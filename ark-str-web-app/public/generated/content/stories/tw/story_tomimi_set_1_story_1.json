{
  "server": "tw",
  "storyId": "story_tomimi_set_1_story_1",
  "groupId": "story_tomimi_set_1",
  "stageId": null,
  "title": "嶄新生活",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_tomimi_1_1.txt",
  "sourceHash": "48d6310d3f822ad311783aacefc3d289af59b9fb8d4ef7fc641623f55f0a79be",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "羅德島本艦\n宿舍區 嘉維爾的宿舍前"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "早上好嘉維爾，該起床了。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（不在......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（好奇怪啊，嘉維爾今天起那麼早嗎？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（還是去食堂看看吧，說不定已經在吃早飯了呢。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（這裡也沒有嘉維爾......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（既不在睡覺，也不在食堂吃飯。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（可能今天有什麼重要的事吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（她最近應該沒有外勤任務，那就只有在醫療部了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "欸，欸？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "怎，怎麼會這樣？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "我也是聽同事們聊起才知道的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "昨天晚上附近聚居點有份緊急委託，情況還很複雜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "為了保證其他幹員的安全，需要醫療部派遣一位作戰經驗和醫療經驗同等豐富的幹員隨行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "這樣的情況整個醫療部只有嘉維爾最合適了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "任務真的很急，部署當晚全體承接委託的幹員就離開羅德島了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "這個......怎麼會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "她應該給你留了訊息吧，留言、紙條之類的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我看看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（打開通訊終端）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "沒，沒有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "怎麼會這樣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（離開阿卡胡拉的時候，她，她就沒來和我打招呼......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉維爾她不會......不會又要丟下我吧？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "呃，你想多了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我現在就去幫忙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "哎哎哎等等，你怎麼去啊，走過去嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我......我開車過去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "用車要申請的，再說了你都不知道目的地，又能開到哪裡去呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "最重要的是，你不會開車呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我，我可以......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔，唔唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "哭，哭什麼呀......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "唉別哭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗚嗚......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "我知道你擔心嘉維爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "但你也應該知道，嘉維爾有什麼好擔心的呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "別人傷不到她的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我怕她......擦......擦破皮......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "她是醫療幹員，這種程度的傷自己能治好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "可是，萬一她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "好了好了，你在這裡哭訴也不是個辦法，對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "先回去休息一下，穩定自己的情緒，做些能讓自己快樂的事，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "任務雖然急，但不是很困難的，說不定過個三四天嘉維爾就凱旋歸來了呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "不要自己嚇自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好，好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "不好意思給你添麻煩了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "沒事的，哈哈，回去休息吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好的......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "沒想到小迷妹沒了嘉維爾反應那麼大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "可能是當初一扭頭就走給人心裡留下陰影了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "下次得提醒她，走之前要記得和親友報個信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "不然再發生一次，特米米怕不是要用淚水把醫療部給淹了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "會發生這麼悲傷的事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "或許吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "醫療幹員",
      "text": "請坐，藍毒小姐，身體有哪裡不舒服嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉維爾......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉維爾出任務了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我也想和嘉維爾一起出任務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "做些讓自己快樂的事啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我該做什麼呢？我能做什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "要是我也能變得強大起來就好了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "這裡是，哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "又在羅德島裡迷路了，要是被嘉維爾知道會被敲腦袋的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（前面有人，問問她吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗯，你好？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "你好，阿達克利斯，有什麼能幫到您的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "（優雅的提裙禮）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔，唔唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（模仿了一下提裙禮）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "你好，我想問一下這裡是哪裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "如果您是指具體位置的話，這裡是前往羅德島機庫的通道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "謝謝你，黎博利姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "不客氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "您好像，有些迷茫，需要我幫忙嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我迷路了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "原來如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "您在哪條道路上迷失了方向？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "抱歉，我好像問了個傻問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "咳嗯，那麼，您現在想去哪裡呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我想......買最新的時尚雜誌，離開阿卡胡拉以後很久沒看了，心裡有些癢癢的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "雜誌，嗯，我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "買雜誌的話坐旁邊的電梯上兩層，出門右轉筆直走，看到小噴泉以後左轉，就能看到書攤了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "價格可能比城市裡的稍高些，但供貨穩定，品種多樣，還能預訂想要的書刊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "是這樣啊，謝謝你，我現在就去看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "請稍等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "在出發之前，能先煩請您解答一下我的小小疑惑嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗯？嗯，直接問就行了，不用那麼禮貌的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "嗯，下次會注意的~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "阿達克利斯，肩上的擔子，還重嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "擔子？你是說背包嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（掂了下背包）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "還好吧，沒有那麼重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "裡面都是精挑細選的寶貝，得貼身帶著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "放宿舍不好嗎，那裡是你在羅德島的家園。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "萬一找不到了，我會難過的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "少任何一件都不行，還是帶在身邊比較合適。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "你的回憶，你的寄託，嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "有沒有想過放在保險箱裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "那可不行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "鎖在箱子裡的話，寶物們會生氣的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "那麼，好好佈置一下宿舍，把它變成僅屬於你的展館，會不會更好呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "懂得背負回憶是好事，但學會卸下負荷並裝點它，或許會更有意義呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔，你說的，我不太懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "沒什麼，只是一位黎博利毫無意義的自言自語罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "我的疑問已經得到了答案，謝謝你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "需要我幫忙引路嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "不用麻煩的，我想我能夠認得路，謝謝你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "那我就先離開了，阿達克利斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "或許我們很快就會再相見的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "（薩爾貢方言）願你的遠景如廣林般浩瀚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "（優雅的提裙禮）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（她好像走得很急。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（通道那一頭的黎博利，是她的妹妹嗎？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（她們好像很親密的樣子。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（真好啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（小噴泉到了，左轉......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "就是這裡了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗚啊，羅德島上也會有這樣的攤子嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "您是第一次光臨小店吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "店裡空間不夠大，有時候貨太多放不下了就會在店外擺個小地攤，當然，這都是提前申請報備的，可不是什麼違規操作哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "您要買什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我想買最新的時尚雜誌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "時尚雜誌有很多種，你看，有介紹掛墜首飾的，有發佈名人新聞的，有主打潮流服裝的，還有——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "請給我關於服裝的，謝謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "這個......最新一期賣完了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（今天運氣好像不太行的樣子......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "不過你運氣不錯，買掉最後一本的幹員還在，如果你特別想看的話，可以問問她願不願意和你分享。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "是哪位呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "那裡，粉色頭髮的就是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "她叫藍毒，每次都是第一個來買雜誌的，今天好像有些事，差點就沒買到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "你去和她搭個話吧，我想她會願意借給你看的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好的，謝謝你！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "唉，我還沒說完呢，她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "算了，多一句不如少一句。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後勤幹員",
      "text": "或許這樣能讓藍毒多個朋友呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "您，您好......請問是藍毒姐姐嗎，我叫特米米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "（她就是特米米嗎？真是巧合。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（伸出手）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "你是......要和我握手，嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔，我只是想，嗯，出於禮貌......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "如果你討厭的話——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "（握了握特米米的手）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "我是藍毒，很高興認識你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "因為一些原因，別人不太願意和我，接觸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "所以你伸手的時候我愣住了，抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "找我有什麼事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我想借雜誌看一下，可以嗎，馬上就還給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "雜誌？你是說這本《自我迷宮》？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "不好意思，我維多利亞語不太好，不是很能理解上面的字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "我也才剛買到，還沒看呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "這裡人太多了，我們找個地方坐下來慢慢看吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好的，拜託你了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "看完了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "謝謝你，藍毒姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "嗯？嗯，不客氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "特米米小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "叫我特米米就好，加上尊稱的話總覺得好像有點奇怪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "啊，好，特米米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "早上......是發生了什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "醫療部那邊的幹員說你的淚水會把整個醫療部都淹了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "這個......講出來還挺難為情的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "說出來心裡會好受些，試試看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "其實，是這樣的......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "大概就是這麼回事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "請不要笑話我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "怎麼會呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "我聽說，阿達克利斯人從不會流淚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "流淚是示弱的表現，所以絕對不可以在別人面前哭的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "即便如此，你也願意為嘉維爾小姐哭泣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "這並不是件難以啟齒的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔，謝謝你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "你好像對服裝類的雜誌很感興趣，你的家鄉也有這樣的刊物嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "沒有，不過依娜姆偶爾會幫我從外面帶過來一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "她是我們那邊做生意的人，經常幫忙從外面帶些有意思的東西回來，還教我語言。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "等學會語言以後，我就買她那裡的書來看，有些書裡的內容特別喜歡，就看得多了點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "比如說？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "《都市麗人》之類的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "嗯哼，那算是比較知名的時尚雜誌了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "只是......東西做得太過流水和規範，反而失了打出名聲時的靈氣，唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "聽說他們有幾個編輯和攝影師想跳出來自立門戶，也不知道能不能成功。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "藍毒姐姐，對時尚很瞭解的樣子，好厲害......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "算不上呢，只是看得多，有一些自己的品味和堅持而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "你呢，特米米，對你來說，時尚是什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我不太清楚，我們那邊的方言沒有描述時尚的詞彙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "打人倒是有好幾種。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "哈哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我覺得，時尚應該就是好看的衣服，簡單又漂亮的首飾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "阿卡胡拉沒有這樣的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "第一次翻開那本雜誌的時候，我才知道，原來衣服也能是那種顏色，那樣的造型。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "有些衣服的樣子，我可能永遠都想像不到，但它會在某一天，出現在我從依娜姆那裡買來的雜誌上，而且我能很肯定地說——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "——我喜歡那件衣服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "你不是很瞭解嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "其實我現在身上穿的這一套，也是從雜誌上看到喜歡的衣服以後，想辦法做了整套然後自己改良的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "雖然有些破......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "啊，我好像有些印象......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "（打開並翻閱自己的隨身筆記）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "瑪爾特......狂野......怒嚎......泳裝系列......珊瑚海岸......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "找到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "來看看，當初是這套嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔，是的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "藍毒姐姐是怎麼知道的？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "積累而已，有時候遇見特別喜歡的設計會剪下來貼在這本筆記裡，然後寫些自己的心得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "剪，剪下來？那樣雜誌不會壞掉嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "這個，怎麼說呢......算是我個人的習慣吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "剪貼畫報的確是破壞了書籍的整體性，但對我來說，它是一條捷徑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "捷徑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "把一本雜誌中你最想要獲得的知識，放到一起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "然後透過這條捷徑，來到這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "到腦袋裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "嗯哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "我手上的這本，已經是第六本筆記了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "最早的幾本，只有在想懷舊的時候才會翻出來看幾眼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "上面除了回憶以外，已經什麼都不剩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "真正重要的，全在腦子裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "成為了審美、品味、格調。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "腦袋真的能記住那麼多嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "當然不會，它只留下你最不想忘記的部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "比如，你對美的選擇和追求。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "或者，對你來說的話，嗯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "嘉維爾？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔，你說得對，嘉維爾的確忘不了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "最重要的回憶，總是在腦袋裡的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "物品有時只是開啟它們的鑰匙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "等到你把回憶鞏固成自動門，就再也不需要鑰匙了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "有，有道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "鑰匙......寶物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "回憶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "特米米，你有試過穿搭嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "穿搭？沒，還沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "那我們現在就去商店試衣，怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "試衣？可，可以嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "雖然種類沒有移動城市裡的商場那麼齊全，但可以先帶你體驗一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "如果你不介意的話，我可以找位裁縫一起去，幫你多提供點穿搭上的建議。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "這，這個，真的可以辦到嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "可以呢，如果你想的話，在羅德島上都可以全身訂製一整套衣服哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "（小聲嘀咕）只是價格不太親民......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好，好的，我，呃，我，我準備一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "一會要試衣服，對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "那我，我，我先回宿舍把背包放下，這樣試衣服的時候可以輕鬆些。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "您能認識到這點，可是一件值得慶賀的事。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "啊，是剛才遇到的黎博利姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的黎博利",
      "text": "之前忘做自我介紹了，請您原諒我的疏忽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "阿絲忒希婭·烏比卡，大家一般稱呼我為星極。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "很高興認識你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "你好，星極姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（伸出手）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（輕盈地握了下手）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "下午好，星極小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "下午好，藍毒小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "我想帶特米米去試一下衣服，您要是方便的話——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "正巧我也想選幾件新衣服，能和各位同行是我莫大的榮幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "柏喙小姐的話，應該還在書攤那裡買刊物吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "哎呀，看來我猜對了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "（真是什麼事都瞞不過她......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "我先去和柏喙打個招呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "藍毒",
      "text": "一會見。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（小聲）星極，星極姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）怎麼啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（小聲）你之前說的，佈置成展館，大概是怎麼做啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）來，看到那邊的小噴泉了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（小聲）嗯嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）噴泉上有個浮雕，是不是很漂亮？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（小聲）嗯嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）如果那個浮雕是你精心保存的藏品，你會不會覺得，很開心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（小聲）嗯......嗯嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）就是這麼回事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）把美好的回憶放在特別為其製作的台座上，總是一件能夠讓人欣喜的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）如果有需要，還可以在台座上加裝其他裝置，可以防止外力破壞，也能把物品的壽命延長許多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（小聲）聽起來挺不錯的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "（小聲）那，有，有空的話，可不可以麻煩您，幫忙，嗯，規劃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）沒問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "（小聲）裝飾挑選有它的講究，等你試完了衣裳，我們再慢慢研究。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "現在先去和藍毒小姐她們會合吧，讓她們久等可不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "特米米。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "怎麼了星極姐姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "現在心情好些了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "做自己喜歡的事，很開心的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "嗯，那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星極",
      "text": "我們出發吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "好的，星極姐姐！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "羅德島和阿卡胡拉的區別是有一點大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "這裡有很多不能做的事，房間也比較小。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "但我不是很在意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我能在這裡學到很多新知識，認識到新朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "沒有比這更令人開心的事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "或許我可以在這裡成為一個時尚達人、探險家、術師。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "或者有探險精神的時尚術師？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "未來又會發生什麼有趣的事呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "我真的很期待。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉維爾也是因為這些原因，才選擇留在羅德島，而不是待在阿卡胡拉吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "不知道嘉維爾現在又在做些什麼呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "忍住啊，也就疼一下的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "疼死了你輕點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "只是疼，死不了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "包紮好了，你按住傷口，我去和客人打個招呼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "喝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "唔呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "喂，怎麼有人溜到我這裡來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤隊長",
      "text": "抱歉嘉維爾，就偷溜了那一個，其他人全搞定了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤隊長",
      "text": "所有人，原地休整，注意警戒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "全體外勤幹員",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "呼，終於結束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "嗯，你沒事就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "嘉維爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "你這次出任務那麼急，有和你家鄉的朋友打過招呼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "這有什麼好打招呼的，都是熟人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "別人我不太清楚，但那個經常來醫療部看你的同族，你總要和她說聲吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "萬一沒找到你，她不哭到把羅德島給淹了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "我們阿卡胡拉出來的人都是一頂一的強者，特米米可沒那麼脆弱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "再說了，之前幫星極做了點事，萬一有事，她肯定會出手幫一把的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "行啊你早都算好了啊，當我沒說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "別嘮叨了，趕緊幫我看看任務結束以後，我們在哪個位置和羅德島本艦會合？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "好，等一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "嗯......這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "本艦會在這座城市停靠，進行休整和補給。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "聽說這還是座度假城市，城裡有大片的濱水沙灘對遊客開放。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤幹員",
      "text": "我們正好能放個假。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "那不錯嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "（度假城市......濱水沙灘？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "（要不，給她買套水邊穿的衣服？她應該會喜歡的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "（就當是，道個歉吧。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
