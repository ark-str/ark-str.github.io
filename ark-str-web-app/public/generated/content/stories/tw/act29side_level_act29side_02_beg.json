{
  "server": "tw",
  "storyId": "act29side_level_act29side_02_beg",
  "groupId": "act29side",
  "stageId": "act29side_02",
  "title": "序曲“哨兵”",
  "storyCode": "ZT-2",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act29side/level_act29side_02_beg.txt",
  "sourceHash": "87519c51991c9b0f8be59dae97a06976ee1298277573f7aeb8ed6b7545a4288c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "在一座很老很老的高塔裡，曾經關著一個可憐的孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "從出生開始，他的人生就已經被書寫完成。就像一部歌劇，每一段旋律、每一幕情節，全都設定好了，他只能照著劇本演出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "有一天，孩子意識到了自己劇中人的身份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "假的，都是假的。身邊之人皆戴著精緻的假面，所有的愛恨情仇都被扮演。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "他是那樣地困惑，恐懼，憤怒。於是他將這樂譜稱作“命運”，並試圖反抗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "終於，他以為自己成功了。他逃離了那個舞台。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "但他忘記了，被賜予的自由，怎麼可能是真正的自由呢？當命運的絲線再度收緊，不管逃去了哪裡，他都只能再度回到舞台上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "這一次他決定戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "他料到了演出在繼續，他的掙扎依然暴露在台下觀眾的注視之下。他想，他可以反過來瞪視他們，來嘲弄他們強加於他的命運。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "然而，他時不時在想……假如他依然是那個劇中人的話，該如何分辨舞台在哪裡，觀眾在哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "假如我們都和他一樣，身在劇中，如何才能知曉，演出何時真正落幕？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的孩子",
      "text": "故事裡的主角好可憐啊。他能成功逃出去嗎？他能變成打敗壞人的大英雄嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "英雄啊……不是每一個人都能變成英雄的。而有些英雄，說不定也會在漫長的時間中變回普通人，甚至變成大壞蛋哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的孩子",
      "text": "什麼啊，阿爾圖羅姐姐，我們才不想聽這樣的故事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "好吧好吧，那我就……唔，從更久以前講起。這樣的話，今天一定講不到結尾，你們也就聽不到不想聽的發展了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的孩子",
      "text": "姐姐快點啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "你們很喜歡來這個密林公園玩，對不對？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "其實這座公園啊，原本並不是用來紀念反抗巫王而死的“英雄”的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "古斯塔夫公園，是為了歌頌一位君王的豐功偉業而建。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾圖羅",
      "text": "在以他為主角的故事裡，他也曾是一名偉大的“英雄”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "呼……呼……哈……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "原來是你們這些“老熟人”啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "我還在想，只是女皇們派來的劊子手的話，何必要大費周章地讓我回來，又准許我多活這幾天。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "烏提卡伯爵，您是計劃的關鍵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "又是這套陳詞濫調。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "格特魯德不是向你們證明過了嗎？她費了那麼大力氣，也只不過差點炸了一座音樂廳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "這次你們又想差遣我做些什麼？炸了頂上的公園嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "斯特羅洛伯爵敗於自己的無知。她與最初那批實驗者都只是一群烏合之眾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "他們得到了陛下的旋律，卻不知道正確的“演繹”方法，竟將它們當作一種散播源石災難的武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "這種粗糙的暴力是對藝術的玷污。假如陛下在當時甦醒，一定會宣判他們死刑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "哈哈，你的意思是，格特魯德是冒牌貨，而你們是真的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "需要我……來替你們向女皇陛下們申請一塊藝術家勛章，來證明你們才是正統嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "我們渴望的是您的理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "您是陛下的繼承人，是他榮耀的證明、骨血的化身、旋律的延續。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "我們相信……您能將榮光帶回烏提卡，帶回萊塔尼亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "……那就動手吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "榮耀，骨血，旋律。統統取回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "我始終很好奇……留下的，屬於名為“黑鍵”這一個體的東西，到底還能剩下多少？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "或許是感染的緣故，又或者，那個名為羅德島的機構很好地鍛煉了您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "您變強了一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "遺憾的是……還遠遠不及陛下的萬分之一。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "倔強的學徒",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倔強的學徒",
      "text": "我……我要去……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "別動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倔強的學徒",
      "text": "你……怎麼來了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "再往前走一步，我就逮捕你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "倔強的學徒",
      "text": "我還沒有……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "沒來得及正式加入那群瘋子，是吧？算你走運。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倔強的學徒",
      "text": "瘋子？他們才不是瘋子。或許在你們眼裡，那位陛下的統治是恐怖的。但他對付的都是那些不思進取的貴族！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倔強的學徒",
      "text": "我為什麼不能懷念他？我為什麼……不能渴望一個像我這樣的人也能出人頭地的萊塔尼亞？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "……因為我比你更清楚那是個什麼樣的時代。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "你聽好，小子。我剛來到萊塔尼亞的時候，在路上不小心踩到了一張飄落在地的畫像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "那條街上都是密探，我立刻被抓進了監獄。當時我還是個拉特蘭商人，他們打算以“外來反對分子”的罪名處決我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你可以嘗試著聯絡公證所或第七廳的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "好了，執行者閣下。我相信您能單槍匹馬深入最恐怖的法術牢獄裡把當時的我撈出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "但您的翅膀就和多數薩科塔的一樣，只能看看，並不能飛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "以拉特蘭和萊塔尼亞的距離來看，您救不了一個第二天就要被處死的可憐黎博利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "可你不僅活了下來，還成了萊塔尼亞人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "因為有人救了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "他是個一瘸一拐的老黎博利，上過戰場，打死過好幾個高盧兵。後來他成了一名憲兵，在當時，這個職位等同於巫王的秘密警察。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "他看我實在倒楣，就塞了點收藏用的煙盒給行刑隊的人，把我弄了出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "幾天之後，我聽說巫王又處決了一批異見者。對，就在你眼前的這個公園內。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "我站在人堆裡，小心翼翼地抬起頭……你猜我在那座扭曲的雕像中間看到了誰的臉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倔強的學徒",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "你很害怕。怕就對了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "快跑吧，孩子。回去找蒂姆，以後都不要摻和進這些事情裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "我們也該撤退了，執行者閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "法術波動很劇烈。你一定也感覺到了，有人在戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "讓女皇之聲憂心去吧。我會通知他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "那樣的話，我們會錯過抓捕罪犯的機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "您為何就是不明白？我並不想要這樣的機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "從這裡進入公園，我會見到一群戴著面具的人，那群人自稱“赫爾昏佐倫的餘音”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "按照女皇陛下們的期許，我應當立即拔出武器，逮捕甚至殺死他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "然後呢？您知不知道，摘下面具之後，他們都是誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "他們可能會搖身一變，成為某位伯爵，甚至某位選帝侯的繼承人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "而我呢？假如我能僥倖活下來，也會再一次被送進監獄。哈哈！公園裡的這場艱辛戰鬥都會變成私人恩怨引發的鬥毆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "就像尤利婭，揚的姐姐。我想抓住最後見過她的混蛋，但我做不到！因為他父親的爵位、他的家族和女皇的牽扯，我傷不到他一根頭髮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "身為執法者，在行動之前，只應遵循律法指引，而非計較個人利益得失。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "律法何曾在乎過一個人的得失生死？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "律法允許你留下遺囑。如果你在接下來的戰鬥中犧牲，我會嚴格執行你的遺願。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "……您真是具備一種特殊的幽默感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "不過您讓我想起了，當我加入反抗巫王的隊伍，衝向那座高塔的時候……我還真想過，就算死了，也能留下點什麼東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "可您看看，我如今活成什麼樣子了？酗酒，收受賄賂，對地位更高的貴族點頭哈腰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "您說得對，我不配當執法者。那個救了我的老傢伙，大概也會後悔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "過去的案件結果不該影響目前的判斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你未能解救那位名叫尤利婭的少女，但你剛剛救了她的弟弟，而且還有機會去救下一個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "我很羡慕您，執行者閣下。離開拉特蘭的時候，我還嫌薩科塔們難以理解。如今想想，你們真是最好懂的一群人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "可是……就算是拉特蘭的律法，難道就總是正確的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你說的那種案子，我有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我正在追查的這個案子，對我來說是特殊的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "她的所作所為嚴重威脅著拉特蘭的秩序。從結果來說，這明明是錯誤的，律法卻始終未能宣判她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "那您不懷疑，不失望？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "以我的經驗來看，失望來自曾對某樣事物寄託足夠正面的情感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "但您沒有，對嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "哈……執行者閣下，您一點都不像其他我見過的薩科塔。您從未真心愛過拉特蘭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我從不認為任何情感對執行任務而言是必要的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "或許吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "又或許，當您不得不像我這樣懷疑自己，感到迷茫，感到動搖的時候……您會意識到，您需要一股力量、一個理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "到那時候，您就會發現，律法指引不了您。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "大提琴聲。目標就在前面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "既然你拒絕繼續前進，接下來我會單獨前往案犯所在地點，執行緝捕任務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "您走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "我仍希望憲兵隊能與我合作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "那可不歸我管了。我回去就會向市政廳提交辭呈。在離開崔林特爾梅之前，我會向繼任者轉交您之前給我的文件。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "洛里斯·博爾丁，我不認為那個曾經的“英雄”已經死去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你就在我面前。因工作要求，我從不誤判生死。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "這樣……嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "哈哈。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "目標並不在此處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "那大提琴的旋律……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平靜的學徒",
      "text": "你沒注意到這些正在噴水的雕塑嗎？術式被改過了，用來復刻她的演奏。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平靜的學徒",
      "text": "薩科塔，你瞄準我幹嘛……你失去理智了嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "金盞花小巷，密林公園。你每一次都會出現在案件相關地點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你的言行舉止均與同齡萊塔尼亞人的平均表現不符。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "上述證據表明，你的身份十分可疑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平靜的學徒",
      "text": "那你就瞄準我？你就沒想過，我可能是站在你們這邊的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "對於有意隱藏身份者來說，先制伏再進行審訊是更有效率的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平靜的學徒",
      "text": "……最笨的術師調試過的雕塑都比你懂得變通！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平靜的學徒",
      "text": "我剛剛還很詫異，這陷阱有什麼意義？在萊塔尼亞，小孩子都能聽出來，這旋律並非人在演奏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平靜的學徒",
      "text": "設置這個陷阱的人一定非常瞭解你，她知道你只要一聽見這大提琴曲，就會像餓久了的牙獸看到肉一樣，不管不顧地撲過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平靜的學徒",
      "text": "這樣的話，她就可以對真正的目標下手……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "……洛里斯·博爾丁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平靜的學徒",
      "text": "誰？那個膽小怕事的憲兵隊長官？你提他幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "你說得對，阿爾圖羅是故意把我引開的。她想找的人是洛里斯·博爾丁。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "蒂姆，是我。我想問問，揚回去了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "那就好。 我放心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "麻煩你跟他說一聲，他姐姐……尤利婭的事，我真的很抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "我要提前離開萊塔尼亞了。這些年我收集了一些線索，都在博登區的房子裡。鑰匙就在我給你的錢包裡，請你交給揚吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "我希望……在我走後，有人能接過這個案子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "追了這麼久，總要有個結果。我是做不到了，但說不定有人可以。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "……這動靜比之前都還大啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "皮姆，我在密林公園附近。這邊有點情況，叫一隊人過來。不，一隊說不定不夠，把能叫的都叫來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "對，大概還是那幫戴著面具四處鬧事的混帳。他們最好只是放出了一幫屁股上點了火的鉗獸，準備炸掉這片下水管道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "但願沒有無辜的倒楣蛋和他們對上。要是有的話……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "哪裡來的琴聲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "誰？誰在那裡……薩科塔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "執行者閣下，是您嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“費德里科”",
      "text": "過去的案件結果不該影響目前的判斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“費德里科”",
      "text": "你未能解救那位名叫尤利婭的少女，但你剛剛救了她的弟弟，而且還有機會去救下一個人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "……幻覺？不，似乎只是回憶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "沒什麼，皮姆，這裡只有我一個人。我突然想起了剛剛發生的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "是的，鬧事的人就在我腳下。我會給你們留一個法術信標。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "很危險，我知道。我這就走遠一點……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“倔強的學徒”",
      "text": "夾著尾巴逃跑吧，長官。你早就沒了當年的勇氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“倔強的學徒”",
      "text": "“第一個踏進巫王塔的士兵”——你真當自己還是那個英雄嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "臭小子，你又在我腦子裡晃來晃去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "皮姆，我不是在跟你說話。該行動了，先說到這裡吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "……沒人比我自己更清楚，我是個懦夫，一個連尤利婭的死因都找不到，也沒有辦法為她報仇的懦夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "尤利婭……尤利婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "假如你見到了今天的我，又會說些什麼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "你那麼溫柔，大概都不會把失望表現出來吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“憲兵”",
      "text": "小子，別垂頭喪氣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "是你啊，老傢伙，你也從我的回憶裡鑽出來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“憲兵”",
      "text": "你呆是呆了點，但還蠻有勇氣的。這年頭沒什麼人敢用眼睛對著畫上的巫王了，更不用說用腳踩上去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "可我只是一個路過的倒楣蛋。為了我這樣的人把命都搭上，真的值得嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“憲兵”",
      "text": "別覺得你虧欠了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“憲兵”",
      "text": "在巫王手底下幹了那麼多年活，我還能有什麼好下場？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“憲兵”",
      "text": "把你放了，至少我這輩子的最後幾天，能睡個安穩覺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“憲兵”",
      "text": "你也是，小子。覺得不舒服的話，想辦法去救更多人吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "黎博利一瘸一拐地走了，很快消失在了陽光下的陰影裡。\n那影子被拖得很長，就和當年那座高塔落下的投影一樣。\n很多生命在無人注視的陰影中消逝。過去如此，如今也是。\n耳畔的大提琴聲漸漸消失了。\n剩下的只有腳下傳來的震動。經驗告訴他，那是無辜的生命正在掙扎的聲響。\n他當然可以留在原地。\n他也可以像離開拉特蘭一樣離開這裡，離開萊塔尼亞。\n只是轉身離開而已，過去十幾年他都是這麼做的。比衝到最前面去要簡單得多，不是嗎？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "我真的很累了啊，老傢伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "我想活。我不僅想活，我還想每天都能喝上新釀的啤酒，下班之後跟皮姆他們一塊去聽點爵士樂。明年夏天，我還想去薩米度假。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "我終究……做不到像你一樣，死得像個英雄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "可是我為什麼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "為什麼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洛里斯",
      "text": "這麼失望？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "您已經很疲憊了，小伯爵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "呵哈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "礦石病蠶食著您的身體。如果您再持續使用源石技藝，等待您的只有自爆而亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "那樣的話……你們會害怕嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "抱歉，我們不會允許您這樣做。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "唔呃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "我的……頭……好痛……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "我們不願意傷害您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "但“首席”說過了，您身體裡的旋律確實比您的頭腦更具有價值。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "有必要的話，我們會讓您暫時陷入……沉睡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "你們想……抹除我的意識……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "休……想！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "呃啊啊啊——!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "什麼人？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "黎博利……穿著憲兵隊制服？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "只有一個人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "逞什麼英雄！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "“快走，我的人已經在路上了。”\n他聽見那個素昧平生的人對他說。"
    },
    {
      "type": "dialogue",
      "speakerName": "黑鍵",
      "text": "……謝謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“巫王的餘音”",
      "text": "小心，別讓目標逃了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "黑鍵知道留給自己的機會並不多。\n鮮血從嘴角淌下來，他的頭疼得快要裂開。\n身後的戰鬥仍在繼續。他很想從爆炸的火光中看清救他的英雄長什麼模樣。但那道影子實在太小，小到很快就被更多的法術光芒吞沒。\n他只能繼續往前跑去。\n不斷地，不斷地跑著。\n他不確定腳下的路延伸向哪裡，自己又究竟要多努力，才能從早已注定的結局中逃脫。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
