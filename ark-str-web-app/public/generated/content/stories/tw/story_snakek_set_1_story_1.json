{
  "server": "tw",
  "storyId": "story_snakek_set_1_story_1",
  "groupId": "story_snakek_set_1",
  "stageId": null,
  "title": "奪包奇遇",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/memory/story_snakek_1_1.txt",
  "sourceHash": "13bf319954738da23ea8a6cd115bb6bd5cbe536d3e65b35f8c1ac1c8edea26a3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "嗯......按照地圖，這裡應該就是那條步行街了。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "比想像中還大好多，這麼多小攤子......糟糕，已經開始擔心沒帶夠錢了......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "哇，水晶餃！還有蓮蓉包！這麼多好吃的......稍微買點嚐一嚐，應該花不了多少錢吧？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "唔——嗝，好撐！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "不行不行，不能再吃了！來這裡是要給大家買禮物的！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "唉，都怪我，之前就因為小卡緹踩到了我的背包就和她發脾氣......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "我也不想那樣，但是背包被......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "好不容易和大家成為朋友，可不能繼續僵下去！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "挑個好禮物，然後鄭重地和小卡緹道歉吧！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "這光澤，這紋路，這重量......"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "不會有錯的，這回我們要發財啦！"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "哼哼，剛剛那個哥倫比亞婦人還斜眼看我們。"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "我叫你瞧不起人！不看好自己的東西，那總會有人替你“看管”的！"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "大哥太厲害了，三兩句話的工夫，就把東西騙走了......"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "那傻女人還沒搞清楚發生了什麼呢！"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "臭小子，我這可不叫騙，這叫請。"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "我們討飯吃不容易，請老天爺照望我們，有何不可呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "大哥說得是！那個......"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "怎麼了老弟，有話直接說！"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "我有點想摸一摸那個吊墜......"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "給你！你來窗邊，在陽光下看，它的花紋超明顯！"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "真的欸，這外鄉東西和我們龍門的確實不一樣......"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "嗯？這個圖案......好像是某種野獸？它的背上有個——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "青年手一滑，吊墜飛落出窗外。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "老闆，我要這個，還有這個！"
    },
    {
      "type": "dialogue",
      "speakerName": "街邊攤老闆",
      "speakerId": null,
      "text": "好，好，小妹妹。我都幫你包上！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "不用袋子了，放我背包裡就好！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "對了，我還沒給錢......唔，錢包好像在外衣口袋裡。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "吊墜正好落在了蛇屠箱敞開的背包裡，但正在交談的二人沒有發現。"
    },
    {
      "type": "dialogue",
      "speakerName": "街邊攤老闆",
      "speakerId": null,
      "text": "看你的樣子不像是龍門人，是來玩的吧？我再給你打個折！來，這是找零。"
    },
    {
      "type": "dialogue",
      "speakerName": "街邊攤老闆",
      "speakerId": null,
      "text": "買這麼多東西，是給爸爸媽媽帶的嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "不是哦，是給朋友們帶的！"
    },
    {
      "type": "dialogue",
      "speakerName": "街邊攤老闆",
      "speakerId": null,
      "text": "看來小妹妹朋友挺多嘛，來，我再給你些贈品。"
    },
    {
      "type": "dialogue",
      "speakerName": "街邊攤老闆",
      "speakerId": null,
      "text": "這些都是龍門的特產，全都是手工製作的。拿去跟朋友們分吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "謝謝叔叔啦！"
    },
    {
      "type": "dialogue",
      "speakerName": "街邊攤老闆",
      "speakerId": null,
      "text": "小意思！祝你在龍門玩得開心，另外要小心點自己的東西......"
    },
    {
      "type": "dialogue",
      "speakerName": "街邊攤老闆",
      "speakerId": null,
      "text": "最近這一片小偷小摸的人不少，最愛盯上外鄉人。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "好喔好喔！我明白啦，你別看我這樣，其實我很能打的！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "就算有小偷！我也能打飛他們！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "沒想到龍門人都這麼熱情呀！老闆大叔送了我這麼多東西......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "等回去好好挑選一下，然後分給羅德島的大家吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "那一對小動物擺件，正好給安德切爾和史都華德一人一個......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "然後，用炎國絲做的軟帽，送給梅小姐！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "還有給小炎熔的音樂盒、給杜賓教官的紗巾......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "唉，可是，逛了這麼多地方，還是沒有找到給小卡緹的禮物......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "到底給小卡緹送什麼比較好呢？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "小妹妹，你等一下！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "欸？怎麼啦，有什麼事？"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "剛才，我的東西掉出窗外了，落在紀念品攤位那裡。是一個金屬吊墜，你有看到嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "嗯？我沒有看到啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "我看到，吊墜正好掉在你的背包裡了。可不可以把你的背包打開，給我看看啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "你稍等，我先看看......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "剛才老闆大叔送的小禮品，都是金屬飾品啊......你不會是看到了，才來找我麻煩的吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "你！你撒謊！"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "把包拿來，我來找！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "你鬆手！別碰我背包！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "哼！還想搶我的東西，先問問我的球棒同不同意吧！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "半個小時後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "嗯嗯、嗯嗯。"
    },
    {
      "type": "dialogue",
      "speakerName": "冒失的青年",
      "speakerId": null,
      "text": "哥，你這個主意不錯，我這就去準備！"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "別再給我搞砸了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "可惡，這個蠢蛋成事不足，敗事有餘。"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "居然被一個小女生三兩下就放倒了。"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "動手不行就動腦，改變計劃吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "果真像老闆大叔說的那樣啊......我看起來那麼像外地人嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "看來龍門這個城市，治安不太好啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "小妹妹，請等一下。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "你又是誰？"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "啊，不要誤會。我剛剛路過時，聽到你說龍門治安不好，所以就來問問情況。"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "這是我的證件，這附近的街道屬於我的區域。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "龍門......街道管理員？是做什麼的？"
    },
    {
      "type": "dialogue",
      "speakerName": "精明的青年",
      "speakerId": null,
      "text": "（對於各種情況我都早有準備，多一個證件，多一份保障。這次就用這個身份陪你玩玩吧。）"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "維持社區街道的秩序，為市民提供一些力所能及的幫助。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "所以你是遇到什麼不開心的事情了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "最近我們發現有一些小攤販會把假冒偽劣的商品高價賣給遊客，我今天是身穿便衣來這附近秘密調查的。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "如果存在這種情況，我可以幫你去處理。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "唔......可是我感覺那個老闆人挺好的呀，不僅給我打折，還送了一堆小禮品......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "最重要的是，我買了那麼多東西，好像也沒花多少錢，感覺比在哥倫比亞的時候還要便宜欸......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "對了，剛才有個怪人，想要搶我的東西！"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "哦？可以描述一下他身著什麼服裝，長什麼樣嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "唔......是個男的，比我高，然後、然後......呃，我不太記得他長什麼樣了......"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "只是這樣的話，我可沒辦法找到那個人噢。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "算了算了，還是給小卡緹挑禮物更重要。謝謝管理員大哥，我去別的地方再看看啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "你是在給朋友買禮物嗎？想買什麼樣的東西？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "我在這片街區工作很多年了，也許我可以給你推薦個商店呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "別的地方我不清楚，但是我們龍門的街道管理員，一定會盡全力幫市民解決問題！"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "畢竟作為龍門的公職人員，可不能讓外國朋友留下一個“龍門治安不好”的印象啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "小妹妹，如果有任何困難，都可以跟我說哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "啊，好吧......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "其實......我之前和朋友吵架了，所以想準備個禮物，向她道個歉......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "但是逛了好久，也沒找到合適的禮物。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "也不能說沒有買到啦，只是還不算很滿意......"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "送禮物給朋友，只要心意到了就可以了吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "我個性急，也會對兄弟朋友發脾氣，但是基本上請頓飯喝頓酒，誠懇地說聲對不起，事情也就翻篇了。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "所以，你和你的朋友道過歉了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "還沒有......因為一直不太好開口。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "那你知道她喜歡什麼嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "對噢......小卡緹她，喜歡什麼呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "我記得安德切爾說過，小卡緹曾經很想成為滑雪運動員。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "之前在小卡緹的房間裡也看到過一套落灰很久的滑雪服......"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "那就準備些和滑雪相關的禮物吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "呃......可是我完全不了解滑雪......"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "哈哈，看得出來，你應該是一個棒球愛好者。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "會打棒球嗎？還是只看球賽？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "會打！而且最喜歡棒球了！"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "那要不送個和棒球相關的東西吧？如果是你喜歡的，作為禮物也不錯哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "呃......小卡緹好像對棒球沒什麼興趣啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "之前我在羅德島甲板上舉辦小型棒球賽，小卡緹也沒來參加......"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "對了，說到棒球，我想起來前面那個路口有個商城，裡面好像有打棒球贏獎品的活動，要不要去看看？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "如果實在不知道送什麼，就送贏來的獎品吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "親手贏來的禮物，肯定比買來的要更有意義吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "確實有點道理欸。之前小炎熔就和我說，送一些親手做的東西更好，可是我實在是沒什麼做手工的天賦......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "棒球是我最擅長的事了，透過打棒球贏來的獎品，應該也不錯......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "那就去看看吧！好久沒打棒球了，正好過過癮！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "那邊的遊樂區域應該就是了，現在正好沒什麼人，去看看吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "是有個奇怪機器的那邊嗎？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "來來來，照過來照過來，揮棒擊球就贏獎品，活動最後一天，大家把握時間！"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "（哼，那蠢蛋偽裝成電玩城員工，還挺有那麼回事嘛。）"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "（利用這個剛停業的小電玩城，讓這小妹妹上鉤，還不是手到擒來的事？......我可真是個天才！）"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "你好！請問這裡是打棒球的地方嗎？獎品是什麼啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "呃......獎品，獎品是......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "嗚哇！這個玻璃展櫃裡的都是獎品嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "那、那個！那個滑雪板，也可以換嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "你想要那個滑雪板啊？不過滑雪板是大獎，要拿到可能有點難度......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "欸，這位員工大哥，我怎麼感覺有點面熟......"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "小姑娘，就算你和我裝熟，我也不會給你降低難度哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "看到那個發球器了嗎？只要將機器射出的棒球打回去，計分板就會根據球擊中的位置顯示你的得分。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "所以，如果打中紅心區域的部分，就能拿到大獎？"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "沒那麼簡單！40龍門幣一輪，一輪10個球，累計得分超過475分就可以拿到大獎啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "要來試試嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "475分，相當於五次打中紅心區域，這也太難了吧！有沒有不用那麼高分就能拿到的獎品啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "（搞什麼鬼，弄這麼難，誰願意和你玩啊？一次失敗人家就跑了！）"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "有的，我們還是鼓勵大家多多嘗試的。"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "如果不足475分，會降低下一次大獎的分數要求，多試幾次，最低200分就可以拿到大獎啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "（一個小妹妹能有多厲害，肯定能爭取到足夠的時間。）"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "唔......這個滑雪板，小卡緹應該會喜歡吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "仔細想想，還有點期待看到小卡緹滑雪的樣子！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "好，那就先來試試吧，爭取一次性拿下！來吧來吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "那還請您先付入場費，在後面的櫃子裡可以寄存包哦。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "不愧是龍門！逛了這麼久才走了兩個街區，腳都快報廢啦！"
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "speakerId": null,
      "text": "那是因為每家店你都要進去看，挑來挑去半天，結果什麼也沒買。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "還不是因為我的錢包已經空啦！"
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "speakerId": null,
      "text": "噢，我想起來前兩天還看到了你訂購的棒球手套和球棒。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "那是為了向蛇屠箱道歉買的呀！而且為了補上差的那點錢，我還賣了些舊東西......"
    },
    {
      "type": "dialogue",
      "speakerName": "梅",
      "speakerId": null,
      "text": "欸，你和蛇屠箱小姐還沒和好嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "梅",
      "speakerId": null,
      "text": "我記得之前在遊戲室裡，你們吵得好凶......我還是第一次看到蛇屠箱小姐咬人啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "......其實現在想來是我的問題啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "我有的時候神經太大條了，只想著大家一起玩得開心，沒有什麼玩笑是不能開的......"
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "speakerId": null,
      "text": "聽醫療幹員說，蛇屠箱對她背包的保護是下意識的。由於蛇屠箱忘記了絕大多數過去的事情，所以大家也不知道實際的原因......"
    },
    {
      "type": "dialogue",
      "speakerName": "梅",
      "speakerId": null,
      "text": "蛇屠箱小姐連以前的家人和朋友都忘記了......想想也有點可憐。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅",
      "speakerId": null,
      "text": "不過她上次跟我說，能和羅德島的大家成為朋友，已經不會覺得寂寞啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "梅",
      "speakerId": null,
      "text": "對了，今天一早起來就沒見到她，她去哪了？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "唉......可能還在躲著我吧......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "嘿呀！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "這......這是矇的吧，這就打中紅心區域了？運氣這麼好？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "嚄！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "又一次紅心區？！"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "不行......這是不是難度弄得太低了，好像可以調節球向和障礙......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "再來！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "哇！原來還可以拋出變向的球嗎，還多了一些障礙物......哼哼，沒問題，那我也要認真起來了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "呼！太暢快啦，這就是打棒球的感覺！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "還有球嗎還有球嗎，全都丟過來吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "真......真的假的？"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "所有的難度係數我都拉滿了呀！"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "這姿勢，這力道，這準度......"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "這小妹妹是安布魯·愛德華茲嘛？！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "員工大哥，我多少分了呀，可以領獎品嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "呃......機器的計分系統好像有點超負荷了，不過目測肯定是超過475分了......"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "（完蛋了！大哥才剛剛離開，肯定還沒拿到吊墜......怎麼辦，得再拖拖時間。）"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "那我就先把滑雪板拿走啦！"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "哦，好的......不對！等一等，小妹妹，我看你意猶未盡，想不想再來幾球？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "可是我已經拿到獎品了......不過確實還想打，那我還需要交錢嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "不用不用，獎品你拿好，現在也沒別人，臨下班前讓你玩個痛快吧！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "球飛向蛇屠箱，在球影正要掠過視野角落的一刹那，蛇屠箱用力揮棒——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在“電玩城員工”的眼中，這名少女的身姿，恍惚間與無數王牌球手的身影重合。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "球再次重重擊中紅心區域，隨後發球器出現故障，閃出電花，併發出了異樣的響聲。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "電玩城員工？",
      "speakerId": null,
      "text": "這......這是？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "轟——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅",
      "speakerId": null,
      "text": "太嚇人了，剛才那聲爆炸，我還以為又要捲入突發事件了呢......"
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "speakerId": null,
      "text": "好像就是從這邊的商城傳來的，欸，那邊地上的是......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "是蛇屠箱的背包！"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "怎麼會......蛇屠箱不會遇到危險了吧？！"
    },
    {
      "type": "dialogue",
      "speakerName": "梅",
      "speakerId": null,
      "text": "在這邊，蛇屠箱小姐在這邊！"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "蛇屠箱！蛇屠箱！"
    },
    {
      "type": "dialogue",
      "speakerName": "安德切爾",
      "speakerId": null,
      "text": "沒事，她應該是睡著了。欸？她好像抱著什麼東西......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "這是......一個滑雪板？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "嗯......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "這裡是......羅德島的房間？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "我記得，當時我在打棒球，然後“轟——”的一聲......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "之後的事......管理員大哥和員工大哥去哪裡了呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "我玩得很盡興，還沒和他們道謝呢......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "現在想來，龍門好人可真多呀！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "啊！對了！我的獎品！給小卡緹的滑雪板呢？！"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "太好了，沒有摔壞。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "給其他人的禮物......也都還在。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "請進！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "唔，是小卡緹啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹&蛇屠箱",
      "speakerId": null,
      "text": "那個......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹&蛇屠箱",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "你先說吧，蛇屠箱。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "啊、好！這塊滑雪板，是我參加商城活動贏來的......送給你！之前的事，對不起！"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "......原來滑雪板是送給我的？"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "我之前聽其他人說，小卡緹你以前想成為滑雪運動員......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "然後，我記得你有一套滑雪服，所以就......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "哎，可是那套滑雪服......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "嘿嘿，可惜上個月我有點財政赤字......已經賣掉了......"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "那、那我下次再送你一套滑雪服吧，或者你還有什麼別的想要的？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "嗯......讓我想想。"
    },
    {
      "type": "dialogue",
      "speakerName": "蛇屠箱",
      "speakerId": null,
      "text": "嗯嗯！你儘管說！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "卡緹將一根新球棒遞給蛇屠箱，然後抬起另一隻手，在蛇屠箱面前晃了晃。\n她的手上戴著一個棒球手套。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡緹",
      "speakerId": null,
      "text": "那麼......今天開始，你教我打棒球吧！"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
