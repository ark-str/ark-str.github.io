{
  "server": "tw",
  "storyId": "act18mini_level_act18mini_st04",
  "groupId": "act18mini",
  "stageId": null,
  "title": "河畔航船",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/activities/act18mini/level_act18mini_st04.txt",
  "sourceHash": "c0eb448244b37d08d8080acb7bba2eded320e6e341c87d1b10d0d2088117c9b0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "自從你們那位親王獨自遠走，航船們分崩離析後，玫瑰河畔在我的認知中便已經解散。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "曾經的航船中，轉而為軍事委員會效力的人不在少數。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "如今軍事委員會剛露出頹勢，你就重新恢復我們之間沉寂多年的通訊，我無法保證你能從我這裡得到你想要的東西。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "神秘的血魔",
      "speakerId": "avg_003_kalts_1",
      "text": "一點情分都不講？你還是老樣子，凱爾希。"
    },
    {
      "type": "dialogue",
      "speakerName": "神秘的血魔",
      "speakerId": "avg_003_kalts_1",
      "text": "阿米婭成長得很快。不過現在她也在暗處提防著我，對吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "必要的準備。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "Logos已經向我們預警了你的出現。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "我們從墜落的飛空艇撤離後，你是第一個接觸到我們安全點的外人。"
    },
    {
      "type": "dialogue",
      "speakerName": "神秘的血魔",
      "speakerId": "avg_003_kalts_1",
      "text": "……“外人”。"
    },
    {
      "type": "dialogue",
      "speakerName": "神秘的血魔",
      "speakerId": "avg_003_kalts_1",
      "text": "勛爵，或許你跟我一樣，傷心的時候最好不要說話？"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "隱德來希，這裡不是巴別塔的安全點。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "聽到這個代號從你的嘴裡說出來，真讓我懷念那些日子。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我來這裡時經過倫蒂尼姆城內外的整片戰場，救了一些人，也送走了一些人。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "看著同胞們淪陷在這片不屬於他們的土地上，那種滋味並不好受，凱爾希。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "我不記得你是多愁善感的人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "血魔沉默了，凱爾希看出了她並不願意對此有任何回應。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "隱德來希，為什麼冒著危險深入維多利亞戰場來見我？"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "如果你需要幫助，特雷西斯會是更好的選擇。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "不必試探我，凱爾希。我對攝政王要做的事情毫無興趣。或許我們之中有些姐妹認可了攝政王的想法，但你也知道……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "自特蕾西婭殿下在巴別塔遭遇意外之後，我們姐妹間的聯絡就越來越少，互相的約束也在減弱。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "不過這並不是我來找你的原因，凱爾希。阿斯卡綸那邊，我打算幫她一點小忙，讓她進城的路容易一點。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "你索求什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "按照我們收到的即時訊息，城內軍事委員會正在加強管控。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "食腐者的軍隊與維多利亞公爵的大軍正以城牆為前線對峙，情勢瞬息萬變。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我當然清楚，但她那樣一個可愛又好學的年輕人，還是值得我去關照的。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "不，我在意的是在這種局勢下，你不可能找得到阿斯卡綸的蹤跡。我很清楚她的手段。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "她受傷了，傷勢不輕。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "她從來都無法容忍自己用受傷這種藉口放鬆警惕。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "你很信任她。被你如此看重，很難說我到底該為她開心，還是要為她擔心。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "誰在幫你？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "“小聰明”，我們那位消息靈通的姐妹。身為技術人員，她在倫蒂尼姆追查到了一些我在意的線索。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "她？我記得你們以前很愛惜她，絕對不會同意她貿然涉足戰場中心，而且按照你們航船之間當初的約定，你們任何一個人都不該來。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……你果然很清楚我們當年的事，她的情報沒錯，你有親王的線索。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "勛爵，那你應該也清楚，我是唯一一個，絕不會，也無法從這條血河上離開的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我都這樣說了，你還懷疑我嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "羅德島會感謝你的幫助，我們會回報航船的付出，就和在巴別塔時特蕾西婭做的那樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "我會告訴你我所知道的線索，關於那位親王。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "謝謝你，凱爾希。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "另外，我在這座城市的地下聞到一些屬於杜卡雷的臭血味，我很願意順手幫你們解決——"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "但我需要你們的人手幫忙。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "羅德島在城內暫時沒有多餘的人手。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "有一支名為“銑痕”的勢力，我想你要找到他們並不困難。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "他們離風暴的中心很近，卻決意與任何一方斬斷糾葛，這樣的立場，你應該很熟悉。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "你竟然會信任這種人？"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "目前我們仍有一些共同的利益。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "如果軍事委員會藉助杜卡雷的布置另有安排，那勢必會影響公爵聯軍的後續行動……甚至重創典範軍進城的計劃。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "羅德島和“銑痕”都不願意看到這個結果。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "哈哈，你果然沒變，凱爾希。這是你的計劃，還是那位指揮官的計劃？"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "這是羅德島的計劃。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……羅德島。好，替我向那位指揮官打聲招呼。不過，那個人恐怕已經不記得我是誰了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "勛爵，我心中有一個揮之不去的疑惑需要向你們確認。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "這個答案，除了攝政王殿下，如今恐怕只有你們能回答我。從飛空艇回來的人，只有你們。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "一個你已經在心中知道答案的問題，重要嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……當然。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "若不親眼見到、親耳聽到、親口說出，告別就會變得很難。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "哪怕心臟真切地感受到了眾魂離去的迴響，也還是要反覆確認，她是否也在那支隊伍中。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "所以……特蕾西婭殿下，是不是又一次離開了我們？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=1>卡茲戴爾南部地區</><p=2>1094年夏，巴別塔倒塌後</>"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲僱傭兵",
      "speakerId": "avg_npc_054",
      "text": "咳、咳咳……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "留你一命，再還你一把小刀。就我要問你的問題而言，這個價格應該算很慷慨了。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "誰僱傭你們來殺我的？知道我們存在的人並不多。"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲僱傭兵",
      "speakerId": "avg_npc_054",
      "text": "結局都是死，不如痛快一點，也少牽連幾個人——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "“放過”他吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "//临时用一下"
    },
    {
      "type": "dialogue",
      "speakerName": "年輕的薩卡茲",
      "speakerId": "avg_npc_1664_1",
      "text": "隱德來希，我的意思是不如痛快點殺了他。"
    },
    {
      "type": "dialogue",
      "speakerName": "年輕的薩卡茲",
      "speakerId": "avg_npc_1664_1",
      "text": "反正只要他流的血夠多，你就能從裡面拆出自己需要的記憶，不是嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲僱傭兵",
      "speakerId": "avg_npc_054",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "既然是你的建議——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "血魔抬高了手。\n壓制住僱傭兵的血色枷鎖消散在無形之中。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "我更喜歡唱反調。"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲僱傭兵",
      "speakerId": "avg_npc_054",
      "text": "……？！"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "走吧，傭兵，就像你看到的一樣，這次來殺我的人太多了，我記不住你的臉。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "不用謝。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年輕的薩卡茲",
      "speakerId": "avg_npc_1664_1",
      "text": "一看到你演戲，我就覺得難受。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "能知道“玫瑰河畔”這個名字的人不多，不需要對他動手，我也能猜出來是誰在狩獵我們。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "殿下才剛離開，有些躲了太久的人就已經忍不住了。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "但你配合得不錯嘛，省得我自己找藉口放走他。"
    },
    {
      "type": "dialogue",
      "speakerName": "年輕的薩卡茲",
      "speakerId": "avg_npc_1664_1",
      "text": "不要誤會。殿下已經死了，我也不想跟著攝政王去維多利亞送死……"
    },
    {
      "type": "dialogue",
      "speakerName": "年輕的薩卡茲",
      "speakerId": "avg_npc_1664_1",
      "text": "所以，我總得為自己找條活路。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "這麼說，你也想殺我，彌爾頓。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "我動不了你……或者你們中的任何一個。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "否則我早就把姐姐帶走了。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "那現在最好滾出我的視線。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "年輕的混血薩卡茲反倒握緊了手中的刀。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "唉。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "彌爾頓，你幫你姐姐傳過信，所以我記住了你。記憶不是假的，記憶和你現在的立場無關——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "你我都清楚，殿下的離開對卡茲戴爾代表著什麼。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "我能預感到一場風暴的接近，誰都逃不了。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "彌爾頓，我不想讓你姐姐傷心，現在你還能離開。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "眼下局勢很不明朗，姐妹們各自散去，連我都很難找到她們的蹤跡。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "卡茲戴爾這場混亂已經讓我不得不和許多人告別，能和我交談的知情人士也越來越少。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "我不想因為你再失去一位姐妹。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "……你們無處可藏。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "來追殺你的人，大部分都不是出於仇恨，而是為了你們經手的情報。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "哪怕是軍事委員會宣稱不會追究與巴別塔有牽連的人，我也不相信他們真的會放任你們帶著那些情報和秘辛就此離開。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "哼。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "那我很歡迎他們來試試。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "彌爾頓，你在做一件蠢事。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "我只是個不值錢的僱傭兵，如果真的能藉由殺死你來取信於人，至少我還有機會保下姐姐。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "我必須這麼做，隱德來希！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "年輕的薩卡茲突然揮動了手中的刀，但隱德來希的鐮刀卻沒有如預期般攔下他的攻擊。\n血魔的身影猶如血霧慢慢散開，隨即消失。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "嘖。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "其實你最初就能坦誠一點。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "如果我向你保證接下來沒有活人能靠近這條街道，你是不是就可以更誠懇地溝通了？"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "嗯，就跟你想的一樣，你正在埋伏的那些同事不會來了。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "隱德來希，你也遠沒有你裝出來的這麼坦然。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "你假裝很在乎這些人的追捕，假裝自己的行動是為了抓出一個叛徒。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "然後把每一個來抓你的人放回去，讓他們說出你的去向，只為了讓所有尋仇的人眼裡只有你這一艘航船。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "呵，我聽姐姐說過很多次了，隱德來希，你是所有行動的善後人。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "她死裡逃生的那一次，你也用了相似的手段，把注意力引到了自己身上。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "只不過那一次你假裝的是自己受傷。你確實流了不少血，施展的法術足以讓每一個看見你的人變成一團血霧。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "即使姐姐已經冒著生命危險讓你們“洗淨”了她的血液，成了純粹的血魔……那幅景象還是讓她幾天吃不下東西。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "我已經很努力控制不讓多餘的鮮血濺出去，我也不喜歡大張旗鼓地做事——"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "不，我難以容忍你的傲慢。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "你覺得自己能一個人背下玫瑰河畔所有的血債。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "……我怎麼會這麼想呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "要是我真的有一手遮天的本事，那我無論如何都會拉住姐妹們，讓她們陪同我留在這條血河上。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "玫瑰河畔本不該那麼早就消散……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "我也不希望在內戰局勢急轉直下的時刻，自己只來得及盡善後人的職責，卻對其他風聲一無所知。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "但事實如此。我沒有能力救特蕾西婭，也沒有能力救任何一艘航船。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "就像眼下你想為你姐姐做的事情，也是我辦不到的。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "——你？！"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "噓。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一枚晶瑩的血紅色寶石緩緩落在了彌爾頓的面前，而隱德來希的面容變得更加雪白。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "拿著它去找你認為能保下你姐姐的人交差。我向你保證，這片大地上只有兩個人能分辨出它和我的“小石榴”的差別。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "……你的耳飾？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "並非只是耳飾……你不需要知道這麼多，走吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "祝你好運，也祝我的姐妹好運……"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "你呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "看看你手中的東西，我已經被你殺了，不是嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "如果你有機會再見到你的姐姐，告訴她，我一定會找到那個人，讓她給所有姐妹一個答覆。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "你們的那位親王，她究竟是叛徒、騙子，還是什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "風送來了血腥味，她已經離開了。"
    },
    {
      "type": "dialogue",
      "speakerName": "彌爾頓",
      "speakerId": "avg_npc_1664_1",
      "text": "……謝謝你。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=1>倫蒂尼姆碎片大廈內部</><p=2>1098年10月</>"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "聽得到嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "我進入軍事委員會的指揮中心了，無線電靜默解除。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_1522_1",
      "text": "隱德來希，你這麼快就找到門路了？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "當然，還是老辦法。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "順手處理杜卡雷的祭壇時找到了不少倒在血泊裡的人，總有幾個跟軍事委員會走得比較近的。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "他們記憶裡還有指揮中心的情報。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_1522_1",
      "text": "啊……看來我今天的占卜又不太準了。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_1522_1",
      "text": "今天血滴下來的形狀像是兩把劍，我以為這說明你會跟王庭軍正面對抗，艱難地打開進入指揮中心的道路。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "你還在玩那套道聽塗說的占卜？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "無線電中傳出了跌倒的聲音，遙遠而模糊。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "……怎麼了？"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_1522_1",
      "text": "嘖，又被纜線絆倒了。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_1522_1",
      "text": "反正我的身體都這麼差了，也不能用血施展什麼法術，就讓我偶爾灑一兩滴玩一下嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "你真的不考慮告訴我，你現在藏在哪裡？"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_1522_1",
      "text": "這不是老規矩嗎？即使在玫瑰河畔，航船們最親密無間的時候，也沒有幾個人知道我的藏身處。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "但你來了倫蒂尼姆，這裡並沒有什麼絕對安全的地方。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_1522_1",
      "text": "不必為我擔心。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_1522_1",
      "text": "出現活動目標，東北方向，聽起來有兩支小隊，注意躲避。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "收到。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "等我們破壞了指揮系統，來接手的傢伙就會是一幫我們都不認識的傭兵。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "——滋……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "……你還在嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "在，就和過去一樣，姐妹們一起行動。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "是啊，就和過去一樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "那支傭兵隊伍其中領頭的三個人，當年和巴別塔也有些交集。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "雖然我只是受凱爾希之託，但此次也無法再用舊日交情這種理由當藉口了。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "你說，這算不算違背了姐妹之間的約定？"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "我想這只取決於你自己的想法，隱德來希。所有人都不再插手巴別塔相關的事務，是你自己定下的規矩。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "有些人其實沒那麼介意自相殘殺。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "多點規矩，少點麻煩。我知道姐妹們的脾氣……有時沒那麼好相處。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "是啊，有人加入，自然也會有人離開。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "隱德來希，我們得接受這一點。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "但還是不能解釋她的突然失蹤，我自認為是最熟悉她的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "當然是啦，其他人身上也沒有攜帶她的任何一滴血。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "所以，她的離開只能是真的毫無徵兆，而不是我們沒有察覺。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "看來你懷疑過自己。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "其實我也是。那之後我就迷上所謂的“占卜”了。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "它一點也不準，只是個聯想遊戲而已，但至少會給我一些預兆，提醒我為任何變故做好心理準備。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "我會幫你的，至少我們現在知道，她的確來過倫蒂尼姆。"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "兩個人比一個人好，有線索比毫無頭緒好，對吧——"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "等等，隱德來希，指揮中心外面有動靜。維多利亞的聯軍和一群身分未知的薩卡茲起了衝突。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "是來接手的傭兵。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "看來他們的動作也沒比我們慢多少。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "我幫他們提前清理一下指揮中心，這樣他們後續的麻煩會比較少。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1522_1",
      "text": "幫我指路？"
    },
    {
      "type": "dialogue",
      "speakerName": "無線電中的聲音",
      "speakerId": "avg_npc_054",
      "text": "我一直都在。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=1>倫蒂尼姆</><p=2>巴別塔攻佔軍事委員會指揮中心後</>"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "——隱德來希。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……凱爾希，你來遲了。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "規劃最後的進攻計劃延誤了時間。你心不在焉，這很不常見。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "羅德島的醫療幹員能夠為你提供一般的醫療援助，但如果一名血魔自己不願意止血，他們也無能為力。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "放心吧，出入戰場難免會流些血啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我只是在想，這片血漬該算是什麼形狀。看起來像是一個不好的預兆，不是嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "繼續說吧，凱爾希。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "……很抱歉，一如既往，我僅能以我個人的身分感謝你破壞了杜卡雷留下的法陣，使倫蒂尼姆免於另一場滅頂之災。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我也只是出於我個人的嫌惡毀了杜卡雷的東西而已。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "不是在幫你們，更不是在幫那些維多利亞人。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "但你也幫維什戴爾他們掃清了很多障礙。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "這點我不否認，希望勛爵記得我做過的事。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "當然。這些從鮮血法陣中獲得的情報，你告訴過“銑痕”嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我只暗示了一下，不過，那隻小貓很聰明。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "當維多利亞人與薩卡茲開戰的時候，必然有人在其中為謀求利益而合作。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "戰爭該結束了。這些問題只能留在倫蒂尼姆，留給維多利亞自身。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "阿米婭和博士正在向維多利亞的代表們爭取一個和平的最終處理方式。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "如果談判成果理想，屆時，所有薩卡茲都會離開。倫蒂尼姆的災難也可以結束。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "對於過去之事，人們掌握的細節越多，越會成為煩憂。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "近乎全知的凱爾希勛爵，你說的這句話很像在自嘲。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "四年前，在我找到已經一片狼藉的巴別塔時，其實覺得我們說不定也有相似之處。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "善後人啊，不就是捨不得離開，不想接受失敗，所以一直留在那裡，想把滿地碎片重新拼起來。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "……隱德來希，我已經如約將那位親王的線索同步到你留給我的頻段。雖然同樣只是一些支離破碎的消息，但應該能幫上你。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "謝謝你，凱爾希。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "要是你和羅德島還需要什麼幫助，可以現在就告訴我。畢竟，讓所有薩卡茲都同意離開，不是一件容易的事情。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "但還有一件事是你需要知道的——接收消息的人沒有任何回覆。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……？！"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "可露希爾很艱難地大致確定了頻段訊號所在的範圍，但有人在阻撓我們的人靠近。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "不，與其說是阻撓，不如說是刻意吸引我們的注意。我想這種舉動只能說明暗中藏著一些另有目的的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "是針對我來的？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "隱德來希走進廢墟。\n幾個害怕的市民遠遠地跟在她身後，一直盯著她，低聲咒罵，卻不敢丟出手中的磚頭。\n地上有一道乾涸的、拖行留下的血跡，穿過巷戰中倒塌的牆體，繞過生鏽的生產線設備。\n“小聰明”了無生氣地躺在那裡，懷中緊緊抱著一個被砸壞的訊號接收器。\n鮮血從她駭人的傷口中淌出，依然殷紅。\n一位孱弱的血魔死在了倫蒂尼姆，一個隨處可見的現場。沒有人會在意她為何而死，但也無人能玷污她的死亡。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "血液還沒有乾涸……有人守護了你最後的尊嚴。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……只有活著的人才能留下這樣的小小法術，生命的法術——"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "親王，你的仁慈……就只有這麼一點點嗎？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "手指浸入鮮血，訊息在眼前湧現。隱德來希藉助鮮血與離世之人尚未完全潰散的意識交流。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……是誰害死了你？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "作為玫瑰河畔的“善後人”，她見過許多次同伴倒在血泊裡的景象。\n那些影子在她的想像裡充當訊息的闡述者，合成出一段似有若無的記憶。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "是維多利亞人，還是軍事委員會——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "記憶在不斷向過去回溯，熟悉的身影從血河中走出，靜靜地注視著她們。\n那是“小聰明”的記憶，也是每一艘航船的共同記憶。鮮血的溫度在流失，逝去之人的記憶也在逐漸乾涸。\n航船們甚少離別，但任何一艘航船的離去都絕不會無聲無息。無論局勢多麼嚴峻，她們都會各自抽出時間，為離去的姐妹哀悼。\n至少曾經如此。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "不，等等——我們要找的人呢？你真的甘心嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "你不是也想要把所有姐妹都找回來嗎？"
    },
    {
      "type": "narration",
      "text": "她看不到任何訊息，鮮血中沒有答案。\n但她的手指驀地觸到一塊堅硬的東西。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……？！"
    },
    {
      "type": "narration",
      "text": "她當然認識那塊結晶。\n那是她自己的一滴血，一個誓約，是玫瑰河畔的起點。\n純淨的結晶裡沒有任何訊息，只有法術殘存的溫度。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "親王……你為什麼偏偏在這個時候，決定把它還給我？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "既然你來過，為什麼又匆匆離開？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "是因為你沒有救下她嗎？還是因為剛剛結束的那場戰爭，因為過去數年發生的一切？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "或者……只是為了告別……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "不準備繼續留在倫蒂尼姆了？"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我已經得到了我想要的答案。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "那位親王果然來了倫蒂尼姆。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "軍事委員會的情報網和我們在倫蒂尼姆城內的地下情報網竟然都沒有她的消息，這對我們的行動來說不是一件好事。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "她不為這場爭端而來。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "“玫瑰河畔不再參與巴別塔相關的事務”，這是我訂下的規矩。她絕對不會違背。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "凱爾希，她或許只為送別殿下而來……又或許是為了阻止我和“小聰明”繼續追查下去……"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "隱德來希，那位親王在巴別塔倒塌的前夕突然失蹤，本就已經充滿了疑點。我甚至無法確認她的突然離開是否是特蕾西婭本人的授意。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "在完全確定她的立場之前，羅德島無法排除她干擾我們計劃的可能。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "哪怕我也更願意相信她只為告別而來。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我會找到她，凱爾希，“小聰明”最後為我留下的線索已經夠多了。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "她也欠我一個回答。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "如果你需要協助，我們依舊會很樂意——"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我知道你想說羅德島願意提供幫助。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "但羅德島與巴別塔很不一樣，我並不想讓當年的往事再度糾纏上羅德島。我相信殿下也不會願意。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "使命並不會因為名字的不同而改變，隱德來希。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "羅德島不會繼續走上巴別塔那條注定失敗的道路，但我們也從未否定過巴別塔為我們描繪的理想。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "況且，我同樣也很在乎當年所有的真相。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……謝謝你的善意，勛爵。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "飄蕩的航船終歸需要一個停靠的渡口，對我們而言，那只能是卡茲戴爾……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "杜卡雷所塑造的王庭充斥著令姐妹們不喜的味道，他的血池中遲早會誕生另一個令人生厭的傢伙。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "或許，不久之後，我會牽引著其他航船重新渡過血河，回到殿下親自建造的城市。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我有一種預感，這場戰事結束後的卡茲戴爾比當年的巴別塔更需要我們。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "但想說服你的那些姐妹恐怕不容易，隱德來希，更不用提那位親王還游離在外。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "我相信航船間的約定，哪怕我們之中有許多人都互相看不順眼。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "勛爵，替我將“小聰明”的這片花瓣送回卡茲戴爾。她的家在那裡。"
    },
    {
      "type": "narration",
      "text": "她輕輕張開了自己的手掌，露出一枚晶瑩的血色晶石。她盡可能保留下一位姐妹縈繞在血脈中的思念。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "你擁有我和羅德島的承諾。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "那到時候麻煩來到羅德島時，不准埋怨我。"
    },
    {
      "type": "dialogue",
      "speakerName": "凱爾希",
      "speakerId": "avg_003_kalts_1",
      "text": "羅德島遠沒有你所認為的那麼脆弱，隱德來希。"
    },
    {
      "type": "dialogue",
      "speakerName": "隱德來希",
      "speakerId": "avg_npc_1521_1",
      "text": "希望如此。再會，凱爾希。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
