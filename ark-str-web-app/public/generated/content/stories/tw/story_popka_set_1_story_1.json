{
  "server": "tw",
  "storyId": "story_popka_set_1_story_1",
  "groupId": "story_popka_set_1",
  "stageId": null,
  "title": "玩樂之間",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/memory/story_popka_1_1.txt",
  "sourceHash": "17d77bb4dc0d1a698fef02d1798f4c610ed045d7ced19d31f43b90c28bec84db",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "羅德島本艦，公共休息區廊道"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "結束了耶。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "沒了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那我們什麼時候可以看下一集？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡問問看。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "巫戀姐姐，我們什麼時候可以看到《菲林寶寶》第二十集呀。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "Zzzz......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "她好像看到一半的時候就睡著了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "最近都是這樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "《菲林寶寶》不好看嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "斑點哥哥說，《菲林寶寶》只有小孩子才會看。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "巫戀姐姐可能已經真的長成大姐姐了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我不信！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我們也就差了幾歲！憑什麼前兩集大家能一起看到結束，現在就只有我們兩個了！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "我們也會很快長大的，說不定《菲林寶寶》全集結束的時候，我們就是大人了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡泡長大以後想做什麼呀？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我嗎？我當然是回到部落裡把所有不服氣的人全打一頓然後當上部落勇士啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡想變成超級英雄，一拳一個壞人，兩眼放雷射，在天上想怎麼飛就怎麼飛。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "超級英雄真的存在嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我從來就沒看到有人能眼睛裡放出雷射，也沒有人能在天上飛。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "能打壞人的倒是挺多的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我也能。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡只是希望能變成那樣嘛......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡的眼睛一直在生病，所以泡普卡在想，眼睛如果哪一天能像超級英雄一樣放雷射就好了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那就趕緊把眼睛養好吧，我還挺想看看你的眼睛的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "等病養好了第一個就給泡泡看。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "真的？！好耶！！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "嘻嘻。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "嗯......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "現在幾點了？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "四點半了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "梓蘭姐姐說泡普卡今天可以在休息室玩兩個小時，只剩半小時了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "為什麼只玩兩個小時？每個小時都拿來玩不好嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "每天都要訓練的，還要上課，之後還有作業了，作業不寫完老師要生氣的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "為什麼要寫作業？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "好好學習天天向上呀，大人們都這麼說的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我每天都在船上跑，從來沒聽說過要寫什麼作業。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "而且——作業是什麼？能吃嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "不可以啦。作業是——嗯......泡普卡也不知道作業到底是什麼，只知道寫了會變聰明。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡泡你看看？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "這就是作業？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "嗯。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "不就是一本書嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "裡面塗塗改改都是你做的嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "大部分都是泡普卡塗的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "不過紅色筆記是老師們的批改。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "看不懂。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "喏，還給你。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "要是讓我學這些東西，我立刻從羅德島跳下去跑回薩爾貢找爸爸。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "有人攔著我，我就把他撞飛。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "聽說，前幾天有個米諾斯的姐姐——"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "沒有這回事，你聽錯了！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那個豐蹄力氣才沒有那麼大呢！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "泡泡隨隨便便就把她推倒了！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我說的都是真的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "如果泡泡以泡泡爸爸的名義發誓，泡普卡就相信這是真的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "呃......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "發誓就發誓！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "泡泡以爸爸的名字鄭重發誓，那天泡泡根本打不過米諾斯的豐蹄大姐姐。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "原來是真的啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你不要和其他人說啊，我真的沒那麼弱！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "只是那個豐蹄姐姐太強了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡泡每次發誓就會說實話，泡普卡已經完全理解了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "沒，沒辦法啊，爸爸說了，用人的名字發誓那個人會聽到誓言內容的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "爸爸要是聽到我說謊，絕對會把我屁股打爛的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "那泡普卡用爸爸的名字發誓，泡普卡的爸爸也能聽到嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "不知道哎，你試試看？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡的爸爸，叫——"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "嗯......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡不記得爸爸叫什麼了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "媽媽呢，媽媽也有用的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "不記得了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "雖然凱爾希阿姨說泡普卡是用泥巴捏出來的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "但泡普卡就是覺得自己有爸爸媽媽。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "而且大家都有，沒道理只有泡普卡沒有。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你說的對哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "會不會那個白大褂醫生在騙你啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "凱爾希阿姨應該不會騙人吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那個菲林醫生總是板著臉，看起來就壞壞的，不像我老家薩滿伯伯，見誰都笑呵呵，一看就是好人。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "冷靜不是壞壞哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "你看巫戀姐姐。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "巫戀姐姐也一直板著臉的，但巫戀姐姐很會照顧人。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "上次泡泡吃仙人掌扎了一嘴刺，是巫戀姐姐把你弄暈以後一根根把刺拔出來然後交給醫生的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "哦......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "而且巫戀姐姐很會選蘋果，又大又甜又脆。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "這倒是，她帶的蘋果一直很好吃。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "好吧，你暫時說服我了，巫戀不是壞壞，醫生也不是壞壞。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "但大家都不壞，醫生也沒騙你的話，為什麼你會記不得爸爸媽媽呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "可能是因為泡普卡記性不太好，記不了太多事。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "不過泡普卡有些事還是忘不掉的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "礦場裡哐哧哐哧的聲音，比羅德島大好多的鋼鐵城市，還有許多人圍著的塔。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "有穿著白大褂的醫生、有很多亮閃閃的大鐵塊、有一間安靜的小房間。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "還有一間白白的大房間，中間有張床。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你這不是記得很多嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "可爸爸媽媽的名字，想不起來......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "或許哪天一拍腦袋就想起來了呢，我經常這樣想起事情的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你要我幫忙的話，我可以幫你拍。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我力氣可大了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "咣咣咣咣！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡泡力氣太大，會把我拍傻的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "會嗎？那還是算了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "滴滴，滴滴。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "嗯......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "好無聊啊，巫戀都說夢話了——泡普卡，你的滋嗚嗚能借我玩一會嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "可以啊，但滋嗚嗚今天轉不起來哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "為什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "因為裡面轉圈的東西在維修。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡之前幫哥哥姐姐們鋸東西的時候壞了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那我想想其他好玩的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "泡普卡你就該和我一樣多玩玩，不要去什麼訓練啊上課的了，沒有意思。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "但只有訓練的好，去打壞人的時候才不容易被弄痛哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "而且泡普卡需要幫梓蘭姐姐她們分擔工作的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你太聽話了啦，像我一樣多好，只要拿著盾衝衝衝就可以了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡泡你這樣很容易受傷的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "一開始泡普卡也不懂，只會拿著滋嗚嗚到處亂甩，有時候還會傷到哥哥姐姐們。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "但經過訓練的泡普卡已經完全懂得聽梓蘭姐姐的話了，梓蘭姐姐負責考慮事情，泡普卡負責聽話。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "這樣泡普卡也不會被弄痛，哥哥姐姐也不會被弄痛，多好。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你的哥哥姐姐，很強嗎？有我爸爸那麼強嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "沒有哦。但哥哥姐姐們一直都很照顧泡普卡。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "梓蘭姐姐會給泡普卡梳頭髮，月見夜哥哥會幫泡普卡挑衣服。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "空爆姐姐會帶好吃的，斑點哥哥會挑好看的漫畫書。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "唉——聽上去好像很不錯耶，以後我也要讓博士找那麼多人照顧我。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那你為什麼要拿滋嗚嗚追著他們跑呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "滋嗚嗚？追著哥哥姐姐跑？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡不會做這種事的哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "巫戀也一直說自己是大人了，不可以被人摸頭。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "但有人摸了她還是很開心嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "巫戀？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "......對哦！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我想到了！巫戀的尾巴那麼好玩，我們為什麼不玩？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "又柔又滑，我爸爸座位上的獸皮都沒那麼滑。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "那樣巫戀姐姐會生氣的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "她還沒醒，不會知道的！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "萬一醒了怎麼辦呀？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "切。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那我再想想......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "摔跤怎麼樣？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "梓蘭姐姐說不可以在休息室裡摔跤，會打擾其他人休息的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你怎麼那麼聽話，無聊......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "我會看好......她的......"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你看巫戀，都無聊到不停說夢話了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "到底能不能一起玩點什麼嘛......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我想到了!"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "扳手腕，玩扳手腕總可以吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "又安靜，又可以比力氣，最重要的是——"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "以前我們沒扳過。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "好像可以哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "就這張桌子上，來吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我準備好了！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "我也好了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "3！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "2！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡&泡泡",
      "speakerId": "char_281_popka",
      "text": "1！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "哼！！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "呀！"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我泡泡，扳手腕，就沒輸過......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "哼！！！嘿呀！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "以爸爸的名義！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "扳手腕絕對不會輸的！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "哈啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "嘿呀！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "桌，桌子塌了......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "（小聲）怎，怎麼辦？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "（小聲）我不知道啊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "Zzzz......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "還好還好，沒吵醒睡覺的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "吵醒巫戀的話她絕對會對我下奇怪咒語的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "那桌，桌子呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "桌子讓打掃的叔叔來收拾吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "要是叔叔問了，我們，說，說什麼呀。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "當然說它是自己斷的呀。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "說謊是不好的......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "不說謊會被打屁屁的！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那樣更不好！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "嗚......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "說好了，一會大人們來了，就告訴他們，桌子是自己壞了，好嗎！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "好......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "唔，你眼罩好像有點歪了。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "裡面有點黑黑的......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "（慌慌張張地把眼罩戴好）"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那個黑黑的，是壞石頭嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "應該是吧，泡普卡也沒有摸過。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "梓蘭姐姐和凱爾希阿姨都和泡普卡說過，絕對不可以把眼罩摘下來。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "為什麼呀？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "泡普卡不太記得了......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "那就讓我看看吧，就看一眼，好不好？看一眼就戴上，絕對不會出問題的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "我給你吃糖果，上個禮拜剛剛從紫色沃爾珀胖姐姐那裡拿了盒好吃的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "而且還是你最喜歡吃的夾心小餅乾哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "怎麼樣？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "好吧......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "只能看一下哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "好的！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "嘿嘿！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "唔唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "怎麼了？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "太，太亮了......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "等一下啊，我把燈關掉！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "（睜眼）......"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "可以了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "嗯......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "（摘下眼罩）"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "哇哦，好好看唉！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "是嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "又好看又酷！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "大概是什麼樣的？"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "不知道，反正就是特別酷。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "嗯？裡面好像有點亮亮的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "哦——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "哇，越來越亮了！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "你的眼睛真的好厲害啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "好像有點熱哦。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "......!"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "發生什麼了？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_281_popka",
      "text": "眼罩戴好。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "好的巫戀姐姐。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "speakerId": "char_381_bubble",
      "text": "啊巫戀你為什麼要——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "唉？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "梓蘭已經在休息室門口了，別讓她等太久。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "梓蘭姐姐已經來了嗎，我馬上就過去！"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "不過泡泡大姐頭怎麼辦？"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "我會把她帶回宿舍的。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "好吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "speakerId": "char_281_popka",
      "text": "那我先走啦，再見！"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "再見。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "呼......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "滴滴，滴滴。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "嗯。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "泡普卡沒有問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "嗯。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "我現在就把泡泡帶過來。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "走吧莫提，我們把泡泡拖去醫療部。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "希望她這次能學到點教訓。"
    },
    {
      "type": "dialogue",
      "speakerName": "莫提",
      "speakerId": null,
      "text": "？"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "是的，拖。她太重了，我們背不動。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫戀",
      "speakerId": "char_254_Shamare",
      "text": "走了。"
    },
    {
      "type": "sceneBreak"
    }
  ],
