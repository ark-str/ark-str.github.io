  "blocks": [
    {
      "type": "narration",
      "text": "第十五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......呼。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......躲在這裡，就不會被發現了吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "就算這樣，也沒法再回孩子們那裡去了。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "他們不會有事吧......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "唉，為什麼......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "——！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "是誰？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "是米莎小姐嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......咦？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "抱歉，米莎小姐，希望沒有嚇到你......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "這是我的同事，芙蘭卡小姐和雷蛇小姐。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "你好呀。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "中午好。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "我們是羅德島製藥。作為一個為感染者服務的組織，至少......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "我們也希望能幫到你什麼。所以想和你，交流一下。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "交流一下？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "嗯。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "這裡也不太合適......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "不過現在，最需要的是能保證米莎小姐你的安全。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "這段時間裡，我們會保護你，請不用擔心。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......你在說什麼......啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "不就是把我抓住關起來嗎？！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "走開！我的爪子很鋒利的......！不想受傷的話......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "......噗。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "你......笑什麼......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "如果我們真的想抓你，你是根本沒機會反抗啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "米莎小姐......我們是真的想幫助你，所以才......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "我不相信你......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "龍門對待感染者，比對待罪犯還嚴苛！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "你憑什麼，憑什麼要幫助感染者？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "——米莎小姐，你看......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "你在——幹什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......你......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......你的手......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "你也是......感染者？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "是的，我和你一樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "龍門貧民區藏匿著許多感染者......剛才的孩子們......她們很信任你。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "米莎，你已經讓他們陷入了危險。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......你是想用孩子們威脅我嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "不，我不會。但已經有人這麼做了......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "羅德島剛剛趕走過一批脅迫孩子們的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": ".......！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "龍門同樣也在搜查感染者。等到龍門發現你的話，可能就晚了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "我們想透過你把暴徒們從孩子們身邊引開——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "另一方面，我們也可以保護你，讓你不受傷害。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......你知道他們為什麼抓我？"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "你們......又為什麼要保護我？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "我其實並不太清楚，為什麼會有感染者針對你......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "但是我們也在乎無辜感染者的安全，包括你。至少這樣是目前最好的解決辦法。我也只能希望你能相信我。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "請先允許我們帶你離開這裡，好嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "......那就......走吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": "char_012_misa",
      "text": "畢竟，我沒什麼選擇，是嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "也不是這麼說......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "至少，謝謝你......米莎小姐！"
    },
    {
      "type": "sceneBreak"
    }
  ],
