    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "怎麼會，這麼簡單——"
