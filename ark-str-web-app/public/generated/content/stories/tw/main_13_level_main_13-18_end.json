    {
      "type": "dialogue",
      "speakerName": "血魔大君",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "還有，被篡奪的“魔王”。"
    },
    {
      "type": "dialogue",
      "speakerName": "厄爾蘇拉",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……不論是誰，軍事委員會的計劃都必須被貫徹。"
