    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……！留在倫蒂尼姆的咒文在方才那個剎那崩毀無跡。"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "倫蒂尼姆發生了什麼。"
