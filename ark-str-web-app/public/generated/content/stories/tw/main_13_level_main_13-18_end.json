    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "他想完成儀式的最後一步！"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "——"
