    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（糟了，來不及了！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不好意思，是我稍微佔用了這位先生一點時間。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（——誰？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "（從背後走出來的......這個女人難道剛剛一直就在我身後？！）",
