    },
    {
      "type": "dialogue",
      "speakerName": "路過的旅人",
      "text": "我受不了了！到底還要擠在這裡多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的旅人",
      "text": "我有正式的通行手續，我要求立刻通過這裡！",
