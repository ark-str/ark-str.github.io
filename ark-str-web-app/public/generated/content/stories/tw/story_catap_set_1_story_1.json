    },
    {
      "type": "dialogue",
      "speakerName": "空爆",
      "text": "再會了，各位~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "與其在這裡道歉，不如現在就直接去和當事人說。",
