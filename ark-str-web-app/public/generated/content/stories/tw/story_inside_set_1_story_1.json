{
  "server": "tw",
  "storyId": "story_inside_set_1_story_1",
  "groupId": "story_inside_set_1",
  "stageId": null,
  "title": "機密任務",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_inside_1_1.txt",
  "sourceHash": "1238d3eb9f05a78bc18b8a9ac6322028ce71359c63ab7cabef3afb11958726f2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "前輩，我把手續都辦好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "辛苦你了，新人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我該做的。那位老先生的情況如何了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "（無言搖頭）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "病房裡已經沒什麼我們能做的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "那就是說......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......我們現在的任務是？執行者的話，應該是要替公民執行遺囑吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "當然。這是我們最主要的工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "說到遺囑......里凱萊，聽令！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "是......是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "嗯，這就對了，工作的時候要打起精神來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "我知道這是你的第一次任務，本來不應該給你這麼大的壓力，但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "里凱萊，現在有一項機密任務要交給你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......機密任務？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "沒錯！你拿好這個。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "資深執行者取出一個密封的文件袋，又從便條本上撕下一頁，寫上了一個地址。\n做完這些，她鄭重地將文件袋與便條交到新人的手上。"
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "時間緊急，我需要你現在立刻就出發，務必要在今天之內把這份文件送到這個位址。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "到時候會有人在這裡接應，把東西交給對方就行了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "前輩，這份文件是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "我不能說。一個合格的執行者必須得學會保守秘密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "但我可以告訴你，這個任務非常重要，這個文件袋中的內容......有能夠令整個拉特蘭城陷入動盪的力量......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......令整個拉特蘭城陷入動盪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（真的假的......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "等等，前輩！這麼重要的任務，真的可以交給我這樣的新人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "這、這是不是還是前輩親自來比較好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "不，我還有其他緊急任務，所以只能交給你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "你能通過公證所的選拔，就已經證明了自己有足夠的實力，現在正是需要你發揮實力的時候！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......這算是公證所的轉正考核嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "考核？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "嗯......也算是吧，只要能完成這個任務，里凱萊你就會是一個合格的執行者了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我明白了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "既然前輩都這樣說了，我現在就出發。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "嗯，務必要一路小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "哈哈，我儘量......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "祝你好運啊，新人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（這個地址......看起來應該是在城郊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（理論上來說，穿過這條大街，然後一路順著主路走是最快捷的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（不過在那之前......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "你聽說了嗎？司提望區開了一家新店，據說賣的是全城最好吃的甜甜圈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "我今早特地排隊去買了兩個，你嘗嘗！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的路人",
      "text": "啊，這家我吃過，確實還可以，不過嘛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "不過什麼？別賣關子了，快告訴我啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的路人",
      "text": "比起新開的那家店，在我心裡達利安大叔做的甜甜圈那才是一絕呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的路人",
      "text": "吃過一次就忘不了那味道了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "真有這麼厲害？我可不相信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "這邊這位小哥，你也幫忙嘗嘗這個甜甜圈，是不是你吃過最好吃的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "呃，問我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "不好意思，我趕時間，兩位還是找其他人試吃吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的路人",
      "text": "哎，別走啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "不會佔用你多少時間的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "實習執行者的手下意識地動了動，但很快又放了下來。\n里凱萊調整了一下臉上的神情。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "抱歉抱歉，我真的有急事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "兩位，借過一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "等等......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "（嘖，他怎麼跑這麼快！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的路人",
      "text": "（不能讓他逃了，我們追！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "呼......呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "我不行了......他、他跑哪去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的路人",
      "text": "哈......呼......我哪知道，這小子真能跑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "就說你那招不好用！玩什麼......呼......假裝閒聊蓄意接近啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒聊的路人",
      "text": "我們剛剛就該直接上，強行攔住他把東西搶到手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的路人",
      "text": "現在不是抱怨這個的時候！我......呼......我已經通知了其他人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "閒逛的路人",
      "text": "我們繼續追！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......果然是衝著我來的嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "嗯......確切地說，應該是衝著我身上的什麼“東西”來的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我身上會被盯上的東西，不管怎麼想也只有這份機密文件了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "雖然早就有心理準備，但沒想到這麼快就有人追上來了......奇怪，他們是怎麼確定我的身份和位置的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "聽起來他們還有同夥......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（......！又是誰？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戍衛隊成員",
      "text": "您好，這位先生，打擾一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戍衛隊成員",
      "text": "剛剛我們接到公民報案，說這一帶有人當街搶劫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戍衛隊成員",
      "text": "請問您有看到什麼可疑人物嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我也只是路過，不太清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（這個人恰好站在我要離開的路線上，是有意的嗎......？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戍衛隊成員",
      "text": "可是您是目前唯一可能目擊現場的人，不好意思，請您配合一下我的工作......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "抱歉，我還趕時間！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戍衛隊成員",
      "text": "等等！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的修士",
      "text": "請留步！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的修士",
      "text": "您看起來好像有什麼困擾的樣子，有什麼是我可以幫助您的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（又來了一個。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "呃......要說困擾的話，現在的情況就挺讓人困擾的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我真的還趕時間，兩位如果沒什麼其他事情的話，我就不奉陪了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戍衛隊成員？",
      "text": "站住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的修士？",
      "text": "不能讓你就這麼走掉呢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......啊哈哈，這是什麼意思啊兩位......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的修士？",
      "text": "別裝傻了，我們的目標你心裡應該很清楚吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的修士？",
      "text": "把你手上的東西交出來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（哎呀，這真是......來者不善啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（但是奇怪，他們的神情裡沒有太多敵意。這個任務到底......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "唉，不管怎麼說，這也是我在新職場的頭一個任務......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "可不能就這麼搞砸了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戍衛隊成員？",
      "text": "要動手嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戍衛隊成員？",
      "text": "那就讓我見識一下公證所執行者的銃有幾分準頭。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "這個嘛，在城區內，我想還是儘量別鬧得太嚴重吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "要對付兩位，空手就足夠了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "里凱萊，這段時間你在戍衛隊的表現我都瞭解了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "作為士兵來說，你的成績非常優秀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "感謝閣下的誇獎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "......只做個士兵，你就滿足了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "呃，閣下的意思是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "你確實把自己的工作完成得很好，但我們拉特蘭並不缺少一位士兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "我們不是因為想要一位士兵，才把你從那個敘拉古的邊境小鎮帶回拉特蘭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "在你看來，拉特蘭如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......拉特蘭城......很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "比我想像中的還要好數倍，不僅是生活富足這方面，還有......嗯，這裡存在某種秩序，大家都在其下有序地生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "你指的是我們的戒律？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我想應該是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "雖然經常能看到有人想炸掉街邊的什麼裝飾，大家還很喜歡圍觀，但這好像也不是什麼壞事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我的意思是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "不是那種會有人死，會有人受傷，會整條街亂成一團讓人無法生活的那種壞事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我很喜歡這裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（......到這裡應該就沒問題了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（把人塞進垃圾桶應該沒什麼問題吧？至少人都還活著，嗯，應該沒事......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（又是機密任務，又是攔路搶奪......哈哈，這難道算是真正的拉特蘭人的生活？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（這才是入職的第一個任務，就出了這麼多事......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（不然還是去求求教宗騎士閣下，讓我轉回戍衛隊吧。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（趕快把東西送到，然後就......嗯？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......居然又有人來了嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "站、站住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "我不能讓你通過這裡......呃，不，那個，總之站住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "把那個東西交出來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（......嗯？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（看不出太多專業鍛煉過的痕跡，作為劫道者來說，這種表現不太合格。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（難道說這也是一種偽裝？總覺得有點不對勁......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "不好意思，請問你指的是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "當然是你手上的那個文件袋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "如果你想要的是這個文件袋，不好意思，我不能答應。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "這是我的職責所在，還請你理解......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "......我也有必須要這麼做的理由......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "如果你不主動交出來的話，那我只好動手了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "哎！一言不合就動手可不好......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "嘶......！放開我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "抱歉，不可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "你剛剛進攻的動作不太標準，下盤不穩，力道也不足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我聽說......拉特蘭的基礎教育課程裡應該有格鬥這一門課？兄弟，你是怎麼畢業的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "只要及格就行了啊！我又不想從事什麼危險行業......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "你快鬆手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "不想從事危險行業？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "這話在你試圖打劫一個執行者被抓現行之後說，可能有點缺乏說服力......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "這樣吧，你告訴我是誰派你還有其他人來搶我手上的東西，我就放開你，如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "這......不行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "我不能告訴你，你根本不知道你手上拿著的是什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "據說是有“令整個拉特蘭城陷入動盪的力量”的什麼東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我猜，或許是什麼武器的製造圖紙之類的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "要這麼說也沒錯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "總之你死心吧，我是什麼都不會說的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "你說得不錯，這正是拉特蘭有別於其他國家之處。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "你說拉特蘭如此特殊，那麼，你自己又如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我是個薩科塔，也......算是個拉特蘭人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "這個理由不足夠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "......唔，去公證所吧，里凱萊，我會幫你開一份推薦信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "不僅是做一個旁觀者，你該去親身體驗一下，什麼才是真正的拉特蘭人的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "真正的拉特蘭人的生活......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "我確定你會喜歡的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我已經在路上耽誤了太久，必須要抓緊時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "如果不是在拉特蘭，本應該能夠更加方便快捷地解決麻煩......我真的不是很喜歡太費勁的處理方式來著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "......你、你這話是什麼意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我的意思是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "見習執行者抽出腰間的銃，滿臉遺憾地將其抵在對方的眉心。"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "今天天氣真好，我本來真不想這麼幹的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "您好，這裡是中庭公證所，請講。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "之前的那件委託嗎？現在我們的執行者正在執行任務的途中，今日內將會完成委託人的請求。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "......出現意外狀況？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "我明白了，我現在立刻去處理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "請您放心，雖然我們的新人才加入不久，還有不少要學習的內容，但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "我相信里凱萊，他一定可以完成任務。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "......我沒事......？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "哇啊！要、要塌了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "那傢伙......居然用銃把承重柱打穿了？！這也太亂來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "嘶......胳膊都差點被他擰斷了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "喂，是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "我也失敗了，沒能攔住他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "唉......早就說了，我怎麼可能攔得住執行者嘛，更不要說搶東西了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張的青年",
      "text": "不過，我們都已經這麼努力了，達利安叔叔應該也會滿意了吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（好險，差一點就沒忍住......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（這裡是拉特蘭......不能再像之前那樣幹了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（......呼......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（......目的地就在這前面了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "打擾了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "你好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "（這裡沒有其他人了，應該沒弄錯吧？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "請問，您就是遺囑的接收人......？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "是的，我是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "謝謝你能把它送到這裡來，年輕人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "您客氣了，這是我的工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "那麼依照委託，這個文件袋請您收下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "你不好奇這裡面裝著什麼嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "這......聽說是很重要的東西。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "是的，是的......是非常有價值，非常寶貴的東西......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "那可能不太合適讓我知道......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "啊，在我看來，一件物品珍貴與否，並不在於有多少人知道或擁有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "一會等到人來齊，我就會當眾宣讀其中的內容。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "當眾宣讀？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "呵呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "年輕人，你不妨打開它看一看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......真的可以嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "當然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "蛋一枚，配砂糖三勺，酵母少許......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "麵粉一杯......楓糖兩勺......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......這是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......一份甜甜圈的配方？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "是的。不錯的配方，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "我們家的那一位，當年就是拿著這張秘方來和我求婚的哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "那個時候，他被我的家人和好友一路圍追堵截，來的時候整個人狼狽極了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "您的丈夫......就是這次的委託人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "（輕輕點頭）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "我們並沒有孩子，當然，這對我們來說不算是什麼遺憾，兩人相處的日子已經足夠令我感到幸福。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "只是，我們都不願讓這份配方上記載的味道，在我們離開後於拉特蘭消失。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "就算是這樣，也不必向執行者隱瞞內容吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "現在想想，路上遇到的那些人，應該也都是安排好的吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "呵呵，請你把這當做是外子最後的任性，原諒他吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "我想，他一定以為我還不知情，想再給我一個驚喜，然後在大家的祝福之中，讓這份配方得以延續吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "我做了一些甜甜圈，請嘗一個吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅的老婦人",
      "text": "你一定會喜歡的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "感覺如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "抱歉，之前沒能告訴你實情，這也是委託人遺囑的一部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "前輩......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我還是不太明白，拉特蘭人為什麼總會做些完全沒有必要的事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "你之前提到過自己喜歡甜食吧？當然啦，拉特蘭就沒幾個人不喜歡的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "委託人老爺子好像也聽到你這麼說了，所以他最後提到，希望由你來負責護送那份配方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "如果你願意把它學會，經常製作，那就更好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "這就是拉特蘭人。你要是繼續幹下去，今後還會遇到更多這樣的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "怎麼樣，你不喜歡這份工作嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "里凱萊",
      "text": "我很喜歡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "哈哈，那太好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "公證所職員",
      "text": "恭喜你順利完成委託，新人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
