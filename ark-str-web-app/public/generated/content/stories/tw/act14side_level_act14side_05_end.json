    {
      "type": "dialogue",
      "speakerName": "莫希",
      "speakerToken": "avg_npc_255_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你的行動已經沒有那麼流暢了吧。只要我再射中你一次，就......"
