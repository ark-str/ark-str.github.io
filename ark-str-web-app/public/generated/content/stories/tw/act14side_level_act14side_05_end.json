      "speakerName": "恩希歐迪斯",
      "speakerToken": "avg_172_svrash_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "還不願意露出真容嗎？難道是我看錯了？"
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士？",
      "speakerToken": "avg_npc_284_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
