    {
      "type": "dialogue",
      "speakerName": "莫希",
      "speakerToken": "avg_npc_255_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "可惡......你的那根手杖竟然能切開箭矢......"
