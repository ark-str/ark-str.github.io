    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "speakerToken": "avg_172_svrash_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "在這樣的情況下？"
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "speakerToken": "avg_172_svrash_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "正面交鋒下，你有幾分自信能夠射中我的要害？"
