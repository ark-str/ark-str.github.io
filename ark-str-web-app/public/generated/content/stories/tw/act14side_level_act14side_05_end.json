{
  "server": "tw",
  "storyId": "act14side_level_act14side_05_end",
  "groupId": "act14side",
  "stageId": "act14side_05",
  "title": "獵場",
  "storyCode": "BI-5",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act14side/level_act14side_05_end.txt",
  "sourceHash": "bc9bbcc966e977d0fa0ae29fe9b08283ee326a192a82ed2406d2d028d3458470",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "接下來的行動準備好了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "諾希斯大人......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......我可以問一個問題嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "真少見，這是不是你頭一次提出問題？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "你說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......屬下僭越。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "只是，若按照我們的計畫行事，事後追查起來，布朗陶家恐怕也將受到牽連。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "屬下......屬下只是擔心，如今諾希斯大人與布朗陶家結成同盟，若是布朗陶家遭發難，是否會對諾希斯大人的計畫不利......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "你說的問題我也考慮過，不過無妨，布朗陶家如何從來不是重點，這次機會十分難得，我不希望錯過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "但我也希望你能保全自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "如果真的出現最壞的情況，不需要考慮布朗陶家的問題。我瞭解恩希歐迪斯，只要你的證詞對他有利，他大概暫時不會動你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "到時我會安排人手確保你的安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "諾希斯大人！我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "......怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "如果你有顧慮，計畫也可以換人執行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......不！請讓我來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "只要是諾希斯大人的吩咐......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "莫希在所不辭。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "年長的謝拉格戰士",
      "text": "這下總算是把那些野獸全部解決了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年長的謝拉格戰士",
      "text": "有一兩個小子受了點傷，但沒什麼大礙......多虧了聖女大人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我並沒有做什麼。是各位出色地證明了自己的勇武，想必耶拉岡德也會為祂的勇士們自豪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年長的謝拉格戰士",
      "text": "您、您過獎了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年輕的謝拉格戰士",
      "text": "聖女大人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "嗯？你是......剛剛的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年輕的謝拉格戰士",
      "text": "是我。多謝聖女大人方才救了我一命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "聖女大人！您剛剛確實是太冒險了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "但還是感謝您，感謝您救了這個混小子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "耶拉岡德的子民之間本就應當如此，不必言謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年輕的謝拉格戰士",
      "text": "......聖女大人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "確實是精彩的一箭。我還不曾聽聞聖女大人竟還有這樣的本領......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "聖女原本就應有保護雪山民眾的能力，這並不是什麼值得特別提及的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "您就是太謙虛了！方才的那一箭，我看完全能與我們謝拉格最善射的戰士比個高下！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士",
      "text": "聖女大人！阿克托斯大人，菈塔托絲大人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士",
      "text": "不、不好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "亂喊什麼？我們好得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "你是希瓦艾什家的人？怎麼，又出什麼事了，總不會是你們也遭到野獸襲擊，他恩希歐迪斯還要來找外援吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士",
      "text": "不、不是野獸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "那究竟是怎麼回事，不要吞吞吐吐，快說清楚！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士",
      "text": "是！是恩希歐迪斯大人遭刺客襲擊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "......你說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "恩希歐迪斯他被襲擊？竟有人敢在聖獵這樣的場合對他動手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......留下一半人手保護聖女，保持警惕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "其餘的人，跟著我走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "等等，阿克托斯！你發什麼瘋？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "你要幹什麼，難道你真要去救援？且不說恩希歐迪斯他需不需要，就現在的情況......你想清楚了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "......沒什麼好想的，菈塔托絲，我知道你的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "但我，我不管他恩希歐迪斯如何，他是真心悔改也好，假意做戲也罷，有人要在聖獵作怪，我阿克托斯絕不允許！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "——我族世代立有保護謝拉格的誓言，聖獵儀式的秩序也在此之列！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菈塔托絲",
      "text": "真是莽夫......罷了，我倒是要看看，你這好心能換來什麼結果。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "恩希歐迪斯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士",
      "text": "恩希歐迪斯大人！血......您受傷了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "無妨，不要驚慌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士",
      "text": "但是您的傷......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "小傷罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "很出色的隱匿技巧，出其不意......沒想到竟會有人在聖獵中動手，確實是我大意了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "怎麼，不出來嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "既然有膽量挑這種場合動手，便是對耶拉岡德的大不敬之舉，應當早有覺悟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "怎麼，難道沒有想過嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......不必用這種方法激我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "我既然敢動手，當然早想過後果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "恩希歐迪斯，今天我走不出這片獵場，你也休想能夠安然離開！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "看來你的決心不假。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "不用你說！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "恩希歐迪斯，你裝作虔誠，實則對耶拉岡德沒有半點敬畏之心，你對謝拉格造成的傷害大家都看在眼裡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "這樣的說法倒是很少當面聽到人說。眼下的謝拉格，會對我敵意如此之大的人並不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "會有這樣的指責，若不是被觸及了利益，就是真正虔誠的極端信者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "你認為自己屬於哪一邊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......你怎麼以為我會乖乖告訴你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士",
      "text": "恩希歐迪斯大人，小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "少妨礙我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "很遺憾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "這些忽然發狂的野獸也是提前準備好的吧？聖獵中，我隨行的護衛不多，若他們都被絆住手腳，這確實會是個難得的好機會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "但......看來你的機會到此為止了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......你這是在小看我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "你已經被我傷到，就算你再怎麼輕描淡寫，也沒法瞞過我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "你的行動已經沒有那麼流暢了吧。只要我再射中你一次，就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "在這樣的情況下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "正面交鋒下，你有幾分自信能夠射中我的要害？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......嘖......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "試試不就知道了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "可惡......你的那根手杖竟然能切開箭矢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "你是在耍我嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "不要誤解。我並沒有要看輕你的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "你做了很好的前期準備和規劃，但所有計劃都要面對實踐的考驗。紙面上的安排經常會被最直接的暴力打破。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "我希望所有事情都能在交涉中體面解決，但我的同行者中就有具備此種暴力之人，歸功於她，我對這樣的人非常瞭解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "你到底在說什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "還不願意露出真容嗎？難道是我看錯了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謝拉格戰士？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "切開箭矢確實有點難度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "你是——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "不過這只是工作的一部分，恩希歐迪斯先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "所以你們還繼續打嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "這不取決於我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "現在收手是最好的選擇，至少不會傷及性命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......別假裝好心，真讓人不舒服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "你不就是想從我這裡拿到情報，想知道是誰要對你下手？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "你說的問題我也考慮過，不過無妨，布朗陶家如何從來不是重點，這次機會十分難得，我不希望錯過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "但我也希望你能保全自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諾希斯",
      "text": "如果真的出現最壞的情況，不需要考慮布朗陶家的問題。我瞭解恩希歐迪斯，只要你的證詞對他有利，他大概暫時不會動你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "莫希，莫希！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你又去哪兒了！快來幫我看看這次的計畫，這回我一定要讓菈塔托絲對我刮目相看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哎，莫希！還是你靠得住，那些人背地裡都罵我傻，哈，別以為我真的不知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "莫希，你說我真的能替布朗陶家做點什麼嗎？一定能行的對吧，對吧？......嗯！我就知道你不會騙我的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "莫希......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫希",
      "text": "——你休想！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一如她往常的迅捷輕靈，彷彿只是躍過一條小溪，又像是跳下一棵矮樹。\n那抹黑色的身影在眨眼間躍起，落下，消失在山崖間。"
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "......她跳下去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "出乎意料的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "你沒有阻攔她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "我接到的任務裡不包括這一條。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "而且你看上去也並不吃驚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "能提前在獵場佈局的人選不多，要找證據，多少都能找得到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "雖然還是有人證在最省力......不過證人的生死倒也沒有那麼重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "......你的那幾個手下人都不在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "或許是都被發狂的野獸攔住了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "關於這一點，還要替我多謝博士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "老爺！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "情況怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "都解決了。有人受了點傷，但沒什麼大礙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "魏斯那邊剛剛傳了消息——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "Sharp先生，你怎麼會在這裡......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "任務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "是博士的吩咐？難道博士竟預料到會有這樣的事發生......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "你是怎麼認出我的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "這不是難事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "我說過。我對存在本身就能破壞局面的戰士，非常瞭解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "恩希歐迪斯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "你怎麼樣，刺客人呢？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "阿克托斯，你會趕來實在出乎我的意料，這是否是希瓦艾什與佩爾羅契重歸於好的徵兆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "呸！我來，與你沒有半點關係！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "我不過是要將膽敢在耶拉岡德的祭典上作亂的卑鄙小人親手揪出！讓他付出應有的代價！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "你確實是耶拉岡德最虔誠的信徒，阿克托斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "不過，恐怕你來遲了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "你這是什麼意思？你恩希歐迪斯沒道理會放走區區一個刺客，人到底被你藏哪裡去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "等等，這片懸崖......難道？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "就是你想的那樣，阿克托斯。我的部下會去搜索對方的蹤跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "繼續狩獵吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿克托斯",
      "text": "地上有血，你受傷了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "小傷而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "老爺，你的傷得立刻處理！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "至少......至少要先止血！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "繼續狩獵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "耶拉岡德的祭典，不應因我個人緣故而有任何閃失。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩希歐迪斯",
      "text": "通知其他人，一切照常。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "角峰",
      "text": "......是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在眾人矚目之下，希瓦艾什家年輕的主人邁開腳步。\n風雪縈繞在其周身，又在其頷首仰頭間四散，未有任何一冊經卷曾記載這樣一種身姿。\n斑駁的赤色在他身後由深到淡，最後歸為純白的印記，融入山川。\n無人敢攔，無人可阻。\n恩希歐迪斯向前走。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
