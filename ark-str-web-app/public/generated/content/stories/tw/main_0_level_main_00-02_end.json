  "storyId": "main_0_level_main_00-02_end",
  "groupId": "main_0",
  "stageId": "main_00-02",
  "title": "守衛",
  "storyCode": "0-2",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_00-02_end.txt",
  "sourceHash": "8da57fdd07af9935e0f65c2e3e96c6e55a27dc8194b4e0a13da569d66da0537e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "哈，哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "整合運動還真是......精力旺盛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "你們，是什麼人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "怎麼會這個時候，出現在切爾諾伯格！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "哈？怎，怎麼回事——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "間諜嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（如果洩露了身份，被烏薩斯當局盯上，後果不堪設想！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（必要的話......！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "——小女孩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "你......感染者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "別動！放下武器！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（做好防護準備，一旦對方有敵對傾向......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "（煙霧？從哪裡......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "先生，對我們抱有敵意的人究竟是誰，你應該很清楚！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "杜賓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "重裝幹員！敵襲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "什，什麼？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......整合運動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "阿米婭，小心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "她和那些普通的感染者暴徒，不是一回事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哼，逃跑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "又能逃到哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "去，撕碎他們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "——————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "就連手下的整合運動成員也是一副訓練有素的樣子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "難道是，整合運動的頭目嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "霧氣越來越濃了......想借助霧氣發動奇襲嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "軍警先生，我們必須立刻撤離這個區域！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "如果讓他們封鎖了我們的退路，我們就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "你們這些感染者，都給我滾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "我得到的命令是防衛這條大街。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "感染兔子，我不管你們來這裡有什麼目的，想幹什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "如果你們是來破壞我們的城市的，自然會有人懲罰你們。烏薩斯的憤怒是無休止的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "如果不是，那這裡發生的事情，和你沒有關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——我知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "每個烏薩斯人都知道，不把背脊朝向敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "快滾！我們沒空理你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "謝謝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "杜賓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "走！去第一會合點！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "各小隊！動作要快！快！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "來啊！感染者混球！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "烏薩斯軍警隊長",
      "text": "你們就這點本事嗎？只會站在那裡看著嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "切爾諾伯格人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "該死。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
