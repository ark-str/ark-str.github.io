{"server":"tw","storyId":"main_0_level_main_00-02_end","groupId":"main_0","stageId":"main_00-02","title":"守衛","storyCode":"0-2","avgTag":"行動後","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_00-02_end.txt","sourceHash":"8da57fdd07af9935e0f65c2e3e96c6e55a27dc8194b4e0a13da569d66da0537e","bodyAvailable":true,"blocks":[{"type":"narration","text":"第二关（后）"},{"type":"background","backgroundId":"bg_cher_1"},{"type":"dialogue","speakerName":"近衛幹員","speakerId":"char_013_riop","isRemote":false,"text":"哈，哈......"},{"type":"dialogue","speakerName":"近衛幹員","speakerId":"char_013_riop","isRemote":false,"text":"整合運動還真是......精力旺盛！"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"你們，是什麼人？"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"怎麼會這個時候，出現在切爾諾伯格！"},{"type":"dialogue","speakerName":"近衛幹員","speakerId":"char_013_riop","isRemote":false,"text":"哈？怎，怎麼回事——"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"間諜嗎！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"（如果洩露了身份，被烏薩斯當局盯上，後果不堪設想！）"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"（必要的話......！）"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"先生。"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"——小女孩？"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"你......感染者？"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"別動！放下武器！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"（做好防護準備，一旦對方有敵對傾向......）"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"（煙霧？從哪裡......）"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"先生，對我們抱有敵意的人究竟是誰，你應該很清楚！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"杜賓！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"重裝幹員！敵襲！"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"什，什麼？！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_1502_crowns","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......整合運動。"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"阿米婭，小心......"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"她和那些普通的感染者暴徒，不是一回事！"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_1502_crowns","isRemote":false,"text":"哼，逃跑......"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_1502_crowns","isRemote":false,"text":"又能逃到哪裡？"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_1502_crowns","isRemote":false,"text":"去，撕碎他們。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":null,"isRemote":false,"text":"——————"},{"type":"background","backgroundId":"bg_cher_1"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"就連手下的整合運動成員也是一副訓練有素的樣子......"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"難道是，整合運動的頭目嗎？"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"霧氣越來越濃了......想借助霧氣發動奇襲嗎？"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"軍警先生，我們必須立刻撤離這個區域！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"如果讓他們封鎖了我們的退路，我們就......"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"你們這些感染者，都給我滾。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"我得到的命令是防衛這條大街。"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"感染兔子，我不管你們來這裡有什麼目的，想幹什麼。"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"如果你們是來破壞我們的城市的，自然會有人懲罰你們。烏薩斯的憤怒是無休止的。"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"如果不是，那這裡發生的事情，和你沒有關係。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"——我知道了。"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"每個烏薩斯人都知道，不把背脊朝向敵人。"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"快滾！我們沒空理你們。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"謝謝。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"杜賓！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"走！去第一會合點！"},{"type":"dialogue","speakerName":"杜賓","speakerId":"char_130_doberm","isRemote":false,"text":"各小隊！動作要快！快！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_1502_crowns","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"來啊！感染者混球！"},{"type":"dialogue","speakerName":"烏薩斯軍警隊長","speakerId":null,"isRemote":false,"text":"你們就這點本事嗎？只會站在那裡看著嗎？"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_1502_crowns","isRemote":false,"text":"切爾諾伯格人......"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_1502_crowns","isRemote":false,"text":"該死。"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米婭"]},{"speakerId":"char_013_riop","aliases":["近衛幹員"]},{"speakerId":"char_130_doberm","aliases":["杜賓"]},{"speakerId":"char_1502_crowns","aliases":["？？？"]}]}
