      "type": "dialogue",
      "speakerName": "赫默",
      "speakerToken": "avg_108_silent_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "是的，我們驗證了無數次，這種液體結構非常難破壞。"
