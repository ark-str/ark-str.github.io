    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "speakerToken": "avg_135_halo_1#12$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "電自己一下原來真的有用，至少恢復了短暫的知覺......"
