      "type": "dialogue",
      "speakerName": "埃琳娜",
      "speakerToken": "avg_135_halo_1#12$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "喬伊絲......奧利維亞，我......我快拉不住她了......"
