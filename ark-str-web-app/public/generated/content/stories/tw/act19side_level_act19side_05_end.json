      "speakerName": "埃琳娜",
      "speakerToken": "avg_135_halo_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "speakerToken": "avg_108_silent_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "埃琳娜，假設我們眼前的就是源石技藝造物，那施術者在哪裡？"
