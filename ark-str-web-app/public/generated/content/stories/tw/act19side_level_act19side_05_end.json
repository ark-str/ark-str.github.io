    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "speakerToken": "avg_135_halo_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "還有更壞的消息。"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "speakerToken": "avg_135_halo_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "我有沒有提過？我們頭頂......整個實驗區，存儲了更多同種物質......總體積是我們面前這些的上萬倍。"
