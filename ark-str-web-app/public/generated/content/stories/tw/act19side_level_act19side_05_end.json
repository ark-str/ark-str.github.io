    {
      "type": "dialogue",
      "speakerName": "赫默",
      "speakerToken": "avg_108_silent_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "控制它們的並不像是多蘿西。它們只是陪伴在她身邊而已。"
