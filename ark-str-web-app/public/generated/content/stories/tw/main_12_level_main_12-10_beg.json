          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這關乎羅德島未來的立場。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "伊內絲",
          "speakerId": null,
          "text": "......我明白你的意思了。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "先生，要找張椅子嗎？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "speakerId": null,
          "text": "不用了，我喜歡站著。"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "speakerId": null,
          "text": "羅德島的博士，你給我惹了個大麻煩。亞歷山德莉娜殿下的身份......在維多利亞很敏感，你應該很清楚這一點。"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "speakerId": null,
          "text": "我以為，對於這件事，我們是有默契的。"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "speakerId": null,
          "text": "不過，唉，這件事我們可以暫時先放一邊......"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "speakerId": null,
          "text": "能向我介紹一下剛剛離開的那位匆匆忙忙的藍髮小姐嗎，羅德島的博士？我想認識認識。"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰禮帽”",
          "speakerId": null,
          "text": "也許我能和她跳支舞。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
