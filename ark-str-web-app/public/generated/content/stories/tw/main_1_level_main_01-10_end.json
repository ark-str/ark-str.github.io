  "blocks": [
    {
      "type": "narration",
      "text": "第十一关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "已經突破了整合運動的攔截！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "但是——他們——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "......我......啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "噓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......別讓阿米婭她們聽見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "阿米婭心裡清楚得很！她比我們想像的成熟得多......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......嗯......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "就算這樣，也不能讓她聽見！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "再去加深她內心的煎熬是不明智的。她已經背負......太多東西了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......不要讓......他們的努力白費！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "既然他們讓我們活下來，我們就應該讓博士和阿米婭......安全回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "還不是垂頭喪氣的時候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "作為耀騎士，無論在什麼時候，都該成為指引眾人的光吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "——我不清楚。但，我會去做我該做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臨光",
      "text": "重整隊形！不要懈怠！我們就快到了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "呵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "嘴裡說著讓我放心的人，真的一個都沒回來過。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "{@nickname}博士......？發生了......什麼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "請，請放我......放我下來吧......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "嗯，沒問題我可以自己走......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我只是......失去意識了一會兒......沒事的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......我們逃出來了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "Ace他們......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是嘛。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "沒關係的。如果是Ace的話，一定沒問題的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "羅德島的大家，都是很強的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "已經，快到南方出口了。只要撤出切爾諾伯格，我們就......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們......就......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士......能......讓我靠一下嗎......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "一下......一下就好......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "塔露拉",
          "text": "————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔露拉",
          "text": "難纏。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "竟然......能，能做到這一步......這傢伙......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "半個街區被燒成焦炭，整個廣場都陷入火海......鋼鐵被融化又重新凝固......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "但他為什麼......還能戰鬥？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "奮戰至屍骨無存——了不起。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔露拉",
          "text": "我記住了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塔露拉",
          "text": "......羅德島。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
