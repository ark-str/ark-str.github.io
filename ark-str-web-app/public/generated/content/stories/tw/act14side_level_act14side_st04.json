{
  "server": "tw",
  "storyId": "act14side_level_act14side_st04",
  "groupId": "act14side",
  "stageId": "act14side_st04",
  "title": "封盤",
  "storyCode": "BI-ST-4",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act14side/level_act14side_st04.txt",
  "sourceHash": "a38ce311e8f825bc7eff1306f8a009b43f1cc1716e63b5241a3aa9ea4e107d9c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "level_act14side_st04"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "數千年前，耶拉岡德降生在這片土地，將這裡命名為謝拉格，並始終守護著這片土地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "千百年來，祂的教誨無時無刻不在影響著謝拉格的人民。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "祂將血肉賜予佩爾羅契家，將皮毛賜予布朗陶家，將骨骼賜予希瓦艾什家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "但我們有一個共同的名字——謝拉格人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "對祂的信仰，是謝拉格的根基，也是今時今日，我們能夠站在這裡，共同自稱謝拉格人的理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "我們心中共同懷揣著對祂的敬仰，攜手在這片土地上生存至今。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "但是，我們如今已經知道，這片大地上並非只有謝拉格一個國家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "在這片雪山之外，還有廣闊的天地，那裡有著和我們長相不同，語言不同，且並不信仰耶拉岡德的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "在過去，我們在如何與這樣的人接觸這一點上，產生了巨大的分歧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "但這分歧並不是危機，而是祂對我們的考驗，同時也是祂對我們的教導。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "祂作為謝拉格全體人民信仰的對象，是我們的母親，是我們的守護神。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "因為母親，絕不會希望看到自己的孩子停滯不前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "所以——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不要因為貪戀舊的而不去嘗試新的，你是祂的子民，你當充滿勇氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不要因為懷戀家鄉而不去探尋新的土地，無論你身在何處，祂都與你同在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "不要因為已經擁有財富而不去冒險，你本可以擁有更龐大的財富。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "因為，祂是包容的，祂所守護的這片土地理當是包容的，祂的子民，更應是包容的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "以祂賜予我的權柄，我在此鄭重宣佈：",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "蔓珠院將接受外國人士對耶拉岡德的信仰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恩雅",
      "text": "並且，蔓珠院鼓勵民眾以自己的方式追求更美好的生活。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "為紀念喀蘭聖女、神啟者、應被稱頌者恩雅·希瓦艾什面向全謝拉格人民的極具感染力的演講。\n這一日，被定為謝拉格的國教日。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（移動棋子）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "......谷地一事，原本只是一手閒棋。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我需要一個人引開佩爾羅契家的注意力，讓我得以暗中調遣物資和人員。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "這個人若不是你，也會是別人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "原本，事後我打算就此事向你致歉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "不過現在看來，我或許更該為輕視了你能產生的影響而道歉。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "恩希歐迪斯自顧自地說著，移動了一枚棋子。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（移動棋子）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "諾希斯是我的摯友，同時也是合作者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "他的想法和我並非完全一致，他有他的想法和做法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "但我瞭解他。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "只要目的一致，他就不會背叛我，甚至不必在計畫中和他交換情報。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我可以放心地任由他動用一切資源，選擇他認為高效的方式，絆住布朗陶家的力量。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "破壞鐵軌是一著妙手。諾希斯既取得了菈塔托絲的信任，也封鎖了他國的間諜與信使進出的道路。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "恩希歐迪斯看了你一眼，移動了一枚棋子。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（移動棋子）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "和棋。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "彷彿是預示了結局一般，恩希歐迪斯將手脫離棋子，攤開雙手。\n示意本局已經結束。"
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "看來，最近我的時運確實不太好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "連下棋都開始贏不了了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你並沒有輸。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "有的時候，和意味著大勝，而有的時候，和則意味著大敗。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "對你來說，這樣的結果是大勝，還是大敗？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "......對我來說，向來是若未取得大勝，就等同於大敗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "不過這一次，確實是例外。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我的勝利毋庸置疑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "但沒想到的是，你為我的勝局開拓了另一種可能性。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "另一種可能性。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "是的，另一種。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "我本以為這樣的結果不可能實現，但你竟在一無所知的不利境況下看破並影響了局面。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "即使這沒有改變我勝利的事實。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "也許是太久沒有棋逢對手，旗鼓相當的對局確實令我心潮澎湃。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "我沒有能力說服聖女下山。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "聖女——不需要別人為她做出決定。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "但是，你在合適的時候推了她一把，為她提示了一個方向。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "並且，你還為她搭建好了舞台。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "你想告訴我，這一切都是你的無心之舉？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "我只是想避免傷亡。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "而你確實達成了這個目的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "主動接觸阿克托斯和菈塔托絲，為他們進行戰前預估，並提供了更優的避免開戰的方案。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "確實很有你的風格，博士。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "即便是我，也沒有預料到，這一次的事情，能以這樣和平的方式收場。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "想必你已經知道，我為什麼如此急於讓謝拉格成為一個整體。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "外憂。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "不錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我並沒有那麼痛恨蔓珠院，或是急於將信仰從這片土地上根除。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我也沒有那麼不滿阿克托斯的排外，菈塔托絲的躊躇。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "他們不知道外面正在發生什麼，也就不可能與我有相同的看法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "如果時間充足，我不介意花上五年十年甚至更長的時間，去改變他們的想法，去用更溫和的方法改變謝拉格。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "但是——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "謝拉格沒有那麼多時間。即便或許稱不上富饒，也一定會有鄰國盯上這片不受天災侵擾的土地。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我必須加快步伐，而如果有誰不能接受，那我就只能剝奪他們反對的權力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "僅此而已。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你不必說服我。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "只是與我認為值得分享的人分享一些我的想法罷了。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "這些與我無關。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "恩希歐迪斯",
              "text": "你以一個旁觀者的身份洞察了這一切，所以我才能放心與你談論這些。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "據我所知，阿克托斯會宣佈對給大長老下毒負責，並辭去家主之位。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "他之所以這麼大方，是因為他決定主動向聖女宣誓，佩爾羅契家的土地將由聖女參與管理。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "恐怕是想要鞏固聖女的地位吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "布朗陶家與希瓦艾什家的從屬協約即將簽訂。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我可以對你多透露一些，我並沒有吞併布朗陶家的打算，如果菈塔托絲願意，她的權力不會比過去少多少。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "不再有渴望停滯的人、堅守不前的人與權衡利弊的人阻擋喀蘭貿易和謝拉格的發展。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我可以接受這個結果，博士。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你與聖女之間，並沒有那麼大的隔閡。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "......但我們終究選了兩條路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "並且，這是我過去的選擇帶來的結果，我會為這個選擇負責。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "而她也必須背負起她的選擇，讓謝拉格人在她的指導下而非我的策動下，走出這片凝滯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "你向我、向謝拉格證明了你自己，也證明了......恩雅。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "切斯特",
          "text": "總裁，會議的時間快要到了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "無論如何，謝拉格將會迎來巨大的改變，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "我接下來可能很難抽空與你見面。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "但我可以向你保證，羅德島可以在謝拉格的任何角落暢行無阻——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "另外，作為對將你與其他幹員捲進這次事件的補償，同時也是我對你誠意的證明。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "羅德島這個名字，以及博士你們的名字，不會出現在未來任何與本次事件有關的官方記錄中。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "並且，一份新的，能夠讓你我從此互稱盟友的合約也已經在前往羅德島的路上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "等到此間事了，我會再次拜訪羅德島。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "屆時，我希望能與你再下一局棋，博士。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "雅兒。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "你啊，好大的膽子，竟然把我蒙在鼓裡這麼久！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "聖女大人恕罪啊，雅兒不知做錯了什麼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "哦？那就當是這麼回事吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "但是，雅兒，我只有一個問題。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "聖女大人請說。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "......我想知道，讓我成為謝拉格的領導者，是祂的意思嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "這一切都是祂的安排，我在這一連串的事件中產生的困惑，迷茫，和最後做出選擇時的堅定——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "都在祂的預料之中嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "雅兒明白了恩雅為什麼忽然在此時此刻問出這個問題。\n她在害怕。\n她並不是在害怕自己的決定做錯了，她所害怕的是，眼下的這一切，都不過只是神明的一場遊戲。"
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "......唯有這一點，我可以向您保證。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "祂......從未想過要干涉您的意志，您的一切想法都出自您自身。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "說不定啊，人們對祂神跡的想像大多也都只出於自己的願望與杜撰。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "僅僅是在風雪中為人們開闢一片不受侵襲的土地，祂或許就已竭盡全力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "祂只是一直在看著這片土地，尋找著能讓生活在這片土地上的人民幸福的方法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "而您給出的答案，得到了祂的承認，僅此而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "......既然如此，可以幫我向祂請求一件事嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "您說說看。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "請祂不要把你帶走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "......欸？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "故事裡通常不都是這樣的嗎。雖然我得到了答案，但代價卻是失去了你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "我不會隨意向祂請求什麼事情的，所以可以讓你繼續做我的侍女嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "......噗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "哈哈哈，哈哈哈哈。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "抱歉抱歉，我沒想到您會提出這樣可愛的要求......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "不過......也是，聖女大人，既然如此，我們來約法三章吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "如果有一天，您不再堅持現在的理想，那麼，我會離開您的身邊。但是，在那之前，我將永遠擔任您的侍女長。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩雅",
          "text": "一言為定？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "雅兒",
          "text": "一言為定。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "讓我作為你的代表去羅德島？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "不錯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "羅德島是個能夠讓你潛心做研究的地方，想必你會喜歡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "你將他們請來，也有這個打算？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "只是一種可能性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "畢竟，無論我們的計畫成功還是失敗，你在謝拉格的處境都會變糟。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "只是你沒料到，原本只是想拉攏的對象，最後險些破壞了我們的計畫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "這無法改變你我的勝利。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "當然，如果你想留在謝拉格，我也會為你安排。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "算了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "......我不在乎罵名，但如果每天都有人來我的研究所用石頭砸窗戶，終究令人煩躁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "而且，我也想見一見那位博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "你也對他產生興趣了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "怎麼可能，他已經在這片土地留下了自己的痕跡，我只是要看一看，他會不會成為我們的敵人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "如果他不會呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "那麼，我也想知道——一家似乎確實做到了抑制礦石病的公司，究竟擁有怎麼樣的技術實力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希歐迪斯",
          "text": "......諾希斯，你現在這副見獵心喜的樣子，比你口中的我好不到哪裡去。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "切斯特",
          "text": "諾希斯，行李已經都打點好了，該出發了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "我知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "切斯特",
          "text": "現在就出發嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "等等。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "莫希！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "沒有人回應諾希斯的話語。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "......莫希？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "樸素的房間中，一切都井然有序，唯獨那個說話時總是會帶著一絲陰沉的女孩不知所蹤。\n他隨即注意到，房間中央的桌子上，擺著一柄匕首。\n那是他過去送給莫希的匕首。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "諾希斯",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "他沉默了一會兒，拿起匕首，走出房門。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "門外陽光正好。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "咦，博士，你看，這裡居然已經開始賣和聖女大人有關的東西了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "哎呀，這不是恩希亞小姐嗎，歡迎您再次光臨小店。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "老闆，你可真是與時俱進呀。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "我回謝拉格的時候，你這還在賣蔓珠院的東西，現在就都換成和聖女大人有關的東西了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "哈哈哈，不止我這裡，現在滿大街都是。而且還鼓勵我們去做生意。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "您還別說，之前賣的那些東西，那些來歷說出來我自己都不信的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "但是製作和聖女大人有關的商品，那我真是真心實意的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "一開始聽說還政的時候，我們這些做生意的還真擔心會變成什麼樣呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "沒想到聖女大人這麼開明。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "現在，就算是最頑固的謝拉格人，都不會再對和外國人接觸說什麼了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "而且聽說，恩希歐迪斯老爺正打算和聖女大人商談，接下來，布朗陶家和佩爾羅契家的領地也會全面對外開放。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "要我說啊，這日子真是越來越有盼頭了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "嘿嘿。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "聽你這麼說，我也跟著高興起來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "那您可真是該高興。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "您瞧瞧，這街上的人，哪一個不是笑容滿面的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "大典上雖然發生了那樣的事，但在聖女大人的調停下，三家的人也心服口服。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "這樣的結果絕大多數人都能接受。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "而這一切，都得感謝聖女大人和恩希歐迪斯老爺才行啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "對了，瞧您這架勢，是要離開謝拉格了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "是啊，假期要結束了，我也該回去繼續治病和工作了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "那您今天想要什麼，我這兒都免費！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "就當是為您送行了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "這......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "您就別客氣啦，這是您應得的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "......那我就不客氣啦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "我要這幅姐姐的畫像，還有這幅刺繡，還有這個雕刻。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "咦，這幅畫是——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "一幅掛在牆邊的畫引起了恩希亞的注意。\n畫中，姐姐恩雅與哥哥恩希歐迪斯站在一張談判桌旁握手，似乎達成了某種協議。\n她一瞬間，停住了腳步。"
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "啊，這幅畫是描繪恩希歐迪斯老爺和聖女大人在謝拉格的未來上達成共識的景象。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "雖然我不知道是不是真的有這一幕存在，但是如今實質上治理謝拉格的無疑是恩希歐迪斯老爺與聖女大人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "而大家都知道，二人是兄妹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "那麼，二人之間的關係一定是非常和諧的吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "您說說，是不是這麼一回事？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "是呢......其他的話，我再看看......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "博士，你有什麼想要的嗎？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我也要一些特產吧。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "恩希亞",
          "text": "好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "謝拉格商人",
          "text": "呃......恩希亞小姐，雖說是免費，也請您手下留情啊。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "魏斯",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "......博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "我們兩個雖然有身為恩希歐迪斯老爺家臣的立場，但也確實是羅德島的一員。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "魏斯",
          "text": "在許多事情上......很抱歉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "角峰",
          "text": "我和訊使不會厚著臉皮奢求原諒，只希望能允許我們未來還能去羅德島探望恩希亞小姐。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "......博士，怎麼辦？",
          "portraitKey": null
