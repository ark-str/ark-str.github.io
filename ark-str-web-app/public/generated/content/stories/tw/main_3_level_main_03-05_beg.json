{
  "server": "tw",
  "storyId": "main_3_level_main_03-05_beg",
  "groupId": "main_3",
  "stageId": "main_03-05",
  "title": "呼叫",
  "storyCode": "3-5",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_03-05_beg.txt",
  "sourceHash": "a9e411bea704a603efb5fdfbc8aa76da3125f91bb53b3b9ecc8d1a508a34923f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十七关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "{@nickname}博士......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我......我不是......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "霧散了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "近衛局發來通訊，他們發現了更多整合運動的蹤跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "說是在跟蹤一個敵人，女性，白髮——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "阿米婭，老陳催促我，讓你......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "——你臉色不太好。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "交給我吧",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "那......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "那就交給你了，{@nickname}博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "最好能在五分鐘內出發。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "——{@nickname}博士——",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你是在害怕嗎？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "啊......？我......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "博士......我沒有在害怕什麼......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "當然，我害怕，害怕再一次失去......所以才......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "不，我只是不想的......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......難道說，你不喜歡這種力量？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我......我不知道......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我不知道該不該這麼說......但我......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "它不應該光是......傷害別人。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我不想讓博士看到我，這麼近的看到我......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "......奪走生命。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "阿米婭，沒有必要後悔。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我沒有後悔。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "不，我是說......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我就是會為了博士而使用力量，無論他背負著什麼，我不後悔殺死他。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "但是，當然......原本，應該會有更好的辦法吧。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "因為沒能找到那個辦法，所以他死去了。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "這一點......我很後悔。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我不希望......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "不希望{@Nickname}你看到這樣的我。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "明明說著讓這片大地的感染者從痛苦中脫身......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "關鍵時刻，卻還是要一次又一次的，說服自己，去剝奪感染者的生命。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我真是，太弱了。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭，至少你保護了我。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "——————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......這是我應該做的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我明白了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我從來都不認為，有什麼事情真的命中註定。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "只是，無論如何......無論我會走到哪一步......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我都會保護你的，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我保證。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "不行！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "你們先走！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "我得去......得去把碎骨救回來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "你瘋了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "你這是自投羅網......要去，就大家一起去！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "我可不能，不能讓他在這荒野中......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "那就上吧！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "怎麼會——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "整合運動......折返了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "他們要做什麼——？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "星熊警官！快回撤！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "近衛局，別懈怠！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "準備好防禦對方的攻擊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "掩護！掩護我！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "那個女人......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "不行，那個女人的盾，我們是越不過去的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "快！迂回！趁他們還沒反應過來......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "先把碎骨，把碎骨——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "把他搶回來！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "羅德島！他們在轉移目標，你們要注意！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "不好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "星熊警官！小心你的右邊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "——嗯——？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "呼呼，用盾擋開了？有些意思——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "爆炸？整合運動的偷襲？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "當然不止是偷襲哦~",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "就請你在這裡乖乖待著，別向後去了哦？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "嘖——哪來的混蛋！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "又是爆炸！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "阿米婭！我遭到整合運動遠程火力的壓制！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "星熊",
          "text": "其餘的整合運動，正朝你們的方向快速移動！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "唔，這面盾還挺厚實的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "我似乎有點自找麻煩的意思呢......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "算了，就當我幫整合運動一點小忙吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "text": "要讓我看到有趣的事情哦。可別讓我太失望了~",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "是切城的那個叫W的人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "難道說，陳長官他們被她甩掉了嗎？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "小心敵人的突襲！迅速援護星熊警官！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "還有很多敵人埋伏在周圍！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "只有暴露他們的蹤跡，我們才能取得優勢！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "博士！請指揮各小隊應對敵人的襲擊！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
