  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 黑角"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "19:46 P. M. 天氣/晴\n羅德島本艦，幹員休息區，酒吧"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "各位，都要幾張牌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "來兩張吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "我看看......要一張。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "黑角呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺出局了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "黑角大哥今天手氣不怎麼樣嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哎哎，看來一定是出門的時候戴錯了面具啊！可惡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "最近你很忙吧？我聽說你不光出了挺多外勤任務，還經常陪其他幹員模擬訓練。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "這個啊，偶爾加個班，不算什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "再說，俺還挺喜歡跟那幫新來的年輕人一起訓練的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "黑角大哥向來挺受歡迎的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "我剛來的時候，看你戴著面具，還以為是個嚴肅的老前輩，話都不敢多說一句，誰能想到，訓練完你就拉我來喝酒了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "老前輩？俺真有那麼老了？你這麼說，這頓酒俺可不請了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "大哥！我是說大哥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "好大哥，我還要一張牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "我說迪倫，要是你多出來走動走動，而不是老憋在駕駛艙裡，你也會更受歡迎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "算了吧，還是偷懶比較適合我。要不是黑角大哥喊我，我才不想出來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "......換我也想躲著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "上次看到黑角和博士一塊出來，我一下條件反射，都躲牆後面去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "哈哈，你這也太反應過度了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "沒辦法，上次從龍門回來，我連著做了好幾個晚上噩夢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "好不容易鼓起勇氣才能繼續在凱爾希醫生面前工作，結果看到博士還有當時隊裡的其他人，眼前一下又冒出了牧群......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "那個場景......太可怕了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "哎，你是真的慘。黑角大哥呢？你也去了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺還好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "不過那場仗打得是挺激烈，不怪查德，就算是俺，也有點害怕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "......我要來一杯，說到這些，我身上又出汗了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "我也要，來那個......生命之水兌香草沙士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "黑角大哥不喝嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "喲，是怕夜刀小姐說你吧？以前可沒見你少喝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "嘿嘿。俺年紀比你們大，是該少來幾頓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "——看俺雙鬼絕殺！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "什麼嘛，黑角大哥又在唬人。你每次唬人的時候，都假得不得了啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "（撓面具）是這樣嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哎哎，不是說戴著面具讓人看不清表情，會更容易唬住人的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "還有語氣啊，黑角大哥一想唬人，語氣就會變得特別誇張！就跟告訴所有人你要上了一樣，這不是誰都知道你在演戲了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哦？看來俺的演技，還需要精進啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "沒辦法了，這一輪算俺的，你們隨便喝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "......那我不客氣了，再來一杯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "少喝些，查德。我可不想再看你抱著馬桶邊哭邊吐嘴裡不停喊女兒和前妻名字了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "上回慶功宴上，要不是黑角把你扛回家，你能在博士和凱爾希醫生面前丟人丟一晚上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "（呻吟）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "可別再說了，再說查德就恨不得馬上抱著酒瓶暈過去了吧哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "查德是心裡難受，幹了一場硬仗，活著回來了，卻沒辦法跟重要的人說。這滋味俺懂，你們別笑話他了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "謝謝......我，我也是真的怕......我好佩服你啊，黑角，什麼場面都不見你緊張......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺也就是多見了幾次，慢慢地大家都會習慣的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "回來以後，我還是忍不住想那個場面。那種情況，那種地方......如果僅僅只憑我個人意志的話，我既沒辦法往前走，也不敢往後退。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "凱爾希醫生讓我想想我的女兒。她說，要是能打贏的話，我還有機會見到她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "唉......我心裡知道的，醫生，無論我有沒有死在那個地方，能不能見到她都不是我能說了算的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺明白的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "我之所以......之所以能走下去，是因為她說我們可以贏。我選擇了......呃，聽她的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "等回來以後，我再看到她和博士，我就覺得特別丟人。有那麼一瞬間，我竟然懷疑我們贏不了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "不是俺安慰你，查德，你這種想法，俺也有過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺過去打過很多仗。那時候，俺只是一場接著一場戰鬥下去，打到最後誰輸誰贏都不關俺這種小角色的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "覺得贏不了是常有的事。打不過了就逃，活命要緊。日子能馬馬虎虎過下去就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "這很正常，挺多傭兵都是這個想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "我過去在外面開安保公司，也是拿多少錢幹多少活，其他的一概不問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "可換成俺們羅德島，一樣是東家，俺在這裡，想法有點變了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "跟著博士他們出了不少任務，俺漸漸會想，要是能贏，而且還能一直贏下去的話，真的不賴嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "這麼想著，日子一天天過下去，戰場上不偷懶了，就連訓練都有勁，簡直跟那些年輕人一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "那我也想贏。我從來相信醫生他們在做的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "我想見我女兒，雖然理智點想，那可能性真的很低。但我也不會放棄這種可能性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "嘿嘿，這不是挺有幹勁的嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "羅德島總歸需要俺們這樣的人的。沒那麼厲害，會猶豫，會害怕，難道是俺們的錯嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "博士跟俺說，“守住自己的位置”，俺做到了。俺對得起這份工錢，也對得起博士的信任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "你也跟著凱爾希醫生走到了最後。回來以後，她難道說你了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "沒有。她......她還表揚了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "你看，俺說的沒錯吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "哎，聽你這麼說，我也想開了點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "可我還是沒有你那種好心態。頂多下回看到博士不躲到柱子後面去，主動打個招呼吧。再怎麼說，那也是好多老幹員嘴裡的厲害人物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "雖說上次一起出任務......嗝，到最後也沒能說上幾句話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "這麼想想的話，博士肯定已經不記得我了......唔呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "哎，查德，你果然又喝多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺來給你順順氣。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "好一點沒？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "呼......好些了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺要說啊，遮著臉的人未必不好相處，你們看俺不就知道了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "現在的博士，下了戰場以後的樣子，你可以去多見見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "等熟了以後，你就知道，博士跟俺們都差不多，兩個眼睛一張嘴，會偷懶，會犯錯誤，還天天為了船上各個部門的排班表發愁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "哎，說起來，過一陣我出外勤，博士可能會一起去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "真是個好機會啊，在這一瞬間，我對博士的好奇，居然超過了對黑角大哥面具底下有什麼的好奇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哈哈......那挺好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "查德還好嗎？我們要不要繼續？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "咳......繼續吧，我好多啦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "你什麼牌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "大蕉同花順！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "黑角大哥，你可又輸啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "再喝下去的話，我們得把酒櫃喝空了。得換點別的賭注。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "那......再輸的話，黑角大哥把面具摘了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "嘿嘿，這可不好。不是俺不樂意，是你們會失望的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "哎，越是這麼說，我就越好奇啊！好奇得不得了，甚至做噩夢都會夢到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "夢到啥了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "......夢到黑角大哥終於摘下了面具，面具底下還是另一個面具。一層層的，沒完沒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "還真是個噩夢，我雞皮疙瘩都起來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哎呦，這夢真不錯，俺喜歡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "要是真能一口氣戴上好幾個面具，俺每回出門都不用發愁挑哪個了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "可別這樣，求你了，好大哥......我不想天天夢到你啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "嘖嘖，都讓迪倫夢裡天天見了，看來秘密有時候也是魅力的來源啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "俺沒唬你們，俺真沒什麼秘密，你們要是真想看的話，俺也可以——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "呃，算啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "黑角大哥還是維持老樣子比較好，真要摘了面具，恐怕我都不習慣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "那，還是老規矩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "你們啊，又要叫俺講故事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "快來快來，黑角大哥的小故事，最佳打牌助興節目。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "嗯，俺想想，上回說到哪啦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "說到下雨天的晚上，一對母女躲在一間......破廟裡？然後遇到了一隻鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "哇，查德，你記性真好！就是這裡，很像恐怖電影。然後呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "——那隻鬼，是去殺人的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "去殺人的？我還以為那鬼是個好人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "那時，鬼只是鬼，有人叫他殺人，他就去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "聽起來還挺慘的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "鬼打暈了那母親，一把抓起那女娃娃，發現她還只有七八歲，已經怕得喊不出來話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "為了任務，沒辦法，鬼一邊這麼想，一邊準備對女娃痛下殺手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "這時候，他發現自己的攻擊被一把刀擋了下來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "好帥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "是的，很帥，俺也這麼覺得。呃，俺是說，故事裡的鬼也這麼覺得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "那個刀光，在晚上看起來特別亮。鬼不得不退開了一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "我知道了，這是來救那對母女的英雄吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哈，鬼本來也這麼以為。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "鬼心想，打不過就算了，鬼對殺人本身也沒興趣。裝作受點傷，就當任務失敗，回去也不會被找麻煩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "然後鬼才發現......擋下鬼的攻擊的，是另一隻鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "啊？那隻鬼為什麼要保護那對母女？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "當時鬼也不懂。尤其是另一隻鬼看起來，是另一個家族的手下。她家主上和鬼的主上一樣，都想要那個女娃的命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "什麼啊？攔下來只是為了自己殺嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "鬼也這麼猜。鬼和另一隻鬼交手了一番，卻發現對方是真的想救人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "鬼就問她，你到底在做什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "另一隻鬼告訴他，她什麼都不想做。她只是不想再傷害無辜的人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "鬼驚呆了。鬼沒想過，他們還能做這種選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "哎，聽起來是個溫柔的好人......呃，好鬼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "是啊。當時鬼就決定，放過那個女娃娃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "因為鬼被另一隻鬼打動了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哈......也可能是因為鬼打不過她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "主動放棄任務，可相當於叛逃了。雙方勢力都不會輕易放過叛徒的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "對，所以鬼發現，只能和另一個鬼一起逃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "啊，一起亡命天涯！從恐怖故事變成浪漫故事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "也沒那麼浪漫吧？想要逃走，很不容易......一起受傷，一起得病。好幾次差點就死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "還有，另一隻鬼見不得日光。老是戴著面具的話，走到哪裡都不容易得到信任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "鬼琢磨著，戴面具明明不錯啊，就費了一番功夫，也搞來了一堆面具。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "一堆面具？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "是啊，那可真是不容易。每一款面具，都在不同的家族裡傳承千年，有著不為人知的神秘力量......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "這越說越玄了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "面具都有啥神秘力量啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "比方說，戴上就能讓人不老不死，力氣大增什麼的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "就說那一天，鬼拿到了最厲害的一個面具，為此付出了很大代價，差點死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "另一隻鬼很心疼他，背後追兵也不少，鬼急中生智，立刻把那面具戴上了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "那一瞬間，飛沙走石，敵人紛紛變色——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "鬼大喝一聲，“俺超越了極限！”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "......然後就大發神威，把敵人都打退了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "啊？什麼嘛？這結局也太草率了吧！每次故事講到最後，都感覺黑角大哥越說越離譜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哎呦，俺是不是贏了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "誒誒？！我聽故事聽得太入迷了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "我也是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "誰不是呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "我明白了！這就是黑角大哥的獨門技巧吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "嘿嘿，比演戲唬人有效率多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "唉，好想繼續聽兩隻鬼的故事啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "上次那個風雪夜一隻鬼連挑十大將也很精彩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "得下回了，俺瞧著，查德的眼皮都快黏在一起了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "等你結束外勤任務，俺們就又能喝一頓。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "哎，那是博士吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "什麼？我光顧著打牌了，竟然沒注意！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員迪倫",
      "text": "剛剛我們說的那些話，豈不是都......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員查德",
      "text": "我......咳咳咳......我頭好暈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幹員巴蒂",
      "text": "裝醉也晚了，查德。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑角",
      "text": "博士，真沒想到你也會來酒吧啊。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭推薦我過來放鬆一下。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我的迷彩模組失效了嗎？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "幹員查德",
          "text": "幹嘛捅我你們......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幹員查德",
          "text": "咳......博士，好久不......呃，晚上好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幹員查德",
          "text": "呼......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "晚上好，幹員查德、幹員迪倫、幹員巴蒂、幹員黑角。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "幹員查德",
          "text": "博士你......你居然記得我們全部人的名字？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "博士的記性還是這麼好啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "要熟悉山一樣高的文件，還要一下子記住俺們這麼多人的名字，可不大容易。博士，您別累著。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這是應該的。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "PRTS會幫我。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "幹員巴蒂",
          "text": "博士，我們正準備收攤了，就不打擾您了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幹員迪倫",
          "text": "嗯，博士，外勤任務見！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幹員迪倫",
          "text": "溜了溜了，查德，你還杵著幹什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幹員查德",
          "text": "啊？好......咳，博士，再見。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "博士，不介意俺坐在這裡吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "剛才啊，俺們下班聚聚，一邊喝酒一邊胡說八道呢，讓您看笑話了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "他們對博士還不算瞭解。但俺心裡明白得很，博士是個很有意思的大好人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "是您的指揮，讓俺這樣的人，也能在亂糟糟的場面上找到正確的位置。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "俺的位置，就在這裡。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "吃炭烤沙蟲腿嗎？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "來點仙人掌乾拌辣椒老媽？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "都行，都是美味。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑角",
          "text": "要不要跟俺喝一杯啊，博士？偶爾來一杯，不打緊的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
