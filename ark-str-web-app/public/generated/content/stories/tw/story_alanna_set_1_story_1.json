{
  "server": "tw",
  "storyId": "story_alanna_set_1_story_1",
  "groupId": "story_alanna_set_1",
  "stageId": null,
  "title": "再見一面",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/memory/story_alanna_1_1.txt",
  "sourceHash": "8837275b680dbf18fcfb6f3cd36e637ed95ce7c6305fad0e598c1916d6f1beae",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "叼牙籤的工人",
      "speakerId": null,
      "text": "幾比幾啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "流汗的工人",
      "speakerId": null,
      "text": "你已經比我多十分了。不然……這球算了？"
    },
    {
      "type": "dialogue",
      "speakerName": "叼牙籤的工人",
      "speakerId": null,
      "text": "說什麼啊？看我再來一個帥氣的——轉身盲拋一發全倒！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "大暴牙——大暴牙！喉嚨冒煙了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "快點幫我倒一大杯啤酒！"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "哦對，還要一瓶紅蘿蔔汽水！"
    },
    {
      "type": "dialogue",
      "speakerName": "叼牙籤的工人",
      "speakerId": null,
      "text": "阿蘭……阿蘭娜？！"
    },
    {
      "type": "narration",
      "text": "喂喂，大暴牙，你的牙籤掉到地上了——\n不要放回嘴裡啊，真噁心！"
    },
    {
      "type": "dialogue",
      "speakerName": "流汗的工人",
      "speakerId": null,
      "text": "好、好像真的是她！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "你們為什麼一副見鬼的表情？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "真是好久不見。距離你上次踢爆這扇門，已經有一年多了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "真的有那麼久嗎？把吧台上那杯啤酒給我，我快渴死了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "哈——"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "你剛才說，你這次回來，是因為一張罰單？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "對，我在羅德島加班的時候，突然收到一張電子罰單，落款是雷姆必拓比格皮勒自治州住宅管理委員會。"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "住宅管理委員會？什麼時候冒出來這個……沒事，你繼續說。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "罰單上面寫，我名下有一處住宅被認定為“違規建築”，如果不在規定時間內繳納罰金的話，就會被拆掉！"
    },
    {
      "type": "dialogue",
      "speakerName": "異口同聲的工人們",
      "speakerId": null,
      "text": "什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "很意外，對吧？我以為我老家那棟房子早就沒了，沒想到竟然還在！"
    },
    {
      "type": "dialogue",
      "speakerName": "流汗的工人",
      "speakerId": null,
      "text": "不對，阿蘭娜，我們的確很驚訝，但最讓我們感到意外的是……"
    },
    {
      "type": "dialogue",
      "speakerName": "叼牙籤的工人",
      "speakerId": null,
      "text": "你這個吃住都在運載車上，站在平地上反而會暈，打賭自己除了上廁所可以一年不下車的傢伙……"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "……竟然有一棟房子？什麼時候？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "那是我爸媽的房子——好吧，我繼承過來了，所以也算是我的。但我一直以為它早就倒了！就算沒倒，天災之後也沒辦法住人了啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "但你現在卻收到了那張罰單……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "所以我就火速趕回來了，萬一是當初組織撤離的人搞錯了呢？萬一天災其實沒來呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "叼牙籤的工人",
      "speakerId": null,
      "text": "既然真的是這麼重要的事情，為什麼你第一個來的地方是這裡？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "難得你這次這麼聰明，大暴牙。你想想，這麼多年了，先不說我還找不找得到那個地方，起碼我得有輛車吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "我聽懂了，阿蘭娜，你想要的恐怕不只是一輛車，最好再幫你安排一個司機，對吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "當然，我從來不會疲勞駕駛——這樣聽起來，你還算感興趣？"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "一直把自由漂泊、來去如風掛在嘴上的“荒野上的阿蘭娜”，竟然也有自己的秘密地盤？我當然感興趣！"
    },
    {
      "type": "narration",
      "text": "那就這麼說定了！事不宜遲，我們現在就出發——\n小鍋蓋！"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "怎麼啦？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "讓大暴牙幫你拿幾瓶紅蘿蔔汽水在路上喝。不用付錢，他欠我的。記得要冰的！"
    },
    {
      "type": "dialogue",
      "speakerName": "叼牙籤的工人",
      "speakerId": null,
      "text": "嘿嘿，多拿幾瓶吧。沒關係的，小傢伙。祝你健康。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "謝、謝謝你……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "這張地圖上也找不到嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "有可能是地圖太新了……唉！怎麼才過去十幾年，那麼大的一個小鎮就直接從地圖上消失了？"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "一直在大路上繞圈子也不是辦法。除了遭遇過天災之外，那個小鎮還有別的特點嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "我想想，小鎮旁邊有個礦場，小鎮上住著的都是礦場的工人。"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "……雷姆必拓百分之九十九的小鎮都是這樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐的爸爸媽媽，也是礦工嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "不算吧，他們只是在礦場工作，我媽媽是會計，我爸爸是焊工。小鍋蓋，怎麼了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "沒什麼，只是蘭娜姐從來沒有說過。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "等等，前面的路口……我有印象！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "在這裡右轉試試看。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "對，就是這條路！一直往前開！"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "看路邊的告示牌，這條路是最近整修過的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "說不定這裡現在還有住人！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜將身子探出車窗外，迎著風沙，努力地睜大了眼睛。\n遠處的地平線上，一排歪歪斜斜的屋頂緩緩出現。幾道煙柱在空中散開，將許多小屋籠罩在一片朦朧中。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "這麼歪的屋頂，還有這股燒火煮飯的味道……對，我記憶裡的小鎮就是這樣！"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "當年那些天災信使說不定真的是搞錯了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "對，一定是這樣！那場天災最後肯定是轉彎跑去別的地方了！"
    },
    {
      "type": "narration",
      "text": "小鍋蓋，你快點看，我家——\n小鍋蓋，你在做什麼？\n十七，\n十八，\n十九……"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐，我在數這條路旁邊的源石結晶柱子。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "無論是源石叢，還是地面上的裂縫，這裡好像都比其他地方多了不少……"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "阿蘭娜不是說，這裡以前有座礦場嗎？多一點也很正常。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小查理，就在前面那幾棟房子旁邊停車吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "嗯。剛好，我也得幫水箱加點水了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "就是這裡了，小鍋蓋。我記得小鎮住在最旁邊的，是一個會做雙色蛋糕的大嬸……她叫什麼啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "她還有一片精心照顧的小花園，裡面都是從很遠的市集上買回來的名貴花卉。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "可是這裡，看起來不像是個花園的樣子。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "是啊，怎麼看都不像……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地居民",
      "speakerId": null,
      "text": "喂，你們踩到我的幼苗了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "你……你是蘇珊大嬸？"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地居民",
      "speakerId": null,
      "text": "叫什麼啊？！“大嬸”？"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地居民",
      "speakerId": null,
      "text": "別再往前走了，你已經踩死三棵甜菜了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "對、對不起！認錯人了。"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地居民",
      "speakerId": null,
      "text": "真是的，想在這個鬼地方找一片沒被污染的田地本來就很難。喂，外地來的，賠錢！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "外地來的……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "這到底是怎麼回事？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地修理工",
      "speakerId": null,
      "text": "水管接通了，加滿應該要等一個小時……你這個水箱還真大。"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "不好意思，辛苦你了，這包煙給你吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "沒想到這座小鎮裡還開著一家修理店，看來這裡的交通很發達嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地修理工",
      "speakerId": null,
      "text": "發達？哼，這裡什麼都買不到，物資全靠車子從外面運進來，當然需要好好修理車子。"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地修理工",
      "speakerId": null,
      "text": "我就是因為不想再當修理工才搬到這裡的，沒想到來了之後還是在幹老本行！"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "搬過來？你不是小鎮的原住民嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地修理工",
      "speakerId": null,
      "text": "哪有什麼原住民？說小鎮都太高估這塊破地方了，往下挖三公尺都看不到泥土，全都是碎磚塊爛木頭。"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地修理工",
      "speakerId": null,
      "text": "要不是當官的許諾定時發放補貼給我們，我們才不會搬到這裡來搞什麼“宜居化環境改造”。"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地修理工",
      "speakerId": null,
      "text": "你看腳底下這些源石碎屑，天災爆發過的地方，就算過了十幾年，又能有多宜居？"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "……這裡真的發生過天災？"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "那之前的那些舊房子，一棟都沒留下來？"
    },
    {
      "type": "dialogue",
      "speakerName": "荒地修理工",
      "speakerId": null,
      "text": "除了一堆賣不了什麼錢的廢銅爛鐵，什麼也沒剩下。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "（在下車之前，我以為我能在這裡看到一些熟悉的人，找到一些我記憶中的痕跡。）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "（那些過於密集的源石結晶，還有地上的裂縫，甚至包括……我腳底下這些碎瓦片，它們早就提醒過我了。）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "（那些信使並沒有犯錯，天災也確實降臨了，我的家……早就沒有了。）"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐，你還好嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "啊？啊，哦，我沒事。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "你盯著那座小山坡看了好久。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐的家就在山坡那邊嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "是啊……不，沒什麼，我耍笨了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜嘆了口氣，不停揉搓著自己的臉。\n但很快，她又聳了聳肩，恢復了往日那副瀟灑的氣勢。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "看來是我想太多了。真可惜，這次沒辦法白撿一棟房子了，哈哈。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "不過也沒關係，那棟房子沒水沒電的，還沒有運載車住起來舒服呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "運載車裡面很暖和，不過溫米和蘭娜姐在羅德島上也有了自己的宿舍，再也不用住在運載車上了。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐之後一定會有更大、住起來更舒服的屋子……到時候，溫米也可以搬進去嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小鍋蓋，想什麼啊？如果你不來，我就要天天吃自己煮的飯了！"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐的廚藝其實也沒有那麼差啦——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "阿蘭娜，水箱加滿了。你還好嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "這裡的住戶我都問過一輪了，他們說……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "我已經知道了，辛苦你了。"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "別灰心，我再去問問看，說不定還有人知道你家的位置……哪怕有一塊磚剩下來，也能留點回憶。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "他們都是剛搬來的，不可能知道的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "發動車子吧，小查理，我們回去鏽渣子鎮吧。剩下的時間應該還能和你們這群老朋友喝幾杯。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜轉頭，讓自己的視野避開那片光禿禿的山坡，以及山坡背後被遮蔽的一切。\n誰會比她自己更清楚家的位置呢？\n她曾經一遍遍地翻過那片山坡，在光滑的草皮上一路滑到家門口。\n媽媽看著一身泥巴的她無可奈何，而她只是咧嘴笑著。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "我先去發動車子。不用著急，我在車裡等你們。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "走吧，小鍋蓋。天快要黑了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "等回到鏽渣子鎮，你有什麼想吃的嗎？要不要來一份傳統奶油什錦麵？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜走出幾步，才發現小鍋蓋並沒有跟上來。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "……小鍋蓋？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐，你看，溫米膝蓋這裡有道疤。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "這不是之前在宿舍門口摔倒的傷嗎？還很痛嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "現在不痛了。那個時候溫米很痛，但是不敢哭，走廊上有好多人。蘭娜姐當時說——"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "“忍住不哭也很累啊，既然已經那麼痛了，幹嘛還要讓自己更累呢？”"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "然後溫米就哭出來了。哭完，就沒那麼痛了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "溫米慢慢走近，牽起了阿蘭娜的手。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐的手指，從好久之前開始，就一直在發抖……"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "現在，拉著溫米的手，可以不用忍得那麼累哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小鍋蓋……"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐，感覺到害怕或者難過的話，都是正常的。溫米剛離開家的時候，也很常哭。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "遇到蘭娜姐之後，溫米一直被照顧得很好，就很少哭了。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "但也不要一直都把溫米當成小孩子看啦，溫米已經長高一點了，我也可以照顧好蘭娜姐的。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "溫米不想讓蘭娜姐再硬撐下去，溫米知道，那樣真的很辛苦、很累……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "可是，將這些情緒丟給小鍋蓋的話，很不公平……你本來不用幫我分擔的。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "這不就是家人之間該做的事嗎？一起分擔，一起吃飯，一起幫傷口塗上紅紅紫紫的藥水。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐，我們一起走了那麼那麼遠的路，早就是家人了，不是嗎？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜緊緊握住那隻小而溫暖的手。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "……嗯，我們早就是了。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "如果蘭娜姐想再看一眼的話，就去看吧。溫米陪你一起。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "蘭娜姐。\n嗯？\n這裡的山坡很平緩，沙子踩起來也很鬆軟哦。\n嗯……\n這條回家的路，蘭娜姐一定走過很多遍了吧？\n想跟溫米講一下嗎？關於……這裡從前的樣子。\n我記得……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "……我記得，這裡以前長滿了草，下過雨之後，不小心就會跌倒。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "現在也有小草哦，不過都很瘦小，剛冒出來的樣子。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小鍋蓋有試過從草坪上滑下去嗎？"
    },
    {
      "type": "narration",
      "text": "沒有耶，聽起來很危險……\n但是應該也很有趣！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "我像你現在這麼大的時候，常常跑來這裡，一遍遍地從坡頂滑下去。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐從小膽子就這麼大嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "其實，更多是因為無聊吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "跟著爸爸媽媽搬家搬到這裡後，我很久都沒有認識一個新的朋友。我也不喜歡一直待在家裡，因為家裡……總是很吵。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "家裡面吵吵鬧鬧的，才熱鬧啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "嗯……不太一樣。我的爸爸媽媽都在礦場工作，習慣了在巨大的噪音裡交流。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "但到了家裡，他們還是大聲吼來吼去，就像是在吵架，不過臉上帶著笑。就算他們不說話，也會把音樂開到最大。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "有時候他們是真的在吵架，為了不讓我發現，他們都是笑著吵的。但我還是發現了，哪有人會一邊笑一邊哭的？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "所以，他們一吵架，我就跑到這裡來，從草坪上滑下去，再爬上來，再滑下去。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐那時候，心裡很難受吧……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "嗯。但最後，還是要帶著一身泥巴回家。進門前，要努力笑出來，媽媽才不會擔心。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "後來，他們因為這件事又吵了一架。再然後，爸爸在院子裡修了很多東西，鞦韆、彈跳床，甚至還有個小涼亭。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "溫米的爸爸，也說過要幫溫米做一座鞦韆，可以放在門廊上。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "大人們好像都覺得小孩子會喜歡這些東西，為什麼呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "可是溫米真的喜歡鞦韆、彈跳床和小涼亭啊，只是……溫米的爸爸來不及做。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "等回到羅德島，我就幫小鍋蓋各做一個吧，把宿舍塞得滿滿的，怎麼樣？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "嘿嘿……"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "哎呀。快要走到坡頂了，馬上就可以看見那邊的樣子……"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐，你怎麼不往前走啦？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "如果蘭娜姐不敢看的話，就閉上眼睛，溫米幫你看……"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "好不好？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "好。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咯吱，咯吱。腳踩在斷磚、碎瓦和燒焦的木頭上。\n縫隙裡，小塊的碎玻璃和源石結晶反射著晚霞最後的光亮。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小鍋蓋……最後這幾步，怎麼感覺走了好久？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "就快到了，蘭娜姐，要注意腳下……慢一點。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "這裡有很多碎玻璃，一閃一閃的，就像星星。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐，整條路上都是耶！就好像……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "好像什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "就好像它們在歡迎你回家！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "回家……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小鍋蓋，如果那裡什麼都沒有的話，不要告訴我，直接帶我回去吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "……好嗎？"
    },
    {
      "type": "narration",
      "text": "可是，小鍋蓋卻突然鬆開了手，向前跑去。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小鍋蓋？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "你在哪？我們到坡頂了嗎？"
    },
    {
      "type": "narration",
      "text": "一陣慌亂的摸索後，她抓住了溫米的手，也聽見了溫米抽泣的聲音。\n然後，溫米一邊哭，一邊笑了出來。她用力地搖晃阿蘭娜的手臂，大聲地喊叫——"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐！你看！"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜慢慢睜開眼睛。\n不遠處的山坡下，在一片雜草叢生的廢墟中，屋頂、窗櫺和門框都變成了陳舊的碎片。\n無數個日與夜，風吹日曬雨淋，最堅固的梁柱與脊檁都已斷裂、腐朽。\n但在那片廢墟前，一座鞦韆仍然站立著。\n一座醜陋的、堅固的、鏽跡斑斑的鞦韆，在夜風中輕輕晃動。\n吱呀——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "“這樣子不行，你看她站在鞦韆上，盪得比曬衣繩的桿子還高！”\n“太危險了……把你那幾條從來不穿的帆布褲子拿過來，我要幫她縫一條安全帶。”\n……\n“別哭，別哭，讓媽媽看看摔到哪裡了……嘶，膝蓋上的皮破了！”\n“就說不安全了吧，你看！鞦韆的架子怎麼直接斷了？！”\n“怪我……對不起，阿蘭娜……都怪爸爸。”\n“幹嘛？這麼晚了，你要去哪裡？”\n……\n“快點睡覺吧，那不是天亮了。是你爸爸的焊槍照亮了窗戶。”\n“我也不知道他在幹嘛……別擔心，我會告訴他的，阿蘭娜沒有怪爸爸，阿蘭娜是個很懂事的好孩子。”\n……\n“看！阿蘭娜，爸爸幫你加固了鞦韆哦，看這些鋼筋，這麼粗——什麼？太醜了？”\n“可是真的很堅固啊，爸爸跟你保證，這次無論你盪得多高，都不會再摔倒……哦哦，對，不可以再盪那麼高了！”\n“爸爸不用睡覺，爸爸還要去上班。等晚上我和你媽媽回家之後，我們一起玩這個新的鞦韆好嗎？”\n“你在家裡不可以自己偷偷玩哦，一定要等媽媽回家幫你繫好安全帶。”\n“再見，阿蘭娜！”\n……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "但是……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "他們說，發生了“礦難”。我當時還沒在媽媽的識字本上學到這個詞。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "我只記得，桌上的杯子裡，紅蘿蔔汁一直在搖晃。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "後面來了好多人，想把我從家裡帶走。他們指著天上形狀奇怪的雲，說礦難導致源石粉塵洩漏，天災馬上就要來了，我必須離開。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "他們撞開了門。然後，我就離開了家。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "我甚至……來不及和它好好告別。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "其實有些話說出口才發現，也許並沒有想像中那麼沉重。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "但一直憋在心裡的話，就會變成大石頭。蘭娜姐以前偷偷用客艙運貨物的時候，不是也最討厭拉一車石頭跑長途了嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "是啊，那樣跑得又慢，一路上還得提心吊膽。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜從地上撿起一塊石子，奮力往遠處拋去。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "不過現在！丟掉那些石頭之後，我可以痛痛快快地跑起來了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小鍋蓋，你帶著我爬上了這座山坡，現在該由我來帶著你往前走了。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "咦？蘭娜姐——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜咧嘴笑了起來，她拉著溫米，邁開大步往山坡下的那片廢墟跑去。\n這條她走過無數遍的回家的路，被天災從地面上抹去，此刻又在她的腳步下重現。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐！慢、慢一點！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "歡迎來到我家！你聽，它們都在歡迎你——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "吱呀——\n夜風吹過，從那些鋼筋和鏈條的接縫當中，沙啞又悠遠的金屬摩擦聲響起。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "要坐上去試試看嗎？放心，它很堅固的。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "真、真的可以嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小鍋蓋不是一直想要一座鞦韆嗎？你看，這裡就有現成的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "等回了羅德島，我再幫你做一個更漂亮的！"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "但這個是蘭娜姐的爸爸幫蘭娜姐做的……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "我小時候就已經玩過了，現在該讓小鍋蓋也試試看了，而且，哪有小朋友不喜歡盪鞦韆的？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "我已經不是小朋友了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "沒錯，小鍋蓋長大了，是可以幫蘭娜姐分擔很多很多東西的好孩子。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "等小鍋蓋的個子比我還高的時候，就換你來推我盪鞦韆了。但現在……就讓蘭娜姐多關照你一下吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜把溫米抱上鞦韆，順手拿起一旁的安全背帶。\n背帶表層的布料已經完全褪色了，但其中包裹著的金屬鏈條依然堅固。\n溫米昂起臉蛋，仔細地看著阿蘭娜為她繫安全帶時的每一個動作。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "這根安全帶，我媽媽縫了很多遍。她從來不讓爸爸幫我繫，說只有她來做這件事才放心。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐的媽媽，也肯定想多陪小時候的蘭娜姐一起玩。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "這個應該怎麼扣住？我小時候，媽媽好像是這樣弄的……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "好了，很牢固！這樣無論盪得多高，也不會掉下來了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "鞦韆的架子也很穩，你看，怎麼搖都不會晃，只是表面有點生鏽了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "小時候只記得爸爸忙了一夜，焊槍的光照射在窗戶上特別亮。現在看著那些焊縫，才認出來……"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "那是最累最麻煩的一種焊接方法，但也是最堅固的。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "很多事情都要等長大後才會慢慢懂得……蘭娜姐以前遇到解釋不清楚的東西，就都是這樣跟我說。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜輕輕推動溫米，鞦韆晃起來，吱呀呀的聲音在這片沉靜的夜裡，似乎能傳到很遠的地方。\n很遠很遠的地方。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "蘭娜姐……好像，有雨滴掉下來了。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "可是，星星明明還……那麼亮。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "走嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "嗯，我們回去吧。回去再說。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "啊，對了，蘭娜姐……你不是說有張罰單嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "對啊！我差點忘了！那張罰單是怎麼回事？我得看看……"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "你剛剛提的時候我就想說了，從來沒聽說過有什麼“住宅管理委員會”。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "“若未在規定期限內繳納罰款，該處住宅將被強制拆除。”"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "好像也沒說在哪裡繳罰款，後面寫了什麼啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "“……同時個人銀行帳戶將被凍結，為避免您的正常資金往來出現問題……”"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "“請將存款全部轉移到我們設定的安全帳戶。該帳戶受雷姆必拓總銀行監管，絕對安全可靠”？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "可惡！原來是詐騙訊息！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "都怪我當時太急，看到要拆除就被嚇到了，後面的內容都沒看完。"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "可是，要不是這封詐騙訊息，可能我們也不會回到這裡。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "是啊，命運就是這麼奇妙的東西。"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "之前遇到的那個修理工說，這裡的宜居改造完成後，會遷來更多居民，建起新的社區。"
    },
    {
      "type": "dialogue",
      "speakerName": "小查理",
      "speakerId": null,
      "text": "你家所在的那片地方，聽說將來會變成遊樂場。什麼蹺蹺板、溜滑梯都有，專門用來給那些小孩消耗體力。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿蘭娜",
      "speakerId": null,
      "text": "聽起來還不錯。小鍋蓋，你覺得呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "溫米",
      "speakerId": null,
      "text": "（哈欠）嗯……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿蘭娜將視線從車窗外的茫茫夜色中收回，停留在懷裡溫米的臉龐上。\n溫米快要睡著了，睫毛上還掛著一點淚珠。\n阿蘭娜也閉上眼，腦海中重新浮現出那條鋪滿星光的小路，還有道路盡頭的那座鞦韆。\n“再見。”她在心裡說。\n再見了。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
