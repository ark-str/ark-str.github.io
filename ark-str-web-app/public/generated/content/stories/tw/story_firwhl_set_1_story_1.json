{
  "server": "tw",
  "storyId": "story_firwhl_set_1_story_1",
  "groupId": "story_firwhl_set_1",
  "stageId": null,
  "title": "獨行之人",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/obt/memory/story_firwhl_1_1.txt",
  "sourceHash": "c124cdc164acf890953700ce9610cd1097a1556956bfe4760a424ad91e6df436",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "浮誇的學生",
      "speakerId": null,
      "text": "終於，我們終於等到了封頂的這一天！"
    },
    {
      "type": "dialogue",
      "speakerName": "浮誇的學生",
      "speakerId": null,
      "text": "我們第一次走出大學，走出移動城市，花了整整兩個星期，用自己的雙手，一磚一瓦地勞動......"
    },
    {
      "type": "dialogue",
      "speakerName": "浮誇的學生",
      "speakerId": null,
      "text": "為這座在貧窮與困苦中掙扎的村莊建起了一所學校！"
    },
    {
      "type": "dialogue",
      "speakerName": "浮誇的學生",
      "speakerId": null,
      "text": "哦，我耳邊已經響起了孩子們的讀書聲......"
    },
    {
      "type": "narration",
      "text": "村莊邊緣的空地上，十幾個大學生模樣的人正圍坐在一起，興奮地嘰嘰喳喳。\n他們身邊，一座剛剛建成的二層建築歪歪扭扭地立著。"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "行了吧你，詩不是詩，散文不是散文，我聽得都要反胃了。"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "說實話，阿格妮，能給村子建起這所學校，你才是最重要的因素。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "哈哈，哪有。"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "我是說真的。"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "我們這幫高談闊論的大學生，整天說要幫助雷姆必拓的窮人，卻連移動城市之外的人怎麼生活都沒見過。"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "要不是你提醒我們要腳踏實地，我們絕對不可能親眼目睹這座村莊的貧窮——"
    },
    {
      "type": "dialogue",
      "speakerName": "浮誇的學生",
      "speakerId": null,
      "text": "諸位，讓我們花點時間，祝福這座飽含我們心意的建築！"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "呃，他又要搞什麼......"
    },
    {
      "type": "narration",
      "text": "浮誇的學生從懷裡掏出一瓶香檳，握在手中使勁搖晃。\n伴著四處潑濺的香檳酒，瓶塞噴射而出，好巧不巧，正好嵌在學校歪斜的大門和門框中間。"
    },
    {
      "type": "dialogue",
      "speakerName": "學生們",
      "speakerId": null,
      "text": "哈哈哈哈哈哈......"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "哈哈哈......阿格妮，這傢伙簡直......太離譜了......"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "阿格妮，怎麼了？你看起來一點都不高興。"
    },
    {
      "type": "narration",
      "text": "阿格妮指了指遠處的村民們。\n就彷彿剛剛建好的學校和建起學校的大學生們都不存在一樣，他們只是埋頭勞作，誰的臉上都沒有一絲笑意。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "誰啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "村長先生，您好，我是阿格妮，來建學校的大學生。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "太晚了，有什麼事明天說吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "明天我們就走了，我來道個別。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "不用道別，你們樂意什麼時候走都行。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "不，不光是道別，還有別的事......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "其實是今天我們瘋過頭了，忘了把這個給你們。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "給，慶祝學校落成的酒。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "見村長沒有接的意思，阿格妮只能自己把酒瓶放在木桌上。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "鄉下人喝不慣，你拿回去吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "這酒很好入口，不信您可以試試。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長搖了搖頭，拿起桌上的酒瓶，試圖找到一些自己能理解的圖畫。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "這畫的什麼？葡萄園？葡萄園和“香檳”有什麼關係？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "反正是酒商瞎畫的圖，瞎取的名字，您就把它當成一般的氣泡酒就行。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "哼，我們自己釀的酒，也不比什麼香檳差。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "那——明天出發前，我們要不要來個交換品酒？我們也嘗一嘗村子的自釀酒——"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "早沒了。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "自從周圍發現鐵礦，別說種啤酒花了，連源石蟲都不願意在這裡築巢。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "怎麼會呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "“怎麼會”？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你們來這裡這麼多天，就沒聽見過採礦平台發出的聲音？時不時震上一下，偶爾地動山搖，源石蟲能不躲著走嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "前幾天好像是有採礦平台的動靜，可我們都沒注意到......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彷彿要給村民的話作註腳似的，遠處真的傳來隆隆的轟鳴聲。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "這下注意到了？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "小姑娘，帶著你的酒回去吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "可是......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你還有什麼事？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我其實就是想問問，為什麼一開始大家都很歡迎我們，可現在學校建成了，大家反而顯得冷淡了？是我們有哪裡做得不好嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "如果是因為學校的建築品質不行，我得負起責任，找個更可靠的施工隊來——"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "反正你們也要走了，我直說吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "村裡根本不需要什麼學校。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "我們不過是想，你們一來，村子就能多點收入。吃飯、住宿，萬一再捐點什麼東西......這不都是錢嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "可你們倒好，村裡的飯不吃，村裡的房不住，居然在空地上搭帳篷......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "這幾天，除了幫你們砍樹燒磚，村裡唯一做成的生意就是烤獸肉，這點錢夠幹什麼？誰能高興得起來？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "可只要把眼光放長遠，學校建成了，村裡的孩子就能受到教育，改變現在的生活——"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "改變現在的生活？我們為什麼要改變自己的生活？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "算了，我不跟你提那些虛的，我現在就問你一個問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "誰來上課？哪個老師願意來這種沒前途的地方教學生？他自己去移動城市不好嗎？去給你們這些有錢人家的孩子當家教不好嗎？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "“當”的一聲，村長把酒瓶杵回桌上。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "是我們......是我想得太淺了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我以為只要建起學校，再加上合理的薪資，就一定會有人來應聘......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "我們這既沒有礦，也沒和礦業公司簽什麼合約，他們的商路都繞開這裡。就算多出點錢，誰願意每天穿過荒地來給人上課？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "我們本來就不是一路人，別白費工夫了。回去吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "酒你也拿回去。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "不，至少......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "您稍等一會！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "浮誇的學生",
      "speakerId": null,
      "text": "留下來當老師？"
    },
    {
      "type": "dialogue",
      "speakerName": "浮誇的學生",
      "speakerId": null,
      "text": "這個我真幫不上忙，抱歉，阿格妮。"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "我們拿錢給他們雇老師好不好？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我也想過，可這裡交通不便，沒人願意來，只有我們......"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "阿格妮，你忘了？再有五天就開學了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......開學？"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "我還得抓緊時間多修幾個學分，否則就延畢了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "開學？學分？延畢？！"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "阿......阿格妮？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "（深呼吸）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我不是怪你們，但這裡的孩子根本沒學上，我們卻要因為開學而走人，你們難道不覺得......諷刺嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "文靜的學生",
      "speakerId": null,
      "text": "可我們首先是大學生，學生就應該按時到校，這不是天經地義嗎？"
    },
    {
      "type": "narration",
      "text": "阿格妮站在原地，好像有很多話想說，又什麼都說不出來。\n其餘的學生安慰了阿格妮幾句，見她沒有反應，只能各自散去。\n他們還有行李要收拾，還有學分要修，還有文憑要拿，沒時間在這裡陪阿格妮一起站著。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "現在喊一嗓子追上去，你還能坐上車。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我既然決定要留下來，就不會改主意。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "要我說，你留下來當老師也沒用。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "至少現在，我自己覺得有用。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "那你可夠倔的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我從小就倔得要死，認準一件事就不鬆口，我爸媽都頭疼死了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "兩人轉過身，慢慢往村子的方向走去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村民們對學校、老師一類的名詞並不熱心，但大人們忙著維持生計，白天沒人看孩子也是事實。\n於是，回到村莊的阿格妮如願以償地獲得了村民們的許可，還像模像樣地排了課表，做了教案。\n可剛開始上課，阿格妮就發現，她以為自己要教的是加減乘除，可孩子們連最基礎的讀和寫都還沒掌握。\n幾天的教學下來，她和孩子們都累得要命。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "大家都看出來了，你是認真想教孩子們學點東西。你比你那幫同學強太多了，阿格妮。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "但是，我勸你對自己好一點，帶孩子們玩玩鬧鬧去吧。別把自己搞得太累了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "如果我偏不呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "那你又能做到什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你最多教孩子們認幾個字，算幾個數，可這又能有多大用？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "怎麼會沒用呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "這些都是最基礎的知識，只有掌握了這些，才有可能開始更高層次的學習，進而改變生活......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "又來了，改變生活。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "阿格妮，村裡人喜歡你，是因為你熱心、善良、不圖回報，不是因為你想改變大家的生活。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你知道這麼多年來，是誰害得我們的生活改來改去，連啤酒都改沒了的嗎？是礦業公司。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "但是，假如孩子們能掌握更多的知識，擁有更開闊的眼界，他們一定能過得更好。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "怎麼過得更好？進大學？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "對，這也是“更好”的一部分。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "那你準備花多長時間教出一個和你一樣的大學生？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......我知道我自己現在像個傻瓜，但對我來說，半途而廢比完全不做更難受。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你確實夠倔。我要是你爸媽，我也會頭疼死的。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "隨你的便吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我記得那瓶香檳還在這放著，沒錯吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你要喝？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "哈哈，那是留著做慶功酒的，現在喝算什麼，借酒澆愁嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "其實......今天正好是大學開學的日子。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "從今天算起，要是我能給孩子們上一個學期的課......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "不管孩子們學得怎麼樣，等到學期結束那天，我們就和村裡人一起把這瓶酒開了，你看怎麼樣？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長看了看阿格妮，又看了看放在破櫥櫃最深處，華麗得與周遭格格不入的香檳酒。\n伴著遠處採礦平台鑽探的聲音，瓶中的氣泡不安分地向上浮去，試圖掙脫液面的阻攔。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你拿來的酒，聽你的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在那之後，孩子們學會了寫自己的名字，學會了加和減，一部分聰明的孩子已經學到了乘和除。\n而在教學之餘，憑藉著從小到大的玩火經驗，阿格妮也在村民心中獲得了一定的地位——\n至少，一家人餓著肚子，濕柴卻不起火只冒煙的時候，所有人的第一反應都成了“快去找阿格妮”。\n一個月時間很快過去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "（伸懶腰）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "今天的課終於上完了......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "累了？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我還挺得住。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "你想，我們用一個月完成了正常學校一個半月的教學任務。要是往短了算，一學期的課業進度已經過半了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "也就是說，只要再過一個月，就是開香檳的日子——"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": null,
      "text": "阿格妮老師，阿格妮老師！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "怎麼了？"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": null,
      "text": "阿格妮老師，村口來了一隊汽車，裡面有一位穿得很整齊的老伯，他指名要找你！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": null,
      "text": "老師，你怎麼了？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......沒事。"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的孩子",
      "speakerId": null,
      "text": "那我去玩了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你父親？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......多半是他。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "看來這瓶酒，我是喝不到了。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "（拍拍阿格妮的肩膀）"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "會替你留著的。你還是先去見你父親吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "爸。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "讓我看看......還好，還好，沒受什麼傷，就是瘦了點。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "你瘋也瘋夠了，該回去收收心了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我不回去。我和村裡人約好教他們的孩子一個學期的課，現在課才上了一半。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "（歎氣）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我們用一個月上了半個學期的課，孩子們已經學會了寫自己的名字，學會了加減法！只要再有一個月就能結課了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "阿格妮，你明知道這沒意義。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "沒意義？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "就憑會寫自己的名字，會算加減法，那些孩子就能成為和他們的父母不一樣的人嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "回學校吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "時間不等人。你晚一年畢業，我就得晚一年把礦上的擔子交到你手裡——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我說過多少次了，我不想繼承你的礦！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "車隊的其他人全都默不作聲。\n這樣父女吵架的場景，他們也不知見過多少次了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "阿格妮，我也說過很多次，我很慶幸自己有一個善良的女兒，知道為其他人著想，知道自己能生在一個富裕的家庭裡有多幸運。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "但她不願意想，要讓其他人過上更好的日子，她必須站在更高的位置上，從統籌全局的角度為別人謀福利。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "別聊這個了好不好，聊不出結果的！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "......你甚至不願意聽我把話說完。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "這樣吧，阿格妮，我們做個約定。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "你不是擔心孩子們的課沒人上嗎？我可以幫你為村子雇一位老師。只要薪酬夠高，會有人願意來的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "終於開始了？用我關心的人做籌碼，讓我接受你的條件？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "別這樣，阿格妮。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "我只希望，當我做了這些之後，你可以認真想一想我的話。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "想一想，如果你在我的位置上，甚至掌握比我更多的資源的時候，你能為這座村莊......能為更多座這樣的村莊做什麼。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿格妮低著頭，咬緊牙關，不敢看父親的眼睛。\n因為她害怕，和父親對視的那一刻，自己就會點頭。\n她為這樣的自己感到噁心。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "（咬牙）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我去村子裡......說這件事。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我走，他來找老師......就是這樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "所以你家裡......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "果然是開礦的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "（沉默地點頭）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長從櫥櫃深處掏出那瓶香檳酒，塞在阿格妮懷裡。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "阿格妮，你走吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "我們本來就不需要學校，現在更不需要一所礦老闆資助的學校。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "您別這樣......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "我不得不這樣。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "我跟你說過，自從周圍發現鐵礦，村子裡連源石蟲都不築巢了。那我有沒有跟你說過，為什麼村子裡連啤酒花都不種了？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "沒有......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "走，出去轉轉，我告訴你為什麼。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你看這些荒地，以前種滿了啤酒花，現在已經完全撂荒了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "採礦平台剛建起來的時候，我們想的是，礦業公司一來，這裡肯定會來很多礦工，會多出很多物資需求......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "正是我們和礦業公司做生意的好機會。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "可他們沒來找我們。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "他們自己建立了供應鏈和貿易點，向所有人開放，裡面簡直應有盡有，糧食、水果、粗布......對，還有啤酒。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "他們的價格甚至比我們的成本還低！"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "很快，別說和礦業公司做生意，就連以前和我們互通有無的那些村莊也不來買東西了，畢竟礦業公司的貨既便宜又好用。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "所以我們不種啤酒花了，因為根本沒人來買我們的啤酒，連村裡人想喝酒時首先想到的也是礦業公司。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "這時礦業公司的人倒來了，告訴我們，只要簽訂土地轉讓協定，就能在拿到補償款的同時被礦業公司雇傭，待遇從優......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "哼，待遇從優！"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "我可從別人嘴裡聽說，所謂的雇傭，就是礦業公司可以隨時讓你捲舖蓋走人，到時候你不光沒了收入，連一片能種莊稼的土地都沒有了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "看著眼前激動的村長，阿格妮想起父親剛剛說的話。\n“想一想，如果你在我的位置上，甚至掌握比我更多的資源的時候，你能為這座村莊......能為更多座這樣的村莊做什麼。”"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "而你，阿格妮......我願意相信你，你真的只是懷著善意來教孩子們讀寫的。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "可現在你告訴我，你要走了，你父親的礦業公司會資助這所學校......我拿什麼相信他，相信他的公司？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "還有——"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "我知道這句話可能過頭了，但是，阿格妮——"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你不覺得你在和你父親，和你父親的競爭對手們做一樣的事嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "怎麼可能？！我怎麼會和他們一樣？！"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你們都一樣，你們想讓我們的後代失去他們的土地，去採礦平台，去移動城市，去過朝不保夕的生活。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿格妮顫抖著嘴唇，她有一萬句話想說，但她一句也說不出。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "遠處傳來轟鳴聲。\n在村子裡住了這麼長時間，阿格妮已經習慣了這樣的轟鳴和震動，但這次比平時劇烈許多。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "他媽的，這次怎麼震得這麼厲害？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在村莊不遠處，一座大型採礦平台以極近的距離隆隆駛過村莊，引發的震動就宛如預示著天災到來的地震。\n阿格妮一個趔趄，終於理解了為什麼連源石蟲都不願在這裡築巢。\n但她的餘光瞥到了別的東西。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "學校！！"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "學校？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大型採礦平台漸漸遠去，引發的震動也逐漸平息。\n而那座出自外行之手，本就搖搖欲墜的二層建築，已經被震成了一地瓦礫。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "直到震動完全消失，阿格妮才跌坐在地。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你應該慶幸現在放學了，裡面沒人。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "回去吧，阿格妮，別替我們操心了。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "你是個好姑娘，但我早說過了，我們不是一路人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長扔下阿格妮，往自己家走去。\n他走了不遠的一段路，回頭看了看，阿格妮還站在那裡。\n真是個倔姑娘，他想，但這個倔姑娘最後也會和她父親一樣，變成一個沒那麼討厭，但更危險的體面人。\n正當他這麼想著，打算回頭走路的時候，他看到，阿格妮抓起放在地上的香檳酒。\n他看到，阿格妮雙手攥住香檳瓶，近乎瘋狂地搖晃起來，彷彿裡面囚禁著的不是氣泡，而是誰的靈魂。\n他看到，為了搖那瓶香檳，阿格妮幾乎耗盡了全身力氣，搖到連最後一絲力氣都耗盡的時候，她把酒瓶高舉過頭，瓶口直指天空。\n砰。\n他聽得不很真切。\n但他分明看到，瓶塞直直朝天飛去，也許在最後不得已落在瓦礫堆裡，也許沒有。\n他最後看到的是，阿格妮狠狠把香檳瓶摔到地上，然後大步走開。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "阿格妮，已經好幾個小時了，你一句話也不說。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "這樣鬧彆扭解決不了任何問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "阿格妮，你得正視現實。礦業越發展，這樣的村莊就越沒有希望。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "可他們只要願意放棄過去，擁抱那個唾手可得的未來，那麼，不管是他們，還是他們的後代，都有機會過上真正富足的生活。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "而我，還有未來的你，就是為了讓這樣的願景成真而工作的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "只不過你現在還不明白，為了給他們更好的生活，我們要先勸他們從過去的幻夢裡走出來。這個過程拖得越短，痛苦就越少。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "（乾笑）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......那我告訴你，爸，這個過程剛剛前進了一大步。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我們給村子建的那個學校塌了。被經過的採礦平台震塌的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "震塌了？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "那時地面震得確實很厲害，我沒注意到。我會幫你把學校重新修起來——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "你......難道在擔心我們之前的約定還算不算數？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "不用擔心。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我確實很認真地想了你說的話，從一上車就在想，一直想到現在。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "我覺得自己還是有很多事沒想通——幾乎什麼都沒想通。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "但我至少想通了一件事。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮的父親",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "說真心話，你是個好雇主，好公民，你是個......好父親。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "但雷姆必拓永遠不缺體面的好人。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "爸，我怕，我真的怕體面人當得太久，我會看不見身邊發生的事情，比如......一座學校的倒塌。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "所以我不會繼承你的產業......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿格妮",
      "speakerId": null,
      "text": "......爸爸。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
