  "stageId": "act25side_06",
  "title": "群英薈萃",
  "storyCode": "CW-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsGamedata/tw/gamedata/story/activities/act25side/level_act25side_06_end.txt",
