      "speakerName": "焦急的船員",
      "speakerId": "avg_npc_1592_1",
      "isRemote": false,
      "text": "有、有幾個被抓的傢伙……逃、逃回來了！"
    },
    {
      "type": "dialogue",
      "speakerName": "焦急的船員",
      "speakerId": "avg_npc_1592_1",
