    {
      "type": "dialogue",
      "speakerName": "伊西多",
      "speakerId": "avg_npc_1577_1",
      "isRemote": false,
      "text": "很好，首先，我需要一個助手，要求不高，勤快一點，機靈一點……"
    },
    {
      "type": "dialogue",
      "speakerName": "胡安娜",
      "speakerId": "avg_npc_1581_1",
      "isRemote": false,
      "text": "好，沒問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "胡安娜",
      "speakerId": "avg_npc_1581_1",
      "isRemote": false,
      "text": "對了，還有一個禮物要給你。"
