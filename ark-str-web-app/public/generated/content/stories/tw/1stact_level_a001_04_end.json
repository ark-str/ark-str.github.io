{"server":"tw","storyId":"1stact_level_a001_04_end","groupId":"1stact","stageId":"a001_04","title":"污點證人","storyCode":"GT-4","avgTag":"行動後","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/activities/a001/level_a001_04_end.txt","sourceHash":"063dcbd44d6bb7149057a91f37a40eceeb65298e77616c0c7e26a3c2b3e02065","bodyAvailable":true,"blocks":[{"type":"narration","text":"第四关（后）"},{"type":"background","backgroundId":"bg_caveentrance"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"大鮑勃","speakerId":null,"isRemote":false,"text":"咕......"},{"type":"dialogue","speakerName":"整合運動","speakerId":null,"isRemote":false,"text":"這傢伙腳受傷了！先解決掉他！"},{"type":"dialogue","speakerName":"大鮑勃","speakerId":"avg_npc_010","isRemote":false,"text":"格拉尼！再繼續耗下去，我們都得死在這兒了！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"就算你這麼說！"},{"type":"dialogue","speakerName":"大鮑勃","speakerId":"avg_npc_010","isRemote":false,"text":"快！帶著可蘿爾走！"},{"type":"dialogue","speakerName":"大鮑勃","speakerId":"avg_npc_010","isRemote":false,"text":"我受了傷，會拖慢你們的速度！"},{"type":"dialogue","speakerName":"大鮑勃","speakerId":"avg_npc_010","isRemote":false,"text":"之後我會找辦法和你們會合的！走！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"說好了，記得要來拿你的那份！"},{"type":"dialogue","speakerName":"大鮑勃","speakerId":"avg_npc_010","isRemote":false,"text":"......哼。"},{"type":"dialogue","speakerName":"大鮑勃","speakerId":"avg_npc_010","isRemote":false,"text":"快走！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"整合運動","speakerId":"char_1002_nsabr","isRemote":false,"text":"她們跑了！"},{"type":"dialogue","speakerName":"大鮑勃","speakerId":"avg_npc_010","isRemote":false,"text":"你們的敵人是我！"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_forest"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"......交戰的聲音似乎平息下來了。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"但是抱歉，可蘿爾，現在我們沒有休息的時間，還得快走才行。"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"沒事......那個，鮑勃先生他，不知道怎麼樣了......！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"可能，要給他一些時間吧。"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"給他些時間......？你是說——"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"啊！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"可蘿爾！你沒事吧？"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"抱歉，被這個樹根絆了一下......"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"來，拉住我的手。"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"......謝謝你。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"能走嗎？"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"......沒事的，只是擦傷。就像你說的，我們還是別停下腳步比較好......"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"只要穿過森林就是莫拉蒂山的山腳下了，我們得進入半山腰第二個洞窟。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"只能從洞口進去嗎？"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"是的，裡面還有很多岔路和暗道，不過我知道該怎麼走。寶藏就在洞窟的最深處。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"嗯。這樣的話......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"咦？好、好可怕的聲音......遠處有什麼爆炸了嗎......？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"仔細聽，還有呐喊和慘叫。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"是戰鬥的聲音。還沒結束。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"......可蘿爾，你害怕嗎？"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"我——"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"......我很害怕。"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"但是，為了讓我的村子平靜下來，讓我們的土地重歸安寧......我也有一定要去做的事。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"是嗎……"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"你真堅強啊。"},{"type":"dialogue","speakerName":"可蘿爾","speakerId":"avg_npc_003","isRemote":false,"text":"欸？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"沒事。事不宜遲，我們繼續前進吧。"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_1002_nsabr","aliases":["整合運動"]},{"speakerId":"char_220_grani","aliases":["格拉尼"]}]}
