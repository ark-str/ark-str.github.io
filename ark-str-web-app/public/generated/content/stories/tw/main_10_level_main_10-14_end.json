{
  "server": "tw",
  "storyId": "main_10_level_main_10-14_end",
  "groupId": "main_10",
  "stageId": "main_10-14",
  "title": "血刃高懸",
  "storyCode": "10-16",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_10-14_end.txt",
  "sourceHash": "47776337e53f0d341e40bd3c2910d07988fd1dea1c3a547dea461ad6d26d4594",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "11-end"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "還要......還要繼續加快裝填頻率？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "你們真的想徹底毀了城內的移動地塊嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "你對將軍的命令有疑問？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "我......我只是擔心這樣規模的轟炸會對城牆有影響......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "過去從來沒有過類似的事情，如果倫蒂尼姆想要更換城內的地塊的話，我們需要同步控制城牆......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "別廢話了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "你是想乖乖聽話，還是去死？只有這兩個選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我覺得他還有第三個選擇。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "你——！呃——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "還能站起來嗎，上尉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "我......我還好。你是誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "你曾經的戰友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "這裡！這裡有人混進來了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲戰士",
      "text": "這盾？哪裡來的維多利亞士兵——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "能再次用上趁手武器的感覺，還不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "上尉，我這個型號的炮......能毀掉城防武器的裝填系統嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "做......做不到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "和我想的差不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "獲救士兵",
      "text": "號角，外面的薩卡茲清乾淨了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "替我再一次感謝Misery先生的幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "上尉，還有沒有什麼別的方法，能關閉城防炮？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "不必擺出這副沉默的表情。你早就設想過我們會來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "畢竟，你甚至沒有把曾經的城防軍士兵識別碼覆蓋乾淨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "......這只是一個失誤。薩卡茲......還不會因為這個殺了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "但假如你幫了我們的話，你會被處死？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "還有我的家人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "他們受我牽連，隨時都可能被薩卡茲處決。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我明白了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "卡爾，瞄準這位城防軍的叛徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "獲救士兵",
      "text": "呃，中尉......瞄哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "這裡。瞄準我的心臟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "只有我死了......或許只有我死了，薩卡茲才能忘記我，不再糾纏我的家人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "你真想清楚了的話，我們可以配合你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "好。謝謝你，中尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "你們想關閉城防炮，只有兩個方法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "一個是逼迫那位薩卡茲將軍自己停下來......另一個是徹底炸毀這控制室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "想用第一種方法的話，我們需要擊敗曼弗雷德。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "是的。至於第二種方法......你們的火力還不夠。而且......中尉，你做好了親手毀掉倫蒂尼姆城牆一角的準備了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "我知道我們該怎麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "上尉，你自己呢......你準備好了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "維多利亞軍官",
      "text": "我等待這一刻......已經很久了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "獲救士兵",
      "text": "中尉，你沒瞄準心臟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "......糟了，手滑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "把他放在升降梯上，送他下去......他的生死至少該掌握在自己手裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "今天的城牆上已經夠熱鬧，不需要再多一位叛徒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "獲救士兵",
      "text": "那我們呢？要接著往上走嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "號角",
      "text": "走吧，我們再去見見曼弗雷德。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可露希爾",
      "text": "哇，這升降梯的速度也太快了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "先......先別說話......我怕吐在博士身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費斯特",
      "text": "畢竟我們倆剛被滑索拉著飛了幾百米......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "別再來一次了。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "習慣就好。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "都站穩了嗎？有敵人來了！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "薩卡茲戰士",
          "text": "這裡也有入侵者！立刻報告將軍！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭，擋住攻擊！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我們跟上那個報信的人。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可露希爾，我們需要儘快找到關閉城防炮的方法——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "如果這意味著必須戰勝曼弗雷德的話，那我們也需要速戰速決。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們花的時間越多，留在地下的幹員們和自救軍就越危險。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "咳咳......咳咳咳。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "被一個沒怎麼見過戰場的年輕人炸成這樣......你也太狼狽了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "......就算是小小的磐蟹，在被逼到絕境之時，也有夾傷人手的可能性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你最好賭曼弗雷德會相信。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "你不該出現在這裡。風險太大了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "所以你寧可獨自靠在廢墟上喘氣，也不願意讓我拉一把？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "唔......你想扶著我的話......最好換另一邊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "這條胳膊，拜她所賜，現在還動不了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你見過她了。你的結論是什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "她的確注意到那位“殿下”了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "那她......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "她的想法沒有改變。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你確定？我們都見過她那時候的樣子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "在她放著一身重傷不管，一路追殺那些刺客的時候，她的腦子裡難道不會期盼著......那位殿下還沒死嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "她已經不是過去那個瘋瘋癲癲的雇傭兵了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你是指她變得更瘋了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "......誰能說得準？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "事實擺在眼前，她獨自一人偷偷摸摸地進了倫蒂尼姆，半個月來沒有折騰出任何一場爆炸，甚至連曼弗雷德都沒有發現她......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "以前的她，怕是早就衝進西部大堂，趕在被赦罪師殺死之前，在特雷西斯的王座底下埋上一百顆地雷了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "我合理猜測她和那群巴別塔......不，羅德島的人一起，有了一些更聰明的打算。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "只是為了確認這一點，就差點搭上自己的命，你不覺得風險太大了一些嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "曼弗雷德的手下始終盯著我。這是唯一一個穩妥些的見面方法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "可惜了施瓦布......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "從他答應W的那一刻起，他就做好了準備。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "不，應該說......我們都做好了準備。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "......你們最好是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "誰——？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "赦罪師......的味道！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "我早就同曼弗雷德說過，你不值得信任。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "赫德雷——你以為你這些自作聰明的小動作，真的都能瞞過我們的眼睛嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "......這是一場誤會。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "哦？可惜，你不會有機會再向首領和攝政王辯解了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "不必再低著頭佯裝順從。拿起你的劍，享受你的最後一場戰鬥吧，雇傭兵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "如果......這是命令的話......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "無力的攻擊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "別試圖掩護你的同伴了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "這裡的每一片陰影......都躲不開我的眼睛。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "赫德雷......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "你先走！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "不，你不能下這種命令，我們已經費勁地走了這麼遠——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "那就更不能一起死在這裡！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "不必擔心，我會在這裡一塊處決你們兩個。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "你們可以短暫地討論一下，誰先來——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪師直屬衛兵",
          "text": "呃？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "連一點掙扎都沒有......就倒下了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "你......是你來了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "......他不該太自信。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "沒人能徹底掌握陰影。看不見的地方藏著一切可能性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "咳......咳咳咳......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "你們快走吧。想活命的話，儘快回到日光下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫德雷",
          "text": "那你呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "我還有其他任務在身。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡綸",
          "text": "要知道......來到這裡的，可不止赦罪師的僕從。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "]"
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "什麼聲音？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戰士",
          "text": "指揮官，是後面的金屬構件砸了下來——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "不止......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......他來了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "你也注意到了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "維娜，除了炮擊帶來的聲響，我沒聽見任何聲音啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......脈搏聲消失了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "跑！！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "十二隊，徹底失去信號——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "他們已經全部犧牲了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "是的......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "就在剛剛，他們的聲音完全消失了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "這些......漆黑的管道，原本會放大一切聲響。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "無論是人類的呼吸聲和腳步聲，磐蟹爬過管道的咔嗒聲，還是機械運作時的轟鳴——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "只要有生命存在，這些管道就會記錄他們的搏動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "而此時此刻......所有聲音都被吞沒了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "摩根",
          "text": "你是說，我們身後這片黑暗——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "它吞吃了一切活物。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "......跟三個月前那場貴族宴會一樣的情況。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "工程隊，關閉第一道防禦門！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戰士",
          "text": "是，指揮官！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "推進之王小姐，你......你很敏銳。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "你很熟悉倫蒂尼姆的地下結構嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "我記得，費斯特說你是......本地人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我......以前只進來過一次。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "但是關於這些管道，我聽過許多故事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "一百多年前，一場火災席捲了倫蒂尼姆的中心。只有王室和一部分貴族逃過了烈焰的捕食。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "在那之後，人們就開始傳說，王宮之下的山體裡藏著一個神奇的法陣，能讓王室成員逃過任何可怕的劫難。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "在我第一次聽說這個故事的時候，我就在想......該不會我們的王室成員也會選擇這些管道作為逃生密道吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "嗯......我聽說的故事，和你說的版本很像。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "建造倫蒂尼姆的工人，和高高在上的王公貴族，大家會被災難逼得走同一條路——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "這本身就已經是個為人津津樂道的故事了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戰士",
          "text": "指揮官，防禦門在搖晃！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "......這門擋不住他。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戰士",
          "text": "不會吧？這門的厚度至少能扛住裝甲載具的七八次轟擊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "後撤，我們繼續後撤！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "伴隨著一聲尖銳的巨響，金屬門中間出現了一道裂縫。\n在門後那股巨大力量的撕扯之下，厚重的金屬彷彿變得比紙還薄，那道縫正迅速地擴大，後面漆黑的空洞就像怪物幽深的口腔。"
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "關閉第二道防禦門！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戰士",
          "text": "是......呃啊！！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "門重重地落下，但關門的人卻像是腳下打了滑。他來不及驚叫，就被什麼看不見的東西拖入了門後的陰影裡。\n一抹血紅從門下的縫隙裡滲了出來。\n但是很快，就連這攤血液都被捕獲。轉瞬之間，從門後湧出來的陰影就吞下了大半截通道。\n轟隆，又一聲巨響，分不清是來自頭頂還是身後。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "管道搖晃起來，影子邊緣變得模糊不清，就像捕食者延展的口器，試圖勾上逃亡者的腳踝。"
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "我......我還聽過另一個故事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "在兩百年前的一場戰爭裡，維多利亞的軍隊與其他兩個國家一起，包圍了當時那座名為卡茲戴爾的城市。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "有一天晚上，一整支全副武裝的軍團在他們駐紮的山谷裡消失了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "領兵的伯爵派人去尋找他們的蹤跡，卻只看到赤色霞光映紅了整片山壁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "而所有人都記得，那天......根本沒有太陽。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "克洛維希婭",
          "text": "第三道門——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "推進之王",
          "text": "這是......最後一道門了嗎？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "克洛維希婭沒有回答她。\n就像那個答案......也被填滿了管道的怪物吞吃了一樣。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
