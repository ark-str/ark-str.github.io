{
  "server": "tw",
  "storyId": "act5d0_level_act5d0_04_end",
  "groupId": "act5d0",
  "stageId": "act5d0_04",
  "title": "7:59P.M.",
  "storyCode": "CB-4",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act5d0/level_act5d0_04_end.txt",
  "sourceHash": "e1b3493b3869cf95f93f56673bf63822d9921bfc8e6ed156ea03487cbda57f7c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的觀眾A",
      "text": "喂，這是在拍電影嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的觀眾B",
      "text": "那不是企鵝物流那群人嗎？又在打架？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的觀眾B",
      "text": "對！左勾拳！就這樣！帥喔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的觀眾A",
      "text": "每次都是他們贏，沒意思啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的觀眾B",
      "text": "也是。喂，不知道哪兒冒出來的黑服，你們不要輸太慘啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嘿咻，不能用實彈可真麻煩啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "這裡再怎麼說也是市中心，當然不能用實彈了。能天使姐，背後！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哎呀，危險危險~謝啦，可頌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "這麼糾纏下去可沒完沒了！德克薩斯小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "嗯......空和我，能天使和可頌，兵分兩路，我們去大地的盡頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "太棒...不，我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哦~分頭引開這些敵人是嗎？沒問題，我最擅長這個！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "能天使姐，路上麻煩你小心一點，賠償清單在變長......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "等等，你們說的那個“大地的盡頭”是什麼意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "一個小時後集合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "所以是什麼意思！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "可是我們要怎麼殺出去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "我有一個辦法......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "你，你想幹嘛！？你這天使——我可不怕你——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "可頌，上來！這輛摩托還挺帥的嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好，出發！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "搶車？好主意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "嗯，就你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "你別過來啊，該死的狼——你——噫噫——車、車給你，別打臉！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "嗯，空，趕緊上來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "好、好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "抓緊了，可不能比能天使他們動作慢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "還是稍、稍微慢——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "那我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "企鵝物流就把這小子丟這兒了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "那不是正好，一起上，看他怎麼反抗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "嘁！那幫傢伙一個個的在想什麼！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "該死——！這附近有沒有——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的觀眾A",
      "text": "啊，要自行車嗎？借你也可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "自、自行車......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "算了，也沒空挑剔了，謝謝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路過的觀眾A",
      "text": "好好加油啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "你竟然敢幫企鵝物流——！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "路過的觀眾A",
      "text": "反正你們有車，也追得上吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "忍著，不要對平民出手，否則我們就完蛋了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "對、對不起，追！都給我去追！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "哼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "“綁架拜松，分裂企鵝物流和峯馳物流，刺殺大帝”，你的好主意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我們的目的是取而代之。沒必要殺光那些蠢貨，這筆帳你都不會算了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "德克薩斯，她可是德克薩斯。還有那個拉特蘭人和峯馳物流的大少爺，給她們留後路，我們還會有安穩日子嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "必須得斬草除根。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "那樣會引起其他人的矚目。不止我們盯著這塊蛋糕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "哈！你怕了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "進退是需要動腦子的，蠢貨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "低聲下氣地懇請鼠王已經是我的底線，懦夫。在龍門的這些年，你變得畏首畏尾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "如果不是念在你對家族的貢獻，我早就把你趕出去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我們都有各自的事情要做，嘲諷的話一會再說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "你說的沒錯。我要用我自己的手段和企鵝物流分個勝負。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "能靠死人解決的問題，就不要讓活人互相爭執，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "......隨便你。但我最後警告你一次，這裡是龍門，不是敘拉古。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "在敘拉古的失敗之後，我就明白，我們不該放過任何一個機會，要不擇手段地摧毀敵人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "而不是妥協，商議，再落入圈套。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甘比諾",
      "text": "我們應該用西西里人最傳統的方式解決問題。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "是啊，家族不需要懦夫......也不需要匹夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "分出一支小隊，去貧民窟找鼠王。交易的內容有變。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "卡彭先生，但如果說服不了鼠王......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "哼，我們如果真想在龍門站穩腳跟，豈能容忍那隻老鼠一直趴在我們頭上？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "他遲早是我們要牽制的對象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "現在，按照這份名單一個個找過去，都是和鼠王有接觸的龍門人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑幫",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我們時間不多，今晚必須得到結果，分秒必爭，快。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "我在龍門這麼多年什麼都沒幹......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "text": "錯了，甘比諾·里奇，大錯特錯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
