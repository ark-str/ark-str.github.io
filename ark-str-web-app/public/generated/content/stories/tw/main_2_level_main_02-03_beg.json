{"server":"tw","storyId":"main_2_level_main_02-03_beg","groupId":"main_2","stageId":"main_02-03","title":"無罪推定","storyCode":"2-3","avgTag":"行動前","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_02-03_beg.txt","sourceHash":"87dfb8a6b6da605cd0cef2e99381902acaab6dae8ff89c3423bd508ad90f8d38","bodyAvailable":true,"blocks":[{"type":"narration","text":"第十五关（前）"},{"type":"background","backgroundId":"bg_lungmen_b"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_012_misa","isRemote":false,"text":"快藏起來！"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_012_misa","isRemote":false,"text":"我......我必須走了。"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_012_misa","isRemote":false,"text":"這個......這個，給你們。"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_012_misa","isRemote":false,"text":"這是我們的護身符，是我媽媽親手教我做的......"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_012_misa","isRemote":false,"text":"給你們的這個是我做的。"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_012_misa","isRemote":false,"text":"親手做的布偶，能保證重要的人平安無事。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"小孩們","speakerId":null,"isRemote":false,"text":"嗯，米莎姐姐，我們會好好保管它的！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"真乖。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"藏好！別出聲。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"小孩們","speakerId":null,"isRemote":false,"text":"嗯！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"往哪去了？！你們，追！看那些感染者還能跑多遠！"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"嗯？這裡......看來還有些東西呢？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......依據能天使的情報，任務目標一定在這附近逗留過才對......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"啊啊，這裡的地形真是很複雜，光憑羅德島，這個任務果然也有些麻煩呢......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"幸好聯繫了企鵝物流......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......有人？"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"這些人是......！"},{"type":"dialogue","speakerName":"小孩","speakerId":null,"isRemote":false,"text":"壞蛋！你們這些壞蛋！放開我！放——開——！"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"說！她往哪跑了？"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"別不知好歹！"},{"type":"dialogue","speakerName":"小孩","speakerId":null,"isRemote":false,"text":"龍姐姐！龍姐姐！你在哪裡！救命啊——"},{"type":"dialogue","speakerName":"小孩","speakerId":null,"isRemote":false,"text":"米莎姐姐！米莎姐姐，救救我！！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"誰？"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"別想走！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......我勸你們，立刻離開。"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"......？！"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"你——？！"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"哪裡來的外地人！"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"你就不怕我們......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"否則——"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"啊？"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"咕啊！！"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"那，那是什麼？"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"法術！她，她在使用法術？！"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"啊啊啊！別過來！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"——以後別再做些欺壓弱小的事情。"},{"type":"dialogue","speakerName":"暴民","speakerId":null,"isRemote":false,"text":"呃呃啊，怪物！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"呵......怪物......嗎。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"好啦，沒事了，都出來吧。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"這裡危險，快去安全點的地方吧。"},{"type":"dialogue","speakerName":"小孩們","speakerId":null,"isRemote":false,"text":"謝謝你，兔姐姐！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"都小心點啊！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"阿米婭，這是什麼情況？"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"嗯，我看見了一個，應該也是未登記的感染者......"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"烏薩斯人？"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"是的，烏薩斯人，她往貧民區更深處去了。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"芙蘭卡，讓附近參與搜查的幹員集合。"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"Ok。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"越往貧民區前進，形勢就越複雜......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"一般居民，犯罪分子，未確認身份的流民......層出不窮。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"必須多加準備才行。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"有通訊，阿米婭。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"請稍等一下。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"是。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"阿米婭，是近衛局。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"是陳長官？"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"沒錯。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"——是的，我們已經搜查出了不少非登記感染者。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"——是的。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"——什麼？"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"——白色短髮，烏薩斯人，少年女性，身高一米四五左右，名叫米莎？"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"這是——？"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"——明白。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"阿米婭，陳長官要求我們，立即搜查具備這種特徵的感染者。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"一經發現，立刻交給近衛局。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"請給我一下通訊設備。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"喂，喂......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"陳長官，你聽得到嗎？"},{"type":"dialogue","speakerName":"陳","speakerId":"char_010_chen","isRemote":true,"text":"我聽得到。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"我能否確認下，剛才你下達命令的有效性？"},{"type":"dialogue","speakerName":"陳","speakerId":"char_002_amiya","isRemote":false,"text":"真實可靠，立刻執行。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"明白了。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"突然就掛斷了......"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"陳長官，好硬的脾氣啊。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"那這就是我們接下來所要執行的任務了。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"阿米婭......幾位重裝幹員向我發來了另一條通訊。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"他們遭遇了對羅德島幹員展現出攻擊傾向的人。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"而且，那些襲擊者不是普通人，他們是......感染者。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......讓重裝幹員們向我們目前所在的區域撤退。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"偵察小隊！去追蹤任務目標，白髮烏薩斯少女，身高1.45米，務必注意隱蔽和安全！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"其他幹員，跟隨各自的隊長散開。"},{"type":"choice","options":[{"label":"以逸待勞，很好。","value":"1","blocks":[]},{"label":"這是......誘敵深入？","value":"2","blocks":[]},{"label":"芙蘭卡小姐，我們是不是要伏擊敵人？","value":"3","blocks":[]}]},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"喲——不錯嘛。"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"雷蛇，這孩子很聰明呢。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"......Dr.{@nickname}可是戰術指揮官，你嚴肅點。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"行動吧。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"攻擊羅德島的感染者......嗎。"},{"type":"sceneBreak"},{"type":"background","backgroundId":null}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米婭","陳"]},{"speakerId":"char_010_chen","aliases":["陳"]},{"speakerId":"char_012_misa","aliases":["？？？","米莎"]},{"speakerId":"char_106_franka","aliases":["芙蘭卡"]},{"speakerId":"char_107_liskam","aliases":["雷蛇"]}]}
