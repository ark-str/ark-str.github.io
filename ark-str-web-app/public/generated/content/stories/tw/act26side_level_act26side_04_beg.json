      "type": "dialogue",
      "speakerName": "艾倫戴爾",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "讓我們在這裡等一個兇巴巴的，和她一樣頭頂有黑色圈圈的大哥哥！"
