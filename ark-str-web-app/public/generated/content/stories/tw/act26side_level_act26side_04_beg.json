      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "建議你選擇後者。這是更安全的選擇。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "（沒有人？）"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "（不對。）"
    },
    {
      "type": "sceneBreak"
    },
