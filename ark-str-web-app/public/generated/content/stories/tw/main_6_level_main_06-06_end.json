{
  "server": "tw",
  "storyId": "main_6_level_main_06-06_end",
  "groupId": "main_6",
  "stageId": "main_06-06",
  "title": "斷弦",
  "storyCode": "6-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_06-06_end.txt",
  "sourceHash": "5ea65d585877b79f8ae4517f31d8491c80ca80fd4264f6417ea3784380a5ef3a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "他不哭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "他這個眼神，怎麼和腦死了一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "他我可憐不起來。我可憐浮士德，他救了我的命，也是個好指揮官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德把梅菲斯特託付給了我們......這是他最後的命令。我們會做到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "干我什麼事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "一起出城，你們存活的可能性會大些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "......行，那走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "你們要把他帶去哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德說過，不希望我們帶他回切爾諾伯格。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......可他又有哪裡可以去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "你們跟浮士德多久了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "哈......一開始，是他跟著我們才對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "四五年前，浮士德並不會用什麼戰術，弩箭用的也並不好。這些都是我們教他的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "他不斷地學，不斷地練習，和雪怪切磋，和愛國者的士兵一起訓練，他越來越強......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "愛國者和霜星都教過他。他成了我們的隊長，雖然我們不怎麼這麼叫他，但他名副其實。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "......你們很幸運。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "不管梅菲斯特怎麼樣，浮士德從來沒逼我們做過什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "射手們，不要省高爆弩彈了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "這些弩彈，一會兒還能用來對付近衛局啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德一直堅持為我們死去的隊友這麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "“表達敬意可以不算是浪費。”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "灰喉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "他......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "如果我沒記錯，他應該是梅菲斯特身邊的弩手，整合運動的另一位指揮官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "......你認識他？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "我不知道。我不知道自己和他......算不算認識。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "羅德島能做的事，好像真的不多。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "是啊。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "羅德島就是這樣......大多數時候，都是這樣。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "但哪怕只有一點點能做的，我們也會去做。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我們一定會去做。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "博士是在想過去的事情嗎？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "是在想......過去也看過許多次死亡？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "我是猜不出博士的心思，也不想直接感知博士你的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "因為......我想博士有一天能親自告訴我。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "我們真的有成功救下過什麼感染者嗎？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "......幹員們付出了許多。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "死亡會比拯救更令人印象深刻。任何一次死亡，都會很難忘。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "但是我很清楚，如果沒有幹員們的努力，我們會看見更多死亡。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "更多，更多，更多的死亡......",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "以前我以為，羅德島就是為了感染者去戰鬥的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "可是現在，倒在我們手下的卻都是感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "阿米婭......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "羅德島在為什麼而戰？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "你現在問這種問題？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "煌。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "......你說吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這個問題，我也常常問自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "感染者，普通人，每天都在我們面前死去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......我們不會，也不應該只是“阻止一次死亡”。對於這片大地來說，這沒有意義。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "就像現在......就像我們面對的這場戰鬥一樣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "讓戰鬥雙方死去的，絕不是一把弩，一個法術......一場爆炸或是一個傷口。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們要戰勝的，是催生了這一切的......普通人對感染者的仇視，感染者對普通人的仇視，他們互相廝殺的理由。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我們要剷除滋生仇恨的土壤。既用藥物，也用行動。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "啊——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "那是不是整合運動發射的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......是施加了源石技藝的弩彈。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "好爛的煙火啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "按臨光說的，在切爾諾伯格的時候，這長鱗的小子還有著相當強的戰鬥力。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "她說那時候她的胳膊都差點被打斷，憑我對這個女人的瞭解，至少我肯定是打不斷的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "但剛才我只覺得他的弦已經完了，弩彈裡也沒剩下多少法術。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "怎麼回事啊，臭小子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "我想，他可能......沒有理由再戰鬥下去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "我說，阿米婭，有沒有他用法術避過了攻擊的可能性？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......抱歉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "道什麼歉啊。我只是可惜那個小子。憑我一眼看穿人的本事看，他不壞。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "現在說什麼都太晚了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "並不晚。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "過去埋下的悲劇，現在開花結果......而未來的悲劇，我們還有能力去阻止。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "我去回收他的弩。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "她開竅了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你不知道她的過去嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "她沒告訴我啊？我們也沒那麼熟。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "她的父母是礦石病學者，為了感染者研究礦石病，卻死在了一場感染者與當局發生的衝突之中。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "她只是認為，我們遭遇的和她遭遇的並沒有區別。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "灰喉比你想的敏感得多。她大概只是不想表達。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "不肯說出來，我哪知道......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "他是你的朋友嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "......我不知道。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "你是誰？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "需要我自我介紹嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "不用了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "和感染者做朋友是很危險的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "我不在乎朋友是不是感染者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "這樣嗎......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "節哀順變。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "......為什麼要問我這些？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "因為我很怕你和感染者做朋友。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "阿米婭，通訊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "這裡是阿米婭。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "嘉維爾？你在哪裡？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......貧民區底部通道？有新通道，怎麼會？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......黑色雨披，以及......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "雪怪小隊？他們在和逃入貧民區的整合運動會合？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "......最壞的事還是發生了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
