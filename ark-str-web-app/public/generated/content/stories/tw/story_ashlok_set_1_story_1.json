      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿貝特",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "偷聽的時候要放下你的重盾和火炮，格蕾納蒂。"
