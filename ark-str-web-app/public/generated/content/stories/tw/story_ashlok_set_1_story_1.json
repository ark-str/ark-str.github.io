    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貴族騎士",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "真是精彩絕倫的比賽，阿貝特·伯雷斯瓦夫。"
