    {
      "type": "dialogue",
      "speakerName": "阿貝特",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "稍微督促一下自己嘛。我的目標和你一樣，都是錦標賽的冠軍。"
