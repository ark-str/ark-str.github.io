  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十八关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": null,
      "text": "到了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "——？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "還要上天台嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......這道門，這道門是鎖著的。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "退後，讓我用法術把門鎖——"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "text": "用不著吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "text": "踹開就得了。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "雷蛇，多學學。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "各有各的風格不行嗎？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......前面是屋頂。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "我大概明白了......"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "阿米婭，那邊！從那邊就能到另外一邊！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "“那邊”是哪......你是說我們可以從——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "從樓頂轉移？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "Bingo——！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "誰能想到呢！萬無一失了是不是！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "龍門啊，可是一座有著很多秘密的好——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "speakerId": null,
      "text": "別想跑——！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "......咦？這什麼呀？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "能天使，敵人也用意想不到的方式出場了......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "我已經堵住了入口，怎麼會——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "難道是從附近的建築裡......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "他們背著的噴氣背包雖然比較簡陋，但是好像完全不影響使用。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "要是讓他們從沒有設防的地方進來的話，就不妙了......"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "呿，等著，我馬上去救你們。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙蘭卡",
      "speakerId": "char_106_franka",
      "text": "那就麻煩你動作快些了，拉特蘭的救世主小姐。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "重裝小隊，防禦陣型！快！"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerId": "char_102_texas",
      "text": "......上了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "speakerId": "char_002_amiya",
      "text": "大家，掩護先鋒！"
    },
    {
      "type": "sceneBreak"
    }
  ],
