{"server":"tw","storyId":"main_2_level_main_02-10_beg","groupId":"main_2","stageId":"main_02-10","title":"病入膏肓","storyCode":"2-10","avgTag":"行動前","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_02-10_beg.txt","sourceHash":"f9cc7f4506465f1ea7e900c6bc81d03f11b1bbd70b47ceb4fb729b8f235c08e9","bodyAvailable":true,"blocks":[{"type":"narration","text":"第二十二关（前）"},{"type":"background","backgroundId":"bg_lungmen_r"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"雷蛇！防線還撐得住嗎？"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"我這邊，沒有問題！"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"芙蘭卡，注意敵人側翼進攻！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"真是沒完沒了......！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"這樣的防禦你們就別想打破了。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"看我就這樣把你撞......"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"唔？！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"呃，呃呃呃啊！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"這是什麼？！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"是鋁熱劍哦。"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"切開算打破嗎？"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"煩人......"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"醫療組！這裡有傷患！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"轉移他們的時候，動作輕點！"},{"type":"dialogue","speakerName":"醫療幹員","speakerId":null,"isRemote":false,"text":"這我還是知道的！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"阿米婭！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"你的情況呢？"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"我們這裡好像出了些小情況。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"芙蘭卡......"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"敵方的首領......就出現在我和雷蛇面前！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"————"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你們還想藏到哪裡去？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"逃不掉的，羅德島。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我會粉碎你們——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"——徹徹底底地粉碎你們。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你們這些......感染者的叛徒！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"哦~這傢伙終於親自登場了。"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"雖然聽起來還是蠻寒酸的......呢。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"阿米婭，我們好像——"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"啊，死胡同！"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"我好像跑過頭了？！"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"芙蘭卡那裡也是....."},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"我們被整合運動逼入死路了。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"只能硬上了。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"我覺得，我們完全有擊潰敵人的實力。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"稍稍用力一些也......"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"這你就不懂了啊雷蛇。"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":false,"text":"無論我們展現出多少實力，可都不能讓近衛局感到有威脅哦？"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"總不能看著自己陷入危機吧！"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":false,"text":"重裝小組，守住陣地！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"羅德島的領導人......嗎。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"身為感染者，卻幫助龍門殺害感染者！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"多少同胞的性命，你們都得血債血償！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"給我進攻！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"————"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"整合運動————"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"先結仇的、先傷害別人的、先使用暴力的——"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"可是切爾諾伯格的你們！！"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米婭"]},{"speakerId":"char_1002_nsabr","aliases":["整合運動成員"]},{"speakerId":"char_106_franka","aliases":["芙蘭卡"]},{"speakerId":"char_107_liskam","aliases":["雷蛇"]},{"speakerId":"char_1500_skulsr","aliase