{
  "server": "tw",
  "storyId": "act20side_level_act20side_07_end",
  "groupId": "act20side",
  "stageId": "act20side_07",
  "title": "生活之道",
  "storyCode": "IC-7",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act20side/level_act20side_07_end.txt",
  "sourceHash": "fb47c770243603896a9ae07847aa9ebd68571e6659f153702641d9001b43b3d8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "各位際崖城的居民，你們好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "耶奇大師的勘測結果已經出爐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "活性源石礦脈的爆發時間，大約在二十五天後。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "從現在開始，際崖城將正式進入撤離的準備階段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "接下來，經過各位代表的討論後，將在合適的時間於廣場舉行一場全體會議。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "屆時，我們將討論具體的撤離方案，以及城市的遺容。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "廣播",
      "text": "請各位際崖城居民注意收聽廣播。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "黛柯綺，醒醒，黛柯綺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "睡著的黛柯綺·銀幣",
      "text": "......機器人斯第奇，真聽話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "......黛柯綺，黛柯綺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "睡著的黛柯綺·銀幣",
      "text": "機器人卡奇，笨笨的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "睡著的黛柯綺·銀幣",
      "text": "你們，打一架。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "你到底在做什麼夢啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "黛柯綺！醒醒！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "嗯？怎麼了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "......我還想問你呢，你怎麼又在斯第奇的花園裡午睡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "因為斯第奇的花園很安靜啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "看你睡得這麼死，肯定也沒聽到廣播吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "發生什麼事了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "......耶奇大師去湖對岸勘測過後，發現了源石礦脈被之前的地震拉扯到了隧道出口的附近，而且活性化已經十分厲害了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "我們接下來要開一次全體會議，決定如何避難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "但是，你應該不是特意來告訴我這個的吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "......沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "我是來找斯第奇的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "斯第奇的話，他應該乘坐我借給他的船去湖對岸找耶奇大師他們去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "是嗎，那我在這裡等他吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "你找他有事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "嗯，我希望，他......能回到設計部來參與穹頂的設計修改。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "既然際崖城面臨毀滅，我們關於這座城市地標的比拼已經毫無意義，但好在我們還有些時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "那麼，我們在之後的大會上肯定需要決定，該如何處理地震留下的穹頂缺口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "就那麼放著不管我覺得也可以吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "即使如此，那也要城裡的居民們都同意才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "讓一座城市在這片土地上存在的最後一瞬間趨於完美，這對於每個建築設計師來說都是非常有意義的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "我們會對這座城市進行最後一次觀察，並且給出一個在有限的時間裡能夠完成的方案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "所以，你希望斯第奇能夠回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "我不知道芬奇大師為什麼會忽然離開，別人或許會以為，是因為他們師徒的感情淡了，或者緣分盡了，但我知道，這是不可能的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "作為芬奇大師過去的助手，我比任何人都瞭解，他雖然是個十分豪放的人，但心底裡其實非常關心斯第奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "對他來說，斯第奇就像他的親生兒子一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "所以，他的離開一定和斯第奇有密不可分的關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "而斯第奇在大師離開後的情況，身為工業代表你也看在眼裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "他從一次次提出的方案被否決，到逐漸不再在設計部出現，在這中間，我一直想要幫他，卻始終沒有找到辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "這座穹頂，是斯第奇的老師，芬奇大師留給這座城市最宏偉的作品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "但這座穹頂，對斯第奇來說，會不會反而是一種負擔呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "即使如此，你也不希望他留下遺憾，對嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "這是最後的機會了，黛柯綺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "真有你的風格。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "斯第奇，斯第奇！你在嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "嗯？怎麼是你們兩個？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "卡奇，原來你和黛柯綺是這種關係嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "哇哦，好果斷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "你就別拿我開玩笑了，極境哥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "耶奇大師，嘉維爾小姐，你們辛苦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "我在這裡午睡，他在這裡等斯第奇回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "斯第奇沒有回來嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "他不是應該給大師你們送設備去了嗎？還鬧出了不小的動靜呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "但他中途就不見了，我們都不知道他去哪了，結果他也沒有回家嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "特米米遇到過這小子，說他的表情好像很難受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "你們有什麼頭緒嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "我......不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "......我可能知道。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪的機械",
      "text": "祖瑪瑪，祖瑪瑪，這一列，也沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "嗯，看看下一列吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "哎，我有些累了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "居然到現在都沒找到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "你休息一下吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "關於剛才的問題，我還是想知道為什麼，祖瑪瑪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "你不會沒有發現在杜林城邦的生活有多麼美好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "這裡沒有貴族陰謀，沒有勾心鬥角——即使有，也都是可愛的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "即使是我們即將面臨的災難，杜林對其也有足夠的預案，他們現在甚至能夠悠閒地思考——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "如何讓際崖城以他們認為最好的姿態迎接毀滅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我沒有否定你的想法啊，阿芙朵嘉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我覺得你說的挺對的，杜林的生活挺好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我拒絕你的理由不是覺得你說的這些不好，而是......我不喜歡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "要是到時候有提亞卡烏願意來地下生活的話，我想，我也好，依娜姆也好，都不會阻止的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "為什麼？我並不是單單因為自身的經歷而排斥地面的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "在杜林城邦的這段日子裡，我思考過許多次這樣的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我認為，從結果上來說，杜林人過的生活無疑是一種更好的，更有人文追求的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "但為什麼你也好，嘉維爾也好，都對於一種更好的生活不感興趣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我的師父除了對於機械知識非常精通之外，也是個影視迷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "她經常會拉著我看各種各樣的東西，並且根本不管我感不感興趣就給我講解，久而久之，我也記住了一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "比如，她在看到劇中人開始長篇大論的時候，總是會說——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "“唉，這種義正詞嚴地長篇大論的人，一般最後要嘛是反派，要嘛是主角的絆腳石，就不能設計點可愛的角色嗎......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "為什麼你一定要說服我，或者說服嘉維爾呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "噢，順便一提，小姑娘，關於杜林，你的看法實際上並不正確。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "為什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "如果你說，在杜林城邦的生活是一種“更便捷”“更舒適”“更安全”之類的生活，我都不會反駁你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "但你認為，杜林人過的生活是一種“更好的”生活，只有這一點，或許並不是這樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "你是個聰明的孩子，不會不瞭解這其中的差別。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "老先生......我暫且這麼稱呼您，我明白您的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "但是，難道說，我希望其他人過上物質上和精神上都更加富足的生活是錯的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "這是另一個問題，現在的你，只是希望從一場早已結束的辯論中挽回自己的一點顏面，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "也就是說，你覺得斯第奇因為心理壓力太大，所以選擇了逃避？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "如果是這樣的話，我想，他現在可能去了湖邊的一座小房子裡吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "在他搬到這棟房子來之前，那裡是他和他的老師一起生活的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "卡奇，你明白我想說什麼吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "如果最後決定要修改穹頂設計，而斯第奇還是不願意的話，由我來，是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "這不僅僅是為了城市的遺容，從現實的角度來說，穹頂的加固也能為我們的撤離爭取更多的時間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "我和芬奇是好朋友，對於他的不告而別我也搞不懂，所以之前，我也想著儘量照看一下他的弟子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "耶奇·地心",
      "text": "但凡事都有個界限。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "......嘉維爾小姐，能麻煩你去找一找斯第奇嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "不用你說，我也正打算去呢，特米米自告奮勇去幫城裡的人做事了，我正愁沒事幹呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "現在看來，我和他之間可能有筆小帳要算呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "......那就拜託你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "那棟房子在哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "就在湖邊，和這棟房子的風格很像，很獨特，過去就能看到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "卡奇，你不去嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "我......我不知道在這種情況下，應該怎麼面對斯第奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "但你很關心他，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "在芬奇大師不告而別後，我一直想要幫助他，卻不知道該怎麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "你啊，該說你是人太好了呢，還是人太太太好了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "不過，你們杜林人確實整體上給我的感覺是這樣沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "出於我也不知道的原因，斯第奇其實是比較自卑的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "對他這種性格的人來說，你以你認為平等的態度去和他交流，在他看來，其實就是一種高姿態的施壓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "因為對他來說，光是偽裝出自己和你平等的態度就已經竭盡全力了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "與人交流不是付出一片真心就一定能夠有回報的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "那，我該怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "既然你喊我一聲極境哥，那我這個做哥哥的，自然也要給你支兩招。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "其實很簡單，你不要去說什麼我希望你和我公平競爭，不要跟他說，你有選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "你要封住他的退路，告訴他，你沒得選，但我會和你一起努力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "對於把自己關在自己製造的小空間裡太久的人，有的時候，是需要一些刺激的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "黛柯綺小姐覺得呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "為什麼要問我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "我只是說了一些我的猜測，而你，顯然是在場的人中最瞭解他的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "......斯第奇他確實是有些自卑的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "或許你說得確實沒錯吧，他需要的不是溫柔的安慰，而是有人狠狠地拉他一把。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "這樣，不會傷到他嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "會，而且不一定會有好的效果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "但是，如果如你所說，這是他最後的機會——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "你也要問問你自己，你究竟只是想要和他關係變好，還是說，即使關係惡化，你也希望他走出來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "我會去試試。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "那我建議你快一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "不然的話，嘉維爾的拳頭，可就不是“拉一把”那麼簡單了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡奇·敘光",
      "text": "哈哈，那我就先去了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "活潑，外向，懂得社交，這些確實都是很好的品質，卡奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "你認為人應該變成這樣，而你也確實是在這麼做的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "但你不能總是想要讓別人變得和你一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "極境的話也是對的，如果我要幫斯第奇的話，或許我也會這麼做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "但我覺得苦惱和逃避也是對的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "所以......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "卡奇，既然你要按照你的想法去做，那我也要按照我的想法去做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "如果斯第奇想要逃，我會幫他逃。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪的機械",
      "text": "黛柯綺，黛柯綺，你找我們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯綺·銀幣",
      "text": "去吧，去幫斯第奇。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "......黛柯綺小姐，如果她不是故意的，那就是她並沒有發現自己的表情其實很好讀懂吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "她其實並不同意我的話，呵呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "嗯——好久沒有感到這麼青春的氛圍了，我都有點想去湊熱鬧啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "算了，真過去的話，說不定會被嘉維爾捲進去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "我可不想平白無故挨一頓揍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "所以，斯第奇啊，你也該醒一醒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "極境",
      "text": "有這麼多人都想要幫你呢，視而不見可是會遭報應的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我不明白，你們明明不像嘉維爾那樣不講道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "為什麼你們會這麼地——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "慣著她？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "因為看到嘉維爾這樣的人，你難道不覺得，我們需要這樣的人嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "依娜姆，你不是在外面嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "看你們半天不出來，還以為你們在幹什麼呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "阿芙朵嘉，其實我們是有些相似的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "我會來阿卡胡拉當信使，很大一部分原因，其實是想要逃避無止境的王酋之間的傾軋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "阿卡胡拉什麼都沒有，但是在這裡的生活很舒服，我很喜歡這片土地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "而且，要說擔心，我比你更擔心杜林的到來會不會引發什麼問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "那你為什麼還......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "嘉維爾離開了阿卡胡拉這麼多年，一點也沒有改變。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "彷彿這片大地上沒有什麼東西能夠讓她屈服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "看到嘉維爾，我就會想，啊，這片大地上還是有這樣的人的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "我會忍不住地想要幫她一把。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "就這麼簡單。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "在跟著嘉維爾離開阿卡胡拉前，我也十分無知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我跟著羅德島看到了許多東西，但我逐漸發現，我真正學到的，並不只是知識。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "這片大地上有著許多我沒有想過，但又理所當然的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "嘉維爾一定也已經見過許多她也無能為力的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我的夢想是造出這片大地上最厲害的機器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "但造出來之後該用來做什麼呢，我其實也沒有想好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "不過，看著嘉維爾，我逐漸有了一個想法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我製造的機器，會用來幫助嘉維爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "總有一天，嘉維爾的拳頭會遇到砸不穿的牆壁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "但那並不是她的問題，她畢竟也是血肉之軀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "而我會像這一次一樣，給她最好的武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "拳頭不行，那就用斧頭。斧頭不行，那就用錘子。錘子不行，那就用電鑽。電鑽不行，那我就給她造一台大醜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "如果大醜還不行，那我就給她造一座移動城市，她想用來幹什麼，就用來幹什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "你就這麼信任她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "因為嘉維爾比任何東西都能代表阿卡胡拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "她是我們的主心骨，她也將成為更多人的主心骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "而我們能做的，就是讓嘉維爾的拳頭永遠不受阻礙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "當然，實際上我也挺擔心，真的把阿卡胡拉交給她來管會成什麼樣子就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "以嘉維爾的性格，讓她去擁有權力，權力可能會比她還不自在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "所以，其實如果她真的來當王酋的話，我是打算給她狠狠培訓一段時間的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "大概不會有效果吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "哈哈，我猜也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "只是，連我自己都沒想到，我居然願意為了她做到這一步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "你的經歷讓你始終對嘉維爾這樣的人心存懷疑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我不否認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "那麼，或許你可以試著從相信她開始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......我會嘗試一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "所以說，地圖呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "啊......我忘記了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "噢，在你們為了嘉維爾吵得不可開交的時候，只有我這把老骨頭和這些機器人在認真尋找著地圖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "並且，我從剛才就發現了，這面書架上的書，和遊記根本沒有關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "所以，我就去了書架的另一面找了找，一下子就找到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "是這個沒錯吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "依娜姆",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪的機械",
      "text": "阿芙朵嘉，笨蛋，阿芙朵嘉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......好啦，我知道錯啦，對不起！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "這樣可以了吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "啊，阿芙朵嘉，太好了，你還在這裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克羅綺·磚石",
      "text": "耶奇大師剛才發來了通訊，他提議現在就在廣場舉行全體大會，其他代表都已經同意了，問問你的意見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "謝謝你，祖瑪瑪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我雖然還是沒有完全接受，但或許——我確實可以嘗試一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "克羅綺，告訴耶奇大師，就說，我沒有問題，並且，我會來說服際崖城的居民們。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
