{
  "server": "tw",
  "storyId": "act21side_level_act21side_06_beg",
  "groupId": "act21side",
  "stageId": "act21side_06",
  "title": "舊日碾軋",
  "storyCode": "IS-6",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act21side/level_act21side_06_beg.txt",
  "sourceHash": "c644957ca511e7b345b76f04c3b974413039add0764aafabf91b1b43bda8072d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......嘶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家族成員",
      "text": "少爺，您沒事吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "做了個夢而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "果然不能在沙發上睡覺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "老頭子呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家族成員",
      "text": "首領已經前往劇院了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家族成員",
      "text": "您要去嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "萊昂圖索將身體陷入沙發之中，沒有回答。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "羅塞蒂，喬萬娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "切利尼娜，你我之間最初的約定，是為貝洛內贏得最後的勝利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "不過，我改變了主意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "只要你能完成這件事，你就不再欠貝洛內任何東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "屆時，你可以自由地離開。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "我以狼之主扎羅的獠牙身份向你保證。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "嘖嘖，明明在下雨，太陽倒還是挺刺眼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "監獄裡的伙食還挺好的，建議你們也嘗試一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠誠的家族成員",
      "text": "確實不錯，我以前還給他們提過幾次建議。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠誠的家族成員",
      "text": "請上車吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "我可以不參加嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "殺一個哥倫比亞人而已，用得著這麼大張旗鼓嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠誠的家族成員",
      "text": "老爺說，切利尼娜也會參加。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "什麼安排？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠誠的家族成員",
      "text": "她會喬裝成劇團的成員，在演出開始後，見機行動。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "嗯......那我的演出服呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠誠的家族成員",
      "text": "老爺的意思是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠誠的家族成員",
      "text": "請您在觀眾席隨機應變。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "......呵，呵呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "不解風情的老東西，他人呢，難道他想找個好位置自己看戲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠誠的家族成員",
      "text": "老爺另外有事，他要去見一個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "見一個人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠誠的家族成員",
      "text": "是的，一個洗車工。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "啊，空，我就知道你會在卡特琳娜小姐的工作室裡練習。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我倒是不反對啦，但是，還是提前去劇院化妝準備演出比較好吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "......嗯，說的也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "能天使已經去買早飯了，我們正好去和她會合吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "對了，之前我們不是說要辦個歡迎會迎接能天使的姐姐嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "對啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "現在都不知道能不能趕得上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "可頌，當心腳下！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哎？哎呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "好疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "你沒事吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "沒事沒事，被絆了一跤而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "哎呀，這一摞書都弄倒了，我收拾一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯？好像掉出來幾張照片。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "照片？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "你看。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "這是一張很多年前的照片。\n空勉強能夠辨認出，背景應該是多年以前的哥倫比亞街頭，繁華又寬闊。\n站在照片中央的，是一位中年男子，他的表情和藹，卻帶著讓人無法輕視的魄力。\n他的左右兩邊，站著一個魯珀女孩和一個菲林女孩。\n左邊的有著一頭秀麗的金髮，表情明快，一眼就能看出性格十分開朗。\n而右邊的則有著一頭黑髮，臉上沒有表情，讓人看不出心裡到底在想什麼。"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "你看，這張照片上的，是不是......小時候的德克薩斯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "然後站在她旁邊的，是卡特琳娜小姐？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "你看照片的背後......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "照片的背後寫著一行字，“喬萬娜與切利尼娜，攝於1080”。"
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "喬萬娜，這難道是卡特琳娜小姐的真名？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "喬萬娜......喬萬娜·羅塞蒂。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "這家店開多久了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "五年了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "五年，巧了，我有條看門牙獸也走失了五年了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "也不知道，它現在過得還好不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "......這座城市這麼大，總有活下去的法子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "我之前一直不明白，我給它餵的肉也夠多，窩也夠好，它有什麼不滿意的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "難道說，它其實是吃素的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "也有可能，它只是真正開過一次葷之後，才知道，平時吃的肉有多難吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "難吃的肉......不如不吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "您的車洗好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "洗車手藝不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "熟能生巧罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "呵，你總是能把手上的事情做好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "但是，大廈將傾，丹布朗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "你也該換換口味了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "......我會考慮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿爾貝托",
      "text": "好好想想，想通了，隨時可以回來。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "你就是臨時替補貝斯手的人嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "對。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "嗯......嗯？你的髮色，是天生的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "真稀奇啊，其他人演貝斯手這個角色都是要染的，這個髮色和瞳色據說和德克薩斯這個家族有血緣關係的人才會有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "而且仔細一看，你的眉眼......和薩爾瓦多雷也有點像，你難道是他們的私生子之類的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......不，我和德克薩斯無關。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "好吧，也會有這樣的巧合呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "來，坐下吧，你的底子很好，應該不用太麻煩就能給你化好妝。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "劇院包廂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "劇場經理",
      "text": "請問，您對這個位置滿意嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "嗯，視野不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "劇場經理",
      "text": "那就好，那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "劇場經理",
      "text": "如果您有什麼需要，請隨時喊我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "下去吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "瓦拉赫，你不留下一起看嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "你知道，我對這一類的東西向來不感冒，還是去給你拿幾支好酒吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "我要——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "text": "白蘭地，我知道。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "抱歉，我來晚了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "沒事沒事，大家都還在準備呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "坐吧，我先給你化好妝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "怎麼了，你的臉色不太好，是太緊張了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "......不，沒什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "沒事的，空你這麼努力，大家一定會喜歡你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "但願吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "對了，你知道嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "樂團的貝斯手好像突然生病沒法出演了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "欸，那怎麼辦？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "別急，總監臨時找到了演員，現在正在另一間化妝室化妝呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "臨時找到的......真的沒問題嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "相信總監的眼光吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "這麼說起來，總監今天沒有來嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "總監剛剛來過，吩咐了一些事情，然後就離開了，好像是要見一位客人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "大人物就是這麼忙碌的啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "沒事的，空，你只要做好你能做的部分就可以了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "場務人員",
      "text": "哎呀，這不是法官閣下嗎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "場務人員",
      "text": "您有好一陣子沒來了吧，您也是來看今天上演的歌舞劇的嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......不，我只是路過罷了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "場務人員",
      "text": "這樣啊，但是現在上演的是備受期待的《德克薩斯之死》，您一定會喜歡的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......抱歉，我沒有心情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "場務人員",
      "text": "好吧，期待您下次的光臨。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "（丹布朗？他怎麼會來這裡？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "（難道說......他聽從了我的建議，想要來劇院放鬆一下？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "（但是，今天的劇院......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "等等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "場務人員",
      "text": "難道說，您改變主意了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "沒錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉維妮婭",
      "text": "給我一張票。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "劇院包廂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "家族成員",
      "text": "首領，有人想要見您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家族成員",
      "text": "是食品安全部部長盧比奧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "請他進來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家族成員",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "貝納爾多閣下——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "在這裡，叫我總監就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盧比奧",
      "text": "啊，好的，好的，能見到您十分榮幸，總監閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "坐吧，盧比奧部長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貝納爾多",
      "text": "先看劇，我們再聊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "報幕人",
      "text": "女士們，先生們，歡迎前來觀看由白日劇團帶來的精彩演出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報幕人",
      "text": "由卡特琳娜女士撰寫的《德克薩斯之死》，第二幕的演出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報幕人",
      "text": "薩爾瓦多雷的故事，想必每個敘拉古人都耳熟能詳，然而，真正瞭解其中那些細節的人又有多少？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報幕人",
      "text": "對德克薩斯家族有著深入瞭解的卡特琳娜女士，為我們提供了一個平實且細緻的視角。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "報幕人",
      "text": "就讓我們在此處，一同瞭解那位薩爾瓦多雷的一生吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "嘶......呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "化妝師",
      "text": "空，加油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "嗯，那我去了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "呼......終於找到我們的位置了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "不愧是空，給我們留的位置視野真好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "空畢竟被賦予厚望了嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "抱歉，能讓一下嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "薩科塔的小姑娘......在敘拉古可真少見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "咦......你也是薩科塔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "來到沃爾西尼這麼久，我也是第一次見到同族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "呵呵，看來，今天還真是好事連連。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "過去吧，孩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "真奇怪，我從他身上感覺不到任何情緒，他是離群的薩科塔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "但是，他和我見過的離群薩科塔，又不太一樣......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "算了。說起來，你有沒有覺得，今天劇院裡那種一看就是家族裡來的人有點多啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "我聽人說，好像是因為，羅塞蒂家族的首領來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "欸，那不就是你剛才說的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "嗯，不過，現在還是先看演出吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "（唱）那是一個混亂與機遇並存的時代，有的人被時代的浪潮吞沒，而有的人，則站在了時代的先端。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "（唱）暴力與財富，權力與秩序，成功者用什麼來交換？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "（唱）一個敘拉古人踏上了哥倫比亞的土地，帶著野心，傷痕和苦難。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "（唱）故事再次開始，女士們先生們，請看看吧，時代由誰掌管。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "這個歌聲......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "原來如此，你是來接她的嗎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "但是，你真的做得到嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "羅塞蒂家族成員",
      "text": "什麼人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普蘭德",
      "text": "女士們，先生們，就讓演出正式開始吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喬萬娜",
      "text": "......沒想到，真的是你，切利尼娜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "咦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可頌",
      "text": "德克薩斯？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "text": "——欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "text": "......？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "德克薩斯在一瞬間看向包廂其中之一。\n她知道，貝納爾多正坐在那裡俯視著一切。\n她心中了然。\n無論是巧合，亦或者是某種必然，空在這一刻既是危險的，又是安全的。\n一切取決於她。\n觀眾席中的異動，遠處隱約傳來的微響，都在宣告著刺殺的開始。\n她向空做了個噤聲的動作，然後，撥動了手中的琴弦。\n好戲開場。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
