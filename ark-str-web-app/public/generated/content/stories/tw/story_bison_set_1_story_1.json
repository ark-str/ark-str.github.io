    },
    {
      "type": "dialogue",
      "speakerName": "通訊音",
      "text": "怎麼樣？他來了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "（剛剛那個價格......說實話，是不是還能再壓一壓？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "（看來我在談判桌上還需要再多學點。）",
