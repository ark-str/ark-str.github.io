    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "text": "先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穿鎧甲的騎士",
      "text": "（攥緊拳頭）",
