{
  "server": "tw",
  "storyId": "act16side_level_act16side_st01",
  "groupId": "act16side",
  "stageId": "act16side_st01",
  "title": "風雲際會",
  "storyCode": "GA-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act16side/level_act16side_st01.txt",
  "sourceHash": "b111f02ca46cb77ff1b0e469f9777282c78e33eda96010dd9fdbfc788be251a6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "st01"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "消瘦的男人",
      "text": "她快回來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沉靜的女人",
      "text": "萬國信使們籌備已久的會議，她當然會回來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉靜的女人",
      "text": "你打算待多久？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "消瘦的男人",
      "text": "等到該做的事情做完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "消瘦的男人",
      "text": "畢竟我在這裡，只能引渡拉特蘭人的靈魂。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "消瘦的男人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "消瘦的男人",
      "text": "我該走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉靜的女人",
      "text": "明天開始，別再來了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽，喝熱水。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "好孩子，咳咳......媽媽沒事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽......我給你讀故事書吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "......塞茜莉亞，我可愛的塞茜莉亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "媽媽真捨不得離開你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽要離開我嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "不，咳咳......媽媽從來沒有想過......離開你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "媽媽只是不得不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽要去哪兒？我也一起去，可以嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "媽媽要去的地方，塞茜莉亞不能去......那裡很冷，很寂寞，什麼都沒有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "我和媽媽一起，我陪著媽媽，媽媽就不會寂寞了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "......塞茜莉亞，對不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "你本應該有更幸福的童年......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "我和媽媽在一起，非常幸福。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "......塞茜莉亞，塞茜莉亞，聽著，聽著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽，我在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "之後，媽媽不能照顧你了......會有人來接你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "跟著他，跟著他去找爸爸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "爸爸會代替媽媽照顧你，好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽不和我一起去見爸爸嗎？爸爸一定也想要見媽媽......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "媽媽......要去做重要的事情......所以不能和你一起去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "等你見到爸爸，替媽媽告訴他，媽媽也很想他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "還有，替我對他說......對不起。好嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽為什麼要道歉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "答應我，答應媽媽，塞茜莉亞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "我知道了，媽媽......媽媽，別哭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "塞茜莉亞，我可憐的塞茜莉亞......你的出生是我一生中最幸福的事。可是，這會不會成為你一生的不幸......我的孩子，我最心愛的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "誰將祝福你？誰能祝福你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "塞茜莉亞，我的塞茜莉亞，躲起來，不要被發現......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病重的母親",
      "text": "逃走吧......離開拉特蘭......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "母親抓住女兒的手，眸中閃過無數情緒。最終，一切都從眼中無力地流逝。\n那雙眼睛緩緩闔上。"
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽......？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薩科塔女孩不知道發生了什麼。\n她發現母親的手變涼了，於是捧起來捂在胸前，希望母親能夠暖和一些。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "是敲門聲。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "拉特蘭公證所執行者費德里科，執行公務，請開門。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "開朗的萬國信使",
      "text": "先生，賓館的入住手續已經全部辦妥啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開朗的萬國信使",
      "text": "今天接下來的時間您可以自行安排，出門逛逛也很不錯。在路上時，看您似乎很有興致呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "拉特蘭城的建築，風格別致。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開朗的萬國信使",
      "text": "您看，來拉特蘭一趟不虛此行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "算是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "之後的日程呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開朗的萬國信使",
      "text": "您與教宗閣下的會面已經安排妥當，接下來我將前往大教堂歸隊。明天，我會來接引您會見教宗閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開朗的萬國信使",
      "text": "正如之前向您介紹的，會議期間，您可以盡情享受在拉特蘭的時光，不必顧慮費用，拉特蘭城很榮幸能招待各國貴賓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "各國貴賓......哎，我是不知道這麼多異國人聚在這裡，能有什麼好談的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "當然，教宗閣下有如此誠意，我自然很願意領略一番貴地的人情風貌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開朗的萬國信使",
      "text": "那麼，容我先失陪了。您請隨意。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "拉特蘭城的建築確實有意思......哥倫比亞也會用這種柱式，不過細節似乎有所不同......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "嗯，來都來了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "嗯？那邊在做些什麼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "安裝好了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的拉特蘭市民",
      "text": "我好了，你那邊呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "搞定。艾澤爾小哥，周邊都疏散好了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "可能受到直接影響的公民已經疏散完畢，次級影響範圍內的公民也已經確認知曉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "那我們可以開始了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "嗯......現在是1099年3月15日上午10時22分，接下來這次爆破行為，將在公證所候補執行者艾澤爾的見證下執行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "好。那麼，三——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "（那三個薩科塔圍在那根柱子旁做什麼？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "二——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "這裡怎麼除了你們三個之外，一個人都沒有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "一，引爆！——喂，哪兒來的人？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "怎麼了，怎麼爆炸了！......什麼東西倒下來了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "救命，救命啊！噫——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "要救人......嗯？倒塌的速度，變慢了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "救——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "閉嘴。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "噫——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "呼......呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "這、這太可怕了，拉特蘭是怎麼回事！......這位黎博利，感謝你的搭救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "你叫什麼名字？請到哥倫比亞臨時會館找我，我會答謝你的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "她叫微光守夜人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "微光守夜人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "微光守夜人......？拉特蘭人的名字真奇怪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "微光守夜人",
      "text": "我不叫這個名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "你好......你們沒事吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的拉特蘭市民",
      "text": "謝謝兩位，不然就出大事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "感謝你們出手相助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不叫微光守夜人的黎博利",
      "text": "客氣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "不過，這到底是怎麼回事？光天化日，大街上怎麼會爆炸？難道拉特蘭混進了犯罪分子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "我在思考一件事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的拉特蘭市民",
      "text": "說說看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "你不覺得這根柱子的位置很完美嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的拉特蘭市民",
      "text": "我同意，拉特蘭的建築美學在它身上體現得淋漓盡致。所以呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "所以......我忍不住想看一看，把它炸掉會是什麼效果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的拉特蘭市民",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩？的拉特蘭市民",
      "text": "不得不承認，是個好主意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "不過，那個會議是不是快開始了？聽說會有很多外賓。教宗閣下是不是說，讓大家這段時間收斂一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩？的拉特蘭市民",
      "text": "不錯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩？？的拉特蘭市民",
      "text": "不過，教宗閣下說的是“收斂一點”，沒有說“不能做”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "我理解教宗閣下希望給外賓們留下好印象。不過，我親愛的朋友，你是否同意我的一點淺見——“好的印象”首先應當符合實際。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不太沉穩的拉特蘭市民",
      "text": "我的朋友，我認為你說得很對。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "所以，我們就向公證所報備了一下，請這位執行者小哥來見證了一下，把周圍民眾疏散了一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "然後將這根美麗的柱子，恰如其分地爆破了一下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的拉特蘭市民",
      "text": "只是，沒想到您正好走了過來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "抱歉，尊敬的先生，我們無意傷害您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "你們......在移動城市的大街上搞爆炸？還向政府報備......在公務員的見證下？！拉特蘭人......原來這麼......灑脫不羈嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不叫微光守夜人的黎博利",
      "text": "拉特蘭人當然遵守戒律和規則。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不叫微光守夜人的黎博利",
      "text": "但在戒律允許的範圍內，拉特蘭人有想做的事，就會去做。而拉特蘭城會尊重和保障每一位拉特蘭公民的權益。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "別擔心，先生。只是爆炸而已，這很平常。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "要是有人受傷怎麼辦......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "我們懂得分寸......當然，我為這次意外向您致歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的拉特蘭市民",
      "text": "真抱歉，先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "也許現在您還不太理解。相信我，在這裡生活一段時間，您會愛上這座城市的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哥倫比亞富商",
      "text": "呃......我可能還是不必理解了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "這就是拉特蘭人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "歡迎來到拉特蘭，先生。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嘖嘖，不愧是莫斯提馬，她的能力究竟是讓時間流逝變慢，還是讓人產生變慢的錯覺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "看幾次都覺得不可思議。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡言的萬國信使",
      "text": "奧倫，那邊怎麼了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "沒什麼，親切的家鄉日常而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "不過，看到了意料之外的好戲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡言的萬國信使",
      "text": "其他人在等我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "我知道，走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "萬國信使。\n本代教宗主持建立的特殊信使隊伍。\n此前，由於拉特蘭在核心圈國家間的超然地位與恒久中立立場。\n在外交實踐中，拉特蘭官方人員受託傳遞特殊事件重要資訊的事例時有發生。\n萬國信使制度建立之後，本代教宗將前述職能常態化、機制化。萬國信使成為奔走於國家間的一支特殊力量。\n萬國信使隊伍的宗旨在於，在堅守拉特蘭絕對中立立場的基礎之上，促進重要資訊的國家間流通。\n1098年，經由萬國信使，教宗向泰拉諸國發出邀請：\n於拉特蘭召集會議，邀請諸國遣使商討集體安全事宜。\n1099年，萬國信使制度誕生三十周年。\n同年三月，散落於泰拉大地各處的萬國信使偕同多國使節，前往拉特蘭。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "剛才那兩個人，一個氣質上很像戍衛隊的人，另一個......難道是萬國信使？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "奇妙的組合。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活潑的拉特蘭市民",
      "text": "艾澤爾小哥，見證工作已經完成了，你還留在這裡嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉穩的拉特蘭市民",
      "text": "請放心，我們會按照之前的申請文書，把這根柱子還原，重新豎立起來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "好的，那就辛苦你們。我還有任務，得先走了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "咦，確認遺囑登記情況的對象......去世了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "典型的獨身女人居所，沒有第二個人生活的痕跡。\n臥室之中，女人遺容安詳。沒有中毒跡象，沒有暴力跡象。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "是我，費德里科。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "司提望區瑟法斯街7-265號發現一具女性公民遺體。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "初步判斷死因為自然死亡，請通知轄區安魂教堂前來收容遺體。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "初步搜索未發現遺囑。請發起新任務：確認死者身份，根據遺囑預登記資訊尋查遺囑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "費德里科",
      "text": "報告完畢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "媽媽......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "別出門。\n不要被其他人發現。\n絕對不能靠近穿著制服的人。\n媽媽是這樣說的。\n穿制服的人走了嗎？還沒有走嗎？\n沒關係，就像平時那樣，有人來做客，塞茜莉亞就去自己的小沙發上睡午覺。睡醒了就可以繼續陪媽媽了。\n不要慌......塞茜莉亞。為什麼心慌？\n為什麼睡不著？\n沒關係、沒關係......只要等奇怪的人離開。\n回到媽媽身邊就好了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "薩爾貢的情況看來不錯？我看他們派來的使者不少啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "別提了，帕夏們是很積極，只可惜每個帕夏的想法都不一樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "他們派來的使者彼此沒有打起來我已經謝天謝地了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "卡西米爾呢，他們的陣仗可不小。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的萬國信使",
      "text": "監正會回絕了我們的提議，商業聯合會倒是很有興趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的萬國信使",
      "text": "甚至有一位代表主動找到了我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的萬國信使",
      "text": "他和我聊了很多......這個人對於國際形勢的瞭解，不亞於萬國信使。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的萬國信使",
      "text": "如果不是他太忙，也許會親自來這一趟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "別光說我們，你呢，奧倫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "維多利亞如今的局勢相當複雜，你們應該也有所耳聞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "雖然我與高多汀公爵關係還不錯，但他......與其說不想，不如說不能夠派人前來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "牽一髮而動全身，大致如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "大炎也沒有派人來，不過，送來了許多禮物“表達對教宗閣下的感謝”......非常大炎風格的做法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的萬國信使",
      "text": "這兩年嶄露頭角的謝拉格倒是派了使者......其他各國的使者也已經到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "其實，我沒想到我們能做到這種程度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "怕了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "有一點。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "我記得，你做萬國信使是不是還沒幾年。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "不到四年吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "而萬國信使的活動已經持續三十年了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "能有今天的成果——各位，就我們的努力而言，這是理所當然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "何況，現在還遠沒有達到我們的期待——我們想要的，不應該是一場更加名副其實的“萬國峰會”嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "並非使者，出現在拉特蘭大教堂會議廳的，應當是那些真正有能力做出改變的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "等到那樣的大人物出現時再緊張吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "被你這麼一說，我都不知道該不該期待那一天的到來了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "奧倫，你又在倚老賣老嚇唬後輩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "冤枉啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "就算你描述的那一天真的到來，也沒有什麼好緊張的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "我們有這樣的資格，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "或許吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "那麼，負責各個區域的萬國信使都到齊了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無奈的萬國信使",
      "text": "就差莫斯提馬了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "莫斯提馬？哦，我剛才看到她了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "她在幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奧倫",
      "text": "她正在享受家鄉的氣息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "不用管她，本來也沒有期待她會來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇爾麗芙",
      "text": "和以前一樣，把她向閣下的彙報排到最後就行。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "教宗閣下到。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "霎時間，大廳靜謐無聲。\n所有萬國信使的視線彙聚於一處。\n全拉特蘭人的導師、引路人、精神領袖——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教宗",
      "text": "早上好，孩子們，早飯吃過了嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "虔誠的修士",
      "text": "如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的修士",
      "text": "沒有外力痕跡，應該是由於她身患的疾病。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虔誠的修士",
      "text": "可憐的人，願彼方沒有病痛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的修士",
      "text": "歸於黯淡的薩科塔，你的遺體將被帶往安魂教堂，你將安息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虔誠的修士",
      "text": "這個掛在臥室的牆上，帶上吧，等下交給公證所的人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "他們為什麼帶走媽媽......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞茜莉亞",
      "text": "我......該怎麼做......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "塞茜莉亞將視線投向大門。\n不能出門、不能被發現......不然塞茜莉亞會有危險。\n媽媽是這樣說的。\n......可是媽媽被人帶走了，媽媽會不會有危險？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "菲亞梅塔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "你怎麼突然願意叫我名字了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "哎，你不喜歡嗎，還是“微光守夜人”比較好？或者想要新的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "叫我菲亞梅塔，謝謝。所以呢，你想說什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你說，這時候我的好同事們應該正在大教堂裡談論我吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "既然你知道，就該去露個臉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "算了，我永遠也習慣不來大教堂的氛圍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "況且，我出現在那裡未免讓他們不自在。誰喜歡看一個會走動的警告牌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "你還在乎其他人自不自在？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我也沒有無聊到自討沒趣吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我看未必。不過，你比我想像的要更享受回到拉特蘭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "“歡迎來到拉特蘭。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "啊，可能是久違的返鄉，讓我的心靈也有些雀躍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "得了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "哈哈，好了，走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "去哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "當然是去見她。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "......啊，她是不是已經轉院了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......你上次回來都是多久之前的事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "跟我走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "之前沒怎麼來過這個區，這裡離城郊好像不遠了......快到了吧？瑟法斯街7-265號......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "停在那一家門口的......是安魂教堂的儀柩車？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "您好......修士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的修士",
      "text": "別著急，年輕的執行者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "兩位已經完成檢查了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虔誠的修士",
      "text": "不錯，是一位因疾病辭世的薩科塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "我可以確認一下遺體嗎？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "......驗證完畢，死者就是戶主費莉亞·拉珀爾塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "兩位修士，我收到的任務說明提到沒有在死者附近發現遺囑，請問兩位檢查時是否發現了類似遺囑的事物呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的修士",
      "text": "未曾發現。不過這個要交給你......公證所要回收，對吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "這是......這位女士的守護銃嗎？明白了，我會帶回公證所。謝謝兩位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "虔誠的修士",
      "text": "如果您已經完成了身份確認和守護銃回收，請容我們送這位女士前往安魂教堂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "......啊，好的。謝謝您，修士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "確認了死者身份，要從公證所系統查遺囑的預登記資訊的話......我記得可以用終端遠程查詢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "......戶籍地址......戶主......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "......咦，沒有遺囑預登記？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "這個診斷記錄是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "哎，這樣的病，放棄住院治療也可以理解......不過為什麼連遺囑都不願意留呢......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "嗯......？是鄰居的孩子嗎，為什麼躲著我啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "什麼，不會吧，摔暈過去了？好像只是絆倒了，怎麼至於......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "有誰認識這孩子的父母嗎！是住在附近的孩子嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "關切的拉特蘭市民",
      "text": "我沒見過這孩子啊。她是暈過去了嗎......不會摔倒時撞到頭了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷靜的拉特蘭市民",
      "text": "我也沒有見過，也許是新搬來的？可以問問社區辦事處的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱心的拉特蘭市民",
      "text": "還找什麼辦事處！如果真摔到腦袋了，得趕緊去醫院啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱心的拉特蘭市民",
      "text": "執行者小哥，你趕緊帶小姑娘去醫院吧。我們就住在這附近，要是她父母找過來，我讓他們直接去醫院找你們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "艾澤爾",
      "text": "好，麻煩你們了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉特蘭市民？",
      "text": "嘖......沒想到塞茜莉亞會走出家門，偏偏撞上了公證所的人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉特蘭市民？",
      "text": "帕蒂亞，怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕蒂亞",
      "text": "能怎麼辦？跟上去，確認塞茜莉亞的安全......然後把她從公證所手裡帶走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
