{
  "server": "tw",
  "storyId": "story_waaifu_set_1_story_1",
  "groupId": "story_waaifu_set_1",
  "stageId": null,
  "title": "武為何物",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_waaifu_1_1.txt",
  "sourceHash": "d37643dd506f01f52c6171d8ccf6bd225f5829b64ea40b9cbad9be7ab2f79fdd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "開拳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "力從地起，拳腳相通，時刻注意你的腳下！站起來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "忌追手，忌衝身。看清楚我的動作，注意自己的架構！站起來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "知道了，阿爸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "練武時要叫師父！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "勁發六合，寸內發力！你的拳頭就只有這麼點力氣嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "（喘氣）是......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "阿爸？你要去哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "去找一樣東西，可以讓我變得更強的東西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "阿爸，可以帶我一起去嗎？不要丟下阿琥一個人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "我不會停下來等你。如果你想站在我身邊，就靠自己的努力，追上來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "阿爸——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "簡直豈有此理！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "嘿喲，這些天可真是熱鬧，一天都不得消停。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "怎麼，我剛說的情況，女俠可有哪裡不清楚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "這是徹頭徹尾的誣陷！你有什麼證據可以證明你們師兄是被我打傷的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "這份錄影就是證據。女俠要是有異議，不如上報官府，由他們判定，這算不算“故意傷人”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "這錄影分明是斷章取義，我當時根本沒有用力，怎麼會打傷他？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "女俠好大的口氣，還沒用力就把我們二師兄打成重傷，那要是用力的話，師兄豈不是命都沒了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "欠債還錢，殺人償命。傷人的話......女俠就把這醫藥費賠了吧。帳單還請女俠過目。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "這麼貴？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "師兄靠拳腳吃飯，要是身體有個三長兩短，砸的可是下半輩子的飯碗，自然得仔細醫治。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我、我沒這麼多錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "當然，女俠這麼年輕，沒有積蓄也情有可原。我們也不是有意為難，這還有一個解決辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "你想怎麼解決？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "請女俠接下這份挑戰書，三日後，我們大師兄邀您比武，為我們門派正名。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "再打一次，讓你們到時候再告我故意傷人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "女俠話可別說太滿。今日是我們二師兄手下留情才被得手，而大師兄功力更遠在二師兄之上，勝負還未可知呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "只是，二師兄還在醫院裡躺著，這比武的勝負嘛......還請女俠再掂量掂量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我明白了，你是要我故意輸了比武，否則就繼續追究“故意傷人”的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "哎哎，話說清楚，這可是女俠您自己說的，不是我的意思啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "可想好了？這帳單和挑戰書，您總得接一個吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "......好，我接受挑戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "那就請女俠在這封挑戰書上簽字畫押。三日後午時，鐵甲門在山上的劍闌酒家設宴，屆時請女俠務必賞光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "另外，這份錄影我們也暫且保留，要是女俠自行離開尚蜀，可莫怪——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "不必多說，三日後，我一定到場。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "哈哈哈，女俠豪爽。那在下先告辭了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "卑鄙小人——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "半日前"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "倒楣......只是遲了幾天，鯉叔就已經不在尚蜀了，梁叔又偏偏在這個時候調任，這下該去哪找......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "咦，前面那是？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "今日是我們鐵甲拳一門在尚蜀開設武館十周年的大好日子，特在此擺台演武。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "感謝父老鄉親和武林同道的支持，今日報名買課一律七折優惠！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "尚蜀的武術氛圍竟這麼濃厚？說不定可以打聽到老爹的消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "前面這位大叔身形壯碩，看起來頗有功力的樣子。看看他要表演什麼吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "諸位師弟，來操演一遍鐵甲拳八十一路拳法，讓大家看看我們習武之人的精氣神！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "這套拳法素來秘不外傳，今日就破例讓大夥開開眼界！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳眾門人",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "嗯......後面的許多學徒動作稍顯生疏，協調性和勁力都有所欠缺，應該是練習時日尚短。不過這份氣勢還是值得稱讚的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "這套鐵甲拳法歷史悠久，底蘊深厚。若勤加練習，定能強身健體，延年益壽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "我現在就為大家展示，運用本門秘法長期訓練，身體強度能達到何等地步！師弟，上傢伙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑似串通好的女性路人",
      "text": "這、這麼厚的大理石，還是三塊！他要把這些石頭一掌劈開嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑似串通好的男性路人",
      "text": "不可能！人類絕對不可能做到這種事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "諸位看好——喝！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "武藝不該是單純的蠻力，用這種辦法博人眼球，是不是太浮誇了點......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "哈哈哈，這還不算什麼。本門拳法練到最高境界，不用動拳腳，以意御氣即可傷人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "諸位請看，我只消凌空一掌，便能將一人震出十米開外！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "什麼？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "師兄！我來搭手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "好師弟！師兄這一掌重，可要當心了！喝——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "這也太假了吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "這位姑娘，你我素不相識，你為何汙衊本門武功？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "汙衊？用這種把戲騙人，虧你還能這麼理直氣壯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "“隔空打人”？你教的到底是武藝還是源石技藝？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "哈哈哈哈......小姑娘，你見識短淺，我不與你計較。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "要知道，人若能將身體潛力開發至極限，拳腳的威力，可不是源石技藝能比的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "是嗎？正好我也練過幾年武，還想向前輩討教一下，這“開發至極限”的拳頭是什麼威力？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "要動手了，快、快拍下來！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "姑娘是哪門哪派，當真要在這大庭廣眾之下與我比劃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我無門無派，你若問心無愧，又何必在意台下有多少人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "好，那就按江湖規矩，每人各出三招，點到為止。看在你是小姑娘，我就讓你先出手吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "你確定要讓我先出手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二師兄",
      "text": "怎麼，不敢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "（這個人應該沒有正經練過武功。還是小心一點，別傷著了他。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "（不如摔他一跤，讓他稍稍出醜就好。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "好，看招！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "師兄！師兄！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性路人",
      "text": "哎！那個人怎麼倒地不動了，好像還在口吐白沫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性路人",
      "text": "快走吧！怕是要鬧出人命了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "哎哎？我還沒用力呢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "鯉叔和老爹的消息一點都沒有找到，還捲進了這種麻煩。要是阿知道了，不知道會怎麼笑話我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "絕不能放任那群江湖騙子為非作歹，可他們要是真的去報官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "到底該怎麼辦......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "什麼人？出來！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "女俠息怒，女俠息怒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "附近到處都有鐵甲拳門人在盯著，在下得小心避開他們的耳目。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "你是誰，何事找我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "在下是無相拳一門的人，請女俠放心，和鐵甲門絕對沒有關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "尚蜀的武林門派原來有這麼多的嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "尚蜀大小門派將近半百。女俠昨日得罪的鐵甲門，在其中也是數得上號的大門派。女俠只怕還不知道自己惹了多麼大的麻煩吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "這次能敲詐掉我大概兩年薪資，我已經很清楚了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "這可不單是錢的事。昨日女俠當眾拆了鐵甲門的台，等於當眾砸了鐵甲門這塊招牌，這可是武行最忌諱的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "後日比武，鐵甲門定然會不擇手段地找回顏面。女俠又是孤身一人，縱是武藝再高，也只怕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我倒想問問，你也是習武之人，竟想坐視他們這樣招搖撞騙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "女俠有所不知，我們向來有一個規矩，就是同在武行，不能砸同行的飯碗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "要是出現了在公開場合分出輸贏的情況，通常是輸的那方出一筆“講和禮”，再擺一桌酒席。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "席上兩派各出一位代表人物，兩人公開交流以示武術沒有高下，以後雙方還是井水不犯河水。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "若是有違規矩，就會被整個武行有意針對，再難在尚蜀立足。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "雖然我也反對踢館這種行為，但是這樣未免也太虛偽了點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "而且，聽起來你們武行一團和氣，那是不是說，你們平時做事也和鐵甲門差不多？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "招攬生意，只是稍稍誇張一些——先不說這個。今日找到女俠，主要還是想向您提供一筆極好的買賣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "那就是請女俠對外宣稱，是我們無相拳一門的人，然後再由我們門派出面和鐵甲門講和，可保證讓女俠再不必煩惱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "你說是“買賣”，那我應該做什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "行走江湖，當然講究有來有往。我們只希望此事平息後，您能來我們武館，掛名授課一個月。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "掛名授課？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "哈哈，我們當然不會要求您教授貴門秘傳，只要您待在我們這，就可以當武館的活招牌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "也不讓您白待，我們付您一個月的薪資，鐵甲拳一門送的講和禮二八分成！這個條件，您覺得——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "說完了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "您意下如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "恕我拒絕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "呃......您要是覺得價錢不公道，我們還能商量——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "聽好了，雖然我對所謂的武行還不太瞭解，對於種種規矩大概也沒有資格指手畫腳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "但這般弄虛作假，在我看來已喪失了對武學基本的敬重，所以我決不能接受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "女俠，此言差矣啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "現在哪還是用得著武功的年代......大夥舞刀弄槍無非是混個營生，也不算什麼罪大惡極的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "大家各留三分薄面也就罷了，又何必這麼較真呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "或許你說的對，我也不該對別人的生活輕易下評判。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "只是道不同不相為謀，多謝你的“好意”，告辭了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "哎......小姑娘看起來這麼年輕，怎麼還抱著陳芝麻爛穀子的那套東西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無相拳門人",
      "text": "這都什麼年代了，那真正能打的人，早就被打死啦......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "阿爸，你的功夫這麼厲害，是不是沒有比你更厲害的人了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "說什麼玩笑話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "大地何其遼闊，我不過是走過幾個城市沒有遇到對手，怎敢妄居第一？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "可是阿爸這麼辛苦地練武，又要到處尋找對手，到底是為了什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "習武就是習武，哪來那麼多“為什麼”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "我就是要訪遍名家，見遍高山。見識過天高地廣，才能知曉自己身居何處，才能更進一步！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐天裴",
      "text": "在武道求一個“登峰造極”，這就是我畢生所願！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "阿爸，時至今日，你追求的到底是什麼呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "客人臉色如此難看，可是吃不慣這尚蜀辣味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "不、不是。飯菜都很好吃，是我自己的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "呵呵，我無意偷聽，昨日那夥人在店裡鬧得厲害，客人遇到的麻煩我也略有耳聞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "讓您見笑——不，是給您添麻煩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "無妨無妨，只是當下這個局面，不知姑娘如何打算？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我已經決定了。既然已經答應了挑戰，就必須赴約。而且要堂堂正正與那人比武，決不弄虛作假。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "習武做人都是同理，“寧求進，勿思停”。這是我自己惹的麻煩，不管結果怎樣，我都要自己承擔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "說得好哇。姑娘一身正氣固然值得敬佩，可是，姑娘也該明白過剛易折的道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "後日比武，那位大師兄多半也是武藝平庸之輩。可如果他們不顧一切地想要保住顏面，使出什麼下三濫的手段，姑娘能一一招架嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我自當盡力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "再言之，如果姑娘贏了，他們惱羞成怒，惡人先告狀，哪怕最終不能拿你怎樣，但是為了這種人惹得官司纏身，未免太不值當。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "而且歸根結底，姑娘看不慣他們沆瀣一氣、弄虛作假的污濁模樣，縱使出手教訓了鐵甲門一家武館，於這尚蜀武林，又有何用呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "前輩言之有理......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "我也並非好為人師倚老賣老，只是方才說的這些，還希望姑娘能有所考量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我不願意捲入沒有意義的麻煩，也不願意就這樣讓那些人遂願，可是無論如何也想不到兩全的辦法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "辦法總還是有的，只是要考慮一下不尋常的手段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "您說，不尋常的手段......？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老鯉",
      "text": "人情世故是一張網，它有時是保護網，有時也會纏得人動彈不得——這張網只靠拳頭可是掙不開的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鯉",
      "text": "身在網中，行為舉止都會受到束縛，也就有規律可循。知其所欲，便能知其所懼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鯉",
      "text": "隨口一說，隨口一說。這也不是現在就一定要明白的道理，哈哈哈......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "知其所欲，知其所懼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "那些人不依不饒找我比試，無非是想賺回名聲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "既然他們這麼喜歡名聲，不如送他們一份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "姑娘看起來似乎是有主意了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "多謝前輩提點，我應該有辦法了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "怎麼回事，是誰請了這麼多其他武館的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "不知道啊！我們是按您的叮囑，完全避開了武行的人啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "“陰陽”“七驚”“白羽”的掌門都來了，還能是他們自己來的不成？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "冤枉啊師兄！我真的不知道是怎麼回事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "之後再找你們算帳！那個揍了二弟的人來了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "來了！她在那！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "她手裡拿的那面旗又是怎麼回事？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在眾人注目下，槐琥走上擂台，將足有一丈高的旗杆立在擂台中央。一面寫著“尚蜀第一”的旗子凌空招展，好不威風。"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "（鄭掌櫃真的請到了這麼多人。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "（還從來沒有在這麼多人面前講過話，有些緊張......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "（呼——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "咳咳——感謝各位武林同道應邀共襄此盛會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "晚生槐琥，師承紅眉詠春派。前幾日有幸結識鐵甲拳掌門師兄，可謂是......一見如故。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "前輩有志彰顯本門武功，邀我一同在此設擂，要比出尚蜀武功第一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "什麼？！你胡——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "今日這宴的確是鐵甲門設下的，此話也不算假吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "鄭清——鄭掌櫃，您怎麼也來了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "武林好久沒有這麼有趣的事，我這把老骨頭也想跟著湊湊熱鬧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "不必招呼，你且坐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "晚生雖然人微言輕，也想為這等振興武林的事出一份力，便自告奮勇，先來擔當這個擂主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "誰要是能打敗我，就可以拿到這面“尚蜀第一”的旗子。誰要是能在台上站到最後，就可以將這面旗帶回去，掛在自家武館裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "七驚拳掌門",
      "text": "賢侄，聽聞貴門師父最近遠遊，你這個大徒弟就搞出了這等陣仗，真是給師門爭氣啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "白羽拳掌門",
      "text": "看來鐵甲拳一門家大業大，尚蜀武行已經容不下它了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陰陽掌掌門",
      "text": "那不如就由你去摘這面旗子，好狠狠打我們這些老傢伙一耳光？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "諸位師叔，這都是誤會，誤會......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "晚生應鐵甲拳掌門師兄之約赴宴，可惜無人迎戰，那這比武......掌門師兄您意下如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "姑娘說笑了......我只是請諸位在此喝茶吃飯，何來比武一事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "麻煩姑娘快快把這面旗子收了吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "咦，莫非是我誤會了前輩的意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "好吧，既然掌門師兄發話了，那我自然從命，今日比武，就此取消。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "槐琥橫劈一掌，碗口粗的實木旗杆應聲倒下，寫著“尚蜀第一”的那面旗子穩穩落在槐琥手中。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "哇，這麼粗的旗杆，斷口看起來和真的一樣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鐵甲拳門人",
      "text": "師兄，我想學這個！師父什麼時候才能教我們？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大師兄",
      "text": "閉嘴！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "今日無事的話，晚生便先走一步，不打擾諸位喝茶的興致了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "這面旗子暫且由我保管，如果還有人想要這“尚蜀第一”的名頭，可隨時向我挑戰。要是得勝，我自當將這面旗拱手相送。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "諸位同道，我們有緣再會。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "多謝前輩，此番如果沒有前輩相助，我怕是很難脫身了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "可別這麼說，說到底辦法還是姑娘自己想的，我不過是送了幾封信而已，不足掛齒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "姑娘不僅練功勤奮，還能有這般玲瓏心思，實屬難得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "唉......我家那丫頭啊，年紀與你相仿，拳腳功夫也還說得過去。她要能有你一半穩重啊，我這頭髮也就不用白這麼多囉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "前輩，實在是過獎了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "姑娘擺脫了麻煩，為何看起來還有心事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我從小跟隨父親習武，他最常對我說的一句話就是“武有陰陽，人有曲直”。心術不正，武藝也不可能精通。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我本以為每一個習武之人都是像父親那樣，一心一意只求武藝的進步。現在眼見武林變成這副模樣，覺得實在不應該。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "有習武之人的地方就是武林，其中有令尊那樣一心問道的人，自然也有只為了討生活的人。但是說到底，“武林”終究還是要消逝的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "你看到的這些門派，在幾十年前也不是這副模樣。可是承平日久，行走江湖不必有武藝傍身，習武自然也不如從前勤奮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "所謂“止戈為武”，等到再也沒有人需要習武的那天，才算真正的太平年景吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "前輩，關於這點，我還有一點異議。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "哦？姑娘請講。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "武館的人認為世道太平便不用武藝，而父親一生都在尋找對手......這幾日我也在思考，但我覺得，武學的價值不必依靠外物展現。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "武藝就像一面鏡子，能清楚地照出自己的意志、心境。習武的過程同樣是自我認識的過程，所謂“無為無我，無界無終”......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我的確是這樣認為的。或許是晚輩......自大了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "哈哈哈哈哈，說得好哇！我本想著尚蜀這些武館，放著不去管，用不了幾年，它們自然也就不見了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "可這幾日所見著實讓我改變了想法，至少在這當下，武林一日尚存，就該有一日的風骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "要是武行沒有人站出來整頓風氣，那我也不介意越俎代庖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "當真？！前輩如有此意，我也願助前輩一臂之力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "哈哈，姑娘心意我領了，但且不說這遠非朝夕之功，姑娘當下應該還有更重要的事要做吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "欸？前輩怎麼知道——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "前幾日有位姓鯉的先生在我這留了封信，說要是有一位姓槐的姑娘來尚蜀找他，就把這封信給她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鄭掌櫃",
      "text": "幾日前怕影響姑娘心思故沒有說起，現在是時候給你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "鯉叔的信？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "槐琥賢侄，展信佳。我已打聽到一些你父親的消息，此刻正返回......龍門？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "那我這一趟豈不是白跑了？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
