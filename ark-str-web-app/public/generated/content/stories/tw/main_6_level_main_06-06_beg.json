{
  "server": "tw",
  "storyId": "main_6_level_main_06-06_beg",
  "groupId": "main_6",
  "stageId": "main_06-06",
  "title": "斷弦",
  "storyCode": "6-7",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_06-06_beg.txt",
  "sourceHash": "fe14e7a34a2b6bb1c0f48872c7568ae4717f5f7b14d4c491a59d2c1ba1a593e0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "灰喉！你在哪裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "阿米婭，我已經和近衛局會合了，現在正在輔助近衛局小隊戰鬥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "我們馬上就會趕去戰場！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "各位精英幹員，請聽我說，這次可能會是我們在龍門唯一一次，也是最後一次的大型作戰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "請各位以完成自己的第一任務為優先目標。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "對敵指揮官的圍攻，我和我的小隊會全力參與。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "請各位記住一件事：我們的首要目標，是完成合約內容，和近衛局一同保障龍門的安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "但羅德島在這次戰鬥中的任務，是減少感染者與普通市民間的摩擦，減少相互之間的衝突！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "無論抱著什麼樣的心態參與作戰，我們都首先是羅德島的一員！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "無論何時，無論何地！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "當然。如果我們的行動實質上會違反我們的準則，我們會立刻停止戰鬥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "所以，我們依然該為這場作戰負責。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "簡直是說給我聽的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "她也擔心太多事了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "再不快點，我們要趕不上了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "沒辦法啊，剛才那些感染者有多難纏，你也親眼見識過了。那可不是一個幹員或者一支小隊能對付的量和質。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "果然，當時在天台上就該把那小子直接收了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "啊，通訊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你要是再不到設伏地點準備，我就把過去一年所有的違紀檔案全部交給凱爾希醫生！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "我很準時的！不要慌！馬上就到！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米婭！她在抓我的外套！",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "煌！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "煌",
              "text": "我也沒辦法，這不是要趕路嗎......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "煌",
              "text": "（你給我記住了，一會兒我再跟你算帳！）",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "博士怎麼沒聲音了？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "......煌！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "煌",
              "text": "我什麼都沒做啊！這個人自己不說話！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "煌",
              "text": "你說兩句給她聽聽啊！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "煌",
              "text": "快說啊，為啥不說話啊......！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "請問能不能把我放下來再通訊呢？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "啊......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "抱歉博士，我忘了你和煌一起行動一定會是這種樣子了......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "煌",
              "text": "因地制宜嘛。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米婭",
              "text": "你在得意個什麼勁，誰是地啊......",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "可以了，我只要知道你們的位置和行動就好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你們的關係還變得挺好的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "是啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......是嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "（不對，怎麼回事？我該怎麼回答？）",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（不知道）",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（不說話）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "（不清楚）",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "（很危險！現在很危險！我心態有損，我急需指點！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "你們加油。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "她掛斷了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "完了。我也完了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "反正已經到了，我們坐會兒吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "可這裡是區域內的最高點啊？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "啊~完蛋了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "我喜歡高處啊。反正兩點間直線最短，我們一會兒跳下去就行了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "這麼高？跳下去？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "是啊。哈欠。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "等等。我沒看錯的話......正在向埋伏圈移動的，東邊的是梅菲斯特帶著的隊伍。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "另一邊......長鱗的小子？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "他還在帶著隊伍和什麼交戰。那黑壓壓一片是啥？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "......是牧群？這個數量是怎麼回事？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "看來沒法在這閒著了。走了，博士，這就是最後一戰了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "喂，阿米婭，喂！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "text": "我馬上就和博士一起加入戰場！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "詩懷雅",
          "text": "你有什麼打算？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "我要放走一小部分整合運動，然後我們進貧民區追蹤它們。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "詩懷雅",
          "text": "你這不是給了那些特殊部隊把柄？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "但我們也可以順勢再進入貧民區作業。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "我已經去探查過一次情況，有一點可以明確：只要我們還在，特殊部隊就沒法明目張膽地行動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "撐到戰事結束，特殊部隊也不好再動手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "詩懷雅",
          "text": "你不怕上司給你下命令？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "誰敢站出來聲稱“這支隊伍是我的”？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "詩懷雅",
          "text": "行啊，算盤打得挺好的。貧民區裡的情況怎麼樣？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "我的線人們一直在調查。除了少數失聯的區域，我們掌握的情報會比其他人多得多。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "詩懷雅",
          "text": "這把賭的有點大，但我們確實得賭了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "現在能讓特殊部隊回避的也就只有近衛局。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "阿米婭，聽得見嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "陳長官，我們已經就位！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "......嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "之前，整合運動擄走感染者的事件，我向你致歉。如果我們考慮的更周到，這種事就不會發生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "......正是因為近衛局在貧民區的先期行動，龍門才能提前規劃出對抗整合運動滲透的方法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "在戰略上，我認為陳長官沒有責任。至於個人的問題......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "陳長官，米莎是沒法死而復生的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "而且，我不會同意陳長官對感染者的看法。甚至陳長官自己也很清楚......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "在龍門，熱愛龍門的龍門人會為龍門而戰，不分身份。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "詩懷雅",
          "text": "哎，這隻小兔子，好厲害啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "那是詩懷雅小姐的聲音嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "別管她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "詩懷雅",
          "text": "喂！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "我認同你的看法，阿米婭，為龍門而戰確實能團結起各式各樣的人——那些投向整合運動的除外。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "但想要在龍門生活，又是另一件事。我不認為時間能改變一切。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "當然不能。是我們去改變一切。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "這種想法太天真了。感染者和普通人之間有著巨大的隔閡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "米莎的死，無數感染者的死，這種事由不得我去天真什麼，陳長官。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "就是這種隔閡把他們逼上死路。我們難道要讓這個隔閡本身，成為我們不應該去消滅隔閡的理由？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "希望陳長官能真的理解......為什麼我們羅德島的感染者與非感染者，會為龍門而戰。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "text": "來了。陳長官。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陳",
          "text": "準備戰鬥。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "幻影弩手",
          "text": "埋伏圈！近衛局正在縮小包圍圈！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "向貧民區方向突破。雖然我們沒有弑君者的音信......但貧民區依然是我們唯一的出口。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "帶他走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幻影弩手",
          "text": "那你怎麼辦？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "我和幾支小隊已經誘導了......“牧群”......聚向這裡。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "他們不會攻擊我。利用這個特性，我可以和他們一起戰鬥。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "轟炸他們的陣線！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合運動成員",
          "text": "我們撐不了多久！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "牧群",
          "text": "呃......呃啊！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "有特殊感染者！小心！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "幻影弩手",
          "text": "......你要殿後？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幻影弩手",
          "text": "你會一去無回。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "唔唔，唔！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幻影弩手",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "讓他說吧。現在這個樣子，他沒法施術。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "你要做什麼！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "梅菲斯特......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "你要做什麼！你要做什麼！！回來！不要，不要！快回來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "你說過，無論我要你做什麼，你都會去做。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "薩沙！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "你也說過，你不想做出自己的選擇。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "只是，如果你真的有了自己的想法，想要去追隨什麼，我......不會責怪你選了什麼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "如果是那樣的話......梅菲斯特，那樣，真好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "不過......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "我已經沒有選擇的餘地了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "接下來我說的這些，會是我最後一個願望。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "......薩沙？你在說什麼，我不懂！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "別讓他們走！擊殺他們的指揮核心！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "啊......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "......羅德島的燕子？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "（口型：你該扣下扳機了。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "小心，臥倒！火力太猛了，我們在被兩面夾擊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "灰喉",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局成員",
          "text": "羅德島的弩手，先後撤！這條通道就是為了這時候準備的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幻影弩手",
          "text": "浮士德！後退！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "弩手們，我相信霜星正在趕往這裡。雖然弑君者下落不明，但她的部隊說不定還在龍門貧民區之內。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "如果霜星來了，她會自動獲得你們的全權指揮權。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "我信任霜星。如果她來了，你們都能倖存。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "還有，我的源石技藝，其實是可以讓你們在移動中隱形的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幻影弩手",
          "text": "浮士德！我們知道，別用！你的感染器官會破裂的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "沒事。我沒有不用的理由了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "命令，撤退。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "......帶他一起走。別去切爾諾伯格。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "幻影弩手",
          "text": "......浮士德......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "你不能這樣！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "我希望哪怕是一個人，你也要活下去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "不要死。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "——這就是我最後一個願望。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "薩沙！！薩沙！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "......我不想傷害別人。我也不想被別人傷害。這兩件事，我都不想。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "如果可以，當時我們就該逃走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "我們本來......可以逃走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "薩沙，你和我說好的，你和我約定好的！你說我們要一起活下去的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "太遲了。我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "......已經太累了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "梅菲斯特",
          "text": "薩沙！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "浮士德",
          "text": "別了，伊諾。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "他將弩矢搭在弩上，上弦。\n他瞄準，最後一次。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
