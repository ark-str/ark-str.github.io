{
  "server": "tw",
  "storyId": "story_phenxi_set_1_story_1",
  "groupId": "story_phenxi_set_1",
  "stageId": null,
  "title": "樂園",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/memory/story_phenxi_1_1.txt",
  "sourceHash": "fa7f37a0b77cc5bfeef0d57c534bf7690a908b5f136044042b8c1660eaf001cb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "不死鸟浅层"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "砰——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歡快的孩子",
      "text": "哇！姐姐好厲害！又破記錄了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "彆扭的孩子",
      "text": "哼，就大人的水準而言，還行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爽朗的攤主",
      "text": "恭喜您，這隻毛絨玩偶是您的獎品！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "好耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "喂，黎明破壞者，你也來試試？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歡快的孩子",
      "text": "黎博利姐姐，你叫黎明破壞者嗎？好酷呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "彆扭的孩子",
      "text": "什麼奇怪的名字，不過聽起來倒是還挺威風的，你射擊很厲害嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......第一，我不叫黎明破壞者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "那可是我們親愛的長官頒發給你的代號，要珍惜啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "第二，作為成年人，在氣球射擊攤破了記錄也沒什麼了不起的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "試試嘛，這裡的槍不是銃械，是靠彈簧驅動的玩具而已，黎博利也能玩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "第三，老闆的臉色不太好哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努力保持爽朗的攤主",
      "text": "哪裡哪裡，做生意就是有賺有賠嘛，這位黎博利小姐，如果不介意的話......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "唉，好吧。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "砰——"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "啊，特等獎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "有賺有賠，對吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歡快的孩子",
      "text": "哇啊啊啊！！！是一年份的甜品站暢吃券！！！通用於拉特蘭所有店鋪！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "彆扭的孩子",
      "text": "好，好厲害！！你其實是戍衛隊的狙擊手對吧！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歡快的孩子",
      "text": "難道是修道院的大人物？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無法繼續爽朗的攤主",
      "text": "您，您該不會是，教宗閣下身邊的......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "老闆，暢吃券我收下了啊，就不計較你在這把玩具槍上動的小手腳了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "試圖維持笑容的攤主",
      "text": "閣下，您......如果方便的話，我想......我想請教一下您的尊號......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我？你們不是已經知道了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我的名字是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "黎明——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩子們",
      "text": "破壞者！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "黎明——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "破壞者！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "莫斯提馬，你有完沒完！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你剛才明明還樂在其中呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我只是......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "唉，算了，隨你高興吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "這麼快就放棄掙扎了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "掙扎的前提是有效果。而對你這種人，說什麼都沒用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "所以，回家的感覺不錯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "偶爾的話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你其實挺喜歡拉特蘭的，不是嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "誰能不喜歡這裡？連瘋子都不得不承認，拉特蘭是樂園。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "就算你感染了礦石病，不能繼續在城內居住，拉特蘭公民的身份也可以幫你免去大部分麻煩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "當然，如果你不幸對砂糖過敏或者是個倒楣的墮天使，那恐怕就得另當別論了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "喂，我也是喜歡這裡的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "得了吧，你哪裡都喜歡。或者說，你根本不在乎自己待在哪裡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "有個更好聽的說法叫作“隨遇而安”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "是是，瀟灑的信使小姐，從來不會停下腳步——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "但你跟我不一樣，菲亞梅塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你有的選。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "所以呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "所以你最起碼應該去見一面我們的那位客人，他都等了好久了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我不需要向一位銃騎彙報什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "向你的老師呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我都畢業多少年了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "那向你親愛的爺爺呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "那只是他的自稱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "說真的，我可不想跟一位銃騎搶人，要是把這幫傢伙惹毛了，搞不好我也會多個奇怪的代號。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "反正城裡該逛的地方都逛完了，我在外面等你囉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "喂，莫斯提馬！莫斯提馬！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "嘖，這混蛋，對我用了源石技藝嗎，身體動起來怎麼那麼慢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教宗騎士",
      "text": "剛才我在心中對莫斯提馬的評級上調了那麼一點點，起碼她是個懂得孝順的好孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......銃騎帕特里奇昂閣下，好久不見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "好久不見——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "黑暗中的光芒，霞光裡的陰影，我最親愛的學徒，黎明破壞者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......再會。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "小菲！小菲！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "還真是一點都沒變。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "我嗎？難得你知道嘴甜一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "不，我說的是修道院。您戴著頭盔呢，銃騎閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "有什麼辦法，教宗騎士有規定，執勤的時候必須佩戴全部裝備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "您這是在執勤嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "執勤就不能來見自己親愛的孫女了？謬論！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "銃騎閣下，您是薩科塔，我是黎博利，我們並沒有血緣關係。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "不許再說了！以前的小菲可不會說這種話！你父母把你託付給我的時候可沒允許你這麼沒禮貌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "以前你還只有那麼點高，簡直比個豌豆大不了多少......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我見到您的時候已經七歲了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "還記得我手把手教你怎麼打靶，怎麼射擊，怎麼計算彈道，好像就是去年的事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "那時候你還纏著我想要學會怎麼用銃械，哈，然後把自己炸得哇哇大哭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "怎麼才過了幾年，小菲就長成了如今的苦難監工......不，黏性微光......宣告人？你最新的代號是什麼來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......黎明破壞者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "啊對，真是年紀大了，明明剛才還記得的......你就不能固定一個代號？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "讓我每個月換代號......不就是你們幾個老頭子決定的嗎！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "有這件事？沒印象了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "那我可以要求廢除這項規定嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "現在管你的是蕾繆安，我說了不算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "總之，還是以前的小菲可愛，現在無聊得很，就連帶回來的電影都越來越沒勁了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "嗯......《獨臂電鋸俠》除外吧，勉強可以打個三點五星。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "——呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "所以，我最尊敬最愛戴的銃騎帕特里奇昂閣下，您把我叫來究竟是為了什麼事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我日程繁忙，還有許多工需要執行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "什麼任務？跟著莫斯提馬到處閒逛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我的任務是監視莫斯提馬這位墮天使，並確保她不向任何人透露應守的秘密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "得了吧，小菲，沒什麼了不起的秘密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "就算有秘密，你又如何知道哪些應守，哪些可說？就算要監視，你又如何知道哪些逾矩，哪些合律？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我只是遵守......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "菲亞梅塔，我就直說了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你現在的生活毫無意義。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......您沒有權利評判我的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "我有。因為我是你的院長，你的導師，你的監護人，我知道你本可成為什麼樣的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你現在每天只是在虛度光陰，遊手好閒，無所事事，更糟糕的是，你甚至都沒有在享受生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "莫斯提馬......她需要我的幫助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "小菲，不是莫斯提馬需要你，是你需要她，需要把跟著她當作藉口而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "她可是莫斯提馬，她能自己處理好問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "當然，她逛街試衣服的時候，也可能需要個人幫忙拉背後的拉鍊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "帕特里奇昂，你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "生氣了？還算有點骨氣，當初我可是對你寄予厚望來著。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "畢竟，你可是我最親愛的學徒，是第一個有可能成為教宗騎士的黎博利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你本該承擔更多的責任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "就算不說得那麼嚇人，當銃騎也很有意思的！你不是薩科塔，頭上沒有那頂討人厭的小光環，所以不會因為戴頭盔而頭疼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "雖然拿不了巨銃，但是給你配發一把超大的榴彈發射器還是沒什麼問題的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "最重要的是，銃騎搞壞街道不用自己賠錢哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "小菲，你有才能，你有經驗，你應該回來，拉特蘭需要你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "但我不想當什麼銃騎，閣下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你小時候不是這麼說的。你要求我訓練你，不就是為了成為......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "為了成為一個大人，以便知道我到底有多少選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你的選擇就是成為莫斯提馬的跟班？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "在最開始，可能是愧疚讓我跟著她，我覺得她的墮天有我一份責任，我擔心她會自暴自棄，她會真的墮落。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "那說明你當年還是不夠瞭解她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "是啊，哈哈，那可是莫斯提馬......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "後來，我在想，安多恩總有一天還會找上她，我只要待在莫斯提馬身邊，就能讓那混蛋付出代價。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "前兩天，在萬國峰會上，你遇到他了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "還不夠，讓他跑了，下次我會親手把他逮住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "那你就更沒有繼續跟著莫斯提馬的必要了。你可以去當執行人，只為了這個案子奔波。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "不，不是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "這次回來以後，我突然明白了，我和莫斯提馬一起遍歷各種地方，遇見各式各樣的人，就算拋去所有目的和意義，這本身就是我的選擇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你自己說的，瘋子都知道拉特蘭是樂園。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "是啊，但從未出門的人怎麼能明白回家的意義。比拉特蘭更打動我的地方有不少，但拉特蘭只有一個。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "更何況，這段旅程其實也不算很差。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "是的，閣下，您說得對，我沒有在享受生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我只是在經歷它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "在我看來，這帶不來任何成長，只是白白受苦受累而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "小菲，我們都希望你留下，銃騎的會議廳裡不介意多一把椅子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "或者你實在願意發發瘋，跟著蕾繆安去當樞機也不是不行。我明天去教宗閣下那幫你說說。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "雖然比起教宗騎士來辛苦得多吧，但也總比在外奔波好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "乾脆，我可以直接命令你留下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "你不會的，因為你是帕特里奇昂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "是啊，因為我看著你長大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "人老了的感覺真的糟糕透了，小菲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "我能感覺到自己一天天在走下坡路，每天醒來的時候都比前一天更衰朽，所有的東西都在離我遠去......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "朋友開始過世，學生四散各處，修士們只是尊重我，卻很少和我聊天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "很無聊，小菲，很無聊。只能一遍遍咀嚼那些往日歲月的殘渣，直到只剩下些模糊的情感，甚至忘記了自己回憶的到底是什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "八年前，我收拾行李的時候，你就在門外。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你怎麼知道？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "因為你在我包裡放了一長串想搞到的電影的清單。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "啊，好像有這麼回事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "那段時間我有點沉迷藍卡塢的爆米花大片，一時昏了頭放你走了，不過第二天就後悔了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "後悔的原因難道不是你意識到，就算我幫你帶回來了片子，那也是在幾年以後了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "......不愧是我的孫女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔&帕特里奇昂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔&帕特里奇昂",
      "text": "哈哈哈哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "其實你就是想找個人代你執勤，自己好窩在修道院看電影吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "或許吧，但電影總是會看完的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "你這次什麼時候走？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "一會兒就得走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "不多待幾天？過幾天拉特蘭又要辦倒立蒙眼射擊賽了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "不了，小時候看得夠多了，你帶我去參加過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "這個我記得，你拿了第一嘛。獎盃現在還在後面放著呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "是嗎，還留著呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "這次又只好自己去看看了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "別把自己說得那麼可憐，反正修士們會陪你去的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "這倒是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "聽說獨臂電鋸系列要出續集了，下次回來給你帶上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "下次打算什麼時候回來？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "應該是明年。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "到那時候電影都過氣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "有得看就不錯了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "時間不早了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "小菲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "又怎麼了，老東西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "算了，沒事，走你的吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "那麼，銃騎帕特里奇昂閣下，容我告退。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "再會，靜待與你的下次見面——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "黎明破壞者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "我這就去把你修道院燒了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "小菲，開個玩笑，開個玩笑嘛！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我運氣這麼差來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兇惡的薩卡茲劫匪",
      "text": "哈！落單的薩科塔混蛋，撞大運了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兇惡的薩卡茲劫匪",
      "text": "說吧，想怎麼死？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "猙獰的薩卡茲劫匪",
      "text": "這薩科塔怎麼還有角？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兇惡的薩卡茲劫匪",
      "text": "哈！管他呢，殺了就知道了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我趕時間，能不打嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "猙獰的薩卡茲劫匪",
      "text": "現在想到求饒了？沒門！我大哥就是被你們這幫混蛋薩科塔——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "猙獰的薩卡茲劫匪",
      "text": "怎......？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兇惡的薩卡茲劫匪",
      "text": "呃啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "知道你平時趕路順風順水，背後是誰的辛苦勞動了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "哇！難道是？！黎明——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "還沒玩膩啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "有點膩了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我還以為你會多耽擱幾天，所以就先出發了。畢竟是那老頭子親自來逮孫女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "你就沒想過我可能就留在拉特蘭了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "怎麼會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "你還得確保我保守秘密呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "......唉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "菲亞梅塔",
      "text": "老頭子讓我轉告你，下次回拉特蘭，可以一起搞個看片會。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌亂的薩卡茲劫匪",
      "text": "怎，怎麼回事！她們只有兩個人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魯莽的薩卡茲劫匪",
      "text": "一起上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "那真是榮幸。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫斯提馬",
      "text": "我會考慮的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "唉，今天也去哪裡逛逛吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "嗯？甜品站暢吃券？還是一年份？！怎麼會在我口袋裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "我什麼時候中獎了嗎？還是教宗閣下前幾天給我的來著？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "不管了，總之去吃個爽吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "text": "等到這張券過期......她就該回來了。",
      "portraitKey": null
    },
