{
  "server": "tw",
  "storyId": "main_4_level_main_04-09_end",
  "groupId": "main_4",
  "stageId": "main_04-09",
  "title": "徹入骨髓",
  "storyCode": "4-9",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_04-09_end.txt",
  "sourceHash": "be2392a9c325720a4eddd1c603c8056c760cc46217d60561ac1274c5af0612ac",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "霜葉，小心！別衝那麼前！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我知道自己在做什麼——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "唔，唔唔額！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "寒氣切開了盾牌？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "什，什麼？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "閃開！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "阿米婭！霜葉打亂敵陣，衝向敵方指揮官了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "狙擊幹員，術師幹員，掩護霜葉！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "哦哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你想做什麼呢，小狐狸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "要你贖罪，要你痛哭流涕——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "——要你的命。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "別擋路！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "嗚哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "黑，黑色的法術......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "快，快跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合運動成員",
      "text": "我不想和梅菲斯特的手下一個下場......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "梅菲斯特，看你還能逃到哪裡去！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "哦。看來這些傢伙還不足以攔住你們羅德島嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "為你的所作所為付出代價吧，殘忍的傢伙！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "你逃不掉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "小狐狸，你離我離得，有點近哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "因為我就是將手刃你的那個人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "不尊重生命的人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "不配擁有生命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "哦——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "是嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "怎麼會，我的腳——？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "阿米婭！各個方向都出現了整合運動的敵人！雖然數量不多......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "糟了，是雪怪小隊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隕星",
      "text": "雪怪小隊......聚攏起來了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "好了，得向你們介紹一位新朋友才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "嗯哼~接下來，請熱烈歡迎我們這個舞台的真正主角——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "西北凍原的噩夢，雪怪們的公主——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "————霜————星————小————姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "她會把你們的血肉，一點一滴的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "全·都·凍·成·碎·渣·哦~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "————糟了！————",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——梅菲斯特————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "我該先把你這個連野獸都不如的殺人狂，丟在雪原裡等死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "啊呀，好可怕好可怕~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "但羅德島在那邊哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "霜葉——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "退後。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "阿米婭，帶她們走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "不行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "那個是......那個是——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "她......向我們走過來了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "我們不可能贏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "呵......雖然感覺還沒活夠......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "能遇見你們，我已經很開心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "快走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "霜葉？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜葉",
      "text": "走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "放心吧，羅德島。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "我會讓你們死的毫無痛苦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
