      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerToken": "char_002_amiya_1#1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "......我會聯繫煌，讓她保護你。會合前這一小段時間，也麻煩你，照看一下煌。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "照看她？你是不是對我有什麼誤會？",
