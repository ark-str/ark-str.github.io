        {
          "type": "dialogue",
          "speakerName": "阿米婭",
          "speakerToken": "char_002_amiya_1#3",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "和她多說些感謝的話，比如說，“謝謝你在廢城救了我們”之類的，她會很受用的！"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我知道了！",
