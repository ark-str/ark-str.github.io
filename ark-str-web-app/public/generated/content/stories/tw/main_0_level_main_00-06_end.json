  "stageId": "main_00-06",
  "title": "強擊",
  "storyCode": "0-6",
  "avgTag": "行動後",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_00-06_end.txt",
  "sourceHash": "737a763367cd50ce10d742393f737874eee883e95b3d12126eb559d58bf34b23",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "哈，哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "整合運動這幫喪心病狂的傢伙！居然用，居然用......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "那些野獸......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "是，是整合運動，佈置的嗎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "感染的野獸，被整合運動當做士兵驅使......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "不，那不只是野獸那麼簡單。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "我能感受到，那種......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "那不是單純的野獸，它們比起野獸，更像我們......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "杜賓教官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "頭兒......我們，該怎麼辦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "幫它們從痛苦中解脫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛幹員",
      "text": "頭兒......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "戰鬥已經結束了，杜賓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "我們同樣也和整合運動發生了衝突。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "天災已經盤旋在我們頭頂，隨時都可能墜落。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "即使是切爾諾伯格城，在天災的直接衝擊下，也會化作一攤廢墟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "整合運動在這個時候鬧事，確實會製造更大的混亂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "杜賓，沒時間了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "羅德島能躲過整合運動的襲擊，也能瞞著烏薩斯帝國行動，但面對天災，我們終歸是脆弱的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "夠了，走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "無論整合運動的計畫有多瘋狂，對於我們來說......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "各位的安全才是最重要的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "整合運動的領袖，可能把這次的事件看作一個標誌，一種手段......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "對我來說，只是羅德島的處境，變得越來越危險。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "在這個時間點挑起事端——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "整合運動不是足夠狠毒，就是足夠瘋狂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜賓",
      "text": "也許，兩者兼有。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
