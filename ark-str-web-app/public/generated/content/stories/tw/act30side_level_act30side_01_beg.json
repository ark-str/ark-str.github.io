  "sourceHash": "144314cfae9e52ae69e0af084aef1c555d44b7a89cf03b2bff1fc5efc4b172d1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "background",
      "backgroundId": "24_g12_mountpath"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "身手矯健的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "嗬！哈！"
    },
    {
      "type": "dialogue",
      "speakerName": "氣喘吁吁的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "呼……呼……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "精疲力盡的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "哈……！嚯啊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鬥志昂揚的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "吃我一招！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "眾山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "哈啊——！衝啊——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "你們都沒吃飯？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "再來。"
    },
    {
      "type": "dialogue",
      "speakerName": "精疲力盡的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "老大，不、不行了，真的不行了……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "站起來。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "我是怎麼教你們的？"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "站起來，抓緊你們手裡的武器！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鬥志昂揚的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "是！"
    },
    {
      "type": "dialogue",
      "speakerName": "氣喘吁吁的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "呼……呼……嗬啊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "速度太慢。力道不足。法術太倉促。戰術太死板。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "也就有些默契罷了。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "整體還是太弱。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "身手矯健的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "那哪能和老大比……"
    },
    {
      "type": "dialogue",
      "speakerName": "精疲力盡的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "哈……呼……"
    },
    {
      "type": "dialogue",
      "speakerName": "精疲力盡的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "能讓老大誇一句，這段時間的訓練也算值得了。"
    },
    {
      "type": "dialogue",
      "speakerName": "鬥志昂揚的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "還不夠！遲早有一天，我也要像老大那樣，能單手切碎山石！"
    },
    {
      "type": "dialogue",
      "speakerName": "氣喘吁吁的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "就憑你……"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "看來你們休息夠了。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "那就再來。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "眾山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "啊——？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "老大！不好了！"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "不要慌。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "呼……呼……"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "呼……"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "發生了什麼事？"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "啊，大事，出大事了！"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "山下那邊忽然見血了……我們都應付不來！"
    },
    {
      "type": "dialogue",
      "speakerName": "慌張的山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "十萬火急！老大你快去看看吧！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "45_g2_trainwalkway"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": null,
      "isRemote": false,
      "text": "哇！開車了！"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": null,
      "isRemote": false,
      "text": "哈哈哈哈哈！媽媽快來！"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": null,
      "isRemote": false,
      "text": "——哇！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母親",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "都告訴你別在車上跑這麼快了！傷到哪裡沒有？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": null,
      "isRemote": false,
      "text": "（搖頭）"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": null,
      "isRemote": false,
      "text": "媽媽，你看，是戴奇怪帽子的外國人！"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母親",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "不要亂講話！不許拿手指著別人，聖女大人不喜歡不禮貌的孩子，還不快道歉！"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "對不起……"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母親",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "哎，這位先生，真是對不起啊，孩子不懂事……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "沒關係。"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "借過一下。前面是我的位子。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "45_g2_trainwalkway"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（車廂內的總人數明顯超過了。）"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（當地平民和觀光客的人數基本上持平，唔，作為觀光列車，這倒是少見。）"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（最後排靠牆角堆放的麻袋有點古怪……麻袋內有異動，是違規攜帶的活物？）"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（唔，沒有其他異常，也沒有值得在意的人物……）"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（情報只指向開往銀心湖的列車，實際線索果然沒有那麼好找。）"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（還是得找個機會去包廂檢查一下……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咚。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咚咚。"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "從剛剛起，椅背後方就一直傳來異動。\n謝拉格的列車上，難道有什麼專門踢人椅背的怪獸嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "…………"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "咚咚咚咚咚。\n像是對他的無反應感到不滿，椅背又被連續踢了好幾下。\n片刻之後，坐在後排的孩子探出頭來。"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "怪帽子叔叔，怪帽子叔叔。"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "叔叔，你是不是特別喜歡坐車啊，前兩天我也看到你了！"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "……你見過我？"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "見過！"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "叔叔，你是不是之前沒看過鐵軌和火車，所以才特別喜歡坐車啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "咳咳。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "叔叔你怎麼還咳嗽了啊？別害羞，我不會取笑你的！"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "我們這的火車可是很厲害的，我也好喜歡啊！我媽說，都是聖女大人和恩希歐迪斯老爺厲害，是耶拉岡德保佑我們呢！"
    },
    {
      "type": "dialogue",
      "speakerName": "淘氣的小孩",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "不如……我把我的小火車玩具借給你，我們一起玩開火車遊戲吧，叔叔！"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母親",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "玩什麼玩具！你乖乖回來坐好，別去煩人家！"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母親",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "實在不好意思啊，先生，打擾你了。"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的母親",
      "speakerId": "avg_npc_281_1",
      "isRemote": false,
      "text": "這孩子就是欠教訓，我一定好好管教他！"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "不，沒什麼……"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（……）"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（這頂帽子……）"
    },
    {
      "type": "dialogue",
      "speakerName": "怪帽子外國佬",
      "speakerId": "avg_npc_867_1",
      "isRemote": false,
      "text": "（看起來很奇怪嗎？）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "45_g2_trainwalkway"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "今天的乘客可真不少，新建成的耶拉岡德像看來確實是很受歡迎！"
    },
    {
      "type": "narration",
      "text": "每次上車我都覺得，卡西米爾騎士競技的比賽現場——\n哎喲！有什麼東西在攻擊我的腳趾！"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "這是……羽獸？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "出逃的羽獸",
      "speakerId": null,
      "isRemote": false,
      "text": "（用力啄咬）"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "欸、欸欸欸，羽獸兄，高抬貴“首”……！"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "欸！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "就這樣把它放了？"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "沒問題嗎？我怎麼記得車上好像說是不能帶寵物的？"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "規矩是這麼定的，不過呢，有的時候不會查得太嚴，也算是給有需要的老鄉們行個方便嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "放心，這種羽獸一般都會用麻袋裝著，不會出太大問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "不說這些。來吧，女士，我訂的包廂就在前面。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "45_g3_traincarriage"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "呼……哈！"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "擠死我了，終於又能坐下來了！"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "沒想到這趟車的坐票這麼難買，這次真是多謝你幫忙，大叔！"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "舉手之勞，女士。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "對我不用這麼客氣，也別女士女士的了，叫我羅莎琳就行。"
    },
    {
      "type": "narration",
      "text": "那麼恭敬不如從命……\n“羅莎琳”，這是一個很適合你的名字。非常動聽。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "嘿嘿，好聽吧，是我媽取的。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "大叔你叫什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "你可以稱呼我為哈洛德。當然，繼續叫“大叔”也沒問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "你的運氣不錯，羅莎琳。如果錯過這班車，恐怕就很難在天黑之前抵達銀心湖了。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "真的？"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "嘿，幸好最後還是趕上了。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "哈洛德也是要去銀心湖吧？你是要去那裡幹嘛來著？"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "我想我已經回答過這個問題了？"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "謝拉格的風光如此壯美，我當然是要去一飽眼福的啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "我可不會被騙到，你們這一大群人，看起來一點都不像是來觀光的。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "我們看著不像觀光客嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "不太像。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "呃，更像是來找麻煩的。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "啊，哈哈，找麻煩？絕無此事！"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "我可是已經被謝拉格的風景人文迷得神魂顛倒，甚至開始考慮退休之後要不要乾脆來這裡養老了呢！"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "嗯，嗯，只要不出大問題，我們當然就可以是觀光客……"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "那要是——"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "——那你呢，羅莎琳？"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "在遊客裡，你的謝拉格語算是說得很不錯了，這是你頭一次來謝拉格？"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "你這話題轉移得也太生硬了！"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "哈哈。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "算了。我沒有說過嗎？"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "我勉強算是半個謝拉格人吧，雖然我自己完全沒什麼感覺啦，我是跟著我媽在烏薩斯長大的。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "哦，令堂是烏薩斯人？"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "對。不過我媽告訴我說，我是在謝拉格出生的，我爸是個謝拉格人……"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "小時候的事我記不太清楚了，要說是旅行的話，也算是吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "唔，原來如此。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "這麼說來，從見面起我就一直想問……"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "羅莎琳，你一直抱在懷裡的盒子是什麼？"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "這是……"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "抱歉，如果有冒犯到你的個人隱私，你可以什麼都不用說。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "沒事。也沒什麼不好說的，我只是在想該怎麼說……"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "這是我媽託付給我的……遺物。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "這……"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "請容許我表達哀悼之情。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "我很抱歉提及你的傷心之事，羅莎琳。"
    },
    {
      "type": "dialogue",
      "speakerName": "哈洛德",
      "speakerId": "avg_4114_harold_1",
      "isRemote": false,
      "text": "節哀。"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "嘁，我有什麼好傷心的？"
    },
    {
      "type": "dialogue",
      "speakerName": "烈夏",
      "speakerId": "avg_194_leto_1",
      "isRemote": false,
      "text": "我這次回來，就是為了完成我媽的心願。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "24_g7_thoroughfare"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "speakerId": "avg_npc_279_1",
      "isRemote": false,
      "text": "鐧小姐，這……"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "已經沒事了。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "該解決的，我都解決了。"
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "speakerId": "avg_npc_279_1",
      "isRemote": false,
      "text": "多虧了您……鐧小姐。"
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "speakerId": "avg_npc_279_1",
      "isRemote": false,
      "text": "不然誰知道會變成什麼樣，耶拉岡德在上，都是活生生的……"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "我只能做到這一步。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "抱歉。場面……不太好看。"
    },
    {
      "type": "dialogue",
      "speakerName": "趕馱獸的牧民",
      "speakerId": "avg_npc_279_1",
      "isRemote": false,
      "text": "唉，現在也只能這樣……"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "老大，你身上的血跡要不要處理一下？"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "等會再說。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "時間緊急，雖然我處理過，但難保後續不會再出問題。"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "現在最要緊的是找到“那個人”。"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "可是老大，我們接到消息，對方現在已經離開車站了。"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "如果現在去聯絡鐵路的人停車，恐怕會引起恐慌……"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "停車？"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "沒必要。"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "那還能怎麼辦？"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "你看下面。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "這是……"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "列車馬上就要通過下面的山道了！"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "嗯。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山雪鬼",
      "speakerId": "avg_npc_275",
      "isRemote": false,
      "text": "等等，老、老大？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "她落下的身姿似比雪還要輕，又像比石更重。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_black"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "讓我看看……"
    },
    {
      "type": "dialogue",
      "speakerName": "鐧",
      "speakerId": "avg_4116_blkkgt_1",
      "isRemote": false,
      "text": "人會在哪裡？"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
