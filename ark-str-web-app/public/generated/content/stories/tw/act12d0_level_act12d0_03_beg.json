{
  "server": "tw",
  "storyId": "act12d0_level_act12d0_03_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_03",
  "title": "往昔",
  "storyCode": "RI-3",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/activities/act12d0/level_act12d0_03_beg.txt",
  "sourceHash": "6dbccb04eba7fe48040067464a4c84a4ac2727bbb85562d5a908ed27ef6fb2be",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "博士，我稍微逛了一圈，沒有看到其他人的樣子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "看來我們可能要在祭典結束後再去雨林裡找她們了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佩塔",
      "text": "——！（勝利的戰吼）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "啊，是佩塔贏了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "這個叫佩塔的傢伙挺能幹啊，我都想和他打一架了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嗯，他是我的部族的勇士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "但是，他肯定沒有嘉維爾厲害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉維爾",
      "text": "哈哈，那可不好說呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "嘉維爾可是在小時候就差點奪得了大酋長的位置呢！才不會輸給佩塔！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "小時候？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "嗯？哦，是那一次啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "在我很小的時候，因為很有趣，其實有參加過一次祭典。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嗯，那個時候的嘉維爾就已經非常厲害了！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯勇士",
          "text": "嘎哈......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯冠軍",
          "text": "荒野意志部族最強的傢伙也不過如此！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "好、好厲害......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人A",
          "text": "嘖，我們部族的勇士竟然被那麼輕易地打敗了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人B",
          "text": "我們一起上吧！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人A",
          "text": "不行啊，比人數我們更加比不過......這一次只能放棄了嗎......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯冠軍",
          "text": "還有誰要來挑戰！沒有的話，就由我來挑戰大酋長！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "我來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯冠軍",
          "text": "你是......荒野意志部族的孤兒嘉維爾？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯冠軍",
          "text": "我聽說你在小輩裡很能打，但是小鬼沒有資格參加祭典，滾回家去再喝幾年奶吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "哼，等你贏了我再說吧！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯冠軍",
          "text": "哈！不愧是孤兒，不怕死的嗎！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "部族的人就是我的親人！少說廢話，打不打！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯冠軍",
          "text": "哼，小鬼，找死！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯冠軍",
          "text": "不、不可能......只是兩拳就......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嘉維爾，好厲害......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "哼，也不過就這樣嘛！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "還有誰來挑戰！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "嘉維爾是孤兒？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嘉維爾沒有說過嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "我沒說過嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "哦，我好像真的沒有說過，畢竟也不是什麼特別重要的事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "我不知道我的父母是誰，不過這在這裡不是什麼很少見的事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "博士，雖然你可能無法想像，在這裡，人要死是非常簡單的事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "甚至不用天災——其實這裡的人根本不知道天災是什麼——一場感冒，一次惡劣天氣說不定就會死不少人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "我想我的父母大概也就是這麼隨便死掉的吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "哎，不說這個，反正你只要知道，我從小就是被部族的人一起養大的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嘉維爾......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "辛苦你了。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉維爾",
              "text": "別這樣，博士，搞得我好像很可憐一樣。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "嘉維爾",
              "text": "孤兒也不只是我，在我們這裡，幾個家庭一起養大幾個孤兒是很常見的事。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉維爾",
              "text": "博士，別想太多。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "嘉維爾",
              "text": "我也是離開之後才知道，這種情況是不正常的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "嘉維爾",
              "text": "這反而堅定了我學醫的想法。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "至少你現在比誰都健康。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉維爾",
              "text": "哈哈，沒錯。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "所以那一次祭典的結果呢？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "那一次啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "找到你了，可惡的賞金獵人！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩塔",
          "text": "什麼人？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "嗯？這個聲音......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "刻俄柏",
          "text": "把博士還回來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩塔",
          "text": "你在說什麼？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "小刻？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "特米米，不是讓你手下綁回部族去了嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "誒，是啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "這孩子力氣不小，估計是直接掙脫了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "刻俄柏",
          "text": "賞金獵人，把博士交出來！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "刻俄柏",
          "text": "不然即使是追到大地的盡頭我絕對不會放過你的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "嘖，這傻孩子看樣子還沒清醒過來。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "佩塔",
          "text": "咕哈！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "佩塔被打飛了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人A",
          "text": "她把佩塔幹掉了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人B",
          "text": "好像很厲害的樣子......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人C",
          "text": "哪裡來的怪胎？！哪個部族來的？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人A",
          "text": "不知道，根本聽不懂她在說什麼！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿達克利斯人B",
          "text": "不管了，反正只要把她打敗就行了吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "嘖，這幫人把小刻當成新的挑戰者了嗎......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嘉維爾，要去幫忙嗎？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "等一等，這傻孩子戰鬥能力還是很強的，這種場面她應付得來，現在上去只會被誤傷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉維爾",
          "text": "不過，場面恐怕會變得混亂起來，博士，指揮一下特米米的手下把場面控制住吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
