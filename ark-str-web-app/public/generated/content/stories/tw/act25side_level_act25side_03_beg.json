          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "是動力甲嗎？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "speakerId": "avg_391_rosmon_1",
          "text": "不是。這個時間點，從秘密通道經過......"
