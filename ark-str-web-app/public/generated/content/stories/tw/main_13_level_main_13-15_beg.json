{
  "server": "tw",
  "storyId": "main_13_level_main_13-15_beg",
  "groupId": "main_13",
  "stageId": "main_13-15",
  "title": "誰來傾訴",
  "storyCode": "13-17",
  "avgTag": "行動前",
  "sourcePath": "vendor/ArknightsData/tw/gamedata/story/obt/main/level_main_13-15_beg.txt",
  "sourceHash": "494c43309dd1ff23ad5a025faa3c78730d35b35a3de7a3b25a17c0676477e007",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "薩卡茲？",
      "text": "（古老的薩卡茲語）魔王死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲？",
      "text": "（古老的薩卡茲語）魔王殺死了魔王。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲？",
      "text": "（古老的薩卡茲語）為什麼，不該是這樣——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲？",
      "text": "（古老的薩卡茲語）我們的城市，卡茲戴爾……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲？",
      "text": "（古老的薩卡茲語）這會是詛咒！這會是刻印進王冠的詛咒——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薩卡茲？",
      "text": "（古老的薩卡茲語）這會是……一切災難的開始——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "明天一早，進攻就會開始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "推進之王和她的“典範軍”將負責外圍的牽制，我們，羅德島的小兔子和女妖需要深入那座停靠站。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "凱爾希那老女人呢？這麼危險的行動，她只派我們送死，自己不出點力？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "她的傷還沒有痊癒，阿斯卡綸會保證她和博士的安全，他們都會留在後方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "羅德島在不久前曾遭到赦罪師的襲擊，那些人想奪取小兔子的那頂王冠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "哼，王冠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "……赫德雷，你沒跟那些維多利亞人說實話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "如果你的計劃成功了，我們回到了卡茲戴爾，你打算幹什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "哪怕是和你當了朋友的維多利亞人，恐怕也不會接受你連“戰犯”和“被捲進戰爭的薩卡茲”一起打包帶走這件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "別告訴我你信誓旦旦地告訴我們“會帶薩卡茲們回家”，自己卻沒考慮過這個問題。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "比如，去卡茲戴爾那座地窖裡的大學，給這些從戰場上回來的傢伙開一門，呵，“反思歷史”的課？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我也許會在卡茲戴爾開個識字班，讓薩卡茲以後少幾個W這樣的文盲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我沒聽錯吧？赫德雷居然在這麼嚴肅的話題上也能順著伊內絲的話開玩笑了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "怎麼，討好曼弗雷德將軍讓你情商高了一點點？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "哼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "“戰爭結束，回到卡茲戴爾。”多可笑，我們居然在這裡幻想這些事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "我們是傭兵，我們不會別的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你是個可愛的卡普里尼，伊內絲，你說不定可以去萊塔尼亞，給那些住在塔裡的高高在上的貴族們當家教。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "就教……我想想，教怎麼在戰場上保持秀髮靚麗，怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "不怎麼樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "你在發什麼呆？馬上就要開戰了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "不，我只是……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我記得，以前你說過，你打算開一家店，在卡茲戴爾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "那是因為當時我們沒有銷贓的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我在識字班賺的第一筆學費，當做你的本錢怎麼樣？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "我很懷疑識字班能賺到多少錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "不過，綁一個萊塔尼亞的貴族家教能掙的贖金倒是不會少，起碼比十個僱傭兵的頭值錢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "先等我們真的回了家再說吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "你的精神狀態讓我懷疑你能不能勝任接下來的任務。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "被幻境啊法陣啊之類的折磨的傻了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "別理這個一向多愁善感的傻子了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "時間不等人。等我們宰了那個血魔，宰了特雷西斯，你們大可以回到卡茲戴爾慢慢商量愛巢的裝修。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……特雷西斯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "這件事我想了很久，W。接下來我要說的也許你無法接受，但我還是得告訴你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "哈，在開打前給人潑冷水？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "確實如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我們不能殺特雷西斯，起碼不能在此時此刻，由薩卡茲處決他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "伊內絲說得對，你確實是被幻象折磨的傻了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "殺了他，卡茲戴爾將不復存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "無論是在現在，還是在戰爭結束後的相當一段時間裡，他都必須以攝政王的身份被記載……乃至，被部分人歌頌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……你瘋了嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "在這件事上我不想開玩笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "我們仍要停止這場戰爭，我並未改變先前的看法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "但特雷西斯已經把自己澆築成了薩卡茲未來的基石。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "卡茲戴爾不能再遭受一次分裂，這場戰爭……也不能結束於薩卡茲的又一次背叛和內戰的開始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "記得我之前說的計劃嗎？我們需要的是在所有人得知他的死亡之前，讓這片戰場上的薩卡茲們撤離維多利亞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "薩卡茲的失敗一旦公開，特雷西斯的威懾一旦不復存在——那麼，會發生什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "公爵們會肆無忌憚地屠殺維多利亞境內的薩卡茲，報復會延伸至核心圈的其他國家，每一個文明都有正當藉口……把薩卡茲趕盡殺絕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "然後組織一支聯軍，合理又正義、迅速又果決地……瓜分特蕾西婭和特雷西斯留下的所有遺產。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你想不到嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "說真的，我一點都不在乎特雷西斯的死會有什麼後果，我需要的只是他的“死”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "聯軍？殺死薩卡茲？他們不原本就在做這樣的事嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "難道特雷西斯一死，魔族佬們就連反抗的欲望也集體消散了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "呿。我不會，我也不信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "是他派刺客殺了特蕾西婭，自詡為王，把所有人拖進今天這般田地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我們不需要為了他的卡茲戴爾，委身於他的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "別以為自己能置身事外，W。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你還以為自己不過是一個傭兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你帶來了多少人？從整合運動到現在，你聚集了多少薩卡茲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你現在背負著他們的命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我他媽不在乎！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你必須在乎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你覺得，你只要和以前一樣，殺殺人，埋埋炸彈就行了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你現在是那些薩卡茲的領袖，你必須要想清楚，你該怎麼處置他們的希望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你必須想清楚，這些命，對你意味著什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "不止特雷西斯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "別忘了，還有特蕾西婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "所以，從所有角度來說，我們都……只能是他們的繼承者，是他們理念的延伸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "他們兩人，才是薩卡茲能團結起來的原因。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "那不是真的特蕾西婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "那不過是特雷西斯造出來的冒牌貨，他騙不過我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "W。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "正視你自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你以為你是誰——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你不能接受特蕾西婭的死，你習慣了當巴別塔的影子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "甚至……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "住口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你覺得有阿米婭走在你的前面。你覺得，她才是特蕾西婭選定的繼承人，“魔王”才該考慮這些事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "你把她看作另一個特蕾西婭，你覺得，只需要追隨“魔王”就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "住嘴！你在故意揶揄我嗎？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……你覺得自己不配繼承什麼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……開什麼玩笑，你自以為你了解我嗎？你真把自己當成教育我的人了，赫德雷？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "你也只是個僱傭兵，比我高不到哪裡去。你就能自詡為繼承者了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "呸，噁心死了！小兔子？還我追隨她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "她就是個機緣巧合之下才被——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "——才被特蕾西婭選中，成了阻止整合運動和塔露拉，今天又打進了倫蒂尼姆的羅德島領導人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "那麼你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "W，特蕾西婭對於你到底意味著什麼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "只是個曾經讓你有個容身之所的遙遠象徵，那個具體的有血有肉的殿下，還是——她所代表的路？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……我……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "“為了這片大地……能夠安穩入眠。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……嘖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "所以……我才會說，她是假的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……伊內絲，你是怎麼忍著這麼久沒宰了他的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "因為我很少騙自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "呿。少來。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "別瞎操心了，赫德雷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我知道自己該做什麼。這次就不以動搖軍心的名義宰了你，你該給我磕個頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "好好磨利你的劍，準備好明天的戰鬥吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "唉……還是逃開了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "你真的覺得，她能成個像樣的領袖？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "她組織起了一大批僱傭兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "呵呵，真的是“僱傭兵”嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "W能有什麼錢雇他們？她做的事又能幫他們賺幾個錢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "那麼，那些跟著W的人，到底是因為什麼跟著她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "不管她自己怎麼說，為特蕾西婭報仇也好，追殺當年刺殺的參與者也罷，還是說自己什麼都沒想，只是一路狂轟濫炸——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "她都確實……已經走在了那條路上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "……跟著她混的人真可憐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "但其實很多人都忘了，她還很年輕。她有很大的……進步空間。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "但願吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "還有，第一筆錢給你開店，不是玩笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "……我知道。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "“典範軍”已經整備完成了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "倫蒂尼姆自救軍的一部分成員，自願加入了我們的隊伍中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "嗯，加上我們這一路收攏的原本屬於各個公爵的殘兵、想要參與戰鬥的難民和自救軍的這些民兵，我們大概有了六七個連的兵力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "推進之王，我們最好正式建立“典範軍”的軍制，任命軍官，這樣我們的指揮系統才……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "希勒少尉，這支隊伍不是一支真的軍隊。“維多利亞的軍隊”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "確實，我們有一些士兵……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "但除去你和戴菲恩帶領的溫德米爾公爵的殘部，其餘的只是想要戰鬥的普通人。工人，農民，商人，當然，還有街頭流氓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "如果我們把他們強行編進一兩個戰鬥小組裡面，再給他們塞一把武器，就要他們聽命於軍官們的指揮，我們和那些公爵有什麼區別？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "“典範軍”是個很好的名頭。但我認為它應該給人們帶來純粹的希望。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "或者別把話說那麼大，為人們帶來一點公爵們的高速軍艦所帶不來的，虛無縹緲的事物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "所以說……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推進之王",
      "text": "典範軍不該是由手握國劍的王位繼承人統領的英雄軍隊。我相當反感這些名頭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "可是，我們該怎麼組織軍事行動？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "要說軍事行動，我們的隊伍裡也有相當部分的人連正規的軍事訓練都沒有接受過。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "入鄉隨俗吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "就像我們在切特雷鎮做的那樣，就像自救軍在倫蒂尼姆做的那樣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我們還是和自己熟悉的人，用自己喜歡的方式，去殺那些薩卡茲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "……無意冒犯，薩卡茲們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "無妨。我不在乎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "儀式已被終止，但殘留在薩卡茲血脈中的賜福，並沒有徹底消弭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "倫蒂尼姆的方向……古老的巫術在翻騰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "我們的死敵有著不可告人的目的，但他們所表露出的緊迫倉促，反而能成為突破的助力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我們會加倍注意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "那麼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "讓我們搶回那根香骨頭吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "計劃很成功，那幫維多利亞人的進攻確實為我們引開了一部分這裡的軍隊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "我們進來了，它確實在這裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "脊椎守衛",
      "text": "你們，是上次的那幾個薩卡茲？你們怎麼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "脊椎守衛",
      "text": "你們和維多利亞人，一起進攻這裡？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "……抱歉了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "脊椎守衛",
      "text": "殺死這些叛徒！殺死這些薩卡茲的叛徒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "厄爾蘇拉沒有親自迎接我們。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊內絲",
      "text": "Logos猜得對，看來她確實正忙得不可開交。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "哈——上次你們沒讓我跟進來，這可真是個大傢伙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "我能把它炸成兩截嗎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赫德雷",
      "text": "不行，跟上隊伍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "馬上登上脊椎，控制它的操縱者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "阿米婭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "嗯。我感覺到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米婭",
      "text": "他在這裡。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
