{"server":"tw","storyId":"main_3_level_main_03-03_beg","groupId":"main_3","stageId":"main_03-03","title":"迴旋","storyCode":"3-3","avgTag":"行動前","sourcePath":"vendor/ArknightsGamedata/tw/gamedata/story/obt/main/level_main_03-03_beg.txt","sourceHash":"47e249c3519a178a22ebc56d8aa7fa3d6c614bf55658c235e2a57096468ad3cd","bodyAvailable":true,"blocks":[{"type":"narration","text":"第二十五关（前）"},{"type":"background","backgroundId":"bg_wild_a"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"該死——！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"敵人只有兩個！都給我上啊！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"有什麼好害怕的！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"我們已經損失了二十幾個戰士！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"那兩個混蛋，絕對不是什麼普通人......！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"小心右邊！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"幫我一下。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"壓制住她！我來最後一擊！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"我暫時還抽不出手對付那個撲過來的傢伙。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"下次可要請我喝飲料哦？"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"沒問題，快點。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"好！"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"那邊的整合運動小哥？"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"啊？"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"這顆子彈是送給你的，請好好收下~"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"子彈？子彈是......"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"咕......噗。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"哈，替你收拾掉了~"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"非常感謝。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"可，可惡啊！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"她，她那把劍......"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"哦，抱歉。"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"——我平時，都是用兩把的。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"額，額啊！！"},{"type":"background","backgroundId":"bg_wild_a"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"這下就全都解決掉啦。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"我們的配合，還真是行雲流水呢！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"......是啊。"},{"type":"background","backgroundId":"bg_wild_a"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"別跑！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"敵人的大部隊趕了過來。"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"看來是被我們鬧出的動靜吸引了。"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"啊啊啊！！！可惡！！"},{"type":"dialogue","speakerName":"整合運動成員","speakerId":"char_1002_nsabr","isRemote":false,"text":"怎麼會.....你們，你們究竟，做了什麼好事？！"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"唔，我是和你們無仇無怨啦。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"但是，合約就是合約哦？"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"履行合約可是物流的基本行業規則呢！"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"左邊。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"啊？"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"啊，啊呀？"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"謝，謝謝啊。"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"那我右側的敵人，就麻煩你解決了。"},{"type":"dialogue","speakerName":"德克薩斯","speakerId":"char_102_texas","isRemote":false,"text":"跑起來吧，該轉移了。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":true,"text":"能天使，我們快要抵達你們所在的位置了！"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"現在敵人注意力都在我們倆身上，你們自己看著辦！"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":true,"text":"兩位，注意安全！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"芙蘭卡，你們抵達預定地點了嗎？"},{"type":"dialogue","speakerName":"芙蘭卡","speakerId":"char_106_franka","isRemote":true,"text":"我ok了。"},{"type":"dialogue","speakerName":"雷蛇","speakerId":"char_107_liskam","isRemote":true,"text":"雷蛇和其餘重裝幹員已經就位。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"全體幹員注意，敵人的狙擊手可能利用了地形來隱蔽自己。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"一定要注意自己的位置，優先解決狙擊手。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"接下來......大家，準備突襲。"},{"type":"dialogue","speakerName":"阿米婭","speakerId":"char_002_amiya","isRemote":false,"text":"......小心目標，不要太過火了。"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米婭"]},{"speakerId":"char_1002_nsabr","aliases":["整合運動成員"]},{"speakerId":"char_102_texas","aliases":["德克薩斯"]},{"speakerId":"char_103_angel","aliases":["能天使"]},{"speakerId":"char_106_franka","aliases":["芙蘭卡"]},{"speakerId":"char_107_liskam","aliases":["雷蛇"]}]}
