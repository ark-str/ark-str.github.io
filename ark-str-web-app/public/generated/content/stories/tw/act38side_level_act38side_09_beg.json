    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……裁縫。"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "外婆仍在指引紅。"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "紅很快就會找到真狼，外婆等紅。"
    },
    {
      "type": "dialogue",
      "speakerName": "紅",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……德蒙塔諾。"
