      "type": "dialogue",
      "speakerName": "萊昂圖索",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "那就辛苦你了，德米特。"
    },
    {
      "type": "dialogue",
      "speakerName": "德米特里",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "像以前一樣。"
    },
