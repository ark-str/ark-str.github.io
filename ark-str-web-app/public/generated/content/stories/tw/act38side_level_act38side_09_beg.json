    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "好了，拉維妮婭，時間並不多。"
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "我們還有不少問題需要解決。"
    },
