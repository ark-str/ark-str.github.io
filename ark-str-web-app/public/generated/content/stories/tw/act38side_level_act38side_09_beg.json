    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "伊雷妮",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "請放心，那群人暫時沒辦法靠近法院。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克薩斯",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "我總覺得在哪裡見過這個場景……"
