{
  "server": "cn",
  "storyId": "act17d0_level_act17d0_st01",
  "groupId": "act17d0",
  "stageId": "act17d0_st01",
  "title": "拉马克行动",
  "storyCode": "OD-ST-1",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/activities/act17d0/level_act17d0_st01.txt",
  "sourceHash": "2e326da06be7b825dd47e07249b3a00f8ce165c0259bca2b358fe2314b4ed2cc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "我们已进入磁山二号，重复一遍，我们已进入磁山二号。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "双月、艾拉，你们那边情况如何？完毕。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": "char_456_ash",
      "text": "一切照旧，我们很快就能完成收尾。"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": "char_456_ash",
      "text": "完毕。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "艾拉？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": "char_456_ash",
      "text": "双月，准备接敌！"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": "char_456_ash",
      "text": "已就位！"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": "char_456_ash",
      "text": "复制器已开启！"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": "char_456_ash",
      "text": "地雷部署！"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": "char_456_ash",
      "text": "如果情报无误，这就是最后一批了！"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": "char_456_ash",
      "text": "我们处理完毕后就向你们靠拢！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": "char_456_ash",
      "text": "Gówno！"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": "char_456_ash",
      "text": "艾拉通讯完毕！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "情况就是这样。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "放心交给波兰人吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "我已经听到雷电地雷触发的声音了，她们会没事的。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "而你，闪击，把注意力放回警戒上。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "听你的，女士。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "注意仪表读数，情报显示这个建筑物里有封存的核废料。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "霜华，我们离目标还有多远？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "穿过前面的检查站和材料储藏室，就是主实验室。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "无人机显示雇佣兵在检查站及周边建造了简易工事 。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "没有掩体，没有死角，入口位置堵死，周边布设了大量铁丝网。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "人数。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "九人，大致位置已标记在了小队的终端上。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "检查站进入储藏室的长廊入口完全封死了，无人机无法进一步深入。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "汇报完毕。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "还有其他入口吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "没有看到入口。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "好，我会解决。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "有什么建议吗，Lord？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "燃烧榴弹还有剩余，你要用几颗？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "两发。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "了解。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "检查站入口的阻塞太庞杂了，如果爆破，瓦砾会对突入造成很大影响。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "我的计划是炸开墙体上方和右侧的墙面，一个人挂绳在上方提供火力压制，剩余人员从右侧缺口突入。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "霜华，压制和支援交给你来办。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "收到。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "贴片炸药爆炸后，战车，你从上方缺口抛射榴弹，其他人按照标识位置投掷闪光弹。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "地面突入按照闪击、灰烬、战车的顺序来，行动要紧凑，不留可趁之机。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "有问题就现在提出。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "都确认了？那好，各自就位。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "霜华，等你的信号，然后我们开始行动。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "正在前往预定位置。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "贴片炸药部署完毕。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "炸药部署完毕。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "准备——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "闪光弹！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "榴弹已射出！！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "突入！突入！突入！！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "敌人倒下！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "闪击，两点钟方向！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "已投掷手榴弹！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "十点钟，机枪手！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "我来压制，你们继续推进！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "榴弹已射出！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "工事已破坏！"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "坏家伙倒了！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "还有三个，正前方！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "两个！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "已净空！"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "已净空！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "已净空！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "已净空！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "有人受伤吗！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "好，我们继续前进。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "霜华，注意警戒后方！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "收到！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "我来开门。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "闪击，警戒。战车，用无人机看一下走廊和储藏室的情况。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "已经在做了。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "好。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "前面怎么样？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "储藏室里堆满了弹药补给，他们在这里驻扎了有一段时间了。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "材料室里没有敌人，只有几个在培养皿中的黑色结晶。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "有威胁吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "不好判断。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "这些罐子里是什么东西？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "发光的矿物晶体，以前没见过这种东西。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "矿石，合成物，只要它在发光，就可能有放射性。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "别担心，盖革计数器没有反应。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "那就直接穿过去，先不管这些石头了。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "各位，没时间可以浪费了，行动。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": "char_456_ash",
      "text": "灰烬，这里是双月。"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": "char_456_ash",
      "text": "我们刚刚解决了敌人，但是他们用大量障碍物堵住了走廊通道。"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": "char_456_ash",
      "text": "我们要换一条路向核心区靠拢，完毕。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "我们正在准备进入主实验室，请尽快支援，完毕。"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": "char_456_ash",
      "text": "收到，双月通讯完毕。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "怎么办，需要等一等她们吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "不，时间紧急，不宜拖延，继续前进。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "前面就是主实验室大门。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "准备好，我们直接进去。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "注意警戒，看到目标优先制服。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "别驻足太久。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "走！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "这里没有人，只有这些奇怪的机器。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": null,
      "text": "别放松警惕，这里的实验器材还在运作，说明目标人物还在这里。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "那我们得先真正进入到实验室里才行。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "这里是实验室内的控制间，看到玻璃那边的器械了吗？那儿才是真正进行实验的地方。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "当心......这里的敌人数量还不明朗。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "不受欢迎的朋友们总是不请自来。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "（发现目标，先别开枪。）"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "（报告周围情况。）"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "（没发现其他人。）"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "（没有看到其他敌人。）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "把手举起来，列维博士，离开终端机。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "我还在想你们要多久才会出现。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "你们干掉了我的保安？真是太遗憾了。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "我昨天才给他们结了薪水。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "不过烦请各位轻拿轻放，这里的易碎品很多。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "不要轻举妄动，这场闹剧结束了。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "结束了？我的新实验才刚刚开始。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "停下你的当前动作......我不会警告第二次。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "哈哈哈哈哈，如果我拒绝呢？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "！！"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "怎么，你在恐惧一个年老体弱，手无寸铁的普通人？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "你可不是什么手无寸铁的“普通人”。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "你是磁山二号实验室的首席科学家，列维·克里奇科。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "不准靠近那些设备。我知道你想干什么。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "闪击，把他的手铐起来。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "收到。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "我得说，你们的动作非常快......快到令人敬佩。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "但是还不够快。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "反应堆启动了？！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "这些黑色的石头在发光！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "让它停下来。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "不好意思，这可做不到。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "让它停下来！立刻！"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "哈哈哈......"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "哈哈哈哈......哈哈哈哈哈！"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "它不会停下的，你就尽管开枪吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "我一生的心血都倾注在这个项目上。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "如果不是因为那些目光短浅的无能之辈一次又一次的阻挠......"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "二十年前，我就该完成这一切了。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "你根本不知道自己在做什么！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "这个实验室里的设备破旧不堪，你正在制造一场核污染灾难！"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "我当然知道我在做什么。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "探索科学的道路充满艰难险阻。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "但是探索是值得的，对真理的探寻绝对值得，永远都值得。"
    },
    {
      "type": "dialogue",
      "speakerName": "列维",
      "speakerId": null,
      "text": "我不过是要拿回那早在二十年前就应当属于我的成果，谁都别想阻止我。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "......该死的雇佣兵......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": null,
      "text": "你还好吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "呃，只是抱怨一下，刚才差一点就被打到了。"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "我们本可以和其他干员一起进入主实验室的！"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": null,
      "text": "现在也不晚。"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": null,
      "text": "控制间就在前面了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "什么声音？"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": null,
      "text": "？！"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": null,
      "text": "地震？"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "不，是主实验室！"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "准备好复制器，他们可能碰上麻烦了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "这，怎么回事？！他们人呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": null,
      "text": "这......这是什么情况？"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "不对，实验室呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "艾拉",
      "speakerId": null,
      "text": "地图呢？这个巨大的空洞是怎么回事？"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": null,
      "text": "地图不会有错，这扇门背后就是主实验室没错。"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": null,
      "text": "整个实验室......凭空消失了？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "char_457_blitz",
      "text": "......醒，快......醒。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "char_457_blitz",
      "text": "科恩，你还好吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "char_457_blitz",
      "text": "科恩？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "char_458_rfrost",
      "text": "让我来。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "呃......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "char_457_blitz",
      "text": "这可真神奇！"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "char_458_rfrost",
      "text": "只是按了几下穴位，帮助她恢复。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "char_458_rfrost",
      "text": "好了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "发......发生了什么......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "亚历山大，她醒了！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "干得漂亮。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "你还好吗，科恩？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "这里是什么地方......出什么事了？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "这个问题问得好。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "......列维启动了设备之后，整个实验室都被剧烈的冲击波席卷了。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "这里是......什么地方？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "我们现在在哪？！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "不清楚。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "目标人物启动了不明实验装置，冲击波把我们所有人推开了。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "醒来之后再看到的情况，全都如你所见。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "没有信号，联系不上艾拉和双月。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "指南针也失效了。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "我唯一能肯定的是，现在我们绝对不在任务原定区域。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "虽然这样描述很不严谨，但我们就像是，和控制室一起被瞬间......传送......到了某个地方。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "她说得没错，我们就像是突然被火箭发射到了月球上，这句话可不是开玩笑。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "需要我侦察吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "不，不要妄动。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "了解。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "列维·克里奇科如果也被卷了进来，那他应该也和我们处于相同状况。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "先恢复体力，我来规划后续行动。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "说说好消息吧，那些佣兵的补给也和我们一起被丢过来了，至少短时间不用太担心弹药问题。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "坏消息呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "坏消息就是......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "......这又是什么声音？"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "当心，墙外有什么东西在靠近！"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "听上去像是重型工业机械......但这速度太灵活了！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "让我看看。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "......我真不敢相信我的眼睛。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "*粗口*，我们麻烦大了！准备战斗！"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "你到底看到了什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "你见过小轿车一样大的节肢动物吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "你说什么？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "哦干！"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "现在算是见到了。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "开火！！快开火！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "闪击！往后退！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "额啊啊啊！！"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "我的盾牌！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "子弹打不穿它的壳！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "要是这个石头大螃蟹把控制室的墙撕开，我们就完蛋了！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "穿甲弹有效！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "但是射它的腿没用！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "那就让它进来！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "什么！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "停火！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "让它把墙打开！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerId": "char_458_rfrost",
      "text": "闪击，你还好吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "呃，没受伤，只是装备坏了。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "好家伙，这么大个窟窿。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "待会向它索赔的时候，记得把壳剥下来。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "灰烬，快说你的计划！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "算不上计划，但选项只剩这个了。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "现在只有你的弹药能对它造成伤害了，可能再加上我的榴弹。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "我还剩......一发。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "在它撕开墙壁的瞬间动手。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "根据穿甲弹的杀伤效果判断，这发榴弹能炸断它的腿，但愿这能让它暴露腹部。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "然后，就要靠你了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "如果各位有更好的建议，请踊跃发言。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "意见搜集结束了！准备！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "换弹！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "结束了。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerId": "char_459_tachak",
      "text": "这是什么鬼东西！"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "啊，这算是可以喘口气了。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "哈——呼——"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "哇哦，刚才可真险。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "这里真的还是地球吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerId": "char_457_blitz",
      "text": "我是指，我们熟悉的那个星球？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "没理由觉得不是。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "但我们要做好最坏的准备。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "墙彻底塌了，这里已经连掩体都算不上了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerId": "char_456_ash",
      "text": "转移吧，直到我们找到能落脚的地方。"
    },
    {
      "type": "sceneBreak"
    }
  ],
