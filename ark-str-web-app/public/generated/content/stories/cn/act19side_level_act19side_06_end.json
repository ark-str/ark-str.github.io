    {
      "type": "dialogue",
      "speakerName": "赫默",
      "speakerToken": "avg_108_silent_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "被自我怀疑与不确定性折磨，难道不正是我们选择的命运？"
