{
  "server": "cn",
  "storyId": "act23side_level_act23side_01_end",
  "groupId": "act23side",
  "stageId": "act23side_01",
  "title": "塞上春来",
  "storyCode": "WB-1",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act23side/level_act23side_01_end.txt",
  "sourceHash": "6ec5a0e1c2ba793d0aecbd10e5bb63393ab96ff15757d1f286f91eadc4f89b37",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "什么人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "异族装扮的少女",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "站住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "你可知你现在身在何处，手里拿着的那把剑又是何物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "异族装扮的少女",
      "text": "一把剑，我要找的剑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "我先不问你是受何人指使，又为何能出现在此处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "把剑交出来，跟我去见宗师。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "异族装扮的少女",
      "text": "薄情寡义，背信弃义之人，不配拥有这把剑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "放肆！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "宗师守护玉门安危百年，岂容你信口玷污？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "异族装扮的少女",
      "text": "装模作样，你又知道些什么？让开！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "逮捕过的不法之徒不少，像阁下这样嚣张的，我还是头一回见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "异族装扮的少女",
      "text": "表面道貌岸然，其实自私自利。你们这样的人，我见多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "那我只好用强硬手段请阁下伏法了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "异族装扮的少女",
      "text": "你出刀，试试看。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "胜负已分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "我们的胜负，不是在这里分出的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "人和说法，阁下总得留下一个。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "我想要一些答案。但你给不了我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "令",
      "text": "还是让她逃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "受了那么重的伤，总该跑不远。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "魏老二，你这把老骨头也是不顶用了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "有劳林先生搭救。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "堂堂赤霄剑主人，被仇家找上门来，也要靠他人搭救了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "我可真不记得，我还有这么一号仇家——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "声东击西！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "异族装扮的少女",
      "text": "哼......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "你受伤了。还能往哪里逃？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "你......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "异族装扮的少女",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "宗师小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "宗师，这里又发生了什么事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "是我疏忽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "剑，被盗走了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡防营守军",
      "text": "禀将军，内城楼方圆五里内没有找到刺客下落，也没有发现有其他贼寇接应。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防营守军",
      "text": "没有其他人受到袭击，核心内城、军武库也没有被闯入的痕迹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "是没有“痕迹”，还是确认没有被闯入？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防营守军",
      "text": "暂时，无法确认......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "这世上竟还有人能随意出入玉门军营，连你们四位高手都留不下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "真是咄咄怪事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "怪我大意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "魏公对于刺客身份，可有些眉目？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "这么多年来，想要这条命的人，很多，但魏彦吾还好好地活着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "他们要么放下了念头，要么已经变成了一抔黄土。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "今晚这位朋友，我的确不认识。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "左乐，你那边有什么发现？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "事发突然，我准备不及，没能捉拿刺客......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "我没有问你为何没能捉住刺客，我问你看到了什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "潜入盗剑的刺客，是个年轻女性，逃走时身上负了伤。除此之外......没有更多的线索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "酒杯碎裂，残片尽数被平祟侯攥在手心。\n贵宾在座，但他那一瞬还是没能收住怒意，就像日间没能控制住自己引弓时颤抖的手。"
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "事已至此，多说无益。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "传我命令。立即封锁城门，各城区之间加设哨卡，禁止一切不必要的人员流动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "另外，通报全城，玉门城两日后申时起，减速以调整航线，请百姓有所准备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防营守军",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "左乐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "在！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "抓捕刺客，追回宗师佩剑，找出潜藏在城内的山海众，三件事全须做到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "给你三日时间，我的亲兵交由你调遣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "不得走漏消息，不得惊扰百姓安生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左乐",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "林先生呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "守军就位后他就已经离开了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "林毕竟不算朝堂中人，就不便领平祟侯将令了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "不知还有什么事是我能帮上忙的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "今夜刺客显然是冲魏公而来，魏公还是应当以自身安全为重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "等到事情平息，我再另外派遣军队护送魏公返回龙门。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "这几天，魏公还是不要四处走动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "不知道这“不要走动”的意思是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "就是不要走动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "剩下的事情，玉门自己解决。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "......当然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "这次敌人来头不小，不如还是由我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "还是有劳宗师留在军营，保护太傅和魏公安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "可是放任贼寇在城中流窜，同样危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "这件事是由巨兽而起，以宗师身份，不方便出手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "毕竟应该知道宗师真正身份的人，也就只有这间屋子里的各位了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "将军的话音不重，却让整间屋子安静了下来。\n不知哪个角落传来一声叹气。"
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "好......也罢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "末将这样安排，太傅可有异议？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "相信平祟侯的判断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左宣辽",
      "text": "以上安排，即刻执行。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "录武官",
      "text": "老师，您没事吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "仇白",
      "text": "打死我也不相信，这世上还有能伤到他的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "你还真是信任我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "看来，你们都已经听说了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "仇白",
      "text": "城外领兵暂且不论。城内的治安布防，本来就是你的职责范围。左宣辽这样安排，摆明了不信你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "左将军的意思，我当然明白，也能体谅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "所以这几天，有些事还得拜托你替我走动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "这次事态非常，敌人也格外棘手，左乐那边，你最好能多帮帮他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "仇白",
      "text": "按他的个性，也未必就愿意让我插手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "那我们之间的事，也不适宜在这时候解决了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "仇白",
      "text": "不用多说，我心里有数。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "这几天无事可做，那《武典》最后的几章，辛苦你陪我尽快撰写。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "录武官",
      "text": "是学生应该做的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "辛苦你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "录武官",
      "text": "老师没有别的吩咐，学生就告辞了。老师也早些休息。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "也不知道是看见了墙壁上空着的剑架，还是别的什么，男人一声叹息。"
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "这局棋，你到底还要卷入多少人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "一瓢清水倒入浊江，便再也不能从江中舀出一瓢同样的清水。这样的道理你难道不明白吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "就算你取而代之，也绝无可能在一片混沌中再见她一面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重岳",
      "text": "你做这一切，又是何苦......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "远处巡逻队伍行进时的甲胄碰撞声依稀可闻，除此外便再无别的声响。\n夜色苍茫，这个喧嚣的夜晚终于安静了下来。\n又是一声长长的叹息。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "你很有勇气。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "我居然没有发现，你也在这里......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "我当然也在这里。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "你难道要阻止我？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "善弈者通局无妙手，你的行为，未免太激进了点。\n哦......或许是因为，你已时日无多。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "要说时日无多，你应该也没有什么余裕。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "你当真以为，那人将“自己”封印入剑，就可以等闲视之？"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "我是为了“一”而来，岂会担心那十二分之一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "我反而想问，你又凭什么觉得，你可以成为他？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "我不会成为他。我始终是我。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "我与他的事，需要做一个了结。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "那是你们的恩怨。\n我们并非敌人。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "这不完全由你说了算。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "至少当下，我们各自应该都有更重要的事要做。\n我们不会是彼此的妨碍。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "你是在向我求和？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "两分之势，你没有理由拒绝。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "......你果然和你的“兄弟姐妹”很不一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的女性",
      "text": "希望下次再见的时候，你能让我看到一些有趣的东西。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "龙门游客？",
      "text": "小姐！听说您今天——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "别声张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "不是说过了不要这么光明正大地见我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龙门游客？",
      "text": "您没事就好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "你们那边有什么进展没有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龙门游客？",
      "text": "玉门集市几年一开，货流量和人流量都很大，人多眼杂，暂时还没有头绪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我们不好查，就请人帮我们查。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龙门游客？",
      "text": "大小姐的意思是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "玉门集市的这些商贩，有多少是本地人，又有多少是从龙门过来的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "后面这批人里，有多少在近卫局那边手续并不齐全，是受了咱们照顾的？筛一遍，找个比我们方便行事的，不难。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龙门游客？",
      "text": "大小姐，这......似乎不太合规矩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "按我说的做。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "半月前"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "巨兽信徒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "情报的来源，你没必要细问。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "炎国千百年来对付过的敌人，从来不只在明处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "虽然玉门常年依靠龙门补给，但城中治安应该不是您职责之内的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "玉门是一面坚不可破的盾，但是盾牌背面潜藏的蛀虫，需要另外有人来帮它驱除。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "我想派你去解决这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "我可以让你以龙门近卫局特别指挥使的身份行动，名义上的工作是负责两城对接期间的治安问题。我也会给你一定的支援。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "彻查潜藏在玉门民间的危险分子，确保玉门平安归航。如有必要，也可以采用极端手段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "为什么是我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "因为你是林雨霞，你可以做到这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "当年鼠王在龙门做过的事，我需要你在玉门再做一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "魏长官......您在找到我之前，并没有和我爸谈过，对吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "雨霞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "爸？您没说过会来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "你领了魏彦吾的任务，我总得跟过来看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......您都知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "“搜查走私犯”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "不想让您为难。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "还要你费尽心思地瞒着我，为难的应该是魏彦吾才对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "你就没有想过拒绝？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "除暴安良，安抚百姓的事，总得有人来做......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "魏彦吾手下能办这件事的人物有的是，他就一定要你来蹚这浑水？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "算了，我就是用尾巴尖都能想到，魏老二用的是哪一套说辞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "今晚发生的事，也得让你知道。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "刚才守军封锁了城门，原来就是为了这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "从白天到晚上，这连续发生的事情，如果说是巧合，那未免也太巧合了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "龙门总督遇刺，宗师佩剑被盗，钦天监信使被杀，无论哪件，单拎出来都是惊天动地的大事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "现在居然同时发生，背后牵动的势力，难以想象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "魏彦吾找到你的时候，有没有跟你讲过这件事有多危险？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "只知道这件事非同小可。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "玉门不是龙门，你也不是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我心里有数......我会谨慎处理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "这次从龙门带过来的暗桩，都是跟着您有些年头的好手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "江湖上的事，我也有经验......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "你要是有主意，那就不用我唠叨了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "但愿这次能早些了事，不耽误你去维多利亚的行程。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "只是一次游学罢了，不去也没什么的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "这些年你帮我，帮近卫局料理了不少事，都没能去做些自己真正想做的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "这都是我自己选的，我做的事也都是为了龙门。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "没见过另一条路，就不能算自己的选择。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "有时想想，像陈那样，又何尝不——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "咳......咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "爸！你受伤了？！我去找医生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "好久没有活动过手脚，筋骨紧了。看来每天只是在公园散步，运动量还是不够。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "那我送你回将军府。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "也不用，我今晚就在这边客栈歇息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "老朋友打过一次招呼也就够了。左军侯府上今晚的氛围，我可受不了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "这可真是巧了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "晚上听到城边有动静，正想是出了什么大事，现在见到林先生才能确信，出的事肯定小不了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "鲤先生的意思是，我这只老鼠跟瘟神没有区别了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "岂敢岂敢，玩笑玩笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "雨霞，我和鲤先生说几句话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我先告辞。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "看样子，你在玉门找人，也不太顺利？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "别提了。一个消失了十几年的人，我也没指望能在一个月里找到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "但不管花多少时间，总还是要找的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "鲤先生向来是位自在人，只有在这位老朋友的事上，才会这么操劳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "或许是我上辈子欠他的吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "既然你不急在这一时，那我能不能委托鲤氏侦探事务所帮个忙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "林先生开了口，我哪有拒绝的道理......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "不过话说回来，最近我接的麻烦事是不是太多了点？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "能者多劳，这件事算我姓林的欠你一笔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老鲤",
      "text": "林先生这么客气，我还真得掂量掂量这件事办不办得成了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林",
      "text": "哼，这件事，就得你这个人精来做。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "一、二......九、十......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "排行榜上前面这些人，各个都不是好对付的啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "平常心，平常心。尽力而为......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "为什么不能出城？我两个兄弟就这么死在城外......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防营守军",
      "text": "城门已封闭，姑娘请回。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "喂，你们还讲不讲道理——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "是你？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玉门路人",
      "text": "哇，使金瓜的丰蹄汉子直接被踹飞出擂台了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玉门路人",
      "text": "算下来，那个菲林女孩已经连赢了五场！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "呼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "喂，你好，认识一下，今天你的比赛我全都看了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "这么厉害的功夫，要不要考虑加入我的镖局？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "镖局？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我拒绝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "别拒绝这么快啊，凭你的身手，我可以给你开一份说得过去的工资！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我没有打算靠拳脚吃饭，我可是正经机械工程专业的大学毕业生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "机械什么......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "算了！反正你是说自己是理科生对吧？理科生好啊，我说的镖局，是新型物流公司，理科生正好大有作为。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "哎你别走啊，我说真的......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "原来还发生了这样的事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "那几位朋友的遗物和讣告，也只能等到戒严结束后才能送回尚蜀了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "是我带他们出来的，不管用什么方式，我都会带他们回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "来玉门之前，我在尚蜀碰巧见过郑前辈一面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "郑前辈告诉过我，等到人人都不需要习武来保护自己的那一天，才算是真正的太平日子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "爹说的这些道理都对，但现在，我更喜欢另外一句江湖老话，血债血偿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "我一定会把凶手找出来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "你们怎么在这儿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "雨霞姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "你是白天那个官差大小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "你不是说会查清楚吗？戒了严还怎么查清楚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "你们俩也见过？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "有了新的变故，事情比想象的还要棘手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "那就让我和你一起去查！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "我，也可以帮忙的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "这件事的危险程度，不应该让旁人——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "这是，什么声音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "是外城军防区传来的鼓声？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "槐琥",
      "text": "看，城头点起烽火了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "玉门的传统，望烽节，这是每年开春的时候，都要举行的仪式，连续三天。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "军营的鼓，是敲给城内的将士百姓听的，征鼓声声，告诉人们城池无恙，山河无恙，大炎无恙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "城头的烽燧，则是为牺牲在沙场的英灵指一条回家的路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜遥夜",
      "text": "回家......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "天灾过境、外虏叩边、流寇滋事......\n整整十七声军鼓，象征着过去一年里玉门经历过的大小劫难。\n这座曾横于北方数百年的塞上城市，因劫难而厚重。这座城市里的人，因铭记劫难而骨气铮铮。\n长风不灭原上火，一夜征人尽望乡。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
