  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "乌萨斯农民",
      "text": "啊啊啊啊啊啊啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯农民",
      "text": "火！火！烫啊啊啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯农民",
      "text": "救命！！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孩子",
      "text": "爸爸！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "哨兵",
      "text": "怎么回事！快走，快跑啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "text": "儿子，我的儿子！你这畜生......感染的牲口！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "text": "啊！！火太大了，火太大了！咳，咳，唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "text": "混蛋！！！我死也不会......我诅咒你！！我诅咒你！！！皇帝在上，惩罚这些该死的感染者吧！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "啊......啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "已经不能再回头了。\n至此，这里发生的事，除了塔露拉外，无人知晓。\n之后的事情，众所皆知。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿米娅睁开眼睛。\n她的眼泪还没干。但她已经看过了一切。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "怎么这里会有只卡特斯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "阿米娅！！当心！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
