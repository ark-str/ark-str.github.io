  "stageId": "main_04-07",
  "title": "各取所需",
  "storyCode": "4-7",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-07_beg.txt",
  "sourceHash": "7a9f79a5e1d329d21af977f0d2416fda360faff16d6d5ac155213539032ce2ab",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这里......倒下的都是些整合运动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......这个，伤口流出的血液冻成了冰渣，其他部分却很完好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "确实是霜叶的技巧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——那边的废墟，应该是爆炸导致的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "应该是陨星炸出来的没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "（霜叶......杰西卡......陨星......她们，一定还......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "阿米娅，各救援小队都已抵达罗德岛、",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "我们救出了除了陨星她们以外的所有侦查小队。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "没有干员在任务中牺牲。但相应的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "所有人都有不同程度的冻伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "你要重视这点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......冻伤？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "所有侦查小队都指出，分城中徘徊着一些特殊的整合运动成员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "他们有着特殊的作战方式，完全不像一般的整合运动成员那样盲目。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "多加小心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我......我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "Dr.{@nickname}，你也明白吧？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "明白",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "那就好。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "我也要去做一些事情了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "阿米娅，就算Dr.{@nickname}很有用，也别太过依靠一个人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "还有，注意戒指。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我知道。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "其实凯尔希医生也很担心你的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "不知不觉中——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "危险的野兽露出他们的利爪了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "整合运动在我们的背后。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我们的退路......被切断了。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "这些感染者暴徒，似乎对我们有些想法呢。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "嗯......他们非常想要阻止我们撤退呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "然而，我们来到这里的目的，从来都不是逃跑。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "罗德岛，冲破他们的防线。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "让我们把陨星她们救回来！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "红，听得见吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "啊啊，对。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "没错。在贫民区东入口处会合。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "嗯。就我们两个。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "没问题的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "对付整合运动，我们两个已经足够了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
