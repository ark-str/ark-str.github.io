  "sourceHash": "acba3a88ee971ac3934774fa1e51359f6f210d36292a889259cbdc2ae6e86d1d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "不对劲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你又要干什么，病发了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "这和切尔诺伯格完全不一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "虽然我们损失不小，但我们战胜切尔诺伯格人的过程中，也看到了那些敌人的挣扎，还有那些帮凶逃窜的样子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "这龙门却像座空城？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "难道不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "大古广场，这么大的大楼，这么多的商铺，却一个人都没有啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "而且我逛了一圈，昂贵的商品都只剩下标牌了！都被拿走了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "爱国者不是说过，不允许......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "我不是那个意思。你知道，梅菲斯特随便我们干什么，但这不重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "我是说，好像有人提前把这些东西收起来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你又在瞎想了。龙门束手无策！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我们从各处突然涌了出来，哪里都有我们，*乌萨斯粗口*，就像在切尔诺伯格时一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "这回我们不毁掉它，我们要夺下它，把它当做我们的城市！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "你不知道吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "知道什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "大古广场是离近卫局最近的据点，从这里很快就能赶到近卫局，支援他们也很方便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "上次通报讲过了，我听过这段。其他的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "各处的整合运动理应在近卫局附近汇合，然后向外扩散，接管整座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "我们是很清楚我们周遭队伍的分布......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "但其他区域的队伍呢？我知道很多支队伍都正向近卫局这里移动，但更多的队伍消失了，消失得无影无踪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "消失......是什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "很神秘。他们的话筒开着，却一点声音都没传出来。我们没法联系上他们了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "马上也没人能联系上你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "什么，谁！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "窗户！在窗户外面！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "有敌人！敌人在攻击我们，近卫局，是近卫局！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "哈，是近卫局没错！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "可恶！难道是从顶楼挂绳下来，跳进窗户的吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "战斗！动起来！我们的人数远比他们多，消灭他们就行了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "通讯，给我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "Yes sir！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "近卫局听好！把整合运动连同他们的掩体统统砸个粉碎！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "（龙门粗口），你要干嘛？！大古广场是我家的财产！你凭什么——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "抱歉，“小姐”，整合运动负隅顽抗，先摧毁他们的战斗力才是第一优先级......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "你在说什么！！！你这条仆街龙！！你！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "近卫局！进攻！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "哎，我的天。哎。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你们注意点，这怎么说也是市民财产。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "那台钢琴他们没抬走，估计太重了。但值个一百八十万龙门币，“小姐”向我吹嘘过的，小心点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "你们跑不了了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "找掩体！快！躲在那架钢琴后面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "它打破了我们的掩体！转移！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "一百八十万......炸了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "其他同胞，其他同胞！听着！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我们占据了龙门的大古广场作为据点，也做好了防御准备，但近卫局从广场高层突袭了我们！他们正在削减我们的人数！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "通报！！近卫局的主力，在大古广场！大古广场！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "汇报完了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你什么时候——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "如果你已经汇报完毕了，那你的任务就已经完成了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "让整个龙门的整合运动都知道我们在这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我们等着他们来，等着他们追逐我们，等着和他们在近卫局决一死战。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "近卫局！继续攻击！别停火！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
