{
  "server": "cn",
  "storyId": "main_16_level_main_16-15_beg",
  "groupId": "main_16",
  "stageId": "main_16-14",
  "title": "旷野轰鸣",
  "storyCode": "16-15",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_16-15_beg.txt",
  "sourceHash": "2c8c35c612eadad493cb3cd4de829b9d487a77c421b16607b8f447163828053b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "说来奇怪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "其实我很喜欢布列斯克的这个季节。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "没有太阳的东升西落，没有昼夜分明......人们也不用假装一切都很明了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "“多事之秋”，元帅他也是这么说的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "女大公殿下，时间紧迫。即使是在我享用您招待的这一杯热茶的时间里，局势也在不断变得紧张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "元帅在等待您的答复。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "连叶甫根尼元帅都坐不住了，看来乌萨斯真的面临着巨大的麻烦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "您完全正确。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "在这样的局势下，圣骏堡温吞的反应将不被接受——这不只是元帅一人的意见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "时至今日，他应该早已理解，他的父亲在当年那场动乱中的举措堪称睿智——第四集团军本会有比发配边疆更坏的结局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "那么如今，年轻的叶甫根尼，是下定决心要冲在眼下乱局的第一线了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "永远站在离危险最近的地方保护乌萨斯——元帅在履行乌萨斯军人的天职。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "现在的问题，在于您，女大公殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "元帅需要您还愿意维系往日的合作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "这是他对我的通知？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "这是一个基于友谊的请求。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "元帅他非常重视与您的友谊，同样也信任您的智慧。他相信，即使在这个时候，布列斯克与第四集团军的利益也是紧密相连的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "何况他并不请求您做什么额外的事——只要您的一个点头。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "听起来，他似乎认为这很容易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "难道他将我们的皇帝陛下看作一个蠢材吗？难道维特议长也是一个蠢材吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "这是非此即彼的选择......就像太阳不会与黑夜共存。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "元帅非常理解您的处境，他当然愿意为您分忧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "无论如何，一位“皇帝的利刃”的陨落，有非常充分的解释空间，而元帅愿意替您做出这个解释。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "“第四集团军协助布列斯克剿灭了发生在远北地区的叛乱”——只要您愿意合作，集团军呈交给圣骏堡的报告上，就只会有这样一句话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "甚至不必点头，您的沉默，元帅也可以接受。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "不......并非如此......如果元帅他真的理解我，就该知道我在意的从来不是来自圣骏堡的质疑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "生活在我的领地内的人民，乌萨斯的人民......我在意的只有他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "元帅理解您的仁慈，他向您保证，您划下的线，没有人可以逾越。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "年轻的叶甫根尼，急躁的叶甫根尼......我又怎会愿意看到我亲爱的朋友以身涉险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "哪怕真的如他所愿，我保持沉默，这也不过是在他前行的崎路上抹去了一堆小小石子，那些巨大的山石他又准备如何处置？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "这些，就不劳女大公殿下烦忧了。无论是山石还是别的什么，元帅他有决心为乌萨斯战胜一切敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "那么......我是否可以理解为，已经得到了您的答复。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "叶甫根尼元帅向您问好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严肃的乌萨斯军官",
      "text": "为了乌萨斯的荣光。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "叶莉莎女大公",
      "text": "一切为了乌萨斯的荣光......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "科谢尼娅，你还好吗？需要的话我也可以抱着你们两人一起跑的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科谢尼娅",
      "text": "不，不用。我......还好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "科谢尼娅",
      "text": "我只是不明白......我们为什么......要这么急着赶路？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我有一个猜想......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "如果乌萨斯官方已经得知了矿脉的异变......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "能让远北所有的矿区都陷入沉寂，只有一种解释——",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "乌萨斯不会让矿脉枯竭的消息传播出去。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "博士，你看天空的颜色！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "我们进来的时候，是这样的吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "......不......这是我的幻觉吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "为什么又是......这样的颜色？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "醒目的、带着警示意味的红色。你甚至不需要特意抬头就能看到的颜色。\n它逐渐笼罩了原本是灰色的昏暗天幕，也笼罩了身处地面的一切。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......军队。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "乌萨斯军队的警示灯。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他们已经来了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "为什么......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "为什么军队会在这个时候深入远北？他们根本不应该来到这里！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "博士，西北方五公里处检测到大规模的高能源石反应，有人在快速向我们靠近。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......马上回研究所。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "必须立刻告知阿米娅。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "科谢尼娅，你还好吗？我们该加速了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "对，研究所......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我们要回研究所。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "这边！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "我记得应急通讯设备都放在顶楼的观景台里，钥匙在所长办公室——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "跟我来！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（小声）不是我们的脚步声。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "（小声）这里还有其他人？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "听起来人数不多。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "没时间了。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "要尽快通知阿米娅。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "抱歉，这里没有应急灯，看不清。我已经点上蜡烛了，先将就一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "没错......通讯设备在这里。我没用过这种东西，不确定它能传递信号的距离有多远。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "这是乌萨斯军用通讯器。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你认识这种装置？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "Raidian有类似的装置——她年轻的时候曾参与过乌萨斯军方类似设备的研究，没想到他们竟然已经做出成果了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "如果和我知道的一样，那这就是一种高性能全域信息广播装置。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "它搭载了一个功率极高的施术单元——功率大概相当于同时使用一百台普通军用级通讯器。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "它的设计初衷，就是为了能大范围向军用设施发送急电。当然，擅长使用感知类源石技艺的人，比如Raidian，也能接收到。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "这难道不是好事？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你为什么这么紧张？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "但是它没有办法发送出特定频段的信号。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "也就是说，如果我们在这里使用这个装置发送了信息，不远处的乌萨斯军队也一定会接收到......我们的位置会立刻暴露。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "博士......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......发送信息。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "发送信息，然后立刻转移。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "好，听你的，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "把你要发出的信息告诉我，我来操作。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "乌萨斯，矿脉正在全面枯竭。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "已录入，还有呢？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "博士！小心！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "呃——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "科谢尼娅",
          "text": "怎么回事？他们为什么要袭击研究所？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "至少有一支军队介入了远北事务。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他们会封锁消息——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "好了，录入完毕！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
