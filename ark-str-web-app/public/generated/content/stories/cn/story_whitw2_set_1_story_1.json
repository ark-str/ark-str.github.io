{
  "server": "cn",
  "storyId": "story_whitw2_set_1_story_1",
  "groupId": "story_whitw2_set_1",
  "stageId": null,
  "title": "气味游戏",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_whitw2_1_1.txt",
  "sourceHash": "7bc54a1b78e15735fce2e8304d8db071bead04cc3d9a54f8eb59f5f5bc6d5748",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "瓦古，你也来了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "我的嗅觉应该比你差吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "我的意思是，看来我们找对了地方——那东西就在这间病房内。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "狼群搜遍这艘陆行舰的每一个角落，只为了找拉普兰德不知什么时候弄丢在哪儿的信物......你不觉得滑稽吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "别抱怨了，恺撒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "头狼有资格驱使狼群做任何事情，这是我们共同的选择。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "赶紧结束这一切吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "那是，你的獠牙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "......红。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "（轻微的鼾声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "（痛苦的呓语）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "拉普兰德的气味......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "红紧握的那把匕首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "拉普兰德丢失的信物，怎么会是你獠牙的匕首？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "哼，哪怕成为了头狼，白狼终究只是个幼稚的人类。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "喂，扎罗。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "刚刚那阵烟尘，只是野生驮兽为了躲避罗德岛闹出的动静，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "荒野就在眼前，何必问我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "耐心点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "这不像是你会说的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "一艘偶然偏航的陆行舰短暂闯入荒野的深处，和那些漫游的神秘存在擦肩而过，我们因为恰好在甲板上，得以和其中的个体打个招呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你知道为了帮你们和你们的同类安排这么一场别开生面的会晤，我费了多大劲，干嘛要急在一时？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "你原本没有必要折腾这一出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "我们可以直接去到龙门，或者阿卡胡拉，那几个家伙的行踪更好掌握。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "哈哈，扎罗，狼群确实越来越像人类了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "我当然可以约德克萨斯的老板去听地下说唱，或者和那个叫鸭爵的家伙相会在赌桌上，还在叙拉古时，我没少做这样的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "但他们这样的在兽主里只是少数，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "如果所谓的“危机”真的那么可怕，你的第一反应竟然是找到同样泡在人类社会里的同类，然后像人类那样凑在一起开会？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "叫其他狼回来吧，再过不久，你们的那些同类就会经过这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "恺撒还在帮你找信物......等等，你没有弄丢信物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "压根没有所谓的信物，扎罗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "那......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "你故意让恺撒见到那个被她抛弃的獠牙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "哈哈，我可没说。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红看见了，外婆......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "她没有醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "你只是靠近，她仍在睡梦中都会情不自禁地颤抖......这个孩子对你的恐惧已经深入骨髓。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "梦境......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "停止你无聊的恶趣味，恺撒。我们拿了匕首走就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "那把匕首，是我送给红的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "那个孩子刚懂事时，我找来一支兽牙，教她将其打磨成最锋利的匕首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "还不明白？拉普兰德故意支使我来到这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "她希望我拿回这把匕首？不，她希望我抹除这个人类的恐惧和痛苦，她希望我消弭我之于这个人类的影响。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "唔，这不像拉普兰德的作派。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "帮一帮可怜的同事，或者向自己正挂靠的医药公司示好......她的心思不难猜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "所以我说，哪怕成为了头狼，她终究只是个幼稚的人类。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "在这里等着，瓦古，我很快就结束这无聊的“任务”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "红。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆......真的是你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "除了外婆，还能是谁呢......真是个可怜的孩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "啧，打我登上这艘船，这是你第五次跟踪我了，红干员。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "味道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红闻到了熟悉的味道，从你身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "如果你说的是狼味，我身上可不止一种。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆她来了这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "你是外婆找来取代红的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "听起来，你想杀了我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "如果博士和你那个爱藏在烟雾里的上司不追究，我倒是很乐意活动活动筋骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "不......红不要和你战斗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红不知道怎么解释......外婆找上你，你会像红一样，到最后，被......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "哈哈，感谢你的关心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "......你在发抖，红。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆对红说，说......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红和被红杀死的那些家伙一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红只是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "只是为她赢得了一场索然无味的胜利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红听了外婆的话，红没有听凯尔希的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红做了一件错事，一件又一件错事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红既是猎狼人，也是真狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红是谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红的心，很乱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "（痛苦的呜咽）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "红，你恨那只狼吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你想要忘记她吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "别怕，这里是罗德岛，你的罗德岛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "我非常愿意帮你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "就是这样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "就是这样。凯尔希不在岛上，你说我怎么能置之不理呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "拉普兰德，你希望我夸你热心，还是夸你善良？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "扎罗，你希望我认为你谄媚，还是认为你阴阳怪气？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆，这次你要去哪里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "外婆没有要离开，外婆在等你跟上来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "红色的幼狼无意识地抬了抬脚，但她很快反应了过来，最终没有动。"
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "别怀疑，孩子，你觉得外婆还有欺瞒你的必要吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "你的疑惑，你的痛苦，外婆都会给你回应。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "过来，来外婆身边。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "熟悉的声音，温柔的语调，微风吹过草地，刮起泥土里隐隐的腥味......很安全。\n仿佛一切从来没有改变。\n良久。\n幼狼终于还是情不自禁地迈开了步子。"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "这是梦吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "是梦，也是真实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "跟上就好，红。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "为什么不说话？以前每次分别后重逢，你都会缠着外婆问东问西......尽管连话都说不利索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "我知道了，你心里有恨，你责怪外婆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......外婆欺骗了红。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红信任外婆，外婆不该。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "若说“不该”，孩子，你我之间不该有这些无聊的情感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "毕竟，你也欺骗了外婆，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "狂欢节的那个夜晚，你没有真正杀死阿涅塞的獠牙，那个幼崽叫什么名字来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "子、子月。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "你留了手，你想要试探外婆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "那是因为......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "狼主确实会折断獠牙，但母兽不会遗弃她的孩子，尽管谎言是她给的襁褓，但荒野中生命的关系总会因纯粹而牢靠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "可罗德岛上的人也好，那个裁缝也好......他们并不理解荒野，你却轻易听信了那些说辞，你让我们的关系有了裂痕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "真相已经不重要，游戏的输赢已经不重要......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "如今这一切，是外婆应受的屈辱，也是你应受的惩罚，孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红记得这里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "外婆说过，这是梦，也是真实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "这簇草丛......外婆教红隐藏气味，安静等待猎物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "这棵树......外婆教红制作陷阱，把它藏在枯叶下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "那边，那块石头......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "你曾在上面打磨兽牙，直到它变成锋利的匕首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "我们刚刚路过的每一片树林，每一个山洞，每一具骨骸......都是你的来路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆在带红往回走......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "我们会在哪里停下来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "你会知道的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "你还在想刚刚的话吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红必须想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红的心很乱，红想不明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "说实话，虽然漫长的岁月里，狼主间的游戏已经更迭了无数轮，但你仍是我最为特别的獠牙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "唯有你，真正在以狼的方式生存，以狼的方式思考，尽管留在了这艘陆行舰上，也永远无法真正融入人群......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "你太纯粹，你无限接近于，真正的狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "真正的狼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "所以，孩子，忘记外婆刚刚说的话吧，忘记我们彼此间的仇恨与责怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "因为这些情感对你来说太过复杂......因为这并不怪你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "我们终于到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "这、这是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "这是你我相遇的地方，外婆在那边的草窠里捡到了被遗弃的红。那天晚上暴雨如注，你的哭声差一点消散在雨里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "这是此行的终点，也是一切的起点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "外婆会烧掉那个草窠，然后，我们刚刚途经的一切便将不复存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红不理解......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红会忘记外婆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红会忘记和外婆有关的所有事情？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "你将忘记我带来的困惑、痛苦和哀伤，仿佛我从未存在过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......红不会再做噩梦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "没错，真是个聪明的孩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沉默。\n红色的幼狼低着头，紧攥着的手骨节发白，她没有再说话，看起来极为痛苦。\n优雅的狼主没有紧逼，她决定给幼崽一点时间，尽管......自己的耐心早已所剩无几。\n终于，幼狼抬起了头。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆，红不愿意。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "红，你恨那只狼吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你想要忘记她吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "别怕，这里是罗德岛，你的罗德岛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "我非常愿意帮你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红不知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "不知道？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "那就说明你不想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红不想？没有人教红该怎么处理......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你的直觉很准，红。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "背叛和欺骗编织了你的人生，痛苦让人想要遗忘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "但忘记是没有用的，那等于抽了筋扒了骨，将自己变成一具空壳......那是更残忍的暴力，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你熟悉荒野，噩梦同样能帮助你活下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "哈哈，我突然有个主意。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红不需要忘记。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "外婆告诫过红，红记得外婆的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "必须牢记仇恨，盯紧仇人，红才不会迷路，才挥得动刀......红才能够活下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红以前为外婆报仇......报不存在的仇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "红",
      "text": "红现在为自己报仇！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "红跟腱发力，高高跃起，那是狼的狩猎技巧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "极短的一瞬，红已经一刀将狼主劈成了两半。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "神秘的黑雾散开，淋漓的鲜血冲刷着红的身体，让她看起来仿佛鬼魅。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "红的手剧烈地颤抖，仿佛不敢相信自己刚刚做了什么......她晕了过去。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "可下一个瞬间，黑雾再次聚拢，狼主重新来到红的面前。"
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "梦境给了你冒犯我的底气？可这一切毫无意义。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "既然不愿意遗忘，那就带着关于我的一切活着吧，让噩梦叠加噩梦，让痛苦缠绕痛苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "也好，也好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "旧的游戏已经结束，可我对拉普兰德能为我们带来多少新乐趣，并不像扎罗他们那样有信心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "就留你作为一个时代的烙印存在吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "但估计下一个转眼，我就会将你彻底遗忘，幼崽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "毕竟，你和那些被我折断的獠牙，其实没有任何区别。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "瓦古，出来吧，我们该走了，这里的气味可真难闻。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "不对......这个气味，不对不对......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "拉普兰德，是你搞的鬼？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "瓦古，我刚刚没有听错吧，恺撒是不是质疑了头狼来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "我身上，怎么会有红的气味？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "是吗？竟然有这样的事情？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "我想想，刚刚到底发生了什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "红用刀划伤了你，你的血淋在了红身上......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "哈哈哈哈，难道说，你和你的獠牙交换了气味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "这只是我赐予她的梦境！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "灼烧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "哈哈，好大的雨......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你指望这些方式能够消除身上的异味？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "没有用的，我亲爱的狼之主。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "阿涅塞告诉我，遥远的岁月前，这片大地唯有荒蛮，狼群各自出没，你们会通过交换气味来识别、交流和标记领地......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你们以此合作狩猎，也以此猎杀彼此......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "直到生命终结，你们都无法抹除身上沾染的其他狼的味道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "红的匕首......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "那把匕首确实是我的信物......它受到了“头狼的赐福”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "阿涅塞，是你教拉普兰德......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿涅塞",
      "text": "她不止问了我，我并不知道她要做什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "糟糕，我忘记了一件事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "狼之主不死不灭，狼之主永恒存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瓦古",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "恺撒，看来。未来你只能带着红的气味行走在这片大地上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "尽管你从未正视过这个獠牙，尽管你早已将她抛弃，但这份气味会始终提醒你她的存在，让你永远无法将她遗忘......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "因为不死不灭，所以永无尽头。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "（凄厉的呼号）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "当然，你也可以随时报复我，这会为我的新游戏提供一些灵感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "为什么要做这一切？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "身为头狼，你居然只是为了幼稚的同僚之情，而如此算计、羞辱自己的狼群？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你是说我只是因为同情红？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "啧，幼稚的狼之主。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "恺撒，我可不单单只是为了红而羞辱你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "扎罗、瓦古、阿涅塞，还有那边的几只......我希望这件事能让你们警醒——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "狼群正变得越来越像人类。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "狼之主们",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "原野苍茫，蛮荒无序，我并不在意你们对人类或是同类有多残忍......这本就是荒野的常态。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "只是恺撒，你连对獠牙残忍的方式都像极了人类。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "欺骗、背叛、粉饰，扭曲认知，种下噩梦......你在耍弄最粗浅的权力，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "（嗅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恺撒",
      "text": "（无奈的喘息）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "你们告诉我，那场所谓的“危机”已经近在咫尺，狼群需要接触众多同类......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "从萨米的雪原到玻利瓦尔的黑流树海，从萨尔贡的黄沙到伊比利亚的盐漠......习惯和人类厮混的兽主只是少数。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "那么，我当然要向他们证明，新的狼群，将会更纯粹。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "喂，拉普兰德。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "扎罗",
      "text": "他们快到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "离开这个梦境吧，让这个叫红的孩子睡个好觉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "我们回甲板......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "text": "狼群，该去赴荒野的约了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
