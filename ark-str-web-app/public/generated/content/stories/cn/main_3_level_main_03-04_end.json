  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "怎么会？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我们明明只消灭了一个整合运动小队......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "还顺势摁倒了一个大块头。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "这个才是重头戏好吗，为了对付他，我可是累坏了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "不可能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "那么多感染者，怎么可能消失的无影无踪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "刚才那个大家伙，只是打个掩护而已？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "整合运动在这么短的时间里撤出了这个区域？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不，陈长官理应截断了他们的后路——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "我看不到信息点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "这里......不对劲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "杂草，废墟，沙丘......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "全是值得埋伏的地点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "但我，什么都看不到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "脚印，服饰刮擦植物的声音，爆炸物特有的气息......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "我没法判断！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "企鹅快递的家伙，打起精神来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "一切都不对劲！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "收声！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "是什么声音......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "————嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "是从......地下！？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "阿米娅！从地下传来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "！！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "博士！！快趴下！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "这群人......真是不择手段！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "————！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "怎么......你居然......能挡住？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "这面“般若”，可不是你能打得穿的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "那可......未必......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "温度急剧升高！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "他想引爆手中的魔杖吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "博士！快跑！那个距离，你会————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你————",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "结束了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不......不要———",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不能—————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不可以伤害博士———————！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "咳，咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......很厉害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你......这是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你好强。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......咳......好疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "明明有这种力量......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......你......就甘......心......看着同胞们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我不能，原谅......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "原谅你们这种......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "不...........不要.............",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
