  "stageId": "main_03-04",
  "title": "龟裂",
  "storyCode": "3-4",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_03-04_end.txt",
