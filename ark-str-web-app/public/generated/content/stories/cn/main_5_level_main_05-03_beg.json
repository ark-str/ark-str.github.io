  "stageId": "main_05-03",
  "title": "义胆凡躯",
  "storyCode": "5-3",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_05-03_beg.txt",
