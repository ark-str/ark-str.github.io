{
  "server": "cn",
  "storyId": "act12d0_level_act12d0_04_end",
  "groupId": "act12d0",
  "stageId": "act12d0_04",
  "title": "机兽咆哮",
  "storyCode": "RI-4",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act12d0/level_act12d0_04_end.txt",
  "sourceHash": "37365c07d416c7e364ddfc0a19c429ed479b8632ee094f6e65726497929221f3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯喽喽A",
      "text": "嘎哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯喽喽B",
      "text": "太、太强了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌代",
      "text": "算你厉害！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿鲁纳",
      "text": "森蚺，别得意！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿鲁纳",
      "text": "小的们，上！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "唔，不愧是祖玛玛，果然很厉害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "虽然只有一个人，一般的阿达克利斯也不是她的对手，就像嘉维尔一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "但是......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你好像很熟悉她。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "嗯，祖玛玛和嘉维尔从前开始就是我们这一带最厉害的两个人呢。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "不过据我所知，祖玛玛从来没有赢过嘉维尔哦！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "博士。在外面这么厉害的人一定很少见吧！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "但是，嘉维尔更厉害哦！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "好帅的女孩子。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "唔，虽然祖玛玛确实很帅。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "但是，嘉维尔更帅！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "对吧，嘉维尔？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "咦，嘉维尔呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人A",
          "text": "喂，你们看，那个人是！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人B",
          "text": "我刚才在来的路上就看到了，她是——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人C",
          "text": "她居然真的回来了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你是——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "所有人",
          "text": "嘉维尔！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "哇啊啊啊啊，嘉维尔直接冲上台了！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "好久不见啊，祖玛玛！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "现在应该叫你森蚺头领了对吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你居然回来了，嘉维尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "是啊，特米米叫我回来的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嗯？等等，你居然也会说萨尔贡语？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......既然你也会这种语言，看来这种语言确实是外面的语言没错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "我学习了很久。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......我以为你不会再回来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "我会回来的，不是现在，未来也会回来的，这里是我的家。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......你要当大酋长？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "不，本来我只是找你有点事，打完再找你也没关系的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "但是，你这家伙变得这么厉害了，这让我怎么忍得住啊！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你真的去做医生了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "是啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嘿，我在外面可是很有名的医生！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "真意外。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "你呢，上次的时候你不是在捣鼓自己的东西没有参加吗？终于捣鼓好了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你马上就会见到。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "呜呜呜，嘉维尔不是说她不会出手的吗......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "嘉维尔出乎你的意料了？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "诶？没、没有的事！只、只是.......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "博士也看入迷了......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "呜呜，虽然确实很帅，但是......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "这才是嘉维尔。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "呜呜，虽然这么说是没错。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......你还是那么强，嘉维尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嘿，你也不差啊，祖玛玛！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "但是，你太依赖你的拳头了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你的拳头让你可以做到许多事，所以你从不考虑用拳头以外的东西做事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "这是你的局限性，也是我们这些人的局限性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "你到底在说什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "我在说，该改变了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "随着“嘿咻”，“嘿咻”整齐的号子声，林间似乎有什么庞然大物在靠近神庙。\n它缓慢，而又坚实地“走”着，还不见其全貌，就已经让人感觉它无坚不摧。"
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你确实很强，嘉维尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "原本，我是想在成为大酋长后再用它的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "现在，我不得不用它来对付你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "但是，结果是一样的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "它将改变这里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "虽然不知道你在说什么，不过我可没那么轻易倒下啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "不，你会轻易地倒下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "......大祭司，瞄准，开炮！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "什么，那是？！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "你看，我说了，嘉维尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "但是，用它对付你，并不是我本来的目的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "靠拳头是没有未来的，嘉维尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "森蚺",
          "text": "接下来，是机器的时代。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
