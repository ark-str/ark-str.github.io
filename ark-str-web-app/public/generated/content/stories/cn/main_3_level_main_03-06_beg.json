  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十八关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "在战场上发呆是很危险的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......抱歉。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我只是......没能理解。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "整合运动龟缩在一个废弃矿场里。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "那个女人，W，也一起逃进去了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "你如果想独自待着，我也会给你点空间。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "但近卫局却没有能拿来浪费的时间。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_136_hsguma",
      "text": "星熊，让其他人集合。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "（米莎......）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "陈长官——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我有一个疑虑。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "疑虑？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "W擅长使用爆炸物。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "她极有可能会在战场上散布陷阱。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我担心，纯粹的正面进攻会给我们带来很大损失。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我提议，由罗德岛干员先行潜入矿场，近卫局在外围设置包围网。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "任何从中逃出的整合运动，可以由近卫局立刻逮捕——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "而顽抗的整合运动，由我们处理。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "你们对付那个女人，有几成把握？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我不知道——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——但我们可以承担相应风险。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我们与她战斗过不止一次，至少对她的作战风格有一定的了解。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "有的风险，近卫局是承担不起的。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "——丢失任务目标的风险，近卫局同样承担不起。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "PC94172，你带近卫局的队伍包围矿场！"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "星熊，去挑几个人。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "我们各带一支小队，和罗德岛一起去。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "星熊你和罗德岛分两路，同时摧毁他们的阵地，扰乱他们的防线。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "我去处理火力点。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "为了龙门，我必须把米莎——"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "......夺回来。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——明白。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我去召集罗德岛干员。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "老陈，矿场边缘——有波整合运动正向外移动。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "——动作还挺快的。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "我先去了，否则会赶不上。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "快去。一个也别漏掉。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "啊，星熊督察，请稍等。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "敌人针对我们罗德岛设下的埋伏中，混有整合运动的术师。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我建议让我方干员芙兰卡和雷蛇跟着星熊督察你的小队。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "他们有非常丰富的对抗术师的经验。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "没问题。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "那就，合作愉快咯？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "那你呢，阿米娅？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "凯尔希医生嘱咐我们的是......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "这里有企鹅物流帮助我，没关系的。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "那就这么定了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "千万不要逞强，撑不住就立刻撤退。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "阿米娅，你呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我明白。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我们已经不剩多少时间了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "和切城不一样——现在，轮到我们来阻截整合运动了！"
    },
    {
      "type": "sceneBreak"
    }
  ],
