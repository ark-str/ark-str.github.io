      "text": "第四关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "speakerId": "char_348_ceylon",
      "text": "快！博士！我们往沙滩那边走！"
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "speakerId": "char_348_ceylon",
      "text": "沙滩上有大量游客聚集，混进人群里面他们就追不上我们了！"
    },
    {
      "type": "dialogue",
      "speakerName": "保镖",
      "speakerId": "avg_npc_020",
      "text": "站住！"
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "speakerId": "char_348_ceylon",
      "text": "就凭你们！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerId": "char_340_shwaz",
      "text": "......"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "欸，你是——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "speakerId": "char_348_ceylon",
          "text": "黑！太好了你终于来了！"
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "speakerId": "char_348_ceylon",
          "text": "还好有你在，克洛宁这是怎么了！？"
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "speakerId": "char_348_ceylon",
          "text": "博士，她就是我之前跟你说......"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "speakerId": "char_340_shwaz",
          "text": "小姐，老爷不在城里，你得听克洛宁的。"
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "speakerId": "char_348_ceylon",
          "text": "黑？你在说什么？"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "speakerId": "char_340_shwaz",
          "text": "快跟我回去找克洛宁，把这些人都交给他。"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "speakerId": "char_340_shwaz",
          "text": "我不想对小姐动手。"
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "speakerId": "char_348_ceylon",
          "text": "......黑？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
