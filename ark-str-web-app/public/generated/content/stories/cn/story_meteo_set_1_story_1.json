{
  "server": "cn",
  "storyId": "story_meteo_set_1_story_1",
  "groupId": "story_meteo_set_1",
  "stageId": null,
  "title": "一星萤火",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_meteo_1_1.txt",
  "sourceHash": "88ce40f84b77a9b9751e71f09a7f5447db7c1f7eabdda1a3ebb6b375089e5e00",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "桦树、椴树、杉树、松树......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "车前草、地团花、接骨木、悬钩子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "夕阳、暮色、傍晚、黑夜......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "怎么样，这些生词都念熟了吗？接下来，我们试着朗读一整篇文章吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "嗯，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "“......花园里新栽的两排接骨木开花了，甜美的香气让人晕晕乎乎。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "“在我模糊的双眼中，悬挂在天幕上的夕阳好像变成了两个......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "“这真是、真是一个......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "怎么停下了？是遇到什么问题了吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "陨星老师，这里有一个生词我不会念。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "来让我看看......\n不好意思，是我的错，应该是昨天准备的时候看漏了，没有标记它。"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "来，先和我一起念。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（萨卡兹语）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "（复述陨星的话）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "很好，你念得很标准。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "陨星老师，这个词它是什么意思啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "这是一个时间名词，也可以用作副词，它对使用情景有特殊的要求，只能是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "哎，前面的，快走啊，堵在路中央干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵A",
      "text": "他妈的，又一个要饭的过来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "要饭的？在前边？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵A",
      "text": "你这丫头，怎么还伸出脑袋往外看，小心他看到你就缠过来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵A",
      "text": "妈的，他还真的过来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "那有什么？不理他继续朝前走就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "先生女士，有人需要代写书信吗，价格不高，几个铜子儿就够，或者给些吃食也可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵A",
      "text": "喂，小萨利，要不要老子让这要饭的给你搞封信！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵B",
      "text": "放你妈的屁，老子根本不识字！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵A",
      "text": "哈哈哈，这不是更好吗，他还可以给你念信，那么这个要饭的就有两份活干了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵B",
      "text": "滚蛋吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵A",
      "text": "看到了吧，要饭的？快滚开，我们没有闲钱，也没有写信的必要，那些我认识的人，还活着的，都在这个队伍里了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "先生，别走，等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "喂！先生，别走啊！哪怕给口水喝也行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "唉，真是的......喂，你过来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "小姑娘，你需要写信吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我没有兴趣，我这里有块饼，你拿了快走吧，这里是战场，用不到你那些玩意儿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "（肚子咕噜作响）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "我不是乞丐，小姑娘，我不能白拿你的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "你要学读写认字吗？那些大头兵年纪大了，顽固得不行，意识不到字词的价值。你还年轻，以后会有大用处的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我不能停下，我得赶路，我没时间听你讲课。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "我可以跟着你的队伍一起走，如果你决定做我的学生，在教会你之前我不会离开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "唉，这块饼还给你吧，小姑娘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "收着吧，劝你赶紧吃掉，到我们要去的地方还需要走很久，你可以一边走一边讲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "哎，好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "你会写自己的名字吗？我可以先教你写这个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我们没有名字，只有代号。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "那你的代号是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "钝镝，是之前的一位团长给我起的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "这是个很好的代号。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我没看出哪里好，那位团长告诉我这个词的意思是没用的箭头。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "哈哈，萨卡兹有一句俗语“锈蚀箭头蹭破皮，小命立刻就归西”。破伤风可不是闹着玩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "噗嗤......你在战争开始前到底是做什么的？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹过路人",
      "text": "教书，那时候我在教书。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "两个月后"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "唉，这场仗不知道打到什么时候是个头啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "（包扎自己的伤口）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "你的伤口怎么样了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "没有大碍，我已经消过毒了，拿绷带缠几圈很快就能恢复。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "没事就好啊，这太阳晒得真舒服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "你上次借给我的书我就要看完了，你还有其他书吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "剩下的书都是诗和散文，你又不感兴趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "那还是算了，你自己收着吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "喂，钝镝，你伤口包半天了，好了没？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "没有大碍，已经处理过了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "大碍？这啥意思？啧，听不懂的话少说，赶紧来分钱了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "二、四、六、八、十......一共十四颗人头，哼，收获蛮多嘛！妈的，要不是跑了几个，大家伙儿能赚更多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "（皱起眉头）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "喏，这是你该得的报酬和干粮，我先走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "等等，先别走，东西少了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "你在胡说些什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我这次击杀的目标中有两个狙击手和一个装甲掷弹兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "按照当初的约定，他们的价格分别比普通目标高百分之三十和百分之五十，所以你还欠我十二个金币。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "你什么时候能把账算得这么清楚了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "（伸出手）十二个金币，不信的话，可以和我一起去找团长，算我酬劳的同时也好好清点下你的小金库。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "钝镝，你什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "都是同行腥风血雨里赚的钱，自己昧下也就算了，装糊涂没必要吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "......拿了就把嘴闭紧，钝镝。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "（耸肩）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "哈哈，你学得很快嘛，这才短短两个月，基本的算数你就掌握了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "是你教的东西太简单了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "是啊，你该学的已经都学会了，我也该离开了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "给你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "半袋金币都给我吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "是这两个月的学费。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "哈，那我就不客气了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "离开后你要去哪里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "东面吧，听说那里的战事不是很频繁，或许还可以找到一两所残存的学校。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "你有武器，身手也不差，加入佣兵团完全可以填饱肚子，为什么非得选择用更艰难的方法活下去？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "哈哈，卡兹戴尔有那么多靠武力吃饭的人，也不差我一个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "啧......你们这些文化人最麻烦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "那本书你什么时候能看完？我离开前记得还我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "明天吧，就差一个结尾了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "“马黛拉觉得窗子透过来的月光过于明亮，于是她揉揉眼睛，拉上窗帘，在......中她沉沉睡去。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "嗯，这个词是什么意思？以前没有见过......算了，继续读下去吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "“与同伴们围坐在篝火旁，马黛拉拨弄着火中的栗子，它甜蜜的气味是这......的馈赠。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "呃，怎么又是这个词，烦死了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "“马黛拉合上门，拿起脚边的行李准备上车，临行前她再次回想起自己在这里度过的无数个......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "无数个什么啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "“别了，那些......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "马黛拉你到底在和谁告别啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "“或许在以后的日子里，她还会再遇到......但不会有......像这里的......一样，令她如此难忘。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "啊啊啊——为什么这句里面有这么多这个词！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "这个破词到底是什么意思啊啊啊！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "哈哈，你看完的时间比预计的久啊，怎么样？要是喜欢我可以送给你，就当作离别赠礼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "不了，比起小女孩在农庄里过家家，我还是更喜欢冒险小说，而且读它的时候我一直很烦躁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "遇到问题了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "是的，那本书出现了一个词，我从来没有见过，我试着跳过它继续读，但是它出现的频率实在是太高了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "给我看看......啊，原来是它，这个词是个时间名词，有特指的情景。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "它指的是一个令人心生欢喜，悠闲宁静的夜晚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "什......么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "一个快乐的夜晚，也可以这么理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "那是什么意思？夜晚不可能快乐，也不可能宁静。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "怎么不可能？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "夜晚都是漫长的、黑暗的、寒冷的，它还是危机四伏的、让人提心吊胆的......总之，我讨厌夜晚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "之前有很多次我都觉得自己会死在某一个深夜，变成一具被野兽啃食的尸体，再也没法见到第二天的太阳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "你能理解“一具被野兽啃食过的尸体”这种复杂的名词，却没法理解“一个悠闲宁静，让人愉悦的夜晚”？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "那些尸体我们这一路上见过很多啊，你一解释给我听，我立刻就能联想到那些场景。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "唉......既然你提到了联想，那不妨让我们靠进行联想来理解这个词，你先闭上眼睛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "那时你还小，一个晚上，你依偎在母亲的身边......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "停，我从没见过她，想象不出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "那在你的成长过程中有没有其他......比较有分量的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我之前的团长，是她从战场上捡到我并抚养我长大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "对，你依偎在她身旁，联想一下这个场景，是不是有了一些感觉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我靠向她，然后她会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "她一把推开我，告诉我佣兵团中不需要柔弱的孩子，随即递给我两桶水，让我绕着营地跑十圈，还不许洒出一滴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我感觉肩膀酸了起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "行行行，我们换一个场景去想吧。要不这样，夜晚你和伙伴们团团围坐在森林中，支起了篝火，一只汤锅架在火上，发出浓郁的香味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "你联想下，是不是感觉到了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我探出头，想要靠近汤锅去细细品味那香气......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "对，就是这样！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "然后我回过头，发现一只手不老实地伸向我的背包，试图从里面拽出钱袋。该死，为什么当时团长要招一个惯偷进来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我现在感觉非常气愤，想要痛打他一顿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "......算了算了，重新来过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "那么，一个夜晚，温柔的月光铺在地面，你把被子裹在身上，眼皮耷拉着，马上就沉入梦乡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "你感觉到......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我感觉到恐惧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "会有炮火......炮火随时会降下来，发出震耳欲聋的爆炸声......我捂着耳朵，躲进行军床底。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "唉......看看战争都对你们这些孩子做了什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "抱歉，你说了这么多我都不能理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "没关系，不着急，我再想想办法，你肯定能明白的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "就是一个词而已，你根本没必要这么费尽心思来教我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "小姑娘，你知道吗？每年都会有很多新的事物出现在我们的生活中，同时也会有很多用来描述它们的词汇不停涌现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "其中的大部分词汇会随着事物的消失一同被人们遗忘，不再被提到，不再被使用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "但是有些词汇，它们是特殊的，在口口相传的过程中，它们会被一直铭记。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "那是因为，它们所描述的东西是永恒不变的，它们也代表着这个民族最核心，也最有价值的精神。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "它们值得你的理解，值得你将它们保存在心里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "万一......我就是不能理解呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "哈哈哈，耐心，给它点时间，它会在你心里扎根的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "小心脚底下的枯树干，刚下过雨上面长了青苔，很容易滑倒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "知道了，你话太多了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "走了这么久，你现在可以告诉我，半夜把我叫起来是为了什么吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "你起床气真的很大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "不好意思，请告诉我，您带我来到此地有何贵干？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "（抖开一块布铺在地上）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "请坐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "（一脸疑惑地坐下）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "请用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "这是......桃子罐头？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "我就猜到你会喜欢这个，前几天你看你们团长吃，看得眼睛都直了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "哼，也没有那么好吃嘛，你从哪里搞来的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "我用一本书和你们团长换了两罐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "什么书那么贵重？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "没什么，一个古老的手抄本，挺破的，没啥用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "别骗我，团长一直在收集珍贵的古董书，然后倒卖给哥伦比亚人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "我没骗你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "......这还有半罐，你要吃吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "哈哈哈，你吃吧，那是给你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "谢谢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "看这周围的一切，你有感觉到什么吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "啪——"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "（嫌弃地看着自己的手心）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "这里虫子有点多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "事实上，你可以不用拍死它们，它们不咬人......算了，不提这个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "寻找这些飞舞的小家伙花了我好几个晚上，我带你来看是因为它们很特殊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我看到了，它们的屁股在发光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我之前在水潭旁边见过这些飞虫，我当时并不知道它们是虫子，我以为......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "以为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "以为它们是鬼魂，就是那些在战场上死去的人留下的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "的确，很多地方会把这些小虫子和坟墓周围的鬼火联系在一起，但是二者的发光原理并不相同。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "鬼火是因为尸体腐烂分解后会生出一种气体，燃点很低，常温下和空气接触就能燃烧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "那这些虫子呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "这些虫子它们自身就能分泌出一种独特的化学物质用来发光，它们还可以通过呼吸来控制体内的生化反应，从而调节萤光的明暗程度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "你来看，这是它们的臀部，尖尖的，里面储存着大量的荧光色素和发光细胞......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "钝镝看向男人的手心，一只飞虫敛起翅膀，停在上面，尾部闪烁着蓝莹莹的光芒。\n它吸引了更多飞虫的靠近，直到将男人的整只手都包围在萤光中。\n关于这些小虫子，男人似乎有讲不完的话，里面夹杂着一堆复杂拗口的单词，钝镝一个也不懂。\n可钝镝并不苦恼，她的内心溢出了陌生的感觉，说不清道不明。\n就像一只小虫在她心里微微振动翅膀，盘旋着向上飞舞，它尾部的萤光渺小、微弱，但极富生机。"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我似乎感觉到了什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "这些小家伙喜欢把卵产在水......什么，你感觉到了什么？！快说说！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我觉得——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然，女孩正欲吐露的剩下半句话被响彻夜空的爆炸声无情打断。\n那些聚集在两人周围的小虫也被传来的响动惊起，四散逃开，萤光几次闪烁，最终没入昏暗的树林。\n远处滚滚浓烟升起，将夜空中仅有的几颗稀疏星子遮蔽。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "糟了，是营地的方向！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "钝镝，等等！你还没有说完，告诉我，你感觉到的是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "别问了，我们得赶紧回去，现在不是说这些的时候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "这对我很重要，告诉我，求你了，我必须知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "说点什么，求你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "什么都没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我什么都没能感觉到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "对不起，它们飞走得太快，我没能抓住。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "不，你感觉到了，对吗？我知道，我能从你的表情看出来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "（慌乱地摇头）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "如果你什么都没有感觉到，那为什么、为什么你落泪了呢？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "（胡乱擦去眼泪）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我想，或许在我的心里，找不到可以让它扎根的土地。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "钝镝，你刚刚去哪里了？团长到处问你为什么不在场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我去林子里了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "大晚上你跑那么远干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "她在巡逻，她一直不是很放心前几天那些逃跑的目标。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "是、是的，我觉得他们有可能回到这里实行报复。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "你还真没猜错，就是那些家伙偷袭了营地，守夜的家伙因为睡着了没发现，被抹了脖子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "今天守夜的是小萨利？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "没错，他死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "这一把大火烧得，估计物资也剩不了几样了，忙活几个月，还得继续饿肚子，他妈的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "有受伤的人吗？伤情如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "好几个人烧伤了，但药品损失也很严重，看他们自己能不能撑过去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹雇佣兵",
      "text": "我先走了，建议你赶紧去找团长，不然他肯定会冲你发脾气。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "你该动身前去找你的团长了，钝镝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "你......还好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "明明遭受不幸的人是你，为什么反而要询问我的感受？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "你看起来很痛苦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "别担心，那不是因为你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "那是为了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "为了一片焦土，一片再无生机的焦土。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "夜深了，我先离开了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "好了，就送我到这里吧，接下来的路我自己一个人走就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "再一起走一段吧，以后就没什么再见的机会了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "这些天，我一直很想找个机会谢谢你，你教给我的很多东西，都令我受益匪浅。至于那个词......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "虽然我始终不能理解，但我相信有人可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "好了，这些不必再提了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "......抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "别道歉，这不是你的错，从来都不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "在遇到你之前，我见过很多孩子，就像你一样，颠沛流离，见惯鲜血与屠戮，从一处战场奔赴下一处，永不停歇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "但只有你，只有你放缓了脚步，为了我兜售的那些......知识。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "许多年来，我一直坚信，靠传授知识与文化可以改变糟糕的现状，抵御野蛮的侵袭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "现在看来，是战火胜利了，它将我所学的变成了滑稽无用的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "你要放弃了吗？如果你都不再坚持了，还有谁会去教授那些词汇的真正含义？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "如果没人能理解，没人会保存，它们会从我们的生活中彻底消失啊，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "那些词汇代表的美好转瞬即逝，这片土地唯有苦难永存。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "钝镝，我无力对抗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "可是、可是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "好了，别哭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "我把这本书给你，这些年我走遍卡兹戴尔，收集各地语料，一直想要完成它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "萨卡兹语词典？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "那个词我还没有收录进去，如果未来某一天有人让你理解了它，就代我把它写上去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "钝镝",
      "text": "好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹教师",
      "text": "把眼泪擦干，小姑娘，我们就此别过吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "老师？老师？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "哦，对，它指的是一个令人心生欢喜，悠闲宁静的夜晚。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "啊，原来是这样，我明白了！谢谢你，陨星老师！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（摸摸孩子的脑袋）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "不过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹孩童",
      "text": "不过陨星老师，你为什么在哭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "因为你很聪明。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
