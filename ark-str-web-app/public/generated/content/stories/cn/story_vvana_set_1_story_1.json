{
  "server": "cn",
  "storyId": "story_vvana_set_1_story_1",
  "groupId": "story_vvana_set_1",
  "stageId": null,
  "title": "不写诗的诗人",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_vvana_1_1.txt",
  "sourceHash": "f5026bbd5c48e204349b6670949d5e5fcadc7b9811ca535ad3157b075f3d3f3e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "技术人员",
      "text": "领航员先生，醒醒！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领航员",
      "text": "不是说了，现在这条航线没问题......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "技术人员",
      "text": "您得知情，先生。我们刚刚监测到一座陌生的移动地块......但我们的航线上理应没有其他移动地块。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "技术人员",
      "text": "我们联络过了，它自称“奥格尼斯科”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领航员",
      "text": "奥格尼斯科......不是固定城市吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领航员",
      "text": "那座移动地块的呼号，你们查过吗？合法吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "技术人员",
      "text": "合法的，先生，它登记在册的所有人是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "技术人员",
      "text": "玫瑰报业的麦基先生。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "又来啦，薇薇安娜。老样子对吧，面包要软的，香肠要墨角兰多一点的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "这么久了，您还记得这些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "谢谢。下次再来奥格尼斯科，我还会来找您买的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "我这家店快关门啦，可能下周就关。到时候你就得上别家买啦，不好意思啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "发生什么事了吗......？您愿意告诉我的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "没啥，就是我找到新工作了。还是开店，只不过是改卖些奇奇怪怪的小工艺品。不用我出本钱，还有人倒付我钱呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "其实这事还得谢谢你来着。自从那次一群记者扛着相机来找你之后，在咱奥格尼斯科能找到的工作就变多啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "没什么能答谢你的，要不今天就不收你钱了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "不必这样啦，您不亏欠我什么。反倒是我，还有事要问您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您知道这条街上还有哪家店，有您这样的手艺吗？我师傅确实很喜欢您家的口味。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "实在馋我这口，上我家来就是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "你师傅那边，我倒是更担心别的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "薇薇安娜，你照顾好她吧。虽然她这些日子给大家惹了不少麻烦，但谁也不想看到她真的出事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "毕竟我们很多家的炉子，都是她当年亲手砌的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "惹麻烦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "不是什么大事，她可能只是老了，太执拗，也太着急，才接受不了很多变化吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......嗯？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "热情的居民",
      "text": "薇薇安娜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "啊，没事，只是好像看到一位熟人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "奥格尼斯科最近，经常能见到穿西装的人吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "师傅，我回来了，饭放桌上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "说了多少遍，叫奥比娜就得了，不用那么尊敬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "铁呢，买了吗？饭随便，铁要紧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "买好了，不过要等您先把饭吃完，才能给您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "一旦让您把锻炉点起来，您恐怕直到明天早上都想不起来吃饭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "哈！我硬朗得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "“没有折不断的人，只有敲不断的铁”，这是您自己说的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我说过的话多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我还讲过“大草原上的第一位工匠，接住从天而坠的火，捧起生于大地的金铁，举起铁锤就是九个日夜”呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "相比之下，我算是怠惰的。怠惰可不行啊。怠惰的话，炉子里的火很快就熄了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "火钳在哪？帮我拿一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您这样是没法蒙混过关的哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "不过，您今天看起来倒是格外有精神，我很久没听您说过这么多话了。回来的路上我还担心您来着......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "......我今天话很多吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您一般只会说“火钳给我”四个字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "好吧，我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我只是想问问，你什么时候走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "明天一早。您直接问就好了呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "不留下吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "欸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "哪怕就多留几天、半个月呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "这间工坊可以挪到你名下，我们还是照常打铁。天花板我加高过了，你肯定不会再撞到角。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您竟然会......希望我留下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "师傅，我要走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "走就成，别落下东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "那我就现在和您道别了。明天的车太早，我就不叫醒您了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "你搞得好像小孩子出门前向妈妈请示似的。不用专门道别，只管走就成。你去哪，我不管。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "就算你是要去当大骑士长，也不用特地告诉我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我知道的，您不在意那些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "就像您也不在意我是谁，又从哪里来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "哈！你就是你，还能是谁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "谢谢您。这可能是我听过的，对我最好的评价。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "啥？我还没开始夸你呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "但你跟我打铁的时候确实挺好。你手够巧，心够静，是块好料子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "至于你在别处做什么，我管也没用。别死了就成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "不会的，师傅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我还会回来看您的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急切的记者",
      "text": "烛骑士小姐，你为什么决定离开奥格尼斯科，你接下来要去哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的记者",
      "text": "德罗斯特女士，关于公认将在散华骑士团里取代你的位置的月光骑士，她在春季赛的表现，你有什么看法？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "很抱歉，诸位，还有十分钟就要发车了......麻烦诸位容我前去赶车。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的记者",
      "text": "德罗斯特女士，你并没有回答问题......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急切的记者",
      "text": "烛骑士小姐，麻烦稍稍留步——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "拍什么拍？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "没见过人吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "你们要是那么会说话，倒是说说，薇薇安娜到底哪儿和别人那么不一样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "她要去哪，跟你们有什么关系？！赶紧滚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......谢谢您。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您竟然会......希望我留下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "啧。当我没说过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我肯定是睡昏了头......我得走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您去哪儿？东西我都买好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "你就别管了，薇薇安娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "也别跟上来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "你先把炉子烧起来吧，今天你想打件什么都行，明天一早该走就走。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......麦基先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您来这里做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我刚刚目送那位铁匠女士远去。很难想象，我会在一位佝偻的老人身上，看到如同骑士出征般的气势。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "很难不让我想起另一个过分坚定的人......另一个对您影响深远的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "奥比娜只是个普通的铁匠，她与您认识的任何人都毫无关联，她身上没有深入挖掘的价值。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "德罗斯特女士......您上一次这样强硬，还是在特锦赛上拒绝用特殊手段击败耀骑士的时候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "您刚被“安排”到奥格尼斯科时，我曾期望耀骑士能给您一些关照。但她毕竟有自己的路要走，很难真的来探望您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "得知您在奥格尼斯科遇到了一位能关照您的人，我只觉得欣慰......哪怕她只是个普通的铁匠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "奥比娜与耀骑士并无相仿之处，她对我的关照也与耀骑士无关。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "但她确实给了我一种我不曾体味过的......安宁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我能想象您有多么珍视这样的安宁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "所以，我才希望您知道，那位铁匠女士，还有奥格尼斯科，确实都展现出了“深入挖掘的价值”，哪怕您不愿这样认为。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......有关奥格尼斯科近来的变化，您知情多少？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "此刻正停靠在城外的几座微型移动平台属于辉煌盾工业，它们将被用于奥格尼斯科的改建。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "民房上那些彩色的灯带、树枝上那些塑料的假花，甚至街头巷尾的武器模型和骑士徽记......都出自辉煌盾之手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "还有那些在玻璃橱窗后面，用橡胶锤子假装打铁的人......他们的“工资”也来自辉煌盾，是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "以及辉煌盾的合作伙伴，是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "散华这样的大骑士团，已经习惯了为主推的骑士定制主题词、印象曲、发言风格、作战方式、着装方案、背景故事、思想定位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "一位竞技骑士能在赛场上挥剑的时间终究还是太短，不论如何敬业，他都做不到完全填补粉丝们精神需求的空缺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "但他的主题展览和印象曲演奏会，他的自白节目和著作发行会，却可以做到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "所以，辉煌盾这样的武器制造商，也想为他们的产品赋予一种性格、一套故事，用来“填补粉丝们精神需求的空缺”......是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "而奥格尼斯科就是他们为此选出的背景板？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "古老的林荫与匠人之都，传承着起源自蛮荒时代的锻造传说。还有比它更合适的选择吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "它可以成为一座巨大的摄影棚，就由当地居民作演员，上演传奇的锻造故事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "匠人们不必在火炉前弯腰屈背地操劳就能有可观的收入，辉煌盾也会获得仿佛出自传说的“神兵利器”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "......至少本该如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "奥比娜......也被要求参加这样的“表演”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我不知道。但一位将终生都奉献给锻造工艺的老铁匠，还与您有着千丝万缕的联系......还有比她更合适的人选吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "如果是对她，我恐怕......他们的手段不会太温和。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "如果那位女士确如我想象中那般执拗，那么以辉煌盾的行事风格，她很可能已经得到了过分强硬的回应。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "假如事实如此，我也会为之感到愤怒。这说明辉煌盾做事还是太欠考虑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我必须去找她......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "等等，德罗斯特女士......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "忧虑的铁匠",
      "text": "奥比娜，算了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "怎么？你难道愿意被关在玻璃橱窗里，陪他们演戏？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "女士，您知道这毫无意义。今天被您砸碎的玻璃，明天就会重新装好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "您需要赔偿的金额，已经超过了您的承受能力。不论您多么用力，砸毁的都只会是自己的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "除非您签署这份协议，赔偿金额我们后续会从您的薪资中扣除。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我砸毁我自己的生活？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "难道是我自己拿着一沓什么*卡西米尔粗口*“协议”，要求我自己关掉工坊，去玻璃橱窗里拿橡皮锤假装打铁的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忧虑的铁匠",
      "text": "奥比娜，你知道，有些年轻学徒也不是真的喜欢打铁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忧虑的铁匠",
      "text": "就算是我们这些老家伙，也不是所有人都像你似的，身子骨硬朗。我都不知道自己再过两年还能不能举得起真正的铁锤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忧虑的铁匠",
      "text": "我们总得有条出路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "大草原上还没有城堡的时候，奥格尼斯科的匠人就已经拿起铁锤了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "你忘了“奥格尼斯科”这个名字是什么意思吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忧虑的铁匠",
      "text": "“火炉”。我没忘，奥比娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "那你该清楚，锻造就是我们的出路。过去是，以后也得是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "抱歉打断二位，但市政府正在推进这座城市的改名事宜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "等辉煌盾的意象学专家团队从总部赶来，这座城市就会得到一个更符合时代需求的新名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "你——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "哇啊——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "咳......摄像老师，刚刚这段拍到了吧......请剪掉我的反应，只留下奥比娜女士对我挥锤的画面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "女士，允许您签署协议之后通过扣除薪资来支付赔偿金额，是我们为您提供的特惠条款，并不是我们的基本行事准则。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "我们也可以立刻报警，以最正当的方式处理这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "但我相信比起牢狱，您还是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您还是更愿意停下争执，给自己留些欣赏奥格尼斯科美景的时间——在这些美景毁于贵司的工程术师之前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "在贵司的各个专家团队抵达之前，您在此不论如何奋力表现，都不会被上级看到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "终于出现了，烛骑士！摄像老师麻烦镜头拉近给个特写。布景术师，放两架无人机谢谢，这一段需要多机位......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "“画面是黑的”是什么意思？你镜头盖取下来了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "烛骑士小姐......您的源石技艺......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "贵司的总部我有幸参观过，大大小小的每一间会客室，都有厚重的遮光窗帘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您一定比我更清楚，并不是所有场合都适合暴露在明光之下，被人审视、被人观赏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "烛骑士小姐，希望您能理解，我是在维护我司的合法权益。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "贵司蒙受的损失会得到合理的赔偿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "感谢您的理解，那么或许您可以听听我司的规划......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "改日吧，发言人先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "奥比娜，我们走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "薇薇安娜，我说了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "别跟上来......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "抱歉。您从不多过问我的事情，照理说，我也不应太过关注您的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "只是，您此刻的处境，并非与我无关。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......您脚软了。来，我扶您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "辉煌盾发言人",
      "text": "愣着干什么？没有备用相机吗？追上去拍啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "你们今天得到的素材，还不够编撰三四天的头条故事吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "止步吧，先生们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "在你们相机的感光元件烧毁之前。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "所以您才希望我留下对吗，奥比娜？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您希望我帮您保护好这间工坊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "愿火星灼烧我的嘴。薇薇安娜，我不该说什么要你留下的话，也不该急着在你走之前就跑去砸他们的场子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我还是老了，软得像块烧过了头的熟铁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "帮您保护这间工坊，和帮您采买材料，并没有什么区别。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "直接和我说也没关系的，您不必将之归为软弱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "不，薇薇安娜......我本来根本没想找你帮忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "能试的办法我都试了。但你看到了，就连砸他们的场子也没用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "多一个人帮忙又能怎样？他们可是几百上千个人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "但、但......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "有人告诉我你是贵族、是骑士，你一个人说话就顶几百上千个人说话。有人告诉我，只要这间工坊归你，就没人敢动它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我实在没办法了。对不起，薇薇安娜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "帮帮我吧，烛骑士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "烛骑士。有多少人这样称呼过她？\n薇薇安娜数不清。她听到这个封号会转过头来，行礼，应答，就如同电灯理所应当地要在开关被拨动时亮起。\n一种本能的麻木，一种麻木的本能。\n但此时此刻，奥比娜低声下气地叫出这个封号，却令薇薇安娜脊背发凉。"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我不会别的道歉的话了，但我希望你知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我确实对不起你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我会想办法，我向您承诺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "只是，我不明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我无论如何也不明白......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "为什么感到愧疚的是您？不论朋友还是师徒之间，需要借对方身份办事的情况，再常见不过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您遇到这样的难处，我本就难辞其咎，如果不是我给奥格尼斯科引来了过多的关注......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您当初好心收我做学徒，我一直以来无以为报，到头来反倒连累您受到这般刁难。如果有谁要感到愧疚，那也应该是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "这不一样，薇薇安娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "但算了。你愿意帮忙，就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "起码你下次回来的时候，还有这间工坊能待......要是你以后还有理由回来的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......要我帮您把炉子点起来吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "不用了。我今天不打铁了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薇薇安娜突然觉得，奥格尼斯科变得很安静。\n以往这个时候，全城都回荡着金铁的交响，奥比娜会随着敲击的节奏，嘹亮地唱起没什么含义的调子。这样的喧闹让她感到安心。\n但此刻，除了偶尔有草木的窸窣，她什么也没听到。\n是因为整条街上的工匠都已经同意了关停工坊吗？可为什么就连羽兽也沉默不鸣？\n忽然，远远地，薇薇安娜听到一个熟悉的声音，清晰可辨——\n“辉煌盾军工产品，助您战胜荒野，斥退天灾！”"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "“尊敬的执行负责人，扎贾克先生，有关奥格尼斯科的改建事宜......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "您答应了帮助那位铁匠女士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "那么，谁来帮您呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......您说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "您当初严词拒绝用特殊手段击败耀骑士的时候，绝不像现在这般忧郁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我所认识的薇薇安娜·德罗斯特，在决心做出一些小小反抗的时候，眼里是有光彩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您对这些细微的情绪还是如此敏感，麦基先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "若不是偌大的玫瑰报业旗下早已没有任何刊物收录诗歌，您或许真的可以成为一位诗人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "不敢当。是您让我理解了诗歌的价值，我应该为此道谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "而我也应该为您的关照向您道谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我没有大碍，只是还有些事没能理解。现在，我需要先写完手上这封信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "您本不必亲自下场与他们斡旋......我们本可以一同保下这间工坊，甚至整个奥格尼斯科。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "辉煌盾的目光终归稍显短浅。不用多久，人们就会不耐烦地发问，为什么所有神兵利器的故事都出自同一座城市？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "到那时，一座昙花一现又归于遗忘的城市，只会比未经开发的乡镇更灰暗、更贫苦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "您比辉煌盾的考察员更懂得欣赏奥格尼斯科的美，而美是长久的......只要您将它传递出去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "您说自己在大骑士领写不出诗，但奥格尼斯科本就是自由的故乡、诗人的土地，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "如果您能写出一首有关奥格尼斯科的诗，我们就可以让这里得到另一种形式的开发。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "到时候，没有人需要被迫改变生活方式，但所有人的生活质量都会得到提升。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "可您为何要这样做呢？您来到这座城市才不过两天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "但您在这座城市真真切切地生活过，也在这里找到了自己不曾体味过的安宁，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我以为这已经是再充分不过的理由了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "仅仅因为，它是我的安心之所？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "当然，德罗斯特女士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "大多数因故被骑士团“安排”到边远城市“休养”的骑士，可不会对那些边远城市有丝毫眷恋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "而您三番五次地到奥格尼斯科故地重游，除了它是您的安心之所，难道还有其他理由？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "“我的安心之所”......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "“自由的故乡”。"
    },
    {
      "type": "dialogue",
      "speakerName": "忧虑的铁匠",
      "text": "我们总得有条出路。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "“诗人的土地”。"
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "那你该清楚，锻造就是我们的出路。过去是，以后也得是。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "“薇薇安娜的安心之所”。"
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我实在没办法了。帮帮我吧，烛骑士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我确实对不起你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "薇薇安娜的安心之所，就只是薇薇安娜一个人的安心之所，对吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "只是因为我喜欢这里的林荫和羽鸣、这里的炉火和铁花，只是因为......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我喜欢这里的人不在乎我的出身、我的地位，不在乎我从哪里来、到哪里去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您清楚这一点，奥比娜也清楚这一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "所以您才会提出要“为我”保下奥格尼斯科，所以奥比娜才会在请我帮忙时显得那样愧疚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "她害怕自己叫出“烛骑士”那个封号，就等于摧毁了我的安心之所。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "她耻于因自己的无力，而毁掉我对她的期待。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "哪怕她所面临的困境，本就是由我造成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "即便您从没来过奥格尼斯科，现在发生在这里的一切，也依然会发生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "麦基......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我很感谢您的好意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "但恕我无法接受您的提案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "奥比娜的变化，只会是我的责任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "她以为简单地向我求助，就会摧毁她对我的全部价值。她以此为耻，因而折磨自己的身心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "......仿佛她不是我的师傅或友人，而只是一件用于让我安心的工具。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "倘若真是如此，那么我的诗又与辉煌盾的摄影棚何异呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "麦基，如果我的诗是这样......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "那我不愿为奥格尼斯科写诗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "薇薇安娜的诗，从此只在她自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "您的坚持还是这样......出人意料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我本来还以为，几年过去，我终于能稍稍理解您了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您已经理解我了，麦基。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "您不理解的是奥比娜。虽然，我也只是在刚刚，才太迟地开始理解她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "......呵。您的想法也是会变的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "简直像是在追逐地平线，我迈进一步，它就后退一分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我的想法大多太过天真，从来都不值得如此追逐。我只害怕您会重蹈奥比娜的覆辙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我或许只是想要某种“救赎”吧，德罗斯特女士。我始终觉得自己在下沉，哪怕玫瑰报业的市值在一路攀升。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "如果您仍渴望从我身上得到什么可以充作“救赎”的回应......就请借我您的名字一用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我的名字？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "我在卡西米尔的财产，大多已经冻结在了散华骑士团名下。余下的部分合计下来，或许还足够买下一座微型移动平台。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "如果您愿意相助，或许以您的名义收购会更为稳妥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "您要一座移动平台做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "带走奥格尼斯科。或者说，带走那些还愿意把奥格尼斯科视作一座“火炉”的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "......我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇薇安娜",
      "text": "那么走吧。生在大草原上的“火炉”，就要重新回到草原。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "都在这了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的铁匠",
      "text": "都在了，不愿意去演那出烂戏，还想好好打铁的人，都在这了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "好！那奥格尼斯科就没有完蛋，大草原上的“火炉”就没有熄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "麦基师傅！我们要启航了，你没问题吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在移动平台的甲板上，麦基望向远方的荒野。\n一抹若隐若现的烛火在黑暗中摇曳。在它的映衬下，薇薇安娜随风飘荡的绿色披肩像一个幽灵。\n至少，如果让他写一首诗，他会如此描述。"
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "她还是走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "她会回来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "她那身衣服......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "她在奥格尼斯科常住的时候，我找人给她做的。骑士的装束总归不是用来过日子的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "我以为她会割舍与奥格尼斯科有关的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "她走之前特地问我，以前在工坊里一起打铁的日子，我是否真切地觉得开心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "我是开心的，我当然开心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "她说，她也是。她说，那就够了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥比娜",
      "text": "然后，她叫我拿出那身衣服，帮她换上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦基",
      "text": "“薇薇安娜的诗，从此只在她自己”，是吗......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
