{
  "server": "cn",
  "storyId": "story_erato_set_1_story_1",
  "groupId": "story_erato_set_1",
  "stageId": null,
  "title": "英雄们的叙事诗",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_erato_1_1.txt",
  "sourceHash": "a7375ae12e4f28ff50a63c63cba59a9113436fe8b62d1bbb914b7d070024479c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "咕咚，咕咚——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "哈，美酒的芬芳，真令人陶醉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "开门，埃拉托小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托——你把自己关在里面也想不出来的，我建议你放弃。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "酗酒祭司，你太吵了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "我是关心你，埃拉托小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "昨夜我徜徉美酒之时，偶然听到干员们的交谈，听闻你将自己关在宿舍里两天两夜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "身为祭司，我自然牵挂着你的情况。你看，清晨的日光才刚刚铺满窗沿，我就前来探望你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "探望我......你手上拎着的是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "佳酿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "米诺斯的群山啊，可否赐予我不被酒品奇差之人骚扰的恩泽？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "你尚有讽刺的力气，新诗篇的创作一定很顺利吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......你怎么知道我正在创作一部新的诗篇？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "来到罗德岛之后，你已经游手好闲够久了......准备写点什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "一部长篇诗歌，讲述几位所长不同、性格各异的英雄，合力带领备受压迫的人们战胜困难，共同前往希望之地......大概是这样的故事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "然而在开始动笔时，我还是遇上阻碍了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "一字未动？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "胡说，我......至少写上了标题！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "在故事前期，我设想了三位英雄，分别是善战的勇士、天才的工匠和仁爱的医生......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "可由于搁笔太久，我对角色的理解已经生疏了，构思的故事缺乏真实感，角色形象难以建立......我需要更多的灵感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "不如就像我们在故乡那样，一边痛饮美酒，一边畅叙诸山之间的英雄传说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "酣醉之时，灵感便如树上熟透的果实一般任你采摘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "请不要为你带酒上门找理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "翻阅典籍，或是外出采风？米诺斯的诗人们善用这些方法，你应当比我更清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "当然，我这不就准备出发去寻找英雄事迹了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "说起英雄事迹，除我们的故乡外，维多利亚与卡西米尔应该是合适的采风地，或许还有其他的选择。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "不会跑这么远，我已经想好要去哪些地方了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "闲聊还是下次吧，我得抓紧时间了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "请留步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "还有事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托小姐如何创作诗篇，我一直对此非常感兴趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "这是一次难逢的机会，若我想与你同行，你应该不会拒绝吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "跟上我。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "这里就是我计划的第一站。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "出乎意料，埃拉托小姐，原来你就没有计划离开罗德岛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "当然啦，在本舰上就足够我寻找灵感了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "说起善战的勇士，那必定是在训练室最容易遇上了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "是我们来太早了吗？似乎没有人在......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哈，这拳如何？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "有人在说话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我也听到了——你好？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "尝尝这拳！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "啊，是燧石小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你是帕拉斯，还有你，你是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你个子不高，也很少来训练场打架，我不记得你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我叫埃拉托，大部分时间都在出外勤任务，我们确实只有几面之缘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "好，你们好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "对了，埃拉托，要来打架吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "欸！怎么突然——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你不想打架，那算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "抱歉，我不擅长近身格斗，射箭的话倒是可以比试一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "没关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "（转向沙袋）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哈！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "等待一下吧，这个时间，再过一会儿就会有其他干员前来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "虽然过去就听过燧石小姐很厉害，但战斗姿态的燧石小姐我还是第一次见到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "这矫健的身姿，凌厉的拳风......啊，这不就是我在寻找的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "燧石小姐，不，能征善战的勇士啊！你的经历一定非同凡响，我想要了解你的英雄事迹，能与我分享一二吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "英雄？我没见过什么英雄，你说的我听不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "你要这些什么......事迹有用吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我正在寻找能给予我灵感的英雄事迹，为了帮助我创作出一部伟大的诗篇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哦，明白了，你是想要灵感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "那你过来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "过来，站这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "这是沙袋，揍它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "啊......这样吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "力气太小了，使点劲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "这样？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "还不够，再用力。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "哈！疼疼疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "对，就是这样，你感觉到什么了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "还有呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "没了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "不可能，你没有感受到灵感吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "完全没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "真奇怪，我打拳的时候就会有很多灵感，比如说会突然想到，下一次可以佯攻面门而直击下盘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "任何麻烦应该都能用拳头来解决，我想想，应该是你打得太少了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "来，再多打几拳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "先停一停......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "后勤干员",
      "text": "燧石，燧石，你在里面吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我在这里。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "后勤干员",
      "text": "啊，埃拉托，帕拉斯，两位也在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后勤干员",
      "text": "燧石，这是上一次外勤任务的赔偿清单，你好好看看。为了处理你出外勤留下的麻烦，后勤部又多了一大笔支出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后勤干员",
      "text": "特别是这一项，你在任务报告中写的是：“因为那个高个子的家伙眼神凶恶地俯视我，我就把他打倒了。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后勤干员",
      "text": "你何止是把他打倒了，他可是痛得满地打滚，足足撞烂了两扇门！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "不可能，我明明收了力的。你看，我就是这么打了两下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后勤干员",
      "text": "总之，以后出外勤任务，千万要注意不要破坏公物，要是再有下次——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "沙袋......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "被一拳打爆了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "对不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后勤干员",
      "text": "唉，算了。燧石，这个给你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "这是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "后勤干员",
      "text": "上次外勤任务中，你救下的那个女孩寄给你的感谢信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "哦，好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "（把信塞进拳套里）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燧石",
      "text": "我去换个新沙袋。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我们走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "果然，埃拉托小姐，我的选择没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "与你同行实在尽兴，甚至胜过在舰桥上自斟自饮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "是你们祭司都这样说话，还是只有你这么无聊，“胜利女神”小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "你知道，我是独一无二的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "下个地方到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "罗德岛上有不少厉害的工程师，在这里一定能找到——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "嘿！帕拉斯，埃拉托，两位，早上好啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "你好，贾维，这里只有你在吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "刚刚奥斯塔还在呢？欸，他去哪里了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "奥斯塔，你在哪儿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "等等，不用麻烦叫他出来啦，我就问你好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我记得你......应该还挺擅长机械设计吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "那当然了，小爷我的改装技术可是一等一的，称之为天才也不为过！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "太好了，我有个问题想问你，你有没有觉得自己有过什么英雄事迹......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "喏，帮我拿着这个。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "这是......液压钳？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "你不是问我的改装技术吗？我学修车的时候师傅曾经说过，嘴上吹得再好听，都不如亲手做一遍来得实在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "不是，我是想询问英雄......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "拿好了，我这就给你演示一下。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "演示什么......\n啊啊啊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "它怎么、怎么飞起来了？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "怎么样？这就是我的最新作品，自悬浮液压钳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "小爷我在这里工作，经常要对付一些大型设备，每次都要带着工具爬梯子实在是太麻烦了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "现在，只要抓住经过我改装的这套工具，身体就能跟着飘起来！去再高的地方都不用搬梯子了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "抓稳了！它还能飘得更高！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "欸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "它、它在震动，这正常吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "震动......我记得我没装转子电机啊？等等，我到底装了没有......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "它开始乱晃了！我抓不住了，要放手了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "小心！液压钳朝你飞过去了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "什么——\n哎哟！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "痛，痛，我的脑袋......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "为什么会出现这种故障呢？奇怪，是不是喷气引擎功率太大了？算了，一会儿再说吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "你刚刚是不是问我，我有没有什么英雄事迹？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "小爷我必须自豪地告诉你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "没有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "这个回答倒是意外。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "这是因为，我的心血全部献给了我改装的这些机械设备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "它们才是真正的英雄，代替我成就了许多前无古人的壮举！我的改装才是应该被所有人铭记的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "至于我......我发明了它们，那我就应该算是......嗯......“英雄创造者”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "啧，这个称号还不赖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥斯塔",
      "text": "“英雄创造者”？嘁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "奥斯塔！你那声“嘁”是什么意思？你不认可我吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥斯塔",
      "text": "你的英雄们是指会唱歌的电钻，还是会跳舞的扳手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥斯塔",
      "text": "哦，现在又多了一个会飞行的液压钳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "不，奥斯塔，你怎么能这么贬低你的头儿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥斯塔",
      "text": "根据我的统计，你上一次收到改装的需求，还是......三个月前？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "你好好回忆一下，我一定还有做得很好的改装吧！一定有吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥斯塔",
      "text": "承认吧，贾维，你已经没救了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "欸，桌子上的这个头盔......我似乎在前不久的一次外勤任务中见过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "当时那位重装干员非常气愤地说：“我只是想修一下护目镜，那家伙竟然给我加了一大堆乱七八糟的功能！”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "然而在任务中，小队遭遇意料之外的源石污染。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "在未携带专业源石探测装备的情况下，头盔的源石探测功能起了作用，帮助小队渡过了危机。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "奥斯塔，你听见了吗？我还是有能帮上忙的地方！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥斯塔",
      "text": "嘁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥斯塔",
      "text": "那这个头盔为什么被送了回来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我记得，在任务的后半程头盔漏电了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "不论如何，我是不会放弃发挥我的创意的，我的天赋绝不能被掩埋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "总有一天，小爷我也配得上堂堂正正的英雄之名，而不是什么，“英雄创造者”之类的。奥斯塔，你就等着瞧好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "哦，差点忘了你们还在了。抱歉啊，埃拉托，没给你你要的英雄事迹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "没关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "但是我想到了，你们想要询问英雄事迹的话，我有一个人选。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "是哪位？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "那就是小爷我的挚友，Lancet-2！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "她最近格外消极啊，明明工作非常努力的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "不过她是不是一直都很消极......如果你们可以向她了解一些她的英雄事迹，说不定她就能开心一点！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "好，我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贾维",
      "text": "有空常来玩啊，有想要改装的玩意也尽管找我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托小姐，你真的打算听贾维的建议吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "当然啦，在我的计划里，要去的最后一个地方恰好也是医疗室。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "这趟“旅程”至今，原谅我用了传统的“旅程”一词，你觉得会对你的创作有所帮助吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "在过去我收集了许多传说与故事，为了将它们完好地保存下来，我会努力把自己当作一个忠实的记录者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "不在记录中掺杂主观的情绪与思考，让故事能保持它原本的样貌，这是我的诀窍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "当旅途告一段落时，那些我所见证的，所听闻的，所记录的，最终会在几个夜晚沉淀下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "而后，在笔下流淌为诗歌，以我之口向众生诉说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "这趟“旅程”还未结束，所以我不知道最后会有怎样的结果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "记录、创作与传颂，你让自己肩负了远超一名吟游诗人的责任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我想我热衷于此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "这是你的自由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......我有一种预感，这次的所见所闻会给我的创作带来些许不同。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "先前我只是好奇你的创作过程，现在你会写出怎样的诗篇，我也很有兴趣了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "该怎么办，该怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "Lancet-2，你好......你在干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "两位好，根据我的运动模块显示的状态，我在转圈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "我看得出来，可是，你为什么要转圈呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "博士，因为博士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "博士他出什么状况了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "不对，是因为我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "是因为无能的、没有作用的、什么都做不好的我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "等等，咱们好好说清楚可以吗？究竟是发生了什么事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "帕拉斯，你说我这样拍两下，Lancet-2能正常说话吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "可以试试。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "语言模块自检中——自检完毕，恢复运行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "原因是，博士他最近实在太忙了，每天都要处理好多文件，直到凌晨才能上床休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "这样下去，下一次博士的体检结果一定会出现异常指标的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "都是我不好，没有照顾好博士，都怪我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "停停。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "Lancet-2，博士有他的职责，他的工作对我们所有人都非常重要，偶尔有忙碌的时候也是正常状况哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "你不应该把这样的情况怪罪在自己的头上，你也在很努力地工作啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "真的吗？埃拉托干员，你真的是这么认为的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "当然啦，我这次前来就是想找你帮忙的。请问你有什么可以分享给我的英雄事迹吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "英雄事迹......在看护的时候我有听见干员们的闲聊，在我的存储模块中应该保存有一些事件。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "不不不，不需要那些。我想要了解的是，你觉得自己做得好的，像英雄一样的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "Lancet-2的工作那么出色，这样的事情一定不少吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "我的英雄事迹......不，我应该没有足以称之为英雄事迹的行为，我连英雄都称不上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "在我的岗位上，能把所有干员都照顾得很好，让大家都保持健康，才能被称为英雄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "而我没有这样的事迹，我照顾不好博士......我是不是根本就不称职......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "她真的很消极。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "好啦好啦，Lancet-2，要不这样，请你也照看我一下？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "照顾埃拉托干员吗？这的确在我的工作范围内，但是......你让我这么做有什么理由吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "这样我就会告诉你，你做得到底好不好，或许Lancet-2就能体会到自己也是很有用的呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "明白了，我马上对埃拉托干员进行全身生理检测，请稍等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "好哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "检测——完成。检测结果显示，埃拉托干员有27小时13分钟27秒没有进入过睡眠状态，身体严重缺乏休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "......埃拉托干员在数小时前摄入了大量糖分，以及脂肪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "帕拉斯",
      "text": "埃拉托小姐，你上次可是口口声声说要减肥的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "......这是为了构思，为了构思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "怎么会这样？我竟然没有及时发现埃拉托干员的异常......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "你一进来我就该发现的，可是我忙于处理自己的情绪模块，没有照看好你......我太不称职了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "埃拉托",
      "text": "没有，这不是你的问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "果然，我什么作用都起不了，我就该自己驶向报废区域的......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "埃拉托，帕拉斯，你们好。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "埃拉托，帕拉斯，你们也在这里啊。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "埃拉托&帕拉斯",
          "text": "博士好。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Lancet-2，我来体检了......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你看起来状态不太好，有什么心事吗？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "博士......对不起，我没有照顾好你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "多亏Lancet-2的帮助，我的体检结果一直正常。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "欸，竟然是这样的吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "短暂的时间内，你完成了体检的全部内容。"
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "体检结果出来了，各项数据指标——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "一切正常。太好了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我都说了，不用担心。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "完全没有担心的必要。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "（减少了博士的咖啡配给，果然还是有用的。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "Lancet-2的工作真的很出色啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "埃拉托，你还好吗？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "啊，抱歉，我刚刚只是在思考......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "博士，我有点事，先离开了！再见！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "好，再见。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "一周后"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "贾维",
          "text": "原来不止小爷我，大家都收到邀请了啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "燧石",
          "text": "“诗篇吟诵会”邀请，我不懂，什么是诗篇？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "是一种用凝练语言叙述事件或表达情绪的文学体裁，听众能从诗篇的吟诵中收获精神的力量。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "这次是埃拉托最新作品的第一次公开朗诵，预计会对干员们的心理健康带来积极的影响。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "埃拉托的新诗篇吗......我还挺期待的。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "咳、咳。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "（虽说给大家都发了邀请，可没想到竟然来了这么多人......）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "感谢大家参加我的新诗篇吟诵会，愿大家在此度过一段惬意的时光。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "好了，话不多说，下面我将为大家吟诵的是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "（深呼吸）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "（啊，好紧张，上一次在这么多人面前吟诵新诗，还是好多年前在科林尼亚的城市广场......）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "贾维",
          "text": "埃拉托！埃拉托！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "咳咳，下面，我将为大家吟诵的是，我最新创作的诗篇——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "《英雄们的叙事诗》。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "......"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "伴随着竖琴声与埃拉托轻缓的吟诵，三位英雄的故事被娓娓道来。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "黎明掀开她的面纱，太阳的光辉洒向大地，拂过灰尘遮蔽的脸庞。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "远方飘来芬芳，人们拾起行囊，将继续踏上道路。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "谢谢大家，谢谢。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "诗篇吟诵会告一段落，大家恋恋不舍地离去。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "喂，帕拉斯，之前我就把诗篇读给你听了，过去了两三天，你还没有什么想法吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕拉斯",
          "text": "如果我没听错，这只是诗篇的第一节。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "没错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕拉斯",
          "text": "我必须承认，诗篇很有你的风格，但在你的诗篇完成之前，我决定不予评价。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "能让喋喋不休的帕拉斯把评价吞进肚子里，应该还不错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕拉斯",
          "text": "比起和你拌嘴，我更想知道你打算如何完成诗篇后续的创作。上一次收集到的素材应该不足以支撑后续写作吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "是的，所以现在我的确没有更多的灵感，只有一个我一直都很喜欢的构想。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "我要创作一个以我自己为原型的角色，在故事中与英雄们一起，同行至鲜花盛开的理想之地。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕拉斯",
          "text": "米诺斯人都曾梦想过与英雄同行，我理解。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "不......和过去不一样，你应该记得我和你说过，这一次的创作会有所不同。可我创作的诗篇和过去相比并没有改变。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "在写作时我一直思索这个预感从何而来，直到放下笔的刹那，我忽然明白，那份不同或许早已发生在我的身旁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "过去的旅途中，我将自己写进故事，成为故事中的角色，期待着凝结心血的创作能引导与鼓舞人们。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "但身处此地，第一次认真地观察过罗德岛上的大家后，我发现......我的诗意产生了前所未有的共鸣......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "我想我已经置身于英雄之间，正与英雄们同行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃拉托",
          "text": "我应当将其记叙。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
