  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "已净空！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "好的，警戒交给你了！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "亚历山大，看看躺在地上的雇佣兵还有没有人活着！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "马上就办。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "蒂娜，把绷带拿来。我们清点人数，给伤员包扎一下。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerToken": "char_458_rfrost_1#3",
      "operatorId": "char_458_rfrost",
      "portraitKey": "char_458_rfrost",
      "text": "好！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "别装死！！"
    },
    {
      "type": "dialogue",
      "speakerName": "雇佣兵",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "等等，把......把铳口移开！我什么都说！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "库兹，把他绑起来。"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerToken": "char_457_blitz_1#6",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "好的。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "医生呢？米亚罗医生！"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "在这里！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......咳......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "蒂娜！绷带！快！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "保持清醒！小伙子，不要闭上眼睛！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "为什么......发生什么事了？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "强行使用源石技艺......源石感染扩散了......"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "罗德岛没有办法吗？你们不是最擅长这个吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "失血、灼伤、矿石病剧烈发作，就算是在罗德岛本舰......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......咳......"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "撑住，小伙子。"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......坚持住，你不是还想远游他乡吗？想想你梦中的哥伦比亚。"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......坚持住！"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "咳咳......咳......"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......咳......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#4",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "......医生......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "speakerToken": "char_458_rfrost_1#3",
      "operatorId": "char_458_rfrost",
      "portraitKey": "char_458_rfrost",
      "text": "......他走了。"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "......抱歉，我没能......"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#4",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "不......不是你的错。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "雇佣兵",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "......不......这和我没关系，我不是负责的！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "*俄语粗口*，今天你别想活着出去。"
    },
    {
      "type": "dialogue",
      "speakerName": "雇佣兵",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "......我只是......别......"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "你完了，*俄语粗口*，你死定了。"
    },
    {
      "type": "dialogue",
      "speakerName": "雇佣兵",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "别！别打我！不是我干的！别！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "亚历山大！别这样！冷静点！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "那个卫兵队长去哪儿了？就那位领主之女？"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "她追着逃走的人跑出去了，巡林者跟着她一起过去了，别担心。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "等等......医生身上的结晶......在发光？"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "这？！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "这么快？为什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "！！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "别管这个了！找个房间！"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "你们要做什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "来不及解释了！动作快！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "找布料来！窗帘、床单，什么都可以！"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "把医生抬到那边的小屋子里！快！"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "发生什么事了？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#9",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "医生怎么了？为什么......"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "科，科恩小姐，请您冷静一下，芙兰卡已经在处理医生的——"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#9",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "处理？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#9",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "处理什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你们没有见过吗？我可能要之后再来解释——"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "堵住门窗！不要留出缝隙！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "烟囱！把烟囱也堵住！还有通风口！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "这是......这是在做什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "不清楚？医生的尸体......出什么问题了？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "别去看。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "为什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "别去看......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "上面堵死了！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "门窗堵死了！没问题。"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "等等，屋子里亮起来了？窗户在发光？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "科恩小姐！别靠近！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "别看......"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "到底发生什么事了？"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "医生他......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "speakerToken": "char_456_ash_1#3",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "啊......"
    },
    {
      "type": "sceneBreak"
    }
  ],
