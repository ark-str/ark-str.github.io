{
  "server": "cn",
  "storyId": "main_4_level_main_04-08_beg",
  "groupId": "main_4",
  "stageId": "main_04-08",
  "title": "应激反应",
  "storyCode": "4-8",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-08_beg.txt",
  "sourceHash": "be6e88616e3be3f64c33224310a0495bf96f3ba638313529bde9db41ea88280d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这里是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们已经很接近霜叶给出的坐标了，但......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这股味道有些恶心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "难道是焦臭味......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "整合运动把我们引到了什么地方？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "啧！小心偷袭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "可恶！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "没，没打中吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "没关系，我们这里是安全的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你，你怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "咕，咕......啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "他没机会回答你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "什，什么！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是在那座建筑里吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "等等......那个难道是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "霜叶！霜叶，是你吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "是我。敌人我解决掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "抱歉让你担心了，阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "你受伤了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "医生，快来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......怎么会？你身上的，也是冻伤？你们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "没关系，是小伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "陨星和杰西卡还在广场那......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "暂时还不要紧，但继续拖下去就很难说了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我把敌人引了出来，整合运动还没发现她们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "敌人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我们现在的位置还比较隐蔽，不用太担心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "但他们马上就要来了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "小狐狸，你躲到那里去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "快出来吧，捉迷藏要结束了哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你每多藏一分钟，我就会折断你同伴一根手指——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "就算这样，你也还是要逃跑吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "（梅菲斯特——！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（他在虚张声势。别激动。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "（他在做什么......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "整合运动转移了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那个家伙......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们需要先联系陨星她们——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们明明已经跨过了污染地带，为什么通讯依然接不通？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "看看这个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这是你的通讯器？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "怎么会结冰了？难道是被......冻坏了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "梅菲斯特只是个添头而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "这座废城里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "徘徊着更可怕的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "可怕的东西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "雪怪们。撞上他们，事情就难办了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "雪怪，是说那个雪怪小队吗？他们究竟是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "这点时间，很难讲的清。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "但整个区域的低温，以及各个小队的遭遇......都是这些家伙的杰作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "整合运动的这支队伍，似乎在废城中划下了自己的地盘呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "天色暗下来了，这是个好机会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们可以更加隐蔽的通过这片开阔地带。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "走吧，先去救出陨星她们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我来带路。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "广场上这些......看不太清。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是什么......雕塑吗？好奇怪的样子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这股味道也令人作呕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "这边，别走散了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "那些东西......别去看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "——有敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "悄无声息的干掉吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
