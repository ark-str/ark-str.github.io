  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "哈，哈......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "咿——！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "碎骨，没事吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "嘁，这帮家伙确实很棘手！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "碎骨，W在通讯里说，她那边已经结束了！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "已经成功劫到了任务目标。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "......W她，得手了？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "是的，她的袭击非常顺利！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "是不是，我们也该撤退了？"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "给塔露拉发送信号。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "明白！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "......撤退。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "哼，罗德岛的懦夫......"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "下次见面就是死期了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——整合运动——撤退了？"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "撤退非常迅速，应该是事先策划好的。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "嘴上放狠话，跑得倒是很快啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "情况有些......不对劲。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "你是说——"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "指出整合运动的目标可能不是罗德岛",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "——！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "整合运动确实可能，只是在拖延我们的脚步......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "这样一来......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "糟了，近卫局有危险！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "......我们应该立刻去支援陈长官！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "芙兰卡，立刻召回侦察小队！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "雷蛇，尝试联系陈长官！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "speakerId": "char_010_chen",
          "text": "特别督察组的主力部队呢！怎么还没有增援我们！"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫局队员",
          "speakerId": "char_015_lmg",
          "text": "通讯说，他们被整合运动拖住了......！"
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "speakerId": "char_010_chen",
          "text": "怎么可能，就凭整合运动那帮乌合之众！"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫局队员",
          "speakerId": "char_015_lmg",
          "text": "......而且对方只有......一个人......"
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "speakerId": "char_010_chen",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "陈",
          "speakerId": "char_010_chen",
          "text": "除非......"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
