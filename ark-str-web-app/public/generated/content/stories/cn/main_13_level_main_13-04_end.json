{
  "server": "cn",
  "storyId": "main_13_level_main_13-04_end",
  "groupId": "main_13",
  "stageId": "main_13-04",
  "title": "苦厄盘桓",
  "storyCode": "13-5",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_13-04_end.txt",
  "sourceHash": "1b0844c3273a907b2b7f5956591fb4a3451aa6b09a58837a5f703927c148879f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "戴菲恩，你......想加入我们吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "温德米尔公爵的灵柩正在运往前来增援的高速军舰，一些难民很感激她，所以自发组织了护送灵柩离开的悼念仪式......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "维娜小姐，能替我感谢大家吗？我......想在这再待一会儿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "刚才那些人和你说了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......没什么，只是希望我先留在这“冷静一下”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "剑卫们登上了迟来的护航舰队，他们大都......在其余惊慌的贵族中保持了缄默。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "只是，一瞬间的破绽，因为我想去救那个士兵......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "血魔向我伸出了手，而无论这是不是一个显而易见的陷阱，妈妈她......都因此受了伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "阵型溃败，人员伤亡，剑卫从不保护他们的公爵，剑卫只为完成他们的目标——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "——但他们面对的敌人，还是强大得......超乎想象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "戴菲恩......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "参谋们认为，这场冒进的行动有着太多的“私人感情”。参谋团本就......不会支持这样的行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "他们......觉得......我是导致母亲死亡的直接原因。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "“英雄不该为软弱之人殉葬。”他们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......说得没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "可以了，戴菲恩小姐。我尽量冲洗了下您的伤口，药品有限，只能先这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "谢谢你，医生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "我也得告辞了，参谋团要求所有部队都回去述职......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "我把一些属于您的东西也一并留下了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "这些本是公爵大人为您准备的礼物。当然，还有......她的配剑，您已经拿到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "也许我接下来的话会稍显冒昧，但我仍然希望，您能和我们一起回到“加拉瓦铁盾”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "不论那些长官对您说了什么，您依旧是“温德米尔公爵”爵位的继承人，任何人都无法改变。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我会考虑的，但现在，请让我独自安静一会儿吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "都还好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "他们接走了一批人，但还有很多留在这。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "所以，呃，那位铁血母亲真的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......很讽刺，公爵把她的麾下培养得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "哪怕此刻，温德米尔的参谋团依然在谋划着吻合计划的下一步行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "戴菲恩呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......这些功利的军官老爷们似乎打算抛弃她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我不清楚，我甚至担心......他们会对戴菲恩做什么。她是“继承人”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "她......还没有准备好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "......温德米尔公爵是铁腕领袖。她的剑卫，她的参谋团，从来都只为维多利亚整体的利益考虑。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "但她本人，却因为女儿......\n做了一个值得钦佩，却又实在太过莽撞的决定。"
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "可这么多人能活下来，不也因为这个决定？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "我没有不尊重她的意思！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "但是......这就意味着，戴菲恩会被温德米尔公爵，她的母亲，一手缔造出的力量给抛弃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "那我们接下来怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "他们确实接走了一部分难民，难道我们真的能信他们？接下来的战斗跟着，呃，贵族混？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......他们没有带走所有人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "不对，就算人数众多，既然这一艘船能装得下，更多的高速战舰没道理——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "什么动静？这艘船的动力舱不是毁了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "看窗外！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "戴菲恩！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "怎么回事——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......他们走了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "可下面还有想要赶去送别温德米尔公爵灵柩的平民！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "那群混账，他们就不怕误伤无辜的人吗？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "怎么回事？怎么回事？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "该死，这不符合军令！或许只是他们收到的指令有误......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "这艘船上还有几辆能动的步兵战车，我们需要尽快赶回“加拉瓦铁盾”确认！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "别磨蹭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诺伯特难民",
      "text": "我......我真的走不动了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "你非得让我拿鞭子抽着你走吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "快点！跑起来，想活就跟上前面的战车！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诺伯特难民",
      "text": "我......有点喘不上气......长官，我生过病......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "不能磨蹭，这不光关系到你能不能活命——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "放开你的手，诺伯特区的混混，我只是在执行军事命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "他们没有经过和你们一样的军事训练，连续五个小时的急行军已经把他们榨干了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "那他们大可就地躺下，留在这里等死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "我们是在救他们的命！只要回到“加拉瓦铁盾”，一切就还有挽回的余地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "他们需要扎营休息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "我都说了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "这不光是为了这些市民，也是为了你们，准尉。我知道你们的情况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "被留下的士兵不多，但我很清楚，你们几乎全都感染——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "闭嘴！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......我只容忍你一次。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你是温德米尔公爵下属的军人，别用你的行动玷污她的名号。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "我——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "抱歉......只是请别说出那个词，该死的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "我好得很......我好得很！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "我要求过荒野行军的时候保持低调，小心把那些萨卡兹部队招惹过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "长官，我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "天色已经暗下来了，跟着你们狂奔的那些普通人需要扎营休息，少尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "......否决，继续按照原定军事任务正常行军。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "按照这个速度，我们在午夜就能抵达31号高地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "在那里我们就能和“加拉瓦铁盾”恢复通讯，只有和移动要塞恢复联系了，这支队伍才能真正安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "如果等到天亮，这支队伍未必能在萨卡兹的部队面前——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你是这里暂时的指挥官，你是船医，也是这里军衔最高的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "那么，你应该很清楚，我们在靠步行和仅仅几辆战车，追赶高速战舰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "少尉，我尊重你的判断，但我们甚至不知道那些高速军舰具体为什么离开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "那些军舰在当时没有响应你们的通讯，你又凭什么笃定，那座移动要塞会为我们敞开大门？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我已经确认过队伍里的情况。现在为止，这支队伍里还有作战能力的士兵只剩下不足三个连，还有大概近千名难民在跟着队伍行进。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "等到你理想中的伟大行军完成，还能跟上队伍的人，不会超过百分之二十。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "你叫维娜，对吧。听好了——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我说的百分之二十，是你的士兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "至于难民，全军覆没。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "长官......（低语）。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "稍微放慢速度......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "我们继续行军——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "......呃......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "......你在挑衅军人，混混头子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "按照维多利亚的军事法，我可以处决你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "站起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "尝试处决我，或者我们继续。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "所有人不许妄动！不许误伤平民！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "他们叫你“推进之王”，是吗？有些传言，说你有什么显赫的身份......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我是个混混头子。格拉斯哥帮的......老大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "行，我不在乎，但你听好了，我是效忠于温德米尔公爵的军人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "我的使命就是完成长官交给我的任务！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我等你擦掉嘴角的血。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......放弃吧，你的手要脱臼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "为了保全大多数，我可以接受......牺牲。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "谁是大多数？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你真正睁眼看过你的队伍吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "已经足够了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我也想告诉他们，那些从诺伯特区的地狱爬出来的人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......他们仍然有我罩着。还有人在乎他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "拳头大的人更有理，这是街头的法则，少尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "所以我现在告知你，他们会在这里扎营休息整顿，我们必须重新考虑之后的行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "一旦与“加拉瓦铁盾”的主力军完全脱节，要是遇上萨卡兹的部队，我们都会死，所有人——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "够了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "希勒少尉，既然你还认可自己是温德米尔公爵军队中的一员，那就别再给她丢脸了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "您怎么可以——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "戴菲恩，这身衣服，那柄剑......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "这身衣服......对于我还是有些太大了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "但现在，我需要你们听听我的想法。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "少尉要出发了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "是的，他们挑选了一辆状态最好的战车组建了特别小队，他随时可以出发。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "这支小队独自轻装疾行，预定会在天亮前抵达地图上的位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你穿上了这身衣服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......它所象征的东西，也许还能帮上一些人的忙。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "戴菲恩小姐，我已经和我的士兵们交代完毕。在我回来之前，这些士兵的指挥权暂时由您接管。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "......我依旧想最后邀请您一次，您是温德米尔公爵这个头衔的第一顺位继承人，无论如何，您都应该和我们一起——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "抱歉，我必须留下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "这也是我对市民们的承诺，他们需要知道，维多利亚没有抛弃他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "他们需要这份希望才能坚持下去......现在我们只能彼此信任，我们必须彼此信任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "况且，如果护航舰队的离开只是一起误会，或是少数人的哗变，那么无论我在不在，“加拉瓦铁盾”都会迎接我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "而如果不是呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "我的出现......会让事态更糟。起码你能活下去，对吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "您知道！我并不是苟且偷生的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "他们放了我一次，也许是出于对我母亲的尊重，也许是出于......一点恻隐之心。但他们不会给我第二次机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "我信任我的战友，以及长官对公爵的忠诚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "戴菲恩小姐，请收下我们的位置信标，我保证带回来好消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "至于你......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "希勒少尉",
      "text": "......唉。你的拳头很硬，戴菲恩小姐就拜托你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "放心，少尉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "推进之王，我们检查了一遍诺伯特难民们的情况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "我不知道这是不是温德米尔公爵瞒着我们下达的命令，当时登舰期间的情况太混乱，也找不到命令的执行者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "但就结果而言，只能说他们的登舰筛查做得“很到位”。如今队伍里的难民基本都没有感染的迹象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "可眼下......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "在萨卡兹的巫术中作战的士兵们......很多都已经有了急性的感染症状。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "这些军人们为了对抗萨卡兹而感染了矿石病，他们的同袍居然就这样毫无心理负担地抛弃他们了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "......这是军队里的传统。不只是维多利亚，卡西米尔、乌萨斯，乃至曾经的高卢都是如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "军营中不会接纳感染者，也许稍微有点良心的指挥官会把他们编进独立的编制中，然后派遣他们执行最危险的任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "但对于一支军队，感染者和他们失控的源石技艺实在是太不稳定了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......总该有人反抗过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "但没有成功过。历史上的战争中军队的感染者比例其实并不算高，为了前线的稳定，这样的损耗是可被接受的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "皇家军事学院甚至直接把这一点写进了教材里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "这只是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "“荣耀基石下可敬的牺牲者们”。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "别动粗，女士们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "我想和你们谈谈。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "首先，我想提前声明一点，温德米尔公爵阁下的死和我效忠的那部分维多利亚没有一点关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "我带着哀悼而来，戴菲恩小姐，真心实意。抛却我自己的身份，我认为她比四皇会战中的英雄更加闪耀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "可如今，她留下的防线缺口谁来填补？她原本的战略意义谁能替代？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "威灵顿公爵是个打仗的老手，但我们都知道，他并没打算真正用出全力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "开斯特公爵阁下在努力协调，她已经焦头烂额。直白地说，温德米尔公爵的死给我们带来了非常非常大的麻烦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "你知道得是不是太快了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "......唔，这是我们的职责。您也算是......同行吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "你究竟是来做什么的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "你最好想清楚你接下来要说的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "向英雄献花，温德米尔小姐，并且带了一批口粮和弹药作为礼物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "交换什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "你很清楚，殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "诸王之息，那根铁条。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我可以坦诚地告诉你，这把剑确实对我没有用处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你很喜欢交易，可以。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "条件很简单——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "拉上你们那个该死的剑座，把那东西带去最前线，带去交火最密集、风暴最可能扫荡的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "如果你们的盘算是把这把剑安稳留在后方，支起一个王公贵族们用来避暑喝茶的帐篷，那就给我滚开！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "只要你们真的愿意把这东西带到前线，为维多利亚的战士、市民或者没了家园的可怜人遮风避雨......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "而不论他们是铁匠的儿子还是老师的女儿，不论他们领着维多利亚的军饷还是握着自制的武器，都能得到它的荫庇......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "那我大可以把这根铁条交给你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "带着剑座来见我，灰礼帽，在前线，我不会落后你哪怕一步，我承诺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "......哎呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "这超出了我的权责范围，我毕竟只是个代办，最终的决定权在开斯特公爵阁下手里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "那就去找你的主人，从我亲爱的姑姑嘴里要出个结论再来见我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "亚历山德莉娜殿下，我会去争取的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "但......这只是个人的承诺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "接下来的谈话不会被记录。只是些私人的，不是“灰礼帽”，而是萨福克爵士，贝林厄姆的私人看法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "殿下，有时候出现些新的声音也许不是坏事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "你们已经收拢了一些感染的战士，呃，更多是平民啦，这......很好，但还不够。你需要一支“军队”，属于你的“军队”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "能够让他们也得以容身的军队。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......你......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "看来你真的关了身上的录音机。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "哈哈。关太长时间会让我的同事们起疑惑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "......我的奶奶，在四国战争期间因感染被处决......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "她出门前，大笑着告诉我爸，因为打仗感染矿石病的概率不到百分之三。等我继承了爵位，去档案馆里翻那些资料的时候，才知道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "这个“百分之三”的统计数字，已经用了几百年。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "......唉。现代战争，更多的源石机械，更复杂的源石法术。但百分之三，恒久不变。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "你们也许注意不到，你们只能看到战场具体的一角。公爵们也注意不到，他们的目光放得太远太远，但是我很清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "维多利亚军队的感染问题很严重，从未有过的严重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "在之前与“文明国家”的冲突中，大家都很克制。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "谁也不想让自己的军营里满是会爆炸的活体炸弹，或是收获一座沾满了源石粉末的脏城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "但是，现在......我们的对手是萨卡兹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "推进之王，如果你真的有意去做，那对你的声望，对我的前途，对......唉，甚至对我们的国家，也许都有好处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "感染者的事，我和我的同伴比你们更有数，就不劳您费心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "对了，我这里有些废弃的小设备，工作中的副产物，没人要，也没人在意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "作为报废品，我可以免费送给你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "那么，再会。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戴菲恩",
      "text": "你觉得他有几句真话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我宁愿相信，现在连他这种人也做不到在这片战场上无动于衷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "他留下的是什么？录音和坐标？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "这个声音......这是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
