  "groupId": "main_3",
  "stageId": "main_03-04",
  "title": "龟裂",
  "storyCode": "3-4",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_03-04_beg.txt",
