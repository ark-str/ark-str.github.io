  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十六关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "怎么样阿米娅，企鹅物流很不错吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "嗯，很厉害！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "唔，唔啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "被比自己年龄小的孩子直接这么夸奖，还有点不好意思。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "她可是我们的雇主，稍微礼貌一些。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "唉唉，不好意思！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "没问题的，我还得谢谢你们呢！"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "这样一来，罗德岛这里也汇合了。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "下面要做什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "可能需要近卫局先做判断，然后我才能给出意见。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "是嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "那我去问他们一下，让他们过来看看。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "这个地形......"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "整合运动应该是有意识把我们引到这里来的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "黄沙、荒原、岩石。真是凑齐了一切野外作战的要素。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "唯一缺的东西，大概就是敌人了吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "星熊，你留下帮罗德岛一把。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "啊？好的。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "我带近卫局换个位置。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "如果就这么僵持下去，整合运动的路线很可能会脱离我们的控制。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "明白。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "你自己也多加小心。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "——唔哦，刚才那阵风好大。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "唔唔，可视好差，有点施展不开呢......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "不能再前进了。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "整合运动可能会等到我们都进入包围圈之后，再对我们发动攻击。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "一定要避免陷入这种处境。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "这样吧，阿米娅。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "我先和雷蛇迂回作战，边侦察敌情，边尝试占领这片区域中的高地。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "在我们通知你之前，罗德岛最好先坚守阵地。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "可别因为我们战斗得太激烈就突然冲出来哦，阿米娅。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我知道的，我会自己判断局势。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "博士，你也要拉好她哦！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "保持联系。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "废墟空无一人，制高点也没人防守。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "有趣，整合运动难道没有指挥官？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "芙兰卡，有什么问题吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "明明是十分易守难攻的地形。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "整合运动肯定会埋伏我们——————"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "去死吧，感染者叛徒！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "啧，真是不给面子啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——芙兰卡！！小心侧面也有！！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我看见有整合运动从建筑下方——"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "咳......快剑......？！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "怎么......会......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "呵呵。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "以为躲在废墟下方，就能从脚底偷袭我们？"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "未免也太小看我了吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "......黑钢......！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动",
      "speakerId": null,
      "text": "撤退！快撤退！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "我还真以为会有大批整合运动埋伏在这，弄得我一路都是踮着脚尖走过来的呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "结果就是一批胆小鬼而已，真让人有些泄气。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "别因为这点小事泄气啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "不能让他们这么轻易就逃脱，我们理当追击敌人！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "阿米娅，你觉得呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我觉得，还是不能冒进！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "先让企鹅物流的二位帮你们稳定局势之后再做打算比较好。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "能天使，能优先确保制高点吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "好嘞！那我就去咯？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "好的，尽量压制住敌人，不要给整合运动丁点反击的机会！"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "整合运动跑了一小段距离之后，就在那里重整阵形了。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "他们好像......还牵了个什么出来。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "当心。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "那个整合运动的暴徒......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "可不是普通的战斗人员！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "整合运动这些家伙，怎么还和......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "会不会是......"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "和什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "确实，这个整合运动的成员，难道说，是魔......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "难道说......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "（雷蛇，我们正和近卫局共事，今天可能......不太适合讨论这样敏感的问题！）"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "（啊，明白。）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "（下次我会再和你谈谈我的猜想！）"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "......唔哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "大家，请做好准备！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "可能......会是场十分艰巨的战斗！"
    },
    {
      "type": "sceneBreak"
    }
  ],
