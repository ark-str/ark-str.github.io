  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "霜叶？霜叶？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "怎么回事——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "阿米娅！这里是第二侦查小队——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "我们正在撤退！但是对方......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "整合运动......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "又断了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "第三侦查小队！听得见吗！第三侦查小队！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "阿米娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "凯尔希医生！是我！你接到了吗——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "我一直在舰桥监控。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "你帮我问问你身边那个陈警官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "就问——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "“龙门还要装腔作势到什么时候？”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "刚才的发言，我就当没听到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "不过，这确实不是什么还能慢慢悠悠的情况。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "出了什么事？我不过拿个报表，你们两个的表情就变得那么严肃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "——有任务？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "大家......整理下装备，我觉得，应该是时候出发了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官，我请求龙门出动近卫局，配合罗德岛进行救援任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "甚至，那里会有整合运动的临时指挥部——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "而且，各个侦查小队，一定还在我看不见的地方战斗着......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
