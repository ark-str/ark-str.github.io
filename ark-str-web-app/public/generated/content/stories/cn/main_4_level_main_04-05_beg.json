{"server":"cn","storyId":"main_4_level_main_04-05_beg","groupId":"main_4","stageId":"main_04-05","title":"官僚主义","storyCode":"4-5","avgTag":"行动前","sourcePath":"vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_04-05_beg.txt","sourceHash":"4a081c10bd987fcc33c566654f2573bd44930d39660b9900749b2048ceb7520e","bodyAvailable":true,"blocks":[{"type":"narration","text":"第三十二关（前）"},{"type":"background","backgroundId":"bg_lungmen_m"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"霜叶？霜叶？！"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"怎么回事——"},{"type":"dialogue","speakerName":"近卫干员","speakerId":null,"isRemote":false,"text":"阿米娅！这里是第二侦查小队——"},{"type":"dialogue","speakerName":"近卫干员","speakerId":null,"isRemote":false,"text":"我们正在撤退！但是对方......"},{"type":"dialogue","speakerName":"近卫干员","speakerId":null,"isRemote":false,"text":"整合运动......"},{"type":"dialogue","speakerName":"近卫干员","speakerId":null,"isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"又断了？"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"第三侦查小队！听得见吗！第三侦查小队！"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"陈","speakerId":"char_010_chen","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"凯尔希","speakerId":null,"isRemote":false,"text":"阿米娅。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"凯尔希医生！是我！你接到了吗——"},{"type":"dialogue","speakerName":"凯尔希","speakerId":null,"isRemote":false,"text":"我一直在舰桥监控。"},{"type":"dialogue","speakerName":"凯尔希","speakerId":null,"isRemote":false,"text":"你帮我问问你身边那个陈警官。"},{"type":"dialogue","speakerName":"凯尔希","speakerId":null,"isRemote":false,"text":"就问——"},{"type":"dialogue","speakerName":"凯尔希","speakerId":null,"isRemote":false,"text":"“龙门还要装腔作势到什么时候？”"},{"type":"dialogue","speakerName":"陈","speakerId":"char_010_chen","isRemote":false,"text":"刚才的发言，我就当没听到。"},{"type":"dialogue","speakerName":"陈","speakerId":"char_010_chen","isRemote":false,"text":"不过，这确实不是什么还能慢慢悠悠的情况。"},{"type":"dialogue","speakerName":"星熊","speakerId":"char_136_hsguma","isRemote":false,"text":"出了什么事？我不过拿个报表，你们两个的表情就变得那么严肃。"},{"type":"dialogue","speakerName":"星熊","speakerId":"char_136_hsguma","isRemote":false,"text":"——有任务？"},{"type":"dialogue","speakerName":"陈","speakerId":"char_010_chen","isRemote":false,"text":"没错。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"大家......整理下装备，我觉得，应该是时候出发了。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"陈长官，我请求龙门出动近卫局，配合罗德岛进行救援任务。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"甚至，那里会有整合运动的临时指挥部——"},{"type":"dialogue","speakerName":"陈","speakerId":"char_010_chen","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"而且，各个侦查小队，一定还在我看不见的地方战斗着......"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米娅"]},{"speakerId":"char_010_chen","aliases":["陈"]},{"speakerId":"char_136_hsguma","aliases":["星熊"]}]}
