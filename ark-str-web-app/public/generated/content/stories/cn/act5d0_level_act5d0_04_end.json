  "sourceHash": "73f7e9d0a48a369aec0b2f79ee185f29d47c0e35d4cbfdefe4cd53782f8554f4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "speakerId": null,
      "text": "喂，这是在拍电影吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众B",
      "speakerId": null,
      "text": "那不是企鹅物流那群人吗？又在打架？"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众B",
      "speakerId": null,
      "text": "对！左勾拳！就这样！帅喔！"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "speakerId": null,
      "text": "每次都是他们赢，没意思啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众B",
      "speakerId": null,
      "text": "也是。喂，不知道哪儿冒出来的黑服，你们不要输太惨啊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "嘿咻，不能用实弹可真麻烦啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": "char_201_moeshd",
      "text": "这里再怎么说也是市中心，当然不能用实弹了。能天使姐，背后！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "哎呀，危险危险~谢啦，可颂。"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "这么纠缠下去可没完没了！德克萨斯小姐！"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "嗯......空和我，能天使和可颂，兵分两路，我们去大地的尽头。"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "......什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "太棒...不，我明白了。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "哦~分头引开这些敌人是吗？没问题，我最擅长这个！"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": "char_201_moeshd",
      "text": "能天使姐，路上麻烦你小心一点，赔偿清单在变长......"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "等等，你们说的那个“大地的尽头”是什么意思？"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "一个小时后集合。"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "所以是什么意思！？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "可是我们要怎么杀出去？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "我有一个办法......"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "你，你想干嘛！？你这天使——我可不怕你——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": "char_103_angel",
      "text": "可颂，上来！这辆摩托还挺帅的嘛！"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": "char_201_moeshd",
      "text": "好嘞，走着！"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "抢车？好主意......"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "嗯，就你了。"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "你别过来啊，该死的狼——你——噫噫——车、车给你，别打脸！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "嗯，空，赶紧上来。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "好、好的！"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "抓紧了，可不能比能天使他们动作慢。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "还是稍、稍微慢——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "那我——"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "企鹅物流就把这小子丢这儿了？"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "那不是正好，一起上，看他怎么反抗！"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "嘁！那帮家伙一个个的在想什么！？"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "该死——！这附近有没有——！"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "speakerId": null,
      "text": "啊，要自行车吗？借你也可以。"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "自、自行车......"
    },
    {
      "type": "dialogue",
      "speakerName": "拜松",
      "speakerId": "char_325_bison",
      "text": "算了，也没空挑挑拣拣了，谢谢！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "speakerId": null,
      "text": "好好加油啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "你竟然敢帮企鹅物流——！？"
    },
    {
      "type": "dialogue",
      "speakerName": "路过的观众A",
      "speakerId": null,
      "text": "反正你们有车，也追得上吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "你——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "忍着，不要对平民出手，否则我们就完蛋了。"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "对、对不起，追！都给我去追！"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "哼......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "“绑架拜松，分裂企鹅物流和峯驰物流，刺杀大帝”，你的好主意。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "我们的目的是取而代之。没必要杀光那些蠢货，这笔账你都不会算了吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "德克萨斯，她可是德克萨斯。还有那个拉特兰人和峯驰物流的大少爷，给她们留后路，我们还会有安稳日子吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "必须得斩草除根。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "那样会引起其他人的瞩目。不止我们盯着这块蛋糕。"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "哈！你怕了？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "进退是需要动脑子的，蠢货。"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "低声下气地恳请鼠王已经是我的底线，懦夫。在龙门的这么些年，你变得畏首畏尾。"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "如果不是念在你对家族的贡献，我早就把你撵出去了。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "我们都有各自的事情要做，嘲讽的话一会再说。"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "你说的没错。我要用我自己的手段和企鹅物流分个胜负。"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "能靠死人解决的问题，就不要让活人互相扯皮，对吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "......随便你。但我最后警告你一次，这里是龙门，不是叙拉古。"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "在叙拉古的失败之后，我就明白，我们不该放过任何一个机会，要不择手段地摧毁敌人。"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "而不是妥协，商议，再落入圈套。"
    },
    {
      "type": "dialogue",
      "speakerName": "甘比诺",
      "speakerId": null,
      "text": "我们应该用西西里人最传统的方式解决问题。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "是啊，家族不需要懦夫......也不需要匹夫。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "分出一支小队，去贫民窟找鼠王。交易的内容有变。"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "卡彭先生，但如果说服不了鼠王......"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "哼，我们如果真想在龙门站稳脚跟，岂能容忍那只老鼠一直趴在我们头上？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "他迟早是我们要牵制的对象。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "现在，按照这份名单一个个找过去，都是和鼠王有接触的龙门人。"
    },
    {
      "type": "dialogue",
      "speakerName": "黑帮",
      "speakerId": null,
      "text": "是。"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "我们时间不多，今晚必须得到结果，争分夺秒，快。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "我在龙门这么多年什么都没干......？"
    },
    {
      "type": "dialogue",
      "speakerName": "卡彭",
      "speakerId": null,
      "text": "错了，甘比诺·里奇，大错特错。"
    },
    {
      "type": "sceneBreak"
    }
  ],
