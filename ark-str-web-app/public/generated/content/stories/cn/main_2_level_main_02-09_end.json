  "stageId": "main_02-09",
  "title": "操作暗箱",
  "storyCode": "2-9",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_02-09_end.txt",
  "sourceHash": "2fdc051e074b815f1f47aef1c2619b2e41ba155ffd6d9f2196d53b1eac5db89d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十一关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这是最后一批追击我们的整合运动了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动",
      "text": "......呃啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "确保！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "确认安全无虞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "敌方的指挥官呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "——不在这批敌人里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "一直潜伏着......观察着，尾随着我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "是想消磨我们的体力，等到稳操胜券后，再发动袭击吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "整合运动的敌人非常擅长发动偷袭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这点，我们在切尔诺伯格时就领教过了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "暂时撤退——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我没法确保撤退路线的安全。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "如果他们破坏建筑物来封锁路口，我们就危险了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——立刻侦查其他的路线！越隐蔽越好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "阿米娅，四点钟方向，那个向下方街道移动的阶梯如何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "那里可不好走哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动",
      "text": "啊啊！罗德岛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是伏击！小心！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "继续给我追。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "别让他们有任何喘息的机会。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......长官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "——贫民区......里有一些被感染的孩子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "如果可以的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "希望你能......照看他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "保护龙门是近卫局的责任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "感染者，并非是龙门公民。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "但龙门的感染者依然属于龙门。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我没任何理由向你保证，但我会尽到我的职责。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "毕竟——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "他们说过，以前也——",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "="
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "这是我们一直在做的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "谢谢你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——你知道我们找你的原因吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "......我不清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "我想不出自己有什么值得你们追缉的理由。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "但我觉得，也许......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "原因不在我，却在——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "text": "——我的父亲身上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "————是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你的父亲，是切尔诺伯格最著名的科学家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "同时，他也是切尔诺伯格重要的政治人物之一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "也许，你身上有着......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "也许没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "但我们不能允许你落入整合运动之手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "呵呵，找到你们了，龙门近卫局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "虽然我和你们无冤无仇——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "但我手上有一个很有意思的剧本哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "为了让事情变得好玩起来，有必要让你们参与其中呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "就让我们开始吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
