{
  "server": "cn",
  "storyId": "main_3_level_main_03-05_end",
  "groupId": "main_3",
  "stageId": "main_03-05",
  "title": "呼叫",
  "storyCode": "3-5",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_03-05_end.txt",
  "sourceHash": "f610782e259b05518a4d87a0345781481c8f921d9e8fd9436bac889a1c52709f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十七关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "后撤！重整队形！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "让他们走吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "再这样下去，我们的队伍会被敌人分隔！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "如果敌人还有后续的战力增援，后果不堪设想......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "这些整合运动......不是在针对我们！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "优先保证我方干员的安全！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "狙击干员，暂时停止对撤退的整合运动的攻击！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "优先支援星熊警官！"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "真烦人！"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "不错不错，居然被你撑住了~"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "不过，你还能撑几发呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "那要看你的命有多硬了！"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": "char_136_hsguma",
      "text": "——————老陈！快！"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "包围那个女人！"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "哦哦，近卫局的后援吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "放下你的武器！"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "陈长官，我们又见面了~"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "油腔滑调不能救你的命。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "你对龙门做的，我会加倍在你身上讨回来。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "哎呀~真可怕~"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "但我这次不是来找你的。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "阿米娅，接好~"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我？这是......移动电话......？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_002_amiya",
      "text": "是的，有人想和你说点事~"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "————————？！"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "好，这样我的任务就完成啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "另外这个，不是给阿米娅的，而是送给你们的。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "后会有期咯~"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "小心！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——近距离爆破——？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "不对，是闪光弹！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "别被她迷惑——"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "——来不及了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "已经让她跑了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "跑起来可也真的是快，趁着近卫局还没稳定阵形，一瞬间就溜走了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerId": "char_010_chen",
      "text": "你也要小心你手上的东西，如果是炸弹的话......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......这个，倒是普通的移动电话没错......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "只是......莫非......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——————"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "喂？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "————"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "你是......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "阿米娅......？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "米莎！告诉我你在哪！我——"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "阿米娅......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "少女的声音",
      "speakerId": null,
      "text": "......优先......处理重伤人员！！给他输血！！快啊！！"
    },
    {
      "type": "dialogue",
      "speakerName": "青年的声音",
      "speakerId": null,
      "text": "......可恶......为什么......明明都是感染者......"
    },
    {
      "type": "dialogue",
      "speakerName": "青年的声音",
      "speakerId": null,
      "text": "罗德岛......这些家伙为什么会做这种事？！"
    },
    {
      "type": "dialogue",
      "speakerName": "女性的声音",
      "speakerId": null,
      "text": "......我们从一开始就被他们遗弃了！！没有出路的......没有......！"
    },
    {
      "type": "dialogue",
      "speakerName": "男孩的声音",
      "speakerId": null,
      "text": "别死！别死啊！我们说好，说好要一起回家的......！"
    },
    {
      "type": "dialogue",
      "speakerName": "女孩的声音",
      "speakerId": null,
      "text": "......呜......哥哥......不......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "听到了吗，这些声音......？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "是整合运动的感染者......吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "我想起来了。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "不，我一直忘不掉。我只是......不愿想起。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "没错，是整合运动毁了我们的家，我爸爸也......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "但......这是我们，自作自受。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "当年，我眼睁睁地看着我的弟弟被拖走......他哭着叫我的名字，我却转过头——"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "——躲进了自己的房间。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "当他又来找我的时候......他放弃了许多东西。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "他依然爱着我，我却害怕了，逃跑了......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "但我明白。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "这一切只是要让当时迫害他们的人，都尝尝感染者遭受的痛苦。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "如今我是感染者了。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "......也到了，我该偿还自己罪孽的时候了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "米莎，别做傻事！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "无论过去的人们怎么对待感染者，只要你现在改变——"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "没用的。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "我又能，改变得了什么呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "因为我，就是当年视而不见的人之一......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "成为感染者之后，我看得......更加清楚了。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "普通人是怎么对待感染者的，感染者也会那样去对待普通人。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "这是他们应得的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "不......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "这一切，不过是我自己种下的残忍种子所结的恶果......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "我理应受到这样的折磨。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "但是，为什么，为什么——"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "他明明，什么错也没有啊？！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "他只不过是突然被发现是感染者而已......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "当时的他，才刚刚开始要我帮他写作业啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "如果我，如果那时候，保护了他的话......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "米莎！冷静点！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "伤害无辜市民的并不是你！这些都不是你的错！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "在最开始，谁又不是无辜的呢？！！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "错的，错的就只有感染者这个身份而已......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "如果这只是互相报复的话，是谁，是谁导致了这悲剧呢......！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "如果乌萨斯没有把感染者当作可怕的牲畜一样对待......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "又有谁会恨乌萨斯入骨呢！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "为什么感染者，就一定要遭遇这些折磨呢！！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "米莎......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "碎骨已经死了，你可以回到我们这里，我们一定会......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "......阿米娅。我已经有了答案......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "我是一个感染者。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "我站在感染者这边。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "不————"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "是的，阿米娅，你也是感染者......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "你应该能够理解。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "是的，我也是......罗德岛大家和我，都知道你的想法......我明白的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "但是，米莎，仅仅是将自己从普通人置换到感染者的身份中，是什么都不会改变的！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "请等等我，我立刻来找你！"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "别过来。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——米莎！你在——"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "你说得对，阿米娅，你说得对......我只是愧疚而已。我只是......太过软弱了而已。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "但我已经决定了。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "即使只有一步，我也要......踏出这一步。"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "对不起，阿米娅，对不起......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "整合运动是感染者......"
    },
    {
      "type": "dialogue",
      "speakerName": "米莎",
      "speakerId": null,
      "text": "他们，也是感染者啊......"
    },
