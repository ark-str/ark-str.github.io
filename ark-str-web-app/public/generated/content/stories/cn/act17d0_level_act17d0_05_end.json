{
  "server": "cn",
  "storyId": "act17d0_level_act17d0_05_end",
  "groupId": "act17d0",
  "stageId": "act17d0_05",
  "title": "物资回收计划",
  "storyCode": "OD-5",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act17d0/level_act17d0_05_end.txt",
  "sourceHash": "6b45afd28b348c8ffef4e8b3eae10b35b42c5aa367c55a79b79f1a8f2401eab6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "霜华",
      "text": "有发现吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "找到了！虽然量不多，但是有收获。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "很好，这些粮食加上安全屋的应急储备，应该能够省省勉强再过一个星期。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "时候不早了，先回去吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......有人来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "有多少？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......十几个人，可能是雇佣兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "不要和他们缠斗。快！往安全屋方向！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "他们还跟着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "不太对劲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "我就知道这群人肯定不会善罢甘休。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "在这里战斗容易被包围，继续撤退。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "追兵。准备战斗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......不对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......不要开枪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......他们不是那些雇佣兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......是瑞柏巴军人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "是本地卫兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "不要动手！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "卫兵，包围这个建筑！不要让任何人跑了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "等等，我们是不是被包围了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "......情况不太妙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "领主卫队为什么要包围我们？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "你们先别说话。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "躲在里面的人，听好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "我是长泉镇卫兵队长，长泉镇领主之女皮加尔·图拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "现在所有人都给我放下武器，乖乖地滚出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "不要尝试挑战我的耐心，你们会后悔的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "雇佣兵，又是雇佣兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你们这群无德无耻无信无义的恶徒！我那个恶贯满盈的兄弟到底给了你们多少金子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你们逃不掉的，我要碾碎你们，我要击溃你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "我要让你们为恶行付出代价。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "等你们死在我刀下后，你们才会知道，再多脏钱也买不来第二条性命！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "喔！喔！你确定他们是来“帮忙”的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闪击",
      "text": "这是要把我们挂在城门口吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "这就是我最担心的情况。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "这中间肯定是有什么误会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "皮加尔大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "老夫是罗德岛外勤干员，代号巡林者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "罗德岛与您的家族应当签署过相关的协议。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我们是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "闭嘴！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "罗德岛！道貌岸然的伪君子！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "我的父亲信任你们，他相信你们的承诺，才同意这个安全屋的存在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "而你们是怎么报答我的父亲的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你们绑架镇民！掠夺他们的财富！我都看到了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你们这些背信弃义的恶徒！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "但凡你有点脑子，就不该说出这么蠢的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "如果我们的目的是掠夺这个镇子，那我们还在这里逗留这么长时间？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "花言巧语！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你们又是什么人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你们拿着铳器站在我父亲的领地上，还敢在这里狡辩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "既然你这么厉害，之前干什么去了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "你和领主卫队放任暴徒袭击病人社区，拼死救人的是我们，不是你那不出动的宝贝卫队。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "现在你还跑来满嘴胡话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "冷静。这人不太像是能讲得通道理的那类人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "皮加尔大人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "我是感染者社区的米亚罗医生！你以前见过我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "......是你，我认得你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "罗德岛没有劫掠感染者，我可以作证！我们是被那些暴徒赶到这里来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "不止是我，这里的其他感染者也可以作证。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "皮加尔大人，请您相信我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "......我相信你，医生，很多人都讲述过你的故事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "谢谢您，皮加尔大人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "但是我不信任他们！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你们未经许可手持兵械进入我父亲的领地，这就是大忌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "看在你们保护了我父亲的领民的份上——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "我不追究你们私携武装的责任！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "至于罗德岛！你们与我父亲签署的合同，即日内作废。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "......请您三思。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "这件事没什么值得商量的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "长泉镇不需要其他武装人员，就算是罗德岛也一样！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "我会带走所有的感染者，将他们安置在合适的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "其余的你们不需过问。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "可是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "好了，别说了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "不要忤逆本地领主，这里是萨尔贡，别忘了我们现在代表罗德岛的立场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "四十一、四十二......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "还有其他人吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "就这些了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "没事，接下来你们就安全了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "科恩小姐，亚历山大先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "这段时间，非常感谢你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "别这么说，该说谢谢的是我们这边。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "你们打算去哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "还没确定呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "不要搞得这么悲伤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "咱们以后说不定还会再见面呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "下次我还得给你讲一讲......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "战车",
      "text": "咳咳......狗头人的故事呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "哈哈哈......好的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "医生，这个是给你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "这是......源石锭，这我不能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "是报酬，你替奥克芬治好了腿，这是罗德岛给你的酬金。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "那只是简单的急救处理......不值这么多钱......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我认为是值得的，收下吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "谢谢您，巡林者先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "最后......谢谢各位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "再见。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "这事情不对劲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "唉，本来以为谨慎一些总没错，没想到反而产生了误会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "谁能想到这卫兵队长是个这么不讲道理的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "这蠢女人，脑袋里面也是肌肉吧，我还以为这类人在黑钢已经够多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "接下来怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥克芬",
      "text": "安全屋里的东西......基本都被他们收缴了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "至少大家毫发无伤，这已经是不幸中的万幸了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "奥克芬先生和我们一起出发吧，你可以先在办事处那边登记，我们向本舰联络之后，再一起商量后续行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥克芬",
      "text": "也只能这样了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......我有点不放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "你指什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......这个叫皮加尔的人......有没有可能她才是这一切的始作俑者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "领主迟迟没有出现，雇佣兵一直想要绑架这些感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......现在来了一个卫兵队长，名正言顺地带走了所有人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "这是不是太巧了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "......你说的还真有点道理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......我打算尾随......去看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰烬",
      "text": "我也去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "不，太多人容易引起警觉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "其他人随时待命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "我还以为你会反对这个计划。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "审时度势，不和本地领主发生冲突，不代表我们什么都不做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡林者",
      "text": "有些时候，一些小诡计是必要的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑",
      "text": "......明白了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你先把所有人都带到避难所去，然后带三个人和我一起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "我怀疑矿坑里有问题。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "避难所里还有位置吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "不是很够了，半个镇子的人现在都躲在避难所里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "实在不行就让他们住在楼上，把我父亲的房间给他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "这......这合适吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "没什么不好，如果父亲还活着他也会这么做的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "......我明白了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "总之，保持警惕。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "......等等，我们出来的时候把灯都熄灭了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "我不记得......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "闪开！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "啊啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "源石畸变体",
      "text": "嘎......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "敌袭！保护镇民！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "这都是从哪儿冒出来的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "不要耗在这里，准备突围！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领主卫兵",
      "text": "他们人太多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你们带着平民先走！我断后！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "来啊，你们这些无胆匪类！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "呼......这是第几只了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "终于到了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "皮加尔大人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "医生！你怎么在这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "米亚罗",
      "text": "别过去！领主宅邸已经被......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "医生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "德鲁奇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你给我滚出来！我要把你的头砍下来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德鲁奇",
      "text": "哈哈哈......你的嗓门还是这么大，我亲爱的妹妹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "皮加尔",
      "text": "你......你这个恶棍......我饶不了你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德鲁奇",
      "text": "那就让我看看你有什么本事。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
