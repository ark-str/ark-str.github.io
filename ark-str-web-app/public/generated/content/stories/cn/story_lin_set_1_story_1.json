{
  "server": "cn",
  "storyId": "story_lin_set_1_story_1",
  "groupId": "story_lin_set_1",
  "stageId": null,
  "title": "新潮旧浪",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_lin_1_1.txt",
  "sourceHash": "f233012681714826113936c04be82ae291332a4fb7cdeb17ad121ea210008055",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "局长，按照您的指示，我们的人已经把贫民窟大大小小的出入口都盯住了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "很好。轮好班，今天别让一只鼷兽溜进去，也别让一只鼷兽溜出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "局长，这么兴师动众，会不会起反效果？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "鼠王宣布让林小姐继承衣钵以来，已经过了半个月了，贫民窟没发生什么事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "但是，那只臭老鼠也失踪了半个月了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "贫民窟的话事人新旧交替，什么都没发生，你信吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "瘦子张、师爷李、鬼眼......这些被鼠王压了这么多年的老滑头们什么都不做，你信吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "今天，瘦子张把臭老鼠手下的人带走了，她不可能不行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......林小姐应该能摆平。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "但我不需要她来摆平。贫民窟是龙门的一部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "也对，这点我支持你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "盯好你那边的人，那边肯定也会有动作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "放心。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "给我等着，死老鼠。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "大家呢，都喜欢在酒吧里喝酒跳舞，我是个俗人，偏爱在酒吧里吃火锅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "以前，我林大哥也时常光顾这里，和我们兄弟几个吃香喝辣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "可惜啊，下周这家酒吧就要拆了，今天在这里吃最后一顿，也算给这里送行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "来，吃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胆怯的商人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "汪老弟怎么不动筷子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "汪老弟在我的地盘上建医院都敢不跟我说一声，怎么吃一顿火锅反而不敢了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胆怯的商人",
      "text": "造医院......是林姐的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "你瞧瞧，我就说啊，现在的年轻人不会做事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "你林姐是什么人？鼠王的接班人，日理万机！这样的人物，忘了一两件小事有什么问题？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "我们做小弟的，最重要的不就是要为大佬分忧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "嗯？汪老弟，你说说，究竟是你忘了，还是我林侄女忘了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胆怯的商人",
      "text": "是、是我忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "那不就对了，你林姐见了我，也要叫我一声叔叔，她怎么会不和我打声招呼呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "都是误会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "汪老弟，我看你一直在抖，身子骨有点虚啊，而且你的记忆力也不太好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "这样，你把这锅火锅汤趁热喝了，补补身子，然后去给我侄女报个信，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胆怯的商人",
      "text": "这......我......张先生，您放过我吧......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "商人颤抖着想要站起来给瘦子张下跪，但一只手按住了他的肩膀。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "瞧瞧是谁来了？我的林侄女！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "侄女，不是张叔说你，手下的人这么畏畏缩缩，怎么能干成大事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "当年张叔为了不给你爸丢人，可是当着好几个大佬的面，把盘子咬碎了咽下去的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "现在不比张叔当年，如今做生意讲究的是和气生财。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "小汪妻子要生产了，让他回去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔既然想找的是我，我来陪你吃火锅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "那敢情好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "小汪，回去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胆怯的商人",
      "text": "抱歉，林姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "不怪你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "来，侄女，吃菜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔，你是长辈，有什么话，你大可以直接告诉我，何必多此一举。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "这些年，你的能力大家都看在眼里，林大哥如今把话事人的位子交给你，我支持。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "江湖上最讲究“规矩”两个字，既然你是话事人，张叔当然不能用对晚辈的态度对你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔对我的态度，倒也不像是对话事人，而像是对敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "哎，侄女这话就过了。混江湖，没有规矩，不成方圆，但不讲情义，又何来立足之地？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "侄女不声不响地在我的地盘上大兴土木，这是摆明了要拆我的台。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "我也只是想提醒一下侄女，有些事，不要搞得大家脸上都不好看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "如果我说，我是特意没有通知张叔的呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "瞧瞧，谁说我侄女不会开玩笑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔误会了，我没在开玩笑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......侄女该不会是以为，坐上话事人的位置，就可以为所欲为了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我坐上话事人的位置，是为了不让某些人为所欲为。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "这件事，我林大哥知道吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔刚才也说了，现在我才是话事人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "看来，今天我得替我林大哥好好管教一下女儿了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "胖坤，来跟我林侄女一起吃顿火锅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "叫上弟兄们，都带上家伙什。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "坤哥，我们真的要对那位林小姐下手？她不是新话事人吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "哼，当话事人也要下面的人支持才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "她刚上位就敢越过张哥在这里搞事，真当贫民窟是她林家的地盘了？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "但、但她毕竟是鼠王的女儿，这背后难保没有鼠王的意思......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "以鼠王他老人家的脾性，他要动张哥，还用得着借他女儿的手？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "这......难道鼠王就任由他女儿乱来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "林小姐做事的风格跟鼠王不一样，这点大家都知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "她喜欢跟白道上的家伙们打交道，这点大家也都看在眼里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "只是没想到，她会做得这么绝。一上位，直接把贫民窟几十年来的规矩一脚踢开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "我看啊，连鼠王也未必料得到，自己的女儿敢做这么忘本的事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "你听好了，我们不是要对林小姐动手，我们是要替鼠王教育教育他的女儿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "坤哥教训的是，我这下明白了！我这就召集兄弟们！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "看来张叔早有准备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "放心，就是让下面的人也来吃一顿，热闹热闹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "张叔也是要给林大哥交代的，不会对你做什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔还是不明白，我爸已经不管事了，你想对他有什么交代？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "林大哥说不管事，就真能不管了？贫民窟上上下下有多少人还是只听他的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "侄女真以为，没有那些人的支持，你能当这个话事人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我有自己的人脉，也有自己的生意，这些和我爸都没有关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "哎呀，侄女，听张叔一句劝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "年轻人想撇下我们这些老东西，觉得我们跟不上时代，我懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "但是，有些东西，不是你想撇下，就能撇下的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "退一步说，你今天让张叔下不来台，明天林大哥想和老兄弟叙叙旧，还怎么叙？后天，你王姨想和你母亲一起去逛街，这街还逛不逛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "你这孩子平时做事滴水不漏，到这一点上怎么就犯傻了呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "是张叔太把人情当回事了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "你这孩子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "罢了罢了，本来张叔也不想做得这么绝，不过，看来是得给你下一剂猛药清醒清醒了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "喂，老李啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "医院的事，落实一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "王局，还记得我吗？我是瑞翔建筑的李敏恒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "记得，怎么不记得。托李总的福，我才知道大地上还有那等美食。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "哈哈，知道王局长对美食有讲究，我才特地托人从雷姆必拓搞了一些山珍过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "可以可以，我就知道，你这个朋友交得值得。以后有什么需要我帮忙的，尽管说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "哈哈，不瞒您说，贫民窟的医院，您知道吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "当然，这事可不小，老百姓都关注得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "不过，它的竞标已经结束了吧？我记得，是贫民窟的一家公司中标了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "唉，您也知道，我们小本生意，想做出头不容易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "这项工程，我们原本势在必得，谁知道被贫民窟的人抢了头筹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "话虽如此，老李，那家公司是合法竞标、合法中标的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "我知道，但您可能没发现，他们提交的文件里，有点纰漏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "你确定？只是一点小问题的话，可没法改变结果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "但是，它也有可能影响结果，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "我只是想先和您打一声招呼，之后我们投诉的时候，您只需要点个头就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "其他的事，绝不会烦扰到您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "我从玻利瓦尔又搞了一些好货，下个月送到，到时请您来尝尝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "......哈哈，好好，没问题！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "好了，这下，侄女可以安心吃火锅了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......不急。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我有些问题想先问问张叔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "你问，只要是张叔知道的，都可以告诉你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "龙门常会接收一些荒野上的流民，这些流民大多被安置在贫民窟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "为了防止流民数量过于臃肿，魏总督受命和其他国家洽谈，签订了一系列的援助合约，旨在让背井离乡的人能够回到家乡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "但是每到这种时候，总会发生一些失踪案件，有的是人到了地方却消失了，有的则是人明明不在援助名单上，却从贫民窟消失了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我一开始以为只是巧合，但随着调查的展开，我发现是有人借着援助的名义，在进行人口贩卖的勾当。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔确实好算计，每次都会联络不同的买家，卖出去的人也都会有意地打散，把他们送去不同的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我花了几年，终于找到一点线索。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔还认得这些照片上的人吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "林雨霞从随身的提包中取出几张照片，照片中是几个瘦弱的人。"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "不记得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我猜也是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "都准备好了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "是，弟兄们都过来了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "什么人？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤的手下",
      "text": "咕......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "谁敢在张哥的地盘撒野！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "咕哈......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胖坤",
      "text": "你、你到底是什么人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "出来吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "是他吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愤怒的男性",
      "text": "......没错，是他，我永远记得他的嗓音......就是他害死我爸的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恐惧的女性",
      "text": "我也记得！是他，是他害我在乌萨斯的矿场待了十几年！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的老人",
      "text": "没错......没错......化成灰我都记得他身上的纹身......是他没错，是他把我卖到了雷姆必拓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "他现在动不了了，林小姐说了，你们想怎么样都行。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "这些人见到胖坤，脸上又惊又怒，听到林雨霞的手下这么说后，其中几人壮着胆子上去给了胖坤几脚。\n但大多数人，还是畏缩地站在后面。\n他们脸上更多的，还是这些年在外担惊受怕的恐惧。"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "各位，林小姐让我向你们保证，从今往后，你们夜里再也不会做噩梦了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "因为——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "都不许动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "附近有斗殴声，怎么回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "你们看，龙门近卫局会为你们主持公道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "......你是臭老鼠的人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "诗怀雅局长，我在这里代替林小姐向您举报，张文浩手下的胖坤一行人，这些年来一直都在进行人口买卖的违法勾当。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "人证就在这里，物证......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "也在这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "相信您会还这些人一片朗朗乾坤。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "......*龙门粗口*，臭老鼠，算计好了是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞的手下",
      "text": "林小姐只是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "行了。把胖坤这伙人带走，然后把这些证人保护起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "臭老鼠的人也别想跑，带回去做个笔录。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "局长，您要去哪儿？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "......吃个火锅。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "侄女有所不知，当初有多个国外的黑帮想要在贫民窟扎根。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "林大哥虽然厉害，却也双拳难敌四手，若非我扛下了这部分压力，林大哥未必能在贫民窟站稳脚跟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "侄女，你当时还未出生，不知道其中的险恶，我不怪你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "爸常说，若不是你当年主动站出来，贫民窟难免又是一场腥风血雨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "但爸不知道，他感激的人，暗中却和这些黑帮达成了合作，协助他们进行人口买卖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "当时是形势所迫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "总有办法。就算当时没有办法，后来也该有办法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔，时至今日，到底有多少是形势所迫，有多少是掩耳盗铃，又有多少......是无法自拔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "侄女，你没经历过当年的事，就别拿一副什么都懂的语气来说这些话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我确实没经历过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "但有些事，我宁可没有亲身经历。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔，你去找过这些人吗？帮助过他们吗？为他们做过什么吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "你见过他们在物是人非的旧宅前失落的样子吗？见过他们在亲人的坟前哭吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......侄女，省省吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "你难道以为，说这些话就能让我动摇吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔知道的，我没有这么天真。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "只是给张叔提个醒，怕张叔忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "不过，这张照片上的人，张叔肯定记得。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "林雨霞又从包中取出另一张照片。\n照片上，是瘦子张、李总裁和王局长在酒席上欢声笑语的场面。\n瘦子张的面色瞬间阴沉了下来。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "长官，姓李的离开王局长办公室了，怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你们去盯着姓李的，我去和王局长谈谈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "......请进。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "王局长，我是近卫局的督察星熊，有些话想和你聊一聊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "近卫局的长官，您来得正好，我要向您举报......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "不，是自首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "我自首，我在过去包庇了部分企业的违法竞标行为。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "同时，我举报，瑞翔建筑的李敏恒，想要非法改变贫民窟医院的中标结果。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "他刚才来找过我，我把我们的对话全部录音了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "还有，他背后的首恶，贫民窟的张文浩，这些年来多次用贿赂和暴力手段暗中控制商业招标竞标活动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "我手上有充足的证据。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......是谁让你这么做的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王局长",
      "text": "......没有人，长官，这都是我自愿的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "......林小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "真是了不起。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "“李敏恒”......对许多贫民窟的人来说，这个名字不算陌生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "许多贫民窟的基建都是他的公司承办的，说他是贫民窟的大善人也不为过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我始终记得，小时候爸告诉我，贫民窟的这些楼、那些厅是张叔的朋友李先生建的时，心中对他的感激。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "甚至可以说，我想要为贫民窟建第一所公立医院的契机，就来自他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "但是，当我自己学习这些知识，踏上这条道路后，我才知道，他和政府官员勾结，骗取了多少投资和补助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "那些我曾经引以为傲的建筑，实际上都是用便宜的材料以次充好造的。他从建筑款中榨取的利润，数以千万计。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "而唆使他走上这条道路的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "也就是你，张叔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......是他先找到我的，是他先跟我说，这里面大有可为。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "是你先，还是他先，有什么区别呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "最终，是你们共同攫取了贫民窟万千穷苦人家应得的利益，化作自己享乐的资本。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "这些年，有些事，张叔确实瞒了你爸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "有些是身不由己，有些是一念之差。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "想到这些事，心中对林大哥总是愧疚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "被侄女点出来，这么一承认，心里反而释然了一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "只不过，这样的话，张叔今天就更不能让你走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "抱歉，侄女，你得跟张叔走一趟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "等到我安全——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "老李，怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "老张，救我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "近卫局的人忽然找到我，把我带进局子了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "你说什么？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "李总裁",
      "text": "喂，老张，别挂——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......啧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "胖坤也在局子里了，想见自己去局子里见。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "通讯声还没响两下，诗怀雅就从酒吧门口走了进来，随手把胖坤的通讯终端丢在瘦子张的面前。"
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔还要打电话吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我可以替你打，师爷李、鬼眼、王经理、陈部长......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "林雨霞说着，从包中掏出通讯终端，盯住瘦子张。\n瘦子张没有理会林雨霞，手握着通讯终端，靠在椅子上，脸色不断变化。\n大势已去。\n最终，他闭上眼，深深呼出一口气。\n一瞬间，他仿佛老了十岁。"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "张叔，出来混，早晚都是要还的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......你王姨怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我会亲自去向王姨说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "小张哥的学业也不会受到影响。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "当年，我也和你一样，以为自己能守住原则。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "结果一步错，步步错啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "替我跟林大哥说一声，就说......张文浩对不起他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我会的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "瘦子张",
      "text": "诗怀雅局长，带我去见胖坤和老李吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "警车就在外面，还要我送你吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "小时候，张叔对我很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我还记得八岁的时候，有一次，他为了逗我开心，把他新买的高档手表丢进了井里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "那你还真是一只没心没肺的死老鼠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我就是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "别以为我会领你的情，近卫局本来就快抓到瘦子张的把柄了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我只是在解决家里的顽垢而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "喔，那还真了不起啊，我们的林女侠，刚从玉门回来，就帮近卫局除掉了一根眼中钉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "不仅能神不知鬼不觉地把人带进贫民窟，就连政府财务部门的人也能影响。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "要不然我去和魏总督说一声，你来当这个局长，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "有些事，现在只能这么做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "贫民窟跟龙门之间隔着的那堵墙，要慢慢拆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "如果我不知道，我还会好声好气地在这里跟你说话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "你猜我把贫民窟围起来，是为了抓你，还是为了保你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "你没蠢到非要今天抓我不可，也没好心到如果我露出破绽，还会放我离开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "知道就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "在你父亲的时代，龙门需要贫民窟。但这不代表，龙门永远需要贫民窟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "别告诉我，你忘了我们中学时说过的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "“没有人生来就该在贫民窟里过日子，总有一天，贫民窟里的人，也可以生活在阳光下。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我没忘，但我怕某个当初爽约的人忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "小心眼的女人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "这件事你还打算念几年？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "我是没心没肺的死老鼠，能有一件事拿来损你，当然会念到你死为止。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "啧，跟你聊天真是气人，我早晚得让星熊给我常备降压药。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "算了，反正，只要你还记得这句话，你还知道自己是在为谁谋福祉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "近卫局不会是你的阻碍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "这算是近卫局局长给我这个普通市民颁发的免死金牌吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "为什么不理解成是近卫局局长给你这个普通市民上的镣铐呢？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "诗怀雅说着，从怀中掏出一副手铐。\n一边铐在林雨霞的手上，另一边，铐在自己手上。\n林雨霞并没有反抗。"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "不管怎么说，你得跟我回去做个笔录。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "今天的事，给我一个交代。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "......呼，在贫民窟里跑了半天，我肚子都饿扁了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "先吃点火锅！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "臭老鼠，快下点菜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "为什么非得我来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "我这只手铐住了，动起来不方便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林雨霞",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "一把年纪了，又受了伤，一个人爬这么高也不怕摔着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "老朋友走了，腿脚不便，浇一碗酒，就当送别了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "是腿脚不便，还是没有脸面？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "......老友，你还记得当年那个拍着胸脯跟你说，只要有他在，就绝不会让你我少一根毫毛的愣头青吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "记得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "他为我做事三十年，我也让他享了三十年的福。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "只是，我也没想到，他瞒了我那么多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "我没什么对不起他的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "但你下不了手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "你也没想到你女儿会如此果断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "堂堂贫民窟的鼠王，躲在这里不想见女儿，说出去也不怕遭人笑话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "此言差矣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "如今我已不是鼠王，只是一个喜欢逛街弄羽的糟老头子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "女儿的成长超乎想象，我这个糟老头子高兴还来不及。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "你倒想得开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "我当然想得开，毕竟就算现在不想见，等会儿也要在一张桌子上吃饭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "反倒是我们的大少爷你，怕是想见也见不到啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "......哪壶不开提哪壶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "我依然是那句话，她若是打算回来，龙门会是她最好的后盾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "老友，我们都老了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "但龙门的未来，交给这些后生，我还算放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "你再这么说下去，老得更快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "林舸瑞",
      "text": "哈哈哈。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
