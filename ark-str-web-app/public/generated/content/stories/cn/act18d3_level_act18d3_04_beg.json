{
  "server": "cn",
  "storyId": "act18d3_level_act18d3_04_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_04",
  "title": "海洋",
  "storyCode": "SV-4",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act18d3/level_act18d3_04_beg.txt",
  "sourceHash": "0729a2c650feb8d3c53d321816b3fd33cecfffd594a0e60a05f3bd85085a501f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "长官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "退下。你不是她的对手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "但是我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "退下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "遵命！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你，强很多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "你不该踏入这座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我已经在了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "违背规则，就要付出代价。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我管不了那么多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "你会留在这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......我不想同你打。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "哼。邪恶的阿戈尔人，你一定是害怕了！有长官在，你绝对跑不掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "但，如果这是必须的话——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "（阿戈尔语）我将打败你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "好快，竟比刚才和我交手时候还要快许多！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "如果是这样的速度，我根本就连她的裙摆都打不中......她到底还藏了多少？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "攻击和闪避都越来越快，老师也是。我就要跟不上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "原来我......我还差这么多？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "不，这不行。那可是一个阿戈尔人。我才不能输给阿戈尔人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "可是这个阿戈尔人，她好像，还在拿着她的箱子当武器......那箱子是什么做的啊！为什么那么硬？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "不过，老师也没有用手炮。要是用上的话......瞬间就能把她拿下吧？连着这条街一起，都会一起被轰成渣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "然而......那只是一个阿戈尔人啊？她的模样，和那些怪物并不一样......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "她用的是......某种法术吗？我感觉不出来。我们的灯......也并没有能压制她的力量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "——这阿戈尔人身上藏着的秘密太多了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "长官！您果然赢了。我就知道，任何人都无法撼动您分毫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "咦，那个阿戈尔人呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "逃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "什么？这......怎么会？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "她受伤了，跑不了多远。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "我去找她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "你打不过她。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "咳咳......但绝不能让她这样的人在这片海岸恣意行走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "看方向，她应该是去居民聚居处了。她可能混入人群，当地居民之中有人在帮她。我会一间一间屋子找过去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "如果你认为这是对的，你就去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "好——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "长官，这座城市的异状，是她带来的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "我让你去看。你看到了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "这座城市里的人，他们的行为很不正常。每天就像没有醒着的时候。他们行动，却不是为了到达。他们进食，甚至不是为了饱腹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "他们正在往海里走，而且他们并不认为这是自杀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "你制止了他们？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "是。因为这显然是错的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "我们关心的，是结果。你认为你的纠正能有对的结果，那就去做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "对的结果......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "若不能，那你必须有所选择。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "判官——你的双眼，你的剑，需紧盯伊比利亚最大的威胁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "是，长官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "最大的威胁......是那些正在上岸的怪物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "难道说，这些正在走向大海的人，他们与这些怪物有什么联系？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "对......一定有联系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "老师说过，异常往往不是单一现象。这些恐怖的异象之间，必有关联。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "要解决问题——你首先要看清问题所在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "我、我知道！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "——是那些躲在暗中谋划一切的阿戈尔人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "他们潜伏在岸上，躲藏在我们律法的缝隙里，腐化我们城市的皮肉，动摇我们同胞的心志，试图侵蚀我们国家的筋骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "在他们的阴谋得逞、将这座城市拖入绝望的深渊之前——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "我们必须，将他们找出，抹除！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "歌手......歌手？你是不是在这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "我找了你好久。审判官一定不知道这地方，这里空屋子太多啦，到了晚上，可不好找。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "我知道......你肯定想躲着我们。你想离我们住的地方越远越好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "找到这里可真不容易......呼......这儿离海岸好近。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "这是海浪的声音吗？原来这么大。还有......我听到了呼吸声。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "歌手，你在这里做什么？你的吸气声音变得不大一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你们有危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "你说什么......呃，你怎么，你受了伤？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我流血了。快走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "想走？没那么容易。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "审判官？！难道是跟着我一路过来的......我、我没有发现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "我还不至于让一个普通人发现。咳，当然，即便不跟踪你，我也一样有法子找到这里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "又是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "怎么，是怕了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "刚才，咳咳，我承认，我一时疏忽，险些让你逃走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "但现在，阿戈尔人，我一定会将你抓住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "可、可是，她已经受伤了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "嗯？你确定要拦下我，保护这个危险的阿戈尔人吗，市民？这样的话，你会变成和她一样的罪犯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "我、我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "你和其他人都不一样。至少，你眼里还有害怕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "到现在为止，你还没有做错事。快闪开！我也不想用剑对付你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "不是时候——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "不是什么时候？你......你瞧不起我？你以为我一定没法拿下你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "哼，我确实不是长官。可我也已经做好了准备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "对付你，我会全力以赴！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "你、你什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "不要出声。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "放开我，你这个阿戈尔混蛋，你别以为按着我的手我就没办法用剑，我还有手炮——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "别吵。它们会发现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "唔唔唔......另一只手也......动不了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "呃，你们听，是不是有声音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "我听见了......黏糊糊的东西在地上摩擦......有好多好多......好像就在外面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "这是......什么啊？不是我们的人弄出来的，我以前从来都没有听过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "越来越近了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "数量，在增长。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "是什么引起的？这里的人，还是她们？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "十只——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "二十只。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "——仍在增长，仍在前进。有什么在吸引它们爬上海岸，涌进城内。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "而来的方向是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官",
      "text": "教堂。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "嗯？他们很兴奋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "text": "......你确定要像这样抚摸这些东西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "注意你使用的词语。他们可不是什么“东西”。他们已经是这片大海的一部分，成为了海的子嗣，比你要纯净得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "啊......潮汐的讯息已至。今夜又是特别的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "他们一定是闻见了气味。当有同胞加入时，他们总会变得很雀跃，很躁动，甚至想浮出海面，去陆上迎接。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "这很正常。我们都爱着自己的兄弟姐妹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "text": "你真当它们是你的兄弟？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "为什么不呢？在需要的时候，我也愿称陆上那些仍不得不用双足行走的为兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "如果你不是拥有最脏污的杂种血脉，有朝一日，你也能拥有这种机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "text": "哦？那真是可惜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "（触碰海水）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "有趣。今天晚上......他们好像格外有精神。或许因为有很多新老朋友都来家里做客。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "text": "你不好奇么？上面究竟在发生什么。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民C",
      "text": "......吵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民D",
      "text": "真的吵。睡不着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民C",
      "text": "把头塞在被子里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民D",
      "text": "听不见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民C",
      "text": "看不见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "呜......好饿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民C",
      "text": "好饿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民D",
      "text": "好饿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "铁皮......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "呜哇哇——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "这、这是什么鬼东西啊？！黑色的......花？还是鱼？为什么会动？好恶心，呕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "难道是......不对啊，这说不通！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "它们在拍窗！它们是不是......是不是想进来？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "不、不能让它们进来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "把窗关紧——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "没用的，这里的窗本来就是破的，你看上面，到处都是缝......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "——伸进来了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "呜哇，它还在动！就这一小块，趴在地上扭来扭去，朝我们不断地挤过来？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "就算是那种东西......也不该这么难缠啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "太多了......外面还有好多。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "这怎么都砍不完！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "我的灯......不行，灯对它们没什么用处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "......弹药只够再打一发。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "审、审判官？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "别动！待会我一开炮，你们俩就往里边跑。废墟总比这破窗牢一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "你的手在抖......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "神圣的经文......将给我力量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "我、我不怕它们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "我马上出去，能杀多少是多少，应该能挡上一阵，你们要跑快一点......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你，带着她躲到里面去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "啊？你在说什么啊！你没看见吗？我对付不了——这么多！很快它们都会进来。屋里和屋外没有区别！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "记住，离门窗越远越好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "你这人根本不听别人讲话——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我会出去。把它们引开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "什么？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "歌手，你也不能出去啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "你是很厉害，比我见过的人都要厉害，但你受伤了呀！而且这些怪东西，可、可太多啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "审判官也、也别出去了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安妮塔",
      "text": "我们一起躲躲？我、我知道这里有个橱柜，还能关上门，就在后头，我们三个人挤挤，应该也能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我必须出去。只有这样，你们才能活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "审判官",
      "text": "喂，阿戈尔人，就算要逞英雄，这里也轮不到你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "听好。这真的不关你的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "因为——它们是来找我的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "斯卡蒂推开门。\n久违的气味自海风吹来的方向钻入脑髓，从不属于陆地的生物密密麻麻地填满了街道。\n它们上下涌动着，吐息，缩紧，用行为模拟腐烂和生长，文明的疆岸在它们险恶的身躯下陷落。"
    },
    {
      "type": "dialogue",
      "speakerName": "怪物A",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪物B",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪物C",
      "text": "！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
