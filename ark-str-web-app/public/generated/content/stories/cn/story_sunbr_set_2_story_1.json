    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "休想......突破古米这一关！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "小心，古米！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "我会让他们慢下来......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真理",
      "text": "凛冬，趁现在！",
