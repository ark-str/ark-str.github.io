      "type": "dialogue",
      "speakerName": "沉默的赏金猎人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴沉的赏金猎人",
      "text": "少多管闲事，小家伙们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴沉的赏金猎人",
      "text": "你们会后悔。",
