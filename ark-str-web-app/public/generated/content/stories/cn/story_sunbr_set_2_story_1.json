    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "没错！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "赶快老实交代！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴沉的赏金猎人",
      "text": "哈，天真。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阴沉的赏金猎人",
      "text": "可惜了，这里知道那些小孩下落的只有我。",
