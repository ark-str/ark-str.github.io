    },
    {
      "type": "dialogue",
      "speakerName": "早露",
      "text": "虽然说得好像很轻松......但是大家应该知道这和之前的模拟训练不一样吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "没问题！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "古米会保护大家的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "呜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好重......！不过，古米可以撑住！",
