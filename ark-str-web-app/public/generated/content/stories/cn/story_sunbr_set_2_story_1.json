    },
    {
      "type": "dialogue",
      "speakerName": "凛冬",
      "text": "和他们废什么话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凛冬",
      "text": "喂，我问你们，这里就你们几个人吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凛冬",
      "text": "你们把这个村子的人怎么了，之前被你们绑走的两个孩子现在在哪！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的赏金猎人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的赏金猎人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沉默的赏金猎人",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凛冬",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
