  "stageId": "main_02-02",
  "title": "兵不接刃",
  "storyCode": "2-2",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_02-02_beg.txt",
