  "sourceHash": "b27c1a6e05798656d27d25afc3ba97efee5b17511e258e03e933d85673e90747",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——天空越来越暗淡了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "天际线仿佛被云层捏住了一样......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "明明空气很通透，乌云却静止不动，好像在把各处的压抑感通通抽出，凝聚在一处。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "连风都停下了......"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "天灾确实，即将降临在这座城市。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "看来，切尔诺伯格已经被整合运动彻底瘫痪了。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "不过，哪怕是要拆分移动城市，也应该提前数周就完成准备工作。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "难道在那时候，整合运动就......？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "不太现实。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "现在的整合运动，并没有体现出秘密接管所需要的精英部队素质。"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerId": "char_013_riop",
      "text": "整合运动的大多数成员......不过是在街头游荡，向切尔诺伯格人寻仇。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "仅仅是在各处重复着杀戮和战斗，使整个城市陷入战火。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "天灾降临时，就连无比坚固的切尔诺伯格都会被撕得粉碎——"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "变成布满源石的巨型废墟。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "无论整合运动想要的是资源还是名望，都只会一败涂地。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "他们真能和乌萨斯军方正面对抗吗？即使乌萨斯的指挥系统陷入了混乱......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "乌萨斯的军事力量，怎么还没有集结反攻？"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "从我的经验来说，一般暴乱发生后，不出片刻，暴徒就会被全副武装的军警清剿。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "虽然，我们刚才也见证了一小撮军警被整合运动围攻的景象......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "那个蒙面的整合运动头目，即使是有一点不同......但她也没有能够吞没一城的水平。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "除非......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "除非什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "我以前经历的战争中......"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "也有行为与整合运动的掌控者如出一辙的领袖。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "于他而言，士兵不过是棋子，达到目的后就可以随意丢弃。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "既合理高效地运用兵力，又在不需要的时候放纵其自生自灭......"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "因为训练与管理的成本太高了。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "所以，他只是放养他们？"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "对。大多数时候，他只要把仇恨和恐慌当做口粮，喂养他们......"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "只需在必要时，轻轻地推一下——追随者就会振臂高呼。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "如果整合运动的运作，真如他们宣传的那般......"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerId": "char_013_riop",
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerId": "char_013_riop",
      "text": "穿上衣服，戴上标志，所有的感染者都可以是整合运动？"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "是的。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "他们确实......将源源不断。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "被压迫、想要呼喊的感染者太多了。这时候，无论整合运动给出的是怎样的出路......"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "只要在铁屋子上钻个口，哪怕外面就是一片火海，里面的人依然会互相推搡着探出身子。"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "speakerId": "char_016_medic",
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "Dr.{@nickname}."
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "这和你我不同。即使我还没有完全信任你，但至少我信任你的能力。"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "与你完全不同......"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "这种领袖并不是指挥官。"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "践踏敌人，同时也践踏同伴，又或者说，“随从”，的生命。"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "也许连随从都算不上，整合运动的暴徒，不过是领袖的棋子。"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "这样的人，是暴君。"
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "speakerId": "char_014_riope",
          "text": "无论敌人是谁，我们都会完成任务。"
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "speakerId": "char_014_riope",
          "text": "以前有人训导过我和我的队友——"
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "speakerId": "char_014_riope",
          "text": "“如果是棋子，那就吃掉；如果是堡垒，那就攻陷；如果是王权，那就推翻”。"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "Ace......稍等一下。"
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "speakerId": "char_014_riope",
          "text": "Dr.{@nickname}，正前方，盘踞着敌人的轻装甲部队。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "我们被发现了吗？"
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "speakerId": "char_014_riope",
          "text": "还没有。"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "但是......"
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "speakerId": "char_014_riope",
          "text": "我们避不开。这是这条路径中的最短路线，如果我们迂回，就会损失时间。"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "那没什么好说的了。无论他们是棋子还是暴徒，只要从战场上赶出去就好！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
