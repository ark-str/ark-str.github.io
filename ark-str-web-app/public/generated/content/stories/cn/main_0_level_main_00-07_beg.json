  "sourceHash": "b27c1a6e05798656d27d25afc3ba97efee5b17511e258e03e933d85673e90747",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——天空越来越暗淡了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "天际线仿佛被云层捏住了一样......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "明明空气很通透，乌云却静止不动，好像在把各处的压抑感通通抽出，凝聚在一处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "连风都停下了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "天灾确实，即将降临在这座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "看来，切尔诺伯格已经被整合运动彻底瘫痪了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "不过，哪怕是要拆分移动城市，也应该提前数周就完成准备工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "难道在那时候，整合运动就......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "不太现实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "现在的整合运动，并没有体现出秘密接管所需要的精英部队素质。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "整合运动的大多数成员......不过是在街头游荡，向切尔诺伯格人寻仇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "仅仅是在各处重复着杀戮和战斗，使整个城市陷入战火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "天灾降临时，就连无比坚固的切尔诺伯格都会被撕得粉碎——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "变成布满源石的巨型废墟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "无论整合运动想要的是资源还是名望，都只会一败涂地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "他们真能和乌萨斯军方正面对抗吗？即使乌萨斯的指挥系统陷入了混乱......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "乌萨斯的军事力量，怎么还没有集结反攻？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "从我的经验来说，一般暴乱发生后，不出片刻，暴徒就会被全副武装的军警清剿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "虽然，我们刚才也见证了一小撮军警被整合运动围攻的景象......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "那个蒙面的整合运动头目，即使是有一点不同......但她也没有能够吞没一城的水平。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "除非......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "除非什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "我以前经历的战争中......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "也有行为与整合运动的掌控者如出一辙的领袖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "于他而言，士兵不过是棋子，达到目的后就可以随意丢弃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "既合理高效地运用兵力，又在不需要的时候放纵其自生自灭......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "因为训练与管理的成本太高了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "所以，他只是放养他们？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "对。大多数时候，他只要把仇恨和恐慌当做口粮，喂养他们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "只需在必要时，轻轻地推一下——追随者就会振臂高呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "如果整合运动的运作，真如他们宣传的那般......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "穿上衣服，戴上标志，所有的感染者都可以是整合运动？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "他们确实......将源源不断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "被压迫、想要呼喊的感染者太多了。这时候，无论整合运动给出的是怎样的出路......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "只要在铁屋子上钻个口，哪怕外面就是一片火海，里面的人依然会互相推搡着探出身子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "Dr.{@nickname}.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "这和你我不同。即使我还没有完全信任你，但至少我信任你的能力。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "与你完全不同......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "这种领袖并不是指挥官。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "践踏敌人，同时也践踏同伴，又或者说，“随从”，的生命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "也许连随从都算不上，整合运动的暴徒，不过是领袖的棋子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "这样的人，是暴君。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "无论敌人是谁，我们都会完成任务。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "以前有人训导过我和我的队友——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "“如果是棋子，那就吃掉；如果是堡垒，那就攻陷；如果是王权，那就推翻”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "Ace......稍等一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "Dr.{@nickname}，正前方，盘踞着敌人的轻装甲部队。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我们被发现了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "还没有。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "但是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ace",
          "text": "我们避不开。这是这条路径中的最短路线，如果我们迂回，就会损失时间。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "那没什么好说的了。无论他们是棋子还是暴徒，只要从战场上赶出去就好！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
