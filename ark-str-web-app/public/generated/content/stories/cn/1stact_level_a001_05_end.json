{"server":"cn","storyId":"1stact_level_a001_05_end","groupId":"1stact","stageId":"a001_05","title":"各抒己见","storyCode":"GT-5","avgTag":"行动后","sourcePath":"vendor/ArknightsGamedata/cn/gamedata/story/activities/a001/level_a001_05_end.txt","sourceHash":"d1f892edb681cfeb0f3301e61ff9f807a7b0fff9d6f9c1593fb7376440ffb775","bodyAvailable":true,"blocks":[{"type":"narration","text":"第五关（后）"},{"type":"background","backgroundId":"bg_caveentrance"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"呃......！"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"你，你这个碍事的混蛋小子！"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"都、都头破血流成这样了，还敢在这挡我们的好事——！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"区区这点伤，连日常训练都算不上！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"咕——"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"还剩多少人？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"算了，记不清了，反正已经全都挡住——"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"发、发生地震了？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"欸？那边的山岩怎么崩塌了？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"骗人的吧？她居然打破了那么厚的石壁？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"入口被打开了一条新的路！赶紧进去！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"糟了，那些人一定会从斯卡蒂打出的通道涌进来！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"得赶快去帮可——"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"站住。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"斯卡蒂——"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"居然能直接破坏山体，强行穿过去，罗德岛的异闻果然是真的啊。"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"那个女孩在哪？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"我不能告诉你。"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"盯上那东西的人不止我一个。"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"难道我非要把你好好教训一顿，你才不会碍事？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"你突然就要带走可萝尔，我怎么也不能轻易把她交给你啊！"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"你要......阻碍罗德岛的任务？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"你也没告诉我罗德岛给你分配了什么任务啊！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"除非你......"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"不要突然攻击同伴啊！"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"谁是你的同伴？"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"我最后一次问，带我去见那个女孩。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"只要她还是我的委托人，我就绝不会这么做。"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"呜呃......"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"可恶，她只是用剑随手碰了下我的枪而已啊，可我的胳膊好像要断了......"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"只凭你这种能力，你真的认为自己保护得了她？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"能不能做到，和去不去做是两回事！"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"————"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"嗯？先等等！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"小心！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"嘁，这下总该打中了吧！"},{"type":"dialogue","speakerName":"粗暴的赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"好像有，不对，好像没有！那家伙还好好的！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"......又来？"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"呃......！"},{"type":"dialogue","speakerName":"粗暴的赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"灾、灾星！把上尉打伤的，就是你吧！你今天就别想从这里——"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"好机会，趁现在！"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"你也别想过去！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"你们还是想想办法先拦住她吧！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"——咦？"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"什么情况？！那个小个子，从我们头上跳过去了？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"斯卡蒂，我先走一步了！"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"你......"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"不好意思！等你想清楚，准备告诉我事实了，我再考虑可萝尔的事！"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"站住，你去哪里！"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"抱歉！"},{"type":"dialogue","speakerName":"粗暴的赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"你怎么就放她走了！"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"她跑得太快了，我们追不上她啊！"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"粗暴的赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"没事，这不是还有一个吗。"},{"type":"dialogue","speakerName":"粗暴的赏金猎人","speakerId":"avg_npc_007","isRemote":false,"text":"你个子那么大，不可能也跳过去吧？"},{"type":"dialogue","speakerName":"斯卡蒂","speakerId":"char_263_skadi","isRemote":false,"text":"你们完蛋了。"},{"type":"sceneBreak"},{"type":"background","backgroundId":null},{"type":"background","backgroundId":"bg_cave_2"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"岔路好多啊。这里就是可萝尔所说的墓穴了吧。"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"呃，赏金猎人——"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":null,"isRemote":false,"text":"咕......救命......"},{"type":"dialogue","speakerName":"赏金猎人","speakerId":null,"isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"太惨了吧？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"就像是被罗德岛号来回碾压过好几遍......"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"可、可斯卡蒂不是还没进来吗？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"这个看上去像炸开的洞是？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"也就是说——"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"你已经想明白了。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"？？？","speakerId":"avg_npc_010","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"？？？","speakerId":"avg_npc_010","isRemote":false,"text":"我哪里演得不好吗？"},{"type":"dialogue","speakerName":"格拉尼","speakerId":"char_220_grani","isRemote":false,"text":"你果然是————"},{"type":"sceneBreak"},{"type":"background","backgroundId":null}],"observedOperators":[{"speakerId":"char_220_grani","aliases":["格拉尼"]},{"speakerId":"char_263_skadi","aliases":["斯卡蒂"]}]}
