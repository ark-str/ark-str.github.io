{
  "server": "cn",
  "storyId": "main_14_level_main_14-08_beg",
  "groupId": "main_14",
  "stageId": "main_14-08",
  "title": "应对饱和打击",
  "storyCode": "14-9",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_14-08_beg.txt",
  "sourceHash": "50c826f9bb049267d0cfa30eb891b200105d9a19c0ef0ed8bc642cd09c95a413",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "赦罪师的“奇美拉”",
      "text": "（嚎叫）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "呼......嗬......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "还有一个。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萨卢斯",
      "text": "没有那么简单哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卢斯",
      "text": "可爱的小魔王，你已经弄坏了我的五头宠物——让我猜猜看，你还能坚持多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "你把这些巫术制造的生命当作消耗品，就为了拖住我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卢斯",
      "text": "造这些奇美拉的确费了我一点功夫。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......残忍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卢斯",
      "text": "你总是这样到处播撒过剩的同理心，就和特蕾西娅一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卢斯",
      "text": "她输给特雷西斯的时候，首领本想借机回收“魔王”，不料她临死之前，硬是把王冠给了你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卢斯",
      "text": "很隐蔽的谋划。我们那么多的探子，没有一人提前发现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卢斯",
      "text": "你是不是也被她骗了过去——“博士”？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我不知道你在说什么。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我对此一无所知。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "真可怜呀，你什么都不记得了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你拼命“侍奉”这位魔王，究竟是出于上一位魔王的操纵，还是发自内心地爱着她？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "这我还是能分辨的。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你别胡说八道了。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我和阿米娅的关系，不是你能置喙的。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "奎萨图什塔的野心会给萨卡兹带来更深重的伤害，特蕾西娅小姐不可能放任他篡夺“魔王”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "......小兔子，别说这种不痛不痒的空话了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "随便问一个卡兹戴尔街头的普通人都知道，对萨卡兹而言，魔王的离去才是更深重的灾难。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "对了，也不要谈论什么公平。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "魔王的传承本就充满了偶然，特蕾西娅做的事，和我们做的也没什么差别。我们都是想让这股力量变得更可控。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "我们首领更相信血与灵魂的联系。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪师的“奇美拉”",
          "text": "（嘶鸣）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "他们的痛苦......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "这些情感，也是被巫术灌注和操控的吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "奇美拉在破坏周边的晶簇。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "源石活性在上升！",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "呃——！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅，源石活性的变化......非常迅速！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士，不......不用担心......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "赦罪师的巫术，我会习惯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "这几年我一直在学习，我记得特蕾西娅小姐教我的施术方法，也记得凯尔希医生的所有叮嘱。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我能清晰感觉到自己和“魔王”的联系。它并没有离开我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "咳......咳咳......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "只是......有一点点痛罢了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "徒劳而已。去吧，那个人已经没有价值了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪师的“奇美拉”",
          "text": "（吼叫）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "疯狂的奇美拉朝你冲过来。\n从切尔诺伯格到伦蒂尼姆，你已见过各式各样的敌人，其中许多都超出你的想象。\n但眼前的敌人依旧是看起来最为强壮的一类。\n他们是赦罪师摆弄“血脉”的成果，是萨卡兹强壮身躯的极致体现。\n萨卢斯说萨卡兹强于卡特斯，而你很清楚，阿米娅的身体也远强于你。\n可你仍有优势。不可取代，不同于任何人的特殊之处。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪师的“奇美拉”",
          "text": "（吼叫）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "——不可以！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "魔王的黑色线条贯穿了来到你眼前的一头奇美拉。\n但另一头奇美拉的爪子即将碰到你的头顶——"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "差不多了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（退后一小步）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "刚才你站立的地方，晶簇正猛烈地增殖。\n一团接着一团，就像被法术催开的花。从地面到岩壁，都被尖锐的石头撕裂贯穿。\n离你最近的奇美拉也一样。庞大的身躯轰然倒地，源石粉尘四处飞溅，相互摩擦碰撞，炸成一片夺目的金色。\n与计算结果一致，在巫术能量的激发下，周围的源石到了崩毁的临界点。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "许多细小的结晶落到你的面罩上。\n你看着它们，没有丝毫负面感受。\n源石从来都不会伤害你，你再一次从内心深处意识到了这一点。\n而其他人不同。\n阿米娅和萨卢斯的眼中都有本能的恐惧。阿米娅依旧在坚定地靠近你，而萨卢斯则微微有些迟疑。\n就是这一瞬。只需要这一瞬——"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "“束缚”。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "我的手和脚......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "女妖！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "萨卢斯几乎就要发出尖啸。\n但紧随而来的咒文提前封堵住了她的力量。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "你的声音过于刺耳。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "摆弄皮毛，却对如何编织韵律一无所知。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "是时候了。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "萨卢斯——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "黑色粒子不再环绕你，而是化作了一柄利剑。\n你忍不住看向蓝发赦罪师的面庞。\n所有的情绪都褪去了，她近乎平静地接受了这致命一击。"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "啊......这就是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "魔王对我的宣判。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "你......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "别误会，我很努力地想活下去的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "没能替首领捕获魔王，我犯的错够大了。所以我才会被你身边那个狡诈的家伙欺骗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "为了这一次的生命，我总该尝试着，将功赎罪吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "你甘愿为了奎萨图什塔的野心牺牲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "他是我们的......父亲，我们的起源，我们无法违抗的唯一。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "我真的好讨厌奎萨辛娜。我也讨厌你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你们为什么，觉得自己应该反抗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "阿米娅——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "我们难道不都是......被寄托了希望的奇美拉？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "“蔽障”。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "爆裂开来的血雾被看不见的力量挡住了。\n片刻后，遮蔽视线的血雾渐渐散去。整个洞窟都安静了下来。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "萨卢斯逃跑了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "她催动了从伤口滴下的血液。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "她无法完全抵抗我的咒文。她的举动只会进一步撕裂自己。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "只要没有彻底杀死萨卢斯，她就会想办法逃走。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "如她所言，她很珍惜“这一次”生命。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "猜猜看，她会逃到哪里去？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "她的任务大概是守卫“提卡兹之血”吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "既然没有办法在假祭坛拦住我们，她一定会回到真正的祭坛。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那前路很清晰了。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Logos留下了标记吧？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "如您所期待的那样。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士，虽然我能理解你刚才的计划，但这太冒险了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我不能赞同你的做法。下次你还要这么做的话，我......呃，我会生气的。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我会注意的。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "但时间紧迫。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "是的，我们得抓紧了。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "凯尔希盯着地上的一件物品。\n你发现，那是萨卢斯仓促之中遗落的赦罪师面具。"
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "我们低估了奎萨图什塔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "之前，他突然在我和闪灵面前出现，掳走夜莺，并展露了自己篡夺“魔王”的意图。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "为了这一刻，他在卡兹戴尔的阴影里蛰伏了数千年。他绝无可能在目的达成之前得意忘形。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "他想让别人以为，他所图的只是黑冠。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "连抢“魔王”都是过程？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "他要用“魔王”做什么？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "“魔王”是中性的力量，它究竟能推动还是阻止灾厄的降临，取决于使用者怎么想。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "这极有可能是奎萨图什塔也想要“魔王”的原因。他要权限回到手中，触碰流传万年的秘密，从原点中寻求更大的力量。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "“阿喃那”。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "最初的源石。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "奎萨图什塔，杜卡雷，还有特雷西斯，他们最终的目的可能各不相同，但目前都指向了同一个方向。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "萨卡兹从来都深受源石的影响。我有些担心，这影响正在被刻意导向......\n或者不受控制地走向更深的层次。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "呜......嗯，这样就好了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "你的身体状况稳定了下来。Logos说，赦罪师遗留的巫术也已经全部清除。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "谢谢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "......至少三枚戒指出现了裂痕。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "只是一些战斗损伤，没什么大碍的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "问题不在于戒指，阿米娅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "从指挥塔之战开始，你是否就一直背负着过多的情感与回忆？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "嗯......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "它们从未离开过你。是你自己的精神在撕裂这些戒指，任何器具都无法承受这么庞大的情绪洪流。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "戒指不行，我可以。我不是器具。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "这些情感最初是有人强加给我的。后来，是我选择了走近，触碰，感受。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "说一点都不难受......是撒谎。我不想对任何人撒谎，也不想欺骗自己，当作这些痛苦不存在。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "但我适应得差不多了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "这如同在泥沼中负重前行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "阿米娅，我建议加固这些戒指。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我需要更强的力量，来救更多的人。我跟您说过许多次，这就是我的愿望。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "博士，阿米娅的情况怎么样？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不是很理想。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "还能勉强控制住。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "所有的问题都只能暂时得到缓解。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "与切实的疾病与伤痛相比，目睹自己与周围的一切滑向深渊时的感受同样煎熬。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我改变不了她身为感染者的事实。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "如果我真的能治愈她就好了。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "阿米娅的意志很坚定。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "特蕾西娅殿下第一次把她带到我们面前的时候，她还无比稚嫩。我还记得，她的视线在我的角羽上停留——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "她是什么反应？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Logos",
              "text": "毫无畏惧，只有友善的好奇。即便是我，也有些许惊讶。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "你是什么反应？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Logos",
              "text": "即便是我，也有些许惊讶。这个孩子眼中毫无畏惧，只有友善的好奇。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我本想和Scout他们一起退后些，可阿米娅主动走近了我们。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "当时的巴别塔核心成员依旧以萨卡兹为主。我们头上形状各异，甚至称得上狰狞的角，还有身上的结晶都很醒目。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我曾见过几支雷姆必拓的商队，我知道，那些温和胆小的卡特斯在直面萨卡兹的时候，很难克制本能的恐惧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "或许是天性使然，又或许是她被......教得很好。阿米娅并无区分萨卡兹与他族的意识。她自然地用温柔关爱所有人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "因此，得知特蕾西娅殿下选择阿米娅作为自己的继承人时，我并无丝毫意外。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "即便你是王庭之主......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你也支持阿米娅继承“魔王”。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......对我而言，这绝非抉择中最为艰难的部分。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "博士，方才我遇到了几位故人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "其中包括一位巴别塔的战友，当年是我亲手杀死了他。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "什么？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "为什么？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "特蕾西娅殿下死后，罗德岛上曾发生过一场叛乱。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "一些巴别塔成员不赞成放弃战争。他们和一部分萨卡兹战士站在一起，认为我们应当复仇，应当回到卡兹戴尔夺回权柄。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "更有甚者......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他们主张杀了阿米娅。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "他们想对凯尔希动手。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......本属于魔王的队伍将彻底背离卡兹戴尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "他们认定，这是一种卑劣的偷窃，一场可鄙的背叛。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "而凯尔希医生和其余不是萨卡兹的巴别塔成员，是作此谋划的罪魁祸首。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "他们都曾是追随特蕾西娅的战士。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "他们都曾是巴别塔的人。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "他们中的相当一部分都相信着特蕾西娅殿下，甚至愿意为她和巴别塔的理想付出生命。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我杀死的那个人，就差点战死在军事委员会的术师面前。我救过他一次，又亲手夺走了他的性命。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "这一定很艰难。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你一定很痛苦。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "巴别塔成员Logos已经做出了相应抉择。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "那场叛乱之后，雇佣兵和萨卡兹战士几乎都选择了离去，巴别塔正式成员中，也仅有少数选择留下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "巴别塔不复存在，凯尔希医生禁止......任何人提起“魔王”。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你呢？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你为什么留在了罗德岛？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "殿下死后，我确实准备回河谷一趟。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "卡兹戴尔失去了魔王，谁都无法预料未来的走向。我既已是女妖王庭的主人，就不能逃避对河谷的责任。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "临行前，Scout拉着我，说他跟Misery替我准备了一个欢送会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我说喝酒不在考虑范围内，刚换好的衣服不想弄脏。结果我发现，他们是找我......刷漆。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "刷漆？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "没想到是搞装修。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "他们正准备给本舰更换标志。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "来劝说我承担这份工作的人是Outcast，也不知道可露希尔跟她说了什么乱七八糟的谣言——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "身为萨科塔，她居然对我说，女妖的咒文具有魔力，由我来改写标志，必定能让罗德岛未来的航行一路顺利。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那你写了吗？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Logos",
              "text": "那是可露希尔的职责所在，我告诫了我的同僚，不要纵容她的偷懒行为。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "不会真有魔力吧？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Logos",
              "text": "如他们所愿，我给涂料附加了一些咒文，来使得整个涂抹过程变得更加富有乐趣。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "好可怕。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "真有趣。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "这项工作还是很快完成了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "结束之后，我们所有人一起仰头看那个标志。Ace询问我何时离开，我对他们说了两个日期。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "一个是当天，申请离舰；另一个是三日之后。七十二小时是女妖河谷与当时本舰的停靠地点之间，来回所需要的最短时间。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "Ace听了，立刻问Scout要了五天的酒钱。Scout原本猜我会在河谷逗留超过一周。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "而Misery......他从兜里掏出一条“欢迎”的彩带，替换了原先开玩笑悬挂的“欢送”那条。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "真热闹啊。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你们是真正的好朋友。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我身上承担着不止一项责任，即便一项都不想放弃，也还是不得不有所偏重。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "但我始终清楚，我的决定并无差错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "自你从切尔诺伯格归来，我也并未询问过你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "你已无过去记忆，因何愿意留在如今的罗德岛，又因何甘愿涉险，深入眼前险境？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "“老财”",
          "text": "女妖阁下......Logos先生！前、前面的路突然断了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老财”",
          "text": "医生和魔王殿下让您尽快——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "新生的裂谷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“老财”",
          "text": "这么大一条缝，是突然之间冒出来的。那个蓝头发的赦罪师就是从这走的，我们的路走得没错。现在就......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "源石对地形的改变频率越来越高，严重程度也在加剧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我能感受到。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "阿米娅，你应当也能。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "地面......在颤动。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "萨卡兹的情感正和源石激烈地共鸣。他们的愤怒凝聚在一起，如同风暴一样，牵动着大地。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "在“提卡兹之血”和“阿喃那”的联合作用下，战场本身就是一座最大的战争法阵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "所有正在搏杀的萨卡兹，源石技艺都得到了强化，而变强的力量，也反过来在推动源石的蔓延。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "类似的情形也发生在万年前。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "萨卡兹通过接触源石获得了巫术，又通过巫术唤醒“阿喃那”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "之后数百年间，风暴笼罩大地，大地遍布裂痕。源石几乎完成了吞噬一切的使命。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你阻止了末日的到来？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "是你遏制了情况的恶化吗？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "我做不到，也不能这么做。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "在源石覆盖大地之前，战争结束了。神民、先民与萨卡兹都遭受了深重的损失，深重到了无力继续大规模的征伐。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "可那只是暂时的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......战争的循环，永无止境。",
