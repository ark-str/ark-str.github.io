{
  "server": "cn",
  "storyId": "main_4_level_main_04-03_beg",
  "groupId": "main_4",
  "stageId": "main_04-03",
  "title": "人工制冷",
  "storyCode": "4-3",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-03_beg.txt",
  "sourceHash": "3cd26ae46657471e9a35616a706636c9024647d93c10f695f6d332ec03245bae",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "好的，保持联络。嗅到气味就立刻告诉我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "按第三个键就行。嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "——嗯？Dr.{@nickname}？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯尔希",
      "text": "阿米娅呢？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅前往贫民区了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "——你居然让她一个人去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "......也罢，至少有人保护她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "你跟着去了，大概率也只是个拖油瓶。这次就不怪罪你了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "你也是一个人回来的？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "哦，企鹅物流。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "你也要更加关注自己的人身安全。我们不是每次都能雇佣到可靠的本地向导的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "Dr.{@nickname}——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "阿米娅不会在龙门逗留太长时间，毕竟之后还有任务。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "你还会再一次面对她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "——如果是我的话，会把当时没说出来的话，说出来。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "啊，博士？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "一直在等我吗......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "对不起，让你久等了",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "嗯？我的表情与离开时不太一样？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": ".....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "发生了些事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我觉得......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "也许陈长官，她也有着自己的想法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "即使她嘴巴很凶，即使她做了我难以接受的事情......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "但也许......我们之间的隔阂也没有那么大。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "她有她的责任。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......啊......原来是这样。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "她也承担了很多吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "也许我也......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅，你也承担了许多事情。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "是吗......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我......只是没有其他的选择而已。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "至少阿米娅你坚持了自己的选择。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......如果导致那样的结果，也算是坚持的话。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士没必要......这样安慰我的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "其实，我明白的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我不知道......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我不知道，我们走到哪一天，这片大地才会变得不同......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "但，我明白。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我不会放弃。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我会承担任何后果，因为......这是我自己选的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "你会......陪在我身边吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "尽管......这种愧疚，会一直存在......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "没能抓住大家的遗憾，没能救助朋友的遗憾......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "但我必须坦然面对。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "和罗德岛的大家一起——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "嗯？是凯尔希医生的通讯......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "凯尔希医生？请问有什么事？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "阿米娅，有几支侦查小队发来了消息。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "text": "情况变得有些刻不容缓。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "好的，我马上就来。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
