        {
          "type": "dialogue",
          "speakerName": "希瓦艾什家士官",
          "speakerToken": "avg_npc_286_1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "这......好吧。"
        },
        {
          "type": "dialogue",
          "speakerName": "切斯特",
          "speakerToken": "avg_npc_267_1#1$1",
          "operatorId": null,
          "portraitKey": null,
