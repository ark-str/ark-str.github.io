          "speakerName": "切斯特",
          "speakerToken": "avg_npc_267_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "那里即将成为战场，你过去会受伤的。"
        },
        {
          "type": "dialogue",
          "speakerName": "切斯特",
          "speakerToken": "avg_npc_267_1#2$1",
          "operatorId": null,
