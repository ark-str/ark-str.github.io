        {
          "type": "dialogue",
          "speakerName": "恩希亚",
          "speakerToken": "avgnew_173_slchan_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "我想要去登山。"
        },
        {
          "type": "dialogue",
          "speakerName": "切斯特",
          "speakerToken": "avg_npc_267_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "你要去登哪座山？"
        },
        {
