          "portraitKey": null,
          "text": "嘿！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（发出难以名状的叫声）",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "雅儿",
              "speakerToken": "avg_npc_250_1#3$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "哇，反而吓了我一跳......"
            }
          ]
        },
        {
          "label": "你的手好冰！",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "雅儿",
              "speakerToken": "avg_npc_250_1#7$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "回过神来啦？"
            }
          ]
        },
        {
          "label": "（下意识地反击）",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "雅儿",
              "speakerToken": "avg_npc_250_1#4$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "呜哇，你的手好冰啊......"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "雅儿",
