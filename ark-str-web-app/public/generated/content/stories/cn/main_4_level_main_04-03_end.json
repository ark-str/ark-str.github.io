  "storyId": "main_4_level_main_04-03_end",
  "groupId": "main_4",
  "stageId": "main_04-03",
  "title": "人工制冷",
  "storyCode": "4-3",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-03_end.txt",
  "sourceHash": "2bc124dfdaa99b533ae5f1a36140f2bb8c7ac8c479ff5bd30b62e427e210c119",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动",
      "text": "动作快！......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "怎么会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（别出声！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "（唔——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（他们还在吗？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（还在......！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（似乎是在找什么东西——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（——有一个整合运动，望向我们这边了！撤回掩体！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "是我的错觉吗。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（能不能狙击他们？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（我们与敌人距离太远了......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（自从他们出现以后，爆炸声就停止了......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（他们的站位很分散，我不可能一次性消灭全部三个。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（而且那些整合运动的动作，和普通的暴徒有明显的区别。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "（其他整合运动，似乎没有那么厚重的装扮。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（没错。可见，一旦轻举妄动，只要有一个活下来、引来更多的暴徒，我们就危险了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（再加上，其中有一个人是术师的装扮，而且正在测试什么的样子。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（如果他们同样也有索敌式的法术......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（在我们的位置射出一发弹药，他们完全有可能感觉得到。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（所以结论是不能。明明是三对三，却像是被包围了呢。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（有点糟糕。我很讨厌这种感觉。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（猎人被更庞大的野兽逼入绝路，不得不藏起来的感觉。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（等等，他们似乎在与谁通讯——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（在这里是听不到内容的。让我去。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（不行，现在移动太冒险了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（太安静了。我们不知道敌人是什么样的感染者......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（如果有听力强化的那种，可就要遭殃了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（——他们在等什么？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（我感觉——很奇怪。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（是不是——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（杰西卡，你有没有......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "（我......我也......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "（温度又下降了......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "（我......好冷......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（难道就是他们......！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（——！杰西卡，你为什么咬住手指——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（在防止牙齿因为打颤相碰而出声。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（先不说是否必要，但这种素养，真是厉害的孩子。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（在我眼里，你也是孩子啊。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（——哈。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "（不要。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "（......回温了。那三个整合运动也离开了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "是在测试什么东西的功能吗——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "——带着冰寒一声不响而来，带着温度默默离开，只留下受害者在暗处瑟瑟发抖。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "可恶，这些家伙，确实很像传说中的雪怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "没准我蒙对了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "也许他们就是雪怪。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "......找到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "还是遭到冰封的墙体。但是，你们看——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "墙角掩埋着黑色的源石？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "果然。寒潮是从这个地点向外释放的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "墙体上能看到鲜明的纹路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "这块源石就是区域降温的中心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "——我在做佣兵的时候，营房里流传过一阵这样一个传说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "乌萨斯西北域有一支感染者游击队，一直在与乌萨斯为敌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "他们中，有一个铁塔般的怪物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "据说，没有任何东西能阻止它前进。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "盾牌会被挤压，武器会被折断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "那个怪物离开之后，留下的只有平地，灭绝了生机的平地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "而在那支游击队里，又有这样一支小队——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "他们就像是寒冬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "他们走过的地方，全数冰结。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "建筑轰然倒下，化作粉末，四散弥漫在空旷的战场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "而战壕中，躺满了被冻成冰块的乌萨斯士兵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "你是觉得......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "是的。我觉得他们就是那个传说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "——“雪怪小队”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "前进吧。我想我们快要找到整合运动的据点了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "你们有没有闻到一股......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "烧焦的味道？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
