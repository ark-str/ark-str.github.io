      "type": "dialogue",
      "speakerName": "阿玛雅",
      "speakerToken": "avg_npc_449_1#8$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "劳伦缇娜，我们为什么要在这个情况下相遇？"
