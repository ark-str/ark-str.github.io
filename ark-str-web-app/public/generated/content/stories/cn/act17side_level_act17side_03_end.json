      "speakerName": "蒂亚戈",
      "speakerToken": "avg_npc_451_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "这里是我们的家。我们花再多时间，再怎么抱怨也改变不了这一点。"
