      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "speakerToken": "avg_npc_451_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "来啊，懦夫，来啊，我要打得你满地找牙！"
