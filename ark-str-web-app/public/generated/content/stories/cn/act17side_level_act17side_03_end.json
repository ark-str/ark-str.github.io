      "type": "dialogue",
      "speakerName": "阿玛雅",
      "speakerToken": "avg_npc_449_1#13$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "你接触过一次海洋，但是没有立刻前往阿戈尔？我以为你们总是归心似箭的。"
