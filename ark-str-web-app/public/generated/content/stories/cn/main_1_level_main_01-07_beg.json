{
  "server": "cn",
  "storyId": "main_1_level_main_01-07_beg",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "暴君",
  "storyCode": "1-7",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_01-07_beg.txt",
  "sourceHash": "3e01211e4517d1a167b4a0ef5ec31a34a94187b2a069bda5ad0e4fa1c2371d66",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "抗冲击准备！！"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "各自散开——！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "规模太大了......这样下去，整个街区的建筑都会被彻底摧毁！"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerId": "char_130_doberm",
      "text": "不行，糟了———！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "——！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "快转移！"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "speakerId": "char_016_medic",
      "text": "......！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "坚持住！！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": null,
      "text": "啊——！！掉，掉下来了！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": null,
      "text": "天空掉下来了！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": null,
      "text": "不，不，啊好疼......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": null,
      "text": "我的手，我的手！我的手哪里去了......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": null,
      "text": "怎，怎么会！！我不想死......！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": null,
      "text": "啊啊啊啊！！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "speakerId": "char_148_nearl",
      "text": "重装干员！"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "speakerId": "char_148_nearl",
      "text": "保护我方术师！！"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "speakerId": "char_148_nearl",
      "text": "——！！"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "speakerId": "char_148_nearl",
      "text": "那是什么声音？！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "巨大的坠岩击垮了临街的建筑！卧倒！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "speakerId": "char_016_medic",
      "text": "啊......！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——那个位置——医生！危险！"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerId": "char_013_riop",
      "text": "糟糕，医生，快闪开！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "医疗干员",
          "speakerId": "char_016_medic",
          "text": "啊！"
        },
        {
          "type": "dialogue",
          "speakerName": "医疗干员",
          "speakerId": "char_016_medic",
          "text": "......唔，博，博士？"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "speakerId": "char_013_riop",
          "text": "博士把医生推进了掩体？可这样......这样的话，博士——！"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "speakerId": "char_013_riop",
          "text": "不，博士！！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "Dr.{@nickname}！！"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "speakerId": "char_013_riop",
          "text": "啊？"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "speakerId": "char_013_riop",
          "text": "临，临光她冲出去了！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "博士，蹲下！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "咯......"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "赶上了！"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "speakerId": "char_013_riop",
          "text": "她救下......她救下博士了！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "咳哈......！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "临光！博士！快回来！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "没问题的！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "我的盾牌还撑得住——！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "跳啊，博士！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "跳！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "博士，博士......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "你，你没事吧？"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我没事，这算不了什么！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "多亏临光小姐救下了我。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "一个人......处在那样的危险中！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "至少拉上我一起，让我保护博士你！"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "无论怎样，我都不能允许你受伤——"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "何况，是在我面前！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "大家都还安全，就非常好了......！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "但我们......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "（还要坚持多久呢？）"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "（我们真的能活下来吗？）"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "......唔......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "坠石的数量减少了？"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "我们撑过了第一波主灾害了吗......"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "还不能大意，谁知道这次的天灾会持续多久。"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "不过至少......我们不是身处天灾正中心的人。"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "我们侥幸躲过去了。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "嗯......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "大家怎么样了？"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "speakerId": "char_013_riop",
          "text": "干员们基本都没事......！"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "speakerId": "char_013_riop",
          "text": "有些干员受了轻伤，但状况都还算不错！"
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "speakerId": "char_013_riop",
          "text": "我们......活下来了！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "speakerId": null,
          "text": "啊......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "整合运动也有部分人员——"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "speakerId": "char_1002_nsabr",
          "text": "......啊？"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "speakerId": "char_1002_nsabr",
          "text": "啊......啊！！罗德岛！"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "......什么？"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "speakerId": "char_1002_nsabr",
          "text": "啊......！！！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "整合运动还要继续攻击我们吗？"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "speakerId": "char_1002_nsabr",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "speakerId": "char_1002_nsabr",
          "text": "罗德岛！"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "这些家伙！"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "speakerId": "char_1002_nsabr",
          "text": "别跑......！"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "真的是疯了。"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "speakerId": "char_148_nearl",
          "text": "这些人为什么就不能珍惜自己的生命？！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "char_002_amiya",
          "text": "杜宾......"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "没有办法......"
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "speakerId": "char_130_doberm",
          "text": "彻底击溃他们，然后马上移动！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
