{
  "server": "cn",
  "storyId": "main_1_level_main_01-07_beg",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "暴君",
  "storyCode": "1-7",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_01-07_beg.txt",
  "sourceHash": "3e01211e4517d1a167b4a0ef5ec31a34a94187b2a069bda5ad0e4fa1c2371d66",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "抗冲击准备！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "各自散开——！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "规模太大了......这样下去，整个街区的建筑都会被彻底摧毁！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "不行，糟了———！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "快转移！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "坚持住！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "啊——！！掉，掉下来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "天空掉下来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "不，不，啊好疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我的手，我的手！我的手哪里去了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "怎，怎么会！！我不想死......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "啊啊啊啊！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "重装干员！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "保护我方术师！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "——！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "那是什么声音？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "巨大的坠岩击垮了临街的建筑！卧倒！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "text": "啊......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——那个位置——医生！危险！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "糟糕，医生，快闪开！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "医疗干员",
          "text": "啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医疗干员",
          "text": "......唔，博，博士？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "text": "博士把医生推进了掩体？可这样......这样的话，博士——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "text": "不，博士！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "Dr.{@nickname}！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "text": "啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "text": "临，临光她冲出去了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "博士，蹲下！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "咯......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "赶上了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "text": "她救下......她救下博士了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "咳哈......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "临光！博士！快回来！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "没问题的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "我的盾牌还撑得住——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "跳啊，博士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "跳！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士，博士......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "你，你没事吧？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我没事，这算不了什么！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "多亏临光小姐救下了我。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "一个人......处在那样的危险中！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "至少拉上我一起，让我保护博士你！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "无论怎样，我都不能允许你受伤——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "何况，是在我面前！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "大家都还安全，就非常好了......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "但我们......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "（还要坚持多久呢？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "（我们真的能活下来吗？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......唔......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "坠石的数量减少了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我们撑过了第一波主灾害了吗......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "还不能大意，谁知道这次的天灾会持续多久。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "不过至少......我们不是身处天灾正中心的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "我们侥幸躲过去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "嗯......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "大家怎么样了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "text": "干员们基本都没事......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "text": "有些干员受了轻伤，但状况都还算不错！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "近卫干员",
          "text": "我们......活下来了！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "整合运动也有部分人员——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "......啊？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "啊......啊！！罗德岛！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "......什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "啊......！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "整合运动还要继续攻击我们吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "罗德岛！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "这些家伙！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "别跑......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "真的是疯了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "临光",
          "text": "这些人为什么就不能珍惜自己的生命？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "杜宾......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "没有办法......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杜宾",
          "text": "彻底击溃他们，然后马上移动！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
