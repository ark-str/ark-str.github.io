    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "行、行了，我又没说不要！干嘛那副表情！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "还不快拿来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蜜蜡",
      "text": "伊芙利特又害羞了。",
