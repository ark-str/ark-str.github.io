      "speakerName": "艾雅法拉",
      "text": "呼......哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "喂，慢吞吞的小羊！你还撑得住吗？不行就说，我扛着你走！",
