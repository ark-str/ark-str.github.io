    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "我没有！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "嘁，懒得和你说。艾雅法拉，你那边怎么样了？",
