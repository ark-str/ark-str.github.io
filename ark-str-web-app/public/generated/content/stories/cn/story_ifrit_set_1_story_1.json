    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "这什么东西......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薄绿",
      "text": "我在这边捡到的矿石，你看这个红色，是不是很适合你？",
