    },
    {
      "type": "dialogue",
      "speakerName": "薄绿",
      "text": "嘿嘿，送给你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伊芙利特",
      "text": "哼......哼！不就是块石头......",
