{
  "server": "cn",
  "storyId": "story_skfire_set_1_story_1",
  "groupId": "story_skfire_set_1",
  "stageId": null,
  "title": "老同学",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_skfire_1_1.txt",
  "sourceHash": "95de4e22315c6ac5a94f27e9e224c09ac176bde718786856a7817b72d5553d22",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "听说了吗，蒙贝兰家的那个大小姐已经回到维多利亚了，就在卡拉顿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "这里？我以为她会去什么大城市。这里感染者最多，之前不是还有什么整合运动，她不是最恨这些吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "在议会工作呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "啊——议会啊。蒙贝兰家的大小姐在这么个城镇议会里，估计是顺风顺水吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "就这点反应？我以为你会很高兴呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "高兴什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你那工厂，不是一直在找机会吗？她那样的人，眼睛长在脑袋顶上，之前做的那些事你又不是不知道，她恨死感染者了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "她现在又在议会工作，你去找她帮忙，给她好处，讲讲你的工厂，那不就是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "......这是什么？邀请函？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "“今天我们邀请您参加......我们希望能和您共同庆祝，并邀请您品尝香槟，参观......今晚八点整，期待您的到来。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "同学聚会啊，我有时候真的不明白这种浪费时间又不好推掉的东西，为什么会被称为“礼仪”。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "下班了再去吧。希望今天这群老东西别给我——\n呼，不行，生气在工作中是不必要的。"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "直接开始工作吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "高傲的贵族同学",
      "text": "噢，您好，老同学。上周我们才在酒会上见过，您的美貌让多少人都忘了呼吸，他们叫嚷着让您再参加一次呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自满的贵族同学",
      "text": "美貌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自满的贵族同学",
      "text": "不过是看中了我手里的产业，毕竟它短短几个月赚来了寻常产业一年的利润。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自满的贵族同学",
      "text": "即便亚当伯爵的头发堪比营养不良的玉米须，不是照样有人称赞他俊朗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高傲的贵族同学",
      "text": "咳！您还和以前一样风趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高傲的贵族同学",
      "text": "不过，要是论起财富，我手里的葡萄酒庄园，才更是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "（互相攀比，炫耀资产，讽刺不在场的人，哼，这群人还是老样子。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寻找机会的商人同学",
      "text": "安布卢斯伯爵，承蒙您的关心，我的工厂已然走上正轨！只是在它能为您带来更多的利润前，我还需要小小的一笔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "啊哈哈，您还记得我，真是太荣幸了！当初我的座位就在您的后面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "如果您愿意看看我的产业，我将会非常感激！......啊，这样，打扰了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "（把宴会当成向上的跳板，那些人也享受他们的奉承，真是......没有什么特别的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "（我在这里待了够久了，该走了，回卡拉顿还要一段时间。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐，果然是您！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "您尝尝，这是宴会上的香槟，我给您拿来......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "没想到会在这里遇见蒙贝兰小姐！您还记得吗？当时我的座位就在您的后面，您现在也是找了一份好工作啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "失礼了。如果没有什么要紧的事，我还有自己的事情需要处理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "啊，是这样的，我听闻蒙贝兰小姐现在在议会工作，而我又正好在经营一家小小的工厂，虽然规模并不大，但......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "如果能有好机会，它也能像伊莎贝拉的产业一样赚钱！而我自然会给您——我的贵人，送上精致的礼物，来表达我的感谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "比如说，来自议会的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我并不感兴趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "（这大小姐，她是不是还根本不知道我的工厂究竟是做什么的？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "（还是一样没怎么真的经历事情，贵族......一群仗着自己的血统就瞧不起人的......我这么放低姿态还不是——！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐，您不知道，我的工厂就在卡拉顿。多亏了您和各位议员的努力，我才能把它办起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "您不是一直厌恶那些低贱的暴徒吗？为了您心爱的宠物，他们也算付出了相应的代价。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "而现在，感谢这些政策。议会也是向着我们的，不是吗？那些低贱的人，就是为了我们而存在的，而我已经学会了好好利用这些的方法——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "若是我可以更进一步，想必我能做出更多的成就。而您，蒙贝兰小姐，我将会尽我所能报答您的好心！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "（要不要把他烧——\n不行。）"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "不过，我怎么感觉这间屋子里有些热？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐，您觉得呢？要不我们出去聊聊？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "（真的不行吗？\n——不行。）"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "这是我的名片，请您先收下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "......哼，让我看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "“巴伦工厂”？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "对对！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "唔，是巴伦工厂啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐听说过？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "当然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "在议会我们以你的工厂为案例，讨论过新的议案规划。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "私下里，我和我的老师也关注过你的工厂。当初送来的名单上，“巴伦工厂”的名字可是排在前面的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "啊，真的吗！真是我的荣幸！那么我能......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我已经签署了保密协议。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "当然！您自然不会做出泄露机密这种事来！我只是希望您能让我也小小地参与进这议会的聊天中来，茶余饭后，增些谈资。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "比如......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "比如我们正准备对工作时长做出新的规定？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "正是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "如若能邀请您来我的工厂看看，我将十分荣幸......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐，感谢您屈尊来这种地方，几天前我就已经让人仔细打扫过一遍，没留下一粒灰尘！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我不是说我就是要看最真实的情况吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "哎呀，扫去一些不必要的尘土，自然不会影响到您了解我们工厂的运作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "我并非自夸，但是您看，这样的规模——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "在卡拉顿算不上数一数二，但也很可观了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "设备、防护措施做得都不错嘛。依照现有的条例，你这里完成得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "安保措施也按照规定配备完整。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐，这您就有点小瞧我了，这些基础的工作自然做得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "您要不再去看看车间？不过往里走可就是感染者车间了，虽然准备了防护措施，但您肯定——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我要去看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "啊，我知道，肯定还是几年前的事情，您是想看看里面还有没有那群叫作整合运动的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "嗯，对，整合运动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "来我这里的工人都是经过了身份审查的，但您放心，要是您在里面看到了让您不高兴的人，我一定——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "亲眼看了才行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "好，好，您先快把护具戴好吧，我舍命陪君子......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "就是这里了？工人们呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐，我没想到您对这里如此上心。怎么可能真的让您和感染者站在一起，我已经下令让他们先走，净化装置也开到了最大功率。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "我们也不要在这里待太久，说实话，我也还是第一......啊，也有一阵子没来这里了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "哦。我也就是四处看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "毕竟按照你说的，这里可是为你赚了不少钱，我自然更关心。而且，你忘了？我和我的老师之前就很关心你的工厂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "是，这是我的荣幸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "感染者又便宜，又不需要太多保障。这样好的劳动力，多亏了议会。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "那些是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "啊，是一些监控设备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "毕竟您也知道，不加以督促和监视，总有人想耍滑头。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "这些防暴盾是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "啊~这您就更不用在意了，感染者难服管教又心思多，您想必比我更清楚。不用点手段，他们绝对不会安生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "防暴设备就这样放在这里，不怕引起感染者的恐惧心理，诱发混乱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "这......哈哈，蒙贝兰小姐就多虑啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "他们看不到的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "看不到......？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "——蒙贝兰小姐，我们也待了有一阵了，还是先出去吧？虽说做好了防护，也怕万一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "坐电梯出去摘护具，喘喘气，喘喘气！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐，老同学，电梯里只有我们两个人，我可以给您说点真话，这或许能让您更加在意我的工厂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "您别对眼前的这些东西失望，更何况，您也注意到了，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "监控和防暴人员，还有那些武装设备。您知道，赚钱的法子可不能都摆在明面上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "下面的东西，才是真东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "只是，地下太脏，您不用亲眼去看。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "原来如此。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "嗯，我很——满意你刚才和我说的那番话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "很有意思。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老同学再次感受到了一点气温的上升。\n他把这理解为天火的兴奋，能赚到钱的兴奋，能继续踩踏那些蝼蚁的兴奋。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "荒野上的野兽都知道看清了猎物才出手，我如果不展示出来真东西，蒙贝兰小姐怕是也不会动心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "工厂比比皆是，我总要有些新东西，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "哈！是这样的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "哈哈哈哈，哎呀，蒙贝兰小姐，来，这是我私藏了好几年的好酒，让我们干一杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "为了您现在能资助一家很有潜力的工厂，而我，将走上更发达的路！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "哈哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "干杯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "天火的温度自脚下开始上升。\n只用短短的一瞬，她就能烧光这个工厂，救出被关在地下的人。\n但也只是一瞬，她按下了心头的怒火。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "老师，您找我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "“自称为‘整合运动’的感染者暴徒们被一个名叫‘王者之杖’的团体重创”，这是我看到的相关消息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "老师，可是他们杀了菲尔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "但解决问题的方式并不只有你现在做的这一种。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "如果只是一味地以暴制暴，蒙贝兰小姐，这似乎和我教你的完全不符。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "你忘了我最开始和你说的了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "整合运动的问题不只是感染者的问题，如果你还想继续在这条路上走下去，就去我给你推荐的地方，去更深入地学习，去好好看看外面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "不要让我失望，蒙贝兰小姐。你是一个很有想法的学生，不要被自己的情绪控制住，看清它的背后。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "烈火能焚烧掉一切，但无法解决问题。\n她捏着酒杯，站在工厂里，按下了自己有些浮动的呼吸。"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "下次议会的时间想必你也知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "等待好消息吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "哈哈哈哈，蒙贝兰小姐，感谢您！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "老师，事情就是这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "巴伦工厂，之前整理出来的感染者权益调查名单上，就有这家工厂的名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "当时我请教了老师，最终也决定派出线人去暗访，关于他工厂的内幕，我已经总结成了文件。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "而且，我几天前才知道，这座工厂的厂主居然就是我的这位老同学。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我原本都想一把火烧了——当然，我知道这肯定是不对的，这解决不了任何问题，反而会增加许多无谓的麻烦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "而我又十分厌恶他所做的事，不论是在宴会上私自找到我希望获得议会的内幕，还是竟敢明目张胆地向一位议会成员透露工厂的底细——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "当他做出这些举动的时候，就说明背后已经有了百十件类似的事，已经有无数人用了同样的方法，为自己牟利。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "老师，这当然是不被现有条例允许的。但他们尝试着做了，却发现没有受到惩罚，反而获得了好处，才开始一件又一件地往下做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "其实，我记得这位同学，我也知道他找上我的时候，那句“位置是在我后面”其实是真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "虽然他对在场的每位贵族都这样说，但他确实曾坐在我身后。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "他以前......不是这样的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "他以前，是个好孩子吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "倒也不算，但也不是现在这种人......我在想，他是因为本性如此，才这样做的吗？我觉得不是的，老师。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "就是因为他试着钻了条例的空子，却发现根本没人在意，他才一步一步走到现在这个样子的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "你是觉得，现在你很矛盾吗，蒙贝兰小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "不，老师，我并不觉得矛盾，我只是觉得有些......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "说不清。不过，我现在很清楚地知道我应该要做什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "安摩斯，辛苦你给老师再讲明一下黑工厂的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "线人",
      "text": "好的，蒙贝兰小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "线人",
      "text": "我根据蒙贝兰小姐提供的消息潜伏在工厂附近，一旦靠近地下工厂，我的通讯信号就会被强烈干扰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "线人",
      "text": "推测地下工厂内部安装了通讯屏蔽器，里面的感染者工人被完全切断了与外界的联系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "线人",
      "text": "根据我的观察，连着几日，都有死去的感染者被秘密运输出来，送去处理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "线人",
      "text": "而里面的武装人员都是为看守地下工厂而设置的，地上的感染者工人们并不知情，只是以为看守的是重要货物产品一类的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "线人",
      "text": "根据蒙贝兰小姐提供的资料，我推测里面的就是之前几批消失的重症感染者工人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "线人",
      "text": "因为重症，失去了医疗必要，于是被当作一次性劳动力，关在地下工厂劳动至死。然后工厂丢弃他们，再去补充新的一批感染者工人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "嗯......我清楚了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "昂斯特议员",
      "text": "那么，蒙贝兰小姐，你对这件事的处理方法是？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我的报告到此为止。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族议员们",
      "text": "嗯，但我们为什么要为了这样一家小小的工厂听你在这里花费——十多分钟来讲述？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族议员们",
      "text": "这对我们来说意义并不大，希望你能清楚地认识到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族议员们",
      "text": "昂斯特议员让你来这里，难道就是为了让你揪着小工厂不放的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我希望为在座各位指出的是，这起事件的重点是失踪感染者工人被关在此处武装看管，限制人身自由，甚至死者被秘密处理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "并且，他们在源石粉尘浓度过高的工作环境里工作，没有相应的防护措施及通讯设备。以上每一点都与现行的政策相违背。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "卡拉顿因为现行的政策对感染者而言相对宽松，才能吸引到大批感染者前来工作，这也是这里发展起来的根本。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "这件事一旦外泄，会极大地损害卡拉顿对外的形象，就不会再有感染者愿意来卡拉顿工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我相信在座的诸位，不会有人乐意看到这个场景。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "贵族议员们",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族议员们",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "所以这条并不算是议案，只是一次工厂清理。而为了卡拉顿的名声，被解救出来的感染者工人，需要得到妥善的安排，以议会的名义。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "这次查封行动，也需要以议会的名义，做给外界看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "站在在座诸位的角度——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族议员们",
      "text": "我们来表决一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族议员们",
      "text": "诸位，你们怎么看？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三天后"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "怎、怎么回事！你们是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "你们进来干什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "啊、啊，这里面可都是感染者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "你们，去下面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "下面？下面可是——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军人A",
      "text": "报告！已发现大批非法武装人员！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军人B",
      "text": "报告！发现非法通讯屏蔽终端，已实施拆除！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军人A",
      "text": "地下发现大量感染者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军人B",
      "text": "地下已查明确为一处非法工厂！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "嗯，报告情况属实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "根据议会条例，依法对此处实施关停处理。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "而你，根据相关规定，五年内不得再从事相关行业工作。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚军官",
      "text": "——转移感染者！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "蒙贝兰小姐！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "啊，是你......怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "你、我的工厂？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "为什么今早突然有一批人来我的工厂，包括地下的事，他们——怎么回事？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "哦！你是说查封工厂的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "你不是之前找我帮你吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "这就是我给你的帮助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "拉拢客户的商人同学",
      "text": "什......？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "你打听到了消息，但没有打听清楚。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我不只是一个议会成员，我还是罗德岛的干员。如果你不清楚，我或许可以挑明了说——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我在为解决感染者问题而工作。\n更重要的是，我是在为了帮他们谋权益而工作。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
