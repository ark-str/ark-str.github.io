  "blocks": [
    {
      "type": "choice",
      "options": [
        {
          "label": "保持冷静！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "都不要慌张！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "崩溃的市民",
          "text": "让让，让让！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "啼哭的市民",
          "text": "他们，那些怪物就快要过来了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "崩溃的市民",
          "text": "戴兜帽的家伙，别堵住路！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "啼哭的市民",
          "text": "别过来！你身上有血！和那些怪物一样沾上了血！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "博士，我在这里，抓住我！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士，抓住我的手。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......你？",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你......不是阿米娅！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "变形者......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅？",
          "text": "......为什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅？",
          "text": "“魔王”，应该是什么样子？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你不再是过去那个你了。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我听到了Logos的骨哨声。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "众魂依然拒斥了我们。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "但......变化已经发生，我们的另一部分......已经离我们而去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "我们需要做出选择......我们不可停滞不前。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "......“魔王”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "我们刚才试图扮演你，但是失败了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......新的变形者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "这就是你的选择？你决定真正与我们为敌。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "......我们只是做出尝试。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "唔——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "“魔王”，我们的意义能否在和你的战斗中得出？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "我们的路到底通向哪里？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......我曾经询问上一位变形者我该怎么做。他告诉我，我需跨越所有的犹豫和迷茫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "既然新生的你仍称呼我为“魔王”，那么——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "自己去找吧，在我这里，你得不出答案。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "哎呀，我弄疼你了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "那个叫阿斯卡纶的女人真讨厌，她对所有人都那么纠缠不休？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅，小心——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他们的目标，是你！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "怎、怎么——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "小小的魔王啊，我早就迫不及待想要翻捡你的情感与记忆了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "我原以为死魂灵会让你吃点苦头，可你的状况似乎比我预想的要好上一些。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "卡特斯，不，奇美拉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你终究不是特蕾西娅呀。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赦罪师直属卫兵",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "放开我——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你是个被人赋予王冠的幸运孩子，但你真的了解你的力量吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "而我们，已经探究了魔王数个千年了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "至于你——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "别打博士的......主意！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "哦？被赦罪师的巫术环绕，你居然还能调动魔王的力量？我开始有些想念丽兹了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "算了，这对我们的实验大有裨益。我会先留这位博士一命，我也会教你利用自己的情感。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "不过在把你交给首领之前，我得保证你比现在更乖一些，小兔子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "变形者阁下，那个讨厌的女人就快追过来了，后续就交给您了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "......好吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "也许，她能砥砺我们。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博......士......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "博士！待在原地！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "第一优先级是——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "放开——",
          "value": "1",
          "blocks": []
        },
        {
          "label": "放开阿米娅！",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "呼——呼——呼——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "呼——呼——呼——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "这......是什么地方......这些石像......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "它们......全都栩栩如生......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "萨卡兹种族的石像？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "很顽强，“博士”，我很敬佩你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你醒了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "如此孱弱的身体，是如何跟随我来到这里的？我尝试检查你的身体，但是一无所获。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "不......也不是一无所获。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你的构造......很特殊。和我所知的所有样本都不一样，我想要研究你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "“仔细研究”。可惜这里很久之前就被首领废弃了，实验设施不完整，我不想损坏你这么珍贵的实验体。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "还是得带回伦蒂尼姆吗？可是特雷西斯好像对你格外关注......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你瞧啊，“博士”——她正看着什么呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "她在颤抖呢。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你对她做了什么？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "“魔王赐予伟大的幻境”。小兔子只是稍——微感受了一下她自己的力量。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我们没必要互相敌对，你寻求知识？罗德岛也有。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "萨卢斯",
              "text": "可笑的拉拢。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "你希望交换什么？我们可以谈谈。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "萨卢斯",
              "text": "无意义的谈判。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "停下，否则我会让你溺死在岩浆之中。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "萨卢斯",
              "text": "带着颤抖的威胁。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "瞧你那一筹莫展、想抓住一切可能的样子，看上去真令人心疼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你的干员不在你的身边，你的指挥派不上用场，现在，就连你所侍奉的“魔王”都在离你而去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你还能做得到什么呢？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "我总是请教首领，权柄为何总被庸人把持？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "这些被历史遗忘的魔王，给我们带来的，除了颠沛流离的生活，还有什么呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "而你，“博士”，你会是这次苦难的源头之一吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你提出了很多疑问，但这里不是个适合探讨的地方。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "只要你解除阿米娅身上的巫术，我愿意尽力回答你。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我有和你相同的困惑，但伤害阿米娅无法带来答案。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "我不讨厌你的智慧。但说实在话，聪明人从来都不缺。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "任何东西都换不来这次机会，都换不来我们数千年的追寻。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "那么......既然她能把王冠强行戴上这个小兔子的脑袋——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "它也应该能被抽取出来才对呀。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你想偷走阿米娅的王冠！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "偷？不不，这顶王冠不是个遗落在战场上的铁环，任人拾取。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "你不会明白。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "瞧瞧，这是什么，一枚——石头？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "令人感动，但我必须提醒你，挡在她面前毫无意义。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "既然你如此执着，我想到了一个更好的办法来处理你，“博士”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "也许你隐藏在兜帽下的脑袋里，同样也藏着不少有助于我们实验的秘密。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "就这样，不要抵抗我的巫术。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "向我分享你的记忆——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "从我的脑子里滚出去！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "......什么？什么力量能这么彻底地排斥赦罪师的......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "是“魔王”......？可她的精神应该受到了巨大的限制......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "*古老的萨卡兹语*。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "诞生自众魂的枷锁可没那么容易挣脱，她还停留在众魂之间。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "她在潜意识中依然选择保护你，呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "......等等。不仅如此？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "她和王冠的联系在加深......？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅！醒醒！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "啊，如此浓烈的情感。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "特蕾西娅当年会选择你，好像不完全是走投无路，小兔子。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "既然如此，那我们干脆略过无聊的前奏吧。希望你的小脑袋瓜不会因此毁掉，那样就太可惜了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "赦罪师在这座洞窟里留下的，可不止是雕像。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "*萨卡兹咒语*。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你答应过我——",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "拒绝那个声音！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "嘁——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "博士，你的行动太过鲁莽，如果不是我遇到了——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "小心。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "血魔的法术......你们对自己的......“血脉”摆弄到了何种地步？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "无法想象，你们是使徒闪灵的血亲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "那样一位优异之人，却要时刻为你们的污秽而忏悔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "咳，咳咳——女妖之主。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "亏你们能进入这里。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "听说如今的女妖之主相当叛逆，我真该再小心一点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "......你比我们预计的更危险。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "没有审讯的余力，情况紧急，杀了她，离开。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我明白。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "喔，这就是如今的女妖之主？“王庭丧钟”？确实了得，这些咒文的精细程度不亚于你的英雄母亲。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "可，你知道吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卢斯",
          "text": "这样精巧的符文——精巧的源石技艺，绝非萨卡兹最本初的心态。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "阿斯卡纶！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "——！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我们已经离开了洞窟，阿斯卡纶在勘察附近的地形。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "你的右臂桡骨被折断了，我正在为你做最基础的处理。我不是医疗干员，只能做到这个程度。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅的情况怎么样？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......她还在昏迷。“受困于众魂”，尽管赦罪师表露出类似含义，但......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "至少，她性命无碍。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我理解阿斯卡纶对你行事的不满，博士。她所担心的，不仅有你的安全。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "但你确实为我们争取了时间，如果不是你的拖延，赦罪师恐怕已经带着阿米娅躲藏进了伦蒂尼姆的高墙之后。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那个赦罪师呢？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "让她逃了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "土石，鲜血，还有......女妖之啸。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "这就是赦罪师所期望的萨卡兹的模样？执迷于......所谓的血统和巫术？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他们的目标是“魔王”。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我们必须尽快转告凯尔希和闪灵。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......等等。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "这些氤氲的水汽......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......不可能。博士，小心些。我们未必离开了敌人的陷阱。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "怎么了？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "很少见你的脸色变化。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "这里......不是维多利亚。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "这里是女妖的河谷。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
