{
  "server": "cn",
  "storyId": "main_0_level_main_00-10_beg",
  "groupId": "main_0",
  "stageId": "main_00-10",
  "title": "困境",
  "storyCode": "0-10",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_00-10_beg.txt",
  "sourceHash": "95167835eff6dbc041446755da099a5f4b6e94dc3d1bdcaaa4bd8949c5ddb8e3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "这女人......怎么回事......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "————你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "制压切尔诺伯格军事据点的整合运动像机器一样高效——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "而你领着的这批各个都像神经错乱的暴徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "屠杀，纵火，围猎......只不过是为了满足你自己残忍的趣味而已吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "会在这时煽动如此不堪之事的人，没可能策划出足以击溃整座城市的方案。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "你的指挥官大概是命令你制造混乱，而你，顺应着自己低劣的品味肆意妄为。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——浮士德。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "把她那张嘴给我打穿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "咳，咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "临光！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "敌人的狙击手......很强！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "临光再被击中的话，一定会失去防御能力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "临光，快退后！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "不行......威力太大了。如果击中我方小队，后果不堪设想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "我必须防住他的炮火！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "挡开了浮士德的弩炮？凭盾牌——？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "不可能......不可能！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "再来！！把她......打成碎渣！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "居然......右侧？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "糟了！快闪开————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "不会让你得逞！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "Ace！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "狙击干员，准备！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——目标，南侧高台，齐射！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "什么！你们居然敢，居然敢......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "打中了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "没那么容易，这只能......稍稍压制他而已。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "没时间再去了解敌人的构成了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "兼具机动性和威力，越拖下去，我们安全挡下他弩弹的几率就越小！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "别给他喘息的机会......！趁着E3小队狙击干员干扰他们的时候，阿米娅！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "E1小队射手，和我一起，压制整合运动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "E2小队，用最大火力，撕开整合运动的防线！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你们这些家伙......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "为什么不肯老老实实地去死？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你们的命运，为什么就不能在这里落下帷幕？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "——————我要把你们，通通————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "临光，趁现在，快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "E4全体，随我冲击敌方阵形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "一次性击溃前方的阻挡目标！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "狂奔起来！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "射击！射击！别让她靠近......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "啊......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "啊？？她刚刚不是还在二十米之外......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "咕咳——唔啊啊啊啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "想要对抗卡西米尔骑士——再去训练个几十年再说！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "text": "杜宾！跟上我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
