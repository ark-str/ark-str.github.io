{
  "server": "cn",
  "storyId": "main_11_level_main_11-08_end",
  "groupId": "main_11",
  "stageId": "main_11-08",
  "title": "以命换命",
  "storyCode": "11-9",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_11-08_end.txt",
  "sourceHash": "236709234811d5bd364867838aa41d7a8f86725b75c958e3606dd9fc5819abf3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "乔治，愿意去的人，都在这里了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "汤米呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "汤米他不见了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "没事，本来就是自愿的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "乔治叔叔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "费斯特，看来你找到了凯瑟琳留给你的东西，是你想要的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "既然你拿到了，那就快走吧，不然，可能就走不了了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "等等，发生了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "你知道那些萨卡兹把凯瑟琳带去干什么吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "她知道的太多了，他们要把像她一样的工人秘密处决掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "刚才我就觉得不对，让戴爬到工厂上面确认了这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "你说......什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "凯瑟琳瞒着我们，以为我们什么都不知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "但我们也不傻，多多少少也猜到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "......然后你们要做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "不做什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "......我们忍了这些萨卡兹很长时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "许多人都习惯了，习惯了这种温吞水的状态。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "甚至许多人以为，只要再忍一忍，萨卡兹就会放过我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "然后，他们现在打算拿凯瑟琳开刀了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "你们会死的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "那也好过眼睁睁看着凯瑟琳被他们杀死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "聚集在这里的，都是没有后顾之忧的家伙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "停。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "你已经是自救军的人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "你们的事迹我们都听说过，不少人其实都为你们高兴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "你有更重要的事要做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "别让凯瑟琳的牺牲白费。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "......不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "博士，虽然我获得了奶奶留给我的情报。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "但是，作为这座军工厂的工人代表，奶奶本人无疑是对萨卡兹的生产线走向最为了解的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "她在战略上有着重要的价值，对吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "毫无疑问。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我不否认。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......那么，我想请求罗德岛的协助。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿斯卡纶，你在吗？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我记得你盯着......陪着我。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "我在。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "想必你已经摸清楚了这个区块的敌军配置。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "请描述一下这个区块的敌人配置吧。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "他们收紧了防御。外围漏洞百出。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "现在看守中外围这些区块的，大多是一些结构松散的雇佣兵团体。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我们需要一些时间。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "转移雇佣兵的视线，解决那些斥候。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "没问题。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "谢谢你们，博士，阿斯卡纶小姐。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "费斯特深吸了一口气。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "他将自己的工牌贴在胸口，走进了工人们的队伍当中。"
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "别做蠢事，费斯特。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "大伙，我并不是以自救军成员的身份站在这里的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我是以在这座工厂长大的、工人代表凯瑟琳孙子的身份站在这里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我属于这里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我和你们一样，不希望凯瑟琳死去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "而且，我不仅不会让凯瑟琳死去，我也不会让你们死去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "这位博士的手下会帮我们切断萨卡兹的情报传递。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "只要能把奶奶和其他工人代表救出来，我们会有充足的时间撤离海布里区。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我会带着你们去和自救军会合。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "所有人都会得救。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......所有人都应该得救。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "工人们面面相觑。\n但他们都看到了彼此眼中缓缓燃起的希望之火。\n他们开始自发地走动，走到费斯特身后。\n他们决定相信费斯特。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "费斯特，我、我也去！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "汤米......你还是来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "不过，你还是不要去了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "为什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "你爸爸身体不好，所以你才犹豫了，不是吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "但是——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "而且，我有件事想要拜托你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "不管结果怎么样，半个小时后，去向萨卡兹举报，就说我们这些工人，擅自行动去闹事了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "可......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "这也很重要，我不能害了留在这里的兄弟。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "......我知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "那么，各位，让我们出发吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "去把我们的老工头们救回来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人们",
          "text": "噢！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "凯瑟琳默默地抽着烟。\n她看着那些萨卡兹将一个个熟悉的老面孔拖到临时的刑场上。\n她能看到那些老面孔或愤怒，或放弃，或厌恶。\n最后，归于平静。\n她知道，很快就会轮到自己。\n她感觉心中空前地宁静。\n费斯特说的是正确的。\n妥协与顺从同样无法解决问题。\n她必须为自己的选择付出代价。\n但她至少在付出代价前，又见到了自己的孙子一面，并给他留下了一点东西。\n这就足够了。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "到你了，老家伙。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "把她押过去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "我自己会走。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "对了，明椒。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "格林应该没让你杀过人吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "......是的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "那这是个好机会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "你该试着学会杀人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "萨卡兹就是这么对待孩子的吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "我听到了你说的话，你说得对，她还不知道战争是什么。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "如果可以，我也不希望知道什么是战争。每一个萨卡兹都是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "但你们没有给我们选择。你们所有人都没有。所以现在，她该知道了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "我喜欢你的眼神，老家伙。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "每当我发现那些死不瞑目的战友时，他们，也往往都是这种眼神。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵",
          "text": "我杀过很多人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵",
          "text": "但是，把这些没有反抗能力的人一个个处决的感觉，还挺怪的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "......不想干的话，可以回你来的地方。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "你怎么知道这些工人过去造的武器有没有被用来杀你的同胞？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "我们在打仗。道德是留给和平的。我们从没有机会真正公平地讨论这个话题。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵",
          "text": "不用你来告诉我这点，我只是......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "嗯？无人机？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "就是现在！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我用无人机在外围侦察过了，就是这里没错！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我们冲进去！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我......不能交给别人吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "不行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "格林应该教过你，队长的命令对雇佣兵来说是绝对的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "今天，要么你杀了这个老东西，要么，放下武器，但我会了结你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "动手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "但是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "动手！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我......我做不到！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "......我早就说过，格林太护着你了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "我们不是来说服维多利亚人把家园还给我们的。没法动手，你可得吃点苦头——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "唔——无人机？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵",
          "text": "队长，有许多工人冲进来了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "费斯特，我们这边有博士帮忙指挥，我们会帮你牵制住其他雇佣兵，凯瑟琳就交给你了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "好！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "......你们疯了吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我们没有疯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "你知道这样的老工人，他们的经验有多宝贵吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "很抢手的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "费斯特！你们——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "哼......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "假装什么都不知道，你们还能活得久一点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "不巧，奶奶从小就批评我，不知道在该闭嘴的时候闭嘴。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "那你以为你能打赢我？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "不能，但是她也许可以。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "什——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵队长",
          "text": "呃......！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......混账玩意，呃，还真结实......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "谢了，乔治。起码出了口恶气。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "还是先谢费斯特吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "还有......你们这些萨卡兹，不动手吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......孩子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "你们的队长说得没有错。我们不该在现在谈论对错。我们没法谈论对错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "但如果你甚至不知道自己在为什么而战......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "......不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "你、你们不能走......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹雇佣兵",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......没办法了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我们上！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "怎么回事，其他人呢......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "再没有联络，就只能汇报给——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "呃......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "萨卡兹战士感觉自己身体一轻。\n随着身体不受控制地前倾，他逐渐模糊的视野中出现了一个黑色的身影。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "那是一个萨卡兹。"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "为......什么......萨卡兹要......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "最后一个。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "虽是自言自语，阿斯卡纶却像是确信一般收起武器。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "从她的位置，可以清晰看到愤怒的工人们将萨卡兹雇佣兵们冲散的场景。\n在积攒了数年的愤怒面前，势单力薄的暴力被摧枯拉朽般冲垮。\n强弱变换了位置，一些往事飘上心头。\n她随即将视线投向某个方向。\n那是伦蒂尼姆中央的位置。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......所有雇佣兵都被绑起来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "我们有多少人受伤？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......不多。跟着这个孩子的雇佣兵第一时间没有动手，他们全都慌了神。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "他们甚至没有下定决心战斗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我们——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "明椒",
          "text": "我们......我们只是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......起码你们试图反抗，只是被狡诈的伦蒂尼姆人偷袭罢了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿斯卡纶解决了外围的麻烦。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我们的时间并不多。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......本来只有我们几个老东西去死。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "现在倒好，你们所有人都要变成萨卡兹的刀下亡魂了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "这就是你的主意吗，聪明的费斯特？让我们这么多年的忍让全部白费？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "不。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "如果今天我们坐视你们的牺牲而苟且偷生，那么明天，就会出现另一批牺牲者。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......直到再没有人真的在意同伴的死活。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "而且......你不能总是替所有人决定这一点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "你说对了，你也不能替所有人决定，费斯特。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "但这次，是所有人自愿来救奶奶的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "萨卡兹占领城市很多年了......我们的日子很艰难，但有一些底线，我们绝不能失去。如果今天我们不出现在这里，那我们——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "伦蒂尼姆工人",
          "text": "我们会被萨卡兹熬死在这一锅大杂烩里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "乔治......你们也陪着他胡闹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......并不是所有人都在这里。那就说明，有很多人并不愿意看到我活着回去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "费斯特",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "......现实的残酷超过你的想象，费斯特，别把人的道德想得那么简单。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "但事情已经发生了......唉。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "凯瑟琳沉默片刻，看向明椒。\n但她终于还是没有说什么。"
        },
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "走吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
