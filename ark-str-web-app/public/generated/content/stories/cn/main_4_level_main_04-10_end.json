  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "咳，咳......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "陨星！我们击退了雪怪小队！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "可是——"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "确实，我有点低估你们罗德岛了。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "下手是不是，还是太轻了些。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "（手指已经没有知觉了......可恶......）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......怎么回事.....？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "寒流......还在凝聚？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "这一次......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "你们就不会那么好运了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "不好.......！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "她是想吸收整片区域内的寒气，一口气爆发出来吗？！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "——♩——♬——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "——那种法术，会抽干我们所有人的热量！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "这种规模，比起她刚才所使用的法术，庞大太多了......！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "就这样结束吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "就让纯粹无瑕的冰霜，埋葬你们的愤怒吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......唔......！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "......♩......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "......！？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "有什么，阻止了寒冷继续汇集......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "......咕......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "是你做的吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "我不是说过......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "不允许你......再前进了吗......！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "——拼尽全力用自己的法术，停滞了寒潮的聚流吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "......真是个好孩子。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "霜叶用冰刃，分割了气流吗......！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "但是，但是她......支撑不了多久！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "冰刃已经......快要碎裂了！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#2",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "......已经，够了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#2",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "这是最后的机会了！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#2",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "阿米娅......就是现在！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#2",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "掩护我！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "务必小心！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "明白！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "立即开火，压制整合运动！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "陨星，去吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "我去了......！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "什么？敌人冲着我们......冲过来了？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "不，她......她是冲向了雪怪小队的霜星？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "别，别想过去！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "射击！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#2",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "呃......！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "陨星！！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "不是直接命中，没什么关系！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "还，还能跑吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "可恶！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "都说了！你凭什么靠近雪怪们啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "继续射击！不要给她机会！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "——糟了！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#2",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "喀......！"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerToken": "char_259_Jessica_1#3",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "不！！她被......她被击中了，不......"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "......小伤而已！这样就想挡住我，还太早了！！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "这还不够，我必须......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "咳，咳......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "——！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "（寒气......颤动了一下？）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "等等，寒气的尽头......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "————！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "我抓住这种感觉了......！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "难道说......？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "不管怎么样，只能试一把了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "击中它吧——！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "大家可都......相信着我！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "————？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "罗德岛的领袖......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "她的法术，击碎了我们埋设的源石？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "——起雾了——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "果然！那个霜星是靠小队埋设的源石来创造寒潮！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "陨星！！趁现在——！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "霜叶......"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "我......一定......会救你！！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "所以，等我......"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerToken": "char_219_meteo_1#3",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "等我！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
