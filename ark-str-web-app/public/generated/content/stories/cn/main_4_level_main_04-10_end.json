      "type": "dialogue",
      "speakerName": "陈",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "——我已经安全了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "但......"
