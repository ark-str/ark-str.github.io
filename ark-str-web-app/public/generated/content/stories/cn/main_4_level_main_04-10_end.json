{
  "server": "cn",
  "storyId": "main_4_level_main_04-10_end",
  "groupId": "main_4",
  "stageId": "main_04-10",
  "title": "灯火将熄",
  "storyCode": "4-10",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-10_end.txt",
  "sourceHash": "6b179c34e90f42dd817761b971b35fb1dfa58a040f483463b3c22ebc6b276d21",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "咳，咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陨星！我们击退了雪怪小队！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "确实，我有点低估你们罗德岛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "下手是不是，还是太轻了些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "（手指已经没有知觉了......可恶......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......怎么回事.....？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "寒流......还在凝聚？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "这一次......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "你们就不会那么好运了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不好.......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "她是想吸收整片区域内的寒气，一口气爆发出来吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——♩——♬——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——那种法术，会抽干我们所有人的热量！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这种规模，比起她刚才所使用的法术，庞大太多了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "就这样结束吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "就让纯粹无瑕的冰霜，埋葬你们的愤怒吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......唔......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......♩......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "有什么，阻止了寒冷继续汇集......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "......咕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "是你做的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我不是说过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "不允许你......再前进了吗......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——拼尽全力用自己的法术，停滞了寒潮的聚流吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "......真是个好孩子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "霜叶用冰刃，分割了气流吗......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "但是，但是她......支撑不了多久！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "冰刃已经......快要碎裂了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "......已经，够了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "这是最后的机会了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "阿米娅......就是现在！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "掩护我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "务必小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "立即开火，压制整合运动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陨星，去吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "我去了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "什么？敌人冲着我们......冲过来了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "不，她......她是冲向了雪怪小队的霜星？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "别，别想过去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "射击！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "呃......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陨星！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "不是直接命中，没什么关系！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "还，还能跑吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "可恶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "都说了！你凭什么靠近雪怪们啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "继续射击！不要给她机会！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "——糟了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "喀......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "不！！她被......她被击中了，不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "......小伤而已！这样就想挡住我，还太早了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这还不够，我必须......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "咳，咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "（寒气......颤动了一下？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "等等，寒气的尽头......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我抓住这种感觉了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "难道说......？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不管怎么样，只能试一把了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "击中它吧——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "大家可都......相信着我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "————？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "罗德岛的领袖......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "她的法术，击碎了我们埋设的源石？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "——起雾了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "果然！那个霜星是靠小队埋设的源石来创造寒潮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陨星！！趁现在——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "霜叶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "我......一定......会救你！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "所以，等我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "等我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "醒醒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "呃......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我抓到你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "谁......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "上来！快！抱稳我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "......陨......星？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "你逞什么英雄！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "我有蠢到，会眼睁睁的看着你送命吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "放我下来......我又不是什么......小动物......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "我可是不会松手的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "阿米娅！杰西卡！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "......好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "大家！快撤退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陨星，带霜叶先走，我掩护你们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "我明白了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "......咕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "哈，哈......咳哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "霜叶......撑下去......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "别死......可别死了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "别担心......我的命......还挺硬的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "你也是......阿米娅也是！怎么一个两个都是这样！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "再怎么逞强......你们也只是孩子而已啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "还把我当孩子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "......那我要是死了，救了你们几个，不还蛮值的吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "你——你给我记住了！下次你再这么做......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "再这么做......我就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "哈......对不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "跑起来吧，陨星。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "别......回头......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "走！快走！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "撤出当前区域！优先保护伤员和医疗干员！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "狙击小队......！瞄准整合运动符号，射击！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "破坏它的结构！解体整栋大楼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "咳，咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "爆炸引起的雾气更浓了——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "趁现在！动作快！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "全员撤出广场区域！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "逃掉了——吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "咳咳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "你看了多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "几分钟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "这些战士值得称赞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "小心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你的身体状况不理想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "——用不着你来提醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "做你该做的事吧，老顽固。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "我要去追击罗德岛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "在清剿他们之后，我们才能.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "text": "去......龙门。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "呼............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "马上，就能到达撤退点了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "博士，我们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "......阿米娅！！和近卫局的通讯，已经连上了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "紧急通讯！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......听......好......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官？你听得清楚吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......龙门...........",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——————什么？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——我已经安全了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "但......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......整合运动已经攻占了近卫局的一处重要设施，正在强行打开贫民区与外城的通路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "阿米娅......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "龙门......危险了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "............"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "W成功吸引了龙门和罗德岛的注意，把他们诱进了圈套。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "是的。他们逃不回去。浮士德和弑君者已经破坏了一处防御——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "按照你说的，这会是我们进入龙门的突破口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我们将在每一处要害都设下埋伏，用他们的鲜血染红从这里到龙门的整条道路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "是的，爱国者也快回到切尔诺伯格了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "这样就万无一失了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "还有什么吩咐吗，塔露拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "是时候了————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔露拉",
      "text": "让这腐败的城市，化为灰烬。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
