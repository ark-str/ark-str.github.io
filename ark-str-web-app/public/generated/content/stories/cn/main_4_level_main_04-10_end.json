    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......整合运动已经攻占了近卫局的一处重要设施，正在强行打开贫民区与外城的通路。"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "阿米娅......"
    },
