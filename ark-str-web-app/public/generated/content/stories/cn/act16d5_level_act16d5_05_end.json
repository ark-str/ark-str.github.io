    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魉",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "嘎嗷？嘎啊——"
