      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乌有",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "又来一只！？"
    },
    {
      "type": "sceneBreak"
    },
    {
