      "type": "dialogue",
      "speakerName": "嵯峨",
      "speakerToken": "char_362_Saga#4",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "无需担心小僧，小僧在此地游历数载，虽对未来之事有了种种念想，忧虑不定——"
    },
    {
      "type": "sceneBreak"
    },
