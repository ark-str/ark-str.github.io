    {
      "type": "dialogue",
      "speakerName": "村民",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "一招就......！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魉",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "嗷！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村民",
      "speakerToken": "avg_npc_141#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "厉、厉害......"
    },
