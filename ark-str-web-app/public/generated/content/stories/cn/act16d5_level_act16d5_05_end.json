    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乌有",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "欸，别看我啦，俗话说得好，驮兽急了也咬人，咱们还是赶紧跑路吧！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魉",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "嘎嗷......"
    },
    {
      "type": "dialogue",
      "speakerName": "乌有",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "！？"
    },
    {
      "type": "sceneBreak"
    },
