    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乌有",
      "speakerToken": "char_455_nothing_1#1",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "村民",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "哎哟，快别哭了！别哭！丫头，别哭了！"
