  "sourceHash": "6b0f5b69a94328a7070bbf9e05fdc65eef7cf1c288aed286b97a08faebbd7d04",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "speakerId": null,
      "text": "嘶——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "speakerId": "avg_npc_186",
      "text": "你们是更像我......还是更像他？"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "speakerId": "avg_npc_186",
      "text": "Gla-dia。 你很强壮。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "speakerId": "avg_npc_186",
      "text": "情绪。会有我们血亲学习的。我们也在传达许多，我们会试着传达给你们。"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "speakerId": "avg_npc_186",
      "text": "Ishar-mla。活着吧。活着会很好。下一次会有其他血亲找到你......向你询问。"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "speakerId": "avg_npc_186",
      "text": "我们不太会问问题。我们会学会。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerId": "avg_1012_skadiSP_1",
      "text": "——死了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "speakerId": "avg_npc_184",
      "text": "你们这些孽种。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "speakerId": "avg_474_gladiia_1",
      "text": "是，上前来。现在轮到你。"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "speakerId": "avg_474_gladiia_1",
      "text": "这只垃圾孑然一身。外面那些恐鱼也不是它这族的。那么，只会是你的了。"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "speakerId": "avg_npc_184",
      "text": "我来把你们撕碎。我来让你们亵渎的行径受罚。"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "speakerId": "avg_npc_184",
      "text": "我自己来。是得在这里把你们这些杂种都解决掉。生命可贵，但留你们的命是浪费资源。"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "speakerId": "avg_npc_184",
      "text": "一个重伤的孽种。一个动弹不得的孽种。我会把你们的残渣抛洒在大地上，让最低贱的陆地生物吃掉你们的一切。"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "speakerId": "avg_npc_184",
      "text": "杀死你们两个，轻而易举——"
    },
    {
      "type": "dialogue",
      "speakerName": "歌蕾蒂娅",
      "speakerId": "avg_474_gladiia_1",
      "text": "不用再装了。比起海嗣这些垃圾，还是你们这种曾经是人，现在又伪装成人的最让人反胃。"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "speakerId": "avg_npc_184",
      "text": "（嘶吼）"
    },
    {
      "type": "dialogue",
      "speakerName": "主教",
      "speakerId": "avg_npc_184",
      "text": "你们会死在这里！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "是不是把我忘了？"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
