{
  "server": "cn",
  "storyId": "story_ashlok_set_1_story_1",
  "groupId": "story_ashlok_set_1",
  "stageId": null,
  "title": "决斗",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/obt/memory/story_ashlok_1_1.txt",
  "sourceHash": "81d764a58097fa7f1a28152197283ca6d8947c91378e24f5f911a10402314578",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "比赛解说",
      "speakerId": null,
      "text": "一记漂亮的突刺，伯雷斯瓦夫家的小少爷对昔日的同伴真是毫不留情！"
    },
    {
      "type": "dialogue",
      "speakerName": "比赛解说",
      "speakerId": null,
      "text": "不过保守的打法依旧无法抵御轰鸣的火炮，灰毫骑士再次用重盾挡下攻击，反手将对方逼到场地死角。"
    },
    {
      "type": "dialogue",
      "speakerName": "比赛解说",
      "speakerId": null,
      "text": "各位观众，欣赏热血沸腾的骑士交锋的同时，别忘了您还可以按下手边的按键，为您支持的选手下注。"
    },
    {
      "type": "dialogue",
      "speakerName": "比赛解说",
      "speakerId": null,
      "text": "在卡西米尔，一夜暴富不是梦想！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "格蕾纳蒂，现在就是机会。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "你站在我的对面，说明你已经做出了选择。难道几次交锋之后，你就后悔了？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "就当是满足一位朋友提出的请求——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "杀了我。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "两周前"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "上啊！砍他肩甲和护肘之间的缝隙......漂亮！"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "小点声，乔伊。你把大家的视线都吸引过来了。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "在酒吧里看转播还有低调的道理？我就是支持感染者把对面的贵族老爷打趴下！"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "呃......你们知道我没有指桑骂槐对吧，格蕾纳蒂，阿贝特？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "罗格最近的胜率一直不错，看来他在采访中提到的“利用源石技艺转变打法”并不是空话。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "反观奥兹家的继承人，他全身上下唯一值得称赞的可能只有那双赞助商提供的新型动力靴了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "将军。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "可以啊，没想到每天看报真有用处。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "当然。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "唉......我认输，格蕾纳蒂。你看上去可不止“小时候随便下过几局”的水平。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "我有很多无所事事的表亲。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "要不是太想保下那枚骑士，你或许还有胜算。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "我说，咱们能不能做点酒吧里该做的事？"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "他俩用下棋训练战术思维也不是一天两天了。倒是你该反思一下，上场淘汰赛到底为什么被对手骗得团团转？"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "嘿，这不公平，我可不像你们从小接受专业训练。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "我只是想在大骑士领租间小店，谁知道会在半道上感染？打比赛来钱快，等凑足资金我就光荣退役。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_222",
      "text": "抱歉打断各位聊天，请问您是不是灰毫骑士？"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "是我。"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "我是《红酒报》的记者，前几天向您的临时住所寄了采访信，但似乎出了一些小问题......"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "我个人十分看好您在赛场上的表现，并认为您有足够的实力冲击骑士锦标赛。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "谢谢。"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "我想除了竞技表现之外，观众们对于您私下的生活也会很感兴趣。"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "包括您常来的这家酒吧，您日常是如何训练的，还有......卡利斯卡家族将您驱逐的始末。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "我的个人生活并没有你想象的那么精彩。"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "听闻您对家族心怀怨恨。比起争夺希望渺茫的锦标赛冠军，一篇重要版面的头条新闻更能煽动骑士竞技的观众，为您扩大影响力。"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "毕竟谁不喜欢听故事，是吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "你可以编撰那些天花乱坠的小道消息，我不在意。今天是休赛日，如果没有其他问题，我想和朋友继续下棋。"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "好吧，打扰了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "我太感动了，小格蕾竟然为了我们拒绝《红酒报》的采访。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "不幸感染、家族决裂、独赴大骑士领......炒作悲情戏码可比火炮轰鸣更容易获得关注。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "那些油墨纸张不是我们的竞技场，乔伊。寻求捷径会让一名骑士失去最初珍视的那些东西。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "阿贝特说得对。我确实厌恶那些装聋作哑的家族成员，但更讨厌将自己的身份当作卖点。"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "《红酒报》下辖的副刊最近出了一个新专栏，专门采访贵族出身的竞技骑士，以此获得各个家族的支持和资助。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "从历史地位来说，我记得阿贝特的家族更加崇高，那记者怎么不——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "哎哟！你干什......咳，我是说没认出你是他的损失，阿贝特。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "哈哈哈，没被无良记者缠上是我的幸运。感谢高洁清廉的伯雷斯瓦夫家，虽然没能留下丰厚的家产，但为后辈省去了不少麻烦。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我们继续下棋吧，格蕾纳蒂。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "注意你的护甲，这个距离发射火炮可能伤到自己。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "对你来说远距离作战确实更具优势，让我想想我应该怎么解决这个棘手的问题。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "对局的时候你真的一句话都不说啊，格蕾纳蒂。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "既然如此......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "你的速度还是不够快。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "我的弹匣......空了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "抱歉，既然无法解决，只能让你犯一犯“老毛病”了。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "每次我都会庆幸自己的实力不足以和灰毫骑士对练，罗伯特。"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "我明白。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "别打扰我们训练。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "哇，就算是空包弹威力也不小。看看棚户区的围墙，又快被轰碎了。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "咳，我会出加固费用。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......等上周的比赛奖金到账之后。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "这种程度的破损一会儿用废砖和合成胶就能修补。我家庭院抵押出去之前就用这种方法修整，花销不会太多。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "不过开工前我们需要先接待一下这位被火炮声吸引来的小客人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者女孩",
      "speakerId": "avg_npc_045_nn_1",
      "text": "灰、灰毫骑士......只是想问能不能给我签个名。我看过您所有的比赛......"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者女孩",
      "speakerId": "avg_npc_045_nn_1",
      "text": "啊，大部分其实是听的收音机转播......我不想打扰你们训练，要不我还是——"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "不打扰。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "告诉我你的名字。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者女孩",
      "speakerId": "avg_npc_045_nn_1",
      "text": "戴安娜！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "签好了，感谢你的支持。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者女孩",
      "speakerId": "avg_npc_045_nn_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "还有什么事？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "唉......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "小戴安，你为什么喜欢灰毫骑士呀？"
    },
    {
      "type": "dialogue",
      "speakerName": "戴安",
      "speakerId": "avg_npc_045_nn_1",
      "text": "因、因为火炮很帅！我的朋友总说刺剑更像骑士的武器，明明盾和火炮也很厉害！"
    },
    {
      "type": "dialogue",
      "speakerName": "戴安",
      "speakerId": "avg_npc_045_nn_1",
      "text": "而且那些黑衣服的人袭击聚集区的时候，她挡在所有人前面，保护了我和爸爸妈妈！"
    },
    {
      "type": "dialogue",
      "speakerName": "戴安",
      "speakerId": "avg_npc_045_nn_1",
      "text": "还有、还有......我的个子也很小。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "呃......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_045_nn_1",
      "text": "既然你是如此忠实的粉丝，我想灰毫骑士一定不会拒绝送你一枚火炮的弹壳。"
    },
    {
      "type": "dialogue",
      "speakerName": "戴安",
      "speakerId": "avg_npc_045_nn_1",
      "text": "......！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "拿去吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "如果以后还想要签名，可以再来这里找我。只是......小心一些，不要被训练的骑士伤到。"
    },
    {
      "type": "dialogue",
      "speakerName": "戴安",
      "speakerId": "avg_npc_045_nn_1",
      "text": "谢谢您！我一定会再来的，比赛加油！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "真不知道那些粉丝为什么喜欢一根木头。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "谢谢你，阿贝特。你很会应对小孩子。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我和侄子侄女相处得不错。幸亏他们是我坚实的拥趸，不然可能也被你的赛场表现吸引走了。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "阿贝特的粉丝也不少啊，他们喜欢你那种温柔的古典骑士调调。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "就算成为对手，只要我求求情，伯雷斯瓦夫少爷一个心慈手软就会放过我啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "他不会。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "阿贝特会为每场比赛倾尽全力，他尊重他的对手，也尊重自己的信念。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "多谢赞美。我开始期待我们的对局了。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "到时候我可不会手下留情。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "不是说好接下来去看罗伯特的比赛，你俩怎么约上架了。"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "不重要不重要，我能活下来就不错了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "信使",
      "speakerId": "avg_npc_223",
      "text": "哪位是阿贝特·伯雷斯瓦夫先生？您的信。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "是我，辛苦了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "粉丝",
      "speakerId": "avg_npc_032",
      "text": "谢谢您的签名，之后我也会支持您的！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "你们有没有觉得阿贝特最近怪怪的？"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "你在嫉妒。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "是啊！凭什么就几场比赛的功夫他多了那么多粉丝！"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "你没看专栏的那篇报道？在一众炫耀家世的低俗文章里，阿贝特对骑士精神的解读可谓动人心弦。"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "但他的家族信念不会合大多数卡西米尔人的胃口。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "哈！你是不是也嫉妒他了，罗布！"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "我没有......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "阿贝特，最近你打得很拼命。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "稍微鞭策一下自己。我的目标和你一样，都是锦标赛的冠军。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "贵族骑士",
      "speakerId": null,
      "text": "精彩绝伦的比赛，阿贝特·伯雷斯瓦夫。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "贵族骑士",
      "speakerId": "avg_npc_219",
      "text": "你应该多来参加参加晚宴，我们还以为伯雷斯瓦夫家已后继无人。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "多谢关心，先生，之前忙于打理家业，实在无暇赴宴。"
    },
    {
      "type": "dialogue",
      "speakerName": "贵族骑士",
      "speakerId": "avg_npc_219",
      "text": "下次叫你的管家来取请帖吧......哦，万分抱歉，我忘记伯雷斯瓦夫家已经没有仆从，只能麻烦阿贝特少爷亲自去我的随从那里领了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "......多谢您的体谅。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "这你都不生气？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "这种程度的冷嘲热讽根本算不上什么。"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "伯雷斯瓦夫少爷。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "抱歉，我接下来还有约。晚点再见，朋友们。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "他最近多了很多商业邀请赛，好长时间没跟我们一起训练了。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "那个是《红酒报》的记者，你们说阿贝特是不是......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "他会处理好自己的事，不用担心。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "上次遗产继承遇到问题他也没跟我们说，直到赛季结束才知道他和侄子们差点被赶出宅子。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "喝酒去吧！格蕾纳蒂都说没事，那肯定没事。说不定阿贝特只是累了呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "罗伯特",
      "speakerId": "avg_npc_220",
      "text": "唉......也是，真出了事我们又能帮上什么忙呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "乔伊",
      "speakerId": "avg_npc_221",
      "text": "我说你什么时候能不这么消极......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "......那么就按照我们说定的那样，伯雷斯瓦夫少爷，合约任何时候都能生效。"
    },
    {
      "type": "dialogue",
      "speakerName": "记者",
      "speakerId": "avg_npc_222",
      "text": "不过，不用我建议您也知道，越重要的比赛越有看头，比如......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我充分信任商业联合会给出的协议，只是还需要做些准备。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "偷听的时候要放下你的重盾和火炮，格蕾纳蒂。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我知道你在等我的解释。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "乔伊随时可能跑出来冲你进水的脑袋来一下。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "你肯定是一个人来的，你不希望他们担心。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "还因为你的决定绝不会威胁到朋友。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "谢谢你的信任。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "但这意味着你要对自己做一些傻事。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我突然想起来，父母将家族交予我后，我还没有邀请过任何朋友到伯雷斯瓦夫家宅做客。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "灰毫骑士，你愿意成为我的第一位访客吗？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "小时候父亲在这片花园教我剑术，他告诉我伯雷斯瓦夫家族虽不富有，但我们的家族信念能让我们胜过所有轻视我们的权贵。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "双亲过世之后，为了维持家业，我成为竞技骑士。由于无力支付直通正式赛的“手续费”，我从预选赛打起，也认识了你们。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "罗伯特一开始并不相信你会把我们当作真正的朋友，你没有感染，又是贵族出身。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我曾用卑劣的想法安慰自己——和感染者骑士的处境比起来，我所面临的要轻松得多。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "但家境日渐窘迫，我无法忽视父母交予我的重担。我必须复兴这个被人遗忘的骑士家族，让更多人记住伯雷斯瓦夫的名字。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "夺冠是我们共同的目标，我可以向卡利斯卡证明我并非家族耻辱，而你也能逐渐收获更多人的支持。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "可我累了，格蕾纳蒂。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "即使参加再多比赛，也不如一篇报道更具影响力，这座被赎回的庭院就是证据。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "文章带来的效力并不持久，你不能完全依靠它们。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "没错。所以我做了一个决定。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "选拔赛最后一轮，我们之间的对局——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "灰毫骑士，我想让你在那场比赛里了结我的生命。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......！"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "你疯了！你拿自己的命跟商业联合会做交易？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "他们能完成我的理想，为伯雷斯瓦夫家族带来光辉。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "你说过我们的赛场不在那些纸张上，忘记最初信念的人到底是谁？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我接到了银行寄来的破产通知书。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "什么......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "没有时间了。那些支持者只能带来微乎其微的安慰，但家族衰落是我无法回避的事实。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "读报是我从小养成的习惯，除了收集选手情报之外，我也会确认有关自己的报道，有关伯雷斯瓦夫家的报道。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......为什么要在意那些虚名？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "因为我的家人待我不薄，因为我认可代代传承的骑士准则，我不想让家族的期待和坚守在我身上消失，哪怕是虚名，我也愿意背负。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "仔细想想，格蕾纳蒂。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "即使卡利斯卡将你驱逐，所有人都认为你怨恨自己的家族，可是卡利斯卡中难道没有任何一个令你崇拜，或善待过你的人？"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖母",
      "speakerId": null,
      "text": "架盾、起炮、轰击！"
    },
    {
      "type": "dialogue",
      "speakerName": "祖母",
      "speakerId": null,
      "text": "格蕾纳蒂，你是棵好苗。"
    },
    {
      "type": "dialogue",
      "speakerName": "祖母",
      "speakerId": null,
      "text": "记住卡利斯卡家的格言——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我想为这些人做些什么。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我并不害怕献出生命，但我害怕哪天站在报摊前看到《古老的骑士之家殁于最后的继承人——阿贝特·伯雷斯瓦夫之手》之类的报道。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我更害怕连这条新闻都不为人知。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "格蕾纳蒂，我的骑士朋友，如果由你为一切画上句号......"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "不。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "那会是一场真正的骑士对决——卡利斯卡的火炮和伯雷斯瓦夫的剑。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我们可以不留遗憾地交手，了结我最后的心愿，让我忘却那些恼人的贵族少爷对伯雷斯瓦夫家的嘲弄。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "不。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "记者会将我的讣告写成报道登上头条，根据合约，伯雷斯瓦夫家能重新雇佣仆从和家庭教师，辅助我的侄子侄女完成学业。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "他们将能够昂首挺胸地参加自己的成人宴，凭志向选择自己的路。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "你想象中的伯雷斯瓦夫与卡西米尔现今的贵族并无不同，你本应改变这一切。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "你为什么还拿着那门火炮？"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "你无法回答这个问题，那么你应当理解我。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "如果你拒绝我的挑战，我依旧会在正式赛中寻求谢幕。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "你不该以生命为代价......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "我明白。但事到如今，这是我能开出的最高价码了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "比赛解说",
      "speakerId": null,
      "text": "哇！这下的威力可不小！我猜很多观众都跟我一样好奇，体格矮小的灰毫骑士究竟经受了怎样的训练，才能如此轻松地举起这面重盾。"
    },
    {
      "type": "dialogue",
      "speakerName": "比赛解说",
      "speakerId": null,
      "text": "饶是熟谙古典剑术的贵族后裔，也无法抵御感染者骑士从地下竞技场千锤百炼得来的战斗技巧！"
    },
    {
      "type": "dialogue",
      "speakerName": "比赛解说",
      "speakerId": null,
      "text": "伯雷斯瓦夫家的骑士倒地不起，那让我们用最热烈的欢呼声恭喜——"
    },
    {
      "type": "dialogue",
      "speakerName": "比赛解说",
      "speakerId": null,
      "text": "等等......是不是我眼花了......我们背负着骑士信条和家族荣耀的伯雷斯瓦夫之子重新站了起来！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "咳咳......太轻了，还是太轻了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "你想逃避本应做出的选择，你和那些无能的贵族一样轻视我的决心吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "你明明知道我为了什么样的理想奋斗至今，现在却冷硬地拦在我与唾手可得的荣光之间，而我只央求你做一件事——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "用你的火炮！格蕾纳蒂·卡利斯卡！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "让大家看看南方林业的开拓者和主宰者曾经是怎样用火药建立起卡利斯卡的家业！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "让大家看看你遭受了多少奚落和不公才走到骑士锦标赛的大门之前！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "哈......哈......让大家看看......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "让大家看看伯雷斯瓦夫家还有心系骑士荣耀的高洁之士......让大家看看他最后的结局，让他为家族点起一枚将息的烛火......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沉默的骑士架起自己的武器，将炮口对准了力竭的朋友。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "终于......格蕾纳蒂......我知道你没那么狠心，你会完成我们的约定。哈......哈......你从未拒绝过朋友的请求。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "......怎么回事......"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "我的弹匣空了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "格蕾纳蒂！"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "你之前向我承诺，这会是场真正的骑士对决。双方为了心中尚未实现的理想竭尽全力，不留余地也不留遗憾。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "在你倒地之前，我就打出了最后一发炮弹，你早该察觉。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "向我挥砍的时候你在想些什么？是古老的骑士信念，还是为家族献身的自我感动？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "我想到了那个问题的答案。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "祖母传授的火炮术确实属于卡利斯卡，或许我难以舍弃这一部分，但我可以选择将炮筒对准新的敌人。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "这是我的信念，而非家族的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿贝特",
      "speakerId": "avg_npc_218",
      "text": "格蕾纳蒂......"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "你已经无法起身了，阿贝特。胜负已定。"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "跟你的头条和家族荣耀说再见，然后——"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "为了自己活下去吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "年轻人，你盯着这头条看半天了，买还是不买啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "......买。"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "好嘞！要不要多带一本副刊？更多不为人知的八卦秘辛全在这里......"
    },
    {
      "type": "dialogue",
      "speakerName": "格蕾纳蒂",
      "speakerId": "avg_npc_123",
      "text": "探病还是别带那种刺激神经的小道消息比较好。"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "听说那两个竞技骑士私下都有故事，一位的家族正式宣告破产，另一个还明里暗里地帮助感染者。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "世道真是变了啊，什么时候贵族也在乎感染者的死活了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_222",
      "text": "那感染者和感染者抱团取暖是不是听起来就合理多啦？"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "那确实......"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "哎，刚刚没看见您，真是不好意思。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_222",
      "text": "小事。来份报纸，让我看看赛场上还有什么新鲜的。"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "您拿好。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "今天的销量还不错，收摊了再去竞技场赌一把！"
    },
    {
      "type": "dialogue",
      "speakerName": "报摊小贩",
      "speakerId": "avg_npc_002",
      "text": "不过......大骑士领什么时候有那么多札拉克了？"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
