{
  "server": "cn",
  "storyId": "act18d3_level_act18d3_02_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_02",
  "title": "歌手",
  "storyCode": "SV-2",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act18d3/level_act18d3_02_beg.txt",
  "sourceHash": "5de6dee3760364af7237b7a83908df3638fffe587b5a7febc5cc9405639d76d8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "3:23 P.M. 天气/阴\n伊比利亚，盐风城"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "地图上的地方，就是这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......空气中的味道，算不上好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "请问——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "另一个男性居民",
      "text": "（垂头不语）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......怪物？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "都是人类。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "（伊比利亚语）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "现在不这么说了么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "（口音稍变的伊比利亚语）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......况且，我现在是歌手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "歌手不这样做事。何塞先生说的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "九十九......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "有人在说话。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "九十九。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "一个......孩子？他在念一个数字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我不会听错。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我的项链被......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你不能走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "text": "九十九，九十九......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你跑不掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "text": "呜......呜呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "为什么偷我东西？为了把我带到这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "一个坑，几条绳。外面那群泥点子的埋伏至少比这像样得多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你们，出来吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我本来也找你们有事。麻烦快点。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "她很古怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "是的，铁皮，这样的人，我没见过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "我也没见过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "原来你们会说话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "你是谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "流浪歌手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "流浪歌手，我不知道是什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "铁皮，不要跟她说话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "你的脸，陌生。你的打扮，奇怪。你不是这里的人。你来做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我想问一个问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "你的衣服，很新。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你见过我的同伴吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "你很强壮。你能吃饱饭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "她在我之前来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "你的箱子，很重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "乐器都不轻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "你手里拿的，很怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你们这里的琴，长得也差不多吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "（拨琴）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "耳朵，难受。是武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "可以不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "铁皮，这人，怪。不要理她。说话，好累。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "长凳。你放开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "长凳......你是说这孩子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我没想对他做什么。他拿了我的一样东西。那样东西，很重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "你是来抢东西的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我只想拿回我的东西，并且找个能听懂我说话的人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "text": "呜......呜呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "我们的孩子，你不许碰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "我们的东西，你不许抢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "我们的规则，不许打破。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "铁皮，你越走越近了。你想做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "她要伤害我们的孩子，抢我们的东西，破坏我们的规则。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "她不是我们的姐妹吗？是的话，也有她的一份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "她一定不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......你们听不懂我的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "我去问别人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "不许走。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "等等，铁皮......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "哎呦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "text": "这、这里有个坑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "木框的坑。你忘掉了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "哦，原来真的有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "text": "外面来的人，我们的地方，你不应该来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
