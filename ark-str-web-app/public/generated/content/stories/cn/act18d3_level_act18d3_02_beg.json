{
  "server": "cn",
  "storyId": "act18d3_level_act18d3_02_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_02",
  "title": "歌手",
  "storyCode": "SV-2",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act18d3/level_act18d3_02_beg.txt",
  "sourceHash": "5de6dee3760364af7237b7a83908df3638fffe587b5a7febc5cc9405639d76d8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "3:23 P.M. 天气/阴\n伊比利亚，盐风城"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "地图上的地方，就是这里。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "......空气中的味道，算不上好。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "你好。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "请问——"
    },
    {
      "type": "dialogue",
      "speakerName": "另一个男性居民",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "（垂头不语）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "......怪物？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "都是人类。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "（伊比利亚语）"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "现在不这么说了么？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "（口音稍变的伊比利亚语）"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "......况且，我现在是歌手。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "歌手不这样做事。何塞先生说的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "九十九......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "有人在说话。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "九十九。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "一个......孩子？他在念一个数字。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "我不会听错。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "你——"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "我的项链被......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#6",
      "operatorId": null,
      "portraitKey": null,
      "text": "你不能走！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "九十九，九十九......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "你跑不掉。"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "呜......呜呜......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "为什么偷我东西？为了把我带到这里？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "嗯？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "一个坑，几条绳。外面那群泥点子的埋伏至少比这像样得多。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "你们，出来吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "我本来也找你们有事。麻烦快点。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "她很古怪。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "是的，铁皮，这样的人，我没见过。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "我也没见过。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "原来你们会说话。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "你是谁？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "流浪歌手。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "流浪歌手，我不知道是什么。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "铁皮，不要跟她说话。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "你的脸，陌生。你的打扮，奇怪。你不是这里的人。你来做什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "我想问一个问题。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "你的衣服，很新。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "你见过我的同伴吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "你很强壮。你能吃饱饭。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "她在我之前来的。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "你的箱子，很重。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "乐器都不轻。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "你手里拿的，很怪。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "你们这里的琴，长得也差不多吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "（拨琴）"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "耳朵，难受。是武器。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "可以不是。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "铁皮，这人，怪。不要理她。说话，好累。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "长凳。你放开。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "长凳......你是说这孩子？"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "我没想对他做什么。他拿了我的一样东西。那样东西，很重要。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "你是来抢东西的。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "我只想拿回我的东西，并且找个能听懂我说话的人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼年居民",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "呜......呜呜......"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "我们的孩子，你不许碰。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "我们的东西，你不许抢。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "嗯？"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "我们的规则，不许打破。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "铁皮，你越走越近了。你想做什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "她要伤害我们的孩子，抢我们的东西，破坏我们的规则。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "她不是我们的姐妹吗？是的话，也有她的一份。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "她一定不是。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "......你们听不懂我的话。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "我去问别人。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "不许走。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "等等，铁皮......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "哎呦！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "这、这里有个坑。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "木框的坑。你忘掉了。"
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "哦，原来真的有用。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性居民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "外面来的人，我们的地方，你不应该来！"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
