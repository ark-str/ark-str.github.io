  "blocks": [
    {
      "type": "narration",
      "text": "第十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "这个感觉......真是让人感到，十分熟悉啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "阿米娅，是吗。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "啊，啊，哈哈......是这样......原来是这样。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "我记住了，阿米娅。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "我已经得到我想要的了。你们可以走了，快走哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "你——！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "W......？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "——你们，要留下来送死？我没问题哦，你们爱怎么样就怎么样。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "......撤回下城区。放他们走。塔露拉的命令。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "算了，事情再拖下去，就要变得没趣了。我很讨厌无聊的，就这样。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "我还是挺期待下次再会的哦，阿米娅。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "还有——那个人。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "什么——？！"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "下次，我会从你身上得到真相的，{@Nickname}。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": "char_1504_cqbw",
      "operatorId": "char_1504_cqbw",
      "portraitKey": "char_1504_cqbw",
      "text": "再见~"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......为什么......她在......做什么？"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "整合运动......撤退了。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "————已经超出了预定时间。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "立刻......撤回罗德岛。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......我来......护送后方干员。"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "speakerToken": "char_148_nearl_1",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "阿米娅......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "我没事。"
    },
    {
      "type": "dialogue",
      "speakerName": "临光",
      "speakerToken": "char_148_nearl_1",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "......好。"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "去吧，阿米娅。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "........."
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "..............."
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "......头儿......？"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "其他人呢......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "临光杜宾她们，已经带着阿米娅和Dr.{@nickname}突破了封锁。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "而留下来断后的小队的干员们......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "......都阵亡了。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "......什么......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "你我是最后两个活着的。"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "......我想起来了......那个......那个怪物塔露拉......仅仅一个人......"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "近卫们竟然眨眼间就像棋子一样迸散横飞......."
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "那个怪物像捏黄油一样捏碎了重装干员......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "别出声。你伤得很重。"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "天灾......！她就是天灾的化身......否则，否则火力小组怎么可能一瞬间被焚烧成灰......"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "明明见识过她的法术，我却......我不能相信......我......"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "惨叫......唔......呜......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "少说点！"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "......抱歉......我......我没法......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "冷静。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "我帮你应急处理了一下。"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "......头儿......你的手......？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "至少还有一只是能用的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "......头儿，逃吧。你的话，一定能够杀出去。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "我们只拖了那个怪物几分钟。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Dr.{@nickname}和阿米娅安全之前，我不能走。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "我得先阻止那个怪物。"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "头儿......我也......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "你的命是我废了一只手换回来的。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "哪怕你只能再活一分钟，我也希望这只手，至少也值一分钟。"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "我去去就回。照顾好自己。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "头儿......我真......不争气。"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "阿米娅......"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "你们一定能实现......大家的愿望......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "他们......我......呜......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "............"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "........阿米娅？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "............阿米娅？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "你怎么了......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......没，没什么。只是刚才突然有些......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......难受。"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "呜......嗯......"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "难受......吗......"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "呜......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "......别哭。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
