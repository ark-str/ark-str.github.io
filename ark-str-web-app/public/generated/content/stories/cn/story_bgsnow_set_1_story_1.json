{
  "server": "cn",
  "storyId": "story_bgsnow_set_1_story_1",
  "groupId": "story_bgsnow_set_1",
  "stageId": null,
  "title": "墨迹已落",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_bgsnow_1_1.txt",
  "sourceHash": "74d8b470b89e23fc60e655ae23973e0708168de46749971b95b7f997e903ebd6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "这就是委托的细节，我保证，一字不差地记下来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "你能确定吗？尤其是后面这几句，她当时说得那么小声，你确定没听错？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "不确定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "都已经过去半个月了，你怎么还记得她当时说话很小声？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "你不觉得有点奇怪吗？她前面说的是想要一支钢笔，按照我们的风格设计就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "后面这些话，你确定她是对我们说的，不是自言自语？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "不确定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "——啊，等等。已经过去半个月了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "我们还没开始设计？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "这不是才半个月嘛。之前我的铅笔头没削好，还有......蜜酒也喝完了嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "也对。来，先干一杯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "干杯！——呃，老兄，你觉得她的要求是什么意思？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "你看这些词......这些词的意思应该是说，很能打，很冷，很重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "哦哦，那应该是某种金属做的，大块头武器？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "然后加一点钢笔的设计。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "加一点就行了？那我觉得加在这里好看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "嗯！虽然你只是随手画了一些线条，但感觉还是不错的草图！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "所以这是个什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "看起来......像弩。你觉得呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "有那么点像，我可以动笔设计结构了。相信我，这绝对会是一件伟大的作品，比《奇谈怪论》里面的所有记录都更新奇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "这就对啦，不然怎么能让一个来自地上的访客满意呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "说得好，再干一杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人？",
      "text": "庆祝今天的工作结束！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "“......这是际崖城历史上最大的荧光蘑菇。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "唉，这本《传奇探险者的际崖城大揭秘》里面，也没有多少有效信息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "三年间的十七版矿洞路线图......并不能反映这座城市经历了怎样的动荡，当权者又有怎样的野心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "也许我要去搜寻更早期外来者留下的书籍，或者学会杜林语，才能从这些故作欢乐的破碎词句中琢磨出际崖城的历史。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......毕竟，我亲眼所见的绝非虚假。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "这里的每一个人都酗酒成性，每一个人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不......我已经从那里走出来了......我要忘记那片土地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "这些杜林人或许也一样。他们一定有某种极其伤痛的集体回忆，因此默契地共同酩酊大醉、共同逃避。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "如果不了解他们的悲痛与禁忌，我就无法融入他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "他们只是表现得无忧无虑，内心却并没有接纳我，甚至对我充满敌意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不然，为什么半个月过去，我委托他们做的钢笔还毫无消息？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "你好，阿芙朵嘉，有什么事吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "——啊，不好意思，我是不是在图书馆里说话声音太大了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "走过那样漫长又孤独的旅途后，我实在难以改掉自言自语的习惯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "醉醺醺的声音",
      "text": "你——看！我说什么来着！咱们俩比赛吃坚果冰淇淋的事情，是在第一千二百零一期上记录的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "比较冷静的声音",
      "text": "不，你把书拿反了，这是第一千零五十一期。再说，这上面的照片也不是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "我觉得你的声音不算很大。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "不过，之前你说你害怕图书馆的机器人会是什么，呃，军队设施之类的，所以我让它们都不要靠近你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "你要找什么书的话，就直接叫我来帮你吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "告诉我你们的图书分类索引法就可以了，这样我自己就能找到需要的书。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "唔，图书分类索引法......我记得是专门写了一本书的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "不过我也不记得那本书放在哪里了，稍等，我把梯子搬来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "索引里没有规定过该放在哪里吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "嗯，这个我也不记得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "毕竟，百分之八十的书籍摆放位置是不符合分类索引的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不用你帮忙了，多谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我还是去街上走走吧，应该能找到融入你们的方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "阿芙朵嘉，你这么喜欢待在图书馆，有没有考虑过为际崖城写书？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "我很好奇，像《奇谈怪论》里那样的地上人，会怎么看待这座杜林人的城......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "我......我冒犯到你了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不好意思，只不过这是我自己要面对的问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "为了彻底摆脱在地上的那些回忆，我不愿意再做和过去相似的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "真可惜，原来你的志向不是成为文学家。那就去开阔的地方看看吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "离开时将借阅的书随便放在哪个书架上都可以。还有，出门时小心，最近门口经常有喝醉的杜林人赛跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......多谢提醒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "对了，我还有一个问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "怎么了，阿芙朵嘉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "你们杜林人的姓氏是什么样的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "没有什么规定。举例来说，我的姓氏是银币，长老的姓氏是地心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "都源自事物的名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "（对杜林人来说那只是寻常的姓氏，我却无法忽视词语的含义和隐喻。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......谢谢，我明白了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "无处不在的人造日光，永远没有冬天的城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我要怎样才能藏起自己身上风雪的气息，避免自己刺痛杜林人挑剔的眼睛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "如果要抛下过去的一切，栖身在他人的穹顶下，只为不受驱逐、不被出卖......我求之不得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我记得，那两名工匠的小屋就在这——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "——咦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "大滑梯......但是没有爬上去的梯子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "半张蹦床，还没有护栏......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......这都是什么东西？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "你好，这里......为什么全都是建了一半的游乐设施，还挤在一起？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "还有，之前这里是不是有一家接受委托的工匠铺......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "哦！又抓到了一个人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......抓？你们要把我抓到哪里去？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "当然是投票现场！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "喔，看你这么惊讶，难道你也是长居室内派？居然错过了这条街的改建大赛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "这都已经是第三批比赛作品了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "为了方便大家投票决定这条街要改建成什么样子，这次大赛采用了一个新规则。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "每个参赛者都建了自己的设计方案的一部分，然后——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "——观众投票选择“最想看到哪个设施建完的样子”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "怎么样，是不是更有吸引力了呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不，我只关心这条街上原来的人去了哪里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "他们就这样被驱逐了吗？或是被流放到杜林人暗无天日的矿洞里......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "走吧，我们去投票！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "唉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "如果这是杜林人的生活方式，那我怎么能拒绝呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "但是，我个子这么高，站在人群里就会很显眼，要是我的选择和大多数人不同，杜林人会怎么看我呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "对哦，你这么高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "那你很适合当记录员进行计票欸！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "虽然我们预先找了三个记录员，但是他们好像今天都喝醉了没有来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "兴奋的杜林人",
      "text": "所以现在，记录员的位置的确是空着的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......好吧。那我们走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......“超级酒精大搅拌碰碰车”，二十票！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "还有弃权票，三百零九票！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "超过一半的人哪个都没选呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......呼，杜林人的说话方式实在是太难模仿了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "无论我多么渴望融入杜林人的生活......我似乎也不愿意用“笔录”之类的词语作为自己的姓氏。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "还是有这么多人弃权啊。看来，我们只能展开第四轮比拼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "是不是游乐设施已经不流行了？要不下次我们以艺术雕塑为主题？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "哼哼，反正我的设计总是会比你的更受人喜欢的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "作为参赛设计师，你们应该对那条街道很熟悉吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "当然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "那你们知不知道半个月前，那条街上有一家由两个工匠开的店铺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我去那里委托他们帮我做一支钢笔，他们答应下来之后就消失了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "喔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "应该是那个吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "应该是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "他们不小心把你的委托忘记了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "不然拆房子的时候他们应该会联系你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "不过这种路边顺手帮个忙的小事，忘了也不会酿成大祸，放心吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "这件事对我来说很重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "哦，你是钢笔爱好者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "你喜欢书法？还是喜欢写文章？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "来来来，别愁眉苦脸的，反正要建大工程的时候，没喝醉的工匠基本上都会来帮忙，到时候你就能找到他们了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "比如说，等眼前这场比赛有了结果的时候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "对了，说到比赛，我觉得你很适合给我提供灵感！快告诉我，地上是什么样的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "喂，这是我要问的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "那么我们现在发起投票，决定一下她要把来自地上的灵感分享给谁吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "——停。不用了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "你难道不想讲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......我讲给你们两个人听。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我只希望立刻有人拿出一个能说服所有杜林人的方案，这样我就能尽快找到我委托的那两名工匠。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "追杀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "哦——我明白了！你说的是可以干扰别人的追逐赛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "高高的围墙！但是在狭小的走道里对峙！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "大宴会厅，所有人都醉倒了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "暴力！超级暴力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "我已经有想法了！我们走！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "这些杜林人......难道真的不理解追杀和投毒是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "而我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "等等。我刚刚把这些丑恶的知识教给了他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "“她心中浮现的只是......隔绝寒气的高大石墙，铺满装饰画的回廊，摆放着热食与酒的长桌......”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "“但是她的句子一旦从这里开始，就必须写到高墙崩毁，面容慈爱的画像在火中燃烧，鲜红的酒倒在洁白的餐布上。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我已经打翻了酒杯，罪恶的念头一旦被启发就无法再根除。眼下我能做的只有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "只有阻止他们在际崖城继续散播这些故事！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "我怎么之前从来没有想到过！明明还有这种比赛方式！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "没错，这样我们就可以长久地互相较量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "这就是——“超级大水炮对战”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "你看，我会在每个窗口都放上水枪，保证水枪能打到街对面你设计的玩意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "不过，如果我们两个人中间只有一个人能被投票选为大家最想玩到的设施，那不就没法对战了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "唔，你说得对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "所以我们应该组成设计团队参加第四次比赛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "好主意！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "抱着酒桶的杜林人",
      "text": "想帮我们推销新的蜜酒？嗯......你是什么人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我......我是好酒之人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抱着酒桶的杜林人",
      "text": "哦——喜欢我们酿的蜜酒，你很有品味嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "来这里之后，我见到杜林人喝这种酒，几乎都是一杯就倒......我想这应该是很烈的酒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抱着酒桶的杜林人",
      "text": "哈哈哈，没错！就连我，两杯下肚也会醉好几天！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我觉得，也许您用的杯子稍微大了一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不过那真是太好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "事不宜迟，就让我现在立刻推着酒出发吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "（只要以推销的方式请那两个设计师喝酒，她们就不会起疑心，反而会痛快地喝到酩酊大醉。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "（让她们睡过设计大赛截止日，那些来自地上的故事就不会通过她们的设计被散播出去了，说不定还能彻底被遗忘。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抱着酒桶的杜林人",
      "text": "好，为了我们的推销顺利进行，先干一杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "等等，我从来没喝过酒......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "（见过那么多锐利的视线，我怎么敢喝酒？我怎么可能在日光下安睡？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "不，我是说，为了工作，我必须保持清醒，还是晚点再干杯吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我，我走啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "两位，你们想试喝一下——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "哦，哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "说得好，芬奇大师！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "——看来不想啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "真厉害啊，优美而又简洁的建筑线条，绝不会导致空间浪费在多余的曲面上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "而且他说得对，经过设计之后这条商业街的采光会和直射人造日光有些许区别。在这样的光线下，一些商品会显得更有诱惑力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "我迫不及待地想看到芬奇的天才设计了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "虽然我们一开始是想在那里建游乐设施来着。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "台上的声音",
      "text": "那么，同意这一方案的请举手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......好多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "只凭目测，也能看出支持者占大多数。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "但是那位设计师不是一直在台上指责杜林人的生活方式吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "哎，这样我们的设计就泡汤啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "毕竟芬奇说得很有道理，现在际崖城里已经有四分之一的地块都是游乐设施了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "期待的杜林人",
      "text": "啊，高个子，你是什么时候过来的？有没有听到芬奇的演讲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "嗯，听到了一部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我听说你们放弃了之前的设计——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "是新酿的蜜酒！这个香味，不会错！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放松的杜林人",
      "text": "既然我们已经这么熟了，我就不客气了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "唉，你们根本没有理解那个演讲者所说的“有节制的生活”，是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......不过，这样也挺好的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "让一让，让一让！这是芬奇托我们打造的售货车，现在我们要试一下它的性能！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "加速，继续加速！绕着前面的廊柱来个急转弯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "是不是空间不够转弯了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "那做一下碰撞测试吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "唔，还算安全。可能因为后面拖着的车厢里还没装东西吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......你们好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "自从这条街开工之后我就一直在等你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "嗯？唔......好像是有点眼熟的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "喂，你还记不记得这是谁来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "你说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "反正都躺到地上了，我觉得应该先睡一会儿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "唉，那我提醒一下你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我......我认识一个人，她委托这条街上的两个工匠帮她做一支杜林风格的钢笔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "她的行囊中有书，头脑中有故乡的文字，但她不愿意再触碰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "一旦提笔，她就会想起自己裹着被雪水浸透的披风，写下一张又一张无处可去的信笺。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "为什么无处可去？通往邻城的铁路断掉了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......不好意思，是我跑题了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "总之，她只想给自己封存的旧时光留一个纪念，然后成为......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "唔，成为什么呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "成为抄写员？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "那就不算完全告别过去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "那她到底是想要这支钢笔，还是不想要？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "在这个故事里，就让她成为蜜酒推销员吧！然后她和大家一起快乐地喝酒，酒的香味绕着整个人工湖都能闻到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "哦，哦！这个结局好！我喜欢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "还好，车上虽然没有装别的东西，但是装了两桶蜜酒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "什么，你带了？你早说我就早从地上爬起来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "来，干杯！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "——让我也来一杯吧，多谢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "其实，大约二十天之前，我曾经拜托你们帮我做一支钢笔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "现在......请问我的钢笔呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "哦，哦！是你啊，我想起来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "虽然我们做完了，但是忘记是谁找我们做的了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "......等等，钢笔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "懒散的杜林人",
      "text": "我们做的好像不是钢笔啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "严谨地说，有一部分是钢笔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "但概括地说，我们做了一把弩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "弩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我......怎么可能想要一把武器？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "不过，虽然我不记得是谁的委托，但你当时说的话我到现在都还记得。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "严谨的杜林人",
      "text": "你的描述太生动了，就算我不知道为什么要用一支钢笔去刺心脏，我也觉得胸口好像中箭了一样痛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......嗯。你们还是再为我做一支钢笔吧。另外，我还想要一台打字机。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "阿芙朵嘉，你又来啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "嗯，我想找一些杜林人之间流行的杂志，看看怎样的广告语比较能吸引大家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "这种书就在门口的书架上，不会有错的。毕竟每天都会被很多人翻看嘛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "多谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "对了，阿芙朵嘉，阿芙朵嘉......我最近是不是在哪见过你的名字？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "嗯，为了方便投稿，我模仿着杜林人的风格，给自己也起了一个姓氏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "这么说，我应该是在最近的杂志上见过了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "我还以为你不想再写作了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......有两个杜林人，为我做了一件更适合拿来封存过往回忆的收藏品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "至于钢笔和打字机，继续使用也没什么坏处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黛柯绮·银币",
      "text": "啊，找到了！阿芙朵嘉......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "......“锐笔”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "我......不得不继续书写。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿芙朵嘉",
      "text": "毕竟，我知道自己不可能真的放下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
