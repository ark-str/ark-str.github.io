{"server":"cn","storyId":"main_1_level_main_01-10_end","groupId":"main_1","stageId":"main_01-10","title":"残留","storyCode":"1-10","avgTag":"行动后","sourcePath":"vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_01-10_end.txt","sourceHash":"585edfd0fd2a8e17b89e7d41d61484102a5a9fa3cfde26a9f256fd7fcd01a997","bodyAvailable":true,"blocks":[{"type":"narration","text":"第十一关（后）"},{"type":"background","backgroundId":"avg_11_2"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"杜宾","speakerId":null,"isRemote":false,"text":"已经突破了整合运动的拦截！"},{"type":"dialogue","speakerName":"临光","speakerId":null,"isRemote":false,"text":"但是——他们——"},{"type":"dialogue","speakerName":"临光","speakerId":null,"isRemote":false,"text":"......我......啊......"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"嘘。"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"......别让阿米娅她们听见。"},{"type":"dialogue","speakerName":"临光","speakerId":"char_148_nearl","isRemote":false,"text":"阿米娅心里清楚得很！她比我们想象的成熟得多......！"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_148_nearl","isRemote":false,"text":"......唔......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_148_nearl","isRemote":false,"text":"......嗯......？"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"就算这样，也不能让她听见！"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"再去加深她内心的煎熬是不明智的。她已经背负......太多东西了。"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"......不要让......他们的努力白费！"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"既然他们让我们活下来，我们就应该让博士和阿米娅......安全回去。"},{"type":"dialogue","speakerName":"临光","speakerId":"char_148_nearl","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"临光","speakerId":"char_148_nearl","isRemote":false,"text":"是的。"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"还不是垂头丧气的时候。"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"作为耀骑士，无论在什么时候，都该成为指引众人的光吧？"},{"type":"dialogue","speakerName":"临光","speakerId":"char_148_nearl","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"临光","speakerId":"char_148_nearl","isRemote":false,"text":"——我不清楚。但，我会去做我该做的事。"},{"type":"dialogue","speakerName":"临光","speakerId":"char_148_nearl","isRemote":false,"text":"重整队形！不要懈怠！我们就快到了！"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"呵......"},{"type":"dialogue","speakerName":"杜宾","speakerId":"char_130_doberm","isRemote":false,"text":"嘴里说着让我放心的人，真的一个都没回来过。"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_cher_2"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"{@nickname}博士......？发生了......什么......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"请，请放我......放我下来吧......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"嗯，没问题我可以自己走......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"我只是......失去意识了一会儿......没事的。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"......我们逃出来了吗？"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"Ace他们......"},{"type":"choice","options":[{"label":"......","value":"1","blocks":[]}]},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"是嘛。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"没关系的。如果是Ace的话，一定没问题的。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"罗德岛的大家，都是很强的。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"已经，快到南方出口了。只要撤出切尔诺伯格，我们就......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"我们......就......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"博士......能......让我靠一下吗......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"一下......一下就好......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_cher_10"},{"type":"dialogue","speakerName":"塔露拉","speakerId":"char_011_talula","isRemote":false,"text":"————"},{"type":"dialogue","speakerName":"塔露拉","speakerId":"char_011_talula","isRemote":false,"text":"难缠。"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"竟然......能，能做到这一步......这家伙......"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"半个街区被烧成焦炭，整个广场都陷入火海......钢铁被融化又重新凝固......"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"但他为什么......还能战斗？"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_1505_frstar","isRemote":false,"text":"奋战至尸骨无存——了不起。"},{"type":"dialogue","speakerName":"塔露拉","speakerId":"char_011_talula","isRemote":false,"text":"我记住了。"},{"type":"dialogue","speakerName":"塔露拉","speakerId":"char_011_talula","isRemote":false,"text":"......罗德岛。"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米娅"]},{"speakerId":"char_011_talula","aliases":["塔露拉"]},{"speakerId":"char_130_doberm","aliases":["杜宾"]},{"speakerId":"char_148_nearl","aliases":["临光","阿米娅"]},{"speakerId":"char_1505_frstar","aliases":["？？？"]},{"speakerId":"char_1507_Mephisto","aliases":["梅菲斯特"]}]}
