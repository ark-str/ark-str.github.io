{"server":"cn","storyId":"main_3_level_main_03-03_end","groupId":"main_3","stageId":"main_03-03","title":"回旋","storyCode":"3-3","avgTag":"行动后","sourcePath":"vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_03-03_end.txt","sourceHash":"7b25a6196704e9e14df5679efd788fef16e64e7510a2724c3ccdf62acb45f6bb","bodyAvailable":true,"blocks":[{"type":"narration","text":"第二十五关（后）"},{"type":"background","backgroundId":"bg_wild_a"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你看。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"嗯......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"这个，是扳机。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"只要这样装上弹药......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"瞄准敌人，按下扳机。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"之后，弹药就会飞出去——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"然后，握住把柄。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"聚精会神......施术。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"这样，就能引爆弹药。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我不知道我能不能......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你一定可以的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我在你身上感到了和我相同的东西。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"想象一下......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"来，握住这颗源石。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"唔......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"集中精神。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"掌心有些......热。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"没错！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"果然，果然......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"米莎，你确实，确实......哈哈，哈哈......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你确实是我的......"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"......走！碎骨，快撤！"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"这个矿场不能再呆下去了！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"发生什么了？！"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"是罗德岛的进攻！我们被袭击了！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"—————"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"这群混蛋————"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"不要慌张，组织大家进行反击！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"碎骨......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"如果是罗德岛的话......我们......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"——怎么？要我和罗德岛谈谈？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"他们，他们一定会帮助感染者的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我那么多同胞都死在罗德岛手上——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你却让我，和他们谈谈？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我的同胞，他们都是感染者！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"声称自己会救助感染者的罗德岛，难道帮助过他们吗？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"究竟是什么东西蒙蔽了你的双眼？！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我，我不知道......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"——对不起。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我有些冲动。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"只不过，确实——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"感染者好不容易拥有了一丝希望——整合运动。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"但罗德岛，他们作为感染者，却在这个时候来伤害我们，屠杀我们！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"他们，难道不是叛徒吗？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你打算和叛徒谈什么呢？！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"感染者就一定要自相残杀吗？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"那我该怎么办呢......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"难道要我任由同胞死去吗？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"没事的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我们会保护你的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你也要，保护好自己......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"别被战斗波及。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"千万要小心......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"你......一定要回来......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我好不容易才......"},{"type":"background","backgroundId":null},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"嗯，我会回来找你的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"到时候，我们一起回家——"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......嗯。"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_wild_a"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"哟呵。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"还是需要我帮你吧？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"没错。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"其实......我觉得事情，和塔露拉说的，有些不一样。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"敌人比我们想象的要强。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"所以，你必须保护米莎。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"我没有这个义务吧？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你有。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"行，行。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"但，光是保护米莎，并不太够吧？"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"如果失败，他们始终会追上来的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你有什么办法？"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"碎骨，我和你说过吧？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"......我记得。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"——只要干掉那个目标，战局就能瞬间逆转。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"Dr.{@nickname}......"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"没错哦。杀死敌方指挥官，很简单吧。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"就是兔子身边那个，带着兜帽的家伙。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"罗德岛所有的战斗都是这个家伙在指挥。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"只要杀掉他，喀！"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"罗德岛的大脑就坏死了。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"什么会变得简单的~"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"我们的人不多了，可用的战术也很少。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"在矿场前面有一个很好的埋伏圈。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"我这里的术师会帮你做些掩护——你知道该做什么吧？"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"我的部下会把他们引过来的。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"好好把握这个机会~"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我明白。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"——帮我照顾好米莎。"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"没问题~"},{"type":"dialogue","speakerName":"W","speakerId":"char_1504_cqbw","isRemote":false,"text":"呼。那么......祝你好运。"},{"type":"sceneBreak"},{"type":"background","backgroundId":null}],"observedOperators":[{"speakerId":"char_012_misa","aliases":["米莎"]},{"speakerId":"char_1002_nsabr","aliases":["整合运动成员"]},{"speakerId":"char_1500_skulsr","aliases":["碎骨"]},{"speakerId":"char_1504_cqbw","aliases":["W"]}]}
