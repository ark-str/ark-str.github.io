        {
          "label": "时光无法倒流，她已经是现在这样。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "那真是对不起咯？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "......谢谢你。如果不是你，我所珍视的一切都会被这座火山吞没。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "我欠了你很多。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "博士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "咦，黑也在这儿吗？",
