    {
      "type": "choice",
      "options": [
        {
          "label": "？！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "之前我也说过吧，我本来就对你们公司有意向。",
          "portraitKey": null
