          "text": "......小姐？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "正好，我有一件重要的事要向你们宣布！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "锡兰",
          "text": "我啊，准备向罗德岛投一份简历。",
          "portraitKey": null
