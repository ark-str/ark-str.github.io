{
  "server": "cn",
  "storyId": "act3d0_level_act3d0_st05",
  "groupId": "act3d0",
  "stageId": "a003_st05",
  "title": "此生挚爱",
  "storyCode": "OF-ST5",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act3d0/level_act3d0_st05.txt",
  "sourceHash": "a05308aa092bb8a90a5bdee60057b0e9970441b6f9b1446fa2762dd7d87dc72c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "博士，这次我可要批评你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "大家身上都多多少少有些轻伤，作为领队你也有责任的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "虽然古米已经给他们处理过了，但是下水的话，还是会影响到伤口的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "真是的，带队玩耍也别太过火呀......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "抱歉。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "唔，我也不是想破坏博士的好心情......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "这身泳装很适合你，阿米娅。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "是、是这样吗？是暴行姐姐给我挑的这件泳装，我还在害怕博士会不会不喜欢——",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "等等！不要想着岔开话题，Dr.{@nickname}！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我们这次可能确实做得有些过火......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "真是的，我也要好好说说赫拉格先生了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "明明让他监督你的，结果他也对你们睁一只眼闭一只眼......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "在没有签订合约前，罗德岛不能插手任何独立城邦的内部问题。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "要是被卷进城邦本地的麻烦，罗德岛的处境会变得非常艰难，甚至难以脱身。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "其实，我们已经......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "是啊，我知道的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士可真是做了件很危险的事情。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "——和狂热的歌迷起冲突什么的！博士好歹要有些大人样子呀。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "再怎么喜欢一支乐队，也要和其他观众和平相处哦，更别说参与斗殴什么的了！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......？可我们是......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "（嘘！）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "总之不要再问啦！整件事就是这样了！嗯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "下次可要好好注意哦？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我知道了。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "嗯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士，快来吧，我在礁石另一边发现了很多好看的贝壳！海滩什么的，好有趣呀！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "水不凉，嗯......",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（跟着阿米娅走）",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "来，博士，这里走！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "（向阿米娅泼水）",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "哎！博士！别这样！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "可恶！看招！哈哈哈哈......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "（拉住阿米娅的手）",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "阿米娅",
              "text": "嘿嘿......",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "Dr.{@nickname}，你来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "我听锡兰说了你们罗德岛的事情，我很想跟你聊聊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "如何，就陪我出去走走吧。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......好的。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "感谢你，罗德岛的博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "这次如果没有你的帮助，小女的鲁莽行动恐怕只会惨淡收场。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那不是鲁莽。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我并没有做太多的事情。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你应该感谢的人是锡兰才对。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "克洛宁是我一手栽培起来的，他有野心，但也有这个能力，所以我这些年对他的一些小动作总是睁一只眼闭一只眼。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "但是，这几年，他有些走偏了，我对他并不放心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "这一次，借着前往新开发区的机会，我留下黑，也是想让她看看这小子还能不能用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "结果很遗憾。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "为什么和我说这些？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "......我很喜欢沿着这片海滩散步。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "因为，芭芭拉——我的妻子，她就沉睡在这片海里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "我还记得那一天，天气有点热，夕阳很好，就在这里，她和我说，“要是我们能永远生活在这里就好了”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "转眼，就只留下了我一个人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "博士，回头看看。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "你能明白吗？这座城市是我为她打造的天堂。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "而我为什么要告诉你这些......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "因为我看得出，你和我是同一种人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "这个世界上，有些事不是靠好的那些东西就能解决的，有时候，必须借助一些所谓不好的东西。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我是。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我不是。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "谁知道呢。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "对我来说，善良与否在很久以前就没有任何意义了，有的只有结果，有的只有这座城市。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "为什么不告诉锡兰？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "我不是来寻求理解的，博士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "我如果需要我女儿的理解，我和她就不会是现在这个样子。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "而且，告诉了她她就会理解吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "不会的，她还要很长时间才会理解，这个世界不是她想的那样条理有序。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "黑希望她永远不会理解，而我......很遗憾，我失去了选择的机会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "博士，锡兰她想要加入你们，我让黑和她一起去，这些我都允许。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "因为这座汐斯塔已经不再是她的天堂了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "我已经看过新的地质报表了。照这样下去，汐斯塔迟早会在迸发的岩浆中落下帷幕。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "我们推迟了那一天的到来。对你们今天的努力，我表示感激。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "这些年来我一直在寻找彻底解决这件事的办法。我找到了，但代价也很一样巨大。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "我一直投入精力的高新区，那将会是一座全新的移动城市，现在看来，那将会成为新的汐斯塔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "我对这里的执着很深，但这并不意味着我会对身旁浅睡的火山熟视无睹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "这次黑曜石节结束后，我们将迁进移动城市；现在的汐斯塔城将会被我们抛弃，迟早淹没在滚热的岩浆中。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "那黑曜石节......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "据说这片海洋有着它的边界。也有人对我说过，这里不是真正的大海，它的边界也许宽广，却有尽头。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "那么我们会环着这片海走下去。或许有一天，我们会真正回到起点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "只是，这座有着美丽海滩和盛大的黑曜石节，以及这座能感受到火山气息的海滨城市本身——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "这座有着无数汐斯塔人回忆的汐斯塔，终究是不复存在了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "也许有一天，你可以把我说的这些告诉她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "你也可以永远都不告诉她。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "而有一天，当她需要一些帮助时，你可以来找我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "无论汐斯塔在哪里，变换成何种模样，这座城市，永远会是她的后盾。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "不——该这么说。只要汐斯塔人还在，汐斯塔就永远在。她们这些年轻人才是真正的汐斯塔。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "趁现在，好好享受这次的黑曜石节吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "至少在找到新的理想场地之前，我们只能搁置和塞壬唱片之间的合作啦。我该去和他们好好谈谈了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "黑似乎也有话想跟你说，她在那边。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "如果我说太多，她就更没话可说了。让她自己和你说吧。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "......老爷。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "赫尔曼",
          "text": "别介意。之后是你们年轻人的事情了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "你好。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你的目的是什么？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "黑",
              "text": "不用紧张，我已经不是你的敌人了。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "你好，陌生人？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "黑",
              "text": "呵，你好，陌生人。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "要不要喝一杯？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "黑",
              "text": "现在就免了。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "其实，也没有什么特别的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "原本我是想教训你一顿的。小姐不该遇到这种危险。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "但我也要谢谢你。没有你，我和小姐也许永远没法解开误会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "黑",
          "text": "我一厢情愿地不想让她触碰这些事情，但也许你才是对的，她有自己的想法，也有自己的责任。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你不该替她做决定。",
          "value": "1",
