    {
      "type": "dialogue",
      "speakerName": "老警察文森",
      "speakerId": null,
      "text": "（镇长昨晚被人袭击了，现在到处找人撒气呢，让我们一定要找到凶手。）"
    },
    {
      "type": "dialogue",
      "speakerName": "老警察文森",
