      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾维",
      "speakerId": null,
      "text": "（爸爸？！）"
    },
    {
      "type": "dialogue",
      "speakerName": "艾维",
      "speakerId": null,
      "text": "（你拉我做什么！石英姐姐她......）"
    },
    {
      "type": "dialogue",
      "speakerName": "皮克特大叔",
      "speakerId": null,
      "text": "（从现在开始，你要是不想给家里惹上麻烦的话，就闭上嘴。）"
