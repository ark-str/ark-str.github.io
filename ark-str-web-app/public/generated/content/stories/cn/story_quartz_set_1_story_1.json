    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "艾维",
      "speakerId": null,
      "text": "这是......石英姐姐你的吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "艾维",
      "speakerId": null,
      "text": "你......"
