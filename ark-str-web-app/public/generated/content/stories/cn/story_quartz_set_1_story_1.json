    {
      "type": "dialogue",
      "speakerName": "老警察文森",
      "speakerId": null,
      "text": "你想做什么？！"
    },
    {
      "type": "dialogue",
      "speakerName": "老乞丐",
      "speakerId": null,
      "text": "我是来找她的，不是来找你的。"
    },
    {
      "type": "dialogue",
      "speakerName": "老乞丐",
      "speakerId": null,
      "text": "你先休息一下吧。"
