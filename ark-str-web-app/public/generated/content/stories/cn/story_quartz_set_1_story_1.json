      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老警察文森",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "老警察文森",
      "speakerId": null,
      "text": "小姑娘？小姑娘？"
