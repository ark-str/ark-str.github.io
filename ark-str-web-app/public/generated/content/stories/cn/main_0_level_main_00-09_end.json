  "storyId": "main_0_level_main_00-09_end",
  "groupId": "main_0",
  "stageId": "main_00-09",
  "title": "临光",
  "storyCode": "0-9",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_00-09_end.txt",
