  "groupId": "main_0",
  "stageId": "main_00-02",
  "title": "守卫",
  "storyCode": "0-2",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_00-02_end.txt",
  "sourceHash": "817d425975f7f2cf442e333f7540864411bde71d8de0136e0ab1c41bfa5ddee6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "哈，哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "整合运动还真是......精力旺盛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "你们，是什么人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "怎么会这个时候，出现在切尔诺伯格！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫干员",
      "text": "哈？怎，怎么回事——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "间谍吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "（如果泄露了身份，被乌萨斯当局盯上，后果不堪设想！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "（必要的话......！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "——小女孩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "你......感染者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "别动！放下武器！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "（做好防护准备，一旦对方有敌对倾向......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "（烟雾？从哪里......）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "先生，对我们抱有敌意的人究竟是谁，你应该很清楚！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "杜宾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "重装干员！敌袭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "什，什么？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......整合运动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "阿米娅，小心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "她和那些普通的感染者暴徒，不是一回事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哼，逃跑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "又能逃到哪里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "去，撕碎他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "——————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "就连手下的整合运动成员也是一副训练有素的样子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "难道是，整合运动的头目吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "雾气越来越浓了......想借助雾气发动奇袭吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "军警先生，我们必须立刻撤离这个区域！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "如果让他们封锁了我们的退路，我们就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "你们这些感染者，都给我滚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "我得到的命令是防卫这条大街。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "感染兔子，我不管你们来这里有什么目的，想干什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "如果你们是来破坏我们的城市的，自然会有人惩罚你们。乌萨斯的愤怒是无休止的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "如果不是，那这里发生的事情，和你没有关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——我知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "每个乌萨斯人都知道，不把背脊朝向敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "快滚！我们没空理你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "杜宾！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "走！去第一汇合点！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杜宾",
      "text": "各小队！动作要快！快！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "来啊！感染者混球！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌萨斯军警队长",
      "text": "你们就这点本事吗？只会站在那里看着吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "切尔诺伯格人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "该死。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
