      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "avg_npc_394_1",
          "text": "博士，请相信我。自从上一次解除限制，我成长了许多。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerId": "avg_npc_394_1",
          "text": "我知道我们才刚刚进入伦蒂尼姆，我不会放任自己在这里倒下。"
