  "storyId": "1stact_level_a001_02_beg",
  "groupId": "1stact",
  "stageId": "a001_02",
  "title": "察言观色",
  "storyCode": "GT-2",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/a001/level_a001_02_beg.txt",
  "sourceHash": "f1e956dcf1e8af64b12a3903c95c4ce93f603b2f1ed1f6f705c00de6ed6350eb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "拦住她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "拦什么啊！你没看到他们全部被干掉了吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "你上啊，你平常不是很厉害吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "我，我不行！这家伙可是那个灾星啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（阿戈尔语）拦住我的都会死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（阿戈尔语）向我挥出武器的都粉身碎骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（阿戈尔语）想死的，向前踏出一步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "你究竟在说些什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "唉？上尉？上尉怎么消失了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "上尉掉进河里了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "这、这家伙一击就......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "啊，忘了他们听不懂......算了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "说，她在哪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "她？你指谁？别问我，我什么不知道啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "呃啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "给、给我记住！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "喂！你们别急着撤退！先把上尉捞起来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "那、那个人是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "你认识她？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "她可能是我的同事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不过，接到这项委托的应该是我啊？我可是好不容易才从陨星姐手里抢到这项任务的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "唔唔唔......也许她是为别的任务来的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "唔，赏金猎人好像溃退了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "事不宜迟，我们趁现在溜出村子吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "既然还有其他干员在这个村子里，说不定事情会好办一些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "可萝尔，楼梯很黑，你要扶紧我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "那个，你要和她联络一下吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "嗯，如果可能的话，我想——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "噗啊————————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "哇——————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "我、我的鼻子！这个门怎么自己弹开——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "欸？这里怎么会蹲着人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "格拉尼！发生了什——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "你们全都给我闭嘴！嘘！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "......嘘？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "唉，你们这些干农活的肯定什么都不懂。没看到那个灾星吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "无论是哪个赏金猎人，都不会想和她碰面的！敢在她面前昂首挺胸的，多半是没见过她毁掉整座城市的样子吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "这么夸张吗！那不是靠她一个人就可以把————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "声音轻点，别被她发现！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "唔，可是我还要找她——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "说了小声点！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "好，好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "感觉比罗德岛里流传的版本更离谱......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "那、那个怪物走了吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "好，好像走了......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "总算走了，啊哟，吓死我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "是，是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "原以为这点活我们一队就能搞定，怎么会碰上这种麻烦事。那种家伙都来了的话，得做好准备才能——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "——等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "哈！拿枪的小子！居然在这里碰见你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "还有村长！你真是送上门来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "格拉尼，你难道是故意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不，只是他们态度那么好，我也没回过神来啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "废话少说，把村长交给我们！不然我手里这把刀保证就让你吃足苦头！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "就用那把断刀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "......这，这小子什么时候出的枪？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "用暗号召集附近还在的人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴的赏金猎人",
      "text": "还有，去把之前用来毁掉农田的虫子都赶出来，让她们尝尝厉害！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
