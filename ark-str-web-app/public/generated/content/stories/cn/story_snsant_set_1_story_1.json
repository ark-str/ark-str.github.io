    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雪雉",
      "text": "一点了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雪雉",
      "text": "今天晚点睡，让我看看终端内部源石电路的接法......",
