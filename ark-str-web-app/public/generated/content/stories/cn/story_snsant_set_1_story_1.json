    },
    {
      "type": "dialogue",
      "speakerName": "雪雉",
      "text": "嘿嘿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "话不是这么说的，雪雉为修终端忙了好多天，怎么能一分钱都不收——",
