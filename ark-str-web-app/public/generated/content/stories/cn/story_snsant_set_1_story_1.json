    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "真的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "这可是可露希尔小姐都没做到的事情！",
