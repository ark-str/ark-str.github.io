        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerId": null,
          "text": "撤掉周边的埋伏吧，回去支援我们抢下来的那几间工厂。"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerId": null,
          "text": "顺便通知那几个负责人，在我说结束之前，他们的炉子别想熄火。"
        },
        {
          "type": "dialogue",
          "speakerName": "神秘的雇佣兵",
          "speakerId": "avg_npc_399_1",
          "text": "是。"
