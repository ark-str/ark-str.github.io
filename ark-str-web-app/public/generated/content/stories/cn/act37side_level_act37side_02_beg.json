        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerId": null,
          "text": "欢迎回家，维娜。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "<p=1>议长办公室</><p=2>1098年12月10日 9:28 P.M.</>"
