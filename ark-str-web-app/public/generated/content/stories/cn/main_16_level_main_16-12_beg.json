        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "源石......",
          "value": "1",
          "blocks": []
        },
        {
          "label": "为什么会是这个样子？",
          "value": "2",
          "blocks": []
