    {
      "type": "choice",
      "options": [
        {
          "label": "我记得。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "它们之间有关系？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "这可能就是它们的原型，或者说原始素材。"
