{
  "server": "cn",
  "storyId": "main_11_level_main_11-04_beg",
  "groupId": "main_11",
  "stageId": "main_11-04",
  "title": "等价交换",
  "storyCode": "11-5",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_11-04_beg.txt",
  "sourceHash": "63f05f2ba403d4deefd2f6948d2de877ad9819a1b3315923741b753b5f7c4adb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "1098年\n2:55 P.M. 天气/阴\n伦蒂尼姆"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "戈尔丁女士，您总算回来啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈尔丁",
      "text": "我赶上了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "当然。这部您排了一年多的戏，孩子们可是第一回完整演出。您要是没赶回来的话，谁会自说自话开始？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "戈尔丁",
      "text": "我可要找个好位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "孩子们，都准备好了吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "顽皮的男声&天真的女声",
      "text": "都准备好啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "戈尔丁",
      "text": "那开始吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "茉莉",
      "text": "关灯——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "农民",
      "text": "早安，阁下！您的脸上布满愁容，请问是什么让您如此心焦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族",
      "text": "胜利的号角声已在城墙上盘旋了三天三夜，可我的心为何还是如此焦灼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "农民",
      "text": "我们伟大的将军不是早已凯旋了吗？赞美他的英勇与无畏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族",
      "text": "英勇？无畏？也许是的。但你没有看见他归来时眼中的光！当他看向王冠的时候，就像荒野上盘旋的羽鹫盯着一瘸一拐的肉兽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "农民",
      "text": "贪婪会使一个好人堕入地狱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "贵族",
      "text": "而人们永远只会觉得，这是自己应得的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆商人",
      "text": "这就是我们的条件，阿勒黛小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆商人",
      "text": "您需要把某些“货物”运进伦蒂尼姆，而这次不同往常，无论是数量还是重量......可都不一般。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆商人",
      "text": "我不会问您运的是什么，为什么需要，但您必须清楚我们这样做会冒多大风险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆商人",
      "text": "您也知道，眼下能帮您做这种事的人可实在不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆商人",
      "text": "萨卡兹紧紧盯着所有物流出入口。要是让他们知道这种私底下的交易，我们一个都没法活着离开伦蒂尼姆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆商人",
      "text": "就算您背景再硬，盯着您的那几位朋友再贪心，能让您在中央区保持这样的生活，恐怕这事儿也不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆商人",
      "text": "想要做成这笔生意的话，您得拿出一些匹配风险的报酬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "谢谢您愿意见我，珀蒂先生，我会好好考虑您的提议。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆商人",
      "text": "时间不等人。您务必尽快做出决定。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "他们要价很高。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "我们讨论过这种情形。眼下皇家铸币厂也在萨卡兹手里，这条消息肯定早就通过玛格纳区的银行家们传遍了所有国家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "做走私生意的商人最担心拿到的钱在下个月就变成一堆废纸，自然需要一些长期上更能保值的酬劳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "你想答应下来吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "珀蒂先生刚刚说得没错，“时间不等人”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "我们最多还有五天准备时间。想要突袭城防军指挥塔的话，我们必须把更多武器运进城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "......可他们想要的东西对你的意义非比寻常。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "可我们在这个位置上，克洛维希娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......我在这个位置上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "你是怎么猜想它对我的意义的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "恐怕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "不，我可以肯定地说，克洛维希娅，你的所有猜测都不对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "你以为我是什么了不起的坎伯兰公爵大人吗？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "那时你恐怕还没出生，而我，\n亲眼目睹了维多利亚那位了不起的狮王陛下被吊死在王宫花园里的绞刑架上。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "我姓坎伯兰，坎伯兰是陛下最忠诚的朋友，人尽皆知。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "我现在正完好无损地站在你的面前，是曾经高坐在议会里的那些大人物发了慈悲吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "就算如今，莱托中校的酒会我仍会频频参与，我对他们而言暂时还算有用，他们需要我来安抚民众。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "当然，这是为了我们的事业。可这也是我的手段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "克洛维希娅",
      "text": "我很清楚你的付出，阿勒黛。没有你的掩护，自救军不可能撑到这一天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......我已经不是个孩子了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "阁楼上的那堆东西，什么也不是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "只是一堆废铁而已。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......艾尔希。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "麻烦你安排一下，把它搬下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家艾尔希",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "你不赞同我的决定吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家艾尔希",
      "text": "......我不敢说，小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "我需要你说出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家艾尔希",
      "text": "阿勒黛小姐，不管您怎么说，它......它依然是坎伯兰家的蒸汽甲胄！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家艾尔希",
      "text": "您的先祖——那位高贵的老公爵的鲜血流淌在甲胄里。它是维多利亚赐予坎伯兰家的荣耀，是坎伯兰家“永远高洁”的象征。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家艾尔希",
      "text": "它可以毁于战火，可以被交付给另一位高洁之人，却不该......不该被一个利欲熏心的商人当作货品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "你觉得珀蒂先生不配拥有它？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家艾尔希",
      "text": "把古老的甲胄！当作收藏品！然后以低廉的代价换取一些——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "艾尔希，你一直陪在我的身边，从我出生开始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "我们一起把已经不存在的“坎伯兰家”维持到了今天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "坎伯兰家不是由一堆空泛的名词构成。“荣耀”“忠诚”“纯净”或者“善良”？事到如今，早就失去了意义。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "艾尔希，它由你，由我组成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家艾尔希",
      "text": "......我明白了，小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "今天......他们有来信吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "管家艾尔希",
      "text": "还没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "你知道吗，艾尔希，过去的音乐......仿佛还留在我的脑子里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "这座宅邸曾经接待过一位国王。而他现在又在哪里呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "抱歉，亚历山德莉娜殿下——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......叫我维娜吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "你来了，维娜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我刚和战士们一起巡逻回来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "你仍然愿意和自救军的战士们一起执行任务，这很了不起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我想尽可能多做点事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "战士们知道你在这里就足够了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我听克洛维希娅说起了一些事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "哈哈，只是阁楼堆了太多杂物，我总得打起精神来打扫一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "那地方积了太多灰，我可不敢劳烦一位尊贵的殿下帮我的忙。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "阿勒黛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我不想看见你不得不卖掉那具甲胄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "这是殿下的命令吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我没有资格命令你，你才是自救军在这里的负责人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你比我更清楚什么是对自救军而言更好的决策，我也明白甲胄能换来机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "但是......请给我一点时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我会想办法解决。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......维娜，你可以不用管这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "这是自救军奥克特里格区负责人的命令吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "如果一切都没有发生，说不定......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "算了，一切都已经发生了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆市民",
      "text": "海蒂女士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "怎么样，有戈尔丁的消息了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆市民",
      "text": "是的，她刚通过书店的发报机发了一则信息过来，已经转录到您的终端上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "好......很好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "信息里说，她很安全。奥克特里格区的计划在照常推进。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海蒂",
      "text": "麻烦你给她回信，博士小队在刚才顺利通过哨卡潜入海布里区。多亏了那几位与罗德岛合作的雇佣兵......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "凯瑟琳，九号卸货区的传送带出了点问题！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "我看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "有一颗螺丝松了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "帕特！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "我在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "今天是你值班。时间越来越紧，你是怎么工作的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "要是今天的进度被耽搁了，小心萨卡兹把你的脑袋当成钉子敲进钢料里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "对不起，凯瑟琳。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "......扳手呢？拿过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "好......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "给。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "这时候倒是变机灵了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "......是你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "好久不见，奶奶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "我回来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "帕特！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "凯瑟琳......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "下工之后去你的组长那里做检讨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伦蒂尼姆工人",
      "text": "啊？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "你让闲杂人员进入了工厂最重要的卸货区。没把你赶走都算轻的了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "......奶奶，这和帕特没关系，不是他放我进来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "好。帕特，叫上汤米和戴一起滚去检讨，你们仨谁都别想跑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费斯特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凯瑟琳",
      "text": "你，还有你旁边这个不知打哪来的怪家伙......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "在叫我吗？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "凯瑟琳",
          "text": "跟我走。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "骑士",
          "text": "先生，王宫为何如此安静？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "老人",
          "text": "王宫？王宫在哪里？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "骑士",
          "text": "您明明正靠着王宫的外墙。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "老人",
          "text": "请挪挪步子吧，铁疙瘩，你挡住我的太阳了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "老人",
          "text": "我只是靠着一栋无人的空房而已。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "骑士",
          "text": "我是蒸汽骑士，我会肃清邪秽与不义！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "老人",
          "text": "年轻人，一切已经结束了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "骑士",
          "text": "不，不会结束！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "骑士",
          "text": "只要我们仍在思考什么是善恶，只要我们依然不惮于做出选择，就不会结束！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "骑士",
          "text": "我正是为此而来，我会邀请人们加入我的队伍！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "骑士",
          "text": "就连您也仍然没有松开握紧的拳头，不是吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "阿米娅，我们被发现了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "有多少敌人？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "侦察干员汇报说，至少有四支雇佣兵巡逻队正在朝我们的方向过来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "要接近城防军指挥塔的话，我们必须通过前面这个街区。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "现在我们才刚刚踏入街区的边缘......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "萨卡兹守军的反应极其迅速。也就是说，我们被伏击了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "备用路线的情况怎么样？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "要是雇佣兵都被引到正面来的话......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "不，行不通！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "还有一支队伍在迅速靠近我们！是自救军的兄弟刚刚发现的！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "自救军怎么说？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "他们从萨迪恩区撤退时，跟这支队伍打过照面！这些萨卡兹的作战方式很......很......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "“不成人形”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......是血魔的手下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "通知所有小队成员，本次行动终止，准备撤退。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "来不及了。血魔士兵的行动速度简直不像人......自救军战士跟他们交火了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "更改目标，支援自救军战士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "那个卡特斯在哪里？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救军战士",
          "text": "什么卡特斯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "别跟我装傻。她这几天都跟你们在一起。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救军战士",
          "text": "我听不懂你在说什么，更不会回答你。就算你杀了我也不成。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "萨卡兹战士",
          "text": "又是一群硬骨头。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "自救军战士",
          "text": "呃啊——！这都什么啊......虫子？！该死！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "朋友，坚持住！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "罗德岛干员",
          "text": "重整队形，别被那些满地乱跑的虫子冲散。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "重装干员，掩护我们的自救军朋友撤退！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "罗德岛与自救军是一起来的，也会一起走！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
