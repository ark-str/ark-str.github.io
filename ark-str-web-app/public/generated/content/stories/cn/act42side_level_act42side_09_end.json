    {
      "type": "dialogue",
      "speakerName": "“圣徒”",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "为一个真正的家园，我们穿越最凶险的峡谷、最贫瘠的荒原，去寻找沉睡的银色山脉。"
