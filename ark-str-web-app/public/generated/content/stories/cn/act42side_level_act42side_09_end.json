      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "教宗阁下？"
    },
    {
      "type": "sceneBreak"
    },
