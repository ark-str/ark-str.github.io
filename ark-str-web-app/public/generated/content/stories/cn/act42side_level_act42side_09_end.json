    {
      "type": "dialogue",
      "speakerName": "“圣徒”",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "而你仍想孤身一人阻挡整支队伍、整个种族、整座城市吗？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“圣徒”",
