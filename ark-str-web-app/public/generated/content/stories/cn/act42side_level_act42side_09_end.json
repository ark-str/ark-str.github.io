    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "把这些年没听到的铳响，一次性都补回来！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“圣徒”",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
