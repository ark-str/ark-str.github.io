    {
      "type": "dialogue",
      "speakerName": "未知的通讯",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "你最好停下来，我瞄准你的喉咙了。"
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "speakerToken": null,
      "operatorId": null,
