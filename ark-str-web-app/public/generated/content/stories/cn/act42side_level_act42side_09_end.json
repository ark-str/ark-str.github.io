    {
      "type": "dialogue",
      "speakerName": "莫斯提马",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "同感。"
    },
    {
      "type": "dialogue",
      "speakerName": "菲亚梅塔",
      "speakerToken": null,
