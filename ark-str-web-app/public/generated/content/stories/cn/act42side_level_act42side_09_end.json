      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "我再一次和自己至亲的人站在了对立面......世事总是这样无常啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "帕特里奇昂阁下？"
