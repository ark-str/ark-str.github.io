    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "确保圣徒能够抵达大教堂，这样，她被迫中断的“降生仪式”还能够继续。"
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "我们还来得及建立一个更好的拉特兰......去解决困住我们的所有问题。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "未知的通讯",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "（滋——滋滋——）"
    },
    {
      "type": "dialogue",
      "speakerName": "帕特里奇昂",
