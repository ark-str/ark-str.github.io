      "type": "dialogue",
      "speakerName": "奥伦",
      "speakerId": "avg_npc_355_1",
      "isRemote": false,
      "text": "莫斯提马？哦，我刚才看到她了。"
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "speakerId": "avg_npc_361_1",
      "isRemote": false,
      "text": "她在干什么？"
