          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "speakerId": "avg_003_kalts_1",
          "text": "Mon3tr，护住博士。"
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "speakerId": "avg_003_kalts_1",
          "text": "接下来你所有的行动都可以视博士的状况自行判断。从未知敌人的威胁中保护博士......"
        },
        {
          "type": "dialogue",
          "speakerName": "凯尔希",
          "speakerId": "avg_003_kalts_1",
          "text": "也需要你在博士自身出现任何异样时，限制博士。"
