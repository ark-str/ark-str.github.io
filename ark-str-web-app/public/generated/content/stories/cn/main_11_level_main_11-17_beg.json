{
  "server": "cn",
  "storyId": "main_11_level_main_11-17_beg",
  "groupId": "main_11",
  "stageId": "main_11-17",
  "title": "直指命运",
  "storyCode": "11-19",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_11-17_beg.txt",
  "sourceHash": "5e18f5e00c42a1e45030695f7541118b386cb96149179621a4b76ebd180de55b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "推进之王，快看前面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "这难道是......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......蒸汽甲胄。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "在漆黑甲胄的映衬下，从气孔处往外冒的白色蒸汽格外明显。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一下，又一下。\n就像呼吸一般。\n他正拨开迷雾，他正从历史中苏醒。\n没有什么可以阻碍他，没有什么可以战胜他。\n抛弃不能，背叛不能。\n就连死亡也不能。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "它动了，快看，它动起来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "*维多利亚粗口*这到底是怎么回事！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "啧，弩箭根本没用！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "快，准备榴弹！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巨大的甲胄从满地残骸中起立。\n沉重的脚步声。\n沉闷的喷气声。\n它一步一步，走向慌乱的人们。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“蒸汽甲胄”",
      "text": "（沉闷的喷气声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "没用的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "铅踝，你出生在萨尔贡，你不明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "在我小时候，我的睡前故事里就是他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "如今我哄我孩子睡觉时，讲的还是蒸汽骑士的故事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "你想让我们战胜他？我们怎么可能战胜他？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "我们怎么可能战胜我们的骄傲，我们的荣光，我们的已经被背叛过一次的英雄？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "我们不可能战胜他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "这是......维多利亚的蒸汽骑士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "散开，散开！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "这是......什么声音？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "喷气声。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "怎么可能？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "肯定是喷气声，他们回来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "老子没跟错人！维娜原来把她的后手藏在这儿呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "摩根，我们的队伍里有蒸汽骑士了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "伦蒂尼姆真的还有蒸汽骑士？他们就在这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "他们是在守着诸王长眠之所，守着......诸王之息吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "哈哈，管他们之前在干什么呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "维娜可是他们的王！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "等我们和蒸汽骑士一起冲到地面上，那些萨卡兹一定......一定......呃，摩根，你的表情为什么看起来这么奇怪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "维娜准备把诸王之息带出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "四年了。整整四年时间，蒸汽骑士藏身在这暗无天日的地底，没有离开那把剑半步。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "萨卡兹占领城市他们没有出现，萨卡兹接管工厂他们没有出现，萨卡兹一把火烧了贵族们的宅子，他们也没有出现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "他们到底在想什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "今天，他们会与......诸王长眠之所的闯入者站在同一边吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "摩根",
      "text": "等等，是谁？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "......摩根，握紧武器。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "他们......很强。他们一直潜伏在我们周围。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "嘿嘿，不错，有点意思了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "诺伯特区的混混怎么会在这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是亚历山德莉娜手下的那个格拉斯哥帮吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "因陀罗",
      "text": "别藏在暗处嘀嘀咕咕，给老子滚出来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "啧，变数已经够多了，那喷气声居然在伦蒂尼姆再度响起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "公爵大人要是知道还有蒸汽骑士幸存，她会作何感想？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "她会不安吗？还是欣慰于那些以荣光为氅的英雄们再度归来？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "呵，荣光......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "先让我们解决这几个混混吧，别让她们妨碍阿勒黛。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“蒸汽甲胄”",
      "text": "（沉闷的喷气声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......蒸汽骑士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "四年过去了......蒸汽骑士之中，竟然还有幸存者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "那些伤痕......明明都是致命伤，萨卡兹的长钉几乎摧毁了每一具甲胄的核心，里面的人也没有生还的可能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "而且，没有王室钥匙，没人能进出诸王长眠之所。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "他就这样，被关在这幽暗的地下，整整四年......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "即便他当时侥幸逃过一劫，他又是怎么在这个地方活下来的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "盔甲之下的那个人......如今的他会是什么样子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“蒸汽甲胄”",
      "text": "（沉闷的喷气声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......你是......谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "不......你是......什么？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "火光自甲胄的头盔中亮起。\n阿勒黛感觉到，一道冰冷的视线正在注视着自己。\n注视着在场的所有人。\n火光......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "那具在火焰中咆哮的古老铠甲。\n那是她年幼时想成为的理想。\n那是她曾把获救寄托于上的希望。\n那是她亲眼目睹的毁灭。\n那是她无法直视的梦魇。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "他又回来了，他就站在自己面前。\n阿勒黛无法抑制自己的颤抖。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "你是......来清算这一切的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“蒸汽甲胄”",
      "text": "（沉闷的喷气声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "阿勒黛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "小心——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "蒸汽骑士，我是阿斯兰王的后裔，我的名字是亚历山德莉娜·维娜·维多利亚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "停下你的攻击，骑士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我们并非敌人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“蒸汽甲胄”",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "推进之王听到一个声音从自己头顶响起。\n是蒸汽骑士在说话吗？她不是很确定。那声音并不像人类的声音，反而更像机器的轰鸣。\n浓白色的蒸汽再次喷吐到他们面前，比之前频率更快，也更加猛烈。\n漆黑的骑士朝她举起了巨大的武器。\n“维多利亚。”\n推进之王突然明白过来，眼前的蒸汽骑士在呼喊着的并非她的姓氏。\n他在看着的是她手中的剑。\n诸王之息，维多利亚王权的象征。"
    },
    {
      "type": "dialogue",
      "speakerName": "“最后的蒸汽骑士”",
      "text": "“维多利亚。”",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "他将这把剑称作维多利亚。\n他誓死守卫的维多利亚。\n他被宏大的维多利亚背叛，那么，他就去守卫象征的维多利亚。\n帝国最后的骑士，将向所有试图夺取维多利亚的仇敌复仇。\n他向王位继承人发起冲锋。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "推进之王，快躲开！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "蒸汽骑士怎么会攻击你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "他难道看不出来......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "趴下——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "唔呃......哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "那把剑......火焰组成的刀刃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "别被它碰到！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "疯了，它疯了！我们根本就不可能拦住它！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "快撤吧，离开这里......离开......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "维多利亚雇佣兵",
      "text": "呃！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "要不了多久，他就能把我们全都干掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "带着你的人冲出去吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......照维娜说的做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "那么，任务取消。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铅踝",
      "text": "骑士小姐，看来我的退休计划要延迟了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "达格达，你跟着雇佣兵离开这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "殿下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你是最后一个向他们行过礼的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "你理应将他们的故事带回阳光下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "这是属于我们所有人的故事，推进之王。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "......它应该由我们每一个人诉说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "阿勒黛，我不知道你在发什么疯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "说实话，你曾是我崇敬的那种人。我原以为，你够得上骑士的荣耀。不，你甚至是我想象中的那种“骑士的标杆”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "身先士卒，不图名利，永远不会畏惧自己的敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "你可是永远高洁的坎伯兰！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "没有什么永远高洁，达格达。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "但我们依然并肩作战过，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "这里也有你的故事，阿勒黛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "......如果你仍然愿意回来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......已经不可能了，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "也许，这取决于你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "不过，我们现在......还是先面对眼前的骑士吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "骑士间的战斗要公平且荣耀，这是我的导师教给我的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "鉴于对手是这么一位遍洒荣光的英雄......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "达格达",
      "text": "殿下，请允许我同您并肩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "......当然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "战斗......与他战斗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "一个可悲的，丑陋的，欺骗了一切的叛徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "怎么敢于挑战命运？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "维娜，这是一个绝好的寓言，不是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "一个纯真的孩子想成为英雄，然而她变坏了，当她再度面对从历史中归来的英雄，发现英雄的剑指向了自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "她的死正应该是这个故事的结束。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "她理应被剥夺一切，她甚至连仅剩的使命都无法完成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "维娜......我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我不想听到你再提起“使命”这个词了，阿勒黛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "抬起头来，阿勒黛·坎伯兰。没有什么是我的使命，也没有什么是你的使命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "我们得先让他安静下来，然后如果你还想拿这把剑，你可以向我发起挑战，我会回应你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "这不是你的该死的使命，阿勒黛，如果你想这么做，你就去做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "推进之王",
      "text": "但别把这个词挂在嘴边了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“最后的蒸汽骑士”",
      "text": "（沉闷的喷气声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿勒黛",
      "text": "小心，他来了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
