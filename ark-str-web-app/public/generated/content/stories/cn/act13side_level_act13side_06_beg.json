    {
      "type": "dialogue",
      "speakerName": "莫妮克",
      "speakerId": "avg_npc_208_1",
      "isRemote": false,
      "text": "我不喜欢说废话。重复一遍，十个感染者骑士的命，换其他所有人的命。"
