    },
    {
      "type": "dialogue",
      "speakerName": "特克诺",
      "speakerId": "avg_npc_1212_1",
      "isRemote": false,
      "text": "（不行啊......估计埃内斯托他们还没进来呢。只好麻烦你也睡一觉了，大块头。）"
