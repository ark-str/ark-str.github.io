      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喇叭里的声音",
      "speakerId": null,
      "isRemote": false,
      "text": "在黑夜我与你跳起一曲无声的探戈♪"
    },
    {
      "type": "dialogue",
      "speakerName": "喇叭里的声音",
      "speakerId": null,
      "isRemote": false,
      "text": "看不清你的面容，只有你手心的温度♪"
    },
    {
      "type": "dialogue",
      "speakerName": "双月",
      "speakerId": "avg_4124_iana_1",
      "isRemote": false,
