  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十九关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "不能让他们过去！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "W应该带走米莎了——————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "不能让这些家伙得逞！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "——给我让开！别急着寻死！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "呃，呃啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "哦，哦哦......这么粗暴的作战方式，让我想起了罗德岛的一个人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "她和星熊长官大概，大概会很有共同话题吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "不要光站在那里，芙兰卡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "快做点什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "好啦，好啦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "哈，龙门的督察传说看来是真的啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "别分心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "没光是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "在看别人哦！砰！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动术师",
      "text": "唔啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "废墟二楼的那些火力小组，可是我发现的哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "很棒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "text": "嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "......我们走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "text": "不能让雇主孤身奋战。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "芙兰卡，有没有找到米莎？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "到处都没有她的踪迹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "W可能，已经把她带走了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "啧，动作也太快了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "哪里发生了......爆炸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "芙兰卡，集合各个小队，支援近卫局！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "罗德岛的各位，千万小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "这个敌人，它，它......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队员",
      "text": "它......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——发生什么了？为什么不说话？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "敌人——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......咦？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "怎，怎么会......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "————什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "嘁，这是什么把戏？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "是奇迹，奇迹啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "别发呆！找掩体！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "奇迹发生了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "————是你吗......是你吗！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "——他没事！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "他，他没事啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "碎骨还活着！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "碎骨！真的是碎骨！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "万岁！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......难道......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......不......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "整合运动......因为领袖的出现士气大振了吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "要拿下他们变得更难了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "......形势很严峻，碎骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "但至少......你回来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "——太好了......真的......太好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "米莎她也应该离开了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "这样，我们就能放手一搏了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "——我会在这里，挡住他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "你们，快走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "我会保护你们——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "说什么呢碎骨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我们不是早说过，要一起回乌萨斯，给那些家伙点颜色看看吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "text": "好好照顾自己，别死了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不，不可能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "愣在那做什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "星熊，立刻向外围的近卫局成员发出通讯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "陷阱和埋伏已经基本被我方排除，没有发现敌方领袖W和任务目标的身影。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "现在，更改作战目标！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "立刻收拢包围圈，合力夹击整合运动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "为什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......为什么会这样.......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
