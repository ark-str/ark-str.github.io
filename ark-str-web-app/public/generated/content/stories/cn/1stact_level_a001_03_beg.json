{
  "server": "cn",
  "storyId": "1stact_level_a001_03_beg",
  "groupId": "1stact",
  "stageId": "a001_03",
  "title": "意外之旅",
  "storyCode": "GT-3",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/a001/level_a001_03_beg.txt",
  "sourceHash": "5637e827e286a82b5a49a563c236769c021f1260397912f52779f2b196538419",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "咕......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "你，你把我的同伴，全干掉了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "......别、别过来啊！求你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "我、我把金币都给你！我把我的武器给你！你要什么我都——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那个女孩子在哪里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "你在说什么——？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "别靠近我——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "你这个——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "晴 \\ 能见度 14公里\n塔拉特山前森林"
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "......这块石头......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "你们两个，跟上。小心脚底，跟着我的脚印走，手也不要到处摸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "这片森林，恐怕比你我想的还要危险。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "石头上是不是刻了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "这是赏金猎人留下的符号。不按照符号指示行动的话，就会踩进设置好的陷阱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "我们要直接躲开陷阱吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "看我的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "——绊索加捕兽夹，老土的小把戏。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "树丛恰好挡住了摆锤，一旦贸然前进就会被击中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "那里，可萝尔小姐，小心点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "嗯，嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "你再向前走一步，大概就会掉进满是尖头的深坑了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "啊......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不愧是赏金猎人，很擅长这些嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "那当然，毕竟我以前——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "想要绕开陷阱是不现实的。果然，还是要全部解除掉才方便行动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "毕竟他们最危险的道路，马上就会变成对我们来说最安全的那种了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "走吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "停下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "不太对劲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "是陷阱？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "沾血的符号......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "“——怪物？”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "这什么意思？这么多年来，我都没见过有人用过这个符号。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "......啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不会吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "怪物，怪物！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "别，别过来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "真的是你啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "斯卡蒂，你是斯卡蒂，没错吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "——原来滴水村村长是和你在一起？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "啊，什么？你认识可萝尔.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "把她交给我。现在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "格拉尼，她的眼神，不太对啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "那可不行，我们应该谈——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "欸，欸？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "呜啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "这只是警告。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不，可萝尔小姐，鲍勃大叔.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "她，她怎么会攻击你？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "你不是认识她，她怎么就——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "别问那么多了！快，快跑！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "哈，哈，她还在追着我们跑吗？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "格，格拉尼，我，我跑不动了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "那个女人，真的，是怪物吧？她甚至，都没在喘气啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "为什么我要陪你们浪费时间？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "她真的要砍了我，啊不，她要拿可萝尔小姐干什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可萝尔",
      "text": "她的眼睛，好，好红.....格，格拉尼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "不行了不行了，为什么还会有这种事啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "停！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "埋伏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "就是现在！放箭！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "就是她，那个突袭我们的灾星！快，快射她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "你们给我住手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "你小子想干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "虽然不知道为什么她要追我，但好歹也是我的同事！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“上尉”",
      "text": "为、为什么要坏我的事！混账——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "格拉尼",
      "text": "趁现在，快点走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大鲍勃",
      "text": "——向东突围！走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "赏金猎人",
      "text": "别想逃出去！受死吧怪物！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "（阿戈尔语）滚开!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
