    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "丰川祥子",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "哎，等等！请不要推挤......！"
