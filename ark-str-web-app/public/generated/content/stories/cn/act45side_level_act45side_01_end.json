    {
      "type": "dialogue",
      "speakerName": "祐天寺若麦",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "“喵速达”鳞丸，若麦和云兽都喜欢吃的鳞丸！等你下单哦~"
    },
    {
      "type": "sceneBreak"
