    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "莫菲丝",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "哈哈哈哈哈哈......没想到一开始就这么狼狈啊，太有意思啦！"
