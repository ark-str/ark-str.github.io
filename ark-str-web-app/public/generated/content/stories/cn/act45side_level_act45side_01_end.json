    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祐天寺若麦",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "若麦也爱你们哟~"
