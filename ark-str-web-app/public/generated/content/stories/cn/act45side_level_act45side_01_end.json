    {
      "type": "dialogue",
      "speakerName": "祐天寺若麦",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "“梦绘人”系列轻巧装，用最简单的步骤化出一百分的妆容！"
