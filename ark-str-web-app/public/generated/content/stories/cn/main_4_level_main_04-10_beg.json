        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "......下雪了？"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "......♪"
