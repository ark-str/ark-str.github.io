          "portraitKey": "char_1505_frstar",
          "text": "等一下再来结束你的痛苦。"
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "speakerToken": "char_219_meteo_1",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "可，可恶......！"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "那么，你就是阿米娅吧。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "......！"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "——"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "你的眼神，很棒。"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "确实是属于战士的眼神。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "......抱歉。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "你......为什么......"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "......♬"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "——♪——♬——"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "——！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "怎么回事？"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "——♬——♬——"
