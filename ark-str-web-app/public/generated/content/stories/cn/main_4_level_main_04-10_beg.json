  "groupId": "main_4",
  "stageId": "main_04-10",
  "title": "灯火将熄",
  "storyCode": "4-10",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_04-10_beg.txt",
