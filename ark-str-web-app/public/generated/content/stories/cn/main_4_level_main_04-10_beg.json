          "speakerName": "陨星",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "这个怪异的旋律......"
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "——她在施术！"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "“沉进静静的黑色......♩"
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "......我，破烂的人偶与娃娃♬”"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "——"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "凭空诞生的黑色冰晶，数量又增多了？"
        },
        {
          "type": "dialogue",
          "speakerName": "杰西卡",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "冰晶缓缓降落在地面上了！"
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "糟糕，冰晶与地面的接触面......结冰了？"
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "黑色的冰面......"
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "居然......在蔓延？！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "冰晶正在迅速侵蚀周边的地形！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "别让她唱完！！"
        }
