{
  "server": "cn",
  "storyId": "main_4_level_main_04-10_beg",
  "groupId": "main_4",
  "stageId": "main_04-10",
  "title": "灯火将熄",
  "storyCode": "4-10",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-10_beg.txt",
  "sourceHash": "f505034f9057d5ad949eba69801e3ce58f16b913a3cd12783de4905f0a09f9be",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "温度......急剧下降？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "地面结霜了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "好冷......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "怎么会......就连那个整合运动的标志都被......怎么会......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "火焰熄灭了......乌云覆盖住了天空......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "啊啊......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "别慌张！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "黑钢干员杰西卡！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "保持阵形！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "你在做什么，霜叶！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "她......正在剥夺这片区域的热量！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "居然能有这么广的范围吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "......哈，雪怪们的公主......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "头次见到......比我体温还低的人呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "霜叶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "陨星......其实我......也想要......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "通过迂回来......来给你们创造空间......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "可是......我的身体......已经冻僵了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我的脚......动不了了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "霜叶！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "阿米娅，带她们突破包围。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "再过不到一分钟，敌人的指挥官......可能会冻上整个广场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "text": "我的命，可别浪费了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "阿米娅......我们不能......我不能！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我不会丢下霜叶的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我是不会——丢下任何人的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我来封锁敌方小队的行动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陨星——去把霜叶救回来！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "博士！拜托你指挥各个小队！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不用你说！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（点头）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "好的！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "想了想，这法术......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "我只用过一次呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "——“凡有血气......”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "想用冰对抗冰......吗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "唔......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "舌头，是不是不听使唤了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "你......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "————",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "雪怪小队，各自散开就位。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "我的兄弟们......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "去摧毁他们的掩体，冻结他们的血液吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "明白。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "“——我知道你在想什么。”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "咒语？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "罗德岛的兔子......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "黑色的......线？......那是什么东西？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "是，是什么法术——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "等，等等，那东西跃过了......掩体？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "别——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "——啊啊啊啊！！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "我，我的身体！好烫......！好烫！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "陨星！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "text": "我知道！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "text": "就拜托你，继续制造空隙了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "不不......不......好冷......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "呃啊......好疼，好疼呀！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "......喀......别，别再......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "快点！别再让普通的整合运动同胞们受伤！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "整合运动成员",
          "text": "了解！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "这种源石技艺......很强大。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "唔......啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "你这家伙......别想......再前进了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "呃......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜叶",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "不会让你有释放法术的机会的，小妹妹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "就这样，稍微睡一会儿吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "等一下再来结束你的痛苦。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "text": "可，可恶......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "那么，你就是阿米娅吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "你的眼神，很棒。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "确实是属于战士的眼神。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......抱歉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "你......为什么......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......♬",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——♪——♬——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "——！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "怎么回事？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "——♬——♬——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......下雪了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "“沉睡啊，沉睡吧，",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "刺猬玩偶与小熊们”......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "text": "这个怪异的旋律......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "text": "——她在施术！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "“沉进静静的黑色......♩",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霜星",
          "text": "......我，破烂的人偶与娃娃♬”",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "凭空诞生的黑色冰晶，数量又增多了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "杰西卡",
          "text": "冰晶缓缓降落在地面上了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "text": "糟糕，冰晶与地面的接触面......结冰了？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "text": "黑色的冰面......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "陨星",
          "text": "居然......在蔓延？！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "冰晶正在迅速侵蚀周边的地形！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "别让她唱完！！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "罗德岛，全力进攻！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
