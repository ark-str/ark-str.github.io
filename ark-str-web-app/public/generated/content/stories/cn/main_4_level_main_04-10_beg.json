  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "温度......急剧下降？"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "地面结霜了......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "好冷......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "怎么会......就连那个整合运动的标志都被......怎么会......！"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "火焰熄灭了......乌云覆盖住了天空......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "啊啊......！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": null,
      "isRemote": false,
      "text": "别慌张！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": null,
      "isRemote": false,
      "text": "黑钢干员杰西卡！"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "是！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": null,
      "isRemote": false,
      "text": "保持阵形！"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "speakerId": null,
      "isRemote": false,
      "text": "明白！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": null,
      "isRemote": false,
      "text": "你在做什么，霜叶！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_cher_6"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "她......正在剥夺这片区域的热量！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "居然能有这么广的范围吗！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "......哈，雪怪们的公主......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "头次见到......比我体温还低的人呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "霜叶！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "陨星......其实我......也想要......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "通过迂回来......来给你们创造空间......"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "你......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "可是......我的身体......已经冻僵了。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "我的脚......动不了了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "霜叶！！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "阿米娅，带她们突破包围。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "再过不到一分钟，敌人的指挥官......可能会冻上整个广场。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "我的命，可别浪费了。"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "阿米娅......我们不能......我不能！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "我明白。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "我不会丢下霜叶的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "我是不会——丢下任何人的！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "我来封锁敌方小队的行动！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "陨星——去把霜叶救回来！！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "明白！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "博士！拜托你指挥各个小队！"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "不用你说！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（点头）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "好的！",
          "value": "3",
          "blocks": []
        }
      ]
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "————"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "想了想，这法术......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "我只用过一次呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "——“凡有血气......”"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "呵。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "想用冰对抗冰......吗。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "唔......！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "舌头，是不是不听使唤了？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "你......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "————"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "雪怪小队，各自散开就位。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "是。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "我的兄弟们......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "去摧毁他们的掩体，冻结他们的血液吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "明白。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "“——我知道你在想什么。”"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "咒语？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "罗德岛的兔子......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "黑色的......线？......那是什么东西？"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "是，是什么法术——"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "等，等等，那东西跃过了......掩体？！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "别——"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "——啊啊啊啊！！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "我，我的身体！好烫......！好烫！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "陨星！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "我知道！"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "就拜托你，继续制造空隙了！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "不不......不......好冷......！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "呃啊......好疼，好疼呀！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "......喀......别，别再......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "——！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "快点！别再让普通的整合运动同胞们受伤！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "了解！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "这种源石技艺......很强大。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "唔......啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "你这家伙......别想......再前进了......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "呃......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜叶",
      "speakerId": "char_193_frostl",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "不会让你有释放法术的机会的，小妹妹。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "就这样，稍微睡一会儿吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "等一下再来结束你的痛苦。"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "可，可恶......！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "那么，你就是阿米娅吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "......！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "你的眼神，很棒。"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "确实是属于战士的眼神。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "......抱歉。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "你......为什么......"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "......♬"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "——♪——♬——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "——！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "怎么回事？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "——♬——♬——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "......下雪了？"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "......♪"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "“沉睡啊，沉睡吧，"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "刺猬玩偶与小熊们”......"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "这个怪异的旋律......"
    },
    {
      "type": "dialogue",
      "speakerName": "陨星",
      "speakerId": "char_219_meteo",
      "isRemote": false,
      "text": "——她在施术！"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "“沉进静静的黑色......♩"
    },
    {
      "type": "dialogue",
      "speakerName": "霜星",
      "speakerId": "char_1505_frstar",
      "isRemote": false,
      "text": "......我，破烂的人偶与娃娃♬”"
    },
    {
      "type": "dialogue",
