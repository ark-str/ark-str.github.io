{"server":"cn","storyId":"main_3_level_main_03-02_end","groupId":"main_3","stageId":"main_03-02","title":"记忆","storyCode":"3-2","avgTag":"行动后","sourcePath":"vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_03-02_end.txt","sourceHash":"73a1c6ca46b9f5e2206458f87353a350a14f635336927ccc8c166dc2c3283ffa","bodyAvailable":true,"blocks":[{"type":"narration","text":"第二十四关（后）"},{"type":"background","backgroundId":"bg_wild_a"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"你就是米莎吧？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"你好。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......？"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"......听碎骨他说了好久，今天，终于见到你了。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......你也是......感染者......？"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"是的。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"为什么要加入......整合运动？"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"为什么？"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"————"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"我的妻子，孩子......都死在切尔诺伯格人的手里。"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"乌萨斯感染者的遭遇，比牲畜还不如。"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"毁灭切尔诺伯格——？作为复仇，太轻了，太轻了......"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"他们手上有多少感染者的血？！"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"米莎——我们被人恐惧，被人愚弄，被人侮辱，被人迫害——"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"——只因我们是感染者。"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"仅仅是这样而已。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"我，我有些激动，忘了吧。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"伊万，来帮忙接下伤员。"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":"char_1002_nsabr","isRemote":false,"text":"好的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"这个废弃矿场只是临时据点，大家在这里暂时整顿一下。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"等到时机成熟，我们就撤回切尔诺伯格。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......亚——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"不。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我已经舍弃了那个名字。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"为什么......？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"过去的那个人已经死了。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"叫我碎骨就可以了。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你——是不是有点害怕？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"碎......骨？......为什么？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"呵......你会明白的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"大家知道你流落龙门之后，都自告奋勇的要把你救出来。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"在龙门，我们也接纳了许多感染者。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"——但你们......在伤害别人。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我不愿意......我不想......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"感染者为什么要互相......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"以眼还眼，理所应当。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"乌萨斯人说，对待亲人，就该像春天一样温暖......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"但对待敌人————"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":".................."},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"怎么了？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"......你知道吗？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"不——你——你不知道。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"他们来抓我时，我被拖出了家门去......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"怎么了？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我看见妈妈她，抓着我的手......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你看见的。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......不......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你一定——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"他们殴打妈妈，妈妈不肯松手......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"他们在雪地上拖出一条血路。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"如果整合运动......如果感染者能......如果————！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"如果能早一些的话，早一些的话！"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我们感染者就不用遭遇那么多苦难了！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我......我......我没敢......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......我......呜......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"米莎......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"会好的......一切都会好的。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"我不怪你。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"当时......谁有勇气呢？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"但至少现在，整合运动给了我勇气。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"亚......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"碎骨......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你可以选择，不去相信我们。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"——即便你相信我们了，你也可以选择，不加入我们。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"但你是一个感染者。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"整合运动......一定会为了感染者的自由战斗到底。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"可你们......摧毁了切尔诺伯格。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"有无数无辜的人死去——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"——无辜？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"呵，谁是无辜的？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"切尔诺伯格实行隔离制度时，有谁反对过吗？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"在我们被拖去矿场，在乌萨斯把我们丢弃在矿场和冻野，任由我们在寒冬中死去时，有谁反对过吗？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"有谁，站出来，反对过吗？！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我，我不知道......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"......整合运动有这样两个领袖，他们与乌萨斯战斗了很长时间。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"他们说过，是有那么些乌萨斯人，也在为了感染者，与乌萨斯抗争。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"但他们不在切尔诺伯格。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"切尔诺伯格冷眼看着我们死去——"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"不，切尔诺伯格乐于看到我们死去！！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"切尔诺伯格，是一座理当被毁灭的城市！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我也遇到过别的帮助感染者的人......他们......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"罗德岛？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"明明是感染者，却帮助龙门，伤害我们？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"杀死我们的同胞，残害我们的兄弟？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"不......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"你看不清事实。但你现在该看清了......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"......对不起，我太生气了。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"没事......我......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......我理解你......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"这么长时间以来，你过得......很辛苦吧？"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"大家都过得很痛苦。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"而现在，至少每个人都抱着希望。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"塔露拉......是她带领感染者，反抗残忍的一切。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"整合运动就是我们的希望。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......果然大家，都吃过很多苦。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"如果整合运动真的能保护他们的话......"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"当然了。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"就像整合运动会保护大家......我也会保护你。"},{"type":"dialogue","speakerName":"碎骨","speakerId":"char_1500_skulsr","isRemote":false,"text":"再也不会让你受伤了。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"————碎骨......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"唔，找到了——！"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"看来他们的损失不小呢。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"还好没回公司......不然又要兜一大圈再出来执行任务了呢......"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"预估一下整合运动的撤退路线。"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"把大致路线和方位一起，全都发给阿米娅。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"很快的，马上就好！"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"——嗯。"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"我们可不能让整合运动太闲着。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"嗯嗯，大概......这样......这里......差不多了！"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"准备好了吗，能天使？"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"要做什么？该怎么做？"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"先做点热身运动。"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"就从他们的岗哨开始。"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_012_misa","aliases":["米莎"]},{"speakerId":"char_1002_nsabr","aliases":["整合运动成员"]},{"speakerId":"char_102_texas","aliases":["德克萨斯"]},{"speakerId":"char_103_angel","aliases":["能天使"]},{"speakerId":"char_1500_skulsr","aliases":["碎骨"]}]}
