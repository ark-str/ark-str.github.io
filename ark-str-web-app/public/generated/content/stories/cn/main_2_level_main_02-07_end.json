{"server":"cn","storyId":"main_2_level_main_02-07_end","groupId":"main_2","stageId":"main_02-07","title":"注意卫生","storyCode":"2-7","avgTag":"行动后","sourcePath":"vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_02-07_end.txt","sourceHash":"32ac13aa58060c53e439b582bc72dd411f343a85b1c33b422cac57d262c4d410","bodyAvailable":true,"blocks":[{"type":"narration","text":"第十九关（后）"},{"type":"background","backgroundId":"bg_lungmen_b"},{"type":"dialogue","speakerName":"感染者","speakerId":null,"isRemote":false,"text":"谢谢，谢谢你们......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"这里不安全，快离开吧。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"感染者","speakerId":null,"isRemote":false,"text":"离开......"},{"type":"dialogue","speakerName":"感染者","speakerId":null,"isRemote":false,"text":"我们......又能去哪里呢？"},{"type":"dialogue","speakerName":"感染者","speakerId":null,"isRemote":false,"text":"我们把这里当成家......现在，什么都毁了......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"......抱歉。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"感染者","speakerId":null,"isRemote":false,"text":"你们......没有错。"},{"type":"dialogue","speakerName":"感染者","speakerId":null,"isRemote":false,"text":"没有错......"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"自称感染者救星的整合运动居然会攻击感染者。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"形象......是不是崩塌了呢。"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"但所谓整合运动的渗透，绝对不是自发的。"},{"type":"dialogue","speakerName":"德克萨斯","speakerId":"char_102_texas","isRemote":false,"text":"龙门一定有不少感染者，已经追随了整合运动。"},{"type":"dialogue","speakerName":"能天使","speakerId":"char_103_angel","isRemote":false,"text":"唉，宁可相信整合运动也不相信罗德岛——"},{"type":"dialogue","speakerName":"芙兰卡","speakerId":"char_106_franka","isRemote":false,"text":"罗德岛从来不开空头支票。"},{"type":"dialogue","speakerName":"芙兰卡","speakerId":"char_106_franka","isRemote":false,"text":"整合运动给感染者的，哪怕只是些幻觉，都没问题。"},{"type":"dialogue","speakerName":"芙兰卡","speakerId":"char_106_franka","isRemote":false,"text":"感染者连幻觉都很难看得到啊。"},{"type":"dialogue","speakerName":"芙兰卡","speakerId":"char_106_franka","isRemote":false,"text":"即使是幻觉，大多数感染者也会不顾一切，伸手去抓那虚无缥缈的救命稻草吧。"},{"type":"dialogue","speakerName":"芙兰卡","speakerId":"char_106_franka","isRemote":false,"text":"又有谁会选择相信，从不忍心欺骗别人的小兔子呢？"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"......我相信。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"米莎......？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"唔......"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"小心！你还不能随便走动！"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"是有点头昏......没关系的。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"整合运动......还会追上来吧？"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我不清楚他们的目的......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"只是......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"我们......走吧。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"阿米娅。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"——"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"我明白了。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"那我们就立刻动身。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"很快，我们就能离开贫民区，与龙门近卫局会合了。"},{"type":"dialogue","speakerName":"阿米娅","speakerId":"char_002_amiya","isRemote":false,"text":"谢谢你，米莎。"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"不......"},{"type":"dialogue","speakerName":"米莎","speakerId":"char_012_misa","isRemote":false,"text":"该我......感谢你。"},{"type":"sceneBreak"},{"type":"background","backgroundId":null}],"observedOperators":[{"speakerId":"char_002_amiya","aliases":["阿米娅"]},{"speakerId":"char_012_misa","aliases":["米莎"]},{"speakerId":"char_102_texas","aliases":["德克萨斯"]},{"speakerId":"char_103_angel","aliases":["能天使"]},{"speakerId":"char_106_franka","aliases":["芙兰卡"]}]}
