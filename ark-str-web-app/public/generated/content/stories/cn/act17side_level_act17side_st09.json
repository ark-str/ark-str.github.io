{
  "server": "cn",
  "storyId": "act17side_level_act17side_st09",
  "groupId": "act17side",
  "stageId": "act17side_08",
  "title": "主舰桥",
  "storyCode": "SN-ST-9",
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act17side/level_act17side_st09.txt",
  "sourceHash": "608495068b1fda6b68c0ef63a1a010cdac7007e1596469cf8e4d165a415cb91c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "走快点！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "......这些，溟痕。它们究竟是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "尽管微小，形式不同，但这些荧光的生命也是我们同胞的延展。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "先知曾说，在海洋的某个部分，发光的生命已经充斥了整个海域。它们即是整体，它们为所有同胞塑造生命的摇篮。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "“溟痕”......只不过是遥远的数千数万海里外的“祂”随波而来的些许意志。哪怕只有一丁点，也确确实实在蚕食陆地。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "溟痕会将陆地化为另一种海洋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "......是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "伊比利亚是你们计划的第一个牺牲品，格兰法洛也是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "......牺牲品？你是不是，用错了词？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "审判庭会夺走这座小镇，看看这些“美丽”的溟痕，它们一样会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "这里不再是我们的家。不再与那段如火的岁月有瓜葛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "蒂亚戈，你不该——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "乔迪也被带走了......那些逃走的人此刻应该都被惩戒军抓起来了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "你们都是凶手。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "——（激动的尖啸）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "Mon3tr——？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "它怎么会在这里？！不可能！它明明在城镇的西边——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "你骗了我们，蒂亚戈！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "负责拷问的教徒",
      "text": "还有你也是？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静的镇民",
      "text": "......在成为审判庭的卧底之前，我只是一名格兰法洛工人的女儿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静的镇民",
      "text": "别小看我们的恨意。忍辱负重，只是为了让你们一同灭亡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "审判庭也好，你们也好，都只是践踏了我们家园的敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "来看看毁灭的模样吧，看看我们当年所看见的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "极境",
      "text": "蒂亚戈——！躲开！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蒂亚戈",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（尖啸）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乔迪",
      "text": "......已经没有还能操作的地方了。剩下的，能源都......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乔迪",
      "text": "最后，就看这座灯塔，还能坚持多久了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乔迪",
      "text": "（溟痕，已经，爬到这一层了？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乔迪",
      "text": "我得再往上走......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乔迪",
      "text": "大审判官阁下......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官达里奥",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "手臂发麻。\n礁石的形状与排布已经发生了极大的变化。审判官不留余力，尽可能歼灭进入视野的敌人。\n但敌人如字面意义上无穷无尽。\n剑已锈蚀，卷匣中的炸药也已消耗殆尽。\n只有提灯中的火焰，比先前还要旺盛。\n达里奥没有一次看向身后，看向他始终捍卫的高塔。\n他看着海平面的彼方。"
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官达里奥",
      "text": "......海洋的生物，伊比利亚不会被你们毁灭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官达里奥",
      "text": "人类不会被你们毁灭。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "他咳出了卡在喉咙里的鲜血。血腥味充满鼻腔。"
    },
    {
      "type": "dialogue",
      "speakerName": "恐鱼",
      "text": "（缓慢的窸窣声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大审判官达里奥",
      "text": "我，也不会，被毁灭。只是死亡而已。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "......耐心等待。加西亚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大副",
      "text": "（乖巧地蹲在船长身边）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "等着猎物上钩的时间，总是无聊的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "还记得我们第二次捕猎怪物的时候吗？那时候我们还有上百名幸存者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "离开海岸的时候，欢呼和礼炮的声响，现在仿佛还回荡在我们耳边。我们告别伟大的海岸，满载阿戈尔的传说，奔向海的深处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "只过了几天，我们只在海洋上待了几天而已——灾难就来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "啊啊......为什么这愚蠢的细胞还要剥夺你的语言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "我多想再和你说说话，而不是和那些，腐臭的，愚蠢的，花了六十多年才抵达这里的白痴们交谈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大副",
      "text": "（伤心地蹭着阿方索的手）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "您好，船长先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "我正缺合适的饵把它钓上来，你下去如何？反正你是阿戈尔人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "......怎么？忘了我说的话吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "要么你跳下去，要么我把你丢下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "你能活下来是个奇迹。我从没想过真的有伊比利亚人能活到今天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "这与你无关，我也与伊比利亚无关。六十年时间，我已经属于这艘船。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "斯卡蒂",
      "text": "可是我们——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "——让我来吧，斯卡蒂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "狩猎愉快吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "也许我温和的态度让你们误会了许多事情。但我能感觉到你们身上流着怪物的血，我们是一样的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "我们......一样吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "与您，和您的大副？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "......谁允许你谈论加西亚的？谁允许你，用这种眼神，看待我的加西亚？阿戈尔杂种？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大副",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "我从未和你们提起过加西亚曾经是个什么样的人。你们不知道他是男是女，是高是矮，是胖是瘦，是佩洛还是魔族佬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "但你们只要知道，它是我的大副也是我的爱人，而我永远不会和外人透露半点它过去的形象。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "它不需要你们的怜悯，更不需要你们用想象的过去来与它的如今比较，我们都不需要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "可笑。与猎物混血的猎人，你们的肮脏连海浪都洗刷不掉，还胆敢对我们表露敌意？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "斯卡蒂皱了皱眉头。她极少在意别人的言辞，特别是陆上人的。但眼前这个特例的话语还是让她感到不舒服。\n大副敏锐地将目光投向斯卡蒂。它在警告。"
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "但是我们需要您的帮助。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "......你们怎么称呼这些怪物？海什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "唔，“海嗣”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "我为什么要帮助海嗣？那场灾难之后，有多少好小伙子丧命于海洋？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "您就漂泊在海洋之上，不肯回到陆地，也坚持与海洋为敌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "这就是我的生活。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "我们是......深海猎人。我们来自阿戈尔，虽然不了解您存活下来的详细情况，只凭猜测，我们也对您感到敬重。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "也希望您理解，我们所做的一切，都是为了对抗它们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "阿戈尔怎么做，和我有什么关系？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "哦，不，您误会了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "斯卡蒂微微瞥了一眼身边的幽灵鲨。她本以为幽灵鲨的那句“让她来”，是指她更擅交涉。\n但“交涉”应该是没必要拿出那柄武器的。"
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "我是说，杀死它们是我们的工作，而我本人则享受这个过程。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "既然您只是为了果腹而狩猎，杀死目标后，我给您留些血肉就是。反正这种令人作呕的玩意，我一向是不爱处理的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "你们......很有本事？比起维多利亚人，比起莱塔尼亚人？我见过你们猎杀海嗣的样子，你们没什么值得一提的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "哦，您误会了。那些被称为“恐鱼”的低等生物，一般是不值得被二队当做战功记住的，歌蕾蒂娅也没那么小家子气。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "我比您强，这是不争的事实。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大副",
      "text": "嘎......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "唔，别这么着急，大副先生或是大副小姐，还没轮到你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "......你敢动它，你就死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "我会吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "既然队长的任务是夺回这艘船，回到阿戈尔，那我们也没悠哉到可以慢慢说服您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "这本来就是更简单的交流方式——猎人的方式。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "——哈，你在找死！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "同类，我来找你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "捕食，重要事项。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "你们，并非同胞。我已认识，但你们仍可回归族群。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "我想问，你们作何打算？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索&幽灵鲨",
      "text": "滚开！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "哈，证明你不是海嗣的方法很简单。杀了它。除非你不愿意对你的“同胞”下手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "我由衷希望您不要拖我的后腿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "我更担心你会对你扭曲的“同胞”手下留情，阿戈尔人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "那您确实多虑了。毕竟，如果我真的沦落到它们一边，您也许根本打不赢我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "证明我不是海嗣之后，您愿意把船借给我们吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "没门。这艘船是我的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "真遗憾。也许我可以在这场战斗中让你失去那只手，你人类的部分就会更清醒些？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "船长阿方索",
      "text": "大副！别出手，让我看看这个自称人的怪物，和我们有多大差别。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽灵鲨",
      "text": "斯卡蒂，可别和我抢猎物喔，这场狩猎属于我，让我稍微......稍微发泄一下吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "捕食，必须去做。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "使命，塑造环境。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海嗣",
      "text": "你们，富含养分。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
