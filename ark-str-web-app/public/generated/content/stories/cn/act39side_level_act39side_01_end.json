    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "悲伤的习武教士",
      "speakerId": "avg_npc_1587_1",
      "text": "证裁官阁下，粮仓的火刚扑灭，里面什么也没剩。"
    },
    {
      "type": "dialogue",
      "speakerName": "西尔弗",
      "speakerId": "avg_npc_1583_1",
      "text": "......食物的事情我会想办法。"
    },
    {
      "type": "dialogue",
      "speakerName": "西尔弗",
      "speakerId": "avg_npc_1583_1",
      "text": "医生呢？老人家腿脚不好，你不搀她过来？"
    },
    {
      "type": "dialogue",
      "speakerName": "悲伤的习武教士",
      "speakerId": "avg_npc_1587_1",
      "text": "医生她不在了。"
