    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "西尔弗",
      "speakerId": "avg_npc_1583_1",
      "text": "......我知道了。"
    },
    {
      "type": "dialogue",
      "speakerName": "惊恐的习武教士",
      "speakerId": "avg_npc_1583_1",
      "text": "西尔弗阁下......您......？"
    },
    {
      "type": "dialogue",
      "speakerName": "西尔弗",
      "speakerId": "avg_npc_1583_1",
      "text": "弄疼你了吗......对不起......忍一下。"
