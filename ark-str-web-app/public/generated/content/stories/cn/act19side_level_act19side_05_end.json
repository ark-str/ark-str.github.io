      "type": "dialogue",
      "speakerName": "白面鸮",
      "speakerId": "avg_128_plosis_1",
      "isRemote": false,
      "text": "星......星星......"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "speakerId": "avg_135_halo_1",
      "isRemote": false,
      "text": "乔伊丝......奥利维亚，我......我快拉不住她了......"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "speakerId": "avg_135_halo_1",
      "isRemote": false,
      "text": "我的手麻得快失去知觉了！"
    },
    {
      "type": "dialogue",
      "speakerName": "埃琳娜",
      "speakerId": "avg_135_halo_1",
      "isRemote": false,
      "text": "法、法术......！"
