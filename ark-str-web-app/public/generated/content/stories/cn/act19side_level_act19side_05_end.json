    {
      "type": "dialogue",
      "speakerName": "多萝西",
      "speakerId": "avg_4048_doroth_1",
      "isRemote": false,
      "text": "赫默医生......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赫默",
      "speakerId": "avg_108_silent_1",
