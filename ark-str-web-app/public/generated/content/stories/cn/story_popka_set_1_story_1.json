{
  "server": "cn",
  "storyId": "story_popka_set_1_story_1",
  "groupId": "story_popka_set_1",
  "stageId": null,
  "title": "玩乐之间",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_popka_1_1.txt",
  "sourceHash": "27da3ed562a14a2c73aead37d0e5cadcec32124bc19ffb79f84c0742f9036aae",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "罗德岛本舰，公共休息区廊道"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "结束了耶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "没了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那我们什么时候可以看下一集？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡问问看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "巫恋姐姐，我们什么时候可以看到《菲林宝宝》第二十集呀。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "Zzzz......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "她好像看到一半的时候就睡着了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "最近都是这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "《菲林宝宝》不好看吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "斑点哥哥说，《菲林宝宝》只有小孩子才会看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "巫恋姐姐可能已经真的长成大姐姐了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我不信！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我们也就差了几岁！凭什么前两集大家能一起看到结束，现在就只有我们两个了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "我们也会很快长大的，说不定《菲林宝宝》全集结束的时候，我们就是大人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡长大以后想做什么呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我吗？我当然是回到部落里把所有不服气的人全打一顿然后当上部落勇士啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你叻？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡想变成超级英雄，一拳一个坏人，两眼放激光，在天上想怎么飞就怎么飞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "超级英雄真的存在吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我从来就没看到有人能眼睛里放出激光，也没有人能在天上飞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "能打坏人的倒是挺多的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我也能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡只是希望能变成那样嘛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡的眼睛一直在生病，所以泡普卡在想，眼睛如果哪一天能像超级英雄一样放激光就好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那就赶紧把眼睛养好吧，我还挺想看看你的眼睛的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "等病养好了第一个就给泡泡看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "真的？！好耶！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嘻嘻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "现在几点了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "四点半了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓兰姐姐说泡普卡今天可以在休息室玩两个小时，只剩半小时了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "为什么只玩两个小时？每个小时都拿来玩不好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "每天都要训练的，还要上课，之后还有作业了，作业不写完老师要生气的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "为什么要写作业？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好好学习天天向上呀，大人们都这么说的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我每天都在船上跑，从来没听说过要写什么作业。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "而且——作业是什么？能吃吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不可以啦。作业是——嗯......泡普卡也不知道作业到底是什么，只知道写了会变聪明。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡你看看？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "这就是作业？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不就是一本书嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "里面涂涂改改都是你做的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "大部分都是泡普卡涂的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不过红色笔记是老师们的批改。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "看不懂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "喏，还给你。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "要是让我学这些东西，我立刻从罗德岛跳下去跑回萨尔贡找爸爸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "有人拦着我，我就把他撞飞。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "听说，前几天有个米诺斯的姐姐——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "没有这回事，你听错了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那个丰蹄力气才没有那么大呢！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "泡泡随随便便就把她推倒了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我说的都是真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "如果泡泡以泡泡爸爸的名义发誓，泡普卡就相信这是真的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "发誓就发誓！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "泡泡以爸爸的名字郑重发誓，那天泡泡根本打不过米诺斯的丰蹄大姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "原来是真的啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你不要和其他人说啊，我真的没那么弱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "只是那个丰蹄姐姐太强了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡每次发誓就会说实话，泡普卡已经完全理解了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "没，没办法啊，爸爸说了，用人的名字发誓那个人会听到誓言内容的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "爸爸要是听到我说谎，绝对会把我屁股打烂的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "那泡普卡用爸爸的名字发誓，泡普卡的爸爸也能听到吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不知道哎，你试试看？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡的爸爸，叫——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡不记得爸爸叫什么了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "妈妈呢，妈妈也有用的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不记得了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "虽然凯尔希阿姨说泡普卡是用泥巴捏出来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "但泡普卡就是觉得自己有爸爸妈妈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "而且大家都有，没道理只有泡普卡没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你说的对哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "会不会那个白大褂医生在骗你啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "凯尔希阿姨应该不会骗人吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那个菲林医生总是板着脸，看起来就坏坏的，不像我老家萨满伯伯，见谁都笑呵呵，一看就是好人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "冷静不是坏坏哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "你看巫恋姐姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "巫恋姐姐也一直板着脸的，但巫恋姐姐很会照顾人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "上次泡泡吃仙人掌扎了一嘴刺，是巫恋姐姐把你弄晕以后一根根把刺拔出来然后交给医生的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "而且巫恋姐姐很会选苹果，又大又甜又脆。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "这倒是，她带的苹果一直很好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好吧，你暂时说服我了，巫恋不是坏坏，医生也不是坏坏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "但大家都不坏，医生也没骗你的话，为什么你会记不得爸爸妈妈呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "可能是因为泡普卡记性不太好，记不了太多事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不过泡普卡有些事还是忘不掉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "矿场里哐哧哐哧的声音，比罗德岛大好多的钢铁城市，还有许多人围着的塔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "有穿着白大褂的医生、有很多亮闪闪的大铁块、有一间安静的小房间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "还有一间白白的大房间，中间有张床。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你这不是记得很多嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "可爸爸妈妈的名字，想不起来......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "或许哪天一拍脑袋就想起来了呢，我经常这样想起事情的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你要我帮忙的话，我可以帮你拍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我力气可大了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "咣咣咣咣！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡力气太大，会把我拍傻的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "会吗？那还是算了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "滴滴，滴滴。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好无聊啊，巫恋都说梦话了——泡普卡，你的滋呜呜能借我玩一会吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "可以啊，但滋呜呜今天转不起来哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "因为里面转圈的东西在维修。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡之前帮哥哥姐姐们锯东西的时候坏了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那我想想其他好玩的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "泡普卡你就该和我一样多玩玩，不要去什么训练啊上课的了，没有意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "但只有训练的好，去打坏人的时候才不容易被弄痛哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "而且泡普卡需要帮梓兰姐姐她们分担工作的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你太听话了啦，像我一样多好，只要拿着盾冲冲冲就可以了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡泡你这样很容易受伤的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "一开始泡普卡也不懂，只会拿着滋呜呜到处乱甩，有时候还会伤到哥哥姐姐们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "但经过训练的泡普卡已经完全懂得听梓兰姐姐的话了，梓兰姐姐负责考虑事情，泡普卡负责听话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "这样泡普卡也不会被弄痛，哥哥姐姐也不会被弄痛，多好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你的哥哥姐姐，很强吗？有我爸爸那么强吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "没有哦。但哥哥姐姐们一直都很照顾泡普卡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓兰姐姐会给泡普卡梳头发，月见夜哥哥会帮泡普卡挑衣服。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "空爆姐姐会带好吃的，斑点哥哥会挑好看的漫画书。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唉——听上去好像很不错耶，以后我也要让博士找那么多人照顾我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那你为什么要拿滋呜呜追着他们跑叻？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "滋呜呜？追着哥哥姐姐跑？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡不会做这种事的哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "巫恋也一直说自己是大人了，不可以被人摸头。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "但有人摸了她还是很开心嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "巫恋？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......对哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我想到了！巫恋的尾巴那么好玩，我们为什么不玩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "又柔又滑，我爸爸座位上的兽皮都没那么滑。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "那样巫恋姐姐会生气的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "她还没醒，不会知道的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "万一醒了怎么办呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那我再想想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "摔跤怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓兰姐姐说不可以在休息室里摔跤，会打扰其他人休息的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你怎么那么听话，没劲......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "我会看好......她的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你看巫恋，都无聊到不停说梦话了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "到底能不能一起玩点什么嘛......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我想到了!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "扳手腕，玩扳手腕总可以吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "又安静，又可以比力气，最重要的是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "以前我们没扳过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好像可以哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "就这张桌子上，来吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我准备好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "我也好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "3！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "2！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡&泡泡",
      "text": "1！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哼！！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我泡泡，扳手腕，就没输过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "哼！！！嘿呀！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "以爸爸的名义！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "扳手腕绝对不会输的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哈啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嘿呀！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "桌，桌子塌了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "（小声）怎，怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "（小声）我不知道啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "Zzzz......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "还好还好，没吵醒睡觉的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "吵醒巫恋的话她绝对会对我下奇怪咒语的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "那桌，桌子呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "桌子让打扫的叔叔来收拾吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "要是叔叔问了，我们，说，说什么呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "当然说它是自己断的呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "说谎是不好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不说谎会被打屁屁的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那样更不好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "说好了，一会大人们来了，就告诉他们，桌子是自己坏了，好吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "唔，你眼罩好像有点歪了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "里面有点黑黑的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "（慌慌张张地把眼罩戴好）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那个黑黑的，是坏石头吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "应该是吧，泡普卡也没有摸过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓兰姐姐和凯尔希阿姨都和泡普卡说过，绝对不可以把眼罩摘下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "为什么呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "泡普卡不太记得了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "那就让我看看呗，就看一眼，好不好？看一眼就戴上，绝对不会出问题的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "我给你吃糖果，上个礼拜刚刚从紫色沃尔珀胖姐姐那里拿了盒好吃的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "而且还是你最喜欢吃的夹心小饼干哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "只能看一下哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嘿嘿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唔唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "太，太亮了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "等一下啊，我把灯关掉！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "（睁眼）......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "可以了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "（摘下眼罩）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哇哦，好好看唉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "又好看又酷！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "大概是什么样的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "不知道，反正就是特别酷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "嗯？里面好像有点亮亮的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "哦——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "哇，越来越亮了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "你的眼睛真的好厉害啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "好像有点热哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "发生什么了？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "眼罩戴好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好的巫恋姐姐。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡泡",
      "text": "啊巫恋你为什么要——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "梓兰已经在休息室门口了，别让她等太久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "梓兰姐姐已经来了吗，我马上就过去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "不过泡泡大姐头怎么办？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "我会把她带回宿舍的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泡普卡",
      "text": "那我先走啦，再见！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "再见。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "呼......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "滴滴，滴滴。"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "泡普卡没有问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "我现在就把泡泡带过来。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "走吧莫提，我们把泡泡拖去医疗部。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巫恋",
      "text": "希望她这次能学到点教训。",
