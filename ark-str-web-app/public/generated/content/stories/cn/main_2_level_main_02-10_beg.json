  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "雷蛇！防线还撑得住吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "我这边，没有问题！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "芙兰卡，注意敌人侧翼进攻！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "真是没完没了......！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "这样的防御你们就别想打破了。"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "看我就这样把你撞......"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "唔？！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "呃，呃呃呃啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": "char_1002_nsabr",
      "text": "这是什么？！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "是铝热剑哦。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "切开算打破吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "烦人......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "医疗组！这里有伤员！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "转移他们的时候，动作轻点！"
    },
    {
      "type": "dialogue",
      "speakerName": "医疗干员",
      "speakerId": null,
      "text": "这我还是知道的！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "阿米娅！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "你的情况呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "我们这里好像出了些小情况。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "芙兰卡......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "敌方的首领......就出现在我和雷蛇面前！"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "————"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "你们还想藏到哪里去？"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "逃不掉的，罗德岛。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "我会粉碎你们——"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "——彻彻底底地粉碎你们。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "你们这些......感染者的叛徒！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "哦~这家伙终于亲自登场了。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "虽然听起来还是蛮寒酸的......呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "阿米娅，我们好像——"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "啊，死胡同！"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "我好像跑过头了？！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "芙兰卡那里也是....."
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "我们被整合运动逼入死路了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "只能硬上了。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "我觉得，我们完全有击溃敌人的实力。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "稍稍用力一些也......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "这你就不懂了啊雷蛇。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "无论我们展现出多少实力，可都不能让近卫局感到有威胁哦？"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "总不能看着自己陷入危机吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "重装小组，守住阵地！"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "罗德岛的领导人......吗。"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "身为感染者，却帮助龙门杀害感染者！"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "多少同胞的性命，你们都得血债血偿！"
    },
    {
      "type": "dialogue",
      "speakerName": "碎骨",
      "speakerId": "char_1500_skulsr",
      "text": "给我进攻！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "————"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "整合运动————"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "先结仇的、先伤害别人的、先使用暴力的——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "可是切尔诺伯格的你们！！"
    },
    {
      "type": "sceneBreak"
    }
  ],
