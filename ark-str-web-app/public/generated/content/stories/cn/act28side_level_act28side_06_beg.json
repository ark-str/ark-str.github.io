{
  "server": "cn",
  "storyId": "act28side_level_act28side_06_beg",
  "groupId": "act28side",
  "stageId": "act28side_06",
  "title": "猎人之夜",
  "storyCode": "CV-6",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act28side/level_act28side_06_beg.txt",
  "sourceHash": "af50bd44cda5c89c3041cc93aa660a68e804a1d3f56ac279ea9a99186915ae1b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "我们真的这么早就要来吗？现在银行外面一个人也没有啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "我有薄荷糖可以提神。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "谢谢你，但我想薄荷糖应该起不了什么用，来，优等生，你来掐我一把。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "啧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "痛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "开工吧。朋友们，都清醒点！哎，说的就是你！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "黑钢佣兵小队成员",
      "text": "哈......欠——抱、抱歉，芙兰卡小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "好啦，接下来认真听。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "这间银行总共有四个出口，贝尼，你带四个人守在后门，小查，右边就交给你和安妮了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑钢佣兵小队成员",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "铜板，你和硬币去车库门。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "黑钢佣兵小队成员",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "剩下的人，与我们三个一起留在正门......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "面色不快的地块居民",
      "text": "咳咳，打扰了，女士，麻烦问下......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "面色不快的地块居民",
      "text": "你们今天一天都会在这里吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "呃，是的，先生......不过我们只是站岗值勤，不会影响大家办理业务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "面色不快的地块居民",
      "text": "办理业务？前几天我在这里签了一份拓荒协议，那是我最后一份业务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "那您是......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "面色不快的地块居民",
      "text": "嗯......算是给他们的服务质量打个评价吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "面色不快的地块居民",
      "text": "（倒立大拇指）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "面色不快的地块居民",
      "text": "噗——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "这颗子弹......是你托杰西卡带来的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "嗯，几年前我在维多利亚的一个古董店见到了它。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "难怪你当时把营地翻了个遍也没找到，现在想应该是某个军官把那把铳偷偷带去了维多利亚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "如今铳已经没了下落，这颗子弹是他仅存的遗物了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "早告诉那家伙不要在铳上搞那么花里胡哨的纹样了......这颗子弹你为什么不自己留着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "比起我，你才应该是那个保存它的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "你是觉得愧疚吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "毕竟朋友一场，最后如此收场，我也很难过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "那你的愧疚与难过有用吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "你想要什么，伍迪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "唤回你的手下，停止驱赶居民。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "伍迪，就算黑钢离开，政府还会派其他的佣兵公司来，结局还是一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "你本可以拒绝这项任务的，是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "黑钢国际虽说是“国际”，可总部毕竟是在哥伦比亚，政府委派的任务，我们没有什么拒绝的权力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "原来你也有要夹着尾巴做人的时候。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "今时不同往日了，在哥伦比亚政府眼里，我们这些武夫比不过那些特里蒙的精尖人才。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "告诉我，大老板，在这份与银行还有政府的合同里，黑钢能得到什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "这并不是份长久的合同，伍迪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "政府提出要求，我们照做，事后拿报酬，除此外......我并不关心，也不容我关心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "我记得还在拉特兰时，你总会和我讲很多，大到国家间的摩擦，小到人群中的矛盾......那些因此而受苦的人们永远是你的话题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "那都是很久远的事了，伍迪，我记不清了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "但我记得很清楚，就在那段从图书馆到学生宿舍的路上，你告诉我，强大的人保护自己，伟大的人捍卫他人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "怎么到现在，亲眼看到了那些人，你却只会不咸不淡地讲，不容关心，那便不关心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "伍迪，我们都老了，能关心的东西非常有限。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "是啊，我们都老了，还能关心的东西剩得不多......剩下的，都是最重要的东西了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "我这一把残破的老骨头，保住地块上所有人是不可能了，但身边的人......我会死死守着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伍德洛",
      "text": "我发誓，如果他们因为你的到来而受到伤害，那我会把这颗子弹原封不动地还给你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“桥夹”克里夫",
      "text": "......我衷心希望，事情不会发展到那一步，伍迪。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "队长，人越聚越多了......要拉封锁线吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "还不到那一步。我们并不清楚人群的意图，贸然行事只会更难控制情势。如果可以沟通，我希望能先与组织者进行交涉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "但是......从凌晨到现在，大家都是陆陆续续地出现，不像有什么组织的样子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "也没人带着武器，看起来不像是要诉诸暴力，可我还是很担心......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "毕竟我们的压力自始至终都不在面前......而在身后。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "回过头，三人看向银行明亮整洁的玻璃门窗。\n玻璃的结实将外界灰暗、冰冷与融化的污雪阻挡在外。\n但屋内的温暖与明亮却不会因玻璃的透明，倾泻到比银行门下最后一层阶梯更远的地方。"
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "队长，你看那个人是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "老板娘......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "担忧的银行员工",
      "text": "他们中的大部分都已经签下了拓荒协议，还聚在这干什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的银行员工",
      "text": "怕什么，黑钢手里的东西可不是吃素的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "担忧的银行员工",
      "text": "真是......唉，我电视都打开了，本来打算看看新年特别访谈的，也不知道今年州长会讲些什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷漠的银行员工",
      "text": "哼，翻来覆去，不还是那些话。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "观众朋友们，大家好。首先，我代表节目组提前祝大家新年快乐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "本次节目我们将采访的是州长先生，就本州居民关心的一系列问题向他提问——州长先生，您好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "您好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "接下来是我们节目的例行提醒——本次节目是在九月份录制的，播放时的情况可能已经发生变化，敬请各位留意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "责任全在特里蒙的科学家们。因为他们研究不出让信使一天跑遍哥伦比亚的交通工具，我们只好提前三个月录节目，不是吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "海伦娜女士，今天天气这么冷，你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "谢谢，但我今天哪里也不会去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我知道银行与诸位之间的矛盾激烈......有诉求的话，或许可以由我向银行转达。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "不用紧张，雷蛇队长。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "来到这里的人大多都已经签署过拓荒协议了，等车队到来，就离开了。你问我们还有什么诉求，还想讨要什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "没有了。我们不会再做无用功了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "那你们来是为了什么呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "为了看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "看什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "我从小就被教导，在告别那些陪伴我们很久的人或者事物时，要好好再看一眼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "这阵子......我看过了自己的餐厅，看过了矿厂，看过了地块上每一个地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "而今天，在新年的第一天，我来看那个让我不得不告别这一切的罪魁祸首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "海伦娜女士，请容我提醒你，每一份抵押协议都是你自己签署的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "是啊，没错，路是我们走的，也是你们指的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "无稽之谈，就好比那位先生，我隐约记得，在他生意受挫四处借钱无门时，是我们为他发放了四万的贷款。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "气愤的地块居民",
      "text": "是啊，刚开始我欠你们四万，这笔钱不大不小，我只想着赶紧还完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "气愤的地块居民",
      "text": "可你们又说，要合理规划投资和负债，我不该一次性把钱连本带利还清，你们提供分期优惠，我可以用余下的钱买你们的理财产品......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "气愤的地块居民",
      "text": "是啊，你们是借了我四万，可最后我要付出的，却是我的店铺、房、车，甚至亲人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "我们当初相信了你们的宣传。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "你们说，会让我们的生活蒸蒸日上，帮助我们实现更加美好的未来......但你们规划的所谓未来里，我们这些客户的位置又在哪里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "气愤的地块居民",
      "text": "是啊，我们是傻瓜，我们贪财，我们目光短浅，馋那一点甜头，所以都上了钩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "可女士，为什么？为什么整个地块上所有人都像饿疯了的鳞一样，迫不及待要去咬那只要命的钩子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "真的是我们自己的问题吗？还是说，这片水塘从一开始就——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "雷蛇小姐，请在十分钟内将这群人疏散干净。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "烦请尽快。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "（小声）杰西卡！想办法给克里夫先生拨通电话，赶快！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "我马上......\n不行，根本打不通......"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "再试试......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "杰西卡",
      "text": "不，队长，我得去当面告诉克里夫先生，这里到底在发生什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "......去吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "那个......海伦娜女士，杰西卡已经去向高层汇报情况了，一会儿应该......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "你想过自己的未来吗，雷蛇小姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我......一直想着要开一家安保公司。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "你会为了它贷一笔钱吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "假如有必要，我会，因为那是我一直想做的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "那你可要小心了，那钱只是以未来为名罢了，拿到它并不算触碰到了未来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "正是你保护着的那些人教会了我们这一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "海伦娜",
      "text": "他们是窃贼，是骗子，他们在路牌上做手脚，却反过来嘲笑我们走上了危险的夜路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我......明白，诸位。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "州长先生，我们不妨直接讨论一些核心问题。众所周知，在拓荒区和建成区之间，本州还存在着大量过渡区域——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "区域内存在着的聚居点，大多是有几十年历史的拓荒地块，有自己的支柱产业，但还不足以达到移动城市的标准，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "正如您所说。我听说，州政府最近在考虑这些地块的处理问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "移动地块是重要的战略资源，但我不能苟同您的“处理”一词，对过渡区及其居民的帮扶早已成为州政府案头最重要的事项之一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "额外投资、税收减免、入学优惠、低息贷款......过渡区居民们正从这些政策里受益良多。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "担忧的银行员工",
      "text": "经理......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "去把那份授权协议拿出来，州政府发来的，紧急事态下授权给我们指挥私人武装的那份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "担忧的银行员工",
      "text": "可是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "快去，可别在这时候傻愣着。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "几十年前，我们的父辈来到此地，哥伦比亚的签证官说想听他们的梦想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "后来，地块的发展蓬勃，你们鼓励我们走向美好的未来与明天，说整个哥伦比亚都想听我们充满干劲的声音。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "但现在我们身无分文，拖着病体，再无价值后，你们就把大门一关。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "没有这样的道理！我们会呐喊，我们会怒吼，我们会咆哮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "而你们最好竖起耳朵，听好了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "暴雪欲来，狂风将至♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "我们两手空空，被推往荒野♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "远离生长的土地♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激动的地块居民",
      "text": "找寻一抔属于自己的土壤♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "关于低息贷款......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "您在迟疑？这很罕见，我以为您还会不停地用问题轰炸我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "不瞒您说，我确实认为这是一个很尖锐的问题，希望您能如实回答。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "主持人",
      "text": "一些人认为，减免贷款利息是在用税收补贴当地经济，不仅可能让钱打水漂，还可能挫伤当地居民自力更生的积极性，让他们变得懒惰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "作为州政府，我们确实在一些地块发现了类似的情况，但我们也要向其他公民呼吁，请多给过渡区一些时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "请相信，当地的居民并非懒惰，而是需要更多的时间，来学习如何重新利用自己的双腿行走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "访谈嘉宾",
      "text": "当他们强壮到足以丢掉拐杖的那一天，他们会如数还清款项，并感激我们的慷慨和哥伦比亚公民间的兄弟之情。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "担忧的银行员工",
      "text": "在这里，经理！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "去把窗户都关好，窗帘拉紧，离门窗远一点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "担忧的银行员工",
      "text": "他们这......是在外面唱歌吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "从耕田到抡锤♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "一切这些事情都是我们完成的♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "我们诞生起就♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "注定要永远负重前行♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "十分钟到了，既然他们执意不肯离开，我们应该采取更强硬的措施。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "很抱歉，女士，做不到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "......我们之间的关系本不应该如此难堪的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "如果你们执意玩忽职守，那我只能遗憾地通知你，这支小队现在交由我来指挥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "你算什么东——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "回收地块的协议是由政府、银行与黑钢三方共同签署，里面有条目写明，黑钢分派来的人手在特殊情况下须听从我们的指挥调度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "这是当时发来的授权书，请雷蛇小姐过目。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "您无权越级指挥我们的行动，女士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "不，这上面写得一清二楚，我有权力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "动手吧，雷蛇小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "请恕我拒绝。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "您现在拒绝的可不是一间小小银行的请求，而是政府的命令。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "不要忘记帮助黑钢走到现在的是什么，是哥伦比亚倾注在你们身上的信任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "但是......信任很容易崩塌，一次小小的失约，就足以重创搭建好的一切。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "银行经理",
      "text": "动手，我不想再多说了，雷蛇小姐。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "挨饿的是我们，送死的是我们♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "为了空头支票付出一切的是我们♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "但未来......未来却没有我们♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "再见了，家乡♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "我将远离生长的土地♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地块居民",
      "text": "只为找寻一抔属于自己的土壤♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "女士，你再说多少次都没有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我不会开火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "重复一遍，我不会开火，也不会允许我小队的任何一个成员开火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "我的任务仅是确保无人冲进银行，伤害到你们宝贵的生命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "据我判断，他们对你们的生命安全没有任何威胁，只想和你们作一场告别。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "如果你们脆弱的心灵因此受伤，那我深表同情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "毕竟......离别总是伤感的，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "text": "大家听好，没有我的命令，都不许擅动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通讯器",
      "text": "收到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通讯器",
      "text": "收到！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通讯器",
      "text": "收、收到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通讯器",
      "text": "收到。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "text": "回去吧，女士，这是真实的歌声，多听听没坏处。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
