        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "speakerToken": "avg_npc_042",
          "operatorId": null,
          "portraitKey": null,
          "text": "我不会去忘掉的。我绝对不会忘记任何一个人的死。"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "speakerToken": "char_017_homura_3#5",
          "operatorId": "char_017_homura",
          "portraitKey": "char_017_homura",
          "text": "哈。对。你和我一样。你也是罗德岛的精英干员。"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "speakerToken": "char_017_homura_3#5",
          "operatorId": "char_017_homura",
          "portraitKey": "char_017_homura",
          "text": "不能代你去，真的，我......"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "speakerToken": "char_017_homura_3#5",
          "operatorId": "char_017_homura",
          "portraitKey": "char_017_homura",
          "text": "唔，呃......"
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "speakerToken": "avg_npc_042",
          "operatorId": null,
          "portraitKey": null,
          "text": "你又流血了？"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "speakerToken": "char_017_homura_3#5",
          "operatorId": "char_017_homura",
          "portraitKey": "char_017_homura",
          "text": "小事。"
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "speakerToken": "avg_npc_042",
          "operatorId": null,
          "portraitKey": null,
          "text": "我送你。"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "speakerToken": "char_017_homura_3#5",
          "operatorId": "char_017_homura",
          "portraitKey": "char_017_homura",
          "text": "哎哟。"
        },
        {
          "type": "dialogue",
          "speakerName": "煌",
          "speakerToken": "char_017_homura_3#5",
          "operatorId": "char_017_homura",
          "portraitKey": "char_017_homura",
          "text": "迷迭香......和阿米娅要好好的。"
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "speakerToken": "avg_npc_042",
