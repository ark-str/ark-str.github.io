            {
              "type": "sceneBreak"
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "看来缪尔赛思是被追到这里的。",
          "value": "1",
          "blocks": []
