  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十八关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": null,
      "text": "到了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "——？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "还要上天台吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......这道门，这道门是锁着的。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "退后，让我用法术把门锁——"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "用不着吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "踹开就得了。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "雷蛇，多学学。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "各有各的风格不行吗？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......前面是屋顶。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "我大概明白了......"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "阿米娅，那边！从那边就能到另外一边！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "“那边”是哪......你是说我们可以从——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "从楼顶转移？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "Bingo——！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "谁能想到呢！万无一失了是不是！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "龙门啊，可是一座有着很多秘密的好——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "speakerId": null,
      "text": "别想跑——！"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "......咦？这什么呀？！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "能天使，敌人也用意想不到的方式出场了......"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "我已经堵住了入口，怎么会——"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "难道是从附近的建筑里......"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "他们背着的喷气背包虽然比较简陋，但是好像完全不影响使用。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "要是让他们从没有设防的地方进来的话，就不妙了......"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "切，等着，我马上去救你们。"
    },
    {
      "type": "dialogue",
      "speakerName": "芙兰卡",
      "speakerId": "char_106_franka",
      "text": "那就麻烦你动作快些了，拉特兰的救世主小姐。"
    },
    {
      "type": "dialogue",
      "speakerName": "雷蛇",
      "speakerId": "char_107_liskam",
      "text": "重装小队，防御阵型！快！"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": "char_102_texas",
      "text": "......上了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "speakerId": "char_002_amiya",
      "text": "大家，掩护先锋！"
    },
    {
      "type": "sceneBreak"
    }
  ],
