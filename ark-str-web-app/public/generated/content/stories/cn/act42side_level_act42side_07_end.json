{
  "server": "cn",
  "storyId": "act42side_level_act42side_07_end",
  "groupId": "act42side",
  "stageId": "act42side_07",
  "title": "丧礼",
  "storyCode": "MT-7",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act42side/level_act42side_07_end.txt",
  "sourceHash": "c07e2d549b933152291c6cc1ec5d937f4b9901b4db040ee3e4c3f36299c8fcfc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "请进。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "蕾缪安枢机......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "得改口了哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我已经被禁足，原则上教皇厅应该不允许任何人前来探视才对啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "报备过了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我刚刚接任，在事务交接上难免有一些仓促，来请教前任枢机，再正常不过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "哈哈，你适应得很快嘛，阿摩斯枢机。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我记得你之前可是说，自己是个没什么追求的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "蕾缪安枢......小姐，我不是来趁机炫耀什么的，我们之间本来也不是什么勾心斗角的上下级关系吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "但如果你是来问蕾缪乐的行踪，我已经在前几轮询问中说过很多次——确实无可奉告。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "不，我想问您另外一个问题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "蕾缪安小姐，您愿意牺牲自己的事业，只是为了保护妹妹，还是，您真的相信她说的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "从降生仪式，到万国峰会......拉特兰最近发生的所有事都很不对劲。我们像是，患上了某种疾病。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "对我来说，这是一码事。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我、我想请您看一样东西。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阿摩斯点开了自己的终端，递给蕾缪安。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "这是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "万国信使的申请函。我希望能够成为万国信使，负责玻利瓦尔一带的政府沟通任务。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "你想离开拉特兰？为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我和我妻子......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "当年我们大吵了一架，不欢而散。等我再回到家，她已经去出任务了，前往卡兹戴尔附近的荒野，处理萨卡兹侵扰商队的事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "她一直是这样的脾气，听不进去别人的话。那时候是冬天，我估摸着她春天才能回来，我还来得及做点什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "后来的事情，我也告诉过您，堕天啊驱逐啊什么的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "第七厅专司情报、国安和外交，工作上有一些便利，我花了很长的时间，终于打听到了她的下落。于是我就想着......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我能理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "可是，你刚刚说的怪事是指？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我知道万国信使的选拔标准有多严格，凭我的能力，实在是......所以这份申请，一直躺在我的邮箱里。直到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "你接任第七厅枢机后，批准了自己的那份申请？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "是、是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "通知我接任枢机一职的时候，帕特里奇昂阁下说我从来都只是缺乏一个契机......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "虽然他肯定另有所指，但我这没出息的脑子，第一时间想到的就是这件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "可是，我点过批准之后，这份申请就......消失了。没有收到任何申请被驳回的消息，没有任何记录可查。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "它就那么消失在了我的终端里，像是、像是从来没有存在过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "流程上，那份申请不论我批准与否都不会被通过，我不可能被允许立刻辞去枢机职务，成为万国信使。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "更何况所有万国信使都已经被召回拉特兰，哪怕真的当上了，我也没机会去见奥罗拉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "批准那份申请对我来说，连弥补都算不上，那就只是一丝微不足道的慰藉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "谁会想着把这微不足道的慰藉也给抹消？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "对我来说，这足以成为一条线索......让我怀疑这个拉特兰是否真实。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "或许......您妹妹想做的事情，是正确的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "阿摩斯枢机，你有向其他人提起这件事吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "没、没有。整整一个晚上，我都没法合眼......想来想去，也只有您可以分享了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "阿摩斯枢机，我在想，这是否是什么新的审讯手段。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "您可以相信我，蕾缪安小姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "我们都有自己真正在意的东西......也都不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "很有意思的发言，阿摩斯先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿摩斯",
      "text": "哦对了，今天，育婴圣堂会举行一场更为盛大的降生仪式。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "“每个人终其一生，都在为死亡这件事做准备。”\n哪怕在潮石镇那样被饥荒和瘟疫冲刷得一无所有的地方，也会有年迈的老人在闭眼前一刻，舔舔干裂的嘴唇，悠悠说出类似的话。\n这是一句老生常谈，只不过对有些人来说是饮恨的总结，而对另一些人来说是不怀遗憾的感喟。但它们的前提是一样的——\n死亡，是生命的终点。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "木攀兽",
      "text": "（疑惑地拱头）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "木攀兽",
      "text": "（紧张地扇翅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "是的，孩子，你的母亲已经不会再回应我们了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "......她已经死去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "木攀兽",
      "text": "（低低地嘤鸣）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "母兽已经没有了鼻息，安多恩缓缓合上了她的眼睛。\n幼崽靠了过来，他颤抖着，连毛色都变得暗淡。安多恩将他抱上自己的膝头，对上他的眼睛。\n幼崽的声音含混不清，安多恩也不懂兽的语言，但他清晰地感受到悲伤。悲伤像是平静河面下奔涌的水流——幼崽的，自己的。"
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "死亡总是伴随着新生，你的母亲只是在自知生命无可挽回后，选择将生的希望留给你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "她用尽了所有力气，她最终做到了这件事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "这是你的第一课。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "木攀兽",
      "text": "（低低地嘤鸣）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "潮石镇、那个有钟楼的小镇、荒野上的修道院，还有如今......我经历过许多类似的时刻，如今我再次经历，体悟越发深刻。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "万物都会在它既定的旅程中走向终结，所以意义的延续才显得难能可贵。\n死亡，是一场告别。\n是死者对生者的赠礼，是生者拯救自己的起点。"
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "孩子，别恐惧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "你应该悲哀，你应该铭记......我与你一起。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "木攀兽",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "安多恩前辈，她的葬礼由您主持，我就不进去了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "牧首呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "牧首恐怕暂时无法过来，她在准备接下来的降生仪式，为圣堂内的所有非萨科塔赋予光环......她让我跟您说声抱歉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "......无妨。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "人们习惯了隆重地迎接新生，而葬礼总是简单的。告诉牧首，我会稍微晚一点再恢复工作。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "您还好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "母亲的离世太过突然，这孩子还太小，很难抵御那样强烈的悲伤，我需要陪在他身边。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "不，安多恩前辈，牧首担心的是您。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "牧首说，您和她一起陪伴了这位母亲良久，您内心的苦痛不言而喻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "您是一个善思的人，每一段旅程都会给您启发，但在那之前，也会让您困顿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "至于这个孩子......他是奇迹，他有能力走出阴霾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "牧首让我转告您，未来，拉特兰每一个新生的生命，都不会被外在的灾厄和内里的悲伤所击倒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "他们生而平等，也将勇敢而强大......拉特兰会帮助他们做到。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "安多恩感到木攀兽幼崽在轻拱自己的手臂。他想抚摸小兽，但小兽奋力地张开翅膀，推开了他的手。\n小兽盘旋着飞起，落在房间中央的安抚铃上，与安抚铃一同发出悦耳的声响。\n安多恩不解地望向幼崽，哪怕头顶光环行走了几十年，他依然在刹那间被小兽无比明亮的光环晃到了眼。"
    },
    {
      "type": "dialogue",
      "speakerName": "木攀兽",
      "text": "（用力地扇翅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "木攀兽",
      "text": "（高高地嘤鸣）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "他与小兽朝夕相处，这些动作意味着什么，他再清楚不过。\n那是小兽在邀他一同玩耍。\n从来不会拒绝孩子们的保育员呆立原地。\n他想借助共感传达自己的悲伤，想以最委婉的方式拒绝这难以理解的邀请。\n但最终，他只是走上前去，牵住木攀兽的爪，与小兽一同、与安抚铃一同，在空旷的房间正中跳起了圆舞的步伐。\n木攀兽兴奋地鸣叫着，尖锐的啼鸣久久不能散去；他的羽毛在灯光下熠熠生辉，在旋转中展露出全部的光泽。\n他们的步伐越来越快，安多恩只能勉强撇过头去，望向母兽的遗体，试图确认自己的情绪。他猛地意识到——\n自己早已不再悲伤。\n他与那小兽一样快乐，他与那小兽一样美丽，他与那小兽一样，满怀希望地向未来献上高歌与舞蹈。\n他们飞旋的步伐在地面上、在空气中画出一个又一个美丽的圆环。"
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "这......这就是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "萨科塔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "只有免于苦痛的本能......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "却没有悲伤与哀悼的资格？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "安多恩",
      "text": "难道这就是萨科塔，这就是生命的奇迹？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "没有人回答他歇斯底里的诘问。他的牧首正在启圣大堂，为人们赋上一顶又一顶美丽的光环。\n唯独他自己，突兀地停下了脚步，没来由地想起了一场葬礼，一场本不应存在于他记忆中的葬礼。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鸢尾花田，小小的孩子，一些残忍却真诚的倾诉与祷告，钟声。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使A",
      "text": "还、还是没有回应吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使A",
      "text": "喂，奥罗拉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "不信就过来自己听。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使A",
      "text": "耳朵要聋了......里面各种杂音，什么也听不清呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使B",
      "text": "奥罗拉，这到底是怎么回事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "你在质问我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使B",
      "text": "你毕竟是铳骑，起码曾经是，你自然要比我们更懂这些东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "你也说了，“曾经”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "这些杂音够吵了，你们要是再吵，我有的是办法让你们闭嘴。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使们",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玻利瓦尔小孩",
      "text": "修女......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努艾达",
      "text": "别害怕，雨果。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "努艾达",
      "text": "（奥罗拉，孩子们在看着，别这样。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努艾达",
      "text": "（这些萨科塔都是突遭变故，从其他国家不远万里赶回来的。他们头上还顶着破碎的光环，满心恐慌却得不到安抚......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "拉特兰的城际网络系统向来稳定，城外各个聚落的通讯装置会由专人定期维护。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "这一根紧急通讯桩离拉特兰城只有三公里，按理说是最不该出问题的。但我已经通过特殊频道呼叫了十几次了，都没有回应。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "呵，难道拉特兰真完蛋了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努艾达",
      "text": "奥罗拉，辛苦再试几次吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "努艾达，你看起来比他们还要紧张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努艾达",
      "text": "是吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "努艾达没有回答。几个孩子跑了过来，攥住她的裙摆，随着她的目光一起看向前方。\n从这个小镇，已经能窥见拉特兰城的外围，洁白的城墙与流云同色，像是误入凡尘的圣灵居所，本不该存世的奇迹。\n而远行者此刻与它相隔咫尺，他们风尘仆仆，疲惫不堪，已经破碎的光环和光翼在荒野里显得越发黯淡。\n朝圣者终抵终途，可苦旅真的能就此结束吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "努艾达",
      "text": "那就是，拉特兰......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "行了，看样子城里的人是火烧眉毛，连自己都顾不过来了。收拾东西，我们直接进城。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使A",
      "text": "也是，总不能一直这样干等着。不管了，走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使B",
      "text": "可是，没有得到教皇厅的允许，擅自进城的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "我们这些堕天的罪人决定回拉特兰，难道得到教皇厅的允许了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "别告诉我你回来是想着给拉特兰报恩的，那样的话我可以先把你解决了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "停下脚步，到此为止。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "你们不得进入拉特兰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "嗬，竟然是一位公证所的执行者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "你是奥罗拉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "你认识我？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "收到你的通讯后，我在公证所查阅了你的资料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "奥罗拉，前公民编号LC0073458，前铳骑第三小队队长，于1090年冬率队前往北部荒野护送拉特兰商队，并与萨卡兹佣兵爆发冲突。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "你成功完成了任务。但在返程途中，移动修道院遭遇了小型天灾，被押解的萨卡兹佣兵趁机暴动，被你当场格杀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "随后，当同行的铳骑试图如实记述任务报告时，为了掩盖因自己的过激手段招致的罪责，你竟然举铳威胁对方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "混乱中你杀害了同僚，也因此被剥夺公民身份，被永久驱逐出拉特兰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "怎么，执行者先生，你面无表情地说完这一大通，就是想告诉我，拉特兰从来没有忘记我的罪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "看看你面前的这几百人。他们有一些是像我一样遭到驱逐的堕天使，有一些是出于种种原因脱离圣城的离群者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "甚至还有一群人，从来没有见过圣城，他们在玻利瓦尔那样的烂地方，信奉着拉特兰的教义......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "你没看见这些人的光环吗？这是堕天还是病？他们跋山涉水来到这里，求一个解，求个说法，求个心安。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "而拉特兰，却只是派出一个执行者将我们挡在城外？！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "越来越多的离群萨科塔围了上来，他们将费德里科堵在中间，向着他举起手中的武器。"
    },
    {
      "type": "dialogue",
      "speakerName": "离群萨科塔A",
      "text": "我们只是离开拉特兰久了些，只是忘了怎么和其他萨科塔一样生活......现在就要被拒之门外？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "离群萨科塔B",
      "text": "律法责罚罪孽，可你告诉我，我老老实实在莱塔尼亚过了二十年日子，我犯了什么罪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使A",
      "text": "如果律法如此残酷，应该受罚的就不是我们，而是你——你和你的同僚，律法的牙兽！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使B",
      "text": "执行者，我当初堕天就是因为你们惩罚不了该惩罚的人！现在看来，你们的本事从来都没用对过地方！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "费德里科沉默地看着眼前的人群。\n路灯不合时宜地亮着，给人们的脸平添一抹怪异的色彩。恐慌、焦躁、愤怒、疑惑、惊惧......种种表情让他们的五官变得扭曲。\n他们握住武器的手在颤抖，骚乱一触即发。\n但费德里科有能力控制眼下的局面。凭自己的反应速度，他有把握尽快解决对方的头领，强行镇压剩下的人。\n一直以来，他都是这么做的，而且效果显著。\n费德里科是一位优秀的公证所执行者，这是他成为执行者的第八年，工作早已得心应手。\n同时，这也是他被加上圣徒名号的第三个年头，除了一朵已经被焚毁的花，几个偶然相识的人，没有谁能给他启发或指点。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "他看着眼前紧张的人群，缓缓将手从腰间移开，示意自己的手与守护铳保持了足够的距离。"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "我来，并不是为了重申拉特兰曾对各位下达的判决。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "我来，并不代表公证所、教皇厅，以及拉特兰的任何官方立场。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "各位不得进入拉特兰城，是因为城中发生了一些远超常识的异变，你们的到来，或许会让局势更加混乱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "我需要一些时间，我会尽量向你们解释清楚。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奥罗拉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "努艾达",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使们",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "阿尔图罗？你不应该离开圣城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "放心吧，我已经见到了博士......我来找你，自然也是博士的意思。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "博士的发现确证了你我的猜想。拉特兰全城陷入了某种群体性的幻梦，但此刻，梦境中的异变正在与现实叠加......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "灾异正在吞噬整座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......类似巫王的帕维永崩解后，荒域对崔林特尔梅的侵袭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "大概吧，我也并不能完全理解。但毫无疑问的是，几百万拉特兰人正深陷在虚幻与现实的拉扯中，我们需要新的助力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......这些背律者和离群者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "恰巧出现的不和谐音，往往能成为演奏中有趣的变奏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "我同意博士的判断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "但如果灾异覆盖的范围是整座拉特兰城，他们极有可能会在入城的同时进入幻梦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔图罗",
      "text": "所以我才来找你，顺便带来了我的琴。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
