    {
      "type": "dialogue",
      "speakerName": "白金",
      "speakerId": "char_204_platnm",
      "isRemote": false,
      "text": "没什么特别重要的事情。"
    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "speakerId": "char_204_platnm",
      "isRemote": false,
      "text": "我现在意识到了一件事情，梦和现实还是十分容易辨析的。"
