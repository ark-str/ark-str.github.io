    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "speakerId": "char_204_platnm",
      "isRemote": false,
      "text": "你好，博士。"
    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "speakerId": "char_204_platnm",
      "isRemote": false,
      "text": "气色不错呢，发生了什么好事吗？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "怎么了，在我办公室门口打瞌睡。",
          "value": "1",
          "blocks": []
