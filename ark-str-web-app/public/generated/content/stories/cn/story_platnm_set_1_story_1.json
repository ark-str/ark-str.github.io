      ]
    },
    {
      "type": "dialogue",
      "speakerName": "白金",
      "speakerId": "char_204_platnm",
      "isRemote": false,
      "text": "怎么了？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "白金——",
          "value": "1",
          "blocks": []
