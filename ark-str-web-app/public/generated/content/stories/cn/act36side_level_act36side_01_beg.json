      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛露西尔",
      "speakerId": "avg_4141_marcil_1",
      "isRemote": false,
      "text": "快过来！我们先进这个小木屋躲一躲！"
