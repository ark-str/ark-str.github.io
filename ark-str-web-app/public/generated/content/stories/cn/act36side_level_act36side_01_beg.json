    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛露西尔",
      "speakerId": "avg_4141_marcil_1",
      "isRemote": false,
      "text": "啊啊啊啊啊啊啊啊啊这是什么啊啊啊！！"
