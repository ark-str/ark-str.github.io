  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "这个怪胎好厉害！已经打退了好几个人了！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "虽然听不懂她在说什么，但是好强啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人C",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "让她来做大酋长感觉好像也不坏！"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "speakerToken": "char_411_tomimi_1#2",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "......嘉维尔，你的同伴好厉害。"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "虽然这种时候只会让人伤脑筋就是了。"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "不过总算稍微消停了，我上去制住她......"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "speakerToken": "char_2013_cerber_1",
      "operatorId": "char_2013_cerber",
      "portraitKey": "char_2013_cerber",
      "text": "什么，整合运动，你们又来了！"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "speakerToken": "char_2013_cerber_1",
      "operatorId": "char_2013_cerber",
      "portraitKey": "char_2013_cerber",
      "text": "原来是你们抢走了博士吗！"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "speakerToken": "char_2013_cerber_1",
      "operatorId": "char_2013_cerber",
      "portraitKey": "char_2013_cerber",
      "text": "别跑！"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "speakerToken": "char_187_ccheal_1#2",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "糟了，这傻孩子要跑了！"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "speakerToken": "char_187_ccheal_1#2",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "我去追！特米米，你和博士不要乱动，我会回来找你们。"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "speakerToken": "char_411_tomimi_1#2",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "诶，好的！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "speakerToken": "char_411_tomimi_1#5",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "......"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1#5",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "啊，上面又有新的人打起来了。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1#5",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "......博士，可不可以告诉我，嘉维尔在外面是什么样的？"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "告诉她嘉维尔在罗德岛的生活。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#5",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "嘉维尔在外面生活得很好吗。"
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#5",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "......"
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#5",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "难道说你和嘉维尔也不是很熟吗？"
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#5",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "太好了！......啊，不，我只是以为你和嘉维尔一起回来的，嘉维尔好像很喜欢你的样子，就以为你和嘉维尔关系很好。"
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#5",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "没关系的，嘉维尔人很好的，你一定可以和她打好关系的！"
            }
          ]
        },
        {
          "label": "告诉她嘉维尔当医生的样子。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#3",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "太好了，果然即使成为了医生，嘉维尔始终是嘉维尔呢！"
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#3",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "是这样啊，嘉维尔没有变呀，太好了......"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "那如果嘉维尔要离开你的话，你会怎么想？"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "会很难过吧。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "嗯，果然呢，我当时也哭的很伤心呢......"
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "你、你怎么可以这样！嘉维尔那么好，她要离开你你怎么可以觉得无所谓！"
            }
          ]
        },
        {
          "label": "祝贺她找到新的道路吧。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "你真厉害......我做不到。"
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "speakerToken": "char_411_tomimi_1#2",
              "operatorId": "char_411_tomimi",
              "portraitKey": "char_411_tomimi",
              "text": "我一直希望嘉维尔能够回来。"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "博士，那个，在嘉维尔的事情上，我、我是不会输给你的！"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "加油。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（点头）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我也不会输给你的！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "所以那一次祭典的结果呢？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "那一次......"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "什么嘛，你们这帮大人也不过如此嘛。"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "还有谁要来挑战我！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人A",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "居然把这么多大人给打倒了......"
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人B",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "嘉维尔，了不起啊！"
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人C",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "难道说嘉维尔真的能当上大酋长？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "我来！"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "什么啊，怎么是你，祖玛玛。"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "你不是在造你的机器去了吗？我去找你你都不理我。"
        },
        {
          "type": "dialogue",
          "speakerName": "祖玛玛",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "......我想最后试一试。"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "试什么？"
        },
        {
          "type": "dialogue",
          "speakerName": "祖玛玛",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "试试我的拳头能不能打败你。"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "你怎么说得好像要死了一样。"
        },
        {
          "type": "dialogue",
          "speakerName": "祖玛玛",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "少废话，今天我可不会输给你，嘉维尔。"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "嘿，那要打过才知道了！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "她们从中午一直打到了晚上都没有分出胜负。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "到最后，她们两个人都没力气了，被其他人给丢了下去。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "这就是嘉维尔第一次参加祭典的情况了。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "祖玛玛是个什么样的人？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "祖玛玛是当时离得比较近的另一个部族的人。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "小时候，她和嘉维尔经常在一起打架，嘉维尔比她厉害，但祖玛玛也不是没有赢过。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "但是我听嘉维尔说，她有一天不知道怎么的，就不再喜欢打架了，开始喜欢研究机器。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "我记得那天，是祖玛玛最后一次和嘉维尔打架。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "在那之后，祖玛玛就再也没和嘉维尔打过，甚至很少出现在大家面前，再之后，她的部族就搬走了，我就在也没见过她了。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "就连嘉维尔离开那次的大闹祭典都没有来。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "我回来了。"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "嘉维尔，你没事吧！"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "我没事。啧，小刻这孩子真能跑，一下子就跑没影了。"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "不过以她的能力应该不用担心。特米米，祖玛玛来了吗？"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "speakerToken": "char_411_tomimi_1#2",
          "operatorId": "char_411_tomimi",
          "portraitKey": "char_411_tomimi",
          "text": "还没有。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人",
          "speakerToken": "avg_npc_070",
          "operatorId": null,
          "portraitKey": null,
          "text": "还有谁要来挑战！"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "我来。"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "嗯？看来我回来的正是时候。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
