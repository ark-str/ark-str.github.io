{
  "server": "cn",
  "storyId": "act12d0_level_act12d0_03_end",
  "groupId": "act12d0",
  "stageId": "act12d0_03",
  "title": "往昔",
  "storyCode": "RI-3",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act12d0/level_act12d0_03_end.txt",
  "sourceHash": "49685e27b779af17e2fd99334abe3ad62b06a482fda542c64475f1dd94298bb9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人A",
      "text": "这个怪胎好厉害！已经打退了好几个人了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人B",
      "text": "虽然听不懂她在说什么，但是好强啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人C",
      "text": "让她来做大酋长感觉好像也不坏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "......嘉维尔，你的同伴好厉害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "虽然这种时候只会让人伤脑筋就是了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "不过总算稍微消停了，我上去制住她......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "什么，整合运动，你们又来了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "原来是你们抢走了博士吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "别跑！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "糟了，这傻孩子要跑了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "我去追！特米米，你和博士不要乱动，我会回来找你们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "诶，好的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "啊，上面又有新的人打起来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "......博士，可不可以告诉我，嘉维尔在外面是什么样的？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "告诉她嘉维尔在罗德岛的生活。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "嘉维尔在外面生活得很好吗。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "难道说你和嘉维尔也不是很熟吗？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "太好了！......啊，不，我只是以为你和嘉维尔一起回来的，嘉维尔好像很喜欢你的样子，就以为你和嘉维尔关系很好。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "没关系的，嘉维尔人很好的，你一定可以和她打好关系的！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "告诉她嘉维尔当医生的样子。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "太好了，果然即使成为了医生，嘉维尔始终是嘉维尔呢！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "是这样啊，嘉维尔没有变呀，太好了......",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "那如果嘉维尔要离开你的话，你会怎么想？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "会很难过吧。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "嗯，果然呢，我当时也哭的很伤心呢......",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "你、你怎么可以这样！嘉维尔那么好，她要离开你你怎么可以觉得无所谓！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "祝贺她找到新的道路吧。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "你真厉害......我做不到。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "我一直希望嘉维尔能够回来。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "博士，那个，在嘉维尔的事情上，我、我是不会输给你的！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "加油。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（点头）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我也不会输给你的！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "所以那一次祭典的结果呢？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "那一次......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "什么嘛，你们这帮大人也不过如此嘛。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "还有谁要来挑战我！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人A",
          "text": "居然把这么多大人给打倒了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人B",
          "text": "嘉维尔，了不起啊！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人C",
          "text": "难道说嘉维尔真的能当上大酋长？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我来！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "什么啊，怎么是你，祖玛玛。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "你不是在造你的机器去了吗？我去找你你都不理我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "祖玛玛",
          "text": "......我想最后试一试。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "试什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "祖玛玛",
          "text": "试试我的拳头能不能打败你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "你怎么说得好像要死了一样。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "祖玛玛",
          "text": "少废话，今天我可不会输给你，嘉维尔。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嘿，那要打过才知道了！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "她们从中午一直打到了晚上都没有分出胜负。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "到最后，她们两个人都没力气了，被其他人给丢了下去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "这就是嘉维尔第一次参加祭典的情况了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "祖玛玛是个什么样的人？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "祖玛玛是当时离得比较近的另一个部族的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "小时候，她和嘉维尔经常在一起打架，嘉维尔比她厉害，但祖玛玛也不是没有赢过。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "但是我听嘉维尔说，她有一天不知道怎么的，就不再喜欢打架了，开始喜欢研究机器。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "我记得那天，是祖玛玛最后一次和嘉维尔打架。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "在那之后，祖玛玛就再也没和嘉维尔打过，甚至很少出现在大家面前，再之后，她的部族就搬走了，我就在也没见过她了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "就连嘉维尔离开那次的大闹祭典都没有来。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "我回来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嘉维尔，你没事吧！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "我没事。啧，小刻这孩子真能跑，一下子就跑没影了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "不过以她的能力应该不用担心。特米米，祖玛玛来了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "还没有。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿达克利斯人",
          "text": "还有谁要来挑战！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嗯？看来我回来的正是时候。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
