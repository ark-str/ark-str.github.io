    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "speakerId": "char_015_lmg",
      "isRemote": false,
      "text": "三......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "speakerId": "char_015_lmg",
      "isRemote": false,
      "text": "四......"
