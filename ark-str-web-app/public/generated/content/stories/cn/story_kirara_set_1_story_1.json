    {
      "type": "dialogue",
      "speakerName": "陌生的男人",
      "speakerId": "avg_npc_031",
      "isRemote": false,
      "text": "从那个亲戚，到“家族”，到你们，再到刚刚那个小姑娘，没有一个好人，没有一个不在说谎！"
