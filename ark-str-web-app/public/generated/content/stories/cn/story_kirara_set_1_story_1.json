    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "isRemote": false,
      "text": "云母同学，你在用掌机给自己打电话？你要和那个人联系？"
