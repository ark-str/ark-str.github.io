    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_lmstreet_2"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "speakerId": "char_015_lmg",
      "isRemote": false,
      "text": "九......"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "speakerId": "char_015_lmg",
      "isRemote": false,
      "text": "十！"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "speakerId": "char_015_lmg",
      "isRemote": false,
      "text": "即将下达强攻命令，各就各位——"
