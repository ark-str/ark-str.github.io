{
  "server": "cn",
  "storyId": "act13d5_level_act13d5_02_end",
  "groupId": "act13d5",
  "stageId": "act13d5_02",
  "title": "呼啸守卫",
  "storyCode": "MN-2",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act13d5/level_act13d5_02_end.txt",
  "sourceHash": "814e5f5b50ebeab1b46f6dd43ee8fb92113776b1e2375aeef6254f0ee74fd7f2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔 2下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "各位！各位！各位！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "在竞赛开始之前，谁能预料到这个结果——声名远扬的临光家族与塑料骑士的对决，谁能想到会是这个结果！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "玛莉娅·临光！这个继承了临光之名的小女孩，竟然——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "被瑟奇亚克完全压制！毫——无——还——手——之——力——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "这样可不行啊！临光！为了这个名字，你知道在座的观众押了多少钱吗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "啊，什么？看赔率其实并不高？喂，你们倒是对临光抱点信任啊！这张脸不值钱吗！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "呃——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "又是佐菲娅又是耀骑士的，结果你就这点本事吗......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "让人失望。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "不愧是呼啸骑士团的老将，利用人造地形和速度优势，我们可怜的小马驹无处可逃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "再度停步！再度射击！再度转移！这就是“塑料节奏”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（根、根本看不见他的动作！为什么？明明还没有佐菲娅的动作快——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（他停下了，得格挡——！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "太慢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "——玛莉娅！左边！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "什——呜！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "瑟奇亚克，踩着墙壁做出的完美的连续射击！哎呀，如果发生了当场击毙的意外，可就要掐掉直播了啊，好险好险！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "没想到这身自开赛至今被命中数次却完全没有损耗的坚固护甲，竟然还能允许人做出如此轻便的动作！真令人惊讶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "看到了吗！这就是呼啸守卫的最新产品！Jack2特殊高性能塑化凝胶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "这种抢手货谁人不爱！？但也不要担心，现在竞技场前台正在派发九五折优惠券！机不可失时不再来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "那就是......临光？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "等等，她真的是那个耀骑士的妹妹吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......怎么，失望了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不......我怎么会因为这种事情失望。倒是你呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我？哎呀......再观望观望嘛，反正都买了票了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我讨厌这里的感觉......莫布还是老样子那么让人不爽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "随便煽动一下这些人的情绪就会像浪涛一样起伏......还有广告，这种广告真有人会去买？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "会有的吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "毕竟让人放下思考随波逐流，不正是这个“骑士竞技”最擅长的事情吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "喂，看那边，离赛场最近的观众席。“鞭刃”的佐菲娅。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不止。那边还有几个......都是小有名气的骑士。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": ".......还有大概十分钟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "你运气真不错，如果不用拖延时间——你早就已经跪地求饶了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "——呜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "退场吧，临光家的小女孩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "你不清楚这里的规矩，直到你的四肢都被我的箭矢贯穿为止，裁判是不会喊停的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "没必要这样，放弃吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "不，我不能放弃......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "敬酒不吃吃罚酒......你除了眼神和她很像，简直一无是处。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "那好吧......看看你还能撑多久。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "实战和训练是不同的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "毕竟没有人会在这么平坦的地方，讲究礼貌地和你正面对决。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "更何况每个选手的装备、武器、作战风格，每一次都截然不同的地形、陷阱、场外支援道具......都会影响胜负。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "情报收集感觉很重要啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "没错，问题也就在这里，你没法在这么短的时间里挨个记住每个卡西米尔骑士的弱点，但每个人也许都是盯着你来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "唔啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "骑士竞技不存在万金油的战术，不过真要说有什么通用解法......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "扬长避短——或者说，全力以赴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "呃.......简单来说就是，没有办法？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "痛！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "去观察，思考。办法这种东西，从来不是在面临困难之前就能准备万全的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "能在极短的时间里分析情况，做出应有的判断并反应，你以为这很简单吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "——左边！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "侥幸......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "哦哦！？这是小临光第一次做出的反击——不，只是挡下了瑟奇亚克的佯攻算不上反击！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "投票数并没有变化！瑟奇亚克依旧拥有——碾压性的——优势！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "观察。思考。\n玛莉娅——\n你有一双天马的眼睛。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（骑士护甲——Jack2？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（呼啸守卫十三种产品里没有这个样式的——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "......想以守待攻？愚蠢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "箭矢拖曳着些许烟尘，从玛莉娅的发丝间穿过。"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（动力增强，不，是更夸张的......可这个样式......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "......试试看吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "冲锋！像是木桩一样被“塑料”瑟奇亚克耍得团团转的小临光，第一次发起了冲锋！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "避开了裂隙的火焰与人造的冰霜，灵活，非常灵活——但是瑟奇亚克面不改色地站在原地！是打算正面决出胜负吗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "哪有弩手和剑盾骑士正面决战的道理——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "别想跑——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "我哪都不跑！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "交错的刹那，箭矢的呼啸，脸颊上的刺痛，玛莉娅并没有出剑。\n她按着敌人的肩甲腾空而起，瑟奇亚克并没有预料到这次冲锋会如此“友善”——\n手掌感受得到的温度，低声的轰鸣，不自然的烟雾——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "什么？怎么！？谁能想到我们不仅能看到骑士竞技，甚至能在这里看到杂技表演！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "玛莉娅终于得以近身瑟奇亚克，但却未出一剑！这算是小临光的挑衅？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "......不是没出剑，是没法出剑，不避开的话，现在左臂已经报废了吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "塑料玩具在拖延时间，为了靠节目效果获得赞助......嘁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "玛莉娅......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "你刚才......做了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "真烫啊......瑟奇亚克先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "呼啸守卫公司没有为你的新装甲考虑散热问题吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "......这是骑士工匠该关心的事，不是两个身处赛场的骑士要谈论的话题。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（高性能，轻盈......是维多利亚顶级工艺的仿制，还有哥伦比亚的源石强化骨骼内衬科技......之类的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（因为某些技术难题......不，也许只是为了美观才放弃了散热口......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（既然如此，极限还有——多久？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（转移——射击——转移——射击，就算知道行动模式也追不上他的速度。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（不对，是转移、停步、射击......等等？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "虽然经历了小小的插曲，但是双方都已经重整旗鼓！拉开距离，节奏再度回到——等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "玛莉娅没有犹豫！她在第一时间起步追上了瑟奇亚克的脚步！但是！但是速度依旧有差距！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "......死缠烂打，速度劣势的时候最忌追逐，“鞭刃”没教过你吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一个漂亮的顿步，转身，瑟奇亚克在吐纳间就已经上好了弓弦。"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（现在！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "光芒！突然出现的光芒充斥着赛场——这里向大家额外推销一下雷神开拓者系列的全新墨镜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "（什么？竞品广告？只要投了钱谁管这个！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "唔——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "没有攻击——什么——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（没有射击，也没有移动！再来！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "喝啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "挡下了！！作为弩手的瑟奇亚克依旧毫无负担地挡下了玛莉娅的全力一击！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "小临光，玛莉娅，完全无计可施！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "（果然！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "法术居然只是虚晃一招......这有什么意义？那才是你最后的机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "瑟奇亚克先生，强制冷却系统真的适合在赛场上使用吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "这么快就能发现还真是让人惊讶......也许你更适合当个工匠，而不是骑士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "——瑟奇亚克先生，您是一位很强的骑士，速度、技巧都无可指摘。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "但很遗憾，看来您似乎选择成为了企业的产品测试员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "......这与你无关，不要小看了呼啸守卫的技术力量。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "——是吗。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "唔哦！？玛莉娅竟然主动拉开了距离，这是为什么！？刚才两人说了什么悄悄话！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "观众们想必也很好奇，我早就说过了应该给骑士们配上麦克风——谁不想听听他们撂狠话的内容呢！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "唔哦，开始满场乱窜了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "玛莉娅·临光......她好像发现了什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我看也是。也行吧，比起单纯的力气胜负，本来咱们骑士就该多花点脑子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "尽耍小聪明......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "停步！射击！瑟奇亚克再度开始猎杀——等等！玛莉娅绕过了地面上的障碍，再度向瑟奇亚克发起了冲锋——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "唔！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "瑟奇亚克！瑟奇亚克压根没有挪步！是打算像刚才一样硬接一剑吗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "*警报声*啧！这该死的冷却设计——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "抱歉了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "不要得意忘形！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "呃！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "哪有弩手和剑盾骑士正面决战的道理——这可是你说的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "（还没有完成冷却，必须先拉开距离！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "让开！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "瑟奇亚克——！惊人的技巧！只靠弓弩刺刀竟然能做出如此完美的格挡！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "玛莉娅闭上了眼。\n过去无数次目睹过的这个动作，她只是在效仿，效仿着这个动作。\n效仿了很久很久。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "啊......我想起来了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "那个反手剑的动作......是玛嘉烈夺冠那时的......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塑料骑士",
      "text": "这......这不可能......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "呼啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "玛莉娅",
      "text": "好、好疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "——谁、谁能想到这样的结果！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "刚才还占尽先机的瑟奇亚克，竟然一剑——只被命中一剑就彻底失去了意识！毫无疑问，获胜的是玛莉娅！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "但是，这是怎么做到的！难道就像那年奇迹般的决赛一样！玛莉娅·临光，隐藏了真实的实力吗！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嚯嚯嚯，这不是做得挺好吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "这就不看了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "没什么好看的，不如回去好好检修自己的武器，别被人捡了漏。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哈哈哈，说的也是呐，等等我！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "玛莉娅......你真的做到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "佐菲娅",
      "text": "......这真的是好事吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "莫布先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "（喂！这里可是解说台！快下去！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嘘，小声些，可别让观众们听见了......这个位置观众是看不见我的，请放心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我只是来转达一些帕维尔先生的意见......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "帕......你、你对总裁直呼其名......你想要什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "看来瑟奇亚克因为技艺不精而输掉了竞赛，白费了呼啸守卫的期待，令人遗憾。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "你是说......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嘘......有些事情是怎么回事，该说的，不该说的，您心里清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "去吧，观众们在等着您。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "各位——！各位！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "看现场的赔率和票数，这毫无疑问是一场大爆冷！这场比赛注定会成为这几天的讨论中心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "没有封号的独立骑士战胜了呼啸骑士团的大先锋！看来玛莉娅·临光的源石技艺不容小觑，她靠实力胜过了“塑料”的瑟奇亚克！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "是瑟奇亚克面对新人放松警惕了吗？亦或是赛场上二人的交流内容决定了胜负？啊啊，我早说过要给骑士装上麦克风——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "但——是！无论怎样的借口都已经晚了！本人荣幸地宣布本日第一场赛事的结果！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大嘴莫布",
      "text": "胜者是——玛莉娅·临光！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
