  "stageId": "main_04-02",
  "title": "雨中漫步",
  "storyCode": "4-2",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-02_end.txt",
  "sourceHash": "7a4ed17c673c89897367a4e50db63a56b71a8308ed2664bd4afa83d7b9d36cfc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "啊......！小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "抱，抱歉，我不是有意撞过来......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我没事的。你很有礼貌呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "嘿嘿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "咦，姐姐你在这里做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "这里可还在下雨呢，为什么不躲一躲？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "啊......嗯......我只是......出来走走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "你是在找人帮忙吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "啊！姐姐是怎么知道的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不能告诉你！这可是姐姐的秘密。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "唔唔......不管了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "姐姐，能不能请你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "好像......不太行。姐姐，你的个子，太小了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "可不能这么说别人！你明明比我矮！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "哇哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "那，那我们试试吧......嗯......能不能帮我抬一下那块板子？一起来吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "那个铁架下面，有台留声机，我想拿回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "1......2......3！嘿！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "成功了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "哇，姐姐力气还蛮大的呢！谢谢姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "可是......这个留声机......还是坏了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "没关系！因为它最开始就是坏的呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "总有一天可以修好的。我给大家收集了不少唱片，虽然从来都没听过——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "————但总有一天，我会给大家放的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......如此轻松的说着这些艰难的话......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......我到底是为了什么......又能做什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "姐姐不怕我吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......怕什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "我可是感染者哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "哈哈......我也是呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "什么！太可惜了，姐姐长得这么可爱，居然是感染者......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "感染者不是什么问题。无论是健康人还是感染者——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "你如果是个好孩子，就一直是个好孩子哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "唉——？我听不懂呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "（咕噜......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......饿了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "......嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......给，我只带了这些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "太好了！谢谢你，兔姐姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "不过你.....为什么来这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "因为......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "因为我答应过一个人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "孩童",
      "text": "姐姐再见！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "好的，再见！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "就连那样的孩子，最后，最后也只会......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "被剥夺了身份的人。感染者。你们早已不是人。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我能做什么呢，我又能，再多做些什么呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "为什么......我不能保护大家呢......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "你不能。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不......我......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "饥荒......迫害......死亡......\n感染者终究只有这样的结局。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不是这样的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "只要罗德岛还在为了感染者.....",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "你只是少数幸运儿。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不，所有人都聚在一起，向着共同的目标，不断地努力。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "这片大地已经麻木。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "还没有......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "感染者绝不能就此陷入绝望......",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "你。\n被愤怒吞噬吧。\n只有———————"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "不......我不会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我答应过......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我答应过她——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那是......?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "一个姐姐和我说过，这个布偶，只有亲手做的才有用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "所以所以，这个送给你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "另一个少女的声音",
      "text": "——————。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "刚才那个声音是 ......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那个背影————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是陈小姐？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "——————。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "————————————。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "——————————————————————————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小女孩",
      "text": "————————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "另一个少女的声音",
      "text": "——————。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "............",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官，你来这里是要做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我以为......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "不关你的事。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "龙门的事情，我会处理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "陈长官......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这是我第一次看到......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "她是那样的眼神......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
