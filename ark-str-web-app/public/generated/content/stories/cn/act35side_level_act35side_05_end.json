      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖拜尔",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......她应该看懂我的暗示了吧？娜仁图亚，如果她真的是梦魇后人......"
