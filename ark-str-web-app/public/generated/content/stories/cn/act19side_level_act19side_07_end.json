{
  "server": "cn",
  "storyId": "act19side_level_act19side_07_end",
  "groupId": "act19side",
  "stageId": "act19side_07",
  "title": "疯狂的信号",
  "storyCode": "DV-7",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act19side/level_act19side_07_end.txt",
  "sourceHash": "7e4de7dc8c2929927dd3c07ef0eebaf37bd7007064cb8bb3e2d9ae0a440b68eb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "莱茵实验员",
      "text": "咦，这不是缪尔赛思主任吗？这么晚了您还来公司啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "呃......咳咳，是啊，有工作没干完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莱茵实验员",
      "text": "您可真是辛苦啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莱茵实验员",
      "text": "这两位是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞雷娅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "......我们的重要合作伙伴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "你没认出这位吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莱茵实验员",
      "text": "呃......我看不清脸......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "缪尔赛思",
      "text": "这位可是源石理论学者、矿石病专家、天灾研究者，大名鼎鼎的——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "莱茵实验员",
      "text": "原来是您啊！真是难得的机会，竟然让我碰到了像您这么厉害的科学家！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（他根本没听说过我吧？）",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "（这都能糊弄过去？）",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "我们有急事需要尽快上楼——有机会的话，下回一起开午餐会啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵实验员",
          "text": "当然。那就不耽误您的时间了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵实验员",
          "text": "等一下，我刚才就觉得您很眼熟，您难道不是那位防......防......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "......防护材料领域非常有名的专家。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "帕尔维斯......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "帕尔维斯",
          "text": "这几年莱茵的扩张速度很快，不是吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕尔维斯",
          "text": "新来的小朋友们还需要多长长见识啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵实验员",
          "text": "......两位主任同时出现？我、我......我还有工作没做完！我先走啦！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕尔维斯",
          "text": "呵呵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "......你不准备告诉他们我回来了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕尔维斯",
          "text": "请原谅我的老花眼，我以前认识您吗，美丽的瓦伊凡女士？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕尔维斯",
          "text": "没什么事情的话，我就先回去了。太晚休息可不利于我这把年纪的人的身体健康。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "帕尔维斯",
          "text": "对了，缪尔赛思主任，别忘了你答应我的黑豆茶。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "呼......他真的是路过吗，塞雷娅？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "现在是凌晨四点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "帕尔维斯平常的下班时间是九个小时以前。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "果然......直到最后一刻到来前，他都不会轻易把赌注压在斐尔迪南和克丽斯腾之间的任意一方身上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "他还想看看谁的赢面大呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "就算莱茵生命变成了废墟，他也一定是能活下来的那个吧？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "......他们进了莱茵总部。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "领航小队，准备拦截。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "别着急。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "你是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "我见过你和塞雷娅交手，对你的装备很感兴趣。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "方便借我看一眼吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "在战斗之前，你们是这么打招呼的吗，罗德岛的精英干员？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "请不要误解，刚才那句话，我不是以罗德岛精英干员的身份说的。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "作为一名机械师，我尊重任何优秀的技术及技术的发明者——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "所以，在我夺下你那根形制特别的法杖之前，我想先询问一下你的意愿。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "......你很有趣，Mechanist先生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "我之前只是想去见一见塞雷娅，但你和你的上司......那位博士给了我更大的惊喜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "你知道我的名字？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "你也调查过我，不是吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "掌握尽量多的信息，是我们这类人在动手之前的习惯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "......莱茵总部的资料库里有你的名字，霍尔海雅女士。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "但我不相信斐尔迪南会雇佣一名历史学家来追杀自己的同僚。就算是在充满不可能的哥伦比亚学界，这也太荒诞了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "那只是我的副业。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "你的副业是研究历史？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "错了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "我是一名历史学者，我在这里，只是为了见证一则流传千年的预言成真。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "同样的，我也相信，未来的走向能揭示一些被掩埋的历史——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "我和你们一样，都是真相的追寻者。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我们到了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "知道怎么去找你的混蛋上司吗，研究员小姐？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "他应该在监控室里。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "拐角的地方有个通风口，要是能爬上去的话，就能用最快的速度抵达监控室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "动作要快。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "毕竟，很快就有很多人来迎接我们了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "......警长。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "我就知道你会站到对面去。你的意志还是不够坚定，你忘不了你和这名罪犯的过去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "他还不是罪犯，小子，能定罪的人从来不是你们。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "......你在走一条不归路。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "为什么？你们明明都那么优秀，为什么要自毁前程？为什么......她也不听我的劝阻？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你真正想提问的对象并不是我，对吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "但我也可以替她再教你一回。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "呃——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "因为我们知道自己战斗是为了什么。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "为了守护某些人......守护某些准则不被像那个混蛋主任那样的人践踏，我们从来不会犹豫。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我们不会像你一样......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "落脚之前总是先看好阵营——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "动手之前还要问为什么！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "唔......！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你们找到方向了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我想是的......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "那快走吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "我有弩，你没有。所以先别管我了，管好你自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......谢谢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "保重。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "你怎么不跟上去？你一路走到这里，不也是为了找那家伙算账吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "......我也有武器。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "嗯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "我们很久没有并肩作战了，玛丽。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "什么并肩作战......那时候只是玩游戏。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "玛丽",
          "text": "再说了，哪一次游戏不是我带你？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "哈哈......谢谢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "桑尼",
          "text": "我真的很想念......很想念那段时光。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "只要从前面的电梯上去，就能直达总辖办公室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "走后面的安全通道会是更保险的做法。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "我知道啊，可我们不是在赶时间吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "直接走的话肯定更快，要应对的武装人员也能更少些......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "等等，别走到前面那个位置——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "咦？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "抱歉，我忘了，那里是监控区......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "博士，我们要转备用计划了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "发现入侵者！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "这里，在这里！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "抓住这几个入侵——等等，主任？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "你好，雷吉。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "您怎么回来了......不，您已经没有权限，不能再往前走了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "面对入侵者，展露出内心的犹豫只会给敌人机会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "需要我再教你一遍该怎么做吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "......举盾！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "眩晕器准备，瞄准入侵者——塞雷娅！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "勉强算你合格。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "最新一批数据都记录好了吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "好了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "注意无人机的方位。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "不要让实验体的行动影响到第一手数据的采集。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "放心，老板。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你想要的第一手数据已经自己走到你面前来了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "埃琳娜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "我很高兴......你没事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我在你手下工作了那么多年，阅读你的微表情也变成了工作的一部分——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你的左侧眉毛轻微地上挑了一下。你明明很惊讶，老板。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "......你总是能给我很多惊喜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "你回来了，我终于可以好好松口气——那些蠢笨的新人需要像你这么优秀的研究员好好调教。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你想让我当组长？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "不，不是组长。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "看到桌上那把钥匙了吗？收下它。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "你已经完全证明了自己的能力。你不再需要给任何人——无论是我还是多萝西——当助手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "下一个项目，你会是第一负责人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "这把钥匙就是我为你准备好的礼物。那是一间崭新的......空间充裕的实验室，属于你的实验室。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "无论你想做什么研究，我和莱茵生命都会全力支持你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "太棒了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你是不是还考虑过让我接任能量科主任？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "......不是没有这种可能性。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "你......你看起来并不惊喜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "因为无论你给我的未来规划了什么道路......我的答案都是“不”。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "......放下你的法杖。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你在害怕什么？你怕我背叛你，在这个你即将迎来重大成功的关键时刻，让你没法看到自己的光辉未来？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "或许我真的会考虑这么做。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "我不明白。我明明给了你那么多......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "我在你身上看到了天赋、勤勉和野心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "这些都是取得成功的必要品质，也正是这些品质铸就了我自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你当然不明白。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "要是你真如你所言的那样器重我的话——你就应该把整个实验的真相都告诉我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "告诉我，你会无视那些受试者的安危，你会把我当成监视多萝西的工具，等没用的时候，就让我连同你罪恶的证据一起灰飞烟灭......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......在你眼中，我是不是一个特别听话的傻子？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "奥利维亚明明提醒过我，我却直到你动手的最后一刻才醒悟过来！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "你还没有准备好，埃琳娜，我怕你会动摇，就跟现在这样......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你从来没有信任过我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "你不相信任何人。斐尔迪南，你只信你自己。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "那么，我凭什么要再信任你......相信你的这些许诺？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "我从来没有给过任何人那么多机会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "埃琳娜，你知道吗？你比我的孩子更像我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "我在你身上倾注了那么多心血，即使此刻，只要你愿意，我依然允许你回到我身边——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "就当我求你最后一件事——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "闭嘴吧，老板。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "带着你的“礼物”和这些虚情假意，离我远一点。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "我，埃琳娜·乌比卡，从今天开始，不再是在你手下任你摆布的傻助手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "斐尔迪南·克鲁尼，你被我开除了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "......斐尔迪南主任！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "给我抓住她，抓住这个暴徒！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "唔......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "莱茵防卫科成员",
          "text": "主任，您没事吧？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "我没事。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "埃琳娜......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "不要......再用这种......看起来很关心我的眼神......看着我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "这让我觉得......恶心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "......你说我不理解你，可你也并没有真正理解我。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "也许......在刚才那一刹那，我是有过犹豫和担心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "那并不是我担心你给我捣乱，而是我在担心你。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "斐尔迪南",
          "text": "我是......真的不想看着你走到这一步。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "这句话......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "埃琳娜",
          "text": "咳咳......我也想原样送给你。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "呼......呼......怎么办，防卫科的人越来越多了啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "斐尔迪南还真是做足了准备，塞雷娅再能打，也很难一下子打退这么多人吧？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "还得麻烦你帮忙了，缪尔赛思主任。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "......我？不行的，我并不会打架啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "光是跑来跑去躲避他们的攻击，我就已经很费劲了啊......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "你没听到我呼呼喘气吗，博士？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你刚才就很巧妙地帮了塞雷娅一把，不是吗？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "只要你不再故意拖时间就行。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "你......你发现了？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "塞雷娅很久没回莱茵总部，但还记得哪里是监控区。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "你总是有意无意干扰塞雷娅的视线。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自从听到我猜测总辖就在这里，你明显不再着急。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "我......哎呀！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "......差一点就真的中招了啊。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "博士......你竟然还拉着我？你......你还愿意拉着我吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "明明猜到我可能有其他想法......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "有什么想法都是你的自由。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我并不在乎你究竟是什么立场。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我请你帮助塞雷娅。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "这是为了罗德岛和莱茵生命的共同利益。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "这是为了哥伦比亚与其他国家的安全考虑。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "这也是为了你。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "......算上这次，你已经救了我两回了，Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "好吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "就当作是报答好了，至少这一回，我会站在你们身边，帮助塞雷娅去她想去的地方。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "听到我的呼唤了吗，水分子？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "缪尔赛思",
          "text": "亲吻眼前的每一位生灵，卷走脚下的所有尘埃吧！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "......精灵动摇了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "真是可怜的生灵......她总是希望自己能从其他人口中得到一些关于明天的允诺。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "谁又会甘愿承认自己与自己所属的族群只属于过去呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "克丽斯腾没法给她的东西，那位Dr.{@nickname}难道可以？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "哥伦比亚雇佣兵",
          "text": "女士，塞雷娅已经突破了封锁。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "就让她见见自己的老朋友吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "我还有其他工作要完成......只能下一次再与这位机械师先生交流了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "霍尔海雅",
          "text": "——要是他能从这批动力甲手中活下来的话。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "有多久没有回来了？\n一千四百九十七天。\n分别的时候，或许已是敌人。\n再见的时候，又还是朋友吗？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你回来了，塞雷娅。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "塞雷娅",
          "text": "......你好，克丽斯腾。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
