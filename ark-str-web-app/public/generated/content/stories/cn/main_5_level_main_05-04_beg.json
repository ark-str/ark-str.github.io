  "sourceHash": "ad37d66a0c4f1557918e3f769918cb5213a1495772a4e4ced5071a6e9fb5a6e9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "星熊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你脸色不大好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我没事，只是在想事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......我没想到他会被卷进来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "没事，你知道我的。过去的都过去了，用龙门话来说，这是命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "东国人也会信这个？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "经历这么了这么多事，即使我不信，现在也已经认了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "线报没问题吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "准确无误。这里就是线报记载的位置了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我们的目标，是那些鬼鬼祟祟的整合运动吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "看来他们没发现我们，还不知道近卫局已经把他们彻底包围了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "似乎在围绕着整座街区搭建着什么的样子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "不出意外的话，这里是连接着整合运动各个据点的中心枢纽之一。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我们摧毁这里的通讯收发设施，可以狠狠地打击整个区域内的敌人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "这能增添我们最后反攻近卫局大楼的胜算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "都听你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "而且，我也很在意情报线索的细节内容。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "你是说，整合运动在这儿活动，可不单单是想建个还算牢靠的据点，是吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你猜对了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "“敌人正秘密寻找高价值目标，需优先确认其行动。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "他们在富人区干些什么？这能有什么高价值目标？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我也觉得有问题。按照之前的计划，这条街道上的任何建筑都应当空无一人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "如果整合运动是在预谋绑架谁，那他们可能没机会抓住这位幸运市民了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "我们什么时候动手？整合运动似乎不喜欢布置侦查小队，我们随时可以突袭他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "一直在做猎人，从来没做过猎物吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "这时候成为猎物，马上就会没命。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "还是先仔细观察一下。我们要优先确认敌人的目的，却不是要折腾他们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "摧毁目标轻而易举，想要了解敌人的目标却需要我们的耐心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "等等！老陈，他们是不是想要破坏那栋宅子的大门？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "已经确定了目标建筑？快，整队！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "要为市民减少点损失是吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "那是自然！狙击手，待命！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "是龙门的军队！撤退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "联络——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "狙击手！射击那个背着无线电台的家伙！别让他发讯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "text": "明明该固守据点，第一反应居然是跑？肯定有鬼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "想跑就跑，跑得了吗！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
