{
  "server": "cn",
  "storyId": "story_otter_set_1_story_1",
  "groupId": "story_otter_set_1",
  "stageId": null,
  "title": "满满的日程表",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_otter_1_1.txt",
  "sourceHash": "3d37193779820ff8412c760a7586d8ad0f4b5e42959dbec4c19041ae1d4b392e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 梅尔"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "罗德岛本舰\n“鲁特拉工作室”"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "哦，时间差不多了嘛，该开始干活了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "让我看看今天的日程表。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，还行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "答应麦麦的“龙腾无人机操作改进方案”今天截稿，一会收个尾，然后等她来就行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "塞雷娅的防护服检修委托？主要是刷新涂料吧......糟了，我是不是没订涂料？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊——还好还好，上次的没用完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "今天主要就做这个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "如果还有空闲，就发几份新零件的订单出去，然后给服役的咪波们好好维护一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，今天就做这些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "开工啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "梅尔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "梅尔快开门啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "有急事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "塞雷娅这件衣服不太对劲啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "充能率怎么都上不去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "奇怪，到底是哪里出问题了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "梅尔，我知道你在里面！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我都听见你声音了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "是这里吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊哈~果然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "找到症结问题就好处理了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "是你逼我的啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "只要修复失效节点，整件衣服应该就能重新工作了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯哼，先优化充能路线，然后上涂料，马上就能恢复到正常运作状态。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "要不要再顺带加点额外功能呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "唉，不知道乱用权限会不会被凯尔希骂......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不管了，要怪就怪梅尔装聋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "梅尔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "搞定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "节点位置再检查一遍吧，一会上涂料渗进去就麻烦了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "干活戴耳机，就不怕被人吓到吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哼哼——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（拍梅尔肩膀）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "（张嘴咬人）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "呜啊啊啊啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "好疼好疼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "松口，快松口啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我不好吃啊！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "好过分喔梅尔，难得有好事情找你，不帮我开门就算了，还咬我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "抱歉啦可露希尔，你又不是不知道我工作的时候被打扰会咬人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "呜呜呜呜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那我也给你咬一下，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "你现在是不是在给衣服上抗源石涂料？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "那还是算了，现在咬你一口，下一秒就得进医疗部，不划算。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊，好像是这样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "可露希尔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "门怎么关不上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我记得特意设置过自动开关，刚刚还调成请勿打扰来着。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "是不是你把门禁给骇了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "怎么会~~我就这样走进来的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "是你门没锁啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我没锁吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "......奇怪。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你等一下，我看看监控录像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "梅尔你装监控的吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我这里很多东西都是莱茵内部资料啊，万一丢了什么东西对大家都不好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "基本保险措施还是需要的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "现在还是先工作吧......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "注意，注意安全操作规程啊。这个涂料，挺危险的吧，你这样三心二意，会出事的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "没事，我用机械臂呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，是哪个程序来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "额，梅尔，涂料的性质是不是要变化了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你是说这个？还好啦，这是惰性涂料。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "就算浸水烧开电离三小时再冻住，只要一解冻，马上就能用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "是这个文件夹吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "ok，监控程序打开。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "把时间拖到——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "梅尔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "不和我一起做智能机器人吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "梅尔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "梅，梅尔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你刚刚说什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "再，再说一遍？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "和我一起做智能机器人好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "好啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "那详情我们——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "（摁下开关播放监控视频）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "滋——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "监控视频",
      "text": "（开门的音效）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监控视频",
      "text": "唉，不知道乱用权限会不会被凯尔希骂......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监控视频",
      "text": "不管了，要怪就怪梅尔装聋。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "咪波。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "咬她。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "啊啊啊我错了别用咪波啊好疼好疼哇啊啊！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "说吧，大概需要我做什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "呜呜呜呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "我想要你帮我搞一下爆炸方面的东西......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "基座机器是雷神挑衅者熔岩猫魔鬼高性能版作业平台......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "上面已经有一个定制的全量热力法术冲击发生器了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "但那个效果不太理想，所以需要你帮帮忙......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "呜呜呜呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "哦好吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你先闻一下这个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "好的呜呜呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "（吸气）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "这是！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "（深吸一口气）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "好了没有？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "哈啊~~~~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "欸嘿嘿嘿，谢谢梅尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你再这样哭下去没法谈生意啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "也是也是，嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "也不知道你为什么那么喜欢闻我这儿的精炼润滑油......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "那当然是因为好闻啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "看来华法琳说的没错，你血管里没有血，只有机油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "不说了，谈正事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "好叻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "是需要我给雷神挑衅者做改装，提高攻击能力对吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "还有自我防卫、受击抗性和战场脱离方案的设计，毕竟是要植入智能的好小伙，可不能用一次就坏了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那你是找对人了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那么，报酬呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "你记不记得机库那里有一间小储物间啊，只要你——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "这活我接了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "嘿嘿，合作愉快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "愉快愉快~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "但是呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你看到那边的黑板了么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "贴满纸的那块？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那是我的排期表。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "就算加急，你的需求也在最后一张纸的右下角。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "能再插个队吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "也就是说，两个月之后。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "快的话五十天。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "你工作速度那么快的吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "还好吧，有时候灵感一来活就做完了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "呃......那我不打扰你了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "加油工作哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "等等！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你先帮我把门格式化，我要重新调整。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "还有，把你的最高权限去掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "现在、立刻、马上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "可露希尔",
      "text": "好......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "两小时后"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "还有最后一小块——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "叮咚"
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "梅尔，是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "你换密码了吗，门怎么开不了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "这下应该差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊？门口有谁在吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "是我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "麦麦！门坏了！摁门旁按钮进来吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "你好呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "好啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我这边还在忙塞雷娅的东西，就不招待你了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那么，找我有事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "我可是有预约的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "无人机方案，做得怎么样啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊......哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那个，已经做完了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "列举了一点技术要点、改进方案和材料需求，全都在桌上的那个文件袋里了，你先看看，没有问题就可以约新时间帮你做些配件了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "要是有问题的话我们找个时间聊聊细节。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "好呀，谢谢梅尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那是哪张桌子的哪个文件袋呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "那个那个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "你机械臂指的位置至少有四张桌子，我怎么知道是哪个嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "梅尔——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊别拉，我还在弄涂料！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "涂料过一会也可以涂的，先帮我找找文件袋好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "梅尔~~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我知道啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "嗯，谢谢~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯——是这个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "这个是你上个月的报销清单哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊抱歉，其实是这个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "对了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "谢谢你梅尔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "没什么啦，应该的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那我先走了，拜拜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "最重要的事差点忘记了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "我问你，现在几点了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "中午吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "是下午！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "梅尔，你吃饭了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊？我嘛？我吃根能量棒就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那怎么行！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "给，拿着！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "这是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "食堂买的，今天有你喜欢吃的河鲜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "本来想请你一起吃的，结果我自己也把时间忙忘了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "所以吃完以后打包了一份过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "唔唔，谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "一定要吃啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，我会的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "还有什么事吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "这是塞雷娅的充能护服？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "是啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "你大概还要做多久？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "一两个小时吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那可不行，我帮你一起弄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "没事，我可以的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "要么让我帮你一起弄，要么我喂你吃饭，选吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "好了我知道了拜托你了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "嘻嘻~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那我们就开工吧~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "呼，完工。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "辛苦啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "过来洗手。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "好——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "哈......也就只有这个时候，才会怀念莱茵的全自动清洁设备。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那为什么不回去呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "回去了就要被安排一大堆麻烦的工作，都没时间改进咪波。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "而且，在那边还要处理人际关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "这里也需要啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你出外勤比较多，对部门间的争斗不熟悉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "在那里啊，今天认识个新朋友，回头就会有人和你说：“这个人是某某部门的关系，你离他远点比较好。”",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "更可怕的是，就算同一个部门，有时候也要因为上司间的竞争关系尔虞我诈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我是真的不擅长应付这些事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "所以就溜到这里来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "是这样啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "对不起，我不该问这些的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "没事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "好，吃饭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那我也该离开了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "咪波，麻烦你监督她一下，不然我一走她又要直接开始干活了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "咪波没装语音模块，不会回应你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那也得叮嘱一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "麦哲伦",
      "text": "那么，这次是真的要走了，拜拜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "拜拜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，要不先订好零件再吃——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "呜哇，咪波你要干什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "只是先干一会活，不会忘记吃饭的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "好我知道了，我吃，现在就吃！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "呼，饱了。好，干活！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，先订材料还是先修咪波？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "还是先咪波好了，咪波比较重要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "过来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "我看看——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "补漆、检查布线、数据更新、补充能源。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "维护一只大概需要做这些......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "出任务的还有4只，备用的5只也要维护。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "现在几点来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "看来今天能搞定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "应该能搞定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "只要别再有人——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "梅尔！开门！！有活找你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "——————",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "怎么又~！@~#！@",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "呼，呼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "冷静。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "吸气——呼气，吸气——呼气。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "微笑~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "好了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "呦，你在啊梅尔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "遇上什么好事了笑那么开心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你过来，我告诉你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "好啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "你看，这是咪波。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "把手伸过来，有好东西给你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "唉，真是稀奇，是什么好东西？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "咪波，咬他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "啊啊啊别咬我疼疼疼疼疼！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "深夜"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊——终于。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "完成了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "今天早上的计划全部完成！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊——那个不算，我刚刚决定把订零件的工作移到明天了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "让我来看看明天要做些什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "去采购部订些零件。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "要给医疗部安装实验装置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "哦，工作台也要重新调试一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "明天就做这些吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "现在是......11点36分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "嗯，是该休息了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "吃碗泡面就睡觉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "明天见，咪波。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "咪波",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅尔",
      "text": "啊好疼！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
