{
  "server": "cn",
  "storyId": "act42side_level_act42side_03_end",
  "groupId": "act42side",
  "stageId": "act42side_03",
  "title": "礼拜",
  "storyCode": "MT-3",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act42side/level_act42side_03_end.txt",
  "sourceHash": "29bf9384c397b7a53af32d24a45d86a196e424907bcb56c8ef124c3f598244d4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "薇尔丽芙枢机，好久不见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "别叫枢机了，我现在只是育婴圣堂里一个再普通不过的事务员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "那我叫你前辈喽......看起来，确实是前辈的手笔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我刚刚一路走来看见的，从外围街道到圣堂内部，这里安防布置的思路可不输戍卫队。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "总得帮着干点活儿嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "说起来，还真被我猜对了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "来这里确认防务的果然是你......从程序上讲这类工作明显更适合公证所的执行者，或是铳骑与戍卫队的成员。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我姑且也还在追查前两天的爆炸事件哦，不是什么无关人士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "我可没接到通知说布防的时候要把爆炸案的调查结果也考虑在内。况且，你的调查现在也还没什么实质性的成果吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "难道说，你来这里，是因为受到袭击的是安多恩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "前辈，你不会是想敲打我，身为七厅枢机，眼里应该是整座圣城，而不是自己的私交吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "哈，我们都知道你是什么样的人啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "头脑清醒，做事雷厉风行，又有敏锐准确的洞察力，在遴选枢机的时候确实加了很多分......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "但大家也都清楚，你的这些美好品质，一般在什么时候最能体现出来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "蕾缪安枢机，我还记得你当年加入戍卫队特勤队的初衷哦，我看过那份报告书。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "哈哈，是吗，我都忘了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "你本来并没有加入特勤队的打算，只是去看望菲亚梅塔的，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......还有安多恩。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "哦？这我倒是不知道。我以为你们是加入特勤队之后才认识的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "要更早。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "他好像是从很远的地方一路走过来的，穿着一身破衣裳，憔悴得很。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "就那么一动不动地坐在礼拜堂前的长椅上，比路边的圣徒像更像圣徒像。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "那是我和莫斯提马第一次见到他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "至于菲亚梅塔，本来就是我和莫斯提马在电影院午夜场偶然认识的好朋友。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "安多恩不在圣城长大，本身就格格不入；菲亚梅塔是个倔性子，那阵子大概在和她的爷爷置气......我和莫斯提马就想着去看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "这两人事先并不认识，其他的萨科塔也未必是故意排挤他们，但实际的结果是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "整个“软胶铳弹轮盘赌，暨特勤队组队仪式”，就只有这两个家伙孤零零地被剩了下来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "所以你就把在场的其他人都痛扁了一顿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "又和莫斯提马当场填了申请表，跟他们组成了那次组队仪式的最后一个四人小队。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "最后成了整个特勤队出外勤次数最多、配合最为默契的小队，也才有了后来的意外......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "蕾缪安，不论我再怎么欣赏你......我也还是要提醒你，身处枢机之位，做事的出发点就永远只有圣城。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "圣城在我眼里，首先是一个又一个熟悉的名字。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "前辈，怀旧到此为止。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "第七厅有能力审视自己的职责所在。如果前辈只以“普通的事务员”自居，我应该亲自去见一下牧首。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "她就在前面，对吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "蕾缪安见到了此行的目标。\n金发萨科塔立于某道门廊之下，她在祷告，她在不安，她的呼吸急促，身体因此肉眼可见地颤栗着......\n蕾缪安感觉自己快被对方汹涌的情绪淹没。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "牧首？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "蕾缪安枢机，我听到了你和薇尔丽芙的谈话......但请原谅我此刻无法思绪平静地与你交谈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "那里面是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "一位萨卡兹母亲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "她在荒野上耽搁了太久，来这里又拒食了两天......现在的情况不容乐观。我们的保育员正在为她治疗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "她在恐惧，她在焦躁，她不想输给疼痛，此刻仍在挣扎着保持清醒......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "......她在清醒地祈祷，祈祷孩子能平安降生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "我能做的，只是与她感同身受，与她一同祈祷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "您能感受到萨卡兹的情绪？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "是的，枢机。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "就像此刻，你也在为我的悸动而担忧。它清晰得如同你我之间与生俱来的共感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "“共感”......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "也许这是主对我这样一个目盲者额外的恩典，也许只是因为......这里是拉特兰专为创造新生而建的圣堂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "我们的信仰将在此夯实，在此延伸，这里不应有任何隔阂与限制。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "这样说来，更应该走进这里的，是我们的同胞自己。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "阳光从高处的彩窗落下，照亮空旷而肃穆的大堂。\n巨大的圣像俯首合十，注视着下方两位渺小的萨科塔。"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "这里的确很特别。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "见多了用各种奇怪的姿势举着铳蓄势待发的圣像，第一次见到这种造型的，还真是，唔，有些不太习惯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "相比于矗立在玻利瓦尔山间或伊比利亚海边的那些所谓的“拉特兰教造像”，拉特兰随处可见的圣像其实更难以理解，枢机。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "乐园形塑了我们别样到有些失真的虔诚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "跋涉在天灾与苦难中的生灵，为生存祈愿......这才是信仰最初的形貌。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "牧、牧首，一切平安。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "那位母亲的状态终于平复下来了，我们喂她吃了药，也给她补充了营养，此刻她已经睡去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "呼——那我就放心了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "她分娩在即，还请继续关注她的状况，不得有一丝松懈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "保育员",
      "text": "是。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "感恩主的赐福。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我能感受到，您发自内心的释然与喜悦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "也感谢你的陪伴，枢机。希望共感没有让我的不安影响到你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "不会，我没那么脆弱啦。再说，您刚刚的话对我也有一些启发。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "听您刚刚说起......您好像是后面才来到这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "是的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "我曾在荒野间踟蹰良久，我的同行者们凋敝于泥污......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "为了找到拉特兰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "不，彼时我从未想过，大地上会出现这样一座城市。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "但共同的愿景，让我终于找到了它的位置。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "我们能在此时此刻相遇，这是被写就的命运，枢机。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "所幸过了这么久，以我之残躯，仍然能为拉特兰、为我的族人们做一点事情。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我的一位朋友，他也在这座圣堂中工作，他也是从遥远的地方来到这里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "如今的拉特兰，未来的拉特兰，每一个人都必须，也能够找到自己的位置，发挥各自的作用......由此，我们才能对抗灾异。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "扯远啦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "既然出现了针对保育员的袭击事件，第七厅愿意协助育婴圣堂开展安防工作，确保降生仪式顺利进行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "枢机，我理解你对朋友的担忧，也理解你对这座圣堂的好奇......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧首",
      "text": "但如我方才所说，我们每个人都应在各自的位置，发挥各自的作用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "呀，本来我还以为我们聊得挺开心的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "但结果是......我被无情地拒绝了，对吧？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "......节哀顺变啊，各位。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "早知道这里发生了这样的事情，出门时我应该带几株麦穗的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "麦穗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "兰登修道院的葬礼会有些特别的仪式。我们会用麦穗编一顶发冠，放在死者的棺椁上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "这样，他在彼岸也能闻到面包和啤酒的香味，灵魂就会得到抚慰。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "谢谢你，好心的修女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "我和我的兄弟因为感染了矿石病，又没有参加骑士竞技的能力，只能被商业联合会驱逐，就这么流浪荒野。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "好不容易来到了拉特兰，可他却在这时候发病咽了气......想想也够倒霉的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "不过，教皇厅帮我安葬了他。他死得还算体面......甚至还有一位路过的萨科塔为他演奏了哀歌。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "这样啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "请确认，你所见的萨科塔，是否为黑色长直发，女性，所持的乐器是一架形制特殊的大提琴？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "呃，是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "她演奏了你们？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "在她的演奏过程中，你们是否感受到了幻觉，或者某种精神层面的不适？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "不适是指？反正听得我挺想哭的，毕竟那是我的兄弟啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "执行者先生，不是说好了，我来负责打探......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "公证所的其他执行者很快就会接这批流浪者到安布罗修区的安置点，我们的时间本就不多。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "流浪者也并非嫌犯，我不觉得有对他们使用迂回的询问策略的必要。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "以前为了给兰登修道院做宣传，我去过龙门，也去过维多利亚......我经常见到这样的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "因为种种不幸的遭遇，他们才离开自己的国家。他们大多和警察打过交道，对警察的态度都很......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "执行者相当于警察，对吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "呃，没有必要啦，毕竟你们刚收留了我们这些异族的感染者。好像以前你们自己的公民感染了矿石病，都是要被赶走的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "所以我现在对拉特兰官方的印象还不错，再说这位小哥也一身正气......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "至于你们刚刚想问的那位黑发萨科塔，她有什么问题吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "该萨科塔目前处于受监管状态。她擅自从修道院离开，我们一路调查她的行踪来到这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "她、她是囚犯？我还以为她是你们第六厅的公务员呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "你依据什么作出这样的判断？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "葬礼结束后，她向我们确认了修道院的情况——有没有哪些设施年久失修，存不存在安全隐患，有没有急缺的物资之类的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "库兰塔",
      "text": "哦对了，她还专门问过，最近刚到拉特兰的人里，有没有谁突然不见了，尤其是孕妇......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "席德佳",
      "text": "（听起来，阿尔图罗小姐不像是偶然经过啊......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "费德里科",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "何必问呢，前辈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "牧首的意思，当然和你差不多嘛——“别多管闲事”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "哈哈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "蕾缪安，我知道你是好心，不过你这是对我的不信任哦。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "前辈，还请你理解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "育婴圣堂，这座不知从何时起就睥睨着拉特兰城的巨构......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "不论是你、帕特里奇昂阁下，还是那位牧首，都许诺未来将从此处诞生。就连那位制造爆炸的“嫌犯”，似乎也对它颇有兴趣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "你一定比我更理解，负责情报与国安的第七厅，怎么能忽视这样万众瞩目的焦点呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "理解理解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "领路的保育员",
      "text": "麻烦让一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "保育员领着一队人经过，脚步声敲醒了空旷的启圣大堂。\n队伍中的人来自不同种族，没有一个人说话，但所有人都在好奇地打量着这个陌生的空间。\n蕾缪安连忙侧身让开。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "薇尔丽芙",
      "text": "怎么了，蕾缪安枢机？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "......没什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "蕾缪安",
      "text": "我是想说，好奇心害死菲林，我要是继续坚持，就该吃前辈的投诉了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
