{
  "server": "cn",
  "storyId": "act11d0_level_act11d0_07_end",
  "groupId": "act11d0",
  "stageId": "act11d0_07",
  "title": "群峦崩塌",
  "storyCode": "TW-7",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act11d0/level_act11d0_07_end.txt",
  "sourceHash": "49061b6f37ca2f3b133f67c9d0635738928aef6e766b415e302c91bdf1cc1358",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 7下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "快点，这里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "这附近的痕迹......更像是单纯的发泄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......塞弗林认为，这是一次有谋划，有规律的变节计划。但事实上呢？这的确就是一次单纯的暴力宣泄。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "卡达，发现什么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "没错，但是、但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "灰喉姐你快过来吧，我......我也不知道该怎么说......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "房间里......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "你的瞳孔......别怕，控制住自己，断崖，在外面陪着她，警戒周围的暴徒。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......在这里面？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "（......一片狼藉，真是惨烈的混战......呃......这是......冻裂的肢体？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "（等等，这个人是——？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "呃——！这个医生怎么！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "你要是坚持不让开，我连你一起杀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......刚才撒在你们身上的药剂，具有挥发毒性。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "啊！？你、你对我们做了什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "赶快说！不然我就让你——让你......让你.......呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "难受吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "告诉我毕德曼在哪里，我可以给你们解药，否则接下来的三个小时里，你们会在幻觉和呕吐之间度过。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "你这个恶毒的......我......我不知道......什么毕德曼......我只是......贵族都得......死......唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......那很抱歉，你们都要去监狱里待着了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "唔......？蘑菇？好大的蘑菇......怎么回事，怎么在动，怎么在咬人——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "长官......很多人都受伤了......！他们已经占领了转角商业街和梅普乐广场......但是，更多的人都被困在了十二音街道.....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "我们没法制止他们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......从第一个人受伤开始，我们就无法阻止任何事情了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "现在我们面对的结果有两种，一，投降。二，组织进攻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "我们该怎么做？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "投降，把控制权交给整合运动和叛乱分子，然后在冻土上饿死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "带领民众发起进攻，两败俱伤，死伤惨重，苟且偷生的人在冻土上饿死。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......或者......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "如果伤亡不可避免，至少少死几个——咳咳，咳咳咳——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "呃......咳咳咳，咳咳咳——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "长官——伯父？伯父？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "——！伯父，血，你的嘴角都是血......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "抱歉！让一下！塔佳娜小姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "伯父他，他说不出话来——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "您还好吗？调整呼吸，肺部病变导致失声，这种时候......这种时候应该......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "——怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "塞弗林长官他、他其实——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......你应该听医生的，戒烟。你的肺部顽疾不需要检查就能看出来有多糟糕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "让我检查一下......先把领口打开——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "喂！别乱动！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "你......你是感染者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "欸！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......这是矿石病的症状，源石从他的肺部扩张到了咽喉......你喉下那些黑色的粉末状固体是......体表源石结晶。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "啧，体细胞已经开始与源石融合，这就是你根本不在乎健康的理由吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "难道是在刚才的战斗中？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "这不是早期症状或是急性病变，他早就已经被感染了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "是天灾的时候......不对，那也太快了......感染时间还要更早......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "咳咳——咳咳咳——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......黑色的血块，铃兰，取样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "好的——！抱歉，长官，忍耐一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "现在的医院——肯定没在运作了，嘁，先把他抬回议事厅！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "——沃伦姆德，不能，没有长官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "你再强撑下去沃伦姆德就真的没有长官了——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "你——这种时候表现得，还真像个医生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "咳咳，咳咳咳——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "唉，吐了口血好像就可以说话了，还挺方便的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "嘴硬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "亚叶小姐，我有一个请求。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "你说你的，但我还是会把你带回去，丽萨，扶着点他，塔佳娜，我们把他扛回去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......各位，请，咳咳，隐瞒我的感染者身份......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "然后，我会承认我是火灾的凶手，我是导致沃伦姆德行差踏错的元凶......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "那真凶呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......顾不上了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "啊......至少，至少这样很多人就失去了厮杀下去的借口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "但这样还不够......没有足以钳制他们的外力，他们依旧会前仆后继地互相报复下去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "我请求......罗德岛的协助......即使我们现在，难以支付报酬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "如果沃伦姆德能挺过这次灾难......我们会报答你们的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......我们不是慈善组织。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "请答应我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "我无权代表罗德岛向你做出承诺......拯救一个近万人口的城镇，这超过了我们任务的范畴，也超过了阿米娅委任我的权限。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......但是，为了安托，“我们”是不会抛弃沃伦姆德的。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塞弗林",
      "text": "......谢谢。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "抱歉让一下，紧急伤员——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......灰喉？你怎么一个人回来了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "铃兰，把塞弗林长官抬进楼上的客房里......不要让其他人发现。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "虽然很残酷，但等塞弗林长官稳定下来后，他必须再次出现在众人的视野中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "铃兰",
      "text": "啊，好的！交给我吧！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "塔佳娜......你......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "......镇上的每个角落都在发生暴乱，哪怕此时此刻，也在出现伤亡......我，我不能坐在这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "我会去组织没有参与暴乱的民兵，至少......至少缩小暴乱的规模。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "嗯，加油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "——谢谢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......现在可以说了吧？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "我们找到毕德曼了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "那我们立刻就去抓住他，结束这场暴乱，为安托报——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "——不。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "他已经死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "我们在B2坐标位置的“留声机”找到了他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "他的后脑部有明显创口，皮肤表面有冰晶残留，有受到源石技艺袭击的痕迹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "在场干员做不出准确判断，但其他尸体的伤口和血液表明，至少在数个小时前毕德曼就已经死于暴乱。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "毕德曼已经死了，但是暴乱并没有停止。这意味着什么，我们都明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "卡达和断崖正在搜寻他的住所，不出意外的话——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "等等......！你说，你说他已经死了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......如果你需要我重复一遍的话，对，他已经死了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "亚叶",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "我看着亚叶脸上的笑容逐渐凝固——笑容，嗯。\n因为安托干员的牺牲，她的情绪变得很不稳定，直到我们得知了毕德曼的情报。\n不用被殖民问题，感染者问题和阶级问题困扰，她简单地快乐地找到了复仇的对象。\n她短暂地感到安心了吗？因为明确的目的而释然吗？\n那接下来，我该怎么处理她现在的这副......表情呢？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "......果然。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "这是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "这是危机合约的行动协议......毕德曼是签订了危机合约的天灾信使。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "所以呢，难道这一切都在规划之中？包括你自己的死，毕德曼......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "唔......但他这么做是为了什么？那个危什么的，会是幕后黑手吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "让人们丧生在天灾中不符合他们的行事理念......危机合约也不至于干出这么丧心病狂的事......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "......可如果......他打算帮助叛乱者以确保更多人生存下来？为什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "说到底这样真的能让更多人活下去吗？我可听灰喉姐说过，现在沃伦姆德的处境很糟糕喔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "不......危机合约只是一个平台。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "利用危机合约的信使中的确有少部分道德和常理不起作用的家伙，他们只想“救下”尽可能多的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "......当时沃伦姆德已经遭遇天灾，难道......为了让外界势力介入，他放了火......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "真庆幸莱恩哈特和罗德岛的其他天灾信使们并没有和他们牵扯过多......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "可......不对......有什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "断崖！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "看那头！那家乐器店的那头！好像有什么奇怪的东西！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "奇怪的东西？那是......山？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "不对，是移动的岩石巨像......？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "卡达",
      "text": "这个源石技艺，难道是那个家伙在操纵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "那不是一个人的源石技艺能做到的——快，回去找亚叶她们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "断崖",
      "text": "普通的民兵不可能拦得住一支身经百战的作战小队——一支萨卡兹作战小队！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "怎么了？这个震动是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "喂！又是那个石头巨像！快！快启动“留声机”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者",
      "text": "整合运动来帮助我们了！他们来了！他们来解放我们了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者A",
      "text": "整合运动万岁！进攻！把那些腐朽的贵族赶出去！进攻！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装的感染者B",
      "text": "——整合运动万岁！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "塔佳娜",
      "text": "......掩护其他人撤退，回到城镇中心区域，激活“留声机”，注意防守！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "镇民",
      "text": "塔佳娜，街道尽头的那个......那个是？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......停，稍息。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹战士",
      "text": "是......我们现在，仅一步之遥。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "......一步之遥，就可以毁灭这座城镇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "但我们的背后亦没有留下希望与存续，他们高呼解放，解放的只有怒火和仇恨。这只是常见的，龌龊的进军。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹战士",
      "text": "是吗？我其实没所谓的，事情到了这一步，已经不可能圆满收场了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "这是最后的机会......在我们踏出这最后一步前，给他们的机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹战士",
      "text": "......投降的机会？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "不......反抗的机会。彰显信念的机会，让我们和他们来代替所有人......分出胜负。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹战士",
      "text": "吃力不讨好，作为一个雇佣兵，你永远是最吃力不讨好的那个。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "萨卡兹战士",
      "text": "算了，还是听你的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "那么——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "泥岩",
      "text": "——沃土磐石，站起来吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
