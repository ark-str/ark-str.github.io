{
  "server": "cn",
  "storyId": "main_5_level_main_05-10_end",
  "groupId": "main_5",
  "stageId": "main_05-10",
  "title": "长夜终尽",
  "storyCode": "5-10",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_05-10_end.txt",
  "sourceHash": "1267211982e89ae6b35a67205fc3621097567eec3387aabe5dcc65f3cccf1daa",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "退路已尽。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "......你，你！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "你们还想往哪逃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "放下你的手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "你的把戏已经被我看穿了，长鳞的小子！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "我说了，我看穿了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "煌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "哼，不算什么，这点火力也就和炮仗差不多！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "你提前防御住了弩弹。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "你知道他们的位置？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "那当然，我已经全都找出来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "阿米娅，后退，我该用那个了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "知道！我会再一次干扰梅菲斯特的护卫，抓紧时间！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "这点血是送你们做临别礼物的，整合运动的“幻影弩手”们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "沸腾吧，爆开他们的伪装吧！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "你泼洒自己的血，用血来点火？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "哈，我难道看起来像个术师吗？那种四处纵火的家伙，最多只是些自我意识过剩的门外汉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "抱歉，这是战斗技巧。现身吧射手们，你们无处可藏了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德，伪装消失了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "命令，撤退。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "那些是......怎么回事！整合运动的狙击手是什么时候埋伏在那里的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "现在？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "现在。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "数个整合运动的狙击手突然现身，主要分布在近卫局东二楼和南三楼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "留神脚下，低处可能也有埋伏！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "大楼里的古怪之处，也是他们引起的吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "通过空气折射让身形变得透明啊，好手法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "不过你掩盖不了自己的行踪，又或者是动作幅度太大，也会导致这个源石技艺失效。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "我说得对吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "......你很聪明。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "是罗德岛情报做得好。你没戏唱了，投降吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "如果还要打的话，哼，不管有没有你的份，你都得为Ace和Scout抵命，小子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "浮士德，我们还有弹药。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "撤退。我们已经失去了情报优势。我会狙击他们，你们立刻转移。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幻影弩手",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "为什么不射击她？浮士德！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "我的护卫们，快去！四个人，四个人而已......其中只有三个能和你们为敌！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "战斗！现在就撕碎这些罪人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我们三个在Dr.{@nickname}的指挥下，胜过你们所有人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "更何况那些被你伤害了、剥夺了理智的感染者，意识里只剩下你的赘余思绪，不再是活生生的人......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "就连你身边那个带鳞的男孩也未必和你同心，他的思绪里充斥着混乱和悲伤......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "梅菲斯特，你才是这战场上孤身一人的那个！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "你读了我的心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我只是感受到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "所以你不会知道我在想什么。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "阿米娅！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我没事，他的弩弹我勉强挡的下来......！但这样的话，那些护卫......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特的护卫",
      "text": "【杂乱的发音】",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我的控制力在变弱！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "梅菲斯特，走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "他们的援军正在消灭我们的队伍。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "有些部队我们从没见过。计划有变，我们被算计了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "......为什么整合运动，二十多支小队，两支大队，还没在这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "弑君者为什么还没在这里？霜星为什么不在这里？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "这次和切尔诺伯格不同。我们没有切断对方的通讯，敌人有大量援军，抵抗很激烈。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "梅菲斯特......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "为什么他们还没在这里！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "想知道原因，我们要亲眼去看。先离开这里。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "煌，我差不多到极限了，你们能行吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "没问题，我和那个姓陈的，应该够！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "快！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我允许你走了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你......护卫们！去杀了她！杀了她！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特的护卫",
      "text": "咯......咯！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "嘁，十几个一起动，难办了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特的护卫",
      "text": "【咆哮】！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "他们要上了，姓陈的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "谢谢你，罗德岛的干员。现在没人干扰我了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "（咳，还是不行？我甚至没法让它彻底接触空气......算了，做到这步，应该够了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "（赤霄，至少这时候......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "“其色溢赤——”",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特的护卫",
      "text": "......咕啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "......不是吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特的护卫",
      "text": "唔，唔......呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特的护卫",
      "text": "（乌萨斯语）谢......谢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "你刚才是不是拔剑了？一剑？十几个这种东西？全灭？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "那把剑......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "阿米娅，有些话我是不是不能再乱说了啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "你......你做了......什......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "闪开！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你也逃不掉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "咕......！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "浮士德，浮士德！你受伤了，你，不，不......不！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "结束了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "还没有。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "咳咳，居然引诱我近身后再射击？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "你这不是挡住了吗。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "他们要借着爆炸逃走了！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "呜啊，连环爆炸？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "哎，整个顶楼都塌陷了，感觉我们追不了了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "一半是你刚才划开的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "那也没办法。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "现在，快走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "不行，我要在这里，等到他们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "这一步失败了。你必须走。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "失败，失败？不可能！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "难道一切不都是谋划好了吗......我不是早就召集整合运动了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "背叛？泄密？究竟是谁？近卫局为什么会知道我们的分布和计划？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "快走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "如果不是叛徒，又究竟是谁做的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "塔露拉姐姐是不会犯错的，所以她是故意......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "不会，不会的，她为什么要故意这样设计？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "......浮士德，我不想承认这是我们的失败。我不相信。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "浮士德",
      "text": "跳！我会拉住你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "梅菲斯特",
      "text": "......好。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "唉哟，这惨状，你要好好修修这栋楼了，长官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "遗憾，还是被那两个小子逃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "剩下那些没脑子的家伙像受惊的兽群一样涌过来，想全部制服，还真有点难度。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "至少我们成功地夺回了近卫局。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "哪怕是暂时的，这也是我们的胜利。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "阿米娅......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "罗德岛是怎么撤出切城的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "是这位罗德岛干员，煌小姐，及时支援了我们。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "也有一位说话音量很大的龙门警官在废城外接应......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "如果最开始近卫局没有袖手旁观的话，过程还会更顺利些。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "我还在想你是不是会说些没有罗德岛的帮助你也能行，你宁可和他们同归于尽一类的话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "还行，看来你还没迂腐到那种程度。还有什么想说的？没有的话，我想回罗德岛了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "罗德岛竟然还有那样的飞行载具。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "哎，罗德岛还有很多会让你惊讶的东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我们和罗德岛一样，不想把手牌打光。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "罗德岛难不成也算是你的牌？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "陈，陈长官......独立线路。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "是通讯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "喂。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "陈警官，你做得很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "诗怀雅警官在频道中吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "在。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "请向我汇报现在的进度。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "罗德岛也救出来了，各大队我也安排好了。调度加指挥，花了我整整三个晚上欸。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "那么，陈警官呢？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我已经夺回——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "——在罗德岛的协助下，我已经夺回近卫局。这个消息将借整合运动的指挥官之口，传达给所有整合运动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "龙门中潜藏的所有整合运动，已经聚集在这个城区，也照我们封堵和架设的所有路线，进入了各个埋伏点。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "接下来，只需等待他们的反扑即可。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我的任务已经完成。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "你们的其他几位同事也已经向我递交了报告，上个阶段的任务，大家都圆满地完成了。各位做得很不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "魏彦吾",
      "text": "那么，我们该进入下个阶段了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
