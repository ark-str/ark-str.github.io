{
  "server": "cn",
  "storyId": "act21side_level_act21side_06_beg",
  "groupId": "act21side",
  "stageId": "act21side_06",
  "title": "旧日碾轧",
  "storyCode": "IS-6",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/activities/act21side/level_act21side_06_beg.txt",
  "sourceHash": "7c0e0d61a45f5c5641daa2a19c8d6e5ffb3ec9f523559b93b6f725801f6c92de",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "莱昂图索",
      "speakerId": null,
      "text": "......嘶。"
    },
    {
      "type": "dialogue",
      "speakerName": "家族成员",
      "speakerId": null,
      "text": "少爷，您没事吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "莱昂图索",
      "speakerId": null,
      "text": "做了个梦而已。"
    },
    {
      "type": "dialogue",
      "speakerName": "莱昂图索",
      "speakerId": null,
      "text": "果然不能在沙发上睡觉。"
    },
    {
      "type": "dialogue",
      "speakerName": "莱昂图索",
      "speakerId": null,
      "text": "老头子呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "家族成员",
      "speakerId": null,
      "text": "首领已经前往剧院了。"
    },
    {
      "type": "dialogue",
      "speakerName": "莱昂图索",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "家族成员",
      "speakerId": null,
      "text": "您要去吗？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "莱昂图索将身体陷入沙发之中，没有回答。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": null,
      "text": "罗塞蒂，乔万娜。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "没错。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "切利尼娜，你我之间最初的约定，是为贝洛内赢得最后的胜利。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "不过，我改变了主意。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "只要你能完成这件事，你就不再欠贝洛内任何东西。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "届时，你可以自由地离开。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "我以狼之主扎罗的獠牙身份向你保证。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "啧啧，明明在下雨，太阳倒还是挺刺眼。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "监狱里的伙食还挺好的，建议你们也尝试一下。"
    },
    {
      "type": "dialogue",
      "speakerName": "忠诚的家族成员",
      "speakerId": null,
      "text": "确实不错，我以前还给他们提过几次建议。"
    },
    {
      "type": "dialogue",
      "speakerName": "忠诚的家族成员",
      "speakerId": null,
      "text": "请上车吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "我可以不参加吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "杀一个哥伦比亚人而已，用得着这么大张旗鼓吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "忠诚的家族成员",
      "speakerId": null,
      "text": "老爷说，切利尼娜也会参加。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "哦？"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "什么安排？"
    },
    {
      "type": "dialogue",
      "speakerName": "忠诚的家族成员",
      "speakerId": null,
      "text": "她会乔装成剧团的成员，在演出开始后，见机行动。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "嗯......那我的演出服呢？"
    },
    {
      "type": "dialogue",
      "speakerName": "忠诚的家族成员",
      "speakerId": null,
      "text": "老爷的意思是——"
    },
    {
      "type": "dialogue",
      "speakerName": "忠诚的家族成员",
      "speakerId": null,
      "text": "请您在观众席随机应变。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "......呵，呵呵。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "不解风情的老东西，他人呢，难道他想找个好位置自己看戏？"
    },
    {
      "type": "dialogue",
      "speakerName": "忠诚的家族成员",
      "speakerId": null,
      "text": "老爷另外有事，他要去见一个人。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "见一个人？"
    },
    {
      "type": "dialogue",
      "speakerName": "忠诚的家族成员",
      "speakerId": null,
      "text": "是的，一个洗车工。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "啊，空，我就知道你会在卡特琳娜小姐的工作室里练习。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "我倒是不反对啦，但是，还是提前去剧院化妆准备演出比较好吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "......嗯，说的也是。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "能天使已经去买早饭了，我们正好去和她会合吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "好。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "对了，之前我们不是说要办个欢迎会迎接能天使的姐姐吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "对啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "现在都不知道能不能赶得上了。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "可颂，当心脚下！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "哎？哎呀！"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "好疼......"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "你没事吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "没事没事，被绊了一跤而已。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "哎呀，这一摞书都弄倒了，我收拾一下。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "嗯？好像掉出来几张照片。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "照片？"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "嗯......嗯？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "怎么了？"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "你看。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "这是一张很多年前的照片。\n空勉强能够辨认出，背景应该是多年以前的哥伦比亚街头，繁华又宽阔。\n站在照片中央的，是一位中年男子，他的表情和蔼，却带着让人无法轻视的魄力。\n他的左右两边，站着一个鲁珀女孩和一个菲林女孩。\n左边的有着一头秀丽的金发，表情明快，一眼就能看出性格十分开朗。\n而右边的则有着一头黑发，脸上没有表情，让人看不出心里到底在想什么。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "你看，这张照片上的，是不是......小时候的德克萨斯？"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "然后站在她旁边的，是卡特琳娜小姐？！"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "你看照片的背后......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "照片的背后写着一行字，“乔万娜与切利尼娜，摄于1080”。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "乔万娜，这难道是卡特琳娜小姐的真名？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": "char_101_sora",
      "text": "乔万娜......乔万娜·罗塞蒂。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "这家店开多久了？"
    },
    {
      "type": "dialogue",
      "speakerName": "洗车工",
      "speakerId": null,
      "text": "五年了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "五年，巧了，我有条看门牙兽也走失了五年了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "也不知道，它现在过得还好不好。"
    },
    {
      "type": "dialogue",
      "speakerName": "洗车工",
      "speakerId": null,
      "text": "......这座城市这么大，总有活下去的法子。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "我之前一直不明白，我给它喂的肉也够多，窝也够好，它有什么不满意的。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "难道说，它其实是吃素的？"
    },
    {
      "type": "dialogue",
      "speakerName": "洗车工",
      "speakerId": null,
      "text": "也有可能，它只是真正开过一次荤之后，才知道，平时吃的肉有多难吃。"
    },
    {
      "type": "dialogue",
      "speakerName": "洗车工",
      "speakerId": null,
      "text": "难吃的肉......不如不吃。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "哦？"
    },
    {
      "type": "dialogue",
      "speakerName": "洗车工",
      "speakerId": null,
      "text": "您的车洗好了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "洗车手艺不错。"
    },
    {
      "type": "dialogue",
      "speakerName": "洗车工",
      "speakerId": null,
      "text": "熟能生巧罢了。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "呵，你总是能把手上的事情做好。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "但是，大厦将倾，丹布朗。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "你也该换换口味了。"
    },
    {
      "type": "dialogue",
      "speakerName": "洗车工",
      "speakerId": null,
      "text": "......我会考虑。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿尔贝托",
      "speakerId": null,
      "text": "好好想想，想通了，随时可以回来。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "你就是临时替补贝斯手的人吗？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": null,
      "text": "对。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "嗯......嗯？你的发色，是天生的吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": null,
      "text": "嗯。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "真稀奇啊，其他人演贝斯手这个角色都是要染的，这个发色和瞳色据说和德克萨斯这个家族有血缘关系的人才会有。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "而且仔细一看，你的眉眼......和萨尔瓦多雷也有点像，你难道是他们的私生子之类的？"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": null,
      "text": "......不，我和德克萨斯无关。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "好吧，也会有这样的巧合呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "来，坐下吧，你的底子很好，应该不用太麻烦就能给你化好妆。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "剧院包厢"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "剧场经理",
      "speakerId": null,
      "text": "请问，您对这个位置满意吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "乔万娜",
      "speakerId": null,
      "text": "嗯，视野不错。"
    },
    {
      "type": "dialogue",
      "speakerName": "剧场经理",
      "speakerId": null,
      "text": "那就好，那就好。"
    },
    {
      "type": "dialogue",
      "speakerName": "剧场经理",
      "speakerId": null,
      "text": "如果您有什么需要，请随时喊我。"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "speakerId": null,
      "text": "下去吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乔万娜",
      "speakerId": null,
      "text": "瓦拉赫，你不留下一起看吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "speakerId": null,
      "text": "你知道，我对这一类的东西向来不感冒，还是去给你拿几支好酒吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "乔万娜",
      "speakerId": null,
      "text": "我要——"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦拉赫",
      "speakerId": null,
      "text": "白兰地，我知道。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "抱歉，我来晚了。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "没事没事，大家都还在准备呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "坐吧，我先给你化好妆。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "好的。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "怎么了，你的脸色不太好，是太紧张了吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "......不，没什么。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "没事的，空你这么努力，大家一定会喜欢你的。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "但愿吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "对了，你知道吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "怎么了？"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "乐团的贝斯手好像得了急病没法出演了。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "欸，那怎么办？！"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "别急，总监临时找到了演员，现在正在另一间化妆室化妆呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "临时找到的......真的能行吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "相信总监的眼光吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "这么说起来，总监今天没有来吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "总监刚刚来过，吩咐了一些事情，然后就离开了，好像是要见一位客人。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "大人物就是这么忙碌的啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "没事的，空，你只要做好你能做的部分就可以了。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "嗯。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "场务人员",
      "speakerId": null,
      "text": "哎呀，这不是法官阁下吗！"
    },
    {
      "type": "dialogue",
      "speakerName": "场务人员",
      "speakerId": null,
      "text": "您有好一阵子没来了吧，您也是来看今天上演的歌舞剧的吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "......不，我只是路过罢了。"
    },
    {
      "type": "dialogue",
      "speakerName": "场务人员",
      "speakerId": null,
      "text": "这样啊，但是现在上演的是备受期待的《德克萨斯之死》，您一定会喜欢的。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "......抱歉，我没有心情。"
    },
    {
      "type": "dialogue",
      "speakerName": "场务人员",
      "speakerId": null,
      "text": "好吧，期待您下次的光临。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "......嗯？"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "（丹布朗？他怎么会来这里？）"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "（难道说......他听从了我的建议，想要来剧院放松一下？）"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "（但是，今天的剧院......）"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "等等。"
    },
    {
      "type": "dialogue",
      "speakerName": "场务人员",
      "speakerId": null,
      "text": "难道说，您改变主意了？"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "没错。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉维妮娅",
      "speakerId": null,
      "text": "给我一张票。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "剧院包厢"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "家族成员",
      "speakerId": null,
      "text": "首领，有人想要见您。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "哦？"
    },
    {
      "type": "dialogue",
      "speakerName": "家族成员",
      "speakerId": null,
      "text": "是食品安全部部长卢比奥。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "请他进来。"
    },
    {
      "type": "dialogue",
      "speakerName": "家族成员",
      "speakerId": null,
      "text": "是。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "卢比奥",
      "speakerId": null,
      "text": "贝纳尔多阁下——"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "在这里，叫我总监就好。"
    },
    {
      "type": "dialogue",
      "speakerName": "卢比奥",
      "speakerId": null,
      "text": "啊，好的，好的，能见到您十分荣幸，总监阁下。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "坐吧，卢比奥部长。"
    },
    {
      "type": "dialogue",
      "speakerName": "贝纳尔多",
      "speakerId": null,
      "text": "先看剧，我们再聊。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "报幕人",
      "speakerId": null,
      "text": "女士们，先生们，欢迎前来观看由白日剧团带来的精彩演出。"
    },
    {
      "type": "dialogue",
      "speakerName": "报幕人",
      "speakerId": null,
      "text": "由卡特琳娜女士撰写的《德克萨斯之死》，第二幕的演出。"
    },
    {
      "type": "dialogue",
      "speakerName": "报幕人",
      "speakerId": null,
      "text": "萨尔瓦多雷的故事，想必每个叙拉古人都耳熟能详，然而，真正了解其中那些细节的人又有多少？"
    },
    {
      "type": "dialogue",
      "speakerName": "报幕人",
      "speakerId": null,
      "text": "对德克萨斯家族有着深入了解的卡特琳娜女士，为我们提供了一个平实且细致的视角。"
    },
    {
      "type": "dialogue",
      "speakerName": "报幕人",
      "speakerId": null,
      "text": "就让我们在此处，一同了解那位萨尔瓦多雷的一生吧！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "嘶......呼。"
    },
    {
      "type": "dialogue",
      "speakerName": "化妆师",
      "speakerId": null,
      "text": "空，加油。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "嗯，那我去了！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "呼......终于找到我们的位置了。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "不愧是空，给我们留的位置视野真好。"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "空毕竟被赋予厚望了嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "抱歉，能让一下吗？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "萨科塔的小姑娘......在叙拉古可真少见。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "咦......你也是萨科塔？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "来到沃尔西尼这么久，我也是第一次见到同族。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "呵呵，看来，今天还真是好事连连。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "过去吧，孩子。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "怎么了？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "真奇怪，我从他身上感觉不到任何情绪，他是离群的萨科塔？"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "但是，他和我见过的离群萨科塔，又不太一样......"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "算了。说起来，你有没有觉得，今天剧院里那种一看就是家族里来的人有点多啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "我听人说，好像是因为，罗塞蒂家族的首领来了。"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "欸，那不就是你刚才说的......"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "嗯，不过，现在还是先看演出吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "（唱）那是一个混乱与机遇并存的时代，有的人被时代的浪潮吞没，而有的人，则站在了时代的先端。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "（唱）暴力与财富，权力与秩序，成功者用什么来交换？"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "（唱）一个叙拉古人踏上了哥伦比亚的土地，带着野心，伤痕和苦难。"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "（唱）故事再次开始，女士们先生们，请看看吧，时代由谁掌管。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "这个歌声......"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "原来如此，你是来接她的吗。"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "但是，你真的做得到吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "罗塞蒂家族成员",
      "speakerId": null,
      "text": "什么人？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "拉普兰德",
      "speakerId": null,
      "text": "女士们，先生们，就让演出正式开始吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乔万娜",
      "speakerId": null,
      "text": "......没想到，真的是你，切利尼娜。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "能天使",
      "speakerId": null,
      "text": "咦......"
    },
    {
      "type": "dialogue",
      "speakerName": "可颂",
      "speakerId": null,
      "text": "德克萨斯？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空",
      "speakerId": null,
      "text": "——欸？"
    },
    {
      "type": "dialogue",
      "speakerName": "德克萨斯",
      "speakerId": null,
      "text": "......？！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "德克萨斯在一瞬间看向包厢其中之一。\n她知道，贝纳尔多正坐在那里俯视着一切。\n她心中了然。\n无论是巧合，亦或者是某种必然，空在这一刻既是危险的，又是安全的。\n一切取决于她。\n观众席中的异动，远处隐约传来的微响，都在宣告着刺杀的开始。\n她向空做了个噤声的动作，然后，拨动了手中的琴弦。\n好戏开场。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
      "speakerId": "char_101_sora",
      "aliases": [
        "空"
      ]
    }
  ]
}
