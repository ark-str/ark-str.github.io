{
  "server": "cn",
  "storyId": "main_7_level_main_07-01_beg",
  "groupId": "main_7",
  "stageId": "main_07-01",
  "title": "别离之夜",
  "storyCode": "7-2",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_07-01_beg.txt",
  "sourceHash": "776011f5e338687057fe0d7a0c802182f3943646dd66e8fa2bf9c1b76a8339c2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "6:30 p.m."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "编号00000-00002，接入权限-8。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "Dr.{@nickname}，欢迎访问罗德岛综合生物处理室，已依据生物数据对您的意图进行判断。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "PRTS",
      "text": "另外，系统检测到您的心情不佳。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "少烦我。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Dr.{@nickname}表现出一定的攻击性。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "请放心，系统不会因此电击你，不用太过顾忌系统对你的检测。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "Dr.{@nickname}陷入了沉默。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "无论是无声抗议还是不愿进行沟通，我认为这都是一种孤独性精神障碍症的表现。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "当然，请便，系统会平等对待所有人。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "该怎么样才算是好心情？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "好与坏是一种主观判断。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "不过，本系统集成了几乎所有有记载的精神活动状态，以及各类神经兴奋的激素标准。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "所以你可以认为，本系统的主观判断是无限接近客观事实的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "因此，无论Dr.{@nickname}将要采取什么样的行动，系统都能在一定程度上进行模拟。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "所以，想做什么就去做吧。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "PRTS具备相应的无害安抚机能。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "PRTS",
              "text": "当你采取过激行动时你会立刻昏厥并在3.55个工作时后醒来，这可以保证你的行为向正常标准贴近。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "Welcome home, Doctor。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......这里真的能算家吗？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "你是，Dr.{@nickname}？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "啊？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......？",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你好？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "......是你，没有错。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我感觉到了......虽然，不太一样。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "不过......你怀里的人，穿的制服......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我可以问一问，你抱着的是谁吗？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "一介战士。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "战士？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "啊......她在你身上留下了伤口。她是敌人？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "不，不是......这伤口，不是会杀死人的伤口。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "一位同胞。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "她也是感染者......？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "不，你不是这个意思。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "Dr.{@nickname}，你像是失去了什么。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "一个朋友。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "她是你的朋友？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "可是，朋友......她和你相联系的时间，很短很短。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "我不知道......我不知道这会不会很快就消失。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你能......感受到什么？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "所有人相互交流的痕迹。气味，温度，形状",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我也不太清楚，但她......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "女孩将手伸向霜星。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（默许）",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "唔。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "不。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "你不想我这么做吧？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "不，不是。我是外人。我和她没有联系。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "这不是我能做的事情，对吧？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "不好意思。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "（出声阻止）",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你也和阿米娅一样，能读心？",
          "value": "4",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "不，没有，我不能......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "阿米娅是特别的。我知道阿米娅的法术......也觉得她很辛苦。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "5",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "我......我想，我不能碰她。我也不能感受她。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "她与这片大地的联系和我没有关联。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "我没有......没有理由去触碰她。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "我没法那么快理解你的反应。",
          "value": "6",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "其他干员，也会这么说。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "罗德岛上，大家都很有个性......但我可能更奇怪一些。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "抱歉。",
          "value": "7",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "没关系，没关系的。我已经习惯了。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "你是要......用这个机器吧？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "8",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "请，请不要生气......",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "你不说话，我有些......有些不知道该做什么。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "你是要......用这个机器吧？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "对不起，小姑娘。",
          "value": "9",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "没事的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "比起被别人害怕，我更愿意别人认真对我说话。所以，没问题的。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "text": "你是要......用这个机器吧？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "如果这里确实是感染者最后归宿的话。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "......嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "我来帮你吧。先让我看一下记录。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "嗯，没问题，这个舱室已经清理过了。把她放在这个平台上吧。轻一点，嗯。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "之后平台会收进去，然后......等舱门关上，按下这个键就可以了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你很熟悉操作。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "啊，因为我操作过许多遍了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "为什么.......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "罗德岛的感染者，最后都会到这里来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "如果是我认识，我感受过的人，我的队员，我都会自己操作。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "原本的使用说明书很复杂，系统简单的操作方式，我都记在终端上了。只要稍稍看看，身体就会熟悉那种感觉。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "什么感觉？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "啊......大概就像链子一样。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "链子......？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "说是两个人之间牵着的线也可以。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "送走和你有联系的人，是解开缠在他们身上的线。线的另一边还是系在我们身上，可哪怕没有再系着谁了，线却也垂不下来。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "那种感觉，是身体里有什么消失了的感觉。已经不知道那里是什么，却又知道，他们曾经在，也不会回来。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "为什么要去熟悉这种感觉？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "因为只有熟悉了，才不会突然地痛起来吧？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......你究竟是......？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "打扰一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "身在罗德岛生物感染综合处理室的精英干员Rosmontis，你的识别码将在15mins后失效。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "接下来我将为你进行更新，请在原地停留十五秒左右。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "另外，接舷区发生了小规模的武装冲突，有条件请在识别码更新后进行支援，以期减少我方资源的损耗。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "啊，嗯。我知道了，马上就去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "我在终端上记一下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "第六次提示你，如果你愿意向本系统开放权限，系统可以直接将信息发送至......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "不行。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "这是只有我......只有我能写的东西。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "PRTS",
          "text": "明白。请。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "精英干员......？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "PRTS指的是我。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我该叫你Rosmontis吗？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "你可以叫我......迷迭香。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......她，叫什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "我想......我想至少知道她的名字。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "霜星。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "霜星......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "好好听。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "你好，霜星。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "迷迭香",
          "text": "......拜拜。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
