{
  "server": "cn",
  "storyId": "story_cerber_set_1_story_1",
  "groupId": "story_cerber_set_1",
  "stageId": null,
  "title": "特大号烤饼",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/memory/story_cerber_1_1.txt",
  "sourceHash": "6800728c635b16f7426f576724f4fde5e2da8b7b9a4c5b961729843a3682f900",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "罗德岛主舰\n火神的工坊"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "小刻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "怎么了大姐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是不是要我帮忙呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "装备有多久没保养了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哦......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我想想。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "一......二......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（扳手指头）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大概十五天，吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是时候了，今天维护一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "给你画的保养示意图还在吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "在的！我把它贴房间里了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那房间里工具和消耗品够不够？用完的话可以现在就拿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "够的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "先收拾一下吧，等炉火暗下去我们就可以走了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "走？大姐是要出去吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是，今天要去锅炉房帮忙检查和维护，然后要去仓库收订好的胚料，顾不上炉火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小刻可以看炉子的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "照看火炉不适合你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "而且你也有自己要做的事情，对不对？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "差不多了，走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "午餐给你做好了，离开的时候记得拿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我忙完就回来找你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的大姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那么，一会见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "一定要快点回来啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊......走掉了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我......做什么比较好呢......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "先回房间保养宝贝吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "宿舍区\n刻俄柏的房间"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "这个......图上说要用植物油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "植物油?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是......这个?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "标签上写着——植......物......油！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "猜对啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "下一步要做什么来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "用小抹布蘸一点油，然后慢慢涂满宝贝上亮晶晶的部分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "对就是这样！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我记得超级清楚。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不知道弄完以后大姐会怎么表扬我呢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "上次一点都没做错的时候，大姐手打了一个陀螺给我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "这次会是更好玩的东西吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "说起来，我还没尝过油的味道呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "既然是宝贝的食物，应该味道不错吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（用手指沾点油，舔了一口）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "呕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "看来宝贝喜欢吃的我都不能吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "本来还以为能和她们有一点共同爱好呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "继续继续。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好，涂完啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "接下来要做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哦，其他地方也要上油啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "还要用不同品种的油。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "过了好久"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好像做得差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "肚子有点饿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔，吃饭吃饭。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "今天的午餐是——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "香煎肉兽排耶！还有淋上酱料的土豆泥！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊呜啊呜！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哈——吃完啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不愧是大姐，手艺真好呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "就是——肚子还有点饿——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯，现在几点来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哦，十......十一点一刻......到中午了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是大家吃饭的时间没错！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "也就是说——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "耶！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "冲呀！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "11:30 A.M.\n罗德岛食堂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "果然这个时候人就变多了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "让我看看有些什么菜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔，唔喔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇哦！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "讯使",
      "text": "你好，小刻俄柏，要吃什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我就看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（这里好吃的那么多，里面肯定有更多吧！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（好，我要想想怎么溜进去。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "讯使",
      "text": "不来点什么吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不用不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "再见！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "讯使",
      "text": "再见。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "讯使先生，一会您柜台前的菜会来，还请注意一下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "讯使",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "讯使",
      "text": "（小声）她来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "（小声）我知道了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐说只有细心观察才能发现机会。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "上次我没好好看，被门口的大叔提出来了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "这次就不一样了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我一定能进去的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "这是上汤浇菜吧，如果我没记错，应该是中间，讯使站着的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（离我藏起来的地方不远就是门。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（门旁边有个好看的姐姐，进去的时候不要被她发现。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（小熊在和她讲话。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（她旁边有一整排好吃的，但是都有人看着。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（再远点的地方有个小开口，好像是放盘子的，我进不去。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（还是只能走门。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（门口还有好多人走来走去的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（嗯，再等一会。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（门口的人好像越来越少了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（没人了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（机会到了！！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（冲呀！！！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好吃的我来啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "呜啊啊小刻你不能进去！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不行吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "不行！你看到门上那个贴纸了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "看到了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "一个红的圆圈里有根斜着的红线。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "还有小刻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "这是“小刻禁止入内”的意思，明白吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "明白。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "明白为什么还要往里面走！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "饿了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "饿了可以去那边排队买东西吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "饿了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "总，总之，小刻不能进去！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "饿了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "好好好古米想想办法！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "如果......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "如果古米把这块饼干给你，你能答应古米不进去吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（嗅嗅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "给......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "谢谢！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "没过多久"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊给的饼干好好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "但是还是饿......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不好意思啊小熊，我还是要进去吃好吃的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "刚刚可能是我太开心发出声音被发现了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "这次不会再犯这样的错误了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔，让我看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（除了门旁边那个站在台子后面的大姐姐，基本上没有人了。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（门还开着？！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（哇！！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（里面那个篮子，有面包！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（好像还是现烤的耶！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（我要吃！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好吃的好吃的我现在就过来！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊呜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "怎么了，急急忙忙的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（糟糕，被发现了！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "呃，呜呜......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（怎么办怎么办！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我，我想上厕所。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "这里不是厕所，那边有块牌子，牌子上有蓝色和粉红色小人的才是。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊是这样啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "谢谢姐姐！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "不客气，下次可不要走错了啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（哎呀总算是没有被发现，要是被抓住，让火神大姐知道就麻烦了。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "远山，最后一锅菜来了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "啊，辛苦了，这锅在最里面黑角站着的地方。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "你怎么了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "没事，被古米咬了一口。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "哎呀，我还不知道原来你们关系那么好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "别调笑我了，疼着呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "哼哼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "哦对了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "一会在厨房门口的准备区放两套标准份的饭食吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "喂佩洛的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "好，我进去和师傅们说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "啊疼疼疼......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "一会说不定还会麻哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "不要啊，饶了我吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "只是开个玩笑~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "你开玩笑，是不是就代表我没救了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "怎么会呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "远山",
      "text": "快去吧，一会我们就可以收工吃饭了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "坚雷",
      "text": "好......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "这次一定能成功的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "让我看看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "这不是什么人都没有嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "门口的大姐姐也不见了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "耶！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嘿！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嘿嘿，门也没锁。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我进来啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哦噢！果然有吃的！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "让我尝尝看——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇哦，好吃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "不错！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊呜啊呜啊呜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊，吃到了，好开心！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "该回家继续保养宝贝啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "刚刚，小熊的肚子是不是也在咕咕叫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "她把饼干给我，是不是她就饿肚子了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "感觉有点对不起小熊......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐说，别人帮了你，你就要加倍回报他。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊给了我一块小饼干，那我就要还给她一块大大大——饼干。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好，等大姐回来就做！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "现在先回家，把今天布置的任务做完。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "刻俄柏的房间"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "唔......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "武器都保养好了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "插武器的袋子和背包也都清洁过了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "现在就剩下最后一件事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐你早点回来啊，这样小熊能少饿一会肚子啊......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "谁？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是我。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊大姐我这就给你开门！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐你回来得好快啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "今天的工作比较顺利，所以就早点回来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "能让我看一下你的保养成果吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小刻正好刚刚做完，武器都整整齐齐放在桌子上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "好，我看一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（我都是按照画来做的。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（对自己有信心！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（不会错的！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "怎，怎么样呀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "油上得很均匀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "（凑近闻一闻）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "也没有用错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "哦？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "鞘也都清洁过了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "做得不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "谢谢大姐！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哎嘿嘿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我现在要回工坊，你一起来吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "火神的工坊"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "这批胚料成色不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "希望能做出些令人满意的作品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（说啊，快说啊，小熊还饿着呢啊！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（但是，好，好紧张，有点不敢说......）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "怎么了，有什么想说的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊，是这样的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐能教我做大饼干吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "哦？你终于要自己做吃的了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊，是，是的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐快教我，小熊要饿死了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "小熊......是，古米吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊，呃，嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "中午......对，中午！我中午碰到了小熊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊请我吃了块好吃的饼干！所以我想还小熊一个更大的，更好吃的，但现在我既不会做饼干，也不知道小熊住在哪里，我，我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "所以我，呃，我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐，我——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "再说下去你就要结巴了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "对不起......我，我有点急......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "嗯，好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "现在，听我说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我知道她住在哪里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我来教你做吃的，然后带你去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "真的吗！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "只要你想学，就可以教。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我要学！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "正好我这里有点发好的面，我们就做个大号的饼，好不好？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "你想做多大？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "越大越好！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "帮我把工作台收拾一下吧，我先让炉火重新旺起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "准备得差不多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "小刻，手洗好了吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇，这是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "面团。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "那我要做什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "很简单，揉面。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "你先试试看，要是错了我会告诉你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "揉面......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是这样吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "对，继续。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "不用怕摁坏，用力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "再摁个几分钟。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "好，差不多了，把它摊在板上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "用刀分成两份。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是这样吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "对。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "然后把每一份都摁扁成饼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "这一次我们先不用馅料，等以后你熟练了，我再教你调配馅料的方法和馅饼的做法。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "这里边角上还有一点没压下去，对，就这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "好，不错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "把饼连着板一起放进火炉吧。给，这是手套，先把它戴上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是放进火炉里的架子上吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "没错。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好——放好啦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "做饼还是蛮简单的嘛。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我还要做什么吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "看着时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "啊——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好难哦。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大概十分钟左右"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "小刻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯......嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "该把饼拿出来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好了吗？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "嗯。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "噢噢哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "当心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "先把手套带好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好，好的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "放在桌上，然后就完成了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好——叻。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（嗅嗅）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好香啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "肯定很好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我尝尝看。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（撕下一块放入嘴中）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好吃！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "果然饼还是要热的才好吃。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "我得赶紧给小熊送过去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那这块我先帮你用木板夹好，这样能冷得慢些。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "这次我带你认路，下次你就要自己去了，明白吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "宿舍区\n古米宿舍门口"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "到了，就是这里。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（摁门铃）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "叮咚"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "进来吧，门没关。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "（探头张望）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊在吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊你在啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "唉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "你好呀。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "中午吃了你的饼干，现在来还你一块。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "火神大姐教我做的，刚刚做完就送过来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "古米",
      "text": "是不是......有点大？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "快吃吧，冷了就不好吃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "拜拜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "小熊好像很开心。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是吗，那就好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "大姐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "嗯？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "谢谢你！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "呵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "没什么好谢的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "赶紧学好，以后就能自己做饼吃了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "甚至有一天能自己做蜜饼，也说不定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "哇，好像很不错！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "对吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "但是我还是会吃大姐做的蜜饼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "是吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "是的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "哼，那也挺好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我们回去吧，炉火没人看着可不行。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "再说，你刚刚做的饼还没吃完。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "对哦！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "急着给小熊送饼，我自己还没吃舒服呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那样的饼，充饥是不错，但要称得上好吃，还得要一些其他东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "还记得上次的肉酱吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "嗯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "想不想用它蘸着饼吃？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "想！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "那么快走吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "火神",
      "text": "我也有点饿了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "刻俄柏",
      "text": "好吃的我来啦！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
