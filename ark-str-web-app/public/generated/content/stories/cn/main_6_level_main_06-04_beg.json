{
  "server": "cn",
  "storyId": "main_6_level_main_06-04_beg",
  "groupId": "main_6",
  "stageId": "main_06-04",
  "title": "溃烂的疮疤",
  "storyCode": "6-4",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_06-04_beg.txt",
  "sourceHash": "68daee144e1ac72e471a3aa686f8110904e99dc9ca13a23b58200e9e0a551a36",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "快！快撤！那些感染者已经变成彻底的怪物了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "啊！！我被咬住了，我被咬住了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "啊，啊！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "（恐怖的尖叫）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "......怎么会这样......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "混账白发小子！！他又干了什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "博士，动作快！我们快去预定地点和阿米娅汇合！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "这个数量级的牧群，不成型的火力小队是对付不了的，我们只能酌情行事！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "这时候可别想着帮助近卫局作战，我们的处境可比他们窘迫多了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "煌",
      "text": "先暂缓对近卫局的援助，我现在只敢保证你我的安全！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "不行，这波我们实在扛不住了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "必须撤离！再不撤的话，我们小队就完了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "别慌张。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "啊？！你是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "这身装束......你......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "援军马上就到了。再坚持一下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "分成两队吧。向他们两侧移动。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "可是，大人......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "这次请相信我。虽然我不能出手，但这个办法会起效。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "夹击之后，从两侧把他们控制住；剩下的，就交给援军吧。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "呃，呃！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "......谢谢长官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "如果你没帮我们挡下那个......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "背后。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "快，快回击！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "没用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你们聚拢。缩起来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "不，可是那样......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "不行。在这里，光防御并没有用。我们必须得主动寻找出路......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "对了，从高处！我们从楼梯走，反过来利用建筑里的走廊攻击它们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "......不成，好像还是只能防御。但至少不会再被这一大群疯子挤在角落了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "对，先转移，然后通过各出入口聚拢，快速收缩队伍，进入防御姿态！快，动起来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "很好。加分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "长官，请跟我们一起来！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不用。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "你们去。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我从地上走过去。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "攻势太猛烈了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "我们装备的都是穿刺性武器，没法有效对抗他们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "不能退后！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "我们背后是安全区！要是让他们打进去了，里面的市民就完了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "那怎么办？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "要战便战！战到近卫局一个都不剩为止！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "小心源石投掷物，除了会腐蚀装备以外，有些是会爆炸的！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "啊......！阿中受伤了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "阿中，退下来！你，顶上去！别让它们穿过防线！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "咕。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "啊啊啊啊！它，它抓到我了，它在咬，不，唉啊啊！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "阿义！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "真丢人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "纵贯白雷正法，去！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "唔，唔！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "雷电法术？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "什，什么......一瞬间就把这些躁狂患者都消灭了？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "哈，哈......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "刚才就说了不会出手不会出手，没想到，你们这些个样子怎么保护百姓？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "到最后居然还是让我动手了，太丢脸了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "监察司长官......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "长官前长官后的，不是让你们当我不存在吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "......我们没想......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "本来想说精神可嘉，结果你们现在都活蹦乱跳的，还把事情丢给我解决，也不知道你们还能干些什么！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "走！去下个地方！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "可是你刚才说......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "快指路！我都动手了，你们怎么就不知道动作快点！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "对了，刚刚我没出手过，一定给我记住了，明白吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "明白！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "但百姓要是受到一分一毫的伤害，你们都该撤职，我也得辞职，全部失业！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "明，明白......我们会尽力的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "知道就好！还站在那干嘛？走呀！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "......对了，你们认识那些黑蓑吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "黑蓑？那是什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "监察司",
      "text": "眼力太差了吧！就是那些在楼顶上行动的，穿黑色蓑衣的人啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局队长",
      "text": "......抱歉长官，你说什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "盾卫出列！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "侦察队，后撤！死守火力点！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "这些突变感染者，居然还会扰乱电波？这样下去，侦察队也会有危险！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "......没法停下来！止不住！你刚才一个人砍了多少这种东西？能不能再表演一遍？！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "不一样！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "啊？个仆街龙关键时刻怎么这么没用！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "那你先表演点作用给我看看！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "无人机！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "啊。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "陈警司说了！！！侦察队！！！后撤！！！死守火力点！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "怎么样？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "啊？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "我问你怎么样！火力小组，弩弹发射！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你说什么？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你把我弄耳鸣了！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "去，用你这本领通知带β号源石电台的通讯小组，让他通知其他各大队，牧群棘手，坚守位置，尽量减少伤亡，别省火力！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "你可真是个*不雅用语*！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我看到你的嘴型了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "诗怀雅",
      "text": "（“丢”音的嘴型）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "陈sir！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "我听不清！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "陈sir！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "（此起彼伏的咆哮）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "声音再大点！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "陈sir！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局盾卫",
      "text": "用破墙弹！快！破墙弹！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "真安静啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "陈sir。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "嗯，我听得见。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "说。没关系。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "我们有......客人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "已经来了吗？看来已经顺势混进我们的小队里了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "也算是意料之中。他们不可能真放手让近卫局去做的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "无所谓，不用改变任何计划。让他们看看龙门的实力。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "还有一个消息，我......不知道它的准确性怎么样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "你说。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "有队员目击到身穿黑色雨披的人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "整合运动？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "恰好相反，我们发现的都是整合运动与他们交战的痕迹。而且......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "而且什么？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近卫局成员",
      "text": "而且......那些整合运动的死状都很......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "搞什么都市传说，大晴天的穿着黑色雨披在龙门里神出鬼没？真该去看精神科了......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "陈",
      "text": "黑色雨披？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "这是......什么？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "十二区已洁净。已抹除全部感染者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "三队、四队正在行动中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "前往下一区域。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "呃......呃......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "牧群",
      "text": "（诡异的哭号）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "为、为什么！为什么要伤害同胞，醒醒啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "不、不行！快逃，快逃啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "你们快走，别被他们抓住！快走啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "已发现额外目标。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "感染者流窜群体，发现于十三区、六区交界。四十四人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "预计完成时间小于五分钟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "行动开始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "啊，救、救救我们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "整合运动成员",
      "text": "我们投降！我们——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "..................",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "灰喉",
      "text": "呃，唔......不，不......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
