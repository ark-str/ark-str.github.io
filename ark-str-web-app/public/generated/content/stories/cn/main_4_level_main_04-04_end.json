  "stageId": "main_04-04",
  "title": "不要恐慌",
  "storyCode": "4-4",
  "avgTag": "行动后",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_04-04_end.txt",
