{"server":"cn","storyId":"main_4_level_main_04-04_end","groupId":"main_4","stageId":"main_04-04","title":"不要恐慌","storyCode":"4-4","avgTag":"行动后","sourcePath":"vendor/ArknightsGamedata/cn/gamedata/story/obt/main/level_main_04-04_end.txt","sourceHash":"a9cf7129f68754ec95cedb78ae4edcfce3c9e536f93fa750288c9b1c4ebaac39","bodyAvailable":true,"blocks":[{"type":"narration","text":"第三十二关（前）"},{"type":"background","backgroundId":"bg_cher_2"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"哈，哈......可恶......"},{"type":"dialogue","speakerName":"杰西卡","speakerId":"char_259_Jessica","isRemote":false,"text":"总算......解决了......"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"......"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"......不，还没有。"},{"type":"dialogue","speakerName":"杰西卡","speakerId":"char_259_Jessica","isRemote":false,"text":"那些空中飘荡下来的粉尘......是怎么回事？"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":null,"isRemote":false,"text":"咕，咕......"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":null,"isRemote":false,"text":"呃，呃啊！"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":null,"isRemote":false,"text":"好疼......好疼啊......"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":null,"isRemote":false,"text":"啊啊......啊啊！好痒，好痒！！"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":null,"isRemote":false,"text":"啊啊？！！"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":null,"isRemote":false,"text":"罗......罗德岛！"},{"type":"dialogue","speakerName":"整合运动成员","speakerId":null,"isRemote":false,"text":"敌人......敌人！！"},{"type":"dialogue","speakerName":"杰西卡","speakerId":"char_259_Jessica","isRemote":false,"text":"什......！怎么......"},{"type":"dialogue","speakerName":"杰西卡","speakerId":"char_259_Jessica","isRemote":false,"text":"刚才被打倒的整合运动又站起来了——？"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"怎么？不行了吗？"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"光芒，从那个家伙的法杖里......？"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"我可还没有动手哦。"},{"type":"dialogue","speakerName":"杰西卡","speakerId":"char_259_Jessica","isRemote":false,"text":"而且......还有更多敌人增援....."},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"可恶......！"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"现在，只能依赖这一发弩弹能把敌人的首领......！"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"不。"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"哈哈......这种情况下，你们还有讨论的余裕吗？"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"真自信啊。"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"呵，就让这发弩弹教教你......"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"不，陨星。不行。"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"啧......！为什么！"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"快撤退。"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"我感受到了......"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"是他们。他们来了。"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"嗯？不射击吗？"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"真可惜。"},{"type":"dialogue","speakerName":"梅菲斯特","speakerId":"char_1507_Mephisto","isRemote":false,"text":"之后，你们就没机会了哦。"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"他要撤退了？可是——"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"陨星！射击西侧那栋危楼，快！至少可以分散敌人的注意力！"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"......只能这样了！没问题！"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"杰西卡，跑起来。"},{"type":"dialogue","speakerName":"杰西卡","speakerId":"char_259_Jessica","isRemote":false,"text":"诶？"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"......雪怪们来了。"},{"type":"dialogue","speakerName":"杰西卡","speakerId":"char_259_Jessica","isRemote":false,"text":"等......"},{"type":"dialogue","speakerName":"杰西卡","speakerId":"char_259_Jessica","isRemote":false,"text":"好、好冷......"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"................走。"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"立刻。"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"......杰西卡。"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"她说得对。"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"我们快走......！"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"阿米娅，听得见吗。"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"喂，喂。"},{"type":"dialogue","speakerName":"陨星","speakerId":"char_219_meteo","isRemote":false,"text":"快走！我掩护你们！"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"听好，阿米娅。"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"——不要来。"},{"type":"dialogue","speakerName":"霜叶","speakerId":"char_193_frostl","isRemote":false,"text":"这个废城分城是——"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_1507_Mephisto","aliases":["梅菲斯特"]},{"speakerId":"char_193_frostl","aliases":["霜叶"]},{"speakerId":"char_219_meteo","aliases":["陨星"]},{"speakerId":"char_259_Jessica","aliases":["杰西卡"]}]}
