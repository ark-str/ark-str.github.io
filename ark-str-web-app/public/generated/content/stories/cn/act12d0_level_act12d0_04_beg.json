{
  "server": "cn",
  "storyId": "act12d0_level_act12d0_04_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_04",
  "title": "机兽咆哮",
  "storyCode": "RI-4",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/activities/act12d0/level_act12d0_04_beg.txt",
  "sourceHash": "bce29ab899ebc1810ed878f707b1df8519ba1dacc53d8a16550441f45ca106bc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人A",
      "text": "森蚺，森蚺！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人B",
      "text": "把他们全都解决掉，森蚺！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人C",
      "text": "大酋长，大酋长！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人D",
      "text": "森蚺，娶我！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯勇士",
      "text": "......森蚺，你果然来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯勇士",
      "text": "我还以为你缩在自己的雨林里不敢来了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "雨林很好。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯勇士",
      "text": "哼，缩在雨林里的提亚卡乌都是胆小鬼！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "是不是胆小鬼，你马上就知道了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "祖玛玛这家伙，虽然身上多了些奇怪的装备，还是和以前一样啊。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "哦，博士，我还没详细给你介绍过吧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "台上那个女孩叫祖玛玛，我们不是一个部族，不过以前离得比较近，年纪又差不多，算是一起长大的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "这家伙虽然不爱说话，但其实也挺厉害。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "不过不知道什么时候起，她就变得怪怪的，虽然还是很能打，但是没事的时候会老是自己在捣鼓一些怪东西。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "在那之后她部族搬走了，我们就见的比较少。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "听说她还是很厉害，但是好像染上了怪病，会和没人的地方说话。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "我在罗德岛的时候还特地查过类似的症状，感觉是精神方面的问题，不过她现在看起来还挺正常的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "上次祭典的时候我还以为她会来的，结果她没来，我还挺遗憾的。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "没想到现在她开始自称森蚺，既然她来了，上面这个人应该没戏了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯勇士",
      "text": "咕哈！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "哈，果然，这家伙也变强了啊，真想和现在的她打一架啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "特米米",
      "text": "果然，祖玛玛很强，但是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘉维尔",
      "text": "嗯？那边的是......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人",
      "text": "森蚺，我们来挑战你。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "你们是？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人",
      "text": "我是猛火部族的族长，乌代！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿达克利斯人",
      "text": "我是刀疤部族的族长，阿鲁纳！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌代&阿鲁纳",
      "text": "小的们，上来！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "你们要一起上吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌代",
      "text": "嘿，我们之间达成了协......什么来着？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿鲁纳",
      "text": "蠢货，那叫协议！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌代",
      "text": "哦对，协议！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿鲁纳",
      "text": "可别以为你可以轻易当上大酋长！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森蚺",
      "text": "我没有这么想过。不过，我没听说过你们有这么团结。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乌代",
      "text": "这是我们自己的事。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿鲁纳",
      "text": "嘿，我只是看不惯你这种捣鼓机器的家伙来当大酋长！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "祭典可以上许多人的？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "诶？嗯，是的。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "博士，看你的表情，你该不会以为祭典是什么擂台赛节目吧。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "难道不是一对一吗？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "特米米",
              "text": "诶？这样不会花很长时间吗？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "虽然很多时候为了尊严，大家伙都是一对一的，但本身祭典唯一的规则就是无论用什么手段，谁能赢到最后谁就是大酋长。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "带小弟当然是最简单有效的办法了。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "无论什么手段？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "博士，你该不会也想上吧，我建议你放弃。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "啊，博士，你现在肯定在想些坏事吧。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "听起来我也可以当酋长。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "哈哈哈，博士，很遗憾，你不行的。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "我说的无论用什么手段，可不是博士你想的那些。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "我们这里的人很单纯的，不管干啥，也只会想到带很多人一起上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "拐弯抹角的阴险招数在这里可没人会用。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "老实说，就算是我在罗德岛呆了好几年，我也不擅长去搞那些小心思。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "嗯，而且群殴也是有风险的呢。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "哈哈，没错，打完之后自己闹内讧的事可不少见。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "而且另一方面，说是说所有手段都可以用，但是博士你可以真的试一试用你的手段解决其他人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "我保证最后是你会被群殴。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "别把人说得那么坏。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "哈哈哈，我只是实话实说。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "哈哈，能看到博士你翻白眼的样子可真少见。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "民风淳朴啊。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "是啊，我也是出去了才知道，原来我的家乡这么淳朴。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "以前我可是觉得，所有地方的人都是一样的。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "虽然我觉得博士你能做到让所有人都察觉不到是你做的，但是，博士，你知道决定性的差异在哪里吗？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "肌肉？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "没错！你看起来就很弱啊。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "喂，博士，别赌气不听我说话嘛！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "嘉维尔",
              "text": "是可以这么说，毕竟博士你看起来就弱不禁风的样子。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "外表？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "总之呢，说白了，想要当上大酋长，其实只有一个条件。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "那就是——够强，拳头够硬，够能打！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "对吧，特米米？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "诶，嗯，嗯！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "不过真是怪了，我记得这两个人可不是什么好朋友，他们居然会联手。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "唔唔，大概是在嘉维尔你离开后关系变好了吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "好吧，也有可能。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嗯？特米米，你不是说祖玛玛也是部族族长吗，她的小弟呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "咦，这么一说，确实呢，好像没有看到多少她的部族的人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "你看那边，那些穿着不太一样的就是。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "咦，那些人装备还挺不错的，不过人确实少。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嘿，这家伙，难道打算学我一个人把所有人打趴下吗，有意思！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "这么一说，特米米，你不是也要参加吗？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "诶，嗯，还不急。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "祖玛玛很厉害，刀疤族肯定打不过她的，先等她被消耗体力我再上。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "嚯嚯，变聪明了啊，特米米。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "特米米",
          "text": "诶嘿嘿，我也是认真想要当上大酋长的！然后......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "然后？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "嘉维尔",
          "text": "哦，等会儿再说吧，开打了！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
