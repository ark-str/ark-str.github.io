{
  "server": "cn",
  "storyId": "main_12_level_main_12-14_beg",
  "groupId": "main_12",
  "stageId": "main_12-14",
  "title": "天边的火烧云",
  "storyCode": "12-16",
  "avgTag": "行动前",
  "sourcePath": "vendor/ArknightsData/cn/gamedata/story/obt/main/level_main_12-14_beg.txt",
  "sourceHash": "ce1b9de8f036799a599c6c90b0bdeeab29b72abd31c4ffb3e97594c842c6f4c5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这就是......飞空艇。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "我们所有的潜入计划都失败了，靠近的人就像凭空消失了一样。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "这是某种萨卡兹巫术吗，魔王？你应当知道该如何破解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "我......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "特蕾西娅小姐......她也在这里吗？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "可我感受不到——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一股沉重的压力袭来。\n它无法被描述，它无法被言说，那么浓重，那么残酷。\n阿米娅几乎无法站稳。"
    },
    {
      "type": "dialogue",
      "speakerName": "阿米娅",
      "text": "这是......什么......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "你在做什么，魔王？别想搞什么小动作！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "使用你的那些巫术，帮我们破解它！否则的话——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "“灰礼帽”",
      "text": "唔——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你来了，阿斯卡纶。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "博士，我来晚了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "阿斯卡纶，别激动。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "这位同事的行为与我无关！我劝过他，可他不愿意听！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "我无意伤害你们的博士，我们只是在完成交易，那时候你也是见证人。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "那就滚开。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "怎么了？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "你的表情很难看。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "你感受不到，你不是萨卡兹。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "我们......在面对自己的历史。在面对萨卡兹千万年的苦难。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "它在诉说，它在愤怒，它强迫我们每个人聆听它的悲号。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "......怪不得。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "哼，大公爵们要失望了，这并非什么可被复制的工业技术。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "这艘船，是一位死魂灵。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "呜——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我......这些声音......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "阿米娅，别被它影响！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "坚持住，这只是幻象！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我明白，我在尝试......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "呜呜——啊——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "这里的影子......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "不对，这不是和那位伊内丝小姐类似的操纵阴影的源石技艺，这是什么？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "博士，离开飞空艇的影子！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "飞空艇的阴影蠕动着，延展着，被阿斯卡纶击倒在地的另一名“灰礼帽”瞬间淹没在漆黑的海洋中。"
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "开什么玩笑，这到底是什么......",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "深重的黑色，深重的绝望，深重的愤怒。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "死魂灵......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我看到了......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "别去看，阿米娅，那是死魂灵的巫术！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我看到了泪水。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "死魂灵，我看到了如此沉重的悲伤。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "您一直与这些悲伤在一起吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "您用愤怒的火焰灼烧伤口。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "这......很痛苦。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "阿斯卡纶踉跄了几步。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "你没事吧，阿斯卡纶？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "我......还好......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "阿米娅她——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "死魂灵巨大的阴影里，阿米娅仍然昂着头。\n在这个角度，看不到阿米娅的表情，唯一能知道的是，她仍昂着头。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "您说得对，死魂灵。我应该去看，我看见了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我看见了这一切。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我看见了那三千四百二十一次毁灭，我看见了每一片砖瓦化为灰烬。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我看见了每一位魔王的反抗，我看见了他们每一个人的心。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我看到了那些被吞咽的泪水和鲜血，我看到了那些被高扬起的尘土和碎片。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......如此相似的身影交叠着倒下，如此相似的场景反复上演。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我看到了，我仍然选择去看，我还会继续看下去。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "死魂灵，我没有一刻移开目光。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我会牢牢记住。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我会记住每一次艰难的选择，每一次的死亡与牺牲，每一次的毁灭，每一次的希望。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "可我已经在努力——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "可是，我一定不会——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "特蕾西娅小姐希望我能成为......！她说，就算是异族，我们依然会感同身受！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "阿米娅突然发现自己无法说出一个字。\n她为什么要阻止这场战争？\n在看了这些愤恨，这些痛苦，这些渴求之后。\n她为什么要阻止这场战争？\n这......这场战争，对于萨卡兹而言，确实是唯一的方法。\n每一个萨卡兹，在面对了这一切之后，都无法得出其他答案。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "可是......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "阿米娅发现了，有一瞬间，她理解了特蕾西娅现在的选择。\n用泪水湮没泪水，用苦难填埋苦难。\n只有焚毁的土地才能给萨卡兹带来新生。"
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "可是......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......我仍拒绝这条路。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "所以，死魂灵说的是对的。\n正因为她拒绝，所以她永远无法真正与他们站在一起。\n她可以抽身而出。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "阴影狂乱地抖动分裂着，简直要化为实体。\n死魂灵混乱的投影正在这座空旷的船坞中析出。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "真是个大家伙。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "紫色的火焰撞上了黑色的阴影。"
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "我对你们的存在很感兴趣，死魂灵。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "若是你被灼烧，会留下什么样子的余火呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "那条德拉克......爱布拉娜。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "任务简报里可没说过她会亲自出现在这里！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“灰礼帽”",
          "text": "走！快走！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "阿米娅！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我......我没事......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "来，我扶着你。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "博士，我......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "我确实没办法，真正和他们站在一起......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "也许，正因为这样，才必须是你。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "阿米娅",
          "text": "......欸？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "那条德拉克的火烧过来了！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "阿斯卡纶",
          "text": "她......很强大。我们没必要在这里对抗她！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "哼——有意思。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "罗德岛......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "我最近，是不是经常听到这个名字？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "王庭军士兵",
          "text": "将......将军，那条德拉克......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "不用理会。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "她的那些火焰，除了自己狭隘的野心，什么都点不燃。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "死魂灵阁下，请您带领我们离开这里。这狭小的船坞容纳不下您的愤怒，这些聒噪的异族也不值得浪费您的时间。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "曼弗雷德",
          "text": "我收到了摄政王的消息，他已经准备好了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "殿下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "萨卡兹的飞空艇已经升空，正在缓慢地向伦蒂尼姆方向转向。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "我们的高速战舰编队已经在外围做好了拦截准备。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "......也有其他部队正在集结。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "哦？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "温德米尔公爵的舰队在更早之前就接近了这个地块，开斯特公爵的军舰也在蠢蠢欲动，恐怕很快也会接近。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "看来大家都很关心这里。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "真的关心吗？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "考伯特",
          "text": "是不是各位公爵来得有些太迟了呢？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "你是......那个酒店的大堂经理？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "你怎么会在这里？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "“校官”",
          "text": "......你是萨卡兹早就安插在伦蒂尼姆的间谍？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "考伯特",
          "text": "不，考伯特只是个普通的自认是个维多利亚人的萨卡兹清洁员罢了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "那么你呢？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "我们......？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "和朋友正聊到兴头上，却被派出来干活的可怜人罢了。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "德拉克，你还真是扫兴。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "爱布拉娜",
          "text": "那么，不如和我聊聊怎么样？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "......饶了我们吧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "变形者集群",
          "text": "不如让我们尽快结束这一切。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
