{
  "server": "cn",
  "storyId": "story_kirara_set_2_story_1",
  "groupId": "story_kirara_set_2",
  "stageId": null,
  "title": "无伤通关",
  "storyCode": null,
  "avgTag": "幕间",
  "sourcePath": "vendor/ArknightsGamedata/cn/gamedata/story/obt/memory/story_kirara_2_1.txt",
  "sourceHash": "8e9217afa88a583c7f41f627df2eeb5790ecdff2e0820e5c993b74728c97c794",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "她们怎么样了？"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "那个领队的姑娘被那群强盗从背后砍了一刀，现在还昏着。"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "那么多人偷袭人家一个，没种的东西！"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "那、那我们现在怎么办？"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "你问怎么办？那群混账要抢的是我们的药，那他们就是要我们的命！"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "大不了我和他们拼了！我也能用法术......"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "他们那都是骗人的！我们连想点个火都不成，就算想拼命，也拼不过啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "拼不过也得拼！难道要把我们好不容易买到的药，就这么让那群杀千刀的抢去？"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "我们费了多大功夫才买到这么一批便宜的抑制药！要是没有这些，你，我，村子里的其他人，你看看我们还能带着身上的破石头活几天！"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "况且，还有罗德岛的人在......"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "但是，罗德岛只是送药来！"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "你搞清楚，药送到我们手上了，她们随时都能走，她们不会帮我们的！"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "就算她们真的留下......就连那个能轻松对付野兽的领队都伤成那样，剩下那几个小姑娘，能成什么事？"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "那群强盗没抢到东西，肯定不会善罢甘休，说不准他们马上就要打过来了！"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "与其大家一起完蛋，还不如他们想要什么就给他们什么，我们、我们总能再想办法！"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "仔细想想，这个什么罗德岛，他们的药卖得这么便宜，谁知道是真是假......"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "够了！你少说两句！"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "呃。"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "那几个送药来的姑娘帮我们赶走附近野兽的时候，那个医生姑娘帮你做检查的时候，你可没说过这种混账话！"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "我们才付了多少钱，值得人家特地送药过来，还带了个医生来给我们免费看病？"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "这个罗德岛都能做到这个地步，就算这药真不起效，我也认了！"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "......那你说，我们真的能守住这些药吗......"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "......总要试试。"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "行了，我还要去给罗德岛的人帮忙，你也给自己找点事做。"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "好吧。早上有个姑娘拜托我帮忙，还差一点才完成，我去喊上其他人一起......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（不妙。再这么下去不妙啊。）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（队长受伤未恢复，治疗也需要一段时间，现在只剩下一个输出职业和我这种派不上太大用场的辅助角色......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（啊，不对，不行。不能在这么严肃的场合用游戏思维。）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（但是......确实难办。难办了......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "唉。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "叹什么气呢？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "哇啊！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "呼，什么啊，是宴啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "是我。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（下次麻烦别一声不吭出现在别人背后，很吓人欸。）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（忍者吗你......）"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "吓到你了？抱歉啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "不过我可不是什么忍者。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "啊？欸？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（为什么会知道我在想什么......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（莫非是......读心术？！）"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "也没有什么超能力哦，你的表情，太明显啦。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（......骗人，真的能猜到？）"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "真的真的。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（好方便，可以不用说话了。）"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "哎，慢着。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "绮良同学，“对话”还是需要把心里想的说出来才成立的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "还是说你是想让我一直紧盯着你不放？嗯？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "好啦，不开玩笑了。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "我要去看看赤冬的情况，一会再聊~"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "等一下，宴！"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "嗯？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "我也和你一起去。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "那个啊，宴......你觉得我们现在的情况如何？"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "嗯......挺糟糕的吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "本以为只是普通的送货任务，我们这边也没做太多准备。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "虽然是配好了小队......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "但我们的战斗主力队长小姐不慎被暗算了。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "哈......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "笑不出来。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "一般的强盗其实完全不是我的对手哦，不过他们人数太多，我一个人还是有点应付不来。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "医生小姐不参加战斗，至于绮良你嘛......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "别看我，我是后勤技术人员。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "啊，是吗？总感觉我认识的技术人员都还挺能打的。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "而且，我记得你不是挺擅长那种战略游戏吗？上回还和博士一起刷新了什么纪录来着？这么看，说不定你也会很适合当指挥官。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "怎么样，要不要试试看？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "我？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "别开玩笑了，现实可不是游戏，我......我不行的。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "快点去看看赤冬的情况吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "唔......随便否定自己可不好。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "而且，明明应该是有什么想法了吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "不诚实哦，绮良同学。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "伤口没有大碍，消炎药也已经用过了。"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "虽然现在还没有醒来，但只要不再发热，好好静养的话，后续应该不会有什么危险。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "是吗......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "那太好了。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "不过，我们的队长小姐还要睡多久？"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "这就要看赤冬小姐自身的体质了。虽然已经尽力治疗，但当时的伤口很深......"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "就算能醒来，也没办法立刻继续作战吧......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "嗯？搞不好可以？"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓&绮良",
      "speakerId": "avg_449_glider_1",
      "text": "不可以！"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "唉......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "我之前放出的侦测设备显示，那伙强盗一直没有离开这附近。虽然我已经联系了在附近的小队，但他们赶过来也需要时间。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "如果强盗趁现在进攻，我们恐怕......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "恐怕就都完蛋了。"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "那现在怎么办？是不是先带着队长小姐撤退比较好？"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "可是，我们离开的话，这里的感染者该怎么办？"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "虽说把药送到，我们的任务就完成了，但我做不到就这样把村里的人丢下不管......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "嗯......我们把药也一起带走？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "先不提对方会不会相信，我觉得那些强盗要抢的可不止是药。这里的人对上强盗，完全没有还手之力欸。"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "确实......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "那个啊......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "其实，我觉得我们可以——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "打扰了，我给你们拿了点吃食过来......"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "小地方没什么好东西，几位将就着吃点吧。"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "谢谢，我们不要紧。之前的袭击，村里有没有人受伤？"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "多亏了几位小姐，我们都没事。"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "这位队长阁下的伤势......"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "不用担心，已经没有危险了。"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "啊，啊，那真是太好了......！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "对了，还有这个。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "这是小姐们要的，这附近的地形图......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "嗯？地形图？我没听说过这回事。"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "也不是我要的......难道是赤冬小姐之前拜托的吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......是我。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "谢谢。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "道谢的声音几不可闻。\n自村民进入屋内就一直保持沉默的女孩像是急着逃避众人视线一般，低头将目光投向接到手里的几张图。\n由在荒野上建起村落的感染者们亲手绘制的图片，粗糙简陋，有些甚至只画了几笔抽象的线条来示意，并不能真正称得上是地形图。\n想要从这样的图上汲取正确的信息并不容易。\n而紧捏着图纸的东国女孩，却像是一个真正经验丰富的老手一样，快速地翻动着手中的纸张。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "唔......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（地形很平坦，对我们这边很不利。）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（不过也不是没有可以利用的地方......比如说这里，如果能在这边做一些布置的话......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（方案是可行的，但是......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "怎么样，看出什么了吗？"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "我说，绮良同学~看你的样子，你应该有什么点子了吧？"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "什么？！真的吗？小姑娘你......不对！小姐你有办法了吗？！"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "我、我......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......我觉得我们......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "呃......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无聊的男生",
      "speakerId": null,
      "text": "她到底想说什么？结结巴巴的，说不出来就赶快下台。"
    },
    {
      "type": "dialogue",
      "speakerName": "无聊的男生",
      "speakerId": null,
      "text": "真是浪费时间......就她这个音量谁听得清啊！"
    },
    {
      "type": "dialogue",
      "speakerName": "刻薄的女生",
      "speakerId": null,
      "text": "就是说啊，听说她初中的时候缺勤到差点留级欸，完全不来上课，大家都猜测可能是犯了什么事，被学校停学了呢。"
    },
    {
      "type": "dialogue",
      "speakerName": "刻薄的女生",
      "speakerId": null,
      "text": "嘻，好像还喜欢那种塑料小人哦，在家里不会偷偷干什么下流的事情吧？哇......真糟糕。"
    },
    {
      "type": "dialogue",
      "speakerName": "八卦的学生",
      "speakerId": null,
      "text": "她的名字也太不适合她了吧？本来还以为会是更闪亮一点的美少女，结果感觉是很阴沉的人嘛，真扫兴。"
    },
    {
      "type": "dialogue",
      "speakerName": "八卦的学生",
      "speakerId": null,
      "text": "脸？她都不怎么抬头，谁知道脸长得怎么样啊......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "忧虑的教师",
      "speakerId": null,
      "text": "云母同学，学校认为不能再容许你像初中那样缺席课程了。"
    },
    {
      "type": "dialogue",
      "speakerName": "忧虑的教师",
      "speakerId": null,
      "text": "如果你还是没有办法适应校园生活，我们可能会考虑与你的家长交流一下，关于留级，甚至是退学的问题......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "不行......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "我、我不......不知道......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（喘不上气......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（我在干什么啊？快点好好说话啊，这里又不是学校......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "呃，啊......我想说的是——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "不、不好了！！"
    },
    {
      "type": "dialogue",
      "speakerName": "紧张的感染者",
      "speakerId": "avg_npc_005",
      "text": "强盗！强盗又来了！他们围在村口，还打伤了人......"
    },
    {
      "type": "dialogue",
      "speakerName": "急躁的感染者",
      "speakerId": "avg_npc_001",
      "text": "什么？！"
    },
    {
      "type": "dialogue",
      "speakerName": "蜜莓",
      "speakerId": "avg_449_glider_1",
      "text": "有人受伤？在哪里，麻烦你立刻带我过去！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "没办法了，我也一起去吧。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "喂，绮良。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "宴",
      "speakerId": "char_337_utage",
      "text": "不要让大家等太久哦。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（宴那家伙，说得好像很懂的样子。）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（什么啊，我自己都还没搞懂呢......）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（不行，不能就在这傻站着，总之得做点什么才行！）"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_478_kirara_1",
      "text": "疼......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "噫！"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_478_kirara_1",
      "text": "别大惊小怪的。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "嘶......疼疼疼，扯到伤口了。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "赤冬你醒了？！"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "伤口怎么样，感觉还好吗？不不不不要乱动啦！快点躺下！"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "你快躺回去，我现在就去喊蜜莓过来——"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "回来，不用喊人！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "我还撑得住......其实刚才我就醒了，刚刚你们说的我都听见了，只不过身体有点不听使唤，问题不大。"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "那群偷袭我的混账自己送上门最好！看我砍了他们！"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "唔！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "啧......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "问题很大！！"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "别乱来了！哇啊啊伤口又渗血了......别动，把刀放下！"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "你现在的状态根本不能战斗啊！你以为你是什么格斗游戏主人公，只要血条不空就不影响行动吗，啊？？"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "......嘁，你这不是挺能说的嘛。"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "那你说怎么办，我不去的话，宴那边恐怕撑不住。"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "还是说你有什么办法？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "我、我想了一些，但是我......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "我觉得不行......"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "你这家伙，到底在害怕什么啊？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "什么？我没有......"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "你有。"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "有想法就直说，行不行作为队长的我会判断！"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "凭什么说自己不行？这次队员可是我亲自挑的，你这是在说我的眼光不行？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "等等，我不是我没有......你这是强词夺理！"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "啊，没错。怎么，你有意见就说出来让我听听啊。"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（唔唔唔——）"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "（怎么回事啊这个人——！）"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "我看你不是挺会制定策略的嘛，在这方面，我可一次都没赢过你！"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "但那是游戏......"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "都差不多，我记得你不是还和博士那家伙讨论过战术指挥？"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "可是那也是游戏的话题啊......！"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "现实能用的博士也教了你不少吧！"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "少磨磨叽叽的！爽快点！一句话，干不干？"
    },
    {
      "type": "dialogue",
      "speakerName": "赤冬",
      "speakerId": "avg_475_akafyu_1",
      "text": "都说了做判断的人是我！现在我就是你的大将，你是我的军师，还不快快献计！"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "绮良",
      "speakerId": "avg_478_kirara_1",
      "text": "呼......哈......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "无聊的男生",
      "speakerId": null,
      "text": "她到底......什......结结巴巴......"
    },
    {
      "type": "dialogue",
      "speakerName": "无聊的男生",
      "speakerId": null,
      "text": "............听得清......"
    },
    {
      "type": "dialogue",
      "speakerName": "刻薄的女生",
      "speakerId": null,
      "text": "......缺勤............犯了什么事......"
    },
    {
      "type": "dialogue",
      "speakerName": "刻薄的女生",
      "speakerId": null,
      "text": "......喜欢那种..................偷偷......"
    },
    {
      "type": "dialogue",
      "speakerName": "八卦的学生",
      "speakerId": null,
      "text": "......太不适合............感觉是很阴沉......扫兴......"
