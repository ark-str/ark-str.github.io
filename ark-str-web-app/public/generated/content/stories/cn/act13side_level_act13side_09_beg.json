      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "烛骑士",
      "speakerId": "avg_npc_215_1",
      "isRemote": false,
      "text": "......这就是卡西米尔感染者的英雄，玛嘉烈。"
