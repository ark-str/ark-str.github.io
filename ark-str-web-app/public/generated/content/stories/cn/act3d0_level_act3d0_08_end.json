  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "小心！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "喝！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "哼！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "它真的有在变虚弱吗？这模样完全看不出来啊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "小心岩浆！这家伙肚子里到底吞下了多少黑曜石！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨大源石虫",
      "text": "————————————————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "虽然有些可怜，但我们也不能手下留情！天火！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "好啦，我明白！现在可不是保留实力的时候了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "那么，这招如何！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巨大源石虫",
      "text": "————————！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "熔岩虫被激怒了......！我去挡住它们，攻击就交给你们！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "大尾巴！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "总算能从岩浆的缝隙里瞄准弱点了呐，但是对方这个尺寸，我可不保证能有效喔！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巨大源石虫",
      "text": "——————！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "成功了！它被赶回之前的方向了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "太好了！这样一来，市民们就都彻底安全了！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "真是的！没想到解决一只虫子会这么费劲！这下我的裙子也毁了......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "毕竟它带领着一整支族群。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "如果不是有人先破坏了它们的生存环境，也许......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我累了！不要再提起这种让人疲惫的话题！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "哈哈，我也已经，累得快站不起来了呢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "但是，我们得回到汐斯塔，还有人在等我们......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "唔！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "倒是能理解你的想法啦，不过站不稳的时候找同伴搭把手，也是成熟的女性应该学会的事情喔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "锡兰",
      "text": "谢、谢谢。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "好了，凯旋而归总是令人心情愉悦。赶紧回去吧，说不定还能剩下点度假时间。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "......但是......这里还是迟早会......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "大尾巴？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "啊，我这就来。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "普罗旺斯",
      "text": "......天火。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "我知道。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天火",
      "text": "但我们应该尊重这座城市的选择，剩下的不该由我们插手，不是吗？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
