{
  "server": "jp",
  "storyId": "story_astesi_set_2_story_1",
  "groupId": "story_astesi_set_2",
  "stageId": null,
  "title": "再び輝くために",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_astesi_2_1.txt",
  "sourceHash": "efcbe8d7dd00f43edd401e2fd9c0863f72cd3a1c7c78b81c9ba1af31382b5aa7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "クルビア トリマウンツ"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "関連項目は一通り直したから、もう修正する箇所はないはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ありがとう、ジーニ。手伝ってくれて助かったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ううん、平気。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "大したことはしてないしね。ただベースとなるデータモデルを提供したついでにちょっと調節しただけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "具体的な内容も構成も、全部姉さんが考えたでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "だけど、ジーニがいてくれたおかげで、ここまで内容を突き詰められたのよ。はあ……占星術研究会のシンポジウムまで、もうあと一週間ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "トリマウンツの上空に空いた穴のせいで、面倒事がたくさん増えてそうだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "うちには特に影響はないんじゃないかしら。お父様もお母様も、根拠のない空想話には興味ない人たちだもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "はあ……二人がトリマウンツに来てからしばらく経つけど、ここしばらくは執筆作業を優先していたから、まだ会いにいけてないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ジーニは二人に会いたい？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "いや、まったく。姉さん以外のウビカの人間に会うと頭が痛くなるしね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "そういえば、姉さんが今書いてるその……研究まとめ？　何に使う予定なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "発表したら、学会に無償で提供しようかと思って。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "トリマウンツの穴の外に広がる星空は、通常のものとは全く異なる法則性を持っているみたいなの。だけど、あの大きさの穴じゃ、全ての星を観測することはできない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "でも私たちが作った変換モデルがあれば、研究者たちはそれぞれの星空に存在する星座の大まかな座標を導き出すことができる、そうすれば、互いの運動法則と相関関係をシミュレートできるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "きっと今後の星空の研究に役に立つはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さんらしいや。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "そういえば、前に穴が空いた星空が、占星術に新たな可能性をもたらしたって言ってたよね。トリマウンツでの目的はもう達成できたんだし……私の今日の運勢を占ってみてよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "あら、いつの間にかまた占星術に興味が出てきたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ただちょっと気になっただけだよ。だからお願い、姉さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "分かったわよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "(考え込む）"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（ぶつぶつとつぶやく）"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（天球儀を掲げる）"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "どう？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "星占いの結果が……今までのパターンと違う……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "「今日はリーベリにとっての厄日となるであろう。」"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "星たちからのメッセージはこれだけよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "以前はもっと具体的なメッセージをもらえたはずなのに、おかしいわね……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "なんだか不吉な結果だね……まあ、別にいっか。思いつきで占ってもらっただけだし。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "前に姉さんが占ってくれた時、大きな災いが降りかかるなんて言われたけど、結局何も起こらなかったでしょ。だから気にする必要なんてないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "朝ごはんはもう食べた？　コーヒーを淹れてくるね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ええ、ありがとう、ジーニ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "あっ、はーい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "配達員",
      "speakerId": null,
      "text": "こんにちは、アステシア・ウビカさんでいらっしゃいますね？　依頼されていた書類の集荷に伺いました。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ありがとう、お願いしたいのはこれよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "配達員",
      "speakerId": null,
      "text": "はい、お預かりいたします。念のために確認をお願いいたします。お届け先はこちらの住所にお住まいの、フランソワ・ウビカさんで間違いないでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ええ、本日中に届けてもらうことはできるかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "配達員",
      "speakerId": null,
      "text": "市内配達ですし、速達料金もいただいておりますので、トラブルが起こらない限りは本日着となります。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "よかった、ありがとう。"
    },
    {
      "type": "dialogue",
      "speakerName": "配達員",
      "speakerId": null,
      "text": "いえ、当然のことですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "配達員",
      "speakerId": null,
      "text": "それでは、よい一日を。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "今誰か来てた？　隣に住んでるヴィクトリア人のおばあさん？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "エヴァンスさんのこと？　違うわ、宅配の配達員よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "お父様に届ける原稿を取りに来てもらったの。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "えっ？　姉さん……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "…………"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "自分が何をしてるのか、分かってるの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "いきなりどうしたの、ジーニ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "何回も言ったよね！？　あの人に論文を渡したら、自分の名前を姉さんの名前の前に書いちゃうよって。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "お父様をそんなふうに言うのはよくわないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "よくない？　ハハ、なら教えてよ。今まで姉さんの名前だけで発表された論文って、一つでもあった？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "わ、私はただ、重要な内容の論文だから、お父様のような専門家に目を通しておいてほしいと思っただけで……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "あっそう。じゃあ、そういうことにしといてあげるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "でも、それだったら懸念点をまとめたものを見てもらうだけでいいんじゃないの？　どうして原稿のコピーを丸ごと送ったの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "あの人、絶対に占星術研究協会のシンポジウムで姉さんの書いた論文を自分の研究内容として発表するよ、断言してもいい。そして、私と姉さんは今回の研究の部外者になっちゃうの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "でも、ウビカ家の栄誉であることに変わりはないわ。当主であるお父様の口から発表されるなら、別にそれでいいと思うのだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "私はいやなの！"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "どうして私があんなに必死に家から逃げ出したのか分かる？　あの人の顔色をうかがったり、言いなりになって生きるのがいやだったからだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "なのに、私たちが数ヶ月も努力して完成させた成果を、姉さんはただ「目を通してもらいたいから」という理由だけで、あの人に渡しちゃうんだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "いやな言い方をするけど、あの中には私の研究成果もあるよね。　それなら送る前に、私に許可を取るべきだったんじゃないの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "そこまでは考えてなかったの――"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "考えてなかった？　几帳面な姉さんが、こんなことにも気づけないなんてあり得るかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "本当よ、ジーニ。それに、あなたは少し大げさに考えすぎだわ。ウビカ家は大家族なのよ。このような重要な論文なら、お父様だってきっと一族の名義として発表するはずだわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "それに、私の今までの論文だって、お父様が何度も目を通して添削までしてくれたわ。名前を私の前に載せることだって、メリットとデメリットを説明してくれたうえで、私が同意したからなの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "そうでしょうね。姉さんのためだって綺麗ごとを並べられて、ついでに口先だけの約束をするだけで、コロッと信じちゃうもんね、姉さんは。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "口の利き方に気をつけなさい、エレナ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "アハハ、気づいてる？　今の話し方、私を叱る時の父さんと全く同じだね、アステシア。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "私はただシンポジウムを成功させたいだけなの。だから、根拠のない想像で物事を言うはやめてちょうだい、ね？　ちゃんとうまくやるから、信じて。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "あの人に反対意見なんて言えたこともないくせに、どうやって信じればいいの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "もういい。これ以上話しても意味なんてないよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "どこへ行くの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ライン生命に戻る。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ジーニ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "あれ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "これ……ジーニの通信機だわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "アステシアさん、どうされましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ライン生命の職員居住エリアはどう行けばいいのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "誰かをお探しですか？　在職中の職員でしたら、受付けから宿舎かオフィスに電話をかけて呼び出しましょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "それなら、エネルギー課の研究員エレナ・ウビカに繋いでくれるかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "はい、少々お待ちください……"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "すみません、お探しの相手はエレナ・ウビカさんでお間違いないですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ええ、どうしたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "それが……ウビカさんは派遣申請を出した際に、職員用宿舎からも退去されているようでして……"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "現在、ライン生命に彼女の居住記録はありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "それなら……今日ここには来ているの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "大変失礼ですが、お答えする前に、念のために身分を照合させていただいてもよろしいでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ええ、もちろん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "文献学顧問としてここに派遣されている、アステシア・ウビカよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（身分証明書を渡す）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "……確かに確認いたしました。今お調べしますので、少々お待ちください。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "申し訳ございません。本日、エレナ・ウビカさんがライン生命の施設にいらした記録はないようです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "こっちに来ていないってこと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "そのようですね。"
    },
    {
      "type": "narration",
      "text": "不吉な予感がアステシアの脳裏をよぎった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（「今日はリーベリにとっての厄日となるであろう。」）"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "！"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命受付",
      "speakerId": null,
      "text": "他に何かお手伝いできることはございますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "いえ、もう大丈夫よ。ありがとう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（悪い方向に考えるのはやめよう。きっと大丈夫だから。）"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（あの子はただ、今通信機を持ってないせいで、連絡が取れないだけよ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（きっとトリマウンツの街をブラブラしているだけだわ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（確か、保安局はこっちだったわよね。）"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（まずはあの子を見つけないと……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "すみませ――"
    },
    {
      "type": "narration",
      "text": "だがアステシアは結局、喉元まで出かかった言葉を無理やり呑み込んだ。\nある可能性が頭に浮かんだから。\n現在このトリマウンツには占星学者たちが集まっており、彼女の父はその中でも一目置かれる存在である。\nもしこんなタイミングで、反抗的な娘から距離を置かれ、連絡も途絶えていることをマスコミに知られてしまったら？\n絶好のゴシップ記事になるのは確実だろう。\nそうなれば、一族にとっても、両親にとっても、妹にとっても、いらぬトラブルを招くことになってしまう。\nだから――\n彼女は保安局の前を素通りすることを選んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（こんな情けなくて、役立たずの姉でごめんなさい、ジーニ。）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（もっと考えるのよ。きっと何か方法があるはず……）"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "おい、避けろ！！　車が暴走してる！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "（他にジーニの居場所を知ってそうな人は……）"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "わああああああ！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "えっ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "はぁ～、危なかった……大丈夫？　ケガはない？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "あっ、すみません、さっきはぼうっとしてて。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "……って、ジュナーさん？　どうしてここに？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "見覚えのある後ろ姿だなと思ったけど、やっぱりアステシアだったのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "真昼間から車に突っ込まれるなんて、ツイてないわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "まあ、ツイてないのはあの運転手も同じか。大方、どっかの部品が壊れて暴走しちゃったんだろうし。がんばって避けようとしてたのに、結局は人を轢きかけたし。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "運転手の方は大丈夫かしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "最後の最後でなんとかブレーキは効いたみたいだけど、車はひっくり返っちゃったみたいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "運転手は……よかった、無事よ。車の横に座って電話をかけてる。自力で車から這い出せたのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "確かにジュナーさんの言う通り、本当にツイていないわ。もしロドスだったら……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ロドス？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "そうよ、ロドスの力を借りればいいじゃない！"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ジュナーさん、少しお時間いいかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "えっ……大丈夫だけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ロドスに頼みたいことがあるの。ジュナーさんから話を通してもらうことはできる？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "こんなところで長話もなんだし、詳しいことはトリマウンツの事務所で聞かせて。さあ、行きましょう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "はい、お水どうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ありがとう……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "話を聞く限り、単純に姉妹ゲンカでカッとなって飛び出して行っただけのことだと思うけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "それだけじゃないわ。今日の星占いでよくない結果が出たのよ。あの子、きっと何かのトラブルに巻き込まれているんだわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "トラブルに巻き込まれたのはあなたの方でしょう？　さっきも車に轢かれかけたし。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "私のことはいいの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "あなたって、たまにすっごく強情だよね……うちの誰かさんとそっくりだわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "それって、ジュナーさんのお姉さんのこと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "妹よ、生まれた順番ではね。私がトリマウンツに来たのも、妹があのペテン……じゃなくて占星学者たちとビジネスをするからよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "予備隊のオペレーターたちもほとんどが休暇に入ってるし、時間を持て余すくらいなら、何か手伝おうかと思ってね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "そうだったの……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "妹さんとの仲はどう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "悪くはないかな。たまに口うるさいなって思うことはあるけどね。私に相談もなしに、あれこれ世話を焼いてこようとするし。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "その……ジュナーさんのほうがお姉さんなのに？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "だから生まれた順では妹だって言ったの。実際の関係では、向こうが姉みたいなものよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "父が亡くなってから、かえって家業の景気が良くなったのも、妹が大黒柱となって支えてくれたおかげなの。なのに、姉である私は何の役にも立てていないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "そんな！　生き残るための術を教えてくれるジュナーさんには、私たちみんな感謝しているわ。最初に会った時、ジュナーさんに一撃で吹き飛ばされたこと、今でもまだ覚えているもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "あの頃は、私もロドスに入ったばかりだったのよ。手合わせであなたが剣を振りかざすだけで、全然攻めてこないからつい……はあ、もうこの話はおしまいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "トリマウンツ事務所に、アステジーニを探すのを手伝ってほしいんでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "何人か手の空いている偵察オペレーターがいるから、妹さんが行きそうな場所を教えてあげて。喜んで手伝ってくれるはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "大事にしたくないのなら、内密に依頼をしてもいいわね。ここのオペレーターとは仲がいいほうだから、私も取りまとめを手伝ってあげられるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ありがとう……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "気にしないで。どの家庭にもそれぞれの事情があるんだから。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "みんなに依頼内容のメールを送ったわ。残りの場所は私たちで探しましょう。もしかしたら何か見つかるかもしれないしね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "そ、そうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "大丈夫、誰かがケガするようなことは起こらないわよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "アステジーニってかくれんぼが上手なのね。公共エリアはほとんど探したはずなのに、まだ見つからないなんて。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "もう夜も遅いし、このまま探してもらちが明かないわ。家まで送っていくから、また明日探しましょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "私……もう少し探してみる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "でも、もうすぐ日付けが変わるわよ。占い結果では、ツイていないのは今日だけなんでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "帰って温かいご飯でも食べて、ちゃんと寝た方がいい。明日になれば運が向いてくるかもしれないじゃない？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "だから、今日はひとまず帰りましょ？　送っていってあげるから。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "いえ、大丈夫……今日一日本当にありがとう……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "じゃあ、私はもう行くね。バカな真似はしちゃダメよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ええ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュナー",
      "speakerId": null,
      "text": "明日の朝、家まで迎えにいくから。おやすみ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アステシアが帰路につく頃には、既にトリマウンツ上空に空いた穴から星々が顔をのぞかせていた。\nしかし、彼女はただ真っすぐ前を見据えたまま、曲がり角を一つまた一つと曲がっていく。\n時計の針が十二時を越えた頃、彼女は最後の角を曲がり、借りているマンションの前までやって来た。\nそして、そこには羽毛の塊が丸くなって縮こまっていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "おかえり、姉さん……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "カギ、忘れちゃって……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "えっ、姉さん？"
    },
    {
      "type": "narration",
      "text": "アステシアは何も言わずに、ただ妹に抱きつき、その懐でポロポロと泣き始めた。\n自分のこんな顔を妹に見せたくはないが、どうしても抑えることができなかったのだ。\nアステジーニもそのことをよく分かっていたから、ただただ姉を抱きしめ、涙で服が濡れるのに任せた。\nそうやって二人は互いに無言のまま、マンションの前で長い間抱きしめ合っていた。しばらくして気持ちが落ち着くと、アステシアはようやくカギを取り出し、部屋のドアを開けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "家に入った二人は、ソファーに向かい合って腰かけ、黙りこくっていた。\nだけど結局先に口を開いたのは姉の方だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ごめんなさい、ジーニ……私が悪かったわ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "悪かったのは私も同じだよ……原稿を父さんに送ったって聞いた瞬間に、頭に血が昇っちゃって、何も耳に入らなくなっちゃったの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "あなたが家を出るために、たくさんのものを犠牲にしたのは知っているわ。ジーニはもうお父様とは少しも関わりを持ちたくないことも。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "私のしたことは、間違いなくあなたを傷つける行為だわ。だけど、本当にわざとじゃないの……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "できあがった論文を権威のある指導教員に確認してもらうのは、普通のことだよ。私だって博士課程時代は、いつも指導担当の先生に論文を添削してもらったし。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ああもうっ、どう考えても悪いのは私だ。感情のコントロールなんて基本的なこともできないのに、何が博士よ。いつも姉さんのことを石頭だって言うくせに、結局一番の分からず屋は私の方だ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "私、決めたの。明日、お父様に会いに行くわ。論文の確認には時間がかかる。朝一に行けばきっとまだ読み終えていないはずよ。だからなんとか説得して原稿を返してもらう。まだチャンスはあるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "えっと……そのことなんだけどね……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "実は……原稿はあの人のところには届かなかったの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "えっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "原稿を取りに来たお兄さんはリーベリだったでしょ？　夕方にここに来て、平謝りで郵送料を返金してくれたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "あのお兄さん、かなり酷い目に遭ったみたい。せっかく朝一にあちこちから荷物を受け取ったのに、配達の車が暴走して横転しちゃったんだって。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "あっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "でも姉さんから速達で依頼された荷物があるからって、同僚に他の配達物を任せて、自分はすぐに自転車で原稿を届けにいったらしいの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "でもオフィス街に着いた時に雨が降り出して、タイヤが滑って荷物ごと人造湖にドボン。原稿も水に濡れてダメになっちゃったんだって。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "それでどうしようもなくなって、涙で顔をぐちゃぐちゃにしながら謝りに戻って来たんだよ。だから慰めて見送ってあげたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さんの占い、完璧に当たったね。今日は確かにリーベリにとっての厄日だった……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "もう昨日のことよ。だから忘れましょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ほら、あなたの通信機。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ありがとう、姉さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "あーあ、これもトリマウンツで勉強してた頃にできた悪い癖だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "スランプに陥ったり、誰かと言い争いになると、全部がどうでもよくなっちゃうの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "そうなると、電話もメールも来ないように通信機を放り出して、何も考えずにただトリマウンツをブラブラするんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "どうにもならない感情を、全部時間に解決してもらうためにね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "もちろん、今日みたいにカギを忘れちゃって、ルームメイトが帰ってくるまで宿舎の前で待つしかないこともたまにあったよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "もしかして、今日一日何も食べてないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "うん……外をブラブラしてた時は食欲がなかったし、帰ってきたらカギを忘れたせいで家に入れなくて、結局何も食べられなかった……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "じゃあ、ドアの外に置いてあった箱は？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さんへのお詫びに買ったアイス。でもこんな時間まで探し回ってくれるとは思わなくて、とっくに溶けちゃった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "じゃあ、お金は持ってたのよね？　どうして自分の分は買わなかったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さんへのアイスを買う分のお金しかなかったんだよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さん、お腹すいたよー……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "すぐに作るから、あともう少しの我慢よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "うん……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ジーニ、約束するわ。私たちの研究成果は、絶対に誰にも渡したりしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "お父様であっても、横取りする資格なんてない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "うん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さんを信じるよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一週間後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さん、発表用の原稿に一通り目を通したけど、問題なかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "私がリストアップした専門用語も全部暗記した？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ええ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "よかった。これで年寄りの古参学者たちに揚げ足を取られても、すぐに返り討ちにできるね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "でも今日の午後が発表だって言ってたのに、予定表には姉さんの名前は書かれてなかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "お隣のエヴァンスさんのこと、覚えてる？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "あのおばあさんでしょう？　どうしていきなりその人の名前を出したの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "エヴァンスさんはヴィクトリアの占星術の権威者よ。今日の午後は本来は彼女が発表する予定だったの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "でも、その機会を譲ってもらえるようにお願いしたのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "へぇー。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "いや、待って、姉さんも発表側に回るのなら、あの人のアシスタントがいなくならない？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "いいえ、そうはならないわ、ジーニ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "えっ……姉さん？　その目はなに？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "まさか……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "お父様にサプライズなんてどう？　いい子だった長女も、妹みたいに反抗的になったことを見せつけてやるの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ね？　お願い、ジーニ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "まさかずっと前から企んでたの？　だから占星術研究協会の詳しい話を、今日まで何も教えてくれなかったんだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ほら、こっちへおいで。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "わ、私、行きたくないんだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "逃げても何にもならないわ、ジーニ。これは正々堂々とお父様に挑めるチャンスなのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ほら、ゴーグルと装置を外して。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "上着とシャツも着替えなきゃね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さん、本気なの……？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "あなたの大好きなイタズラだと思えばいいわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ちょっと！　私、イタズラなんて好きだったこと一回もないよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "髪も降ろさないと……ほら、いい子だからじっとしてて。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さん、こんなのやり過ぎなんじゃ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "静かに。ほら、剣と天球儀をちゃんと持ってて。お化粧もしてあげるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "うん、完璧ね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア？",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "こんなの無理だよ、うまくいかないって。姉さん……一緒に他の方法を考えよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ごめんなさい、ジーニ。発表の時間まであと少ししかないの。他の方法を考える余裕なんてないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "私の喋り方を真似してみて。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "シア、や、やっぱりこんなことはよくないわよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "うわあああ、無理！　私にこんな話し方は無理だって！"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "すごくよかったわ。完璧よ、さすが私の自慢の妹ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "こんなのであの人を騙せるのかなぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "お父様を騙す必要はないの。ただ他の人の目をごまかせられれば十分よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "でも、私が姉さんの服を着ちゃったら、姉さんは何を着ていくの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "もちろん、フォーマルの場に最もふさわしい――"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "「星尋ね」よ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ふぅ、やっぱり身軽な服の方が着心地がいいや。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "どうだった？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "よく分かんなかったけど、ほとんど無意味な討論時間だった気がする……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さんの発表がなかったら、始まってすぐに帰ってたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "じゃあお父様の発表は？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "父さんね……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "確かにあの人は優秀な学者だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "伝統的観念こそ至上だって訴える人しかいない中、父さんは自ら進んで壇上に立ち、今起きている変化を認め、知識を更新する重要性を説いていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "石頭の年寄りたちに反論するする父さんの姿は、私たちの意見を一蹴する時の父さんとそっくりだったよ。少なくとも、あの人に裏表はない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "……だからといって、あの人がフェルディナンドと同様、救いようのないクズってことに変わりはないけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "じゃあ、お母様は？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "母さんは……いつもと同じ、彫像みたいに冷ややかな視線で会場にいる全員を見つめてた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "つまり、二人ともあなたの変装について特に何も言わなかったってこと？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "私を見た瞬間に方眉を上げて、それでおしまい。あいさつもなかったし、名前も呼ばれなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "たぶん、見た瞬間に私だってバレてたと思う。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ねぇ、もうこのつまんない話はやめにしようよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さんの発表、すごくよかったよ。最初から最後まで、ウビカの石頭二人からなんの反論もなかったし、他の人たちが揚げ足を取っても、姉さんがすぐに黙らせてた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "しかも、もう記者から取材もされたんだって？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ええ、ありふれたことを色々訊かれたわ。それよりも、外国から来た二人の学者からもいくつか質問をされたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "連絡先を交換したから、これからモデルの改良方針や学会への普及について詳しい話ができるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "それと、お父様とお母様だけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "きっと二人とも真っすぐ前を見つめながら、厳しい口調で私への不満を零していたんでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "あの人たちはいつもそうでしょう。この十数年の間で違ったことなんて一回もない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "「アステシアには、一族における自身の立場をよく理解してもらいたいものだな。」"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "どう見ても姉さんにカンカンに怒ってたね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "フフッ、やめてよ、ジーニ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "それで、これからはどうするの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "もうしばらくトリマウンツに滞在しましょう。ずっと観光もショッピングもできないくらい、忙しく過ごしていたし。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "この部屋のレンタル期間もまだ少し残っているわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ここでの用事が済む頃には、きっとお父様の怒りも大分収まっているはずよ。そのタイミングで話をしに行くつもり。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "その時に、はっきり伝えようと思うの。この研究成果は私と妹の努力の結晶だから、お父様の名前を載せることはできないって。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "やっと姉さんが分かってくれて、本当によかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "それでジーニは？　ライン生命に戻るの？　あなたの指導員が、ライン生命の主任にまた返り咲いたと聞いたのだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "ううん、やめとく。同僚からの話じゃ、あの人、以前にも増して人使いが荒くなってるらしいし。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "本音を言うと、フェルディナンド主任が今研究してるプロジェクトは……確かにすごく魅力的だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "建物を空に送り込むエネルギーの開発なんて、憧れない人なんていないでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "でもあんな人の下で働くのは、やっぱり無理。たった一つのチャンスのために、あの人の支配下に戻る必要なんてないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "もう決めたの。だから後悔はしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "私もあなたを見習わなきゃね、ジーニ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "だけど、私のお手本は姉さんなんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "フフッ、たまには妹に褒められるのも悪くないわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "今日は家じゃなくて、外に食べに行きましょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "いいね！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "そうだ、姉さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "なに？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "実家に戻る時、私にも声をかけてよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "ジーニ……でもあなた、実家にはもう戻りたくないのでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "分からせてやりたいの。あの人のやり方を良く思っていないのは、姉さんも私も同じなんだって。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "そこまで深刻な話じゃ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アステジーニ",
      "speakerId": null,
      "text": "姉さんがいやなら、別に行かなくてもいいけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "そういう意味じゃないわ、ジーニ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "speakerId": null,
      "text": "それじゃあ、一緒に行きましょうか。"
    },
    {
      "type": "sceneBreak"
    }
  ],
