  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 纯剧情AVG序章"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 3:23 天気/晴天\nリターニア領内 移動市街ウォルモンド城外 目立たない古いオークの木の下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "セベリン憲兵長……もう三箱目です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "憲兵長、か。今は仕事の時間ではないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "あ、すみません、伯父さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "タバコや酒は身体に悪い。わかっていても頼りたくなる。だが、確かに吸いすぎだな。君は私のようにはなるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "差し出がましいことを言ってすみません。でも、咳がどんどんひどくなってきていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "そんなに畏まらなくていい。今は仕事の時間ではないと言っただろう……ふぅ、まあいい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は遠方を眺めた。焼け焦げたテントと生い茂る野草を尻目に、紫煙を吐き出す。\nたとえ、呼び方を変えてもらうだけであっても、プライベートと同じ安らぎを味わいたかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "はぁ……それにしても、彼らが君を使いに寄越すとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "あのたぬき共が。意見しに来る勇気がないだけならまだしも、まさか君のような若い娘に責任を負わせようとするとは――ゴホッ、ゴホゴホッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "伯父さん、落ち着いてください！　私は自ら望んで来たんです。私の口から伯父さんに伝えなければと思い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ふぅ――ゴホゴホッ、ゴホッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "本当にタバコとお酒はやめるべきです。最近は特に調子が悪そうですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "たぬき共がどんな結論を出したかは大体予想がつく――クソッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "……会議は熾烈を極めました。若い方たちは皆接客室に逃げ込み、押し黙っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "もちろん、私に賛同してくれる方もいませんでした。申し訳ありません、私一人では皆さんを説得することができず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……街が正常な運行ルートを外れた後、状況は緊迫の一途をたどっている。今は若者の社会体験研修などでもないし、学生や若い者たちが発言したとしても、誰も耳を貸さないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "それで、結果は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "住民代表も含めて皆さん同じ考えでした。感染の有無やその感染状況を判別することはできないため、万が一に備えて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "死体は街の外に埋葬し、もちろん……葬儀を執り行うことも許さないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "そうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "本当に……申し訳ございません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……死者の中にはウォルモンドの一員だった者もいる。彼らは我々の家族だ。そう安々と諦めるべきではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "エッケハルトは街一番の裁縫家だった。父親の裁縫店を受け継いでから、彼は結婚式で引っ張りだこだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ビーダーマンは可哀想な奴だった。だが彼は大裂溝の件で天災トランスポーターの職を追われても、贖罪をしようと努力していた。強い男だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ケヴィンは非感染者で、妻のために心血を注ぐ本当に素晴らしい亭主だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "そしてトールワルド、奴は――ゴホッ、ゴホゴホッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "本当に……もうタバコはやめてください、憲兵長。トールさんもそう言っていたじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……そう言うが、君は受け入れられるのか？　思ったことを素直に言いなさい、あのたぬき共の思惑に流されずに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "私は……わ……わかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "ですが、トールさんには安らかに眠ってほしいです。死後も危険物扱いされて、葬儀もなく街の墓にも入れないまま、ただ埋められるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "どうしてこんな扱いをされなければいけないんですか？　昔は、昔はこうではありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "あの鉱石病医も……彼女は素晴らしい方でした。最後までウォルモンドを見捨てなかった。あの四人には、皆立派な葬儀を挙げてもらう権利があるんです、それなのに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "感染者が彼らと共にいたせいで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "……責めるべきは感染者ではありません。今回起きた火災です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "わかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……彼らを弔うのはまだ先だ。今はとにかく、遺体が街の外に埋められることを避けなければ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "最も近くにいる憲兵隊に連絡を入れた。彼らは専門家を含む救援隊を寄越して、調査を行うだろう。それまでは、死体は私の目の届くところに安置しておかなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "専門家がいさえすれば、彼らを街の外に捨てることなく、適切に埋葬してやることができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "最も近く？　救援が期待できるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ああ。だがここまで来るのに一ヶ月ほどはかかるだろう。いや、大裂溝の範囲によっては、数ヶ月を要するかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "大裂溝のせいで……あまりここで時間を取られすぎると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "憲兵長が仰ったように、ウォルモンドが本来の運行ルートを外れてから、状況は刻一刻と悪化しています。皆、いち早く正常なルートに復帰する必要があると言っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……とにかく、今は待ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "私とトールをしばらく一緒にいさせてくれないか。私には……その権利があるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "もしあのたぬき共が、私の息子をどうしても今すぐウォルモンド外の荒野に打ち捨てると言うなら、その前に、憲兵長へ向けて引き金を引けと言ってやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "――そう、私へ向けてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "そ、それはありません！　皆さん伯父さんが街のためにやってきたことは知っています。いくらなんでも、そんなことは……そんなことは絶対にしません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……いや、今のは忘れてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "言うべきではなかった……憲兵長にあるまじき言葉だ。我々は私情にとらわれるべきではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "ですが、トールさんは伯父さんの息子なのに……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "タチヤナ、戻って彼らに伝えてくれ。私が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "私が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "私が同意したと。ゴホッ、そうだ、私が同意したとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ゴホッ、ゴホゴホッ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "隊長、彼らが戻って来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "近くの街に潜入し資源の補給ができるのも、彼ら現地住民たちのおかげだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "狩猟隊ももうすぐ戻ってくるだろう。今日は何か収穫があると良いんだけどな、もう二日も砂虫しか食べてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……水源は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "問題ない。それも彼らのおかげだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "……彼らは私たちの役に立ってくれている。だが本当のところ、彼らと上手く交渉できているとは思えないな。甘く見られているような気すらしてくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "見たところ、ウォルモンドは近い内に移動を始めるようだ。それまでに何か手を打たないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……我々には助っ人がいる。大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "助っ人……そうかもしれないが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "やはり、現地住民はどうも信用できない。あの感染者たちは……ただ単に復讐がしたいだけじゃないのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "リターニアは感染者に対してかなり寛容的だし、アーツの普及率も高い。つまりあの感染者たちが恐れられ、迫害される理由はないんだ。それなのに、どうして復讐を考える？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "ここの感染者は少なくとも普通に暮らせているし、すぐに絞首台に送られることもない。それなのに、まだ不満だと言うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "俺は、奴らは下心を持った暴徒ではないかと感じてる。もしかしたら奴らは、俺たちの名前を利用して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "名前？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……名前が、何になる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "彼らを信じない……それは構わない。では……我々は誰を信じる？　誰を信じるべきなのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "毎度毎度、そんな怖いことを言わないでくれ。俺はあんたのことを信じるよ、隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ああ、落ち葉が、君の頭に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "えっ、落ち葉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "干し肉が数箱と、拾い集めた果実、水源。今は初秋だ、冬までにはまだ時間がある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そう、我々には時間が残されている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "……はぁ、あんたの喋り方は相変わらず、何を言いたいのかよくわからないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "とにかく、俺たちはいつ戦場に出るんだ？　あんたが決めてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "戦場？　いや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ほら、狩猟隊が帰ってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今夜の食事は、多少はマシになりそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "そうだといいけどな。今のうちに肉をたらふく食べておこう。冬になれば食事が一番の困りごとになるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ボブから連絡はあったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "俺たちがリターニア領内に入ってから、届いてないな……ああ、そうだ、一つ聞きたいことがあったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "あの人のコードネームは最初から「ビッグ・ボブ」だったのか？　それとも、「ボブ」という名前で身体が大きいからそう呼ばれるようになったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……覚えていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した感染者",
      "text": "まあいい。彼らは賞金稼ぎだ。もう財宝を見つけたかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……財宝、財宝か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そうだな、もし私たちの助けになるような財宝でも見つかれば……良いのだがな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "もう二十七日目よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "これだけ長い間連絡をよこさないなんて、あの子が時間に厳しいことは有名だっていうのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "アント……どこにいるの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "フォリニックお姉さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "あ、リサ……いえ、今はオペレーターのスズランって呼ぶべきね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "良いコードネームじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "えへへ、ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "それよりお姉さん、通信室にこもってもう二十時間になりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "そっ……そんなに経った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "はい！　ですから休憩室で休んでください、私が代わりに見ていますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "わかった……私、そんな長く通信機に張り付いていたのね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "……まだアントお姉さんからの連絡はないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ええ……でもリターニアに向かう申請は出したわ。アーミヤが許可してくれたら、いつでも出発できるように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "お姉さんが直接リターニアに行くんですか？　他の任務があるのでは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "あの子は私の同期で、一番の友だちなの。放っておくなんてできないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "アントの最後の定期連絡は、リターニア北部の事務所からだった。よほど特殊な状況じゃなければ、拠点から遠くに離れることなんてないはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "――では、私も行きます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ダメよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "えっ！？　そんなにあっさり却下されちゃうんですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "で、でもアントお姉さんの行方を調査するだけで、危険はないんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "状況によるわね。何とも言えないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "あの、でも、大丈夫です！　私だって正式なオペレーターですし、ケルシー先生に指導を受けていますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "それにフォリニックお姉さんは最近ずっと辛そうな顔をしてます。心配なんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……はぁ、まさか私がリサちゃんに心配される日が来るなんてね。ここ最近、私はそんなに様子がおかしかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "はい……でも、悩み事に年齢は関係ありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "うーん……わかったわ！　現地の拠点には報告を上げてるし、もし何かハプニングがあっても、彼らが助けてくれるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "アーミヤの許可が下りたら、一緒に行きましょう。でもどんなときも私の側を離れないこと――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "通信ですか？　アントお姉さんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "違うわ。電報ね。リターニアのオペレーターが、通信を受け取った後に送ってきた電報……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "フォリニックお姉さん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "アントは最後、リターニアの某移動市街で目撃されてる……そしてその街は約一ヶ月前に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "天災に見舞われた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
