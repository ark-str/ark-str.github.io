  "stageId": "act18d3_08",
  "title": "血族",
  "storyCode": "SV-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d3/level_act18d3_08_end.txt",
  "sourceHash": "2bcf35f1e7117e581e558d7ce1d27e74e8f1e8aec5f0e6574c2fa17e347e4ba8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "はあッ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「シーボーン」",
      "text": "お前たちは私に似ているのか……それとも彼に似ているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シーボーン」",
      "text": "Gla-dia。お前は強い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「シーボーン」",
      "text": "感情。我らの血族は学習する。我らも多くを伝達する。我らはお前たちに伝達を試行する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シーボーン」",
      "text": "Ishar-mla。生きろ。生きること、生存は良いことだ。次は他の血族がお前を見つけ……お前に問う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「シーボーン」",
      "text": "我らは、質問が不得手。不得意だ。故に我らは、学習する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "――死んだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "この……罪深き、者どもめ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "来なさい。あなたの番よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "このゴミは一体きりのようね。外にいた恐魚たちも、こいつの一族ではない。となると、あなたのものということになるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "その冒涜的行為への罰として、あなたたちはこの手で引き裂いてやりましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "そう――私自ら！　あなたたちのような雑種は、ここで根絶やしにしなければ！　命は尊いものですが、罪深き者を生かしても、ただ資源が浪費されるばかり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "重傷を負った罪人に、身動きの取れぬ罪人……あなたたちの死骸はいずれも大地に放り捨て、最も卑しき陸生家畜にすべてを食わせてやりましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "あなたたち二人を始末するなど、実に容易いことです――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "人間ぶるのもいい加減になさい。あなたたちのような、かつては人であり、今は人のふりをしているだけの者たちこそ……あのゴミ、シーボーンなどより、よほど気色が悪いのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "ァアアアアア！！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "罪深き雑種め、ここで死ぬが良い！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ねえ……私のこと、忘れてない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
