{
  "server": "jp",
  "storyId": "story_texas_set_1_story_1",
  "groupId": "story_texas_set_1",
  "stageId": null,
  "title": "絶対に、確実に",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_texas_1_1.txt",
  "sourceHash": "fc98aa341a27fa4837196f993584d61f235a94ebeaebf07c3f91942f09e0e598",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "龍門　ペンギン急便のアジト"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "え！？　ええ～っ！？　ちょっと！　ちょっと待ってよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "待たない。お前の負けだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もうや～めた。毎回毎回テキサスばっか勝って、つまんないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "やっぱり映画でも見よーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なんか食べる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いつもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "オッケー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ほら、テキサスが大好きなクッキー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ありがと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "う～ん……この爆破シーン、なんか物足りないな。あたしが学校でやらかしたやつの方がまだマシだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "この、主演のウルサス人ってのはどっかで見たことある気がするんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ん？　もしかしてテキサスもなんか爆破したことがあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ、まあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "え～！？　その話今まで聞いたことがないよ。どんな感じ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "たいした話でもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "教えてってば、誰にも言わないからさー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "何を爆破したの？　校舎？　礼拝堂？　それとも他の何か？　ねえねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……あれは、塔だろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "塔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ、塔だ。斜めに傾いていた塔だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ある種の……地元のシンボルといった建築物だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "じゃあ絶対に処分食らったでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ただファミリーのために働いただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "処分を食らっても懲りずに十何回も爆破を繰り返しているお前とは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "それはさぁ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ほら、学校って、人を楽しませる場所でしょ？　当然一番面白いことにしなきゃね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "それにあたしだって、別に物を壊したくてやってるわけじゃないんだよ。ただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ただ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ただ、いたずらをしようとすると、いつもちょっとしたアクシデントが起こるんだよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "たとえばほら、モスティマの時なんかさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "本当は彼女をちょっと驚かそうと思っただけなんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "モスティマ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そそ。あの頃モスティマはまだあたしの学校の先輩だったんだよ。優等生で、しょっちゅう演台に上ってなんかしゃべってたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だからあたしはその演台に行く通路に、小さなバネ仕掛けを置いたわけ。そしたらさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……モスティマが、どこかへ飛んで行った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あのモスティマだよ、そんなわけないでしょ。むしろあっさり跳び越えちゃってさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "後ろを歩いてた別の先輩が罠を踏んで、飛んでっちゃったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "その話、爆破とは何も関係ないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "テキサスは知らないだろうけど、ラテラーノではそういう場面になると、敬意を示すとか言って、実弾の入った銃器を担いで行くのが礼儀なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "で、その先輩が担いでたのがさぁ……火力がえっと、ちょっと高めの銃だったんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "経験なのか条件反射なのか知らないけど、先輩はその銃で一発ぶっ放して、その反動で無事着地したの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "けど撃った弾は屋根を支えてる柱をものの見事に破壊しちゃって、礼拝堂がちょっとばかり崩れちゃったんだよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシア、本当にただのいたずらだったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "本当だよ！　わざとじゃないってば！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "はぁ……もしシラクーザでそんなことをしでかしてみろ、翌日には物理的に死んでいるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "首を落とされるのはまだいい方だ。苦しまずにすむからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "だが、もし公の場で他人に恥をかかせたなら、そんなに簡単にはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そうだな……手足を切り落とされて、口が塞がれて川底に沈められるといったところか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ひえぇっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "――その後、死体は引き上げて道端に吊るされる。お前のような危険思想を持った人間への見せしめとしてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "冗談、だよね……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私が冗談を言うと思うか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……脅かさないでよ。学生時代に物を知らなくてやっただけなんだからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "へえ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "今のあたしは、真面目に働くフツーの社会人だからさ。他の人に迷惑かけたりしないって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "まぁ時々……たまに、うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ちょっとした仕掛けでボスをからかおう、なんて考えることもあるんだけど。テキサスはどう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "お前の破壊力を考慮すると、やめておいたほうが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "あ。ボ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "チョアーッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "誰だよ急に頭なんか叩き――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あれ、ボス！　おかえり。今日は早いじゃん？　あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "暇だからって悪巧みしてる社員の頭を叩いちゃいけねえのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "悪巧みって、そんなあははは……ただちょうど仕事がなかったからお喋りしてただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "じゃあ今すぐお前にひとつ、仕事をやるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "あった。ほらよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "今すぐこいつを届けてこい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "住所と受取人の伝票はこれだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どれどれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "オッケー！　ちゃちゃっと片づけてくるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "テキサス、お前も一緒に行け。老いぼれネズミの荷物だ。ちっとばかり面倒くせぇ代物なんでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "届けたらすぐに戻ってこい。あいつらが弁償してくれたレコードがもうすぐ届くから、運ぶのを手伝え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしたちにどーんと任せてよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うわぁ、この時間にどうしてこんなに混んでんのさ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "おっかしいなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……まさか、またどこかの運送業者が道路でかっ飛ばして事故ったとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "はぁ……テキサス、さっきからハンドル握ったままボケーッとしてて危ないよ。何考えてんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……テキサス？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（住所を見る限り、この荷物はこの間のシラクーザのマフィア宛てのものだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（だが、奴らはすでに鼠王の配下になったのではなかったか？　どうして私たちに荷物を運ばせるんだ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "テ～キ～サ～ス～",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "わっ！？　なんだ、敵かっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "周りを見てみなよ。敵がいるように見える？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "あっ……すまない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ねえ、テキサス。この荷物ってさ、何ヶ月か前、あたしたちにやられて街中を逃げ回ってたあの黒服たち宛てじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "なぜそれがわかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしたちみたいな物を運ぶ人間はさ、ついでにいろんな情報を聞くもんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あのエリアに配達に行くと、受取人にループスが多いんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でね、その連中の家の玄関に入ると、決まって黒い帽子とコートが掛かってるんだ。すぐわかっちゃったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "マフィアだよね……あいつら以外に、龍門であんな恰好する連中はいないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そうだ、テキサス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "マフィアと言えば、急に興味が湧いてきたんだけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "シラクーザにいた時は、テキサスもあんな恰好だったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "黒いスーツに白シャツだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いや、白いスーツに赤シャツだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "おお！　なんかカッコいいね！　似合いそう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "よーするに、みんなとは違う恰好をしてたんだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ、そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ふーん、なかなか個性的じゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ファミリーの幹部にとって、自身の実力と立場を明らかにするために服装で他のループスとはっきり差をつけておくことは、必要な選択だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でもそれってすごく目立つんじゃない？　真っ黒な集団の中でぜんぜん違う服を着てたらさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そんなことしてたら、遠くから誰かに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "パァンッ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "って撃たれたりしないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "マフィアのボスは皆、セキュリティには細心の注意を払っているからな。狙撃手の配置に適したポイントには必ず、自分のファミリーの人間をあらかじめ向かわせて安全を確保する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それでも、もし本当にそんなことが起これば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "その矢をたたき折って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そいつのファミリーをシラクーザから排除する。徹底的に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……以前の私はそうしていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "だが今は……もうどうでもいいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "トラブルをどう処理すべきかは、ボスが考えることだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私たちは荷物を指定の場所まで届け、たまにケンカをする。それで十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "アハハ……そ、そうだね。うん、それがいいと思うよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "これ、渋滞にはまってどのくらい経ったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "三十分ほどじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "このまま待ってるだけはマズいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うわぁ……隣の車の運転手が、お子様には教えられない言葉で怒鳴りはじめたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イライラした龍門市民",
      "text": "（激しいクラクション）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イライラした龍門市民",
      "text": "（窓を開ける）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イライラした龍門市民",
      "text": "おい、前の*龍門スラング*、とっとと進めや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした龍門市民",
      "text": "そんなデカい声で怒鳴られてもね。前が詰まってるから俺に文句言われても困るんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした龍門市民",
      "text": "ほら、周りを見てごらんよ。みんな同じだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イライラした龍門市民",
      "text": "このクソ*龍門スラング*、今日の商談が潰れたら、お前を*龍門スラング*してやるからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした龍門市民",
      "text": "俺だって嫁さんのところへ急いでるんだよ。でもこんな状況なんだからさ、みんなどうしようもないんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした龍門市民",
      "text": "もし暇なんだったら、一緒にトランプでもどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした龍門市民",
      "text": "ラジオでもいいぜ。最近のニュースは結構面白いぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イライラした龍門市民",
      "text": "お前*龍門スラング*",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（ラジオを交通情報チャンネルに変える）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイウェイラジオ",
      "text": "……環状道路上で二台の乗用車による衝突事故がありました。近衛局の警官が急行しましたが、双方の運転手は既に現場を立ち去っているとのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイウェイラジオ",
      "text": "近衛局によると現在、運転手を捜索するために目撃者の証言を求めているほか、事故車両を移動させているとのことです。環状道路の交通は間もなく復旧するでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイウェイラジオ",
      "text": "では引き続き、ほかの道路情報です――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なんか前にも聞いたような話だね。どう思う、テキサス？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ね、みんなに状況を聞いてみたほうがいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（無線のチャンネルを合わせる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "もしもし、聞こえるか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もしもし、テキサスはん？　どないしたん？　今取り込み中や！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "クロワッサン、何があった！？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "（矢が飛び交う音）"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "誰かがウチらの荷物を横取りしに来てんねん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "車が壊されたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "壊れとるやろな。せやけどそっちはちょちょいと直せば大丈夫、多分見た目は元通りや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "けどボスに言わんといてや、バレたらウチ、今月のボーナスまた没収されてまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "取り込み中に邪魔して悪かったな。また後で。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あんなことするのはあたしだけだと思ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ずいぶん自慢げだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そりゃそう――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あだっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ふん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "このままここでぐずぐずしていたら、戻った時に不機嫌なボスと会うことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシア、荷物は先に私が持って行く。お前は渋滞が解消したら急いで追いかけて来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "荷物ならあたしが配達した方がいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "マフィアと会う時、何と言って挨拶すべきか知っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ごめんくださーい、ペンギン急便です！　……じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "はぁ……それじゃ、あの晩の惨劇の再現になるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ケンカになっても、あいつらなんて怖くも何ともないけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それでいいのか？　今回は奴らは荷受人なんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "もしお前がケンカしてから荷物を受け取ってもらうつもりなら、私は何も言うことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ああ……確かにそれはちょっとなぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "だから、私が行った方がいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "少なくとも奴らは「テキサス」という名前を憚る。私の顔を見せれば大きな衝突は避けられるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ほら、鍵だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "鍵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……あたしに運転しろっての！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "今だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "帰りは私が運転する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……オッケー！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ぶつけるなよ。わかってるな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしがやるんだから安心してよ……たぶん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私はな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "まあいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "後で落ち会おう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "はいはい……ん？　テキサス、どうして剣を車の中に置いて行ったんだろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "龍門市場"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（この道を抜ければ早く着くはずだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（姜斉通りはすぐそこだな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（どうやらこの大きな倉庫のようだ。姜斉通り8号、住所はここで間違いないな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（荷物を渡してすぐに帰れればいいんだが……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "龍門市場  姜斉通り8号"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "てめえは、テキサス！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "と、止まれっ！　これ以上近くに来るな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（クロスボウの矢尻をゴム製のものに取り換えている。どうやら本当にルールを守り始めたようだな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "落ち着け。私は荷物を届けに来ただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "荷物！？　そこへ置いとけ。こっちから取りに行かせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "荷物は本人に直接手渡しするルールだ。中身の確認後、サインをもらわなければ帰れない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "（小声）おい、どうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "（小声）誰宛の荷物か、まず聞くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "ああ……ゴホン。受取人を呼んできてやる。伝票はいったい誰の名前になってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……エンリコだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "エンリコって……ボス！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "（小声）おいっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "お――ゴ、ゴホン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "ここから一歩も動くなよ！　俺がエンリコさんを呼んでくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "（小声）頼むぞ。すぐ戻る。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "て、テキサス……さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "見たところ、武器を持っていないようですが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ……武器は車の中だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "まさか、袖に隠し持った源石剣で俺たちを皆殺しにしたりしないですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "コンテファミリーを壊滅させた時みたいに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "お前もルールを知っているはずだ。龍門のルールを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "ははっ、そうでしたね、仰る通りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "（ふう、よかった……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "エンリコさん、こちらです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "エンリコだ、ドン・テキサス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "私宛の荷物が届いていると聞いたのだが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ、この小包だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "差出人は鼠王だ。受け取りのサインをお願いしたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "……鼠王？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "わかった。荷物を頂こう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "（箱を開ける）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "うむ、確かに鼠王から私への荷物だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "……どちらにサインをすればいいのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "この右下の、署名欄に頼む。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "うむ――よし。これでいいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ありがとう。では――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "お待ちください、ドン・テキサス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "その呼び名は私ではなく、シラクーザにいるファミリーのボスのものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私のことはただ、テキサスと呼んでほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "そうか……わかった。テキサス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "見ての通り、私とファミリーの兄弟たちが龍門に来てから、もう何年も経った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "先日、カポネとガンビーノがこの都市の……権威ある者に楯突いた結果、ここを追われることとなった。そして私は、皆に推挙されてファミリーのボスになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "私はあなたの意見を聞きたいんだ。もしよければ、中で詳しい話をしないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "遠慮しておく。私には大したアドバイスはできない。言えることはわずかだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "ではそれを拝聴しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "あなたと兄弟たちが、シラクーザに戻る可能性は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "今後は恐らくずっと龍門にいるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "もし帰っても、ミズ・シチリアの手下に追われるだけだ。何の利益もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "なら、シラクーザ式の生活にこだわりすぎないことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "龍門の人たちと同じように暮らすんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "うむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ファミリー間の争いをここに持ち込んだ場合どうなるか、あなたたちにはよくわかっているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "極東、ウルサス、あるいはシラクーザ、どこからでもいい。この場所に来て、ここで長く暮らしていきたいのであれば、その方法はただひとつ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "龍門の人間になることだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "この街にやって来たマフィアはたくさんいる。あなたたちは最初ではないし、最後でもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "何人もこの街に来て、また去って行く。最後に残るのは、龍門人だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……私が言いたいのは、それだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "失礼する……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "テキサス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "あなたも、もう龍門の人間になったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "かもしれないな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "だが、私はやはり最後はあそこに戻るだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カタッ\nピ――ピ――！"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "……何の音だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアボス",
      "text": "この箱からかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "おか～。終わったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "遅かったじゃん。あたしが来る頃には、もうここで待ってると思ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "少し話があってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "へぇ～テキサスが積極的に誰かと話すなんて珍しいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "今後うちのボスに迷惑をかけないように釘を刺しただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そうなの？　意外と話が通じる奴らなんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でもそれならさ、後ろを見てよ。倉庫から飛び出してこっちに走って来る連中は何なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あれって間違いなくテキサスを追って出てきてるよね！？　なんだか友好的じゃなさそうだけど？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……ちょっとしたアクシデントが起こったようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私があそこを出てから、離れた場所で大きな音が聞こえた。ボスはどうやら私たちに荷物を渡す前に少々……改造したらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "じゃあどうするのさ……やっちゃう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "やるな！　逃げるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "このエリアはマフィアの巣窟だ。また給料で車を弁償したいのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あああ、そうだった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "鍵を貸せ、車を出すぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "やれやれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ピーターズの野郎、見た目はあんなで不器用そうなのによ、酒選びはなかなかうまいじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "レコードを運び終わったらあいつのとこへ行ってもう何箱かもらってこよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "待ちくたびれたぜ！　お前らが戻ってこなけりゃレコードは俺が自分で全部運んじまったとこだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "あの荷物は、鼠王からマフィアに宛てたものじゃなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ああ、あの老いぼれネズミのモンさ。俺がちょいとばかり細工をしてやっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "あの黒ずくめのゴロツキ共め、俺のレコードを燃やしといて、タダで済むとでも思ってたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "そうは問屋がおろさねぇってんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "……なあ、テキサス。奴らはカウントダウンの後に流れたラップを聴いてブッ倒れてやがったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "倒れてない？　そんなわけねえだろ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ありゃあ俺が、あのチンピラ共のために特別に用意したラップなんだぜ。録音前にそこらでたむろしてたループスを捕まえて、効果は実証済みだ。そいつはその場で怒り狂って倒れちまったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "奴らは倒れたりはしなかった。ラップを少し聴いた後、ものすごい勢いで飛び出してきて私とエクシアを追いかけてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私たちは車で龍門の街中をぐるぐる走り回って、ようやく奴らを撒けたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "じゃあそれはお前のミスだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "俺はお前の配達の平均時間を精確に計算してたんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "逃げる時間を確保してうちの従業員の身の安全を守るために、録音する時に数分だけ空白を入れたんだ。再生延期ボタンだって二、三回は押したしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "あ……わかったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "あのループス共はお前の名前を聞いて、あれこれ尋ねてきやがったんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "そのことまで計算に入れた、俺の用意周到さが際立つぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "奴らは絶対に気づかない。あれは俺が特別に用意してやったウォーミングアップだとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "激しいカーチェイスのあげく、お前らを取り逃がした後に戻ってこれを聞くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "そりゃあムカっ腹も立つってもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "それで息ができなくなっちまってもよ、誰も奴らを助けてやれねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ウェイの野郎、実弾は使ちゃいけねぇって言ってたが、口もダメだとは言わなかったからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ガハハハハハ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "まったく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "仕事に戻るぞ、一緒にレコードを運んでくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "了解だ、ボス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "エクシアはどこ行った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ゴム弾の補充に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "早くしろって言っときな。良いレコードは待っちゃくれねえんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "了解……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
