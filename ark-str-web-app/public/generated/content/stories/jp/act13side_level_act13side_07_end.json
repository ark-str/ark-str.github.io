  "sourceHash": "463c926112b95da631e49b9c12a4b50f42b31668b172db467435b3d73399e3eb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2 7-2"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "……カイちゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……ソーナ！　よかった、無事だったんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ロイに一杯食わせてやったんでしょ？　名演技じゃないの！　一体どうやったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……いや、私はただ本当にお前を失ったら、どう思うかを想像しただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "わお、メソッド演技派……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ところで、ほかのみんなは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……イヴォナが重傷を負ったが……幸い、命に別状はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "……イヴォナが……そう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジャスティスナイト」",
      "text": "“Di-di”……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "彼女は我々の中でも、最も戦士らしい戦士だからな……立ち向かい続けたんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ユスティナと合成樹脂騎士の二人が、プラチナの対処にあたってくれている。彼らを助けに行かなければ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……その必要はない。プラチナは既に撤退したからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "そもそも、奴はそこまで強くない。俺たちだって、二人がかりで奴を追い返せなくなるほど落ちぶれちゃいないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……ユスティナはどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "今日の試合は必ずスケジュール通り進行する。問題ないな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "はい。メジャー会場は万全な状態です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "よろしい。観客の不安を抑えるためにも、今晩の試合は完璧なものにしなければね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "覚えておいてほしい。この試合に視線を注いでいるのは観客だけではない。騒動を受けて、常務取締役の一部も今夜は特に注目しているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "上手いことやれば褒賞を得られるが、下手を打てば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業職員",
      "text": "か、かしこまりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "いやはや、苦労を掛けるね、モーブ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "とんでもない！　今夜のMCをお任せいただき、大変光栄です――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "わかっているとは思うが。昨夜は何も起きなかった、いいね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "今晩行う四試合で最も注目を集めるのは、間違いなく耀騎士と追魔騎士の対戦だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "とは言え……感染者がこれだけ大規模な事件を起こした直後だ。理事会としては、耀騎士が勝ち続ける展開はあまり望ましくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "……それは……審判団に、不正な判定をさせたいということですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "実際にそうするかどうかは、今後の試合の状況に応じて判断するつもりだ。もちろん、審判の判定後は、君が観客向けにその合理性を「説明」することになるがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "同じ感染者である血騎士のほうは、ブラッドゴブレット騎士団から説得しに行かせた。もうすぐ結論が出る頃だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "もう一方は、耀騎士と追魔騎士だ。もとから狂人に対処しようという方が難しい。どうせ他の方法を取らざるを得ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "わかりました！　それでは、すぐ試合の準備に取りかかります！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "お顔が真っ青ですよ。どうなさったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "……あの大規模停電のあと、「クロガネ」が姿を消したんだ。それも三人ともね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "それに、公表こそ控えているが、連合会幹部数名が停電中に暗殺される事件も発生した……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "現場は慌ただしく、手がかりは感染者の犯行を示唆している。しかし……私には、彼らにそれほどの実力があるとは思えないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "これは今まさに、音もなく恐ろしいことが起きていると言っても過言ではない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "ということは、まさか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "無冑盟が裏切ったんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……バトバヤル。お前には、平素為すことが何もないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "なんじゃと！？　お主にだけは言われとうないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "……それでもメジャーに出場する騎士なんじゃろう？　訓練場もなければ、帰る家すらないとはお主、この大騎士領で毎日浮浪者同然の暮らしをしておるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……狩人たる者、森で方角を失いし時はそこに暮らし、住みかを築かんとするものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "お主が今居るのは、大地でも指折りの大都市であって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "――都市だと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その異様なまでの怒鳴り声が、老騎士を暫し沈黙させた。\n周囲の視線が二人へ集まる。まるで、彼らこそ森の野獣であるとでも言うかのように。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "都市……それは軟弱者の象徴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "いわゆる文明と呼ばれるものは、野蛮を征服したのち、自らの塔を打ち立てた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "その塔においては、最早人間性などという手形は無用の長物だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "……何を言っておるんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "カヴァレリエルキには、一戦に値する騎士が……我が命を運命に委ね挑むに相応しき者たちがいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "しかし、彼らは皆、この都市に反抗せし者ばかりだ。従順なる者の多くは弱者であり、反逆者こそが永遠に朽ちることのない騎士だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "これぞ正しく、文明なるものが既に腐敗し堕落しているという事実の象徴……騎士は血と栄光の時代に回帰すべきなのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "……お主は過去に生きておるようだな、小僧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……私は、この生き方を誇りに思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "ゆえに今宵は、かの時代が過ぎ去りしものでないことを肌身に感じられるよう願うばかりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "ならば、わしも小言はこれまでにしよう。マーガレットは負けん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……かの騎士には、英雄の纏う気迫を感じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "この平凡なる時代が、その切っ先を未だ鈍らせていなければ良いがな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "観客の皆様～！！　今宵の栄えある会場へ――カジミエーシュ騎士メジャーへようこそ～～っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "試合はここまで順調に進み、本当～～にたくさんのお客様が大会にご参加くださっております！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "そして本日！　今シーズンの累計観戦者数と、賞金プール及びイベントにおける総額が、またまた歴史上最高の数字を記録いたしました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "皆様、これは間違いなく――この時代がいまだ発展の一途を辿り、カジミエーシュに輝かしき未来が約束されていることの証左でございましょう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ねえ、本当に会場に行っちゃダメ？　お姉ちゃんならきっと、関係者用のチケットを持ってると思うんだけど～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "このおバカ、また無冑盟に襲われたいの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ううっ……ご、ごめんなさ～い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……私たちは今や、無冑盟と明確な敵対関係にあるのよ。それがどんな意味を持っているのか、ちゃんと理解してる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "だから迂闊な行動は取れないの。このまま対立状態が続けば、大騎士領を離れる必要だって出てくるかもしれないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……まったく、どうしてこんな状況になっちゃったんだか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……おや、あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……チャルニーの腰巾着、か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "こんにちは、タイタス様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "ああ。そこに掛けると良い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "代弁者になって、生意気になったようだな、ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……いえ、そのようなことは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "あの状況で、突然椅子が転がり込んできたんだろう。何かおかしいとは思わなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……チャルニー様はあまりにも急に去ってしまわれましたから、聞きそびれたことが多くあるのは確かですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "では、機会があるなら、聞きたいと思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "私には、連合会へのコネがある……貴様では聞き出すのに都合が悪いというのなら、代わりにチャルニーの流刑先を聞いてやってもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "誤解のないよう言っておくが……私は、耀騎士との再戦に敗北して気が付いたんだ。自分はもう、片腕だけを頼りに七人の騎士を制したあのタイタス・トポラではない、ということにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "であれば、引退前に貴様ら代弁者とも関係を築いておかねばと……なんだ？　なぜそんな顔をしている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……正直に申し上げますと、思ってもみなかったのです。威厳溢れるブレードヘルム騎士団が誇る主力選手であり、かつては四強に手をかけ、大騎士の称号を得るかとまで思われていたあなたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "ご自分から、引退を口にされる日が来るなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "試合場でのあなたは……あんなにも……その、超然としていて……私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "もとより競技騎士であることは悲劇なんだ、マルキェヴィッチ。競技場の外へ出れば、我々も一人の人間でしかない。自らのために、その先の道を築いておかなければな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "五体満足で今日まで戦えただけでも、満足すべきだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "我が理想は、幕を下ろしたのだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "さて、本日ここに雌雄を決する騎士両名は、なんとそれぞれにドラマティックな背景を持つ「独立騎士」でございます！　こうした独立騎士同士の戦いをメジャーで目にするのはいつぶりでしょうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "スポンサーなし、騎士団の訓練もサポートもなし！　武器も鎧も自分自身で手入れするしかありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "しかし、彼らはそれでもメジャーの会場に立つ強者であります！　まずご紹介しますのはかつてのチャンピオン、誰もが注目する復活の王者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "それでは、ご登場いただきましょう！　若き伝説、ニアール家の誇るチャンピオン！　耀騎士！　マ～～ガレット・ニア～～ル！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "対しますのは、歴史書の中の存在となったあの種族！　希有なるクランタにして、古の時代における戦神の子孫――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "長い騎士競技の歴史の中でも唯一無二！　純粋なる血統を持ち、純粋なる強さと恐怖を従える者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "はるかな草原を踏み越えてきた孤独の戦士！　最後のケシク、追魔騎士！　トゥ～～ラ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "こ、これは――音に聞こえし「悪夢」の角笛！　戦いの始まりを告げているようです！　果たして、最後に膝をつくのは――帰ってきた耀騎士か！？　はたまた、蘇った古の戦士か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "それでは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "耀騎士よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "おお～っと？　追魔騎士が突然、槍を地面に突き刺しました。彼は……な、何をしているのでしょう？　深く一礼しているようですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "この時を……長く、待ち続けてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "カジミエーシュの騎士というものには、あまりにも失望させられたがな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……フォーゲルヴァイデ卿から、あなたの話は聞いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "追魔騎士。あなたは、何を求めているのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……天命だ、ペガサスよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "我が古の一族は伝統に従い、成人を迎えると、未知なる天路へと踏み出していた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……天路にて待ち受けるものが何であるかは、誰も知らぬ。しかしその旅を終えてこそ、人生はようやく真の始まりを迎えるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "野獣との殺し合いであれ、異国にて見聞を広めることであれ、最後まで天路を歩み抜いたナイツモラは、皆その意味に気付くもの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "その後、彼らは恐怖の萌芽となり、数多の山河を踏み越えて、征服者として闊歩する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "この大地を知ることによってのみ、我らは己の命運を知ることが適うのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "では、あなたの天路の意味は見つかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……否。我が前途は……濃霧立ち込める森林の如く在る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "ゆえに貴様こそが、我の求める意味ならばと望んでやまぬのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "――来い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……君たちが、合成樹脂騎士……シェブチックの家族？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "……あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "私は……騎士だよ。彼の騎士仲間なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……ええと、君たち……大丈夫？　虐待とか、されてない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "虐、待……？　何を言っているのかはわかりませんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "あの日、シェブチックは突然倒れてしまって。白い服の騎士から、彼は競技場で敵に陥れられた、と聞かされたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "その後、彼女が私たちをここに匿ってくれて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……そうだったんだ。これ、シェブチックから渡されたんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "……！　これは、彼に渡したあの木彫……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな女性",
      "text": "シェブチックは今どこに？　無事なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……安心して。私が、彼の所に連れて行ってあげる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……ねえ、取引しない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "今夜以降、無冑盟とは二度と敵対しないって約束してくれるなら……奥さんと子供が、どこにいるのか教えてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "……なんだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "それとそこの遠牙騎士。レッドパイン騎士団全員に伝えてくれないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "無冑盟の内部で、問題が起きてるのに気付いちゃったんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "だから取引したいの。誰だって、理由もなくいいように利用されたくなんかないもんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……そんなことを言われても、信じられないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "君は、無冑盟の総意を代表できるような立場じゃないよね？　いくらプラチナだとは言え――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "そんなの中間管理職にすぎない、って言いたいのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "アンタの言う通り……無冑盟の大部分は、連合会に雇われてるわけだし、私はその代理として管理してるだけの立場であって……理事会の考えとあれば、私たちに止めることなんてできないけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "それでも、「ランク」持ちの人たちが動かなければ、アンタらもだいぶ楽ができるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "この数年、理事会は功を焦ってるから、集めた新兵のレベルはかなりまちまちだしさあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シェブチック",
      "text": "……何？　では、動力炉を破壊したのは無冑盟なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ええ。サーバーの格納庫も、ロイが破壊して、あたしたちに罪をなすりつけたみたいね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "連中は、まさか、本当に理事会の支配下を抜け出したいのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……クソッ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "初めから、利用されていたっていうのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "私たちの戦いも、払ってきた犠牲も、すべてが――っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジャスティスナイト」",
      "text": "……“Di-di”。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……っ……すまない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "……ううん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あたしね、燭騎士に助けられたあとにイオレッタ・ラッセルに会ったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "合成樹脂騎士",
      "text": "なっ――あの大騎士長本人に会ったのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あははっ、うん。新聞やテレビのニュースで見るよりも、若くて優しい人だったわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "彼女は……あたしたちが、合法的な身分を取り戻すことに同意してくれたの。つまりこの取引は、まだ有効ってことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃん、チップは持ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……もちろんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "だが……ここへ来て、世論はすべての事件を感染者によるものだと結論付け、我々を非難している……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ソーナ。「合法的な身分」を得たとして、本当に意味があるんだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "ああ！　この気持ちを何と表現したらいいのでしょうか――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "耀騎士の強さは誰もが知っての通りですが――この追魔騎士、過ぎ去りし過去を背負った古の戦士は！　何と見事な技の冴えを見せてくれるのでしょうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "それにしても――想像もしていなかった展開です！　この試合、両者は複雑なアーツを使用するでもなく、純粋なる武術と武器で戦っております！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "この迫力、どんなアクション映画も敵いますまい！　雷の如き身のこなし、力強く繰り出される斬撃！　試合開始から十分しか経過しておりませんが、競技場の至る所がボロボロになりつつあります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する観客",
      "text": "見ろよ、あの動き！　追魔騎士ってのは、チャンピオンレベルの選手だな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "騒がしい観客",
      "text": "彼がどんなに凄いかなんて知ってるわよ！　だって私、金貨四百枚も賭けたもの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……本当に、見事な試合ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……あのナイツモラの武器捌き……あんなものは初めて見たな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "征戦騎士のそれに似たところもあるが、また違うもののように見える……うん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "どうされたのですか？　左腕騎士様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "意外な客が来ているな。昨晩の噂は、本当だったということか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "噂、というのは――えっ――！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]\n観客席の最後列、その隅に銀光が佇んでいる。\n彼の存在感は比類なきものだが――それもこの時ばかりは、観客の上げる歓声と叫び声の中に埋もれていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……これほど近くでメジャーの競技を観戦するのは、初めてです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "本当に……吐き気がします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "あなたが反感を覚える理由は何かしら、ライム？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "なるほど。あなたの答えはわかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "では、今戦っている二人の騎士……ナイツモラとペガサス、彼らの実力については、どう思っているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……確かに、彼らの武芸が素晴らしいものであることは認めざるを得ません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "あの「ナイツモラ」は幾度も戦場を経験してきた戦士というわけではありませんが……ある種の執念が彼を真の戦士にさせたのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "そして、マーガレットに関しては……ううむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "……あら、どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "あなたのご慧眼であればおわかりでしょう、グランドマスター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "昔の彼女とは……あまりにも、違います。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "――ふぅ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "めまぐるしいほどの技の応酬が、あの嵐のようなやり取りが、ここでついに！　初めて停止しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "この二人には、呼吸すらも必要ないのでしょうか！？　最早常人の為せる動きではありません！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……美しい剣技だ、ペガサスよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "それは光栄なことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……貴様は……この上なく血を沸き立たせてくれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "――伝説によれば、かつて若かりし頃のハガンは、金色の血を持つ一匹のペガサスに敗れたと云う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……私は、大いに興味があるのだ。その身の内に金色の血が流れるクランタなど、この大地に存在するのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "残念ながら、私の頬をつたう血は、ごく普通の赤色だがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……肩慣らしはこれまでだ、耀騎士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "我が天路への道は途絶えることなし。貴様が名ばかりの騎士でないなら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "瞬間、空気が凍り付いた。\nふと我に返ると、息をするのも忘れていたことに気付く。\nこれは、恐怖だ。\nしかしなぜ、恐怖を感じるのだろうか……？\n会場内にいるすべての観客……そしてすべての騎士たちは、異様な圧迫感を覚えていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "――この現実に道を譲ってもらうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "――ッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マーガレットは、初めて競技場で無意識の内にアーツを使った。\nその強烈な光は、まるで小さな太陽のように、果てなき闇夜を照らし出す。\nしかし――その目がくらむような光の中、若きナイツモラは、微塵も動じることはなかった。\n「騎士競技」とは、その名の通り、単なる競技である。\nだが、マーガレットが一瞬感じ取ったもの――それは、かつて強大な敵から感じたことのある気配そのものだった。\n天災、泣き叫ぶ感染者の声、響き渡る怒号、反逆者の流した血、そして死に際の足掻き。\n若きナイツモラは屍の山も血の海も経験したことなどない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "けれども、彼はその血筋によって、恐怖を支配する方法を生まれながらに理解していた。\nその、純粋なる血筋によって。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "（古代語）……若き狩人、天路を往かん♪　夢より出でて、黄金の彼岸へ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "（古代語）血族の血が矛を紅く染め♪　矛を握りて♪　緋色の哀悼に溺れ往く♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "悲壮な歌声が響く。\n古の物語を紡ぐ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……はァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "――っ、くっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "い、一体何が起きているのでしょうか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "これは何らかのアーツなのか～～！？　恐らくアーツらしい何かが放たれたあと、会場内すべての人が――何と申しますか――えー、何とも言えない感覚に襲われました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "おおっと揺れた揺れたぞ――！！　突如動き出した追魔騎士が、競技場全体を震撼させるほどの一歩を踏み出してーー",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "凄まじい一撃です！　あの耀騎士が為すすべもなく後退しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "チャンピオンの光すらも退かせるほどの悪夢が襲いかかる！　これほどの輝きを以てしても、悪夢の襲来は防げないのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……歓声が、上がらない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "みな……この感情から抜け出せずにいるのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……先ほどの一撃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "何か、気になることでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……凡庸な騎士であれば……確実に死んでいただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "えっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……奴は本気だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……やはり、実力は本物ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "……あの子は、単なる迷子にすぎないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "本当に可哀想にね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "……あら、どうしたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "（小声）な、なんだって！？　今やるのか！？　急すぎるだろ、本気かよ……！　どうしたもんかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "えー……突然ですが、ここで判定が下りました！　追魔騎士が……先ほど放ったアーツにつきまして、あー……「観客や審判に影響を及ぼした」と判断されたということです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "えー、これは騎士競技規則の第三条！　「競技騎士はいかなる場合にも、観衆の身体及び財産の安全を害し又は脅かしてはならない」というものと～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "第七条の「競技騎士はいかなる形でも審判の主観的判断を妨げてはならない」というものに違反する行為となります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "（くっそ～適当にこじつけたはいいけど、流石に無理があるだろ……あの連中め、タイミングくらい選んでくれよ……！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "この違反行為により、本試合はこれを以て終了といたします！　つきましては――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "――さあ、来い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "――光よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "集え。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "お、お～っと！？　これはどういうことでしょう！　両騎士にはこの判定が聞こえていないようです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "お二人ともー！　試合は中断となりました！！　両者とも互いに離れて、審判団の判断をお待ちください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "はあァッ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "おお……なんと美しき一太刀か……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……我が切っ先がその頭を割り砕くかに思えた刹那……よもや反撃してくるとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "生と死を、そして残酷な事物を目にしてきた貴様は、恐怖によって――私によって動揺を覚えることなどないのだろうな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "強大な敵も、打ち負かすことのできない困難も、決して恐ろしいものではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "この都市が今もさらけ出しているような、思考の麻痺と堕落に甘んじる姿の方が、あなたの「恐怖」よりも余程恐ろしいものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "誰か、二人を止めてください！　早く引き離して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "今のカジミエーシュには、私も嫌気が差していたところだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "――こい。我が恐怖を以て、この野次馬どもに、己が観賞せしものが何であるかを知らしめてやろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "――そこまでだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "――何……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "血影が一筋走り、大地を引き裂いた。\n突如現れた巨大な斧で、二人の間の地面が切り裂かれたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そこまでだ、と言っただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……試合は終わったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……あなたは……血騎士か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "な、なんと――！　誰がこの結末を予想できたでしょうか――止めることすらままならない、二人の戦いを制止したのは――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "「カジミエーシュの紅きゴブレット」！　英雄！　ディカイオポリスだァーッ！　彼の名前が覚えにくくとも、この光景は忘れられないものになるでしょう――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "カジミエーシュ騎士メジャーのチャンピオンにして、現在の人気ナンバーワン！　ミノスから来た戦神！　その名は血騎士――！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "（小声）ふぅ～、助かった……血騎士が来てくれて本当によかったな……今日の撮れ高もこれで十分だろう。おーい、誰か代弁者の顔色を見てきてくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……ディカイオポリス、なるほど、ミノス人らしい名前だ。彼が三年前に優勝したというあの感染者か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "血騎士の長刀を生で見たのは初めてですが、凄い迫力ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左腕騎士",
      "text": "……フン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "おおっ！　血騎士が競技場内にひらりと飛び降りましたっ！　そのまま、先ほどまで戦い続けていた二人のほうへ向かって行きます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "こうした光景は、一体何年ぶりのことでしょう！　二人のチャンピオンが今、同時に競技場に立っています！　これは実に興奮する一幕です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "もちろん、あとの一人も普通の騎士ではございません！　この試合で凄まじい実力を見せてくれた、カジミエーシュ最後のナイツモラが彼らと共に立っているのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "これを目の当たりにするだけでも、まさしく価千金というもの！　皆様この瞬間を是非ともその目に焼き付けてください！　これは間違いなく、歴史に残る瞬間ですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……貴様も、覇者の一人だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "――ナイツモラよ。貴様の次の相手は俺だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "そして「次」の対戦相手は、耀騎士、貴様だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……フッ……ハハハッ……私が負けるのは必定だとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "当然だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "単なる過去の幻影なんぞが、俺に勝てる道理があるまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "――では、感染者よ。決戦の日を待ち望んでいるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "……逃がすと思うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "追魔騎士",
      "text": "――ッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "……恐怖というのは、常に「今」だけに存在するものだ。よく学んでおくことだな、ナイツモラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "（あの角度からの一撃を、防いだ……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血騎士",
      "text": "また競技場で会おう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マーガレットは振り返り、巨大な斧で引き裂かれた地面を見た。\nそのさなか、血騎士は自らの斧を拾い上げる。\n地表の亀裂は、それが命ないものでありながら、血が滲んでいるかのように見えた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
