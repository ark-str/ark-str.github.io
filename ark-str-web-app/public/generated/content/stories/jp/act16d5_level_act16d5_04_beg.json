{
  "server": "jp",
  "storyId": "act16d5_level_act16d5_04_beg",
  "groupId": "act16d5",
  "stageId": "act16d5_04",
  "title": "女将",
  "storyCode": "WR-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16d5/level_act16d5_04_beg.txt",
  "sourceHash": "83df0da51ff11a920dc6359fa7bbcbbaceefad91f364d4ed5a5e77c9498031de",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "残っているやつはいないか？　早く先生のところまで逃げるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "東へ向かえ、急げ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……空に意識を向けるようになって改めて実感したんだが、ここでは本当に西へ行くほど夜に近づいていくんだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "つまり、私たちは今「正午から黄昏へ向かっている」のですね？　なんとも風情があるなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……だがやっぱりおかしい。「昼」から「夜」までの距離が短すぎるぞ。まだほとんど進んでないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "絵巻の長さは一定ではないし、景色も奇怪なものばかりである。絵の中の住人がその中で規則性を見出したとしても、突き詰めれば虚構のものに過ぎぬゆえ、考えてもどうしようもないでござるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "いや、でも――おい待て、今何て言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "へっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "今、絵がどうとかって――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うわあああ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "――！？　逃げ遅れた町民がいたのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ここだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "た、助けて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "お任せあれ、拙僧が相手つかまつる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "グオォ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "む……いつもながら、斬られた後で墨になるとは、奇怪千万。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "お坊様、なんとも素晴らしいお手並みで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ご油断召さるな、お嬢さん。早く東へ逃げるのだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "は、はい！　あなた方もお気を付けて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……どうやらかなりの数の町民が逃げ遅れてるようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "おそらくあまりにも急な襲撃であったがゆえ、間に合わなかったのであろう――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "お父さん？　お母さん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "あ、あそこに子供が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "まずい――早くこちらへ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "間に合わない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うぅ……うわあぁん……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "あっ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "うおっと、危機一髪！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ケガはないね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ううっ……ないけど……ううぅ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "さきほど……奴の喉を貫いたのは一体……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "クルースだ。さすが抜け目ないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "か、彼女は今どこに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "どうせ見つからないから探しても無駄だ。あいつがどこかで目を光らせてるってことだけ知ってればいいさ。まずは、町民が全員この夜の地から逃げ出せたかどうかを確認しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ほう、以心伝心とはよく言ったものだ。勉強になったぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うう……ぐすっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "こ、この子はどうするんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……その子を連れてここを離れろ。安全な場所へ送り届けてくれ、できるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "もちろん！　できますとも！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ですが……恩人様を置いて離れるなど実に忍びない！　あなた方と共に正義のため命を投げ出すことが叶わぬとは、どんなに口惜しいことで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "その子を煮傘さんのところへ届けて、もっかい戻ってくればいいだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "あはは……はぁ……分かりました。そうします、しましょうとも！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "お嬢ちゃん、お兄ちゃんと一緒に走れるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "う……うぅ……おじさん、お母さんがいないの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "よし、じゃあお兄ちゃんが君のお母さんを探しに連れていってあげよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "う……うん……ありがとうおじさん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……ゴホン。恩人様、では行ってまいります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "講談師",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "先生、サガと三人の英雄だけで、あれらに太刀打ちできるんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "講談師",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "講談師",
      "text": "……問題なかろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "町民A",
      "text": "先生はどうしたんだ？　機嫌でも悪いのか？　昨日寝てないとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民B",
      "text": "先生は優雅で温厚な方よ。そんな気分屋には見えないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民A",
      "text": "うーむ、きっと私たちの事を心配して疲れてしまったんだろう。少し眠った方がいいと勧めてみよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "六根清浄！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "煩悩を斬り捨てん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "油揚げ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガ、ガァッ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……やるじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "少々薙刀の心得があるゆえ……幼少より寺で育ち、知らず知らずに身に付いたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "その腕前で「少々」か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "お気になさるな。拙僧がラヴァ殿の為に道を切り開こう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガ……ガァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "化け物どもがオマエにビビってるぞ……というか、墨魎には知能があるのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガッ！　ガァ！　グァグァ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ほう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "どうして手を止める？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガッ！　ガガァ！　グァグァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ほう、ふむふむ、うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "おい！　奴らの言葉が分かるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "少しばかりな……ご覧あれ、この墨魎にはもはや敵意はござらぬ。もし心から悔い改め、二度と町に侵入して騒がぬというのならば、放してやろうではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガァッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……大丈夫なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "問題ない。拙僧の目に狂いはござらん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "あたりが静かになったな……もう他に町民も残っていないだろう。さて、話を聞かせてもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "話を聞かせてもらおうとな……ラヴァ殿、深刻な様子だが、拙僧は間違ったことをしでかしたのであろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "いや、そういうことじゃない。だけどさっき言ってた……絵巻？　その話を聞きたい。オマエはどうやら、ここについてかなり詳しいようだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "うむ。拙僧はこの地を行脚して、ずいぶん経つゆえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "この辺りに「行脚」するほどの場所なんてなさそうだけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ううむ。一幅の絵巻の大きさに限りがあるのは、仕方のないことでござるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "何の話だ……アタシたちは絵の中にいるとでも言うつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "いかにも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……どういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ああ、拙僧ようやく得心し申した……そなたたちも拙僧と同じく、この山河へ誤って踏み入ってしまったのだな――？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "はっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "当初、拙僧はただ勾呉の境界を通り抜けようとしたのだが、ふとした思いつきで、ある大家の子孫を訪ねてみることにしたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "通りかかった灰斉山の滝の麓は美しく、ほど近い場所に古ぼけた家があったので、そこで宿を拝借したのだ。そして眠りについて次に目を開けると、なんとここへ来ておったというわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ちょ、ちょっと待ってくれ。どういうことだ？　オマエも「シー」を探しに来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "シー？　そのような名は、初耳であるが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "拙僧が探しておったのは、「一筆にて拙山起こさば、何処にて風流を語らん」との評判で有名な、炎国の画家だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "しかし、長い年月が経っておるゆえ、すでにその画家はこの世におらぬかもしれぬ。それゆえ旧居を訪ねてみたいと思ったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "つまり、オマエも勾呉の灰斉山へ行き、なぜかここへたどり着いた――そういうことなのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "左様。たしかに相違ござらぬ。しかしそなたはどうしてそのように興奮しておるのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "オマエは、ここが絵巻の中だと言ったが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "天地も人も皆、道理から外れておるゆえ……ラヴァ殿は気付いておらぬのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "それは分かっていた。だが、どうして絵なんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "拙僧もはっきりとは説明ができぬが、この婆山町は、拙僧が今まで巡り歩いてきた……百余の絵巻の中の一つだ。少なくとも己自身がどこにいるかは、分かっておるつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "だが……ここの住民たちは、本当に生きてるみたいだろ。それに茶はうまいし、果物も食べられる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "これは何かのアーツの効果なのか？　だがもしこれがアーツだとしたら……一体どんな……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "それについては拙僧も、全く手がかりが掴めておらぬ。もし偶然、天地の真実を垣間見ることがなければ、拙僧も己がどこにおるのかに気づけなかっただろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ここでは天災に悩まされることもなく、皆自分なりの規則に従い、それぞれの仕組みを作り暮らしておる。なんとも至妙なり……拙僧がここに留まっているのは、心の安らぎのためでもあるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "な……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "はは、混乱しておるようだな。まあ無理もなかろう。拙僧が初めて夕娥（シーウ）に会うた時も、そなたと同じような状況であった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "待て……今誰に会ったと言った！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "拙僧が会うたのは――待て、あそこに灯火が……もしかして質屋の女将殿？　まだ避難していなかったのか、まずいぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "おい待て！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女将",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガウ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女将",
      "text": "……分かった分かった。そう興奮しないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女将",
      "text": "どうして町を脅かしに来たの？　彼女はなんて言ってた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女将",
      "text": "ああ……そう……やっぱりいつも通りなのね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "女将殿！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女将",
      "text": "……行って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "女将殿、無事か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女将",
      "text": "私は大丈夫よ……そちらの方は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "おお、こちらはラヴァ殿。噂の、外より参られた客人だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女将",
      "text": "これは、お目にかかれて光栄です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "この方は質屋の女将で、「レイ」殿だ。黎明の「黎」と書く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……奇妙な化け物たちに襲われてないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "いいえ、特に見ていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "レイ殿、墨魎どもがまた戻ってくるやもしれぬ。こちらに隠れて、見張っていても良いだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "……ええ、構わないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
