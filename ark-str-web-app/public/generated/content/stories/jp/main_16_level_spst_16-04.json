  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=1>ウルサス クライニ・セーヴェル境界 荒野</>"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "もう……走れ……ない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "ここ、までか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえる声",
      "text": "あそこに誰かいるようだが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえる声",
      "text": "様子を見てこよう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえる声",
      "text": "……いえ、私が行きましょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえる声",
      "text": "あれは苦難に見舞われた人であるように感じられます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "脱力、脱水、長時間の絶食……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたも感染者ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "ゲホッ、ゲホゲホッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "同胞、彼も同胞だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "どうか救ってあげてくれ。我々全員を救ってくれたのと同じように――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "再びあなたの奇跡を起こしてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "奇跡などではありませんよ……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "鉱石病は、彼がここまで苦しんでいる主因ではありません。私は病による痛みを和らげることはできても、飢えを満たしたり、綺麗な水を与え、安全な場所で眠りに就かせてあげることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は奇跡など起こせませんし、全能でもありません。ただ……信じているだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な声",
      "text": "あなたのそういう謙虚な姿勢は、みんなわかっていますとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……あの、私の声が聞こえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今から、あなたの手を取ります……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "「信じなさい、我らの命を信じて。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "「我らの身体と思考を、心臓が刻む一拍一拍を、肺葉が生み出す呼吸を。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "「我らを、あらゆる力の源を信じるのです。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これより、あなたは死への恐怖の中で生きる必要はなくなります。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "体内で急速生長する源石による痛みが、徐々に引いていく。\n彼にはまだその音が聞こえたが、もはや痛みにのたうつことはなくなった。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "あ――あんたは何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "あんたが助けてくれたのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "ゲホッ、ゲホゲホッ、ゲホッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "どうやって、お礼をすればいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ここにいる仲間たちと同じく、私のことは「ヒアダ」とお呼びください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "奇跡だ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "ヒアダは、また我々の同胞を救ったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "彼女は、俺たち全員を救ってくれたんだ。まるで母親のような手つきで、さっきあんたにやったように、触れただけであらゆる痛みを消し去ってくれた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "text": "ヒアダ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な声",
      "text": "ヒアダ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "多くの人の声",
      "text": "ヒアダ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "ヒアダ……ヒアダ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "はい、それが私の名です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "どんな姿をしているんだ？　あんたのことも、他の話してる奴の姿も、ぼやけている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "頭に傷がありますね。慌てて駆けてきたせいで、どこかでつまずいて、頭を打ったのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "脳内出血のせいで視界がぼやけているのかもしれません。大丈夫です、私たちが支えますから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "これからどこへ行くつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "text": "わからない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "ならひとまず、私たちと共に行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な声",
      "text": "あなたは私たちを、苦痛のない場所へ連れていってくれるんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "はい。皆さんが私と共に歩むことを望んでおられる限り……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "私たちが信じる限り。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
