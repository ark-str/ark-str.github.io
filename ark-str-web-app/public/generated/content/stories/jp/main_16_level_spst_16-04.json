  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=1>ウルサス クライニ・セーヴェル境界 荒野</>"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "うっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "もう……走れ……ない……"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ここ、までか……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえる声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "あそこに誰かいるようだが？"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえる声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "様子を見てこよう――"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえる声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……いえ、私が行きましょう……"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえる声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "あれは苦難に見舞われた人であるように感じられます。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "脱力、脱水、長時間の絶食……"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "あなたも感染者ですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ゲホッ、ゲホゲホッ！"
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "同胞、彼も同胞だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "どうか救ってあげてくれ。我々全員を救ってくれたのと同じように――"
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "再びあなたの奇跡を起こしてくれ！"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "奇跡などではありませんよ……はぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "鉱石病は、彼がここまで苦しんでいる主因ではありません。私は病による痛みを和らげることはできても、飢えを満たしたり、綺麗な水を与え、安全な場所で眠りに就かせてあげることはできません。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "私は奇跡など起こせませんし、全能でもありません。ただ……信じているだけです。"
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "あなたのそういう謙虚な姿勢は、みんなわかっていますとも。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……あの、私の声が聞こえますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "今から、あなたの手を取ります……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "「信じなさい、我らの命を信じて。」"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "「我らの身体と思考を、心臓が刻む一拍一拍を、肺葉が生み出す呼吸を。」"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "「我らを、あらゆる力の源を信じるのです。」"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "これより、あなたは死への恐怖の中で生きる必要はなくなります。"
    },
    {
      "type": "narration",
      "text": "体内で急速生長する源石による痛みが、徐々に引いていく。\n彼にはまだその音が聞こえたが、もはや痛みにのたうつことはなくなった。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "あ――あんたは何者だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "あんたが助けてくれたのか……"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ゲホッ、ゲホゲホッ、ゲホッ――"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "どうやって、お礼をすればいい？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ここにいる仲間たちと同じく、私のことは「ヒアダ」とお呼びください。"
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "奇跡だ――"
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ヒアダは、また我々の同胞を救ったんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "彼女は、俺たち全員を救ってくれたんだ。まるで母親のような手つきで、さっきあんたにやったように、触れただけであらゆる痛みを消し去ってくれた！"
    },
    {
      "type": "dialogue",
      "speakerName": "熱に浮かされた声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ヒアダ！"
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ヒアダ。"
    },
    {
      "type": "dialogue",
      "speakerName": "多くの人の声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ヒアダ！"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ヒアダ……ヒアダ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "はい、それが私の名です。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "どんな姿をしているんだ？　あんたのことも、他の話してる奴の姿も、ぼやけている……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "頭に傷がありますね。慌てて駆けてきたせいで、どこかでつまずいて、頭を打ったのでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "脳内出血のせいで視界がぼやけているのかもしれません。大丈夫です、私たちが支えますから……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "これからどこへ行くつもりですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者坑夫",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "わからない……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ならひとまず、私たちと共に行きましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "敬虔な声",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "あなたは私たちを、苦痛のない場所へ連れていってくれるんですよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "はい。皆さんが私と共に歩むことを望んでおられる限り……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "私たちが信じる限り。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
