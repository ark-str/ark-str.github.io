{
  "server": "jp",
  "storyId": "story_milu_set_1_story_1",
  "groupId": "story_milu_set_1",
  "stageId": null,
  "title": "途上",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_milu_1_1.txt",
  "sourceHash": "e4ba61819cc976e362af60832bd63ff7b8b73f342f573906a52e99d58dc88d46",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "彼らは私に言った……全部終わった、と。\n故郷、戦友、すべてが埋葬された、と。\nでも私は知っている。すべてはまだ始まったばかり、だと。\n……私は今、その途上にいる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 4:50 天気/曇天\nカジミエーシュ北部の町"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "ほらよ、パンと水だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "本当に大したもんだぜ！　たった一人であの気味の悪い鉗獣どもを追い払……いや違うな。滅ぼしちまうなんて。まだ若いってのに、たった数時間で一仕事、終わらせちまった。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "町の若いもんが総出でかかっても駆除できなかったってのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "正直驚いちまったよ。こんな小さな町だから話はいろいろ耳に入ってくるが、あんたみたいに容赦なくやる奴は見たこともないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……これは、いらない。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "ん？　食い物はいらないのか？　なら……そうだ、薬もあるが。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "これだ。以前キャラバンがここを通った時、みんなで色んなものを持ち寄ってやっと交換してもらった代物なんだ。それなりの価値はあるはずなんだが……"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "あんた、怪我してるんだろ？　見た感じ、結構ひどいもんだし。この薬、使ってくれよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "必要ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "な、ならどうやって礼をすればいい？　金か？　悪いんだが、それは無理だ。こんな小さな町にも小悪党が数日おきにやってきてあれこれと持って行っちまう。周辺には野獣もいる……"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "みんな、一年中すっからかんなんだ。金なんか一銭もないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "おととい、黒い服を着て、クロスボウを持ったクランタがこの辺に来たという情報がある。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "そいつがどこにいるか、教えてくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "クロスボウか。狩人なんて見かけなかったがな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……殺人に使うクロスボウだ。狩猟用ではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "ひ、人を？"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "冗談、だろ……？　いや、マジか……ゴホンゴホンッ、そんな奴がこんな小さな町に来るわけないじゃないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "嘘をつくな。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "そそそそ……それは武器か？　あ、あの、お、怒らないでください、あなたが言うような人は本当に見てないんです、誓います――"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ここに来る前に立ち寄った村の住人は、見た、と言っている。そいつはこの町の方向に向かった、と。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "も……もしかしたらこの町は通り過ぎただけで、南の方に行ったのかも……南にはもっと大きな町があって、そこなら食べ物も、きれいな水も、何でもそろってますから……"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "あぁ神様！　お嬢さん、どうか俺を信じて……本当に嘘をついていないんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュの村人",
      "speakerId": "avg_npc_005",
      "text": "ほ、ほら……うちの有り金です。本当なら年末の税金に充てるつもりでしたが……これしかないですが、持って行ってください。全部差し上げますから……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "必要ないと言っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……もういい、行け。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……また収穫なし、か。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "まあいい、こうやって可能性を一つずつ潰してやれば……隠れる場所もなくなるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "いつまでも、どこまでも追い続けてやる――お前たち一人一人を、全員を見つけ出すまで。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ん？　これは？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……パン、水、薬。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "あんなに怖がって尻尾を巻いて逃げて行ったのに、わざわざここまで渡しに来たのか。律儀なことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "感謝を伝えたかったのか。鉗獣数匹程度、大したことなどないというのに……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "なんだか……あの時のことを思い出すな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "おじいちゃん、あの人たちは誰？　みんなが言ってた騎士様なの？\n……違うの？\nあの人たちが持ってるのって、私たちをいじめる悪い人たちのと同じやつだよね？\n……こ、怖いよ。\nでもあの人たちはいい人なんでしょ？　私たちのために悪い人を追い払ってくれたんだもん。\n私、お礼がしたい！\nあんまりいいものはないけど、このクッキーでも大丈夫かな？　大事に食べようと思って半分に割ってとっておいたんだ。あとハーモニカも吹いてあげられるよ。\nうーん、あの人たちがずっといてくれたらいいな。\nみんなと一緒に、ずっと暮らすの。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "今、残ってるのはこのハーモニカだけだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "騎士様？　フッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "あの時にしろ、今にしろ……どこも同じ、か。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "もしあの人たちがまだいてくれれば……もし……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "だが……もしはないんだ、もう。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "おいおい、こんなとこにいいカモがいるじゃねえか！"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "おお、おまけに食いもんまであるぜ。結構あるな――大したもんでもねえが、夜食ってことで、まあ我慢してやるか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "消えろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "あ？　俺に言ってんのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "こいつはここに置いてあったんだ！　名前でも書いてあんのかよ？　お前が食ってるとこも見てねえ。今、俺が見つけたんだ。だからこいつは俺のもんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "分かった。いいだろう……欲しいものを持って、早く消えろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "へへ、これだけじゃ足りねえな。その手に持ってるのは……ハーモニカか？　ま、おもちゃだろうが街に持って行けば、暇な物好きが気に入って買うかもしれねえ。それもよこしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "これは、お前が触れていいものではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "おぉ、怖い怖い。……怖いねぇ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "だが、小娘？　お前、俺を誰だと思ってやがる？"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "しかもお前、そんな細いナリして、長いことロクなもん食ってないんだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "警告する――ゴホッ、ゴホゴホッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "ヘヘ、なんだ体の具合が悪いのか。まあいずれにしろ、俺様にかかればよ、指一本でつつくだけでもお前を倒せそうだぜ？"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "そいつは何だ？　俺を脅そうってのか！？　こんな暗がりなら木の枝を持ってるだけで人を脅せるとでも思ってんのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "私は警告した。聞かなかったのはお前の方だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "おいおい――まてまて。そいつは……クロスボウか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "わかってるならさっさと消えろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "今夜は人を殺したくない気分だ、少なくとも今はな。だが、気分というものは変わるものだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "わ、わかった！　これ全部返すから、勘弁してくれ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュのごろつき",
      "speakerId": "avg_npc_002",
      "text": "今すぐ消える！　消えるからよ！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ううっ……ゲホゲホッ、ゴホゴホゴホッ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……誰だ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ゴホッ、ゴホゴホゴホッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "まだ……倒れては……だめだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "私はまだ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まだあの裏切り者たちを、見つけ出していない。\nその日が来ない限り、彼らが安らぐことはない――\n私も永遠に止まることはできない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_012",
      "text": "おい！　大丈夫か！？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_012",
      "text": "意識がないってわけでもないようだが……自立は無理か。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_012",
      "text": "身元確認……うん、情報と一致している、恐らくターゲットに間違いない。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_012",
      "text": "ひどい怪我のせいか体温が高い。しかも栄養失調の症状もある……ろくに食事も睡眠もとれていないんだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_012",
      "text": "栄養剤……うん、あと応急処置用の薬剤も……来る時にたくさん用意しておいてよかった。ケルシー先生は本当に、いつも何でもお見通しだな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_012",
      "text": "目、覚めたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "誰だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "何もしないから落ち着いてください。敵意はありません。俺はロドスという製薬会社の社員で、このエリアで外勤をやっています。見てください、俺の社員証です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "それは何の説明にもならない。身分証などいくらでも偽造できる。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "確かにそうですね。はは、聞いてた通り非常に警戒心が強い方だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "聞いてた？　誰からだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "おっと、もっと警戒させましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "まあ信じてくださいよ。俺は本当に悪い奴じゃないんです。ほら、まともな武器の一つも身につけてないでしょ。せいぜい野獣から身を守る程度の装備ですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "あなたは立派なクロスボウをお持ちだ……ほら、ちゃんとあなたの手が届くところに置いてあります。俺が悪い奴なら取り上げてますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "どうです？　とりあえず俺と話をしませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "もし余計なことをしたら、この森に入ったことを必ず後悔することになるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "わかってますよ。あなたのクロスボウはどう見てもおっかない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ならば答えてもらおう、誰が私の情報を流した？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "それは……えーっとですね……"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "エラフィアの年若い女性が、最近ずっとカジミエーシュ北部の村々を訪ねて、色んな人にある人物たちの行方を聞き回ってると、たくさんの目撃情報がありましてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……獲物を追うことに夢中で、足跡を残してしまっていたか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "以前の私ならこんなミスは……だがもう今さらだ。どうでもいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "それで、誰の指示で、私に何の用だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "会社の指示です。さっき紹介したように、ロドスは製薬会社で、広い業務範囲をもっており、常に我々にふさわしい人材を求めています。あなたにも俺たちの仕事に加わってほしいってことですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "製薬会社？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……さっきお前は私に薬を使ったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "栄養剤と簡単な応急用の薬剤を少しだけ、です。俺は医療スタッフではないので、詳しい検査やそれ以上の治療はできませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "ふむ……だいぶ顔色が良くなりましたね。どうやら怪我もそこまでひどくないようですね。でもきちんとした検査と治療をするなら、やはり俺と一緒にロドスに行ってみませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "私を雇うために治療をしたいと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "事前に調査してあるならわかってるだろう。私にできるのは戦うことだけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "医療に関して私は何もわからない。製薬会社が傭兵に何の用だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "えーっと……それはですね……さっき説明したように、ロドスの業務は多岐にわたります。あちこちを頻繁に移動し、様々な人とやり取りする必要があるんですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "その過程で突発的な事件が起こることはよくある話なんですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "そういう時に、あなたみたいな特殊な人材が、ロドスの力になってくれるとありがたいんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "人だろうと組織だろうと、生きる、ただそれだけのためにも力が必要だということか……"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "はい、あなたならおわかりでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "だが、私の力にはすでに別の使い道がある。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "あなたが探してる人物たちのことですよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "そうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "奴らを見つけるまで、私は歩みを止めたりはしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "……あなたの過去に何があったかは知りませんが、なんとなくわかります。その点については問題ありません。俺たちロドスの内部にも、他の目的を持っている方は多いですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "そうなのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "会社も俺たちも、個人的な事情については干渉しません。任務時間外は、みんな自由です。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "それだけじゃなく、規則に反しない限り、希望のものがあれば会社が提供してくれます――医療サービスだろうと、重要な情報だろうと、必要な力だろうと。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "これが多くの人たちがロドスへの加入を選択する理由です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ならば、私が探している奴らも……"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ロドスは探すのを手伝ってくれるというのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "はい。えーっと、他のことは今ここで確約できませんが、人を探すということに関して言うならば、あなた一人でカジミエーシュ中を回るよりは効率的にできると思いますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "全部一人でやろうとして、無茶なこともありますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "……実際、今のあなたは気合だけで歩いてるようなもんです。そのクロスボウ、持ってるだけでも辛いでしょ？　何をするにも体が一番大事ですよ。見つける前に倒れたら本末転倒だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "それに、なんて言うか、何かをする時、ただ単に生きていくことだけでも、一人よりたくさんの人と一緒の方がいいんだと思いませんか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "（誰の助けもなく、自分一人に頼って生きて行くしかない……そうした日々が、自分には普通になっている。）"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "（だが頼るものがあるあの暖かな感覚を……懐かしいと思わないといえば嘘になる。）"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "（そうだ。助けがあれば、たしかに今よりは……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……いいだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ロドス……製薬会社。私の正義に反することはないな？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "その点については、安心してください。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "わかった。力を貸してくれるのなら――"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "私も礼を尽くそう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "ロドスに加入しよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "よかった！　さっそくロドスに行きましょう。詳細はそこで人事の者と話してください。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "手続きが完了したら、あなたは晴れてロドスの一員です。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "avg_npc_012",
      "text": "少し早いですが、言ってしまってもいいでしょう。これからよろしくお願いします。えーっと……？　そういえばお名前を聞いてませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "……ファイヤーウォッチ。そう呼んでもらおう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "過去、現在、未来……この身がどこにあろうと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "裏切り者を見つけ、復讐を果たすまで――"
    },
    {
      "type": "dialogue",
      "speakerName": "ファイヤーウォッチ",
      "speakerId": "char_158_milu",
      "text": "私は……この名を名乗り続けるだろう。"
    },
    {
      "type": "sceneBreak"
    }
  ],
