{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_03_end",
  "groupId": "act17d0",
  "stageId": "act17d0_03",
  "title": "セーフハウス攻防戦",
  "storyCode": "OD-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_03_end.txt",
  "sourceHash": "94264c0226d37feebb978ef06c89c8c505602a9706d289d37b02360af86a7c1d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "雷鳴よ……轟け！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "うああああ……目が！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "術師はどうした！？　あのヴイーヴルを殺れ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "させないわよ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "どういうことだ！　新手だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "どうなってやがる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "マズい、こいつらの火力はヤバすぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "こんな所で余計なケガをするな！　ひとまず撤退だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "……丸見えですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "うわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "狙撃手に気を付けろ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "クソッ、どこだ！！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "探すのはやめだ！　撤退する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "……逃しません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "撤退！　さっさと撤退しろ！　他に構うな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "逃げた！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "情況を報告！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "アレクサンドル、大丈夫か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ああ、かすり傷だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "あいつら、賢くなってやがったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "警戒を解かないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "他にも人がいる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "それ以上、近寄らないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あんたたちの助太刀には感謝してるけど、お互いに状況がハッキリするまで、安全な距離を保ちましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そう身構えないで、敵意はないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしたちはロドスの外勤小隊よ。あなたたちが今いる場所はうちの会社のセーフハウスなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしたちは救難信号を受けてやってきた仲間ってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あなたたちが何者か教えてくれないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ひとまず落ち着いてください。わたしたちは助けに来たんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あんたたちが、ロドスの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "おいおい、本当に援軍が来たのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Blitz、オクフェンさんを呼んできて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "ロドスのオペレーター？　助かった！　助かったんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "具体的な状況を説明します……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "………つまり、最終的にあの四人の傭兵が、ここを一時的な防衛拠点としたというわけじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "申し訳ありません、通信機を壊され、セーフハウスも守れないなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "今、クビだと言われても、何も文句は言えません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "案ずるでない、儂におぬしをクビにする権利はないからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "それにこの様子を見るに、ここまで耐えてだけで立派な戦果じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "おぬしの判断がなければ、この感染者たちの運命はもっと悲惨なものになっておったじゃろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "今、ここにはどれほどの感染者がおる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "外のあの医者を含めて合計四十三人。全員、感染者です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "つまり、あの四人の傭兵さんがずっとここの感染者たちを守ってくれてたってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "率先して感染者を守る傭兵など、今時、珍しいのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "感染者に対して差別意識がなくて、むしろ率先して感染者を守る傭兵ねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしの疑い過ぎかもしれないけど、そんな聖人が本当にいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "じゃがあの者たちには、感染者を守ったという意識すらないように見えたのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ただ罪なき町民を守っただけのような口ぶりじゃったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "感染者を「差別してない」というより……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "「鉱石病なんて気にしてない」って感じよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ですが、彼ら自身が感染者というわけでもなさそうでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "彼らのような傭兵は見たことがありませんし、「レインボー小隊」という名前も初耳です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "みんな銃を持ってるけど、どっからどう見てもサンクタ人じゃないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "サンクタ人が「蛍光灯」をしまう方法を編み出したんなら、話は別だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "サンクタ人でもない傭兵が、全員大型の銃器を装備してるなんて、そんなの絶対ビッグニュースになるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……BSWの装備開発部の人たちが知ったら、絶対発狂する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "……「レインボー小隊」の皆さんがそばにいないからと、陰で人のことをとやかく言うのは止めた方がよろしいかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "何はともあれ、彼らがロドスのオペレーターを救い、感染者を保護してくれたことは事実じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "彼らが何かを企んどる証拠がないのなら、儂らも彼らを疑うべきではなかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "当面の急務は、この窮地をどう切り抜けるかじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "まずは彼らと話し合うことじゃな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "彼らがセーフハウスに入ってから、もう何分になる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ロドスとかいう連中のこと、お前はどう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "実はずっと気になっていることがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "どんな製薬会社や医療会社が、辺境の町に武器いっぱいのセーフハウスを建てる必要があるというの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "あそこには、一個分隊が武装できるだけの量があった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "それにその「製薬会社」のオペレーターは、どいつもプロの武装戦闘員みたいだったしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "この世界で医者になるには全身武装する必要があるか、それとも製薬会社なんてのはただの見せかけか、もしくはその両方か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "彼らは武装していたうえに、よく訓練されているみたいだった。それに言っていることも実に適切だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あたしたちがこれまで遭遇してきた、見た目だけの奴らとは違うみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "それに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あたしの錯覚かもしれないけど、彼らからは馴染み深い雰囲気を感じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "俺も同意見だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "少なくとも彼らは道理の通じる文明人であることに間違いはない。これまでこの世界に対する俺の印象は、盗賊の類いが至る所にはびこる黙示録の世界だったからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "傷の手当てが終わりましたよ、アレクサンドルさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ありがとう、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "先生、先生はロドスという組織を知っていたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……キャラバンから話を聞いたことがある程度です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "彼らは感染者治療の専門組織で、鉱石病の研究機関でもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "でもその病気は治らないんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "実は過去に「鉱石病を治療できる」と公言していた人は数多くいるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "ですがそのほとんどがペテン師で、みな嘘が見破られて悲惨な結末を迎えました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "ごくごく一部の人たちは確かに「鉱石病の症状を抑制」して見せましたが、それを「鉱石病を治療できる」と大げさに言って、高い薬代を請求してきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "そんなことだと思ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "以前聞いた話ですが、ある領主の娘が鉱石病にかかってしまい、その領主は娘を救うために、クルビアから抑制薬を高値で買い取り続けたそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "数年後、領主は財産を使い果たし、彼の娘も苦しみの中亡くなったとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "でも、これを見てもらえますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "これは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "これはセーフハウス内に用意された鉱石病抑制薬です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "ここ数日、病状が芳しくない人に投薬しました。確かにこれまで見たどんな製品よりも抑制効果があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "こんな薬……きっと非常に高価だと思いますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "オクフェンさんはそんなことも全く意に介さず、鉱石病の病状が深刻な人がいると伝えると、一箱譲ってくれたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "この大地に善人がいないと信じてるわけではありません……しかし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "へっ、まさかロドスがそんなにご親切な奴らだったとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あんまり考え過ぎる必要はないわ。疑いの感情は表に出しても出さなくても、これからの話し合いに利益をもたらさないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "とはいえ……互いの目的が一致しているならば、正直に思っていることを話して構わないと思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "おっ、出てきたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "申し訳ない。待たせてしもうたかのう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "堅苦しいあいさつは抜きにさせてもらうぞい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "オクフェンを救っていただいたことに感謝する。おぬしらの協力がなければ、責任感に満ちたオペレーターを一人失っておったじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "今回の任務が終わりしだい、このことについてはわが社の上層部に報告させていただく。ロドスからおぬしら四名に相応の謝礼が贈られるじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……謝礼ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "それはありがたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "それとじゃ。おぬしらが身を挺して感染者を守ってくれたこと、敬服の念に堪えぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ここの町民たちにはあたしたちも随分と助けてもらった。見殺しにするのはあたしたちのポリシーに反するのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "つまり……皆さんは傭兵なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "いや……あたしたちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "ああ、そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "俺たちは傭兵だ。めっちゃ高額のな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "所属する会社を教えていただけますか？　あなたたちのような優秀な傭兵はめったに見ないもので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あー……俺たちは……えーっと、だな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "（ロシア語）なんか考えてくれよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "（ロシア語）白熊急便とか言ってみたらどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "差し支えがあるなら結構ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "お……俺たちははるか遠くの国から来たんだ。み……南の方だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "そう！　俺たちははるか南から来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "南？　サルゴンの南じゃと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "フェーンホットランドを越えてかのう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "フェ……そう、その辺から来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "フェーンホットランドを越えた先に国があるのか？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "これはなんと……衝撃的じゃな。この歳になって初めて聞いたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "サルゴン首長の歴史記録にも、干ばつの地を越えて人がやってきたという記録は存在しておらぬものでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "（ロシア語）でっち上げるならもっとリアルな話にしろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "（ロシア語）お前の白熊急便のどこがリアルなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "とにかく、じゃ。ウルサスとヴィクトリア訛りで喋る戦士たちよ、おぬしらがどこから来たかは重要ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "おぬしらは感染者のために戦った。この一点で、儂らは同じ方向を向くことができると思うのじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "少なくとも今は、手を取り合って困難に立ち向かうことができると思うとるんじゃが、どうじゃろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "その意見には賛成できる、ご老人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ならば、どなたか教えてくれんか？　町で一体何が起きたんじゃ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "サルカズ傭兵……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "モンスターを操っていたのは、恐らく術師ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "組織的で規律がある、と。さらに注目すべきは、情況が不利と判断するや撤退したことですね。単なる突発的な略奪ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "奴らの装備は万全で、どれもクルビア産の軍備だったわね。セーフハウスを守った時、何人かの手練れも見たわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "あの装備と戦術……「レッドラベル契約」に合意した、プロの傭兵かと思われます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "恐らく領主を相手どった反乱じゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "でもそれがどうして一般人を襲うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "奴らは感染者地区からあたしたちをたどって、ここまで来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あの傭兵たちの目的は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "一番の可能性は口封じでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "恐らくそれだけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どうしてですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あいつらが昨日感染者地区を襲った時、病人たちに突っ込んでいったのを俺たちは目撃している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "奴らはあの病人たちを連れ去ろうとしていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "俺はそれこそがあいつらの目的だと思うね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "感染者の……拉致？　誘拐？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そんなことして何になるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "敵の目的はハッキリせぬが、それを考えても答えは出ん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "今一番の方法は、待つことじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "待つ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "今のところわからぬことだらけではあるが、確実に分かっていることを踏まえた上での最善策じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "儂らは武器を所持したまま、首長の領地に許可なく踏み入ってしもうた。首長の戒律であろうと、この地の法律であろうと、サルゴンの禁忌を破ってしまっておるんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "町の貴族は戦争で手が回らんのじゃろうが、それでもこの地における統治はいまだに存在しておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ここで儂らがうかつに動けば、状況は更に悪くなるばかりじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "この地の領主は感染者地区を設けておる、それすなわち領主が残虐無情な人物ではないということじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "更に、領主はロドスがここにセーフハウスを建てることを許した。すなわち領主は閉鎖的な者ではなく、多少なりとも聞く耳を持っているということじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "そのような領主ならば、儂らに対して公正な判断をしてくれるに違いない。そう儂は信じとる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "国の法律……地方政府……そうね。何とかいい方向に向かうことを願うしかなさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "そうじゃ。だからこそ、状況がさらに変化するまでは、このセーフハウスを守りながら、町の騒動が収まるのを「待つ」のが最善策というわけじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "おぬしらも力を貸してくれると嬉しいんじゃがの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "その場合、あたしたちもロドスの支援を受けられるのよね？　だったらその話、受けるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "もちろんじゃ。皆、改めてよろしく頼むぞい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
