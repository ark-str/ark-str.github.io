{
  "server": "jp",
  "storyId": "act23side_level_act23side_02_end",
  "groupId": "act23side",
  "stageId": "act23side_02",
  "title": "黄砂の荒波",
  "storyCode": "WB-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act23side/level_act23side_02_end.txt",
  "sourceHash": "0f3637680e3fc26ec20225a0c60a535cfbd23cbd7122c34b627d413d5449842a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "腕白な子供",
      "text": "お母さんお母さん、見て、あっちで喧嘩してる人がいるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい女性",
      "text": "何を興奮してんだい。面白いもんでもないよ、交渉がうまくいかなくて喧嘩し始めたんだろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい女性",
      "text": "それよりしっかりついて来な。ここで迷子になったら、見つからない可能性の方が高いんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ズオ公子、連中はそう簡単に諦めちゃくれませんよ。おれたちの身の安全はともかく、このままだと一般人を傷つけかねません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……リーさん、何か良い案でも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "逃げる方法ならあるにゃありますが、ただそうするってーと、後々ズオ公子が泥を被ることになるかもしれません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "待っ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "（しまった、間に合わない――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆メンバー",
      "text": "（うめき声）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "「武術」が卓越しているというだけではない。生死のやり取りの中で得た確かな経験が、その大雪を降らせたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "チュー・バイ",
      "text": "まだ続けるつもりか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山海衆メンバー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チュー・バイ",
      "text": "追ってはいけません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チュー・バイ",
      "text": "市場は人が多すぎます。賊人は後先を考えぬ輩です。下手したら罪のない一般人を傷つけるおそれがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "（荒い息切れ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "チュ、チューお姉さん……お久しぶりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チュー・バイ",
      "text": "ええ、久しぶりですね。それなのに、なぜあなたの腕は大して進歩していないのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "チューお姉さんはなぜここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チュー・バイ",
      "text": "宗師からあなたを手伝うよう言われました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チュー・バイ",
      "text": "こちらの方は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "以前任務中に知り合った友人で……リャン・シュン様の旧友でもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チュー・バイ",
      "text": "リャン様のご友人であろうと、官職に就いていないのであれば、この件に首を突っ込むべきではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "誤解ですよお嬢ちゃん、おれはただ通りかかっただけでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "まっ、そう言われてみると、依頼をこなしてるときは、いつも他の誰かに余計なことをするなと釘を刺されるんですよねぇ。これも私立探偵が仕事をするうえのお決まりみたいなものなんですかねぇ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "リーさんの助力がなければ、私の命は危うかったかもしれません。ただ……リーさんは本当に偶然ここへいらっしゃったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "本当に偶然だって言って、司歳台は信じてくれますかねぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "事は重大なんです。冗談はやめてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "はぁ、普段から面倒事ってのが何より嫌なんですけどねぇ。それなのに、いっつも向こうからやってくるから始末が悪いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "強いて何かもっともなことを言うなら、おれに依頼をしたその方も龍門のウェイ長官の顔馴染みでしてねぇ。昨晩の軍営で、皆さんすでに顔を合わせてると思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "その方がおれに探すよう依頼したのは、十中八九、たった今ズオ公子を襲った連中でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "昨夜に玉門で起きた事件について、リーさんはほかに何をご存知なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "多くはありませんね。私立探偵に依頼をする人ってのは、ほとんどが話せない事情を抱えてますしねぇ。おれも慣れちまいましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "もしズオ公子が、ちーとばっかし情報を教えてくれるんなら、おれもまだ力になれるかもしれませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "昨夜の混乱の中、私は刺客に刀傷を負わせました。ですから手始めに医館から調査を始めたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "都市内の医館はほぼ調べ尽くし、どれも異常はありませんでした。ただ先ほどの一軒だけが、医館の下働きと自称した男が調査の邪魔をして、どうしても中に入れてくれなかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "私は無理やり押し入って、部屋でガーゼと血痕を見つけました。するとその男は色を変えて、急に飛び出して行ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "この玉門で、司歳台の調査を妨害するような奴が本当にいるんですかい……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "私も不思議に思います。故意に調査妨害をすることはすでに犯罪行為ですが、あの男の言動はとりとめがなく、何か企んでいるようにも見えませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ズオ公子、その男の容姿をもう少し詳しく教えていただけますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "ええと、あの変な大男は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "フェリーンの男性で、年齢はおおよそ四十から五十くらいだと思います。大柄で……異常なまでの武術の使い手でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "本当にあいつなのか……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "亡くなった仲間のご遺族を訪ねるのが、ユーシャ姉の頼みです。急がないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "もうやってるでしょ。それに残るは最後の一軒なんだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ドゥさん、まだ聞いていませんでしたが、どうして玉門へ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "前に話したはずよ。玉門には、自分の物流会社を立ち上げるために来たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "テイさんが娘さんも玉門に行くと言っていましたが、まさか本当に会えるとは思ってもみませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "縁ってやつね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "となると、もう一緒に事件の調査をしてることだし？　そのまま行裕物流に入ってくれるのも当然の成り行きよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "まだそんなことを言ってるんですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ドゥさんだけじゃなくて、ユーシャ姉も……今回の件は、本当に多くの知り合いが関わっていますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あのお役人様って、鼠王の娘だったのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "リンさんともお知り合いなんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "知り合いとまではいかないわ。父さんが各地を渡り歩いてた時に、鼠王の評判を聞いたことがあるだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あんたたちみんな龍門人だから、てっきりお互いのことをよく知ってるんだと思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "龍門は大きいんですよドゥさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "探偵事務所の仕事の関係で、リンさんにはたまにお会いすることもありますが、ユーシャ姉に関しては、噂を聞く方が多いですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "ねぇ、龍門人にとって鼠王は一体どんな人なの？　かなり興味があるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "「龍門人」という言い方をすると、範囲が広くなりますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ある人たちからすれば後ろ盾、他の人たちからすれば手出しできない大物の場合もありますし、ただの優しいお年寄りだと思っている人もいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ですが一つ確かなのは、龍門の安定が、鼠王とは切り離せないことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "聞いてるだけでもすごい人物ね……そんな父親がいたら、娘の生活もきっと大変なんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "どうしてです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "当たり前でしょう？　世の父親なんてみんな同じよ。子供にはおとなしく自分の敷いたレールに沿って歩いてほしいってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "自分が成功した人ほど、そうしようとするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ドゥさんは、お父さんと仲が悪いのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "悪いとは言えないわ。そこまで親密でいたくない仲って言った方がいいかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "では、自分の子供のことなんて少しも気にかけない父親もいることを想像できますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "自分の気持ちだけに従って好き勝手、行き当たりばったりに行動して実の子の面倒も他人に押し付け、全く気にもかけずに十年以上姿を消したまま、そういう父親です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "それって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "やめましょうか、今はあの人の話をしたくありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "もしテイのじじいが十数年も行方をくらませたら、あたしが鏢局を引き継いで、自分の考えに基づいてゼロから経営してやるのにちょうどいいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "じじいに見せてやるわ、あたしの方が、あんたよりはるかに上手くできるってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ですが、もしその父に、あなたがどれだけうまくやっているかを見に戻ってくる気が全くなければ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "えーっと、ここよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "すみません、誰かいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "お邪魔します、私たちは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "あれ、鍵が掛かっていませんね。医館の中に、誰もいないんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "ここが四軒目よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "犠牲になった鏢師はこの医館の医者の息子らしいわ。医者は現地の人間で、この医館を数十年経営して、親子二人で助け合って生活してきたそうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "信使部隊が亡くなったという知らせは、昨日の午後に都市内に伝えられたから、ここのお医者さんも知ってるはずだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "でも、室内に変わった様子はありませんね。物は整頓されていて、机や椅子もきれいに拭かれています。隅にある二つの袋は、市場で買ってきたばかりの日用品でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "玉門ではどういった習慣なのか分かりませんが、この家は……何も起きていないかのようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "自分の子供が永遠にこの世を去ったと知ったら、父親というのは、どのような反応をするのでしょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "少なくとも、何も起きていないような様子ではないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ですが家には誰もいません……こうやって勝手に入るのもあまりよろしくありませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "まずはユーシャ姉と合流しましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "お嬢様、前方に見えるのが、例の密輸犯が言っていた倉庫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "妙ですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "あなたはこの場所を知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "前に玉門を秘密裏に探っていた時に、都市内の輸送ポイントを一つ一つ調べたことがあります。この倉庫は、確か街の南の鋳剣坊が鉄器や源石燃料の保管に使っていた場所です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "俺が調査した資料だと、この鋳剣坊は街に古くからある店で、今回の件と関係あるはずは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "あの*龍門スラング*、よくも俺たちを騙しやがったな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "待って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "焦る必要はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "あそこまで詰めたのよ。嘘をつく度胸なんてないでしょう。現場に来たからには、問題があるかどうかは見ればわかることよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "ここを見張ってなさい。私が見てくるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "お気を付けください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "お嬢さん、来る場所間違ってませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "あら、石刻店の倉庫じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "石材を買いに来てあげたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "あなたたちの店主が市場で売ってた彫刻は、作りが雑だったけど、石の品質自体は悪くなかったわ。だからまとめて仕入れたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "店主からも、直接倉庫に行って見学する許可は貰ってるわ。話を聞いてないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "鐘記石刻店ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "そんな名前だったわね、市場の一番東側にあるお店。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "鐘記石刻の倉庫だったら城西にあります。ここは南ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "これ以上、奥へ行く必要はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "辺りを見てください、どこも銑鉄や鉄くずばかりで、石材なんてありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "場所を間違えましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "道案内にやられたわ。あいつ案内料まで受け取ったのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "ごめんなさいね、お邪魔したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "いいですよ、外まで送ります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "空に浮かぶ雲の層が位置を変えて、急に日差しが強くなった。肌を焼くかすかな痛みを感じたユーシャは、無意識に首の後ろをなで、そして顔を上げて目の前の人を見た。\nどのような服を着れば、首にあのような日焼け跡が残るのだろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫の見張り",
      "text": "何を見てるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "何でもないわ。それじゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "お嬢様、どうでした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "ここに残って、周囲の動向をしっかり見張りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "何か異常でもありましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "質問はなしよ。目を光らせてね。何かあったらすぐに報告して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "任せてくださいよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
