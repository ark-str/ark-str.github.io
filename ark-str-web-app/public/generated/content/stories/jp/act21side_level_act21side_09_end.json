{
  "server": "jp",
  "storyId": "act21side_level_act21side_09_end",
  "groupId": "act21side",
  "stageId": "act21side_09",
  "title": "偽りの文明",
  "storyCode": "IS-9",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act21side/level_act21side_09_end.txt",
  "sourceHash": "bc78ec5faa85868851cbc19b540d6c2fc418830efca6dcadde0fb8076cbe0357",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "チッ――結局逃がしちまったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "向こうさん、途中からやる気なくしてたけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "気付いてたかは知らないが、本気で俺らを殺す気があれば、それは時間の問題だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "あの人はただその時間を無駄にしたくなかっただけなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "どこが相手だろうと、シラクーザのファミリーを甘く見るのはやめたほうがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "一つ勘違いしてるようだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "どのファミリーのことも、俺は見くびったことはねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "いつだって真剣に、全員敵だと思ってるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "ベッローネも含めてな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "おいおい、ちょっと急ぎすぎじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "驚いちゃいねえようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "自分のドンを裏切るような奴を信用できるわけないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "だが、忠告しておいてやるよ。今はその時じゃない、ってな。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ウォラックの鋭い刃を前にしながら、ディミトリは少しの動揺も見せず、部下のほうへと目を向けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "市内はどうなってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "……かなりマズい状況です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "第二中枢区画の分離システムが起動したことは、どこのファミリーにも知られてます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "ベッローネとサルッツォはすっかり攻撃の的ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "たった今も、ほかのファミリーの連中が仕掛けてきたところで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "よく確かめろと言った件はどうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "ディミトリさんの予想通りでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "よそに潜り込ませた人間からの報告では、二家が標的になっていることは確かですが、そこまで強い関心を寄せられているわけではないみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "現状の混乱は、全ファミリーが望むものだということですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "ミズ・シチリアに長年抑圧されてきた不満が爆発しているんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "ベッローネとサルッツォ、二つのケーキの取り分を巡って起きた争いや、単にこれを利用して雪辱を果たそうといういざこざまで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "すべてのファミリーが自分から、あるいは巻き込まれる形で参加している状態です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "（小声）……ドン、これがあなたの望みなんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "（小声）やっぱり……俺たちを裏切ったんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "ウォラック。あんたもバカじゃないし、俺たちが今ここで争っても何の得にもならないことはわかるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "大きな面倒ごとから片付ければ、十分得ができそうなもんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "ロッサティはクルビアすべてのマフィアを率いる立場ってわけでもないよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "それなのに、自分たちだけでシラクーザを平らげられるなんて本気で思ってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "味方はよく選んだほうがいいぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "text": "チッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "嫌そうな顔しないでくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "俺だって、こんな状況じゃなけりゃあんたとは組みたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "それで、レオンは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "なんだよ、戻ってないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "はい。行方もわかりません。明らかに、わざと俺たちを避けているんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "レオン、まさかお前まで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ディミトリは深く息を吸った。\n今はどれだけ考えたところで意味がない。目の前の現実に向き合わなければ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "どこのファミリーもやり合ってるこの状況は――俺たちが第二中枢区画を手に入れる絶好のチャンスでもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "あの場所を手に入れてこそ、俺たちの未来が開けるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルッツォの構成員",
      "text": "ドン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルッツォの構成員",
      "text": "混乱状態です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルッツォの構成員",
      "text": "多くのファミリーがこの機に乗じて攻撃を仕掛けてきています。こちらも反撃を始めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルッツォの構成員",
      "text": "もう手に負えない事態です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "面白い。こいつはレオントゥッツォが考えたことじゃねえな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "今思えば――あれは単なるラップランドの思い付きだったが、お前はそれを逆手に取ったわけか、ベルナルド。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "シチリアが定めた鉄の掟は溶け落ちた……シラクーザがこの数十年シラクーザであり続けた理由に火をつけたのはお前だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "どうしてこの状況を望んだ？　理由は一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ラップランドはどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルッツォの構成員",
      "text": "昨日から連絡がつきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……まあいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルッツォの構成員",
      "text": "ドン……都市は動乱状態ですが、まだ様子を見たほうがいいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "フン……今となっちゃ、巻き込まれまいとしたところでそうはいかんだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ベルナルドのジジイめ、ここまで考えてやがるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "外に出てる連中を全員呼び戻せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "それから、精鋭の一部を第二中枢区画の司令塔に送り込むんだ。あの場所をベッローネとロッサティが見逃すはずがねえからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルッツォの構成員",
      "text": "ということは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "新都市自体に興味はねえが、裏切り者にいい思いはさせねえよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "親父！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "レオン……まさかこの場所を見つけるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "記憶を頼りになんとか辿り着いたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "せっかく来たんだ、そこに座りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……親父の目的はわかってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "ほう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "初めから、シラクーザを六十年前の暗黒時代に戻したいと思ってたんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ミズ・シチリアの介入がなければ、当時のマフィアたちは互いに争い続けて、もっと大きな犠牲を出していたはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そして今回、親父は奴らをミズ・シチリアの枷から解き放ち、前より激しく争わせようとしている。それこそ、どのファミリーも滅びてしまうまで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "ふむ……確かにわかっているようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "だが、お前はその推測が正しいかどうかを聞きに来たわけではないのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……俺はただ、どうしてこんなことを考えたのかを知りたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "二十歳の時、私はまだベッローネの一構成員だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "ある時、暗殺任務に失敗してやむなく近くの村へ逃げ込み、変装で身を隠したことがあってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "結局、私はそこで半年近く過ごしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "その半年の間に、語るほどの価値あることなどほとんどなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "だがその生活が、自らの住む国に対する新たな視点を与えてくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "シラクーザにはファミリーの手が届かない場所などない。しかし、都市周辺の村にいるようなファミリーは、村のごろつきと変わらんようなことばかりしているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "私は靴屋で働き始め、あの夏、通りで仕事をしながら、ターゲットの動向を観察していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "だが結局、相手の動きに特筆すべきところはなく、むしろ大通りで汗を流したあの夏自体が、一生忘れられない思い出になった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "お前も私も、生まれながらにマフィアとしての烙印を押され、そう生きていくしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "だがあの夏に、私は気付いたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "シラクーザは、ファミリーが存在しなくとも機能するのだということに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だから親父はラヴィニアに力を貸したし、俺と彼女が親しくなるのを止めなかったのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "本気でラヴィニアの理想を支えようとしてたんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "彼女が思い描く公正を見てみたいと思っていたのは確かだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "この計画に保険をかけなかったのもそのためか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "親父は俺にも、ラヴィニアにも、ほかの誰にもこの計画のリスクを背負わせるつもりはなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "普通の人間たちのために、ファミリーという障害を取り払えば、彼らの生活が悪影響を受けることもなくなると信じてるんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "まさしく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……だけど、これじゃ足りないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "足りない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ああ、全然足りない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "全ファミリーが滅ぶまで争い合わせれば、今ある構造は崩壊するかもしれないが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "それだけでシラクーザが一般市民の手に渡ることはないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "気にかかっているのは、ミズ・シチリアのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "いいや、気になるのは「慣れ」の問題だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "カラチの助手として働く中で、俺はあることに気が付いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ファミリーという存在は、この地に何千年と根を下ろしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だから、ファミリーが存在しないシラクーザがどのように進んでいけるものなのか、人々には想像もできないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "となると、それを実現したあと、彼らに新しい仕組みを作ることなんてできるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺は……できないと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "何が起きたかも理解できず、人々は困惑することになる。彼らには元あった家が急に廃墟になったということしかわからないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そして、その廃墟の上での再建を志したなら、次もまたファミリーを作ることだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そうなれば何も変わらないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "このまま行けば、一時的にファミリーの存在しないシラクーザを手に入れられるのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "だが、親父が思い描いたシラクーザは、これだけでは絶対に訪れないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "親父の考えは傲慢すぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "自分が想像したシラクーザを皆に与えてやりたいと思うばかりで、彼らが受け入れてくれるのか、受け入れられるのかを考えてないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "俺たちは、この地で生きる一人一人に今起きていることを伝えて、彼らをそのプロセスに巻き込んでいくしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "そうしてようやく、「ファミリーの存在しないシラクーザ」をどのように築き上げるのかを、話し合いのテーブルに乗せられるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "本当に大きくなったな、我が子よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "お前が私を見つけたところで、せいぜい親子喧嘩にしかならないだろうと思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "それがまさか、お前から教えを受けることになるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……親父……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "これからどうするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "ラヴィニアの所へ向かって、マフィア以外の戦力で部隊を作る。この混乱に乗じて、第二中枢区画の司令塔を奪取するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "新都市というカードが俺の手中にある限り、後手に回ることはないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "その後ミズ・シチリアと交渉するか、あるいは直接対峙するかは、様子を見ながら一歩ずつ進めるつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "しかし、いずれにせよ、俺たちはディーマを、そして俺たちのファミリーを裏切ることになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……であれば、お前の好きなようにやりなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "この騒ぎは親父が起こしたものだろう。その一言で俺に任せてあとは任せるような真似はしないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……安心しろ、すぐに追いつく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "アグニル……あなたは教会には足を踏み入れないと聞いていたが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "シラクーザに教会は必要ないが、ラテラーノの思想の一部を受け入れたからには、その文化の影響を受ける定めにある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "結局、私は自らを遠ざけることしか選べないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "とはいえ、君のような人のためなら、一度くらい慣例を破る価値があるというものさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "ラヴィニアさん、全員揃いました。これで五十人ちょっとです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "随分減ったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "マフィアが送り込んできていた人たちは、みんな自分のファミリーに戻った、ということで合っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ふっ……皮肉なことに、お陰で手間が省けたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "皆、聞いてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "シラクーザにおいて、裁判所はとても厄介な立場にある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私たちはある程度ミズ・シチリアの意志を代弁していて、それにより一定の権力を得ているけれど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "この力では、私たちの責務を十分果たすことはできないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "それどころか、多くの場合は、ファミリーという概念に直面した時に我々の無力さをより深く意識させるばかりだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私たちは多くの一般市民とは違って、おとなしく受け入れることもできなければ、マフィアたちに完全に溶け込むこともできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そんな状況に置かれて、多くの仲間はそうした環境に耐えられず、疎外され、追放され、ひいては痛めつけられてきた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "実際、彼らが最終的にこの職に背いてしまったとしても、私はその人たちを責められるような立場じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "結局、私にはベッローネの後ろ盾があったからこそ、今日まで歩んでこられただけなのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "今日起きたこと、そして今外で起きていることについては、きっと全員が知っているでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私は元々……自分にはこれまでと変わらないような行動しか取れないと思っていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "マフィアの争いがあまり多くの一般市民を巻き込まないように……そして最後にはミズ・シチリアが我々のために「正義を執行してくださる」ように、祈ることしかできないと、そう考えていたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "けれど、ある勇敢な方が、ファミリーの存在は悪であり、このすべては不公平だと考える胸の内を語ってくれた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "彼はすべてを変えたいと願い、私に希望を託してくれたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたたちは私と同じ、ファミリーにルーツを持たない人よね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "これまで長年一緒に働いてくれているあなたたちの中には、私以上にマフィアへの不満を持ち、現状を深く理解している人が多くいると思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "だから、力を貸してちょうだい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少しの沈黙が流れる。"
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "でも、俺たちに何ができるんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "先ほど、新都市の中枢区画の分離システムが起動したけれど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "これはルビオさんが暴露した、ベッローネとサルッツォの陰謀を裏付けるものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "マフィアにとっては争いの火種だろうけど、私たちにとってはチャンスでもあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "今後ミズ・シチリアと話し合うにせよ、マフィアと争うことになるにせよ……新都市は、この状況下の交渉材料になるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "再び、沈黙が流れる。"
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "……だけど、俺たちの人数じゃ全員足しても少なすぎますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……私には、頼れる友人が二人いるの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "みなさ～ん、こんにちは～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "えっ、チェリーニアさんですよね！？　どうしてここに……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "それに、ウォルシーニにサンクタがもう一人いるなんて聞いたことも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "二人のことは、私たちの味方であることだけ覚えておいてくれたらいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "それと、ルビオさんが残してくれた助っ人にも、もう連絡を取ってあるから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "彼らがきっと助けてくれるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "でも、皆には正直でいないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "今から行くのはイバラの道よ。全員が生きて帰れる保証はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "命の危険を冒したくない人は、立ち去っても構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "これが上手くいったとして、俺たちは本当に何かを成し遂げられるんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "それも保証はできないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私が唯一約束できるのは――このためなら、私は喜んでこの命を捧げるということだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裁判所守衛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "残ったのは三十人余り。\nそれでも、彼らは去るつもりなどなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な裁判所守衛",
      "text": "こんな機会をいただいたことに感謝します、ラヴィニアさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目な裁判所守衛",
      "text": "この裁判所にあなたがいなければ、俺はとっくに気が狂っていたと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意志の固い裁判所守衛",
      "text": "俺もラジオを聞いていて、何が起きたかは大体想像がつきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意志の固い裁判所守衛",
      "text": "正直、もう我慢できないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った裁判所守衛",
      "text": "俺たちには何もできないかもしれないけど、せめてマフィアの連中には、俺たちが大人しくまな板の上で待つだけの鱗獣なんかじゃないってことを思い知らせてやりたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……ありがとう、みんな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "ラヴィニアさん、こちらの準備は完了しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "もう終わったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "あはは、今はどのファミリーもめちゃくちゃですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "あいつらは普段からこっちのことなんて少しも目に入ってないくらいですし、こんな時に私たちが足元すくってやろうと考えてるとは思いもしませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "でも、ここで教えてやりましょう。奴ら自身が都市の運営に関わったことなんかないってことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "この街は、私たちの手の中にあるんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "あなたたちは心置きなく司令塔に向かってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "こちらはあらゆる手段を使って、なるべく足止めしておきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ありがとう。そちらも無理はしないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "お礼を言うのはこっちのほうですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "正面切ってマフィアに抵抗する力なんて、私たちにはありませんし……結局、一番危険なことはあなたに押し付けてしまいましたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "私は望んでこうしているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シラクーザの役人",
      "text": "それなら、お互い頑張るとしましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ええ。一緒に頑張りましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "ただ街を混乱に陥れるために、カラチを餌にした上で自らの息子まで巻き込んで、さらにはシチリアを相手取るという大義を用いて部下を騙し……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "サルッツォのはぐれ狼がちょっかいを出してきても一切動じることなく、むしろそれを利用してサルッツォを引き込む、か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "ロッサティの若き首領を公然と始末しようとしたことは、アルベルトに君との同盟関係への安心感を与え、他方でほかのファミリーに対しては見せしめになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "そして、最後のテキサスというカードも十分に利用していたな。――ジョヴァンナの下にあるロッサティは、鞘に収められた鋭い剣のようなものだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "ウォラックの手にかかれば、それはむき出しになった鋭い凶刃と化すだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "加えて、君はルビオとカラチの絆をも見抜いており、ルビオの怒りを利用さえした。彼は自らの辛抱を誰にも知られていないと思っていたし、よもや君に気付かれていたとは考えもするまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……あなたがこの都市にいることは知っていたが、まさか私の計画すべてを見抜かれてしまうとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "大したことではない。結果を知っていれば、そのプロセスを推察するのは簡単なことさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "しかも、大勢はすでに決しているしな。すべてを推し量ることができたところで、今さら私にできることなど何もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "仮に、今すぐシチリアがここに現れたとしても、この状況には手を焼くだろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "最も力あるファミリーのドンが、自らのファミリーもろともすべてのマフィアを葬り去ろうとするなどと誰が想像する？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "腹を立ててはいないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "シチリアが私に求めたのは、永遠に繁栄するシラクーザではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "そして私がこの地に求めるものは、権力や富などではないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "確かに、君の行いがシチリアの定めたルールに反していることは明らかだ。ゆえにこそ、私は君を処分するためにここへ来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "だが、こんなところで予想外かつ有意義な親子の会話を聞くことができるとはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "というと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "シチリアがルール破りを認めないのは、これまでに誰一人として彼女を満足させる答えを出した者がいなかったからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "しかし、ベルナルド。君は優秀な息子がいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "君一人では、シチリアが作り上げたこの時代を揺るがすことなどできはしないが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "君とその息子であれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "もしかするかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "はっはははは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "人生というのは、予想もつかない物事に満ちているな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "私は今日、終生の願いを果たしたと――もう心残りはないと思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "それなのに今になって、レオンに成し得ることを見てみたいなどと思うとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "まったく、残念だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アグニルは一瞬、視線をグレイホールのほうへと向けた。\n人ならぬものが近付いてくるのを感じたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "なるほど、噂には聞いたことがあったが……君はここまで計算に入れていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "単にそうせざるをえなかっただけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "どうかお引き取りいただけるかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "これは私が払うべき代償なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "……仕方がないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "その前に、一つお願いしても？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "なんだろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "アグニル――いや、修道士殿。私はこの人生において、誰にも祈ったことはなく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "自分の疑問にほかの人間が答えられるとも思っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "そして主も、私に答えることなどできんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "しかし今、ここにはあなたにしか答えられない疑問がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "聞こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "ミズ・シチリアはラテラーノから帰ってきた当時、何を思っていたのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "一口には答えがたいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "彼女は、自分が直面しようとしている課題に不安を感じており――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "一方で、自分が切り開こうとしている時代に期待を抱いていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "この瞬間、君が感じているものと同じだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "……うん、うん、了解。そっちも気を付けてね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "テキサスはんとエクシアはんは大丈夫かいな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "うん。今はラヴィニアさんと一緒にいて、彼女を手伝うつもりだって言ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あの裁判官か。少なくとも、前つるんでたベッローネよりは信頼できそうやな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "何も起こらへんとええけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "そうだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "っ……あ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "っ、ジョヴァンナさん！　目が覚めたんですね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "私……生きてるの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "もちろんですよ……！　刺されたところが心臓から何センチか離れてたおかげで助かったんですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "それに、ジョヴァンナさんが丈夫な人なのも功を奏したと思います……でないと、持たなかったかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "……ウォラック……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "……私、どれくらい気を失ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "一日です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "一日もあれば、街では色々なことが起きたでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "text": "何があったか教えてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "ようやくお出ましか。我が主――いや、ザーロ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "ベルナルド……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "お前は一体何を企てている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "それがわからないほど愚かでもないだろう。お前はただ、導き出した結論を信じたくないだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "よくもそんな真似を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "誹りを受けるいわれはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "お前自身が私に権力と裏切りを教え込んだのだ。その傲慢さと自信ゆえに、いつか私に裏切られるなどとは夢にも思わなかったのだろうがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "ベルナルド……忘れるなよ、お前のすべては私が与えたものだということを！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "漆黒の霧がベルナルドの首にまとわりついていく。\nだが、彼はそれを気にも留めなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "まだ理解できていないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "狼主同士のゲームなど、私からすれば言及するほどの価値もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "さらに言えば――お前の想像が及ぶ限界は、シラクーザという国家一つくらいのものだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "ゆえにお前の思う権力の極致とは、一つ、あるいは複数の国を支配下に置き、ひいては大地全体を隷属化することなのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "けれども、私はそうは思わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "真の権力とは、時代を牽引しうるものでなければ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "――当初の計画では、シラクーザは私の手で傾くはずだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "しかし今……我が子は、より大きな未来を描いていることを教えてくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "お前はそれを喜ぶべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "そして、その喜びを抱いて自らの山林へと帰るがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "今回のゲームは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "お前の……負けだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "バカなことを。私にはいくらでも方法が――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "そう、狼の主には「牙」を支配する方法が山とある。\nだがその瞬間、ザーロは気付いた。ベルナルドの口の端から、血が流れていることに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "毒……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "初めからこうするつもりだったのか！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ベルナルドは答えなかった。彼にはもはや、口を開く力も残されていないのだ。\nただ顔を上げて、半開きになった教会の扉越しに――\nその視線は花畑を、高いビルを、雨雲を越えていく。\nそうして最後に時までも越え――\n彼は、あの夏を見た。\n靴職人として炎天下の中ひたすらに汗を流す彼はしかし、これまでにないほどの充実感を覚えていたのだ。\n当時の感覚はその後の人生にも影響を与え、常に心に残り続けることとなった。\n彼はゆっくりと目を閉じる。\nまるで一人の君主のように。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "バカな真似を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "愚か者が！！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "巨大な狼の咆哮が教会中に響き渡る。\nしかし、それに応じる者はいなかった。\nしばらくして、彼はレオントゥッツォが向かったほうへと視線を向ける。\nこのような失敗は認められない。\n絶対に。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウォルシーニの通りは、ファミリー同士が争っているか、誰もいないかのどちらかだった。\nそれゆえにか、街の入り口に一人の老婦人がゆっくりと歩いてきていることに気付く者はない。\nそう遠くない場所で、アイマスクをした一人のサンクタが、静かに彼女の到着を待っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな老婦人",
      "text": "向こうに見えるのが新市街の建物かしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "ああ、かなり壮観だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな老婦人",
      "text": "ふふっ。個人的には、ちょっと角が尖りすぎていると思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "君はどうもセンスが古いな、シチリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "あら、あなただって同じようなものでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "それで、どうするかは決めたのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "まだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "ひとまず、大きな騒ぎを起こしているファミリーに警告するところから始めましょうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ミズ・シチリアがそう言った途端、その背後からいくつかの影が飛び出した。\nそうして、それはすぐにウォルシーニの建物の間へと消えていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "それから、旧友に会いに行こうかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アグニル",
      "text": "私の見解だけでは足りないと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "意見というのは、多いほどいいのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "やっぱりここにいたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "アグニルが教えたのでしょう。私はこのレストランにいると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "ここの料理が気に入りましてね。よく足を運んでいるのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "――ベン、久しぶりね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "久しぶりですね、シチリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "何をしにきたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "あなたはどう思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "街の混乱を鎮めることだけが目的ならば、私のもとへは来ないはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "ベルナルドは群狼を理解しているけれど、この計画は結局のところ勢い任せの一言よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "十二家の闘争心はすでに掻き立てられていて、これを鎮めるのはそう簡単ではないけれど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "……そう難しいことでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "とはいえ、アグニルからは別の話も聞いているから、旧友のあなたにアドバイスを聞かせてもらおうと思ったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "私に意見などありませんよ。ひいきにしているレストランが料理長を変えようとしている……それだけのことですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "今のシラクーザにはそれなりに愛着があるものと思っていたけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "ノスタルジーも愛着の一種でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "もう、つれない人ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "私の意見など本当に必要ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "でも知りたいの。文明の中に生まれながら、自らそこを離れたあなたがどう思うかをね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "……人は誰しも、生まれた時代に縛られるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "誰一人それを逃れる者はいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "ベルナルドの考えは、あなたの時代が生んだ執念なのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "彼は暴力を以て解体するという手段には辿り着きましたが、そのあとのことまでは考えが及んでいませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミズ・シチリア",
      "text": "息子のほうはどうかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "未来のことはわかりませんし、なんとも言えないところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "けれど――あなたもわかっているのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベン",
      "text": "彼はこの時代に芽吹いた小さなきざしですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
