          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ？",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "……どうしてですか？"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ？",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "「魔王」って、一体どんな姿であるべきなんでしょう？"
        },
        {
