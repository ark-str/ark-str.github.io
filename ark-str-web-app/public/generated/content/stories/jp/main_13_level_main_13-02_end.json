        {
          "type": "dialogue",
          "speakerName": "泣き叫ぶ市民",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "奴らが、あの怪物たちがもうすぐこっちへ来るわ！"
        },
        {
          "type": "dialogue",
          "speakerName": "絶望した市民",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "そこのフード被った奴、道塞いでんじゃねぇ！"
        },
        {
          "type": "dialogue",
          "speakerName": "泣き叫ぶ市民",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "こっちへ来ないで！　血が付いてるわ！　あの怪物たちと同じよ！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター！"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター、ここです！　手を伸ばしてください！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
