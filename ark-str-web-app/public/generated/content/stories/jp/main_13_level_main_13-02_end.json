        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ここは……どこだ……この石像たちは……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "どれも……まるで生きているようだ……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "サルカズの各種族の石像か？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "けっこう頑丈なのね、「ドクター」。感服しちゃうわ。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "目が覚めた？"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "そんなひ弱な体で、どうやってここまでついて来たの？　あなたの身体を調べてみたけど、何の収穫も得られなかったわ。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "いえ……何も、って言うわけでもないわね。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あなたの構造は……とても特殊ね。私の知るどのサンプルとも違ってる。あなたのこと、研究してみたくなっちゃった。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "「隅々まで」よ。けど惜しいことに、ここはとっくの昔にリーダーに廃棄されてて、実験設備もそれほど整ってないの。あなたみたいに貴重な実験体を傷つけたくはないわ。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "やっぱりロンディニウムに連れ戻すべき？　でもテレシスはあなたを特に気にかけてるみたいだし……"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ほら、「ドクター」――彼女は今、何を見ているのかしらね？"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "こんなに震えて。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼女に何をした？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "「魔王が偉大なる幻を授ける」よ。子ウサギさんは、自分の力をほんのちょっぴりだけ、感じ取っているの。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "敵対する利はない。知識が必要ならロドスにもある。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "サルース",
              "speakerToken": null,
              "operatorId": null,
              "portraitKey": null,
              "text": "バカげた誘いね。"
            }
          ]
        },
        {
          "label": "何が望みだ？　話し合おう。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "サルース",
              "speakerToken": null,
              "operatorId": null,
              "portraitKey": null,
              "text": "交渉なんて無意味よ。"
            }
          ]
        },
        {
          "label": "やめろ。さもないと溶岩に沈めてやる。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "サルース",
              "speakerToken": null,
              "operatorId": null,
              "portraitKey": null,
              "text": "声が震えているわよ。"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "万策尽きてるのに、なんとか可能性を掴み取ろうと足掻くあなたのその姿、見ていて心が痛むわ。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あなたのオペレーターはそばにいないし、指揮能力だって何の役にも立たないわよ。そして今や、仕える「魔王」まであなたの元を去ろうとしている。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "これ以上何ができるのかしら？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "私はいつもリーダーにこう尋ねるの。権力はなぜいつの日も凡庸な者の手に握られるのですか、って。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "歴史から忘れ去られた魔王たちが私たちにもたらしたものなんて、流浪の身としての生活以外に何があるっていうの？"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "そして、「ドクター」。あなたは今回の苦しみの元凶の一人なのかしら？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "質問が多いな。ここは討論会じゃないぞ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "アーミヤにかけた巫術を解けば答えてやる。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "戸惑うのは分かるが、彼女を傷付けても無意味だ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あなたの知恵は嫌いじゃないわ。でも正直な話、聡明な人間などいくらでもいるのよね。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "何千年も追い求めてきてようやく掴み取った機会なのよ。それに代わるものなんてあるわけないじゃない。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "さて……あの人が、この子ウサギさんの小さな頭に無理やり王冠を載せることができたなら――"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "私が引き剥がすことだってできるはずよね。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤの王冠を盗むつもりか！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "盗む？　いいえ。いーえ、違うわ。この王冠は、戦場に落ちてる鉄の輪っかみたいに誰でも拾っていいものじゃないのよ。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あなたには分からないでしょうけど。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あら、何よこれ――石ころ？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "感動的ね。でも教えといてあげる。その子を見えないように庇ったところで何の意味もないのよ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あなたがそこまで諦めが悪いなんてね。もっといいやり方を思い付いたわ、「ドクター」。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "そのフードの下の頭の中にも、私たちの実験に有益な秘密がたくさん隠されてるかもしれないわね。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "こうしましょ。ほら、私の巫術に抗わないで……"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あなたの記憶を見せてちょうだい――"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "頭から出ていけ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "……何よ、この力？　聴罪師の巫術をここまで完全にはねのけるなんて……"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "これが「魔王」……？　でもこの子の精神は大きな制約を受けたはず……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "*古代サルカズ語*"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "サルカズの魂から生まれた枷はそう簡単に解けないわ。この子はいまだ、魂の中にいる。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "子ウサギさんは無意識の状態でも、やっぱりあなたを守ろうとしてるわけね、ハッ。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "……待って。本当にそれだけなの？"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "この子と王冠との結びつきが、強まっている……？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ！　目を覚ませ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あぁ、なんて強い感情なのかしら。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あの時テレジアがあなたを選んだのは、苦し紛れの選択じゃなかったみたいね、子ウサギさん。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "そういうことなら、退屈な前奏は飛ばしちゃいましょうか。その小さな頭がこんなので壊れちゃわないといいんだけど。そうなったらもったいなさすぎるもの。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "聴罪師がこの洞窟に残していったのは、彫像だけじゃないのよ。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "*サルカズの呪文*"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "約束しただろ――",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "その声を拒むんだ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "チッ――"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター、あまりに無謀すぎるぞ。もし私があいつに会っていなければ――"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "油断するでない。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ブラッドブルードのアーツか……うぬらは自らの……「血脈」を、果たしてどこまで弄んだのだ？"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "うぬらが使徒シャイニングの血族だなどとは、想像もつかぬな。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "あのような傑物が、うぬら汚らわしき者どものために絶えず悔い改めねばならぬとは。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ゲホッ、ゲホッ――バンシーの主。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "よくここに入って来れたわね。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "今のバンシーの主はかなり反抗的だって聞いてるわ。もっと用心すればよかったわね。"
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "……お前は我々が予想していたよりも危険らしい。"
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "尋問している余力はない。状況は一刻を争う、急ぎこいつを殺して出るぞ。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "然り。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "へえ、これが今のバンシーの主？　「王庭の弔鐘」？　確かに素晴らしいわねぇ。英雄と呼ばれるあなたのお母さんにも引けを取らないほど、繊細な呪文。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "だけど、知ってるかしら？"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "そうした精巧なルーンは――精巧なアーツは、サルカズが原初に抱いていた心の形では決してないってことを。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "――"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "アスカロン！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "――！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "我らはすでに洞窟を離れた。アスカロンが付近の地形の偵察に出向いてくれておる。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "うぬの右腕の橈骨が折れていたゆえ、基礎的な処置を施しておるところだ。医療オペレーターではない我には、この程度しか叶わぬ。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤの容態はどうだ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "……意識の回復はなっていない。「サルカズの魂に囚われている」との表現を聴罪師は用いていたが……"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "少なくとも、生命に危急はない。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "アスカロンがうぬの行動を不満に思うのも理解はできる。彼女の懸念は、うぬの身の安全だけには留まらぬのだから。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "だがうぬの行いが我らのために時を稼いだのも事実だ。あれがなければ、おそらく聴罪師はすでにアーミヤを連れてロンディニウムの高壁の向こうに身を潜めておったことだろう。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "あの聴罪師は？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "取り逃した。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "土石、鮮血、それから……バンシーの鋭い叫び。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "これが聴罪師が望むサルカズの姿なのであろうか？　……いわゆる血統や、巫術への妄執に取り憑かれた姿が？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "奴らの目的は「魔王」だ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "一刻も早くケルシーとシャイニングに伝えねば。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "……待て。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "この立ち込める蒸気は……"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "……まさか。ドクター、用心せよ。我らはいまだ敵の術中にあるやもしれぬ。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "どうしたんだ？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "君が動揺するなんて珍しいな。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ここは……ヴィクトリアではない。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "この地は、バンシーの河谷なのだ。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
  "observedOperators": []
}
