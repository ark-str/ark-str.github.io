  "sourceHash": "3e5fd6f0cd83db7589dc49504dbb42598815d3d8f3618b676e632c841ea5a4d3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "リスカム！　そっちはまだ持ちこたえられそう？"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "うん、問題なし！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "フランカのほうも、両翼からの攻撃に気をつけて！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "ええ！　にしても、ほんっとしつこい連中ね……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "ハッ！　この護り、打ち破れるとは思うなよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "お前らなんざ吹っ飛ばして――"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "――っ、ぐ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "いっ……く、クソッ……！！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "何なんだ、その剣は……！？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "ふふっ、すごいでしょ。下手に触るとヤケドじゃ済まないわよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "まあ、それで済ます気もないけどね！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "ふー、やれやれ……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "医療班、こっちへお願い！　負傷者がいるの！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "運ぶときはそーっとしてあげて！"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": null,
      "text": "はい！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "――アーミヤ！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "そっちの状況は？"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "ちょっと面倒が起きてるところ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "！　フランカさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "こちらはリスカムさんと同行中、レユニオン幹部と遭遇したところです！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――――"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "隠れようとしても無駄だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "お前らに逃げ場はない。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "今から全員、俺がこの手で――"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――徹底的にぶちのめしてやる。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "お前らは……感染者を裏切ったんだからな！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "あ～ら、ようやくご本人様のお出ましね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "聞いた感じ、超小物っぽい口上だったけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "！　アーミヤさん、このままでは――"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "ってうわ、行き止まり！？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "もしかして、ルートを外れちゃってたかしら……？"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "っ、向こうも同じ状況か……"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "どうやら、誘導されていたようですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "アーミヤさん、ここは強行突破しましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "我々の実力なら、奴らを退けるには十分です。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "少し本気を出せば……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "わかってないわねえ、リスカム。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "本気を出すのは別にいいけど、それで近衛局に目をつけられたら厄介なことになるのよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "そのくらいわかってる！　それでも、四の五の言ってる場合じゃないでしょ！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "――重装部隊、防御陣形を！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……お前が、ロドスのリーダーか。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "自分も感染者のくせに、龍門なんかの感染者狩りに手を貸しやがって……！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "犠牲になった同胞たちの命は、お前らの血で償ってもらうぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――かかれ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "――――"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "っ、レユニオン……！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "あの日、チェルノボーグで……復讐と称して他人を傷つけ、はじめに暴力を振るったのは――"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "あなたたちのほうです！！"
    },
    {
      "type": "sceneBreak"
    }
  ],
