  "stageId": "main_04-04",
  "title": "恐れるなかれ",
  "storyCode": "4-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_04-04_end.txt",
  "sourceHash": "3705095a557dc9f9d20be8e69cdde25d092621652d34fb9943d3993889a760a8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "はぁ、はあ……っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "な、なんとか……なりましたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……いいえ、まだ終わりじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "え……？　い、言われてみれば……塵みたいなものが、舞っているような……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ぐ、うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "あ、あああああっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ひ……いたい……痛いい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "あ、うああっ……か、ゆい……痒い……痒い痒い痒い！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ア……ぁあアァ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ロド、ス……ロドスがいル……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "やツらは敵だ……こ、ろせェ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そんな……！　ど、どうして……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "さっき倒したはずなのに、また立ち上がってくるなんて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "おやおや？　もうくじけちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……！　奴のアーツユニットから、光が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "まだ何も始めてないんだけどなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "――う、嘘……増援まで来るなんて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "こうなったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "なんとかして、私があの幹部を仕留めるしか……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "よせ、メテオリーテ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "ハハッ、この状況で議論なんかしてる余裕があるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "すごい自信じゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "何とでも言いなさい。この一撃で黙らせてあげるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "――ダメだ。やめろと言ってるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "っ、ちょっと！　どうして止めるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "いいから、今すぐ撤退しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……感じるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "奴らが、近付いているのを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "あれ？　撃たないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "それは残念だなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "こんなチャンスはこれっきりだと思うんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……？　向こうも退いたみたい、だけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "メテオリーテ、今だ！　西にある、崩れかけの建物を撃て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "！　敵の注意を逸らすってことね、任せて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ジェシカ、走れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……「スノーデビル」が来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ほ、本当に、いきなり寒く……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……急げ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "今すぐここを離れるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……ジェシカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "フロストリーフの言う通り、撤退しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "とにかく、全力で走るわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "――アーミヤ、聞こえるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "応答願う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "私が補助に回るから、あなたたちは先に行きなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "――いいか、アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ここには来るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "この場所は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
