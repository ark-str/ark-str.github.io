  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "speakerToken": "char_2013_cerber_1",
      "operatorId": "char_2013_cerber",
      "portraitKey": "char_2013_cerber",
      "text": "レユニオンのくせに強いぞ！　ふーんだ、でもおいらは負けないからな！"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerToken": "char_187_ccheal_1#2",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "チッ、まったくこのおバカちゃんは。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerToken": "char_187_ccheal_1",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "目を覚ませ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "speakerToken": "char_2013_cerber_1",
      "operatorId": "char_2013_cerber",
      "portraitKey": "char_2013_cerber",
      "text": "あれ？　ここはどこ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "speakerToken": "char_2013_cerber_1",
      "operatorId": "char_2013_cerber",
      "portraitKey": "char_2013_cerber",
      "text": "あっ、ガヴィルだ！　みんなもいる！"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "おはよう。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケオベ",
              "speakerToken": "char_2013_cerber_1",
              "operatorId": "char_2013_cerber",
              "portraitKey": "char_2013_cerber",
              "text": "えへへ、ドクターおはよー。"
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケオベ",
              "speakerToken": "char_2013_cerber_1",
              "operatorId": "char_2013_cerber",
              "portraitKey": "char_2013_cerber",
              "text": "うっ、ドクターの顔が怖い……おいら、なんか悪いことした？"
            },
            {
              "type": "dialogue",
              "speakerName": "ケオベ",
              "speakerToken": "char_2013_cerber_1",
              "operatorId": "char_2013_cerber",
              "portraitKey": "char_2013_cerber",
              "text": "怒らないで、ドクター……"
            }
          ]
        },
        {
          "label": "（頭をぶっ叩く）",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ケオベ",
              "speakerToken": "char_2013_cerber_1",
              "operatorId": "char_2013_cerber",
              "portraitKey": "char_2013_cerber",
              "text": "ううぅ、痛いよ、ドクター。"
            },
            {
              "type": "dialogue",
              "speakerName": "ケオベ",
              "speakerToken": "char_2013_cerber_1",
              "operatorId": "char_2013_cerber",
              "portraitKey": "char_2013_cerber",
              "text": "なんで急に叩くの……"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "どうやらシラフに戻ったみてぇだな。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "ケーちゃん、どうやってここに来たか、覚えてるか？"
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "speakerToken": "char_2013_cerber_1",
          "operatorId": "char_2013_cerber",
          "portraitKey": "char_2013_cerber",
          "text": "……うーんと、忘れた！"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "そうか。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "ほら、とりあえず横になれ。問題ねぇか診てやるから。"
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "speakerToken": "char_2013_cerber_1",
          "operatorId": "char_2013_cerber",
          "portraitKey": "char_2013_cerber",
          "text": "は～い。ねえ、ここってどこ？"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "ここはだな……チッ、どう説明すればいいかわからん。とにかくまずは横になれ！"
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "speakerToken": "char_2013_cerber_1",
          "operatorId": "char_2013_cerber",
          "portraitKey": "char_2013_cerber",
          "text": "わかったー。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ガヴィル、これはどういうつもりだ？"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "チッ、こっちの説明も面倒だな。とりあえず待ってろ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "十分後……"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "よし、何も問題なさそうだな。ドクターと一緒にじっとしてろ。今度また勝手にいなくなったら、もうはちみつクッキーやんねぇからな。"
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "speakerToken": "char_2013_cerber_1",
          "operatorId": "char_2013_cerber",
          "portraitKey": "char_2013_cerber",
          "text": "わかった！　はちみつクッキー！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "もういいか？"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "おう。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ではガヴィル、これは一体どういうつもりだ？"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "話すとややこしくなるが、とにかくアタシは、お前に用があって来たんだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "エンジンなら返さないぞ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#4",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "エンジンの件もだけど、ほかにも用があんだよ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ほか？　なんだ？"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#4",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "お前、子分たちに鉄鉱石を掘らせてるだろ？"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ああ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#4",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "……チッ、やっぱりな。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ビッグ・アグリーにやられたことが不服だったのか？"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ガヴィル、お前がこんなに負けず嫌いだとは思わなかったぞ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#4",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "いや、あの戦いはアタシの完全敗北だ。ビッグ・アグリーも大したモンだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#4",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "だがあれを作るために、子分たちが鉱石病に罹ろうがお構いなしで採掘させてるってんなら、医者として、アタシはお前を止めなきゃならねぇ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "鉱石病？　ああ、石塊病のことか。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "そんなことはさせていないぞ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "ハァ？"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "私は、採掘場には深入りするなと何度も注意している。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#4",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "何ふざけたこと言ってやがる！　現にお前の子分が鉱石病に罹ってんだ！"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "私の言葉を無視して採掘場の奥を目指す者がいるのならば、それを全て止めろと言うのは無理な話だ。ヨギ、そうだろう？"
        },
        {
          "type": "dialogue",
          "speakerName": "ヨギ",
          "speakerToken": "avg_npc_070",
          "operatorId": null,
          "portraitKey": null,
          "text": "ああ、兄貴は大族長のために鉱石をたくさん採るって言って、オレたちが止めるのも聞かずに奥に入ったんだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "あぁ？　んだよ、そういうことなら先に言っとけよ！"
        },
        {
          "type": "dialogue",
          "speakerName": "ヨギ",
          "speakerToken": "avg_npc_070",
          "operatorId": null,
          "portraitKey": null,
          "text": "聞かれてねぇんだからわざわざ言わないだろ……"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "んだとこの！　鉱石病に関わることなのに……！"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "鉱石病はここでは軽視されているんだろう？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "speakerToken": "char_187_ccheal_1#2",
              "operatorId": "char_187_ccheal",
              "portraitKey": "char_187_ccheal",
              "text": "チッ、わぁーったよ。"
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "speakerToken": "char_187_ccheal_1#2",
              "operatorId": "char_187_ccheal",
              "portraitKey": "char_187_ccheal",
              "text": "ドクター、アタシはそこんとこ確認してなかったっけか？"
            }
          ]
        },
        {
          "label": "確かに、君はそこまで質問していなかった。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "speakerToken": "char_187_ccheal_1#2",
              "operatorId": "char_187_ccheal",
              "portraitKey": "char_187_ccheal",
              "text": "チッ、ドクターまで揚げ足を取ってきやがって！"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "それに……"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "おい、急に服脱いで何する気だよ！"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#2",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "おい！？　お前……"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "私も小さい頃から採掘場中を駆け回っていたんだ。石塊病になっていても不思議はないだろう。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "だからこそ私は、採掘場のどこに病をもたらす鉱石があるかも熟知している。常日頃から、そこには行くなと言い聞かせていたのだがな。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "そうかい。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "……お前を誤解してた。悪かったな、ズゥママ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1#5",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "気にするな。"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "speakerToken": "char_337_utage_summer_1#3",
          "operatorId": "char_337_utage",
          "portraitKey": "char_337_utage",
          "text": "えっ、もしかしてこれで仲直り！？"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "speakerToken": "char_337_utage_summer_1#3",
          "operatorId": "char_337_utage",
          "portraitKey": "char_337_utage",
          "text": "普通こういう場合って、どっちも譲らなくて、次の朝まで殴り合うとかじゃないの？"
        },
        {
          "type": "dialogue",
          "speakerName": "クロワッサン",
          "speakerToken": "char_201_moeshd_summer",
          "operatorId": "char_201_moeshd",
          "portraitKey": "char_201_moeshd",
          "text": "そないなこと期待すな！"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ガヴィルはそんなヤツじゃない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "残念だなー。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "じゃ、もう一つの用について話すか。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "アタシらのエンジンはお前んとこにあるんだよな？"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ああ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "返してもらえねぇか？　あれがないと、アタシら帰れねぇんだよ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "それはできない。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "帰りたいというなら、誰かにお前たちを送らせよう。だがあれは返せない。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "それじゃダメなんだよ。ケルシー先生に怒られちまう。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "どうしても、返してくれねぇのか？"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ああ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "speakerToken": "char_337_utage_summer_1#3",
          "operatorId": "char_337_utage",
          "portraitKey": "char_337_utage",
          "text": "おっ、結局やり合う感じ？"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "……やっぱ、拳を交えることになんだな。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "私は最初からそのつもりだ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "へぇ、またそいつと喧嘩だな！　面白れぇ！"
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "やあやあ諸君、ご機嫌よう！"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1#6",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "……じいや、なぜ今ビッグ・アグリーを出す？"
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "なんじゃ、使わんのか？　使わんなら戻しとくぞい。エンジンのテストもまだじゃからのう。"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "……使う。だが、今ではない。まだ話が終わっていない。"
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "なんじゃそういうことか。じゃあ話が済んだら呼んでくれい！"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ああ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#3",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "おい、エンジンのテストだって？"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "ああ。ビッグ・アグリーにお前たちのエンジンを付けたんだ。返して欲しいのなら、力ずくで奪え。"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "speakerToken": "char_187_ccheal_1#5",
          "operatorId": "char_187_ccheal",
          "portraitKey": "char_187_ccheal",
          "text": "へっ、じゃあそうさせてもらうぜ！"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "speakerToken": "char_416_zumama_1#2",
          "operatorId": "char_416_zumama",
          "portraitKey": "char_416_zumama",
          "text": "では、広場で決着をつけよう。ついて来い。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
