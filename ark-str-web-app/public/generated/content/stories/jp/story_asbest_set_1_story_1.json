{
  "server": "jp",
  "storyId": "story_asbest_set_1_story_1",
  "groupId": "story_asbest_set_1",
  "stageId": null,
  "title": "奇景",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_asbest_1_1.txt",
  "sourceHash": "4ab3904dbbd07bf907e23611608c3ed20dea4593fd9a2ca2b41215e24f8f11ee",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ここよ。ガヴィルから聞いてるわ、あんたもロドスの人だってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "私の子分たちはみんな商売やってるから、最低限のサルゴン語は教えてあるの。欲しい物があれば彼らに声をかけてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "おう。ところで、なんでそいつらあたしのことジロジロ見てんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ここはめったに外から人が来ないから、みんなテンション上がってるんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "少なくとも私はテンション上がってるわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "ねぇ、あの子のしっぽ見て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "あのしっぽ、柔らかそう……むちむちしてるのに細長くて……しっぽの先っちょもすごく器用……しかもオレンジ色の模様がついてるよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "今の見た！？　しっぽであんなおっきい荷物を持ち上げたよ？　それにあのドア！　すごく重たそうなのに片手だけで持ててるよ！　なんてすごいんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "レスリングしたら強そう。しっぽのひと振りで木をなぎ倒せそう。ああ、なんて……美しい人！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "こんな人初めて見た。友達になりたい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "ま、待って、今から行くの？　わ、わたし、まだ心の準備が――あ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "ハガネガニで作ったアーマーとグリーブはいかがっすかー？　硬い甲羅はどんな攻撃でも受け止められますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "鋸歯鱗獣の牙で作った槌と骨で作った剣もございます！　鋭い牙刃はどんなものも切り裂けますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "（こっちへ向かってきた……！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "えっと……こんにちは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "あ？　なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "あの！　う、うち、あんたのしっぽが好き！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "あたしのしっぽが？　お前何言ってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……あたしゃ忙しいんだ、どいてろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "（うっ！　怖い……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "あっ、待ってよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "あんたのことが好きって言ってるのに、その態度はないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "褒められたら、褒め返さなきゃ！　例えばほら、このしっぽも素敵だと思わない？　かっこいいしっぽだってよく言われてるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はぁ？　だから何言ってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "暇あんなら、そこのお友達と泥遊びでもしてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "こっちの言葉が話せるんだね？　でも、なんか言葉遣いが荒いような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "泥遊びなんかしないもん！　甘く見ないでよ、もう子供じゃないんだから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "……こうなったら、勝負よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "チッ、お前なんなんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "どけって言ってんだろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "おい、死にてぇのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "あー、わーったよ、お前は美しい！　しっぽが素敵だ！　めっちゃキレイだ！　これで満足か？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はぁ？　どうしろってんだ！　やらねぇと気が済まねぇのか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "ああ……喧嘩になっちゃった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "おい、オレの商品を壊すなって――わお！　しっぽが首に巻き付いたぞ、やるな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "あー！　俺の油が――お、怪我を防ぐためにわざと油まみれになったのか、賢いな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人たち",
      "text": "いいぞ！　頑張れ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "早く隠れてッ！　この低木だったらちょうど隠れられるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "昨日の今日でまだ懲りてないの？　わたしまで無理やり連れてきて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "で、あなたたちまでどうして……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "うちの商品をいっぱい買ってくれたお客さんだからな、気になるに決まってるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "あの人、全く手加減してくれなかったよ……うちのしっぽ、ウロコが何枚も剥がれちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "それにしても、いっぱい買い物したのに、なんで村に泊まらないでこんなところに小屋を立ててるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "けど、いい場所を選んだよね。あの木のとこだったら、河原からそう遠くなくって水汲みが便利だし、満潮の時はギリギリ届かないから浸水の心配もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "あ、あの子、でっかい毛虫を捕まえた！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "それを炒めた！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "パンに乗せた！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "食べちゃった！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "……おえっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "ほら、スープに使う石を探してるぞ。大した奴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "しょっぱい味がする石があって、それをスープに入れて煮れば旨味が増すってのはうちの村の人しか知らない秘密だぜ？　あの人何で知ってるんだろう。市場で誰かから聞いたって感じでもないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "へぇ、あのツルのことも知ってるんだな！　俺もお前から聞いて初めて知ったけど、噛むと甘酸っぱい味がして大好物になったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "ほう、今度は鱗獣捕りか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "せいぜい細縞鱗獣何匹ってところだろう。何せ鋸歯鱗獣は捕まえにくいんだ。オレでもしっぽを使ってやっとだからな。毎回しっぽを噛まれて痛いのなんの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "外の人は石やツルのことを知ってても、鱗獣捕りに関しちゃオレの方が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "っしゃあ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "一体どうやって……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "えっ、ええ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "ぷっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "そろそろ行こっか、ツルでも採って食おうぜー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二時間後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "あ、あの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "お前らさ、まさかあたしが気付いてねぇとでも思ってんのか？　いつまでついてくるつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "おいお前、連れの奴は？　川に落ちて鱗獣にでも喰われたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "い、いえ……さっきあなたが虫を食べてるところを見て、彼女も食べてみたいって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "そしたら、なんかヤバいのを食べちゃったみたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "だから、その、た、助けてくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "は！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "お前ら、マジなんなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "だって、あなたも食べてたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "なんて虫だ？　どんくらい食べた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "何の虫かはわからない……けど食べたのは少しだけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "じゃ、吐いたのか？　今意識ある状態か？　体に赤い斑点は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "もういい！　自分で確認する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "熱はない、体に斑点もないか……これ、胃の中身を吐き出させられる薬草。煎じて飲ませて、さっき食ったもん全部吐き出させろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "あとは水をいっぱい飲ませとけ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "もう三回も吐いてて、これ以上何も出ないって言って、眠りについたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "これって、もう大丈夫だよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "チッ、もっと水を飲ませろ！　それとお前ら少しは静かにしろ、横でごちゃごちゃうるせぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "焚き火が温かいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "なんか歌いたくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "へへ、オレも！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "筋肉はムキムキ～♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "女は畑仕事で男は狩りに～産まれた仔は元気モリモリ～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "ヒャッホー！♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "お前ら……マジであたしが今まで出会ってきた中で一番イカれてる連中だぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "前から気になってたんだけどさ、この人のしっぽって、オレらのと似てるよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "村の誰かの親戚なんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "なぁ、お前、どこから来たんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "あの、ど、どうして毛虫なんかを食べるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "うちの村に一体なんの用だ？　オレんとこでも買い物してたよな。ここに住むつもりなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はぁ……参ったぜまったく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "違ぇよ、あたしゃ滝を登りに来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "おいおい、大口を叩くのも大概にしなよ。あそこに登れる人なんて聞いたこともないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "ふーん、あっそ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "どうして滝なんかを？　落ちたら死ぬぞ。それとも登りきったら何かいいことでもあるのか？　鱗獣をいっぱい捕れるとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……いい景色が見られるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "景色……？　滝のこと？　そんなのどこからでも見れるんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "滝登りはスリルがあって、気持ちいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "スリル……？　ここに住むオレらにとっちゃ、食い物を見つけて、腹を満たして生きていけば十分なんだよな。スリルを求めて滝登りなんかする必要ってどこにあるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "そうだ。生活するのにはここで十分だな。上なんか行ったりして、もし毒虫がいっぱいいたら死んじまう。そしたらスリルどころじゃなくなるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "そうよ、死んじゃうよ……お願い、思い直して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はぁ……あたしは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "ひょっとして、この間市場で有り金を使い切っちゃったから？　だから、毛虫を食べるしかないんだ……でも、あなたは鱗獣が捕れるんだよね。たくさん捕ればお金になるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "そうだな、イナムの姉さんについていけば、きっと儲かるって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "それに、あなたが死んだら、お父さんとお母さんが悲しむよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "あたしの親？　はっ、そいつらとっくにおっ死んじまったよ。あたしのことが情けなくってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "あっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "ていうかお前らさっきから何勘違いしてんだ？　あたしゃ死ぬなんて一言も言ってねぇけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "違うの？　ならよかった～",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "じゃ歌の続きだ！　なぁ、ここの歌を覚える気はないか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "女は畑仕事――♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "（すぅ――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "お前らマジでいい加減にしろ！　いつになったら静かにしてくれんだこないだのガキンチョもお前らと比べりゃおとなしい方だぜガムテープも買っときゃよかったわ全員の口塞いでやろうかああ゛！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "ひぃ！　なんだこの人、急にどうした？　今のはどこの言葉？　サルゴン語じゃないよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "しまった、なんか片方の目の色が変わったぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "……う！　うぷ！　ううぅ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "おぉ！　意識が戻ったか。よかったよかった。早くこいつを連れて帰れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "あっ、大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "おぇ、ぐっ、うぅ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "あーあ……早まったか、また寝ちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "まあいい。村には医者くらいいんだろ？　早く連れてってやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "これ以上ここにいても時間の無駄だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "うん、わかった。ありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "（小声）しかし、やっぱりこの人何か変だ。そうだ、いっそのこと気絶させて、安全な場所まで運んでおくというのはどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "ざけんじゃねえ！　聞こえてるっての。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "ふぁあ、起きた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はぁ、昨日は大変だったぜ……あいつらが来てねぇうちにさっさと行こ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "持ち物確認、よしっと。さあ、出発だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "ここか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "目の前まで来ると、一層寄せ付けない雰囲気を感じるな。うはっ、この先何が待ってるんだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "――っしゃ、行くぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "轟く水音が耳を充満すると、辺りはかえって静まり返ったかのように感じる。アスベストスは自分を飲み込もうとする水流に逆らい、先端が水しぶきに埋もれたロープを引っ張ってみた。\nいつもそうであった。地面から未知なる高みへ登るか、あるいは地下深くへ潜る。\nたどり着くその先に、言葉を失うほど壮大な景色が待っていることは約束されているが、道中どんな困難にぶつかるかは一切わからない。\nそれは転倒や滑落かもしれないし、猛獣や吹雪の可能性もある。或いは、もっと予想のつかないような災難や苦労が――"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "（ダメだ、流れが激しすぎて立ってられねぇ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "（枝だ、そこに枝がある！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "（……よし、ハマった。しっかりしてるから、これに伝って横に行けば激流は避けられるはず……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "よっ、と！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "げっ、足が滑った――！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ある時、激流でバランスを失い、二度と呼吸することを許されないような渦巻きに巻き込まれ、気絶しそうになった。\nある時、暗い夜にうっかり山の中腹で足を踏み外したが、ただ日の出の瞬間を見るためだけに、骨折した腕をなんとか固定し、痛みを耐えながら山頂まで登りつめた。\nある時、氷河の上で滑って転がり落ち、予想以上に鋭い氷がむき出しになった肌をすりむいた。しかし、再び立ち上がった瞬間、夕焼けが赤く染まった雲をすり抜け、氷河を照らした――\nオレンジと紫が織りなす美しい光が滑らかな氷面に映り込み、氷原独特の甘みを帯びた風が吹き渡り、その香りは絶景を伴って彼女の鼻と目に飛び込んだ。\nその瞬間、彼女は傷口からまだ血が出ていることすら忘れた。どんな対価を払っても、それだけの価値があったと心の底から思うのであった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "ゴホゴホゴホ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はぁ、はぁ、危うく溺れるところだった……ゴホッ、ったく、何て激流だ……隙間に挟まってよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "まだ生きてる！　あと少しだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "待ってろよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は立ち上がるたびに、こう思っていた。\n*レム・ビリトンスラング*、来た甲斐があったわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三十分後"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "疲れた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "辺りを確認してきたよ。毒虫はいないから命の危険はないだろう。これで一安心だ！　おっ、ここにもこのツルが生えてたんだな……うおすごっ、いっぱい生えてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "他ではめったに見ないのに、こんなにたくさん生えてるなんて、ここはいい場所だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "お前、おっかないところもあるけど、なかなかやるじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "ちょっと、何言ってるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "あんたは褒めちゃダメ、先に目を付けたのはうちの方なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "ねぇ、あんた……カーナにも言われたんだけど、あんたら外の人はやり合うのが嫌いかもって。だから、この前はいきなり殴りかかって、ごめんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "でも、あんたのしっぽは本当にカッコいいって思ってるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はぁ……まーたごちゃごちゃと……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "いいから黙って景色でも見てろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "泥水まみれのアダクリス人たちは、息を切らしながら立っている。中にはどこでついたかもわからない草が頭にくっついている人もいた。\nその草は湿り気を帯びた強い谷風に乗って、回りながら空へ舞い上がり、やがて姿が消えた。\n彼らにとっては今まで見たことのない景色――自分たちの故郷が、その目の前で広がっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "わぁ――あそこを見て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "お、おぉ――これは……！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "心動かされる壮大な景色を前に、言葉にできないような感情が胸にこみあがった。気付けば彼らも、隣でじっと景色を見つめる異郷人をマネて、山に向かって歓声を上げていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "お――い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "やっほ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "最高だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "こりゃいいぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "なんかまた歌いたくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "なあ、彼女を囲んで、手をつないで歌おう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "水が多い滝は、鱗獣が捕れる～♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "しっぽを使えば、すぐに釣れる～♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "滝を登れば、きれいな景色～♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "きれいな景色、きれいな景色～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "まぁ、いいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "きれいな景色～♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "……って目が回るからほどほどにしろよ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "率直なアダクリス人",
      "text": "みんなの笑い声、天高く響かせて～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイなアダクリス人",
      "text": "響かせて～♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "愉快なアダクリス人",
      "text": "そんじゃ、オレらもう帰るからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "真面目なアダクリス人",
      "text": "さようなら！　友よ！　さようなら！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "はいはい、じゃあな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "ぷはー、つっかれたー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "なんて騒々しい連中だ。滝を十回登るよりも疲れるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "――そういや、今回の探検記、どうしようかな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一ヶ月後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "アスベストスから雑誌が届いた。みんなの分もあるよ！　この前探検に来た時の紀行文が載ってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人たち",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "えっと、紀行文というのは……旅先で感じたことや経験したことの記録よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "来る途中でちらっと読んだけど、風景に関するコメントは意外とシビアね。まったく、滝から降りてきた時はあんなに楽しそうにしてたくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ふむ……レム・ビリトン語で書かれてるから訳しながら読むわね。向こうでは「アスベストスの新コラム『地元民見聞』」とか宣伝されてるんだけど、あんたたちのことも載ってるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人たち",
      "text": "うちらのことが本になってる……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ゴホン！　じゃあ読み始めるわよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスベストス",
      "text": "「やかましいが、面白い奴らだった。」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
