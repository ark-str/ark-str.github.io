{
  "server": "jp",
  "storyId": "act43side_level_act43side_03_beg",
  "groupId": "act43side",
  "stageId": "act43side_03",
  "title": "ドラマチックに",
  "storyCode": "AD-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act43side/level_act43side_03_beg.txt",
  "sourceHash": "96b927ca8bbdbe10522009ae6efa5f18b67d656121feea34d434c2e19b066ad4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "……シェリーさんが死んじゃった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "え？"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "初めはダルトン、次にシェリー……なんてこと。一体何が起きているの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "シェリーさんが、死んじゃったって言ってるでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "何その言い方？"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "あたしとマイケルをわざわざ呼び止めて、うちのチームでまた事故が起こったことを教えてくれてありがと。すっごく驚いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "シェリーさんが亡くなる前に最後に会ったのが、マイケルさんなんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "言いがかりはよしてよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "シェリーは昨日、あんたとモイラと一緒に部屋で映画を観ていたんでしょ。もう聞いてるんだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "だからこそだよ！　昨日の夜シェリーさんと一緒にいたからこそ、彼女が途中でメッセージを受け取るなり出て行った時に、あたしとモリーは何も聞かず、ついていってもあげなくて……"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "それでこんなことになっちゃったから。だからこそ、一体何が起きたのか、あたしとモリーは突き止めなきゃいけないんだよ。それで色んな人に聞いて回ったんだけど――"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "あるスタッフが、あの倉庫からそう遠くないスタジオで彼女があんたと会ってたって言ってたんだから！"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "偶然会っただけだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "俺はただ、シェリーの気の抜けた様子を見て、撮影を中断させてしまったことにまだ罪悪感を感じているのかと思って、慰めようとしたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "はぁ、まさか本当に思い詰めてたなんてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "へ～。スタジオに、あんたたち二人っきりで、慰めねぇ？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "ハニー、信じてくれ。俺の心には君しかいないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "黙りなさい！"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "つまり、ほんとにあんたがシェリーを殺したの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "たった数日の間に二件も事故か。"
    },
    {
      "type": "dialogue",
      "speakerName": "不運なスタッフ",
      "speakerId": null,
      "text": "しかも、どっちも人が死んでる。スタッフを募集してる制作チームはランクウッドに山ほどあったのに、どうしてよりによってこの場所を選んじゃったかな。はぁ、やっぱり私ついてないよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "それくらいにしとけ。急にペンキ缶がひっくり返ったり、スタジオの外を黒い影が横切ったり、都市間ネットワークが繋がらなかったりするのまで、何でもかんでも自分の不運のせいにするなよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "俺はむしろ自分がラッキーだと思うぞ！　事件が起きてからすぐの現場情報はゴシップ誌に高値で売れるし――"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "ってなわけで、ちょっとどいてくれ、シェリーの死体の細かいところがよく見えないじゃないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "不運なスタッフ",
      "speakerId": null,
      "text": "そんなの見なくていいよ……スタジオへ手伝いに行かないとでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "先に行っててくれ、ホーティン。これ全部メモっとかないといけないからな！"
    },
    {
      "type": "dialogue",
      "speakerName": "不運なスタッフ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "……にしても、どうしたんだろうな。アブナーさんが言ってたが、シェリーさんは昔から変だったらしい。まさかダルトンさんのことがショックすぎて自殺したのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "理にはかなってるが、そうだとしたら少しつまらんな。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "もし何か裏の事情があるとしたら……へへ、半年分の家賃の心配はしなくて済むぜ。一日中ガンマイクを掲げる人型スタンドなんておさらばだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "シェリーさんは凍死だって医療チームが言ってたよな。なら左の手の平にどうしてこんなにたくさんの傷が？"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "うっ――気味が悪い。呪いの儀式か何かか……"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "呪いではなく、抗った痕跡だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "……抗った痕跡？"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "シェリーさんは精神的ストレスに押しつぶされ、ヤケになって冷凍庫に入っていったんじゃなかったのか？　まさか本当に裏が――"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "って、ルシアンさん！　なんで気配を消してるんだよ。びっくりしただろ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "幻覚に抗うために痛みを用いるのがいいと、私がアドバイスした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "ミズ・シェリーの耳元では過去の残響がこだましていたが、その状況でも彼女は自らの仕事を全うし、映画に円満な結末をもたらそうとした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "彼女が絶望のあまり自ら命を絶つことはない。自傷の血の痕が何よりの証拠だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "ただ今回、彼女は痛みを用いても幻の中から逃れられなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "あの頑固で、神経質で、人の話を聞かないシェリーさんがあんたのアドバイスに従ったって？　信じられんな……"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "あんた彼女のことをよく理解しているんだな、ルシアンさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "そこまでではない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "勘弁してくれよ。どう考えたらそうなるんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "俺がシェリーに言い寄ってフラれたから殺したって？　ハニー、そんなバカげた話よく思いつくな？"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "そうそう、ティッピちゃん。シェリーがメッセージを受け取るなり急に出て行ったって言ってたよな？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "俺も彼女が端末を握っているのを見た。つまり、メッセージを送った人物こそが彼女をおびき出して殺した犯人だ。そうだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "それ、あんたじゃないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "speakerId": null,
      "text": "納得のいく説明がほしいわね、マイケル。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "冷凍庫に入れっぱだったせいで端末は故障してるから、記録の復元はできないよ。でもあたしたちの端末はチームから支給されたもので、連絡先リストにはチームメンバーしか載ってない……"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "いい加減にしろよ。あのな？　名探偵ティッピ？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "グレータさんか、メラニーさんがやった可能性だってあるだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "昼間シェリーに撮影の邪魔をされて、二人とも機嫌が悪かったじゃないか。ちょっと懲らしめようとでもしたんだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "グレータさんはシェリーさんと仕事中ずっと一緒だし、急な問題を処理する機会なんていくらでもあるよ。昼間のことくらいで嫌がらせなんかしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "メラニーさんはメラニーさんで、現場のマナーやルールを厳守する人だから、チームのスケジュールを尊重してるし、ほかのメンバーの休憩を妨げるようなことなんかしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "今のところわかってる事実は、事件直前に彼女があんたと会ってたってことだけだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "おい、俺は誰があいつにメッセージを送ったかなんて知らないんだよ。たまたまスタジオで鉢合わせただけだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "あの時間、普段のあんただったらセルフバーで美術班のお姉さんとお酒を飲んでるか、マリオンさんの部屋にいるんじゃないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "夜はあんたにとって、すっごく大切な時間でしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "それなのに、どうしてスタジオエリアに戻ったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "あぁ、なんだよ。そういうことか、可愛い可愛いリーベリちゃん、さては俺と一緒に酒が飲めなくて不機嫌なんだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "もうちょっと大きくなったら、一緒に飲む機会もあるからさ――"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "少なくとも、あんたは目的があってスタジオに行ったはずだよ。それで小道具部屋を出て行ったシェリーさんに遭遇した。本当に一言慰めたかっただけなら、どうしてあたしの質問に正直に答えないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "シェリーさんの死は、本当にあんたとは無関係なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "どうしたんだよ、ティッピちゃん。雑用に、スタジオセット、スプレーアーティスト、ランクウッドで色んな仕事をやってきただけじゃ満足いかなくて、今度は探偵ごっこをやろうってのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "それとも、ホラー映画を一緒に見たくらいで、君とモイラちゃんの仲良しコンビにシェリーっていう新たなメンバーが加入したってのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "いい子ちゃんぶるなよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "仕事の時、君が描いた落書きみたいな薄気味悪い背景画に対して、あいつは何度も大声で文句言ってたじゃないか。シェリーとは大した仲でもないだろ、なんで俺に噛みついてくる？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "全ての不慮の事故の裏には真犯人がいるって？　映画の観すぎなんだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "……シェリーさんと知り合ってからの二ヶ月、彼女がチームメンバーに微笑むことも、誰かを褒めることもほとんどなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "あたしへの指摘が一番多かったのもシェリーさん。二人で納得できる背景画が出来上がるまで、あたしは何度も残業したよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "でも毎日撮影した素材をチェックする時に嬉しそうな表情を浮かべてたことは知ってんの。一見奇想天外な背景画にどれだけマイナー映画のオマージュを盛り込んだかも、彼女だけがわかってくれた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "もしほんとにシェリーさんが苦しくて苦しくて、死ぬことで解放されたいって思ってたなら……あたしは彼女の決定を尊重するよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "けど！　もし誰かが彼女の感情をコントロールして、心を踏みにじって、映画を愛し続ける権利を奪ったなら、あたしは許せない！"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "シェリーとは本当に偶然出会っただけだ。昨日の夜に俺がスタジオに行ったのは……ある人に会うためだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "ある人に会う？　誰か証明できる人はいるの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "speakerId": null,
      "text": "それは……"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "私だよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "speakerId": null,
      "text": "モリー？"
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "speakerId": null,
      "text": "昨日の夜、マイケルさんは私に会いに来たの。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "シェリーさんとは親しかったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "彼女の痛みを私も理解できたというだけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "彼女には正気を保っておかなければならない理由があった、私がそうであったように。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "（小声）謎の呪い、それとも愛による恨みか……どっちの話のほうが読者ウケがいいだろう……"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "おっほん、それで昨日の夜あんたはどこにいたんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "二階のオフィスだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "あのオフィスはグレータさんとシェリーさんが重要書類を置いている場所だろう、何しにそこへ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "謎を解きに。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "証人はいるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "ミス・クリスティーンだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "ハッ、あんたのそばにいる小さなバケモノを信じろって？　そいつはしゃべれもしないじゃないか！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "ルシアンさん、そんなむっとしないでくれよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "あの日のダルトンさんとの演技は見たからな。あんたがどれだけすごい役者かってのは知ってる……誠実なふりをするのは、あんたにとっちゃ難しいことじゃないだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "正直なとこ、俺としてはシェリーさんがなんで死んだかなんぞ興味なくてな。つまり、たとえ彼女の死が本当にあんたと関係があろうが、俺は絶対に通報しない。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "むしろ、あんたがもしくだらんゴシップ紙に載ったら、警察はあんたへの疑いを弱めるだろうよ――ゴシップ紙に書いてあることが本当だなんて誰も信じちゃいない、面白半分に見てるだけさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "だからもう少し協力してくれ――オフィスで解いてた謎ってのは一体何なんだ？　もしかしてシェリーさんをどうやって罠にはめるか計画してたのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "君は移動区画で殺人事件が起きたことに恐怖を感じないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "はぁ、制作チーム内での恨みつらみなんてランクウッドじゃ珍しくもない……じゃなきゃ俺はおまんまの食い上げだよ。撮影アシスタントで食ってけるとでも？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "たとえその謎の答えが全ての人の命を脅かすことになるとしてもか？"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "ハッ！　大袈裟だな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "speakerId": null,
      "text": "では伝えるが、この話は内密に……"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "そりゃあ、もちろん！　独占ネタを誰にも譲る気はねぇからな！"
    },
    {
      "type": "narration",
      "text": "ルシアンは撮影アシスタントの耳元に近付き、隠された真相をそっと明かした。\n撮影アシスタントの目が興奮から恐怖へと変わた。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "何だって！"
    },
    {
      "type": "narration",
      "text": "アシスタントの手からゴシップ用のノートとペンが床に落ち、驚愕したフォルテの叫びが倉庫全体に響き渡る。\n事故現場の片付けを続けていた制作チームのメンバーたちの不満げな視線がルシアンと撮影アシスタントに突き刺さる。しかし次の瞬間、衝撃的なニュースが全員の耳に届いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "speakerId": null,
      "text": "この区画がもうすぐ天災に見舞われるかもしれないだって！？"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
