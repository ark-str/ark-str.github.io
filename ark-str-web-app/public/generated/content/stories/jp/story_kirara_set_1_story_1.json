{
  "server": "jp",
  "storyId": "story_kirara_set_1_story_1",
  "groupId": "story_kirara_set_1",
  "stageId": null,
  "title": "隠しエンディング",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_kirara_1_1.txt",
  "sourceHash": "0d6e9a50f746e1562597accbf236332083474f012dfcec53cfe12eb282547af2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "うん？　ウタゲか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あれ、アカフユじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あっ、ちょうどいいや。雲母（きらら）とここで会う約束してたんだけど、見てない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "なんと、お主らもここで待ち合わせておったのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "あのー、ガイドさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（顔を上げて男性をちらっと見る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（携帯端末を持ち上げ、道路の景色にカメラを向ける）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（携帯端末で何かを入力する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "ガイドさーん──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（携帯端末で入力をする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "何で携帯を俺に向ける……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "「ガイド……って」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "「何のこと？」だって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "お前、龍門を出るのに手引きしてくれる約束のガイドじゃなかったのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（携帯端末で入力をする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "「ちがう……」だと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "じゃ何で俺の車に乗ってきた？　まさか近衛局の回し者か！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（携帯端末で入力をする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "字ぃ打ってないでなんか言えよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "近衛局って……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "私、てっきり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "はっきり言え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "て、てっきり……ロドスまで送ってくれる、運転手の人、だと思って……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "スイマセーン、デカいキャリーケース持った女の子、ここらへんで見かけたりしてません？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人の男性",
      "text": "ケースを持った女の子？　見てないなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人の女性",
      "text": "あんた一時間も遅れて来たんだからそりゃ見てないでしょうよ！　――ねぇ、その子、私さっき見かけたかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人の女性",
      "text": "大荷物持った子でしょ？　あなたと同い年くらいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そーそー！　夢中でゲーム機とにらめっこしてたら、その子で間違いないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人の女性",
      "text": "ゲームはしてなかったような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人の女性",
      "text": "確かにゲーム機っぽいのは出してたけど、すぐにしまって携帯を取り出して、写真を撮ったりなんか文字打ってたと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ケータイ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "（あの子のケータイって、極東から持ってきたヤツだよね、龍門でもそのまま使えたっけ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "（って今はそんなこと考えてる暇ないか。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "たぶんその子だね。どこ行ったか知りません？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人の女性",
      "text": "そのあと車が来て、あの子運転手と目を合わせたらそのまま乗り込んだわよ。運転手も親切にケースをトランクに積んであげてたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "……その車って、どっちに向かった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "なんてことだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "極東の身なりをした若いエーギルの女って、そう転がってるものかよ……約束してたガイドと特徴が被るだなんて……チッ、何でそんな紛らわしいタイミングで出てくるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "え、えと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "モジモジすんな。言いたいことあんなら言え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "いや、その……何でこれが極東の身なりだって思ったのかなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "はぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "そんなマンガから出てきたみたいな格好して何言ってる？　それが極東の身なりじゃなかったら何だってんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "いや、極東ぽいって言ったら普通侍とか巫女みたいな格好かと思うんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "サムライ？　ミコ？　そりゃマンガの中のキャラだろ！　それともなんだ、本当に極東にはそんなヤツらがいるってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "それは……いや、なんでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "そんなに車飛ばして……どこに行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "あぁ？　家に帰んだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "でも私、友達と会う約束をしてて、さっき車に乗った場所で……だから、その、一回そこに戻ってからにしてくれないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "ふざけんな。んなめんどくさいこと誰がするか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "じゃあ……お家がどこなのか教えてもらえる？　そこに迎えに来てもらえるよう、友達に連絡するから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "俺ん家ならシラクーザだよ、これで満足か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "し、し、シラクーザ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "無理無理絶対無理！　極東からここまででも結構かかったのに、今からシラクーザになんか行ってられないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "チッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "なぁお嬢ちゃんよ、このナイフが見えるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "ま、まさか……マフィア？　シラクーザのマフィア！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "マフィアってわけでもねぇが……まぁ似たようなモンだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "分かったなら大人しくしてろ、今からお前は俺の人質だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "でも……ガイドさんと落ち合えなかったんでしょ、龍門から出られたとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "黙れ！　こっちはもうイチかバチかなんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "犯人め、ジュエリーショップで強盗を働いたのみならず、人質まで取るとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "申し訳ありません、アカフユさん。ロドスに合同捜査を持ちかけたのはこちらなのに、こんな事態となり、ご友人まで巻き込んでしまうとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "詫びは後でよい！　対策はどうなっておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "はい、すでに高速道路と移動都市の各出入り口には人員を配置させました……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "おい、黙り込んで何してる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（ゲーム機を見せる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "こんな状況でゲームか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（頷く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "わけわかんねーヤツだな、お前は。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "今度はケータイか？　ゲームはもう飽きたってか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "……これ、極東から持ってきたんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "だからなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "龍門じゃ使えないみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "だろーな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "……何打ってんだ？　おい、見せてみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "ダメ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "あん？　黙って寄越せってんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "絶対ヤダ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "寄越せってこの──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "*シラクーザスラング*！　渋滞かよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "ちょうどいい、これで手が空いたぜ。おいガキ、ケータイ見せろ。仲間と連絡とってないか確認するだけだ。何もなかったらこっちも何もしねーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "してないしてない！　ホントだって、信じてよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "信じろだ？　信じた結果、俺はこんなことして逃げる羽目になったんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "いいから寄越せっつーの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "じゃあ携帯しまっとくから、それで勘弁してよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "ダメだ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "あ、隣の車の人がこっち見てる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "なに！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "*シラクーザスラング*！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "携帯しまってゲームだけしとくから、ね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "……あっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "何なんだよ。さっきから数分おきに「あっ」って、気が散るぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "いや、その……同じステージで何度も死んじゃってて……全然、集中できなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "んだよ、俺のせいだって言いてーのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "そういう意味じゃ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（無意識に携帯を取り出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "何をする気だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "ご、ごめんなさい！　つい、癖で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "ったく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "いいか、お前の解放は俺が無事にシラクーザについてからだ。そのあとはメールでもゲームでも好きにやりゃいい。だが今は我慢してもらうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "本当にシラクーザまで行っちゃうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "他にどこへ行けってんだ！　こちとら身内に騙されてよ、龍門なら商売のチャンスはいくらでもあるとか言ってよ！　なぁーにがチャンスだあのチクショーめが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "自分が騙されてヤクザの下っ端にされたからって、味方欲しさに俺に目を付けやがって！　ふざけんな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "それでも親戚のよしみで暫くはついてってやったよ。だがそのうちにやつらのやることにゃ嫌気がさしてきてよ、帰るつったらあの野郎……ジュエリーショップを襲って罪を俺になすり付けたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "知らねー土地で何十年も牢屋にぶち込まれるなんざ耐えられるかってんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "親父もお袋もシラクーザにいる。俺が発つ前、さんざん引き留められたよ……あんときは金に目が眩んで聞く耳も持たなかった……けど今は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "俺はもう、ただ家に帰りてぇ、両親に会いたいだけなんだ！　一目だけでもいい！　腰抜けと罵られようが川に沈められようがなんでも受け入れてやるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（無意識に携帯を取り出し、文字を打ち始める）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（小声）私だって……家を離れるのは嫌だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（小声）ここにたどり着くのだって、いっぱい苦労したのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "何か言ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "な、何でもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "でも、ガイドも案内もなしに……本当にシラクーザまで戻れるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "じゃあどうしろってんだ？　近衛局に道案内でも頼むのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "いくら騙されたっつっても、今の俺はもうヤクザの一味扱いだ。ヤクザもんが近衛局に「俺はハメられたんだ」なんて言ったところで連中が聞き入れてくれると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "最初から耳を貸すつもりがない相手だと、どんだけ説明しても聞いてくれないよね……しかも色眼鏡で変に解釈しちゃうし……そういうのわかるよ、おじさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "……何だ。てっきり「ちゃんと説明すればきっとわかってくれる」とか言って一生懸命訴えてくるモンだと思ったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "でも、近衛局を説得できなくたって、その場でズドンってことにはならないはずだよ……むしろ荒野で事故でも起こしたら、それこそゲームオーバーになると思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "待った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "前に見えるあれは──まさか近衛局が検問を張ってんのか！？　おいおい車一台一台調べてんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "ってお前！　またケータイをいじってやがったな！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "やっぱりさっきは近衛局にタレコんでやがったのか！　今すぐよこし──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "させん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "お主がきららであるな？　私たちはロドスのオペレーターだ。迎えに来たぞ、早く車から降りろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "チクショー！　近衛局の手先どもめ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "きらら、早う掴まれ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "どうした、なぜ動かぬ？　一刻を争うのだぞ、迷うのは後にせよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "でも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "トランクにあるケースならもう回収したから、さっさと降りなよ。そのドロボーは近衛局が何とかしてくれるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "宴（うたげ）！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "わ、分かった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "結局ヤツには逃げられちゃったけど、きららは無事だから結果オーライかな。大事なキャリーケースも回収できたし、めでたしめでたしっと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ちょっと、大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "まだビックリしてるんだろうけど、道のど真ん中に突っ立ってたら交通の邪魔だよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "あっ！　ご、ごめん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "さてと、フルーツティーは飲んだし、龍門名物の鱗獣団子も食べたことだし、さすがにもう落ち着いたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "う、うん……ありがとう、宴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "んじゃ紹介するね。このいかにも武士！　って感じの人はロドスのオペレーターでアカフユっていうの。実はさっきのドロボーの車にはこの人が乗るはずだったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "えっ、どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "アカフユが、例の「ガイドさん」だからだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "あっ、じゃあのおじさんが言ってた、極東の格好をしたエーギルの若い女性って……アカフユさんだったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "然り。近衛局は件の盗人に目をつけておったのだが、一方で藪蛇となる危惧もあったゆえな。私をガイドに扮装させ、隙を見て捕らえるという算段を立てていたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "だが私の不覚でお主を巻き込んでしまった。誠に申し訳がない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "う、ううん……平気……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（無意識に携帯を取ろうとする）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "あれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（慌ててポケットを探す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "またメールで話す気？　初対面の人にそれやるの失礼だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "ち、違うの……私の携帯が……もしかしてあの人の車に！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あらら、ドンマイ。このあと新しいのでも買いに行く？　ビックリさせちゃったし、お詫びに付き合ってあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "いやでも、アレには大事なものが入ってるの！　すごくすごく大事なものが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ゲームの攻略記事とか、いい勝負をした対戦相手の連絡先とか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "……それもあるけど、そういうのじゃなくて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "どうしよ宴、今からでもあの車に追いつけたりしない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "うーん。アカフユはどう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "追跡の任は近衛局に引き継いでおる。今から私たちが向かったところで、却って混乱を生むだけであろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "でもさ～、この子マジで焦ってるぽいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あたしの知る限り、たとえあの車にこの子の持ってるコレクションが全部載っててそんで吹っ飛んだとしても、ここまでは焦らないだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（首を縦に激しく振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "ふむ、そこまでというなら、近衛局の方へ話を通してから動くのならば問題はなかろう。だが、あの盗人はすでに検問所を突破して逃げて行ったぞ？　どうやって探すつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "それなら──大丈夫。私にいい考えがある……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "へぇー、すごいじゃん。ゲーム機でケータイの位置を突き止められんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "出発前にちょっとね。落としたら大変だから、デバイスには一通り仕込みをして、互いを紐づけて位置がわかるようにしてあるの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "やるじゃん！　機械いじりの腕がまた上がったんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "と、ともかく、このずっと動いてる赤い点が現在位置だから。どうやらあのおじさん、私が携帯を落としたのにまだ気付いてないみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "であれば、追跡も楽になろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "ウタゲよ、お主の学友も中々の豪の者ではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そんなのあったり前だって。あたしの友達だもん、すごいに決まってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "あはは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "前方真っすぐ五百メートル進んだところで高速降りて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "さっきから思うんだけど、よくそんなスイスイと指示を出せるね。デバイスを見ながらまるでゲームでもやってるみたいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "そ、そんなことないよ。ただ……ただマップの情報を伝えてるだけだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "もー、謙遜すんなって～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえてくる声",
      "text": "……無駄な抵抗は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くから聞こえてくる声",
      "text": "……今すぐ投降……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "あれで間違いない。かなり目標へ近づいてきたぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "無駄な抵抗はよせ！　武器を下ろし、両手を頭の後ろに組んで出てきなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "来るな──来るんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "行かせてくれよ、俺は龍門から出たいだけなんだ！　シラクーザに……家に帰らせてくれ！　頼む！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "もう逃げ道はないぞ！　武器を下ろせ！　今ならまだ減刑の可能性はある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "黙れ！！　知ってるぞ……テメェらもどうせ俺をハメようとしてるんだ――もう二度と騙されねーぞ！　俺は帰るんだ！　ここさえ抜ければシラクーザまできっと帰れる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "身内だろうと、「ファミリー」だろうと、テメェら近衛局も、それにあのガキも！　ここに良い奴なんて一人もいねぇ！　全員噓八百並べやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "みんな消えろ！　もう俺に関わんじゃねぇ！　騙そうたってそうはいかねーぞ！　俺は家に帰るんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "マズいね、あれはもう理性ブッとんじゃってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "近衛局のことだから、あのまま粘ってたら強行手段に出るかも。それで揉みくちゃになったら、きららのケータイはおろか、あの人も無事じゃ済まないだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "アカフユさ、あたしらで潜り込めたりしない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "断じてならぬ。規制線を越えてしまえば、近衛局が私たちの身の安全を保証してくれるとは限らない。今はあの者が冷静を取り戻すのを待つより他ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "事前に近衛局に聞いたが、あの者は強盗を働いたとはいえ、死傷者は出しておらぬようだ。処罰もせいぜい禁錮刑止まりだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "はぁ、抵抗して死ぬくらいだったら牢屋の方が全然イイじゃん。いつになったら理解すんだろうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "おじさん……自分はハメられたって言ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "えっ、そなの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "車に乗ってた時に言ってた。ジュエリーショップの強盗の件は濡れ衣なんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "マジ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "アカフユ、それを急いで近衛局に伝えてきてくんない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "構わぬが、そのような裏付けのない証言で見逃してくれるような近衛局ではないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そうかもしんないけどさ、ただ固まってるよりかはマシっしょ。はいはい行った行った！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アカフユ",
      "text": "よし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "それを聞いた近衛局がやり方を変えてくれるといいけどね〜。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "きらら、一旦ここを離れよっか。見ての通り、今はもう向こうに任せるしかないからさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "最後にもう一度だけ言う、大人しく武器を下ろせ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "もしこれ以上非協力的な態度を取るようならば、武力行使も辞さないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない男",
      "text": "誰が従ってやるもんかよ！　テメェら全員くたばりやがれ！！　ああ分かったぞ、最初から俺をここにおびき寄せて殺すつもりだったんだな？　そうだろ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "十まで数える！　それまでに投降しなければ、攻撃に移る！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "一……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ゲッ、こりゃアカフユの説得間に合わないパターンかも。きらら、覚悟を決めた方がいいよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "きらら？　何してんの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "きららはゲーム機に意識を傾け、パネルの上で忙しく指を滑らせている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "……本来のインターフェースをスルーして、自作のヤツでコマンドを送ってるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "二……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "三……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "四……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "まさかゲーム機から自分のケータイに電話をかけて、あの人に連絡とるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "あの人に……気付いてほしいだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "頼む、繋がって……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "九……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "十！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "攻撃を仕掛けるぞ！　総員──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "ターゲットが現れました！　武器は所持していません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "ターゲットは武装を解きました――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "はい、入院手続きはこれで終わりです。お疲れ様でした。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "（携帯端末で何か入力する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "「ありがとうございます」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "いえいえ、どういたしまして！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "まーたそうやって～。面と向かってるのに文字を打って会話するのは失礼だって言ったでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "ご、ごめん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "はぁ、まいっか、ずっとこんな性格だしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "行こ！　部屋を案内してあげる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "しっかし、あん時はマジ危機一髪だったよね～、あの人もう絶対ムリだと思ったもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "てかあの後さ、あの人のために証言までしてあげたんでしょ？　ただでさえ怖い目に遭ったっていうのに、よくそこまでできるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "あのおじさんの処分って、もう出たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そんなすぐ出るわけないじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "まあ、アカフユから聞いた話だと、強盗の件は確かに真犯人が別にいたからチャラになったって。罪状は今んとこ、公務執行妨害と……あと何だっけ、覚えてないや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "組織に入ったのも騙されてたってのが考慮されたらしいから、刑期は一年そこらじゃない？　明けたら国外追放して終わり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "いやぁ～、これも全部きららのおかげだね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "私はただ、携帯に気付いてもらっただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "中身を確認すれば、私が車で言ってたことはウソじゃないってわかるから。ただそれだけのことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "へー、そうなんだ。で、結局ケータイの中身はなんだったの？　まさか、凶悪な人を改心させる呪文だったりして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "呪文なんてないない……だから、大した内容じゃないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "マジ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "マジだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "だったら、なんで見せてくんないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "いや、だから、見てもしょうがないし……ホントだってば！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ふ～ん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "まっ、そこまで言い張るならこれ以上は聞かないでおくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そんじゃまたね。疲れてるんだったら寝るといいよ～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "入ってるのは呪文なんかじゃないよ、ただの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "雲母",
      "text": "手紙の下書きだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう呟いて携帯を取り出し、メールの下書きボックスを開いた。そして出発した日付のところまで、指でスクロールさせていった。\n実家のある移動都市を離れた時点で、メールなどの送受信はできなくなっていた。\n初めて家を出た少女はそれでもなお、道中で見聞きした出来事とその感想を事細かに記し続けた。\nきららは机の引き出しから便箋を取り出し、一枚千切って、丁寧に写し始めた。\nその下書きにはよくまとめられた文章もあれば、短い言葉の断片が雑然と綴られたものもあった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一枚また一枚と、きららは無我夢中に写し、便箋は次々と文字で埋め尽くされていった。そしてつい一番直近の日付の下書きにたどり着いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "下書きはここで途切れていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "きららはそれを書き写した便箋を千切った。そのままくしゃくしゃに丸めた後、床に投げ捨てた。\nそして携帯の画面をオフにして、新しい便箋を取り、また「三十四日目」と書き出した。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
