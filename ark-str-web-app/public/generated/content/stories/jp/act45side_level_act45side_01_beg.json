    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "65_g2_dreamcastlehall"
    },
    {
      "type": "narration",
      "text": "冷たい空気のおかげで少し意識がはっきりして、祥子は部屋を見渡した。"
