{
  "server": "jp",
  "storyId": "act13side_level_act13side_09_beg",
  "groupId": "act13side",
  "stageId": "act13side_09",
  "title": "溜息",
  "storyCode": "NL-9",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act13side/level_act13side_09_beg.txt",
  "sourceHash": "3f57647a93e8f4f2b8892d3418591e1f99678c804f6e89368eecb01a1df59661",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2-9-1"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……ドクター、グッドニュースよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "監査会が、ロドス全員の外出申請を認めたの。「重要なパートナー企業に都市を見物してもらうのも必要なことだから」ですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……本来なら、一連の事件さえなければ、あなたはもっと自由に行動できてたはずだったものね～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ドクター？　私たちに御用ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あっ、騎士さん！　ちょうどよかった！　まだ健康食が余ってるんですが、よければ持って帰りませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "う、う～ん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……グラベルさん、ドクター、ご機嫌よう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "カジミエーシュを見学するチャンスが来たぞ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "散歩に行ってみないか？",
          "value": "2",
          "blocks": []
        },
        {
          "label": "皆聞いてくれ、待ちに待った休みだ～！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "――激戦！　ここに我が目を疑う光景が繰り広げられております！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "それもそのはず――存在自体を疑われていたあのナイツモラが！　初のメジャー進出にして、チャンピオンと対等に渡り合っているのですから！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "今宵、二人の鮮やかな紅の鎧が、競技場で大激突を繰り返し――この目を奪う熱闘の前には、月明かりすらも霞んで見えます！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "それにしても――「草原の恐怖」、追魔騎士トゥーラ！　観客の皆様も、その狂気が放つ魅力を肌で感じていることでしょう！　耀騎士との対戦後、彼の人気は留まるところを知りません！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "追魔が往く大騎士への道――その物語に、ここで新たな一ページが加えられることとなるのでしょうか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "ちなみに、エンシェント・エンターテインメントカンパニーでは、現在彼の「新騎士称号予想企画」を行っております！　見事的中させた方全員に素敵な景品をプレゼント！　奮ってご応募ください！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "ナイツモラよ、あの勢いはどこへ行った？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……っ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "ミノス人め……我が同胞が古き者を蹂躙するあの時代では、既に貴様らの英雄は詩人が歌う故事に成り下がっていたというのに……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "くだらん無駄口を利くものだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "ならば問うが――貴様のハガンは、この現代のどこにいる？　貴様が誇る同胞たちは、この大地のどこで暮らしていると言うんだ？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "過去に生き続けるナイツモラ――貴様も、哀れな男だな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……ミノスより来たりし感染者よ。貴様は何のために戦っている？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "生きるためだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "彼らは俺を感染者の英雄と崇め、歴史に名を残す手本としているが……元を辿れば、俺はただ生きるために戦っているにすぎない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……「感染者の英雄」？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "なるほど……では、貴様の戦いも同胞のためにあるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "同胞……というのは違うだろうな。何しろ、俺たちに血の繋がりはなく、故郷を同じくするわけでもない。単に、不運にも同じ病にかかっただけの間柄だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "けれども、彼らの境遇には同情している。ゆえに俺は彼らを救い、すべての人々のため、活路を探しているんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "同胞とは呼ばず……なれど貴様はそやつらを救う、か。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……笑わせてくれる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "貴様は確かに強大だ。……されど結局、カジミエーシュの草原を治めしは感染者にもあらねば、異邦人にもあらず。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "カジミエーシュ人はどこにいる！？　我らは、彼奴らの――あのクランタどもの手のひらの上、見世物とされるばかりなのだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "私が千里を越え、騎士の国へとやってきたのは、我が理想のためではなく、感染者やミノス人、ともすれば自らの同胞との争いを彼奴らに披露せんがためだとでも云うのか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "――何たる恥辱！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ハイビスカス",
          "text": "うわわ～っ。こ、ここが大騎士領の中心商業区画なんですよね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "厳密に言うと、大騎士領には「中心商業区画」って呼べるような街がいくつもあるから。そのうちの一つ、って感じだけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "ここを勧めたのは、単純に距離が近いからだしね～。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイビスカス",
          "text": "それにしてもこの街、ジャンクフードだらけじゃありませんか！　こうしてぱっと見ただけでも、ポップコーン屋さんが三つ、ピザ屋さんが二つ、ハンバーガー屋さんなんて四つもありますよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイビスカス",
          "text": "まったくもっていただけませんね！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あはは……もしかしてそれも、騎士競技場が近くにあるからでしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "ええ、そうよ～。競技場は、商業エリアすべての中心地とも呼べる場所だから～……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "言ってしまえば、争う騎士たちを中心にして、商業が発展してるってことなのよね～。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "あっ……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ナイチンゲール",
          "text": "……これは……ニアールさんの人形、でしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイビスカス",
          "text": "わぁ～！　本当だ、可愛いですね！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……あれっ……？　まさかこのお店のグッズって、全部……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "店主",
          "text": "よう、いらっしゃい。お客さんたち、耀騎士のファンかい？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "店主",
          "text": "だったら、ここに来たのは大正解だな。うちは耀騎士グッズの専門店なんだ！　フィギュアにぬいぐるみ、ニアール家の紋章バッジまで何でも揃ってるぜ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "店主",
          "text": "ちなみに、耀騎士が風騎士を下して、無事決勝に進んだら……うちの仕入先が、記念品を作ってくれるかもしんねえんだ！　しかも精錬源石彫刻でな！　どうだい、前金払って予約してみねえか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "店主",
          "text": "どうせ勝つのは耀騎士だしな！　ハッハッハ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（ナイチンゲールにぬいぐるみを買ってあげる）",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "店主",
              "text": "まいどあり！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "その前金というのは、いくらなんだ？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "店主",
              "text": "そうだな、ざっと――って、お客さん、もしかして外貨で払うつもりかい？　……なに、龍門幣？　だったら、銀行に行って追加で下ろしてこなきゃなんねえかもな。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "店主",
              "text": "俺の計算じゃ、龍門幣なら130万ってとこなんだが……持ち合わせで足りそうか？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "耀騎士が使った盾なら、ここの家宝になり得るだろうか？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "店主",
              "text": "盾ぇ～？　そんなもん、いつ使ってたってんだい？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "店主",
              "text": "それよかほら、うちにはハンマーに剣、それから今使ってるソードスピアの模型まであるんだぜ。ちょっと見てかねえか？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "決着の兆しは見えず、両者一歩も譲らぬ戦いが続いております！　追魔騎士の凄まじい攻撃はまたも血騎士に防がれ！　そのチャンピオンは、ケーキを切るかの如く軽々と人工地形を破壊しています！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "さあ、既に試合時間が10分経過しました！　嵐のような戦いはいまだ終結せず！　永遠にすら思われるこの攻防！　先に疲労を見せ始めるのは果たしてどちらなのか！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "――と、言っている間にも！　血騎士が再びアーツを操り、追魔の薙ぎ払いを回避する～～ッ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "しかし、どちらの選手も今に至るまで、積極的にアーツで仕掛ける様子は見られないようですが――まさか、双方互いに未だ探り合いの段階なのでしょうか！？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……貴様、いかような訓練を受けてきた？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "残念ながら、騎士になる前の俺は、真っ当な戦闘訓練を受けたことなどなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "とは言え、騎士になったあとも、戦いの中で学びを得てきただけだがな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……天性の戦士、というわけか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "――若者よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "俺は貴様の師ではない。だが、貴様が対戦相手を渇望しているというのなら、一つ教えておこう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "はったりの恐怖を振りかざしたところで、今を懸命に生きようとする者には何の意味もなさんぞ。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "血騎士は半歩、その場から引いた。\nすると、その鎧から鮮血が滲み出て、空中に集い流れを成す。\nそうして――裁きの刃の如く、紅い光が武器を包んだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "答えろ、ナイツモラ。貴様の夢見た歴史――その数千年前から現在に至るまでの軌跡の中で――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "感染者に、生きる望みが存在した試しなどあるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……貴、様……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "怯むな！　ケシクを名乗る悪夢よ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "貴様のハガンは何処だ！　居るというなら、ここへ喚ぶがいい！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "あなたのハガンはどこにいる？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "老騎士フォー",
          "text": "お主のハガンはどこにおる？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ハガンの時代は、もう何千年も前のもの。\nだから、今ではもう彼は歴史の中の存在でしかないのよ、坊や。\n「ケシク」？　それは、ハガンの従者たちのことね。彼らは、この大地で一番勇ましい戦士だったと言われているわ。\n……確かに、ハガンはたくさんの土地を征服したけれど……それと同時に、たくさんの人を傷つけてきたの。\n恐怖を振り撒くことは、ナイツモラの生まれ持った性質であり、ハガンにとっても征服欲とは、食欲のように満たさなければならないものだからよ。\n――でもね、トゥーラ。\nこの大地に生まれたのだから、あなたは、あなた自身の道を見つけることになるでしょう――"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……父。強敵。……師と、理想。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "私は……こともあろうに、この都市でそれを見いださんとしていたのか……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "否！　夢より出でて、目覚めるべきだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "これは遠き思い出にすぎず、己が為描いた天路は――我が道は、とうに定められしもの故に。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "祈りは終わったか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……私の家族は皆死んだ。我が同族は、皆消え失せた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "――ハガンは我が切先に宿る。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "我こそは――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "――己が戴くハガンなり！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "来いッ！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……天気、晴れ。射るには適した、風のない日。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "ターゲットはロドスのリーダー二名。種族不明のフルフェイス、それとコータス。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "気分は……最悪。仕事のたびに邪魔が入るから。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……追記、気分はやっぱり「超最悪」で。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "おや、日記をつける習慣がおありなのですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "は？　そんなもん残すわけないでしょ。有罪認定用の物証作っとくバカがどこにいんの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "ならば、あなたは仕事に私情を持ち込む方なのですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "聴罪師に耀騎士、それとあの妙な感じのするコータス……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "あんたたちを抱えるロドスって、一体何なの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……ああ、そういえば、お聞きしそびれていたのですが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "あなた方は、どこで「聴罪師」の名を耳にしたのですか？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "モニークは、目の前にいるサルカズが狙撃へ対処する瞬間を、既に目にしている。\n彼女はその卓越した剣技に、理解不能なアーツか巫術の類いを織り交ぜて、耀騎士と共にクロガネの一矢を防いだのだ。\nモニークは内心、あの時「矢を防いだ」動きだけを見て、このサルカズの実力すべてを知ったとは言えないだろうと考えていた。\nしかし今、彼女はある一つの確信を得るに至った。"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……生憎、それを教えてあげるほど親切じゃないのよ、私。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "それは残念です。とは言えこちらも、ドクターとアーミヤさんに狙いを定める殺し屋を見逃すほどのお人よしではありませんからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "以前頂いた「挨拶」に返礼せねばと思っていたところですし。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……何、その光……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "耀騎士のお仲間って、そうやってキラキラするのが好きな連中しかいないわけ？　こっちはいい加減、目が疲れるんだけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "（それにしても、この光……穏やかすぎる。攻撃性の欠片も感じないし……これもサルカズの巫術なの？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "（……っていうか……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "（あの表情……自分の剣に、悲しみを覚えてる……？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……答えてはくれないみたいね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "いいわ。それなら、あんたの実力を試させてもらいましょうか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "――い、一体何が起こったのでしょうか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "もしや私の目の錯覚……！？　突如として会場を黒い霧が覆ったように思います。――それ自体は珍しいことでもありませんが……黒い霧の中に現れたのは――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "もしや……旗、でしょうか？　――いや違う、あれは……軍隊！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "これが……あなたの執念の表れなのか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "……実に残念だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "何せ、観客席は遠すぎる。あの場から見ている騎士たちには、俺が今ここで味わっている感覚などはわかるまい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "はためく長旗、鳴り響く角笛、一つの軍隊……それを織りなす一つの民族、一つの歴史。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "だが――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "――貴様が今を捨て、狂ったように死を求めるのは、これが理由だとでも言いたいのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "――はぁッ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "悪夢が攻撃を仕掛けましたっ！　し、しかし、この霧では……何が起きているのやら、こちらも把握しかねる事態となっております！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "何かが……黒い霧の中を前進しているようです！　まさか追魔の真のアーツは、自らの先祖を召喚する能力なのでしょうか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "笑止。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "貴様は単に――運命に立ち向かう勇気を欠いているにすぎんのだ。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "血騎士が、その巨大な斧を振り上げる。彼は、自らの対峙するものが本物の古きケシク軍ではないことを理解していた。\n彼が今、向き合っているのは――滅びの道を選ぼうとする、一人の若者だ。\n過ぎ去った時代を喚び戻さんとする、一人の若者にすぎないのだ。\n漆黒の霧が、その名の如く紅い血騎士の鎧を覆った。\nまずは痛み、そして衝撃が襲い来る。喚び出された者たちが、決して虚像や幻覚ではないことが実感となって押し寄せる。\nそれでも、血騎士は不動のまま立ち続け、ナイツモラ本人が向かってくるのを待っていた。"
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "（古代語）倒れろ、英雄よ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "血騎士の唸る声が零れる。\nカジミエーシュ最高級のその鎧さえ、たちまち悲鳴を上げていた。\n悪夢の刃は鎧を裂き――その一撃には、血騎士の強靭な肉体を以てしても、危うく片膝を突きかけるほどだった。"
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "――！　くっ、深手には至らぬか……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "貴様は、俺を傷つけるに至った。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "――しかし、それは同時に「俺の血がその武器に触れた」ことを意味する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "（――謀られた――ッ！？）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "恥じることはない。実戦経験の乏しさは元から貴様の弱点だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "貴様はあの「ケシク」には未だほど遠いと見える。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……あんたと耀騎士がクロガネの矢を防いだあの瞬間は、私の目にも焼き付いてるわ。たとえ銀槍のペガサスでも、クロガネの懲罰を防ぐなんてこと、そう簡単にはできないもの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "諜報員が言うには、あんたらと耀騎士は「使徒」とかいう感染者治療組織を名乗ってるらしいけど……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "あんたが「医者」ですって？　はぁ～あ、どこがよ。あの諜報員、鉗獣の檻にでもぶち込んでやろうかしら。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……私としては、争いは好きではないのですが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……へえ、そう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "それなら、少しお喋りしましょうか。……私、前はヴィクトリアの軍人だったの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "貴族の出じゃないせいで将校になれなくてさ。で、合同軍事演習の時に商業連合会に引き抜かれたってわけ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "きっとあの時、私の上司たちは、厄介払いができてさぞ喜んでたことでしょうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "ま、そういう経歴だから、私は自分の弓術に自信があるの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "それで、一つ提案なんだけど――私の矢を三本、この距離で真正面から受けきれたら、ロドスにはもう手を出さずにいてあげる……どう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "その言葉が、信じるに値する根拠は？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……信じるも信じないも、あんた次第よ。そもそも、ロドスを処理する方法くらい、無冑盟にはいくらでもあるわけだしね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "たとえば、あいつらが今何の警戒もせず持っているぬいぐるみに、揮発性の薬を塗るだとか……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "そんな目で見ないでくれる？　この程度の仕込みなら造作もないって話をしただけよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "――三本、と仰いましたね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……ええ、三本よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……ふぅ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "じゃあ、一本目。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "モニークは、ヴィクトリアで最も標準的な姿勢を取って、弓を引き絞る。\n軍人時代、百発百中を誇った彼女は、その腕を非常に高く評価されていた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……浅すぎますね。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "サルカズは、剣を抜きさえしなかった。\n思わぬ結果に、モニークの胸は締め付けられ、悔しさが込み上げてくる。"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……二本目。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "再度、弓を引く。\n彼女は以前――ある雨の夜に、一人の第一階級征戦騎士を襲撃したことがある。\nその騎士は名のある英雄でこそなかったが、カウ戦争を戦い抜いた真のベテランだった。\nゆえに、彼は闇の中から放たれた矢にも鋭く反応した。そして、そのまま揉み合いとなり、双方共に崖から落ちた。\nカジミエーシュの早春の森は肌寒く、鬱蒼とした森の中での追撃戦は七日七晩続いた。\n耳鳴りと体中を蝕む痛みとが限界に達しようというその瞬間、彼女は弓を引き絞り、水辺で喉を潤すターゲットをようやく仕留めたのだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……姿勢が変わり、目つきも変わった……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "さながら、好機をうかがう狩人のようですね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "――！",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "矢が弾かれ、空中で真っ二つに折れる。\n片方は地面に突き刺さり、もう片方は茂みに飛び、隠れてお喋りしていた羽獣たちを驚かせた。"
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "けれども、私は獲物になるつもりなどありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……聴罪師って、全員あんたと同じレベルの剣士なの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "それとも、ロドスにはあんたみたいな奴がうじゃうじゃいるのかって聞いたほうがいいかしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "（……こうなると、ロドスへのリスク評価を見直しておくべきだと思うけど……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "そうそう。実は、ロドスを始末しろっていうのは理事会からの命令なのよね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "だけど私、もうすぐ命令を聞くのは止めにする予定なの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "どう？　これも信じられない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "いいえ……むしろ、そう意外でもありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "我々のリーダーが、その可能性を予見していましたから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "それで、あなたは何を仰りたいのですか？　この戦いは、あなたのエゴのためのものだ、とでも？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "私はね……全力を出せって言いたいのよ、サルカズ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "さあ――これが、最後の一本。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……ぐっ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "これで終わりだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "窮地からの見事な反撃ーッ！　血騎士の強烈な一撃が、会場を覆う黒い霧を完全に消し去りました！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "怒濤の気迫で、追魔騎士の生みだした幻覚を瞬時に粉砕！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "これは追魔騎士の失策か！　鮮血のアーツを操る血騎士を相手に、無闇に近付いたことはまさに痛恨のミスだった～～ッ！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……今のは、幻覚か……？　まるで、一幕の戦争のような……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "追魔騎士",
          "text": "……が……はッ……あ、あぁ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "なっ、なんということでしょう！　この状況で、追魔騎士はまだ競技場に立っています！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "信じられません！　まさか、反撃するつもりなのか――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "――血騎士の名において、審判団への意見を申し出る。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "……そう。彼は既に、意識を失っている。これ以上判断が遅れれば命に関わるだろう。結果を言い渡してくれ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "――審判団の結論が出ました！　カジミエーシュメジャー決勝進出最初の騎士が誕生します！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "悪夢と王者の決闘！　恐怖と恐怖の腕比べ！　その勝敗はここに決しました――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "それでは、宣言いたします。勝者は――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "モーブがその名を呼ぼうとした時――会場の隅にある、よく目立つ仕切りの向こう側で。\n一人の感染者騎士が、最初に立ち上がった。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "感染者騎士A",
          "text": "血騎士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "感染者騎士B",
          "text": "血騎士！　血騎士！　血騎士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "これは……皆、感染者か？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "感染者騎士",
          "text": "血騎士が勝ったぞ！　血騎士万歳！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "観戦する感染者",
          "text": "血騎士！　血騎士！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "観戦する感染者",
          "text": "血騎士！　血騎士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "血騎士！　血騎士！　血騎士！\n血騎士！　血騎士！　血騎士！\n血騎士はゆっくりと手を挙げると、観客の声援に応えた。\nそしてそこで振り返り、いまだ倒れずに立ち続ける悪夢を見やる。\n彼が視線を上げると――悪夢の後ろ、遠い観客席にいた、とある騎士と目が合った。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マーガレット",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "血騎士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "血騎士！　血騎士！　血騎士！"
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "ええっと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ビッグマウスモーブ",
          "text": "（私のプロ意識が囁いている……！　観客の上げる歓声を邪魔するべきじゃない、って。……だけど、これはほとんど感染者だ……このままにして大丈夫なのか？）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "テレビの音声",
          "text": "血騎士！　血騎士！　血騎士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "燭騎士",
          "text": "……マーガレットさん。これが、カジミエーシュの感染者たちの英雄なのです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "燭騎士",
          "text": "あなたは、自らと重なるイメージを持つ相手に、どう対処なさるおつもりでしょうか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "テレビの音声",
          "text": "血騎士！　血騎士！　血騎士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ラッセル",
          "text": "これこそが、感染者騎士……ディカイオポリス。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "テレビの音声",
          "text": "血騎士！　血騎士！　血騎士！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "……英雄、血騎士……本当に、凄まじい影響力ですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "耀騎士は抵抗の手本にこそなりましたが……結局のところ、感染者に生きるすべを与えたのは、血騎士ディカイオポリスです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "とは言え、彼は我々に服従してから随分と経っています。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マッキー",
          "text": "……メディアに従事してきた身としても、君の提案にはまったく感服するよ、マルキェヴィッチ君。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マッキー",
          "text": "だが君も知っての通り……世論は、保険としては当てにできないものだ。万全を期すためには、強硬措置も用意しなければならない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "ええ、もちろんそのつもりです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "私はただ……みなに逃げる場を残したいだけなのです",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "興奮する観客",
          "text": "血騎士が、血騎士が勝ったわ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "興奮する観客",
          "text": "ふふふっ、血騎士はやっぱり無敵なのね！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "興奮する観客",
          "text": "――きゃっ、なに？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "興奮する観客",
          "text": "向こうの屋根……太陽でも昇ってるの……？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "――ッ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "あんた――",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "アーツを見られることを忌み嫌っているかのように、サルカズは黙して目を閉じていた。\n彼女の剣先はいまだ、夕日の如く短命なその輝きを纏っている。\nふと、何か思い出したかの如く、彼女は剣を振るう姿勢を変え、それをさやに収めて胸に抱いた。\n己の剣はさやから出るべきではない、とでも言うように。"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……今の……一体、どうやって……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "サルカズの巫術？　いいえ、違う。……だけど、はっきり感じたわ……",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "生命の息吹？　違う。――魂の力？　それも違う。\n何かもっと本質的な、夢や酒に酔って落ちる幻覚の中でしか触れられない、形なき幻影のようなもの……\nけれど、それが何であろうと、このサルカズは確かに、夜と昼の境界線を振りかざしたのだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……チッ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "本当なら、その一振りで……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "私を殺せたはずでしょう！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "これはあなたの矢を三本受けるだけ、というお話でしたので。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "無論、約束を違えるようならば、そうすることも厭いませんが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "あんたね――",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "その時、捕らえられたかのような感覚が、モニークを襲った。\n自分の意志で退くことすらできそうにない。間違いなく、追いつかれるだろうと感じる……だが、それは一体何にだろうか？　このサルカズに？　それとも、彼女の剣に？\nあるいは、彼女が握っている……生命の本質に？"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……さて、続けますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……いいえ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "契約一つ守れないようじゃ、良い仕事なんてできないもの。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "――撤退よ。ロドスへの追跡を中止して。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "ありがとうございます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……関係ない質問、してもいいかしら。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "約束を守る姿勢に敬意を表して、できる範囲でお答えしましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "あんたたちサルカズにとって、二つの角を削ることには……どういう意味があるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "……人によって、意味は異なります。サルカズであること自体が呪いに等しいと考え、そうした方法で出自を隠す人もいるでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "他方で、何かしらの巫術の媒介や、アーツの拠り所としている場合もあるかと思います。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "さらには……何処かの異民族の伝統ということもあるでしょう。可能性は多岐にわたりますので、これと定めることはできません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シャイニング",
          "text": "どうされたのですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モニーク",
          "text": "……何でもないわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
