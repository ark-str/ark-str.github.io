{
  "server": "jp",
  "storyId": "story_ghost_set_1_story_1",
  "groupId": "story_ghost_set_1",
  "stageId": null,
  "title": "メリークリスマス！",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_ghost_1_1.txt",
  "sourceHash": "3e11d3a7230f4d9ac03334a2d7fd89a763a18abdb28fcdc436da435aede68960",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "どうぞ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "こんにちは。私はスズラン……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "よぉ、アオスタ！　戻っ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "出て行ってください。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ひゃっ！？　お、お邪魔してすみませんでした。すぐに出て行きます……"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "いや、あなたのことではありません。口から先に生まれたようなこの騒がしい男に言ったのですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "この男をこの場に留めれば、必ず愚にも付かない話を延々し始め、しまいにはあなたにお聞かせできないようなことまで見境なしに口にするでしょう。ですから早めに退場願うのが正解です。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "へへ、なんだよ、俺のことは何でも分かってるってか？　お前を探してた嬢ちゃんを誰が案内してきてやったかは分かってんのかよ。作ってほしいらしいぜ、クリスマスの呪いのなんつったか……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "その、「スペクターさん」という方のお人形です。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "そうそう、そいつだ！　楽勝だろ、アオスタ？　こういうセコセコした針仕事はお前の一番の得意分野だもんな。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "スズラン嬢ちゃんは俺たちの部屋を探すのに結構な時間がかかったんだぜ。とっとと用意してやれよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "……そんな簡単な話じゃないんですよ。この単細胞生物が。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ごめんなさい。急なことですし、ご迷惑ですよね……"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "いえ、大丈夫です。話を聞かずに断るつもりはありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "それで、具体的にどのような人形をお望みですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "はい。実はクリスマスパーティのプレゼント交換用の人形を作っていただきたいんです。オーダーメイドのプレゼントを作ってくださる職人さんのリストでアオスタさんのお名前を拝見したので。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "プレゼント交換ですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "はい。交換と言っても、今回は事前の抽選でもう相手が決まったんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "私は「スペクターさん」にプレゼントすることになっているので、その方に似合うお人形を作りたいと思ったんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "おうおう、なんだやっぱり楽勝じゃねぇか！　アオスタ、いつまでも偉そうにデコにしわ寄せてんじゃねぇよ。何が気に入らねぇってんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "……あなたの希望はそれで全部ですか、スズランさん？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "はい！　報酬と材料費は私のお給料からお支払いします！"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "「約束事」のことはご存じですね？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "（緊張）は、はいっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "ん？　なんだ？　どうして嬢ちゃんはそんなカッチンコッチンに緊張してんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "製作依頼をお受けするかどうかは僕の気分次第なんですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "職人リストに掲載する受注条件を提出する時、「クリスマスは毎年一件限定受注」という注意を最後に記載しておきましたから。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "あ？　ははーん。お前さては「意地の悪い大人」キャラをやってんのか。注文を受け付ける条件ってのは何だ？　聞いてみて難しすぎたら受けねぇとか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "……どんな布製品の製作であろうと、僕にとっては造作もないことです。特殊な源石加工技術を要しないもので、入手し難い材料も必要ないのであれば、さほど時間はかかりません。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "スズラン……さん、あなたの依頼についてですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ううっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "……お引き受けいたしましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "や、やったあ！"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "（お前、「約束事」って結局、最初に来た依頼を受けてるだけじゃねえか。）"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "（フッ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "へいへい、まあでもこれで一件落着ってこったな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "一件落着？　なにを馬鹿なこと。これから、一番の問題である「デザイン」について話し合わなければなりません。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "デザイン……？　何か足りねぇっていうのか？　スズラン嬢ちゃんの注文どおりに作りゃいいんだろが？"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "はぁ……キアーベ、あなたは自分が考えなしなことを話す時、いかに間抜けな面を晒しているか鏡でよくよく確認したほうがいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "そういう持ってまわった言い方すんなって言ってんだろうが。おツムのよろしい連中のお上品な比喩はな、俺にはわかんねぇんだよ。いったい何が問題だってんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "あらかじめ申し上げますが、僕はわざと困らせようとしているわけではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "スズランさん。確認しますが、あなたが僕に作ってほしいのはプレゼント用のスペクターさん人形、それで間違いありませんね？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "そうです！"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "では、図面はありますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "……えっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "簡単な手描きの似顔絵や、文字で説明したものでも構いません。あるいはその「スペクターさん」の写真でも良いのですが、きっと何もご用意いただいていませんよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "……う……はい……用意してません。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "あ？　つまりどういうこった……？"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "キアーベ、あなたという人はこれだから……物事をもっと慎重に考えたらどうですか。そうすれば日常生活でも非常事態でも、もっと早く問題のありかに気付けるんですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "「クリスマスのプレゼント交換」というイベントは僕たちにとっては興味をそそられないものなので、具体的なやり方や参加者についても知りません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "そしてスズランさんも抽選の結果が出るまでどの参加者のためにプレゼントを準備することになるか、ご存じなかったんですよね？　その参加者と僕たちの関係も当然知らないはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "ここで問題が発生します。実は僕も、キアーベも、これまで「スペクターさん」という方のことを聞いたことがありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "食堂やジムでも会っていませんし、任務の遂行中でさえ姿を見たことがないのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "しかし、僕を選んだあなたの見る目に間違いはありません。僕が作る人形は間違いなく、当日交換されるハンドメイドのプレゼントの中でも群を抜いて素晴らしいものになります。"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "speakerId": "char_346_aosta",
      "text": "ですが製作のための最も重要な情報が今、欠けています。プレゼントの交換対象である、スペクターという名のオペレーターがいったい誰で、どんな姿をしているのか、ということです。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "……はぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "ははっ、しょげるなよ、嬢ちゃん。アオスタってさ、ちっとばかり無遠慮で無神経なだけでよ、依頼を断るってわけじゃねぇからさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "むしろよ、もし今嬢ちゃんがプレゼント作りを他の奴に任せようとなんかしたら、あいつは必ず自分の「武器」でそいつと競って、死ぬ気で依頼を完了させちまうと思うぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "いえ、すみません、キアーベさん。私が慌てて来ちゃったのが悪いんです。よく考えたら、プレゼントを受け取る相手のことさえきちんとわかっていなかったのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "それにしてもよ、そのイベントを考えた奴もおかしなことをするもんだな。参加者同士が互いを全く知らないなんてこともあるとは。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ふふっ。きっとそれがこのイベントの目的なんだと思います。お互いへの理解と関心を深められますから。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ただ、私は自分だけが「スペクターさん」のことを知らないのだと思っていました。まさか皆さんもご存じないとは……"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "まったくだ。珍しいんだぜ、この俺様でも助けてやれねぇことがあるなんてよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "まあでも、これはこれでありなんじゃねぇか。嬢ちゃん、あんたが頑張ってみんなに「スペクター」のことを聞いて回るんだ。そうしていろんな奴らと仲良くなるのも悪くねぇだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "……そいつが、関わっちゃいけねぇような奴じゃなけりゃ、の話だけどな。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "そのイベントの参加者に、危ねぇ奴はいねぇんだろうな？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "わ、私はそう思っています。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "はは、そうだよなぁ。聞いた限りじゃただのパーティーのイベントなんだよな、きっと……"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "じゃあまずは、いろんな奴に聞いてみな、嬢ちゃん！"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "ロドスは得体の知れねぇ奴がそこらじゅうにいるからな。ひょっとしたら「スペクター」って名前の通り幽霊みてぇに不思議でおっかねぇ奴で、闇夜の中でそろ～っと徘徊してたりしてな……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ひえっ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "そ、そうだとしても、プレゼント交換の相手ですから、私も頑張って……贈り物をお届けします！"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "おうおう、その意気だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "でも気をつけてな、嬢ちゃん。本当にヤバくなった時は俺やアオスタに声をかけりゃいいからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "speakerId": "char_349_chiave",
      "text": "ごちゃごちゃ面倒くせぇ問題事の解決は、俺たちの得意分野なんだからよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "うーん……これからどうしましょう……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "キアーベさんとアオスタさんが心配するのも無理はないです。「スペクターさん」のこと、私は聞いたことないですし、会ったこともないんですから……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ですが、イフリータさんが誘ってくれて、サイレンスさんがお手伝いを引き受けているイベントですから、きっと危険な人物はいないはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "でも知らない方ですし、誰に聞いてみればいいのかも分かりません……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "う……悲観的になっちゃダメです！　相手がどなたでも関係ありません。参加したからにはクリスマスを皆さんと楽しく過ごして、プレゼントを用意する過程や受け取る時の嬉しさを体験するんです！"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "私、イベントに参加してプレゼントをもらうのを楽しみにしてるんです。だから……相手も、きっと心待ちにしているはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "絶対に情報を集めてみせます。アオスタさんの作ったお人形はいつも絶賛される素晴らしいものですから、私もそれを相手に送り届けて喜ぶ顔を見たいです。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "さあ、今日は頑張って「スペクターさん」の情報を集めますよ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三十分後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "し……失礼します……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "あの……すみません……"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "あら、スズランじゃない。どうしたの……？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "慌てなくてもいいわ。お話はきちんと聞くから。何があったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "（スズランは普段、こんなに緊張した表情を見せることないのに……まさか、何か大変なことが起こったのかしら？）"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "わ、私、ある人を探しているんです……メテオリーテお姉さん、「スペクターさん」というオペレーターを知りませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "あなた……スペクターを探してるの……？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "はい。あの、友達にも聞いたのですが、みんなその方のことを知らないみたいで……私、なんだか悪い夢でも見ているようで。本当に「スペクターさん」はいらっしゃるんでしょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "そう……なるほどね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "大丈夫よ、怖がらないで。あなたは今のところ、恐ろしい出来事には遭遇していないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "「スペクターさん」は確かにほとんど人に知られていないけど、彼女もちゃんとロドスの一員なのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "でも確かに、彼女があなたのお友達と交流があるとは思えないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "それにしても、どうして彼女のことが知りたいの？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "あの私、彼女にプレゼントを差し上げたいんです……"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "プレゼント？　でもスズランあなた、相手の存在だって知らなかったんでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "ああ、待って……前にチラシを貰ったわね、あれのことかしら？　クリスマスパーティのプレゼント交換とかいう。それで彼女を探しているの？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "はい。もしかして……メテオリーテさんも参加するんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "ええ、私もプレゼントの準備中よ。なるほどね、そういうことなら心配ないわ。あの人のことなら、私もいくらか知っているから。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "そうですか。でも、どうして今まで、メテオリーテさん以外にスペクターさんのことを知っている人がいなかったんでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "一生懸命探してたのに……"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "あら頑張ったのね、スズラン。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "……だけどね、ロドスには、自分についての情報を隠さなきゃいけない人も少なくないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "私がスペクターを知っているのは前に任務の時、彼女と一緒に戦ったことがあるからよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "でも、メテオリーテさんが担当する任務って、どれも難易度が高い危険な任務ですよね……？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "そうね。ロドスが進んでやっていることではないけれど、私のように危険な問題を解決する「刃」も必要だもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "私としては、それはそれで気が楽だと思ってるんだけどね。安全な作戦だと、逆に動きが鈍っちゃうから。難局を切り抜けるのも楽しいのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "だけど、そうね。スペクターという「刃」は、私なんかよりずっと鋭いわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "メテオリーテさんは……スペクターさんがどんな人なのかご存じですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "私たちが一緒に戦ったのは一度だけよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "彼女は海からやってきた若い女性。常識では彼女の考えを理解することができない、そんな存在だったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "え……？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "戦術上のコミュニケーションが取れないの。最初に武器を持って、命令を聞いたら、彼女は任務が完了するまで、そのたったひとつの命令を守り続けることしかできないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "寡黙な方なんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "一言もしゃべらないことを「寡黙」という言葉で片づけていいのならね。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "ただ、寡黙というのは性質ではなくて、本人の選択の結果という場合もあるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "殺意を剥き出しにした危険な敵や、叫びながら襲いかかってくる怪物を見ている時でも、彼女はいつもあの「寡黙」さを崩さない。そこからどんな感情も読み取ることはできないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "そして……顔色ひとつ変えずに大胆な破壊を行うの。まるで最初から最後まで、自分一人で全ての脅威に対抗することが当然みたいにね。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "たぶん……彼女は自分が指揮官の命令を聞かなければならないということを理解している以外、周りのことを何一つ気にしていないと思うわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "敵だろうが味方だろうが、生きていようがいまいが、彼女の顔からは周りの物事にどんな感情の揺らぎも感じられないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "一言も話さないのは、彼女は意識的に「沈黙を選んでいる」ということかしら？　それとも他人と交流することを望んでいるのかしらね？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "あの……それなら、メテオリーテさん。戦場以外のところでなら、スペクターさんは誰かと交流があるんでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "難しい質問ね……でも私が思うに、スペクターの精神状態は正常な生活には向いていないでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "少なくとも……彼女が普通に宿舎に住んでいる様子を、私は想像できないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "つまり、もしかしたら医療チームの皆さんの方が……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "あっ……わかりました！"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "あら？　私は何も重要な手がかりを言ってないわよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ふふ、ヒントをくださってありがとうございます。また今度お時間があったら、もっとたくさんの戦場でのサバイバル話を聞かせてくださいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "……もし、争いが避けられないもので、他の人を守るために戦わざるを得ないのなら……私も、大切な友達と家族を守れる能力を持ちたいんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "あら？　スズランに聞かせる戦場の話……これはしっかり準備しておかないといけないわね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......\n......\n......"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "ただ、私でもスペクターともう一度、共同作戦ができるとは思えないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "あの戦場を離れてからロドスに戻るまで、目を閉じる度に彼女が戦闘中に敵を軽々と切り裂いていく姿が脳に浮かんできたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "もしスペクターに感情がないわけじゃないなら、彼女は空恐ろしいものを秘めているのかもしれないわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "speakerId": "char_219_meteo",
      "text": "そうでなければ、どうして自分の行動がもたらした結果に、あれだけ無関心でいられるというの……？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": null,
      "text": "はい、どうぞ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "すみません……"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "あら？　スズランが自分から私の医務室に来るなんて。医療部名物の超精密検査フルコースを受けたくなったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "いえいえっ！　そんな怖いことを言わないでください、フォリニックお姉さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "ふふ、冗談よ……今は休憩時間だから、スズランが遊びに来てくれるのは大歓迎だわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "それで、どうしたの？　何か話したいことでも？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "実は今、クリスマスパーティーの時に交換するためのプレゼントを準備しているんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "なるほど、それで？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "それで、私がプレゼントを贈る相手は、スペクターさんなんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "なるほど……え？　スペクター？"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "彼女は最近医療室を離れたことはないはずだけど。どうしてそんなことが……？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "やっぱり……フォリニックお姉さんはスペクターさんのことをご存じなんですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "よかったぁ。予想が外れていたらどうしようって思ってたんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "私はスペクターさんにオーダーメイドのお人形をプレゼントしたいと思っているんです。それで、彼女のことを少し知りたいんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "スペクターの情報……ねぇ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "確かに私は、彼女のことを知っているわ。ケルシー先生が彼女を診療するのを手伝ったことがあるもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "ただ、彼女は最近精神状態が安定していなくて、もうかなり長い間医療室にこもりきりで離れていないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "彼女は本当にプレゼント交換にエントリーしたのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "プ、プレゼント交換は、誰もが参加する権利があると思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "でも、メテオリーテさんも言ってました、スペクターさんはこんなイベントに参加するような人ではないと。もしかしたら……もしかしたら誰かが代わりに申し込んだのかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "もしそうだとしても、私はその人の期待に背きたくないんです。その人もきっと、スペクターさんのためを思って申し込んだんだと思いますから。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "そうでしょうね。スズラン、あなたは優しい子だから。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "私が思うに、そんなことを勝手にしそうなのは、お見舞いに来るあの……コホン。いえ、何でもないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "スペクターさんは重い病気で、ここを離れられないのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "まれなことだけど、意識がはっきりしている時は、外出することもあるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "だけど、彼女の言語機能には大きな障害が出ているの。他人の誤解を招くような言葉を言ってしまうことが多いから、たいていの場合沈黙を選ぶしかない状況ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "あと……戦場に出れば、過去に体に染みついた戦い方ができるし、思いきり戦った後、蓄積された過度な疲労のおかげで何も考えずに自然と休めるのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "だから、そこまで心配しなくても大丈夫。彼女は自分なりのライフスタイルで生きているから。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "そうなんですか。それなら私、スペクターさんにお会いしてみたいです……！"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "え？　そうねぇ……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "やっぱり、だめですか……"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "医療部の私でも、簡単に彼女の部屋には入れないのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "スズランは、自分でプレゼントを渡したいのよね？　ただ、その気持ちを伝えたくても、今のスペクターの情況だと、かなり難しいと思うわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "そうですか……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "でも……たとえ会えなくても、このプレゼントを完成させて、スペクターさんにお届けしたいです！"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "クリスマスのプレゼントを贈った時や、それを貰った時の嬉しい気持ちって、きっと意味があるんだと思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "ええ、ええ。さすがはスズラン。その優しさをいつまでも大切にしてね！"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "（小声）実は、あまりデリケートな情報でない限り、特例として教えられないこともないのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "ふふ、これでも、ケルシー先生の信頼をいただいた弟子だからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "フォリニックお姉さん、ありがとうございます！　できたら、お人形の製作に参考になるような、スペクターさんの情報を知りたいです！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "おや！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "これは珍しい、スズランではないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "スペクターのことを話しておったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "あ、ワルファリン先生。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "ああ、面倒な人が現れてしまった……"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "ちょうど入り口を通りかかった時に偶然耳に入ったのだが、スズランはスペクターのために人形を作りたいのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "なんともいじらしいではないか、妾が手を貸してやろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "待ってください。そう仰られても、あなたが盗み聞きをしたという事実は隠せませんよ、ワルファリン先生。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "彼女のスリーサイズや服の材料などの、細かいことも教えてやれるぞ……妾に与えられておる権限はフォリニック先生より大きいからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "え、そこまで詳しく……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "それだけではない。妾ならば、そなたの人形をスペクターに渡してやることもできるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "無論、代価は頂くがな……ふふ、ペンギン急便の売り子が売っておる記念版トマトジュースがよかろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "わ、わかりました。すぐに買ってきます！"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "子供を使い走りにしないでください、ワルファリン先生！"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "あ、スズラン！　今すぐ行かなくても……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "よし、この件はこれで仕舞いだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "え？　どういう……意味です？"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "先刻は危ないところだったではないか。スペクターの件だが、現状をスズランに知られるのは望ましいこととは思わぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "……彼女は心配していただけですよ。賢い子ですから、今はまだ知るべきではない、知らなくてもいいことがたくさんあると、頭ではちゃんと理解しています。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "だが、わずかな好奇心でも、取り返しのつかない事態を招くこともある。有名な戒めだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "……それにしても、いったいどこのお節介な輩がスペクターに善意を与えようとしておるのだろうな？"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "たぶん……他の誰でもないスズランにプレゼントを用意させるというのも、その人物の計画なのでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "まったく……もしスズランではない誰かが、何の前触れもなくスペクターについて尋ねて来たならば、それが誰であろうと間違いなく危険な兆候だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "逆に言えば、スペクターのことを話して、それが心からの親切心と気遣いなのだと相手に信じさせることができるのはスズランだけでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "この件についてスペクターはまだ知らないはずですから、当日交換するプレゼントの準備も……間に合わないでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "スズランが可哀想か？"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "いや、ただ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "だが、さっきの言葉は妾もその場しのぎで言ったわけではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "もしスズランが人形を持ってくれば、妾もどうにか手立てを講じてスペクターにそれを受け取らせよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "ですが、もしこの件がケルシー先生に知られたら――"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "そなたは先程申しておったではないか。スズランのためなら、そなたとしても「権限」を行使することを惜しまぬと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "それに、スペクターのためでもあるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "彼女がプレゼントを受け取った時にどんな反応を見せるのか……実験の一環としても、有意義な試みではないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "speakerId": "char_345_folnic",
      "text": "でも……どう考えても、結局この件でケルシー先生に怒られるはめになるのは私です！"
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "speakerId": "char_171_bldsk",
      "text": "ああ、それは妾の知ったことではないな――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "20日後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ううん……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ふわぁ――"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "もう朝かぁ……ええっと、上着は……よし！"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "今日は……フォリニックお姉さんのところへ身体検査に行って、ケルシー先生のところでお勉強をして……あ、午後はお茶会と裁縫の先生の公開講座があるんでした。最後まで集中しなくては。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "今から頑張ってお裁縫を覚えたら、いつかアオスタさんみたいに、皆さんに喜んでもらえるような、素敵なプレゼントを作れるようになるでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "ふふっ。アオスタさんに作ってもらったお人形は、クリスマス当日にスペクターさんに渡してもらうように、ワルファリン先生にお願いできてよかったです。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "先生は、スペクターさんはプレゼント交換に申し込んでくれた人物をおそらく知らないが、プレゼントを受け取ってから精神状態が少し良くなったみたいだって言ってました。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "はぁ。あのクリスマスも、もう六日も前のことなんですね……本当に楽しかったなぁ。今でもまだ夢の中にいるみたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "スペクターさんも、クリスマスの雰囲気を楽しめたらいいなぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "彼女の体調が良くなったら、一緒にお話をしたり、食事をする機会もあるでしょうか？　ふふっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "よし、そろそろカバンを持って……カバンは……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "……えっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "机の上に……これってプレゼントボックス？　昨夜は置いてなかったはずなのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "もしかして、プレゼントを贈る人が多すぎて、サンタさんが当日に配り忘れてしまっていたんでしょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "……わぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "これ……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "「深海からの贈り物」……"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "speakerId": "char_358_lisa",
      "text": "……オルゴールだぁ！"
    },
    {
      "type": "sceneBreak"
    }
  ],
