{
  "server": "jp",
  "storyId": "story_fmout_set_1_story_1",
  "groupId": "story_fmout_set_1",
  "stageId": null,
  "title": "占い",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_fmout_1_1.txt",
  "sourceHash": "ed7cbd8e58e7de286250a07c536ad9c0c61a62b1c2a506947e5b4971429fbbfb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 远山"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "週末\nロドス食堂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "要するに、こうするとじゃな――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "カードが自然とこちらの手から流れるように――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "こちらの手に落ちる。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "わあ～！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わかったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "わかんない！！"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "ギターノお姉ちゃん、もう一回やって！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ふむ……では、よーく見ておくのじゃぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "わかった――！"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "わあ～！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ちゃんと見えたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "全然見えなーい！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "やれやれ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "残念じゃが、今日のカードの授業はおしまいじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "えぇー！？"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "もうちょっとだけ！　お願い！！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわが次の授業の先生に叱られてしまうじゃろうが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "皆もわらわが叱られるのは見たくないじゃろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "ちょっとだけ！　ちょっとだけだから、大丈夫だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "決まり事は大切なものじゃ。己の欲望に任せて、それをないがしろにしてはならぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ふむ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "それでは、皆に宿題を出すとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "もし来週の授業で己の練習の成果を発表できる者がおれば……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "その子には――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "先生の宝箱からご褒美を取らせてやろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "宝箱？"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "ほんとに！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "本当じゃ。ちょうど最近、宝箱に面白いものを入れたところじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "勇気を出して皆の前で発表すれば、誰もが褒美をもらえるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "やったー！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ほれ、授業はこれでおしまいじゃ。皆自分のカードとおもちゃを、忘れずに持って帰るんじゃぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ではまた来週会おう。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "先生さようなら！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ふぅ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あらら、ホンマお疲れさんやな、授業は順調なん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "授業などと呼べるような代物ではないわ。実際は子供たちと一緒に遊んでおるだけじゃよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわなどより、おぬしの方こそ重い荷を担いでおるじゃろうて。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "子供たちに四則演算を教えるのは、頭も体力も要るじゃろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "大したことあらへんて。計算なんか、たくさんやれば覚えるもんやから。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "それにウチが教えとるのは計算とは言わへん。うーん、最初は何て言うてたかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "「経営教室」？　そないな感じやった気がするわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "実際はあんたはんの授業と同じや……一緒にただ遊んどるだけで、勉強なんかしてへんて。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "それは良いことじゃよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "商売とは残酷なものじゃからのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あんたはん、ようわかっとるやないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "不本意ながら、占いも本質的にはある種の商売じゃからのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "確かにそうやな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "では、おぬしの授業の邪魔にならぬよう、わらわはそろそろ行くとするかのう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ほな……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "――あ！"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "せや！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ギターノはん、ちょお待ってんか！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "まだ何か用かの？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "うん。ほれ、旦那さんがガヴィルはんたちと遠出するらしいやん、サルゴンの僻地に行くっちゅーて……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ああ、そうじゃな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ほんでウチもな、一緒について行くつもりやねんけど、そのついでにそこで商売できるか見てこよ思ってんねん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "なるほど。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "せやからな、あー、アレや……ちょこーっと融通利かせて――ウチのこと占ってもらえへんやろか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わかっておるじゃろうが――"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あー、もちろんわかっとる。せやけど……うん、つまりやな――"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "お金は全部仕入れに使うてしもて、今手持ちがホンマにないんや。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "はぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "分かった。報酬として金銭は求めぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ホンマに？　そら助かるわぁ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "じゃが一つ約束してくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "今度から――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "授業の時に子供たちに商品の売り込みはせぬと約束するんじゃ。"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "たとえお菓子であろうと、ダメじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あ……はは。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "んな殺生な。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "授業はお遊びみたいなモンやけど、ウチはちゃんと教えとるで。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "遊びか真面目か、わらわにとってそんなことはどうでもよい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "この約束を対価とすることにおぬしが同意するか、わらわにとって問題になるのはそれだけじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "もし約束を破ったら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "さぁ、どうなるであろうのう？"
    },
    {
      "type": "narration",
      "text": "//此处替换成懊恼"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "うぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "どうじゃ？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "わかった！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "うむ……おぬしの対価、しかと受け取ったぞ。"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "契約書とかは……いらへんの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわたちの約束は互いの信頼の上に成り立っておるゆえ、契約書などは必要ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "さよか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "では、始めるとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "この後、授業も控えておるゆえ、簡単な方法で占うとするかのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "（タロットを取り出す）"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "うわぁ！　す、すごいなこれ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "どのカードもめっちゃ高値で売れそうやん……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "カードをテーブルに広げて混ぜとるのは、シャッフルなん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "そうじゃ、しばし待つがよい。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "授業でやっとったみたいにパラパラって混ぜたらええんちゃうん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "そうする占い師も確かにおる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわは違うがの。一度二度ならば良いじゃろうが、ずっとそのように扱うとカードが痛むからのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "猛吹雪の中、頑なに進み続ける旅人みたいなものじゃ。いかに体が丈夫で服が暖かくても、体温は少しずつ奪われていくじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "低体温症になったと気付いてからでは取り返しがつかんのじゃよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あはは……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "サーミ人がよく使う喩えじゃが、おぬしなら理解できるじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "うんうん、理解したで。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "もうええかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "うむ、良いじゃろう……これで、カードがおぬしの迷いを晴らしてくれるはずじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "カードを一つにまとめ、山を半分に分けるのじゃ。そうして分けた位置から三枚引いてテーブルに伏せて置く……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "よいか、まだめくってはならぬぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "それって、ギターノはんは何もせーへんってことやんな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわはおぬしの迷いを晴らす手助けをしてやるだけじゃ。自らの運命は己の手で明らかにされるべきとは思わぬか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "それとも、おぬしは喜んで他人に運命を預けると？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "わかったわかった、ウチが自分でやるわ！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "一つにまとめて……二つに分けて……三枚引いて裏っ返しのまんま自分の前に並べて置けばいいんやな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "これでどや？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "思い切りのよい動きじゃな、一切のためらいが見られぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "せやろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "では、結果を見るがよい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "さあ心を落ち着けて、どれでも思う順にカードをめくるのじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "なんやクソ真面目な感じやな……プレッシャー感じてまうわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "恐れることはない、さぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "まず一枚目をめくるのじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "（カードをめくる）"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "カップのナイト……逆位置じゃな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ウチよぉわからへんねんけど、逆とかってなんか関係あるん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "簡単に言うと、逆位置は今おぬしが障害物に阻まれているということを表しておる。"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "えっ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "安心せい。阻まれていたからといって、それが必ずしも悪いというわけではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "今現在は、進むことができないというだけじゃな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "障害物を乗り越えれば、成功はすぐ近くにあるかもしれんのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "へぇ、そうなんや。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "詳しく見てみるとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "おぬし、商売で何か問題に直面しておらぬか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "うーん……かもしれへんな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "基本的に毎月そうやな。販売戦略を間違えるとまるっきり商売にならへん時もあるし、ホンマ頭痛いわー。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "チャンスは見つけているものの、逃してしまっておるのじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "せやけど、そんなん商売人からしたら日常茶飯事やで。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "だから今回は一か八かの大勝負に出ようとしておるんじゃな？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ああ、ウチは自分の直感を信じとる。ガヴィルはんの故郷に行けば絶対大儲けできるはずや！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "なるほどのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "じゃが、確かロドスの物資の仕入れはずっと人手不足のはずじゃ。おぬしが進んで彼らに協力すれば、金銭面で困るようなことはないし、大方のリスクもロドスが担ってくれるじゃろうに――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "何ゆえ個人経営にこだわるんじゃ？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "それは――"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "個人でやることに慣れてるからやろな……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ふむ。おぬしの経営戦略は、完全に利益のみを追求しているというわけではなさそうじゃな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "そない言うほど大したことやないよ。世の中を知るついでにお金を稼いで、生活費の足しにしとるだけや。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ええモンを得るにはお金がぎょうさんかかるからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "なるほどのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ほんでこのカードは、簡単に言うたら、あんまりええことあらへんのやろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "道のりはそう容易くはないじゃろうな。"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ええ？　ほなもしかして大損を……ギターノはん、助けてーな！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "そう焦るでない、まだ始まったばかりじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ほれ、二枚目をめくるのじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ううっ、怖いわ……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "（震えながらカードをめくる）"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ワンドのエース、正位置。"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ど、どんな意味なんやろか……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "チャンスをつかみ、その中から再び人生のアドバンテージを得ようとしている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "危険はあるが、自信を持って人生に挑戦しておるということじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "聞いた感じは何か良さそうやな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "以前に自分自身を占った時、わらわも引いたことがある。"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "へぇ――あんたはんも自分を占ったりするん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "何かをひらめいた時、占い師も自分の道を覗き見ていいんじゃよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "占い師っちゅうんは、お金もろて他人を占うだけか思うてたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "結局、金ではすべての問題を解決することはできぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "それに他人が干渉できぬ道もあるんじゃ。自分自身と対話をして、模索し、探求し、ようやく糸口を見つけるチャンスが得られる。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "複雑やね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "おぬしが自分の力で商売することを選んだと同じじゃよ。あらゆる決定や選択は、すべて長年にわたる経験の結晶――そうじゃろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "他人が与えられるのは助言だけじゃ……決定権は常に自分の手の中にある――今みたいにのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "もし三枚のカードがすべて最悪の結果だったとして、おぬしは自らの決心を覆すのか？"
    },
    {
      "type": "narration",
      "text": "//此处替换成懊恼"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "うーん、お金は使うてもうたしなぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "つまりおぬしはただ、慰めを求めに来たというわけじゃな。気持ちが楽になるような結果をわらわに告げてほしいと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ああ、答えなくともよいぞ。多くの者がそうじゃからな、わかっておる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "物事を決めかねている時、誰もが超常的な方法でなにもかも解決できれば、と願いがちじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "じゃが残念なことに、占いはおぬしたちが期待しているようなものではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわにできることは、前途を少し覗き見て、力の及ぶ限り手助けすることだけじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "おぬしは対価を支払った。ならば、わらわは全力で義務を果たす。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "それだけじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ギターノはん……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "では、続けようぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "わ、わかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "おぬしは冒険をするじゃろう、そしてその旅は決して穏やかなものではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "結果については、最後の一枚がもたらす啓示に期待するとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "結局、龍門幣一枚すら残らぬかもしれんがな。"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "だんだん雲行きが危うくなってきよったな……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわはただ、悪い方の可能性を言うたまでじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "大儲けの可能性とて、無きにしも非ずじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "そうなればええんやけどなぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "そうなれば、わらわはパフューマーの所へ行ってアロマセラピーのフルコースでも受けようかのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "支払いはおぬし持ちでな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ええで、儲かったらそんなんナンボでも払うたるわ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "フフッ、約束じゃぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "では、おぬしの今回の旅の結末を探るとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "最後の一枚じゃ、めくるがよい。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "（サッとカードをめくる）"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ツインムーン、正位置。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "正位置か、よかったよかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "それは……どうじゃろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "おぬし……ガヴィルの故郷の状況について調べはついておるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "サルゴンの市場なら調査したで。絶対よう売れるわ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "……であれば、それに越したことはないがのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "（普通のサルゴン市場ではない可能性が高そうじゃ……）"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "（正位置のツインムーン……）"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "旅は穏やかではない。前のカードも同じ予言をしておった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "欺かれぬよう、気を付けた方がよいな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわの助言は、可能な限り物事は慎重に行えということじゃな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ところで、おぬしは月が好きか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "大好き……とは言わんけど、気持ちが沈んどる時にデッキから月を見上げたら、少しは気が晴れるで。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "では月影は？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ん？　わざわざ影を見ようとする人なんておるんかいな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "月の輝きの下では、見落とされがちなものがある……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "このカードが示しておるのも、そういったことじゃな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "輝きによって覆われ、故意に隠されるものもある。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "それが幸いであるか災いであるかは、慎重に吟味せねばならぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "わかった。気ぃ付けるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "カードが示しておるのは、このくらいじゃな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "三枚のカードの組み合わせがおぬしに示すことは――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "クロワッサン、おぬしの未来は決して楽ではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "少なくとも今回ドクターと一緒に行く旅は、障害が多いじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "自分で感じぬか？　例えば心の中に微かな不安や戸惑いなどは――"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ちょっと……あるかも知れへんな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "せやけど、キバったらなんとかなるやろ！"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "その……カードにはウチが投資でヘタ打つとか書いてあるん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "いいや。タロットはそんな明確な未来を予言したりはせぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ほな、まだ救いはあるっちゅうことやね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ホンマにアカンかったら、貯金箱叩きゃなんとか持つやろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "そうであればよいがのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "占いは、これでおしまいじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "まだ何かわらわにしてほしいことはあるかの？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "うーん……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ギターノはん、自分も引いてみぃ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "さっき言うてたやん。占い師も自分を占うっちゅーて。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あんたはんの運気がどないなモンなんか、ウチ見てみたいねん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "じゃがそれはわらわが――"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ほれほれー。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "タロットはそういう――"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "もう、ええからさっさと引きぃや。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "（ギターノに無理やり引かせる）"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ほな、めくりぃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "待つのじゃ、準備をさせてくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "（カードをめくる）"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "カップの十……逆位置……"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "これって悪い意味なん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ならウチが逆にしたるわ――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "待て！　触るでない！"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あっ、うん……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ごめんな、ギターノはん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "いや。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "違う。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "カード位置が正か逆かは、めくった者のいる方向によって決まる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "つまりこのカードは――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "正位置じゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あー……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "そうか！　あんたはんはウチの正面に座っとるもんな！！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ほなこれは、良い意味ってことやんな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "わらわの仕事と人間関係で言えば……とても良い。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ほな――"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "（ギターノの腕をつかんで頬擦りする）"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "な、なんじゃ？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "その強運をウチに分けてーな。そしたら元手の回収くらいはできるかもしれへんやろ？　頼むさかい！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "そ、そこまで言うなら――"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "好きにするがよい……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ううっ、ウチは絶対元をとるんやああああ！！"
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "あっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "どうしたのじゃ？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "今ふと思うたんやけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "もしウチがあんたはんの運を借りたら、さっきの占いの結果も無効になるんちゃう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "さて、どうじゃろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "その可能性はあるんやな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "もう一度占うのなら、また別の対価を支払ってもらうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "……ほな、やめとくわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "うーん……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "頬擦りする分には、金は取らへんやろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "はぁ、おまけしといてやるかの……よい。金は取らぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "ホンマおおきに！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "五分後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "クロワッサン先生、来たよ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "子供オペレーター",
      "speakerId": null,
      "text": "あっ、ギターノ先生もいる、こんにちは！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "まいど。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ふむ、こんにちは。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "では、わらわはもう行くぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "ロドスを埋め尽くすほどの龍門幣が手に入ることを願っておる。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "任しとき！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "char_201_moeshd",
      "text": "今度欲しいモンあったらウチんとこ来たってや。大サービスしたるさかい！"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "時運は千変万化、その時が来ればまた詳しく話をしようぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "（手を振って去る）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ギターノ",
      "speakerId": "char_109_fmout",
      "text": "（クロワッサン、わらわの運気がおぬしの助けになることを願っておるぞ。）"
    },
    {
      "type": "sceneBreak"
    }
  ],
