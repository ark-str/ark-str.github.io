{
  "server": "jp",
  "storyId": "act18d3_level_act18d3_02_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_02",
  "title": "歌い手",
  "storyCode": "SV-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d3/level_act18d3_02_beg.txt",
  "sourceHash": "86639b329db5f8101e38a24fe8fe43c74fb34ad66b79ae73548d8976fab28be4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "p.m. 3:23 天気/曇天\nイベリア サルヴィエント"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "地図にある場所は……ここね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "……嫌な臭い。それに、気持ちいいとは言えない空気だわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "こんにちは。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "すみません――"
    },
    {
      "type": "dialogue",
      "speakerName": "別の男性住民",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "…………"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "……ここには怪物がいる、ですって？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "人しかいないみたいだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "（イベリア語）"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "今はこんな言い方しないのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "（発音を少し変えたイベリア語）"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "……それに、今の私は歌い手だもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "ホセさんが言ってたわ。歌い手はそんなことしないって。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "九十九……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "今、何か言ってたわね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "九十九。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "子供……？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "間違いない……数字を数えてるみたいね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "あっ――"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "私からネックレスを盗っていくなんて……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#6",
      "operatorId": null,
      "portraitKey": null,
      "text": "待ちなさい！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "九十九、九十九……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "もう逃げられないわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "う……あぅ～……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "なぜ私の物を盗ったの？　ここへおびき寄せるためかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "そう……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "落とし穴に、縄まで仕掛けて……残念だけど見え見えよ。三流バウンティハンターの待ち伏せの方が、まだサマになってたわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "出てきなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#7",
      "operatorId": null,
      "portraitKey": null,
      "text": "私もあなたたちに用事があるの。さっさとして。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "妙な奴だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "そうだな、トタン。こんな奴、見たことない。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "俺も、見たことがない。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "あなたたち、言葉を話せたのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "お前は何者だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "さすらいの歌い手よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "さすらいの歌い手？　それは何だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "トタン、こいつと話すな。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "知らない顔だ。妙な服を着ている。よそ者だな。何をしに来た？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "聞きたいことがあるの。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "お前……新品の服を着ているな。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "私の仲間を見なかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "それに、強そうだ。腹いっぱい食えているんだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "彼女は私より先にここへ来たはずなの。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "その箱も、重そうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "……楽器なんてどれも重たいものよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "持っているものだって、おかしい。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "ここのハープも、これと似たようなものでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "ほら、ちょっと弾いてあげるわ……"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "……ッ！　耳がおかしくなりそうだ。武器に、違いない。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "武器以外の使い方もあるわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "トタン、こいつ、変だ。もう構うな。話すの、疲れた。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "おい。ベンチを放せ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "ベンチ……この子のことかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "この子に危害を加えるつもりなんてないわ。ネックレスを持って行かれたから、追いかけたの。大事な物なのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "お前は、何か奪いに来たのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "違うわ。私は自分の物を取り返して、それから話の通じる相手を見つけたいと思っただけよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "あぅ……う～……"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "俺たちの子供に、触ることは許さない。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "俺たちの物を、奪うことも許さない。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "何を……"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "俺たちのルールを、破ることも許さない。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "トタン、あまり近付くな。どうするつもりだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "あいつは俺たちの子供を傷つけ、俺たちの物を奪い、俺たちのルールを破ろうとしている。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "あいつは、俺たちの姉妹ではないのか？　姉妹には、分け与えてやるべきだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "あいつは、違う。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "……話が通じる相手じゃなさそうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "なら、他をあたるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "駄目だ。行かせない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "待て、トタン……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "うわっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民B",
      "speakerToken": "avg_npc_187",
      "operatorId": null,
      "portraitKey": null,
      "text": "あ、穴が、ある……"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "木枠の穴だ。忘れたのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "speakerToken": "avg_1012_skadiSP_1#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "あら、それ本当に役に立つのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民A",
      "speakerToken": "avg_npc_178",
      "operatorId": null,
      "portraitKey": null,
      "text": "よそ者、ここは俺たちの場所だ。お前が来ていい場所ではない！"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
