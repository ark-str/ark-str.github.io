  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act5d0/level_act5d0_07_beg.txt",
  "sourceHash": "9f1f13d4beee62a475c5406f9f5e52a4858290b9c1573fadbe25a0a5bc16412d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ボス、ペンギン急便に動きがありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……想定内だ。奴に大した傷を負わせてなかったからな……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "それよりもカポネだ。奴はどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "じ、実は一時間前から全く連絡が取れなくなっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……最後の定期連絡はどこだった？　スラムか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ええ、そうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "やれやれ、奴には失望したぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "と言いますと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "まずは全チームに通達だ。元の計画に沿って、ペンギン急便の奴らを食い止める——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ま、一部の奴らにはもう連絡取れねぇだろうがよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "それはどういう……あっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "まさか——カポネさんがファミリーを裏切ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ああ、俺にはアイツが考えそうなことなんて全部分かるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "俺たちはガキの頃から一緒に育ってきた。自分の手で父親の為に裏切り者をバラしたのが、俺の——俺たちの最初の殺しだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "だがシラクーザの惨敗は俺たちを変えちまった。俺と奴の唯一の違いは、奴が臆病になり、俺は賢くなったってことだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "奴はファミリーを売るつもりだ。つまりファミリーの名前を変えるんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "なら俺たちはどうすりゃいいんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……ペンギン急便は想像よりも手強い。敵をあんまりいっぺんに作らない方がいいかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "やはり、先に裏切り者を片づけるべきかもしれねぇな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "こちらは三差路、異常なし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "わかった。なら予定通りの作戦で行動しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "ちょ、ちょっと待て！　作戦ってなんだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "あ？　お前マジで言ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "いやぁ、ちょっと確認するだけだって。龍門はあんまり詳しくないもんでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "安魂祭は0時過ぎから恒例のイベントが始まる。俺らの任務は人々がイベントで街を留守にしている間を狙って、ペンギン急便の連中を倒すことだろうが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "じゃあボスの——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "ウルセぇな。あれこれ聞くなよ。これは命令だ。いいから言われた通りにしてりゃあいいんだよ。早くしろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "……そういうことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "俺のことは殺さない。約束だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もっちろん。ありがとね、お兄さん。それじゃおやすみ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もしもしテキサス、聞こえる～？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "こちらの状況と同じだな。奴らはチームを分散させた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ただリーダー自らが戦闘に参加するからには、必ずもう一人が司令塔になり、部隊の配置を指揮しているはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "そいつを探し出し、対処すれば全て終わりだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "もしも～し？　テキサスさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "龍門の中心街に到着しました。だけど、本当に人が多いですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "敵の動向に注意しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "わかりました～！　街の仲間たちに監視してもらいますので……。あれっ待ってボス、フロートの上に行くの？　うわ、ちょっと待って——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……クロワッサン、バイソン、聞こえるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "テキサスさんが仰っていた、その司令塔に関して、少し意外な発見がありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "……バイソンはん、頭低くしぃや。あの箱の後ろに隠れるで。見つからんようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あっ、はい。テキサスさん、また後で報告します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "俺ら、これからはどうなる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "知らねぇよ。ボス……ガンビーノ・リッチの通信を切ってから、俺らにもう選択肢はねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "はぁ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "何ため息ついてんだ。カポネさんは龍門で俺らのためにここまでしてくれたのに、結果はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "ガンビーノの奴、シラクーザから移ってきてからめちゃくちゃなことばかりしやがって、いいことなんて何もしてねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "カポネさんの計画通りにいけてたら、こんな面倒なことをやらずに済んだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "もう鼠王と話がついているのに、なんで殺しをしなきゃならないんだよ。ここはシラクーザじゃないんだぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "はぁ、ボス、というか元ボスは、自分の鬱憤を晴らしてるだけなんだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "へん、ガキか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "（なんや仲間割れしとるみたいやな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "（みたいですね。これは絶好の機会です。ぼくたち——）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "！　そこにいるのは誰だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "およ？　この銃声どっからや？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "またあのスナイパーか——！　ぼくたちの居場所をバラした！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "ペンギン急便がいたぞ！　奴らを逃がすな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "執事",
      "text": "……バイソン様、申し訳ありません。これも旦那様からのご命令なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執事",
      "text": "しかしこともあろうにバイソン様を危険に陥れるなんて……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執事",
      "text": "この件が落ち着いたら、私は暇を頂くべきですかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執事",
      "text": "はぁ……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……向こうはトラブルが発生したようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシア、マフィアのルートの確認が終わったら、クロワッサンと合流して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "了解～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ソラ、そちらはどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "えっと……。彼らの動向は複雑ですが、二つのチームに分かれて行動しているみたいです。多分、罠かと——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "そんなに複雑なことではありませんよ。敵の内部に問題が発生したようです。これはチャンスです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "きゃっ！　びっくりした！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……お前、戻ってきていたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "なぜ仲間内のチャンネルをハッキングしているんだ。普通に通信をすればいいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "こうする方が早いので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ところでキミはいまどこにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "ザ・サッドカフェですよ。今日は休日であることをつい先ほど思い出してしまってね。本来の業務を取りやめ、こちらのイベントに参加することにしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "クロワッサンさんとあの新人くんの座標については、皆さんにはもう送ってありますよ。いや龍門ネットの通信速度は本当に気持ちいい程早いですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……わかった。各自の任務を遂行したら、それぞれ彼らのサポートに向かってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "これは反撃の絶好の機会だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "カポネさん、ボスがペンギン急便に奇襲を仕掛けた作戦は失敗したようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "当たり前だ。あの馬鹿に何ができるんだ。奴のことは放っとけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "……本当に良いんですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ファミリーに必要なのは生きていくための強固な基盤だ。名前がどうこうなんてどうだっていいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ところで、まだ鼠王は見つからねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "まだです。鼠王が残す痕跡が少ないもので……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "辛抱強くやれ。奴はこの都市の一部、龍門の影のようなもんだ。俺らの時間はもう多くないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "しかしもし鼠王に気づかれたら、我々は同時に三つもの勢力と対峙することに……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "それは誰にとっても同じことだ。もし劣勢に立たされたなら、俺はむしろこの状況を混沌へと突き落としてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "おい、ガンビーノから何か言ってきてるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "どうした？　なぜ喋らないんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "おいおい水くせぇなお前。俺の声が聞きてぇなら、直接連絡を寄越せばいいじゃねぇかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "……どうやって入ってきたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "どいつもこいつもお前と同じわけじゃねぇってことだ。親父の墓前で立てた誓いの言葉を、何の躊躇もなく踏みにじりやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "誓いの言葉？　ああ、あんなのは単に俺らが同じ道を歩んでいたからだろ。だがな、今は昔と違えんだよ、ガンビーノ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "今のボスは俺だ。お前には失望させられたよ。だが俺はお前に弁明するチャンスをやりてぇと思ってるんだ、ブラザー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "フン。七年前、先代ボスが暗殺されたとき、俺はお前の指示でこの龍門に飛ばされた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "そう、俺がその指示を飲んだのも、ここでイチからビジネスを開拓して、シラクーザのファミリーの後ろ盾を作るっていう大義があったからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "しかし結局お前はシラクーザで失敗して、オメオメとこっちに逃げて来たよな。そして俺が苦労してイチから作り上げた全てを奪いやがった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "止せよ、お前はこんなちっぽけな利益にこだわるような人間じゃないだろ。そうでなきゃお前はとっくに死んでるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "なんとでも言え。俺はな、今になってようやく気付いたんだ。ファミリーで最も勇猛な牙ってやつこそが、最もファミリーに害を及ぼす元凶になってるってことがよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "それでテメェの牙をへし折って、代わりに首輪でもハメて大人しくしようってのか？　ハッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "この龍門で、お前にこれ以上好き勝手させてりゃあ、俺たちは遅かれ早かれ時代の波に飲み込まれるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "へぇ、感動で涙が出そうだぜ。お前がファミリーのためにそこまで深く考えてるとは思わなかったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "お互い様だな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "お前も腕が鈍ったな、カポネよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "お前がシラクーザで受けた傷もヤバそうだな、ガンビーノよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "やめろ。お前を殺したくはねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "そりゃどうかな。本当はその逆だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ハッ！　俺のことをよくわかってるじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "なに——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ありゃ？　壁ブチ抜いて脱出しよ思っとったけど、なんや修羅場にブチ当たってもーたってやつか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "まぁええわ。えらいすんまへんな。どうぞお続けください。ウチらが道変えますよって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "早く追え！　あの二人を逃がすな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……これ無理みたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "丁度いい、役者が揃った。全員まとめて——。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "今度はなんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ハローゥ！　来ちゃったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……これは。全員揃ったようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "うーん、この感じは最終決戦ってやつかな？　ちょっと早くない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "問題ない。こんな茶番は早く解決するに限るからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ボスの命令通り、縛り上げて河に流してやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "フッ、混乱すればするほど都合がいいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "どうやら、ここから無事に抜け出せた奴だけが、今夜の勝者になるようだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
