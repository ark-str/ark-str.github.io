  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "07下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "ロドスは今後どうするつもり？"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "あれぇ……えーとぉ……私、自己紹介ってしたっけぇ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "それと貴君はこれからどうするの？"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "ようやっと片が付きましたからね。もちろん帰ってあの秘密主義者のリャンに……しっかりと始末をつけてもらいますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "うむ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "彼の言う通りかもしれないな。貴君と私たちの縁は、これで終わりではないかもね。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "ただ……"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "レイズさんはどうして……"
    },
    {
      "type": "dialogue",
      "speakerName": "レイズ",
      "speakerId": "avg_npc_039_1",
      "text": "……偶然兄弟弟子から灰斉山の件を知り、すぐさま尚蜀まで駆けつけてきたのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "レイズ",
      "speakerId": "avg_npc_039_1",
      "text": "一足遅れてしまいましたが、手遅れとまではいかないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "……そっかぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "リィンさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "一つ聞きたいのですが。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "あなた方のような存在は、どうやって……えーと、兄弟姉妹の序列をつけているのですかい？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "……長幼の区別か。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "渾沌の中で、答えを早く見つけた者から、他に先んじて人間（じんかん）に立てるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "何の答えです？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "簡、極まりないことさ。すなわち――"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "――「我とは誰か」。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "タイホー副監察御史、ズオ持燭人。お会いできて光栄です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "こちらこそ、ニン侍郎。"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "ニン侍郎にお目にかかる。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "せっかくお二方が尚蜀へいらしたのに、お出迎えも接待もできず失礼いたしました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "招かれてもいないのに来て先に礼を失したのは我々です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "ズオ公子は父君の命を受け、司歳台を代表して、酒杯と灰斉山の件を迅速に処理するために来られたのですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "さすがのご慧眼ですね、ニンさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "そして此度のリャンさんの行動は、方々が睨み合う硬直した局面を打破しようというものでした、敬服いたします。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……司歳台がこれほどまでに過激な策を弄さなければ、リャン様もあの行動には至らなかったでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "私は己に恥じることはしておりません。粛政院が今後この件を知り次第、公正な判断をしてくれるでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "すでに上奏文は起草してある。私心など挟んでおらぬことは保証しよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "……タイホー殿が仰った、「忠を取り義を棄てる」ですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "そうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "司歳台の此度の越権行為、太傅がどのような決定をしようと、ありのままを礼部尚書に報告させていただきます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "そうすべきでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "必要ない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": null,
      "text": "ズオ・ラウ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "は……はっ。ここに！"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": null,
      "text": "お主の推算を問う。もし先程の三人があのまま世に害をなし、また尚蜀に害をなしたとすれば、当時の状況からして鎮圧するのにどれだけかかる？"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": null,
      "text": "もしあの歳獣が目覚め、炎国が一都市でもってこれに迎え撃つとすると、いかほどの代償を支払うことになる？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "……前者は三日の時間を必要とし、後者は双方とも損害を受け、巨獣は死に、軍は三割も残らないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": null,
      "text": "リャン・シュン。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "はっ。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": null,
      "text": "もしも礼部と司歳台の平穏のため、お主に死罪を申し付けたら、いかがする？"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "判決に従います。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": null,
      "text": "ではもしお主の今日の行動で、何かの間違いが生じて尚蜀の町や民衆が損害を被っていたら、お主はどうする？"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "伏して生き長らえ、亡獣補牢に努めます。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "盤面はここに至って五分五分か。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "リャンが龍門人を選んで酒杯を運ばせたことは、本来相手を出し抜いた奇手であるが、あやつに察知され一手劣ってしまった。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "事はここに至ったが、盤面のどれほどが彼の掌中にあるか。彼の目算を外れていても、黒番に利する働きをするものもあるだろう。それはまたいかほどあるのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……太傅は、やはり酒杯があの者が仕組んだものだとご存じだったのですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "リャン・シュン、お主に代わって新たに知府を務める者が、一ヶ月以内に尚蜀に到着する。引き継ぎを行った後、わしと共に来い。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……！"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "太傅……それは……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "わしと都に来るのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "……太傅の寛仁なご差配に感謝いたします。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "ですが私はやはり……"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "――リャン様のご昇進をお祝い申し上げます。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "……私は……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……ニン侍郎。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "玉門（ユーメン）は既定のルートを辿り、すでに帰国している。昨日龍門と接触し、補給の準備をしているところだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "――！"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "玉門……天災を避けるために？　それとも……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "別の目的だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "お主は一足先に玉門へ向かえ。わしとリャンは都で事を済ませたら向かう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……！　承知いたしました。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "タイホー。"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "万事順調です。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "よかろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "……タイホーさん、もしや初めから……"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "「忠を取り義を棄てる」、公子あしからず。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "司歳台の此度の過ちはひとまず追及せん。今は、百八十一の黒石の行方を確定させることが重要である。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "……はい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "太傅はいつ尚蜀を去られるのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "明晩だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……そんなに早くですか。信使隊の護送を待ってはいかがですか……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "必要ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "バイ天師は太傅を見送るつもりのようですが。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "それも必要ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "尚蜀の山道は危険が多い場所です。太傅お一人では……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "なんだ、尚蜀にはわしに無礼を働くほど大胆な賊がいるというのか"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "……いえ。ただ、太傅はご高齢ですので、独りで外を出歩くとなるとやはり注意が必要かと……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "この炎国の威光が届く域内において、わしが恐れるのは民衆が安寧を得られず、国が昌盛できないことのみ。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "ほかに何を恐れる？"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "わしが恐れるに値するものなどあるか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "終わったな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "危ういところで肝は冷えたが、被害はなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "肝が冷えたのはお前じゃないだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "阻止できなければあらゆる者が最悪の事態に陥っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "お前が龍門から尚蜀に酒杯を届けるよう依頼したのは、初めは司歳台の密命を受けたからだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "だがお前は司歳台に酒杯を引き渡す気はなかった。尚蜀知府という立場からも、お前の身近にいる誰かさんの立場からもな。それでおれに盗人の名を着せて、鏢局を巻き込んで一芝居打ったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "――けど、お前はその芝居についておれに何も言わなかった。つまりお前さんは、そもそも芝居を演じる気はなかったってことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "私は昔から演じるのが好きではないとは知っているだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "お前が一人でこの方法を考えたのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "そうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "司歳台の持燭人が尚蜀にいる。加えて、そう簡単に酒杯を諦めやしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "民を守る知府であるお前は、そもそもこの件が尚蜀で起こることを望んでおらず、司歳台の暴走によって礼部と司歳台に衝突が起きるのも抑えたかった。ここまでが、お前の策だったと？"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "そうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "しかしそうすると、お前は不義を働いた輩になる。そこで……"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "お前が汚名を被るのを嫌がった者が――ただのお節介か、あるいはお前を後生大切に思っている者が、あの眠獣使いを寄越して、酒杯を奪わせた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "酒杯がお前の手から消えれば、お前さんが困る必要もなくなる。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "それが誰かはわかってたんだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "多分、わかっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "だがそこでシャンの横やりが入るとは、誰も思わなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "最終的に計画は失敗して、全員が取江峰に……この忘水坪に巻き込まれた。本当に賢くないやり方だよ、本当に……"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "だがお前にしては――リャン・シュンにしては、むしろ賢すぎたやり方なのかもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "……だから私は君に依頼したのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "私が何を考えているか察知できるうえに、絶対に友人を裏切らない君にな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "まだ友人として見てくれていることに感謝すべきかねぇ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "おれは最後まで手伝ってやったわけだがね、最終的に探してた答えは酒杯の主が誰かなどではなかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "何を探していたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "お前だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "お前は、まだ変わらず立派な志を抱いたあの時のリャン・シュンであるかどうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "……君の得た答えは？"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "お前は賢くなったよ、リャン。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "でも良かった。お前はやはりあのリャンのままだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "……ワイの行方については、いくらか手がかりがある。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "最初からあったが、おれに酒杯の件に集中してほしかったから教えなかった、そうだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "教えなかったことを責めているか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "いいや、おれの力を必要としているのはわかっていたからねぇ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "最近炎国で、とある噂が流れている。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "武林に関する噂だろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "speakerId": "avg_npc_295_1",
      "text": "武林である以上、必ず彼が関わっている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "うむ、尚蜀は良い場所だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "今年の梅の花は咲くのが遅いから、どうしてかと思っていたら、太傅がお忍びで尚蜀を訪ねていたんだね。これは珍客かな。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "いつからお主はこの山の主になった？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "ふむ。そう言われてみると、確かに私は半ばこの山の主みたいなものだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……量られるは、人にあらず。お主らである。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "来るべきその日に、お主らがどの立場に立ち、何を見て、心をどこに向けるかで、戦争の損失が決まる。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "炎国が負けることはないと思うな。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……お主は確かに炎国軍に代わって、その言葉を用いることができよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "お主とあの宗師は北の辺境を百年守り、大きな功績がある。そうでなければ、朝廷もここまで旧交を温めはせん。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "司歳台の行いは出過ぎたものではあったが、多くの民心を得た行いでもあったのだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "……崢嶸（そうこう）たる歳月、今もなお離れがたく惜しい。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "いまだに酒に酔った時は、野営地の角笛が聞こえてくる時があるんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……ニェン。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "なんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "朝廷はお主と取引がしたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "へえ。なんかとんでもねーことを命じられるのかと思ったぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "千年来、天機閣（てんきかく）は止まったことがない。無数の兵士や天師が北の辺境で戦死してきた。しかし正義は一尺、魔は一丈で祟りは絶えず、殺しても尽きぬ。一労永逸はあり得ぬのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "最も優れた兵士、最も偉大な将軍、最も叡智ある天師が、みな北へと馳せ参じている。毎年毎年な。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……朝廷はお主に天機閣の外に、十二楼と五城、からくり三千、兵俑百万を築いてもらいたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "この件はすぐに行う必要もないし、もとよりお主一人にやらせるつもりもない。炎国はすでに動き始めており、設計図の作成も各天師府に任せてある。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "お主には力になってほしい。少なくともあの楼閣からある人物を出してやってほしいのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "……誰をだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "倒れることなく、決して倒れてもならない者だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "……おい嘘だろ。レイズから噂を聞いたことがあるが、アイツのとこの開祖はくっそめんどくせー奴だって話だろ……アイツも会ったことないらしいが。"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "speakerId": "avgnew_2015_dusk_1",
      "text": "ふんっ……源石頼りに理を捻じ曲げた不死なんて。ほんと人間って嫌なものよね……"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "それはアイツがオメーにちょっかい出してたからじゃねーのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "speakerId": "avgnew_2015_dusk_1",
      "text": "ふん。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "ああ……彼女のことは覚えているよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "元気かな？"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……まあな。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "彼女は今に至るまで北を守って三百七十余年。もし彼女が国に帰ることができるなら、朝廷は喜んで彼女に閑暇を与え、晩年を安らかに過ごしてもらいたいが……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "しかしあの先達は常々暇ができないと言っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "かなりでけー話に聞こえるが、私に何の得があるんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "お主の望むことに、朝廷は力を貸そう。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "凶獣は、いつまでも檻に繋いではおれぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "ハッ、どれもオメーらに都合のいいように聞こえるな。さすがの炎国人は商売上手ってか……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "話は終わった、後はそちらで考えてくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "私からも一つ、願いたいことがあるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……何だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "今の彼は……"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "あれはあらゆる巨獣学者の予測を上回り、己の血肉を百八十一の黒石へと変え……世に放った。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "此度のあやつは天地を碁盤としている。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "どうしてなのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "侵分を経て、終局が訪れた日には彼は必ずまた真の姿を現す。その時自分で聞くといい。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "この一局は、必ずや勝たねばならない。"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "speakerId": "avg_npc_301_1",
      "text": "……負けられん。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "……君たちも聞いたね？"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "speakerId": "avgnew_2015_dusk_1",
      "text": "縦横十九路の盤上であの囲碁バカが太傅に負けることはあるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "もちろん負けないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "speakerId": "avgnew_2015_dusk_1",
      "text": "なら太傅はどうやって勝ったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "太傅は彼と対局してないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "speakerId": "avgnew_2015_dusk_1",
      "text": "どうして？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "縦横十九路の盤において黒白の置かれ方は幾千万、無論そこに碁の妙がある。でも太傅は、彼が碁盤の上では人の心を理解していないと話していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "speakerId": "avgnew_2015_dusk_1",
      "text": "人の心？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "だから太傅は彼と別の対局をした。炎国の地を碁盤とし、民を駒としたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "speakerId": "avgnew_2015_dusk_1",
      "text": "……どっちが勝ったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "その時は太傅が勝った。だから彼は炎国に捕らわれることを受け入れて、一局負けるごとに六十年の禁足を自らに課した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "それじゃあ、炎国に奇才がいて勝ち続ければ、アイツはずっと都から出られねーんじゃねーか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "さあなあ。あれで実は囲碁が不得手なんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "碁を学ぶ速度は酷いものだった。一番初めの頃、彼は六十年間で数千数百局は負けた。その後の六十年で負けの回数は徐々に減り、そしてさらに六十年で、負けは百回程度になった。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "そうして、ある日を境に、彼に勝てる者はいなくなったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "最後の六十年が過ぎた後、彼は都を去り……あの件が起きた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "ジエはその時……"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "うん。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "誰だってわかるよ。それがどれほどの打撃だったかはね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニェン",
      "speakerId": "avgnew_2014_nian_1",
      "text": "だから太傅がアイツに勝った時、アイツはすごすごと都に戻り、誓い通りに罰を受けたのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "彼はもう随分と完敗したことがなかったんだろうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "あるいは……彼は炎国だけに目を向けているんじゃないのかもね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "speakerId": "avg_476_blkngt_1",
      "text": "……君がニン・ツーチウだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "あなたは天師府の隊を襲うほどの度胸があるバウンティハンターさんですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "speakerId": "avg_476_blkngt_1",
      "text": "あ、あの時は彼らが良い人って知らなかったし……"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "speakerId": "avg_476_blkngt_1",
      "text": "あのバイっていうお爺さんは、今どこにいるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……彼の所に連れて行ってあげましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "今回の件について、あなたにお礼を言わなければなりませんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "speakerId": "avg_476_blkngt_1",
      "text": "大したことじゃないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "speakerId": "avg_476_blkngt_1",
      "text": "でもさいくら考えても分からないんだ。たかが酒杯一つだよね。場所がわかってたなら、自分で持って帰っちゃえば良かったのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "彼は私に渡したくないんですもの、勝手に持っていくことはできません。"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "speakerId": "avg_476_blkngt_1",
      "text": "だから私の手伝いを必要としたの？　どうして？"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……どうしてでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "ただ、全く自覚もないまま、これだけ多くの面倒事に彼が巻き込まれてほしくなかったから、ですかね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "……やはりこちらのバウンティハンターは、ニンさんの手の者でしたか。"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "speakerId": "avg_476_blkngt_1",
      "text": "！"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "警戒の必要はありません、彼らは敵ではありませんから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "ただ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "元はと言えば司歳台が事を急いだのが原因ですから、こちらの方を問い詰めるつもりはありません。えっと……もちろん、彼女が合法的な手段で炎国に入っていることが前提ですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……もちろんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "バイ天師の所へ行きなさい、イェバン。彼は以前教えた場所であなたを待っていますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イェバン",
      "speakerId": "avg_476_blkngt_1",
      "text": "……わかった。じゃあね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "ニン侍郎は、司歳台とリャン知府の計画をとっくに見破っていたのですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "そこまで早くからではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "ですがあなた方は、リャン様の仲裁の計画を見破れなかったようですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "……彼はニンさんを裏切ることに、疑念を抱いていただけかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "いずれにせよ、此度の一件で司歳台は確かに分を越えた行いをしました。後ほど司歳台から礼部にきっちりとご挨拶いたします。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "……構いませんよ。いずれも炎国のためにしたことですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "寒くなってきましたので、あなた方も早めにお休みください。私は少しイェバンの様子を見てきます。初めての炎国のようですし、やはり彼女が心配です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "お気を付けて。"
    },
    {
      "type": "dialogue",
      "speakerName": "ニン",
      "speakerId": "avg_npc_298_1",
      "text": "では。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "公子。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "彼らの私情が……今後の大事に影響しなければいいのですが。"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "公子、その言葉、いささかあえて年寄りじみた発言をしているように聞こえます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "持燭人として、そういったものとは無縁ですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "恐縮ですが、公子が以前通りかかった村で、賊をひっ捕らえ――"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "ゴホッ、ゴホッ――あの時の女性はただ感謝の気持ちがあっただけです！　男女の情などとは異なります！"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "助けた恩が介在するのであれば、向けられる感情は純粋とは言えません。こちらが弱みにつけこんでいるとすら言えます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "speakerId": "avg_npc_297_1",
      "text": "つまりタイホーさんの誤解ですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "……うむ。"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "speakerId": "avg_npc_299_1",
      "text": "正論なり。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "リーさんは龍門に帰らないのぉ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "帰りません。まだ人を探すんでね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "通り道かなぁ？"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "どうせウユウくんと一緒に事務所に行ってから、ロドス本艦に戻るわけだし……"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "通り道のようですね。ただ今回は、もうロドスの手を借りられませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "遠慮しなくて平気だよぉ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "本当に個人的なことなんでね。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "今回の件に巻き込じまったせいで、あのウユウさんに至っては足を怪我してまだ病院にいますからねぇ。みなさんにこれ以上迷惑はかけられませんて。"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "……わかったよぉ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "speakerId": "avg_473_mberry_1",
      "text": "ク、クルースさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "あっ、マルベリーさん～！"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "あなたが尚蜀にいるってことは、ラヴァちゃんがとっくに事務所に着いてるってことだよねぇ？"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "speakerId": "avg_473_mberry_1",
      "text": "は、はい……それにラヴァさんから伝言を預かっています。何やら別の問題が発生したようで、早く事務所に行った方がよろしいかと……"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "アハハ……今回の炎国の旅はほんと波乱万丈だねぇ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "よくあることです。"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "これまでも龍門とかでしか経験したことないけど……そうだぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "前から聞きたかったんだけどぉ、リャン様は龍門のウェイさんと似てるって言ってたよねぇ。どこが似てるのぉ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "そんなこと言いましたっけ？"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "speakerId": "avg_1021_kroos2_1",
      "text": "言ってたよぉ。しばらく一緒に過ごしたけど、私は全然似てないと思うなぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "うーん……"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "speakerId": "avg_322_lmlee_1",
      "text": "まぁ……どちらも思い人の尻に敷かれていますからね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "戻ってきたか。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "百八十一に分れるなんて……君は歳よりも先に理性を失うことになるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "ここ数年、お前はずっとここで夢うつつに過ごしてきたのか？　いや……歳月はお前にとって意味はないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "行裕鏢局の茶番は、君が画策したものだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "すべてがそうではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "彼らは私とは何の関わりもないけれど、どうして巻き込んだの？"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "ただの忠告だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "私への？"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "お前は夢の中で天下の物事を知り、乾坤の大きさを知るも、いまだ草木の青さを哀れむ。"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "江南から北を巡って、この山頂へと戻りお前は随分と変化した。私は不安なのだ妹よ。だから忠告しに来た。"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "妹よ、人の心とは、道徳家が吹聴するほど純粋ではない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "同門で殺し合い、骨肉の兄弟も反目し、愛も憎悪もいずれも碁の一手となるよ。\nお前は恐れていない。今のお前は当然恐れていない。しかしいずれは恐れるだろう。ニェンは恐れ、シーは恐れる。彼女たちはあまりにも人らしくなった。故に恐れる。\nこれは……私からのささやかな忠告だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "怒ったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "杯の中にあるのは酒だけであるべきで、酒はおしゃべりであってはいけないよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一瞬にして、万物が止まった。\n尚蜀三山十七峰、今では一峰増えている。さらには無数の木、無数の枝、無数の葉。\n風はあるが、葉は動かない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "尚蜀はかつて天災に見舞われた。\n荒れ狂う嵐に火花が混ざって、砕けた源石結晶が火の雨のように降り注いだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "――！"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "――尚蜀は――かつて天災に見舞われた！"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "ある者が――酒を把（と）って天に捧げ、黒雲を退け、人々の安全を守った！　なのに今、お前はその手にある酒杯を暗雲へ投げつけようとしている！"
    },
    {
      "type": "narration",
      "text": "一つの黒い酒杯。一つの黒石。\nこの大地で最も恐ろしい災いを前にして、一瞬にして跡形もなく消えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "お前は憤怒しているか？　お前は哀感に打たれるか？　お前は嫉妬に灼かれるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "杯の中の声",
      "speakerId": null,
      "text": "この感情を刻んでおけ――大勢はまもなく動き始める――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "……世はまもなく動き始める……私も我関せずではいられない……でしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "ふぅ――ふぁ～。"
    },
    {
      "type": "dialogue",
      "speakerName": "リィン",
      "speakerId": "avg_2023_ling_1",
      "text": "……酒でも買いに行こうか。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "speakerId": "avg_npc_302_1",
      "text": "……俺は尚蜀を去る。"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "止めはしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "我々が互いを殺したいのであれば、そもそもこれは複雑な問題ではなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "だがどちらも相手の手でケリをつけてほしいというのであれば……"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "speakerId": "avg_npc_302_1",
      "text": "やり合うのはやめておこう、きりがない。"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "私は引退するつもりだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "speakerId": "avg_npc_302_1",
      "text": "ヤオイェはまだ準備ができていない。それのあの娘は、独立したい考えがあるんじゃなかったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "ならば、店じまいだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "反対か？"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "speakerId": "avg_npc_302_1",
      "text": "俺はもう鏢局の人間じゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "それもそうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "speakerId": "avg_npc_302_1",
      "text": "言っておくが、俺たちのことはしばらく棚上げというだけだ。これですべてがチャラってわけじゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "鏢局の掟では、酒の席で私怨の話をしてはならん。いずれにせよ私は尚蜀でお前を待っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "speakerId": "avg_npc_302_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "speakerId": "avg_npc_302_1",
      "text": "最後に一つ。"
    },
    {
      "type": "dialogue",
      "speakerName": "山の担夫",
      "speakerId": "avg_npc_302_1",
      "text": "聞いた話だが……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "speakerId": "avg_npc_296_1",
      "text": "父さん！　シャンさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "テイ",
      "speakerId": "avg_npc_300_1",
      "text": "なんだ、騒々しい……"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "speakerId": "avg_npc_296_1",
      "text": "あたし決めたわ！　若い衆たちとも話をつけたわ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "speakerId": "avg_npc_296_1",
      "text": "あたしたち玉門に行きましょ！"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
