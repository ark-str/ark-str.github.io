{
  "server": "jp",
  "storyId": "act15d0_level_act15d0_01_end",
  "groupId": "act15d0",
  "stageId": "act15d0_01",
  "title": "密会",
  "storyCode": "MB-1",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15d0/level_act15d0_01_end.txt",
  "sourceHash": "8b75ca30e2dcf49143077b04b0c7f36387035359590ebbb1c5295c7d61263beb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "くらえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Aエリア囚人",
      "text": "ぐふっ、くそがっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "うわあ！　ちょっと、何これ？　なんで急に大乱闘が始まっちゃってんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "カフカ、隠れとけって言ったろ？　なんでここまで出てきてんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "カフカなら大丈夫だよ、それよりもどういうことか説明してよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "見りゃわかんだろ？　目障りな非感染者のヤローどもを、今日こそ完膚なきまでにぶちのめしてやんだよ！　まあ向こうも同じことを思ってんだろうけどな。よくあることだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "確かによくあることかもしれないけど、こんなに堂々と殴り合うって……看守は何してんの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "看守たち？　ハッ！　周りをよーく見てみな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "ハハッ、コイツら、飽きもせずまた喧嘩してやがる。こりゃ見ものだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "今日が当番でラッキーだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "ハハッ、そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "こんなクソみたいな職場で唯一の娯楽といや、このバトルロイヤルくらいだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "頑張れー、Aエリア！　今日はお前らに賭けてやるぞー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "ほらな、あいつらが一番楽しんでるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "勝った方はしばらくの間、飯のグレードが良くなるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "楽しんでるのは看守たちだけだよ、殴り合わなきゃダメなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "殴り合わないだと？　カフカ、お前俺が監獄に入った理由を知ってるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "それは俺を見下した奴らをぶちのめしたからだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "カフカ、この監獄は多分この大地で唯一、感染してねえクズどもを後先考えずにボコれる場所なんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "もし殴り殺しちまったところで、しばらく懲罰房に閉じ込められるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "それにもし自分が死んじまってもそれはそれだ。監獄に入るような連中の誰がそんなことにビビるってんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "てなわけで、俺はぶん殴りに行ってくるからよ。お前は隠れてろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "チェッ、カフカも甘く見られたもんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "それにしても、感染者と非感染者の対立って、こんなところにまで波及してたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "しかも、ただ対立してるだけじゃなくて、監獄の環境の影響で、超歪んだ形になっちゃってるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "監獄の外でも色んなものを見てきたけど、こんな光景は初めてよ……もしサイレンスが見たらきっと目を回すだろうなあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "でも、カフカは違うもんね、へへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "混乱はカフカの大好物だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "君たちは殴り合ってればいいよ。カフカは、何か面白いものがないか探すからさ。今後のための布石が打てるかもしれないしね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "えぇ……こんなところに食べ残しを持ち出すなんて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "なんで靴下が？　しかも片っぽだけ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ふーん、さすが州立の監獄、やることはちゃんとやってるじゃん。使えそうなものはパッと見、特に何もないな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "でも――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人",
      "text": "死ねや、クズが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Aエリア囚人",
      "text": "死ぬのはてめえだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "おおっ！　めっちゃエキサイトしてんじゃん！　しかも……みんなずるーい、密かに色々、変な武器まで作っちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "その調子でやり合っててね、もっと夢中になるといいよ。カフカはその隙に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人",
      "text": "捕まえたぜ。こんなとこに隠れてやがったか。へへへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ああ、あの女の子危ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "助けてあげた方がいいよねぇ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人",
      "text": "へへ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "あれ、あの子、意外とやるのかも。これは面白い……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何をしている！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "バートン隊長、囚人たちがケンカを始めました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "ならお前たちは何故黙って見ているのだ。さっさと止めないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "text": "あっ、隊長、もう終わりにしますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "終わりも何もない！　囚人を管理するのが我々看守の役割だろう！　さっさとしたまえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "わ、わかりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "看守A",
      "text": "おい、お前ら！　隊長命令だ、もうやめろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人たち",
      "text": "*クルビアスラング*",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Aエリア囚人たち",
      "text": "*クルビア方言*",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "ああ、全く何度言わせれば気が済むのか。ここは監獄である。お前たちの戦場ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "お前たちはここできちんと働いて、真面目に過ごすべきだ。そうすればこそ、外にいる家族や友人に早く会えるのではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "俺がこんなこと言うのはお前たちのためなのだからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "チッ、また始まったぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "うっわー、傷だらけじゃん、大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "こんなモンかすり傷だ！　そんなことより、Aエリアのクズどもを何人もぶっ飛ばしてやったぜ！　へへっ、ざまあみろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "いつもこんな感じで終わるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "あ？　バートンのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "まあそうだな……バートンはいっつも気取った態度で現れて止めに入るんだ。そしてクソみてぇなキレイごとを言いやがる。あいつが看守長だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "特に今は、監獄が都市に立ち寄ってて獄長が留守にしてるからな。まるで、自分がこの監獄の主みてぇに振る舞ってやがんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "いけすかねえ野郎だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "でもな、毎度毎度こんな感じで終わるってわけでもねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "ヒートアップして収まらないことは、過去に何度もあった……いやむしろ収まらないのが普通だな。今日みたいにやめろって言われて収まる方が珍しいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "まあ収まらない時は、バートンが応援を呼ぶんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "応援？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "ほら、来た。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "アンソニー！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "どうやらマジであいつを知ってるみてえだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "カフカが見たのは正装した姿だったけどね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "お前たち、ミスター・アンソニーを見習え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "彼は囚人の身ではある。そうだ。彼は、罪を犯した囚人でありながらも！　それを深く悔い、理性を尊んで暴力に走らない。普段は読書や音楽なども嗜む。なんと品のあることか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "おえぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "アンソニーが嫌いなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "いやいや、勘違いするな、カフカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "この監獄で、アンソニーを認めない奴はいねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "普段のあいつはバートンが言ったように他人に暴力は振るわない。だが俺たちはみんな知ってる。あいつこそ、この監獄で一番強い奴だってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "なんでもあいつは、監獄に入ったばかりの頃、Cエリアの奴ら全員をぶちのめして服従させちまったらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "あいつはCエリアのもんだ。普段は俺たちと関わることはねえが、本当にいい奴なんだ。AエリアだろうがBエリアだろうが、みんなあいつのことを認めてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "ああ、俺が吐き気を催したのは、バートンのクソ野郎のせいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "お前も聞いただろ、あれは本当にアンソニーを褒めてたかよ？　恥をかかせてただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "アンソニーは、唯一あいつが頭の上がらない囚人だ。だがそれでもあいつは、アンソニーに頼らないと俺たちを抑えられない。だからあんなふうに嫌味を言うことくらいしかできねぇんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "我らが州立マンスフィールド監獄は、首都特別認可の試験監獄だ。将来的にはここのシステムが、手本として他の州にも広められる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "text": "ケッ、囚人ばっかなのに何が手本だ……肥溜めで金でも探してんのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "とにかく！　お前たちには自分のため、そして俺のために、是非とも色々と考えられるようになってもらいたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "text": "行くぞ、アンソニー。今日は特別に読書の時間を一時間やろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "普段はアンソニーに会えないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "まあ、そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "あいつら重罪人たちのスケジュールは、俺たちとは全然違うんだ。それにほとんどの時間はCエリアにある塔の中にいるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "text": "なんだ、あいつに会いたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "まあね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "アンソニーに相談したいことがあるんだよね～。もちろん、看守に知られたらマズいやつだけど。",
      "portraitKey": null
    },
    {
