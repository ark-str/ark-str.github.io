{
  "server": "jp",
  "storyId": "story_utage_set_1_story_1",
  "groupId": "story_utage_set_1",
  "stageId": null,
  "title": "トレンディ・トリック",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_utage_1_1.txt",
  "sourceHash": "0560e732b3d4cc32a7751a873f056dcd0461abc53eaa227bc47f0733098fb2d2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ウタゲ、あんたならわかるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "確かに前までは、毎週サンセット通りでお買い物したり、セブンポインツホテルでお茶したり、映えるとこ行って写真撮ったり、土曜日のディナーは極東料理って決めてたり、好きなようにしてたよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "なのに今ときたら、Mangoの最新機種買うにもお金を借りてるくらいなの。しかも分割払いでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "この空虚な目が見える？　あたしもお財布も、まさにこういう感じなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "だからこの「オリジン・ストライフ」でこんなもん売るようになったわけ？　こっちの棚にあるやつとか、何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "今はミニマル志向のサコッシュが流行ってるんだよ。サンセット通りでは出したら即売り切れになるくらいなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "こんなの枕カバーに紐つけただけだって言ってたくせに……げっ、ねえちょっと、あっちのは何なの？　スリッパ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "スリッパじゃなくてプリントサンダル。トレンドなんだけど、知らない？　ウタゲくらいの若い子はみんなこういうの履いてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ついでに言っとくと、ここ五年で流行ったやつを参考にして、あたしが自分でデザインしたやつだからね。今っぽさ抜群の三種類から選べますってことで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "で、前みたいなやつはどこいっちゃったの？　ほら、「セクシー看守さん」とか「ダークな女王様」とかをテーマにしたやつ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あんたのお気にだった「ワイルドジャングル」シリーズですら帽子がちょこっと残ってるだけじゃんか……駄獣形のペンダントも見当たらないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ああいうのは……もう出してないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "じゃあ、この先あんたのとこでは買えないってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "あたしはこれまで通りじゃいられないんだよ、ウタゲ。欲しいなら今度また来てくれれば、タダであげるからさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "正直、ウタゲにはすっごく感謝してるんだ。あたしのデザインを応援し続けてくれたのも、一緒に楽しく過ごしてくれたのもね。それにもちろん、あたしだって自分の作品のことは大事に思ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "でも、本当に売れないんだ。特にウタゲが龍門を出たあとは、常連客がたまに何人か来てくれるだけで、新規のお客さんなんてほとんどいないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "とはいえ、一番大きいのは、お父さんがお金を出してくれなくなったことなんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "お父さん、ちょっと前にループスの女の人と結婚したから、あたしを養うお金はもうないんだって。お陰であたしは自立するか、ホームレスになるかの二択になっちゃったわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "つまり、今のあたしは……前みたいに、お父さんのお財布頼りでウタゲを連れまわして自分のアートを探求する～なんてことできなくなっちゃったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "それで……ぶっちゃけ稼げてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "今のところ……まだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "けど、あとちょっとだって！　時間さえあればなんとかなるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "そりゃあ、ハイエンド市場は「Marthe」とか「0011」とかの老舗ブランドがいまだに独占してるけど、今の流行を引っ張ってるのは、街角のショップだしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ミニマル志向や機能性重視の流れとか、ニューレトロやストリート系の流行りとか……トレンドを掴んでこそ未来も掴めるってもの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ほら、見て。ここにある商品は全部、トレンドをしっかり押さえてるの。ナンセンスな自称アートを気取るより、消費者のニーズに合わせてこそ、「本当のファッション」でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "こういうのが売れてるのはこれが人気だっていう証拠だし、そこにあたしの才能を加えれば……うちの商品が他よりイカしてることに気付いてくれる人もいるはずだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "それに……あたし、新人デザイナーとして春のトレンドファッションショーに出展することにしたんだ。最近はその準備中なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "このショーにはハイブランドは参加してないけど、トレンドを押さえたデザインが多いから注目度も高めでさ。良いチャンスになるかなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ああいう派手なファッションショーは嫌いなんじゃなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "「うぬぼれ屋のお偉方と、権威ある人の承認をもらいたい無能なデザイナーたちのためにある場」だとか言ってたじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "今思えば、まあ、そこまで否定することもなかったかなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "あの頃は若かったし、お金にも困ってなかったからさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "姿珍（ズージェン）、真面目に聞きたいんだけど……あんた、本気で自分のデザインじゃよその店に勝てないとか思ってんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "少なくとも向こうのほうが売れてるし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あー、うざ。なんか連絡来ちゃったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "とりあえず、次はもっとちゃんと話そうよ、ズージェン。今日のところは、そっちの帽子全部もらってくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "これまで通り20％オフでいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ごめんウタゲ、今は割引やってないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "へー、そっか。……ま、「変化」を起こしてみるのもいいかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "それじゃ、ショー頑張って～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ファッションショーねえ。そういうのしばらく行ってないな～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "んー……たまには行ってみてもいいかも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ファッションショー前日"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "（えーっと……情報通りなら、この辺りだよねえ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "どうぞお気をつけてお帰りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "華やかな服装の女性",
      "text": "ねえ、あの噂聞いた？　ブランシェさん、最近スランプみたいね。こんな新人だらけのショーに顔を出すのも、インスピレーションを求めてのことなんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "華やかな服装の女性",
      "text": "でも、さすがは有名デザイナーよね。言葉遣いも振る舞いも、普通の人とは全然違ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "派手な服装の女性",
      "text": "ふふっ、あの人のことが気になってるのね。明日のショーのテーマは都会的なカクテルパーティーだし、何杯かご一緒してみたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "華やかな服装の女性",
      "text": "やだ、からかわないでよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ふーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "そちらの方、お待ちください。招待状のご提示をお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "招待状ね。あーごめん、急いでたから忘れてきちゃったみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "申し訳ないのですが、本日はショー前日の関係者向けレセプションとなっておりますので、招待状がなければお入りいただけません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "へえ？　……あたしが誰だかわかってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "ええと……オシャレに敏感な学生さん、ですかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "じゃあ、ブランシェさんはわかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "リターニアの有名デザイナーさんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "わかってんじゃん。あの人、もう受付も済ませてるっしょ？　ここだけの話、主催者から特別に招待されたんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "確かに、あの方のことはお見掛けしましたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "いやー、ぶっちゃけああいう有名なアーティストって性格ヤバい人が多いんだけどさ、あの人は特に人使いが荒いんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "実はあたし、龍門でのアシスタントしてるんだ。それで一緒に来たはいいけど、ブランシェさんが肝心なデザインカンプをオフィスに忘れてきちゃってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "しょーがないから、あたしが代わりに会場抜け出して取りに行ってきたんだよね。で、今戻ったところってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "本当ですか？　失礼ながら、あなたを見た覚えはないのですが……何か証拠はありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あー、だったらブランシェさんのとこまで一緒に来てくれたらわかるんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "であれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "とはいえ、あの人がおしゃべりを楽しんでるとこに邪魔なんかしたら……どうなるかわかんないけどねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "っていうか、あたしに見覚えがないとか言うけど、それならさっきお見送りしてた女の人たちは？　ちゃんと覚えてるわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "もちろん。赤のトップスをお召しの方と、濃い紫色のロングスカートをお召しの方ですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "全然違うじゃん。赤いほうは「Epoque」が出してるオーダーメイドのロングドレスだったし、紫のほうはライトパープルのカーディガンだよ。ちなみにそっちは「Marthe」の秋の新作ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "そんなはずないでしょう、記憶力には自信があるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "じゃあ、ブランシェさんが今日着てた服の色わかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "当然ですよ！　たしか……ダークグレーの礼服ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "答えはそれでいいわけね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "ええ。あ、いや……待ってください、思い出しますから。やっぱり黒だったかな？　いや、黒じゃなかったような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ほらね、そんな調子じゃあたしのこと覚えてないのも当然っしょ。……うわヤバ、こんな時間じゃん。もう行くね、ブランシェさんを怒らせると大変だし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "待ってください……ああ、どうしてこんな時に限って交代できる奴がいないんだか……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "仕方ない、こうしましょう。通っていいですから、ブランシェさんに届け物をしてください。ただし私はすぐ確認しに行きますから、くれぐれも妙なことはしないでくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "はいはい、サンキュー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ちょろいもんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "よーし、お次はっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あ、あの辺かな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "こんにちはー。ご多忙のところすみません！　ブランシェさんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "ん？　君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "初めまして。あたし、極東から来て炎国で勉強してる、美術史専攻の留学生なんですけど、学内新聞の記者もやってるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "最近連載してるコラムで、有名な現代アーティストの方々に取材をさせてもらってて。皆さんの日々の創作活動を記録に残すっていうテーマで書かせていただいてるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ブランシェさんはファッション業界の誰もが知る巨匠ですし、若手のアーティストが尊敬してやまないリーダーと言えばやっぱりあなたなんです。あたし自身、あなたにずっと憧れてて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そんなあなたが龍門にいらっしゃるなんて滅多にないことですし、絶対に取材させていただきたくてお伺いしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ですから、お願いします。チャンスをいただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "取材？　私は忙しいんだ、そんなことにかまけている暇はないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そこを何とか。お時間は取らせませんので。ショーの間、あなたのそばにいさせていただけたらそれで十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "いいかね、お嬢さん。私が時間を割いてまで龍門に足を運び、この異国の地で名も知らぬ人々のファッションショーに参加したのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "純粋な美を追求するという目的があるからこそなのだよ。……この神聖な仕事の最中に、大学生のおままごとなどに付き合ってはいられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "ん……？　ところで、君はどうやって入ってきたのだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あー、実は叔父にこのことを相談したら、招待状をくれたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "記事が満足いくものになったら、地元でファッションショーを開催して、各国の有名なデザイナーさんを招いてくれるって約束で。そうなれば、あたしもまたその特集記事を書けますしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "うちの地元の服飾文化はかなり独特なんですけど、ブランシェさんもご存知ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "もちろんだとも！　何と言っても極東は……ふむ、極東か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "取材だけなら……そうだな。邪魔をしないと約束できるのなら、少しは時間を割いてあげよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ほ、本当ですか？　ありがとうございます！　でしたら、明日のいつ頃お伺いすれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "後ほど、アシスタントから住所を伝えさせよう。明日午前九時、そこに来なさい。ショーに同行させてあげようじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "ただし、私は遅刻が嫌いだ。よく覚えておくように。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "この辺りで大学生くらいの女性を見ませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "やっほー、警備員さん。あたしならここだよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "……まさか本当にアシスタントさんだったんですか？　先ほど、ブランシェさんとお話しされてましたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "嘘つくわけないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "……疑って申し訳ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "気にしないでー。通してもらったおかげで、ブランシェさんのご機嫌も損なわずに済んだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あ、そういえば……ちょっと聞きたいことがあるんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "何でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ブランシェさん、もう何日か龍門にいるつもりなんだって。でも今回はボディガードを連れてこなかったから、現地の信頼できそうな人を雇いたいらしくてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "この件はあたしに一任するって言われて。給料はたっぷり出すから人を探してくるようにって頼まれちゃったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "多分、お兄さんたちって、ショーの期間だけ雇われてる臨時の警備員だよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "……そうですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "お兄さんデキる人だし、この仕事受けてくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パーティーの警備員",
      "text": "それは……本当に私でいいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "まあ、ちょっとした面接は必要になるかな。とはいえ、形だけでいいから……質問に答えてもらっていい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "さしあたって、仕事経験について知りたいから、このショーの警備業務を例にして答えてほしいんだけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "お客さん、ごめんなさい。もうすぐ閉店なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そっか。大丈夫、ちょっと見たらすぐ帰るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "はい、またぜひいらしてくださいね！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は店の階段を下り、両の足が地面についた時、ふと思いついたように振り返った。\n馴染みの小さな店の中では、店員が忙しなく過去の遺物を片付けている。\nそれが終わればどうなるかはわかっていた。この店は、一新されるのだ。\nサンセット通りに立ち並ぶ、ネオンだらけのアパレルショップと同じように。\n長い間変わらなかった古い看板が、何度か明滅し、やがて消えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "ぷはっ――マスター、もう一杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのマスター",
      "text": "お嬢さん、これで三杯目だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "飲まなきゃやってらんないんだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "最近、仕事のストレスがヤバすぎてさあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのマスター",
      "text": "この前転職したばかりだろう？　イカしたデザイナーズブランドの店員になれたとか言ってたじゃないか。たしか、オリジ……なんとかいう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "「オリジン・ストライフ」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのマスター",
      "text": "そう、それ。ちょっと前に、ファッション誌にも掲載されてたらしいじゃないか。有名なアート評論家の「カタナピンク」先生が紹介してたって聞いたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのマスター",
      "text": "それで、あっという間に無名の店から人気店に早変わりしたとか。ここ数日、うちの奥さんが行ってみたいってうるさくてね。私は、服なんてどこも同じだと思ってしまうほうなんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "んー、それねえ。実は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "こんばんはー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "あれ、あなたは……さっきのお客さんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "うん、お疲れ～。ズージェンは最近ファッションショーの準備で忙しそうだし、お店のほうは君が一人で切り盛りしてるんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "もしかして、ズージェンさんのお友達なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "んー、まあそんなとこかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "まあ……お店のことは別にいいんですよ。接客は得意ですしね。それより大変なのは……倉庫の片付けなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "最近はお客さんも増えてきたんで、それに合わせて商品も増えて、前の小さな倉庫だと手狭になっちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "だからズージェンさんが借金して新しい倉庫を借りたんですけど、おかげでこれまでの商品を全部そっちに移動しないといけなくなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あー、前の倉庫にはあいつが好き勝手作った作品が山積みだし、片付けってなると大変でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "そうなんですよ。前はズージェンさんが自分で管理してたらしいんですけど、これがもー散らかり放題で。昔の作品がいっぱい適当に積まれてて、整理するのが大変でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "しかもあそこ、ベッドや生活用品まで置いてあるんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あそこねー、あたしも何日か暮らしてたことあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "前に色々あって、他人に居場所を知られたくなかった時に、何日か泊めてもらったんだ。……ま、昔のことだし気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "は、はあ……とにかく、そこから何日もかけて新しい商品をなんとか移動させ終わったんです。それで今、前の倉庫には昔の作品だけ残ってる状態になってて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "でも、店長の昔の作品ってぇ……今よりもスタイリッシュで、かなり良い感じなんですよね……どうして作風変えちゃったんだろぉ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "ま～そんなことど～でもいっかあ～……いっしょーけんめー働くので精一杯だしぃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "相当酔ってるじゃん、その辺でやめときなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "よ、酔ってなんかないですからぁ！　あたしぃ、めっちゃお酒強いんれすよぉ～！　ほら、見ててくらさい！　ますたー、もう一杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ありゃ、ちょっと見くびりすぎだったかな？　そういうことなら一杯くらいは付き合わないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "でも残念だなー。あたし生まれつきアルコールアレルギーだから、オレンジジュースで乾杯するしかないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "いいれすよ！　飲みましょ飲みましょ～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "（こんな言い訳信じるなんて、かなり本気で酔ってるね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "よーし飲もう！　君の新生活と「オリジン・ストライフ」に乾杯！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "「オリジン・ストライフ」にかんぱーい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "ぷはー、サイッコ～……ちょっとだけ、くらくらするけどぉ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そうだ、一つ秘密を教えてあげるよ。ズージェンって、ちょっと大雑把なところがあってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "前は、持ち歩いてるとすぐなくしちゃうから～とか言って、倉庫の鍵を扉のフックに引っかけてたくらいなんだよ。だから、これからもあいつの面倒見てあげてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "あはは～、任せてくらさいよぉ！　店長も、さすがに今はフックになんかかけてませんからぁ！　前と違って、扉の前にある石の下に隠すようになったんれすよぉ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アパレル店員",
      "text": "まあ～、安心してくらさい！　あたしが店長を支えますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ほんと助かるよ、ありがとね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ふわあ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "よし、準備は大体できたかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "んー、明日のショーが今から楽しみだね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "掌ににじむ汗を感じた彼女は、その手を握ってポケットの中へと入れた。\nそうして今度は、ポケットから手を出す。すると、冷たい金属の感触が掌に伝わってきた。\nその手には、「ワイルドジャングル」シリーズの駄獣形ペンダントが静かに乗せられていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "見てなよ。カワイイっていうのは、こういうのを言うんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ファッションショー当日"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "いえいえ、そんな。才能だなんて恐れ多いです。運よく先生方のお眼鏡にかなっただけですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "サプライズも何も準備してきていないですし、まだまだ先輩方から学ばせていただかないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "あっ、すみません。少し外させていただきますね。もう一度スタイリングの確認をしておきたいので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "（ブランシェさんのおかげで、会場入るの楽勝だったね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "（服の準備はちょっと面倒だったけど、なんとかなったし。お次はアクセサリーだね。たしかここにあるはず……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "（お、見っけ！　――あれ、まだ警備員が二人いるな……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫警備員A",
      "text": "上から何か聞こえなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫警備員B",
      "text": "いいや、何も。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫警備員A",
      "text": "気のせいかな？　でも、そんなはず――って、おい！　なんで頭叩いてきたんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫警備員B",
      "text": "はあ？　俺がいつそんなことしたって？　それより、モデルさんたちがもうすぐ着替え終わるから、急いで荷物を運ばないとだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫警備員A",
      "text": "とぼけるなよ！　お前が持ってるそれは何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫警備員B",
      "text": "何って――え？　俺、いつの間にハンマーなんか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倉庫警備員A",
      "text": "こいつ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "よいしょっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショーの警備員",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "しーっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショーの警備員",
      "text": "ど……どうしてここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "んっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショーの警備員",
      "text": "ああ、なるほど。事前チェックのために、ブランシェさんの付き添いでいらしたんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショーの警備員",
      "text": "……ボディーガードの件、話はまとまりそうでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ああ、その辺は安心して。うまく取り計らっておいたから。お仕事頑張ってね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショーの警備員",
      "text": "ありがとうございます、頑張ります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ウタゲ？　どうしてここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "やっほー、ズージェン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "あ、わかった。今季のトレンドをチェックしにきたんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "……さーてね。とにかく、もう行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ウタゲ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "……あたしを責めないでね。ウタゲが前のデザインを気に入ってくれてたのはわかってるし、そこの埋め合わせはするつもりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "だけど、あたしが今やってることは、デザイナーとしてのあたしには意味があることだっていうのは理解してほしいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ウタゲが楽しいこと好きで、カワイイもの好きで、すっごくセンスのいい子だっていうのはよく知ってるけど、それでもただの大学生なんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "あたしのやってることの価値なんてわからないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ふふーん、わかってないのはそっちかもよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ファッションは、他人から求められるものだけが正解ってわけじゃないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "でも、今のあんたは、他人に認められてこそ本物のファッションだと思ってるみたいだし、それならみんなに実力を見せてあげたらいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "失礼。まもなくショーが始まりますので、お席にお戻りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "ま、あたしも邪魔するつもりはないし、楽しんでよ。……この唯一無二のショーってやつをね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女性デザイナー",
      "text": "イェさんの作品は、新人デザイナー部門の一番手だったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性デザイナー",
      "text": "ふふっ、私たちベテランを驚かせてくれるようなデザインを期待してるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "（グラスを揺らす）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ウタゲ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "イェ・ズージェン先生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "はい？　……どうしました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "一つご確認したいことが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "落ち着いてください、何の話ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "準備をしていたら、先生の作品が提出リストと違っていることに気付いたんです。先生のアシスタントを名乗る方が、ショーをもっと素晴らしくするために急遽内容を変更したと言っていて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "そんな！？　スタイリングディレクターにはちゃんと伝えておいたのに、どうして……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "その自称アシスタントさんが、バックステージで先生とお話されていたのを私もディレクターも見ていたもので……そこまで疑問に思わなかったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "まさか……ウタゲ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "今回は都会的なパーティーがテーマですから、デザイナーはそちらに出席する都合、修正内容をアシスタントづてに伝えることもありますし、ディレクターは会場内にいる方なら大丈夫だろうと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "ですが私としては不安があったので、直接確認をと思いまして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "と、止めてください！　私の展示はいったんストップで……バックステージに行ってきます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "ですが……恐らく間に合わないかと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "司会者",
      "text": "紳士淑女の皆々様、こんばんは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司会者",
      "text": "この素晴らしき夜、春のトレンドファッションショーにお集まりいただき誠にありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司会者",
      "text": "ショーの第一部では、新鋭デザイナーが手掛けた作品をお披露目いたします。デザインの未来を担う彼らの作品は、このステージで見事な輝きを放ってくれること請け合いです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司会者",
      "text": "それでは、早速ご覧いただきましょう。イェ・ズージェン氏が、このショーのために作り上げた新作の数々を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "待ってください――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司会者",
      "text": "ふふっ！　ご本人は少々恥じらっておられますが、今日のために熱心に打ち込んできたことは間違いありません。現に、彼女のアシスタントがこんな紹介文を渡してくれたほどですからね――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司会者",
      "text": "「サルゴンの原生林からインスピレーションを受け、荒々しさの中に生命の力を見出し、そこに現代都市独自の美学を融合させることで、オリジナリティ溢れるファッションを生み出しました。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司会者",
      "text": "「ワイルドジャングル」シリーズの新作です、どうぞご覧あれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "水面の如くゆらめく照明が、原始的で荒々しい模様に注がれる。それはまるで、はるか遠くの未開の地から、現代文明へと滴る黄金のようだった。\nモデルたちはリハーサル通りのポーズを決めており、ミスマッチなそのスタイルの中でも不思議と、誇張的で派手なアクセサリーが強烈な魅力を放っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "司会者さん、待ってください、違うんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ストップ！　止めて、お願い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ああ……終わった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "……い、イェさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "これは本当に君の作品なのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェ・ズージェン",
      "text": "ち、違います……これは、昔遊びで作ったボツデザインで……！　私がお見せしたいのは、これじゃないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "なんと……なんと美しく、生命力に満ちた作品だろうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "原始と現代、自然と都市が、このデザインの中で奇妙ながらも見事な調和を織りなしている……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "私が苦しみと共に探し求めてきた、子供の目に映る原風景のような……飾り気のない純粋な美しさを生み出したのが、君のその手だとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランシェ",
      "text": "見事だ、イェ・ズージェンさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼の声は大きいものではなかったが、その場の誰もが、この有名デザイナーの評価を耳にした。\nすると、会場のあちこちから拍手が湧き起こり、あたりは歓声の海となった。\n鳴り響く喝采の中、イェ・ズージェンは椅子にへたりこみ、口を利けずにいた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ウタゲはん！　ここにおったんか、えらい探したんやで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "おー、クロワッサン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "あ、ネイル新しくしたん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "可愛いっしょ？　ダークな感じでさー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "おっと、聞きたいこと忘れるとこやったわ。なんや最近、龍門で急に「ワイルドジャングル」っちゅうスタイルの服が流行り始めたことは知っとるやろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "へえ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "知らへんの？　ショーがきっかけでドカンと人気になったらしいんやけど、今じゃ龍門のブランドショップはどこも、それ系の服だのアクセサリーだのを作って売り出しとるんやって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやから、ウタゲはんに実情を訊きたいなーと思てな。なんせ、あんたはんは高名な「サムライピンク」大先生やから……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ってそのペンダント、「ワイルドジャングル」やんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そうだよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "なんていうかこのシリーズ、アイデアは面白いけど、デザイナー本人はちょっとつまんないんだよねえ。ま、一つ二つは買っといていいと思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "とはいえ、流行り始めた原因は……多分、偶然だろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "へー。まあ、ウタゲはんからの評価がええなら安心やな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ところで、そのワイルドジャングルのデザイナーがやっとる店、最近20%オフのキャンペーンやってるらしいで！　興味あらへん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そうなんだ。それなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "また見に行ってみようかな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
