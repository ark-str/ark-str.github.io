  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "ぐ、っ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "はぁ、っはあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "スカルシュレッダー！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "おい、大丈夫か！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "っ、平気だ。……こいつら、実力はあるらしいな……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "動けそうならいいんだが……Wから連絡が来たんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "ターゲットは確保済み、向こうの仕事は済んだとよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "……本当か？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "ああ！　奇襲がうまくいったんだろうさ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "なあ、こうなったら俺たちも退くべきじゃないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "まずは……タルラに、信号を送れ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "了解！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "……撤退だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "覚えてろよ、ロドスのクズどもめ……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "次に会った時が、お前らの最期だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "――レユニオンが、退いていく……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "やたら手際いい退却ね。最初からこうするつもりだったのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "まったく……あんな大口叩いといて、逃げ足だけは一級品ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "この状況……どこか、変ですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerToken": "char_107_liskam_1",
      "operatorId": "char_107_liskam",
      "portraitKey": "char_107_liskam",
      "text": "？　それは、どういう――"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "やはり、レユニオンの目的はロドスではないんだろうな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "――"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "つまり、彼らはあくまで私たちを足止めしていただけ……"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "ということは――"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "狙われているのは、近衛局……！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "みなさん、今すぐ支援に向かいましょう！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "フランカさんは、周囲の偵察部隊にコンタクトを取ってください！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "それと、リスカムさん！　チェン隊長にも連絡を！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerToken": "char_010_chen_1#2",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "なぜ援軍が来ないんだ！　督察隊の主力部隊はどうした！"
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "speakerToken": "char_015_lmg",
          "operatorId": "char_015_lmg",
          "portraitKey": "char_015_lmg",
          "text": "先ほど、レユニオンに足止めされていると連絡が……！"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerToken": "char_010_chen_1#2",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "馬鹿な……！　あんな寄せ集めの連中に、足止めなどできるはずがないだろう！"
        },
        {
          "type": "dialogue",
          "speakerName": "近衛局隊員",
          "speakerToken": "char_015_lmg",
          "operatorId": "char_015_lmg",
          "portraitKey": "char_015_lmg",
          "text": "っ、それが……向こうは、たった一人とのことでして……"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerToken": "char_010_chen_1#3",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "――！"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerToken": "char_010_chen_1#5",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "まさか……！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
