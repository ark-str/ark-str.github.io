{
  "server": "jp",
  "storyId": "act35side_level_act35side_05_beg",
  "groupId": "act35side",
  "stageId": "act35side_05",
  "title": "働く展示物",
  "storyCode": "AS-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act35side/level_act35side_05_beg.txt",
  "sourceHash": "0b62d7e050c0aa09d37bbf1d00aee0c403a1ac4c71fc776679f655c64cc82430",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "博物館放送",
      "text": "チケットご購入の方は列にお並びください、チケットご購入の方は列にお並びください。特別展示会「死から蘇ったシャア時代の将軍との出会い」現在チケット販売中です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館放送",
      "text": "チケットご購入の方は列にお並びください、チケットご購入の方は列にお並びください……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱狂的な客",
      "text": "そう、そのまま私を見て。私だけを見るのよ、カメラは見ないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱狂的な客",
      "text": "ちょっと待ってて、ウエディングドレスを整えるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱狂的な客",
      "text": "徹夜で急ごしらえしたものだけど、私のコレクションであるシャアの伝奇小説三千冊に誓うわ。この衣装は絶対歴史通りだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "文化財の損傷を避けるため、本展示はフラッシュ撮影を禁止している。注意をしてほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "熱狂的な客",
      "text": "えっ？　ほら──二十連写よ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スクーターに乗る客",
      "text": "皆さんこんにちは。たった今、ついにバルジャバンダバード博物館の最も神秘的な部屋に入りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクーターに乗る客",
      "text": "今から私のカメラにより、こちらの将軍の勇ましい姿を三百六十度隅々まで記録し、輝ける都市における死者復活の謎に迫ります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い客",
      "text": "パパ、この人の足、中が空っぽみたいだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い客",
      "text": "パパ聞いて、叩いてみると空っぽの音がするよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電話をする客",
      "text": "ああ、そうだ、その商品はすぐ極東に送るんだ。注文数はそれほど大きくないが、何より相手との信頼関係が重要だ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館職員",
      "text": "お客様、娘さんをしっかりと見ていただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電話をする客",
      "text": "すまない、ちょっと待っててくれ。少し急用が……おい、こっちへ来なさい！　勝手に触るんじゃない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "博物館職員",
      "text": "館内では大声で騒がないようお願いします……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "電話をする客",
      "text": "おいおい、こんなオープンな展示会を開催し、展示物をウロチョロさせてるのはお前たちだろう！　しかもチケット制限も設けずに。こんなに騒がしいのは自分たちのせいじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "それは本館のアナト館長代理が、「歴史と知識はすべての人に平等に開かれるべき」であり、貴賤による入場券の格差は設けるべきでないと考えているからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "そして、余がいる展示台の周囲には高さ約六十センチの柵があり、来場者の立ち入りを阻止する機能を有している。そなたの子供が柵を越えたのは違反行為と見なされる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "スタッフの指示にご協力願いたい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "うわっ、入らなかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ガイドブックには外国のコインでもいいかどうか書いてないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そもそも、コインを投げれば幸運が訪れるとも書いてないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "やってみなきゃわからないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "……一枚貸して。あの体の中心に投げればいいのよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館職員",
      "text": "お……おやめください……こちらは重要な歴史的文化財です……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館職員",
      "text": "人が多すぎて、全く進めない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "了解した。投擲物は余が武器で弾くとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "（手を上げる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甲冑を着た客",
      "text": "うわぁ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甲冑を着た客",
      "text": "みんな、早くこっちを見ろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甲冑を着た客",
      "text": "俺が演じているのは千年前のナイツモラの戦士だぞ。今のはそれが倒された場面──歴史が再現された偉大な瞬間だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "余の武器は彼の体に触れていないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甲冑を着た客",
      "text": "おぉ、シャアの配下の将軍よ！　あなたに敗れた敵に対し何か言葉をくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "余が生きていた時代に、各軍が捕らえた敵の首領の首を見せしめで斬り落とす際、最もよく用いられた言葉はこうだ。「貴様の内臓は虫ケラに食い尽くされるだろう」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "甲冑を着た客",
      "text": "よし、その言葉、もう一回言ってくれ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "甲冑を着た客",
      "text": "おいおい、押すんじゃない。俺がまだ倒れてるんだ！　事故が起きちまうだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館職員",
      "text": "ダメだ……早く応援を呼ばなければ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "博物館職員",
      "text": "まさか……外ではまだ湛水祭が行われているのに、こんなに大勢の人が動くミイラを見に来るなんて想像もしてなかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "高貴な身分の女性",
      "text": "ハトシェプスト様、最近あなたは特別な宝石をお探しになっているとお伺いしましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高貴な身分の女性",
      "text": "ちょうど私の家に大変貴重な宝石がありましたので、お持ちいたしました。これであなたの悩みが解決されれば幸いなのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ありがとうございます……ぜひ見せてください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高貴な身分の女性",
      "text": "ところで、近々わが家へ夕食にご招待させていただきたいと思うのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "申し訳ありません。ここのところ多忙でして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "わざわざ宝石をお持ちいただいて、ありがとうございます。ですが残念ながら、私が探しているものではありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高貴な身分の女性",
      "text": "まあ、そうですか。ではこの辺で失礼いたしますね。ハトシェプスト様、お時間がございましたらまた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "うぅ……外にいるのはあと何人？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "七十三人です。彼らは皆、あなたが探しているのは自分の宝石かもしれないと言っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "どうしてそんなにいるんだ──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "もう少し我慢してください。午後になれば休めますから。グランドバザールの宝石商人数名が手がかりを見つけたと言っていたので、午後になったら見に行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それを休憩と呼ぶのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "もちろん。午後は人に会わず、宝石を見るだけでいいんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "あぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "宝石商人",
      "text": "アナトさん、パーディシャーのご令嬢が浮かない表情で座り込んでもう三時間は経ちますが、残りの宝石はまだご覧になりますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "あとどれだけありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宝石商人",
      "text": "まだ二百個以上は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "……そこに置いてください。この箱を見終わったらまた考えます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宝石商人",
      "text": "では失礼します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "アナト……今誰か来てたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "また宝石が一箱運ばれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "アナト、なんだか変だよ。君の頭どうして四角錐になってるの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "周りの装飾品も全部四角錐になって……しかもキラキラして……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "ペペ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "博物館がついに開いたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホテルの受付係",
      "text": "はい。ですが今は特別展示会のチケットが入手困難なんですよ！　昨日の夜に噂を聞いて、早めに並んでチケットを買った方がいいとお伝えしたかったんですが、昨晩はいらっしゃらなかったので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "構わない。私が博物館に行きたかったのは、特別展示会が目的ではないからな。あの蒐集家を訪ねる方が重要だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホテルの受付係",
      "text": "なんだか機嫌が良さそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私の思った通り、言葉は平和の架け橋であり、会話は理解の基礎だ。そしてこの歴史ある街には、見識の豊かな人間が少なくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あぁ、古から現在に至るまで、輝かしい歴史を誇るサルゴン人よ、あなた方がもし略奪するのではなく、あの蒐集家と同じように私と腰を据え夜通し語り合ってくれれば、どれほど素晴らしいことか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私の説明で、あの蒐集家はミノス人の執念を理解してくれた。私もまた、彼のこの都市の紹介を通じて多くの学びを得た……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……そうだ、一つ確認したいことがあるのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "現代のミナトハマイでは、銀製品は金製品より貴重なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホテルの受付係",
      "text": "はは、どうして突然そんな冗談を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホテルの受付係",
      "text": "もちろん、そのようなこともあるでしょうね……例えば、首長様に脅迫された時とか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……ありがとう。状況は理解した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私と同室の旅仲間は戻ってきているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホテルの受付係",
      "text": "はい、お二人のご友人と一緒に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "二人の友人……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "それも結構。思想の交流は多いほどいい。私も彼女のように情熱的で豪快なクランタの知己をもっと得たい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アスパシアはホテルの階段を上がり、部屋の前にすっくと立つ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "ナラントゥヤ、いるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "良いニュースがある。三位を取ったあの蒐集家が、私の演説を三時間聞いた後、金杯をタダで譲ってくれたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "対が揃った金杯を見に、一緒に博物館へ行かないか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない声",
      "text": "……昨日の夜は、宝石が置いてあるあの部屋に誰も入ってないわ。本当よ、ナラントゥヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "知らない声",
      "text": "向かいの屋根に隠れて、まばたきもせずにずっと監視してたもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤの声",
      "text": "……今回の誘拐がどれだけ重要かはわかってたはずよね。すぐに大金を手に入れるにはああいうターゲットじゃなきゃだめなんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "ごめん、ナラントゥヤ。今すぐパーディシャーの娘を探しに行ってくるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "もう遅い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "隠れ蓑として見つけてきたキャラバンはそろそろ街を出てしまう。今さら彼女を見つけて何とか誘拐に成功したとしても、逃げるには間に合わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャニ",
      "text": "だったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "今後のことを話しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あんたたちは博物館に戻って。だけどあのパーディシャーの娘にはもう接触しないようにね。金を奪う新しいチャンスを見つけたら、すぐに連絡を寄越すんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしはその消えた宝石を探しに行く。せめてアスパシアに返してやらないとね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "その必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アジャジは突如として部屋の中が静まり返るのを感じた。\n彼女は押し入ってきた見知らぬ者を見て、それからナラントゥヤを見て、最後に助けを求めるようにアジャニを見た。\nアジャニは指を立てて唇の前に置き、もう一方の手で腰にある麻酔薬を探る。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あー、話を聞いて、アスパシア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "今は計画の初期段階なんだ。計画が成功したら、必ず宝石は返す。少なくとも同価値のものを返すよ。あたしを信じてくれていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうだ、こっちはあたしの手下の二人で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "何の計画だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "えーっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "その宝石を餌にしてパーディシャーの娘を誘拐しようという企みが聞こえたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……全部聞いてたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "すまない、盗み聞きするつもりはなかった。だがつい先ほど偶然扉の前に立っていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私は、会話は理解の基礎だと信じている。それと、あなたには借金があり、今すぐに金が必要だということも知っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "だから、事のいきさつを詳しく話してくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "実は、宝石の行方については何の見当もついてなくてね。あなたの力を借りようにも、任せられる仕事はないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "過ぎたことはもう何を言っても仕方ない。けど、そんな感じだから今のところの計画は……ほとんど計画なんてないようなもんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私が訊いているのはそういうことではない。わかっているだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "じゃあ、もしあたしがなぜ借金をしていて、いくら金が欲しいのかを話したら、あたしのやり方を支持してくれるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "話し合うことによって、より良心に恥じることのないやり方を考えられると思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ほら、やっぱりあたしって、あなたのことをよく分かってるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "アスパシア。手を出して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "何をするんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "気にしないで。あたしたちの仲だと思ってさ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アジャニとアジャジがアイコンタクトを取る。\nナラントゥヤが行動を起こす合図は、ヒールで地面を叩く澄んだ音であることを彼女たちはよく知っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "これで──あたしの借りを帳消しにしてくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アジャジ＆アジャニ",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしはあなたの所に半月泊めてもらった上、宝石を持ち去った。まとめて全部あなたへの借りよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "この金貨の袋は、全部で千二百ディナールある。これくらいじゃ全然足りないのはわかってる。だけど……あたしたちの仲でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "ナラントゥヤ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうだ、中にはよその国の硬貨も混ざってるんだ。商人によっては受け取らないだろうけど、どこかしらでは使えるだろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "それと宝石。どれも小さくて不純物もちょっと多いけど、幸い数はそれなりにあるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "これで何とかならない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……ナラントゥヤ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "そんなに私と話し合いたくないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "「会話は理解の基礎」だよ。けど、あたしはもうあなたを理解しているんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あなたはかつて神殿で毎日毎日そこにある像の真似をして、剣の持ち方を練習したかもしれないね。あるいは両親に倣って、一族に伝わる誓いを立てたかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "なにより、あなたはミノスの英雄を慕う者の一人だから、純潔な魂を持とうと心掛けている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "きっと、高い建物から落ちてくる人を救うために手を伸ばすだろうし、良くない手段を使おうとする人を……こっぴどく批判するだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "そうだ、あなたの言う通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私は人々の心には善悪を計る尺度があり、法令にもまた尺度があると信じている。人は尺度に従って行動すべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あなたと同じように、私もあなたのことを理解している。おそらく今の私に対して首長やパーディシャーの法令の尺度は異常であり、自らの心に従った方がいいと言うだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "ただ、ナラントゥヤ……私は自分の心が信じられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "じゃあ、もしあたしがいつか首長様に捕まって、わけもわからないまま死罪を食らったら、あなたは同情してくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "もちろんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ハッ、それで十分だ。どうやらあなたも、あたしの死は全サルゴンにとって取り返しのつかない損失だって思ってくれてるみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "もしあなたがあたしの偉業に加わってくれるんなら、あたしたちが途中でヘマして死ぬ確率は随分と減るだろう。でも嫌だって言うんなら、それでも別に構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "来る者がいれば去る者もいる。当然あたしは皆をそばに引き留めておきたいよ。だけど去る人にあまりにもこだわってたら、それってあたしを妬む人たちと同じくらい愚かでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "つまりあたしが言いたいのは、もうお互いを困らせるのは無しってこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "これで私たちはもう貸し借りなしだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "怪我をしているではないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ただのかすり傷だよ。心配ない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "手当てすべきだ。油断して小さな傷を放置し、最後には命を失った兵士をこれまで大勢見てきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "今はもうそういう時代じゃないのさ……また日を改めて現代の医療技術について話してあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "休むのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "いや……水浸しになったノートを書き直さないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "水浸し？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "話すと長くなる。全部語り終えるほどの気力が残ってるかどうかわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "朝別れる前、そなたは得た情報を余に共有すると言った。ペペ殿、そなたは約束したのだ。だから話すべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……わかったよ。今日は何の収穫もなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "情報を公開したら、無数の人が似たような宝石を持って押し寄せてきたんだ。でも一つとして関係なかったのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "丸一日、無数の宝石が私の目の前でキラキラ輝いて、めまいがするほどだった。それから飲み物でも頼んで一休みしようと思ったら、隣にいた二人の子供が突然喧嘩をし始めたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "その結果テーブルが倒れて、飲み物はこぼれ、私はすり傷を負って、ノートがビシャビシャになったのさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "これが共有できるすべてだよ、ズバイル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "今の話から君が必要な情報は得られたかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "では……余が今日経験したことを聞きたいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ズバイル……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "たくさんの変人がやって来た……しかし面白かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "明日にしてくれるかな。君は寝る必要がないだろうけど、私は本当にクタクタなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "ペペ殿、余は展示館内にとどまりたくない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……あと数日辛抱してくれ。ティティのために今回の特別展示会をやり遂げなきゃ。その代わりとして、彼女は宝石をくれたんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "展示会が終わったら、ほかの宝石探しに連れて行ってあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "貴石を探しに行くのもあまり気が進まない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "何を言い出すんだ、ズバイル？　シャアの宝物庫の守護者として、一刻も早く記憶をすべて思い出し、再び自分の責務を負うべきではないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "宝物庫の場所を知りたいと急いているのはそなたの方ではないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "あー……そう、その通りさ。でなきゃ私がなぜ君を呼び起こしたと思っているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "だがペペ殿、余はすでに目覚めたのだ。もはや余を文化遺産として扱わないでほしい。余の行動と考えは余自身の支配下にある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "少なくとも現時点において、自分の過去をすぐに思い出したいとは思っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "明日は良い天気だ。外へ散歩に行き、何も考えたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "博物館の展示物が一人で街なかで日向ぼっこしているのを見たら、街の人がびっくりしてひっくり返るって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "言ったであろう、余は展示物ではない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "すまない、ズバイル……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "気にするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "もう夜中だよ。本当に疲れたんだ……また明日話そう、いい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "おやすみ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "虚ろな部屋、ズバイルは壁のスイッチを押してみる。すると明かりは消えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すぐに彼はもう一度押してみる。すると再び明かりが点灯した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "ニャ？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ミオは深夜の通りの中央に立ち、遠くで明滅している窓に向かって目を凝らす。\nすると──"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "明滅は止み、代わりにガラスがそこらじゅうに砕け散った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "南風が過ぎれば、向こうは乾季だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "それまでに十分な金を手に入れられるだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "よし、飛ぶか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "おい──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "今時の若い子はどうしてこんなに無茶なんだ……何をしている？　自殺しようとしてたわけではないだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "見れば分かるでしょ？　これは湛水祭の風習の一つなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "川の神に質問しようとしてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "だとしても川に飛び込んでやるもんじゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "お嬢さん、それはどこの歴史書から引っ張ってきた風習だい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "確かに昔の人々は迷った時、川に質問を投げかけた。しかし今じゃ大概の問題はお金で解決できるようになったってのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "役に立たない豆知識をありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "まあでも、私なら君の質問に答えることができるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ランプライターは持っていた明かりを掲げ、ナラントゥヤの方へと近づいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "南風が吹くまでに君が得られるお金は、君自身の欲望を満たすには足りない。だがそれでも十分だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……もう少し具体的な質問に変えようか。これからあたしはどこへ行ってその金を手に入れればいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "砂漠の奥深くだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "サルゴンはそこら中が砂だらけだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "答えてやれる質問はあと一つだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ミナトハマイの人はどいつも裕福だから、無料サンプルは無限に貰えるもんだと思ってたけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……あ、待って。今のは質問に入らないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "教えてちょうだい……あのバカほど真面目なミノス人はあたしを探しに来てくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ランプライター",
      "text": "来るだろう。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "相手がそう言った瞬間、ナラントゥヤは視界の端に一つの人影を捉えた。\nその人影は誰もいない路上で足を止め、一瞬彼女を見ると、向きを変えて歩き去った。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……アスパシア？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "アスパシア！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "路地を曲がった影を、赤髪のクランタが追いかける。\n駆けるナラントゥヤの耳元に届くのは風の音、川の流れる音、そして彼女の背後で徐々に遠ざかるランプライターの歌声だけだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……見失った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "嘘でしょ？　このナラントゥヤがターゲットを見失っただって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……ハァ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "まあいいさ。落ち着いて考えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ここの人たちは皆何かの影が見えるよう祈ってたっけ。今あたしが見た影は足音がしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "つまり、あたしが見たのは本当に幽霊だってわけ？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は道端に座り込んだ。\n花壇の向こう側、暗闇の中で同じように川の流れに耳を傾けている者がいる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "川の近くのベンチには水がたまってることが多いから、拭いた方がいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "そなたも本当に幽霊が怖いわけではないのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "なーんだ、あなたもあの影を見て怖くなったの？　あたしが守ってあげようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "……懐かしさを感じた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "はっきりとは見えなかったが、あれは亡き親族や友人の亡魂であるのかもしれぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "なんであれ、一人で見るよりは二人の方がマシでしょうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "その姿を見た人はミナトハマイの祝福を得られると聞いたけど、ここに座ってる人はどっちもツイてないみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "……余はただ、口論をしただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "奇遇だね。きっと負けたんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "勝っていればここに座ってはおらぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "はははっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "知ってる？　ほんの十分前に聞いたんだけど、ここに住んでる人には悩みがないんだって。なぜなら金がすべて解決してくれるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "なかなか理に適ってると思うよ。あたしみたいに借金がなければ、そこまでむしゃくしゃすることなんてないだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "……余は今日、他人に物を投げつけられ、先週手に入れたばかりの新しいマントも汚された。そのうえわけもわからず一日で二十回も結婚させられた。老若男女幅広い相手だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "しかも誰も余のこういった話を聞いてくれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "えっ、あぁ……それは確かに災難だったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "個人情報を持ち出された上、勝手に結婚の手続きをされたって？　あなたそもそも結婚できる年齢なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "別に悪気はないよ。あなた少し変わった声をしてるけど、若そうに聞こえたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ハァ、あたしがあなたくらいの年だった時はもっと運が良かった気がするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "一度、奪った駄獣たちを追い立てながら帰ってる時、突然空が暗くなって、スカーフでも遮れないほど砂が吹きつけたことがあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "幸い人数が多かったから、他とはちょっと違った空き地を見つけてすぐに掘り始めたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "何が出てきたと思う？　砂に埋もれた二つの部屋さ。あたしたちの全員がギリギリ入れて、中にはベッドとテーブルまであった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "……それは古代の陵墓でよく見られる寝室の調度品だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ははは、物知りだね！　あたしがそれを知ったのは、何年も経った後だったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あれはなんて楽しい日々だったんだろうね。時間ってやつはまったく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "左様……時は川の流れを変え、都市を興し消滅させる。骨を烈日の砂漠にさらし、歴史をより深く沈める。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "過ぎ去った日々は懐かしく、そしてその懐かしさは……恐ろしさを感じさせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうさ。過ぎ去った日々はどれだけ懐かしんだところで取り戻せないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "そなたが懐かしむその者たちは、今どうしている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "生きてるさ。ひどい有様でね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "一番ひどいのは、そいつらはぽっきり折れたまんま、前を向くことすらできないことだ。どれだけの奴が刀を売り払ったことか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "だからあたしはあいつらのボスとしてあいつらに借りがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "とにかく、新しい金貨の山でも築けば、あのバカどももきっと元気が出て、以前のような日々を過ごせるはずさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "……そうなることを願っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "余は……余にもわからぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "人々が必死になって川の神の姿を追い、ついにはっきり見えた顔が見たくもないものだったら、心に恐怖が生まれるのも当然だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "もしそれでも追うというなら、少なくともあなたがそこまで恐れちゃいないってことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あたしが故郷を去る前、母さんはいつも耳元でこう言ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "「ナイツモラは恐怖の主であるべきで、恐怖に支配されることなどない」、誰もがそう思ってるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込む通行人？",
      "text": "──そなたはナイツモラなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうだよ。それがどうかし──",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ナラントゥヤは肩を叩かれ、ごく自然に振り返った。\n静寂な通りで、街灯だけが遠くから一つ一つ灯される。\nランプライターは、鼻歌を歌いながら二人の前までやってくると、梯子を上ってガラスのランプシェードを開けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ぎゃああああああ！！！！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "誰か、誰か助けてぇ！　死人に取り憑かれたぁ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
