  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "风笛"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 11:41 天気/曇天\n龍門七区外 入城ゲート"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "speakerId": "char_015_lmg",
      "text": "ホシグマ督察、こっちです！　待ちくたびれましたよ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "あのなぁ。こちとら、通信がきたから脱ぎかけてた靴を履いて、深夜にここまで龍門を横断してきたんだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "――で、密航者は？"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "speakerId": "char_015_lmg",
      "text": "は、はい！　捕まえました！　今は臨時監房に留置しています。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "捕まえた？　何人がかりでだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "speakerId": "char_015_lmg",
      "text": "えっと、俺ともう一人の同僚とで……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……相手はヴィクトリア兵で、おっかない武器を持っていると言ってなかったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "speakerId": "char_015_lmg",
      "text": "それが俺にもよく分からないんですが……俺とピンの奴で近付いていったら、すぐに武器を捨てて、両手を振ってきたんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "speakerId": "char_015_lmg",
      "text": "「ここにいるよ！」なんて大声で呼んでくるし、密航者のくせに、一刻も早く俺たちに見つけてほしいって感じでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "speakerId": "char_015_lmg",
      "text": "このゲートに配属されて数年経ちますが、あんな変なやつは見たこともありませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "そうか。まあ、暴れる気はないようだし、問題はないだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "さっきの通信では、何か叫んでいると言っていたが、なんて言っていたか分かったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "speakerId": "char_015_lmg",
      "text": "それが、あまり。あいつ炎国語が下手で、訛ってるせいで分からないんですよ。強いて言うなら、確か「チェン」に聞こえたんですが……あれ？　チェンって、まさか……"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "speakerId": "char_015_lmg",
      "text": "俺の聞き間違いだったかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……ははあ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "話は分かった。私も顔を拝んでくるとしよう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うわっ、眩しい――ありゃ、やっと誰か来た？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "ええ、あなたにいくつか質問しに来ました。こんにちは。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "それって……取り調べ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "まあ、そんなところです。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "はぁ、取り調べはずっとうちの仕事だったのに……いきなり逆の立場になっちゃうなんて、なんだか変な感じだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "こうなるのが分かってて、大人しく武器を手放したんですか……逃げようとは思わなかったんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "こっから逃げるのは簡単だべ。わざわざ破城矛を使うまでもな――"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "いやいや違うよ、そういう意味じゃなくて！　取り調べ中だってことを忘れちゃった……えっと、うちは逃げようなんて思わないべ、自分の意思でここに来たんだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "牢屋に入れられるのが趣味なんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "閉じ込められたいわけじゃないよ。ただ、許可なしで入城すれば警察が捕まえに来るって聞いたから……ああ、龍門じゃ警察のことは近衛局って言うんだっけ？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "会いたい人がいたから、一番手っ取り早い方法を選んだんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "誰をお探しで？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "チェンちゃ、あっ、チェンさんって人だよ。近衛局にいるよね？　確か……隊長になったって聞いたべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "あーあ、残念だべ。てっきり報せを受ければ、あの娘本人が来てくれると思ってたのになぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "あなたとそのチェン隊長はどういう関係なんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "仲の良い友達だよ。あの娘がヴィクトリアの学校に通ってた頃、うちらは同級生だったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "その学校の名前は？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "えーと、王立前衛学校だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "ということは、あなたは士官なんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "……退役する前はね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "ふむ。ヴィクトリアの退役士官が一名、制服を着たまま、夜間に他国の辺境都市に入城しようとした。しかも手には制式武器を――"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "でも射撃機能は除去してあるべ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……しかし装填装置は外されていないので、依然強力な爆破能力がありますよね。違いますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "（小声）確かに規定に従えば、退役していたら、破城矛は返却しなくちゃいけないもんだべ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "その口ぶり、正式に退役したわけではないのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "…………"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "こんなにすぐにバレるなんてなぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "はぁ～こんな日が来るなら、尋問学理論の授業はもっと真面目に受けるべきだったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "どうやら隠したいことがあるようですね。お嬢さん、あなたが逃亡兵だというなら、すぐに電話で人を呼びますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "だめ、呼ばないで――"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "ほ、本当に退役したんだよ。保証するべ！"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "経緯の説明もできるだけするよ！　ただ……どうしてもここじゃ明かせない情報もあるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "とりあえず聞きましょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "ありがとう。実は三ヶ月前――まだ軍隊にいた頃、うちらの小隊はある事件を調査してたんだべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "その調査中に……ええと……"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "そうだね……事件を追っていたうちらの小隊で生きているのは……ううん、今自由に行動できるのは、うち一人だけになっちまったんだ……今うちが言えるのは、それだけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "思い出したくない記憶だったでしょうに、ありがとうございます。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "ううん。分かってくれて、ありがたいべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "しかし、危うく命を落とすような任務をこなしたんですから、ヴィクトリア軍のお偉いさんたちは、あなたの功績をたたえて山ほど褒章を与えるはずなのでは？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "褒章？　まさかぁ。事件は未解決だし、そんなもんがもらえるなんて考えたこともないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "でも……調査継続のための応援くらいは寄越してくれると思ってたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "それが派遣してもらえなかったと？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "驚きだよね？　警官さん、うちも首をかしげちまったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "それで、最初はいろんな人を訪ねて回ったんだ。半島郡の駐屯部隊をはじめ、みんながうちをなだめて、上層部の命令が下りたらすぐに派遣するから、待ってろって言うんだべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うちはその指示に従ったんだ。けどなんもなしに時間が過ぎるばかりで、調査は全く進まなかった。それで、うちは地方の駐屯部隊をすっとばして、直接ロンディニウムと連絡を取ることにした。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "かなり手こずったけど、幸い、付き合い方は多少知ってたから、駐屯部隊の方はどうにかなったし、本部へ向かう途中でも、行く先々で心優しい人が助けてくれたんだべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "おかげで、ついに、ロンディニウムに一番近い軍営にたどりついた――"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "そしてそこで、うちは退役するって決めたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "彼らもあなたを支援しなかったからですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "長官、伯爵、大公爵……あの人たちにも、きっと苦しい事情があったと思うよ。とにかく彼らが言うなら、うちは全部、そうなんだと思って頷いてた。うちもあの日までは信じてたんだよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "偶然聞いちまったんだべ。中佐がうちの知らない将校と、うちの処遇について話し合っているのを。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "あんなのは予想もしてなかったべ――"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "事件発生から丸々三十七日も経って……うちの元に届けられるのは増援どころか異動命令、なんてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "それは、気持ちが収まりませんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うん……辛いようでもあって、失望に、無念に、怒りでもあって……なんて言ったらいいか分からないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "聞いた時は、頭が真っ白になってさ……破城矛を訓練室に置いてきてよかったって、思ったのだけ覚えてるべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "武器があったら、使っていましたか。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "しないよ……たぶん。自分の職責を忘れたことはないからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "それにヴィクトリアの軍人として、うちは絶対に軍規に従わないといけない。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "だけど……警官さん。うちはあの時、上官からのものだとしても、そんな命令に従うなんて絶対無理だって思っちゃったんだべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "命令にそむく兵士を許す軍隊はありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "そうだよ。だからすぐに思い立ったんだべ。彼らがうちの今後について正式に決定を下す前に、自分から軍を離れようって。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "彼らは退役に応じたのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "手続きは順調だったよ。中佐たちには引き留められたけど、うちはもう心を決めていたからさ。そういえば前に、隊長やチェンちゃんにも「頑固すぎる」って言われたことがあったなぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "だけど、兵営に武器を返しに行ったとき、いきなり襲撃に遭ったんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……襲撃？　誰です？　あなたが追っていた人物ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "可能性は高いね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "一ヶ月以上もうちに構ってなかったのに、どうして急に兵営で事を起こそうとしたのかは、もちろん不思議に思ったけどさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "もしかしてここまで来て、ようやく敵は軍の上層部に入り込んだのかな？　あるいはそもそも……"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "まぁ、そんなことはもうどうでもいいべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "襲ってきた連中は何人か倒したけど、まだまだ大勢いたから、うちはしかたなく、破城矛を持ったまま急いでその場を離れたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "その後は？　ヴィクトリアから逃げ出したんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "逃げたかぁ……そうだね、ははっ。ここまで本当に散々だったべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "そいつらが手強いってことは分かってたから、家には帰らなかったんだ。お母ちゃんたちを巻き込みたくなかったからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "警察に行っても迷惑を掛けるだけだし、軍隊は言うまでもねぇべ。それであれこれ考えて……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "同級生を頼るしかないと思ったわけですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うん、そうだよ。チェンちゃんは前に、用があってもなくても会いに来ていいって言ってたからさ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……ははっ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "えっ、警官さん、なんで笑うの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "いえ、何でも。それで龍門に来たんですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うん。それでチェンちゃん、龍門にいるのは間違いないよね？　去年もらった新年のメッセージはここから発信されてたもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "その前に、どうしてゲートを強行突破する必要があったのか教えてください。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "追っ手に命を狙われているとはいえ、あなたはヴィクトリア国民。通行切符一枚すら買えないほど困窮してはいないでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "……それが買えなかったんだよなぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "え？　ヴィクトリア軍人の収入は龍門の市民以下なんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "そういうことじゃなくって……あの……"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "その……お財布とパスポートをリターニアで無くしちまって……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……さすが、とあなたを褒めるべきでところでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "――爆破されて、塵すら残らなかったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "確かに褒めるべきでしたね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "お財布どころか、危うく自分まで吹き飛ばされるとこだったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "あれは、ヴィクトリアを離れたばかりの頃だったべ。うちはとある商隊の中に入れてもらって、リターニアを横断しようとしてたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "入国してまもなく、街に立ち寄った時に、現地の子爵が親切にもてなしてくれて、うちらに街一番のホテルを手配してくれたんだべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "夕方になってね、みんなは宴会に出かけたんだけど、うちは案内された豪華な部屋に残ってたんだ。そしたらホテルの従業員さんが、サービスで夕食を持ってきてくれて――"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "ちょっと食べたんだけど、リターニア料理はどうも繊細すぎて口に合わなかったもんだから、外に出て市場でも探そうと思ったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "……でも、一階に着いてすぐに、すーごくでっかい音がして、うちの部屋の窓枠が目の前に吹き飛んできたんだよ。しかも完全にへしゃげた状態で。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "そりゃあ酷いですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "だよね。さすがのうちだって、十階以上の部屋から爆破で吹っ飛ばされたら、死んじゃうかもしれないのにさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……かもしれない、ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "十分、深刻なんだべ！　まさかリターニアでもあんな目に遭うなんて思ってもなかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "どうやらあなたは、心身ともに不運な窓枠よりずっと丈夫みたいですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "ん？　えっと……ありがとう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "それで、犯人に心当たりはあるんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "それが分からないんだよ。商隊に入って数日しか経ってなかったし貢献はしてたから、恨みとかじゃないとは思うんだけどなぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "でも……うちも別にそこまで犯人が誰か気にしてないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "この事件の調査をはじめてから、謎がこれでもかって増えるばかりでさ、ちっともすっきりしないんだ。もう慣れちまったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "龍門で友人を訪ねて、助けてもらうつもりですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うーん。別に誰かに守ってもらおうなんて思ってないよ。ただチェンちゃんに協力してくれるか聞いてみようと思って。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "ほう？　ヴィクトリアに戻って調査を続けるつもりなんですか？　大勢の素性も知れない相手があなたを殺そうとしているのに？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "もちろん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "何の迷いもないようですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うん……"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "ヴィクトリアから龍門まで。うちは数ヶ月かけて、ここに来た。もしちょっとでも迷いがあったら、ここまでだってたどり着けなかったべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うちはね、約束したんだ。絶対に真相を暴いて、白日のもとにさらすの。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "真相がどこにあるか分からないなら、探しに行く――"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "敵がうちの口を封じようとするなら、うちはもーっとおっきい声で叫ぶんだべ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "ヴィクトリアを離れてから、後ろを振り返ったことは一度もない。けど、真相を暴く準備ができて、あそこに戻る時が来たら、うちは躊躇しない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "怖くないのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "怖いよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "そうですか。あなたのことを信じます。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "え？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "死ぬのが怖くないと口にできる戦士は、大口を叩いているだけか、死を理解していないかのどちらかです。ですから私は――"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "――あなたがきちんと覚悟を決めているのも、嘘をついていないのも信じます。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "それなら、チェンちゃ、チェン隊長に連絡をとってくれる？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "その前に、これをどうぞ。袋にチャーシューまんが何個か入っています。冷めてきていますが、腹は満たせますよ。広い荒野を渡って来て、きっとひもじいでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "さすがにあなたのような屈強なヴイーヴルでも、餓えには勝てませんからね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "（もぐ……がぶがぶがぶ、ごくん）"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "……うっめぇ……"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "うっ――あれ、おかしいよ、これも取り調べの一環なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "取り調べ？　そんなものはとっくに終わってますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "さっき、連絡をとってくれるって言わなかったから、てっきりチェンちゃんとの思い出話をさせて、うちが嘘をついていないか確認するだろうと思ってたべ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "その必要はありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "知るべきことは、とっくに知ってますから。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "それってつまり……"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "あっ、待って待って、思い出した！　うちもおめーさんのこと知ってるべ！　確か近衛局の、ホシ……ホシ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "ホシホシ……？　ハハッ、その呼び方はやめたほうがいいですよ。とくに彼女たちの前ではね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "さて、バグパイプさん。外に人に待たせているので、私は少し失礼しますね。申し訳ないですが、規則があるので、あなたはもう少しここで待機していてください。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "speakerId": "char_308_swire",
      "text": "取り調べは終わったの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "興味があるなら、どうして入って来ないんです？"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "speakerId": "char_308_swire",
      "text": "……どこに興味を持つ価値があるっていうの？"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "speakerId": "char_308_swire",
      "text": "ロドスの人間が来るんだから、彼女はすぐいなくなるんでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "ええ。時間的に、もうすぐ到着する頃ですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "speakerId": "char_308_swire",
      "text": "フンッ！　あのアホ龍、今はどこをほっつき歩いてるのかしら。おかげで龍門に残ってるアタシたちが残業させられてるってのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "もしも同級生が遠路はるばる会いに来たと聞けば、無視するはずはありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "口にこそ出しませんが、彼女は友人に対して義理堅いタイプです。お嬢様もご存知でしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "speakerId": "char_308_swire",
      "text": "……アイツの友人関係なんて、アタシの知ったこっちゃないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "speakerId": "char_308_swire",
      "text": "アンタもアンタよ。報せを受けて、すぐにロドスへ連絡しておきながら、どうして取り調べなんて真似をするの？　鉄仮面の役人を演じてて楽しいの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "下のものが大勢みてるんですよ。皆まじめに職務に当たっているんですから、私もしっかり過程を踏まないと示しがつきません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "それにですよ、お嬢様。これからチェンがどんな危険に巻き込まれそうなのか、気にならないんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "speakerId": "char_308_swire",
      "text": "……興味ないってば。"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "speakerId": "char_308_swire",
      "text": "ああもう、めんどくさいわね！　中にいるそいつがロドスに引き取られたらちゃんと説明してちょうだい……誤魔化したりしたら許さないわよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "ははっ、了解。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "ほら、ロドスのオペレーターが迎えに来ましたよ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "えええっ、どういうことだべ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "えぇー！　チェンちゃんはもう龍門近衛局にはいない？　そんなぁ……！　別の場所で待てって？"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "えっと、その会社、なんて名前だべ……"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "speakerId": null,
      "text": "――ロ、ド、ス？"
    },
    {
      "type": "sceneBreak"
    }
  ],
