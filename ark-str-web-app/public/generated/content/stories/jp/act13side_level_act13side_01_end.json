{
  "server": "jp",
  "storyId": "act13side_level_act13side_01_end",
  "groupId": "act13side",
  "stageId": "act13side_01",
  "title": "カレンデュラ",
  "storyCode": "NL-1",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act13side/level_act13side_01_end.txt",
  "sourceHash": "8b3858b26e85745f5d599d314f5676dcf33ee2e8d0c9f981ad58b5234af0a886",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2 1-2"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "やあ、マルキェヴィッチ君。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "あっ、マッキーさ……様。何か御用でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "――連合会からの手紙は受け取ったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "メジャーの開催期間中、大会の監督を担当する代弁者は我々二人だけ……これは大変な仕事だが、大いに注目を集める役割でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "「代弁者」という肩書を失った後も成功し続けたいと思うのなら、絶好のチャンスになるだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "あ、はは……個人的には、注目されるくらいなら、いっそ会場のイベント計画でも担当したいところなんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "イベント計画か。得意分野なのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "いえ、得意でも不得意でもないのですが、その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "またそう謙遜するな。君は適応力のある人だよ。あのベテラン社員たちより、よっぽどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "――さて、早速本題に移ろうか。少し、事前に伝えておきたいことがあってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "ここじゃなんだし、ラウンジにでも行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……？　は、はい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "あの……もしかして、人前ではできないお話なのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "そうなるね。本来なら私から伝えるべきことではないんだが、チャルニーさんがああいう去り方をしたからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "――カヴァレリエルキは、大騎士領本土を核として、その年の商業成長率が最も高い都市を三つ選び、今のような大騎士領に統合することで成り立つものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "その大騎士領本土を除く統合された三都市については、メジャーが終了したら数ヶ月以内に、航路技師の設計に基づき、それぞれ一ヶ月ほどをかけて元の航路へと戻ることになっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "四都市の統合は良い機会だよ。相当な人数が往来し、絶え間なく商業取引が行われる傍らで……問題解決のチャンスも訪れるわけだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "もし四都連合がここまで大規模のものでなかったら、効果的な移動や天災の回避が不可能ということもなく、物資の分配や採掘問題への対処が困難であることもないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "正直な話をすれば、こうした問題さえなければ、四都連合がずっと続いてくれたらいいのに、と思うくらいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "だが、伝えておきたいことというのはそれではなく……とある暗黙の了解についてなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "暗黙の了解……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "……感染者のことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "今年、ミェシュコ工業グループは大騎士領のために、七つの移動式プラットフォームを提供した。これは他国の区画一つに相当する規模になる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "その話なら、同僚から聞いたことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "しかし、ここまでは表向きの話だ。今我々が注目すべきなのは、零号地という場所でね。あそこは、ミェシュコが提供する正式なリストには含まれていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "あの場所は特殊なんだ。小規模の移動式プラットフォームで、今は南西の端に接続されている。ちょうど十七号区画の外だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "十七号区画というと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "そう。感染者収容治療センターのそばなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "……話を進める前に、一つ無礼な行いだがどうか許してほしい。マルキェヴィッチ君。この先の会話は、規定に従いすべて録画させてもらうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "連合会への背信行為は、いかなる場合も許されない。代弁者とはそういうものだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……わ、わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "顔色が悪いな……大丈夫かい？　……君の気持ちはよくわかるよ。私も初めてこれを聞いた時、気分が悪くなったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……こんなこと……あまりにも、人道に反する行いです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "「ですが――今のあなたは理事会の執行人。商業連合会の代弁者なのですよ、マルキェヴィッチさん。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "「どうかそれだけはお忘れなく。ああ、ご安心下さい。この発言は警告でも脅迫でもございませんので――」……はは、チャルニーさんの物言いはこんなふうじゃなかったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "なにもかもを掌握し、知り尽くしているかのような不思議な説得力があった。彼の言うことを聞かなければと思わせる凄みがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "だが、私は彼とは違うんだ。マルキェヴィッチ君、我々は互いに支え合おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "時間はある。先ほど伝えたことについて、よく考えてくれたまえ。私はこれから、いくつか騎士団の元へ立ち寄ってスケジュールを確認しなければならないから、そろそろ失礼するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "では、また。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……ムリナール？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "いないの？　ムリナール――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……ゾフィアおばさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "あ……マーガレット。どうしてまだ家にいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "騎士協会へ呼ばれて行ったって、マリアから聞いたけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "簡単な手続きだけだったので、大した時間はかからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……ふふっ。君、本当に変わったのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "あの「ロドス」って場所にいたおかげかしら？　前は書類仕事なんて苦手だったでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "君が騎士競技に応募した時のこと、覚えてる？　……独立騎士マーガレット・ニアールときたら、証明書類も手続きも、何もかもがメチャクチャで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ……あの時は本当に助かった、おばさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……はぁ……あのねえ、マリアにそう呼ばれるならまだしも、君は私と同じような歳じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "あんなに苦労してやっと呼び捨てにさせたのに、また「おばさん」に逆戻りなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "何年か会わない内に、そこまで疎遠になっちゃったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……はは、悪かったゾフィア。家族と直接話をするのが随分久しぶりなものだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ところで、叔父さんに会いに来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "ええ。……彼、まだ仕事中？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "まだ帰ってきてはいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……ねえ。ムリナールは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……わかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ゾフィア、私は叔父さんを敵視することなどないし、恨みを抱くこともない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "絶対に。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あっ……見て、試合が始まるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "……相変わらず、とんでもない人出じゃのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "お、ブレードヘルム騎士団のあの男、去年も見かけんかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "あんな奴、どうだっていいだろ。左腕騎士ですらうちのマリアにゃ敵わなかったんだぜ。今更ブレードヘルムが何だってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "ちょ、ちょっと……！　あれは偶然……ただの偶然だから……そんなふうに言われると、恥ずかしいよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……ほう。今夜の試合、錆銅騎士オルマー・イングラも参加するみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "ハハ！　どいつも顔馴染みばかりじゃな、マリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "――おい、ちょっとは黙ってろっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "まあまあ。私は大丈夫だよ、コーヴァル師匠。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "もう競技騎士になろうだなんて思ってないしね。私には合ってないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "よくぞ言った！　自分らしく生きる方法なんぞ山ほどあるんじゃ、強制された選択なぞ捨ててしまえ！　これは老ぼれの忠告じゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "お主は本当によくやっておるしな！　そおれ、マリアの前途を祝って乾杯するぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "そういや、話は変わるが、マーガレットの鎧はまだ調整中か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "前に着てたやつァ確かに出来は良かったが、マーガレットみてえな勇猛なクランタ向きじゃねえからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あっ、うん。今最終調整をしてるところなんだ。もう少し時間がかかりそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "それから、お姉ちゃんの武器も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "思えば、マーガレットが初めて騎士競技に参加した時は、ハンマーを使っていたね。その後、ロングソードに持ち替えて、彼女の刀身は光を纏うようになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "今の得物は――ソードスピアか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "ははっ、そうさ！　ミノスのD32鋼を使った鍛造加工、アーツ伝導率に優れた逸品だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "いやあ、懐かしいぜ……あの時はマーガレットが俺を訪ねてきて、扱いやすい剣が欲しいっつってなあ。ニアールの旦那の孫娘が俺に助けを求めるなんて、初めてのことだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "何をしみじみしとるんじゃ、コーヴァル！　来週には耀騎士の試合があるんじゃぞ。お主ら、ちゃんとマーガレットを手伝ってやっとるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "ああん？　当たり前だろうが！　一日中酒浸りで遊び回ってるあんたと一緒にすんじゃねえよ、フォー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "（錆銅騎士の参加試合は――フラッグ戦……？　ブラッドボイル騎士団はなぜ、精鋭騎士をこんな割りに合わない試合に……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "（錆銅の相手は……ふむ。確かに、どれもいくらか名の売れた騎士団ではあるが……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "（……待てよ。感染者騎士がいるのか……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メジャー本戦か、フン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "感染者になった時は、こんな日が来るなんて、想像もしてなかったよなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前はさ、この競技場に立って、何度生まれ変わっても稼げそうにねえ額の賞金を自力で勝ち取れるだなんて、考えたことあったか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "そうだよ……そうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "レッドパイン騎士団に入れてもらえて光栄だ、野鬃騎士。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ははっ！　堅苦しいこと言わねえで、名前で呼んでくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "そうか？　わかった！　では、私が賞金を手にした暁には、あなたに酒でも奢るとしようか、イヴォナ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "そりゃあいい。灰毫以外に付き合ってくれる奴がいなくてな、ちょうど退屈してたところだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "――で、あんた。フラッグ戦のルールは覚えてるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "ああ、もちろん。できるだけ得点エリアの中にとどまって、衝突は避けるように――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "おいおい、それってぜってーソーナが教えたテクニックだろ。あたしに言わせりゃ、あの貴族騎士どもの鎧を片っ端からぶっ壊せば一位獲得間違いなしだぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "点を奪いにくる連中を、邪魔される前に片付けとくのさ。簡単な話だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "あ、はははっ……それができたら、簡単なんだろうけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "自信持てよ。がっつり力を見せつけないと舐められるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "誰かに尊敬されたいか？　見上げられたいか？　簡単だ。そいつを叩き潰して地べたに這いつくばらせればいい、そうだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "――だけど、あんたを狙ってる奴もいるみてぇだな。ハンッ、あの野郎、灰毫に痛めつけられといてまだ足りねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "オルマー・イングラ……彼は、感染者への復讐のためにここへ来たというわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "まったく、度量の小さい男だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "けっ、これだからお貴族様のお坊ちゃんは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "灰毫との一戦でプライドをずたずたにされたらしいが、そもそも見かけ倒しの野郎が競技場に立つなっての。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "あーあ、あたしも戦いたくなっちまった。いっそ個人的にぶちのめしてやろうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の声",
      "text": "――参加騎士の皆さん、ご入場ください――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "よし、行ってこい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "……ああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "子供たちが我々の帰りを待っているんだ。張り切らなければな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "……目障りなレッドパイン騎士団め……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "感染者どもが……生意気に騎士を名乗りやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "……思い知らせてやる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
