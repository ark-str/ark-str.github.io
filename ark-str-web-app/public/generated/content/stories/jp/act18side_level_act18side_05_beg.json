{
  "server": "jp",
  "storyId": "act18side_level_act18side_05_beg",
  "groupId": "act18side",
  "stageId": "act18side_05",
  "title": "月光",
  "storyCode": "LE-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18side/level_act18side_05_beg.txt",
  "sourceHash": "9e5f4eeb3b74c8cf8d0a12bdce9c4cc20f336a232e57f4eb94e9566b15b5ab9e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "ご気分はいかがですか？　もう大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "問題ない、大丈夫だ。君も私もきっと大丈夫なはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "少し出かけてくる、君はここで待っててくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "まだ調子が戻ってはいないでしょう、どこへ行くんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……やることがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "何をするにせよ、回復してからにしましょうよ、ね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "心配はいらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "ハイビスカスさんも仰っていましたよ。目が覚めても、しばらくは休んで様子を見た方がいいって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "急用なんだ、とても急ぎの。いいな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "でもコンサートまで時間がありません。今最も重要なのは、身体を休めて練習に力を入れることだと思います……それこそ、あなたが望んでいることじゃないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今はそういうことを言って煩わせないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "え……その、気に障ることを言っちゃいましたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……君を責めているつもりではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "だが、どうしても行かないといけないんだ。止めてくれるな。できるだけ早く戻ってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "本当に……何をしに行くかすら教えてくれないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "すべてがうまくいけば……じきに知ることになるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そうだ、衣装。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "衣装？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今日の午後に取りに行く約束だったはずだ。一緒に行けなくなったから、一人で行ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "チェロも持って行くんだぞ。試着した時に軽く弾いて、着心地を確認しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "では行ってくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "またあなたですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "今回のコンサートを中止していただけるよう、お願いに来ました。少なくともエーベンホルツさんとクライデさんは、コンサートで合奏をさせないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "何を言っているのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "もし二人に合奏させてしまったら、アフターグロー区は大変なことになるんです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "先日あなたは確か、最近私の体調が良くなった原因は、彼らが引き起こした「疑似回復」によるもので、その疑似回復期が過ぎると、私は重症患者となり、命が危なくなると言いましたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "そうです。あなたは彼らとの接触が多いので、それによる症状がより顕著に見られます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "もしこのまま演奏をさせれば、彼らとの接触が少ない方でも影響を受け、誰かが亡くなる可能性があると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "はい。原因はまだ定かではありませんが、あの二人が合奏すると、周囲への影響が高まる可能性が大きいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "どれほどの影響が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "まだわかりません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "今、それによって私以外に命の危険に晒されている人はいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……アフターグロー区の十名以上が、すでにクリフィーパティオ区の病院に運ばれています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "クリフィーパティオ区……つまり、その方たちはすでに彼らの影響範囲から離れているのですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "多分そうだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "仰りたいことはわかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "では……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "お断りします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "え！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "コンサート自体を取りやめるよう求めているわけではありません。ただ、あの二人の演奏をやめさせるだけでいいんです！　それか、演奏者の変更でも構いません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "もし彼らの演奏が、私以外の人に必ず害を及ぼすということをあなたが証明できれば、すぐにこのコンサートを中止しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "ですがあなたは彼らの演奏がもたらす結果すら、明確に説明できないようだ。そのようなあやふやな「可能性」だけでは、アフターグロー区全体の努力と希望を無駄にするわけにはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "アフターグロー区全体の努力と希望？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "このコンサートをとても重視しているのはわかります。でも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "いいえ、あなたはわかっていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "本当にわかっているのなら、「でも」などという言葉は軽々しく口にできないはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "残念ですが、あなたの言い分だけではコンサートの予定を変更することはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ツェルニーさん、教えてください。このコンサートの一体どこが、感染者の命よりも重要なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "どういう意味でしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ツェルニー",
      "text": "私が命を軽視していると仰りたいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私はただ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルズラ",
      "text": "ハイビスカス、ハイビスカスや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ウルズラお婆さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルズラ",
      "text": "ちょいと風にでも当たりに行かないかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "でも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルズラ",
      "text": "ほら行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルズラ",
      "text": "外に出て頭を冷やしてから話を続けたって遅くはないさ、ね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（ゲルトルーデの話がすべて本当なら、クライデは生き延びることができない……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（いや、きっと何か方法があるはずだ……どちらもうまくいく方法が……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（ツェルニー……そうだ、ツェルニーなら何か知っているかもしれない……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（いや、彼はただの音楽家だ。あてにはできない。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（クライデに真実を告げるか――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（しかしそれでどうなる……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（あるいは、ロドスなら……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（いや、ハイビスカスのような奴は、私をウルティカへ送り返して閉じ込めるだけだ！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（「女帝の声」？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（いやいや、一体何を考えている、自殺の計画か！？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（ダメだ。ずっとここをうろついていると怪しまれる。人のいない場所に行こう……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（ん？　あの男には見覚えがあるな。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄な貴族",
      "text": "……慎重に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "……人々……保証がある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（そうだ、噂――あの予言の噂！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（噂の内容をはっきりさせれば、何か手がかりが得られるかもしれない。それを広めた者が何を発信しようとしているかわかるかもしれない！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（今は自分で動くしかないな……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄な貴族",
      "text": "本当に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "今が絶好のチャンスだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "これ以上先延ばしにすれば、時間はどんどんなくなっていく。いざその時になったら厄介なことになるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄な貴族",
      "text": "そうですか。では存分にやってください。上には私から報告をしておきます。頑張ってください、ミスター・ラハマン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラハマン",
      "text": "はぁ、この仕事はほんと身心共に疲れるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラハマン",
      "text": "噂を広めるだけならまだしも、こんな場所にまで行かなきゃならんとは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（下水道？　彼は下水道へ入るつもりか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（後をつけて入りたくはないな……やるか。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そこで止まれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラハマン",
      "text": "誰だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "振り返るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "言え、アフターグロー区で噂を広めたのは誰の差し金だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラハマン",
      "text": "誤解だ、俺も他の人から聞いただけなんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君をずっとつけてきたぞ、ミスター・ラハマン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "それに今気づいた。この前ハイビスカスが取り囲まれた時、そばで声高に噂を広めて、煽り立てていたのも君だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラハマン",
      "text": "いい記憶力だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "言ってみろ、誰の指示でこんなことをしている？　下水道に入って何をしようとしていた？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ちょうどいい、私も興味があったのですよ。ミスター・ラハマンが下水道へ入って何をしようとしていたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "振り返らないでください、でないと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どうなるでしょうね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
