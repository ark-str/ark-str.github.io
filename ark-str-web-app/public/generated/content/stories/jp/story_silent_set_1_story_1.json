{
  "server": "jp",
  "storyId": "story_silent_set_1_story_1",
  "groupId": "story_silent_set_1",
  "stageId": null,
  "title": "新入社員",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_silent_1_1.txt",
  "sourceHash": "a13dd7def7fa3f4ab52da493a096c27d32a9e120966e3ae8d9ec3579df7cb22c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "本当にありがとう、サイレンス！　あなたがいなかったら、あのライン生命を見学させてもらうなんてできなかったわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "どういたしまして。このくらいはしないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "ふふっ、テスト期間中毎日あなたを起こしに行ってた甲斐があったわね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "自力で起きてた日もあったと思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "ええ、二回だけね。ちゃんと覚えてるんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "ところで……ライン生命ってカッコいい人多くない？　好きな人とかいないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "えっ？　い……いないよ、まだ入社したばっかりだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "ごめんごめん、ちょっとからかっただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "あなたが研究に夢中なのは知ってるしね。向こうから口説かれない限り、自分から追いかけたりはしないタイプでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "でも正直、クラスのみんなもサイレンスをちょっと心配してるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "？　どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "あなたは何でもできる人だけど、控えめなところがあるから……恋愛のことは一旦置いといて、職場に相談しやすい友達ができるかどうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "だ、大丈夫だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "職場の人はいい人ばかりだし、心配しないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "……うん、そうよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "じゃ、切り替えましょ！　私、トリマウンツにはあと三日居るつもりなんだけど、ちょうど明日からは週末じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な女性",
      "text": "だから明日は観光に付き合ってほしいの！　有名どころを全部制覇しましょうよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "おはよう、サイレンス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ミラーさん、おはようございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "おはよう、クリス。楽しい月曜の始まりね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "やあ、スザンナ。ははっ、そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "週末はどこかに出かけたりしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "いいや、家に籠もって『証券会社大血戦』を一気見してたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "私もそれ大好き！　完走するまでついつい徹夜しちゃったのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "だよなあ。サイレンス、君は見たことあるかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "えっと、私は見てなくて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "そんなことより、週末は何してたの？　お出かけしたりした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あっ、はい！　同級生がトリマウンツに来ていたので、一緒に観光地を見て回ってたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "なるほどね～、私もここに来たばかりの頃はそんなふうに週末過ごしてたっけ……でも、面白いところってそこまで多くないのよね。あなたはどこが気に入ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "セントラルパークですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "セントラルパークって……木が生えてるだけで何にもない場所じゃないか。あれのどこが気に入っ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "ちょっと、クリス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "あっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "それじゃ、私たちもう行くわね。今週も頑張りましょ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "……今週の注意事項は以上だ。では、解散。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "そうだ、サイレンス。君は残ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "はい、先生。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "どうだい、仕事を始めてみての感想は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "皆さん熱心な方ばかりで、雰囲気のいい職場だと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "そういう君だって熱意に溢れているじゃないか。この数日の様子を見る限り、君はほかの子たちと比べても飛び抜けた才能を持っているようだしね。私は君を高く買っているんだよ、サイレンス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "ただ……仕事以外では畏まらなくてもいいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "この会社は若い人も多いし、一緒に働く仲間同士で自由にお喋りをしたり、遊びに行ったりして構わない。適度な交流は仕事をする上でも重要だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "よろしい。このくらい、君は当然わかっていると思うけれど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "大切なのは、実行することだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "さて、本題に戻ろう。こんな年寄り臭いお説教をするために呼び止めたわけじゃないからね。――君に話があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "私は、君の配属先を勝手に決めるつもりはない。しばらく課内を見て回って、構造課のどのチームに入りたいかを考えてもらいたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "その上で、君の希望と課内の状況、両方を加味して結論を出そう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "シャーマンさんのチームは……源石微粒子の病原性が専門。現在のプロジェクトは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うーん、やっぱり第七班の専門分野が私には合ってそうだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あのチームはベテラン研究員ばっかりだし……軽はずみに入りたいなんて言ったら、生意気だと思われそうな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "そこの新人、この辺でリーベリとすれ違わなかったか？　眠そうな目をした女性なんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "眠そうな目の……リーベリですか？　それって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "あ、もちろん君のことじゃないぞ！　髪の毛は白で、服装は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "はぁ……いや、もういい。この辺りには居ないみたいだし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "ほかを探してみよう、カレン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "ええ。それにしても、どこ行っちゃったのかしら……人に迷惑かけてないで、病室で大人しくしてればいいのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "（誰かを探しているのかな……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "（眠そうな目をしたリーベリの女の人、か……私の髪が白かったら本当に間違われてたかも……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "まだ見てないチームはあと一つか……確か、九号デバイスがどうとか聞いたような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "オフィスはここのはず……だよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うわっ……このドアノブ、ほこりだらけだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……あれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "白い髪のリーベリで……眠そうな目をした、女の人……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "さっきの人たちが探してた患者さんって……あなたのことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "患者さん？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あるいは、その人に運悪くよく似ているだけとか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "運の悪い人？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あっ、もしかして、このチームの人ですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "このチームの人",
      "text": "（頷く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "なるほど、そうでしたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "初めまして、最近入社したばかりのオリヴィア・サイレンスと申します。あなたの名前をお伺いしてもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "このチームの人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あの……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "サイレンスは、オフィス内に置かれたメンバー表を見やった。ほこりを被ったそれには、名前が一つだけ書いてある――ジョイス・モル。"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ええと……もしかして、ジョイス・モルさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "肯定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……えっと……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "やっと見つけた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "ちょっと、あなたさっきの新人じゃない。まさか嘘をついてこの女を匿ってたわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "いえ、そういうわけでは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "言い訳はいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "ここは大学寮じゃなく、ライン生命なんだぞ！　かくれんぼがしたいならよそでやってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あの、誤解です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "はいはい……何をしたいかは知らないが、君が俺たちの邪魔をしてるのは確かだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "このことは主任に報告させてもらうわよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "事情は大体わかったよ。あの二人には、私から説明しておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それにしても……モルさんのチームでは、何かあったんですか？　メンバーも彼女しかいないようですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "あのチームは実験に失敗して、そのまま解散してしまってね。以来あのオフィスは空き部屋なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "ほかのメンバーは全員メンバー表から名前を消したんだが、ずっと入院しているモル君だけはそのままになっているのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "モルさんが治療を終えて仕事に復帰するのは、いつになるんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "残念だが、今のところはわからない。彼女の状況は複雑だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "端的に言うと、彼女の脳には、失敗した実験の機材が今も残っているんだ。そのせいでこの先どうなるかの予測も付けられなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そんな……どうしてそんなことに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "はぁ……本当に心の痛む話なんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "優秀な研究者だったモル君は、自分からあの実験の被験者になったんだ。しかし結果としてそれは上手くいかず、彼女は今のような状態になってしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "科学の道において、犠牲は避けられないものだが、我々の支払った代償はあまりにも大きい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "……この話はもうよそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "各チームの見学を終えてきたそうだね。配属先の希望はもう決まったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "モルさんの力になりたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "彼女の治療を引き継ぎたい、と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "なるほど。てっきり第七班を希望するとばかり思っていたよ。君は彼らの研究分野に興味を持っていたようだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "実際、そうしたくもあるのですが……今治療を担当しているお二人はモルさんに対してあまり友好的ではないようなので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "彼女が本当に、科学の道の犠牲となってしまったというのなら、あんな扱いを受けるべきではないと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "だから、私はモルさんの力になりたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もし、私がモルさんと同じような状況になったら、先生もきっと私を助けてくださるだろうと思いますし……ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "ああ、もちろんだとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "とはいえ、その覚悟があるのはとても良いことだ。ライン生命での仕事はある程度危険が伴うものだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "たとえば昨日なんて、ある賭けに負けてしまってね。危うく、一週間昼ご飯抜きで過ごさせられるところだったよ。あれはまったく危機一髪だったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……ふふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "さてと、やりたいことが決まったのなら、早速準備を始めよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "君がその仕事を通して、色々な経験をしてくれることを期待しているよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "なっ……どうして新人なんかと交代しなきゃいけないんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "まあまあ、いいじゃないの。早く誰かに引き継いでこんな仕事から離れたいって言ってたわけだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "（小声）実験で頭をやられた奴なんかの世話でこれ以上時間を潰したくないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "じゃあ、モルさんのことよろしくね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "待ってください、彼女の状態についての引き継ぎがまだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "自分でカルテでも読んでくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あれ……急に立ち上がったりしてどうしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ええと……カルテを見せてもらいますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "「ジョイス・モルの思考能力及び言語機能には障害がある模様。他人との正常なコミュニケーションが取れず、しばしば理解不能な独り言を口にしている……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "モルさん、ベッドに戻りませんか。まだ身体が弱っているようですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もしかして、失語症も併発してるのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "否定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "えっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "（そういえば、初めて会った時も「肯定」って返事をしてくれたような……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "（でも、肯定と否定の二つだけだと、言いたいことを判断するのは難しいし……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……モルさん、あなたはリーベリですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "肯定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたの言う「肯定」は、「はい」という意味で合っていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "肯定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "警告。この質問は誤解を招く可能性があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "仮に「肯定」を否定の意味で使っていた場合にも、先ほどの回答で会話が成立してしまいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ええっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ちょっと待ってくださいね……考えてみます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "――あ、本当だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "「肯定」が「いいえ」の意味で使われていた場合でも、私の間違いを指摘するためには「肯定」と答えることになるんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "というか、こんなことに一瞬で気付くなんて、思考能力に障害がある人だとは思えないような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あっ、そうだ……そろそろお昼ですし、食堂からランチを取ってきましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "（どうして急に黙っちゃったんだろう……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス・モル",
      "text": "警告、不明なエラーが……発生……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "モルさん？　大丈夫ですか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "よかった……呼吸も安定しているし、どの値も正常だ――ってことはただ寝ちゃっただけ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私の症状にちょっと似てるな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ジョイス、気分はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "身体の柔軟性上昇を検出。より強度の高いリハビリテーションに適応可能と推測します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それはよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも、リハビリは昨日したばかりだし、今日は週末だからゆっくり休んでほしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "了解しました。サイレンス博士の医療プログラムは、良好な効果をもたらしています。恐らくあなたは豊富な医療経験を持つ人物だと判断します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ううん、私はまだ学校を出たばかりの新人だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "認識を修正します。サイレンス博士は豊富な医療経験を持つ新人であり、信頼に値します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "（頬を赤らめる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そうだ、今日はリハビリを休む代わりに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "（首をかしげる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "この病室でドラマを見てもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "本日は休日です。ご友人とご自宅で鑑賞することを推奨します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "実は、一緒にドラマを観てくれるような友達がいなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "推奨環境を満たしていない場合、当病室でのドラマ鑑賞を選択することも可能です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "えっ、いいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "肯定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "ドラマのタイトルを提示してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "『証券会社大血戦』だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "ポップコーンを摂取しながらの鑑賞を推奨します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ポップコーン？　会社で買えるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "病室を出て左折し、150メートル先で右折、さらに270メートル先の角に、ポップコーンの自動販売機があります。キャラメル味は当該ドラマとの相乗効果が低いため、ご注意ください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あ……ポップコーン、なくなっちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ふわあ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "少し休憩しようか、ジョイス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "……すぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……寝ちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "……肯定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "気にしないで。私も鉱石病のせいで、睡眠のリズムが乱れがちだからわかるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "サイレンス博士がドラマに集中していた時間も、短時間に留まっていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あっ……気付かれてた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "実は、こういうビジネス競争系のドラマには興味がなくて。でも、同僚たちの間で流行っているから、観てみようかなと思ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "疑問を提示します。なぜ同じドラマを見る必要があるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "職場に馴染むため、かな……そうでもしないと、共通の話題がないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "前は……大学に入る前住んでた場所は、あまり栄えてなかったから娯楽が少なかったし……大学時代は友達が面倒を見てくれたから、周りに合わせようとする必要もなかったんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "なぜ、周りに合わせようとする必要があるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "観察と推測の結果、サイレンス博士は社交的な性格ではないと判断しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ええと……私はただ、同僚と良い関係を築けたら仕事がもっと楽しくなるかもと思ってただけなんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "無理をせず社交から離れた場合と、無理に社交的でいようとした場合の心理的負荷を、比較検討する必要があるかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……確かに、そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "このドラマ、やっぱり返してこようかな――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "何やってるんだ？　彼女にドラマなんか見せてたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "ああ、気にしないでくれ。忘れ物を取りに来ただけなんでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "しかし、最近の新人はぶっ飛んでるな。メロドラマを見せて普通の人間の真似をさせようとするなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そんなことしてません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そもそもジョイスには、あなたたちが書いていたような思考障害なんてないのに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "そうだな。で、それがなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そうだなって……どういうことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "確かに彼女の思考能力に問題はない。だがそれが何だと言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それがわかっていたなら、ありもしない症状をカルテに書くなんて無責任すぎると言ってるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "いい加減その安っぽい同情は捨てたほうがいいぞ、お嬢さん。そいつのことなら俺のほうがよっぽどよくわかってるんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "彼女がずっとこの病室にいるのは病気のせいなんかじゃなくて、九号デバイスのせいなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それの何が違うって言うんですか？　彼女の病気の原因は九号デバイスにあるんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "……忘れてくれ。言ったところで理解できんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "だが、君の同情心のせいで、どれだけ周りが迷惑をこうむっているかは自覚すべきだな。お陰で俺たちが得られるデータは大幅に減ってしまったんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……？　何のデータのことを言ってるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "本気でわかってないのか？　それともしらばっくれてるのか？　そんなの当然――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "お静かに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "お静かに願います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "ハンコックさん、どうかお静かに願います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "ああ、そういうことか。君も随分お人よしだな。この純粋なお嬢さんが知ってしまうのが怖いわけか。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "どうか、お静かに、願います。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジョイスはほとんど表情を変えなかったが、サイレンスは彼女の言葉の中に明らかな怒りを感じ取った。"
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "……ふん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "好きにするがいいさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ハンコックさんは何を言おうとしてたんだろう……データって何のことなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "今のはノイズです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ノイズ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "有害なノイズにすぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……何を言ってるか、よくわからないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "時間の経過に伴って、理解も可能となるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "『証券会社大血戦』第七話がまもなく再生されます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "……今週の注意事項は以上だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "解散する前に……サイレンス、こちらにおいで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "はい、パルヴィス先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "（小声）あの子、何かやらかしたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員C",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "サイレンス。君の業務のことで、一度話しておきたくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "ジョイス・モルの治療について、ほかの人への引き継ぎ準備をしてほしいと頼んでおいたけれど、進捗状況はどうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "正確なカルテを作成し、用語集も添付しておきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "以前ご報告した通り、ジョイスの言語機能に問題はありません。彼女の病変は、そう単純なものではないと思われます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "（小声）大げさな言い方してくれちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "彼女がああして……特徴的な話し方をするのは、鉱石病とあの実験による影響を軽減するためのことなんです。このことは造影検査と病理学的な診断結果の両面から証明されています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それから、用語集については、次の担当者の負担を軽減することが目的です。ジョイスが習慣的に使う語彙と、通常の言語表現を比較した表としてまとめてあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "そうかそうか、お疲れ様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ありがとうございます。ただ、本当のことを言えば……彼女をほかの人に任せることはしたくないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "ほう、というと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "特定の治療と投薬だけを考えるのなら、交代に異論はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ですが、引継ぎには時間がかかりますし、ジョイスとの信頼関係を築くのにも根気が必要です。それに、誰が引き継ぐにしろ、彼女の気持ちをおろそかにしないかが心配なんです。以前のように――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……いえ、何でもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "（肩をすくめる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "実は、モル君本人にも意見を聞いてあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "彼女も、自分なりの言葉で君と似たようなことを言っていたよ。要するに、引き続き君に担当してほしいそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "（小声）本当に仲のよろしいことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "客観的に見ても、君が引き継いだあとから、モル君の回復速度は大幅に早まっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "彼女が戻ってきてくれる日も近いだろう。これは君の功績だよ、サイレンス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "お褒めいただき、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "しかし、そうなると少しばかり問題がありそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "と仰いますと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "第七班は最近人手不足でね。本当は君をそちらに異動させたいと考えていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "どちらも諦めたくないと言うのなら、掛け持ちしてもらうこともできるけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "この子が？　第七班に、掛け持ちで！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "カレン君、何か言いたいことでもあるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員D",
      "text": "い、いえ、とんでもない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "ならいいんだ。……改めて考えてみれば、モル君の容態も安定してきたことだし、サイレンスには第七班での仕事に重点を置いて対応してもらうこともできるだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "ひとまず、チームリーダーには話を通してあるから、あとは君次第だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "掛け持ちを選んだ場合には、仕事量はかなりのものになるだろうが……それでもいいかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もちろん！　第七班で働けるなんて光栄です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "であれば、しばらくは二つの仕事を頑張ってもらおうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パルヴィス",
      "text": "よろしい、それでは解散。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "すごいな、オリヴィア！　こっちまで嬉しくなっちゃったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "クリス、そんなにバシバシ肩を叩かないの。あなたは力加減が下手なんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "ははは、ごめんごめん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "そうだ！　今夜はオリヴィアのお祝いってことで、バーで三人一緒に飲まないか？　僕が奢るからさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ミラーさ……じゃなくて、クリスさんも、スザンナさんも、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "お礼なんていいんだって。僕たちも、君とじっくり話してみたかったんだ。あっ、どんな話題でも大歓迎だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "たとえば……『証券会社大血戦』の話とか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員A",
      "text": "いいね、最高だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "バーといえば……人が多いところで話すのは苦手なんですけど、大丈夫でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "もちろんよ。ここはトリマウンツだもの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "ラボで輝いてる人がバーでちょっと大人しくしてるくらい、誰も気にしたりしないわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "研究員B",
      "text": "そこのお兄さんがくだらない質問をした時は、私が代わりにつねってあげるから安心してちょうだい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "やっぱり、バーの雰囲気はまだちょっと慣れなかった。どうにもお酒は苦手だし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "鉱石病への影響を考慮するのであれば、アルコールの摂取は非推奨です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "自分ではノンアルコールを頼んだつもりだったの。でも、一口飲んでみたらそれがお酒で……しかも、結構度の強いものだったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ただ、断りづらい空気だったから少しだけ付き合って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……二人が次に誘ってくれた時は、セントラルパークで噴水を見る会を提案して、それに断固こだわることにする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "サイレンス博士はセントラルパークの噴水がお好きなのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うん。あそこに行くと故郷の小さな公園を思い出すから。その公園にも、あれとそっくりな噴水があるんだ。もう少し小さいやつだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "セントラルパークの噴水は異国情緒溢れる様式をしています。この情報から、二つの噴水はトリマウンツのモンセン社が製作したものと推測されます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あははっ、面白い偶然だと思ってたんだけど……私の故郷でもモンセン社が売り込みをしてただけってことか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "あなたは少々ホームシックになっていると推定します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "確かに、ここに来て数日の間はふるさとが恋しくて大変だったけど……今はジョイスと話ができるから、毎日楽しく過ごしてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "サイレンス博士の故郷について、詳細な説明をいただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "なんて言えばいいのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そんなふうに改めて聞かれると、どう答えたらいいのかわからなくなるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "質問の意味はちゃんとわかってるけど……しっくりくる表現が見つからないっていうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "ご提案があります。セントラルパークへ足を運べば、故郷についてより円滑な説明が可能になるかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それって……一緒にセントラルパークへ行ってくれるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "肯定。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うーん……仮に私が賛成したら、あなたは事故以来初めてライン生命のビルを出ることになるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたの身体はもう回復してると思うけど、パルヴィス先生に診てもらった時、念のためあと一週間は安静にしていたほうがいいって言われたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "ご心配なく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "サイレンスさんと私は、友人同士ですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "現段階における症状面でのリスクは極めて低く、友人のためならば無視することが可能な範囲です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ありがとう、ジョイス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも、やっぱりセントラルパークには来週行くことにしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "（首をかしげる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "友達同士になった今は、なおさらあなたに危ないことなんてさせたくないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "体調が万全になってから一緒に行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私たち、長い付き合いになりそうな予感もするしね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
