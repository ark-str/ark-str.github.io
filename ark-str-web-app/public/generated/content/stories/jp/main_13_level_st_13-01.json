{
  "server": "jp",
  "storyId": "main_13_level_st_13-01",
  "groupId": "main_13",
  "stageId": "st_13-01",
  "title": "戦場内外",
  "storyCode": "13-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_st_13-01.txt",
  "sourceHash": "f0d363f31a8533b3075d55a1998b29b5c51adde5813938bd6c58194dc14a7be4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "どうしようもねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "やってはみたが、あの本はどれも中の紙まで皮でできてやがる。そもそも火が点かねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "紙が皮でできてんなら、何で「皮」って言うんじゃなくて、紙って言うんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "知るか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "*サルカズスラング*、大して燃えもしねぇくせにそこら中が煙だらけだし、スープが煮える様子もねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "「スープ」ったって……こんなの、野菜の茎と肉の欠片を水に浮かべただけだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "元はと言えば、全部奴らのせいだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "驕り高ぶった王庭の野郎どもめ！　街中のロンディニウム人をとっ捕まえて工場で無理やり働かせて、疲れるだけの汚れ仕事を押し付けてくるくせに、あったけぇスープ一杯配りやがらねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "隊長が、俺たちは正式にロンディニウムを占領したって言ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "都市防衛軍は解散させられて、あのレトってリーベリも失脚したらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "ちっ。イカレ野郎のWについて行かなかったこと、段々後悔し始めてきたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "まあいい……あいつについて行ったところで、いい結果になるとも限らねぇしな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "ってか、これとか、そこにあるのとか……一体どんな本なんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "知るか。セール品のカタログか何かじゃねぇの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "あのフェリーンの爺さん、どうしてあんな大量にカタログを集めてんのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "なんだってそんな色々訊いてくんだよ。ヴィクトリア人の考えなんてどうでもいいだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "しかし、年寄りがあんなに泣いてるとこなんて初めてだぜ。さっきの見たか？　刺繍入りの服が、鼻水でひどい有り様だったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "おい、何ボケッとしてんだ！　その本もっとこっちに寄越せよ、火が消えちまうだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "何やってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "うん……これ読んでた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "はあ？　「読む」？　字なんて読めねぇだろ！　しかも全部ヴィクトリア語じゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "いや、文字だけじゃなく絵も描いてあるんだって！　ほら、これ、この絵を見てみろよ。フェリーンの女が男にビンタしてる。この二人、どういう関係だろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "多分、懇ろな男と女ってとこだろ。もっと面白そうなシーンはねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "ないな。あとはつまんない絵ばっかりだ……たった一冊で何百ページもあるぞ。ここの本全部合わせたらどれだけあるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "あっちには割と薄いのもあるな。一行にちょっとしか文字を書いてないのに、すぐ次の行に移ってる……一体ヴィクトリア人は中にどんなことを書いたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "この大地に、本に書くほど価値のあるもんが、こんなにたくさんあるのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "これも、これも、それからあれも……贅沢なガラス棚まで使って、種類分けまでしてるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "ヴィクトリア人は、便所紙をまとめて綴じておけるほど金が余ってるだけって可能性もあるけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "ハッ、かもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "どうして俺たちサルカズには本がないんだろ？　こういう、めくりすぎてボロボロになった紙なんて見たことない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "もしかしたら、本当はあるのかもしれねぇぞ。リッチってのは図書館に引きこもるイカれた連中なんだろ。何年も何年も、ずっと外に出てこねぇって聞くぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "ま、真偽はどうでもいいけどな。そんなことより温かいスープの方がよっぽど大事だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "そうだな。毎日変わり映えしないし、どの本にも違いなんてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "文字が読めなくても分かるよ。新しい何かが起きたことなんて、これまで一度だってないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "千年前、俺たちは刀で人を殺してた。で、今の俺たちは、もうちょい効率的な武器を使えるようになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "あと千年も経てば、俺たちも空を飛べるようになってるかもな。そんで……よく分かんないけど、雲とか、星とか？　そういうのを刀の代わりにして、誰かをぶっ殺し続けてるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "なぁ、もし俺たちが月に家を建てて、畑仕事で食えるようになったらこんな戦争を必要はなくなるか？　それか何かもっとでかいことが起きたら、戦う気なんて失せるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "空腹の傭兵",
      "text": "ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた傭兵",
      "text": "ふわ～ぁ……まあいいや。もう一冊、火に入れちまおう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "さっさと覚えてもらわんと困るんだよ、新人。新聞社は学校じゃないんだ。お前を教育する義務なんて俺にはないんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "それとも田舎へ帰るか？　お前の研修期間はあと何ヶ月残ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見習い記者",
      "text": "も、申し訳ありません。ただ……きちんと正確に書こうと思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "「正確に」だと？　おいおい、俺が求めてるのは天災学の論文なんかじゃないんだぞ！　『ザ・レッドワイン』がグループ内の発行部数で常に『四都スポーツ』の上を行くことだけを考えろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "仮にだ。お前が通勤中にスタンドの前を通りかかったり、都市ネットワークでサブスク中のニュースサイトを読んでるとして、「ヴィクトリアの天災学分野で大きな前進」なんて見出しに金を出すか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見習い記者",
      "text": "ですが、この「サルカズがヴィクトリアを壊滅状態に！」ってタイトルはちょっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "うちの読者が真相を求めてるとでも思ってるのか？　そんなわけないだろ。『中央ジャーナル』を読んでるようなエリート層だって、本当に欲しがってんのは「真相」なんかじゃないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "奴らに与えるべき餌は、焦燥感や、恐怖、優越感だ。特定の感情と結論を煽る言葉なんだ。そうしてやれば、連中はもっとたくさんの餌を欲しがるようになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "それでこそ俺たちは奴らの財布から金を得られるし、お前も仕事を失わずに済むんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "誰だ、こんな時に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "何だと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "……新人、見本配達の車が行ってからどれくらい経つ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見習い記者",
      "text": "三十分ほどです。ま、まさか、ヴィクトリアから続報が入ったんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "マヌケが。そうじゃない。今すぐ印刷会社に行くぞ。まだ下版はしてないはずだ、今から行けば間に合う！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "俺は編集長に電話する。お前は今すぐ新しい一面記事を書き出せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見習い記者",
      "text": "何の記事です？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "タレコミ屋が言うには、長いこと姿をくらましていたノヴァ騎士団の燭騎士ヴィヴィアナが、明日正式に引退を発表するそうだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "急げ！　このニュースをカジミエーシュで一番最初に出すのは、うちでなくてはならん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "ローズ新聞連合で最も重要な編集部は果たしてどれなのか、商業連合会に証明してやる時が来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見習い記者",
      "text": "では、ヴィクトリアやザ・シャードの件は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "そんなのはどうでもいい。テラでは毎日、これだけたくさんのことが起きてるんだからな――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "いいか新人、覚えておけ。俺たちはな、一番価値あるものだけを掴んでればそれでいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン編集者",
      "text": "急いでタクシーを呼べ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見習い記者",
      "text": "わ、分かりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見習い記者",
      "text": "そういえば、前はこの辺りにいつも魔族の違法タクシーが止まってましたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見習い記者",
      "text": "近頃はめっきり見なくなった気がしますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "話が違うじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "在庫がないと言ったらないんだよ、トナさん。源石爆弾は売り切れちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "発注していた武器はどこに？　あの坑道はオリジムシやら巨大鉗獣でいっぱいで、まかり間違ったらもっとひどい怪物までいるのよ。素手でそいつらとやり合えって言うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "それはあんたらが解決すべき問題で、俺にはどうにもできん。言っておくがね、ここ半月くらいは、闇市をひっくり返したって武器なんて半ダースも手に入らないだろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "商品を全部買い占めるなんて、どこの傭兵部隊がそんなことできるのよ？　馬鹿げてるわ。サンバレー工業だってこんなにたくさん買うのは不可能――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "……もしかして、首長の仕業とか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "またどっかのついてない首長がボコボコにされかけてるのね。誰なのか教えてよ、そこの辺りは避けて通るから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "いや、首長じゃなかった。隠している感じだったから、はっきりとは言えんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "（小声）おそらくは……パーディシャーだと思う。それも、一人だけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "それに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "まさか。パーディシャーが闇市の商品を空にするですって？　しかも一人じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "そんなのとてもありえないわよ。あの人たちには自分らのツテがあるでしょうし、それに……複数のパーディシャーが武器を大量購入だなんて、それが何を意味するのか分かってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "俺は適当に予測しているだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "何人もの仲介人を介した上で、外国企業を使って資金洗浄までしてるし、一回ごとの購入量もちょうど疑惑を起こさない程度に抑えてる。単なる偶然と言われても、反論はできないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "だがサルゴンで、こいつらを完璧にこなすことができるのは誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おい、店主。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "頼んでおいた車と補給は用意できたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "ああ。車四台に、食糧、水、テント。全部用意はできてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "よし、金はここに置いとくぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "「スペーサー」っていつからあんな金持ちになったわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "いや、あいつんとこの傭兵部隊はサルゴンを出るつもりらしい。有り金を全部はたいて、どこか別の場所へ向かうんだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "クルビアか、それともヴィクトリアとかかな？　近頃は魔族の傭兵の中にも転職者が特に多いみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "どういうつもりなのかしら？　「スペーサー」は家族全員サルゴンに住んでるんじゃなかったの？　足を失くした父親を放っとくつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "さぁ、魔族どもの考えなんて、端からよく分からんからな。単に砂漠とジャングルだらけの景色に飽きて、生活環境を変えたいと思っただけかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "……だといいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "なんだか……前と比べて、色んなことがものすごく複雑になってきた気がするのよね。もう何が何だかよく分からないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "――はぁ。うちの爺さんの頃なんて、どこの小角跳獣が一番間抜けで晩ご飯にピッタリか、とかそんなことしか考えてなかった気がするのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "それか、サルゴンの田舎で暮らしてる俺たちみたいなのですら「そいつ」が突っ込んでくるのを感じ取れるようになったのかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "「そいつ」って？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "闇市商人",
      "text": "まるで小角跳獣みたいなやつだよ。なりは小さいが、暴れ出したら俺たちをぶっ飛ばすこともできるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "あのトランスポーター、もう着いていい頃だろ。あいつ、また道すがら美人にでも気を取られてんじゃないだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "あいつの遅刻の言い訳にはもううんざりだ。ったく仕事の重要性を説いてやってくれる人が、どっかにいないもんかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "彼ならもう来はしない。郵政トランスポーターのアーサー・モリソンは死んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "なに、死んだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "そうだ。国家反逆罪の罪により処刑された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "こ、国家反逆罪だと？　あんた……何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "いいから、私の仕事に協力してくれたまえ。それで互いに手間が省けるのだから。アーサー・モリソンについて知っていることを話してもらえるかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "あ、あいつのことなんざ全く知らん。ただ、娘がロンディニウムの大学に通ってるんで、そっちに手紙を出す関係で、たまたま接点があっただけだよ。あいつはこの近くで唯一の郵政トランスポーターだったからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "それが国家反逆罪とはな……サルカズの方についたのか？　娘の手紙に書いてあったが、今やロンディニウム中サルカズだらけらしいじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "あのバカ野郎、俺は最初からろくでもねぇ奴だと思ってたぜ！　魔族どもと結託するなんざ、ろくでもない。自業自得だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "いいや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "アーサー・モリソンはウルサスに仕えていた。我々はこのことに確信を持っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "ウルサス？　し、しかし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "そして君は、彼の同僚のウェズリー・ロートさんで間違いないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "なっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "ハッ、ハハッ、何をバカなことを。俺は正真正銘ここで生まれ育ったフェリーンだ。ずっとじゃがいもを植えて暮らしてきたし、ウルサス語すら話せやしないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "きっと何か誤解してるんだって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "じゃがいもをいくつ植えても、娘の通うヴィクトリア国立大学の学費が生まれることはないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "ぐあっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "どうしても口をつぐむ気なら、もう片方の腕も同じように折ってもいいがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "時間を無駄にしないでくれたまえ。抵抗は無意味だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "……つまり、あの噂は本当だったんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "ウルサス人が言ってたことは本当だったんだな！　ロンディニウムは本当に占領されちまったんだ。この一ヶ月間、ロンディニウムからの連絡はおろか、噂すら届いてこなかったからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "クソッタレのサルカズどもが俺たちヴィクトリア人を侮辱して、殺して、いいようにこき使ってやがるんだろ！　あんたらは何してたんだよ。　ヴィクトリアの守護者とか名乗ってるくせに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "あんたらの家族や親戚、友人は、ロンディニウムにはいねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "いや、でもそうか。権力者のあんたなら、逃げ道を用意する手段なんていくらでもあるだろうしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "結局、バカを見るのは俺たちみてぇな貧乏人だけってことか。我が子を偉大なロンディニウムに、ヴィクトリアの中心に行かせてやれば、いつかきっと大物になるだろうなんて夢を見ちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "その結果がどうだ？　ハハッ、ハハハッ！　サルカズどもの雑用係にやっちまったんだ。俺たちの国の首都で、奴隷をやらされてるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "魔族がヴィクトリアの嵐を使って国を破壊してるってのに、あんたらは何もせずに横で黙って眺めてるだけじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "そのように狭い視野と浅い考えでは、ヴィクトリアの思惑を測ることなどできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "君はただ、君たちが情報交換をしている場所まで私を連れて行ってくれればそれでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "そんなこと――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "グッ――アアッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ村人",
      "text": "ウッ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "男の身体から、黒い槍が突き出ている。\n目の前の男はぴくぴくと引きつりながら両手を伸ばし、心臓を貫く恐怖を払いのけようと試みた。\n邪悪な穢れに触れた瞬間、彼の手はすでにねじれ、萎れていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "背筋が凍り付くほど重い呼吸が、遠くから伝わってくる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "私だ。「カイシャー郡に春の花が咲いた。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "通信を全て遮断しろ。十五分後に私からの連絡がなければ、すぐにこの町を放棄するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "……この花の香りの中で溺れ死なぬよう、祈るとしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "真夏であるにもかかわらず、口と鼻からは白い息が漏れ出した。\nうろたえてはならない。怯えてはならない。彼はヴィクトリアの名にかけて、相手と意思疎通を行わねばならなかった。\n一体どこに潜んでいる？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "振り向いてはならない。そして互いに姿を見てはならない。この些細なゲームのルールを、相手が理解してくれていることを願った。\n彼は猛獣を繋ぎ止めることはできても、相手が怪物となると手に負えないのだ。\n雪がひらひらと舞い、ヴィクトリアの大地が黒く染められていく。\n細長い影が自分の足元まで伸びている。奴は自分の背後にいると彼は気付いた。\nどれほど近付かれているのだろうか？　心臓の鼓動が雷のように鳴り響き、黒い呼吸が彼の背中にまとわりつく。辺りは完全に静まり返っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "（ガリア語）説明してもらおうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "93。【暗号】。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（ガリア語）此度の行動に、陛下の許可は下りていない。出過ぎた真似は許されぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（ガリア語）反逆者は皆処刑された。それだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "（ガリア語）なるほど。我々は会わなかった、そういうことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "フゥー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "……行ったか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スパイ",
      "text": "グレーシルクハット閣下、我々の観測によれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "君たちは何も観測などしていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "彼はこの地に足を踏み入れることができ、我々は未だ生きている。この事実そのものが、ヴィクトリアとウルサスの意思表明だ。今回の件は、公爵様にそのまま報告するだけでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "ウェズリー・ロートは罪を恐れて自害した。これで任務は終了だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スパイ",
      "text": "どうやら、ウルサス軍と皇帝の間で意見が割れているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "しかし我らが取る行動のいずれかが、合意の形成を促す可能性は十二分に存在している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルクハットの人物",
      "text": "まだ意見は固まっていないようだが、あの帝国も……いずれは決断を下すだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "左後方、車両三台、十五人以上。かなり長いことつけられてるが……ずいぶん慎重だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "今のところは、ただつけてきているだけだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "WにUターンでもさせればいいじゃない。もしかしたら向こうも恥ずかしがっているだけで、本当はロンディニウムのお土産片手に挨拶しに来たくてたまらないかもしれないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "土産？　それは奴らが手にしている、あの巨大なアーツのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "土産はさっきのでもう腹いっぱいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あの傭兵どもの動き、何か引っかかる。俺たちを狩るというよりも……どこかへ追い立てているようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "大方、俺たちにロンディニウムから離れてほしいんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "クールでお高く止まったマンフレッド将軍が、あんたの命を守るのにずいぶん必死みたいじゃない。ホントに義兄弟の仲じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "折角だし、ご厚意に甘えて、こんな危険なところからおさらばしたらどう？　カズデルのスラム街で、マンフレッドの言う通り、ガキどもに字でも教えるのがおすすめよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "で、結局あんたは、誰の手を借りて軍事委員会の牢屋から抜け出したわけ？　あたしがあんたを拾った時には、もう大手を振ってロンディニウムの城壁の外で散歩してたじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺の監房には、看守がしばらく留守にする時間があった。罠だとばかり思っていたが、今にして思えば、実際はもっとひどいものだったのかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "こんな回りくどいやり方で、何かを仕出かすようそそのかされるくらいなら……もっとシンプルに、命を狙われた方がマシだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "期待されている「何か」の内容が、全くはっきりしないならなおさらな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "だったら避けることにしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "W、もっとスピード出せる？　こんな未練がましい送別役とは、そろそろお別れの時間よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "こんなオンボロじゃ無理はできないわね。けど良い知らせよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "今、ちょうど地雷原に入ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "三十分前にあたしが埋めたやつだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "しっかり掴まってなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "全部の地雷を踏み抜いてるようにしか見えないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あははっ、あいつらの分はもっと残してあるわよ。保証するわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "前の林を抜けたら停車して、そこからは歩きましょう。車じゃ目立ちすぎるから、いずれまた追いつかれるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "地雷を設置した場所を全部覚えてくれているといいけど、W。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "三人ともまだ五体満足ね、何よりだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どう？　ちゃんと覚えてたでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "何個か爆発しちゃったけど……あれ、なんて言ったかしら？　「地殻変動」とかってやつのせいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "追手は来てないわね。うまく撒けたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "もっと情報がいるわ。なるべく早くロドスと合流すべきよ。アスカロンもドクターも、今はウィンダミアの軍艦にいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "いくつか……気がかりなことがあってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "何を見たんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ただの直感よ。見たものが問題なければないほど、ますます不安になるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "二人とも、あの「ドクター」には会ったことがあるな。今はロドスのドクターをやっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……最終的な結論はまだ出せないけど、ある意味で、あのドクターが「軟弱」になったことは確かね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ここで言う「軟弱」は、貶しているわけじゃない。けど、今の私たちに「軟弱なドクター」はあまり必要ないのかもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ふん、それ本気で言ってるの？　ロドスのオペレーター連中にだって突然チェルノボーグでのことを思い出して、あたしを裏切ってくる奴がいるかもしれないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "W、あなた本当に口で言うほど疑ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "さぁね。どっかのクソババアが、あいつらの大好きな「ドクター」のそばにあんまり近付けさせてくれないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "W。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前はこの戦場をずいぶん歩いて見てきたんだろう。どう思った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……あははっ。あたしなんて虫けらみたいに追い回されたりするだけで、まともに軍事行動も取れてないのよ。現代社会で一番おかしな包囲戦を、間近で眺めるので精一杯だったわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……ハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もうめちゃくちゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "事ここに至って、今この戦争の指揮を執ってる奴なんて本当にいるのかって考えることすらあるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "王庭の各軍団の間には、協力関係と呼べるものなんてそもそも存在しないわ。ましてや各地からヴィクトリアに押し寄せてきた、復讐しか頭にないような素人兵士の集団なんてなおさらね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけど黒幕はあのテレシスよ。だから、この混乱もただの周到な計画かもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あいつは今、戦略上のごたごたやら何やらなんて眼中にないのよ。ただ……舞台を整えてるだけなんだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "――そして時が来るのを待つ、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "何を待つつもりかは……あまり考えたくないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "何も考えずにドクターとケルシー医師のところへ行って、指令が下るのを当てにするわけにはいかない。俺たちはもう、バベルでさんざん苦渋をなめさせられた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "主導権はこちらで握らねばならん。一つ、情報源があるんだが……俺たちの身分の方が、接触するのに都合が良いかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "どんな身分よ？　哀れな虫けらかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "まあ大した違いはない。サルカズだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうだ、一応聞いておこう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前たちは、リッチを殺す方法について何か聞いたことはあるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
