{
  "server": "jp",
  "storyId": "story_hsguma_set_1_story_1",
  "groupId": "story_hsguma_set_1",
  "stageId": null,
  "title": "決断の後",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_hsguma_1_1.txt",
  "sourceHash": "99718eaa3a51c033713f238dc1eb3c5949eba3b2883ea9b7383f9caabda78b0b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "董（ドン）、来たぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドン",
      "text": "おう、いつものか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ああ、麻辣ふたつと、咖喱（カレー）と清湯（チンタン）ひとつずつ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "やっぱりドンの鱗獣団子だよな――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "今なんて言った？　駆け出しの小僧が誰を呼び捨てにしてるんだ、「ドンさん」と呼べ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "つ、つい言っちゃっただけだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "間抜けのダートウなんて呼ばれてるからって、本当に間抜け晒してんじゃねぇぞ。言っていいかどうかの区別もつかねぇのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "セン、ずいぶん気が立ってるじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "ダートウの間抜けっぷりが気に入らなくてよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "だからなんだって言うんだ？　鬼の姉御が黙ってんのに、なんでお前がデカい態度取ってやがる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "シャン、いいって！　俺が間抜けなのはほんとだし、そんなことでケンカしないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "姉御からもなんか言ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "まったく、お前たちは、腹が空いてると碌なことを言わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン、ダートウに頭を下げろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "……わりぃ、カッとなっちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "シャン、お前はセンにだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "シャン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "嫌味を言って悪かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ほら、これでしまいだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セン＆シャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "他の話をしようよ。そうだ、おととい姉御が例の「缺一門（チュエイーメン）」をやっつけたけど、あいつの手下はどうなったんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "リンさんが何とかするだろうが、詳しく聞いてない。今後は大人しく生きるよう注意する程度だろうな。いずれにせよ、温情ある処置になると思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "そうなんですねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "あの、姉御。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "どうした、まだ何かあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "ちょっと聞いてみたいだけなんですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "こいつは間抜けなだけじゃなくて話すのも下手なんだよな。俺から言ってやるよ。姉御、今日俺たちは……あー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "お前らなあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "俺から言います。今日、姉御がこれからどうするかを打ち明けてくれたから、じゃあ今からパーっとやろうって話になったでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "もうこれが最後かもしれないんで、俺たちは知りたいんです。姉御は一体なんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "なんで、あっち側なんかに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドン",
      "text": "ほらよ、どいたどいた。鱗獣団子だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドン",
      "text": "サービスで大根を入れてある。ダウンタウンの害を処分してくれた礼だと思ってくれ。ホシグマさんの分には、特別に羽獣の手羽肉もつけておいたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "気をつかわせたな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャン＆セン＆ダートウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……はぁ。気がかりなことがあるのはわかる。だがお前たちは普段口が回るし、私に上手な機嫌の取り方を教えてやるとまで抜かしていただろう。何をいまさら口下手な振りをして押し黙ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャン＆セン＆ダートウ",
      "text": "……ドンさん、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドン",
      "text": "いいってことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドン",
      "text": "坊主どもがすぐに受け入れられなくても仕方ねえんじゃないか、ホシグマさん。いきなりあんな一大事を伝えられて、こいつらにとっちゃ青天の霹靂だったろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドン",
      "text": "ソースやらはそこに並べてっから自分で取りな。俺はデリバリーに行ってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "「あんな一大事」って言ってましたけど……さっき俺らが出てくる前に姉御が教えてくれたばっかりのことを、なんでドンさんがもう知ってるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "お前なぁ、このスジで何を学んできたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "ダートウ、ドンさんの片足が不自由な理由を知らねぇのか？　「あの人」の身代わりになったのは有名だろうが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "えっ、どの人？　リンさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "お前、そこまで間抜けなのかよ！　リンさんの名前なら「あの人」なんてわざわざ濁さねぇだろ。俺たちじゃ名前を出しちゃいけねぇお方だよ、これでわかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "それって、ウェイ――！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "フルネームで言わないでくれてありがとう、とでも言うべきか、ああ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "ごめんごめん、悪かったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "ドンさんとリンさんは昔からよく情報交換するくらい仲がよかったんだ。二人とも前はあの人のために働いてたんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "ああ、どうりで……最近、リンさんから姉御におっかない仕事ばっかり回ってくると思ってたんだよ。「羽翅伍（ユーチーウー）」、「喪門銭（サンメンチェン）」、今日は「缺一門」……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その瞬間、一行はまた静かになった。"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "ダートウ！　お前本当に碌なことを言わないな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "落ち着けって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "姉御、前に教えてくれましたよね。極東では一晩かけて通りの屋台を全部制覇するもんだって。皆そろそろ食べ終わりますし、別の店にも寄っていきませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もちろん。これからがいいところだからな。ここで解散なんてありえないだろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "やっぱ酒がないとっすねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "そりゃあもう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "お前は黙ってろ。というか今日はもう口を開くな。また場が白けたらたまったもんじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "全く、これだから間抜けのダートウは。ほっといたらとんでもねぇことになりそうだ。姉御、こいつ絶対まだ姉御のことフォルテだと思ってますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "流石にそんなことないって。姉御は極東から来た鬼だってことくらい、俺でも知ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "それから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "やっぱり知らないじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御は龍門に来てたった一年か二年の新参じゃねぇ。俺たちみたいな役立たずを率いる前は、あの両儀会にいたんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "両儀会？　あの極悪非道って噂の両儀会！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "それ以外ないだろ。姉御は両儀会に所属こそしてたが、行動も交友関係も真っ当だったから、かなりの人に支持されてた。そんで、リンさんもその頃に姉御を見出した。これで合ってますよね、姉御？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "すまないが、過去の栄光は語らない主義でな。あの頃私が尖りすぎていたせいで、両儀会は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御のせいじゃないですって！　リンさんが姉御の手を借りただけじゃないですか。姉御がいなくても、どのみちリンさんは別の人を使ってたんですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "むしろ姉御がいてくれたおかげで、両儀会の半数は酷い目に遭わずに済んだんです。その証拠に、この件で姉御を悪く言うスジの人はいないじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "俺は、姉御のことで怒ってるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "あの時、リンさんが姉御を使って、両儀会と八卦幇を収めたことがあったでしょう。それで掟が決まったとまでは言えないですけど、少なくともその後龍門で大きな派閥はできてません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "でもここ数年、残党どもがまた再起を図り始めた。それでリンさんはまた姉御を使ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "その結果は……くっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "ああもう、この話は終わりだ！　もっと飲むぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バーテンダーの声",
      "text": "えっ、何してるんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バーテンダーの声",
      "text": "鬼の姉御！　この人――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バーテンダーの声",
      "text": "うわぁっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な声",
      "text": "チクろうってのか、李宝発（リー・バオファー）。よほど死にたいんだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ホシグマはがばっと身を起こした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "おい、ファー！　大丈夫か！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "地味なバーテンダー",
      "text": "ケホッ……大丈夫です。姉御の前じゃ、あいつも下手なことをできないですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "名乗れ。後で探す時に面倒だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "俺がどこの誰かなんて、お前にはどうだっていいだろ。お前がデカいヤマを片付けたって聞いて、祝いに来てやっただけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男がビール瓶をテーブルに叩きつけると、ガシャンという音とともに底が砕け散った。瓶の割れ口の先端が、照明を反射してギラリと禍々しい光を放っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "その割れたビール瓶で、か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "ただのビール瓶じゃない。この中身を見くびるなよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男はビール瓶に手を入れ、巻かれた手紙を取り出した。男の手は割れたガラスで傷つき血まみれになっている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる観光客",
      "text": "は、早く警察を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "おい、サツとか言ったのはどいつだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる観光客",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "お前か。さっきの訛りからして、龍門の奴じゃなさそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "知らないなら教えてやるが、サツはこのダウンタウンに手出しできない。通報でもなんでもしてみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "つまり、サツが来ても奴らは何もできないってわけだ。その時、無駄足踏んだ連中はどうやって気を晴らすと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる観光客",
      "text": "そ、そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "次に旅行する時はちゃんと下調べして、こんなスラムに遊びに来ないことだな。わかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "失せろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "観光客は逃げるように店から飛び出していった。\n凶暴な男は再びホシグマたちの方を向いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "「鬼の姉御」、話を戻そうか。今日からあんたは龍門裏社会の共通の敵だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "姉御が殺した奴らは、どいつも弱い者いじめばかりして、お前らと対立してたヤクザのリーダーばかりだったはずだぞ。姉御にはむしろ感謝しろってんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "それが誰の指示だったか、俺たちが知らないとでも思ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "リンのジジイが「缺一門」を殺せと言えば、「鬼の姉御」はそいつを抹殺する。もしその標的が俺たちの兄貴になったら、俺たちはどうしようもないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "お立会いの皆、カタギの方々はどうか証人になってくれ。裏の奴はよく覚えておけ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "こいつは永遠に、俺たち龍門ダウンタウンの裏切り者だってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "デタラメ言うな！　姉御が誰を裏切ったって言うんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "そいつは、龍門近衛局の誘いを受けてサツになるって話だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "人を殺す時にも眉ひとつ動かさん悪鬼が、裏社会の大物を何人も片付け、サツに入るための足掛かりにした……そういうことだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "こいつ、デタラメを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "デタラメだと？　ならなんで本人は黙ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "さっきから全員気落ちしてただろ。お前ら三人とも「鬼の姉御」がなんでサツなんかになるかわかってないってことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "お前らに裏社会で食ってく気があるなら、さっさとその悪鬼と縁を切っとけよ。確かに俺たちはそいつに勝てないが、そいつも二十四時間ずっとお前らを見てられるわけじゃないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "俺たちと姉御の仲を引き裂こうったって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "頼金森（ライ・ジンセン）、お前のお袋はまだ元気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "なっ！？　お前――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "若いのをいたぶるのはやめろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "お前一人が責任を取るってか、さすが「鬼の姉御」は仁義がわかってるな。たがお前の握ってる刀から仁義が駄々漏れなのを見て、リンのジジイはどう思うだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……リンさんは関係ない。これは私個人のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ここにいる全員に告げる。この三人と、その身内に理由もなく手を出す奴がいたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私と般若が、地の果てまで追いかけて、擦り潰してやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "……けっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "凶暴な男",
      "text": "ともかく、伝言は伝えた。俺の役目はここまでだ。じゃあな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "地味なバーテンダー",
      "text": "姉御、あんな奴の言葉に耳を貸さないでください。ほら、何か飲みませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ファー、お前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いや、会計を頼む。これ以上お前に迷惑はかけられない。別のところで飲んでこよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "まさかダウンタウンじゅうの店が、俺たちを入店拒否してくるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "まあいいだろ、コンビニで酒は買ったし、もう邪魔してくる奴もいない。どこにいたって酒は飲めるんだから、風通しのいい所でも探して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "風にあたるなら、近衛局のビルの屋上が一番でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "おいダートウ、ふざけたこと言うな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "いや、言わなきゃいけないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "姉御に近衛局のサツになれだなんて、リンさんは一体どうしちまったんだよ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャン＆セン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "さっきのビール瓶のクソ野郎が言ってたことはムカつくけど……俺はほんとにわからないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "二人はわかるのか？　姉御はわかるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "俺は間抜けだけど、みんなは賢いんだから教えてくれよ。リンの爺さんも、ウェイ……も、一体なんのつもりなんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "最初から言っているだろう、私が自分からウェイさんの誘いに乗ると決めたと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "そりゃ乗るしかないですって！　姉御、俺は嫌味じゃなくて本気で言ってるんです。面と向かって誘われたから、姉御には乗らないなんて選択肢がなかったんですよね！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "さっきので、俺でもわかりましたよ。姉御は裏の連中にとっても目の上のたんこぶになっちまったんだって。あいつらは何がなんでも姉御を排除しようとするでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "こんな時にリンの爺さんは何をやってるんだ？　姉御を守ってくれるんじゃないのかよ！　なのに姉御にサツになれだなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "もし断ったら、姉御はこれから龍門にいられなくなっちまうんですよね？　だったらもう受け入れるしかないじゃないですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "姉御、サツどもが俺たちにどんな仕打ちをしてきたか、忘れてないですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "あいつらにとっては、俺たちは人間ですらないんです。あいつらは俺たちを人間扱いしないし、俺たちを見下すことしか頭にない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "姉御、正直俺にもわからないです。裏の水にどっぷり浸かった人間が近衛局に入ったって、ろくな目に遭わないんじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "俺から見れば、リンの爺さ……リンさんは裏の残った派閥を手懐けて、自分の側に引き入れるために、姉御を近衛局に押し込めて笑いものにしようって考えにしか見えないんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "シャンがそう言うや否や、センがすっと立ち上がった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン、何をする気だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "別に何もしませんよ。近衛局に行ってくるだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もう夜も遅い。近衛局は閉まっているだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "知りませんよ。正門が開いてないなら、壁伝いに屋上までよじ登ってやります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "いつも俺たちを見下して威張りやがって、クソったれなサツめ。今晩は俺たちが見下してやりましょうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三人は酒瓶を提げて、近衛局の方へと歩き始めた。\nホシグマは彼らを止めることもできたが、一歩遅れてしまった。\nあるいは、本気で自分を心配してくれる者を止められるほど、確固とした気持ちは持っていなかったのかもしれない。\n……彼らは、「鬼の姉御」が出ていったら自分たちがどうなるかなど、一切気にしていなかった。むしろ彼女が近衛局に入って、厳しい境遇に置かれないかと心配していたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "はあ……はあ……入れた……って言っていいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "屋上は何かで塞がれてたから、最上階の倉庫から入るしかなかったけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "まさか近衛局の屋上が、こんなにボロボロでゴチャゴチャしてるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "姉御は……こんな風に俺たちと一緒に来て、大丈夫なんですか？　もうすぐここに入職するんだし、もし姉御が俺たちと暴れにきたって上司にバレたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "気にするな。たとえ空が降ってこようと、私の上背と角で穴を開けてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "ははっ！　あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "はは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "姉御、俺は怖いんです。姉御みたいな人でも、近衛局でそれなりの期間働いたら、あいつらに屈しちゃうんじゃないかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御なら大丈夫だって。もしそんな日が来ても、また俺たちのところに来てくれたらいい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう言って、センはぐいっと酒を流し込む。"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御がいない間、まずは俺たちだけで持ちこたえよう。姉御があいつらにアゴで使われるのに耐えられるとは思えないしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "やめておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "……姉御？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私を近衛局に誘ったのは、リンさんではなくウェイさんだ。長官のあの人が、リンさんの尻拭いに動く道理はないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "さっきドンさんとリンさんがあの人の側近だって言ったばかりじゃないですか。それって俺たちの関係でたとえたら、俺がやらかした時に姉御がカバーしてくれる、みたいな話じゃないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はぁ、お前な……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "これを見てみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "さっきの奴がビール瓶から出した紙切れ……これがどうかしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "署名を見てみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "銅槳幇（トンジャンパン）、鉄錨幇（ティエマオパン）、聯興会（リェンシンフイ）……豉油幇（チーヨウパン）、白灼幇（バイジュオパン）……叉焼幇（チャーシューパン）？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "「叉焼幇」なんて、変な名前だなぁ……俺の地元だと「あんたを生むより叉焼の塊を生んだ方がマシだった」って母親から叱られるんだけど、名付けた奴も同じことを言われてたのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "こういう変な名前のヤクザは、新興のところばかりだ。リンさんが目を光らせているもとでは、もう「両儀」や「八卦」のような大それた言葉を使う勇気がないんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "だからこそ、今日も虚勢を張りにきたんだろう。本当にリンさんに構わず私たちに手を出せたなら、わざわざビール瓶で手を血まみれにする演出なんて必要なかったはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "龍門はよくなっていく。私はそう信じている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私が来た頃と比べても、龍門はいくらか変わった。これからもっとよくなるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "姉御、もしその通りになるなら、しばらく姉御は裏社会の奴らから隠れておいて、リンさんがあいつらを制圧してから帰ってくればいいだけの話じゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "姉御が極東でサツだったから、どうしてもその経験を近衛局で生かしてほしいってことなんですかね？　だったら納得ですけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いや、私は極東で警察はしていない……向こうでは、龍門よりずっとたちの悪いことをやってきた。でなければ、故郷を離れて龍門まで来たりしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "はあ……でもあいつらは、龍門でも姉御を自由にさせてくれないみたいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "最上階の倉庫の空気は「叉焼幇」という間抜けな名前でいくらか和らいでいたが、ふたたび冷たい沈黙が流れた。\n三人は各々酒瓶を注いでいき、その度に目元を赤くしていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "どうせ龍門がよくなったって、俺たちだけは取り残されるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御は、昔きっと極東で悲しいことがあったんですよね。でも姉御が何も言わないなら、俺も詳しくは聞きません。龍門の話だけにしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御がせっかく両儀会でうまくやってたのに、リンの爺さんめ。両儀会を潰して、姉御を一人にしやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "それから一人になった姉御は、俺たちと出会って、助けてくれた。おかげで俺たちはいくらかまともな生活を送ることができた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御には、俺たちのことを本当の家族だと思ってほしかったんですよ。それで、人の上に立って名を馳せてほしかった。姉御にはその力もあれば、その資格もあるんですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "なのに今となっては、姉御は無理やり頭を押さえつけられて、サツなんかに頭を下げさせられてるんです……あいつらにこんなことする権利なんてないのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御はさっき、龍門がよくなっていくと信じてるって言ってましたね。でも、本当にそう信じてるんですか？　それとも、ただ信じたいってだけですか？　もし信じたいだけってなら、俺……俺……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御、もしサツになるなら、まず俺を殺してからにしてください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "センは大股で屋上への扉に向かい、鍵の緩んだ扉に思い切り体当たりして強引にこじ開けた。夜の冷たい風が倉庫に入り込み、むせるようなカビの臭いが巻き上がる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン、飲み過ぎだ。降りて家に帰ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "家ですか？　確かに俺はまだ、うちの爺さんに頭を下げたら家に帰れますよ。でも姉御は？　体制側の奴らを本当に信じるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "あいつらを信じちゃだめです。体制側の奴らは、俺たちを物扱いして駒みたいに動かすだけですから！　奴らの眼中に俺たちがいたことなんて一度もありませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン、本当に信じているのか、信じたいだけなのか、と聞いたな。お前の言った通り、龍門が本当に良くなっていくかどうかなど、私にもわからない。それでも私は絶対に信じないといけないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "どうしてですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私たちが初めて出会った時、私はお前たちに対して「誰かの撒いた罠かもしれない」「誰かに買収された刺客かもしれない」と疑ってかからなければいけなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私は元の居場所を自分の手で壊して、やむを得ず龍門にやってきた鬼だ。最初はこの地に馴染めるなんて思っていなくて、ただ一人で過ごしたいとだけ考えていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そんな時、両儀会の仁義溢れる兄弟たちが私を助けてくれた。ビルの間を通り、街のあちこちに私を連れて行って、叉焼、滷水料理、カレー味の鱗獣団子なんかを食べさせてくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私は龍門方言が上手く話せなかったが、お前たちは何度も練習に付き合ってくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "リンさんだって、私を後ろから刺すような真似は一度もしたことがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私は、リンさんを信じなければならないんだ。さもないと……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "センは身震いした。ホシグマが呑み込んだ最後の言葉を理解したからだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "じゃあ、賭けをしましょう。姉御が近衛局に半年もいられないほうに俺は賭けます。半年後には離職して、二度と近衛局に戻らないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "その賭けに乗るつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "怖いんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私はもう賭けているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "ああ、そうですね。龍門の都市が姉御を裏切らないってほうに賭けたんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "ですが、賭けに負けたらどんな恐ろしいことになるか、俺にはわかります。俺はそんな姉御の姿を見るのが怖いんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御は本来恐れ知らずの性格で、最近は俺たちから口の上手さも習いました……だからこそ、誰かに後ろから刺されて、うろたえる姿なんて見たくないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "たとえこの命と引き換えにしてでも、姉御があの脳味噌まで腐った奴らと賭けるのは阻止しないといけないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御、俺はわからず屋なんです。許してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン、馬鹿な真似はするな――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "センは一歩、二歩と下がり、ついに踵が地面から離れた。\nそこからどうすればいいのか、彼自身もわかっていない。\nだから酒の勢いを借りて、思い切り後ろに倒れた――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その瞬間、誰かに襟元をぐっと掴まれ、力強く引っ叩かれた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン、何をやっている！？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ふわりとした瞬間にほとんど飛んでしまった酒の勢いが、今度こそ完全に消えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御、俺は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もう何も言うな、降りるぞ！　今日はお前たち三人全員が帰るまで目を離さないからな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "身分証、ノート、記入表、登録用の顔写真……全部持ったな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "鬼の姉御――じゃなかった、ホシグマ警官！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "セン！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "何しに来たんだ？　まさかまた屋上に行こうとでも――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "姉御、何言ってんですか。昨日は飲みすぎて色々言っちまいましたけど、あとから考えたら確かに俺が間違ってましたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "では何しに来たんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "推薦入職のホシグマさんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "後ろの方々は？　彼らも入職されるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いえ、彼らは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "長官！　俺たちは今日ホシグマさんがとっ捕まえたヤクザの一味です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "ホシグマ警官は、一発で俺たち三人を殴り倒したんです。出勤初日からゴロツキを三人も捕まえるなんて、とんでもない腕ですよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ダートウ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャン",
      "text": "（小声）おい、この間抜けが！　そんな風に手柄を讃える奴がいるか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "はぁ……三人とも、どこかに行きなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "俺たちは本当にヤクザなんです！　それに金も持ってるので、俺たちを捕まえたら、近衛局の収入にも手柄にもなりますし――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "法律を執行する時には規律を守るように、とウェイ長官が現場を整えたばかりなんだぞ。そんな時にお前たちときたら、わざわざ喧嘩を売りに来たのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "そういうことです。ほら、頭を一発殴っちゃってください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "頭を一発殴れだと？　何を言って……わかった、私を嵌めようという算段か。私が殴れば、お前は近衛局に訴えを出して、私をクビにできる。そのつもりだな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダートウ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "確かに、三人ともろくなこと考えていなさそうだ。ならホシグマさん、提案があります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "「この三人組が嫌がらせで付きまとってくる。」と一言おっしゃってください。そうすれば、私はこの三人を法に則り逮捕して、何日か留置所に入れて反省を促すことができます。いかがでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その言葉を聞いて、シャンとダートウは一目散に逃げ出した。\nセンも身を翻したが、逃げ出そうとする寸前にホシグマのほうを振り返った。\nホシグマもセンを見つめ返した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "今なら、私が賭けに勝てると思えるか？　それともまだ負けると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "わかりません。でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "少なくとも、姉御が勝てるんじゃないかって期待はできそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ありがとう、信じてくれたんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "だけど……その、もしもの話なんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セン",
      "text": "もし負けちまったら、俺たちのことを思い出してください。姉御が帰ってくるのをずっと待ってますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……覚えておこう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "近衛局の門の装飾は素朴だったが、それでもどこか目に障った。それを眺めながら、センは涙が溢れそうになった。\n彼はそれ以上門を見ていられず、目元をごしごし拭うと、ホシグマに向かって軽く頭を下げた。そして兄弟も同然の二人とともに、ダウンタウンへと走っていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "まったく妙なチンピラどもでしたね。あなたに近づこうとしてたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ああいうろくでなしのチンピラを相手する時は、容赦なく――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "兄弟です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "なら君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "こいつらの兄弟です。これまでも、これからも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
