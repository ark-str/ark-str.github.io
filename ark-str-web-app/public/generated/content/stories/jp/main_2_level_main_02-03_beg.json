{
  "server": "jp",
  "storyId": "main_2_level_main_02-03_beg",
  "groupId": "main_2",
  "stageId": "main_02-03",
  "title": "推定無罪",
  "storyCode": "2-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_02-03_beg.txt",
  "sourceHash": "ad61ac4ab499332618eee837661cee6b423d7e736717eb16cb1ba1b044c40a71",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "早く隠れて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は……もう行かなくちゃいけないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……このお人形さん、君たちにあげるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "実はこれ、お守りなんだ。お母さんから作り方を教えてもらったんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今あげたのは、私の手作りでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "大事な人を守ってくれますように、って願いを込めてあるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "子供たち",
      "text": "そうなんだ……ありがとう、ミーシャお姉ちゃん！　大事にするからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "ふふ、おりこうさんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "さあ、それじゃ隠れてて！　声を出しちゃダメだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "子供たち",
      "text": "うんっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "チッ！　あの感染者め、どこへ行った……！？　おいお前ら、探してこい！　奴はまだ近くにいるはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "……んん？　こっちは……まだなんかありそうじゃねえか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うう～ん……龍門の地形は本当に複雑ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ペンギン急便の助けを借りられなければ、もっと苦労していた気がします……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "エクシアさんの情報によると、今回の調査対象はこの辺りにいたようなんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……おや？　向こうに誰かいますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　もしかして、あの人たち……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "やめろってば、このくそ野郎！　は～な～せ～！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "うるせえ、だったらさっさと吐け！　奴はどこへ逃げやがった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "いつまでも知らんぷりが通用するとは思うなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "くっ、うう……！　お姉ちゃん……龍のお姉ちゃん、どこにいるの……！？　お願い、助けて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "――ミーシャお姉ちゃん、どこに行っちゃったの……！？　ねえ、助けて！　助けてよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "っ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "ああ？　なんだお前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "そこから動くんじゃねえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……警告します。今すぐ、この場から立ち去ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "はあ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "お前、見ねえ顔だな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "一体どっから来やがった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "どこのどいつか知らねえが、お前なんざちっとも――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――聞く耳を持てないというのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "あぁ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "――っう、ぐあっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "な、何だ！？　何が起きた……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "あ……アーツだ……！　アーツを使いやがったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "う、うわああっ！　く、くく、来るなっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……二度と、弱い者いじめはしないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暴徒",
      "text": "ひ、っ……！　ば、化け物！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……化け物……ですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……さあ、もう出てきても大丈夫ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ただ、この辺りは危ないですから、もっと安全な場所に避難してくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供たち",
      "text": "うん！　ありがとう、ウサギのお姉ちゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ええ。どうか気をつけて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "お疲れ様、アーミヤ。状況はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "実は先ほど、未登録と思われる感染者を見かけたところで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "へえ。ウルサス人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。ウルサス人の女の子でした。スラム街の奥へ向かったようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "フランカさん、この近辺で捜索に当たっているオペレーターを集めてもらえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "OK、任せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それにしても、スラム街を進めば進むほど、周囲の状況が複雑化していきますね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "一般市民だけでなく、犯罪者や身元不明の難民たちもいるようですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "よりいっそう、準備を整えておく必要がありそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――お話中すみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "通信が入りましたので、応答します。少々お待ちいただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――もしもし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ええ、お疲れ様です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……アーミヤさん、近衛局からです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もしかして、チェン隊長ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "はい。……と、すみません、通信中ですので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――ええ、未登録の感染者を何名か確認したところで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――そうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――なるほど、詳細をお伺いできますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――白い髪をした、ウルサス人の少女……ですね。身長は145cm前後、と。名前は……「ミーシャ」でよろしいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……？　何の連絡でしょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――承知しました。失礼、一度報告をしてきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "アーミヤさん。チェン隊長から、感染者捜索の依頼が来ました。白い髪をしたウルサス人の少女だそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "見つけ次第、近衛局に連絡してほしいとのことで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "直接お話ししたいので、通信機を貸して頂けますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――もしもし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "チェン隊長、聞こえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ、聞こえている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "本件の捜索目的を伺いたいのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "説明する必要はない。すぐに取りかかってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……了解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……あっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "通信、切られてしまいました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ほ～んと、やりにくい相手よねえ。あの隊長さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あはは……何はともあれ、捜索に取りかかりましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "その前に……立て続けにすみません、アーミヤさん。実は、重装オペレーターたちからも連絡が入っているんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "曰く、こちらに対して攻撃的な人々と遭遇した、とのことでして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "しかも、その人たちは……感染者だそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……わかりました。重装オペレーターのみなさんには、私たちのいるエリアまで撤退してくるように、と伝えてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それから、偵察部隊のみなさんは、隠密を基本とし、安全を保った上で、感染者の捜索をお願いします。対象は白い髪をしたウルサス人の女の子で、身長は145cm前後とのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "最後に、そのほかのオペレーターは、それぞれの隊長のあとに続いて散開してください。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "囮作戦か。悪くない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "これは……相手をおびき出すつもりか？",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我々は待ち伏せ要員ということかな、フランカ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フランカ",
          "text": "へぇ～……わかってるじゃない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フランカ",
          "text": "リスカム、今の聞いてた？　この人、かなり頭が切れるみたいよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "リスカム",
          "text": "……Dr.{@nickname}はわたしたちの指揮官なんだから、失礼なこと言わないの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――では、行きましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……それにしても、ロドスを狙ってくる感染者……ですか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
