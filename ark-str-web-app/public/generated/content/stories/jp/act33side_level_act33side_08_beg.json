  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act33side/level_act33side_08_beg.txt",
  "sourceHash": "8d9ecace223a22b31ffef457f745fe632531c6af3651a2b280bbfd49f0a577a4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "1094年春\nカズデル地区　バベルロドス本艦"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "アスカロン、来ると思ってたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……残ったのも私くらいなものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "ここ数年で、少しは話の合う顔見知りはお前だけになっちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "今回、お前の任務は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "ロンディニウムに向かう。知ってんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "正直、少し不安なんだ。潜入任務はこれが初めてじゃないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "カズデル地区を離れるのは、実はこれが初めてなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "アスカロン、お前は何ヶ月か各地を渡り歩いた経験があるんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "ヴィクトリアに行くのとそれとでは話が違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "お前の任務はテレシスの傭兵隊に潜伏し、機を見計らって反乱を起こすことだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "……テレシスを殺せば本当に問題が解決するのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "しない。軍事委員会は、もはや強大な個に依存する組織ではない。それがテレシスの目指す軍事委員会の在り方というものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "つまりお前たちの任務における実際の目的は、動乱を起こした後、ヴィクトリアの公爵の疑念を煽り立てて、連中の刃でもって軍事委員会を滅することだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "ロンディニウムがヴィクトリアの内地である以上、奴らに逃げ場はない。あの場所は軍事委員会の破滅の場となるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "そうすれば、お前たちにナハツェーラーの王庭を叩きのめす機会が巡ってきて、カズデルを占領できるって寸法なんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "だが、ジュリー、お前は恐らく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "あーみなまで言うな！　わかってるさ。潜入の経験はあるけど、テレシスとヴィクトリア人を同時に騙すとなると……フェリーンだってほとんど見たことないあたしじゃ厳しいかもな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "だけど、わざわざヴィクトリア語の練習までしたんだぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……そんな話をしてるんじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "まあいい、これを渡しておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "……これは？　あたしの古い服か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "裏地にあたしの名前が縫われてる……殿下がやってくれたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "ああ。殿下は元々直接お前に渡そうとしていた。だがお前たちを会わせたくなかったのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "私は……殿下につらい思いをさせたくないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "この言葉の意味はわかるはずだ。この計画においては、誰もが捨て駒も同然なのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "殿下はそのことをよくわかっている。だから、お前たち一人ひとりを見送りたいと思っていたようだが……そんなことをすれば夜も眠れなくなってしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "だから殿下には、お前たちは予定より早く出発したと嘘を教えた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "すまない、ジュリー。お前の殿下に会いたいという気持ちを蔑ろにしてしまったかもしれない。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ジュリーは答えない。綿と麻で刺繍された名前を無言でさすり、指先で粗い質感を感じとる。\n「ジュリー」。\n彼女は殿下が自分に授業をしてくれた時の様子を思い出した。\n彼女は、授業を受けるよりも人を殺す方が慣れていた。授業中は何も理解できずよく居眠りしていたが、心の内の声は、殿下は正しいことしか言わないと彼女に告げていた。\nだから、彼女は質問をしたことがなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "……最後に殿下に会いたくない奴なんていないよ。だが、お前の見送りも悪くない。ここ数年、お前からも色々と学ばせてもらったしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "あっ、もしかしてお前、この任務は自分の方が適任だとでも思ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "いいや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "実は会議でお前の名前も上がったんだぜ。だけど、満場一致でお前はカズデルに残って殿下のそばにいるべきだってなってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "あたしに至っては元々身寄りなんてないから、いの一番に名乗り上げて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……Scoutの隊に加わることもできただろう。以前、その申請をしていたと記憶しているが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "それは……あの英雄から学べるもんを学んで、お前に勝ちたかったからだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "戦い方が大きく違うわけじゃないのに、お前にほとんど勝てないまま行くことになっちまうなんて、どうにも気が済まなくてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "フンッ。出発が迫ってなけりゃ、お前にこんなこと打ち明けたくなんてなかったけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "ほかに……何か言っておきたいことはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "ない。まさか故郷を離れるのがこれで最初で最後になるとはな。それに、魔王のそばでむすっとしてる暗殺者のリーダーが最後の見送りに来るだなんて思いもしなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "アスカロン、正直に答えてくれ。嘘はなしだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "外の大地はどんなだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アスカロンは答えない。ジュリーも彼女の口から答えを得ようとは思っていないようだ。\nジュリーはただゆっくりと身を起こし、立ち去っていった。\n悠々とした背は、まるでただ上物の酒を取りに向かっているだけであるかのようだ。\nアスカロンはそのまま彼女の背を――その背中が小さくなっていくのを見つめていた。\nふと、ジュリーが見知らぬ人物であるかのように感じる。影や、もう一人の自分と同じように、遠くに感じられたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三ヶ月後\nヴィクトリア　ロンディニウム郊外の村"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "出てこい、隠れても無駄だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "町で情報は仕入れてある。カズデルに向かって悪さしようって部隊がいるらしいが、お前らだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "この村の出口はあたしらが全部塞いでる。強行突破は諦めろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "おい、捕らえたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "そんな全身傷だらけじゃ、ちょっとイカつい一般人にも敵わないんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は嫌そうに刀身を振り、そこに付いた血を払った。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "仲間が助けに来るのを待とうってか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の刺客",
      "text": "……ほかの連中は全員死んだのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "皆殺しにした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "仲間が全滅したって聞かされて、なにホッとした顔してんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の刺客",
      "text": "死はある種の解脱だ……同胞よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "お前たちは一体何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の刺客",
      "text": "どうでもいいことだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謎の刺客",
      "text": "ぐっ……うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の刺客",
      "text": "見事だ。ごほっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は自分の剣に倒れた刺客が安らぎを得たように大笑いするのを聞いた。\n地面に横たわる刺客が呼吸を止めるのを待って、ジュリーはようやく刺客のマスクをはがした。\nその顔を見て、ジュリーは呆然とする。彼女は思索を巡らせ、なんとかサルカズの目元のひどく損傷した痣からその身元を推測した。\n彼の肖像画はかつてスカーモールの逸話図録に収められていた。\n彼には多くの呼び名があったが、本当の名を知る者はいない。彼は傭兵たちが噂や冗談を言う際の酒のつまみになるほど、あまりにも長い歳月活躍してきた人物だった。\nだが今となっては、彼の血と身分を象徴する二つの角は根元から切り落とされ、切っ先が彼の頭に永遠の傷痕を残していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "顔を覆い隠した死士の連中は……みんなお前みたいに自傷行為が好きなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "こうまでしないと殿下を暗殺する勇気が湧いてこないってか？　それは「魔王」に刃を向けるのが怖えのか、「六英雄」に刀を振り上げるのにビビってんのか、どっちだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "……だがもういい。お前たちはテレジア殿下に接したことがないから、そんなことをしてるんだろうしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "安心して死ね。お前たちの顔は火で潰しといてやる。臭い炭にはなるだろうが、罪人として記憶されるよりマシだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "カズデルにもう帰れないお前たちに、あたしがしてやれるのはこれくらいだ……あたしたちは似たもの同士かもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "ハッ、こっちももう帰れないんでね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジュリーは仲間と共に刺客の死体を積み上げて火をつけた後、ロンディニウムの方へと向かっていった。\n炎が背後でパチパチと音を立てる。ジュリーはふと、カズデルの溶炉から聞こえる音とは違うと思った。\nあれはどんな音だっただろうか……小さい頃はいつも聞こえていたというのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジュリー",
      "text": "……もうすっかり忘れちまったな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "ケルシー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "精鋭戦力はすでにそれぞれ要所へと配置についた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "よし。各位、我々と軍事委員会の軍事力には確かに差がある。移動都市カズデルに対する包囲攻撃は、本来不可能な作戦であった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "しかし、テレシスはキャヴェンディッシュ公爵が突き付けた最後通牒に逆らうことはできず、予定を繰り上げてロンディニウムへと急行した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "現在のカズデルは軍事委員会の一部王庭メンバーのみで指揮している状態にある。言い換えれば、彼はこの都市を放棄したようなものだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "それにより、移動都市の人々と留守を預かる兵士には、間違いなく混乱がもたらされていることだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "軍事委員会の旗が降ろされたその瞬間――テレジア殿下は軍事委員会がカズデルを放棄したという事実、そしてバベルによるカズデルの解放を宣言する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "戦線は面ではなく点で展開する。正確に要所を叩き、速やかに終わらせる必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "兵力に差があるからこそ、今回の都市奪還計画ではバベルの号令に応えてくれるほぼすべての戦闘員を投入した。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "それゆえ、本艦の防御は相対的に薄くなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "そのため、テレジア殿下には本艦を守っていただく。また、本艦護衛に足る戦力も残してあり、その指揮は自分が執る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "各位がカズデルの門を押し開き、溶炉への安全なルートを確保した後に、殿下は迅速に主要作戦部隊と合流を図る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "奇襲の制限時間は六時間。それを超えてしまえば軍事委員会に反撃する機会を与えることとなり、脆弱なバベルは危険にさらされるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "夕日がカズデルにそびえる溶炉を照らす時、我らは炉と議事堂を占領し、ほどなくしてバベルの旗が月と共に揚がる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "その時――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "――停戦の宣言がカズデル全域に響き渡るだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "各位の成功を信じている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……ふぅ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "素晴らしい布陣だわ、ドクター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "だが今のは士気を高めるための聞こえのいい演説でしかない。歴戦の戦士やケルシーであればきっと気づいているだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "恐らくバベルの損失は甚大なものとなってしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "テレシスがこれほど大きな隙を見せるなんて、彼らしくないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "……だけどあなたを信じる。この代償を払えば、私たちはきっとカズデルを奪還できるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "テレシスはロンディニウムで喉から手が出るほど望んでいた力を奪い取るでしょう。もし私たちの推測通りに事が運べば、帝国を引き裂いた後、彼はその視線を必ずこの都市に戻すわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……この大地に二つのカズデルが共存する可能性はないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "あるかもしれないわね。けれど一つの力を二つに分けてしまえば、次の外敵の襲撃を防げなくなってしまうかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "それに、都市なら再建できるけど、サルカズが数千年もの間、本当の意味で成し遂げられていないのは団結することなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "軍事委員会でさえ、最後まで現存するすべての王庭を招集することは叶わなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "もしかしてあなたは、テレシスに王冠を掲げさせれば、何か変わるかもしれないと考えているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……そんなことはない。戦争に嫌気が差して、ただ腹を満たすことだけを求めて各地より集ったサルカズたちは、やはり団結して自分たちの「魔王」に抗うだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "「団結」とは、なんとシンプルでいて、想像の及ばない言葉だろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "……そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "ケルシーの大まかな計算だと、移動都市カズデルに住むサルカズの人口は、全テラのサルカズの三割から四割程度らしいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "恨みの下でなら効率的に団結することはできるけど、それは一時的なものにしかならない。平和の中で団結して初めて、発展と未来について語れるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "テレシスだって、それがまったくわからないわけではないし、サルカズのみんなもその道理を理解しているはず……それでも戦争は起きてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "ドクター……たとえカズデルを奪還しても、私たちの戦争はそう簡単には終わらないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "でも、今はこれで十分なのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "勝利の後、あなたにあの都市を案内させて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "あそこは私の家であり、多くのバベルの仲間たちの……そしてケルシーの家でもあるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "これだけ長くバベルのために戦ってくれたあなたが、一度も私たちの語る故郷に足を踏み入れたことがないなんて、なんだか私が意地悪をしているみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "魂の溶炉がカズデルにもたらす光と熱を見届けましょう。あの都市は苦痛の上に成り立っているけれど、私たちは平穏な明日を貪欲に望んでいるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カズデル地区　荒廃した町の外"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "オッダ、町の様子はどうだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オッダ",
      "text": "まだ残りの傭兵を追ってる！　奴らの残党はほとんど廃墟に逃げ込んじまったから、全員見つけ出すにはたぶん時間がかかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "あまり深追いはせず、時間に気を配れ。ドクターの言いつけを忘れるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "我々の目標は両翼を片づけた後、すぐに正面の戦線に合流することだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オッダ",
      "text": "わかってる。それにしても、ドクターが対応策を立ててくれててよかったよ。でなきゃ今頃奴らの待ち伏せにやられてたかもしれないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オッダ",
      "text": "でも……なんかおかしくないか？　この町は天災の通り道だっていうのに、傭兵たちはどうして危険を冒してまでここで待ち伏せてたんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "今調べているところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オッダ",
      "text": "連中のリーダーを見つけられたら、手がかりを得られるかもしれないよな？　もうちょっと追ってみるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "そうだな。気をつけろよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "天災。暴虐な気流がアスカロンを打ちつける。\n空の果てからかすかに聞こえた爆発音に、彼女はぼんやりとする。それは彼女に何かを伝えようとしているかのようだった――"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これが俺たちの歩む定めにある道だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……お前か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "久しぶりだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "随分と成長したじゃねぇか、アスカロン。どうやらここ数年、戦場で相当もまれてきたようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "お前たちはとうに奴について、今頃ロンディニウムで縮こまっているのかと思っていたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "摂政王につくだぁ？　ハハッ、大ハズレだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "傭兵ってのは「誰かにつく」ようなもんじゃねぇ。俺たちは利益にしかなびかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "そしてカズデルにおいて、利益を得られるのは暴力だけだ。俺たちはちょうどその匂いを敏感に嗅ぎ取ることができるのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "もちろん、俺は傭兵どものために受けた注文の見通しを「適切に」視る手伝いもしてやるがな。何せスカーモールは赤字の商売には決して手を出さねぇから――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アスカロンの仕込み刀がサイクロプスの背中に迫った時には、すでに男の手が彼女の攻撃を防いでいた。\n彼の手はまるで初めからそこにあり、全く位置を変えていないかのようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "もしも、奴がお前が出張ることで我々を止められるとでも考えているのなら、恐らく的外れだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "また大ハズレだ、アスカロン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "傭兵がここに現れたのは確かに摂政王の依頼だ。だがあいつらがどんな注文を受けようが、俺の知ったこっちゃねぇ。フッ、じゃあどうして俺はここにいると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "……お前に会いに来たんだよ。あいつらとは関係なくな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "――？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "（雑音）――うっ――アスカロンさん、町に――\n（雑音）――まだ伏兵が！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "オッダ？　オッダ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "行かせねぇぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "町に足を踏み入れたその瞬間、あいつらの運命は決まったんだ。お前じゃ救えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "前回、俺たちが会った時のことを覚えているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "今俺たちは、運命の交錯点に立ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "この場所で、俺は唐突に訪れる終わりを視た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "ずっと試してみたかったんだ。そうして視た終わりを動かせねぇもんかってな。運命の急流の中から、石を拾い上げ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "そんでそいつを好きな場所に置いて、本来運命には存在しなかったさざ波を急流の中に起こす――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "――サイクロプスは予言を操れるのかどうか、試してみたかったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "……どけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "さもなくば、死ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "奇襲は無意味だって、いつになったら覚えんだ。俺には「視える」んだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "テレシスからは多くのことを教わったが、はっきりと覚えているのはただ一つ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "大方の問題は力で解決できるということだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "「スカーアイ」……お前には虚無が視えるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "舞い上がる土煙に薄暮のような霧が混ざり、広がっていく。\n視界がぼやける。刺客の姿が霧の中で次第に輪郭を失っていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "運命だの予言だのと、お前の芸当はもう見飽きたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "お前は時間そのものよりも遠くを見通せるとうぬぼれ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "そして、視た運命を利用して利益をむさぼれると思い込んでいる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "だが所詮、お前は運命をもてあそぶことに取り憑かれた亡者にすぎない……「スカーアイ」。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アスカロンの声が消えた。サイクロプスの耳はただ風の音だけを捉え、その目には霧だけが映った。\n彼は不思議に思う。毎日目を醒ます度に、百ものバリエーションに富んだ自分の死を視ることができるというのに、この光景は……\n確かに見たことがなかった――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「パキリ」。\nマスクが砕ける音が聞こえた。\n彼は百年近くその両目をマスクの下に隠していた。両目で真実を捉える必要などなく、多くの人、多くの物事を、見るに値しないと考えていたのだ。\n暮光がついに砕けたマスクに注ぎ、興奮により開いた瞳孔にしみ込んだ時――"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "死は見えたか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "否。彼が視たのは断崖だった……\n交わった運命の急流は、この断崖から流れ落ちる。"
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "殺し合いを続ける前に、タダで予言を一つ聞かせてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「スカーアイ」",
      "text": "一つの、物語を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
