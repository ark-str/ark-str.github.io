{
  "server": "jp",
  "storyId": "main_11_level_main_11-02_end",
  "groupId": "main_11",
  "stageId": "main_11-02",
  "title": "一筋の光",
  "storyCode": "11-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_11-02_end.txt",
  "sourceHash": "96dc09816983fd116f3d4a83599bea6316c5d9385c60b91f401942722a2a84a8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "数時間後"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "ラルフ――ラルフ、どこへ行ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "なんてこと、こんな時に、あの子はどうしていなくなるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無邪気な子供",
      "text": "ラルフ、大人たちがよく言ってる大砲がどんなものかまだ見たことないって言ってたよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "なんてこと。まさか街に出たのではありませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "外では戦闘が起きています。至る所で矢や榴弾が飛び交っているんですよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私が探しに行きます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "ゴールディングさん、危険すぎます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "ラルフ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "あっ……えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "早くこちらへ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "うう、ゴールディング先生……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "怖がらないで、先生がそばにいます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "うわぁ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "学校に戻りましょう――戻れば平気です。きっと大丈夫ですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "ゴールディングさん、ラルフ！　無事だったんですね、よかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "ごめんなさい、モリー姉さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "ラルフ、とても心配したんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "子供たちはもうみんな戻っていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "はい、人数を確認しました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "さ、さっきのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……砲弾が近くに落ちたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "そんな？　一体誰と誰が戦っているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "どうして、午前中は何ともなかったのに……ロンディニウムはどうして突然こうなってしまったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "泣いてはいけませんよモリー。子供たちの前で泣いてはダメです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私の手を握って。少なくとも、私たちは一人じゃありません。みんな揃ってここにいるのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "わ……私たちには都市防衛軍がいます。それに蒸気騎士も！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "彼らがロンディニウムを、ヴィクトリアを守ってくれます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "蒸気騎士……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "さっき俺、見たよ！　黒くて、背が高くて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無邪気な子供",
      "text": "それって街灯の影じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "バカ言うなよ！　あれは絶対蒸気騎士だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "靴屋のトムがいつも言ってるぞ、あの人たちこそが、ヴィクトリアの偉大なる象徴だって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "「谷を駆け抜け、川を飛び越え、ドンドンドン、ドンドンドン、音の主はなんだ？　雷ではない、風でもない、それは偉大なる騎士、偉大なるヴィクトリア！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "その歌は私も小さい頃に聞いたことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "歌を教えてくれた先生が言っていました。毎年国王のお誕生日の時には、蒸気騎士が隊列の上を飛んで行くのを見ようと、人々が広場に押し寄せるんですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "蒸気騎士って本当に空を飛べるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "先生が言うには、彼らはただ移動するのがあまりにも速いだけなんですって。雷や風よりも速いうえに、噴射する蒸気のせいで、まるで雲を踏んでいるみたいだそうですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "そうなんだ。今は国王陛下がいないし、一回も閲兵式をやったことがないから、見れないのがすげぇ残念。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "それに先生が言ってたけど、先生の先生はもっとすごいのを見たことがあるんですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "ヴィクトリアが戦争でガリアに勝ってまもない頃、当時の国王陛下のお誕生日を祝うために、何十名もの蒸気騎士が全員ロンディニウムに戻ってきたらしいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "甲冑たちはヴィクトリアの旗を身にまとい、彼らが聖王会西部大広間の階段から足並みそろえて下りてくる光景は、まるで一つの巨大な旗が開いたみたいだったとか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "そして雷よりも響き渡る咆哮を全ての人に聞こえたんですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "咆哮？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "はい、咆哮です。その場にいた人は、我らの旗にあるヴィクトリアの象徴が生きているようだったと言ったらしいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "なぜならその日から、ヴィクトリアは正式にガリアを超えて、テラ大地で最も偉大なる国家になったんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "ごめんなさい、ゴールディングさん。あなたのおじいさんはガリア出身でしたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "謝る必要はありませんよモリー。私は君やラルフ、それにここで成長していった数多くの子供たちと同じように……ロンディニウムで育ったのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "外の蒸気甲冑の中にいる人も同じかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "text": "ゴールディング先生、蒸気騎士を知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……チャールズ・リンチ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "彼はオークタリッグ区に住んでいたことがあるのです。靴屋のトムは彼の昔からの友人で、だからトムはいつも国王や蒸気騎士の話をするのが好きなのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "チャールズ・リンチは、国王がご生前の時に選ばれた最後の蒸気騎士です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……そして、現存する最後の蒸気騎士でもあります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "翌日"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "何も変わってない……大公爵の軍はどこへ行ったのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "やっぱり、蒸気騎士が来てくれれば、きっと騒ぎをすぐ鎮めてくれるんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "ただまさかこんなに早いとは思いませんでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……モリー、どうにかして必需品を買い集めないといけません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "今後何が起こるかわからないですから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム市民",
      "text": "二人とも、どうして外に出てるんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "アダムスさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "ちょうどよかったです。子供たちにとって、知識も同様に欠くことはできませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……特に今のこの状況下では。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "アダムスさん、昨日預けた演劇集をいただいてもよろしいですか。それと、他の本もいくつか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "うーん、この童話数冊と、あの数学と物理に関する入門書数冊、それと『家庭医療マニュアル』、これ全部包んでもらえますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "待ってください、何の音でしょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "遠くからぴたりと打ち揃った足音が聞こえてくる。\nロンディニウム人がかつて閲兵式で聞いたものとは異なり、この足音はより重々しく、より生々しく迫るものだった。\n聖王会西部大広間。ザ・シャード。議会広場。\n一つまた一つ、集団が絶え間なくやってくる。彼らはオークタリッグ区の人気がほぼない通りを抜けて、ロンディニウムの中心へと、ヴィクトリアの心臓へと踏み込もうとしていた。\n足音がこの平凡極まりない通りに迫った時、道端に隠れていた人々が行進する集団をようやくはっきりと目視した――\nあるいは、兵士たちの姿をはっきりと目にしたと言うべきか。\n形状がそれぞれ異なる角は不吉な黒色に固まっており、瞬く間に白んでいく空でさえ、それを照らすことは叶わない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……サルカズ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "あれはサルカズの傭兵です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "傭兵なら、すぐにここから去りますよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モリー",
      "text": "そうなれば、ロンディニウムはまた元の姿に戻るはずです。そうですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
