{
  "server": "jp",
  "storyId": "story_kroos_set_1_story_1",
  "groupId": "story_kroos_set_1",
  "stageId": null,
  "title": "林檎",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_kroos_1_1.txt",
  "sourceHash": "42240c4e78b428aef657e1f4ec1cec0218bbf7d1b0713457ba7f564c37a86ae8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "とある休日の早朝\nロドス本艦"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "クルースが戻ってこない！　またサボりだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "あの……隊長？　怒らないでください。クルースちゃんも悪気があるわけじゃないと思いますから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "ん？　ああ、怒っているわけではないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "ただ――ちゃんと仕事をするように見張っているつもりなのに、どうしていつもこうなるのかと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "もう少し待ってみましょうよ。彼女はちょっと気分転換してるだけですよ。戻ってくるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "……そういえばクルースも、ビーグルがついてる時だけはサボらないよね。どうやってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "え？　わたしですか？　わたし、何もしてないですよ。ただ彼女が仕事してるのを見てるだけなんですけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "一人で仕事してるのって大変そうだなって最初は手伝い始めるんですけど、しばらくすると、手伝わせてくれなくなるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "それだけ？　せっかく手伝ってるのに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "はい……手伝ってるだけなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "さすがだよ、ビーグル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "私はなんでいつもクルースには騙されてしまうんだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "お腹が痛いとか、ドーベルマン教官に呼ばれてるとか……後から考えればわかるのに、どうして私はその場で信じてしまうんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "気付いた時には、もう遅い……とっくに捕まらないところに逃げられた後だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "……あ！　クルース！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "やっと見つけた！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "今日こそは逃がさないよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "ビーグル、向こうから回り込んでくれ。クルースを挟み込むよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "……は、はい！　わかりました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ハァ、ハァハァ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "クルース、待って！　私と当直に戻るんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（ちょっとくらい休んだっていいじゃないぃ～）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "待てって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（えっ、フェンちゃん、速くなってる！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（なんとかしないと。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様、次の曲はいかがいたしましょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "かしこまりました。ではレンズが音楽ライブラリの中を検索いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（あ！　シーンちゃんだ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（うーん……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（よ～し！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "やっほ～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "これはクルースお嬢様、ごきげんよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "シーンちゃんの隣、いいかなぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "え――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様の許可をいただきました。どうぞお掛けください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ありがと～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ふぅ～……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お疲れのようですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "クランタに追いかけられてるんだもん、そりゃ疲れるよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "見つけたぞ、クルース！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "あれは、フェンお嬢様ですね。どうかされましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "実は……フェンちゃんと、かくれんぼしてるのぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "でも探し合ってるうちに、競走になっちゃったんだぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "レンズ、助けてくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "それは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様が面白そうだと仰っています。レンズにクルースお嬢様の手助けをさせていただくように、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ありがと～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "ただし、フェンお嬢様にバレないという保証は致しかねます。ご了承ください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "そりゃそうだよねぇ。その時はおとなしく負けを認めるよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "かしこまりました。では微力ながらお手伝いさせていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "ビービー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "M.P.M1号",
      "text": "ジ――ジ――ジ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "M.P.M2号",
      "text": "ピンポン！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（この小さな子たち、ずっと傍にいたの？　気付かなかった……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "ビービー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "M.P.M1号",
      "text": "ジ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "M.P.M2号",
      "text": "ピンポンピンポン！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "クルースはさっき、この辺りに飛び込んだはず……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "どこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "本当にもう……こういうことだけ、どんどん上手くなっちゃって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "ふむ……少し落ち着いて考えてみよう。もし私がクルースならばどうするか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "ふむ……この辺りならば、きっと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "そこか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "あ、フェン隊長――クルースちゃんが食堂の方に向かうのを発見しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "よし、分かった！　今行く！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ふぅ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "どうやら捕まらずに済みました。これでよろしいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うん、ありがとう！　前に任務でシーンちゃんが隠れるのを見てたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "やっぱりすごいね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "レンズに使用されているのは、光の性質を応用した最新のステルス技術になります。お嬢様のご要望に応じて搭載されたものです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "申し訳ございません、お嬢様。曲を流すのを忘れておりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "こちらの曲ではいかがでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "はぁ――いいな～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "もう少し、ここで休んでてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様は喜んでらっしゃいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ところで、シーンちゃんは何をしてたのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様は次の作品の構想を練っていらっしゃいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "ただぼうっとしているように見えるかもしれませんが、こういう時のお嬢様は様々なことに思いを巡らせておられるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "このレンズは、お嬢様のために曲を流し、食べ物を運ぶ役割を負っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "仕事しなさーい！　ってシーンちゃんを追い回す人はいないのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "レンズの記録を確認いたしましたが――過去にそういった人物はいませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "もしいるとするならば、レンズがお嬢様のためにステルス技術を活用いたしますので、誰にも見つかることはございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "え～いいな～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "私もシーンちゃんみたいな生活したいなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様も似たようなことを仰っていたことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "確か「コータスみたいな生活ができればいいな」――と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "えぇ。コータスのどこがいいんだろぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "疲れるよ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "小さい頃から、お前はコータスなのに、なんでそんなに怠けてられるんだ？　って言われてきたんだよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "私は頭の中を空っぽにして、ソファの上で、一日中ずっとのんびりしてたいんだよねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "そういうのが好きだっていいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "クルースお嬢様には選択肢がある。それだけで幸せだよ、とお嬢様が仰っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "レンズを例にご説明いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "写真撮影においては一瞬が勝負となります。全ては刻一刻と変化しますから、切り取りたいと願う瞬間が訪れたとしても、それはまさに一瞬で消えてしまいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "その点、レンズはシステムの補助により、飛ぶように走るクランタだろうとベストの一枚を撮影することができます。けれど生身のお嬢様にはそれはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "人物を撮影しようという時、お嬢様は精密な絵画を描くように、とても長い時間を費やして最高の一瞬を切り取ろうとされます。ですが、それに耐えられる者は多くはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様が景色の撮影がお上手なのは、景色だけが好きだからではございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様は視界に入るものすべてを撮影したいとお考えです。ですが実際には辛抱強くそこにとどまり、お嬢様の時間に合わせることができるものだけが、お嬢様に撮影される栄誉を得られるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "これがお嬢様が実際には景色以外の対象を選ぶことができない、現実的な理由なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "クルースお嬢様は動くのを好まれないと仰いますが、実際に動き出したら、きっととても俊敏に動かれるでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "まあ、そうかな～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "レンズは、クルースお嬢様が参加された戦闘記録の編集をされる、カシャお嬢様のお手伝いをさせていただいたことがございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "指示された位置で待機され、命令があれば迅速に移動する。クルースお嬢様は普通のコータスと何ら変わりがありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "だって、それはちゃんとやらないと～。命がなくなったらいやだからだよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "任務は大変だよね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "ですがレンズの手助けがなければ、お嬢様は移動さえままならないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "「できない」と「したくない」、これらはまるで異なるものであるとレンズは認識いたします。クルースお嬢様は選ぶことができるのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "「できないことが多過ぎる。だから自分にできることは精いっぱいやりたい。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様はこのようにお考えです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "残念ながら、お嬢様にできることは少ないですし、簡単なことばかりではございますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "クルースお嬢様は恐らく、ご自身のことをきちんと把握なさっているのでしょう。必要なところ以外、なるべくエネルギーを使いたくはないのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "そう言われると、そうかもね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "どうやらレンズの判断は正しいようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ただ面倒くさがりなだけかもしれないよぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "レンズはクルースお嬢様を信頼いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "ジー、ジジ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "大変申し訳ありません、ここは環境条件がよろしくないようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "先ほどじ実行したカモフラージュプログラムの続行にひ必要な条件が変化したようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "どうかご確認確認認認認――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "レンズ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（そばのロボットも動かなくなっちゃった。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（これは、壊れたのかなぁ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "シーンちゃん、どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "も――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "なになに～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "お――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "う――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "当ててあげるね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うーん――メイヤーさんかなぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "ん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "りょうかーい、メイヤーさん探してくるね。シーンちゃんはここでレンズを見ててあげて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "すぐ戻るね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "じゃあ、あとで～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "だ――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "い――――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "フェン隊長！　本当にすみません、人違いでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "レオンハルトさんとクルースじゃ全然違うでしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "たしかに二人ともコータスではあるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "本当にすみません。焦って見間違えちゃいました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "大丈夫だよ……探し直そう。もし見つからなかったら、メテオさんかギターノさんに助力を頼もうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "クルース、今日こそは逃がさないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "今日はどうしたんですか？　クルースちゃんが他にも何かやらかしたとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "普段なら見逃してますよね？　何か今日は特別なような……やっぱり怒っていますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "別に怒ってはいないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "ただ、今日クルースは抜け出す時に私にこう言ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "今日は、私がみんなのリーダーになった記念日だから、私のためにプレゼントを買いに行きたいって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "それはいいことじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "戻ってこなかったけどね。ビーグルが宿舎に来た時にやっとサボるための口実だって気付いたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "今日は本当に記念日なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "それは本当……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "それは……クルースちゃんのやり過ぎですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "後でわたしも言って聞かせます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "あ、そうか。隊長、記念日おめでとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "あっ、う……うん、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "って、あれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "今のって、クルースちゃん？　違います？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "なんか自信なくなってきました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "いや、合ってるよ。あれはクルースだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "なんだか急いでるみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "行こう、あとを追うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "メイヤーの部屋兼「ラボ・ルトラ」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "とうちゃ～く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（あれ？　これって自動ドアだよね、なんで開かないんだろぉ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "メイヤーさーん、いる～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（あれ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（ドア、壊れてる？　調子が悪いだけかなぁ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "（このボタンかなぁ？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "メイヤーさーん、いる～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "お願いしたいことがあるんだけど、いいかな～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "メイ……ケホッ、ケホケホッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "どうしたの？　私に用？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "わぁ、サーキュレーター回してたのに、まだこんなに臭気が充満してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "今、塗装中だから、ひとまず出てってもらえる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "先に終わらせてもいいよね？　あと少しだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うっ、ケホッ、ケホケホッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ケホケホッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "フゥ、フゥ――ハァ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "はいはい、来たよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "さてさて、どうしたのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "もし何かの修理だったら、エンジニア部に直接行ってね、私のところではできないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ケホッ、え～っとぉ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ほう――レンズがダウンしたのか、それならクロージャに言った方がいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "シーンちゃんはメイヤーさんの方がいいみたいだよ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そういうことね。なるほど……まあ今日は空いてるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "いま緊急の仕事がなくてよかったよ。じゃなきゃ無駄足させるところだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "これは覚えておいてほしいんだけど、これからあの四輪ロボットたちに何か問題があれば、まずはクロージャに聞いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うん、わかった～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "よし、じゃあ行こうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "うーん――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "クルースちゃん、本当に用事があったみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "そうだね。私たちは戻ろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "え？　もう追わないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "用があるなら仕方がない。邪魔してはいけないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "さて、クルースが残した仕事を片付けたら、何か美味しいものでも食べに行こうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "メイヤーさん、ここだよ～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "もう少しゆっくり歩いてよ。私、朝ご飯まだ食べてないんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "シーンちゃん～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "レンズ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "こんにちは、クルースお嬢様。お帰りなさいませ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "メイヤーお嬢様も、よくぞいらしてくださいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ちゃんと動いてるじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "あれぇ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "実は……クルースお嬢様が離れられてから、すぐにレンズは再起動したのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "レンズの一部機能はエラーが起こりやすいので、トラブルを確認したら自動的に再起動するようになっているのです。よくあることなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "なら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "ああ、お嬢様ですか？　お嬢様が言いたかったのは「問題ない」でございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "きっとお嬢様のしゃべり方がと――ってもゆっくりなので、クルースお嬢様が誤解されたのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "あぁ、そっか～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "じゃあ私は無駄足？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "大変申し訳ございません、メイヤーお嬢様。レンズは現在、正常に動作中です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん、どれどれ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "外部要因ではなさそうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "さっきは確かにシステムダウンだったよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "じゃあ中身に問題があるってことだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "さっき再起動はよくあるって言ってたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "クロージャはどうして解決してくれないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "クロージャお嬢様はすでにレンズのためにアップグレード用の部品を注文してくださいました。もうしばらくすれば解決できるものと考えております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "え？　あぁ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あの部品、レンズのだったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "昨日クロージャに聞いた時、すごいもったいぶってたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "「高精度移動型撮影機器が苛酷な条件下で使用する精密部品」とかなんとか言って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "なるほど、レンズのことだったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "だったら今からクロージャのところに行かない？　あの部品を組み込んじゃおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そうすれば任務中にシステムダウンする可能性はぐっと減るから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "メイヤーお嬢様、お気遣いありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "それではレンズはお嬢様と一緒に向かいますので、申し訳ないのですがメイヤーお嬢様は先にクロージャお嬢様のところで待っていていただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "そういうことなら、私がシーンちゃんを連れてゆっくり行くよ～。それならレンズも安心して早く直しに行けるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "いいよね、シーンちゃん～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "お嬢様がよろしいと仰るなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "よし、じゃあ行こうか。ちゃちゃっと終わらせれば今日は早く寝られるよ。明日はまた仕事が山ほどあるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンズ",
      "text": "うわぁ！　メイヤーお嬢様！！　レンズを推しながら走るのはやめてくださいいい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "大丈夫だよ。メイヤーさんはせっかちなだけだよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "私たちはゆっくり行こう～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "道も分かるし大丈夫だよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シーン",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "行動予備隊A1宿舎"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ただいま～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "おっ、帰ってきたな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "おかえりなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "フェンちゃん！　これフェンちゃんにプレゼント～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "記念日おめでとぉ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "わぁ、マフィンだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "え？　あ、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "テーブルに置いておくよ。明日一緒に食べよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "わかった～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "バスルーム、誰か使ってる～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "もう他のみんなは寝てるよ、あとはクルースちゃんだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "わかった～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "ほらフェン隊長、クルースちゃんは今日一日、頑張ってたみたいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "それに、隊長にプレゼントまでちゃんと用意して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "あ……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "別に私は、クルースを怒ったり、責めたりしようとは思ってないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "本当に休みたいのなら、言ってくれれば問題ない時なら許すしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "でもクルースはいつもああいう逃げ方をするから、それがちょっと問題かなって思ってるだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "クルースちゃんは休みたいって言うのが申し訳ないだけですよ。彼女はいい子なんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "私は、クルースは私をからかってるんだと思うけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "それは……隊長と仲が良いからですよ、きっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "だってクルースちゃん、他の人にはそういうことしませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "はぁ、私はむしろ普通に接してほしいよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "まあいい。さぁ早く寝よう、明日も訓練だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "ああ、明日は起きたらクルースを起こしてあげてよ？　さっき帰ってきた時、だいぶ疲れてたみたいだから。たぶん、明日は自力では起きられないかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "もし寝坊でもしたら、ドーベルマン教官が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "安心してください。ちゃんと引っ張って行きますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "そう？　だったらいいけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "だめだ、考え始めると止まらなくなる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "やめやめ！　寝よう寝よう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェン",
      "text": "おやすみ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーグル",
      "text": "おやすみなさい、隊長。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
