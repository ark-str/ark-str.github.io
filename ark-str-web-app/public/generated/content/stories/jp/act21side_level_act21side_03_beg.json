{
  "server": "jp",
  "storyId": "act21side_level_act21side_03_beg",
  "groupId": "act21side",
  "stageId": "act21side_03",
  "title": "衆矢の的",
  "storyCode": "IS-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act21side/level_act21side_03_beg.txt",
  "sourceHash": "0f5bf389562e7d370012c958091fef533a5a53ad499c82791d52fa1c0c38b11f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "わーお、このドレスすっごく綺麗だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやなあ、ソラが着たら似合いそうや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "こんなことならあたしも役者やるって言っとけばよかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "エクシアはんには無理やって。演技っちゅーもんをまるでわかってないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でも、素のあたしとして出ることはできるっしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "シラクーザにはあんたはんみたいなサンクタおらへんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "それがいるんだな～。聞いた話じゃ、あのミズ・シチリアのそばには――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "サリーさん、うちのボスがあなたをディナーに招待したいと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "そんな……ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳格な用心棒",
      "text": "どけ。サリーさんは劇場へ行くとこなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "うちのボスが今すぐ会いてえっつってんだ、劇場なんかあとで行っても同じだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "ええとその、監督のところへ行かないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "監督ねえ。前なら顔を立ててやってたが、今となっちゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "あの、どうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っているマフィア",
      "text": "いつまで奴らに気ぃ遣ってるつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っているマフィア",
      "text": "ボスが会いたいって言ってんだぞ、名誉なことだろうが。痛い目に遭いたくなきゃさっさとついてこい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "待てよ、ボスはそこまで言ってなかっただろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っているマフィア",
      "text": "まだ兄貴の考えがわかんねえのか？　これまでの俺たちはベッローネにビビってたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒っているマフィア",
      "text": "今じゃ奴らは落ち目になって、有力マフィアたちも椅子取りゲームを始めてる。俺たちにとってみりゃこれはチャンスなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "確かにそうだな。お前ら、この目障りな連中をやっちまえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳格な用心棒",
      "text": "チッ、サリーさんを守れ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "エクシアはん、どうしよ……って、どこ行ったん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "先に飛び出して行っちゃったよ！　あたしたちも行こう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "厳格な用心棒",
      "text": "っぐ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "フンッ、この程度で用心棒なんかやってるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "……うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "サリーさん、こっちへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "わ、わかりました……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "――えっ！？　あなたたちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "ッ、誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ついてきて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "軽薄なマフィア",
      "text": "チッ、追え！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怒っているマフィア",
      "text": "邪魔すんじゃねえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "さ、行くで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "サリーって呼ばれてたよね。キミ、大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "あなたたち……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "とんでもないことしてくれたわね……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "私を助けたつもりでしょうけど、とんだ迷惑よ！　あいつらは絶対報復してくるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "じゃあ、どうするつもりだったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "……どうもしないわ。我慢するだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "え？　でも、それじゃ怪我しちゃうでしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "それでも……怪我だけで済むわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "あの人たちは本気で私を取り合ってたわけじゃなくて、喧嘩の種を探してたんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でも、あんなことになったらせめて助けくらいは呼ばないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "無理よ。マフィア同士の争いだから、誰も助けになんてきてくれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あのラヴィニアさんって裁判官は？　すっごくいい人そうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "……確かに、ラヴィニアさんは数少ない素晴らしい裁判官だけど、この手のことに関してはあの人にできることなんて何もないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "それに、私がこの公園から生きて出られなかったら……マフィアたちの小競り合いに巻き込まれて私がいなくなったことに、一体誰が気付いてくれると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "だから……我慢を選ぶんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "それ以外の方法なんて知らないわ。私たちはずっとそうやって生きてきたんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "何とか隠れて、決着がつくのを待って、勝ったほうについてその場を逃れる……そうするしかないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "はぁ……ごめんなさいね。あなたたちを本気で責めるつもりはないのよ。それどころか、正直さっきは誰かに守ってもらう感覚を生まれて初めて味わったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "あのマフィアたちも特別すごいファミリーじゃないから、きっと監督が丸く収めてくれるでしょうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "でも、忠告だけはしておきましょう。シラクーザで暮らすつもりならこういうことはやめたほうがいいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "特にこれからの時期はね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "これからって、何かあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "建設部長のカラチさんが亡くなったってニュース、見てないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "見たで。なんでも、暗殺されたっちゅー話やんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "気の毒だね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "あなたたち、やっぱりいい人そうだから、もう少しちゃんと教えておくわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "私は普段からマフィアたちの相手をしないといけない分、あの人たちから色々聞いてるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "カラチさんを殺した犯人はまだ捕まってないらしいわよ。それに、彼の殺害と同時にベッローネの若旦那も襲撃を受けていたんですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "え？　ベッローネですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "そう。彼らはマフィアたちのトップに立ったも同然の状況だったんだけど、今回の件はどう見ても前々からベッローネを標的に計画されていたものだって聞いたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "おかげで、とっくに諦めてた多くのファミリーまで、今になってまた動き始めてるって話よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "「テキサス」って名前が話題に上ったりしませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "テキサス？　シラクーザでその名前を知らない人なんていないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "そういえば、最後のテキサスがどうとか言ってたような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "本当ですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "こんなデタラメに食いつくなんて、変わってるわね。テキサスファミリーに生き残りがいるわけないじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "でも……ううん、そうですね。あなたの言う通りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "とにかく、あなたも知ってるかもしれないけれど、私たちの劇団は監督のツテでベッローネとのコネクションがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "そのおかげで、さっきの人たちも前は監督の顔を立てていたのに、今は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "あなたたちも見た通りよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "シラクーザのマフィアってみんなここまでやりたい放題なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "……今から言うことを覚えておいてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "シラクーザで生きていくのなら、マフィアの一員になるか、彼らからできるだけ離れるかしておきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "……そして後者を選ぶなら、離れていれば面倒は起こらないと自分に言い聞かせて過ごすのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "それじゃ、私は劇場に戻るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "きゃああああっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "今度は何！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "役者",
      "text": "こ、ここに……縛られてる人が！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "全部上手くいってりゃ、そろそろあの可哀想な野郎が見つかってる頃だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "しっかし、わかんねえな。あの時わざわざ生かしといた奴を、なんで今になってほっぽり出さなきゃならねえんだ？　特別な理由でもあんのかねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ま、つまりあの胡散臭いバーテンは、このタイミングで奴を見つけさせたいと思ってるってこったろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "普通に考えりゃ、誰かを嵌めるのが目的だろうが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "チッ、ほんと陰険な野郎だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "最後に勝つのがあいつだったら、その「陰険」って評価は「抜かりない」に早変わりだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "けっ、くだらねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "……ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "何笑ってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ちょっと思い出しただけさ。昔、俺らがまだガキだった頃にもよくこんなふうに喧嘩したなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "あれから何年も経って紆余曲折経た末に、結局今もお前とつるんで必死こいてるとはねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "運命ってのは本当にわからんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……フッ、まったくだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "龍門であんなことが起きるとは思わなかったしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "まさかそれが、最後にはシラクーザに戻ることになるとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ガンビーノ、もしもの話だが、ラップランドが本当に俺たちを放っといて好きなようにさせてくれるとしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "お前はシラクーザに残る気でいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "なんだ、まだ龍門が恋しいってか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "はあ、やめだやめだ。お前に聞いた俺がバカだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "けどよ、現実的な話、雇い主を変える気はないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ニュースを見たんだが、俺らが昨日仕留めようとしてたあいつ、あのベッローネの若旦那らしいぜ。それに、こっちの襲撃と同時にかなりの大物が殺されたって話もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "どう考えても、俺たちはどっかのファミリーに便利な道具として使われてる状況だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "だったらそうなってやりゃいいだけの話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "俺からすりゃ、ショボい真似するよかそのほうがマシだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そうだねえ。シラクーザに戻るなり、十二家の一つベッローネの跡継ぎ暗殺に加わるなんて、キミたちも立派になったなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "……楽しい時間はお終いだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……よう、ラップランド。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "わあ、美味しそうなもの食べてるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……食いてえなら自分で買え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ひどいなあ、上司に対してその態度？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "で、あんたは今まで何してたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "久しぶりに家族との時間を過ごそうと思って、実家に帰ってただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "いやあ、あの憎たらしい顔が相変わらずうざったく感じてほっとしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "家族だあ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あれ、言ってなかったっけ？　ボクの名字はサルッツォなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "サルッツォって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "あのサルッツォか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "カポネ。――ボクが三番目に嫌いなもの、わかるかな？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "カポネは一瞬悪寒を覚えた。しかしそれは束の間のことで、まるで錯覚だったかのようにすら思わせる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "正解は、他人がボクの家族について聞いた時――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ああ、確かに雰囲気が似てるね、って言ってくることだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ついでに一番と二番も聞いといていいか？　無駄死になんざしたかないし、先に知っときたいんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アハハッ、ボクとの付き合い方がわかってきたみたいだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけど、ほかはまだ思いついてないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "さてと、それじゃどうしてベッローネ暗殺に関わってたのか教えてくれる？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "はい、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "失礼します、ルビオ部長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "これはこれは、ラヴィニア裁判官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……立派な執務室ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "はは、普段から賓客をもてなすことが多いものでして……あの方々はこうした飾り付けがお好きですから、私もならってこのように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ところで、ご用件は何でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "カラチ部長が亡くなった件についてお話したいのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "おや？　私の証言であれば、すでに記録されていると思いますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ええ、存じています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ただ――個人的な考えがあって、お伺いしたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "……ああ、そういえばあなたは、犯人を見つけ出して罪を償わせると宣言なさっていましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "素晴らしいことです。若者はそのくらいの勢いがなければね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "進展はあったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……遺憾ながら、まだありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "それは残念です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたとカラチさんはご友人同士だったと伺いましたもので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "確かに、カラチは飲食から衛生に至るまで、人々の暮らしには常々強い関心を持っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ですが、恐らく私ではお力になれそうにありませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "何しろ、私は彼とはそこまで親しい仲ではありませんでしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "協力したい気持ちはあっても、どうにもなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "とにかく手がかりがほしいんです。怪しく思った物事や、政府内の要注意人物など、本当に何でも構いませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "多すぎるくらいありますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "……あなたは、カラチ以前の建設部長が何人亡くなったか覚えていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "七人？　あるいは八人でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "この地位に就いた人間は皆操り人形にすぎません。どのファミリーも自らの縁者を就かせようとしては――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ほかのファミリーにそれを殺される。その繰り返しです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "率直に申し上げますと、マフィアたちが建設部長という重要な役職に自らの縁者ではなくカラチという中立の人間を選んだのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "このまま同じことをしていては、いつまでも都市建設が進まないからというだけのことでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "どこか一つのファミリーの縁者が選ばれることのないようにと彼らが牽制し合った結果、カラチがあの地位に就いたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "確かに彼はベッローネと大層懇意にしていました。若旦那がそばで秘書を務めていたくらいですからね。ですが、彼はある程度ほかのファミリーとも同様に親しくしていたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "――炎国には「朱に交われば赤くなる」という言葉があります。私はカラチの誠実さを信じていますが、他の人はそうは見ないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "私たちに選べるのはどのファミリーに飼われるかということだけだ――というのがシラクーザ人の考え方ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "はっきりと言ってしまえば、どうあれカラチは死んでいました。どのファミリーの計画にも彼の存在はありませんし、彼自身それに気付かなかったはずもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "死んだのが今日であろうと、一ヶ月前であろうと、あるいは一ヶ月後であろうと、実質的な違いはないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……彼の努力はご存知のはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "それをして、彼は結局何を得たと思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "仮にあなたの仰る通り、彼が無私無欲な人だったとして――そんな彼が常々尽くし、気にかけてきた市民たちは、彼に報いることなどあったでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "裁判官さん。あなたについては色々とおうわさを聞いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなたがこれまで、たくさんの成果を上げてきたということは事実でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "しかし、その内どれだけがあなた自身の努力の成果で、またどれだけがその後ろ盾の影響によるものか、ご自分でおわかりになっていないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "っ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなたはベッローネのために私を探りに来たのではないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "決してそんなつもりではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "……そうであってくれたほうがよかったくらいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなたにご忠告しておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "死人は戻ってなどきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "我々は自分たちのことだけでも精一杯なのですから、彼にそこまで心を砕くことはないのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……それが故人の友の取る態度ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ここで長生きをしたいのなら、見習うことをお勧めします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "もしもし？　ああ、可愛い娘よ。そうなんだ、まだ仕事中でね。そちらの準備はできたかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "わかった、私も今行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "うん、それじゃあな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "では、今夜オープンするレストランから食材のチェックに招かれていますので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "この辺りで失礼いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "そういえば、レオントゥッツォさんにお伝えいただけますか。美味しいものにご興味があれば、いつでもいらしてくださいと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……覚えておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ありがとうございます。それでは。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "――何ですって？　レストランで襲撃を仕掛けた連中のリーダーを見つけたの？　しかも縛られた状態で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "了解、すぐに行くわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……ってわけで、俺たちは偶然巻き込まれただけで詳しいことは何も知らねえんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "この件での雇い主がどこのファミリーかもわからんが、金払いは相当いいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "向こうがキミたちみたいな身元のわからない殺し屋を求めていたのは明らかだね。そうすれば死なれたところで足がつかないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "偶然どころか、とっくに目を付けられてたのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ありえなくはないだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "それじゃ、推理してみてよ。キミたちの雇い主は誰なのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "……ロッサティかサルッツォじゃないのか。この都市でずっと争ってる十二家の中で、まだ力が残ってるとこはベッローネを除けばその二つくらいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "うんうん、普通はそう考えるだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "でも、サルッツォにそんな計画はないってことはボクの反応を見ればわかるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "だったら――ロッサティか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "可能性はほかにもあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "っていうと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミたちが最初に始末したあの運の悪い人たちは、元々建設部の人をターゲットにしてたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "そして、ベッローネのお坊ちゃんは建設部で働いてる……ということは、キミたちが始末したのはベッローネにとって不利益をもたらす人間だったわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "……つまり俺たちは、ベッローネのために脅威を取り除いたあと、今度はベッローネに対するもっと大きな暗殺に参加させられてたってわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……驚くことでもねえだろ。ファミリー同士のいざこざではよくある話じゃねえか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "まあ……そうかもな。最初に始末したのは、状況を把握してない連中だったって可能性もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけど、それは「口封じ」だったんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ってことは……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ベッローネに裏切り者がいるってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "単なる可能性の話だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アハハハッ、面白くなってきたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "そうだと仮定して考えてみようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "建設部長のカラチが死に、その前には、建設部の人間への襲撃が行われていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "普通はこの二つを関連付けて考えるだろうね。特にあの可哀想な裁判官は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけど、襲撃に関わった犯人は口封じに始末されて、そのリーダーも見つからない。途方に暮れたあの人はどう思うか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "もちろん、手がかりを欲しがるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "そんな時、キミたちが縛って捨ててきた殺し屋は最高の手がかりになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "なるほどな。どうして今さらと思ってたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "今になって奴を放りだした理由はそれか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "そのあとちょっと待ち伏せて、裁判官にサプライズを仕掛けてやれば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "「ドカン！」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラップランドは爆発を表現するように両手を広げ、ソファへと倒れ込む。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "そこら中に影響が出るだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ああ……ほんっとに素敵なアイデアだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "こういう展開にならなかったらボクがそうしてあげたいくらいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……つまり、これはベッローネの自作自演だって言うんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "その可能性があるって話だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ベッローネのことを一番よくわかってるのはベッローネ自身なわけだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "フンッ、ありえねえだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "全ファミリーの未来に関わる大事な時に、自分のファミリーに手を出すようなクズはシラクーザにゃあいねえよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "ガンビーノ、いい加減学べよ。その根拠もない自信がシチリア人を滅ぼしたんだってことをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "てめえ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "とはいえ、今回ばかりは同感だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アハッ、そうかい？　あえて弱みを見せることで、自分たちが弱体化していると思わせたいのかもしれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "……だが、奴らはもう勝ちを掴んでたんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "まさか、ベッローネが結託して、手に入るはずの街を手放してまでこの都市をメチャクチャにしてやろうと考えてるとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "そんな気の狂った真似するか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "さあね。だけど、この大地にはキミたちの想像よりずっとたくさんの狂人がいるのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "フフッ、愉快な食事の時間もそろそろお終いだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "それじゃ、楽しんで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "あんた、お喋りしにきただけだってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あれ、ボクのために働きたかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "そんなつもりはないけどよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "とにかく、どっち側についてんのかだけ教えてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "知らない間にあんたを敵に回して、わけもわからず死ぬのは勘弁だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ボク？　ボクはもちろん、いつだってテキサスの忠実な味方だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "待ち伏せの準備はできたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "用心棒",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "言いたいことがありそうな顔だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "用心棒",
      "text": "……いえ、ただ少しラヴィニアさんが可哀想な気がして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "用心棒",
      "text": "あの人も俺たちファミリーの仲間みたいなもんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "……彼女と仲良くなったのが、ベッローネの次期ドン――レオンでさえなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "俺だってこんな悪役にはなりたかなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "あの人が「公正」という名のゲームで遊びたがる分には、好きにしてもらって構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "だが、ラヴィニアがドンの力を当てにしてこの数年やってきたことはレオンに……いや、俺たちファミリーに対して大きな影響を与えつつある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "ベッローネにそんな優しさはいらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "彼女にも、レオンにも、その事実を理解してもらわなきゃならん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "でないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "この先訪れる混乱の中、勝利を手にすることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "用心棒",
      "text": "ですが、若旦那は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "text": "お前たちの懸念はわかってる。この件は全部俺が責任を取るさ。あとでレオンに詰められても、お前たちは無事で済むようにするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "用心棒",
      "text": "……はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……誰だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "やあ、チョコレートを持ってきたよ。食べるかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……シラクーザの監獄はセキュリティがなってないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけど、ここはほかの都市に比べればしっかりしてるほうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "テキサスは少しため息をつくと、チョコレートを受け取って一口かじる。\nそれは彼女が一番嫌いなフレーバーだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アハハッ、てっきり容赦なく追い出されると思ったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "お前を追い出す労力に比べれば、無視するほうが楽だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私の邪魔をしない限りは好きにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "とっても感動したよ、テキサス。ボクとの付き合い方を、少しずつわかってきてくれてるんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "大丈夫、ボクは誰かの邪魔なんかしないよ。むしろ前にあるものがよく見えるように、霧を払ってあげるほうが好きなくらいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それで、サルッツォはどこまで知っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミの知ってる以上のことは知らないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "勝利を確信していたベッローネは、さらにロッサティへの牽制として龍門からキミを連れ戻した。これは一種の予防策だったんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけどそんな折、昨日の暗殺事件が起きてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あまりにもわざとらしすぎて、犯人に本当に隠す気なんてあったのか疑わしいレベルだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "で、キミはどうするの？　あの裁判官が解放してくれるまで、監獄の中で龍門の思い出にでも浸ってるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "早く帰りたいんじゃなかったのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "待てば帰れるというのなら、大して苦にはならないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "じゃあ、その裁判官に危険が迫っているとしたら、どうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "容疑者はどこ？　もう目は覚ましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "書記官",
      "text": "現場はこちらです、すでに押さえておきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "書記官",
      "text": "容疑者はまだ目を覚ましていません。縛られたまま隅のゴミ箱に詰め込まれていて……病院には連絡済みです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "発見者は誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "書記官",
      "text": "デッラルバ劇団の役者たちです。稽古があるというのですでに帰しましたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "デッラルバ劇団……ベルナルドのところの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あの人の影は本当にどこにでもあるものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "書記官",
      "text": "ラヴィニアさん。あなたが報告を上げていた、口封じ目的と思わしき事件……殺害されたのはこの人の仲間でしたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ええ。あの時は、彼らの身元を確かめられそうなものは何も見つからなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "書記官",
      "text": "なのに、どうしてそのリーダーがこんな痛ましい姿で急に現れたんでしょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "書記官",
      "text": "とりあえず、起こしてみますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ええ、お願い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "げほ、ごほごほっ……げほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたは包囲されているわ。抵抗はしないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "……ラヴィニアか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "自分が置かれている状況はわかってる？　あなたを縛ってここに置いていった人物は誰なのか、教えてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "そんなことを聞いてどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "質問に答えなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "刑法第十四条。非公式の尋問に対しては黙秘権があるんだ、わかってるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……法律に詳しいのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "それがどうした？　第百三十二条を適用して、特別処分権を行使しようとでも考えてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなた、何者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "ただの殺し屋さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……いいえ、思い出したわ。あなたには会ったことがあるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "ああ、昨日レストランでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そうではなく――三年前、ある法律関係の討論会で、ソレント市のボルトロッティ裁判官による素晴らしいスピーチを聞いたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "当時、あなたの演説には感銘を受けたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "記憶にないな。今の俺は気楽な殺し屋稼業で食っててね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あなたはそんな人ではなかったはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "そうやって決めつけるんじゃねえよ。体裁だけの討論会での演説一つで、俺をわかったつもりなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "熱意というのは誤魔化せないものよ。あなたはあの時……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "妄言を吐いて幼稚な発言を繰り返してた。若造のご多分に漏れず、自分は何かを変えられるんだと思い込んでたのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "俺は単に、あんたより早く正気に戻っただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "「どんな人をも守れるような落とし所を見つけたい」と言ったのはあなたでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "ああ、たとえばマフィアの一員になって、ボスの言う通り邪魔者を全員始末するとかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ボルトロッティ裁判官。私があなたの力になるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "ハッ！　俺の力になってくれるって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "そうだよなあ。あんたにはベッローネっていう頼もしい後ろ盾があるんだからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "そりゃあ名誉と尊厳を失うこともなきゃ、一時の甘さで投獄されたり殴られたりすることもないだろうさ。自分の家が家族もろとも燃えてるところを見たことだってないんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "あんたは何もわかってねえよ、ラヴィニア裁判官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "その手に持ってる法典の重さも……それが人生をどう台無しにしていくかってことも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な殺し屋",
      "text": "だが、運が良かったな。それを知る機会もなくなるんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "書記官",
      "text": "ラヴィニアさん、危ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "なっ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "すぐにここを離れるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "テキサスさん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "相手が多すぎる。ついてこい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
