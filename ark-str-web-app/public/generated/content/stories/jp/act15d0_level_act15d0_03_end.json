  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "speakerId": "avg_npc_133",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "speakerId": "avg_npc_133",
      "text": "ふん！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "speakerId": "avg_npc_133",
      "text": "！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Aエリア囚人",
      "speakerId": "avg_npc_132",
      "text": "ぐはっ……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "（こいつ、強い……ほかの連中はみんなこいつ一人にやられた。）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "speakerId": "avg_npc_133",
      "text": "……死ねや。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "speakerId": "avg_npc_133",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "（この看守もやるな……でも、どうして彼女は守りに徹してるんだろう？）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "speakerId": "avg_npc_133",
      "text": "ハァッ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "speakerId": "avg_npc_133",
      "text": "……うっ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "（まずい、この看守も倒されたとは……）"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "（残るは私だけ……でも、もしここであいつと戦ったら、脱出した後で何て説明すればいいんだろう？）"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "speakerId": "avg_npc_133",
      "text": "……あとはお前だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "（どうしよう、やるしかないの？）"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "speakerId": "avg_npc_133",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": null,
      "text": "フンッ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人B",
      "speakerId": "avg_npc_133",
      "text": "……見掛けによらず素早いんだな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "（アンソニー、私を助けたの？）"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "お前たちが誰かは知らない。だがこんなことを私の目の前ですべきではない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "speakerId": "avg_npc_133",
      "text": "へへっ、自分の死が目の前に迫っているってのに他人の心配かよ。紳士だなぁ、ええ？　アンソニーさんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "（！　いつの間に背後に！？）"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "speakerId": "avg_npc_133",
      "text": "へへっ、悪く思うなよお嬢ちゃん。恨むんなら、ここに居合わせた自分の不運を恨むんだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "speakerId": "avg_npc_133",
      "text": "安心しろ。俺たちゃ、アンソニー以外、誰も殺すつもりはねえ……ここでしばらく寝てな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "（しまった！）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "avg_npc_133",
      "text": "ぐっ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": null,
      "text": "（くそっ！　あいつの思い通りになっちゃう……）"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": null,
      "text": "（意識が、朦朧として……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "speakerId": "avg_npc_133",
      "text": "……さあ、アンソニー……もてなして……やる……ぜ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……しね……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "speakerId": "char_249_muesys",
      "text": "メイヤーさんってこんなに料理が上手だったのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "speakerId": "char_242_mayer",
      "text": "フフーン、意外でしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "speakerId": "char_249_muesys",
      "text": "でも、別の殺し屋の暗殺に巻き込まれて気絶するなんて……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "speakerId": "char_249_muesys",
      "text": "ほんと運がないのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "speakerId": "char_242_mayer",
      "text": "ほんとだよ、ツイてなさすぎ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "speakerId": "char_249_muesys",
      "text": "じゃあ、その場はどうやって収まったのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "speakerId": "char_249_muesys",
      "text": "きっとアンソニーさんが勝ったんでしょうけど、獄中で暗殺未遂事件が起きたんだもの、そう簡単に終わるはずはないでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "speakerId": "char_242_mayer",
      "text": "うん、でもその時ロビンは気絶してたから、カフカの視点からの話になるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "speakerId": "char_249_muesys",
      "text": "あら、カフカさんもその囚人に気絶させられたんじゃなかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "speakerId": "char_242_mayer",
      "text": "カフカは気絶したふりをしてたんだってさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "speakerId": "char_249_muesys",
      "text": "アハッ！　そうだったのね、今まで聞いた彼女の印象からすれば、確かにやりそうなことだわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "言え、誰の差し金だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "speakerId": "avg_npc_133",
      "text": "へっ……へへ……お前にゃ……教えねぇよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "Bエリア囚人A",
      "speakerId": "avg_npc_133",
      "text": "――"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……気絶したか。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "まさかこいつら……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "まあいい、今考えても仕方がない。ほかの囚人たちの状況は……"
    },
    {
      "type": "dialogue",
      "speakerName": "囚人たち",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "死んではいないようだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "このお嬢さんは――"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "誰かは知らないが、さっき私を助けようとしてくれた……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "ありがとう、見知らぬお嬢さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": null,
      "text": "カフカって呼んでよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "んん？　気絶してはいなかったのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_264_Mountain",
      "text": "ちょっ、下手に動かないで。少し右にずれてくれない？　あそこに監視カメラがあるんだよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "これでよろしいかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": null,
      "text": "いいよ、これで監視カメラからは見えないはず。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "掃除中にチェックしといてよかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "ふむ……貴方は一体？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "言ったじゃん、カフカだよ。君を助けに来たんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "でも、ついてないなぁ……本当は君にメモを残してそれで終わりのはずだったんだけど、まさかこんなことに巻き込まれるなんてさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "どういうことですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "ここで話すのは都合が良くないな……どっかいい場所知らない？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "まもなく騒ぎを聞きつけて看守たちがやってくるはず……医務室に行きましょうか、あそこなら大丈夫ですよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "speakerId": "avg_npc_135",
      "text": "どういうことだ！　アンソニー、何をした！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "それは私が聞きたいですね、バートンさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "この囚人たちの中に私を殺そうとした者がいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "これは一体どういうことです？"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "speakerId": "avg_npc_135",
      "text": "なんだと！？"
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "speakerId": "avg_npc_136",
      "text": "本当です、バートン隊長。あの二名の囚人がミスター・アンソニーを取り囲むのを目撃しました。"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "speakerId": "avg_npc_135",
      "text": "なに？　お前はあいつらを監視してなかったのか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "看守B",
      "speakerId": "avg_npc_136",
      "text": "私はあの囚人たちに倒されてしまいまして……かなり腕の立つ連中ですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "speakerId": "avg_npc_135",
      "text": "チッ、使えない。"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "speakerId": "avg_npc_135",
      "text": "こんな面倒起こして、俺は獄長にどう説明すればいいのだ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "まずは今のこの状況を片づけましょう、バートンさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "この二人は刺客です。相応の処分をお願いします。"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "speakerId": "avg_npc_135",
      "text": "ゴホンッ、だがミスター・アンソニー……ほら、何というか、この件に関して、あなたの言い分だけでは……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "わかっています。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "私も怪我を負ってしまいましたので、ひとまず医務室に行かせてください。皆も二人によって倒されて気絶しています。手当てをした方がいいでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "医務室へ行った後、この件について相談しましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "speakerId": "avg_npc_135",
      "text": "わかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "バートン",
      "speakerId": "avg_npc_135",
      "text": "お前らなにをボサッとしている、この二人を霊安室へ運べ！　それから、倒れてるこいつらをまとめて外に連れてけ！"
    },
    {
      "type": "dialogue",
      "speakerName": "看守",
      "speakerId": "avg_npc_134",
      "text": "は、はっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "看守",
      "speakerId": "avg_npc_137",
      "text": "了解しました！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "speakerId": "char_441_lotus",
      "text": "看守たちは行ったわ、アンソニー。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "speakerId": "char_441_lotus",
      "text": "何が起きたの？　みんな慌てた様子だったけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "私もそれが知りたいのですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "さて、もう安全ですよ、カフカお嬢さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "ドゥーマさんは私の友人です。この監獄で信用できる者といえば、彼女だけです。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "最初に言っとくけど、お嬢さんはやめてほしいな。カフカは単に、背がちょっと低いだけだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "それは失礼をいたしました、ミス・カフカ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "えぇ？　囚人のくせに、外の人より礼儀正しいじゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "speakerId": "char_441_lotus",
      "text": "アンソニーはこういう人よ、誰に対しても丁寧なの。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "そうなんだ。めっちゃ強いのに腰が低いなんて……ここの人たちがすごいって褒めるのも分かるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "恐縮です。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "では、ミス・カフカ。質問してもよろしいですかな？　貴方は私を助けに来たとそう仰ったが、それはつまり私を暗殺しようとした者たちの素性を知っているということですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "うーん……その前に、一個聞きたいんだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "どうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "君の家、もしくは君んちの名が付いたサイモン社で一体何が起きたか知ってる？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "もし知ってれば、そんなに複雑な話はしなくて済むんだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……父は十数件の事案で告発されました。あれらの背景は単純なものではない。しかし私にはその辺りを具体的に探る余裕はありませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "それを知ってるなら話は早いや。サイモン社は源石……何だっけ？　イホーナントカ……？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "違法源石製品密輸罪ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "そう、それ！　その罪でもう会社には捜索が入ってほとんどのものが差し押さえられたし、中心メンバーも全員逮捕された。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "今、君の家族はみんな、バンカーヒルシティの刑務所で服役中なんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "speakerId": "char_441_lotus",
      "text": "アンソニー……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "すみません……大丈夫です。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "心の準備はとっくにできていたのですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "とにかく、誰も死んではいない……それだけでも十分喜ばしいことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "で、誰の仕業です？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "ハイドブラザーズだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "ハイドブラザーズ！　やはりあいつらか……"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "えーと、サイレンスはなんて言ってたっけ……そうだ、君の家族、サイモン家は、もともとハイドブラザーズと、ある事業においてライバル関係にあったらしいんだけど――"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "お互いにその事業で50%ずつのシェアを占めていて、常日頃からぶつかり合っていた。そしてあっちは、君たちの分まで占領しようと企んでいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "それでとうとう彼らは行動を起こした――とまあ、こういうこと。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……ハイドブラザーズ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "父は、よくその名を口にしていました。客人として彼らの会社に招かれたことすらあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "speakerId": "char_441_lotus",
      "text": "私欲に駆られてこんなことまでしでかす人たちだったとは……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "似たような話を聞いたことはありましたが、まさかそれが自分の身に降りかかるとは思いませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "speakerId": "char_441_lotus",
      "text": "アンソニー、大丈夫？　私のアーツで興奮を和らげてあげようか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "大丈夫です……ありがとうございます、ドゥーマさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "言ったでしょう、とっくに心の準備はできていました。ただこんな形で突然事実を知らされるとは……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "貴方を信じます、ミス・カフカ。この件で貴方が私を騙す理由は何もないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "とすれば、あの刺客たちはハイドブラザーズが送り込んだものなんでしょう。しかし、彼らはどうして今になって私を殺そうと？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "それはカフカもほんとにわからないんだよ。でもカフカの経験から言えば、絶対さっきので終わりじゃないと思うよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "ハイドブラザーズは、きっと何人もの殺し屋を送り込んでるはず。これはまだまだ序の口って考えた方がいいよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "では貴方は？　おそらく貴方は、その殺し屋たちから私を守るためだけに来たというわけではないのでしょう？　貴方の目的は何なのですか、ミス・カフカ？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "カフカの目的？　うーん……これすぐには説明できないんだよね。とにかくカフカは依頼を受けて、君の脱獄を手伝いに来たんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "君は外に出て復讐したいと思わないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "君の判決は終身刑、しかも仮釈放すら望めない。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "もしここを出たいなら、選択肢はたった一つ――脱獄しかないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "幸いここに、カフカっていう助っ人もいる。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "もちろん、君がここで一生過ごしたいって言うなら、カフカは無理に連れ出したりしないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "speakerId": "char_441_lotus",
      "text": "脱獄……でもこの監獄から無事逃げ出せた人はいないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "まあね、そりゃ確かにそうだけど。でも、やってみなきゃわかんないよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……貴方はこの監獄に入ってしばらく経っている。そうですよね、ミス・カフカ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "ん？　そうだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "なら私の噂は聞いたでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "うん、君はこの監獄で最も強く、最も自由な囚人だって。獄長も君には敬意を払っていて、君はまさに監獄の主人だってみんなが言ってたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "カフカも、君はすごいって思うよ。こんな時でもそうやって冷静でいられるなんて。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……違うのです。いわゆるカリスマ性のようなものが、私にどれだけあったとしても、所詮は囚人です。看守や、まして獄長が私に敬意を抱くなんてありえない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "買いかぶりなのですよ。私は本来、今祭り上げられているような地位にふさわしくない。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "うーん、理屈は確かにそうかもしれないけど。でも実際にさ、君はそうなっちゃってるんだよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "確かに、私は看守たちから優遇されています。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "少なくとも私の知る限り、獄長は看守たちに「アンソニーには丁寧に対応しろ」と命令しています。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "ここ数年、ずっと疑問に思っていました。アイアンフォージシティへ来たところで捕まり、そしてここに収監された。これは最初から父が手配しておいたものではないのかと。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "父は何かを予見し、事前に私をここに送り込んだ――"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "私はずっとそう考えていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "へー、サイレンスは知ってたのかな、そのこと。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "サイレンスさん、それが貴方の背後にいる人物ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_Kafka",
      "text": "あ。あちゃー……ま、いいや。そうだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "事が済んだらその方にお礼を言わなければなりませんね……"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "いずれにしても、これはただの推測です。真実を知るためには、なんとしても逃げ出さなければなりません。本件を明らかにすることができるのは、もはや私だけなのですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥーマ",
      "speakerId": "char_441_lotus",
      "text": "アンソニー、彼女に話すつもりなの？　本当に大丈夫？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "大丈夫です。ひとまず貴方を信じます、ミス・カフカ。ですから貴方に打ち明けましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "たとえ貴方が来なかったとしても……たとえこの監獄生活を悪くないと感じていたとしても、私はいずれここを去るつもりだったのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "ここにいても、欲しい物はほとんど手に入ります。しかし私も、どうやってここを抜け出すかについては、ずっと糸口をつかめなかったんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "つまりここは、私から貴方に依頼すべき場面なのですよ、ミス・カフカ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "お願いします、私の脱獄を手伝ってください。"
    },
    {
      "type": "sceneBreak"
    }
  ],
