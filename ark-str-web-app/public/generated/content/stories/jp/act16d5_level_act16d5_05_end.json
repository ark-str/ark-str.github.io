{
  "server": "jp",
  "storyId": "act16d5_level_act16d5_05_end",
  "groupId": "act16d5",
  "stageId": "act16d5_05",
  "title": "拙山",
  "storyCode": "WR-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16d5/level_act16d5_05_end.txt",
  "sourceHash": "8214dc5c9771532e183e27e3fb418cb0f77e5b49f1df20a2d678c03283af098b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "来るな！　来るなぁ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "ててて、手がっ、俺の手がぁ！　……は、はは、どうして全く痛くないんだ？　俺は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "ひいっ――来ないでっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "大丈夫か！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "遅いじゃない！！　どうして誰も鐘を叩かなかったの？　除夜の鐘を打つ僧侶はどこに行ったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "あなたたちを信じて言う通りにしたのに、どうして！？　どうして私の夫は死んじゃったの！？　一体どうやって……どうやって償うつもりよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……まずはここを離れるのが先決だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うわあぁ――お母さん、お母さん、お母さんを返してよぉ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "うおっ！　今回も危機一髪だったね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "お、おじさん、お母さん、お母さんが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "小さいのを倒すだけならまだしも、外のデカいやつには歯が立たなさそうだ。お嬢ちゃん、しっかり捕まってろよ。ズラかるぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガァ――！　グァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "うわっ、もう一匹来た！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "き、キリがないな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガア――ッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "グガッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "一体どっから湧き出てやがんだ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ダメだ。この数じゃ、全部は食い止めきれない――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガッ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "絵の中の人々とはいえ、これほどにひどい仕打ちを受けるなど……このような光景は、見ていて苦しくなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ラヴァ殿、ここは拙僧にお任せを。早く他の者を避難させるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "サガ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "心配はご無用。拙僧はこの地を遊歴すること数年、未来への憂いや迷いも多いが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "――目の前の危機を見過ごした事は一度もござらん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ここは、拙僧が守り抜く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……わかった。終わったら東に向かってくれ。そこでアタシたちと合流しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "承知つかまつった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "拙僧ここにあり！　前に進むでない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "この境界線を越えた者は――斬る。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うあああーーん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "お、お、お嬢ちゃん！　髪を引っ張るのはやめてくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "お母さん――お母さん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ガァガァガァガァうるさいなぁ。こんなにしつこく追いかけ回す頭があるならば、人の言葉くらい話してみたまえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "……ニゲ……ルナ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "うおぉ、今のは冗談だって！　なっ、なんでも真に受けないでよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ううぅ、おじさん、前、前！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "へっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "いやぁっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "あ、あなたは占い師さん？　他の二人の英雄はどうしたんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "危ない、後ろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "どうして化け物を連れてきたんです？　早く何とかしてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ええ？　私が！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "化け物を引き離してください、早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "い……いや私だってね――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ううぅ、うわあぁ、お母さん、お母さん――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "ああ、もう泣かないの！　ね？　泣かないでってば！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "あっ！　化け物がこっちを見てる！　早く、早くどうにか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアアアッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "せ、扇子で？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……ちょっと離れていてくれるかな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ？　ガアッ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "一発で……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガオッ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "す、すごい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "のおおっ！　痛ててて、手が痺れた！　こいつら一体何なんだ？　見た目はフニャフニャなのに、叩くと結構カタいじゃないか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "はぁ……そんな目で見ないでくれたまえ。曰く、「駄獣窮して人を噛む」とな。それより早く逃げよう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うーん。腕前はなかなかだけどぉ、ウユウくんはこういう状況で人助けをしたことがないんだねぇ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "目の前の敵だけ倒して、周りに気を配らなかったらぁ、いつか痛い目を見ちゃうかもよぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "あ、あはは……。恩人様のおかげで助かりましたよ。いや本当に危ないところでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……はいは〜い。早く残りの人を連れて避難してねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "え、恩人様は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "私ぃ？　大丈夫だよぉ。私は足取りが軽いから、見つかりっこないと思うよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "（足取りが軽いとかそんなレベルの隠れ身じゃないだろ！？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "さてとぉ……一気に敵の数を減らすにはぁ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "いやぁ！　あ、あの庭園の火はなに？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "おう！　火の柱が天に向かって伸びておる、なんと壮観な眺めか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "む？　そうか。たしか「ラヴァ」というのは、異国の言葉で――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ラヴァちゃ〜ん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……クルース、付近の敵の分布範囲を確認してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "そんな大掛かりなのをやるつもりなのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ああ。周りの建物が心配で、みだりに派手なアーツは使わなかったんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "敵が多すぎる。ちまちま対処してたら、計り知れない数の被害者が出るだろうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "そうだねぇ。緊急事態には、緊急手段を――だよねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "私は高いところに行くから、安心してやっていいよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "アーツの範囲外にいる敵は私に任せてねぇ。一匹も取りこぼさないからぁ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "任務報告はアタシが出そう……元々ロドスが助けるべき対象は、感染者だけにとどまらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "感染者……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ううん……なんでもないよぉ。あ、その前にねぇ、ラヴァちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "煮傘さんは見かけたぁ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
