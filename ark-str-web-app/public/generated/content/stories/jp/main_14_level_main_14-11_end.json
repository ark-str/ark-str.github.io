{
  "server": "jp",
  "storyId": "main_14_level_main_14-11_end",
  "groupId": "main_14",
  "stageId": "main_14-11",
  "title": "使徒",
  "storyCode": "14-12",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_14-11_end.txt",
  "sourceHash": "7d5fd190e87566d3c2e26a6eacb5eb13fc289eb17e73949e015a085083206391",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ここにいたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……ニアールさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "久々に本艦に戻ってきたんですし、もっとリズさんと一緒にいてあげたらどうですか？　あなたに会いたがっていましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "彼女なら先ほど眠った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "それより、君は前よりもやつれたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "リズのことを考えていたからか？　ケルシー先生に聞いたが、リズの病状に特に問題はないそうだが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "もしかして……何か私に隠していることでもあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私は……ただ、リズさんを完全に「治す」方法を考えていただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "君はもう何年もそのことに悩んでいるだろう。一朝一夕で解決できることじゃない。あまり自分を追い詰めすぎるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "もしも……その方法が常に手の届くところにあったのにもかかわらず、私に触れる勇気がないだけだと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……シャイニング。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "一体何を隠している？　私にさえ打ち明けられないことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ニアールさん、これは私自身が立ち向かうべき使命です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……私やリズが君の元を離れるとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "君もよく分かっているはずだ。そんなことは、絶対にありえないとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私が案じているのは……あなたたちが傷付いてしまうのではないかということだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私はリズさんと共に彼女の記憶を取り戻すことに決めました。真相を明らかにするその時まで……彼女の元を離れません。ですが、もし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ニアールさん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "もし何かあった時には、私の代わりにリズさんを守ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だが私が守り、共に戦うのは……リズだけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "シャイニング、君のためにも私は戦う。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私たちは仲間だ。使徒は全員で一つなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私の誓いは今でも変わっていない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "君たちが必要とする限り、マーガレット・ニアールと、このソードスピアは、いつでも君たちの元へ駆けつけよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ソードスピアが空を切る。\nまばゆい光が、敵の集団を押し返した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ここの聴罪師は……強敵ばかりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "シャイニング、どうりで君が私との実戦訓練を避けたがっていたわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "我々はロドスの資金節約に貢献していたのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "最大の敵は……まだこの先にいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "なるべく手早く片付けるとしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "……子供じみた真似を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "危ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "くっ――ふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "問題ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "シャイニング、私の盾で君を援護する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "君はただ……前へ進めばいい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巫術の奔流が彼女たちに襲い掛かる。\nその勢いは、マーガレットの光でさえ押さえつけられてしまうほどだ。\n階段の最上段に立つクイサルトゥシュタの手のひらでは、昼と夜とが渦巻いている。"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "それが、あなたの呼んだ助っ人ですか？　クイサルシンナ、我らの儀式の場を何だと思っているのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "馬の競技に興じるための……草原だとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "ふっ。彼女のアーツは、私からあなたへの影響を一時的にとはいえ阻めるようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "ですが、だから何だというのです？　あなたの剣技も、アーツも、全て私が仕込んだものなのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "私の許可なしに、この身を傷つけられる……とでも？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ゲホッゲホッ――ぐっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "動きが遅くなった……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "奴のアーツは……時間認知に作用しているのか？　それとも何か別の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "シャイニング！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……平気です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ですが、その盾が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……この新たな盾に、初めて傷がついたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だが問題ない。空いた穴はアーツで埋めるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "守るべき相手の前で、騎士の盾がたやすく壊れることはない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "……煩わしい光だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "仔馬よ、あなたのようなペガサスを……私は過去に幾度となく始末してきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "彼らの金色の血を、我がカズデルの城壁に塗りこめたのです――我が都市が夜明けの光の下で、永久に輝いて見えるように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "さすれば彼らの子孫たちも理解することでしょう。カズデルとは、みだりに侵してはならない場所であることを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……ここは、カズデルではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "貴様も、護国の英雄などでは決してない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "英雄とは自らの血を流し、他者のために道を切り拓く者のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だが貴様は――貴様が王座へと登る道は、誰かの血涙と屍でできている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "英雄？　そんなものになることなど、とうの昔に諦めていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "いくら人々に語り継がれ、敬われようとも……それは砂のように儚く消えていく。私がいかに時間を弄ぼうと、時の流れが止まることは決してありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "私は死に、私が築いた都市も崩れ去っていく。私が愛した民たちもまた成す術なく路頭に迷うだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "そんな絶望の循環に……あらゆるサルカズも、そして私も、苦しみ続けているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "ですが私には、君主としての責任と能力があります。ならばサルカズの運命を根本から改めねばならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "サルカズたちが二度とあなたたちのような野獣の足元で這いつくばらずに済むのなら……我がカズデルが無数の昼夜の中、永久不滅でいられるのなら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クイサルトゥシュタが話すにつれ、周囲のあらゆる光が彼の手のひらに流れ込んでいく。\nマーガレットのアーツも、聴罪師たちのアーツが放つ輝きも、そして……分厚い雲の隙間からわずかに差し込む陽の光も。そこに例外は一つもなかった。\nクイサルトゥシュタの手のひらの上に浮かんでいる小さな茨の王冠は、まるで絶対的な暗闇だ。\n石のベッドに横たわっていたナイチンゲールも、それに伴い浮かび上がる。\n相変わらず固く閉じられた目、そして力なく垂れ下がる四肢とは裏腹に、両腕がひとりでに開いていき――\nやがて最後の光が囚われた瞬間に、王冠はクイサルトゥシュタの頭頂部に落ちるだろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさん……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "シャイニング、私の光を辿っていけ！　彼女を助けるんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "最後に残った光が投げ槍のように放たれ、行く手を阻む巫術障壁を切り裂いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クイサルトゥシュタの眼前に、シャイニングが立ちはだかる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "闇夜の帳が檻のように垂れ下がっている。唯一の光は、彼女の剣から放たれる輝きだけだ。\nそれは剣先に揺らめく、魂の炎の跡だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……リズさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "かつて私が奪った、本当の記憶をあなたに返します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私が魂の探求に執着したために……あなたを彫り出す時に残った不必要な痕跡を消しませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "その結果、あなたは……目覚めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "感情の萌しがあり、反応を返し始めたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "しかしそれでも実験は続いていたので、私はどうしても耐えかね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "せめてあなたが、少しでも楽になるようにと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "自分は本当に生きているのだと。ほんの少しの温もりを抱いたこともあるのだと……そう感じてくれるように。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさん、あなたは……もっと早くに思い出すべきだったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私たちが交わした約束は、全て覚えていますよね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "青い羽獣が暗闇に浮かび上がる。\nシャイニングを見つめる大きな灰白色の瞳から、ゆっくりと涙が滴り落ちた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "宙に浮かんだ少女が、ゆっくりと降下していく。\n緩やかに流れる時の中で、シャイニングとマーガレットはナイチンゲールの声を同時に耳にした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "覚えています、シャイニングさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "あなたは真っ暗な部屋から私を連れ出すと、そのまま逃げ出して……お医者さんを探しに、色々なところへ連れて行ってくれました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "それからニアールさんに出会って、私たち三人は一緒にいるようになりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "たくさんの場所を訪れて、多くの人を救いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "あなたはよく真夜中になると、眉をしかめてため息をついていましたが……私が目を開けると、すぐに優しい口調に変わって、道すがら私が見逃した素敵な物事を語ってくれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "ニアールさんは何度も私にダンスを教えようと、手を引いてくるくると回ってくれました……私が回れない時は、二人で一緒に支えてくれて……代わる代わる背負ってくれて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "二人の傍にいると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "なんだか……本当に飛べるような気がしていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "あなたたち二人がいたから、今の私があるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私は使徒の一員……一人の医者です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私も、あなたたちのことを守ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私も共に戦います。最も深き罪を断ち切り……永遠の闇夜から人々を救い出すために。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "それが私たち三人の……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……約束です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ナイチンゲールは地面に降り立った。\n彼女のアーツユニットから、身体の中から、どこまでもまばゆい光が放たれる。\n巨大な檻が現れ、逆にクイサルトゥシュタの身体を捕えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "くっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "魂は完全に我が手中にあるはず。なのにこの「檻」は、なぜ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私には名前があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私はリズです。あなたの敵です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "クイサルトゥシュタ、あなたを止めるのは……あなたの話す言葉には、何も同意できないからです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "シャイニングさん、ニアールさん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "シャイニングは剣を握りしめる。\nマーガレットが放ったソードスピアの穂先が、クイサルトゥシュタの手の上で回転する茨の王冠を過たず捉えた。\nこの瞬間、三人は互いが何を考えているかすべて理解していた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "昼夜が再び支配される前に、揺らめく魂の炎の残光を掴まねば。\n連綿と続く血色にできた唯一の亀裂は、もう目の前にまで迫っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "見つけました。あなたの魂の本質を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "クイサルシンナ……あなた、は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "この身体がどうなろうと……私は構いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私の意志が血に支配された時は、リズさんとニアールさんが裁きを下してくれるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ですが、決してあなたの操り人形にはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "あなたに代わって征服することも、統治することもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "この身朽ちるその時まで……私は自由です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "ずいぶんな高言を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "ならば試してみなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "クイサルシンナ、我らはそう簡単には離れられませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "私の元から……もう一度逃れてみなさい。どれだけの間逃れていられるのか……試してみるのもいいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "もう逃げません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私はあなたに――唯一の、永遠の死を与えます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "シャイニング――下がれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "枝先の月が崖を転がり落ち、まるで天地がひっくり返ったかのように地面が激しく揺れる。\n祭壇が崩壊し、裂け目からは金色の液体源石が溢れ出てくる。\nいつの間にか人影が一つ、誰も気づかぬ間に歩み寄ってきていた。その動きは決して速くはなかったが、まるで図ったようなタイミングでクイサルトゥシュタと使徒の間に割って入った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "この場を去りましょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "……殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クイサルトゥシュタ",
      "text": "ふっ……あなただったとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "何者――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "使徒……だったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "勇気の欠如したこの時代において、お前たちが放つ輝きは抗いがたいものであると言える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クァリドチョア",
      "text": "我らは、いずれまた相まみえるだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クァリドチョアとクイサルトゥシュタが祭壇の残骸の中に沈み込んだ。\n他の聴罪師たちもその後に続いていく。\n先ほどソードスピアに撃ち落された茨の王冠が、突如回転し始めると、真っ黒な虚像となって空へ飛び上がった。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……ザ・シャード。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "あの嵐の中央にあるのが……通信で話していた「アナンナ」か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ケルシー先生とドクターたちは……間に合うでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "シャイニング、君は……その、平気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私なら大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "その血脈の呪いは、確かに複雑らしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ん……？　リズ……？　リズ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……そんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "なぜ魂が不完全な状態になっているんです！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "まさか、先ほどのクイサルトゥシュタへの抵抗は……あなたの魂を引き裂いて、それを代償にしたというのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "シャイニングさん……ニアールさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私はここだ、リズ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ずっと傍についている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私のことは、心配いりません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "お二人にはこれまでずっと、守っていただきました……今度は、私が守る番……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "text": "私は……みな……さんと……ずっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "リズ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "治療しよう、シャイニング！　二人で力を合わせるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "シャイニング？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "無駄です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "私たちのアーツでは、このような状況でこれほど深刻な魂の傷を治すことはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさんは元々、身体から魂までとても特別な方なんです。彼女が生まれたのは、ある偶然の結果ですから……いえ、むしろ奇跡と呼ぶべきでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "では、我々は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "ひとまずこの場を離れてから、次の算段を立てましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "クイサルトゥシュタはどうする？　見逃すのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "リズさんの安否に比べれば彼の生死など取るに足らないことです。彼の存在はとうの昔に重要ではなくなりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "text": "さあ、戻りましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ、一緒にな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "……リーダー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（怒り狂った咆哮）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "クイサルトゥシュタの黒い王冠を捕える計画は失敗に終わったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "祭壇の力が弱まりました……この程度の影響なら、耐えられます――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "祭壇の上部が崩壊し始めている。アーミヤ、「ティカズの血」を集中攻撃しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "うっ……くっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "私は以前、魔王から死の宣告を受けたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "それが今もう一度下されたってだけの話よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですがあなたは……とても苦しんでいるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あれほど敬愛していたクイサルトゥシュタに、こんなにもあっけなく見捨てられて。彼があなたを見る目は、あなたがあのキメラたちを見る目と……何も変わらないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "気遣いは結構よ、「魔王」様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "私の感情に特別なところなんてないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "聴罪師は皆、元々リーダーの血脈に連なっているの。クイサルシンナみたいに、生まれつき完璧な肉体を持つ者もいれば、私みたいに絶対に選ばれない者もいるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "だけど、彼女に嫉妬したことはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "私たちはただ、それぞれが相応しい立ち位置にいるだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "本来なら慈しみ合うこともできたんでしょうね。兄弟姉妹として……一体となって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルース",
      "text": "聴罪師のように、かつてない奇跡を作り出せる組織は他にないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "執着心が強いな。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……頑迷無知も甚だしい。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "私にだって、気になることはあるわよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "あなただってそうじゃないの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "「ドクター」……自分が生涯を捧げてきたことのためなら、ずっと一緒に戦ってきた、愛する人のためだったら……あなたも私と同じ選択を下すはずでしょう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "操られてるかどうかとか……影響を受けてるかどうかとか、どれもどうでもいいことなのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "原点に到達し、まったく新たな未来を築き上げる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "それこそが私の望みよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "いけません……「ティカズの血」に近付いては。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "はっ……あぁ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "黒い線が再びサルースの身体と、祭壇の中心を同時に貫いていく。\n「ティカズの血」が活動を止めた。"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "あと少しだった……はずなのに……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "アーミヤ、奴を止めろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "奴は起爆を試みて――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "text": "――！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "大丈夫……大丈夫よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "私の身体……まるで、怪物みたいね……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "彼女はぐしゃぐしゃになった腕を、あの血へと伸ばした。\n聴罪師だけが知る呪文。その魂に、血肉の全てに基づいた――"
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "今度ばかりは、完全に死んじゃうでしょうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "リーダーより先に、クイサルシンナより先に。私の家族、皆より先に……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルース",
          "text": "憧れの……未来の中へ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "サルースは微笑みながら、鼓動の止まった「心臓」へと飛びつく。\n「ティカズの血」が滾り出した。\n祭壇の中心に、巨大な赤い渦が浮かび上がる――"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "その瞬間にアーミヤは自分を見つめる視線を感じた。\nクイサルトゥシュタに、冠を戴く名もなき者、咆哮を上げるサルカズの魂……そして、彼女の最もよく知る人物の視線を。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "テレジアさん……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "「アナンナ」。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "サルースは自らの血で聴罪師の儀式を完成させた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "急ぐぞ！　祭壇から離れるんだ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
