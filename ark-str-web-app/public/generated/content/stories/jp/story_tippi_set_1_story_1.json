{
  "server": "jp",
  "storyId": "story_tippi_set_1_story_1",
  "groupId": "story_tippi_set_1",
  "stageId": null,
  "title": "受賞コメント",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_tippi_1_1.txt",
  "sourceHash": "c827d80feee95ddcdc7bd3de371edd6c7dc2e749dbd6e94c0e7ddeae1f97831d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "エクセルシオールスタジオは創設以来十数年もの間、多くの人々に愛されるカルト映画を制作し続けてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "全盛期は一日も休むことなくスタジオを稼働させて、映画館のレイトショーをすべて我々の作品で独占していたほどだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "しかしこの二年間、何本もの大作が立て続けに失敗して、興行収入は下がる一方になってしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "今では昼ドラの監督ですら「くだらないスプラッター映画しか撮れない粗末なスタジオ」と言って、我々の依頼をあしらう始末。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "経営不振も資金難も紛れもない事実だ。包み隠さず言うと、このスタジオにはもう映画を制作する余裕がない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "それに、もう一つの事実も認めざるを得ない。世間はもはや血と暴力に満ちた映画など望んでいない、と。我々は市場に切り捨てられたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "私も、もちろんここにいる皆も、全力を尽くした。だが、この場をもって伝えなければならない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "エクセルシオールスタジオは……一週間後に閉鎖する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "フン、あんな感動的な挨拶をしたくせに、結局退職金すら出すつもりもないじゃないか！　クビを切りたいってだけならはっきり言えばいいのによ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "破産なら、払えるお金なんてあるはずないでしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "おいおい、さっきの話を真に受けてるのか？　今頃、金を転がして次のスタジオを立ち上げる準備でもしてんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "信じられないってなら、先週の新聞を読んでみな。もう皆が知ってる話だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "でも新しいスタジオを作るなら、私たちを雇い続ければいいんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "そりゃあ向こうは大作映画を撮って、大衆から金を巻き上げたいんだろ。血のりと悲鳴ばかりの映画しか売りがない俺たちを、アイツが新作に入れたがると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "はあ……次の仕事、ちゃんと見つけられるかなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "どうしてティッピまで落ち込んでるのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "あなたはここ数年で、大手の作品に何度も参加してきたじゃない。もうそこそこ名前も売れたんだから、仕事がなくなる心配はないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "……ティッピ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "やっぱオーナーと話してくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "オーナー、あのさ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "ティッピ、さっきの会議ではっきり伝えただろう。私はもう素寒貧なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "もちろん君たちには申し訳なく思っている。だがスタジオも破産してしまって、金券一枚すら出せないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "違うよ、オーナー。お金の話をしに来たわけじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "……ほう？　なら、私に別れを告げに来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "気持ちは受け取っておこう。だが、そう急ぐ必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "私は一時的に会社を畳むだけで、何も今後いっさい映画に関わらないわけではないからな。そう遠くないうちに、また別の現場で会えるだろう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "いや、そういう話でもなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "ならば何の用だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "その……ただ倉庫にしまってる背景画をどうするつもりなのか聞きにきただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "……背景画？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "うん、映画撮影のために作った背景画。全部オフィス裏の小道具用倉庫にしまってあるはずだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "ああ、思い出した、数日前に経理から伝えられたところだ。あの板きれを保管するためだけに、二年間で百五十三万も経費がかかっていたそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "百五十三万……あの板きれを全部木材工場に売り払ったって、三万にもならないのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "あれはもう処分するよう手配してある。工場に持っていくのか、叩き割って薪にするのか知らんが……私にはどうでもいいことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "で、でも、あれはみんなの努力の結晶だし、映画を観た人の思い出にもなってるのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "三流スタジオが作った背景など、誰が気にするというんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "ティッピ、君が優秀な背景スプレーアーティストだということは認めよう。新作の『血濡れのミッドナイト』でも、君の背景画は皆を驚かせた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "正直に言うと、あれらのシーンをこの目で観た時、まさか背景が絵の描かれた板きれだとは信じられなかったくらいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "君は平凡な連中の間では頭ひとつ抜けている。君の能力はスタジオの誰よりも優秀だし、君の絵はより多くの人を魅了できるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "だが、映画『血濡れのミッドナイト』自体は三千万もの大赤字を叩き出した。我々のスタジオ史上最悪の失敗作だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "脚本、監督、カメラワーク、演技……どれもひどいものだ。君がどれほど素晴らしい背景画を描いたところで、どうしようもなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "観客に気に入られなければ、映画は売れない。会社の業績が落ちれば、新作は作れない。どちらも当たり前のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "人は前に進まなければならない。私は十年以上もホラー映画を作り続けてきたが、今こそより幅広い観客の好みに合わせる時だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "君だって自分の作品をもっと大勢の人に見てもらいたいだろう？　ならば、もっと高みを目指すことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "ティッピ、他の奴らは君の出自を知らないが、私は知っている。家に帰って私に言われたことをおじいさんに聞いてみることだ。きっと私の考えに同意してくれるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "もし皆がスタジオの未来について考えていれば、もし皆が時代の流れに乗っていれば……このスタジオも、こんな落ちぶれた姿にはならなかっただろうにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "じゃあ……あたしが描いた背景、一枚だけもらってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "それもだめだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "スタジオは君を雇って背景を制作させ、映画を撮影して何万本ものテープを市場に流通させた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "つまり、映画の画面内に登場する物はすべてエクセルシオールスタジオの所有物だ。もちろん、君が描いた背景もな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタジオオーナー",
      "text": "クルビアの著作権法を読んだらわかることだ。調べてもらっても構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "ティッピはまだ未成年だから、ジュースでいいな……そんじゃ、乾杯。こいつを飲み干して、みんなそれぞれ新天地で頑張ろうぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター＆ティッピ",
      "text": "乾杯。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "ティッピ、もうそんなに不貞腐れんなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "お前が知らなかっただけで、みんな薄々気づいてたんだ。オーナーが俺らの小さいスタジオを畳んで、自分の思い描いてる「大作」に投資するのは時間の問題だろうなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "背景画のことも、そう落ち込むな。これからお前が描くものは、どれもあの背景画より素晴らしいものになるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "大手のスタジオだってお前の実力を認めてくれたんだろ。十分に支援されたら、お前はもっと自分の発想を自由に表現できるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "二人はここをやめたら、どこのスタジオに行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "いい感じのクライアントを何人か知ってるから、よかったら紹介しても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "俺か？　遠慮しとくよ。次は広告撮影の仕事でも探すつもりだ。映画の撮影経験があるカメラマンを求めてる広告会社もあるしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "はは、もちろん俺が撮った映画を観てもらっちゃ困るけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "アイリーンはどうだ？　もう半年も求人広告を調べてたけど、いい仕事は見つかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "えっ、なんで知ってるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "俺もあの求人サイトを使ったことがある。だからたまたまお前の画面が見えた時、すぐに気づいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "そ、そうなのね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "正直、私もこれからどうすればいいのかわからなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "ここで四年間やってきた仕事っていえば、カチンコを打って、シーンの番号を書いて、またカチンコを打って……それだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "だからいざ他の仕事をやれって言われても、なかなか踏ん切りがつかなくて……いっそ地元に戻って何か手に職をつけようかしら。もしかしたら、落ち着いた暮らしのほうが合うかもしれないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "……みんなランクウッドを離れちゃうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "ティッピ、俺はお前みたいな才能もないし、運もない。業界に入ったのが少し早くて、嫌なものをちょっと多く見てきただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "俺にとっちゃ、カメラで食っていけるだけで十分幸せなのさ。だからランクウッドでの仕事に特別なこだわりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "ほとんどのヤツからしたら、エクセルシオールスタジオの仕事なんてただの仕事でしかねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "一つの仕事をダラダラ続けた結果、実は自分に合ってなかったと気付く。そんなのはよくあることだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "ここランクウッドで成功したいヤツは山ほどいるが、本当に成功できるのはほんの一握りなのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "でもみんなと一緒に映画を撮ってきた時間は、あたしにとってすっごく幸せだったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "あたしにしてみれば、二人は大作を作ってる人たちにも全然負けてない。むしろ大手スタジオの人たちよりずっと人間味があるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "だからここでみんなと一緒に、もっと映画を作りたかったな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "二人をクビにする理由なんてないのに……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "そう言ってもらえるだけで十分よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "私がランクウッドに来たきっかけは、学芸会でお芝居が上手だって褒められたからなの。でもここに来てからは、自分は凡人なんだって気づかされちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "でもね、ティッピ。あなたの才能なら、きっとランクウッドの映画史に名を残すスプレーアーティストになれるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "あなたはこの仕事のために生まれてきたの。だから絶対に諦めないで、ランクウッドで頑張って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "それでいつかティッピが賞を取ったら「昔この人と一緒に仕事をしてたの」って、故郷のみんなに自慢できるかもしれないし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "でも……でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "ったく、みんなで一緒に酒を飲みながらオーナーの愚痴を言い合おうって話だったろ。なんでこんなしんみりしてんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "もうバーに残ってるのは俺らだけだし、なんか映画でも観るか。今までみたいに、飲みながら映画を観てだべろうぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "じゃあ今夜は……ティッピに映画を選んでもらいましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "そうだね……じゃあ『バッドボーイ』にしようよ。あたしたち三人で初めて撮った作品。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "おいおい、俺はこれでも一応は映画の趣味がいいほうだぜ。自分が撮ったクソ映画なんざ観たくねぇよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "マシュー、今夜で最後なんだから、ティッピのお願いを聞いてあげようよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "……わかったよ。『バッドボーイ』な。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "古びたプロジェクターが「ブゥン……」と音を立て、少し変色した映像を流す。三人は小さい丸テーブルを囲み、ゆっくりと流れていくスタッフロールを眺めていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "……ぷっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "ふふ、あはははは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "*ランクウッド現場用語*、観てるこっちの方が恥ずかしいぜ！　なんであの男、最後は表彰台にまで殴り込みに行ってんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "撮ってる途中で、誰も脚本家に文句を言おうと思わなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "さ、さあ……たぶん監督は、血みどろのシーンがもう一つ欲しかったんじゃないかな……ふふっ、笑いすぎてお腹痛いよー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "あのシーン……なんで……なんで鼻の穴をあんなドアップで撮ったの？　ふふっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "し、知らねぇよ！　何テイクも撮ったのに、よりによって一番ひどいやつが採用されちまったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "もうダメ……あははは、これは紛れもないクソ映画だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "あはははは……ほんと！　背景も雑過ぎてヤバいよね。まあ、全部あたしが何日も徹夜して描いたやつなんだけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "スタッフロールが流れる度に、画面に飛びついて自分の名前をかき消したくなっちゃう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "流れる度に……って、何回も観てんのか？　俺には無理だ！　こんなの何回も見れねぇよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "えっと、それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "ティッピ、もしかして自分の関わった映画をいつもこっそり一人で観てたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "そ、そんなことしてない！　あたしはただ、この映画のラストシーンが好きなだけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "あの意味不明なシーンか？　ははははは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "違うって。好きなのはあのシーンの背景。ほら、あのボロボロの表彰台だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "二人は覚えてないかもだけど……あの背景画の裏には、スタッフみんなのサインが入ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "え……そんなのあったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "あるよ。『バッドボーイ』を撮ってた時、あたしはまだスタジオに入ったばっかりだった。あの時も資金難で、もうすぐ潰れるぞって言われててさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "元々依頼していた役者さんたちは、ギャラが出ないかもって理由で突然抜けちゃうし。スポンサーも急に降りちゃうし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "そうだったな……あん時はこれが最後の映画になるから、とにかく完成させれば勝ちだって思ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "思い出したわ。あの時、エキストラから一番映える人を選んで、臨時の主演にしたんだっけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "そんでクランクアップの時に、みんなで一緒にサインをしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "あたしたち、ちゃんと撮り切ったんだよ。しかも、意外と興行成績もよくて、昼間に上映してくれる映画館まで出てきたくらいだし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "観客ウケを狙って仕方なくグロいシーンを増やしたけど、結果的には大好評だったじゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "まあ、それからなんとか二年持ちこたえたスタジオも、結局は潰れちゃったけど……でも、あたしたちは一度それを救ったんだよ！　何も達成できなかった負け組なんかじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "ティッピ……俺たちを引き留めようとしてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "励まそうとしてくれてるのはわかるわ。でも、今回ばかりはもうスタジオを救う手はないのよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "ううん、みんなの選択は尊重してるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "でもみんながバラバラになっちゃう前に、もう一回あの背景画のサインが見たいんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "……二人も、見たいと思わない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薄明かりに一つずつ照らし出される、ホコリを被った小道具。それらは映像としてフィルムに焼き付けられてから、ずっとこの場所で眠っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "ゴホゴホッ……どこもかしこもホコリだらけだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "（小声）マシュー、静かにして！　入口にいる警備員に見つかったら大変よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "（口を押さえる）……わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スクリプター",
      "text": "（小声）背景画、全部積み上げたら私の背の何倍にもなるわ……こんなにたくさんの映画を一緒に撮ったのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カメラマン",
      "text": "（小声）フン、こんな分厚い背景画だけじゃねぇ。お前が書いた記録とか俺が撮ったフィルムを積み上げたって、大人の背丈なんざ余裕で超えちまうぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "（小声）見つけた！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三人は一枚の背景画の前に辿り着いた。二年の時が経っていたが、絵に使われた顔料は当時と同じ鮮やかさを保っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "……一緒にひっくり返そう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "ほら見て……これがあたしたちの「輝かしい足跡」だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "「最後の映画」なんて書いてるけど、全然最後なんかじゃなかったよね。だってあたしたちがスタジオを救ったんだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "ここにある背景画は、どれもみんなで一緒に作品を作ってきた証でしょ。あたしたちが撮ったシーンだけで、きっとウォーク・オブ・スターズを埋め尽くせるくらいだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー",
      "text": "うっ……ずずっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーン",
      "text": "マシュー……大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー",
      "text": "い、いや……これは……そう、ちょっと飲み過ぎただけだ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "屈強な男は、必死にすすり泣く声を押し殺そうとした。その隣ではアイリーンも涙目になっていた。\nティッピは二人の手を取ると、ゆっくりと背景画の前まで進んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "『バッドボーイ』のシナリオ通りなら、あたしたちは刑務所を抜け出して、会場にいた悪役を全員殺してから、表彰台の上に立ってるんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "それでは、ランクウッド一番のカメラマン、マシュー・トーマスさん！　そして、ランクウッド一番のスクリプター、アイリーン・ハンターさん！　一言どうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーン",
      "text": "え……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー",
      "text": "そうだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーン",
      "text": "（大声）エクセルシオールスタジオ、*ランクウッド現場用語*！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー＆ティッピ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーン",
      "text": "（さらに大声）ランクウッド、*ランクウッド現場用語*！　*ランクウッドのニッチな現場用語*！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー",
      "text": "……エクセルシオールスタジオ、*ランクウッド現場用語*！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "ランクウッド、*ランクウッド現場用語*！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "三人の声が倉庫で反響する。それが完全におさまると、三人はついにこらえきれなくなり、腹を抱えて笑い出した。"
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー",
      "text": "はは……今日は飲みすぎたな……俺たち全員、飲み過ぎた……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーン",
      "text": "さっきね、ここ数年撮ってきたシーンが、頭の中を一気に駆け抜けていったの。まるで、夢みたいに一瞬で……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "そうだね……夢みたいな時間だった。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ティッピはマシューとアイリーンの手を固く握り、そのまま高く挙げた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "じゃあ、観客のカーテンコールに応えよっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー",
      "text": "（手を高く挙げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーン",
      "text": "（手を高く挙げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "はぁ、これでスポットライトがあれば完璧なのに――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ティッピの言葉が終わる前に、強い光が突然三人を照らす。あまりの眩しさに、全員が目を細めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "誰だ！？　動くな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "そこでじっとしていろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーン",
      "text": "まずい……さっき大声を出したせいで気づかれちゃったわ！　どうしよう？　逃げる……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "……逃げるしかないっしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー",
      "text": "ちょっと待て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "な、何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリーン",
      "text": "もう警備員が来ちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マシュー",
      "text": "どうせもう見つかっちまったし……俺らでこの表彰台、パクっちまわねぇか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ティッピは大きく深呼吸をする。光線が揺れながらどんどん近づいてくるのが見える。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "ナイスアイディア。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その晩ランクウッドの通りに、突如として表彰台の描かれた巨大な移動式背景画が現れた。\n色々と奇妙なことが起こるランクウッドでも、これほど突飛な光景は滅多にない。人々はこぞってカメラを手に、その場面を写真に収めた。\nウォーク・オブ・スターズの歩道を行く表彰台、ホール・オブ・スターズの門を横切る表彰台、映画広場のど真ん中に立つ表彰台……様々な写真が撮られた。\n不思議なことに、どの写真にも背景画を動かす人の姿ははっきりと写っておらず、三つの人影がかろうじてぼんやりと見えるだけだった。\nしかし、その三人の正体について気にかける人はほとんどおらず、動く背景画の件も食事中の笑い話の一つに終わった。\nランクウッドで成功したいと望む者は山ほどいるが、本当に成功を収められる者はほんの一握り。このようなことが起こっても、人々の記憶に残るわけではないのだろう。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
