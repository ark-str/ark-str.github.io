{
  "server": "jp",
  "storyId": "act20side_level_act20side_01_end",
  "groupId": "act20side",
  "stageId": "act20side_01",
  "title": "没入型ツアー",
  "storyCode": "IC-1",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act20side/level_act20side_01_end.txt",
  "sourceHash": "966bf14aff5e834a63fe94b33cbe22b45eb7534d4cf5ccf2c5d98758659c3ed5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "恥ずかしがらなくていいわ、トミミ。とっても似合っているもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ほ……本当ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えへへ、この水着、すごく好みのデザインで一目惚れなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "このお店の仕立職人はすごいわね。こんなにすぐあんたのスタイルに合ったデザインに変えてくれるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "わ、私のスタイルなにか変ですか？　最近はトレーニング量を増やしてるのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "安心なさい、とっても可愛いわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ふぅ、それならよかったです。また尻尾が太くなったなんて笑われたくありませんから……イナムは水着を選ばないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "私はいいわ。むしろ、さっき仕立職人のお手伝いをしてたあの金属頭の方が気になってるのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ドゥリンの技術ねぇ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "いやー、サイッコーだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "こんなに芳醇なお酒を飲んだのは初めてだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少し酔ったドゥリン人",
      "text": "ほら、兄弟、ぐいっと！　あんたの健康を願って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "僕たちの健康を願って、乾杯！　カールミード万歳！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ちょっとトミミ、あのエリジウムとか言うやつ……本当に頼りになるの？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "えーっと、エリジウムさんはですね……いざという時にはとってもすごいんですよ。\nきっと！"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そういえば、ロドスにもドゥリン族のオペレーターはいますけど、皆さん自分の故郷については一切話しませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "もしかしてドゥリン族には何か秘密があるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "いえ、単純にあまり気にしてないだけだと思います。食堂のランチメニューへの関心の方が、大きいように見えますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "そうなの？　……それにしても、まさか地下に建てられたドゥリンの都市に来ることになるなんて、思ってもみなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうですね。もしかしたら、ガヴィルさんの名前をドゥリン人にも広める絶好のチャンスかもしれません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんた今回の休暇は、ガヴィルやズゥママ、それとクマールを連れてこなかったのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "クマールは、ブレイズさんと特訓をしたいそうです。ガヴィルさんとズゥママは任務からまだ帰ってきてなかったんですよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "最近のガヴィルさんは、かなりお疲れみたいで心配なんです！\nあまり無理しないでほしいのですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私、出発する前に二人宛に手紙を残してきたんです。イナムたちがスディチさんに出会ったことと、スディチさんが話していた内容を全部書いておきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "二人ともこの機会にアカフラに戻ってきて、少し休めればいいんですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あの二人は──それにあんたもだけど、あの時有無を言わせず私を大族長にしたんだから、私が長い間頑張った成果を確認する義務があるんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あと、さっき話がそれたけど、エリジウムのこと、普段ロドスでウザいと思ったことなかったの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "うおお、これまたぜんっぜん違う風味だね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひどく酔ったドゥリン人",
      "text": "ノッポの兄さん、さっきあなたがあのミード好きの奴らと一緒にいるのを見たけど、よく聞いてちょうだい。あんなのはお子ちゃまの飲み物よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひどく酔ったドゥリン人",
      "text": "うちのセブンススピリッツを味わわないと、お酒を飲んだとは言えないわよ！　ほら、乾杯よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "カンパーイ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "この香り……大雨の後のジャングル、それに地下洞窟にあるコケの味わいがするよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ひどく酔ったドゥリン人",
      "text": "あっ！　ごめんなさい、木のコップがちょっとカビてたみたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "どうやら彼しっかり楽しんでるみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ところでイナム、スディチさんとはどこで会ったのか、まだ教えてもらってませんでしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "うーん……それを話すと長くなるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮するアダクリス人",
      "text": "大族長！　前に持ってきてくれたアレはマジですげぇぜ！　夢中でいじってたら、何日も徹夜しちまった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮するアダクリス人",
      "text": "ここ数日嫁がずっとうるさくてよ、あんまり夢中になり過ぎてたら魂まで吸われちまうぞって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "大げさね。クルビアで廃棄された旋盤機くらいで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮するアダクリス人",
      "text": "大げさじゃないって！　伝説に聞く、機械を作る機械だぜ！　あれが回転する振動を間近で感じたことがあるか？　嫁と付き合ってた時ですら、あんなに激しく心臓が跳ねたことはないぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あら、近いうちにその旋盤機に緩衝装置を付けてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "それよりあと数日でトミミが帰ってくるから、さっさと準備して。迎えに行くわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いたアダクリス人",
      "text": "トミミを迎える？　そいつはかなりの重労働になるだろうな、想像がつくぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘆くアダクリス人",
      "text": "旋盤で頭をガンガン揺すられるくらいのヤバさだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いたアダクリス人",
      "text": "あいつがどれくらいのコレクションを持ち帰ってくるか、わかったもんじゃないしな！　前回送ってきた荷物は何人がかりで運んだか覚えてるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いたアダクリス人",
      "text": "オレはてっきりキャラバンなんじゃないかと勘違いしちまったぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘆くアダクリス人",
      "text": "昔っからトミミは、ゴチャゴチャしたものを集めるのが好きだったけどよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘆くアダクリス人",
      "text": "あいつ、ロドスに行ってからのここ数年で、さらに酷いことになってねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いたアダクリス人",
      "text": "ガヴィルが殴って穴をあけた鋼板まで送ってくるんだぜ？　マジで意味がわからねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嘆くアダクリス人",
      "text": "ロドスの宿舎には入りきらないとか言いやがってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "待って、あそこに誰かいない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こんなとこにわざわざ自分から来るなんて、オレは気が狂ってるのかもな。ぐねぐねよくわからない洞窟を抜けたと思ったら、こんな最悪な場所に出るし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "アースハートのじじいも煩すぎるんだよ。毎日毎日扉を塞いではグチグチグチグチと……チッ、このツル、ムカつくな！　あの太陽もなんなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "やっぱり人工光源の方が全然マシ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "喉が乾いた。眠い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "師匠がどうしてゼルウェルツァを去ったのか全く理解できないよ。苦労するだけじゃんか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あら、子供？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供？",
      "text": "誰が子供だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "うーん、変ななまりね、誰から教わったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供？",
      "text": "独学だよ、文句あるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "他人と話す時はそんなカリカリしてちゃダメよ。子供は礼儀正しくなくちゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "変な格好してるな。アカフラにこんな奴いたか？　どっかの迷子の子供か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "太い尻尾でも、細い尻尾でもねぇし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "リーベリでもフィディアでもないわね。いえ、待って、もしかしてあんた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ドゥリン人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "ドゥリン？　ドゥリン人ってのは何人だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "私も雑誌でしか見たことがないわ。確か、地下で生活する不思議な種族らしいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "それってハガネガニじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハガネガニかも？",
      "text": "誰がハガネガニだ！　アンタ殴られたいわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "あっ！　思い出した！　数年前『奇談怪論』で特集してたな。地下のドゥリン人は、酒造りの腕がすげーって。てことは、ハガネガニとはちょっと違ぇみてぇだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "ハガネガニだったらせいぜい発酵した果物を食って酔っぱらう程度だもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "それにハガネガニも地下で生活してるわけじゃないわ、ただ土の中に体を埋めるだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハガネガニではない人",
      "text": "重要なのはそこじゃないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハガネガニではない人",
      "text": "ハッ！　やっぱり、地上人は見識の狭い傲慢な奴らの集まりだね。なんにも知らないくせに自分の浅い考えをひけらかすのだけは得意だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハガネガニではない人",
      "text": "バカなドゥリン人よりもバカじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハガネガニではない人",
      "text": "チッ、何より、センスがひどすぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ちょっと、ドゥリンの坊や、言っとくけど私の服はサルゴンで一番流行ってるスタイルよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの坊や",
      "text": "「流行ってるスタイル」なんてのを選んでること自体が、ひどいセンスの証明だよ。他人に決められた美の定義に、一体何の価値があるっての？　みじめに後追いしてるだけじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "大族長、このガキちょっとシメてやった方がいいんじゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "子供相手よ、やめなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの坊や",
      "text": "オレはとっくに成人してる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成人ドゥリン？",
      "text": "はぁ、オレは何でこんなバカどもと話してるんだろ……じゃあね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "あっ、あのガキンチョ行っちまいやがった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "ん？　戻ってくるぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成人ドゥリン？",
      "text": "あのさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成人ドゥリン？",
      "text": "……コホンッ、えーっと地上人さん、もし嫌じゃなかったらでいいんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成人ドゥリン？",
      "text": "ちょっと水を飲ませてくれない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それで、ドゥリン人の都市が困ってるから、私たちの力が必要だって言われたんですか？　あなたからの手紙に書いてあったのはその方のことですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "少なくともあの時、スディチはそう主張してたわ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "でも周りを見てみなよ！　こーんな綺麗な都市のどこが……\nゲフッ！　どこが困ってるっていうのさ？"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "うーん、確かに酒が美味しすぎるっていうのも困りものかもね……簡単に酔いつぶれちゃうからさ。でも僕は酔ってなんかいないよ、ほらカンパーイ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "多分このひねくれ者のチビちゃんは、僕たちを彼の綺麗なおうちに招待したかったんじゃないかな？　その気持ちわかるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "みんながあんたと同じ思考回路だと思わないことね、エリジウム。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "スディチは私たちの所で一ヶ月滞在してる間に、アダクリス人たちが機関車を作ってるのを見たのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "そして彼はこう言ったわ。ええと、「なんだ良いものがあるじゃないか！　アンタらが作った鉄のデカブツはすごく役に立ってくれるはずだ！　ゼルウェルツァに来てくれないか？」ってね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "君はそれで──ねえねえ、残りを今すぐ飲んじゃうから、もう一杯注いでくれるかい？　なみなみでお願いするよ。\n──君はそれで引き受けることにしたのかい？"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "ええ。スディチは、危険な状況をかなり誇張して話してたけど……正直言うと、引き受けたのは私自身の好奇心によるところが大きいわ。ついでに地下の隣人と商売ができないかと思ったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ちゃっかりしていますね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "アカフラが今の未開の状態から抜け出そうと思ったら、何もかもが足りないのよ。ドゥリン族の製錬や製造技術は優れていると聞いたわ。力になってあげれば、引き換えに何かが得られるはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "あんたたちも、少しばかりのスクラップが手に入った程度で大興奮しなくて済むわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "イナム……ちゃんと大族長してるんですね！　てっきり毎日街へ買い物に行って、お金を使い果たしちゃってるんじゃないかと思っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "この子ったら、普段そんなふうに私を見てたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "アカフラが発展していくために一番重要なのは、もちろんお金よ。サルゴン金貨でも、クルビアン金券でも、ヴィクトリアポンドでもいいけど……私たちにとってはどれも必要なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "だけど今のアカフラの生産物──粗末な手工芸品や、未精錬の鉱石程度では、お金を稼ぐどころか、皆に良い生活させるのもギリギリよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "まあ幸いだったのは、都市で定義されているような「良い生活」に皆が関心を持ってなかったことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "でも、お金と富は違うわ。ただひたすらお金や財宝を蓄えても何ももたらさない。流通させて初めて「富」と呼べるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "アカフラは今、良くなってきている。そしてもっと良くなるには、何かきっかけが必要なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "例えば、ドゥリン人との技術協力とかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ううっ、話がわからなくなってきました……とにかく私としては、困難にぶち当たったらアーツを使えばいいんです！　アーツがダメならアーツユニットでぶん殴ります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "これが私たち「ガヴィルウィル」の生き方です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "フフッ、あんたロドスにこれだけ長くいるっていうのに、まだそんなやり方なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "はぁ。だけど私にできるのもこういう細かいことくらいなのよ。本当にアカフラを発展させたいなら、「リーダー」が必要よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "大族長のイナムがいるじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "リーダーっていうのはあんたたちティアカウを一つにまとめられる人物のことよ。私？　私はそんな面倒事は嫌よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "そんな暇があったら、街をぶらぶらしに行きたいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ナイスアイディアだね！　僕も街をぶらつくのは好きだよ。でも野外の方がもっと好きだけどね、ゲプッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "そういえば、あのやかましいおチビちゃんがさっきから見当たらないね。どこかへ遊びにでも行ったのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "何か準備でもしに行ったんじゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "text": "うーん、でも巨大滑り台が目の前にあるわけだし……ちょっとくらい遊んでも問題ないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "わ、私、ロドスで炎国の方から、この状況にピッタリなことわざを聞いたことがあります！　えーと、「客は主人の便宜に従う」……だったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "意味は、「主人がいないなら、客は好きに振る舞っていい」ってことだと思います。多分！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "ゲプッ！　いい言葉だね！　だったらもう一杯飲まないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "text": "よーし君たち、誰が一番早くあのスーパースパイラルスライダーにたどり着けるか競争しよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……エリジウムさん、あっという間にドゥリン人の生活に馴染んでますね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "はぁ……はぁ……やっとあの酔っ払いたちから逃げられた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "だから考えなしに行動するドゥリン人は嫌いなんだ！　あいつらは大切な命を無駄遣いしてるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "たった一ヶ月離れてただけなのに、ゼルウェルツァはまた一段とブサイクになってるじゃん！　やっぱ帰ってくるんじゃなかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "で、あの間抜けな地上人たちはどこ行ったんだ？　チッ、あいつらが崩れない鉄道橋を作れるってんなら、要求を低くしてやれないこともないのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリンの老人",
      "text": "おお、スディチか？　本当に帰ってきたのか？　酒も飲まんドゥリンがゼルウェルツァをうろついてると聞いたが、やはりお前だったか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "エッジ・アースハート……アンタもほんとしつこい奴だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "今までどこへ行っていたんだ？　この老いぼれもあちこち探し回ったんだぞ！　もう少しで、決死の覚悟で山のトンネルまで突入するところだったんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "アンタみたいなしぶとい人間が死ぬわけないだろ？　っていうか、死にそうだったのはむしろこっちだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "お前まさか……地上へ行ったのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "なに、ダメなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "スディチ、思いもしなかったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "な、なんという度胸だ、まさかお前に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "お前にそんな甲斐性があるなんてな！　さぁさぁ！　どんな珍しいものを持ち帰ってきたのか見せてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "あの昇降機の上の洞窟は道が険しくて、地図も行方不明だから、地上へ行こうとする者は何年もいなかったというのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "何かしらの土産はあるのだろう？　遠方の鉱石標本か？　地上の酒造用の植物か？　もしや『奇談怪論』最新号か！？　図書館にあるのはもうずっと昔のものだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "全部違う。えーっと、なんて言うか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "人を何人か連れ帰ってきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「そして彼女は選択した……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「彼女は選択したのだ、カールミードを！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "うーん、あまり良い出来とは言えませんわね。商品名の登場が少し遅すぎるかしら？　ちょっと方向性を変えてみましょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「お得を超えるお得さ、クレイジーを超えるクレイジー具合！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「全力でエンジョイできる場所、思いっきり遊べる一時、そこにはいつも、心を癒やす一杯のミード──」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "「ゼルウェルツァのカールミードをご賞味あれ！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "考えるループス",
      "text": "うん、単純明快でストレート。クライアントもきっと満足するわ。そう願っておきましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
