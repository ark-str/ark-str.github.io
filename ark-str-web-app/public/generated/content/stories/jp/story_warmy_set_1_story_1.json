    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "（メガホン）夕飯は食べ過ぎないようにしてくださいね。皆さんのためにお菓子をたくさん用意していますから！"
