      "type": "dialogue",
      "speakerName": "ラジオ局事務員",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "お前――"
    },
    {
      "type": "dialogue",
      "speakerName": "家具工場大工",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "なんだ？　やんのか？　いいぜ！"
