{
  "server": "jp",
  "storyId": "story_hamoni_set_1_story_1",
  "groupId": "story_hamoni_set_1",
  "stageId": null,
  "title": "孤独なダンサー",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_hamoni_1_1.txt",
  "sourceHash": "f1d38d2affa31718c66977288883a2db47bfec8c68945988ef597fd71904ba69",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "久しぶりね、ロックスレイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "ロックスレイ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "――ああ、親愛なるリタ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "こうして話すのも久しぶりね。前のように同室のルームメイトになれなくて、本当に残念だったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "前衛学校の軍事化訓練は、想像よりもずっと大変だと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "……ロックスレイはあの日、入学試験に間に合ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "ゴホッ……どうしたの急に？　間に合っていなかったら、ここにいるはずがないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "……そうよね。ほら、ロックスレイが貸してくれた『軍事科学概論』。中にあった書き込みとメモ、とても役に立ったわ、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "試験当日の朝に返すつもりだったけど、いくら待っても来なかったから。それがずっと気掛かりだったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "この後、一緒にディナーでもどう？　ゆっくりお喋りできるし、ついでに休日用のロングスカートも選んでもらいたいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "残念だけど、今からステファニー主催のダンスパーティーに向かうところなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "あのリターニアの伯爵令嬢の？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "確かに彼女の人脈は広いと聞くわ。商人も音楽家も劇作家も、名を広めるには彼女と繋がりを持つことから始めるのが正解だと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "前回会った時は、ヴィクトリア軍参謀の孫娘が主催するパーティに向かうところだったわね。社交場を通して周りと距離を縮めてくれる人物を育てるのも、軍事家系にとっては大切だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "だけど、それはロックスレイが目指しているものと関係あるかしら？　あなたはずっと、騒がしい社交場は好きじゃなかったはずでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "そんな言い方はよしてよ、リタ。私はただダンスが好きなだけ、それじゃだめ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "……そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "じゃあ、今度また時間がある時に、お喋りしましょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "そんな不機嫌そうな顔をしないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "私たちどっちもまだ、新しい環境での生活のリズムを掴むのに少し時間が必要なの、そうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "（鼻歌）……ダンスのステップを掴むのと同じ。でも、あなたがそばにいなくて本当に残念だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "……ロックスレイ、どうして私たちが王立前衛学校に合格するために、あんなに努力したのか覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "もちろん、優秀な軍人になるためよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "ええ、将校でも軍事貴族でもなく、軍人なの。私は父のような保身しか頭にない人にはなりたくないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "そしてロックスレイは、先生のような秩序を重んじる軍人を目指しているのよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "つまり、えっと……もし悩みがあるのなら、ちゃんと相談してほしいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リタ",
      "text": "先生が亡くなってから、私もロックスレイもまだお墓参りに一度も行ってなかったわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "……本当にごめんなさい、リタ。私、そろそろ行かなきゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "新聞にはこう書かれている、「ロンディニウムとカズデルの経済文化交流協会」ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "どこの大公爵様の仕業かは分からんが、サルカズの傭兵をぞろりと集めて、駒としてロンディニウムに置きやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "私はそう思わないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "おっと、その辺にしておくんだ。何か内情をご存じだとしても、俺の耳には入れないでおくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あら、ヴィクトリアを支配する可能性が高い大公爵が誰か、獅子王の末裔の行方について貴族の間で流れている噂、それと今後暴動が起きるかもしれない都市についてとか……少しも気にならないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "そんなことを知ってなんの得になる？　あんたがどの市議員の家庭教師なのかさえ知りたかないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "まぁ、家庭教師って身分も、もう過去のもんだろうがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ええ、昨日最後の授業を終えたばかりだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "幼い坊ちゃんも十分な知識を習得したし、私はもう用済みよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "ハハッ……十分な情報を手に入れたのは、あんたの方なんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "私の上司が壁に飾る勲章をもう何枚か増やすために、ここ一帯の業務を直々に担当すると決断を下すのに十分だった……ってことかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "コ、コホンッ……俺は他人様の事情を、むやみやたら討論するほど野暮じゃないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "でもよ、そうやって手柄を横取りされないよう、何か対策をしといた方がいいんじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "いつものことよ。気にする必要なんてあるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "それよりも、ファッション誌を頂戴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "あいよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "今後来る客の中に、あんたの特製コインを持っている奴がいれば、この雑誌を売ってやる。そういうことだよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "橋渡しはもう済んでいるから、手違いが起きることはないわ。だから安心しなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "それに、あなたは何も知らない。目をつけたところで、何もできないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あなたの平穏な暮らしは何一つ変わらない。ただ私から約束の報酬がもらえるだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "へへ、俺のことをよく理解してるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "この金のおかげで、息子たちをもっといい学校に行かせられるよ。これであいつらは本物の紳士になれるだろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞露店オーナー",
      "text": "ところであんた、軍人の気配を消すのに、どれくらい時間がかかったんだ？　知り合いの将校たちは軍服を脱いでいても、軍人の独特な雰囲気を感じ取れるのに、あんただけは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "軍人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "……確かに私は軍に属しているけど、自分が軍人だと言った覚えはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "さて、パーティーに招待されているから、そろそろ行くわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "たとえいつの日か、周辺の都市が丸ごと崩壊しても、聖王会西部大広間が血の海と化しても、巻き込まれることなく変わらない生活を続けられる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "そういう上品で優雅な賢い人間は、うんざりするほど見て来たわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "さて……諜報員はどんな情報をくれているのかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あれ、この手紙……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "開封された痕跡がある……メモが挟んであるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "「……あなたの正体を知っています。ですが私はヴィクトリアの敵ではありません」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "この一言だけじゃ、協力者なのか、私を捕まえるつもりか判断つかわないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "だって誰もかれもが、「ヴィクトリアのため」だと主張するもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "獅子王を吊るした人たちも、最後まで王室を守っていた人たちも、全員自分こそがヴィクトリアのために動いていると信じていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "もし全員の目指す方向が一致していたら、私のようなスパイも必要ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "この手紙の差出人の目的を突き止めるためにも、今夜のパーティーで追加のメッセージを送る必要があるみたいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "噂好きな貴族",
      "text": "聞きました？　市議会の偏屈者のうち、やっと二人が蒸気戦車を追加で生産することに同意したそうですよ。それに合わせて、工場の制限を緩める法令も打ち出すとのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おしゃべりな商人",
      "text": "ハハッ、連中に使った金は少なくとも無駄にはならなかったということですな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おしゃべりな商人",
      "text": "年を取れば取るほど、人は保身に走るようになる。軍隊が武器を仕入れるのは当然なことなのに、連中はどこの軍隊が誰と戦うつもりなのかについて、聞かれるのが怖いのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おしゃべりな商人",
      "text": "獅子王がいなくなってからというもの、その類の質問にはどんどん答えにくくなってきておりますな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "噂好きな貴族",
      "text": "ええ、まったくです……ちなみに、先月病死したあの年老いた議員のことは覚えていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "噂好きな貴族",
      "text": "微かな悲鳴が響いていたと、近所の人が言っていましたよ。果たして本当に病死だったのですかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おしゃべりな商人",
      "text": "権力を手放そうとしなかった老いぼれたちの末路ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おしゃべりな商人",
      "text": "さぁ、ホールの方へ向かいましょう。ぜひとも一杯付き合ってください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "陰謀、賄賂、暗殺……いつも通りね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "そろそろあっちのベランダで、「お友達」に会って来ようかしら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "こんばんは、アルモニさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "少しお時間をいただけませんこと？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "私は忙しいの。だから無駄な話をしたら、私のアーツで水を気管に流し込んで、息の根ごと黙らせてやるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "ずいぶんと察しがいいですこと。本当、恐ろしいですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "呼吸が一切乱れていないわ。ちっとも怖がってなんかいない癖に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "私のことを誤解なさっているようですわね。あなたの情報網にメモを紛れ込ませたのは、脅迫するためではないですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "じゃあ、どういうつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "あなたにご挨拶を申し上げるよう、とある侯爵から仰せつかったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "……私に協力するつもりなら、せめて有益な情報の一つでも提供するべきじゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "いえ、私があなたに提供するのは新しい居場所です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "あなたほどの才能の持ち主を、とうに朽ち果てた獅子王軍のために働く諜報員にしておくなど、あまりにもったいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "あなたも、数年前に犯した些細な過ちのために、負い目を感じ続ける必要などありませんわ。それに、あなたは一切事情を知らなかったのですから、過ちを犯したとすら言えないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "……だけど、彼らは例の件を隠蔽するために、とても良くしてくれたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "それよりあなた、知りすぎてるわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "先生、ただいま戻りました。手紙、ちゃんと届けてきましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "明日の入試に備えて、アーツテストの対策でいくつか確認したいことが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "……誰もいない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "先生？　どこにいるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "……金属がぶつかり合う音。先生のサーベルの音だわ！　まさか強盗に襲われているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "戦闘経験が豊富な先生なら、強盗数人を相手にするのなんて余裕のはず。でも、ちょうど力試しがしたかったし、これはチャンスよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのない声",
      "text": "……密売組織の者共は全員無力化した！　これより倉庫の調査を開始しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "先生……ホーリー先生？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのない声",
      "text": "残党を発見しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのない声",
      "text": "武器を下ろして両手を上げろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "……あなたたち、誰なの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "厳しい将校",
      "text": "取り調べは終わったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "はい、彼女はホーリーの生徒ですが、軍事物資の密売については何も知らされていなかったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "何度か双方の取り次ぎ役になったことはありますが、彼女はあくまでホーリーに言われた通りに手紙を届けただけであり、その内容も知らなければ、怪しんだこともなかったとのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "ホーリーは退役後、私立貴族学校の教師として働いていました。直近五年間での規定違反の記録はく、生徒からも尊敬される教師だったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "そして、彼女が覚えている限りでは、ホーリーが生徒を仲間に勧誘していた素振りは見られなかったとのことです。他の生徒を調査する必要性はないかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "倉庫前で捕らえた生徒は、既に二日間拘束されています。取調べに素直に応じてくれた様子からして、嘘をついている可能性は低いでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳しい将校",
      "text": "では、彼女を連れて来い。上からの指示通りに実行する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "厳しい将校",
      "text": "状況は把握しているな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "先生は重大な罪を犯し、私も知らず知らずのうちにそれに加担していた……という認識で合っていますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "その……先生はどうなるのですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳しい将校",
      "text": "彼女は取調べに非協力的で、挙句の果てに暴れ回って抵抗した。死刑は免れないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳しい将校",
      "text": "軍事物質の密売について、我々は一年以上もの時間をかけて調査し続けてきた。軍隊に広い人脈を持つホーリーが反抗の中心人物なのは間違いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳しい将校",
      "text": "彼女にあまり同情しない方がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "……ホーリーは、良い教師だったのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "先生は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "堅い意志を持つ強い方でした。私はそんな先生の強さに憧れていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "先生から学んだことは、礼儀作法や会話技術の練習よりも、ずっと価値のあるものに感じられました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "なのに、裏でこんなことをしていたなんて……しかも、失敗して命まで落とす羽目になるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "……少し意外でした。それだけのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "私が尊敬していた人も、所詮この程度の者だったのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "急にこんなことになってしまって、ショックを受けるのは仕方のないことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "でも、どうか安心してほしい。君は部外者だ。罪に問われることは決してない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "ただ、唯一事情を知っている一般人として、この事件の真相を口外しないことを約束してくれるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "君の名前はこれから、ホーリーと密売に関与した他二名の兵士とともに、今回の軍事作戦の協力者として記録される。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "彼らは「勇敢にも敵に立ち向かい命を落とした英雄」だ。ホーリーの死について、同級生や他の教師に何か訊かれたら、そういう風に答えるのだよ、いいね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "彼らには、勲章も授けられることになっている。これは君の尊敬する先生の名誉と尊厳ある死を守るためなんだ。どうか分かってほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "はい、言ってはいけないことはちゃんと把握しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "君の理解を得られてとてもうれしいよ。もちろん、協力してくれたお礼はさせてもらうとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "お礼？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "供述によれば、君は前衛学校の入試準備のために、ホーリーを訪ねてきたそうだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな将校",
      "text": "王立前衛学校に入りたいかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックスレイ",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "私はたまたま当時の軍に所属していた、真相を知る者の一人にすぎませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "私と昔話を語り合うために来たのなら、残念だけど無駄足だったみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "何年も昔のことなんて、もうよく覚えていないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "その記憶が薄れてしまうほどの境遇が、私には心苦しいのです。前途有望な若者が、本来得られるべき栄誉を与えられていないのを見過ごすことなんてできませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "あの事件の後から、人生の決定権がもはや自分にないことを、あなただってもう既に気付いているはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "確かに前衛学校には無事、入学できました。ですが、在学中に身分と名前を変えられ、無理やり諜報員にさせられては、まともに人間関係を築くことすら叶わなかったでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "ですが幸いにも、侯爵様はあなたの能力に一目置いておられます。私の推薦さえあれば、侯爵様に直接お会いすることができますわ。頑張り次第では、側近になることだって可能でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "そうすれば、諜報員という身分から解放されると同時に、より高い地位を得られることができますわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "ここまで申し上げれば、信用していただけますでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "……やっぱり、所詮その程度のものよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "……つまり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "今のはただの独り言よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あなたとはこのまま、アーツユニットがちょうど喉に届く程度の距離を保つのが、もっと仲良くなれそうな気がするわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう言うと、アルモニは貴族に突きつけていたアーツユニットを降ろした。"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "――どうぞ、お引き取りを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "もし軍が手放してくれないことを懸念しているのなら、心配はいりません。その対策についても十分に手はずが整っております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "どうしても、私が自分の人生と運命を恨んでいるのだと、決めつけたいようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あなたはよくある錯覚に陥っているわ。陰謀は至るところに潜んでいるの。一見些細なことでも、あなたのような黒幕が後ろで糸を引いている――そうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "諜報員なら、そのような場面はたくさん目にしてきたのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ええ、うんざりしてしまうくらいにね。正直、そういうことをするのにもうんざりしているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "私は誰かに脅迫されてこの仕事を始めたわけじゃない。先生たちが私に声をかけ、そして私はその誘いに承諾した、それだけのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あのね、もし私が本当に自分の人生を決められないのなら、これ以上面倒なことにならないよう、今この場であなたを殺さなきゃいけないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "でも私、あなたのことが好きなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "さあ、今はパーティーの時間よ。だったら楽しまなきゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アルモニは軽やかに身を翻した。\nホールではちょうど音楽隊がお辞儀をし、演奏を開始しようとしている。赤々とした照明が窓ガラスを突き抜け、彼女の顔をくっきりと照らした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "（ハミング）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は思いのまま腕を上げ、くるりとターンを描く。\nそうして一人、庭先で軽快なステップを踏み始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "親切そうな貴族",
      "text": "あなたはこれから……誰と踊るのです？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アルモニと呼ばれているフェリーンから、答えが返ってくることはなかった。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
