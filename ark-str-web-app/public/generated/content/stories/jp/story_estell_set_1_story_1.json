  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "p.m. 9:30 訓練場"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "今日はバブルの稽古に付き合ってくれて助かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "あの子を力で簡単にねじ伏せられる者は、そう多くはないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "遅くまでご苦労だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "いえ……今日はほかに用事もなかったので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ドーベルマン教官、訓練中は厳しいけど、普段はすごく優しいんだよね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（いつも遅い時間まで仕事を頑張ってるみたいだし。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（それにしても、あのバブルって子、ホントにすごかったな。まだ小さな子供なのに。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "はぁ……どこかの誰かさんたちもエステルを見習ってくれればいいんだがな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "腹が減っただろう。少し遅いが、食堂で何か食べてくるといい。私のおごりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ありがとうございます。それじゃあ、お言葉に甘えて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 9:34 食堂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えっと……食料を温めるには……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "この機械を使えばいいかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……動いている音はするけど、料理はあったまってないですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "こっちのほうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "火のマークが描かれてますね。火を使って機械を温めろってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "食料を中に入れて……外から火をつけて……これでいいかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "危なーい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "どうしていきなり爆発したんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "それは……その、使い方が間違ってたから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "どこもケガしてないみたいだね……よかったぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ハッ！　初めて話す子だ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（わ、私、なにしてるんだろう……つい体が動いちゃって……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ど、どうしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（しかもアダクリスだ。新しく来た子なのかな……？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あの、食材の温め方を教えていただけますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "あ、この機械を使うの。こうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "よし……それで5分経ったら、このボタンを押すの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "こっちの壊れた機械は、もう触らないでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "修理届を出せば、担当者が直しにきてくれるから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（私、また変なことしちゃったかな……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（でもドクターもラナさんも、もっとみんなと交流した方がいいって言ってたよね……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（今までずっと、ほかのみんなは先輩だから、プレッシャーのせいで緊張するって、言い訳してきたけど……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（今回はたぶん、新しく入ってきた子だよね……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（うぅ……私ってほんと……ダメダメだなぁ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "エステル、もう食べ終わったのか？　ずいぶんと早いじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "あっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ごはん食べるの忘れてた。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん……もう食べたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（さっきの子、たぶんまだ食堂にいるよね……もう少し待ってから戻ろうかな……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "a.m. 9:22 療養庭園"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "どう？　気分が落ち着いてきたのが分かる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ラナさん、コードネームはパフューマー。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（私は毎日のこの時間に、療養庭園でラナさんのアロマセラピーを受けている。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（まぁ、今ではもう一日の始まりのルーティンワークになっちゃってるかも。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ラナさんってほんとにいい香りがするなぁ。すごく優しいし、こんなお姉ちゃんがいたらいいのに。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "やっぱりエステルには、この香りが一番リラックス効果があるみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "だって……おうちと似た匂いがするから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "そうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "でも、これは花の香りじゃなくて、その……培養液の匂いよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "昔のことを話したくなったら、私もドクターくんも、いつでも聞くからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "もちろん、無理にとは言わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（どうしてこの匂いで落ち着くのか、理由はちゃんと分かってる……小さい時に実験室で嗅いだ匂いとそっくりだから。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（あの頃はまだ角も生えてなかったな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（小さなおうちに住んでいたんだよね。卵型のお部屋の中に、同じような小さなおうちがたくさんあって、アダクリスの子供がひとりずつ入っていた。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（あの人たちは私のことを「失敗作」って呼んでた。それからしばらくして、実験室から放り出されたんだよね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（思い出した……私を捨てたのはダニー・キープって人だった。それまで、朝になると必ずガラス越しに「おはよう、僕のお姫様」ってあいさつしてくれてたのに……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（いい子じゃなかったから、捨てられちゃったのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（それからロドスに入るまで、ずっと荒野で暮らしてた。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "なにか考え込んでいるみたいだけれど、ここにいる時くらいは、香りに身を委ねてリラックスした方がいいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "そういえば、最近、誰かとおしゃべりしているかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "えっと……してない、かな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "無理する必要はないわ。でも、もし誰かと仲良くなりたいのなら、気の合いそうな人を見つけて、おしゃべりしてみるのも悪くないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パフューマー",
      "text": "私にできるのは、少しの間心を落ち着かせてあげることだけ。本当に現状から抜け出したいのなら、自分自身でなんとかしなくちゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "分かった！　ありがとう、ラナさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 2:15 医療部外廊下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブリーズ",
      "text": "また新しい人が入ったそうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリーズ",
      "text": "ロドスの人員は日に日に増えていくわね。ここもずいぶんと賑やかになったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "食堂の列も長くなったしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "人が少なかった頃は新人の面倒も簡単に見られたけど、今では名前すら覚えきれないくらいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリーズ",
      "text": "新人の面倒を見るのが、先輩の務めでしょう！　エイヤフィヤトラなんか、少し前まで「先輩先輩」ってあなたの後ろにくっついてたじゃない。あなたには世話焼きの才能があるのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "羽獣",
      "text": "（嬉しそうな鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリーズ",
      "text": "きゃっ、どういうこと！　羽獣が廊下を飛び回ってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "落ち着いて。あれはエステルが飼っているサー・クレイヘルよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "驚かせちゃってごめんなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（アーススピリットさんも角が生えてる。キャプリニーなんだし、生えてるのは当たり前だよね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（私のよりは細いけど、すごく長い。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ドクターの執務室で、びっくりして飛び上がったりしたら、天井に刺さっちゃったりするのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（仲良くなれたら、角が邪魔な時の対処法について聞けるのに。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリーズ",
      "text": "この子はエステルさんのペットなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ブリーズさん、相変わらず優雅だなぁ……マナーについて教えてほしいな……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（サー・クレイヘルはペットじゃなくて、友達だけどね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（実験室から追い出された後、私を一番最初に見つけて、おうちを開けてくれたのがサー・クレイヘルだった。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（私よりも色んなことを知ってるけど、あんまりお話をしてくれないんだよね。ちょっと口も悪いし。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブリーズ",
      "text": "そういえば、来週は外勤支援任務がいくつか入っているから、またエステルさんの力を貸してもらうわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ブリーズさんは戦場での医療サポートが得意だから、よく外勤任務で一緒になるんだよね。私が緊張してるのに気付いてるからか……いつもすごく丁寧に接してくれるの。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（気持ちはすごく嬉しいけど、ちょっと距離を感じちゃうかな……それに、仕事以外の時は滅多に会わないし……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ドクターには、自分から話しかけるように言われたけど……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ちゃ、ちゃんと……患者さんを保護できるように、頑張るね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（また上手に話せなかった。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "サー・クレイヘル、戻っておいで！　勝手に飛び回っちゃだめ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "そんな風に、みんなに迷惑をかけちゃうと……私たち、嫌われちゃうよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "そういえば……ブリーズさんたち……新人の面倒がどうとか言ってたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "昨日見かけたアダクリスの子も、ひょっとして面倒を見てくれる人がいないのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "もし、また昨日みたいに間違った方法で機械を触っていたら、今度こそケガしちゃいそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "でも……私なんかが……力になれるのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サー・クレイヘル",
      "text": "（意味深な鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "もう、茶化さないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サー・クレイヘル",
      "text": "（優しげな鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ちゃんと治療を受けてるし、療養庭園にも毎日通ってる……それでも同族と顔を合わせるのは、やっぱりちょっと怖いよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "みんなを見るとすぐ分かる……私だけ違うんだって……それなら、みんなもすぐ気付いちゃうよね……私の、この角が変だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サー・クレイヘル",
      "text": "（短い鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ガヴィルさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "確かにガヴィルさんもアダクリスだし、仕事でよく会ってるよ。だけど、ずっと話しかける勇気がなくて……向こうが私のこと、どう思ってるか分からないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "同じアダクリスなのに、ガヴィルさんはすごいお医者さんなの。何をやってもうまくいかない私とは大違い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我人のオペレーター",
      "text": "待った！　待ってくれ！　ガヴィル！　まだ心の準備が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "待つわけねぇだろ！　んなの、瞬きしてる間に終わるって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我人のオペレーター",
      "text": "瞬きってそんな……ぎゃああー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "今日の当番はガヴィルさんかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "怪我人を連れてきた時、ガヴィルさんが当番だと、いつもあんな感じの叫び声が聞こえてくるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "中で一体なにが起きてるんだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サー・クレイヘル",
      "text": "（興味ありげな鳴き声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "待って、今度はどこに行くの――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（あっ、昨日食堂で機械を爆発させて怪我しかけてた子だ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あれ？　あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（見つかっちゃった……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "待ってください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "す、すごい力……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "あっ、しまった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ケガしてないよね……？　ごめんなさい……私、また……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "いえ、大丈夫ですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すごく力持ちなんですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "えっと……うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "いえ、気にしないでください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それより、昨日のことでお礼を言わせてください。あなたが来てくれなかったら、冷たい夕飯を食べていたところでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "私はたまたま通りかかっただけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "まだ用事があるから、じゃあ、また――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あぁー、疲れた。ちょっと患者を見ててくれ。アタシは気分転換に外で腕を伸ばしてくる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ハァー！　空気がうまい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "んあ？　今人影がチラッと通り過ぎていったような？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "疲れすぎて幻覚でも見てんのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ふぅー、もう少しで見つかっちゃうところでしたね。近くに空いている診察室があって助かりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "今度は私が助けてあげましたよ。へへ、これでおあいこです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "へ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさんに見つかったら大変ですもんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ど、どういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "働いているガヴィルさんをのぞき見してたんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（新人さんに勘違いされてるみたい……悪い印象を残しちゃうと大変だから、ちゃんと説明しなくちゃ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "私は別に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私もそうなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさんとは仲がいいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "えっと……たぶん……そうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（仕事でよく一緒になるしね。あまりお話したことはないけど。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "じゃあ、あなたもガヴィルさんは最高だって思ってるんですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ロドスのような場所で医者を務めてる人と、私のような治療を受けるついでに雑用をしてる人とでは、レベルが全然違うから……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（そう考えたら、私なんかがみんなと上手く話せないのも、当たり前だよね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん、そうだね。ガヴィルさんは本当にすごい人だと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それじゃあ、私たちはお友達ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ともだち……私と友達になってくれるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "お互い助け合った仲じゃないですか！　それに、共通点もありますし――ガヴィルさんを尊敬してるってところ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "たし、かに……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それじゃあ、お友達で決まりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "そういうものなんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（新人さんといきなり友達になっちゃった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（早くドクターとラナさんに教えなきゃ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（自分から話しかけたわけじゃないけど、きっと二人とも喜んでくれるよね？　もしかしたら褒めてくれるかも。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私はトミミです、あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "えっと……私はエステル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（落ち着かなきゃ。友達ならまずは日常会話から……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（よし！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それはコードネームですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ううん、本名だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "アダクリスっぽくない名前ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "でもその名前、どこかで聞いたような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "灰かす姫の物語でしたっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "イナムから聞いたことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "幼い灰かす姫のエステルは、悪い人にお城を乗っ取られ、追い出されてしまった。だけど、人生を投げ捨てることなく、一生懸命剣術の鍛錬を続け、どんどん成長していった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "やがて機は熟し、忠実なるサー・クレイヘルに助けられながら、彼女はドレス姿でお城の舞踏会に乗り込んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "舞踏会が最高潮に達したその時、彼女は事前に用意した甲冑を身につけ、サー・クレイヘルが投げてきた大剣を手に取り、見事復讐を果たした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "一説によれば、灰かす姫は目的を成し遂げた後、灰になって消えたそうなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（つい長々と語っちゃった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（嫌われたりしないよね……私、本当に口下手だな……やっぱりあまりしゃべらない方が……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すごいです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "とても分かりやすくまとめられてます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "本当に灰かす姫が大好きなんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん……私もあんなお姫様になりたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（新人さん……怖い人じゃないかも……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（はぁ……角が邪魔で兜を被れないのが残念だな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ロドスの鍛冶師さんはみんな優秀らしいけど、誰とも話したことないしなぁ……戦う時に武器を使わないから、お話をする機会がないんだよね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（でも、これから頑張って鍛冶師さんたちといっぱいお話をして、お姫様と同じ甲冑を作ってくださいってお願いしよう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それなら、剣の練習もしなきゃですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（そうだ。武器の扱い方も勉強しなきゃ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（大剣を使う人に教えてもらうのはどうかな……スカジさんとか……ちょっと話しかけにくい感じだけど……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そういえば、どうして私を見るたびに逃げ出してたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "その……私、自分の見た目に……あまり自信がなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "見た目？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ちょっと背中を向けてみてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "個人的な意見ですが、太すぎず細すぎず……確かにどっちもつかずの状態ではあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それって普通ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "……普通？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "えっと、つまり、あなたは私が普通に見えるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "でも、故郷にいた頃は、たくさんの人に笑われてたよ。みんな、私が化け物みたいだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "その人たちが分かってないだけですよ。個性があった方が魅力的に見えるんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ほら、例えばガヴィルさんなんか──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（え？　ガヴィルさんも昔は角が生えてたの？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "部族のみんなから好かれているんですよ。それは見た目ではなく、ガヴィルさんが多くの人を打ち負かせる、すごい人だからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "なるほ――え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "じゃあ、すごい人になればいいってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうとは限りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "私も考えたことがあるのですが、結局ガヴィルさんがみんなから愛されている理由は、ガヴィルさんがとことんガヴィルさんだからだと思うんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "えっと、よく分からないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "つまり、自分らしくしていれば、自然と誰かが好きになってくれるということです。他人のために、無理して居心地の悪い場所にいる必要はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ほ、本当！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（私の角って、アダクリスのみんなから、そういう風に見えてたってこと？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "昔に読んだ『自信まであと一歩』という本に、こう書かれていました――美しさの基準は常に変化している。だから、一番大切なのは自分が自分をどう見るか、って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "エステルさん、今度時間があったら私に連絡してください。その本を貸しますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "でも、たまにすごく不便な時もあるんだよね。ドクターの執務室に入ろうとして、ドアに引っかかっちゃうとか。灰かす姫を真似して剣を振るう時も、思いっきり動けないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "うーん……確かにそれはちょっと困りますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ですが、体のバランスを保つのはもちろん、武器としても役に立ちますよね？　剣を振るう時は確かに少し邪魔ですが、組み合わせれば攻撃に活かすことだってできると思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "つまり、別の角度から見れば、尻尾だってすっごく役に立つってことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "確かにそうだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（尻尾のことを言ってたのか……誤解されてたみたい……私、自分の尻尾は気に入ってるんだけどな……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（頭の角はすごく重たいけど、この尻尾のおかげで、簡単にバランスが取れるし。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（すごく頼りになる尻尾だよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（でもどうして全く角について触れてこないんだろう……みんながみんな角を気にするわけじゃないのは本当だったんだね……同族でもこんなに話やすい子がいたなんて……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それに私はエステルさんのこと、結構好きですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "本当！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そうですよ。だから友達なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさんほどではありませんが、0.7ガヴィルさんくらいは好きです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "あ、ありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（この子の「好き」の単位はガヴィルさんなのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（0.7ガヴィルさんなら、かなり好感度が高い気がする。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "じゃあドクターは……何ガヴィルさんくらい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "それは考えたことがありませんでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "これから私たち二人で、ロドスの皆さんを採点してみるのもいいかもですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ガヴィルさんを基準にして……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん、わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "約束ですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あっ、ガヴィルさんが部屋に戻っていきましたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "のぞき見を再開しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ごめんなさい……私、そろそろ仕事に戻らなきゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ちゃんと働かないと、ロドスに見捨てられちゃうかもしれないし……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "そういえば、エステルさんの仕事は何ですか？　確か作戦チームのメンバーですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（急に話題が変わった。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（友達同士のおしゃべりってこんな感じなんだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "作戦チームに入ってはいるけど、私の仕事は支援に近いかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "物資を運んだり、患者さんの搬送や負傷者の撤退を手伝ったり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "誰かがケガした時は、私も戦場に突入して、負傷者を抱えて突破するの。その途中で戦闘が発生することもあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "あとは、たまにお医者さんの護衛をしたりとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すごいです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "そうかな？　特別すごいことはしてないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "想像してみてください！　誰かがケガをして敵に囲まれて、どうすればいいのか分からない時に、突如駆けつけてくれたエステルさんの姿を見たら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "きっと輝いて見えるに決まっています。0.9ガヴィルさんくらいに感じるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ほんと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（こんな仕事でも、尊敬されることがあるんだね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "もし病人や負傷者をガヴィルさんの元へ送り届けられたら、もっとすごいと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "0.9ガヴィルさん足す1ガヴィルさんは……えーっと、つまり8ガヴィルさんってこと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "はい。そうすれば、皆さんももっと早く回復できるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "そうだね。これからケガ人は、なるべくガヴィルさんのところに連れて行くようにするね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "でも……その……私、本当に行かなきゃ……もうこんな時間だし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すみません、引き留めてしまって。お話ができてとっても楽しかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "私も。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（これからもずっと、0.9ガヴィルさん分の好感度を保てられたらいいな。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 7:23 エンジニア部"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（友達ができるのってこんなに楽しいんだね。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "おや？　エステル、まだ仕事中かい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "来週、外勤任務があるってブリーズさんから聞いたから、先に物資を車に積んじゃおうと思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "そんなんじゃ残業代が稼げないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "別に大丈夫だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（よく知ってる人とお話するのは、そんなに怖くないな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（グレイパウさんは、ロドスの地上車両ドライバー。ブリーズさんと外勤に出る時は、この人の車に乗せてもらうことが多い。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（車の屋根を改造してもらってからは、車内が広くなって、物資をたくさん積み込めるようになったし、なにより私の角もちゃんと収まるようになったの。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "お子様は終業時間になったら、ちゃんと休むべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "成長期に無理をすると、大人になってからツケを払わされるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "俺を見ろ。最近は首と腰が痛くて痛くてしょうがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "あと長距離をもう何回か走ったら、体がバラバラになっちまうかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "そんなにヒドいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "そりゃあもう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "私、グレイパウさんの役に立てられるかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ガヴィルさん、もう帰っちゃったのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "ほんとか？　もし効くんだったら、マジでありがたいぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "っておい、何す――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 8:20 医療部外廊下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "エステルさん、また来たんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "具合の悪い同僚さんを、ガヴィルさんのところに連れて行ったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "なるほど！　それならガヴィルさんの退勤まで、もう少しかかりそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "一緒にご飯を食べようと思って、ガヴィルさんを待ってるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "私もグレイパウさんの治療が終わるのを待ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "ちょっと待ってくれ！　痛いのは首だけなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "せっかく来たんだからよ、アタシがもう少し揉んでやるって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "やめ……もう痛くないから！　大丈夫だから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイパウ",
      "text": "ぎゃあああ──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "すごく効いてるみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "そうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "治療は激しい方が、効果があるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "それもそっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "なに笑ってるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "ううん、なんでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（やっと友達ができたし、同僚さんの力にもなれたし、すっごく嬉しい。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（素直に気持ちは伝えられなかったけど。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（ロドスでは、角のことを笑われることも、不器用なせいで怒られることもない……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（優秀とは言えないけど、それでも毎日着実に成長しているって気がする。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あっ、終わったみたいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "よぉ、トミミ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ガヴィルさん、私、今日新しい友達ができたんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ほら！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あれ？　いない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "誰もいねぇぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "訓練で疲れすぎて幻覚でも見たんじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（危なかった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（また逃げちゃったよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エステル",
      "text": "（うぅ……まだまだ成長が足りないみたい……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アダクリスの少女は大きく息を吐くと、顔を上げ、二本の角ごと診察室の壁に体をもたれかけた。\n培養液の匂いはしないのに、彼女は今、心の底から安らぎを感じていた。\n船窓の外に広がる濃厚な夜の闇と、そこに散りばめられた星々。この景色は、荒野を渡り歩いてきた十数年の歳月に見てきたものと何ひとつ変わらない。\n今もその荒野の中を進んでいるが、自分には、もうロドスという拠り所があるのだ。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
