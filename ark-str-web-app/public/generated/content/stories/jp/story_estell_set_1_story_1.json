  "groupId": "story_estell_set_1",
  "stageId": null,
  "title": "その小さな一歩",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_estell_1_1.txt",
