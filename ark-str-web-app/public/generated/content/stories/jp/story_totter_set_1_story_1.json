{
  "server": "jp",
  "storyId": "story_totter_set_1_story_1",
  "groupId": "story_totter_set_1",
  "stageId": null,
  "title": "計画",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_totter_1_1.txt",
  "sourceHash": "90ec394e4e8101a82f27e473c2b89bec9d3f9bfa0f7325d99a6ca4626efbf7eb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "開けろこのクソ野郎が！　騙しやがって！　俺の金返せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "とっとと開けやがれってんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "たぬき寝入りしてんじゃねぇ！　早く出て来いや！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "――ハーレンさんか。ドアを叩くのはいいが、もう少し静かにやってもらえないか。ご近所さんに迷惑がかかる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（トターの襟に掴みかかる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "テメェ、しらばっくれてんじゃねぇぞ。そんなに俺がいいカモに見えたのか、ええ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "前払いの時になんつったか覚えてるか？　金曜には片を付けてくれると言ったよな！　今日がその約束の日だ。テメェは何してる？　この荷物はなんだ？　まさかトンズラする気じゃねぇだろうな！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ハーレンさん、ひとまず落ち着いてくれ。すべて終わってから説明する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（ハーレンの手をほどく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "説明だぁ？　説明なんざいらねぇよ。欲しいのは結果だけだ！　今すぐ！ あの畜生どもの首を取ってこいっつってんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（時計を見る）もう少し待ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "五日で充分だって言ってたよな？　もう五日は待った。これ以上何を待つというんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "計画は今のところ順調に進んでいる。もうじき結果が出るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "計画だって？　この四日間、テメェが何をしてたのかおさらいしてやろうか？　月曜はカフェで一息、火曜はポーカー遊び、水曜は市場をぶらついて、木曜はずっと寝っぱなしときた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "そんで今日だ。もう約束の日だってんのに、テメェは何してた？　家にこもってケツを上げようともしてなかったじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（時計を見る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "チラチラ時計見てんじゃねぇ！　こっちを見て話せや！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "まだ動くときではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "なんだって？　テメェ、俺がせっかち過ぎるとでも言いてぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "……そうじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "なっ――強盗どもに何もかも奪われたこの俺の気持ちがテメェにわかるかよ！　余裕ブッこきやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "いいや、おおよその事情は把握しているつもりだ。提示してくれた金額から察するに、あんたは今、ほとんど手持ちがないという状況だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "……ああ、そうだよ！　俺にほんのでも金が余ってたら、テメェが今心配するのは他人の首じゃなく、自分の首だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "まさかそんなことを言われるとは。てっきり良好な雇用関係を築けていると思っていたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（毒気を抜かれ、壁にもたれかかる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "あぁ……俺もあんとき女房と一緒に死んでたらよかったんだ……ここでお前なんかに嫌な思いをさせられるより、そっちのほうがずっとマシだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "……ひとまず白湯でも飲んで落ち着いたらどうだ？　一杯いれてきてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "お前――はぁ、もういい……人の気も知らないような奴に言ったってしょうがねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "多少は理解しているつもりだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "だったら頼むよ、何でもいいから動いちゃくれねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（時計を見る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（首を横に振る）はぁー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "時間だ。一緒に来るか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "は？　なんだ、やぶから棒に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ご要望通り、奴らに血をもって償ってもらうのさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ここだ。乗ってきた駄獣はちゃんと隠したか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "ああ……ってちょっと待った。金出して雇ってんのは俺だぞ。何でお前に指図されなきゃならねぇんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "……そいつはすまなかった。なんなら俺がもう一度縛り付けてこようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "いい！　それよりも、こんなとこまで連れて来て一体何のつもりなのか、そろそろ教えてもらおうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "これを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "なんだ？　望遠鏡か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "そうだ。あそこを見ていてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "……何も見えねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "もっと遠くだ。地平線のほうを見てくれ。徐々にこちらへ近付いてくるキャラバンが見えるはずだ。真紅の布に黒いドクロが描かれた旗を立てている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "……見えた！　奴らだ。間違いねぇ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（クロスボウを引く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "おい、これ使えよ、望遠鏡……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "俺には必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "この距離から撃つのか？　肉眼で狙えるわけが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "シッ──静かに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "よし、任務完了だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "もう……終わりなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ああ。ほかに何か要望があれば応えるが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "何かって、たとえば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "死体を辱めるような真似は、あまり褒められたことじゃないんだが……どうしてもそうしたいと言うのなら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "……全員、ちゃんと死んでるって確信はあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "爆発の及んだ範囲を見る限り、生き残りがいる可能性はほぼないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "ははっ、一人残らずくたばったか。そうか。ざまあみろだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ずいぶん神妙な口ぶりだな。仇討ちを果たせたなら、普通は喜ぶものじゃないのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "俺もそう思っていたさ。だが……こうもあっけなく終わっちまったんじゃ、実感がまだ湧かねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "こんな時に言うことじゃないかもしれないが、報酬の残り半分は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（金貨の袋を投げつける）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "持ってけ、それで全部だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（袋を拾う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "何か言うことはねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "……まいどあり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "……お前さ、一体どうやった？　前に雇ったポンコツどもは一ヶ月かけても奴らの足取りすら掴めなかったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "どうして奴らがこの時間、この場所に現れるって分かった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "実は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "待て、こんなとこで話すのもなんだ。場所を変えよう。一杯やりたい気分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "今はやめた方がいいんじゃないのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "ははっ、どうだろうな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "この街にはな、太陽が昇ったことを祝うため、朝から酒を飲むという風習があるみたいだ。変わってるよな――頼んだ二杯が来たぜ、どっちにする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "かなりサイズが違うようだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "その通り――デカいほうが俺のだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "じゃあ、なぜ俺に選ばせる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "お約束ってやつさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "小さい方をもらおう、どうも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（ジョッキを持ち上げ、一気に半分飲み干す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "くぅ～～……ゲフッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "そんじゃ聞かせてもらおうか、一体どうやったのかをよ。今の今まで何一つ準備してこなかったってのに、ただ時間を待って、あの場所へ出向いて、弓を引いて、ヒュー――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "ズドン！　それで全員をやっつけちまうんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "お前、ひょっとして予知でもできんのか？　それとも奴らの内の一人を買収したとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "勿体ぶらずに言ってくれよな。俺ぁ本当に見当もつかねぇんだ。昨夜訪ねに行ったときは、本気で騙されたって思ってたんだからよ……それが今となっちゃ、お前さんのことは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "チッ――ったく、心から感服ってやつだぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "興奮しすぎだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "酒が入ってるからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "そう難しいことでもないさ。周到な計画を立て、それを一歩一歩着実に進めていけば、たどり着く結果はそう大差ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（ノートを取り出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "あんたは俺がカフェに入れ浸ってたことに不満をこぼしていたが、カフェは街にとって特別な場所なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "行き交う商人たちにとって、そこは言わば……情報の集散地さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "あらゆる情報がそこから拡散される。信憑性のある情報も、ガセ……ゴホン、定かではない情報もな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "胡椒商人",
      "text": "アンタとこの香料の輸送は上手くいってるか？　こっちは別ルートを試してるんだが、ほとんど毎回待ち伏せに遭うんだ……連中、俺らの足取りが手にとってわかるらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "乳香商人",
      "text": "まだどうするか考え中だ。いっそ傭兵でも雇ってキャラバンの護衛を頼むってのはどうだ？　商品を倉庫の中で腐らせておくより割がいいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "胡椒商人",
      "text": "はぁ……首長軍はいつまで経っても掃討しに来てくれないし。こんな暮らしが一体いつまで続くことやら。俺んとこの帳簿はもうこれ以上の赤字には耐えらんねぇよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフェ店員",
      "text": "いらっしゃいませ。何になさいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "コーヒーを一杯頼む。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフェ店員",
      "text": "かしこまりました。お客さん旅の方ですか？　ここの特産コーヒーはコクが深く、慣れない方には苦く感じるかもしれません。ヤシナツメのハチミツ漬けをお付けしますから、お口直しにでもどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ありがとう。でも平気さ、俺は苦い思いをするのには慣れてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ところで、少し聞いてもいいか？　医者を探しているのだが、どこに住んでるのか知らないか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフェ店員",
      "text": "あー、街の東の方に診療所を構えてますよ。噴水沿いに東へずっと歩けば見えてきます。ご病気ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "救急用の医薬品をいくらか持ち余してな。誰か必要な人もいるだろうと思って。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "荒野においては、万能の貨幣ってヤツは金じゃなく、薬だ。情報は既に流した……次は、向こうさんにわざわざ出向くだけの価値が、この俺にはあるということを証明してみせる番だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "もうこんな時間か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "宝飾品商人",
      "text": "あんちゃん、今日はなかなかの負けっぷりだったねぇ！　あんだけの大金をスっちまったんだ。奥さんにバレでもしたら、タダじゃすまないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "あんなはした金、小遣い程度さ。娯楽のための出費ってやつだよ。大したことじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "木材商人",
      "text": "へへっ、あんちゃんみたいな気前のいい男は好きだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "そうかい。じゃあもう一局行くか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "水曜の朝、予測通り俺が住んでる宿の外、窓の下には散らばった足跡があった。一応消されてはいたが、所詮素人のやり方だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ハーレンさん、狩りをしたことはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "動物は大抵自分の縄張りを持つもの。その縄張りの中で餌を探すのにも、遊ぶのにも、見回るのにも独自のルールを持っているんだ。そうした習性さえ把握すれば、罠を仕掛けるのは容易いこと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "商人A",
      "text": "お兄さん、もうここを発っちまうのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ああ、その話題でもちきりだろう？　荒野の盗賊とかいうのが気がかりでな。そんな物騒な奴らがいるのなら、早めにここを出ておくに越したことはないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "それで皆の知恵を借りたい。ここから離れるのにおすすめのルートはないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商人A",
      "text": "正直な話、どこを行ったって同じよ。奴らの手から逃れること自体そもそも無理な話だ。一度目を付けられたら最後、動向が完全に握られちまうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "なんと、他のみんなはどうだ？　奴らと遭遇したことはあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商人B",
      "text": "俺のキャラバンはこの前、街の東にある細い路地から出発した。目立たないしあのクソどももさすがに気づかんだろうと思ったのに、一時間も経たないうちに奴らの待ち伏せに遭っちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "まったく恐ろしい話だな。誰か運良く出くわさなかった人はいないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "商人B",
      "text": "ここ一ヶ月、俺らはあらゆるルートを試してきたよ。辺鄙な路地だろうと、大通りだろうとね。だがどこを通っても、一歩でも街から踏み出せば、そこには避けようのない不幸が待ち構えてるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "商人たちの使用したルートと、彼らが被害に遭った地点とを照らし合わせれば、盗賊どもの行動範囲はほぼ割り出せる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "それをもとに、狙撃に適した場所をいくつかマークした。俺のクロスボウの射程が、辺り一帯を完全に覆うことができるような場所をな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "あとはもう、罠を仕掛けた場所へ獲物を追い込むだけ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "なぁ坊主、小遣い稼ぎに興味はないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "利発な男の子",
      "text": "やります！　どんな内容ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "俺は明日から遠出をする予定だ。十日分の真水と保存食を用意してくれないか。それと日暮れまでに俺の駄獣に飼い葉をたっぷり食わせてやってくれ、夜明け前にはここを発つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ああ、そうだ。先に報酬をやろう。金貨四枚出すよ。明日の朝五時に西の方の出口で待ってるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "利発な男の子",
      "text": "わぁ！　旦那、気前がいいや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "出発前にはしっかり睡眠を取っておきたいから、それまでは探さないでくれよ？　ほら、突っ立ってないで、さっさと仕事に取り掛かれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "利発な男の子",
      "text": "はいはーい、お任せあれ。ご期待に沿ってみせますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "あれくらいの仕事なら、本当は金貨二枚が相場なのだが、俺はその倍を支払った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "あの年頃の子供のことだ。多めに稼げたらあちこちで自慢したがるに違いない。その子が言い触らすのを聞いた人間が多ければ多いほど、俺の目的達成も容易になる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "そうだったのか。だったら昨日もただ寝てたわけじゃねぇんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "いいや、睡眠の時間は確かに確保させてもらったよ。翌日に目を使う仕事が控えてる場合、気力を充分に養うようにしているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（酒を一口飲む）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "そうか……たったそれだけで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "がっかりしたって感じだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "まあな。俺はてっきり、伝説の傭兵のあっと驚くような武勇伝が聞けると思ってた。なのに蓋を開けてみりゃ何だかうちの女房が書いてくれてた企画書みてぇでよ。事細かだが、味気ねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "優れた計画というのは、起伏に富むべきじゃないんだ。無難であればあるほど良い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "あいつも似たようなことを言ってたぜ！　しかもお前みてぇにいっつもノートを持ち歩いててさ、思いついたことをいちいちメモしてたっけなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "いい習慣だ。自分の記憶ほど、信用ならないものはないからな。それで、その奥さんは今どうしてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "連中の手にかかって……ってお前と最初会った時に教えただろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "……すまない、忘れていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "まあいい、過ぎたことさ。少なくとも、あいつはもう企画書なんかで気を煩わす必要はなくなった……最初に俺が無理やり商売に巻き込んでなけりゃ、あいつは今頃、詩人にでもなってるだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "そうか、詩人ってのはいい職業だ。何より、安全だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "正直に言うが怒るなよ？　お前と話してると、なんだかしょっちゅうイラついてくるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "気にしないさ、みんなそう言うよ。むしろ口で言うだけに留まってくれる人はありがたいくらいだ。ほとんどは殴りかかってくるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "ここで何か慰めの言葉をかけるべきだって頭では分かってるが、すまねぇ、俺の感情はいい気味だって言ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "こちらこそすまない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（首を横に振る）まぁこういうこともあるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "お前のノートを見せてもらってもいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ああ、構わないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "ほぉ、随分とデッケェ字だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "俺の目は少し変わっていてな。遠くの物はよく見えるが、逆に、近くの物があまり見えないんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "生活のあらゆることを、事細かに計画立てているんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ああ。大体の筋書きが決まっていれば、いざという時も取り乱さずに済むからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（ノートを閉じる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "はぁ……お前のような人間は、きっとすべてを自分のコントロール下に置いてるのだろうな。少しのミスも起こさず、一分のズレも許さないって感じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "きっと人生だって、思惑通りに順風満帆に進んでいくんだろう。ある日突然、すべてを失うなんてこともないだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（酒を喉に流し込む）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（落ち着かない様子でジョッキの持ち手をさする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "それは違う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "ん、何が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "そんなことはない。俺のこれまでの人生の中で、本当の意味で自分でコントロールできたことなんてほとんどないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（軽く一口飲む）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "哀れだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "やめてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "いや、今のは俺自身に言ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "（ジョッキを持ち上げ、一気に飲み干す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "ごっそうさん、お勘定を――っと、ん？　俺の金は……あっ、忘れてた。全部お前に払っちまったんだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "俺が払うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "悪いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "残りを貰っていくか？　一文無しじゃやっていけないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "へっ、いいってことよ。お前さんが取っとけ。俺にはもうどうせ、使い道がねぇんだからよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "酔ってるぞ、あんた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "っと、ああ、構わんでいい。一人で立てらぁ――じゃあな、相棒。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "♪太陽が落ちきる前に、彼女をこの腕に♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "♪薄紫のベールに包まれし、馥郁たるジャスミンの香り♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "♪その柔らかな唇で、私を導いてくれ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "♪故郷へ、かの永遠の園へ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ちぶれた商人",
      "text": "♪一瞬の痛みで、人生にとどめを刺してくれ♪",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "地平線から昇る朝日――巨大な紅蓮の輪の中へ、よろめく男はゆっくりと歩を進み、やがて消えていった。その背中には意志があり、まるで恋人の熱き抱擁に向かって飛び込んでいくようだった。\n乾いた砂漠の風は彼の歌声を砂で優しく包み込み、丁寧に収めた。次の旅人が現れ、再び喉を震わすその時まで――"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "♪ルイーサ、おお我が心のルイーサ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "♪故郷へ連れ帰ってくれ。君と一緒なら、他に何も望みはしない♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "♪ルイーサ、夢に見しルイーサ♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "低い男性の声",
      "text": "トター、言いにくいことなんだが……お前にはここにいてもらうことになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低い男性の声",
      "text": "我が隊は北上を続ける。その脚の怪我では我々の行軍速度には追い付けまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ここに見捨てていくというわけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低い男性の声",
      "text": "ここは雪境からほど近い。雪景色がとても美しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "俺をここに捨てていくつもりなんだな。そうなんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低い男性の声",
      "text": "金はいくらか残しておく。近くに村があるから、そこで生活に必要な物と交換するといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "回りくどい言い方をするな！　はっきり言え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低い男性の声",
      "text": "トター、俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "アン、教えてくれ。あんたもそのつもりなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な女性の声",
      "text": "そういう言い方はやめて。心の中では解ってるんでしょ？　あなた一人のために留まるわけにはいかないの。私たちにはみんなそれぞれ、果たすべき任務があるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "つまり、俺はみんなに見捨てられたってことか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な女性の声",
      "text": "子供じゃないんだから、そうやって拗ねても何にもならないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "アン、約束と違うじゃないか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な女性の声",
      "text": "未来のことなんて、結局誰にも予想できないのよ、トター……来年の春には隊がここへ戻ってくるかもしれないわ。その時にはまた状況が変わってるかもしれない。だから、あまり気を落とさないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "どうだかな……あんたたちは？　来てくれるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な女性の声",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "……そうか、分かったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "低い男性の声",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "♪ルイーサ、おお我が心のルイーサ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "♪故郷へ連れ帰ってくれ。君と一緒なら、他に何も望みはしない♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "♪ルイーサ、夢に見しルイーサ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "♪ここで君の訪れを永遠に……♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "♪……待ち続けよう♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（残りの酒を一気にあおる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "鍵……鍵はどこだ？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "これか？\nいや、開かないな。これじゃない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "こっちか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "これも違うか……まあいい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（地べたに座り込む）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "……今何時だ？　そろそろ約束の時間のはずだが……外で待つか。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "屋根の庇が灼熱の砂の上に影を落としていた。影は燃えるような熱気と強烈な陽光を遮断し、縮こまったトターの身体を覆い隠した。\n柔らかな風の中、トターはまぶたを開いていられなくなり、ぴたりと目を閉じた。\nそして扉にもたれかかりながら、まどろみの中へと落ちていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "トターさん、トターさん。起きてください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ん……ああ！　何だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お迎えに上がりました！　ここへ来る途中砂嵐に遭いまして、約束の時間に遅れて大変すみません。お待たせしてしまいましたか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（立ち上がってズボンの土を払う）いや、ちょうどいい時間に来てくれたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "ですが……寝ちゃうほど待ってたんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ちょっとウトウトしてただけさ。ついさっき出たばかりで、そんなには待っていないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "そうですか。えっと……どうして、そんな風に笑うのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "（自分の口角を触る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トター",
      "text": "変だな。なぜ笑ってるんだろうな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
