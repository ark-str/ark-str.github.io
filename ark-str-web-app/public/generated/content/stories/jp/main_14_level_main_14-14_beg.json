    {
      "type": "choice",
      "options": [
        {
          "label": "ケルシーが心配だ……",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "W",
              "speakerId": "avg_1035_wisdel_1",
              "isRemote": false,
              "text": "クソババアがこんなにか弱かったとは記憶してないけど、あいつは――"
