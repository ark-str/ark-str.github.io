    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_1035_wisdel_1",
      "isRemote": false,
      "text": "*サルカズスラング*、あたしの目と鼻の先で人をさらおうなんていい度胸ね！"
