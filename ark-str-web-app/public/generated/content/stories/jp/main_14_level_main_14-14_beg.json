    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_1035_wisdel_1",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "speakerId": "npc_10002",
      "isRemote": false,
      "text": "（あざ笑うようにWを見る）"
