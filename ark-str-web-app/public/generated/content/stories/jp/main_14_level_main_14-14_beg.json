    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_1307_1",
      "isRemote": false,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_1307_1",
      "isRemote": false,
      "text": "お前はやはり何も変わらないな、W。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_1035_wisdel_1",
      "isRemote": false,
      "text": "――？"
