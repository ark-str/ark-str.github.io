    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_1035_wisdel_1",
      "isRemote": false,
      "text": "ペットちゃん、そいつを守れなかったら、クソババアにきっとグチグチ言われるわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "speakerId": "npc_10002",
      "isRemote": false,
      "text": "（高ぶった雄たけび）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "こっちだ！　だが壁が分厚くて、爆弾では破れない――",
          "value": "1",
          "blocks": []
