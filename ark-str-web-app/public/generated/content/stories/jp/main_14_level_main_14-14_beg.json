    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "飛空船の「亡霊」",
      "speakerId": "avg_npc_1307_1",
      "isRemote": false,
      "text": "それ以上は進むな。"
