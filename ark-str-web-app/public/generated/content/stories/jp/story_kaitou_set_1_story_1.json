  "sourceHash": "949f267e0d0b56e762a6642bc04aa881ed3c78130133ff3337952988267dc574",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "1098年\nリターニア アインヴァルト管区 グリンデン"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "はあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ようやく目の痛みが治まってきました。これでやっと安らかに眠れるというものです……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "隅々まで探せ！　そいつのデスクに置いてあるものは特にだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "グズグズすんじゃねぇ。鍵のかかってる箱は爆弾でもなんでも使ってこじ開けろ！　本棚も全部ひっくり返すんだ！　その蓄音機もバラして中身を調べろ！　躊躇わなくていい、さっさとやれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "それと、そこのお前――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "大人しく知ってることを全部吐け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……すみません、一体何を話せばよいのでしょうか？　先ほどあなたの部下が壊したあの箱の中身が、顧客から販売を委託された相当高価なものであることくらいしかお伝えできませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "サクソン伯爵様のせいで損害を被ったとでも言いてぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "いえ、とんでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "とぼけた顔をしたって無駄だぜ。目の奥から小賢しさが透けて見えらあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……つまり、伯爵様自らが高塔を下りられ、このような奥まった物陰に建っているようなみすぼらしい小屋にわざわざ来られるほどの事態が起きている、ということですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "であれば、こちらとしても喜んでお力添えいたしましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の用心棒",
      "text": "報告します。怪しいトラップの類いは見つかりませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の用心棒",
      "text": "こちらもです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "フンッ……物分かりがよくて助かるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "全員、部屋を出ろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "君と顔を合わせをするのに、こんな乱暴な手順を踏まないといけないなんて本当に残念だよ、ハインツ。あまり気を悪くしないでくれると嬉しいのだが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "とんでもございません、伯爵様。当店は本日これにて閉店いたしましたので、誰もここには近づかないでしょう。どうぞ安心してお話しください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "……君は察しが良くて助かるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "は、伯爵様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "イーヴェグナーデ様は今年、四年に一度開催される女帝の祭典での献上品として、唯一無二の宝石をご所望になられた。この詔令が下されてから、どれだけの者が血眼になって探し回っているのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "我がグリンデン領が必ずやご希望にお応えすると、私も陛下に約束をしたものでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "あのバイカラーの宝石を手に入れるのに、どれだけの心血を注いだことか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "濃密な黒と透き通るような金が互いを引き立てるような輝きを持った宝石だ。どちらかの色が悪目立ちすることもなければ、僅かな不純物すら含んでいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "完璧な比率と色、そして光沢……それはまさにリターニアの「永遠なる恩寵」と「情なき大権」を象徴する一品だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "私はそれを「双塔の夢」と名付けた。あの宝石のほかに、両陛下に相応しい献上品など存在しないだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "七日後には、宝石を受け取りに女帝の声がグリンデンに到着する。そんな肝心な時に宝石が盗まれるとは何事だ。なんのために貴様らに厳重警備させていたと思っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "そのコソ泥は瞬間移動か、もしくは自分を空気に変えられるアーツでも使っていたというのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "それとも、私が今まで養っていた部下は全員、ただの役立たずだったというわけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "直ちに宝石の在り処を突き止めて参ります！　たとえ移動都市を丸ごとひっくり返したとしても必ずや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "相手が何者なのかも、どんな手段を使ったのかも分からないのに、よくそんなことを豪語できたものだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "……ハインツのところへ行け。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "つまり、伯爵様の依頼というのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "これは依頼ではなく命令だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "お前は以前「双塔の夢」を鑑定したことがある。ならばあの幻想的な色合いと唯一無二の光沢を必ず覚えているはず。あの宝石の美しさは一度見れば忘れられん、誰であってもだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "そこでお前にその宝石を再現してほしいのだよ。あの目を奪うほどの輝きを新たにもう一度造り出してみせよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "し、しかし僕は宝石鑑定の知識しか持ち合わせていませんよ。この研磨機も研究のために用意したものでして、旦那様方の楽器やアーツユニットに装飾用の宝石を取り付けるくらいしかできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "そんな僕が恐れ多くもマイマスターの真似をして、無から至宝を作り出すことなど、とてもじゃありませんが不可能です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "何よりも、よくある模造技術では、女帝御用達の宝石学者の目を欺くのは困難かと。万が一このことが露呈してしまえば僕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "御託はもういい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "私がお前に資金を援助しているのは、お前の精密なカッティングと加工技術の才能を見込んでいるからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "よく聞け。もし宝石界隈にも音楽界と同様に「首席」という概念が存在するのなら、少なくとも現時点のグリンデンにおいてその称号に一番近い人物はお前だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……伯爵様からそのような栄誉あるお言葉をいただけるとは、感激の極みです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "当然、今のその知名度があるのは誰のおかげなのか、決して忘れぬように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "他人を欺くあまりに本当の自分も忘れたのか？　贋作を造るのは今回が初めてというわけでもあるまい。こちらは下請けを一人失おうと痛くも痒くもないが、お前は違うだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "忘れてなどいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "忘れることなどありませんとも、伯爵様。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "おや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "――これはこれは、このような場所でお会いするとは。その服についている明るい色のボタンは、雲間から差し込まれる日の光に照らされると、とても目を引く輝きを放ちますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "ハハーン、こんな薄暗く曲がりくねった路地で、ボタンの光の反射だけで気付かれちまうとはな……へッ、だけどちょいと警戒しすぎなんじゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "伯爵様の護衛に意見するつもりはありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ただ宝石の模造に使うかもしれない材料を持った状態で、高塔の庇護を受けられない平民区を歩いているとなれば、いささか警戒せずにはいられません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "もちろん、これから欺くお方の姿が頭をよぎる度に……背筋が凍るほどのうしろめたさを感じてしまうのも当然でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "せっかく伯爵様の御付きが、こんな場所までお越しになったのですから、ここにある材料が「双塔の夢」に使われているものと近しいかどうか、確認してもらえませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "お前、伯爵様に重用されるだけのことはあるみてぇだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "今回のチャンスを無駄にするんじゃねぇぞ。ことが上手く運び、伯爵様が双子の寵愛を受けられれば、お前もそのおこぼれに預かれるんだからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "チャンス、ですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "大変ありがたい話ではあるのですが、あまりにも恐れ多いチャンスですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "僕はただ宝石の虜になってしまっている一平民に過ぎません。本来なら僕は……偽物造りなどとは無縁であったはずでしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "だけど、そんなお前を伯爵様がどうして目をつけたのか、自分でもよく分かっているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……僕からしてみれば、あれは単なる偶然が重なった結果に過ぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "初めて作ったフェイク品のことは今でも覚えています。いや、あんな粗末なもの、フェイクとすら呼べませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "あの頃はいい原料を使う度胸もなければ、鉛ガラスと樹脂で亀裂を修繕する技量もありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ただあの宝石店で働くしがない見習いとして、鑑定に通すことなくそれをショーケースに陳列することを黙認……あるいは許されていたと言ってもいいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "あの頃はきっと今以上に挙動不審でしたね。いつでも逃げられるよう荷造りをし、自首すべきかどうか毎晩悩みながら夜を明かしたものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "だけど結局バレることはなかった。でなきゃ、ここに立って俺と話しができてるはずねぇからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……あの宝石はすぐにとある男爵が大金を積んで買い取っていきました。ほどなくして、僕もあの宝石店を辞めたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "あとから聞いた話ですが、その男爵の家は財政がかなり厳しい状況にあったそうで、貴族としてあるべき暮らしを取り戻すために、あの宝石に賭けていたのだとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ですが、僕が造った粗末なフェイク品はすぐにその道に明るい者に見破られてしまったそうで。男爵もそのせいで発狂してしまい、それっきり姿を消したのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "僕は本当に運がよかっただけなのでしょう。いなくなったところで誰も気にすることすらない貴族の手にアレが落ちたおかげで、僕は殺されずに済んだのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "ブハハハ！　そりゃただの男爵だしな！　旦那様方の足についておぼこれを預かってるだけの小貴族なんざ、誰も気にしねぇに決まってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "だが俺の聞いた話じゃ、あんた、ある学者のために、そいつのライバルをおちょくったんだってな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "あぁ……その件については致し方なかったというべきか……いや、あれも僕が犯した過ちの一つですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ご存じの通り、僕のアーツユニットの動力源は宝石の破片です。贅沢だなんてとんでもない。そういった欠片はカッティングの際に出る屑石として廃棄されてしまうものですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "だから毎月定期的に屑石が届くようになっていたのですが、ある時なぜか傷一つない宝石が丸ごと入った箱が届いたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "それ、なんでなのか本当に分かんねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "詮索できるはずないじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "人体切断のイリュージョンを演じるマジシャンが、パフォーマンス中に仕掛けの故障に気付き、このままでは助手が真っ二つになってしまうのだと悟っても、恐らく目をつぶり手を下すだけでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "後になって知った話ですが、ある書記官が保管していた宝石をこっそり売り払い、取り戻せなかったせいで厳罰に処されてしまったのだとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "しかしその時……宝石はすでに僕の試験管の中の粉末と化していたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "加えて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "お前のあの偽造鑑定書に伯爵様が気付いちまった、だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "サクソン伯爵様の使者がやってきた時は、てっきり尊き子爵様である甥っ子が失った名誉を、僕に償わせるためだと思っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "お前はただ子爵の要求通り、完璧な鑑定書を書き上げ、平凡な宝石をあたかも世にも珍しいお宝に仕立て上げただけだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "悪いのは身の程知らずなのはサクソン子爵のほうだ。宝石にニセモンの鑑定書をくっつけて、あちこちに見せびらかすとは、とんだお笑い者だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ええ、僕はただ……要望にお応えしただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "その一件で伯爵様は怒るどころか、むしろ理解を示し、なんと今日に至るまで僕を重用してくださいました。このご厚意をどうやってお返しすればいいのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "俺たちの言う通りにしてりゃいいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "お前のそういう臆病なとこも伯爵様から気に入られてる理由のひとつだ。ハインツ、小賢しい考えは持つな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "無駄話はこんくらいにしとこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "三日後には女帝の声がグリンデンに到達する。もし俺たちの献上品に少しでもキズがついてりゃ、伯爵様が住まう塔であっても更地にされちまうだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "つーわけで、そろそろ作業に戻ってくれや、ハインツ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "今の僕があるのは、伯爵様のおかげでもありますが、実はもう一つ宝石にまつわる出来事も関係してましてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ある採掘場が原因不明の爆発によって崩落してしまった話なのですが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "だけど、貴族ですら生死を気に留めてもらえないのであれば、哀れな一般人についての話など……口にする価値がどこにありましょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "（口笛）♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "（口笛）♪♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "その粗末な口笛を今すぐやめろ、ハインツ。少なくとも私の高塔において、そのような下品な行為は許されていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "申し訳ございません、伯爵様。つい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "なにせ、このような高い場所、それも伯爵様の高塔に立ったのは初めてでしたので。ここからグリンデンを見下ろすと、どの建物も背筋が折れ曲がってしまった老人のように見えますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "ハインツ、お前を呼んだのはそんな感嘆を聞くためではない。女帝の声はまもなく到着される……それで「双塔の夢」は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "すでに机に置いておきましたよ、伯爵様。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "子供の頃、僕はいつも汚くみすぼらしい掘っ立て小屋の前に立って上を見上げていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "そして、いつの日かあの高塔のてっぺんに立って風に当たれるのかなとか、高い場所で感じられる風はきっと澄んでいるのだろうなとか、そんな取り止めのない空想を膨らませていたのです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "黙れと言っている！　それに何なんだこれは！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "これが私が依頼していた宝石の完成品だと？　こんなものが「双塔の夢」だというのか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "伯爵は宝石の入った木箱を床に投げ捨てると、親指と人差し指でバイカラーの宝石をつまみ上げ、ハインツにつき出しながら怒号を浴びせた。\nその声はあまりもの怒りで割れており、とても教養を身につけている伯爵とは思えない姿だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "床に落としてしまわないよう、くれぐれもお気をつけください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "貴様には七日間も時間を与えた。それに、その才能を十分に発揮できるよう、人手も物資も十分に提供してやったというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "え、ええ、そちらがその完成品ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "「完成品」だとぉ？　笑わせてくれるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "ハインツ、貴様はグリンデンで最も優れた宝石鑑定士だろう。それなのに、これが市場で叩き売りされているガラス玉にすら劣っていることが分からんのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "このくすんだ金色を見てみろ。少し近づいただけで、内部が不均一なことがはっきりと肉眼で見える。光の屈折も入り組んだ迷路のようにぐちゃぐちゃだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "それと反対側の黒も、荒野に転がっている石ころと何が違う？　貧乏人が泊まる宿屋に使われてる安っぽい遮光カーテンのようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "そして極めつけには二つの色の相性。なんと薄っぺらく、ちぐはぐな組み合わせだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "あの幻想的な色彩はどこへいった？　あの眩いきらめきは？　二つの色が照らし合う唯一無二の美しさは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "私からの依頼を引き受けておきながら、なんの悪びれた様子もなくこのような粗悪な石を渡してきおって。これをどう女帝に献上しろと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "両陛下が私の頭を踏みつぶすところが見たいのか！？　この高塔を更地にしていいのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "答えろハインツ！　なぜこのように私を愚弄する！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "――パリン。\n伯爵の怒号が途切れるよりも早く、乾いた音と共に「双塔の夢」に亀裂が走った。バイカラーのその宝石は、伯爵の指の間で砕け散ったのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "おのれぇ、ハインツ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ああ、伯爵様、誤解ですよ！　どうか弁明させてくださいませ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ハインツは、アーツユニットに取り付けられているバルブをそっとひねると、腰をかがめ、床に散らばった宝石の欠片を拾い上げ、中に装填した。\nそして何やら角度を調節するかのように、数歩後ずさる。やがて彼が指をパチンと鳴らすと、その音に応えるかのようにアーツユニットの先端が光り出した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "幽遠な黒と荘厳な金が放つ澄んだ輝きは、さながら夕焼けに照らされる湖畔のごとくであった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "もちろん、これを女帝に献上することは可能です。なぜなら、これこそが本来の「双塔の夢」なのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "あり得ん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "先ほどあれだけ近くで観察したのだぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "簡単な話ですよ、伯爵様。「双塔の夢」はもともと、至って普通のクリスタルなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "あの宝石を鑑定したのが僕だったのをお忘れで？　あの時、宝石は精巧なケースに入れられ、僕のアーツユニットに照らされていました。こうして角度を合わせて、光の強さを調節すれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ほら、この通り……幻想的な色合いと眩い輝きの完成です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "「屈折」を上手く操れば、たとえ粗悪なダイヤであっても、本物に引けを取らない輝きを放つ――ちょっとした僕の専門スキルです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "き、貴様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "あなたは宝石の素人だ。プロとしての僕の腕に疑問を抱くべきではありませんでしたね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "……私に陛下の御前で大風呂敷を広げさせてから宝石を盗み、挙句わざととぼけたフリをして、私自らの手でそれを破壊させたというわけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "貴様のその行為はサクソン伯爵の高塔を死地へ追いやっているようなものだぞ！　そんなことをして一体なんのメリットがある！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "誰のおかげで今の自分があると思っている！　誰が貴様を重用し、この塔のための宝石業を任せたと思っているのだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "よく考えてみるといい！　何一つ成し遂げていないどころか、他人の恨みばかり買ってきた貴様の滑稽な経歴を片手に、グリンデンで生き残れたと思うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "伯爵様より受けた御恩を忘れたことはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "僕はただの普通の人間です。あの頃は何もかもあきらめかけていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "書記官が秘密裏に販売していた宝石を盗み、さらに砕いて粉末にした夜は、彼が行政の力を利用して僕のところまでたどり着くんじゃないか、怯えて一晩中眠りにつけませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "それから偽の宝石鑑定書を発行し、サクソン子爵に恥をかかせ官職への道を途絶えさせてしまった時も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "自分の計画が、あなたのような陰謀に長けた者にとっては、易々と見破られてしまうような稚拙な計画だったのではないかと、気が気ではありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "幸い、ことがうまく運び、僕はあなたの目に留まり、そしてあなたは僕の利用価値にしか関心がなかった",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "破産してしまったあの男爵や、投獄されてしまった書記官をろくに調べもせずに信用してくださったとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "確かに……あの事件が起きてからもう二十年も経っているのです。どうしてあなたが覚えていましょう？　僕たちのような小物は、あまりにも取るに足らない存在です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "一体……何が言いたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ですから、僕の目的は最初から伯爵様、あなただったのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "一年半前グリンデンに戻り、例の粗末なフェイク品を男爵に売りつけた瞬間からずっと、僕の目的はあなたでした、サクソン伯爵。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "……なぜだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "フフ、話したって思い出せないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "そうそう、女帝の声ならすでに高塔の下に到着しているはずです。金色の女帝に唯一無二の宝石を祭典の献上品として捧げると豪語していたようですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "どうやって場を収めるんですかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "誰か！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "この痴れ者を捕えろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "パチン――再び指を鳴らす音が響く。\nアーツユニットから光が放たれ、それがバルコニーに入り組んだ光線を描き出す。伯爵はそこでようやく、いつの間にかバルコニーの至るところに鏡が大量に仕込まれていたことに気付いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "光は伯爵の視界を奪い、ハインツの元へ集まっていく。\nそうして、宝石職人は伯爵の前から忽然と姿を消したのであった。\n最後に伯爵に笑みを一つ残して。\nあれほど謙虚で臆病で可愛げのあった彼からは想像もつかないような大袈裟な笑み……\n嘲弄と憎しみが込められた笑みだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "幸運をお祈りしています、伯爵様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サクソン伯爵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "伯爵の御付き",
      "text": "は、伯爵様、女帝の声が到着されました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "そこの少年、ここは楽器工房ではありませんよ。その楽器を修理してくれる人を探しているのなら、ここに来ても無駄です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "グリンデンの伯爵を弄んでおいて、そのまま責任逃れするおつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ハインツさんですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ツヴィリングトゥルムから参りました、ミヒャエルと申します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "まさか女帝の声ですか？　こんな子供もいたとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "いいえ、僕はただ陛下に代わってそのご意思を伝達するための密偵に過ぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "サクソン伯爵の高塔はすでに差し押さえられました。今後、陛下の裁きを受けるべく、ツヴィリングトゥルムへ護送される予定です。そしてあなたの処置についてですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "なるほど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "あっ、そう緊張なさらずとも結構です。どうかアーツユニットを降ろしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "ここに来たのはいくつか確認したいことがあるだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "この一年半の間で、様々な「不幸」に見舞われたあなたの顧客たちには一つの共通点がありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "破産した例の男爵はとある採掘所の監督でした。さらに、内密で宝石を売り払ったがゆえに投獄されてしまった書記官は、以前とある採掘所の報告書の草案を起こした者です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "……そしてサクソン子爵とサクソン伯爵は、その採掘所のオーナーでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "どうして一日経っても誰も僕を捕まえに来ないのか不思議に思っていたのですが、どうやらそちらはこの間にかなり色々調べ上げたようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "一連の事件を起こしたのはすべて復讐のため、そうですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "二十数年前、サクソン伯爵は巫王のために方陣装置を製造すべく、グリンデンで秘密裏に源石鉱脈を採掘していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "しかし双子の女帝のクーデターが成功し、リターニアの情勢は一夜にして激変、新たな二つの高塔が首都にそびえ立った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "そこでサクソン伯爵は「帰順」を図るため、内密に源石採掘場を爆破し、そこで働いていた労働者も全員生き埋めとなったのです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "彼はこの件をツヴィリングトゥルムへ提出する報告書で、「異種結晶の採掘場で崩落事故が発生した」と記述し、事実を隠蔽した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……ええ、僕の両親はまさしくその採掘所で働いていたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "そして僕の人生はあの瞬間から変わってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "その日に僕はグリンデンを離れ、様々な人や出来事に遭遇し、そして鉱石病を患い、このアーツユニットを手に入れたがゆえに、再びこの光彩を放つ石ころと関わる羽目になったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "とまあ、大体こんなところでしょうか、敬愛なる若き密使様。あなたはまだお若いでしょうから、全てを理解してくれるとは期待していません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "もし僕の犯行について調べに来たのなら、本来ならば爆破事故を起こし、サクソン伯爵を粉々に砕かれた宝石もろとも土の中に埋めてやるつもりだったのだとだけ、お伝えしておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "僕は金色の女帝へ献上する宝石を壊したんです。逃げられるとは端から思っていません。さあ密使様、どうぞ僕に刑罰を言い渡してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "今回のことであなたに責任を追及するつもりはありません、ハインツさん。僕にとって、今回の宝石事件はただのプレリュードに過ぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "これまでずっと、サクソン伯爵は女帝に媚びを売りながら、裏では巫王派の残党を援助していたんです。近年起きた反乱事件の全てに伯爵が関わっていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "僕はグリムマハトに仕える密偵です。今回グリンデンへ来たのも、名利を貪る害虫をツヴィリングトゥルムへ連行するためです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "イーヴェグナーデが祭典のために探されていた宝石を壊した件ですが……あのような浮ついた宝石など、グリムマハトはちっとも興味を抱かないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "復讐を終えたあなたがこれからどうするのか、僕が気になることはただそれだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "どうやらあなたはかなりの有名人のようですね。玄関のポストに招待状が入っているのがたまたま目に入ったので、ついでに持って来ましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "それと、伯爵の塔に仕掛けたアーツギミックも調べさせてもらいました。あなたは優秀な宝石鑑定かであると同時に、腕のいい怪盗でもあるのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "それなら宝石鑑定所でも構えたらいいのではないでしょうか？　ここリターニアにいる限りは「商売」に困ることはないはずです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ハインツは、ミヒャエルが作業台に置いた招待所の封を切った。\n封筒に施された金の封蝋に見覚えがある。これは別の高塔の主を表す印だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "「マイルズ伯爵は自身の所有する採掘所から発掘した貴重な宝石――『天空の涙』をリターニア内で巡回展示をしており、近々グリンデンへ訪れる予定である。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "「つきましては、その際の鑑定において素晴らしい腕を披露していただきたい。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "僕の記憶が正しければ、マイルズ伯爵の採掘場も昨年、防護措置が不十分だったせいで十数名もの感染者を出し、採掘停止令が出されていたはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "ハッ、もう一人の「サクソン」というわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハインツ",
      "text": "もしかしたら、あの少年のアイディアもなかなか悪くないのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
