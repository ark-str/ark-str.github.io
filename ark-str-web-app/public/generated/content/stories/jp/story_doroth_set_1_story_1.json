{
  "server": "jp",
  "storyId": "story_doroth_set_1_story_1",
  "groupId": "story_doroth_set_1",
  "stageId": null,
  "title": "友の故郷はいずこ",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_doroth_1_1.txt",
  "sourceHash": "5bec7ebd82fe6970459ed5155540d576d8dd9b288014bf769535d31683c73f30",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ドロシーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "フルネームでお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それと、この会話はすべて録音されていますので、協力的な態度でいていただくことをお勧めしますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "我々は、調査の結果と今回の査問内容を踏まえて、今後の対処を進めていくつもりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これはあなたのみならず、359号基地の職員全員の命運に関わることなんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "いいでしょう、わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私の名前はドロシー・フランクスよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "かごを下げた少女",
      "text": "ドロシー！　ドロシー！　こっちこっち！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "かごを下げた少女",
      "text": "見て見て、この草原すっごく広い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "かごを下げた少女",
      "text": "眺めもすっごく良いし、ドロシーの家がないか探してみようよ！　ええと……銀色の小さい家……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴローゼ",
      "text": "GO……GO-LOS-E！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "かごを下げた少女",
      "text": "ちょっと、ゴローゼ！　その風船どかして！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "かごを下げた少女",
      "text": "前が見えないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ありがとうナナ、だけどもう十分探したから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "銀色の家はなかったわ……私の家は、ここにはないみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "うん……大丈夫だよ、私の家もここじゃないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "ここもとっても綺麗だけど、うちの麦畑には及ばないしね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴローゼ",
      "text": "GO……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ん？　ゴローゼ……どうしたの？　あっちを見てって言ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あら……あそこに誰かいるみたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "よう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "こ、こんにちは！　ヴァルポさん、もしかして何かお困りかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちしたヴァルポ",
      "text": "ああ、帰る家が見つからなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちしたヴァルポ",
      "text": "兄貴と、家がひっくり返るくらいの大ゲンカをしてさ。二度と帰ってくるもんかって言って飛び出したんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちしたヴァルポ",
      "text": "勢いでここまでやってきたものの……外は恐ろしくてならない。……それでやっぱり家に帰りたいと思ったんだが、今となっちゃできない相談だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "どうして帰れないの？　道に迷ったとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "帰り道が見つからないなら、一緒に行かない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちしたヴァルポ",
      "text": "そうだな、あんたらについていこう。優しい二人のお嬢さんと……風船を持ったロボットか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちしたヴァルポ",
      "text": "だけど、実際俺の家を見たら、帰れないって言った理由がすぐにわかると思うぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちしたヴァルポ",
      "text": "それと、俺はヴァルポじゃない。誇り高きアスランさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "あなたの目的は「帰るべき家」を探すことだと言いましたね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "それと同時に、開拓者たちの「家」を探すのも手伝っている、と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ええ、そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "私は、事件の真相調査のために359号基地を訪れたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "抽象的な言葉でごまかそうとするのはやめてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ごまかしで言ってるわけじゃなくて、本気でそう思っているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "もう一度確認させてほしいんだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "359号基地の被験者や、開拓者たちの受け入れ先については、きちんと手配してくれてるのよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "そちらの質問に答える義務はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "ですが、開拓者たちの行く末をそこまで気にするのはなぜですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "調べによると、あなたのお母さんは開拓者だったそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "幼少期はずっと、お母さんと開拓隊と共に過ごしていたとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "その後あなたのお母さんは、荒野で天災の被害に遭い亡くなった。違いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ごめんなさい、できればその話はしたくないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私の事情について十分把握しているというのはわかったけれど……それとあなたたちの調べていることに何の関係があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "ご不快な思いをさせてしまったのなら、お詫びします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "これは単なる推測ですが――あの被験者たちは……あなたにとって何か特別な意味がある人々なのではありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "開拓者というのは……命尽きるまで、荒野の中をさまよい歩く人たちなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "帰る場所なき嵐のように、土地から土地を渡り歩く彼らは、荒野を切り拓いているにもかかわらず、自分たちの土地なんて持っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "彼らがより良い生活を送れるようにすることこそ、私の理想なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "家族のために……彼らが夢の中で何度も帰り着いた「家」にたどり着きたいと思ってるのよ。彼らの代わりに、ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴローゼ",
      "text": "GO-LOS-E。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ここなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ゴローゼ……ここがあなたのお家？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴローゼ",
      "text": "GO。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴローゼ",
      "text": "GO……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "何かを伝えたがってるな……そいつが指さしてる場所を見てみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "その引き出しを開けてほしいんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "引き出し？　何が入ってるんだろう……見てみるね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "これって……レコーダー？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴローゼ",
      "text": "ワガ……ヤ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "あっ！　い……今、喋った！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロボットは自分の身体を分解し始めた。\nずっと握りしめていた風船が手を離れ、天井にぶつかる。\n「胸」の中にあるコアを露出させたロボットは、自分の「心臓」を取り出して、レコーダーにセットした。\nすると、レコーダーから何か聞こえ始めた。……どうやら老人の声のようだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老人の声",
      "text": "ごほ、ごほっ……わしの名はゴローゼ。ロボット職人だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人の声",
      "text": "この足はもう動かないというのに、わしは故郷を遠く離れた場所にいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人の声",
      "text": "ゆえにわしの声を、この子の身体に入れておこう。どうかこの声を故郷へ、我が家へと届けてくれることを祈って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人の声",
      "text": "顔も知らぬ、そこなお人よ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人の声",
      "text": "この声を聞いたなら……わしの代わりに、我が家の有様をその目で確かめてほしい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老人の声",
      "text": "さあ行け、我がロボット。わしの声をあの家まで送り届けてくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人の声はそこで止まった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴローゼ",
      "text": "GO-L……OSE……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロボットはその声を最後に、冷たい鉄の塊と化した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ゴローゼ……これがあなたの名前じゃないことはわかるけれど、今まで通りそう呼ばせてちょうだい。……よく頑張ったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "だけどあなたは、ただ主人の代わりに彼の家へと帰り着いたというだけじゃないのよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "だってここは……あなたの家でもあるんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ねえ、ループスさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "なんだ？　ああ、さっきも言ったが俺はループスじゃなくて、アスランだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "そうだったわね。それじゃ、アスランさん……ゴローゼの風船を取るのを手伝ってくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あの風船を持って、旅を続けたいの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "本題に戻りましょう。軍との企みはすべて、フェルディナンドが独断で得たもののようですね。加えてあなたの行った実験は、見たところ完全に合法です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "一つはっきりさせたいのですが、あなたはフェルディナンドと共謀していたのではありませんか？　彼の計画について、本当に何も知らなかったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ごめんなさい、彼とはあまり付き合いが深くなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "そうですか。確かに、あなたがこの件を認知していたという証拠がないのも事実です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "映像記録を見る限り、ライン生命の内部文書に対するあなたのアクセス権限は、一般の研究員と何ら変わらないようですしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私はいつも時間に追われていたの。少しでも早く自分の実験を成功させたい一心で……ほかのことを気にする余裕なんてなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "そうは言っても、これがかなり不可解な状況であることもまた確かです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "普通なら、そうやって周囲の情報を遮断することはないはずです。ましてやあなたはライン生命主任の一人でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "あの映像記録は、自身の嫌疑を晴らすためにあなたが用意したものなのではないか、と疑うだけの理由が我々にはあるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "事後調査向けに虚偽の映像記録を用意したところで、私の実験が早く終わるわけではないし、開拓者たちの助けにもならないのは明らかでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私がそんなことをすると思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "他人の計画の中で、自分がどういった扱いを受けているのかを……協力相手とされているのか、それとも単なる駒なのかを、知りたいとは思わなかったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "そんなの、どうだっていいわ。誰かの計画の中の立ち位置なんて、私は気にしないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私の研究と理想は……もちろん私にとっては意義あるものだし、もしかするとほかの人にとっても特別な価値があるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "だから、彼らがそれを利用したいというのなら、私も喜んで取引に応じるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "駒扱いすらも甘んじて受け入れるというのですね。捨て駒にされることや、何かの被害を被ることが怖くはないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "被害というと……投獄されることかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "私の知る限りですと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ええ、分かってるわ。あのローキャンのように……過ちを犯して政府に見捨てられた科学者の末路なんて、散々見てきたもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "だけどその一方で、かつての私のように、研究関係のアドバイスや協力を得ようとして、ローキャンのいる牢獄まで足を運ぶ人が大勢いることも知っているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "こほん。つまりあなたは、最悪の事態まで想定しているというわけですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私は……これまでずっと、そうして足場を固めてきたのよ。それがクルビアのルールだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "そうでなければ、単なる開拓者の子供が、ライン生命の主任になんてなれると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "あなたは……こんなことなど考慮していないものとばかり思っていました。ですが……あなた自身は利用されても構わないとしても、開拓者たちのことはどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "フェルディナンドのような人間でも、あなたのことは同僚として扱うでしょう。ですが開拓者たちは？　擦り切れるまで使われた挙句荒野に捨てられるビニール袋と大差ない扱いではありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……だとしたら、そんなことをする人たちには、その代償を支払わせてみせるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "今すぐにはできなくても、いつか必ず償わせる。これは私の責任でもあり、今までないがしろにしてきたことでもあり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私が犯した……最大の過ちでもあるのだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ねえ、フェリーンさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "どうしてぼーっとしているの？　ほら、早く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "俺はヴァルポでもフェリーンでもない。アスランだって何回言えばわかるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "訂正してやるのはこれが最後だからな。次に間違えたら、この鋭い牙を嫌ってほど拝ませてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "はいはい、「アスラン」さんね。さあ、もういきましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "あんたらだけで行ってくれ。俺はもう、自分の家を見つけたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "えっ？　家なんてどこに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "上を見てみろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一行の頭上高くに、逆さまになった家がふわふわと浮かんでいる。\n「アスラン」が家には帰れないと言った理由を、ドロシーはようやく理解した。"
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "俺は一生かけても償えない過ちを犯した。自分の傲慢さのせいで、二度と我が家へ帰れなくなってしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "お家に帰る方法はきっとあるはずよ、「アスラン」さん。一緒に考えましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "いいから行け、俺はここに残る。これは俺が受けるべき罰なんだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "空中に……浮いてるお家……\nそうだわ！\nねえ「アスラン」さん、ゴローゼの風船があるじゃない！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "風船って……それで空まで飛ぼうっていうのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「アスラン」さん",
      "text": "まあ、物は試しだ……いったんやってみて……えっ！？　嘘だろ、本当にいけそうだぞ。足が浮き上がり始めた！　あとはもう少し自重を減らせば……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "きゃっ！　「アスラン」さん、何してるの？　……これって……全部水？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "こんなにたくさん……どうしてあなたの耳から水が出てくるの？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "へへっ……実は、少しでも強そうに、身体を多く見せたくて、水をたくさん吸い込んでたんだ……\nそのせいか、ずっと頭がくらくらしてたんだが……あっ、おい見てくれ！　浮いてるぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「アスラン」は風船と共に浮かび上がると、叫び声を上げた。それが恐怖によるものか、興奮によるものかはわからなかったが……\nその一瞬、ドロシーには彼の牙がはっきりと見えた。さほど鋭くもなく、むしろ少し丸く可愛らしい牙が。\nその時、なぜだかドロシーの目からは涙がこぼれ落ちた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "クリステン・ライトの計画についてはご存知でしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "少しも知らなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "こんなことを言っても信じてもらえないかもしれないけれど、これが事実よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ライン生命で一番周りから浮いていたのは、多分私だったように思うし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "では、クリステンは今どこに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ごめんなさい、それも知らないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私が知っているのは、彼女がとても壮大な目的を持った理想主義者だということだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "彼女からライン生命に入らないかと誘われた時、私は、彼女に自分と同じ理想主義者の「稲妻」を見たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "稲妻、ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "トリマウンツの方角、その上空に、突如として異変が起こった。\n光の柱が一筋伸びて、天を貫く。今この瞬間、蒼穹の背後に秘められた真相が零れ出ようとしていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "あ……あれは何だ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "トリマウンツの空に……一体何が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "これが……クリステンの描く「壮大な目的」なのか……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "ふ、フランクスさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "フランクスさん……？　な……泣いているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "これが空に秘められた真相なのね……本当に綺麗だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ごめんなさい、どうしても涙を抑えきれなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "さすがクリステンね……彼女は……やり遂げたんだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "なっ、先ほどは、クリステンの計画については知らないと仰ったではないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "知らないのは事実よ。だけどあれは、いかにも彼女がやりそうなことだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "それに……実際、感じ取っているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "何をですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "「伝達物質」よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あの子たちが、空の向こう側に辿り着いたんだわ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "星空が、その衝動のまま私の脳内に流れ込んでくる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "「伝達物質」、と仰いましたね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "それは359号基地の実験で作られたものでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "正直、気になっていたんですが……あなたはそれとかなり濃厚な接触をしていたんですよね。何らかの悪影響を受けてはいませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "つまり、後遺症がないかってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "今のところ、特段異常な症状は出ていないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "しいて言うなら、夢を見ることが多くなったわね。それも、どんどん頻度が増してきているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ふとした瞬間……眠っているわけでもないのに、時折感じ取ることもあって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "どういうことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "あの、フランクスさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あっ……ごめんなさい、またあの感覚が来ていたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……誰もいない、うだるように暑い荒野にいるような感覚が。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "暑い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "なんて暑いのかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ナナ……もう少しゆっくり歩いてちょうだい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "着いたよ、ドロシー。ここが私の家。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "えっ？　ここが……？　だけどここは、少し暑すぎるし……荒涼としすぎているように思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "麦畑は？　新しく建てたっていう、頑丈なレンガのお家は……？　それに、麦畑であなたを待ってるお友達はどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "えっと……友達なら、すぐ隣にいるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あっ……もしかして、あなたのお友達って、そのボロボロのカカシさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "うん。あはは、しばらく見ない間にここまで変わっちゃうなんてね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "私のお家も……様変わりしちゃったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ナナ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "このまま私と旅を続けましょうよ！　これからも一緒に……私のお家が見つかったら、そこで暮らしましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "私たち、もうずいぶん遠くまで歩いてきたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "ゴローゼも、「アスラン」さんも、それに私も……皆、ドロシーが一緒に旅をしてくれたこと、本当に感謝してるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "だけどもうお別れの時間なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "で、でも、私……あなたのことがすごく心配で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "いいの。ここに残るって決めたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "どんなに変わってしまっても……ここは私の故郷だし、私の友達も……この子も、ずっとここにいてくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナナ",
      "text": "だからこの子と一緒に、新しいお家を建てるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "吹き抜ける風と共に、カカシがゆらゆらと揺れた。\nそうして、ドロシーは最後の友人に別れを告げた。\n記憶の中に佇んでいるあの銀色の家は、この果てしない砂漠の一体どこにあるのだろう？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "クリステンめ、イカれているとしか思えないぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "ライン生命というのは、どんな怪物の集まりなんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "クリステン……これがあなたの探し求めた「帰るべき家」への答えなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "今度彼女に会ったら、実験成功を直接お祝いしてあげなきゃね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "それに、パルヴィスも……どうやら私の出した結果を修正してくれたみたい。うん、興味深い発想だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "だけど、「伝達物質」は「伝達物質」でしかない。生命のために役立てるのでなければ、その存在意義はどこにあるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "いえ、待って……一つ、可能性はあるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "星のさやの外で生きられるものなんていないけれど、「伝達物質」は例外かもしれない。つまり――「伝達物質」なら、人の代わりに劣悪な環境に踏み込めるということ。天災の中や、それに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "素晴らしいわ。調査員さん、少し時間をくれないかしら。この光景を目に焼き付けて、今この瞬間閃いたアイデアのすべてを記録しておきたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私の実験にはまだまだ改善の余地があるし、伝達物質には無限の可能性があるんだわ。私が求める平等な未来も、そして、私の望む……帰るべき家も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "先ほどから仰っている、その「帰るべき家」というのは一体なんですか？　まさか……空の上なんて言いませんよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「帰るべき家」とは何か？\n私の言う「帰るべき家」は……未来の光景は……\n一体どんなものなのだろう？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "こ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ここが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私の家なの？　この、銀色のお家が……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母の声",
      "text": "ドロシー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "お母さんの声だわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "お母さん……そこにいるの？　どうして姿が見えないの……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母の声",
      "text": "ドロシー、ここは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "未来……そこに広がる光景……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "それは一体どこにあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "フランクスさん、独り言はやめてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "質問に答えていただかないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ええ、ごめんなさいね。インスピレーションが湧いたから、つい言葉にしてしまっただけなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "だけど、私の言う「帰るべき家」は、あなたが思っているようなものじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私が追い求めているのは、今よりも平等な理想の社会よ。それはもしかしたら私たちの足元にあるのかもしれないし、クリステンが追及している遥か彼方にあるのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "今思えば、クリステンも、パルヴィスも、フェルディナンドも……それに私も、ライン生命の科学者たちの目標は、それぞれ違うものなんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "何か共通点があるとしたら、それは……きっと全員が持つ「稲妻」のように激しい輝きだと思うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドロシーは、調査員がレコーダーの一時停止ボタンを押したことに気付いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "どうやらあなたには忠告が必要なようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "仮にあなたが、クリステンやフェルディナンドと同じような方法で理想を追い求める方ならば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "先程の発言内容は、あなたにとって非常に不利に働く可能性があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "どこからか一陣の風が吹く。\n……その風は、荒野の匂いがした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ねえ、オーティさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "調査員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "どうして……私の名前を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "その前に、まずは話を聞いてもらえる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "昔、リンダという開拓者を助けたことがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "彼女は小さい頃に鉱石病を発症したせいで家族から引き離されて、荒野に流れ着いた子でね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "家族と共に田舎で過ごした日々の記憶は、リンダにとってかけがえのないものだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "秋になると一面が金色に染まる麦畑……その中で風に揺れるカカシ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "そして、いつも彼女にくっついて、麦畑をいつまでも駆け回っていた弟……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "あなたは……私の姉をご存知なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "あ、姉は今どこで何を？　……元気で過ごしているんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "やっぱりあなただったのね。前にリンダが家族写真を見せてくれたことがあって……一目見た瞬間に、彼女の弟だってわかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あの子は元気よ。結婚もしたの。私も式に招いてもらったのよ。荒野で挙げた簡単な結婚式だったけど、お相手はとっても頼もしそうな人でね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "今は子供も生まれたんですって。とっても可愛らしい子で、一日中ママにくっついて、「カカシ」のお話を聞かせてっておねだりしてくるらしいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "リンダはいつも言ってたわ。自分の弟を誇りに思ってる、って。優秀で責任感の強いオーティなら、きっと自分の代わりに家族のそばにいてくれるはずだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "すみません……言葉が出なくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "フランクスさん、どうお礼を言ったらいいか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "気にしないで。私は別に、見返りを期待してこの話をしたわけじゃないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "開拓者を助けることは……私の天職だと思っているの。これからも同じやり方で、自分の理想を追求したいと考えているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "だから私には、やましいことなんて何もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "オーティさん、私の発言はすべてそのまま記録してちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "人との間にある愛と善意だけは、決して取引に使ってはいけないものだと思うから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーティ",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "レコーダーは再びつけられた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "翌日"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "待ってたわ、いらっしゃい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謎の客人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の客人",
      "text": "私が来ることがわかってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あなたはとっても優秀な協力者だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "もっと大きな責任を負おうと考えているのなら、必ず来ると思っていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "思った通り、また一つ成長したみたいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたの予想通り、「伝達物質」が使われることになったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "情報提供に感謝しないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "政府と協力関係を築いたから、今日は「伝達物質」を回収しにここへ来たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "そうだったのね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "それじゃあ、「取引」しましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "何が望み？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "その前に聞きたいことがあるの。クリステンは今どこにいるの？　ライン生命は一体どこへ向かっているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "わからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "少なくとも随分長い間、ライン生命内部の人にも、それ以外の人にも……その答えは「わからない」ままだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そんなことを訊くなんて、何か考えでもあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私はライン生命に残って研究を続けたいと思っているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "もちろん、もっといろんな場所で同じ志を持つ人に出会って、私の研究でより多くの人を幸せにできるのなら、それに越したことはないけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ねえ、あなたはロドスって企業と仕事をしているんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あなたや……ロドスの人たちは、私のパートナーになってくれるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "科学をあらゆる人々のため真摯に役立てる――これは、私たちの共通の夢でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私の成果が正しい人の手に行き渡るよう、あなたが協力してくれたら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私たちの夢は、いつの日かきっと実現できるはずよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
