{
  "server": "jp",
  "storyId": "act9d0_level_act9d0_06_end",
  "groupId": "act9d0",
  "stageId": "act9d0_08",
  "title": "離散",
  "storyCode": "DM-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act9d0/level_act9d0_06_end.txt",
  "sourceHash": "6d86f60905a58a7abac08d028785fed3b38884714b5bace75d775f7f2f52a446",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "報告は読みました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "あなたたちがレユニオンの下で得た成果は、称賛には値しません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "ですが、予想外の収穫があったようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ありがとうござい――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "お礼はいりません、少なくとも今回は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "あなたたちは皆、優秀な戦士です。命あるうちに得た報酬は、全てあなたたち自身の血と意志によって勝ち得たものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "摂政王殿下は、あらゆるサルカズが歩んだ軌跡をご存知です。それがあなたたちのような矮小な者であっても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "この殿堂の中で価値を失っていくのは、あの感染者たちだけではありません。この意味はわかりますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "結構です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "私の予想通りなら、ロドスは既に、あの不愉快な者を迎え入れているでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "あなたたちも接触したことがある人物ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "（摂政王は、これほど遠いロンディニウムから、Wよりも早く情報を掌握しているというのか――？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "「傭兵は利益だけに忠実であれ」。この考えは、必ずしも悪いものとは限りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "全て落ち着いたら、殿下の玉座の前に跪くといいでしょう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "――褒美を賜ることができるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……他の戦士たちは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "あの感染者の若者はそれなりにうまくやっています。気づいていないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "ですが殿下はこの茶番劇に深入りするつもりはないようです。殿下と私の判断により、ヴィクトリアはこのままレユニオンの動向を見守ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "今の私たちには、Wからあの部隊の支配権を取り戻す、「効率的な方法」がありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "それに、私たちはこれからも「支持者」の名義の下に、大地の至る所で活動する感染者たちを扇動していく必要があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "このままレユニオンを利用し続けるのですか？　私の考えだとこのままではいずれ殿下に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "ここで手を止めろと言うのですか？　若い傭兵よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "私たちは混沌とは程遠い……そう、遥かに遠いのです。リーダーの下を離れたレユニオンであっても、まだまだ災禍の根源にはなってくれます――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "――それと、先程の言葉は、殿下への疑義と捉えても良いですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "い、いえ、違います。申し訳ありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "構いません、頭を上げなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "――ああ、そう言えば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "あなたはしばらく、かの地に戻る必要はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "長旅をしてきたのですから、当分の間はここで、わずかばかりの自由な時を楽しむと良いでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……心より感謝いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "では、話はここで終わりです。私は殿下のもとへ参ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "まずは自分の成すべきことを成し遂げなさい。ヘドリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "承知しました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "……ヘドリー、か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "text": "これ以上何に気づけるか、期待しておこう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "つまり……私たちは囚われの身ということ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ああ。だが想像していたよりもずっとマシだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "とはいえ、我々はまだまだ甘かったようだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "甘いってどういうこと？　死を覚悟してたこと？　それとも摂政王が何も知らないと思ってたこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "どちらもだ。摂政王は……知らないどころじゃない。初めから全てを操っていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だがそれでこそ……テレシスだ。伝説に語られる彼とテレジアは、それほどに無敵の存在だった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "この戦争のせいですっかり忘れていたな。伝説はただの伝説ではないということを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "でもここから出られないんじゃ、どうやってWに連絡するの？　レユニオンの方がどうなっているかもわからないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "ここまで来るのにかなり時間がかかったから、Wはもうタルラと仲違いをしてるかもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あるいは、この茶番劇は龍門で終わりを迎えるのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "……早過ぎない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "その方がWらしいとも言える。もしタルラが本当にあの感染者たちに終焉をもたらそうとしているのなら、Wは真っ先にタルラを始末しようとするだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "サルカズのやり方で、手段を選ばずにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "どこかの傭兵の死で、Wは苛立っているから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "Wだって馬鹿じゃないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "今の状況では、尻込みしている余裕などない。つまり、行動に移すだけの動機があればいいのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "だけど今の私たちは、積極的に動くことはできないわ。Ｗと連絡をとるなんてとても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "方法はある。摂政王の目を欺くのはどう考えても危険だが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺にはまだ、直属部隊に「待機」命令を出す権限が残っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "それなら……！　ヴィクトリアも混乱してるし、暗号には気付かれなさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "それだけではない。情報は摂政王の支配下にある目立つエリアを避けて……カズデルに送る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "カズデルに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ああ。あの廃墟と化した戦場……あそこはかなり前から誰も寄り付かなくなっていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だが我々は、あの場所に長く留まっていたな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あの廃墟の地下には、発信機が仕込んである。地上の発信塔は破壊されたように偽装されているが、回線は生きてるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "全然知らなかったわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "いつそんな準備をしてたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "始めからだ。かなりの金をかけてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "……フフ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "あなたの……この生き生きとした表情をWたちに見せたら、きっと驚くでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "いつからか、あなたは戦場から戻るたびに、思い悩んだような顔をするようになっていた。悪さをしてバツが悪い子供みたいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "私はてっきり、あなたはそうやって闘志を失っていくものだと思ってたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "いや、その逆だ。だんだん自分のやるべきことが見えてきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "選択肢がないからだ。消去法で考えれば楽になる。そんな単純なことに、やっと気づいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "どうせWがあなたに何か言ったんでしょ。チェルノボーグを離れる前に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "彼女が何もかも話すような奴だと思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "いいえ。もしそんな人だったら、今みたいなことにはなってないだろうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうだな。……だが、お前の言う通りだ。確かに彼女は、俺が中枢エリアを離れる直前に話をしてくれた。あのときにはもう我々の意図に気づいていたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "彼女は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "傭兵の命は、値段で評価できるものなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "当然だ。これまでずっとそうだっただろう。お前だってわかっているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "じゃあ、それは誰が決めるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "戦争そのものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……戦功、戦果、血に塗れた名声……そうやって知名度を上げて初めて、あたしたちは道具として他人に認められる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "つまらないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "だけど、これからは変わるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……どういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしは、サルカズ傭兵はみんな、自分の値段をはっきりさせておくべきだと思ってるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もちろん、他人が決めたり、誰かに操作された額じゃないわよ？　あたしたちは、自分で自分の値段を決めてリストに書き込むの。サルカズの敵たちの鮮血でね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "お前は……まさか、サルカズたちを皆カズデルの支配から遠ざけようと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そんなにびっくりしないでよ。みんなに自分の価値を自分で決めさせるってだけでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "変？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "変じゃないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "よく考えてみて……あんたがカズデルで何をすべきかを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……テレシスの目と鼻の先で何ができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "そんなこと言わないでよ。自分でやることがあるって言ってたのはあんたでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "大丈夫……あんたはあたしのリーダーだった奴なんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "成功するといいわね。というか、そうじゃなきゃ面倒なことになるわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "……面白いジョークね。きっとスカーモールの人たちは腹を抱えて笑うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ああ。そして委員会はそれを黙って見ているはずがない。これまで大金を叩いて、色々画策してきたのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "彼らはたくさんの人を殺したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そうだ……だが彼らの中には、我々と親しい者もいる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "あなたはまた何か企んでるのね。……まぁ好きにすればいいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……とは言え今の俺は、ロンディニウムを……いや、あの屋敷すら離れることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だから、お前に頼みたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "……「トランスポーター」って、本当に便利な身分ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "「引き続きタルラの命令に従い行動せよ。ヘドリーはしばらく戻らない」、そう伝えれば大丈夫だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あの発信機がまだ稼働している限りは、こちらにも返事は届く。その後、彼らもどうにかしてWに連絡を取るだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "……フンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "そんな細かく説明しなくても、どうすればいいかくらいわかるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズトランスポーター",
      "text": "私に命令しないで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "はぁ……面倒くさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "やっとあの龍女に会いに行くって決めたのに……ホンット、タイミング悪いわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "出てきなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "チェルノボーグの廃墟は、カズデルのものとは少し違っていた。\n荒れ果てているとは言え、徹底的に破壊されつくしているわけでもなかった。\n通りの端に落ちた泥まみれの洗濯物に、割れた窓の向こうの壊れた家具に、過去の営みが見て取れる。\nそしてなにより異なるのは――\nこの二人の子供だ。必死に武器を構えている子供。"
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "――魔族め、何するつもりだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ちょ、挑発しちゃダメだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "あっ、あの……ご、ごめんなさい。すぐどこかに行くから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ふーん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたが持ってるのは、制式の軍刀？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……そうみたいね、サルカズの刀だわ。構えられもしないのに、そんなお荷物引きずってどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あたしに歯向かうつもり？　あたしを殺したい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "えっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "く、来るな！　――ううっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱々しい子供",
      "text": "ルブレフ君……足が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あら、怪我してるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "天災が直撃した後は危険よ。このままじゃあんたも感染するわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "たくましい子供",
      "text": "お、俺は、お前たちみたいにはならない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あらそう。強い子ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "じゃあ知ってる――？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――サルカズの刀を受け継ぐことに、どんな意味があるかを？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
