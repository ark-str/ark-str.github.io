{
  "server": "jp",
  "storyId": "story_chen2_set_1_story_1",
  "groupId": "story_chen2_set_1",
  "stageId": null,
  "title": "帰属",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_chen2_1_1.txt",
  "sourceHash": "5ed82bb1b1385624536281eff7d34b41b1acdd941c1e05560d61ef92d76bcceb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "テレビ番組の司会者",
      "text": "親愛なるドッソレス市民の皆さん、バカンスをお楽しみの皆さん、そして！　予選を通過した選手の方々！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビ番組の司会者",
      "text": "昨晩はよく眠れましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビ番組の司会者",
      "text": "私はグッスリ快眠でした！　なんといっても、大穴一点賭けが見事に的中！　これまで負けたお金がすべて戻ってきましたからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビ番組の司会者",
      "text": "私に勝利をもたらしてくれた選手の方々に感謝を！　おかげで昨日は悪夢にうなされずにすみました。あ、だからといってあなた方に分け前はありませんからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビ番組の司会者",
      "text": "さて、無駄話はこの辺にいたしましょう。昨日の予選は素晴らしいものでした。しか～し、ドッソレスウォーリアーチャンピオンの本当の見どころはここからですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビ番組の司会者",
      "text": "二日間のインターバルを挟み、真の戦いが始まります！　それまで何もなくて暇だと思った皆さん、ご安心ください。きたる本選を、がっつり楽しむためのボーナスコンテンツをご用意しています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビ番組の司会者",
      "text": "まずはこちら！　予選を通過した選手たちのスーパーエキサイティングな活躍を、ディレクターズカットでご覧ください──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ダメだ、この司会者を見てるとムカついてくるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "俺は昨日の予選で危うく足を骨折するところだったんだ。しかも負けちまって本選も出れねぇしよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ふざけんなって話だよ。賭けた金が全部おじゃんになっちまった。大損もいいとこだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君は自分に賭けたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そんなわけないだろ、バカにしてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "俺が賭けたのは、最近の大会で成績が良かった奴らだよ。一人か二人は決勝に行くと思ってたのによ、ふたを開けてみりゃあいつらみんな予選で敗退しちまった！　使えねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "一番注目してたチームすら、突然現れた小娘二人にやられちまったんだ。冗談きついぜ、そいつらに百万もつぎ込んだってのによ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ほう？　そんなにすごい奴がいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "あのチームは……なんつったか。意味わかんねーやつで、なんちゃら鼠……だったか？……ま、とにかく変な名前のチームだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "臆病鼠とかじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "いや、四文字だった気がする……まあいい。覚えてねぇが、とにかくムカつくぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そう怒るな。酒でも呑め、私のおごりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "いいのか？　サンキュー、お姉さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "しかし……妙だな。あんた何だか見覚えがあるぞ。どこかで会ったことあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……気のせいだろう。私がこの街に着いてからそう経っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（見覚えがあって当然だ。昨日、君の百万を拳でなぎ倒したのは私だからな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（出る前に変装しておいてよかった。エルネストの奴が、街の人間の大半は昨日の生中継を見ていると言っていたが、あながち誇張でもないようだ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だが、確かに妙だな。これまでの有名選手が、どいつも予選すら通過できないなんてことは滅多にないだろう？　賭けてた連中の大勢が損をしたんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "まったくだ、昨日誰もビルから飛び降りなかったのが奇跡さ。主催者はきっと大儲けだぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……八百長か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "でなきゃ何だってんだ？　都合よくみんなの運が悪かったってか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "八百長自体は別に珍しかないこった。これまでも無かったわけじゃないからな。だが……うーん、何と言うか、今年は少し違うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "というと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "この大会には俺も何度か参加している。毎回たくさんの新人が出てくるが、それでも見慣れた奴のが多いのは変わらねぇ。だから人気選手ランキングなんてのも作られる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "だが今年は妙に新参チームが多くてな。雰囲気も少しおかしいような気がすんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（やはり……この大会はどこかおかしい。私の直感は正しかったようだ。何か企んでる連中が、大会なんていう絶好の機会を逃すはずがない。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（さて、参加者の中に騒動を起こそうとしてる者が一体どれほどいるか。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（……判断材料が足りないな。つくづく、さっきの倉庫での一件が悔やまれる。手がかりをつかめると思ったが、まさか先を越されるとはな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（奴らを追って探し当てられたのはこのバーだけだった。私を出し抜いて連中を片づけるなんて一体誰の仕業なんだ？　……さっぱりわからん。チッ、情報を集めないと。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "……運営側のバカどもは裏で一体何をやってんだ？　そんで、どれだけ甘い汁を吸ってんだろうな……っておい、聞いてるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ん？　あぁ、聞いている。今年は確かにめちゃくちゃだ、予選でも多くの者が負傷したようだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "俺はまだ足が痛ぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "毎回怪我人が多く出るのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "こういう大会だからな、避けられねぇさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "まあ、俺のケガなんてどうってことねぇよ。あんたは来たばっかだからよく分かんねーかもしれねぇが、ここはそういう場所だしな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "確かにこういった娯楽都市は他じゃあまり見ない、特にボリバルでは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "もう少し話を聞かせてくれないか？　ドッソレスのことなら何でもいい、ここで観光を楽しみたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "こいつもおごろう。思いっきりやってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "プッハァーー！　やっぱりボトルのラッパ呑みは爽快だな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "あんたも随分呑んでるだろ、まだ酔ってないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ううっ、少しくらくらするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そうか？　見た目じゃ全然そうは見えねぇぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "仕事の都合で、昔訓練したからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "とはいっても、私はそこまででもないさ。友人には肝臓が変異してるんじゃないかと疑うほど酒が強い奴もいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "すげぇな、マジか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ。しかもあいつは人を煽るのが上手くてな──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "今の音は、何事だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いA",
      "text": "あ？　今なんて言った！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いA",
      "text": "もう一ぺん言ってみろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いB",
      "text": "終わってるって言ってんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いB",
      "text": "お前のボロ店はもうお仕舞いなんだよ！　運良く予選を通過できたとしてその後はどうすんだ？　報酬の純金像を売っぱらって借金を返そうってか？　そんなはした金じゃ利息の足しにもなんねぇよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いB",
      "text": "金も運もねぇくせに一発逆転狙ってギャンブルだ？　身のほどを知れよクズ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いA",
      "text": "*ボリバルスラング*！　殺してやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いB",
      "text": "ハッ、いつでもかかってこい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "おい、誰も止めないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私が行ってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "おい待て、そう焦るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "何を待つんだ。まさか怪我人が出るまで待てとでも言うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "安心しろ、ここの連中もバカじゃねぇ。本気でやり合うようなことにはならねぇさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "もしバーで流血沙汰を起こして無事に帰れるようなら、ドッソレスは今みたいに毎年旅行客がわんさか来るようにゃなってねぇよ。店の方でちゃんと対処するさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それが普通なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そんなところだな。よくあることさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ここの治安管理は？　警察……あるいは警備隊のような機関は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "あ？　死傷者が出ないんだから必要ねぇだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（これがドッソレスなのか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（あのカンデラ・サンチェスは、自分の都市をこんなふうに治めているのか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（……気に入らないな。やっぱりここでバカンスを過ごすべきじゃなかった。この場所は肌に合わない。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いB",
      "text": "ハハッ、どうだ、参ったかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いB",
      "text": "店を賭け金にしやがったゴミクズの分際で！　なにを被害者面してんだ、自業自得だろうが！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いA",
      "text": "うぅっ、くっ……嫌だ。頼む、なぁ頼むよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いA",
      "text": "店を俺から取り上げないでくれ！　あれは俺のすべてなんだ！　俺の命より大事なものなんだ。俺はドッソレスから出ていかないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いA",
      "text": "種銭がもう少しあれば絶対、絶対取り戻せるんだ……今月の支払いさえしのげれば……だから頼む……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのオーナー",
      "text": "お客さん方、どうか店内では……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いB",
      "text": "ハッ、この期に及んでまだギャンブルかよ、救いようがねぇな。金もねぇのに見栄はって粋がるな！　これは昔お前が俺に言った言葉だ。そいつをそっくりそのまま返してやる！　どんな気分だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っ払いB",
      "text": "お前、もう消えろ！　ドッソレスは貧乏人なんていらねぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "うわ、容赦ねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "おい待て、あれはもう流血沙汰だぞ。本当に問題ないのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "もうよせ！　やめるんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ふぅ、ビビったぜ。まさかあんたがこんなに正義感のある奴だったなんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "だがあんなことにいちいち首を突っ込んでたら、そのうちトラブルに巻き込まれるぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "別に構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私はトラブルは恐れたことなどない。向こうは私を怖がっているだろうがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "わーお、かっけーな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "事実を言ったまでだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そんなことより、さっき君は店が解決すると言ったが、マスターだけじゃ対応しきれないんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ああ、確かにそうだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "マスター、ここで雇ってる用心棒はどうした？　どうして肝心な時にいないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのオーナー",
      "text": "あいにく今日のシフトに入っていた奴が来てないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "来てない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "何かあったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのオーナー",
      "text": "大したことじゃないさ。あいつらも昨日の予選を通過したんでな。臨時収入が入ったもんで派手に遊び回ってるんだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのオーナー",
      "text": "ここ最近、あいつらはちゃんと仕事に来やしないんだよ。代わりを見つけたらクビだクビ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ここ最近……それは今回の大会への準備でということか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのオーナー",
      "text": "そうとも言い切れんな。この都市じゃあ、若い連中なんてのは何をしでかしてもおかしくないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーのオーナー",
      "text": "今日はお二人さんにゃ随分助けてもらったな。まだ何か呑むか？　俺がおごるよ、少しばかりの気持ちだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "よっしゃあ！　太っ腹だなマスター！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（荒事担当の連中がサボり……これも大会に関係があるのか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（たまたまか？　いや、これはただの偶然なんかじゃない……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（これ以上遠回しに探っていても埒が明かないな。リン・ユーシャの方は何か有益な情報を得られただろうか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ありがとう。だが酒はいらない。大したことはしていないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "お、もう呑まねぇのか？　ああ、観光に行くのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そんなところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そうか、じゃあ楽しんでこいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ドッソレスはいい所だからな。金さえありゃよ、なんだって手に入るし、好きに遊べるんだ。しかもそれに対してとやかく言ってくる奴もいねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "君はこの都市が随分と気に入ってるようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ん？　そりゃもちろんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だったら、ここに住もうと考えたことはないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ここに住むだって？　そんなひでぇこと言うなんて、あんた……俺のことが嫌いなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そんなことはないが。待て、それはどういう意味だ？　さっきのはただの冗談なんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "全然笑えねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ここに住むのはまっぴらゴメンだ。ドッソレスは休暇を過ごすにゃいい所だが、生活するとなると全然ダメだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "さっき喧嘩してた連中を見ただろ。ああいうのがわんさかいるんだぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "将来子供ができたとするだろ。昼間から酒を呑んで夜はギャンブルだなんて子供の教育に良いわけがない、ろくでなしに育つだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "昼間から酒を呑んで、か。今の君と私みたいに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "その通り、今の俺たちみたいにだ。うちの親父とお袋は俺のことを穀潰しって呼んでるぜ。このどら息子が、つってよくどやされてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ハハッ、私はそんなふうに呼ばれたことはないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（そう、あの人からは……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私には、どら娘になる機会なんてなかったんでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そりゃ、さぞや肩がこる暮らしだったろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうでもないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私の保護者は頑固オヤジでな。妻に実家に帰られてから、自暴自棄になって、呑んだくれてギャンブル漬けだ。最近じゃ頭頂も寂しくなってきていて、みっともないったらないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "彼は頼りにならない、私が家族を養わなくちゃいけないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それに、私が戦闘課程で全科目オールＡを取ってからというもの、私に対してちょっかいを出そうという奴は誰もいなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "道理で。さっき「ケンカの仲裁」に入った時のあんたは、全く容赦がなかったもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "おかしいな。やっぱりあんたに見覚えがあるぞ。特にさっきあんたが酔っ払いに掛けた技……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……ゴホンッ！　気のせいだ。あまり深く考えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そうか……でもまぁ──さっきの話だが、実際ドッソレスに住めるなんてことになったら、以前の俺なら多分狂ったように大喜びしてたろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "さっき君は、絶対ここには住みたくないと言ってたじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "察しろよ。確かにさっきはそう言った。だがここはボリバル人の夢の都市なんだぜ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ボリバル人の誰もがドッソレスに憧れ、なんとかしてこの街に残ろうともがいてんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ここの暮らしを見てみろよ。ハハッ、外であんなに滅茶苦茶に戦争してるなんて想像できるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "つかぬことを訊くが、君もボリバル人だろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "まあな。つっても数年前に家が戦に巻き込まれて壊されてな、逃げ出すしかなかったんだが……そこは今でも戦地だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "みんなでドッソレスに移住できないかと考えたけどよ、そん時ゃ金がなくて街に入ることすらできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "それで？　選べるもんなんてなかったさ。追われるまんま東に逃げて……まさか最終的にクルビアまで行くことになるとは思わなかったけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "当時はクルビアがどんな場所か誰も知らなかったんだ。だが戦争はないし、落ち着いて暮らせるとこだ……それから生活は徐々に良くなっていって、金も稼げるようになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "今じゃもう、ドッソレスは俺が入るのを拒まないってわけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "街が君を拒まなくなったのと同じように、君の方の気持ちもかつてとは変わったんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "確かにそうかもしれないが、それも仕方のないことさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（土地と、土地に住む人……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（ドッソレスのような都市は、多くの人が集まる一方で、同じくらい人を拒んでもきた。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（結局のところ、ここは誰の街なんだ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "おっと、どうしたんだ？　眉間にしわを寄せてよ。嫌なこと聞かせちまったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……いや。少し考え事をしていただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私はまだボリバルをあまり知らなくてな。ドッソレスもだが。おそらく、時間がまだ足りていないんだろう。なぜ人々がこの地に群がり、去りたがらないのかが、いまいち理解できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だから今はまだ、評価を下したくはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "急に真面目臭くなってどうしたんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "真面目というほどのことじゃない。軽い気持ちで話してるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "批判することは難しくない。だが否定した後でより良い提案ができないのであれば、それは軽率で無責任というものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "今言えるのは……私から見て、ここは決して素晴らしい都市ではないということだ。少なくとも私の性格には合わない。この街はもっと良くなれるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "……まぁ余所からきた人間がどう考えようと、それは仕方ねぇことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ただ、ボリバル人にとっちゃ、ここはもう十分素晴らしい場所なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "俺がガキの頃の話だ。夜中に反抗軍と名乗る奴らが家に押し入って来たんだ……みんな無事だったが、家族全員すっかり縮み上がっちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "内乱か……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そんなとこだろうな。実は俺も、やり合ってた奴らのことについてよくわかってねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "だが、要するにそいつらのせいで、戦場はどんどん広がって、畑や家がなくなっちまって、俺たちゃすべてを失った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ボリバル人のほとんどが俺たちと同じだ。いつ何が起こるかなんてわかんねぇし、次の瞬間には金も人も、故郷も全部なくなってるかもしれねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "少しだけ理解できた気がするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "衣食も確保できず、住居も常に脅威に晒されている状態じゃ、働いて収入を得ることなど、過ぎた願いだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そんな状況で、まともに生きられる場所があると知ったら、きっとそこは夢のような所だと誰もが思うだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ボリバル人にとって、ドッソレスはそういった場所なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "まあ、大体そういうことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "俺はただ運が良かったんだよ。もしがむしゃらになってボリバルを離れていなけりゃ、ドッソレスは今でも俺の心の中じゃパラダイスだったろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なら今は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "今でも、やっぱりここは好きだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "理由を訊いてもいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "理由なんてないさ。ここは休暇に最適だし、それに……きっと……ボリバル人には希望が必要なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "もしあの当時、ここに入れていたとしたら、今頃どんな生活をしていたか想像できるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "どうだろうな……もしかしたらさっきの酔っ払いと同じような境遇になってたかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "どうにか街に留まろうと必死で働いて金を稼ぐか、ギャンブルで大儲けするか、多分すぐに使い果たしちまうだろうが。人生の夢だってこの街で小さい店を持つことくらいで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "想像もできねぇな。もしかしたら俺はもう、本当のボリバル人とは言えないのかもしれねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いや、君はボリバル人だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どこの人だと私が訊いたら、君は何と答える？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そりゃあもちろん……ボリバル人だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それで十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "もし君がボリバル人でないなら、どうして酒を飲む手を止めてまで私に話して聞かせてくれるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それだけの熱量を、ボリバル人でもないただの観光客が持つか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "……慰めるのが上手いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうか？　友人からは、人を罵る時だけ口が達者だとよく言われるんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "謙遜するな。あんたの口はどんなときも達者だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ハハッ、褒めの言葉は有り難く受け取っておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私はそろそろ行くとするよ。今日は楽しかった。また機会があれば会おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "クルビアか……あそこの司法制度については聞いたことがあるが、なかなかのものらしいな。今度時間を見つけて訪ねようと思っているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "歓迎するぜ！　もし本当に来たら、コーヒーをおごってやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "ボリバルに有名なコーヒーブランドがあるのを知ってるか？　うちでは客人をもてなす時にはそれを出すんだ。クルビアに来たなら、思う存分飲ませてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "わかった、機会があれば必ず行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "あんたがおごってくれた酒と、楽しい話に対するお返しだ。礼には礼で返さないとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "そういえば、まだ聞いてなかったな。あんたはどこの人なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "龍門だ。私は龍門から来た。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "龍門もとても良い場所だ、ドッソレスに負けていないくらいにな。もしまた休暇の機会があれば、龍門へ行ってみることをお勧めするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "きっと失望するようなことはないはずだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
