{
  "server": "jp",
  "storyId": "act15mini_level_act15mini_st02",
  "groupId": "act15mini",
  "stageId": null,
  "title": "氷原の娘",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15mini/level_act15mini_st02.txt",
  "sourceHash": "4779ab5e5a2d17d2d8cfc199f7d2e5278682a53e841253495b0ba658ad84df8b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "強靭な山の戦士",
      "text": "失踪したラーセたちのことは何かわかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな山の戦士",
      "text": "ああ。もう探す必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな山の戦士",
      "text": "悪魔がやって来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな山の戦士",
      "text": "向こうの氷上に、アーツでえぐられた痕跡が残っていた。苦しい戦いを強いられたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強靭な山の戦士",
      "text": "……霜楓の根たる、尊敬すべき戦士たちよ……まさか彼らの遺体すら残らなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな山の戦士",
      "text": "氷原の天気は移ろいやすい。ゆえに急変があったのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強靭な山の戦士",
      "text": "それにしても、近頃はこんな天気ばかりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな山の戦士",
      "text": "サーミはすでに、エイクティルニルを通じて我らに警告していただろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな山の戦士",
      "text": "行こう。砦を固め、すべての関所に目を光らせなければ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "「我々は冬牙連峰へと入った。現在の気温は……氷点下31度。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "「現状、サーミ領内では通信基地局が見つかっていないため……依然として、マリアム主任の観測隊とは連絡が取れていない。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "はぁ。マリー先生がいないんじゃ、このノートは誰に見てもらえばいいんだろう。いつもあたしのレポートを見て、「ここをもっと観察するといい」ってポイントを教えてくれるのは先生なのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……「我々は、以前の観測記録に記されていた、冬牙連峰の麓に広がる森林の端にある、集落の前を通過した。」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ふぅ……手袋を一枚外しただけでも、すっごく寒く感じるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "何か手伝うことはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あっ、ううん、大丈夫だよ。もうすぐ書き終わるから！　そしたらすぐにここを出て、勇気を出して雪の中を歩いてみよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "で、どこまで書いたんだっけ？　確か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "「しかし現在、その集落はすでになくなっていた。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "「シモーネさんに――」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あっ、いけない！　これは消しとこう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "「同行するサーミ人に、この点について確認してみたところ、サーミ人の部族はこうして居住地を変えることがあるという。」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それはなぜだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "調べてみようと思うけど、まだ理由まではわからないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさんが言うには、サーミから、危険が迫っているからそこを離れろってお告げがあるんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "でも、これまで集めた気象データは過去のものと比べても異常はないし、長期データにもそれらしい傾向はないんだよね。サーミは一体どこに危険があるって言ってるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どうやら……科学考察課の資料を……更新しなければならないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん。サーミはやっぱり、あたしたちにとって未知の領域だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "だけど、サーミの人はあんまり干渉されたくないみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "マリー先生も、前からあの人たちと協力関係を築きたいって言ってたけど、全然うまくいってないんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ウルサスルートの申請はすっごく時間がかかるし、本当ならサーミから氷原へ入る新しいルートを開拓して観測基地を増設できれば、きっと今後の調査がもっとスムーズになるはずなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "残念ながら、サーミ人は……誰であれ氷原に立ち入られたくないようだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうらしいね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あれっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あたし今……マリー先生と話してた？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさん、シモーネさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あたし今――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "――向こうにいくつか人影が見えない？　雪がすごくて、よく見えないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "マゼ……ラン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "も、もしかしてほんとにマリー先生！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさん、あたし向こうを見てくるね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "科学考察課主任？",
      "text": "マゼラン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "（ああ、やっぱり……！　見つかってよかった！　きっと無事でいてくれるって思ってたよ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "（変だな……なんで声が出ないんだろう？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "（う……心臓が、バクバクする……あたし、震えてるの？　どうして……？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "（ダメ、このままじゃダメだよ！　マリー先生を――みんなを連れて帰らないと！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "先生――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "――っ！　むぐぐ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "静かに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "聞くな、見るな、音を立てるな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "見知らぬ少女",
      "text": "お前を責めはしないさ、シモーネ。随分長いこと訪ねてこなかったのだから、あれを感じ取れずとも不思議ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ふふっ……訪ねるだなんて、私はもうお客様扱いなのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見知らぬ少女",
      "text": "こいつほどのよそ者ではないが、客であることは事実だな。お前たちが選んだ登山ルートは誰も使わなくなって久しいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見知らぬ少女",
      "text": "やれやれ。この辺りを通る時は遠回りすることにしているんだが、それが幸いしたようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "あの戦士たちはまだあなたを受け入れてくれないの？　この土地自体が、あなたを愛する子としてみなしているというのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……何はともあれ、助けてくれてありがとう、ティフォン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ああ。報酬はいらないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "この辺りに隠した食料は、数ヶ月しのぐには十分な量だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ところで、さっきの話では、失踪した南の奴らを探すために氷原へ入ろうとしているようだったな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "だったらわたしも行こう。そいつらは何らかの危険に遭遇しているだろうし、お前と共にこの南から来た人間を守ってやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あー、あー……ん！　声が出るようになってきた！　……あたしも話してもいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ねえ、聞いてほしいんだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "大人しくしていろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "……なぜ両手を上げた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっと……サーミの人はすごく気性が荒くて、よそ者が氷原に入るのを好まないって聞いたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "で、でもあたし、本当に悪意なんてないからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ん……？　確かに、ここの戦士たちは荒々しくはあるが、わたしは戦士ではないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "とにかく、お前のことはさっきアーツで起こしたばかりだが、恐らくまだあの声が聞こえているんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "んっと……うん、聞こえるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "だけどもう大丈夫。これが幻聴だってことはわかったから、もうのんきにおしゃべりしたりしないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうだ、これもノートに書いとかないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "二人とも、この幻聴の原因はわかる？　極端な気候に置かれたことで肉体的な疲労が出たのかな？　あるいは、この辺りの水に中枢神経を麻痺させる成分が含まれてるとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "はぁ……こっちに耳を寄せろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "（小声）オッケー、なあに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "よし。反対側もだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん……ってあれ？　ないしょ話するんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "今何か耳に触ったよね？　なんだかひんやりしたんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "これをベロの下に押し込んでおけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "こ、苔と泥……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "探検家は、食料が足りない時には革製品を煮て食べることもあるってことは知ってたけど、まさか苔まで非常食になるなんて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "よーし、勇気を出して試してみよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "言っておくが変に勘繰る必要はないぞ。そのまま口に含んでいろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "こうすれば自分の声しか聞こえなくなる。その妙な雑音に悩まされることもなくなるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうなの？　ありがとう！　君、いい人だね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……えーっと、でも、こうすると周りで起きてる危険にすぐ気付けなくなるよね？　登る時の平衡感覚にも影響が出るし、とっても危ないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "大丈夫よ、ティフォンのやり方を信じて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "私たちが、穢れた雪のない場所まで連れて行ってあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "うむ。その苔を吐き出してもよくなったら、また合図してやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "それまでは、大声で話すなよ。「あれ」に聞かれないようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うぅ、わかったよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "若き観測員はふと立ち止まり、誰もいない方向に目を向けた。\n彼女は二秒だけためらって、そのあとすぐに、指示された通り、何でもないことのように泥のついた苔を口に入れた。"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ほんとだ、何も聞こえないや。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "止まれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "雪の中に鼷獣（けいじゅう）の毛が混じっている……偵察用のアーツね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "マゼランを止めてくれてありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "何をどうしたって戦士たちの目を逃れることはできないけれど、これで少なくとも、私たちの訪問がいくらか敬意を払ったものになるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "こいつに苔を吐かせようか？　お前から状況を説明できるように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ここから氷原に入ろうなどと考えるくらいだ。こいつはきっと、この北地戦線がどういうものかを知らないんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "その必要はないわ。あの戦士たちとの交渉は私がするから。多分彼らのほとんどは、共通語かクルビア語を聞いただけでハンマーを振りかざして追い払おうとしてくるでしょうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……ほら、来たわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "はぁ……よりによって「軍団」の戦士か。あいつらが我々の話など聞くわけがない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "サンタラの木の娘よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "樹痕の戦士たちにご挨拶申し上げます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "部外者を一人お連れになっているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "それと……黒き弓を背負いし狩人も。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "どうかご判断を急がないでください。外から訪れたこの方はサーミに何も求めてなどいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "我々はただ、道をお借りして果てなき氷原へと向かいたいだけなのです。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "サーミの戦士たちは静かに一行を取り囲んだ。一歩も引く気はないらしい。\n武器を手放すこともなく、一言も発さずにいる彼らに対して、サンタラはどんな回答をすべきかわかっているようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……誰であれむやみに氷原へ立ち入るべきではないということは理解しています。皆さんが高い壁を築いたのは、氷原の厄災を食い止めると共に、サーミの人と獣を通さぬためでもあるのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ですが彼女は、氷原で消息を絶った恩師を助けたいと切に願っているのです……此度のことは近しい人の命に関わるもの。決まりに反することとはいえ、例外として通していただけないでしょうか。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "サーミの戦士たちはやはり動こうとはしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……どうか信じてください。我々が彼女をよく見ておきます。この南の人は、サーミに対して軽率な行動をとることも、道に迷うことも、ましてやあなた方の敵になることも決してありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "我々が彼女に同行するのは、今後彼女の身に起こりうる、そして失踪した人々の身にはすでに起こっているかもしれない最悪の事態に対処するためなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "……その黒き弓を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "狂ったサイクロプスの娘を信じるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "黒き弓が何を意味することがありましょう。彼女もまた、あなた方と同じものに立ち向かっているのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "彼女がいかに正気であっても、その武器が災いをもたらさないとも限りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "かつては我らも、戦士たちひとりひとりの遺品を持ち帰っていましたが、そうした遺品に残った穢れが敵を引き寄せるのだということに気付いたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "あなたはよくおわかりのはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "――サンタラの樹下のシモーネよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "私はもうシャーマンではありませんが、かつての身分を以てお願いを申し上げます。どうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "確かに、我らの多くは今でも、かつては雪祭司となるはずだったかの戦士を覚えております。ですが彼女がその責務を放棄した以上、我らはその過去を振り返る気はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そんな彼女の力量でも、周りの人間の面倒を見るくらいのことはかないます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "氷原で失踪した人々は十数名いるのです。私の記憶が確かなら、これほど多くの命のためなら北地の戦士は融通を利かせてくれるはずだと存じます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "それはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "過酷な運命に耐えなさい、サンタラの木の娘よ。運命と共に生き、そこから逃げてはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……エイクティルニルの言葉ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "もしや彼は……北地全体に何かを予言したのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "部外者にはお話しできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "ですが、エイクティルニルはすでに、サーミのささやきをすべての部族に伝えるべく多くの戦士を伴って南へ向かいました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そうですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "サーミが予言を与えたからには、これ以上氷原入りを固持するつもりはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ですが、我々の持ち合わせた物資だけでは、麓まで引き返して山地を迂回することなどもはや不可能なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "たとえ悪魔のもたらす穢れが蔓延していようとも、我らはこの山々を進み、戦士の守る関所を抜けねばなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "山の民の斥候",
      "text": "「物資」……？　大地を荒野などと呼び、自然の中では生き抜けないという偏見を持っていることは、南の人々の欠点ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "皆さん、どうか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "はぁ……行くぞ、シモーネ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "こいつらにあれこれ説明する必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "そのジェスチャー、まさか……本当に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ああ。わたしを信じろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "――ちょ、ちょっと待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "んわ、口の中苦すぎ……げほ、ごほっ、話を聞いて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あたしは何にも悪いことなんて考えてない、ただの観測員だよ！　箱の中に入ってるのは全部予備のドローンだし、今すぐ開けて見せたっていい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "氷原に忍び込むつもりだってなかったの！　ただどうやってサーミの政府機関に申請すればいいかわからなかっただけで……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あれ、サーミに政府機関なんてあったっけ？　そういえば見たことないかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "なんにせよ、ここにはウルサスに提出するはずだった書類に、身分証明書、探検許可証、ダメになったルート計画書が揃ってて……これは全部、あたしが本物の観測員だってことを証明するものなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "とにかく、シモーネさんもティフォンちゃんもいい人たちだから、二人を責めるのはやめて！　あたしを疑ってるようなら、自分で説明するから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "それと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あ、あれ……？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "それは目の錯覚ではなかった。\n彼女が言葉を発するたびに、皆の表情がますます厳しくなっているのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "誰もが彼女の背後を見ていた。まるで、あの幻聴が彼らにも聞こえているかのように。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "このおまぬけ鳥！　行くぞ、走れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "やってくれたな、厄災の兆しをもたらすとは！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "こっちだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "さっき話していたよく知る道って、これのことなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "わっ――今の矢、そこの岩に当たってなかったら直撃してたかも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "冬牙連峰の岩さんに感謝しないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "吹雪のおかげで、向こうは岩を人影と誤認したんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "しかし、そのアーツはつくづく有用だな、シモーネ。やはり身を隠す時はお前を頼るのが正解だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "よし、向こうへ進むぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "後ろが静かになったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ん、どれどれ……ああ、確かに先ほどの戦士たちはもういないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "よかった、逃げ切れたんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "あるいは……これ以上追うつもりがないだけかもしれないけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "どっちにしろ、もう大丈夫ってことでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ふぅ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "なんだか急に……息が苦しくなってきちゃった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "肩を貸してやるから、もう少し寄れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あ、ありがとう……測量機器がすっごく重くてさ。防護服も分厚いから重量あるし、結構大変で。極北探索用の装備を設計した人も、山を走ることまでは想定してなかったんだろうな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "はぁ……さっきは本当にごめんね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "何も聞こえてなかったから、君たちがあたしのせいで喧嘩してるみたいに見えちゃって……慌てて大声出しちゃったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "先生にはいつも「衝動的に動かないように」って言われてるのに、うかつだったよ……ただ、幻聴を警戒する理由がわからなくてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "謝る必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "自然は何が正しく何が間違っているかなど語らないものだ。あるのはただ、近しさによる区別だけ。あの北地の戦士たちもそれと同じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっと、近しさって……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "彼らは……言うなればひとつに繋がった連峰のようなものだ。だからそこへどう働きかけたところで、山々の一部として迎え入れられることはない。お前はただ懸命にそれを乗り越えるしかないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "山を相手に改心を促したところで、平地にさせることなど当然できないわけだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "え～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "どうして戦士の人たちはまともにコミュニケーションを取ろうとしてくれないのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "言葉が通じているかはさておき、普段彼らは言葉で話す必要がないというのもあるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "たとえば、わたしとお前が朝から晩まで共に生活していたとして、毎日決まった方法で巡回や狩り、戦いを繰り返していたのなら……言葉は必要なくなるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えーと、それってお互いを知り尽くしてるからってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "いいや。意思疎通が必要になるということ自体、まず互いに異なる考えがあって初めて起こることだから、だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "わたしが彼らをひとつの連峰のようだと評するのは、つまりそういうことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "加えて、彼らはウルサス人への対処もしなくてはならないから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "何を考えているのかが一目でわからない部外者はすべて、警戒に値するというわけなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "少し残酷なやり方かもしれないけれど、生きていくためにはそうするしかない……（サーミ語）「いかなる運命をも受け入れよ」ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "（サーミ語）運命……かあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "なんにせよ先ほどのことは気にするな。わたしもシモーネに逃げる合図を送っていたしな。あの連中にいくら交渉したところで、大抵はこちらが退くことになるんだ。譲歩など期待はできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "だが、これではお前の先生を探しに氷原へ行くことはできないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "はぁ……そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "この先のアテはあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "んーと……チャパットに行って助けを求めてみようかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "チャパットというと……サーミ最南端の都市ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "うん。クルビア企業は大抵、サーミで唯一チャパットにだけ事務所を設けてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "現状、ウルサスルートは封鎖されちゃってるし、探索協会が組織した捜索隊もチャパットから出発するしかなくなってるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "だからその人たちと合流して、サーミルートの情報をできるだけ集めてみようと思うの。だって、サーミがどんな場所なのかちゃんと理解してる人なんて一人もいなかったわけだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "それなら、わたしが引き続き護衛してやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "言っておくが報酬は不要だぞ。南の人間が考える報酬には、基本的に使い道がないからな。まあ、どのみち、チャパットに行く用事もあったところだ。なんでも、依頼人がそこで待っているそうでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうなの？　ありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "シモーネさんはどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "もちろん一緒に行くわ。そう約束したでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えへへっ、ありがとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "だけど、この道はどこへ通じているのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "この山中に、戦士たちがまだ見つけていない秘密の通路があるとはあまり思えないのだけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "これはアルゲスの住処に通じる道だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……サイクロプスの洞窟ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "あるいは、わたしの家とも言う。わたしはあそこで育ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "道中施してきたサルカズのアーツによる擬装も、老練なシャーマンに注意深く観察されたら見抜かれるだろうが、奴らもサイクロプスの邪魔をしようとは思わないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "はは、まあそれも当然か。自分に対する悲惨な予言を聞きたい奴などいないだろうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "とはいえ、さっきの連中がしつこく追ってきていたら、アルゲスが家にいて我々を助けてくれるのを期待するしかなくなっていたな。彼らがそう辛抱強くなかったおかげで助かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それでも油断は禁物よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "向こうが早々に追撃を切り上げた今、私たちは吹雪の中置き去りにされたようなものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "恐れることはない。わたしが周囲に目を光らせていよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "足元で雪がザクザクと鳴る。"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そういえば……さっき言ってた厄災って何のことなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "幻聴の原因を見つけられたら、そのサンプルを採取して、ライン生命に持ち帰って分析できるし、そうすれば長時間抑制する方法もわかるかも！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マゼランの質問にすぐに答える声はなく、靴が積雪にめり込む音だけが余計にはっきりと耳に届いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "本当に妙な質問をするんだな。お前たちは、天災や霜害、裂獣の牙までもを消せるとでも思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "厄災は面倒ごととしては比較的珍しいほうだし、起きた時に何とかして打ち勝てばいいだけだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "まさしく、今そうしたようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ふと、雪を踏みしめる音が消える。気付けば、凍っていた積雪はいつの間にやら重さを失ったかのようだった。マゼランは目を瞬かせた。"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ま、また幻覚でも見てるのかな？　それとも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……本当に、雪が上に向かって浮き上がってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ええ、そうよ。見間違いなんかじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "雪が空に「積もって」、私たちの頭上に浮いているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "それなら……サンプルを採らないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ドローンをつけるから、一分だけちょうだい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "これで、浮き上がっていく途中の雪を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "採取完了、っと！　次は、空に「積もってる」雪を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "――危ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "雪が崩れてきているわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それに、かろうじて見える範囲の状況から判断して、前方にはもっとたくさんの雪が「積もっている」みたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "このまま進んだら、上から落ちてくる雪で三人とも埋もれてしまうかもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "恐らくこの現象はしばらく続いていたんだろうな。だからあの戦士たちは追ってこなかったんだ。我々がすでに、死地に追いやられた獲物であると知っていたわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "雪祭司のアーツでどうにもできないのなら……私にも無理ね。ごめんなさい。氷雪を呼んでみたところで、私に力を与えてくれる凍土の縛りを抜け出して、上へ浮き上がるばかりだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "――待って、マゼラン、戻りなさい！　一人で進んだら危ないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "へーきへーき！　サンプルを採るために少し離れるだけだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "こうすれば、ドローンが雪を集めてる時にバランスを崩して、雪が崩れてきちゃっても、埋もれるのはあたしだけで済むでしょ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "――うわっ、危なかったぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "感じるか？　雪が震えているのを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "我々が一歩進むごとに、あれを呼び覚ましてしまっているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "それでも、ああいう子がこんなところで立ち止まるべきじゃないわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "手を出せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "何をするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "この方法を嫌う奴も多いが、こうした特殊な状況であれば試してみるべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "それと、矢じりまで血を流すには、少し深く切る必要があると言っておこう。お前ならわたしの手当など必要ないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "遠慮なくやって、ティフォン。ただ、手元を狂わせて深く切りすぎたりはしないようにね。滴る水もすぐ凍るほどの寒さだから、痛覚は麻痺しているし大丈夫よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "さっきから、雪の落ちる頻度が上がっているわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ああ。この土の下にある黒い種は、わたしの弓と矢を知っている。こういうことがあるから、わたしはいつも誤解されてばかりなんだが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "……よし。あとはマゼランの――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "――おい、マゼラン！？　状況報告を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あっ、あたしは大丈夫だよ！　落ちてきた雪が道を塞いじゃっただけだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ここは、除雪モジュールに切り替えてっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "できた！　これで二人も通れるね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "まずは手を出せ。手袋は取れよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっ？　ちょっと心の準備をさせてね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "――はいどうぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "これでよし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三人の血をつけた矢が冷たい風を切り裂くと、轟音と共に「積雪」が崩れ落ち、崖の上へ釘付けにされた。すると、唸るような音を伴う奇妙な振動がピタリと止む。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "……サルカズの巫術ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "中央の「積雪」はもう落ちてこない。次からはわたしが危険を見極めて、同じ方法で事前に取り除いてやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "さあ、進むぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "森の民",
      "text": "角獣がまた何匹も、泉のそばで息絶えている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森の民",
      "text": "サーミのご意志通り、ツンドラを越えて部族全体を連峰の麓からここへと移してきたというのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森の民",
      "text": "どうしてまだ厄災の浸食を逃れられないんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "森の民",
      "text": "もう一度……もう一度占わなければ。この土地はいつになれば我らに安寧を与えてくれるのかを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "森の民",
      "text": "……あるいは、あの時同行したサイクロプスの言葉は真実だったのだろうか？　我らの部族は本当に、あんな悲惨な末路を迎えねばならない運命なのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "えっと……ここ、誰かのおうちなんだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ああ。以前はわたしの家でもあった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "やれやれ。あの人はいつも通りいないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "で、でも、こ、ここってただの岩窟だよね……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "し、シモーネさんは用事でまたどこかに行っちゃったし……今いてくれたらこれが普通のことなのかどうか教えてもらえたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ううん、何でもない！　ここについてノートに書く時、どう表現すればいいか考えてただけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "好きにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "ほら、こっちだ。干し肉と塩があるから持って行け。アルゲスはケチじゃないし、ここにあるものは好きなように持って行って構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "これだけあれば、山を下りるまで持つだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "ありがとう、ティフォンちゃん。でもちょっと待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あたしはそのアルゲスさんのことをよく知らないし、こんなことしてもらっていいかどうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "問題ない。彼女自身も言っていたんだ。（サルカズ語）「白日の下に晒された物事はすべて共有のものになる」とな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "これでわかっただろう。あの人は気にしないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そっか！　えへへ、それじゃ遠慮なく。ありがとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "あっ、それと……この洞窟について詳しく記録してもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "写真も何枚か撮りたいんだけど、大丈夫かな？　もちろん、その辺のものを勝手に動かしたりはしないから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "わざわざ聞いてくるほどのことか？　別に構わん。それが終わったらたき火のそばに休みに来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "わかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "そうだ、このノートも読んでいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "それも構わん、好きにしろ。あの人のノートに書かれているのは、本人にしかわからないことばかりだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "わかった……って、あれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "……ねえティフォンちゃん、聞きそびれてたことがあるんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "論理的に考えれば、そもそも自分の知らない言葉や聞いたことのない概念を幻聴で聞くなんてありえないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティフォン",
      "text": "お前の言う「論理」というのはわからんが……どうしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "とにかく、このページを見て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "「ひとたび箱を開けてしまえば、アンドスコターニルに気付かれてしまう。」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マゼラン",
      "text": "この言葉、君が周りのノイズを遮断してくれる直前に、先生の声が伝えてきたのと同じなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "ウルサス人の通信機が……何か受信したみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンタラ",
      "text": "今受け取った情報がどれくらい前のものかはわからないけれど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "途切れ途切れの通信音",
      "text": "……軍団所属の……国境警備隊に……報告……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "途切れ途切れの通信音",
      "text": "「フリエーブ鳥」の助けを借り……「黒印」は……サーミにて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
