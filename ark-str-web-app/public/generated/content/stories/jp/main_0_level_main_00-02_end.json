{
  "server": "jp",
  "storyId": "main_0_level_main_00-02_end",
  "groupId": "main_0",
  "stageId": "main_00-02",
  "title": "防衛",
  "storyCode": "0-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_00-02_end.txt",
  "sourceHash": "7fd861b3dcc15510e5826255c8c26d10a57915781d00af65b7da4d41e0dd2a9c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "っはあ、はぁっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "レユニオンの奴ら、なんて勢いだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "――おい！　そこの貴様ら、何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "こんな時に、ここで何をしている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "えっ？　な、何って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "言いよどむとは、まさか連中のスパイか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "（ウルサス当局に正体を知られたら、面倒なことになる……！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "（となれば――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そちらの憲兵さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "……子供……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "っ、貴様……感染者か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "そこから動くな！　武器を置け！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……！　（小声）防護の準備を。向こうが敵対姿勢を見せたら、すぐに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "待て、これは霧か……？　一体どこから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "お願いです、話を聞いてください！　我々の共通の敵は誰なのか、本当はあなたもよくわかっているはずですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ッ――！　ドーベルマンさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ああ！　――重装オペレーター！　敵襲だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "な、何ッ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……レユニオン……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "アーミヤ、気をつけろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ほかの連中とは何かが違う。奴は恐らく、相当の実力者だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "フン、逃げ出すか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "無駄なことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "行け。奴らを八つ裂きにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "あの動き……部下の練度も相当高いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "となると、率いる彼女はレユニオンの幹部クラスか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……先ほどから、段々と霧が濃くなってきていますね。この機に乗じて、奇襲を仕掛けてくるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "憲兵団のみなさんも、すぐにここから離れてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "退路が断たれる前に離脱しなければ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "――断る。行くなら、貴様らだけで行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "……見逃してやるということだ。さっさと消えるがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "我々は、この場を死守せよと命を受けている。持ち場を離れるわけにはいかんのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "……子ウサギよ。貴様のような感染者が、ここを訪れた目的に興味などないが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "この街を破壊するために来たのなら、いずれ必ず罰を受けることになる。ウルサスの潰えぬ怒りの炎によって、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "しかし、そうでないのなら……ここで起きていることは、貴様らとはなんの関係もないことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "ならば行け。これ以上構っている暇はないのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "――ウルサス人たる者、敵に背を向けるわけにはいかんのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ありがとう、ございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "行きましょう、ドーベルマンさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "了解。――総員、第一合流地点へと向かえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "グズグズするな！　各小隊、速やかに行動せよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "来い、感染者ども！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵隊長",
      "text": "どうした、突っ立っているだけでは始まらんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "チェルノボーグのクズ野郎が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "――皆殺しにしてやる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
