{
  "server": "jp",
  "storyId": "act44side_level_act44side_06_beg",
  "groupId": "act44side",
  "stageId": "act44side_06",
  "title": "渦中",
  "storyCode": "AT-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act44side/level_act44side_06_beg.txt",
  "sourceHash": "3fddbc656d2dc05463bf232aad363dbebbbee03291281095263e921137dde1fd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "疲れた警察官",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちした警察官",
      "speakerId": null,
      "text": "突っ立ってる場合じゃないわよ！　あの無法者ども、容疑者よりもタチが悪いんだから！"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れた警察官",
      "speakerId": null,
      "text": "……俺は疲れた。"
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちした警察官",
      "speakerId": null,
      "text": "こっちだってヘトヘトなんだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れた警察官",
      "speakerId": null,
      "text": "俺が言ってるのは、本当にもう嫌気が差したってことだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れた警察官",
      "speakerId": null,
      "text": "社会のゴミどもと一緒に徒党を成して、たった一人を追いかけて、*極東スラング*、それでも捕まえられやしないんだぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れた警察官",
      "speakerId": null,
      "text": "だが、彼女は俺たちには髪の毛一本触れようとしない。実のところその鞘で打ち倒された連中のほうこそ、札付きのクソ野郎の集まりだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れた警察官",
      "speakerId": null,
      "text": "彼女が奴らをぶちのめしてる一方で、俺たちはそのクズどもと一緒に彼女を追ってるなんて……"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れた警察官",
      "speakerId": null,
      "text": "クソッ……ふざけてやがる！"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れた警察官",
      "speakerId": null,
      "text": "惟任の奴は「じきに良くなる」としか言わないが、入職してもうすぐ十年経つ俺は、肩の階級章もそろそろ変わろうって時なのに、状況は何一つ良くなんてなってない。何が――"
    },
    {
      "type": "dialogue",
      "speakerName": "横柄な忍者",
      "speakerId": null,
      "text": "どけ、ポリ公！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちした警察官",
      "speakerId": null,
      "text": "将吾！"
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちした警察官",
      "speakerId": null,
      "text": "このクズ、警察に手を出すつもり！？"
    },
    {
      "type": "dialogue",
      "speakerName": "横柄な忍者",
      "speakerId": null,
      "text": "俺はどけっつったんだ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちした警察官",
      "speakerId": null,
      "text": "あ、あなた――"
    },
    {
      "type": "narration",
      "text": "二人の視線がかち合った。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "道を開けてはもらえないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "さもなくば、私の罪状に公務執行妨害がもう一つ増えることになるだろう。あるいは殺人罪になるかもしれないな。今の私はそうなったとて構わないが。"
    },
    {
      "type": "narration",
      "text": "警官はため息をつきながら、手に何も持っていないのを見せるようにして、少し横へ退き道を開けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "気落ちした警察官",
      "speakerId": null,
      "text": "将吾の代わりにあいつをのしてくれてありがとう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "繰り返される放送",
      "speakerId": null,
      "text": "リン、リン、リン、リンゴネス、リンゴネスデパート～♪"
    },
    {
      "type": "dialogue",
      "speakerName": "繰り返される放送",
      "speakerId": null,
      "text": "古今東西、何でもそろうよ～♪　リンゴネスデパート～♪"
    },
    {
      "type": "dialogue",
      "speakerName": "客引き",
      "speakerId": null,
      "text": "まだ明るいうちですが、中で一杯どうですか！　あなたみたいに豪快な鬼族の方にぴったりの、クラフト黒ビールを新しく入荷しましたんで――"
    },
    {
      "type": "dialogue",
      "speakerName": "客引き",
      "speakerId": null,
      "text": "昔ながらのお酒がお好きでしたら、秘蔵の芋焼酎も……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "お洒落な男性",
      "speakerId": null,
      "text": "お姉さん、どうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "どいてくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "お洒落な男性",
      "speakerId": null,
      "text": "そんなに急いでどうなさるんです？　まさかあなたも、この大地にたった一つしかない「幸福」に至る足がかりを探して――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "お洒落な男性",
      "speakerId": null,
      "text": "あれっ、あなたもしかして「金石会の青鬼」じゃありませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "お洒落な男性",
      "speakerId": null,
      "text": "萌々香さんはどこに行ったのか、聞かせてもらえません？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "彼女のファンか？　あるいは、彼女を三船の元へ連れて行き、報酬を受け取ろうという算段か？"
    },
    {
      "type": "dialogue",
      "speakerName": "お洒落な男性",
      "speakerId": null,
      "text": "そうじゃなくて、あなたにお願いがあるんですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "お洒落な男性",
      "speakerId": null,
      "text": "ここ数日の萌々香さんみたく、俺をどこかに雲隠れさせてもらえませんかね？　そうすれば、俺もあの子みたいにバズれるかもしれませんし。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "野次馬",
      "speakerId": null,
      "text": "あ、「青鬼」だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "野次馬",
      "speakerId": null,
      "text": "すいません、一緒に写真撮ってもらってもいいですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "失せろ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "野次馬",
      "speakerId": null,
      "text": "えっ？　「青鬼」さん、待って――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "客引き",
      "speakerId": null,
      "text": "あ、あのー、うちはただの飲み屋なんですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "「煉黒」をくれ。持ち帰りで。"
    },
    {
      "type": "dialogue",
      "speakerName": "客引き",
      "speakerId": null,
      "text": "申し訳ありません、「煉黒」は何年も前に製造終了となっておりますので、同じ酒造の新製品でもよろしいでしょうか？　最高級ラインの商品ですので、きっとご満足――"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "それでいい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "店員が酒を取りに行っている間、星熊は店先に背を預けて、周りに集まり始めた人々を冷ややかに見渡していた。\n龍門であれ、御机であれ、都市というものはとにかく広い。\nゆえに、一人の人間の死が、都市の人々すべての心を揺さぶるようなことはない。どれほど地位の高い人間であろうとそれは同じことで、有名無実の極道の会長の死となればなおさらだ。\n死にゆく人もいれば、無論生き続ける人もいることを、星熊は知っていた。\nだが、鉄斎の死によって、彼女はもはや、ここで生きている人々やこの都市との繋がりが絶たれてしまったように感じていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ついてきている奴はいないな。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ここにしよう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "星熊が瓶の蓋を開ければ、つんと鼻をつくアルコールの香りが溢れだす。\nその酒に口をつけるまでもなく、漂うその匂いを嗅いだだけでも、彼女は嫌なめまいを覚えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "この一杯はあなたに捧げます、叔父貴。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ふぅ……値段も度数も高くはあるが、味は薄っぺらいな。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "――叔父貴。今回の帰郷で誰かと酒を飲んだのは、家で父を弔った時と、今だけなんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "あの怪談話を追いかけている連中は、「青鬼」が死人と杯を交わすなど、いかにもそれらしいことだと思うのでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "怪談……ハッ、怪談か。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "極東における私の物語は、真相もわからぬままに正誤を決めつけ、一歩踏み出してしまった時点で、終わりを迎えました。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "本当に、バカな真似をしたと思います。結果的に私は生き延びましたし、チェンの奴も似たような決断を迫られた末、生き延びることはできていましたが、それを踏まえてもやはり、そう思うのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……チェン・フェイゼといえば、叔父貴にもあいつに会ってもらいたいものでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "あいつは「侠」の字に相応しい奴なんです。炎国でも極東でも、同じ形で綴られるこの「侠」という字は、一説によると、独り剣を携えて無数の軍勢の前に立つ人を表すものだそうですから。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "この一杯は、あいつに捧げましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "とはいえ、私はあいつとは違うんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "あいつは肝が据わっています。それに引き換え私は――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ははっ、叔父貴に言われるまでもなく、自分でもこの言葉にも違和感を覚えますが……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "それでも……やはり怖いのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "自分の生死を顧みずにいることは、私にとっては難しくもないことです。ですが、ほかの人たちを、私が守るべき人々を、私の……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……帰るべき場所を、顧みずにはいられません。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "正直なところ、こうなったからには今すぐ龍門へ戻るべきだと思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "龍門近衛局の人間が極東で殺人を犯したとなれば、一大事です。お嬢様はもちろん、リンさんも、フミヅキさんも、ウェイさんまでもが、この件で神経をすり減らすことになるでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "あの人たちは私を見捨てたりなどしません。向こうの人柄はわかっていますし、向こうも私を理解してくれていますから。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ですが、この件はあくまで私が招いたことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ようやく見つけた帰るべき場所を、またしても私が仕出かしたことで傷つけることになるのなら――"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "どんな顔をして、あそこを「帰るべき場所」だなどと言えばいいのでしょう？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "あるいは、この刀を抜き、一匹の鬼に――殺人鬼になるしかないのかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "そうなれば、金兵衛を殺し、奴に従い刃を向けてくるチンピラどもを殺し、私を阻む警察官を殺し……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "やがては雨夜に御机の通りをさまよう災いとなり、完全な怪物に――本当の怪異になるのでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "憂さを晴らして悦に浸り、流れに身をゆだねるまま時勢を受け入れて、狂宴の中でこそ輝く狂人となり、そうして奴の……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "いいえ、御机の人々の望む通りの姿となるのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……もはや、進める道などありません。どの道を選び、何をしようと、すべては間違いなのですから。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "――酒は……もう残り僅かになってしまったか。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "お前、かなりの酒豪だな。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "誰だ！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……部下は連れてきていないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "今は俺一人だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "叔父貴の遺体はどうなった？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "今は警察が別所に安置して、警護に当たっている。死因は刃傷だと確認が取れたが、それがお前の刀じゃないこともわかってる。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "だったら、なぜ私を捕まえようとしたんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "上からの命令でな。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "あなたもそのために来たのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "いや、俺はお前と酒を飲みに来たんだ。"
    },
    {
      "type": "narration",
      "text": "警官は勝手に地べたにあぐらをかくと、おちょこに酒を注いだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……うっ、こりゃかなり強い酒だな。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "理詰めで私を説き伏せて、情に訴え、素直に署まで同行させて、上からの命令を果たそうという腹積もりか？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……ああ。そのあとは、お前を御机から逃がして、おとなしく龍門に帰らせるつもりだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "上の命令に逆らって、か？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "お前が御机に来た直後に、俺が部下を差し向けてお前を捕らえさせたのはなぜだと思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "「二十年前に龍門で重大な事件を起こしたヤクザ者の幹部が、龍門に戻ってきたら」と考えると、私も、そいつを捕まえて事情を聞くだろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "それだけだと思ってるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ほかに何がある？"
    },
    {
      "type": "narration",
      "text": "警官は星熊の目を見据えた。\nそして、彼女が隠し事をしているわけでも、冗談を言っているわけでもないと理解するなり、前触れもなく星熊の顔面を殴りつけた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "よくも忘れられるもんだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "俺の名は伝えたはずだ。当時金石会の手で殺された議員候補も、惟任だったのを覚えてないとは言わせんぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "今の一発は叔父の分だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "お前が極道の*極東スラング*な義侠心とやらのために、考えなしに罪を被ったりしなければ、叔父の件がこれほど長く闇に葬られることもなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……すまなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "今更謝られても遅い。俺はもう、三船には手出しできないんでな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "奴はとっくに有力議員に取り入ってるんだ。でなきゃ、ただのヤクザが警察署で偉そうに振る舞えると思うか？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "だから、お前を逃がして、奴の思い通りにはさせないようにすることが、俺に――警察にできる限界なんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "そうして、叔父貴の死は青鬼と幽霊屋敷の怪談を裏付ける脚注となり、昔と同じようにすべてが有耶無耶になる、ということだな？　「心霊対策局」の惟任刑事。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "口では思い通りにさせないと言っておきながら、それでは奴の手助けをしているも同然だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "お前は、怪談話に三船が絡んでると見てるわけか。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "驚いた様子はないな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "「心霊対策局」の刑事にも、それなりの嗅覚はあるからな。鎖でがんじがらめにされていようが、腐ったにおいがどこからするかくらいはわかるさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "そうして過ごすうちに、その鎖とも和解したと？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "みんながみんな、お前みたいにカツ定食で自分一人の腹を満たせば済むような暮らしをしてるわけじゃないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "御机で四人暮らしするとして、ろくに身動きも取れないような手狭な家を一軒買うのにいくらかかるか知ってるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "想像したくもないな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "お前が俺の住宅ローンを一括払いして、妻と子供を龍門に連れてってくれるってんなら、喜んでお前の家をくまなく捜索してやるさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "あるいは、何かしらの方法で三船の奴を確実に一撃で仕留められるなら、危険を冒すのもやぶさかじゃないがな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "さて、今度は俺から聞かせてもらおう。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "お前は俺の一生かかっても返せそうにないローンの返済を肩代わりしてくれるのか？　三船を失脚させられるだけの、議員以上の力を持ってるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "こっちはお前を助けるために、できる限りのことはしてるんだ。お前のほうもそれに応えてほしいもんだな、青鬼よ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "警官は怒りに任せて残りの酒を飲み干した。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "ついてこい。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……断る。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "理由を言ってみろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "私は……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "……まさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "誰だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……？　何を言っている？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "……星熊さん！"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "幽霊さん！！"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "萌々香！？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "惟任、彼女の声が聞こえるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "萌々香っていうと、あのアイドルか？　お前とずっと一緒にいたはずだろ？　一体どこへやったのか聞きたいくらいなんだが――"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香の声",
      "speakerId": null,
      "text": "私はここだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "こっちだ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "星熊は声のする方向へ駆け出した。\n惟任はため息をつきながらも、その後を追いかけてくる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "姿がない……だが、声は近付いているはず――"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香の声",
      "speakerId": null,
      "text": "こっち！　こっちだよ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "萌々香！？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "どうして――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……彼女がテレビの画面の中に閉じ込められているのか？\n一瞬、そんなバカげた言葉が出かかったが、誰もそれを口にはしなかった。\n二人の前には、何の店か、そもそも営業しているかどうかもわからないような小さな店があり、その店先にはボロボロのテレビが一台置かれていた。\nその中では、髪を振り乱した萌々香が大声で叫んでいる。\nその目ははっきりと星熊を捉えているわけではなかったが、彼女は片手でカメラを叩いているようで、こちらからはテレビの画面を叩いて中から出てきそうに見えていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "speakerId": null,
      "text": "星熊さんだよね！"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ああ！　そちらには、私の姿は見えないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "speakerId": null,
      "text": "見えないけど、声は聞こえてるよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "speakerId": null,
      "text": "よかった、ほんとに……もう全部ダメかと思ってた……"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "speakerId": null,
      "text": "ううっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "泣くな。その場所はどこなんだ？　このテレビは、どこを映している？"
    },
    {
      "type": "dialogue",
      "speakerName": "萌々香",
      "speakerId": null,
      "text": "今、金兵衛のアジトにいるの。吉星さんと一緒に閉じ込められてて――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジジッ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "萌々香！？"
    },
    {
      "type": "narration",
      "text": "画面が突然真っ暗になった。\nビルの間を冷たい風が吹き抜けて、腰から下げた刀が鞘の中で小さく鳴る。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "惟任。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "私は、叔父貴の死を前にして心が乱れるあまり、色々なことが頭から抜けてしまっていた。これは完全に私の落ち度だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "お前はどうなんだ？　本当に私が萌々香をどこかに閉じ込めていると思っているのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "萌々香だけではない。吉星のこともだ。彼女は、お前たちからすれば取るに足らない、パチンコ好きの役立たずなのだろうがな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "星熊――"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "厄介者の私を送り出すためなら、そうした人間が一人二人巻き込まれたところで、金兵衛と関わってしまったからには放っておくしかない、と？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "二人の命を守れるよう、できる限りのことは――"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "「幽霊屋敷」で起きた事件の被害者に、鉄斎の叔父貴、そして数日前、鍛冶町で切られた金兵衛の手下に至るまで……お前たちはそのうち一人でも守れたことがあったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "今度は星熊が、刑事の顔面を殴りつけた。\nあまりにも重いその一撃に、刑事は少し後ずさったが、何とかそこで踏みとどまる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "自分が警察失格だってことくらい、言われなくてもわかってるさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "だが、俺に言わせれば、お前は厄介者なんかじゃない。それどころか、俺が切れる手札の中では唯一、三船に痛い目を見せて、奴にも御机で好き放題できるわけじゃないと思い知らせる切り札なんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "私を放り出すだけで、それができると思っているのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "これが警察にできる限界なんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ハッ、「警察に」か。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "お前も警察官なら、その限界もわかってるはずだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "一つ忠告しておくぞ。龍門に戻れ、星熊。そうすれば、お前の「同郷」や龍門近衛局が、事態を丸く収められるよう力を貸してくれるだろう。"
    },
    {
      "type": "narration",
      "text": "星熊は思わずポケットに手を伸ばす。そこには龍門近衛局の身分証が入っていた。\nそれと同時に、何か柔らかい物に手が触れる。それは般若の持ち手に貼っていたものを鉄斎が剥がし、渡してくれたテープ――友人たちが贈ってくれた、心からのプレゼントだ。\n彼女はふいに、どこからか、シエスタの潮の香りがしたような気がした。\nさらには、ヴィクトリアの原野の湿った藁の匂いや――\n龍門のダウンタウンにある食堂の香り、そして……\n……鍛冶町で日ごと濃くなっていく、古い屋敷特有の木材の匂い。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "確かに、その通りだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "それがわかったなら、さっさと――"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "今のは、「龍門近衛局が事態を丸く収めてくれる」という部分に関して同意する、という意味だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "私は少し慎重になりすぎていたようだ……いや、正確には、友人たちに迷惑をかけることを怖がりすぎていたのかもしれないが。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "どういう意味だ？"
    },
    {
      "type": "narration",
      "text": "星熊はその質問に答えず、腰から刀を外すと、テープを柄にぐるぐると巻き付けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "その刀を使うつもりか？　一体何をする気だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "まだ果たしていない約束があるのでな。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "人助けに行くと？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "バカな真似は――"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "このままおめおめと龍門に逃げ帰れば、お嬢様は怒りのあまり倒れかねないし、リン・ユーシャに対しては一生頭が上がらない思いをすることになるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "チェンとは……鍛え直した般若で、赤霄と一戦交えたいからな。手ぶらで帰るわけにはいかない。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "その刀を抜けば、二十年前と同じように、一生の後悔を背負うことになるかもしれないんだぞ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "叔父貴の話では、般若には僧院の秘法が込められているそうだが、あの時は私の精神が未熟であるがゆえに、鬼族の血に眠る狂気を抑えることはできなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "とはいえ、精神の強さであるとか、秘法であるとかは……曖昧なものだとは思わないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "二十年前、本当にその秘法が存在していたとして、事態が変わっていたのかどうかはわからないし、興味もない。どうあれ今この時、私にはそんな秘法など必要ないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "このテープを握っている限り、私は決して、殺戮しか知らない悪鬼に身を落とすことはないからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "それに、私の後悔は、すべてを自分一人で背負い込み、己の選択に勝手に意味を見出そうとしていたことにこそある。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "お前をそうさせているのは、警察としての立場なのか？　それとも極道としての立場なのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "警察だとか、極道だとか――"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "そんなことは関係ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "萌々香と約束したから行く。それだけの話だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "ああ、それと……彼女たちを助けに行くからには、三船に出くわすことになるだろう。そうでなくとも、私のほうから探しに行くが。奴には聞かねばならないことがあるからな。"
    },
    {
      "type": "narration",
      "text": "警官の落ちくぼんだ目と濃いクマの向こうに星熊は鋭い光を見た。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "やり合うつもりか？"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "気は進まないが、恐らく戦いは避けられない。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "だったら、奴に一太刀食らわせてやってくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "言われるまでもない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "だが、一太刀でいいのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "もう一度だけ言っておくが、俺は警察だからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "俺は署に戻る。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "死人が出ない限り、上からの圧力は俺ができるだけ引き受けておこう。"
    },
    {
      "type": "dialogue",
      "speakerName": "星熊",
      "speakerId": null,
      "text": "感謝する。言葉では言い尽くせんほどだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "惟任刑事",
      "speakerId": null,
      "text": "その重い感謝の言葉に見合う働きが、俺にできればいいんだがな。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
