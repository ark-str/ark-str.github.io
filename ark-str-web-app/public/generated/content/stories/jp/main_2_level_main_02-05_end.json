  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十七关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "アーミヤ、急いで！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "はい！　ミーシャさんも、行きましょう！"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerToken": "char_012_misa_1#4",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "……なんで……どうして、なの……？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "こっちだ、早く来い！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "よし、近辺は問題なしね。追撃には注意して！"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerToken": "char_012_misa_1#4",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerToken": "char_012_misa_1#4",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "さっきの人たちが、例の……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "……ええ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "先ほど少しお話しした、レユニオン・ムーブメントという組織……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "そこに所属する、感染者たちです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerToken": "char_012_misa_1#4",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerToken": "char_012_misa_1#4",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "なんで……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerToken": "char_012_misa_1#4",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "どうして、感染者同士で争ったりなんて……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "スカルシュレッダー……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "まさか、奴らを逃がしたのか……？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "大したことじゃないさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "どうせ逃げ切れやしないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "……それより……やっと、あいつを見つけることができた。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "ずっと……この日が来るのを待ってたんだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "到着だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "え？　本気で言ってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "地図上の指定地点はここだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "でも、これ……上へ行けってことじゃない？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "まあ、上とか言われたところで、意味はわかんないんだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "――アーミヤ～！　こっちこっち！　上だよ、上！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "え、エクシアさん……？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "上、って……ビルの上へ登るルートなんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "うん、そーゆーこと！　ほらほら、あたしを信じてついてきて！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "なんたってあたしは、龍門の道のことなら知りすぎなくらい知ってるんだから！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#5",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "あ、あはは……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "階段はこっちだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "ねえ、これほんとに大丈夫なの？　包囲してくれって言ってるようなもんじゃない？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "うだうだ言ってないで早く来なって！　グズグズしてると、レユニオンに見つかって、マジで包囲されちゃうよ～？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "うだうだって、あのねえ……！　はあ、もういいわ。あなたたち、先に行っててくれる？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "あたしは入り口を溶接してくるから。そうすれば、少しは時間が稼げるでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "……階段の壁に、ペンギン急便のマークがついてるみたいですが……ここでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "そうそう、それそれ～！　その先を左に曲がったら、階段を上がっておいで！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "ええと、一応お聞きしたいんですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "地下通路があって、そこから脱出する……とかではなく、上へ上がる……で、合ってますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "もー、何度もそう言ってるじゃ～ん！　ほんとのほんとに上で合ってるんだって！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerToken": "char_107_liskam_1",
      "operatorId": "char_107_liskam",
      "portraitKey": "char_107_liskam",
      "text": "でも、どうして上なんでしょう？　逃げ場がない気がするんですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerToken": "char_107_liskam_1",
      "operatorId": "char_107_liskam",
      "portraitKey": "char_107_liskam",
      "text": "本当に、エクシアさんを信じて大丈夫でしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "目的地に着きさえするのなら、どんな道でも通ってみせる。……それが、我々ペンギン急便のやり方なんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "まあ、ひとまず一度試してみてくれ。きっと気に入ってもらえるはずだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerToken": "char_107_liskam_1",
      "operatorId": "char_107_liskam",
      "portraitKey": "char_107_liskam",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#5",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "……はぁ、はあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#5",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "ごめんなさい、ミーシャさん……まさかこんなことになるなんて……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerToken": "char_012_misa_1",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "ところで、お前。"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "speakerToken": "char_102_texas_1",
          "operatorId": "char_102_texas",
          "portraitKey": "char_102_texas",
          "text": "Dr.{@nickname}だろう？"
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "speakerToken": "char_102_texas_1",
          "operatorId": "char_102_texas",
          "portraitKey": "char_102_texas",
          "text": "……見たところ、階段を登るのは苦手らしいな。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
