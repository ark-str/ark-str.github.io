  "blocks": [
    {
      "type": "narration",
      "text": "第十七关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "アーミヤ、急いで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい！　ミーシャさんも、行きましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……なんで……どうして、なの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "こっちだ、早く来い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "よし、近辺は問題なしね。追撃には注意して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "さっきの人たちが、例の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "先ほど少しお話しした、レユニオン・ムーブメントという組織……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そこに所属する、感染者たちです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "なんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "どうして、感染者同士で争ったりなんて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "スカルシュレッダー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "まさか、奴らを逃がしたのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "大したことじゃないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "どうせ逃げ切れやしないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……それより……やっと、あいつを見つけることができた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ずっと……この日が来るのを待ってたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "到着だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "え？　本気で言ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "地図上の指定地点はここだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "でも、これ……上へ行けってことじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まあ、上とか言われたところで、意味はわかんないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "――アーミヤ～！　こっちこっち！　上だよ、上！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "え、エクシアさん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "上、って……ビルの上へ登るルートなんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うん、そーゆーこと！　ほらほら、あたしを信じてついてきて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なんたってあたしは、龍門の道のことなら知りすぎなくらい知ってるんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あ、あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "階段はこっちだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ねえ、これほんとに大丈夫なの？　包囲してくれって言ってるようなもんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うだうだ言ってないで早く来なって！　グズグズしてると、レユニオンに見つかって、マジで包囲されちゃうよ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "うだうだって、あのねえ……！　はあ、もういいわ。あなたたち、先に行っててくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしは入り口を溶接してくるから。そうすれば、少しは時間が稼げるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……階段の壁に、ペンギン急便のマークがついてるみたいですが……ここでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そうそう、それそれ～！　その先を左に曲がったら、階段を上がっておいで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ええと、一応お聞きしたいんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "地下通路があって、そこから脱出する……とかではなく、上へ上がる……で、合ってますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もー、何度もそう言ってるじゃ～ん！　ほんとのほんとに上で合ってるんだって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも、どうして上なんでしょう？　逃げ場がない気がするんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "本当に、エクシアさんを信じて大丈夫でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "目的地に着きさえするのなら、どんな道でも通ってみせる。……それが、我々ペンギン急便のやり方なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "まあ、ひとまず一度試してみてくれ。きっと気に入ってもらえるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……はぁ、はあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ごめんなさい、ミーシャさん……まさかこんなことになるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ところで、お前。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "Dr.{@nickname}だろう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "テキサス",
          "text": "……見たところ、階段を登るのは苦手らしいな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
