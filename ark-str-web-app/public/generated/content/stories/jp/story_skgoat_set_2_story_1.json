{
  "server": "jp",
  "storyId": "story_skgoat_set_2_story_1",
  "groupId": "story_skgoat_set_2",
  "stageId": null,
  "title": "遠方の遺品",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_skgoat_2_1.txt",
  "sourceHash": "8890f495856088f82f3848438f7ad79649afeaf0e2a072d65f14db512cb794d4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……冷えるわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "そう思うならさっさとノックしたらどうだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……彼女とはあまり面識がないから、なんだか気まずいのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "ったく、長い付き合いだが人見知りだけは直らねぇな……相変わらずで何よりだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "それはどうも。相変わらずなのはあなたもよ。まあ、その長い付き合いの中で、同僚になる日が来るとは思わなかったけどね。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "はいはい、そう混ぜっ返すなよ。それじゃ、困ってる「同僚」さんのために俺が一肌脱ぎますかね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リターニアの女性",
      "speakerId": null,
      "text": "何か御用？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "あ、あの……"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "バッハマンさん、急にお伺いしてすみません。こちらのグラシエールが、あなたからお手紙をいただいていたそうで。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "ええと……ああ、あのことね。何度も手紙を出してごめんなさい。届いているか心配だったけど、来てくれてよかったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "母の遺品整理中に見つけた箱をあなたに渡したいと思ってね。「グラシエールへ」って宛名のある紙が入ってたものだから……それにしても、わざわざ来てくれてありがとう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "いえ、お気になさらず。里帰りのついででしたから。……ええと、早速ですが、見せていただいてもよろしいでしょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "ええ、入って。それと、そんなに畏まらなくても大丈夫よ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "悪いけど、箱にかかってた鍵はこじ開けちゃったの。何が入ってるかも知らなくて……中の手紙を見てようやく、あなた宛ての物だって気付いたのよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "ただ、中身を見ても、あたしにはなんだかよくわからなくて。あなたなら何かわかるかしら？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "何だこれ？　紙切れに……石ころ？"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "おいおい……こんなもののために、わざわざここまで来たわけか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "これはアーツユニット抑制器の設計図ね……技術理論しか書いてないから、完成にはほど遠いけど……なるほど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "まずは順を追って話すわね……私は、教授にアーツを教わったおかげで、鉱物の振動音が聞こえるようになったの。でも感染者になってからは、ただのノイズしか聞こえなくなってしまって――"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "当時は為す術もなかったけど、教授はそれを、鉱石病がアーツの出力を増大させているせいだと考えていたわ。だから、一年間仕事を続けられたら、抑制器を作ってあげると言われたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "思うに、これはその設計図ね。ただ、ロドスでの治療の甲斐あって私の病状は安定したから、もうノイズは聞こえないし、鉱物の声もより「はっきりと」聞こえるようになったくらいなんだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "アーツユニットの……抑制器？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "そのくらい、リターニアでならパッと発注できると思うけど……母さんが自分で作る必要があったのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ええ。単にすべてを「抑制」するだけでは、小さな音が何一つ聞こえなくなってしまうの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "つまり、アーツだけじゃなく、鉱物の振動周波数にも造詣が深くないと作れないのよ。楽器を調律するみたいに、波長ごとの抑制方法を調整しないといけないから。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "なんだかすごい話ね。未完成なのがもったいないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "そうね。完成させられたら、今でも役に立つと思うわ……教授がここまで研究を進めてくださったことだし、持ち帰って私がそのあとを引き継いでもいいかもしれないわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "……それで、そっちの石は何かしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "これは「ビーコンストーン」ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "どういう物なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "その名の通り、座標を示す目印として使われる石よ……ある種の岩石の中には、源石による変質作用を起こしやすい物質が存在するんだけど、これはその働きで形成された変質岩で――"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "私のアーツに強烈に反応するの。そして、音叉の力を借りれば、私はある程度の距離までそれを感知することができるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "バッハマン教授は、変質岩の中でも特に反応の強い物を「ビーコンストーン」として使っていたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "彼女とフィールドワークに出る時にはいつも、二人してこれをいくつか持っておいたものよ。一定間隔で通った道に置きつつ進めば、迷子にならないから。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "けど、ほかにもその「ビーコンストーン」を使う奴がいたら、お互いごっちゃになって困るんじゃないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "その点は大丈夫よ。こんな方法を使う人はそう多くないし、お互い違う周波数で反応する石を持ち歩いていたから、混同するどころかそこに来たのが誰なのか判別できるくらいなの。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "話を聞く限り、相当便利なアーツみたいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "本質的には、物体を微振動させるだけのものなんだけどね。アーツの出力コントロールよりも、鉱物の成分に対する深い理解こそが、このアーツの要になるのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "……ところで、母さんはなぜこの石をあなたに遺したのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "何かのヒントかもしれないわね。この石の周波数を元に、町をアーツで探索してみなさい、って言いたいとか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ねえ、パーカー……この程度のアーツなら使ってもいいわよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "周りの安全に影響しない範囲で、かつ人目を引いたりしないなら、多分問題ないんじゃないか。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……見つけた。はっきりと道を示しているわけじゃないけれど、町の外に向かって点々と置かれているようね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "それなら、行ってみない？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "今から？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "今行かないでいつ行くのよ。明日には帰っちゃうんじゃないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "それはそうだけど……慌てて調べる必要もないもの。ひとまず、道しるべがあるのはわかったわけだし、また今度でも問題はないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "その上教授も、「好奇心は災いの元」だって日頃から口を酸っぱくして言っていたし……"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "でも、ここは移動都市なのよ。道しるべを辿った先が町の外なら、次にこの辺りへ来た時には見つからないかもしれないでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "そう言われても、今回はあくまで休暇で来ただけで、仕事をしに来たわけじゃないんだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "このくらい、仕事のうちには入らないわよ。何か見つけられたらあなたのものになるんだし、ちょっとの手間で大儲けできるチャンスじゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "まあ、行ってみてもいいんじゃないか。さっき宿に連絡を取ってみたんだが、部屋の準備にまだ二時間はかかるって言ってたしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "二時間も？　随分と「効率的」ね……はぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "わかった、じゃあすぐに出発しましょう。明るいうちに片付けちゃいたいもの。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "町の外にこんな場所があるなんてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "ホントにここであってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ええ、道しるべはこの場所へと一直線に続いていたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "んー……壁の補強材は落石で埋まっているみたいだけど……奥には坑道も見えるわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "まさか、母さんが遺したのはこんな洞窟だったってこと？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "どうかしら。見たところ、随分昔に掘り尽くされた廃鉱山のようだし……教授がこんな場所を所有しているなんて話は聞いたことないわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……前方に反応があるわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "あの落盤地点の下に、何か埋まっているみたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "下？　掘り出す道具を持ってくればよかったわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "大丈夫よ、任せてちょうだい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アーススピリットが音叉を地面に突き立てると、形容し難い奇妙な音が周囲へと響き、落盤地点が液体の如く流動し始めた。\nそして瞬く間に、その地面は沸騰するかのように激しく滾り出す。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ほどなくして、鉄の箱が地面からせり上がってきた。その表面には複雑な花の模様が施されている。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "いかにも宝箱って感じね！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "なるほど、悪くない。中身にも期待できそうだな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "おい、何だお前ら？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "連絡ご苦労。これでやっと、バッハマン教授の遺産をすべて回収できるよ。――君たちも運が悪かったね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "どういうこと！？　あなた、私たちを利用したの？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "ごめんなさいね。あたしは望みの薄い遺産なんかに執着するつもりはなかったんだけど、旦那がぜんぶ手に入れたいって聞かなくて。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "ねえダーリン、これを売り払ったらもうここに用はないのよね？　前に言ってたみたいに、クルビアへ行って毎日気楽に――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "──っ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "チッ……もっとしっかり狙えないのか？　先に足を撃って動きを止めるつもりだとでも言うのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "何すんのよ、ルイス！　あんた正気なの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "ハッ。お前にはわかるまい。私はこれまで散々時間をかけてこの計画を練り、そのために苦汁を味わってきたんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "なのに結果はどうだ。これまで手に入れた遺産と言えば、たった一軒の家と、何の役にも立たん石ころときた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "心底うんざりしていたが、最後に価値のありそうなものが見つかってよかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "そいつを売って儲ければ、それを元手にクルビアでの鉱業ビジネスを立て直すことができる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "――残念だが、お前は用済みだ。分け前を半分にしてまで生かしておく気はないんでな。移動都市外の廃鉱山なんて、すべてを闇に葬るにはこれ以上ない場所だろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "させないわ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "おや、これはこれは。噂ではレム・ビリトンの企業から何件もヘッドハンティングを受けておきながら、一つ残らず断ったそうだな。親愛なるグラシエール大先生。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "君が我々に加わるのなら、生かしてやってもいいぞ。私の有能な部下として、ある程度の地位を与えてやろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "悪いけど転職は考えてないの。今の職場は手取りこそ少なくても、私たちみたいな感染者にとっては魅力的な福利厚生が揃っているから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "生きるために身を粉にして働く……そんな牢獄から抜け出してみたいとは思わないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "好きなように取れる長期休暇。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "家で何もせず自堕落に過ごすだけの毎日。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "そんな生活が欲しくはないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "誰だって欲しいに決まってるでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "ならば私の下に来い。十分な休暇も大きな権力もくれてやろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "うぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "バッハマンさんのことも、そうやってたぶらかしたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "確かに、経験の浅い若者には魅力的な提案に聞こえるでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "でも、長く働いてきた私は、楽な仕事なんか存在しないことを知ってるの。条件の良すぎる仕事なんて、大抵ろくなものじゃないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "ふん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "だが、「生かしてやる」という採用条件を前に、それを拒むことなどできまい。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "上司の世話を焼くなんて、ロドスの仕事だけでもうたくさん。せっかく有給で来てるんだし、やりたいようにやらせてもらうわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "痛い……うぅ……た、助けてっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "黙れッ！　うるせぇんだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "お前ら、先にあの女から始末しろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵A",
      "speakerId": null,
      "text": "了解、射殺してやりましょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "バカ野郎！　お前の腕じゃ苦しませるだけだろうが！　手っ取り早く片付けろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵隊長",
      "speakerId": null,
      "text": "わかりました。――行くぞ、さっさと斬り殺せ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵A",
      "speakerId": null,
      "text": "な、なあ……！　さっきから身動きが――何かに足を掴まれてるみたいだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵B",
      "speakerId": null,
      "text": "っ、違う！　お前、地面に沈んでいってるぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "それ以上進ませないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵A",
      "speakerId": null,
      "text": "た、助けてくれぇ！　もう胸元まで来てる……！　このままじゃ、埋もれて息が……！"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵B",
      "speakerId": null,
      "text": "おい、掴まれ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "クソッ！"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵B",
      "speakerId": null,
      "text": "も、もう近づけません！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "グラシエール、これが私に対する答えと捉えて構わんな？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "どうぞお好きに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "――気が変わった。三人ともぶっ殺せ。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "おいこら！　俺はまだ何も──"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵隊長",
      "speakerId": null,
      "text": "よし、クロスボウに換えろ！　全員射殺せ！"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵B",
      "speakerId": null,
      "text": "了解。"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵隊長",
      "speakerId": null,
      "text": "まずはあのキャプリニーを狙え！　奴さえ殺せばアーツも止まる！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "悪いが、幼なじみが傷つけられるのを黙って見てるわけにゃいかないんでな。"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵隊長",
      "speakerId": null,
      "text": "チッ、あの野郎も厄介だな。"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵A",
      "speakerId": null,
      "text": "隊長、ここは狭すぎて、盾一枚で全部防がれちまいます。あのアーツのせいで近付くこともできませんし……"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵隊長",
      "speakerId": null,
      "text": "くそっ……どうする……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "お前らの仕事はそこでうろたえることか！？　さっさと何か策を考えろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵隊長",
      "speakerId": null,
      "text": "……了解。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵隊長",
      "speakerId": null,
      "text": "そんなら、こいつでどうだ！　入り口にあった爆薬で……即席爆弾矢だ、食らえっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "いくら撃っても効かねぇよ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "なに、俺たちの上を狙った……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "ハハッ、なるほど！　長年整備されていない廃鉱山に迷い込んだ連中が、崩落事故で不慮の死を遂げる……完璧なシナリオだな！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "ッ！　危ない──"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "バッハマンが顔を上げると、巨大な黒い影が視界を覆った。\n車輪ほどの大きさの岩が、頭上から落ちてきたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "状況を理解する間もなく、絶体絶命と思われたその時――透き通るように白い手が、岩との間に滑り込む。\nその手に触れた瞬間、岩はあっという間に砂粒と化した。指の間から頬へと流れ落ちる砂の滝は、微かに手のひらの暖かさを帯びていた。\nキャプリニーはにこりともせず、彼女の肩を軽く支えると、もう片方の手を高く掲げた。\n体が触れ合うその距離では、母親に似た匂いが鼻先をくすぐる──あの土と青草の混じった香りだ。\n彼女は、二十年ほど忘れていた安心感に包まれた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "大丈夫？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "ありがと……あなたのアーツって、こんなことまでできるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ええ、少し計算さえすればね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "よかった……今回は間に合ったわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "今度は奥のほうからだ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "まずいわね、ここが崩れちゃう……！"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "あいつら、俺たちを生き埋めにする気か？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "パーカー、私の後ろに下がって！"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "いや、今ならまだ逃げられるだろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "バッハマンさんが足を怪我してるの！　その上、入り口は奴らに塞がれているわ！"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "そうは言っても、ここにいたって埒が明かないぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "私を信じなさい！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "待て、グラシエール！"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "サーベイランスマシンを見ろ、警告灯が赤に変わってるぞ！　それ以上はよせ、危険だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "大丈夫よ、ただの誤作動だから。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "何なのそれ……骸骨なのに、動いてる……！　動物、なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "驚いちゃうでしょうし、あんまり見ないほうがいいわよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "さあ、もっと近くに来て！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "ハハハッ、みんな仲良く死んじまえ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "初めに、岩石が色とりどりの砂粒と化して、無数の星々の如くぱらぱらと落ちてきた。\n続けて、徐々に砂の粒度が粗くなり、さながら春の雨のようにまばらに降り注いだ。\nそして最後に、洞窟の奥で岩盤が崩落し、地面にぶつかって轟音を立てた。\n足元の「流砂化」した地面は、その上に立つ三人を呑み込むことはなく、むしろ満ちていく潮のように優しく押し上げた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "なっ、これは……おい、こんなことして大丈夫なのか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "私は平気よ、調整してるだけだから！　それより、口と鼻を覆いなさい！　砂煙を直接吸い込んだら、アーツが解けたあと病院送りになるわよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "これって……岩と地面の成分を全部分析した上で、それぞれ違う周波数の振動を起こしてるってこと……？　「少し計算さえすれば」なんてレベルじゃないでしょ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "だって、少しでも間違えたら……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "な……何をしているんだ……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "だ、だが今は身動きが取れまい！　矢を放て！　一斉掃射だ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "まずいぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "そうかしら。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "眼前に舞う砂煙が突如として岩石へと戻り、矢を弾きながら落ちていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巨大な盾と化した岩はそのまま地面に衝突するなり、湖面に落ちたかのようにして、砂の大波を引き起こした。その波は一方向へ――入り口に立つ人々のほうへと押し寄せていく。\nそして、彼らの両足へと絡みついた途端、それは再び元の固い地面へと戻り、彼らをその場に拘束した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "何だこれは──う、動けないっ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "パーカー、一応彼らを縛り上げてから警察を呼びましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "わかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "おい、貴様ら！　その女も同罪だということを忘れるなよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "この場にいる人間で、私の計画に一から関わっていたのはその女だけだ。そいつも立派な共犯者だろうが！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "そもそも、お前を利用して最後の遺産をかすめ取ろうというのも、その女の提案だ！　その上、遺書を偽造し、財産を奪った張本人でもあるんだぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "なんですって……！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "バッハマンさん、どうしてこんなことを？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "……わからないの？　母さんは、あたしのことなんか少しも愛してなかったのよ。いつも兄さんばっかりちやほやして……！　どっちも母さんの子供なのに！"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "じゃあ、あたしの存在って何なの？　あたしには、何もないのよ……だったらせめて財産くらいは多めにもらうのが、当然の権利ってもんでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ふざけないで！！　あなた自分が何をしたのかわかってるの！？　その男と共謀して私を利用しようとしたのも、許されることじゃないわよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "母さんは随分あんたを気に掛けてたみたいだし、そのくらい手伝ってくれたっていいでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "元々は、命まで奪うつもりなんてなかったし……"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "あたしは学校を卒業したばかりだから、必死に駆けずり回って仕事を探してたけど……このお金さえあれば、働かないで毎日寝て過ごせるようになるのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……随分甘やかされて育ったのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "うるさい！　年に一度しか里帰りしないあんただって、あの人と同じじゃない！　仕事ばっかで家族を顧みない奴らなんか、退屈な毎日の繰り返しの中で溺れ死ねばいいのに！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "――私は余計な口出しをする気はないし、あなたの目に映っていた教授の姿を擁護するつもりもないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "だけど、あなたに私を批判する資格はないし、必死に働いて生きている人を批判するなんてもっての外よ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……あなたの言う通り、私は仕事ばかりで実家にほとんど帰らない親不孝者かもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ロドスでの仕事以外にも、時間さえあれば天災トランスポーターの仕事をしてお金を稼いでいるしね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "だけど、私がどうしてそんなことをしているかわかる？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "家に帰らない理由を作るためにそうしているとでも？　みんながみんな、やりたくてやってるとでも思ってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……私の家は、移動都市の外にあるの。時代に取り残された貧しい田舎町――そこが私の故郷よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "近くに移動都市がある間はそこまで不便をしないけど、どんな都市もいずれは私たちに構わず離れていくわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "だから、天災が来た時のことを考えると、私は移動都市へ家族全員で引っ越せるだけのお金を稼がないといけないのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "天災トランスポーターの私にさえ、長期的に天災の脅威を遠ざける方法なんて、それ以外には思いつかないんだもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "あなたは自分のことを、どうにもならない生活に甘んじる大人たちとは違うと思っているのかもしれないけれど、問題の根源に向き合うつもりがないのなら、幼稚な優越感に浸るのはやめなさい！"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "何よ！　少なくともこの遺産に関しては、あたしが努力して手に入れた物でしょ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "私が来なければ何も得られなかったじゃない。そこのレナードとかいう人のほうが、遺産をかすめ取ることに関してはあなたよりよっぽど努力してるわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "わ、私の名前はルイス──"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "どうだっていいわよ！　黙ってなさい！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "いつもは冷静なキャプリニーが、割れんばかりの大声で一喝した。\n崩落した洞窟は、その声を反響させることはない。\nしかし彼女のすぐそばにいた骸骨のような生き物すらも、低く唸って一歩下がった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "……承知した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "バッハマンさん。私の知る限り、お母さんはあなたのことをとても愛していたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "あなたを愛し、もっといい生活をさせたいと思っていたからこそ、仕事を四つも掛け持ちしていたのよ。大学教授に地質学者、天災トランスポーター、それからピアニスト……とね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "それに、あなたのお兄さんだけど……子供の頃はろくに食事もできなかったせいで、色々な病気にかかってしまったと聞いたわ。教授はあなたを同じ目に遭わせてしまうのが怖かったんでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "けれど皮肉なことに、豊かな暮らしを謳歌し、リターニア最高水準の教育を受けてきたあなたは……未だに子供のまま……"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "それが何だって言うの？　いくら擁護したところで、母さんが全然家に帰ってこなかったのは事実じゃない。どんなに忙しくたって、休みくらいは取れるでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "実は……一度、教授が休暇を取ってあなたの元に帰ろうとしたことがあったの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "だけどちょうどその時期に、フィールドワークへ出ていた私の滑落事故が重なってしまって……あの時は、洞窟で足を滑らせたと思ったら……あとはもうあっという間の出来事だったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "後々教授から聞いた話では、当時の私はひどい状態で……露出した源石に全身を擦って、傷だらけになってたんですって。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "教授は、そんな私に応急処置を施して、そのままバイクに乗せてロドスまで急いで搬送してくれたの。だから……休暇が取れなかったのは私のせいなのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "もしあの時、教授が予定通り家に帰れていたら？　あなたが自分の思いを伝えられていたら？　……もしかすると、教授も早くに引退していて、こんなことだって起こらなかったかもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "そう考えると、すべて私の責任ね。あの時抱いた好奇心が、事の発端だったとも言えるでしょう……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "「好奇心は災いの元」――教授の教え通りだわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "自分のせいってわかってるなら、あたしのことはもう放っといて。あたしはあたしで、「つつましい」生活に戻るから。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "この男たちを警察に突き出したら、あなたのことも証言すると思うわよ。そうなれば、元の生活に戻るのは難しいでしょうけど……まさか全員見逃せって言うの？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "そいつは前科者なの。あたしがそのスジの人に頼んで、都市に入れてやったのよ。だから、偽造した身分証さえ取り上げれば、街にはもう入れなくなるし、入ろうとも思わないでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "現状、それが一番良い方法だと思うわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "なんて女だ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "先に裏切ったのはあんたじゃない！"
    },
    {
      "type": "dialogue",
      "speakerName": "ルイス",
      "speakerId": null,
      "text": "チッ……身体の自由さえ利けば、貴様を殺してるところだぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……つまり、決定権は私にあるのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "そうね。だけど、あんただってあたしに悪いことしたと思ってるんでしょ？　だったら、これ以上あたしの生活を壊さないでよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "確かに、悪いことをしたとは思うわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "でも、それを決めるのは……上の人のやることよ。私はただ、普通に仕事をこなして、その対価をもらうだけでいいんだもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ましてやこれはあなたたち家族内の問題だし、私はわけも分からず巻き込まれてきただけ。あなただって、私の休暇を邪魔した分の手当を出してくれるわけじゃないでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "はあ！？　汚らわしい感染者のくせに──！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "――あなたを病院へ連れていって傷の手当てをしてもらったら、お兄さんに連絡するわ。事の顛末を知った上で、あなたを許すと言うならそれに従いましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "逆に、許さないと言うなら、あなたを裁判所に引き渡して、判決を下してもらうことにするわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "あんたはあたしを……あたしの人生を、めちゃくちゃにするつもりなのね！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "どうかしら。めちゃくちゃにしたのはあなた自身かもね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "――さあ、パーカー。分担して効率よくいきましょう。全部片付けたらバッハマン家の邸宅前に集合ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "バッハマンの娘",
      "speakerId": null,
      "text": "ちょっと待ってよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "了解。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "お疲れさん。こっちも片付いたぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "いやー、まさかあの冷静沈着なグラシエール女史が、我を忘れて大声で一喝するなんてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "わ、我を忘れたりなんかしてないわよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ただ感情を解放しただけ。これも休暇の意義の一つなの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "それにしても……"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "どうした？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "バッハマン教授のお家……前に来た時は、庭の花や草も丁寧に手入れされていて、外壁も綺麗だったのに。たった数年で、こんな姿に……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "教授は一家を支えるために必死に働いていたのに、結果的にはそれが裏目に出てしまったのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "一家の支えとしては、もっと家族と過ごすべきだったんだろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "……それより、そろそろ警告灯の件を説明してもらおうか。あれが赤くなった時は、本来ならすぐにでも本艦に報告しないといけないはずだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "そうね……あの時、私の背後にあったものは見えた？"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "うっすらと、骨っぽい輪郭だけな。あれって何かの生き物なのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ええ。誰にでも見えるわけじゃないけど、私がアーツを発動すると見えやすくなるの。あの時のような状況であれば、もっと簡単に見えるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "私のアーツは、出力を精確にコントロールすることにはかなり気を使うけど……物体を振動させるのに必要なエネルギー自体はごく僅かなの。だから、実はかなりエネルギーが余っちゃうのよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "アーツで得たエネルギーから、振動に使う僅かな分を取り出して……残りは、熱を発散するみたいに放出してしまう仕組みなのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "そのせいか、いつの間にかこういう生き物が周りに寄り付いて、そのエネルギーを食べるようになって……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "初めは勝手に食べられてるだけだったんだけど、ロドスの術師たちの協力で、この子の体内に貯蔵されたエネルギーを転用する方法を発見してね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ただ、この方法を使うと、エネルギーがそのまま私の身体に逆流してくるから──"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "それに反応して、警告灯が赤く光ってたのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "つまり心配無用ってこと。でも、サーベイランスマシンのデータ処理は必要ね。ドクターやケルシー先生のお小言は聞きたくないし、検査を全部終えるまで働けない上に給料無し、なんて最悪だから。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "なるほどな、わかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "speakerId": null,
      "text": "お前は昔っから嘘は下手だし、信じるさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ありがとう、パーカー。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "speakerId": "char_145_prove",
      "text": "へぇ～、ただの里帰りでそんな危ない目に……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ええ、本当に疲れたわ。里帰りのついでにちょっとバッハマン教授の娘さんに会ってみようと思っただけなのに、自分から面倒事に首突っ込む羽目になるなんてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "speakerId": "char_145_prove",
      "text": "あ！　揚げ物ばっかり食べちゃダメだって。ほら、僕の野菜を分けてあげるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "フライドポテトってたまに食べるとやけに幸せを感じるのよね……あなたもどう？"
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "speakerId": "char_145_prove",
      "text": "うーん、ほんとにお疲れみたいだね～。"
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "speakerId": "char_145_prove",
      "text": "あんまり無理しちゃダメだよ。っていうか、揚げたてでもないしなしなポテトなんてよくそんな美味しく食べられるなあ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "speakerId": "char_145_prove",
      "text": "それで、結局箱の中身は何だったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "ウルサス以北のエリアで採取された地質サンプルが入ってたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "speakerId": "char_145_prove",
      "text": "あーあ、また一仕事増えそうだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "そうでもないわよ。バッハマン教授は生前、あのサンプルのどれもが未探索の土地で採取されたものだけど、もしかすると一生かかっても調査できないかもしれない……って言ってたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "だからいつか私に保管を頼みたい、ともね。とはいえ、とっくに用意できていたとは思わなかったけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "speakerId": "char_145_prove",
      "text": "君たちみたいな研究者からすれば、好奇心を抑えるのってすっごく難しいことじゃないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "それはそうだけど……こう見えて私は結構多趣味だから、仕事のあとはほかの物事に没頭できるのよ。あれもこれもやらないと、なんて頭を悩ませることはほとんどないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "それに、教授から保管を任された以上、その約束を反故にして好き勝手研究するわけにはいかないから。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "私の仕事は、ケルシー先生とドクターに報告して、箱の中身をきちんと保管してもらうことくらいね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "……ああ、思い出した。まだ報告が終わってないんだったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "speakerId": null,
      "text": "はぁ──また忙しい午後になりそうね。"
    },
    {
      "type": "sceneBreak"
    }
  ],
