{
  "server": "jp",
  "storyId": "act16side_level_act16side_st01",
  "groupId": "act16side",
  "stageId": "act16side_st01",
  "title": "千載一遇",
  "storyCode": "GA-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16side/level_act16side_st01.txt",
  "sourceHash": "8f95147f8c4cfc5eb64d67cbd42cbd412b997560e05dcd6770bf81663025ccee",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "st01"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やつれた男",
      "text": "もうじき彼女が戻ってくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな女",
      "text": "当然よ。だって、レガトゥスたちがこれだけ時間をかけてお膳立てしたんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな女",
      "text": "あなたはどのくらいいるつもりなの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やつれた男",
      "text": "成すべき事を成したらすぐに去るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やつれた男",
      "text": "なにせ私は、ここにいてもラテラーノ人の魂を導くことくらいしかできないからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やつれた男",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やつれた男",
      "text": "さて、もう行くとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな女",
      "text": "明日からはもう来ないで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママ、お湯だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "いい子ね、ゴホゴホッ……でもママは大丈夫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "じゃあ……ご本を読んであげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "ああ……セシリア、愛しのセシリア……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "あなたと離ればなれになるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママ、どこかに行っちゃうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "いいえ、ゴホゴホッ……そんなこと……ママは一度も考えたことないのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "だけどママには、もうどうしようもないの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "どこに行くの？　わたしも行ってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "セシリアは付いてきちゃダメよ……ママが行くところはね、とっても寒くて、寂しくて、何もないところだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "わたしがママと一緒にいたら、寂しくないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "……セシリア、ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "あなたはもっと幸せな子であるべきなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママと一緒にいられて、わたしはとっても幸せだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "……セシリア、いい子だからよく聞いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "うん。なあに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "ママはね、もうあなたの面倒を見てあげられないの……だけど、あなたを迎えに来る人がいるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "その人に付いていって、パパを探すの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "パパがママの代わりにあなたの面倒を見てくれるわ。いい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママは一緒に行かないの？　きっとパパもママに会いたいよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "ママは……大事なお仕事があるから……一緒には行けないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "パパに会ったら、ママもパパが恋しいって代わりに伝えてくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "それと……ごめんなさいって。わかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "どうしてママがごめんなさいするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "……どうしてもよ。セシリア、約束よ……お願い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "わかった。ママ……ママ、泣かないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "セシリア、なんて可哀想な子なの……あなたが生まれてきてくれたことは一番の幸せなのに、それがあなたにとっては一生の不幸になるかもしれないなんて……ああ、愛しのセシリア……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "……一体誰なら……どんな人なら、あなたに祝福を与えてあげられるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "……いい、セシリア。見つかってしまわないように、ちゃんと隠れて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "text": "逃げなさい……ラテラーノから逃げるの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "母はその瞳に無数の感情を映しながら、娘の手を握った。しかし、やがてすべてがその瞳から力なく消え去った。\nそして、両目がゆっくりと閉じられた。"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンクタの少女は、何が起こったのか理解できなかった。\n母の手が冷たくなっていることに気付くと、少女は母が寒くないようにと、両手でその手を包み込み、自分の胸に押し当てた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノック音が響いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ラテラーノ公証人役場から参りました、執行人のフェデリコと申します。公務執行のため、ドアを開けてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかなレガトゥス",
      "text": "ホテルのチェックイン手続きはすべて完了いたしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかなレガトゥス",
      "text": "本日、あとはどうかご自由にお過ごしください。街を散策されてはいかがでしょうか。道中、関心がおありのようでしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "うむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "ラテラーノの建築物は、なんともユニークであるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかなレガトゥス",
      "text": "ええ、ラテラーノへ来たのは無駄足ではなかったでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "ううむ、そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "今後のスケジュールはどうなっている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかなレガトゥス",
      "text": "教皇聖下との面会の手筈はすでに整えてあります。私はこれから大聖堂へと戻りますので、明日またお迎えに上がりご案内させていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかなレガトゥス",
      "text": "繰り返しになりますが、会期中はどうか存分にラテラーノをご満喫ください。もちろん費用もご心配無用です。各国の貴賓をもてなせることはラテラーノの名誉ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "各国の貴賓か……はぁ、これだけたくさんの異国人を集めて、何を話すというのやら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "だが、教皇聖下がここまで誠意を尽くしてくださるからには、私も貴国ならではの風情とやらを味わわせてもらうとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "朗らかなレガトゥス",
      "text": "ええ。どうかお楽しみください。では、お先に失礼いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "それにしても面白い建造物ばかりだ……クルビアにもこの手の柱はあるが、細部の趣向には違いがあるようだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "うむ、せっかく来たからには……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "ん？　あれは何を――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "設置できた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな市民",
      "text": "ああ、そっちは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "バッチリよ。エゼル君、周囲の避難は済んだかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "はい。直接被害を受ける恐れのある公民の避難は完了してます。二次災害が起きうる範囲の公民も了承済みです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "じゃあ始めてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "はい。ええと……現在1099年3月15日午前10時22分、今回の爆破行為は、公証人役場執行人候補エゼルの立ち会いの下で執行されます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "はーい。それじゃあいくわよ。さーん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "（サンクタが三人……柱の周りで何をやっているんだ？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "にーぃ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "失礼、どうしてこの辺りには君たち三人以外誰もいないのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "いーち、点火！　――って、なんで人がいるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "ば、爆発！？　……崩れるぞ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "た、助けてくれ！　ひぃ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "いけない！　……ん？　崩れる速度が、ゆっくりに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "たす――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "黙らないと舌を噛むわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "ひぃっ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "し、死ぬところだった。ラテラーノは一体どうなっているんだ！　……リーベリのお嬢さん、助けてくれて感謝するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "名前を伺っても構わんかね？　後ほどクルビア臨時会館を訪ねてくれればお礼をしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "この子は「幽光の夜警」っていうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽光の夜警",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "幽光の夜警……？　ラテラーノ人は変わった名前をしているのだね……ハハ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽光の夜警",
      "text": "そんな名前じゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "えーっと……あなたたち無事よね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな市民",
      "text": "ありがとう二人とも、大変なことになるところだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "お二人のご協力に感謝します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽光の夜警ではない誰か",
      "text": "どういたしまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "しかし、一体何事かね？　こんな真っ昼間に街中で爆発とは……まさかラテラーノにテロリストでも紛れ込んだのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "えーっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "ねぇねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな市民",
      "text": "何だい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "この柱の位置ってまさにパーフェクトだと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな市民",
      "text": "まったくだ。ラテラーノの建築美学が如実に現れているよ。それがどうかしたのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "うーんと……これを爆破したらどうなるか見てみたいのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな市民",
      "text": "え――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな？市民",
      "text": "そいつはナイスアイディアだと言わざるを得ないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "だけど、例のサミットってそろそろでしょ？　外国のお客さんもたくさん来るみたいだし、教皇聖下もしばらく控えるようおっしゃってなかったかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな？市民",
      "text": "その通り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな？？市民",
      "text": "つまり「控える」ようには言われたけど「禁止」はされていないってことさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "……なるほどね。外国のお客さんに好印象を与えたいっていう教皇聖下のお気持ちもわかるけど、ありのままを見せた上で「好印象」を与えないと意味ないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかじゃない市民",
      "text": "その通りだ……興奮してきたな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "それで、公証人役場に届け出てから、この執行人のお兄さん立ち会いの下、周囲の公民を避難させて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "この美しい柱を「ほどよく」爆破してみたってわけだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな市民",
      "text": "ですが、近づいてくる人がいるなんて思ってもみませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "本当にごめんなさい。人に危害を加えるつもりなんてこれっぽっちもなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "……移動都市の市街地で爆破だと？　しかも役場に届け出た上で……公務員の立ち合いの下！？　ラテラーノ人は……これほどまでに自由奔放なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽光の夜警ではない誰か",
      "text": "ラテラーノ人も戒律と規則には従順よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽光の夜警ではない誰か",
      "text": "でも戒律の許す範囲なら、やりたいことを全部やるのがラテラーノ人なの。この国は公民一人ひとりの権利を尊重し保障してるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "ただの爆発など日常茶飯事です。どうか安心してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "もし怪我人が出たらどうするのだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "僕たちも加減をわきまえてますから……もちろん、今回のハプニングについてはお詫びします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな市民",
      "text": "本当にすみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "すぐには理解できないかもしれないけど、しばらく生活すれば、あなたもきっとここを好きになるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルビアの金持ち商人",
      "text": "うーむ……理解したいとも思えないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ともあれ、これがラテラーノ人さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ようこそ、ラテラーノへ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "へぇ、さすがはモスティマだな。時間の流れを遅くする能力か、そう錯覚させるだけの能力かはわかんねぇけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何度見ても不思議なもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙なレガトゥス",
      "text": "オレン、あちらで何かあったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "いいや、なんてことない見慣れた光景だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "だが、ちょっとしたサプライズは見られたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙なレガトゥス",
      "text": "……？　ほかの者が待っているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ああ、行くか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「レガトゥス」。\n当代の教皇が設立した特殊トランスポーター組織である。\nこれまで、ラテラーノは中核国家間において超然的地位を持ち、永世中立国の立場にあった。\nその立場を見込まれて、ラテラーノ政府当局は外交実務において、特殊な案件に関する重要な情報の伝達を依頼されることがままあった。\n教皇はその役回りを常態化し、体制を整えて組織化したのである。これによりラテラーノは、国家間を行き交うことのできる独自の力を手に入れたのだ。\nレガトゥスの主要な目的は、ラテラーノの絶対的な中立体制を崩さないことを大原則に、国家間における重要な情報の流れを促すことにある。\n1098年、教皇は選任したレガトゥスを介して、テラ各国に招待状を送った。\nそれは、ラテラーノで集団安全保障を議題とした国際会議――万国サミットを開催するため、各国に使者の派遣を要請するものであった。\n1099年、レガトゥス制度が誕生して三十周年。\n同年三月、テラ各地に散らばっていたレガトゥスは、諸国の使節を連れてラテラーノへと戻った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "今の……一人は護衛隊みたいだったけど、もう片方は……まさかレガトゥス？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "珍しい組み合わせだなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "活発な市民",
      "text": "ちょっとエゼル君、立ち合いの仕事はもう終わりでしょ。ボーッとしてどうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな市民",
      "text": "申請書にも書いた通り、柱は元通りに立てておくから安心して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "わかりました。ではよろしくお願いします。次の任務があるので、僕はこれで失礼しますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "え、遺言の登録状況確認者が……亡くなっている？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "典型的な単身女性の住まい。ほかの者が生活していた痕跡はない。\n寝室には安らかに眠る女性の遺体があるのみ。毒や暴力が行使された跡もない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "こちらフェデリコ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ステファン区セルヴァティウス通り7-265にて、女性公民の遺体を発見。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "死因は自然死と見られます。管轄の安魂教会に遺体収容の通達をお願いいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "現状遺言は確認されていません。故人の身元確認、及び遺言の事前登録情報に基づいた遺言捜索任務の発令を申請いたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "報告完了。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ママ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "外に出ちゃダメ。\nほかの人に見つかっちゃダメ。\n制服を着た人には絶対に近づいちゃダメ。\nママがそう言ってた。\n制服の人、もう行ったかな？　まだかな？\nでも大丈夫。いつもみたいに、お客さんが来たらソファでお昼寝してればいいんだ。起きたらまたママと一緒にいられるから。\nでもどうして……どうしてこんなにそわそわするの？\n……どうして全然眠れないの？\n大丈夫。きっと大丈夫だよ……変な人が出て行くのを待ってればいいだけなんだから。\nそれからママのそばに戻ればいいんだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "あんなに使者を寄越すなんて、サルゴンは繁盛してるみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "いやいや、パーディシャーたちが積極的なだけですよ。それぞれ好き勝手に使者を寄越しただけで、全員同じ考えとは限りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "使者同士が揉めないだけでも御の字です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "カジミエーシュもなかなかの大所帯だが、あいつらはどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なレガトゥス",
      "text": "監査会には提案を拒否されましたが、商業連合会は興味を持ってくれています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なレガトゥス",
      "text": "自ら私を訪ねる代表もいたほどです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なレガトゥス",
      "text": "……その代表は、国際情勢に関してレガトゥスにも劣らない理解を有する方で、色々とお話をさせていただきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なレガトゥス",
      "text": "もし多忙でなければ、今頃この場に現れていたことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "そちらの話も聞かせてください、オレンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ああ。お前たちも耳にしてるだろうが、ヴィクトリアの情勢はこじれにこじれてるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ゴドズィン公爵とはなんとか良い関係を築けているが、公爵は今……人を寄越したくても寄越しづらい状況にある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "些細な動きが情勢を左右することになりかねないからな。まぁ、そんなところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "炎国も使者を出していませんが、「教皇聖下への感謝の気持ち」と称して、かなりの寄贈がありました……まったく炎国らしいやり方ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なレガトゥス",
      "text": "ここ数年で頭角を現したイェラグも今回使者を派遣してきましたね……他国の使者も揃ったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "正直、私たちがこれほどの影響力を有しているとは思ってもみませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "怖気づいたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "少し。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "たしか、お前はこの仕事に就いてまだ数年だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "ええ、四年弱です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "だが、レガトゥス制度はもう三十年も続いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "今日の影響力は――俺たちの努力の積み重ねの結果に他ならないってことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "それに、まだ俺たちの目指すものには程遠い――俺たちが目指しているのは、中身の伴った正真正銘の「万国サミット」だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "ラテラーノ大聖堂に現れるのは、各国の使者なんかじゃなく、真に改革をもたらすことのできる人であるべきなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "緊張するのはそういう大物たちが揃った時に取っとけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "そんな言い方をされると、その日の訪れが待ち遠しいとも思えなくなりますが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "オレン、また先輩風を吹かせて後輩イジメかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "おいおい、冤罪だぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "……いつかあなたの思い描いた光景が実現しても、緊張する必要なんて何もないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "私たちには皆、その資格がある。そうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "かもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "それで、各地域の担当レガトゥスは皆、揃ったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "やるせないレガトゥス",
      "text": "あとはモスティマさんだけですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "モスティマ？　あぁ、さっき見かけたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "彼女は何を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "今頃、故郷の空気を存分に楽しんでるところだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "そう。構わないわ、元々来るとも思っていなかったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "いつも通り、彼女が教皇聖下に報告する番は最後に回せばいいわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇騎士",
      "text": "教皇聖下がご到着されました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一瞬にして、ホールが静まりかえった。\nレガトゥス全員の視線が一箇所に集まる。\n全ラテラーノ人の導き手であり、牽引者であり、宗教指導者――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "text": "おはよう、我がラテラーノの子らよ。食事は済ませたかね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "信心深い修道士",
      "text": "いかがですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な修道士",
      "text": "外的要因は認められません。おそらく持病によるものでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "信心深い修道士",
      "text": "ああ、なんと痛ましい。どうかあちらでは苦しみと無縁でありますように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な修道士",
      "text": "灯火の潰えたサンクタよ、あなたは安魂教会へ運ばれ、永遠の安らぎを得ることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "信心深い修道士",
      "text": "壁に掛かっている「これ」も持って行きましょう。後で公証人役場の方にお渡しします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "どうしてママを連れて行っちゃうの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "わたし……どうしよう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "セシリアが視線をドアの方へと向けた。\n外に出ちゃダメ、見つかっちゃダメ……そうしないとセシリアが危ないから。\nママはそう言ってた。\n……でもママは連れて行かれちゃった。ママは危なくないの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "フィアメッタ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ちゃんと名前で呼ぶなんて珍しいこともあるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ふーん、嫌だった？　やっぱり「幽光の夜警」の方がいい？　それとも新しいのが欲しいのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "フィアメッタ以外は認めないわ。それで、何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "今頃、大聖堂で同僚たちに陰口を叩かれてるのかなーと思ってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "自覚があるなら顔くらい出せばいいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "遠慮しとくよ、大聖堂の雰囲気はいつまで経っても慣れないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それに、私なんて歩く警告標識みたいなものだし、顔を出したところでみんなの居心地が悪くなるだけでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あなたが他人の居心地なんて気にするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私だって空気くらい読むよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "どうだか。でも思ったより今回の里帰りを楽しんでるみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……なにが「ようこそラテラーノへ」よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あぁそれ。久しぶりの里帰りでちょっと浮かれてたのかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あっそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ハハッ、ほら、行こうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "行くってどこへ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "もちろん「あの子」に会いにだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……あっ、もしかして転院しちゃってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……あなた、自分がどれだけラテラーノを離れていたか自覚した方がいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "付いてきて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "めったに来ない場所だ。もう郊外近くまで来てるけど……もうすぐかな？　えーっと、セルヴァティウス通り7-265……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "あの家の前に停まってる車……安魂教会の霊柩車かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "修道士さん、こんにちは！　あの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な修道士",
      "text": "ごきげんよう、お若き執行人さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "お二人はもう調査を終えたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "信心深い修道士",
      "text": "ええ、病で亡くなられたサンクタでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "ご遺体を確認させてもらってもいいですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……検証完了、故人は世帯主のフェオリア・ラポルタさんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "修道士さん、僕が受けた任務説明では、故人の周りに遺言は確認されずとのことでしたが、お二人はそれに類するものを見かけませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な修道士",
      "text": "いいえ。ですがこちらをお受け取りください……公証人役場が回収するものでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "これは……故人の守護銃ですか？　ありがとうございます。僕が責任を持って公証人役場へ持ち帰りますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "信心深い修道士",
      "text": "身元の確認と守護銃の回収が済んだのであれば、私たちはこの御方を安魂教会へとお連れいたします。よろしいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……あっ、わかりました。よろしくお願いします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "えーっと、故人の情報があれば、端末からでも遺言の事前登録情報を照会できるはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……本籍地……世帯主……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……あれ、遺言の事前登録がない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "この診断記録は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "はぁ、この手の病気なら、入院治療を諦めてもしょうがないか……でもどうして遺言すら残さなかったのかな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "ん……？　近所の子供かな。でも僕を避けてるような……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "危ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "え、そんな。気を失ってる？　ただ転んだだけなのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "すみません！　この子のご両親はいらっしゃいますか！？　あるいはご両親をご存じの方は？　近所に住んでる子でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "親切な市民",
      "text": "こんな子、見たことないわね。倒れちゃったの？　……頭でも打ったりしてないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な市民",
      "text": "僕も知らないなぁ。越してきたばかりかな？　役所の出張所の人に聞いてみたらどうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "ぐずぐずしてる場合じゃないでしょ！　怪我してるかもしれないんだから早く病院に連れて行かないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優しい市民",
      "text": "執行人さん、早く病院に連れて行ってあげて。私たちはみんなこの辺に住んでるから、親御さんっぽい人を見かけたら急いで病院に向かうよう伝えておくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "わかりました、お願いします！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "市民？",
      "text": "チッ……まさかセシリアが家から出るとは。しかもよりによって公証人役場の奴と鉢合わせるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "市民？",
      "text": "パティア、どうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "どうするもこうするもないわ。まずは追ってセシリアの安全を確認して……それから奪い返すのよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
