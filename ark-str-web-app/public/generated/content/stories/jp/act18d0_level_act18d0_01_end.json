  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d0/level_act18d0_01_end.txt",
  "sourceHash": "78e43b6deeb5e5e3b69e4bcf852137796c99c7311592fb6539d3ec5625fd4d6d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "1下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二十二年前\np.m. 3:09 天気/晴天\nサルゴン中部 イバト地区"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "顧問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "目標物の回収を完了した。他の部隊が徒党を組んで我々を襲撃してくる前に、ここを離れる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "こちら行動隊、上級顧問の手によって「サンドソルジャー」小隊の生存者および目標物は回収された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "……了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "顧問、偵察隊がすでにルートの安全を確保したようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "では、行こう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "あー……エリオットさん、その箱を我々に渡してもらえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少年は持っていた箱をしっかりと抱きしめた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "……顧問？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "好きにさせてやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "僭越ながら申し上げます。我々は、目標物の状態に問題がないことを確認し、以後いついかなる状況においても我々のコントロール下に置くべきであると判断します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "彼が逃げると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "……いえ、それは……わかりました、あなたに従います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵A",
      "text": "ん？　なぜ止まるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵B",
      "text": "エンジントラブルみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "術師はどうした？　点検させろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "まさか……燃料切れ？　拠点から出る時に点検しなかったのか？　担当は誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "スタウトハンマー小隊のJ5だ。だが今は全員偵察に行っちまってるんだ……どうする？　奴らに連絡するか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……エリオット。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "伏せろ。箱をしっかりと抱えておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……どういうことですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "何か爆発した――うわっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "偵察隊！？　おい、聞こえるか？　俺たちだ、俺たちだよ！　術師に攻撃をやめさせろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "Mon3tr。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "そ、そいつ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（嬉しそうに身震いする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "違う、早合点するな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "この子を守れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（返事をする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "ひっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "どういうことです！　彼らはあなたの仲間じゃないんですか！？　僕たちを助けに来たんじゃないんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "気を抜くな、Mon3tr。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "うわっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（不満そうな叫び声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "クソが！　別行動ってのはダミーかよ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "リバーブレード小隊、全員聞け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "偵察隊が俺たちの所属を把握してる上で攻撃を仕掛けてきた。これは明らかな契約違反だ！　いいか、スタウトハンマー小隊が裏切ったんだ！　反撃準備にかかれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "術師チーム、アーツ発動用意。狙撃手は方向を確認せよ！　撃て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "この砂漠で武装車両から徒歩で逃げようとするのは、賢い選択とは言えないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ここに残るのが、最も安全だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……これもあなたの計画ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "いいや。戦争はクルビアに多くの利益をもたらすが、誰一人としてそれが他人のポケットに入るのを良しとしていない。利益の分配において、あらゆる者を満足させるのは難しいことだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "彼らの上級顧問として、私はすでに十分な忠告をしてやった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "あらゆる「裏切り」の可能性も含めてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……今、外では戦争が起きています……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "なのにあなたは、ただここに座ってて……何もしないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "気付いていないようだから確認しておくべきだろう。エリオット、ここには君も座っている。私の庇護を受けてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "それは違います……ここにこの箱があるから、彼らは僕たちを攻撃できないんです。私があなたを守っているんですよ、「顧問」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（不満そうに遠くを凝視する）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "反論するつもりはない。確かに彼らは、その箱を破壊できない――サルゴンのジャングルの半分を砂漠に変えてしまう可能性のある、アーツ技術の原型を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "それは、全く新しい動力源としてカモフラージュされているがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……な、何を言ってるんですか……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "顧問！　これ以上は持ちそうにありません、すぐ撤退しましょう。脱出ルートを変更します！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "生存者を連れてついてきてください！　我々がお二人の安全を確保します！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……撤退できたのは何人だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "二十人もいません、ひどい損耗です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "隊長、もう一度言います。数十人が死にました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "作戦中に堂々と裏切りやがって、あの*クルビアスラング*！　会社がきっと人を送ってあいつらを皆殺しにしてくれますよ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "それは……どうだろうな。スタウトハンマー小隊が早くから計画していたのなら、会社の手はサルゴンに及ばないかもしれない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "奴らは首長の誰かと取引をしたのかもしれないな。いや、もしくは最初から……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "ふむ……顧問とあの子供は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "あそこです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "俺に……彼らと話をさせてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……顧問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私はサルゴンに入る前に、忠告したはずだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "今更ここで答え合わせをしたいのか。……軍部はサルゴンに火を放つ必要があった。燃え上がる戦いの気運は彼らに財をもたらすからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "工場、鉱山、武器貿易……己をより肥え太らせるため、クルビアが常にこの古い国を食い物にしているのは周知の事実だろう。軍部も例外ではなかったということだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "彼らは「サンドソルジャー」の発足を促し、科学研究員を連れてサルゴンに……「技術援助」のために向かわせた。それで上手く自身の目的を達成できると軍部は確信していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "――しかし管理局はそう捉えてはいなかったわけだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "正確には、酒類・煙草・アーツユニット及び源石製品管理局、そしてその背後にある何らかの勢力がそうは思っていなかったと言うべきだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "一部の者の目にはサルゴンは腐敗し、その隆盛はすでに過去のものとなったと映っているかもしれない。しかしかの古豪は未だに人々を支配して平伏させるだけの力を秘めている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "管理局の見方は正しいとしか言いようがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "クルビア人の一部は莫大な富と権力を手にしたがゆえに、万能感で視覚が狂ったのだ。己の力量も相手の強大さも見誤り、何の代償も支払わずにサルゴンを排斥できると勘違いしてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "パーディシャーの誰かが気まぐれに一言発するだけで、クルビアの証券取引所の数字は容易く上下するにもかかわらず、彼らはそうしたサルゴンの強大な力がまるで見えていないように振る舞った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "会社の中で座したまま指示を出すだけの者であれば、無知でも構わないだろう。失策だったという報告を受けるだけだ。だが現場の君たちは、自分が一体何をしているのかを知っておいた方がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "なぜなら、それが君たちの生死に密接に関わっているからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "パーディシャー……サルゴン帝国の中枢が首長を牽制するために任命した大総督たち……そいつらが、会社のやることと関係があるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君は会社が何をしようとしているか知っているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "エリオットが抱える箱は、ある首長との取引を成立させるために、軍の上層部の者がブライアン創生科学研究所の大株主を脅迫し、非公式という形でサルゴンに輸出しようとしたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "軍が取引したのは、簡単かつ乱暴な方法でイバトに内乱を起こし、利益を得るためだ。その目論見が実現した場合、パーディシャーたちがみすみす内乱を静観すると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "帝国が出張って来ないとでも？　箱の出所が掴まれないとでも？　管理局は考えた――砂嵐の中に隠れる古代帝国の中心にまで戦火が及べば、自分たちの「金を稼ぐ」手段が全て灰と化してしまうと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "クルビアに累が及ばぬよう、サルゴンにおける軍の上層部の度を超えた行為を阻止するために、管理局は俺たちに目的物を回収させた……そのくらいはわかる、だが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが軍もバカではない。社内における軍のスパイ――君も知ってる人物だろう――彼はスタウトハンマー小隊を買収し、図面がサルゴンに留まるように仕向け、首長の誰かが武力蜂起するのを待った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……そんなバカな！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私以外の顧問は全員、社内で起きたこの一連の動きを黙認した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "業務総括は中立を保ち、互いに牽制させ合った。そしてその結果、より多額のグレーゾーン収入を生み出したのだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "なんだ。子供の出る幕じゃないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "僕は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "彼はエリオット・グラバー、十三歳にして飛び級で大学を卒業した後に、地元の科学アカデミーに入所、源石技術科で学んだ天才だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "それから三年後、この若き天才はソーン教授のお眼鏡に適い、彼の助手として育てられた。そして今回「サンドソルジャー」の一員として連れて来られた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "「砂の兵士」というコードネームを与えられた研究者の小隊は、任務先のここサルゴンで、何が待ち受けているのかを全く知らなかったのだ。何も知らされず出発し――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "――無残にも砂嵐の中で命を落とした最後の瞬間まで、彼らは蚊帳の外だった。その唯一の生存者が事件の全容を知る機会を奪う権利は、私たちの誰にもないはずだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……わかったよ。好きにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "どこまで話したかな……ああ、そうだ。クルビアで管理局と軍の両方が会社に圧力をかけ、それからサルゴンで首長たちがドンパチやるって話だったか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……ははっ、最初から俺たちはハメられてたってわけだな。そのうえ何も気付かずに、この紛争に飛び込んじまった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "連中は、よくこんなことができたもんだな……俺たちをゴミ同然に砂漠に投げ捨てるなんてよ。それで事態が自分たちの思うように進むと本当に思ってるのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "会社は箱が誰の手に渡るかなんてそもそも興味がない。君たちのどちらかが生き残って任務を果たせば、会社は報酬を得られる。さらに言えば、たとえ君たち全員がここで死んだとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "彼らの懐に入る硬貨は、一枚たりとも変わらない。虎視眈眈と台頭の機会を窺っている首長やパーディシャーが、君たちの代わりに後始末をしてくれるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "つまり、どのみち今回の事件を契機にして、この国には混乱がもたらされる。そうすれば軍の目論見は達成され、戦乱の対価は遠くクルビアの会社で座る誰かの懐を、予定通り潤すことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君たちが莫大な報酬につられてサルゴンにやって来た瞬間から、すでに退路はなかったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……すまなかったな、顧問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "わざわざ忠告してくれたうえ、俺たちの行動に力も貸してくれた。あんたへの敬意は、会議室で戯言ばかり並べている葉巻き中毒の連中に対するものとは比べものにならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "だがもしかしたら……俺たちには別の道があるかもしれない。武器を取ってくれ、顧問。俺はあんたとの対決にまだいくらかの尊厳を残していたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "彼女を殺す気ですか……！　どうして！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "当然だ、これこそが俺たちの本当の仕事だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "冷静になれ、傭兵。君が業務総括から別の密命を受けているのは私も知っている。だがもう君にもわかっているはずだ、今となってまだ命令に従って行動しても、自ら生きる道を断つだけだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "そうだな、あんたは何でもお見通しのようだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "全部あんたの言う通りだ。会社は俺たちを売り、管理局は捨て駒にした。首長やパーディシャーたち、そしてクルビア軍は、俺たちを殺してブツを奪おうとしている――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "――だがよ、俺たちゃ傭兵だ。こんなことは日常茶飯事、金さえ貰えりゃ、どうだっていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "それは残念だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "管理局？　クルビア軍？　どっちにしろ勝手にやってくれ、俺にはわけがわからん。俺はこの騒動に関しちゃ、取るに足らない一兵卒にすぎないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "顧問……会社は、あんたが今のその地位に居座り続けるべきでないと考えてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "誰にも知られずに、一人の上級顧問をサルゴンで消すには、いい機会なんだ。俺に随分な大金を支払った奴がいてな。もしかしたらスタウトハンマー小隊を買収したのと同じ人物かも知れねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "だがそんなのはどうだっていい。ただ一つ、最後に訊いておきたい……あんたが……あんたがここまでしたのは、一体何のためだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……クルビア、サルゴン、そして恐らくはヴィクトリアも……多数の勢力がこの件に関与している。そして、それぞれの陰謀はすべてある一つの結末を指し示している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "――戦争か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そうだ。そして戦争は破滅をもたらす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私はただ、この破滅を阻止したいだけだ。非力ながらも、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "俺は……俺は何を信じるべきなのかわからない……あんたを殺して業務総括の命令を完遂すれば、会社は改めて俺たちを認めてくれるかもしれない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "洞窟に追いやられた十六名の傭兵たち、一人の科学者の卵、そして一人の傭兵企業の顧問が、数百万の命の行く先について腰を下ろして共に語り合うなど、一体誰が信じられるだろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "最後に一つ言っておこう。たとえ業務総括の望み通り、邪魔な顧問がサルゴンで消えたとしても、それは君が安全に家に帰れることを意味しているわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "この砂漠にいるすべての殺し屋が、「サンドソルジャー」の遺産を持ち去ったのは君たちだと思っている……そして彼らは確実に、首長の謀略をぶち壊したクルビア人を殲滅しようとするだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "俺は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君は私を殺した後、エリオットを交渉材料にするつもりだろう。だが果たして、平和的対話を図る余地はあるだろうか。彼らにとっては君をどうにかする方がよほど楽で早い解決方法だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "――いや、あんたは正しい。ついさっき仲間を殺した奴と取引するなんて俺には無理だ。俺は「大局を重視」できるような人間じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "いいだろう、俺の負けだ、顧問。俺はクロスボウを下ろす、だからあんたもその……ええと、あんたもそのペットを引っ込めてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "text": "（威嚇するように低くうなる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……君はこれからはどうするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "もしこのままあんたと共に行動すれば、俺たちはクルビアに帰れると保証できるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "逆だな。もし私が一緒に行けば、君たちの危険が増すだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが少なくとも、私は君たちのために退却路を示すことはできるだろう。君たちがミノスに密航する手助けをしよう。おそらくこれが最も安全なルートだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "「最も安全なルート」なのに、あんたは一緒に行かないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私の目的地はまた別の場所にある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "まさか、このルートは俺たちのためにわざわざ用意していたなんてことは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "勘違いするな、これは生き延びてこの地を去る者たちのために用意したものだ。それが誰であろうとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "救世主のようにも聞こえるが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そんな大層なものではない。疑わしいのであれば、一つの取引だとみなしてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……わかったよ。あんたの言うことを信じなかった結果、自ら災いを招いてしまったのは確かだ。今はもっと賢くあるべきだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "これは取引だ、顧問。あんたら二人の命で、俺と残りの兄弟たちの命を買おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "十六対二か、随分とお買い得だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "確かにバーゲンセールも同然だな、ハッ！　けどあんた、この日が来るってとっくにわかってたんじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……どこへ向かうんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "僕たちは……僕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "イバト地区に闇市がある。地元の武器商や源石製品の地下商人たちは「沁礁闇市」と呼んでいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "その闇市へ行く。そこの密航者なら私たちの力になってくれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "僕はただ……僕は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "僕は……先生の遺体を……あんなぞんざいに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "もっと他に……僕は……あの血を、あの叫びを……うぐっ、おえっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "ゴホッ、ゴホゴホゴホッ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "……顧問は行ったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "次はどうするんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "これを見ろ……顧問からもらった地図だ。各町の名前だけでなく、トランスポーターの拠点まで示されてる。この地図だけでどれほどの価値があると思うよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "……あの顧問は一体何者なんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "知るか！　だが今は、彼女の情報だけが俺たちの頼みの綱だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "身元がバレそうなマークは全部剥がせ。クルビアの車も使えない。最も近い町へ徒歩で行く。大体三十キロだ。そこで車を調達して、ここからオサラバするぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵",
      "text": "……俺たちはこのまま逃げるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "言いたいことはわかる……だが俺たちはまだ「お礼参り」の準備ができてない。しばらくは潜伏して、力を蓄えてからここに戻る。そして会社の裏切り者どもに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "――誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "……ほう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "「サンドソルジャー」を逃がしたか……これは予想してなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リバーブレード傭兵隊長",
      "text": "敵襲だ！　狙撃手、準――ぐふっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "三人は生かしておけ。呪術師に拷問の準備をさせろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ほかの奴は全部片づけろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "落ち着いたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "研究員を含む「サンドソルジャー」小隊は、トカロントを出る際、少なくとも百人規模だった。生き残ったのは君一人だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君は虐殺を経験したばかりだ。難しいだろうが、できるだけ早く元の精神状態を取り戻さなくてはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……あなたは一体……何をするつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君が抱いているアーツの原型図面を回収する。私の予想が外れてなければ、恐らく源石結晶サンプルも入っているだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "くっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そうしたところで、戦争の勃発が先延ばしになるだけだが、十分な時間稼ぎはできる。クルビアにいる私の同僚たちが、この件に干渉が可能になる程度にはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君は、その箱の中身が何なのかを全く理解していない。こちらに渡してもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "渡せません！　冗談じゃない……これは研究所が心血を注いだ成果なんです……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君が信じるか否かはさておき、数で計れぬほどの情熱や命と引き換えに得られた成果が、一介の理論科学者にとってどれほど重要であるかを、私は深く理解している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが、この「新型源石エネルギーアーツ転換装置」と名付けられたものが、もし別の目的で使用されたとしたら、それがどれだけ深刻な被害をもたらすかも私は理解している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "くっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "多くの者がそれに気付いていただろう。もちろん、君の先生もだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……あなたは！　僕たちが悪い研究をしていたことを先生が黙って見過ごしていたと言うんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "よくもそんなことを――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "……ここがサルゴンか！　なんと伝統を感じさせる魅力的な国だ……見てみろ、荒れ果てた砂漠の真ん中でも、移動都市に頼らずに生活している。それでいてこんなにも活気づいているとは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "ええ、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "……ん？　エリオット、まったくお前は注意力が足りんな。こっちに来い、頭に付いた砂を払い落してやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "あっ……せ、先生、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "しかし先生……もし身の回りの女性たちに対してもそこまで気遣いができていたら、きっと家の人に結婚を急かされずに済んだのではないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "ははっ！　痛いところを突くんじゃない。来月のお前の実験担当を倍にしちゃうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "ああ、いや、何でもない。砂漠の向こうの山脈や、その反対側にあるジャングルもきっと活力に満ちているんじゃないかと思ってな。この砂漠とはまた違った感じで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "あのジャングルにも……ここと全く異なる生活をする人々がいるのだろうか？　何で生計をたて、生活レベルはどの程度なのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "ジャングル？　どうして急にそんなことを気にするんですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "いいかエリオット。私はね、我々の研究は、源石技術の恩恵を受けられていない人々に、幸福をもたらすためのものだと思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "だが、研究成果が当初の意図と異なる形で用いられることもある。私たちは初めから誤った道を選んでしまっているのかもしれない。そしてそれに気付いた時はもう、取り返しがつかないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "ハハッ。いやすまない。これはただの仮定の話だよ。だが、もしそんな日が本当に訪れたとしたら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーン教授",
      "text": "――私たちはそれらすべてを阻止しなければならない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "ソーン……先生は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……あ、ありえない。先生は騙されてたんだ……先生は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ソーン教授の研究は、最初から悪用しようとする者に目を付けられていた。研究結果を欲する連中は資金の支援もしていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ただそうした金銭は複数の口座を経由して、新興エネルギー市場に憧れを抱いているよう装った商人から彼に渡された。そのせいで教授は疑いを持たなかったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私は彼に忠告したことがある。だが実験の成功と前進が、彼の眼を曇らせてしまったのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "完璧な人間などいない。だがエリオット、君たちが全てを捧げた研究がサルゴンを燃やす戦火の火種になることは絶対にない。そのために私はここに来た。そして君の協力を必要としている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ふむ……君には、考えをまとめる時間があと五分ある。それから出発しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "僕を連れて行く気ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "でなければ君はこの砂漠で死ぬだけだ。君の数学と源石応用に関する才能は否定しない。だが君は、どの植物から安全に水分補給できるかすらわからないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私は、「サンドソルジャー」の真実を知る最後の若者が、目の前で無駄に命を落とすのを見たくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "勿論、もし君が既に行動する意味を失い、前に進む必要がないと感じるのなら、君をサルゴンの田舎に避難させてやることもできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エリオット",
      "text": "……あなたは……あなたは一体何者なんですか？　どうして何もかもをそんなに……簡単に言えるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "もう一度君に繰り返す必要があるというのなら……今の私は、クルビアウェスティン警備会社の上級顧問兼術師教官だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "――私は、ケルシーだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「サンドソルジャー」",
      "text": "ケルシー。ケルシー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「サンドソルジャー」",
      "text": "ふむ……この契約書……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「サンドソルジャー」",
      "text": "なんと美しいサインだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
