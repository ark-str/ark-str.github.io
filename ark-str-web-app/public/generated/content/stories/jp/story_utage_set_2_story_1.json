{
  "server": "jp",
  "storyId": "story_utage_set_2_story_1",
  "groupId": "story_utage_set_2",
  "stageId": null,
  "title": "鵺切物語",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_utage_2_1.txt",
  "sourceHash": "34d9db3038b65d134b7ddeef5be6e6de9345ee48b6608ce226d565fd5ed16be3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "奉行A",
      "text": "待て、今何か聞こえなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奉行B",
      "text": "なんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奉行A",
      "text": "……屋根の上からだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奉行A",
      "text": "クソ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奉行A",
      "text": "あれは一体何なんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奉行B",
      "text": "ば、化け物め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奉行A",
      "text": "退治してくれる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "謎の化け物",
      "text": "ガアアアァーー！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奉行B",
      "text": "今の声で怒ったようだぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奉行C",
      "text": "と、殿！？　ここは危険です！　どうかお戻りください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大名",
      "text": "醜い化け物め！　わしの臣下を傷つけるとは、その命を以て償え！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロドス外部連絡所"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "それが極東に伝わる鵺切家の伝説か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "ああ、聞くところによれば、鵺切の一族は今も極東のどっかの一族のために、災いを退け、幸運をもたらしてるらしいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "でも結局、どの領地のどの大名の話なのか、はっきりわかってないじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "だから伝説なんだろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "荷物の確認が完了しました。いつも通り、あちらの廊下をお使いください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "左へ曲がるところに赤いマークがあるのが見えますか？　あれが貨物用のエレベーターです。二層上がれば、クロージャさんの保管庫へ繋がる廊下に出られます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "標識に沿って進んでいくと、目的地まで三回のセキュリティチェックを受ける必要がありますが、スタッフの指示通りにしていれば問題ありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "これだからロドスは面倒だよな。ここで受け取ってくれたっていいのに。そんじゃ、俺はここで伝票の整理をしてるから、あんたが届けてきな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "え、俺かよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "いいからさっさと行ってこい。くれぐれも道に迷うなよ。俺はもう何回もここに来てるけど、未だにあの廊下を歩いてると頭がこんがらがる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "わかったよ。行ってくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "あの彼……初めて見る顔ですね。また担当者が変わったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "トランスポーターってのは、人が辞めたり入ったりしてくるもんだろ。危険だらけな大地で荷物を届けるのがどんだけ大変かは、ロドスが一番よく知ってんだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "前にあなたと組んでいたパーカーさんはどうしたんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "手紙を届ける途中で野獣に襲われて怪我しちまって、今はレム・ビリトンの実家で療養中だ。容態は詳しくは聞いてないが、いつ復帰できるやら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "命が助かっただけでもよかったじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "だから、新しいパートナーが派遣されたってわけ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "まいったな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "（どの廊下もまったく同じにしか見えない。まさか……本当に迷ってしまったのか？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "というか、誰もいないじゃないか。引き返そうにも、元来た道もわからないし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それ、クロージャの保管庫に届ける荷物？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "道に迷ったの？　案内したげようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "え？　ああ、助かるよ、君はここで治療を受けている患者なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "違うよ～、あたしはここのオペレーター。IDカード見る？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "これは失礼、見た目からしてまだ学生かと思ったんだ。それで、どの道を行けばいいのか教えてくれるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "もちろん。でも代わりにー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "道案内の代わりと言っても、勝手に荷物を持ってくのはだめだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あたしが注文したやつだから別に良くない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "いや、でもまだロドスの検査が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あたしは毎回自分で勝手に取ってるよ。ほら、ここに「ウタゲ」、「コスメ」って書いてあるでしょ？　それとも源石爆弾が入ってるんじゃないかって疑ってるの？　ここで中身見せたげようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "……いやそこまではしなくていいが……決まった作業フローがあってだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そ。じゃ荷物置き場だけど、今来た道を戻って三つ目のドアをさらに進むと、二十メートル先に曲がり角が見えてくるから、そこを右に曲がって左側の通路を三十メートル進んだら、目的地に着くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "はやく行きなよ。あたしはこれから訓練があるから、じゃあねー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "おい、まだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "ロドスのオペレーターってみんなあんな感じなのか？　なんというか……自由だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "あとで、ウタゲというオペレーターが荷物をひとつ持っていったことを、セキュリティチェックのスタッフに報告しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "話好きの男",
      "text": "よし、急いで届けるぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウタゲは、トランスポーターの視界の届かない曲がり角のところに立っていた。\nその手には先ほどの箱を抱えている。まるで、何か大切なものでも入っているかのように。\nそして、一切物音を立てることなく、ウタゲはトランスポーターの後を追いかけた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "つまり、極東の伝説にすごく興味があるということですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "ああ、珍しい話を聞けるのが、トランスポーターをやってる醍醐味だからな。新しい人と出会うたびに、そいつの地元の話を聞くようにしてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "それは確かにトランスポーターくらいにしかできませんね。そういえば、私は鵺切の伝説の別バージョンを聞いたことがありますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "へぇー、どんな話なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "そうですね――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "領地はとうの昔に滅びましたが、鵺切の一族はどこかでひっそり存続しているそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "極東のとある一族に召し抱えられ、今も己が責務――主にとっての「鵺」を斬り殺しているとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス荷物管理員",
      "text": "これが、私が聞いたもうひとつの鵺切伝説です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心の強い男",
      "text": "さっきの話と全然違うじゃないか。これは興味深い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "面白い話だ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "続きは？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ロドス荷物管理員",
          "text": "ドクター！　いつからいたんですか！？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "「彼は山に潜む数多の賊と同じく」のあたりから。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ロドス荷物管理員",
          "text": "本気にしないでくださいね、ドクター。私も人伝に聞いただけですから、内容が本当かどうかまではわかりません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "好奇心の強い男",
          "text": "ははは、所詮は物語だろ。突拍子もないくらいがちょうどいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "好奇心の強い男",
          "text": "にしても、新人のやつはいつになったら戻ってくるんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドス荷物管理員",
          "text": "ドクター、わざわざここまで来たということは、何か大事な荷物でも届いているのです？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ああ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "いくつかの事務所からの報告書が今日届くんだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ロドス荷物管理員",
          "text": "ちょうどこちらの荷物のリスト整理が終わったところです。クロージャさんのところへ行ってみましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "好奇心の強い男",
          "text": "とろとろしやがって、まさか本当に迷子になったのか？　あとで先輩としてきっちり「指導」しないとな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "好奇心の強い男",
          "text": "な、なんだ！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドス荷物管理員",
          "text": "一体何が起きたのです！？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "保管庫の警報が鳴ったようだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "様子を見に行こう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "クロージャの保管庫へと続く廊下には、すでに数名のオペレーターが待機していた。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "何があったんだ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "熱感知アラームが作動しました。誰かがここでアーツを用いた戦闘を行った可能性があります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "ですが、現場に戦闘の痕跡はなく、荷物を載せた台車が一台残されているだけでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "好奇心の強い男",
          "text": "これって俺たちが持ってきた荷物じゃないか？　俺の同僚がこれを運んでいたはずだが、見かけなかったか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "オペレーターは首を横に振った。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "ドクター、気をつけてください。今監視カメラの映像を調べています。万が一危険があってはなりませんので、その間は我々のそばを離れないでください。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（廊下の状況を確認する）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "ドクター？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "好奇心の強い男",
          "text": "大の大人が一人、こんな簡単に消えちまうなんてあり得ないぞ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "これは……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "台車のそばにしゃがみ込んだドクターの鼻に、何かの臭いが届いた。\nそれはほんの微かな甘い香りだった。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "まさか……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "（あーあ、めんどくさ……)",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ウタゲは心の中で文句を言いながら、腕に抱えた小さな箱に目をやる。落としたのか、箱はところどころ凹んでいた。"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "（イライラする。)",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "ああー！　ほんとにもう！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ウタゲは段ボール箱と太刀をどさりとテーブルに置く。\nそして、ネイルを施した指先でカッターナイフを取ると、段ボールの蓋にすっと切り目を入れた。封の切り口の間からは小さな部品が現れる。\n部品には小型の源石電池が接続されており、小さいながらも精巧な造りをしている。\nその部品を見つめるウタゲの顔から、すっと表情が消える。"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "もしもーし、聞こえてるよね？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ウタゲは部品に話しかける。予想通り、それは盗聴器だった。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "ドクター、艦内の端にあるドアのそばで、例のトランスポーターを発見しました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "原因は不明ですが、気を失っています。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "きっと働きすぎで倒れたのだろう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "休憩室でゆっくり休ませてあげて。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "ですが……もし彼が――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "どう考えても怪しいのに――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "大丈夫だ、信じてくれ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ここも一通り調べたけど、他に痕跡はなかった。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "……ドクターがそこまでおっしゃるのなら、とりあえず彼を休憩室まで運びましょう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "他のみんなも戻ってくれ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "事件性があるわけではない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "報告書はこちらで作成しておく。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "いい？　一度しか言わないからよーく聞いててね。ま、どうせ録音されるから、どうでもいいけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "……コホン。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "今の生活ほんとにだ～い好き！　友達と遊ぶのもだ～い好き！　前に住んでた屋敷と比べたら、ロドスって何もかもがサイコーに感じちゃう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "あ、でも訓練はきらい。だからこそ、サボった時のあの感じが大好きなんだけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "だから――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "間諜を変装させてロドスを調べようとしたって無駄なの。あたしが見破れないわけないでしょ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "誰がロドスに興味を持ってるのかは知らないけど、また今度変な小細工を仕掛けたりなんかしたら――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "一回帰省して、鵺切一族を滅ぼしちゃうかんね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "それじゃ、パパとママによろしく～。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ウタゲは身を翻すと、すらりと刀を抜く。\n哀れな盗聴器は真っ二つに斬られ、ゴミ箱の中へと落ちた。"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "ああー！　フェイスパウダーがこぼれちゃってる！　絶対にさっきの偽トランスポーターが反撃なんかしてきたせいじゃん！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "うちの人間にあいつにお灸を据えといてって言いたいけど、盗聴器壊しちゃったしなぁ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "ほんっと腹立つ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ウタゲは殺し屋にも間諜にもなりたくない。もちろん一族の責任とやらを背負いたくもない。\n訓練も嫌いだ。正直なところ、オペレーターをやるのもなかなか疲れる。\nウタゲはただの女子高生でいたいのだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "あっ！　キララ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キララ",
          "text": "やほー、ウタゲ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "何持ってるの？　それ、新しく届いた雑誌？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "もう、あたしを置いて自分だけ先に読むなんて！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キララ",
          "text": "そんなことないよ……今受け取ったばっかなんだけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "まあいいや。ほらキララの部屋に行こ！　新しいコスメが届いたから一緒に試そ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "キララ",
          "text": "ま、またぁ～……？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
