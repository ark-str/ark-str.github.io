{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_04_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_04",
  "title": "機械獣の咆哮",
  "storyCode": "RI-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_04_beg.txt",
  "sourceHash": "dfcfe1700602f934832597902cc8ef8b0be8386661ec0b7b836cee07d98ffbfc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "ユーネクテス！　ユーネクテス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "全員やっつけろ、ユーネクテス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "大族長、大族長！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人D",
      "text": "ユーネクテス、結婚してくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの勇士",
      "text": "……ユーネクテスか、来たな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの勇士",
      "text": "ジャングルに引きこもってもう出てこないのかと思ったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ジャングルはいい場所だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの勇士",
      "text": "ヘッ、ジャングルで縮こまってるティアカウは全員腰抜け野郎だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "腰抜けかどうか、試してみるといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ズゥママのヤツ、ヘンテコな装備は増えたけど、性格は昔のまんまだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おっと、ドクター、紹介がまだだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "舞台にいるあいつはズゥママってんだ。別部族の奴だったけど、縄張りが近くてさ。歳も近いし、要は幼馴染ってヤツだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あいつはあんまり喋らねぇけど、実力は本物さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "でもいつの間にか変になっちまってたんだ。喧嘩をやめて、おかしなモンを弄るようになってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "それから気付いたら部族ごと引っ越しちまって、会う機会もほとんどなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "聞いた話じゃ、喧嘩はまだ強いけど妙な病気に罹ったとかで、誰もいないところで独り言を言うようになったらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ロドスで似た症状を調べてみたんだが、精神疾患の類だと思う。だがこうやって見ると、割とまともに見えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "前回の祭典には出ると思ってたのに、結局来なかったんだ。あのときは本当に残念だったなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "それにしても、今やユーネクテスなんて洒落た名前を名乗ってるとはな。あいつが来たんなら大族長はもう決まりだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの勇士",
      "text": "ぐはっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "へぇ、やっぱりあいつも強くなってやがる。アタシもやり合ってみたいぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……ズゥママは強い。でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ん？　あそこにいるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "ユーネクテス、次はオレたちがお前に挑むぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前たちは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "オレはフレイム族の族長、ウダイ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "オレはスカー族の族長、アルナ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウダイ＆アルナ",
      "text": "野郎ども、前に出ろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "まとめてかかってくるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウダイ",
      "text": "へへっ、オレたちはどう……なんだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルナ",
      "text": "アホ、同盟だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウダイ",
      "text": "あーそれだ、同盟を結んだんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルナ",
      "text": "簡単に大族長になれると思うなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "簡単になれるだなんて思ってない。それにしても、お前たちが仲が良かったなんて初耳だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウダイ",
      "text": "オレたちにも事情があんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルナ",
      "text": "へっ、機械ばっか弄ってるようなヤツが大族長になるなんて、気に食わねぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "祭典って、複数で参加できるものなのか？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "えっ？　はい、そうですよ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "なんて顔してんだ、ドクター。もしかして祭典を決闘かなにかだと勘違いしてないか？",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "一対一ではなかったのか？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "えっ？　全部一対一だと時間がかかるじゃないですか。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "面子のために大抵は一対一でやるんだが、厳密にはルール無用だ。要は全員ぶちのめして、最後まで勝ち残ったヤツが大族長ってわけさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "舎弟を連れてくのは、一番手っ取り早い方法だな。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ルール無用？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ドクター、まさか参加するつもりじゃないだろうな。やめといたほうがいいぜ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "おいドクター、なに悪い顔してんだよ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "それなら自分も大族長になれそう。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ハハハ、残念だがドクターじゃ無理だ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ルール無用って言っても、ドクターが考えてるような手段は誰も使わねぇよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ここの奴らは単純だからな。何でもありだとしても、思いつくのはせいぜい人手を増やすことくらいだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "回りくどい小細工をするヤツなんて、いやしないのさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "正直、ロドスで何年も暮らしてるアタシですら、そういうのは未だに慣れねぇしな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "でも、人数が多ければいいってわけじゃないんですよ。多対一にもリスクはあります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ハハ、そうだな。あとで仲間割れするのも珍しくないからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "それに、もしドクターが考えてるような方法を使ったら――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "間違いなくリンチだ。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "人聞きの悪いことを言うな。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ハハハ、ホントのことを言っただけだ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ハハ、ドクターがそんな顔をするなんて珍しいな。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "みんな純粋なんだなぁ。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "そうだな。純粋でいいとこだろ？　アタシも外に出るまではわかんなかった。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "昔はどこのヤツも同じだって思ってたからな。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "まぁ本当のところ、ドクターが本気になればバレずに小細工で勝つこともできると思う。だけど、お前とあいつらの間には決定的な差がある。何かわかるか？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "筋肉？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "そうだ！　お前、見るからに弱そうだもんな！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "おいドクター、そう拗ねるな、話を聞けって！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "まぁそれも正解だ。ドクターはここのヤツらと比べたら、風に吹き飛ばされそうなくらい貧弱だもんな。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "外見？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "とにかくだ、大族長になるための条件は至極単純さ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "腕っぷしが強くて、ゲンコツが痛くて、喧嘩じゃ誰にも負けねぇってことだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "だろ、トミミ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "えっ、は、はい！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "しかし妙だな、あの二人は友達でも何でもなかったはずだろ。まさか手を組むなんてな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "うーん、ガヴィルさんが出て行った後、仲良しになったんじゃないですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "まぁそうかもな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "つーかズゥママは族長なんだよな？　子分たちはどうしたんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "確かにそう言われれば、あまりズゥママの部族の人は見てません……えーっと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "あ、いました！　あそこの変わった恰好をしている人たちがそうですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "へえ、いい装備を持ってんじゃねぇか。でも人数は確かに少ねぇ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "もしかしてあいつ、まさかアタシみたいに一人で全員ぶちのめすつもりか？　おもしれぇ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "っていうか、お前も参加すんだろ、トミミ？　こんなとこで見てていいのかよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "えっ、はい！　まだ大丈夫です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ズゥママの強さにはスカー族は足元にも及びませんが、体力は消耗させてくれるはずです。私は彼女が疲れたところで出ていく予定なんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ほほう、賢くなったな、トミミ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "えへへ、私だって本気で大族長になりたいですから！　そしたら……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "そしたら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "おっと、話は後だ、始まったぞ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
