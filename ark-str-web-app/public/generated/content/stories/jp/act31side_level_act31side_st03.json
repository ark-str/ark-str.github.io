{
  "server": "jp",
  "storyId": "act31side_level_act31side_st03",
  "groupId": "act31side",
  "stageId": "act31side_st03",
  "title": "雨風の中で",
  "storyCode": "HS-ST-3",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act31side/level_act31side_st03.txt",
  "sourceHash": "a879f5023dd339970cd0be7f3411424e7bf266099ce07a60a4cc3a098e547213",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ごほごほごほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ごほごほ……ごほ……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "結核の老人",
      "text": "わざわざこの天岳を登らせてまで、会う必要などあったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "結核の老人",
      "text": "日向は私の席だ、お前はそちらへ座れ。私はお前ほど体が丈夫ではないのでな、取らないでくれよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "散歩に出て、日差しを浴び、天岳の湧水を味わうのもお主の体に良かろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "おかしなものだ。私たちは数十年もあの宮殿の塀の外で顔を合わせたことがなかったのに、此度はお前の方から誘ってくるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "……結局のところ、先にじっとしていられなくなったのはお前の方か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "それはじっとしていられんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "玉門、大荒城。この一連の件について、納得のいく説明が必要だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "そうだ、すべて私がやったことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "玉門の山海衆は私が唆した。睚も私が引き入れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "これらで私を引きずり下ろすに足るか？ もし足らぬのなら、ウァンは私が都から放ち、例の子供は私がヴィクトリアに送り込んだよ。それと、悪魔の裂け目も私が引き裂いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "三公の席をもう一つ空ける必要があるのなら、こうしたことは全て私がやったことにしてもいいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "山海衆なぞ烏合の衆、あいつらに何ができる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "睚もただの病弱な獣であり、数十数百の天師を送り込めば追い払える。だが歳を呼び起こす餌としては、ちょうどいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "老いぼれの魔や道化師どもなぞ、何ほどのものか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "ごほ……ごほっ……ふぅ……結局、私もただの病弱な老いぼれにすぎん。この命も、使い道はこれしか残されていないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "お主は、事態が制御不能に陥ることを恐れておらぬ。一度もな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "恐れているものというなら、あまりにも多いな……私は「測り知れぬ人の心」を、「世の趨勢」を恐れている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "風を見て舵を動かす。それぞれが一方を引っ張っている方が、均衡を保てると思わないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "しかし事ここに至り、あの罪人は碁盤をひっくり返した。たとえわずかであっても、我々に和を求める可能性が残っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太尉",
      "text": "玉門城の修復はすでに完了し、都への道を急いでいる。太傅、とく備えよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "復職書……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "この書簡は、本来私が届けるはずのものではありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "大荒城の件、あの二人の罪人の行いについてはすでに朝廷の知るところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "現在は司歳台、天師府、六部……朝野のすべてが多忙な状態です。公務で大荒城を通りかかったので、代わりを務めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "母が、頼んで来させたのでしょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "今回代理人が引き起こした動乱について、朝廷内で結論は出ましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "玉門城の修復はすでに完了し、都に向けて再出発しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "やはり、そうなりましたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "落ち着いていますね。てっきり前線に戻りたいとうるさくわめき散らすと思っていましたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "ここしばらくで、ある道理を理解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "恐れこそ焦り……未知なる敵に立ち向かうことを恐れるほどに、人は突っ込もうとします。たとえ結果がどうあれ、自分に対する言い逃れができればそれでいいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……しかし、私はもう恐れません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "たとえあの代理人たちは天地をひっくり返す力を持っていようと、結局のところ、人情や人間らしさを持っています。この点においては、私たちも代理人も変わりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "「相手」は計りしれないものではないのです。それならば、何も恐れることはありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "ズオ公子、私は貴方と敵対するつもりはありません。先ほどの言葉は、ただ覚えていてほしいのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "まだ先は長い。いずれまた顔を合わせる日が来るでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "よろしい。ズオ将軍があなたにここで学ばせたのは無駄ではなかったようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "いつでも出立する準備はできています。これからどこへ行くのですか？　玉門、それとも百灶ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "焦らずに。まずはあなたの本職に戻っていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "代理人との接触が多い場所があります。そこに対し朝廷は何も知らないわけではありませんが、慣例通り、司歳台が調査に向かう方が良いと考えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ・ラウ",
      "text": "……ロドス？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャオマン",
      "text": "本当に行っちゃうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーシェン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーシェン",
      "text": "今回の種から栽培された中には、源石耐性が想像以上に良いものがあった。そろそろ外の田畑に植えて次の段階に進む時だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャオマン",
      "text": "それって、とっても大変じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーシェン",
      "text": "大荒城でやってたことと同じだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャオマン",
      "text": "うぅ……ならいつ帰ってくるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーシェン",
      "text": "まずは種を全国の食糧栽培基地に送って、最初の試験栽培株を育てるんだ。それから土地ごとの作物の適応状況を見て、適切な栽培方法を探す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーシェン",
      "text": "正確な結果が出るには、十世代以上の栽培が必要かも。多分、すごく時間がかかるだろうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャオマン",
      "text": "うーん……作物の一世代は一年だから、十年……それってどれくらいの長さかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャオマン",
      "text": "めんめんが両親と同じ大きさになるくらいかな……そこまで長いってわけでもなさそうね。新しい飼料に変えてから牧獣の成長も早くなって、毎日一回り大きくなってるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャオマン",
      "text": "でも十年か、忘花果の木の酸っぱい実が十回なるまで……そう考えると、すっごく長く感じるかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーシェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シャオマン",
      "text": "はぁ、もう少し見送るよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "笛の音はとどまり続け、夕日に伴って二人の後ろを流れていく。土の道に、四つの足跡が遠くまで続いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "江南。\nチョンユエ兄さんが言っていた。解任後は江南を訪れたいと。\n数百年江南の夏の菱の実を食べていなくて、砂漠も見慣れてしまった。橋架かり水流るる町で休んでいればいいわ。ただ二度と絵を破らないように気をつけてちょうだい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リィン姉さんは、いつまでもあの砂漠を忘れることができない。\n彼女は戦争が好きというわけではなく、ただ戦場の人々の勇敢で豪放なところが好きなだけ……嫌いな人なんていないわ？\n絵の中に大隊の戦火はなく、広い砂漠に一筋の烽火があがる、陽は川の彼方へと沈みゆく景色しかないわ。ここでお酒を飲んで、安心して詩人をやってなさい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニェンは賑やかな場所が好きだけど、龍門よりも味の好みは尚蜀の方が合ってるわね。\n大人しくここにいなさい。私にちょっかい出さないで。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ワン兄さんは……碁盤だけを描いてあげればよかったわね。\n考えてばかりで、センスもなさすぎ……この庭園を贈るから、この先二度と会いたくないわ。\n最後まで手を考えて、自分に少しの退路さえ残さないなんて、一体……ふっ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジエ姉さん……\nもし貴方が口うるさくなくて、いつもお姉ちゃんみたいな態度を取らなければ、本当に貴方から書道を学ぼうと思ってたのよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "……いいわ、こんなものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "これだけ苦労したところで、夢から覚めた時、この絵が残ってるか分かったもんじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "残ったからどうなの、残らなかったからどうなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "この人の世に来た、見た、千載の春秋も黄粱（こうりょう）の一夢に過ぎない。もう満足したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シー",
      "text": "……貴方たちがいるから、私も孤独じゃないわ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "画家は筆を投げ、姿を消した。\n空は白紙のごとく澄み、羽獣の列がかすめ通った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "丈は合っていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "生地はこの一枚だけですので、誤って破いてしまえば、新たに探しに行くことはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウァン",
      "text": "ちょうどいいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "ここに至って、こんな質問をするのは遅いかもしれませんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "……勝算はどの程度ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウァン",
      "text": "生死は、半目のうちに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "聞く限りだと、容易に元手をすべて失いそうですが……まあ退路もないですがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "決行はいつ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウァン",
      "text": "準備はすべて整った。あとは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "農民",
      "text": "シュウさん、ここの田んぼはもう何年も荒れてるんですが、本当にまだ作物が育つんですかい？　やり方が合っていれば育つと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュウ",
      "text": "もちろんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュウ",
      "text": "土地ごとに適した作物は異なるから、土の改良には、適切な方法を用いなければね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュウ",
      "text": "種はすでにまかれた。秋を待てば、結果が目に見えるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農民",
      "text": "シュウさん、あんたはどっから来たんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農民",
      "text": "とても若く見えるのに、田んぼについてこんなに詳しいなんて……天師府の天師とか言ってましたよね？　天師っつーのは何です？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュウ",
      "text": "知識の研究をしていて、より多くの人に教える人たちのことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農民",
      "text": "そいつはすげーや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農民",
      "text": "シュウさん、作業を続けていてください、俺は水を持ってきますんで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い子供の声",
      "text": "七月は葵を煮、九月は衣を授く。春日載ち陽かく、鳴く倉庚（そうこう）有り……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い子供の声",
      "text": "九月は場を圃に築き、十月は禾稼を納（い）る。黍稷重穋、禾麻菽麦……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "「七月は葵を煮、九月は衣を授く。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "大荒城の冬の訪れは早い、今年も早めに冬服の準備をしなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "姉さん、新しい服を作りましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュウ",
      "text": "要らないわ。着る機会もないわよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "新たな織り方を考えました。出来上がった緞子は軽くて丈夫で、色も美しいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "新しい服のイメージはできています。きっとよく似合います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュウ",
      "text": "はぁ、好きにしなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "姉さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "こういうのが、「人」の生活というものでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "なんだか……楽しいですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュウ",
      "text": "そうね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "あなたはもう、本当の意味で生きたわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "貴方から教わった行商の道理はすべて理解しました。ただ最後に、一つ分からないことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "世の万物は、幻のごとく曖昧としていますが、一体どのように値を見積もればよいでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "ははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "な、私の身にあるこの玉の飾りは、いくらだと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "その飾りは知っています。普通の品で、露店でせいぜい二両の銀で売られている程度です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "だがこれは私の母からもらった形見でな、物心ついた頃から身につけているんだ。私にとっては、計れない価値だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "見積もるというのは、結局、人の心を測っているのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "……覚えておきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "もうすぐで夏だな……江南のライチが美味い時期だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "北は乾燥しているから、栽培されるライチは甘くないんだ。故郷の味には及ばんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "本当は実家に戻って、また交易路でも開拓し、南のライチを北に売りに行こうと思っていた。だが川一つ隔てて、これじゃもう帰れなくなってしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "恨めしい雨です。なんとも時機が悪い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "あと数日待って夏に入り、貴方の体も暖まってきたら船を雇って川を渡りましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "いやいい……もう分かっている。私の道は、ここまでだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "人というのは、なぜいつも天に逆らおうとするんだろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "……君は、今年でいくつになった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "私たちのような者の年齢は数えるのが容易ではないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "どうしても数えろというと、小暑を過ぎたらちょうど五十でしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "君が普通の人間とは異なるのは見て分かる……そんな長い寿命は羨ましいな。でも考え直してみると、そんな長い一生なら、どれだけ骨が折れるだろうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "君が何であろうと、私は今年で八十三だ。君はこれだけ長く私についてきた。養子としても、お前に損はないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "貴方と出会い、この大地の果てしない風景を見られたことは、幸いでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "縁あって出会ったが、君に渡してやれるものはそんなにない。あの価値のない家財以外には、この言葉だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "天下熙熙として皆利の為に来る。天下攘攘として皆利の為に往く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "……この言葉は私が商売を学び始めたその日から、今まで口癖にしてきた。この言葉を頼りに、多くの敵や相手にも勝ってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "だがな、もしこの天下を「利」の一文字だけで表し尽くすのであれば、それはあまりにもつまらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "私の時間は多くないから、もういくらも歩けはしない。もしも、君に本当にそれほど長い寿命があるのなら、どうか私の代わりに見に行ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "この大地の隅々まで足を延ばし、この世に果たして天下の誰もが共に利を得られる「大利」があるのかどうか、その答えを、君が探し出してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "高齢の商人",
      "text": "もし本当に見つかるのであればな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "肝に銘じておきます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジー",
      "text": "必ず、見つけに行きます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
