{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_08_end",
  "groupId": "act17d0",
  "stageId": "act17d0_08",
  "title": "浸透作戦",
  "storyCode": "OD-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_08_end.txt",
  "sourceHash": "f78f491e6084a4447a4fc6c53114246c0520b050f9aa512d1d77a35d3744429d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "まだ動いています！"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "爆弾セット完了！　撤退するぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "あいつ……再生してないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "一体……どんな生き物なんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "どんな生き物だろうが、あんなもの世界に存在させてはいけない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#4",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "撤退するぞ！　起爆する前に逃げろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "こちらへ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "こっちは弾切れだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "レンジャー？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang#2",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "まだ生きとるぞ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "あんた、ちょっとヤバそうだぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "歳は取るもんじゃないのう……ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "その手はどうした。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "かわし切れなくてのう……大したことはない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "どうする？　避難所へ行くか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "坑道の方はどうなったじゃろうか。まだ知らせは届かんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "まだだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "ハハハッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "儂ら二人でここまで持ちこたえられるとは、思うてもみなかったわ……じゃがもうそろそろ限界じゃのう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "何をしておる？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "即席で盾を作ってみた。実は前から試してみたかったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "ハハハッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "昔に戻ったようじゃ……あの栄光の時代に、な。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "ある日、若いレンジャーたちが町の入り口に集結してのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "大軍が押し寄せつつあることも、間もなく荒野が皆の血で染まることもわかっておった。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "しかし彼らは共に笑い合い、軍歌を高らかに歌った。死を恐れる必要など無いかのごとく、迫っている敵など陳腐な虫けらに過ぎないかのごとく。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "戦争とは残酷で無慈悲じゃ。おじけづいた者もおったが、ほとんどの者が命を賭けて町を守り抜こうと決意したんじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "倒れた者は伝説となり、立っている者は彼らの伝説を刻み語る責任を負った。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "そして最後まで立っておった者は、やがて死を恐れ始めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "倒れていった人たちを忘れたくなかったからか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "ハハハッ……そうかもしれぬな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "アレクサンドル……おぬしと肩を並べて戦えて光栄じゃった。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "俺も光栄だったよ、レンジャー。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "だがそんなに悲観的になるな。俺はまだ諦めてない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1#2",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "弾なんてなくても、ぶん殴ってあいつらを殺してやるさ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "待て！　あれは……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "援軍じゃ！　ハハハハハハ！　助かったんじゃ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "このやり口は……あの若人じゃろうな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "救援信号を受けて、普通の救援任務だと思い駆けつけましたが――"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "まさかこんな所であなたにお目にかかるとは。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "レンジャー殿。"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "元の稼業にお戻りになったのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "ハハッ、歳には勝てぬわい。笑うてくれるな。"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "あなたの愛刀――あの曲刀は？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "もう重くてな。とっくに振り回せんわい。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "おぬしが来なければ、この老いぼれは、今日ここで骨になっておったわい。"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "ご謙遜を。"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "各小隊員に告ぐ！　目標は領主の屋敷にいる。"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "敵は危険な変異源石生物だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "位置の報告を怠るな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "気を付けるんじゃぞ、敵はかなりの数じゃ。隊の者が孤立せぬようにな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "それと、足元にも注意させい。あやつらは穴を掘る。"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "わかりました。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "あなたと肩を並べて戦えるとは……光栄です。"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "speakerToken": "avg_npc_167",
      "operatorId": null,
      "portraitKey": null,
      "text": "「血染めの谷の曲刀」殿。"
    },
    {
      "type": "sceneBreak"
    }
  ],
