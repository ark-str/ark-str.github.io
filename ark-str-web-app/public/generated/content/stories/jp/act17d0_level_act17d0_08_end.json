{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_08_end",
  "groupId": "act17d0",
  "stageId": "act17d0_08",
  "title": "浸透作戦",
  "storyCode": "OD-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_08_end.txt",
  "sourceHash": "f78f491e6084a4447a4fc6c53114246c0520b050f9aa512d1d77a35d3744429d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "まだ動いています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "爆弾セット完了！　撤退するぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あいつ……再生してないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "一体……どんな生き物なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "どんな生き物だろうが、あんなもの世界に存在させてはいけない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "撤退するぞ！　起爆する前に逃げろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "こちらへ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "こっちは弾切れだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "レンジャー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "まだ生きとるぞ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "あんた、ちょっとヤバそうだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "歳は取るもんじゃないのう……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "その手はどうした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "かわし切れなくてのう……大したことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "どうする？　避難所へ行くか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "坑道の方はどうなったじゃろうか。まだ知らせは届かんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "まだだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ハハハッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "儂ら二人でここまで持ちこたえられるとは、思うてもみなかったわ……じゃがもうそろそろ限界じゃのう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "何をしておる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "即席で盾を作ってみた。実は前から試してみたかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ハハハッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "昔に戻ったようじゃ……あの栄光の時代に、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ある日、若いレンジャーたちが町の入り口に集結してのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "大軍が押し寄せつつあることも、間もなく荒野が皆の血で染まることもわかっておった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "しかし彼らは共に笑い合い、軍歌を高らかに歌った。死を恐れる必要など無いかのごとく、迫っている敵など陳腐な虫けらに過ぎないかのごとく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "戦争とは残酷で無慈悲じゃ。おじけづいた者もおったが、ほとんどの者が命を賭けて町を守り抜こうと決意したんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "倒れた者は伝説となり、立っている者は彼らの伝説を刻み語る責任を負った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "そして最後まで立っておった者は、やがて死を恐れ始めた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "倒れていった人たちを忘れたくなかったからか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ハハハッ……そうかもしれぬな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "アレクサンドル……おぬしと肩を並べて戦えて光栄じゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺も光栄だったよ、レンジャー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "だがそんなに悲観的になるな。俺はまだ諦めてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "弾なんてなくても、ぶん殴ってあいつらを殺してやるさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "待て！　あれは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "援軍じゃ！　ハハハハハハ！　助かったんじゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "このやり口は……あの若人じゃろうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "救援信号を受けて、普通の救援任務だと思い駆けつけましたが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "まさかこんな所であなたにお目にかかるとは。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "レンジャー殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "元の稼業にお戻りになったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ハハッ、歳には勝てぬわい。笑うてくれるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "あなたの愛刀――あの曲刀は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "もう重くてな。とっくに振り回せんわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "おぬしが来なければ、この老いぼれは、今日ここで骨になっておったわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "ご謙遜を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "各小隊員に告ぐ！　目標は領主の屋敷にいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "敵は危険な変異源石生物だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "位置の報告を怠るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "気を付けるんじゃぞ、敵はかなりの数じゃ。隊の者が孤立せぬようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "それと、足元にも注意させい。あやつらは穴を掘る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "あなたと肩を並べて戦えるとは……光栄です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "「血染めの谷の曲刀」殿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
