{
  "server": "jp",
  "storyId": "story_chen2_set_2_story_1",
  "groupId": "story_chen2_set_2",
  "stageId": null,
  "title": "道",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_chen2_2_1.txt",
  "sourceHash": "1d9c433232353b1ca995a5d3c25697ff5812e9b0155c22a977582f2d6ec2608a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "許してくれチェン、もう二度とやらねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前の目と腰の後ろに回した手は、そうは言っていないがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "良い場所を見つけたじゃないか、待ち伏せには最適だな。面倒だ、全員で来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "へっ、さすがはチェンだな。お前ら、出てこい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "かかれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "待て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "誰だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "水臭いですね、チェン。ケンカするのにどうして私を呼んでくれないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "呼ばなきゃ来ないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "おっと、ロドスに行ってからますます口が達者になったんじゃないですか、チェン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "無駄口叩くな、半分ずつだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "チッ、こんだけ頭数揃えてもお前の相手にゃなんねぇのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "わざわざこっちから出させるように仕向けたり、待ち伏せしたり。私は一人だぞ、手間をかけすぎじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "お前は大勢の金儲けの邪魔をしたんだよ、チェン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "全くわからねぇな。お前とリンは、この都市で今、最も人気のある人間だ。市長の後ろ盾もある。お前らが望みさえすれば、金と地位なんて楽に手に入るだろうがよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "てめぇみたいなのはよ、おとなしく企業に金貰ってCM撮って、テレビに出てりゃいいじゃねぇか。なのに何でこんなことするんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "自分はいくらでも稼げるくせに、人の金儲けの邪魔しやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それはお前に関係のないことだ。おとなしく私と警察に来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "ハハッ、警察だと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "何年もお客様の入らなかったドッソレス警察署の牢獄の扉が、ようやく開かれるってか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "なぁチェン、知ってるか。俺の背後にいる人があいつらに一声かければ、お前がいなくなった後、俺たちはすぐに釈放されるかもしれねぇんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……そうだとしても、今回の教訓は刻んでおけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "覚えておくさ、お前がこんなにヤバい奴だってことは、忘れられるわけがねぇだろ？　クククッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もういいんじゃないですか。こいつら真っ当なこと言っても聞きゃしません。腕の一本でも折ってやった方がよっぽど効果的ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そんなことはしない。お前もするなよ、今はお前に命令できる立場ではないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それ、まだ続けるんですか。あなたが上司だったから従っていたと思われているのなら、困ってしまいますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "とはいえ、腕は折らないまでも、こいつの口を塞ぐくらいは構いませんよね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう言うと、ホシグマは犯罪者の口に縄を噛ませ、力を込めて締め上げた。"
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "うぐぐぐぐ──！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "好きにすればいいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "では、こいつらを警察署に連れて行きましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "こいつらの処理を頼む。容疑は器物損壊および私に対する暴行だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "諂いドッソレス警察官",
      "text": "何ですと？　チェン様を暴行？　そそ、それはけしからん！　お任せください、私がしっかりと懲らしめてやります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "犯罪者",
      "text": "うぐぐぐ！！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴマすりドッソレス警察官",
      "text": "目で取引を訴えても無駄だ。チェン様にちょっかいを出したんだ、お前の背後に誰がいようと無意味だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "彼らには相応の罰を与えればそれでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴマすりドッソレス警察官",
      "text": "はい、もちろんですとも、おっしゃる通りにいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ん？　あれは何の騒ぎだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "俺がやっとの思いで稼いだ金だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "なんでそんなこと言うんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "言ったから何だってんだ？　俺様は今日機嫌が悪い。牢屋にぶち込まれたくなけりゃ失せろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "こ、この野郎……くそっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "チェ、チェン様？　な、何でもありません。こいつが勝手に騒ぎ立てているだけですよ、へへっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "あんた、あのチェンさん！？　聞いてください、こいつら酷いんですよ。俺、金を貯めてなんとかこの街に来て、それで今回の大会にも死ぬ気で参加して、稼いだ金をカードに入れてたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "でもついさっき、道でその全財産を入れたカードを盗まれちまいまして、どうにか犯人を捕まえてもらおうと思って、急いでここに来たんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "なのに、ここの警察は、俺の預金額を聞いた途端、それっぽっちの金で通報するな、失せろって言いやがったんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "はい、あっ、いえ、私が言いたかったのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……どこか市内に配備されているドローンのカメラ映像を見られる場所はあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "え？　それは……署内にあります。ですが、もうずっと使われていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "案内してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ついて来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "あ、ありがとう、チェンさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "狭い部屋ですが、お許しください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "構わない。鍵をくれ、あとは私たちでやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "はっ、了解しました。では、何か御用があればいつでもお呼びください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ほう、ここの設備はなかなか整ってますね。うちの局内のものよりも進んでます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ただ全く使われていないのが一目でわかりますね。こんなに良い設備なのにもったいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "局の監視設備は改良されたか？　去る前に一度提案したんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いいえ。もうしばらくかかるでしょう、ただ許可は下りています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ならいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "どうです、操作できそうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "クルビアのシステムだな。読めはするが、認証が必要か……チッ、パスをさっきの奴に置いていってもらえばよかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "一応試してみるか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう言うとチェンは自分の携帯を認証端末に近づけた。 アクセス許可を示す通知音が鳴り響いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なるほど、どうやら確かに彼らは、私に対してすべての権限を付与しているようだ。ハァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いいことじゃないですか。いっそここに再就職したらどうです？　ここの人は全員、あなたの言うことを聞いてくれますし、龍門より思い通りに仕事できるんじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前な……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "あの、お二人さん。何言ってるのかわからないんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ああ、私たちは龍門の者同士なので、ついつい故郷の言葉で話してしまうんですよ、気にしないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "は、はぁ……なるほど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "君は随分と落ち着いたようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "チェンさんが助けてくれるっていうなら安心ですから。あなたがここの警察とは違うっていうのは、街のみんなが知ってることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "あなたが骨を折ってくれるのなら、たとえ最後に泥棒が捕まらなくても諦めがつきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "安心してください。私とチェンはこうした案件を、数えるのも面倒なくらいに扱ってきましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "カードはいつどこで盗まれたんだ？　具体的に教えてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "大体、午前十一時くらいに、ノックス歩行者用道路の中央だな……大きなバーの前辺りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そのバーはリン・ユーシャの……なぁ君、すまないが私が探す間、外で待っててくれ。ここのものはあまり君に見せられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "安心してくれ、君が提供してくれた手がかりは十分具体的だ。監視カメラに映ってなくても、恐らく目撃者がいるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "わかりました。どうかお願いしますね、チェンさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しばし拝むようにした大会参加選手は、すぐに監視室を出た。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ヒュー、さすがはチェン。どこへ行っても信頼されますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "これは本来ここの警察がやるべきことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "彼らにお手本を見せてやるのも悪くないんじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それも彼らが学びたければの話だがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハッ、確かに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ちょっと手伝ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "再生時間を十時から十二時に設定した。私はこっちの二つを見る、お前はそっちの二つだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "しかし、チェン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "何だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "話すべきかどうか迷うことが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そう言ってお前が話さなかったことなどないだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハッ。じゃあ話しますが、さっき無能な連中と会話してた時のあなた、貫禄がありましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "以前は局の奴らを叱り飛ばしていたから、ついやってしまったな。お前の忠告通りだ、これを直さないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "違いますよ、私が言いたいのはそういうことじゃありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あなたが局でしていた説教は、筋道が通っていて、指摘していたことも間違っていなかった。それはあなたが、局員のことをよく知っていたからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そしてここの人たちについても、あなたはよくわかってる。なのにまるで、彼らを変えることはできないと諦めているみたいだ。だから表面的なことしか指示してない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "以前のチェン隊長は、こうではありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ああ、勘違いしないでください。私は、これは良いことだと思ってるんですよ。とても良いことですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ひねくれた奴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それは心外だ。おっと、さっきの奴、いましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "時間は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "十時三十五分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "よし、見てみる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……いた。こいつをロックして行動を追おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "OK。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……仲間と合流しました。付近の組織のメンバーみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あら、最近巷で大人気のヒーロー、チェン様じゃないの、私に何か用かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "今、時間あるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あるとも言えないし、ないとも言えないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "人探しを手伝ってほしい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "チェンとホシグマ、そして大会参加選手は、 リン・ユーシャと言い合わせた場所に到着した。\nリン・ユーシャは退屈そうに、手中のカードをもてあそんでいる。彼女の足元には、縛りつけられた泥棒が一人、気を失ったまま横たわっていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "はいコレ、あなたのカードよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "そう！　そう！　間違いない、このカードだ。本当にありがとう、リンさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "借りができたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "別にいいわ。ついでだったもの。それに貸しがあっても、あなたを使うような用事なんてないし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ちょっとネズ公。どこほっつき歩いてるのよ！　アタシがたった三着試着するのも待てないわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "おばあさんが横断歩道を渡るのが見えて、大変そうだから手伝ってあげてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "馬鹿にしてるの？　ここモールの五階なんだけど！　いつからそんなに視力がついたのかしら。しかも下は歩行者専用道路よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "五分以内に来て、でなきゃアンタ許さないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "はぁ……わかったわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "ふぅ……それとも、私の代わりにスワイヤーの荷物持ちする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "遠慮しとこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "こいつの処理は任せたわ、じゃあね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "いやはや、何度見ても信じられませんね。まさかチェンさんとリンお嬢さんが仲良くなるだなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "これで仲良くなったと言えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もちろんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "まあいいさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "カードはしっかりと持っておけ、もう失くすなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "絶対に離しません！　俺のためにここまでしてくれるなんて、お二人とリンさんには何てお礼を言えばいいか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "市民の安全と利益を守るのが警察の仕事だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "二人とも警察官なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……私は以前。彼女は今もだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "そうだったんですね。この都市の警察がみんな、あなたのようになればいいのにな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "警察でなくても、一人の人間として、困ってる人を助けるのは当然だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "俺も以前はそう思っていました。けどこの都市に来てから、そうでもないような気がしてきたんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "君は地元民ではないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "俺も含め、ここにいる出稼ぎ労働者のほとんどが地元民じゃありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "俺の家は元々、シンガス政府管轄下の村にあったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "一度シンガスとトゥルーボリバリアンが衝突して、うちの村は滅ぼされました。死人もたくさん出て……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "俺は運良く山で猟をしていて難を逃れたんです。獲物を担いで山を降りたとき、村の変わり果てた様子を見てすぐに逃げ出しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "俺、本当は兵士になりたかったんです。けど軍に断られたんで、仕方なく、ここなら金を稼げると聞いてやって来たんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "申し訳ない。つらい過去に触れてしまったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "……つらい過去とは言っていいのか、正直言って自分で思い返してみても、あれは夢だったんじゃないかって思うんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どういうことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "俺は今年で三十五です。村では二十年以上暮らして、ここに来てからはまだ十年も経ってないんですが、時々思うんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "むかしの生活の方が、まるで嘘だったみたいだってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "以前は俺も他人を助けることは正しいと思っていたました。けどもう随分そんな言葉を聞いていない気がしますし、俺自身も考えたこともありませんでした。さっき、あなたの口から聞くまでは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "もしあのとき警察署で、俺が助けを求める立場じゃなくて、あなたのようにそばで見ている人だとしたら、正直俺はきっとそいつを助けはしなかったでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "ほんとは、あいつらが俺を助けてくれるなんて、はなから思っちゃいなかったんです。でも腹が立って仕方がなくて駆け込んで、それでまさかあなたみたいな人に会うなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "この街では、金さえあれば何でもできますけど、逆に言えば金がないなら、なにも望んじゃいけないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "人生変えたいなら、ギャンブルに走ったり、犯罪組織に入ったり、他人から金を奪う必要があって、一生懸命働くことしか稼ぐ方法を知らない奴は、みんなからバカにされるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "大会に参加するのも人生を変えるためか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "もちろんそうです。俺は臆病なので、ギャンブルをする勇気も、奪う度胸もない。俺のような人間からしたら、大会に参加することが一番堅実に大金を稼ぐ方法なんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "俺たちみたいに勝てる見込みの薄い奴は、予選を通過できれば儲けものです。もし最初のラウンドで勝てれば、多少有名になってもっと稼げるかもしれないですしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "そうだ。俺は普段レストランで働いてるんですよ。オーナーには話を通しておくので、お二人とリンさんにごちそうさせてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "チェン、どうします。いっそのことお嬢様も呼びますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "よし、早速店に行ってオーナーを探してきます。チェンさんとリンさんが来るって知ったら、きっと喜ぶぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大会参加選手",
      "text": "ではまた後で！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "どうしました？　早く泥棒を連行して──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ホシグマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……頼みがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "おっと、明日は雪でも降りそうだ。先に言っておきますが、お金ならありませんよ。お嬢様に借りに行くことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハハッ、冗談はこれくらいにして、なんですか、言ってください。長い付き合いですが、あなたの口からそんな言葉を聞いたのは初めてですからね。どんな頼みだろうと引き受けます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "ったく、何が「チェン様」だよ……市長の後ろ盾に頼って偉そうにしてるだけじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "俺だって市長の後ろ盾がありゃ、何でもできるっつーの、チッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "コホン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "あっ！　あの、えっと、お帰りなさいませ、チェン様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "へへ……あの、後ろのそいつが泥棒ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうだ、任せた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "わかりました。チェン様に迷惑をかけた奴は、この私が懲らしめてやりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "まだ何かありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "先ほどカンデラさんと話したんだが……ええと、つまりだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "チェンさんが言いたいことはこうです。目立つ行動をし過ぎたのを彼女自身も理解しています。そしてカンデラさんの前であなたたち警察署員のメンツを潰してしまったことも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "だから先ほど彼女はわざわざカンデラさんを訪ねて、ここの警察署の業績に対するボーナスを上げてほしいと頼んだんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "カンデラさんはチェンさんに免じて、特例で資金を用意してくれるそうです。署員が成果を出しさえすれば、ボーナスをもらえます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "チェンさんはさらに講義を開き指導をしてくれるそうです。彼女が警官時代に培った捜査のノウハウを伝授し、カンデラさんがご用意したボーナスを皆さんがもらえるよう協力するそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "……ボーナスとは、どの程度でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "一つの案件につき、これだけです。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ホシグマが指で数字を示した。"
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "……チェ、チェン様、あなたは本当に素晴らしい方です！　すぐにほかの者に伝えて参ります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……大したことじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "あと、この泥棒も君の手柄にしていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "なまけ者ドッソレス警察官",
      "text": "ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "後味が悪いんじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "良いとは言えないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ですが、「ここの警察にやる気を出させる方法を教えてほしい」というあなたの頼みに対して、私の思いつく最も簡単で直接的な答えがこれですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だがこれは……間違っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ええ、間違っていますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ですが、この方法を選んだ理由もたしかにあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "まず、あなたはここに来たばかりです。どんなに魅力的な人格者であろうと、すぐに人を心から服従させるのは難しい。こういう場合は、利益をチラつかせて従わせるのが最も簡単な方法です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "あなたが局に入ったばかりの頃、あのひねくれ者たちを従えるのにどれだけ大変だったか覚えてますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……私の記憶が正しければ、力で奴ら一人一人の膝を折らせていったんだよな。お前が最後の一人だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "私は膝をついてませんけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "次に、利用できるものを持ってるのに、それを使わず自分の力だけに頼るというのは、傲慢だと思われがちです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それが金や権力、地位などの場合は特にです。だったらむしろ使ってしまった方がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "過去の私もそのような印象を与えていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "今はそのように思う者は龍門にいません。それはあなたの長年の努力によるものです。しかしここは龍門ではないし、ここに長く留まるつもりもない……だったらどうやって自分を証明するんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それから、先ほど彼が口にした不満ははっきり聞こえましたね？　こんな状況になった原因が本当に、彼らが怠惰であることを望んでいるからだと思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "彼らは生まれついてのロクデナシでしょうか？　組織や企業と結託することは正しいと思っているのでしょうか？　電話一つで罪人を釈放して楽しいのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ここはまだ警察署と呼ばれているし、彼らも自分たちが警察官だとわかっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "彼らは職務放棄をしたいのではない。それしかできないんですよ。職務をまっとうする勇気がないんです。元々は彼らにも勇気があったはずですが、それは現実に押しつぶされてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そうなっては最早、どんな道理も彼らにとっては意味がない。だから周りに合わせるだけ。それがここの現状です。あなたはこんなことは間違っていると、言うべきでもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ですがあなたはそうはしなかった、これが事実です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "わかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そうですね。ですがまだ理解が足りていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "かつてなら、私はあなたが無意味な場所で命を落とすのではないかと恐れたでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "でも今、あなたは龍門を離れてだいぶ変わりました。少なくとも私の目には良い変化に見えます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "同時に今度は、あなたが自分を見失うんじゃないかという恐れを感じています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……わかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "少ししゃべり過ぎました。私がどう恐れようと、これはあなた自身の決断ですから、私は干渉しません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "もう私の前に立ちはだかったりはしないんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "おや、根に持ってたんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それに関しては何とも言えませんね。わかるでしょう、私は誓いを抱えて死ぬような人間ではありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "フッ、お前が誓いに殉じないとは、出来のいい冗談だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ホシグマ、お前にどう答えていいか私はまだわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "先ほどの出来事を、そしてこの地をどのように評価すればいいか、いまだ私にはわからないのと同様にな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私はひとまず歩み続けるしかないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "充分です、チェン。それで充分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "言い方はきつかったかもしれません……でも忘れないでください。あなたの周りにはたくさんの人がいます。わからなければ、彼らに教わればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それでいいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もちろん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "じゃああいつらに開いてやる講義だが、講師はお前がやってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はあ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "現役の警察官はお前だ、私じゃない。それに今、そばにいる人に教われと言っただろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "今回、私は生徒だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……はぁ、そう言われてしまうと、拒否できませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "そうだ、お嬢様も呼びましょう。私一人でこんな災難を背負うのは嫌ですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "好きにすればいい。何ならリン・ユーシャも呼んで構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ハァ……せっかくの休暇が台無しだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……ホシグマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "正直、この都市の太陽は眩しすぎるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "眩しいですね、私もそう思います。でも、少なくともあれは太陽ですよ、チェン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "かもな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
