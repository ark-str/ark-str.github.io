  "sourceHash": "379c7fab26d014527d901d3f08dc2400b642ca7dbb55aac4020be401c3c5b598",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "中秋 史尔特尔"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "a.m.7:10  天気/晴天\nカズデル郊外"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "目的地はここなのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ええ、移動村落ベルーニは地図の通りならこの辺のはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "移動村落っていうより、村がまるごと大きなトロッコみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "源石を使った採掘で自給自足して、余った資源を近隣の都市に売って収益を得ている村ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "大きな遺跡が見つかれば、周辺の大きな移動都市に採掘の支援金を求めることもできるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "それにしても、この村は荒れすぎだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "砂ぼこりはひどいし、フェンスもボロボロ。人通りはあっても、誰も修理する気はないようだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "見た感じ、面白い場所じゃなさそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "テラには面白い場所なんてほとんどないけど、それでもここに暮らす住人たちにはそれぞれ生活があるのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せっぽちの子",
      "text": "待って、返してよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "いたずらっ子",
      "text": "なんだよ！　このアイス、みんなで分けるって言っただろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せっぽちの子",
      "text": "ねえ待ってってば！　そんな風に握ってたら家につく前に溶けちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せっぽちの子",
      "text": "このバカ！　返して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "いたずらっ子",
      "text": "やだね。俺のがお前より足も速いからな、父ちゃんに持ってってやるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せっぽちの子",
      "text": "待ってよ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ひどい環境を必死で生き抜いている人たちは少なくないわ。それに彼らがみんな不幸だとも限らないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "アイス一つで周りの迷惑も考えずに騒ぐなんて、くだらない。きっとあのまま大人になるんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "それのどこが幸せなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……もしかして、怒ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "子供が埃をたてまくったぐらいでは怒らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（怒ってるじゃない）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "いやぁ、すまんです。お二人がロドスから派遣されたオペレーターの方ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "お待たせしましたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "初めまして。あなたがアテンドの方かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "ええ、わしはベルーニ村の村長です。ご案内しますんで、さあ、どうぞどうぞ、こちらへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "お手数おかけします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "任務出発前\nロドス指揮室"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "カズデルの辺境にあるベルーニ村は典型的な鉱山村だ。数ヶ月前に落盤事故があったため、採掘場は完全に封鎖されている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "落盤事故で採掘場が崩壊しただけでなく、村内の道路も交易ルートも遮断されてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "村はこの数ヶ月間、近隣の移動都市に助けを求め続けているが、手を差し伸べる都市は未だに現れていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "今回メテオリーテには現場へ行って予備調査を行い、現地の状況を確認してもらいたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君が持ち帰ったデータをもとに救助計画を展開する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "了解。そう難しい任務ではなさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "村の問題は天災や鉱石病とは関係なさそうだが、油断は禁物だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "了解。でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "スルトも一緒なの？　それほど難しい任務じゃないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "今回の任務地で確認したいことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "スルトからは個人的な事情で同行の申請があった。こちらで審査した上で許可している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "迷惑はかけない。私のことは気にしなくていいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "小せえ村です、ここで少しお待ちいただけますか。道具を取ってきますんで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あ、基本的な探査ツールなら持ってきていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "いやぁ、村外れにある鉱山の入口は、今は特殊な装置で封鎖してあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "だもんで開錠用の特殊な道具じゃねえと開かないんです。自慢じゃねえが、うちの村は採掘経験が豊富でしてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "だが閉じ込められたんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "わはは、そうですな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あぁっ、すみません。悪気はないんです。ちょっとあなた！　失礼でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "情けねえ、採掘経験は豊富でも、こんな大規模な落盤事故を予想できなかったのも事実ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "掘削場所も落盤で埋もれてしまいまして、安全のため立ち入り禁止にしとるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "今回はロドスに助けてもらえたとしても、今後は自分たちで策を練らねばな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "しばしおくつろぎくだせぇ、ちょっくら準備してきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ええ、分かりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "だからね、他人に対する遠慮がなさすぎるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "事実を言ったまでだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（ああ、気まずい）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（スルトは付き合いにくい人だとは聞いてたけど、ここまで話が続かないなんて）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……（メモを取る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "村の状況を記録しているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "別に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "じゃあ、何を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……知らないのか？　私の資料は、みんな見てるものだと思っていたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "見るには見たけど……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "資料にはこう記されていた。\nスルト、原因不明の記憶障害から起こる認知障害を持つ少女。\n彼女の脳内には膨大な記憶が同時に存在しているため、虚実を見極めることがまったくできないようだ。\nゆえに、この少女は記憶にある場所を一つ一つ探し続けている。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "じゃあケルシー先生が言ってた個人的な事情って、この村の付近にあなたの記憶に近い場所があるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "ケルシー先生がこの近辺の情報を教えてくれたとき、既視感を感じたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "写真や記録の中にも見たことのある景色がたくさんあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "それで、実際に村を見て何か思い出した？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "いいや。村を歩いても、通りすがりの子供やボロ屋を見ても、記憶の中にあるものに近いようでまったく違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "なぜかは自分でも分からない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "村の隅々まで調べたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "ザッと見ただけだが、見落とした場所はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "村人たちに訊いてみたらいいんじゃない？　記憶にあるのは何年も前の村で、いろいろと変わっているかもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……そうかもしれない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "確かに、この辺りに漂う乾燥した植物の匂いは記憶と同じだ。\n目をつぶると、懐かしい通りにいるような感じがする。\n走り回っている子供たちの足音を聞いていると、友達とやった追いかけっこを思い出す。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "でも目を開けると、やっぱり見知らぬ景色なんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "せっかくケルシー先生がこの任務を私に託してくれたんだもの、私も手伝うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "落盤事故の調査が終わったら、村で手がかりを探しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "必要ない、自分でできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……過去が分からない、家が見つからないって感覚は、私にも分かるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "サルカズの名誉や居場所を守るために、たくさんの仲間たちとずっと頑張ってきたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "私とは事情が違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "違うかもしれないし、同じかもしれないわよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "お互いに、心の奥ではただ帰る場所を求めているだけなのかもしれないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "とにかく、先のことが見えないまま何かを探しているときは、周りにも気を配らないといけないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "アーミヤが教えてくれたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "いやぁ、お待たせしました。では行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "こちらは準備万端です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "とにかく、まずは任務を完了しましょ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ここは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "ええ、ここが落盤の現場です。足元に気をつけてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "ここに掘削口がありましたが、落盤で周辺が陥没して、今はここら一帯が全部塞がっとります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "この採掘口は隣村に通じてましてな、塞がってからは物資の交換もできなくなってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "スルト？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "この道、見覚えがあるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "村長、隣村との関係性は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "隣りもうちの村と似たような採掘村でさあ。近隣の村はどこも同じ産業を生業にしていて、よく行き来しとったんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "交流はもちろん、引っ越すことだってよくあったんですがねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "でも、この落盤でうちの村との道が塞がれてしまったもんだから、隣村もしばらくは自分たちでやりくりせねばならんでしょうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "この道筋、この方向。\nますます見覚えがある。\n昔、確かにここをよく通っていた。\n一瞬、よく知っている子たちが脇を走り抜け、目の前を塞ぐ岩の中に消えていくような感じがした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "隣村へ行かれたいですかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "道路が開通しさえすれば、すぐ連絡がつきますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "よかったわね……スルト？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "待っていられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "は？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "どいて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "スルト、待って！　早く記憶をはっきりさせたいのは分かるけど、今はダメよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "先へ進むのは危険すぎるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "メテオリーテは外で待っていろ。入口を見張っててくれればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "うわぁ！　崩れた採掘口をぶち抜いて進んだぞ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ちょっと待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "ダメだ！　お嬢さんまで入っちゃあ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "中でまた落盤が起きるかもしれねえんですぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "もう！　スルト！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "鉱坑の奥へ入ると、機械採掘の痕跡がはっきり見て取れた。\n道はうねうねと先へ続き、まるでスルトを奥へ奥へ誘い込んでいるようだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "……これが隣村への道か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "すっかりオリジムシの巣穴になってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "採掘でできた空洞は、この数ヶ月で完全にオリジムシに占領されてしまったようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "面倒だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "子供たちが手をつないで、目の前の道を横切った。\nそして、無数のオリジムシの痕跡を迂回し、\n闇の向こうへと消えていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "この爆発音は！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "また落盤か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "あのお嬢さんが危ねえ！　どうすればいいんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "記憶の中の道は、乾燥した植物の匂いではなく、土の匂いに満ちていた。\n記憶の中の仲間は、アイスを持って追いかけっこなどしない。\n家屋は似ているけれど同じではない。\n見た目が微妙に違うだけじゃなく、材質や構造もまったく違う。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "チッ、怪我するなんて。痛いな、掌を擦りむいたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "まさか私がうっかりオリジムシに襲われる日がくるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "坑道の真下に、別の大きな空洞が？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カサカサ。オリジムシの音だ。\nカサカサ。\nカサカサ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "しかも空洞の中に、都市遺跡……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "スルトはさらに空洞の深層へと下った。\nオリジムシが光を放つ中、岩に埋もれた建物の輪郭がぼんやりと見える。\n路上の縁石や、壁の煉瓦。\nどう見てもすべてが長い長い時の中に埋もれていたようだ。\n何十年？　何百年？\nそれはスルトにも分からない。だが彼女にとって確かなのは、探しものをやっと見つけられたということだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ここよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "スルト！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "ああ。大声で場所を教えてくれたから、あとはそこ目掛けて岩を砕くだけだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ちょっと！　どうして一人で危ない場所に入っていくのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "中を調査しに行っただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "ついでに落盤の原因も突き止めた。鉱坑の真下にオリジムシの巣穴があって、その奥が巨大な空洞になっていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "そこを掘削したせいで地盤を支えられなくなって崩落したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "だけどオリジムシの巣穴は全部壊滅させて、さらに落盤を利用して空洞はもう塞いだ。これで大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "基本的な探査はすっ飛ばしたけど、問題は一応解決した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "つまり、問題はうまく解決したけど、隣村への道は見つからなかった……そういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "ああ。しかも途中で気づいたんだ。ここも、隣村も、違うって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "どうやら私の勘違いだったみたいだ。ここには私の探していた思い出はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あんなに細かく記録していても、間違うことはあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "たぶん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……私も同じ経験がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あと少しで人生の目標を掴めるかと思ったら、そういう時に限ってヘマばっかりで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "だけど周りの人たちのおかげで、今まで何とか頑張ってこれたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "そんなの私にとってはいつものことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "記憶違いもこれが初めてじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……そう。何はともあれ、今回の任務で探しものは見つからなかったけど、帰る家がなくなったわけじゃないし、あなたの周りには私たちがいる。そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "それは、あんたを頼っていいってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "えーっと、まぁ別に違うとは言わないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "どうもお待たせしました！　村の者に知らせましたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "正式な探査隊がすでに準備をしています。本当にそちらのお嬢さんの言う通りなら、すぐにでも坑道の復旧作業に取りかかれます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "探査を始めるのは、私たちが現時点のデータをロドスに持ち帰ってからにしてくださいね、くれぐれも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "また事故が起きると大変ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "はは、わかりました。みんな大喜びですよ。お嬢さん方には本当に感謝しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "よろしければ、今日は村に泊まってってくだされ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "是非おもてなしさせてくだせえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "えーっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "急いで帰る必要があるから、遠慮しておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スルト",
      "text": "その代わりに、アイスをもらっていいか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
