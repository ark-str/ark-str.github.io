{
  "server": "jp",
  "storyId": "act19mini_level_act19mini_st02",
  "groupId": "act19mini",
  "stageId": null,
  "title": "蒲先生",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act19mini/level_act19mini_st02.txt",
  "sourceHash": "10e68f80d5380ce92136a232e0896d139bab549ebacf765586a73680b53afac4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "先生、先生！　大変です！"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "フーが……フーが――死にました！"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "なっ――"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "なんと……それはいつの話です……なぜそんなことに……"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "フーがいつもいる茶館で、二階から落ちて死んじゃったんです！"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "きっと……きっとあの嫌な女が殺したんです！"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "また俺たちを狙って、ここに戻ってきますよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "はぁ……私は普段、あなたたちにどう教えていますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "見てもいないことを軽々に口にすべきではありません。その目で見ていないのなら、みだりに結論を出してはいけません。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "ですが先生は、一を聞いて十を知れとも仰っていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "あの女は最近何人も殺しています。だったらフーだって奴に殺されたに違いありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "一を聞いて十を知るとは、道理の話で、物事の話ではありません。ましてや人のことなどもってのほかです。"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "誰かに悪意を向けられることが嫌だと思うのであれば、他者も同じように感じるだろうといことに思い至るべきです。これを道理と言います。"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "ですが誰かが一度過ちを犯したからと言って、その人が生涯過ちだけを犯すと決めつけてしまうのは、理不尽と言います。"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "まあよいでしょう、二言三言で説明できる道理ではありません。今はそれよりも重要なことがあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "フーが茶館で転落して亡くなったのならば、彼の遺体を回収した者はいなかったのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "それは俺がこの目で見ました！"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "フーが落ちた後、天師の格好をした人が、バラバラになったフーを回収していきました。"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "天師まで足を突っ込んできたと……？"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "冗談で済むことではありませんよ。確かなのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "この目でしっかり見ましたとも。フーが転落死した時、その天師もその場にいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "それから、その人がフーの死体を持って、町中で色々聞き回っていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "まずいことになりましたね……見られてしまった以上、面倒事は避けられぬやもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "ですがいずれにせよ、フーの遺体はまだその天師の手にあります。何とかして……何とかして取り戻さなくては。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "先生、それは俺たちに天師からフーの死体を盗み出せって言ってますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "何度も言ったでしょう。亡くなった同胞のことは、「遺体」と呼ぶべきです。死体と呼んではいけません……"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "そして、「盗む」ではなく、「窃む」です。以前に説明したでしょう、私欲のためにするのが「盗み」であり――"
    },
    {
      "type": "dialogue",
      "speakerName": "私塾の先生",
      "speakerId": null,
      "text": "いや、やめましょう。今は時間がありません。あの天師がいつ来てもおかしくありませんから。以前教えた通り、各自準備に入りなさい……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "こんにちは……あなたが「蒲（プー）先生」ですか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・チンイェンはこの小さな学び舎に入ってから、一言も発さずに、室内の品々を一つ一つじっくりと眺めていた。\n一本の香が燃え尽きるほどの時が経った頃、彼女の向かいに座っていた老人が、ついに耐えかねて口を開いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "すみませんが……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "自己紹介させていただきます。私はリン・チンイェン、大理……いえ、天師府の天師です。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "あなた様のお姿から承知しています。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "プー先生は日頃から天師との付き合いがあるのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "この町は天師府の近くにあります。天師の皆様には日頃から色々と助けられておりますから、分かるのは当然です。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "それでリン天師……本日は一体どのようなご用件で？"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "冗談だと思われてしまうかもしれませんが、私は今日初めてこの邙山町を訪れ、ある奇怪な事件に出くわしました。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "町の南の茶館に、フー・ジュンという名の給仕がおりまして、彼は未の三つ時に、茶館で四名の客に毒を盛り、縛り上げました。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "私はちょうどその現場に居合わせたため、取り押さえようと動きましたが、うまく逃げられてしまい彼が二階から落ちる様を目撃しました。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "しかし転落の現場に駆けつけた時、そこにあったのは砕けた茶壺でした。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "最初は目の錯覚かと疑いました。ですがその当時現場にいた者で、それを見たのは私一人だけではなかったのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "つまり、二階から落ちて亡くなった者が、砕けた茶壺に化けたと言うわけですか？　前代未聞の珍事ですな……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "その……リン天師、話に出てきた砕けた茶壺を、一目見せていただくことはできますかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・チンイェンは服のかくしに手を差し入れると、小ぶりな包みを取り出して卓上に置いた。\nプーがそれに手を伸ばす。指先が触れようかという瞬間、リン・チンイェンはそれを咎めるように包みに手を置いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "お待ちください、先生にいくつか尋ねたいことがあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "それは……いえ、どうぞ遠慮なく。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "今日、町で故人について聞き込みをしたところ、多くの方がフー・ジュンという人物を知っていると言い、中には彼がプー先生の知人だと話す者も少なくありませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "ところで私は長年ずっと百灶に在住していたのに、百灶からほど近い邙山の麓にこのような町があると知りませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "この邙山町には官府がなく、お上の派遣する官吏はいないため、住民たちは何かあれば、こちらの「置錐（ちすい）学塾」に頼っているとか。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "先生はこの町でも、かなり名望がおありのようですね？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "いえいえ……とんでもない……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "天師の疑問にお答えしましょう……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "実を申しますと、この町も昔はそれなりに賑わっていました。しかし、百灶の拡大が徐々に進んだことで、若者たちはこぞって都市へ働きに行ってしまい、町に住む者も少なくなっていきました。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "今は町と言いましても五百余りの家があるばかりの小さな集落ですよ。それに天師府が近くにありますから、滅多なことが起きる心配もなく、朝廷も放置して問題ないと考えているのでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "そして私ですが、少し学んだだけの貧しい書生に過ぎません。官吏登用の試験に受かる学もないので、この町で子供たちに読み書きを教えることで口に糊をしております。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "何年もそうして過ごしてきました。町の人々が私を先生と呼び、何かあれば私に意見を尋ねに来てくれるというだけで、分不相応なことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "ご謙遜を。人を教え育てることは非常に徳のある行いですから、敬われてしかるべきでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "しかしそれにしても、この部屋に置かれている蔵書や書画、古美術品の数々は、どう見ても尋常の品ではありませんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "これは……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "きっと誤解されているのでしょう。これらは日頃から親しくさせていただいている天師から贈られたもので、方々から集めたガラクタです。少し古いだけで、さして値打ちのある品ではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "そうですか……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "はい。それと、天師のお話にあったフー・ジュンという者ですが……ゴホン――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "――！"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "あぶない！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "どういうわけか、卓上の燭台が急に倒れ、液状になった熱い蝋がリン・チンイェンの手にかかりそうになる。\n彼女が慌てて立ち上がると、何故か背後の椅子もひっくり返り、危うくそれに足をとられそうになる。\nそうして彼女がほんの少し目を離した隙に、プーは素早い動きで卓上の包みを別のものとすり替えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "これは一体……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "天師……お怪我はありませんか……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "この部屋の調度品はどれも古いものばかりで、ガタがきているものですから、何卒ご容赦を……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "……問題はありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "先ほどは、どこまで話しましたか。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "フー・ジュンのことをお伝えしようとしたところでした。確かに彼は私の友人です。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "彼は町の古い茶館で給仕を務めていまして、茶を淹れる腕には見るべきところがあり、普段は茶や酒を共に嗜む仲間でした。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "彼に恨みを抱く者などはいましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "それは分かりかねますな……私から見ればフー・ジュンは真面目な男でしたが……しかし人同士の付き合いというのは、どこで何があるか分かりませんからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "皿と碗がぶつかるのを避けられぬように、時に意図せず厳しい言葉をかけてしまったり、借りた金を返しそびれることもあるでしょう……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "この世に生きていれば、「仇」の一人や二人はできてしまうものです。こればかりは、何とも言えませんな……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "私に話す気はないということでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "いえ、まさかそのような……私に分かることなど、それしか――"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "結構です。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "教師という尊敬すべき職につくあなたに、私も不義を働かせたくはありません。どうか発言される前によくお考えください。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "先生が話されるおつもりになった時に、また会うことになりましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "今夜はすでに長くお邪魔しておりますので、これにて失礼いたします。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "先生、先生、例の天師は帰ったんですか？　俺たちは見逃してもらえたんでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "うむ……"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "それで、フーさんの遺体は回収したんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "言われたプーは机の下から包みをゆっくりと取り出すと、慎重に開いた。\nだが、予想に反して包みの中身は茶壺の破片などではなく、石ころだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "あのリン天師という方は、聡明で、筋も通った方だ……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "まあいい……もう一度出向かねばならぬな。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "あなたたちには留守番をしていてください。すぐに戻ります。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる生徒",
      "speakerId": null,
      "text": "先生、先生――俺たちが手伝いましょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "……いいでしょう。ついてきてください。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "とっぷりと日の暮れた夜更け、静まり返った無人の通りを、リン・チンイェンは歩いていた。もし誰かがこの場にいたら、奇妙な光景を目にしていたことだろう。\n天師から十歩ほど離れた後ろ、道端の壁になぜか立てかけられている箒が、彼女が歩くたび、常に一定の距離を保ってついて行くのだから。\nなぜ通りに家庭用の箒があるのかという疑問は、ひとまず棚上げしよう。なにせ屋根の上には箒の後を追う刺繡入りの靴が一足あり、壁に貼られた掛け軸まで靴の後ろに続いていたからだ。\n奇妙な行列はそれだけでは終わらず、掛け軸の後には跳ね回る天秤棒に転がる薬瓶、ポコポコと鳴るでんでん太鼓……その長い列の最後にいたのは、他ならぬプーその人だった。\n行列はある客桟（きゃくさん）の前で止まった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "箒",
      "speakerId": null,
      "text": "プー先生、天師を見失いました……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "この客桟に入ったのではないのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "天秤棒",
      "speakerId": null,
      "text": "そこまでは確かなんですが、客桟に入った途端に姿が見えなくなったんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "ふむ……"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦",
      "speakerId": null,
      "text": "先生、先生――"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "天師が見つかったのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦",
      "speakerId": null,
      "text": "いえ、違います！"
    },
    {
      "type": "dialogue",
      "speakerName": "瓦",
      "speakerId": null,
      "text": "あの嫌な女が、追ってきてるんです！"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "えっ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "見つけた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "あっと……腰が……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "やはりあなたでしたか……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "はぁ、あなただと思いたくはありませんでしたが……余人であるはずもありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "無駄なお喋りは結構。知りたいことは一つだけだ。なぜ、私を騙した？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "騙す？　私がいつあなたを騙したと……"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "あの秘伝書は偽物で、我々が手を出す必要はないと言っていただろう。だが今日の茶館での取引に例の茶壺が関わり、秘伝書を手に入れた。本当に偽物なのであれば、何故だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "誤解……すべて誤解です……"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "今更何を言われようがどうでもいい。用件は一つだけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "この秘伝書にある「化人」の秘訣を、解いてほしい。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "本気で……それほどこの町から出たいのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "私が旧友と交わした約束は、先生も承知のはずだが？"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "今まで、あなたには何度もこの町を出る術をご教示願いたいと訴えてきた。だがいつも焦るなと言われるばかりだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "だが今、秘伝書がこうして目の前にある。まだ焦るなとおっしゃるつもりか？　それとも何か新しい口実をでっちあげるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "先生は数多くの生徒を指導してきたんだ。私に化人の仕方を教えるくらい何の問題もないだろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "この数日、あなたは秘伝書を奪うために、人を傷つけることも厭いませんでしたね。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "人間になりたいと言うが、人の善良さや仁愛を学ぶ前に、恨みや暴力を学んでしまっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "そんな状態で町を出れば、己が傷つくだけです……"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "仁愛……ふん、私が抱く愛が、あなたたちに分かってたまるものか……"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "事ここに至っても、まだ化人の秘訣を自分たちだけのものにするつもりか！"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "残念ですが……あなたの言う「化人」の秘訣は、私にもまるで理解していないのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "あなたが私を恨もうが、殺そうが構いません。お好きにどうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "ですが、私は自分の良心に背いて生徒を騙すことだけは、決していたしません。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "……プー先生、私は今まであなたを尊敬し、敬意を払ってきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "だがこうなったからには、恨まないでくれ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷酷な剣客",
      "speakerId": null,
      "text": "――！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "言った剣客の剣が振り下ろされるより早く、外から飛んできた一振りの剣が、雷霆の威を帯びた一撃で剣客を退けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "剣客は乱入者の並々ならぬ実力を瞬時に悟ると、躊躇なく窓を破って逃げ去った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "逃げられましたか……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "リン天師……今の話を聞いていたのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "大体は聞き、概ね内容にも察しはつきました。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "はぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "先生にもやむにやまれぬ事情がおありだというのは理解しますが、先ほどの行いはあまり褒められてたものではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "リン天師の指摘はごもっともです……はぁ、これでは書物を読み学んできた甲斐もない……面目ありません……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "ですがリン天師、なぜ私が脅されているとお分かりに……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "喋る箒が私の後にずっとついてきて、しかも助けてほしいと頼んできましてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "……今日はもう、何を見ても驚きません。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "天師、どうぞおかけください、まずはお茶でも……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "プーの言葉と共に、茶壺と茶杯を乗せたお盆が現れて、茶を持ってきた。\nリン・チンイェンはそれを見て大きく反応することはなく、ただ眉をひそめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "こちらは……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "皆この塾の生徒で、いずれも「器鬼」です。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "道理で今日出会った町の人々は、おかしな方たちばかりだったわけですね……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "まさかこの町の住人はどなたもそうなのですか……？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "人もいれば器鬼もいます。どちらがどれくらい住んでいるのかは、町がこのようになってから何年も経っていますから、私にも分かりかねますな。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "何年も前からこうした有様でした。先ほどリン天師に申し上げた話も、あながち嘘ではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "巨獣の影響を受けて生まれた器鬼の話は、いくらか耳にしたことがあります。ですが、ここまで人に近い知性を持つ「器鬼」は初めてお目にかかりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "リン天師は、この近くに何があるかを覚えておいでですかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "……歳の陵墓ですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "ええ……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "巨獣の化身が器物に憑依する能力を持つのは周知の事実です。歳獣はあまりに強大な存在ですから、封印されて千年といえど、漏れ出したわずかな力だけで器物を「器鬼」へと変えてしまうのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "そうした事情は、決して市井の者は知り得ないはず。先生はまさか……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "私が司歳台で「巨獣学者」をしていたのは、もう何十年も前のことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "生や涯（はて）あり、知や涯なし……巨獣の研究に終わりはなく、続けるうちに己からも人間味というものが失われました。職を辞して山奥で隠居を考えていたところ、この町を知ったのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "数十年前、この町では器鬼がしばしば騒ぎを起こし、そのたびに天師が鎮圧に遣わされていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "しかし私は思いました。「器鬼」たちは人の世に生まれながら、何の拠り所も持たぬ哀れな者たちだと。中には人間性を帯び、人と大差ない精神と知恵を持つ者もありました。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "そこで、あちこちで騒ぎを起こしては消されていく様をただ眺めるくらいなら、私が人としての仁義礼法を教えてやれば、器鬼にも人と共に平和に生きていける道があるのではないかと考えたのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "そうして次第に、この「置錐学塾」が出来上がっていったのです……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "立派なお志ですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "とんでもない……今の話は、己の功を誇りたかったわけではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "振り返れば滑稽な話です。私の人生、前半は人のために「獣」を研究し、後半は「器鬼」に人の真似を教えてきました。しかし結局どちらの理解も中途半端なまま知ろうともしていなかったのです……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "しかし、こうして隠居するようになって初めて、この器物たちが愛いものだと気づいたのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "この先は、こうした日々が続くものと思っておりましたが……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "実は数日前、一通の手紙を受け取りました。これです。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "手紙……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "「機密情報、他者への譲渡禁止」？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "ある人物が、かの玉門の宗師の書いた希代の秘伝書を手に入れたと豪語してきました。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "噂では、宗師は巨獣の化身でありながら、人と同じ肉体を作り出すことができ、書物には器鬼が「化人」できるほどの秘訣が記されているとか。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "この件、まさか玉門まで絡んでいたとは。ラウくんが話していた異変とは、これのことなのでしょうか……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "しかし「器鬼」を人に変えるなど、本当にそのようなことが可能なのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "実を申しますと、私にも真偽のほどは分かりません。しかし重要なのは、少なからぬ器鬼がそれを信じていることです。それが混乱の種となりました……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "つまり、手紙を書いた者の目的は、この町の住人の心を乱すことにあると？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "はぁ……本当のところは分かりません……"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "私の知る限りはすべてお伝えしました。天師はこれからどうされるおつもりですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "歳獣の件は、本来であれば私の管轄外です。しかし器鬼が人を傷つけたとあれば、天師府の者として見過ごすわけにはまいりません。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "この件の背後に黒幕がいて、よからぬ企みを抱いている可能性もあります。そうであれば、なおさら放ってはおけません。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "そうですね……リン天師が正義のお人であるのは、私にも分かります。この件をあなたにお任せできれば、安心です。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "……最後にもう一つよろしいでしょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "フーの「遺体」ですが、お引き渡し願えませぬか……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "もちろん構いません。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "彼を弔うおつもりですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "弔うといえばそうですが、そればかりではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "この書斎は……名を旦暮堂（たんぼどう）と申します。ここに置かれている壊れた器物は、いずれも「器鬼」だったものです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "器鬼の生死は、人とは異なります。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "彼らは人の執念が器物に宿って生まれたものです。依り代が壊れるか、執念が消えれば命を失います。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "ですから壊れた器物を修復できれば、いつか精神が蘇るかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "ではこの茶壺――いえ、フー・ジュンは……？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "フー・ジュンの主人は、この町の茶畑農家でした。彼は茶を愛し、茶を知る男でした。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "かつて山の斜面に丹精込めて数畝（せ）の茶畑を耕し、毎年清明の時節が来る前に茶を摘んで煎じていました。その頃は、町のどの井戸水を汲んでも、口に含めば茶の香りが広がったものです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "しかし彼はそれに満足せず、天下一の茶と、何よりも澄んだ泉水を一心に求めました。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "ある年、彼は炎国最南の海辺に天岳春（てんがくしゅん）という茶の母樹があると聞き及びました。すぐに船団を雇うと、南へ向かったのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "しかし出て行ったきり、二度と帰っては来ませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "彼が遺した執念が、長年付き添ってきた茶壺に宿ったのです。だからこそフー・ジュンは、殊更に町を出ることばかり考えていたのでしょう……"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "speakerId": null,
      "text": "その方は、先生の友人だったのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・チンイェンは包みから箱を取り出す。箱の中には、茶壺の破片が丁寧に収められている。"
    },
    {
      "type": "dialogue",
      "speakerName": "プー先生",
      "speakerId": null,
      "text": "ありがとうございます、天師……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい男性",
      "speakerId": null,
      "text": "ユンさん、お待ちしておりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "speakerId": null,
      "text": "申し訳ありません。道中で色々とありまして、お待たせしてしまいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい男性",
      "speakerId": null,
      "text": "まずはこの町を見て回りたいとおっしゃっておりましたが、ご満足されましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "speakerId": null,
      "text": "はい、この町の在り様には驚かされるばかりでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユン・チンピン",
      "speakerId": null,
      "text": "あまりあの方をお待たせしてしまってはいけません。そろそろ向かうとしましょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "礼儀正しい男性",
      "speakerId": null,
      "text": "ええ、では先導いたします。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
