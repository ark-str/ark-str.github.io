{
  "server": "jp",
  "storyId": "story_broca_set_1_story_1",
  "groupId": "story_broca_set_1",
  "stageId": null,
  "title": "信頼への第一歩",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_broca_1_1.txt",
  "sourceHash": "f63d8347ff4021d6d574131e8356b7ebbcfcabc38aa3425b8b508811eed55f0b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "アオスタ、本気でそのロドスとかいう組織に加わる気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "そうです。ブローカ。悪い選択ではないと僕は思っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "他の町に行けばいいだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "ブローカ、あなたがこういう大きな組織を嫌っているのは知っています。ですが率直に言って、これが一番マシな選択なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "おい、んな浮かねぇ顔すんなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キアーベ",
      "text": "入ってみてマズけりゃまた別のとこに行きゃいいだけだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "はぁ……そんな言うほど簡単ではないと思いますが、確かに理論的にはその通りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "どうです？　ブローカ、納得してもらえました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "チッ……わかったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "やっと目を覚ましたか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ここは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "森の中だ。隊が獣の群れに襲われ、俺ら二人は崖から落ちてきた。思い出したか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "チッ、ったくほんと憎ったらしい奴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "だがそれとこれは別だからな。礼は礼として言っておく。もしお前がいなかったら、俺は死んでただろうからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ああ、もう、わかったよ、俺の負けだ！　昨日のお前とのケンカについても謝るよ。確かにあんな言い方はすべきじゃなかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "俺は気が短いんだ、俺の周りで誰かがロドスの悪口を言うのは許せない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "だがお前は来たばかりだってのも知ってる。ロドスがどんな組織か分からないのも無理はないし、仕方ない。昨日の夜、ヤトウにこっぴどく言われたよ。あれは言いすぎた俺が悪かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……いや、俺も悪かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "いや。間違いは間違いとして認める。俺が悪かった、すまない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "これでこのことは水に流してくれ。いいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "はぁ、今日はずっとこのことが気になってたんだ、やっと胸のつかえが下りたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "他の連中は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "分からんが……まあ、あいつらなら大丈夫だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "とりあえず、みんなを探すべきだ……っつ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "下手に動くな、相棒。さっきちらっと見たが、お前のその傷じゃまともに動けないはずだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "あ、相棒？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "あぁ、これは俺のクセみたいなもんだよ。こういう呼び方をした方が距離を縮められるからな。嫌か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……好きにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "そうさせてもらおう。さてと、お前の傷の痛みが落ち着くまでしばらくはここで休むぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "だが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "なに、安心しろ。ヤトウがいるんだ、問題なんて起きないさ。彼女はベテランオペレーターだ、俺らは自分の面倒だけ見てればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ならお前はもう少し横になってろ。俺は付近の様子を見てくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "俺を……見捨てるのか？　今まで組織とあなたにどれだけ尽くしてきたか、あなたが一番知っているだろう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ブローカよ、これも忠誠だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "俺の代わりに死ぬ……これも忠誠のうちに入るんじゃねえのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "相棒、戻ったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "少し見てきたが、この森はかなり広いな。何があるか分からない。慎重に進む必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "俺の方も少しは落ち着いてきた。もう動ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "もうか？　無理はしなくていいんだぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "そうか、なら行こう。来た方向は俺が大体覚えてる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "なあ、相棒、初対面の時から気になってたんだが、そのドリルの後ろに付いてるノコギリはなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "戦ってる時も使ってないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……これはいろいろと改造する時に使うんだ。木を切る時とかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "木を切る？　お前、前はきこりでもやってたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "違う。ただ自分に使いやすいように物をいじるのが好きなだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ああ、なるほど。見かけによらず器用なんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "別に大したことじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "なあ、相棒。お前、愛想が悪そうに見えるが話し始めると結構いい奴だな？　俺はずいぶん長いこと勘違いしてたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "お節介するわけじゃねぇが、最低限でもいいから、自分の意思や考えはちゃんと伝えろ。でないと誤解されるぞ。昨日みたいにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "誤解？　俺は本気だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "本気？　それこそ本気かよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "いいか。お前はまだ新参者だ。来たばかりのお前のことを分かってる奴なんかいないし、逆もしかりだ。ロドスに忠誠を誓えだの、周りを信用しろだの綺麗事は言わねぇ。だが、せめて敵対心は隠せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "これだけは忠告しとくけどな。そんな話し方じゃ、お互いにいいことないからな。同じロドスに属してんのに、開口一番「ロドスを信用してない」って言われる方の身になってみろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "お、俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "話し方、いや、違うな。俺はお前の話し方を責めてるわけじゃなくてよ。なんて言やいいかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……俺はな、ロドスに入る前はフリーの傭兵だった。いろんな大組織も見てきた。ロドスに来たのも、最初は食いぶちを稼ぐためだけだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ロドスの待遇は悪くない。飯も温かいしマズくもない。だがそれだけだと思ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "大きな組織や大企業はみんな同じだ。そう、今のお前の考えてることだよ。でもな、例外もあるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……例外？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ロドスはどうも少し違ったんだ。信じられんことにな。相棒よ、もうしばらくすりゃ、身に染みて分かるようになる。言葉じゃ説明できないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "いずれにしろ、俺はアーミヤを信じることにした。だからドクターも信じてる。もちろんケルシー先生も信じてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "これで、昨日俺が怒った理由を理解できたか？　お前の話し方じゃなくて、俺たちの信じてるものを、ろくに知りもしないのに否定したからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……分からない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……まあいい。すぐには理解しなくていいさ。ただ言いたいのは、ロドスはお前が思っているような組織とは違うってことだ。俺たちは信頼には信頼で応える。それだけは覚えておいてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……ところで、俺たちの任務に村の支援なんて含まれていなかったと思うが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "あ？　ああ昨日のことか？　ありゃ隊長の裁量の範囲だよ。隊長がやるって言や、状況が許す限り、地元の人のために何かしてやる。人助けは悪いことじゃないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "で、相棒……どうして急にそんなこと聞いたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……なんでもない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "って、おい……ちょっと待て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "見ろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ブローカたちの視線の先にある木々の間からは、先ほど小隊を襲った野獣の群れの姿が見えていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "どうやら俺たちをお探しのようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……俺なら戦える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "やめとけ、痛みがほんの少し引いただけだろ？　俺がひきつけてやるから、お前は先に逃げろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……いや、俺は戦う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "おい、相棒。俺がさっき自分から謝った理由が分かるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ヤトウにどう言われようが絶対折れないって決めてたんだけどよ。あいつらに襲われた時、お前は俺を守ってくれたろ？　それで「あぁ、こいつは根は悪い奴じゃない」って思ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "お前みたいな奴は、きっとロドスを気に入る。断言してもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "だから今度は、俺がお前を助ける番だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "だめだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "お前もたいがい頑固な奴だな……先輩の言うことは聞くもんだぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "だいたいだな、この程度の相手じゃ死にゃしないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ブローカは、彼の言葉を無視して、その場に立ち、無言で武器を掲げた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "はぁ……ったくほんと憎ったらしい奴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "まあ、嫌いじゃねえがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "相棒よ、もう止めないが俺から離れ過ぎるなよ？　俺に合わせろ。一緒に殺るぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "分かった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人が野獣に向かって飛びかかろうとした瞬間、群れの中から、突如として悲鳴が聞こえてきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ん？　ありゃあ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "お二人とも、無事ですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "おう、待ってたぜ！　俺はぴんぴんしてるぜ。こいつは少しばかり怪我をしてるがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "あら、たしかに。ブローカさん傷だらけですね。とりあえず座って診せてください。必要があればこの場で処置しますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "大した傷じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "で、あそこにいるのはヤトウたちか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "はい、お二人が崖から落ちた後、ずっと探してたんですよ。二人ともご無事で本当によかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "確かに大怪我ってことはなさそうですが……でも油断は禁物です。ここは他の方に任せて、私たちは一足先にブローカさんを連れて戻りましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "あいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "あ？　何か言ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "なんでもない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "初めての外勤任務はどうでした？　ブローカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "……まあまあ、といったところか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アオスタ",
      "text": "そう……それはよかった。誰かと揉めないか心配だったのですが、大丈夫だったようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブローカ",
      "text": "そうだな。とりあえず、もう少しここでやってみてもいいと思う。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
