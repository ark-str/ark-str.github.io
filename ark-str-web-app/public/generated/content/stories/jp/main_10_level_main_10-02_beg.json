{
  "server": "jp",
  "storyId": "main_10_level_main_10-02_beg",
  "groupId": "main_10",
  "stageId": "main_10-02",
  "title": "うつむく",
  "storyCode": "10-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_10-02_beg.txt",
  "sourceHash": "9f6e9949b5b50eea8f5bb363d7237b4bdc1a723420bfb582eb1f631f27601304",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "a.m. 9:09 天気/曇天\nロンディニウム サディアン区 309番ゲート"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "前に進めば……ゲートです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "何か心配事か？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "そうですね……これまでのところは順調ですが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――一つだけあります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "これまでずっとドクターやケルシー先生と連絡を取っていたあのトランスポーターですが、元々私たちが付属区画に着いたらすぐに連絡をとる予定でした。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そう約束していたのは覚えている。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "私たちは待っていますが……待つことしかできないんです。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "もともとは直接会えるか、少なくとも何かしらの形で知らせを受けるものだと思っていました。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ドクター、今の状況では、他のオペレーターに心配を与えるような情報を不用意に話すわけにはいきません。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "……私たちはもうここにいるんです、前へ進み続けなければなりません。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "彼女に何かあったのか？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "連絡がつかないなら、安否を確認する手立てはありません。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "彼女がトラブルに巻き込まれていないことを願っています……",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私たちは計画通り市内に入りましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あれ、人がたくさんいます。みなさん市内から出てきたみたいですね……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "……俺たちは本当にこのまま逃げられるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "この道は安全よ。お隣さんが先週ここから逃げていったもの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "外出許可証さえ手に入れば、兵士たちが難癖をつけてくることはないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "お……俺が言ってるのはそういうことじゃないんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "わかってるわ。私が考えてることは多分あなたと一緒よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "四年前、サルカズの軍隊をニュースで初めて見た時は、深く考えてなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "そうさ俺もだ。陛下が去られた後は混乱してたからな。どこぞの大公爵が気まぐれを起こして、魔族を軍に招き入れたとか知ったこっちゃねぇ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "二年前、サルカズの軍隊がトレンフィールド区の通りを歩いているのを見たわ。それからというもの、仕事から帰る時は、同僚との話題はいつもそれだった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "俺も覚えているぞ。まるで一夜にして、ひっそりと何かが変わったみたいだったよな。カルダン区の公爵役場近くに住む俺たちは、そうした変化に気付くのが少し遅れたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "半年前くらい、サルカズの軍隊がうちの銀行の前に急に現れて店長を連行したの。彼女の夫が都市防衛軍で要職に就いているからという理由だったわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "はぁ……それ以降、君は二度と二人を見てないんじゃないか？　俺たちが住んでいる区画でも警官たちの顔ぶれが変わったんだ。今では大体があの恐ろしい角を生やしているよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "そして……昨日。サルカズがうちの向かいの街角にやってきて……一軒一軒ノックしていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "それで君は逃げてきたのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "実は私の両親はとっくに逃げてたの。私はただ……銀行での稼ぎを手放したくなかっただけ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "みんなそんなもんだろう。ロンディニウム……この都市を去れば、俺たちはもう以前のような生活には戻れなくなるんだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "こんな話やめましょうか。行きましょう、行くのよ。お金より命の方が大事だもの。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ここは毎日こんな様子なんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "……ある日を境に、概ね毎日こうだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "テレシスの軍は、住民が都市から離れるのを止めないんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "どうやら奴は、今のロンディニウムを本当に掌握しているのが誰であるかを、外の人間に知られても構わないようだな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "外の大貴族たちは何とも思っていないのか？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "間違いなくロンディニウムの動向を気にしているだろうな。だからこそ、奴らは都市の外に兵を駐屯させている。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "だがそれよりも、お互いの動きの方が気がかりなんだろう。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "ロンディニウムを支配しようと目論む大公爵たちにとって、都市内のサルカズに攻撃を仕掛けることは、この二十年以上続いた睨み合いにおいて、他の連中を出し抜く可能性を秘めた行動だ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "あいつらの中に、自分のものになるかもしれない玉座に他人が先に座るのを見て喜ぶ者がいると思うか？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "このような状況でいずれかの公爵が攻撃の意を示したとしても、たちまち通信やパーティーの招待状、あるいは自分の領地からやってくる不利なニュースによって出撃を諦めざるを得なくなるだろう。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "そして仮にその公爵が、なお進軍するというのであれば、その者を待ち受けるのは敗北だ。しかも都市内の摂政王が自分の兵士を消耗する必要すらない。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "ヴィクトリア議会の状況はどうなっている？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "……わからない。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "私たちが去ったあの日のロンディニウムは、それまでと大して変わりなかった。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "シージ",
              "text": "それに、議会が機能している限り、この都市が収拾のつかない混乱に陥ることなどないとも思っていた。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "すでに予想外の出来事が起きているんだ、都市内の具体的な現状については、入ってみないことにはわからないだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "あの、僕はもうここまで案内したから……ここからは、君たちだけで行けるよね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい。ありがとうございます、トーマスさん。大変助かりました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "各チームに告ぎます。これより我々は事前の段取りに従って、別々に前方の人の流れに紛れ込みます――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "先行はクロージャチームにお願いします。問題ないことが確認され次第、シージチームが続いてください。私とドクターでしんがりを務めます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "偵察チームは引き続き周囲の状況に注意を払い、何か異常があればすぐに知らせてください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "バリンさん、トーマスさんを連れて、来た道を戻って……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドスオペレーター",
          "text": "アーミヤさん！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい。どうしましたか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドスオペレーター",
          "text": "前方が突然騒がしくなってきた。サルカズ兵がこちらに向かってきているみたいだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "総員警戒。潜入行動は一時中断します、潜伏を優先してください！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "前方のそいつを捕らえろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "ど……どうしたんだ？　なんでサルカズ兵がいる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "この道は安全だと言ったじゃないか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "そこのお前だ、止まれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "速く……もっと速く足を動かせ。もう少しで……街を出られる……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民A",
          "text": "あぁ――！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "こいつじゃないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民B",
          "text": "お、お願いです……殴らないでください。戻りますから……私たちがどんな過ちを犯したというのですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "行きたきゃどこへでも行け、ここに突っ立って邪魔をするな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "そっちのお前らは動くな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "全員その場で待機してろ。貴様と貴様、それとそこの下向いているやつ、顔をこちらへ向けろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "カバンの中に何を入れている？　武器か？　全部出してみろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "なぜ顔に火傷があるんだ？　しかも治りきっていない……お前、列から出ろ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "……パンを作っている時に火傷しただと？　俺たちをバカにしているのか！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "チッ……本当に俺たちの武器で負った傷ではないようだな。お前、反乱軍じゃないだろうな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "ビビって気を失ったか。まあいい、とりあえずこいつを連れてけ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "中尉、ここまでのようですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "……私の責任ね。あなたたちをここに連れてくる前に、追っ手がいないか注意しておくべきだった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "そんなことおっしゃらないでください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "ダブリンに捕らえられた私たちにしろ、サルカズに長く苦しめられたトムたちにしろ、あなたに助け出されるまでは、死人も同然でしたから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "あれこそが絶望でした……訳もわからずみじめに敵の虜囚となるくらいなら、戦場で死んだ方がましです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "ロンディニウムの陥落は決してあなたたちのせいではないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "ならば当然中尉の責任でもありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "私たちを絶望の淵から引っ張り出してくれたのはあなたです。中尉のおかげで私は自分の両足でここまでたどり着き、一時間も長生きできました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "私はもう戦えないと言ったのに、あなたは私を責めもせず、危険を冒して私たちをここまで送り届けてくれました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "行ってください。あなた一人ならば、まだ間に合うでしょう。サルカズたちの目を避けて、安全な場所に隠れてください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "怪我人や病人だらけの我々は、あなたの足手纏いになるだけです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "私はあなたたちの誰一人も見捨てたりしないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "ハハ……私の上官もあなたのような方であれば、あの時の我々は……これほどまでに悲惨で、早すぎる敗北を喫することはなかったでしょうか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "実は中尉と会ってから、気付いたんです。私も中尉のように何か行動したいと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "あなた何を考えて……ダメ、いけないわ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "仲間で束になって突っ込んだら、何人のサルカズを道連れにできると思いますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "……私の話を聞きなさい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "勝手な行動は許さないわ。これは命令よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "命令ですか……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "いいでしょう。今からあなたは私の上官です。命令に従います。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "ここからサルカズ兵がいる地点まで、まだあと徒歩で数分の距離があるわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "全員下を向いて、私の言うことを覚えなさい。あなたたちは付近の区画から来た失業者よ。顔の傷はパンをめぐって殴り合った時についたもの。いいわね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "サルカズたちは……それを信じますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "見ての通り今のサディアン区は混乱状態よ、似たような喧嘩を見たことがあってもおかしくないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "あいつらが信じるかどうかはともかく、問い詰められても……ひとまず耐え忍ぶのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "耐えられない者がいたら……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "わかってます。もし気付かれれば、ほかの者を巻き添えにすることは絶対にありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "耐えられない者がいたら、私がなんとかするわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民？",
          "text": "中尉……！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "ひとまずは様子見よ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "こっちにはいない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "あっちは？　あっちにまだ数人いる、それとあの昇降機の後ろ、あの辺りは人が隠れやすい構造だ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "お前たち、よく調べてこい！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あの兵士たちは誰かを探しているようですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "各チーム、場所の報告を。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……位置確認完了。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我々を探しているわけではなさそうだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "まだバレてはいないはずだ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "同意見です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、出発前にケルシー先生と行ったシミュレーションは覚えていますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "想定される状況として、ロンディニウムとヴィクトリア各地で行動する私たちの情報員に、不測の事態が生じるというものがありました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "彼らがロドスに情報を送る前に、こちらの動きがすべてテレシスに把握されるというケースです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "この場合、私たちがロンディニウムに入るのをテレシスの近衛兵が待ち受けている可能性が高くなります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが現状は想定していたものとも、ちょっと違う感じですね……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我々を待ち受けているのは聴罪師だと思っていた。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "我々はそこまで小物というわけじゃないだろう。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私とドクターの判断は恐らく一致しています。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "テレシスは、まだ私たちがロンディニウムに入ったことには気付いていないと思います。でなければ、こんなに簡単に辿り着けなかったはずです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "そうなると、目の前のサルカズ兵たちが探しているのは、きっと偶然ここに現れた別の人……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "えっ、トーマスさん……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドスオペレーター",
          "text": "アーミヤさん、こいつ突然逃げ出そうとしたぞ！　危うく逃すところだった！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "と、止めないでくれ、僕はここで捕まるわけには……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "トーマスさん、勝手に行動しないでください！　今は危険です！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "すみません、あなたを護送するとお約束しましたが、今はまだ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドスオペレーター",
          "text": "うわっ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ま、待ってください、こちらの武器を奪うなんて――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "ごめん、だけど、僕はまだ死にたくないんだ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "一体どういうことですか……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "答えは明白だ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "兵士が彼を探していると思い込んでいる。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "僕だってこんなことしたくない……ただサルカズのために半年運転手をやっただけなのに！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "あいつら僕のキャンディ工場を乗っ取って、荷物を運ぶよう強制してきたんだ。都市の郊外にいる家族だって養わなきゃいけなくて……僕はどうすりゃいいってんだ！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "あの日はちらっと見ただけだ。ほんのちょっと見ただけなんだ。あいつらが僕の工場で何してるかなんて想像できるわけないだろ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "あいつらはずっと僕を追ってきてる。捕まったら絶対に殺される！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "どうして僕ばっかりこんな目に。みんなして追ってきやがって……逃げ場がないじゃないか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "ぼ……僕は何もせずに殺されるのは嫌だ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロドスオペレーター",
          "text": "トーマスさん！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "バリンさん！　戻ってきてください。ロドスの存在に気付かれてはいけません。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "ハ……ハハ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "こうやって……ロンディニウムを出れば……外のダブリンの奴なんて知ったこっちゃない……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "あら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "うっ――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ダブリン兵士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロンディニウム市民",
          "text": "ど……どうして……君たち……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンドラゴラ",
          "text": "ダブリンの人間は、あんたごときが無視できるもんじゃないの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンドラゴラ",
          "text": "――捕まえなさい。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
