{
  "server": "jp",
  "storyId": "main_9_level_main_09-07_beg",
  "groupId": "main_9",
  "stageId": "main_09-07",
  "title": "罪無き者",
  "storyCode": "9-9",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_09-07_beg.txt",
  "sourceHash": "6cb059b6e5ed790f60f4aec23bde6bc8ae73f6704f8f09dcda8876b05a7e5738",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ただいま！　パンときれいな水を見つけてきたよ。クレイグは一晩中走り回ってたから、早く何か食べさせてあげないと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "って、あれ……？　みんな、どうしたの？　何かあった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "……この女だ！　ヴィクトリア軍に情報を流したのは……！　こいつが、シアーシャを殺したんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "なっ！　何を言ってるの……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "シアーシャ……シアーシャに何かあったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "聞こえなかったのかよ、死んだんだよ！　白々しいぞ、ヴィクトリア兵め。お前がシアーシャに近づいたのは彼女から情報を引き出すためだったんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "あいつはもう処刑されちまったよ――どうだ、これで満足か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……そんな、あたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "そんなの、考えたこともない、のに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "どうして……？　どうして、こんなことに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "う、ぁ……ごめん……ごめんね……シアーシャ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "よくも泣けたもんだな！　お前がやったんだろうがよ。被害者ぶるのもいい加減にしやがれ、あいつを悼む資格なんざ……ここにいる資格なんざてめぇにゃねぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あの子は私の友達だもの。ずっと心から……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "友達だと？　ヴィクトリアの兵士が、俺たちターラー人に向かって友情を語るのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "そいつは笑える冗談だな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "で、でも……あたしたちはみんな……同じヴィクトリアの同胞じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "「同胞」？　お前らが俺たちをそんなふうに扱ったことがあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "お前自身はどうなんだ？　俺たちが食うような飯を口にしたことが……俺たちの使う言葉で話したことが……俺たちと同じ苦しみを受けたことが、お前にあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "それでも、あたしはずっと、あなたたちの力になりたくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "やめろ、それ以上近付くな！　旗を下ろせ！　これ以上増援なんて呼ばせねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "違うの……あたし、そんなこと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "俺たちの土地から出て行け！　俺たちターラー人の故郷には、ヴィクトリアの旗なんて必要ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あなたたちも……あたしを、追い出したいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……少なくとも、あなたを庇うことはできないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "あなたも見たでしょ？　私は何も悪いことなんてしてないのに……あなたたち兵士は、私を見逃してくれなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しげな女性",
      "text": "……きっと、ローナンが正しかったんだわ。今がチャンスなのよ。私たちが勝つことさえできれば、もう私とクレイグを悩ませる人はいなくなる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "クレイグ……君も、そう思う……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クレイグ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クレイグ",
      "text": "僕たちには、お前なんか必要ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "いたッ……石？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "結局……あたしはそれを、ちゃんとわかってないだけだった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……もう、ここにいるべきじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "駐屯軍が撤退していくわ。このままいくと、じきに地区の半分以上が亡霊部隊の手に落ちるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "な、なんで！？　さすがにこれは早すぎでしょ！　確かにここの駐屯軍は組織力も低いし、訓練不足だけど、それでも今夜くらいまでは持つと思ってたのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……さっきの駐屯軍の動き、あなたも見てたでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うん。一緒に競技場を守ってたのに、敵が来たらすぐに退いていったね。どんなに声をかけても逃げ腰だったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ええ。完全に戦意を喪失しているように見えたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "でもさっきの状況はさ、敵が現れた途端、避難民たちが大喜びで中から扉を開けちゃってたからね。あんなの見ちゃったら、やる気なくすのも当然だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "とはいえハミルトン大佐はヒロック郡を重要視しているし、何よりそう簡単に諦める人じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "確かに、今の駐屯軍は不利な状況だけど、潰走しているわけではなくて、ある程度組織的に撤退しているように見えるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "この状況が大佐の計画の範疇で、何らかの勝算があるのだと信じるしかないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "一番近くにいるのはカイウェン郡の駐屯軍だから……救難信号を送れば、早ければ夕方には到着できるよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……すぐに信号を受信してくれたら、の話だけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "隊長。通信システムの心配でもしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ここに来てもう三日が経つのに、今に至るまでロンディニウムからの連絡がないのよ。今のヒロック郡は孤立していると考えるべきだわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――ッ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "びっくりした。でも、大丈夫だよ！　あの人たちは榴弾も人数もそんなに多くなさそうだし、うちが片付けてくるね。そうすれば、この通りはまだしばらく安全だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……バグパイプ。あなたが訓練兵として入隊してきたばかりの頃、罰として、重りをつけての逆立ち腕立て伏せを二時間させていたことは覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "もちろん覚えてるよ、隊長。あれくらい何でもなかったけどさ、しばらくの間は、隊長に嫌われてるんだと思ってたっけなぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――これまで、あんなことをさせた理由は伝えてなかったわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "実を言うと、あれは……あなたが着任時、「カバンの中にひき肉のゼリー寄せと毛布が入ってる」と言ったことが始まりなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "えっ？　でも、あれはうちの故郷の特産品で、すんごくいいものなんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "そう、それよ。あの時も、そう言ってたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "それから、単独でのトレイルランニングテストの日のこと。戻ってきたあなたは既にかなりの空腹状態だったのに、懐に忍ばせたそれを食べようとしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……だって、もったいなかったからさ。元々、あれは自分へのご褒美だったんだよ。訓練期間が終わった後の、一番幸せな時に食べようと思ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "「故郷を忘れられず、過去を乗り越えられない人は、優秀な士官にはなれない」……以前の私はそう思っていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "だから、あなたが前衛学校を好成績で卒業していようと、スリム先生からの強い推薦があろうと、私はあなたの能力に疑問を抱いていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "そういうことだったんだ！　けど隊長、その後はうちのことしっかり面倒見てくれてるよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "それは、あなた自身が自分の価値を証明したからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "お陰で、私は少しずつ理解していったの。あなたには、確固たる信念から来る粘り強さがある。だからこそ、今のあなたは、私以上に優秀な、ヴィクトリア最高の戦士だってことをね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……バグパイプ。これから言うことを、よく聞いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――この地区を放棄して、二手に分かれましょう。私は、チェロたちを連れて北東の第一通信基地局へ向かうわ。あの場所がまだ亡霊部隊に占拠されてないことを願いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "それで、あなたの方は連絡所へ向かってちょうだい。なるべく早くトランスポーターを見つけて、その人のために街からの脱出ルートを探し出すのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "道が見つからないときは、その破城矛で切り拓きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "これは命令よ。私たちはヒロック郡で起きたことを伝えなければならないの。たとえ、どんな犠牲を払うことになろうとも。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "あ～あ、めんどくせー。ほかの連中はリーダーと一緒に働いてるってのに、俺だけ掃除係なんてよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "にしても、考えてみりゃ変な話だよな。そこら中で皆戦ってるって時に、リーダーはなんでわざわざ彫像の近くを掃除しろなんて言ったんだ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "……あぁ？　誰だお前？　邪魔すんじゃねーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……シアーシャが死んだのは、ここなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "シアーシャ？　リーダーに処刑された裏切り者のことか？　けっ……そうだよ、全部あいつのせいだ。こんなところで死にやがって……お陰で俺は灰掃除なんかさせられて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……っ！？　じゃあ、あなたが掃除してるのって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "ただのゴミに決まってんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "シアーシャは……あの子は、すごくいい子だった。家族にも、友達にもとっても優しい人で、この都市のために……何もかもを差し出したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "どうして？　あの子が、一体、何をしたっていうの？　だってあの子は、恋愛小説を読んで泣いちゃうくらい、純粋な子で、絶対に、誰かを傷つけたりなんて……しない人なんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "はぁ……？　わけわかんねーこと言いやがって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "まさかこの裏切り者に同情してるのか……？　そもそもお前、一体誰なんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "「裏切り者」なんて呼ばないで。あの子の名前はシアーシャだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "シアーシャをこんな場所に一人置いておけない。あたしが、連れて帰る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "……頭イカれてんだろ……気持ちわりぃな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "何があった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忙しい青年",
      "text": "あっ、上官！　怪しい奴があそこにしゃがみ込んで、裏切り者を連れて帰るとか何とか、おかしなことを言っています。恐らく、敵か裏切り者のどちらかではないかと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "わかった。報告ご苦労。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "おい。貴様、何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "（……シアーシャ。あたしたち、間違ってたのかもね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "（あなたは、命を懸けてこの人たちを守ったのに……彼らはそれに感謝するどころか、暴徒を迎え入れてしまった。この都市がこんな姿になった今……彼らはもう、罪がないとは言えないよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "……答えろ。貴様は、我々の敵対者か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "敵対？　あたしにもわからないの。自分が一体、どちら側に立っているのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "ッ、動くな！　動いたら、その頭を――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……よし。これでまた、一匹減った。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "このクズどもが……フンッ。撤退中だろうが、見かけた奴らは全員始末してやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "なあ、そこのヴイーヴル。この辺で、ほかにもクズを見かけなかったか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "（……クズ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "（……シアーシャをゴミ呼ばわりしたあの人は――あの人たちは、当然「クズ」。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……あっちへ行ったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "了解。すぐに向かう――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "誰かの叫び声が聞こえたようにも、何も聞こえなかったようにも思えた。\nあたしはただ、シアーシャを連れて帰りたかっただけだ。それなのに……どれだけ必死ですくっても、灰は指から零れ落ちていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "シアーシャ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その時、手が、私に向かって差し出された。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "――おいで、ジェーン。ここを離れよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "ほら、レモンティーだ。まずは温まりなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "う、うぅっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "泣きたいのなら、我慢はいらないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……泣きたくても、涙が出ないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "君の中にある怒りを感じるよ。彼らが憎いかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "そう、なのかもしれません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "ふむ。先ほどは、あの連中を支持するターラー人を兵士に捕まえさせていたようだが、少しは気が晴れたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あたしは、あの人たちよりも、自分自身が憎いのかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "もし……あたしがメモを渡さなければ、シアーシャは死なずに済んだんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……だけど、あたしはただ、もっと大きな衝突を止めたかっただけで……立ち上がりさえすれば、何かを変えられると信じて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "――運命が常に人々の願いを叶え続けるものであれば、我々がそれを運命と呼ぶことはなかっただろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "ジェーン。一つ、昔話をしてもいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……はい、もちろんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "では、語らせてもらうとしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "数十年前、私が君と同じくらいの……いや、君よりは多少年上か。まあ、そのくらいの歳だった頃のことだ。当時の私は教会に勤めていて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "えっ……？　ラテラーノの修道士だったんですか？　全然そうは見えませんけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "ははっ。時間と経験はたやすく人を変えてしまうのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "話を戻そう。その時、私は戦争の調停を命じられてな。いざ現地に赴いてみれば、もはや、誰が何のために始めた争いかなんてことはどうでもよくなっているような、混乱した状況だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "そこで、とある都市が私に助けを求めてきたので、私はそれを了承した。彼らに武器を下ろすよう勧めて、和平交渉の仲介者として、その都市を包囲している将軍を訪ねたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "しかしながら、それは同時に、彼らが暴政に屈することを意味していた。ゆえに街の人々はそれを望まなかったんだ。やむを得ず、私は過激な手段も用いて説得を試みたが、合意には至らなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "結局私は、訴えに賛同してくれた数名だけを連れて、失意の中で都市を離れた。我々が去った翌日、その都市は攻め落とされたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "街に残った人々は、ほとんどが死んでしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "恐らく、そのうち相当数の人々は、死ぬ間際まで、私が守ってくれると思っていたことだろう。けれども、私はそうはしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "結果だけを見れば、私は、街の住民を虐殺した連中の味方でありながら、彼らに希望をもたらすふりをした悪辣な人間ということになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "そ、そんなの……事実とは違うじゃないですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "そうだな。さりとて一体誰がそれを理解してくれるというんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "そうしたこともあって、私は枢機卿の任命を放棄し、ラテラーノを去ることにしたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……それでもあたしには、あなたが全力を尽くしたように聞こえます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "そうかい？　ではもし、私が街に留まって、虐殺を阻止するべくより懸命に努力していたとしたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "だとしたら……あなたは誰一人救えなかったかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "あるいは初めから現実離れした希望なんて抱かず、虐殺命令を下せる悪党を撃ち殺していればよかったのかもしれないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "もし、そうしていたら……結果は変わっていたんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "引き金を引く前に、銃弾がもたらす結果を語れる奴なんていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Outcast",
      "text": "だが、悪事が繰り返されるのをただ眺めているだけなんてこと……君にはできるかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あなたの仰る通りです。自問自答をいくら繰り返すことになっても……あたしは、後悔なんてしませんから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "バグパイプ……どうか間に合って。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……トライアングル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ちょうどよかったわ。今から第一通信基地局へ向かうところなの。あの場所なら、そちらからもそう遠くないでしょう？　街に入ってくる必要はないし、直接郊外で合流しましょ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "――隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ッ！？　何があったの！？　声がおかしいわ、まさか負傷！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "は、ははっ……問題、ありません……あ、いや……問題は、ありますね。……でも、私たちのことは……構わないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "隊長。私に、残された時間は……ごほっ。多くは、ありません。……とにかく今は、報告を。――我々は、捜索対象を発見しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "源石製品は、どれも……砲兵大隊の元に、運ばれて、いたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "砲兵大隊！？　駐屯軍の砲兵大隊のこと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "はい。我々は、今……そこに、います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "まさか駐屯軍の兵営が、亡霊部隊に攻め落とされたの……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "正直、わかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "それともう一つ、伝えておきたい、ことが。発見した、源石製品は……すべて、細工がされて、いたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "細工……？　どんなふうに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "手に入れたのは、一部だけ、でしたが。構造が、不完全なんです。活性源石のパーツが、抜き取られて、いて……ごほっ。――隊長、ストレージシティでの、連続爆破事件を、覚えてますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ええ、もちろん。あの犯罪組織は、政府への報復のために不完全燃焼の爆弾を大量生産して、都市の中枢部で、源石による深刻な粉塵汚染を引き起こしたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "そう、です……ふぅ……「構造が不完全」と言った、意味、おわかりに……なります、よね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "はぁ……奴らが、もう、近くに……これ以上は、隠れられそうにもありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――！　ドラムはどこ？　ほかの隊員たちは！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "ドラムは……そばにいます。心臓を射抜かれたので……幸い、あまり苦しまずに済んだようです。……ベースと、マンドリンは、まだ倉庫に。連れ出せなくて、すみません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――ッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "よくやってくれたわ。あなたは、素晴らしいチームリーダーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "……そう、ですか？　……はっ、は、隊長ほどじゃ、ないですけど……ね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "あの……隊長。奴らは……妙、なんです。……我々と、同じような……武器を、使っていて……その上、聞き馴染みのある……号令を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "我々が、戦っているのは……一体、誰なんでしょうか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "今はそんなこと考えなくていいわ。それよりトライアングル――生きて帰ってきなさい！　聞こえたわね？　これは命令よ……！　生きて戻ってきて、お願い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "ははっ……了解、しました。……肝に銘じて、おきます……隊長。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
