{
  "server": "jp",
  "storyId": "act28side_level_act28side_07_end",
  "groupId": "act28side",
  "stageId": "act28side_07",
  "title": "白熱",
  "storyCode": "CV-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act28side/level_act28side_07_end.txt",
  "sourceHash": "36295db29a8a969a7dbd62704be3e4341335d42d889e40bf33f18141443daac0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "全隊準備完了、いつでも本艦に戻れるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカはどう、やっぱり連絡がつかない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "ジェシカちゃんの通信機……また壊れたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "一回の作戦で二度も壊れるなんて、そんな偶然ある？　あの子一体何してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "ジェシカちゃん！　もう、待ったんだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……すみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "いいのよ。あなたの荷物はローラちゃんがもうまとめてくれちゃってるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "いえ……その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしは……みなさんに、お別れを言いに来たんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "お別れ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "隊からの一時離脱を申請したいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……そんな感じです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "理由は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "私用です。絶対にやらなければならないことがありまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どれくらいの期間？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わかりません。一週間か、一年か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカ、正気なの？　一年もの一時離脱なんて許可が下りるわけないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "一時離脱がダメなら……部隊からの脱退を申請してもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "脱退ですって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "道理で……だから「お別れ」なのね。単に離れるだけなら許可なんていらないもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカ、一体何があって突然そう決めたのかはわからないけど、これは言っておかなければならない。小隊を抜けたら、BSWでの君の努力が全部無駄になるかもしれないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "その「やらなければならないこと」って、過去の努力と引き換えにしてまでやるようなものなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "これが工場に残ってる最後の爆薬だ。全部運び出そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "確認は俺がやるから、あんたは少し休んでおけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの、レオーネさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "動力炉を爆破して……ほんとにいいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "今さらこんなこと言うべきじゃないのはわかってますが、タワーを爆破するって話になった時、レオーネさんはきっと反対するだろうなと思ってました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ほかに隠し通路を封じる手立てがねぇんだろ？　ヘレナの逃亡を助けるにはこうするしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "俺がどう思ってるかなんて……今となってはもう、どうでもいいことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "この町は、このデイヴィスタウンは……もはやすべてが取り返しがつかないんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "だがあの大金さえ手に入れば、未来のことも、開拓地での生活も、まだ希望は持てる……違うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……きっとそうなります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ハッ、希望、希望ねぇ……たかがこれっぽっちの希望になんつー値打ちがついてんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "だがこのほんのわずかな希望のために……この切符で行ける限りの終点が今日だなんてことにさせないために……命を賭けるのも仕方ないと思うしかねぇだろうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ジェシカ、あなたが何をしたいのかわからないけど、自分がやろうとしてることに対して絶対に後悔しないって言い切れる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "溶接トーチを使う時は継ぎ目との角度に注意して。あんまり角度をつけすぎると、火花が飛び散って火傷しちゃうわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "レストランのおかみさんにしては……とても多才ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ふふーん、二十年以上広大なクルビアを転々としてたのよ、あたしがやってたのはレストランだけじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……恋人と破局させられた後、家に帰ろうと思ったことはないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "破局させられた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あ～、レオーネの奴が間違って伝えたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "そうじゃなくて、あれはあたしから別れを持ちかけたのよ。あいつは根っからの几帳面でね……あの無骨な顔にはちっとも似つかわしくないくらいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "当時あたしはクルビアを渡り歩きたいって主張したけど、彼はそんなのクレイジーすぎるって言うのよ……それでもしばらくは荒野で支え合いながら暮らしてたけどね。あれも悪くない生活だったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "でもある晩、彼が突然あたしにプロポーズしてきたのよ。もう放浪には耐えられない、一緒に移動区画で安定した生活を送ろうって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "だけど、一つの場所で同じ日々を繰り返すなんて……そんなこと、当時のあたしにはあまりにも怖ろしすぎたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "だからあたしは断った。あたしじゃあなたが望む良い奥さんにはなれないわよって。そして有り金と生活用品を全部彼に残し、駄獣に乗って彼の前から消えたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でもその後……デイヴィスタウンに来たんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "彼の手紙にね、当時の夢がついに叶ったから、デイヴィスタウンに会いに来てほしいって書いてあったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "それでここにやってきたの。もしまたプロポーズされちゃったら、どう断れば彼のプライドを保てるだろうなんて考えながらね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "だけど……あなたも知っての通り、あたしは一足遅かった。彼はすでにこの世を去っていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それからあなたは彼のレストランを受け継いで、ここに残った……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "受け継いだんじゃなくて、奪い返したの。悪ガキどもがレストランを占拠してめちゃくちゃに荒らしてたから、あの時少なくとも十五人は追い払ってやったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ええっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "人生なんてそんなものよ。ロマンチックに見える物語には必ずしもロマンチックな始まりや過程、結果があるわけじゃなくて、大抵は泣くに泣けないし、笑うに笑えないようなものなのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "だったら、この数十年で……後悔したことはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "後悔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "駆け落ちして、結婚から逃げ出し、彼の死に目にも会えず、そしてデイヴィスタウンに残った……こうしたすべてに対して、後悔は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "残念に思うことはたくさんあっても、後悔はしてないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あたしは自分の選択によってもたらされた結果に満足してるし、その代償も喜んで受け入れてるのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……わかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ろくに考えもせずこんな大きな決断をしたっていうの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "いえ、お二人の問いについては十分考えましたし、参考にするためにそれらをほかの人に投げかけ、その答えも聞きました。結果、どれもが正しいと思いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ですが聞いた答えをそのまま繰り返したり、自分の代わりに彼らに答えてもらうことはできません……なぜならその答えはわたし自身のものではないからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "自分の選択に、過去の積み重ねを代償にするほどの価値があるか、後悔する結果にならないか、この選択で将来がどうなるかはわかりません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ですがやらなくてはならないんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "だけど、やっぱりジェシカ・ブリンリーの一時離脱申請については却下させてもらうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "では……脱退を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "リスカム……隊長？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "どんなに世渡り上手なベテランでも、仕事に無頓着な老傭兵でも、君みたいに平然と脱退という言葉を口にしたりはしないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "でも、そんなことが言える今のジェシカこそが……自己不信やためらいを投げ捨てて、自分とちゃんと向き合えたジェシカなんじゃないかとも思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "その選択に賛同することは依然としてできないけど、それでも決心が固まっているというのであれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ごめんなさい、本当にごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "もう何も言わないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……気を付けて行ってくるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "ジェシカちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ごめんなさい、ローラさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "実は連絡が取れなくなったあたりから、漠然と嫌な予感はしてたんだよね……でも、ジェシカちゃんがもう決めたんなら、最後にハグしてお別れの挨拶にしよっか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジェシカの答えを待たずに、ローラは数歩前へ出ると、ジェシカを強く抱きしめた。\nそうしてリスカムとフランカに見えないよう、ジェシカのポケットに小さなメモをねじ込んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "（耳打ち）あたしちゃんたちがいなくなってから見て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "（耳打ち）ジェシカちゃん、元気で……元気でね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "まだほかにやることはあるかしら、隊長？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "じゃあ……行きましょうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ウッドロウさん、本当に大丈夫なんですか？　レオーネさんと二人だけで林の中で待機だなんて……事件が発覚したら、きっと大勢の人が追ってきますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "俺たち老いぼれのことより、自分の将来を心配したらどうなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……どうせ今までちゃんと考えたこともありませんでしたから。でも監獄の中なら考える時間がたくさんあるかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "もう傭兵を続けるつもりはないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ずっと戦場に留まっていたくはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "ジェシカ……戦い続けるにせよ、戦いの場から去るにせよ、答えが見つからないからといって自分を責めて、落ち込んだりはしないでほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でしたら、ウッドロウさんはどんな選択をしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "独立戦争が終わって、俺は長い間迷い続けていたが、最終的に退屈な毎日を過ごす生活を選んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それは一つの正解と言えるのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "そうは思えないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "正しいと思っているのが自分だけだったとしても、それが間違った答えであるとは限らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "お前は若く、そして道のりはまだ長い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしは……見つけられるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "がらんとしたセーフハウスを眺めながら、ジェシカは突然鼻の奥がツンとする感覚に見舞われた。\n鼻を軽くすすり上げると、彼女はあのメモを開いた。\nメモに走り書きされた数字に従って、ジェシカはセーフハウス内の隅の目立たない場所へと歩いていく。そこには木板を寄せ集めて作られた仕切りがあった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "五、六、七……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "八枚目の板の後ろにスペースがある……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そこには装備がたくさん積み上げられていた。それらは全部、ジェシカがBSW本艦を出る時に持ってきたものだ。\n装備の山の上には、同じように走り書きされたメモが一枚置かれていた。\n「どうせまだ何かやることがあるんでしょ？　これならきっと役に立つと思って。」\n「思い切ってやっちゃえ。あたしちゃんはジェシカちゃんの選択を信じてるから、ジェシカちゃんも絶対に自分を信じ抜くんだよ。」\nメモの一番下は、こんな一行で結ばれていた。\n「さよなら、ジェシカちゃん。キミときちんとお別れできてればいいんだけど。」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ごめんなさい、遅れてはいませんよね？　装備の準備に少し時間がかかってしまって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "構わん、約束の時間まではあと五分ある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "それはどこから持って来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "友人からの贈り物です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "もしまた会えたら、ちゃんとお礼を言わなくちゃね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "最後にもう一度確認する。中に入った後、ヘレナとレオーネは障害の突破と現金の運搬、俺とジェシカは人員の制圧、それが済み次第あとを追う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "合流した後、ヘレナは金を持って隠し通路から逃げ、俺たちは追手を引きつける。ほかに質問はあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "もし十分な量の爆薬があれば……銀行の奴らに直接サプライズしてやれたんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "頭を冷やしなさい。もしシルヴィアの情報に誤りがなければ、爆薬のほとんどを最後の扉のために取っておかないといけないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "すべては迅速に行わねばならず、俺たちの持ち時間はあまりない。三十分後、見張りの傭兵がここに戻ってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "三十分で目的達成できたとしても、金庫の扉の爆発音が必ずBSWの注意を引くことになります。でも今夜はほとんどの傭兵が本艦にいるので、ここまで駆け付けるにはかなり時間がかかるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "その時は任せろ。たっぷり時間を稼いでやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "時間だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恐れる銀行員",
      "text": "あなたたち何を――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "警報器から手をどけろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恐れる銀行員",
      "text": "ヒィッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "これは強盗です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あなたたちが協力してくれれば、怪我人も死人も出さずに済むわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "神経質な銀行員",
      "text": "そんな、まさか――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "声をあげるなよ……お前とさっきの女はこれで一度目の警告だ。次はこんなに優しくはないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "全員、慌てる必要はない。俺たちの指示に従え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "命を助けてほしけりゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行員たち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "異論がなければ、全員ロビーに集まって、両手を頭の後ろに回して床にしゃがみなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "こっちは全員の顔と名前を覚えてるのよ。下手な真似はやめておくことね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "早くしなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "金庫に行くには四つの扉を抜ける必要があります。一つ目は応接室の扉。鍵が必要ですが、従業員であれば誰からでも入手することは可能です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "二つ目は応接室内にあるパスワード式の扉。パスワードは毎日変更されますが、規則性があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "私の計算によれば、当日のパスワードは恐らく……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "よしっ、応接室の鍵は使えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "お次は隠し扉……入口右手にあるタペストリーの後ろ……ここね。シルヴィアの言った通りだわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "794461……開いた？　あいつ……大した奴だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "次は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "金庫内には二枚の扉があります。片方は格子扉で、もう片方は重さ数十トンの防犯扉です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "格子扉は力ずくでこじ開けられそうに見えますが、警報システムと繋がっているので、パスワードで開けるしかありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "パスワードは三つに分かれています。頭取と支店長がそれぞれ一つずつ把握しており、最後の一つはパスワード生成器によって完全にランダム生成されます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "パスワード生成器は応接室の金庫内にあり、その金庫だけは力ずくで開けるしかありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "どう？　中のものは無事よね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "傷一つないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ご無沙汰だっていうのに、ちっとも腕が衰えてないのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "どうしたの？　もっと得意げになると思ったけど。それとも町一番の発破技士にとってこれぐらいどうってことないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "何でもない、ただウッドロウの方が心配でな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "……二十二人目、これで全員縛ったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "次は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "想像もしていませんでしたよ。ジェシカ様との再会が、まさかこのような形になるとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そうですね。ただ、問題点ならご自身の中に探したほうがいいと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それと、この銀行には三つに分かれた秘密の暗号があり、そのうち二つはあなたとこちらの方がそれぞれ持っていると聞いています。お二方、どうか教えていただけないでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "一緒に下に来るんだ。協力してもらえない場合、銃弾を食らうことになるぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "早くしろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ハーイ、お二人さん、こんばんは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行頭取",
      "text": "お、お前はあの女将のヘレナ？　な、何をするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "怖がらないで、頭取さん。いくつか簡単な質問をするだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "選びなさい。あたしたちにパスワードを教えるか、それともこの扉に縛りつけられてまとめて爆破されるか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "一つ教えてあげるけど、命惜しさに機密情報を漏らしても罪には問われないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行頭取",
      "text": "このクソ虫どもが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "五……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行頭取",
      "text": "思い通りになると思うなよ……お前らみたいなクズは破産して当然なんだ！　荒野へ行って死ぬのがお似合いなのさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "四……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行頭取",
      "text": "ここをどこだと思ってるんだ！？　銀行だぞ！　採掘工場しか知らんくせに、過去にばかり浸って進歩しようともしない搾りかすどもめ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "三……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行頭取",
      "text": "お前らの掘る鉱石なぞとっくに誰からも必要とされていない。今はハイテクの時代、自動化の時代だぞ！　クルビアのためにお前らが役に立てる唯一の道は、さっさと開拓地に行くことなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "二……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行頭取",
      "text": "馬鹿どもが！　お前らは数字すらわからない馬鹿なんだ、騙されて当然の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "一……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "銀行頭取",
      "text": "654784！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "フッ……こんなに長い数字をこの速さで言える奴なんざ、生まれて初めて見たよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "あんたの上司は言ったぞ。次はあんただ、支店長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "パスワードを教えるか、死ぬか選べ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行頭取",
      "text": "早く教えるんだ！　ここで死にたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "……レオーネ様、あなた方はその金を手に入れて何をするおつもりなのです？　いくら開拓地とはいえ、我々から逃れてやり直せるとお思いなのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "そんなことはできませんよ。我々の仲間はどこにでもいるのですから……我々はあなた方の足取りをつかみ、あなた方と共に目的地へ到着することになるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "あなた方が奪った金は甘美な匂いを放ちます。そうなればすぐに現地の同業者がどっと押し寄せ、あなた方を切り分けて食い尽くすでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "そしてあなた方は約束された利益を前にして、自らその首を我々の前へと差し出すのです――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "パスワードの番号は何だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "ゴホッ、ゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "3……6……8……6……5……4。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "どうぞ、持ってお行きなさい。どうせあなた方には何もできませんもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "そう、何一つできやしません。ただ何度も何度も同様の悲劇が繰り返されるだけ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "黙れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "黙っていられるものですか。人間とは貪欲なものですし、レオーネ様などその典型的な例です。そもそも彼が、自分に所有権がないものを手元に留めようとさえしなければ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "黙って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "ブリンリー様……こんな方々とつるむようになられるとは、本当に堕ちたものですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "このレオーネ・テルミンなどは、とうの昔にここを去ることができたのですよ。子供たちを連れ、アイアンフォージにでも、ニューライトバーグにでも、バンカーヒルにでも行けたはずなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "銀行支店長",
      "text": "発破技士である彼ならば、どこでも職には困らないでしょう？　貪欲でさえなければ、今日のような境地には至らなかったはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "……開いた！　レオーネ、彼女の言った通りよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "レオーネは勢いよくヘレナの方へ向き直った。一言も発しなかったものの、彼の目の奥底で渦巻く驚愕にヘレナはぎょっとした。\n数秒経った後、彼女はようやく気付いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ごめん、あたしが言ったのは……パスワードのことよ。パスワードが彼女の言った通りだったって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "わかってる、大丈夫だ、わかってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "三つの扉が開けば成功したも同然です。残りの扉はおまけのようなもの。見た目は最も複雑そうですが、開け方は最も簡単です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シルヴィア",
      "text": "爆破してください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "レオーネ、爆薬の準備はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "いつでも起爆できる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "ではやってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まるで精密手術のように、コンクリートに深く埋まった鉄筋が正確にピックアップされ、爆発の衝撃でねじ曲がり、断ち切られた。\n高温により爆発した燃料が、幾重もの炎の花弁をほころばせ、鋼鉄を優しく包み込む。\nそして突如、そのすべての防御を解除したのだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "爆風が上層の札束を引き裂き、破れた紙幣が地下空間にひらひらと舞い散る。突然の紙吹雪がデイヴィスタウンの雪よりも激しい勢いで吹き荒れた。\n多くの人が夢にまで見るその「吹雪」の中、四人はしばらく唖然となり、その場に佇んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "まさに壮観だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "……正直、こんな大金を見たのは生まれて初めてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "だが銀行が俺たちから搾り取った金額にははるかに及ばないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "お前たち、感動してる暇はないんだ、金を詰めろ。これだけの大金だからな、忙しくなるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "ジェシカ……どうした、何を固まってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "いえ、ただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "お金に対してこんなに欲が出るなんて生まれて初めてで、少し……新鮮な気分です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
