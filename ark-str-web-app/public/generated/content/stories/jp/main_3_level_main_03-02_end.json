  "sourceHash": "085aece01ee9ccf2329785761e0356a7e9979a81be215a24ae45ecd981944870",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十四关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前がミーシャか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "初めまして、だな。会えて嬉しいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "実は、スカルシュレッダーからお前の話をこれまでず～っと聞かされててさ。お陰でなんだか、ようやく会えたって気分なんだ。初対面なのにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……ええと、あなたも……感染者なの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ああ、そうだとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "それじゃ……レユニオンに入った理由は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "「理由」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――俺の妻も、そして子供も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "チェルノボーグの連中に殺されたからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――ウルサスの感染者が辿る末路は、家畜以下だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "それで俺たちは、チェルノボーグをぶっ潰した。復讐のために……だが、まだ足りない。こんなんじゃ軽すぎる……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "奴らの手は感染者の血で真っ赤に染まっているというのに……この程度の報復で、満足できると思うか……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "いいか、ミーシャ。俺たちはこれまで、あの連中に恐れられ、もてあそばれ、馬鹿にされ、迫害されてきた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――理由は一つ、俺たちが感染者だからだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "たったそれだけのことで、奴らは……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "わ、悪い。少し興奮しすぎた……忘れてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "イワン。けが人を運ぶのを手伝ってくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "あ、ああ。わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "それと、この採掘場跡地を拠点として整備することにした。あくまで一時的な拠点だけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "時期が来たら、チェルノボーグへ撤退しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……ねえ、アレッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――その名前は捨てたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "もう呼ぶな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……捨てた、って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "「そいつ」は死んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "俺のことは、スカルシュレッダーと呼んでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……なあ――まさか、怖がってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "――スカル……シュレッダー……？　なんで、そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……そのうち、お前にもわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "それより、別の話をしよう。……お前が龍門に向かったと知った時のことなんてどうだ？　あの時は、皆が自分から志願してまで、救出に乗り出してくれてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "そうして龍門に来てみれば、感染者を大勢引き入れることもできたし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "――だけど、あなたたちは……ほかの人たちを傷つけたでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "私は、あんなの……イヤだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "どうして、感染者同士で争ったりなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "目には目を、だ。当たり前だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だって、ウルサスの言葉にもあるじゃないか。「友に接するは春風の如くせよ」――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "「されど敵に対するは」――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――お前には、わかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……いや。――違う、わかるわけない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "あいつらが俺を捕まえに来た時、俺は家から引きずり出されて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だけどそれでも、母さんは俺の手を握ってくれてた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "お前だって、ちゃんと見てたはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……それ、は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "絶対……絶対、見てたはず……そうだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "あいつらは母さんを寄ってたかって殴りつけたけど、母さんは手を離そうとはしなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "結局、俺たちは引きずられていって……雪の上には、血でできた道が続いてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――あの時……もし、レユニオンの皆がいてくれたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "もっと早く、来てくれてたら……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "俺たち感染者は、ここまで苦しまなくても良かったはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……わ、私……何も、できなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "怖かったの……だから……う、ぅっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……ミーシャ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "お前を責めてるわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "立ち向かう勇気なんて……あの場の誰にもなかったんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……だけど、大丈夫。これからは、きっと全部うまくいく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "今は、昔とは違うんだ。レユニオンが俺に勇気をくれたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……アレッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "――スカルシュレッダー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……お前には、俺たちを信用しないって選択肢もあるし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "信用した上で、仲間には入らない、っていう選択肢もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "でも、どの道お前は、もう感染者なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――俺たちレユニオンは……その感染者の自由のために、最後まで戦い抜く。そういう組織だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "けど、あなたたちは……チェルノボーグをめちゃくちゃにしたじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "罪のない人たちだって、たくさん犠牲に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――「罪のない人たち」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ハッ、あの街の誰に罪がないっていうんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "あいつらの中に、チェルノボーグでの隔離政策に反対した奴なんていたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "俺たちが採掘場に連れて行かれた時や、政府にほっとかれて凍原だの鉱山だので野垂れ死んでいった時……それに抗議した奴なんてどこにいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "感染者への扱いに対して、立ち上がって異議を唱えた人間がどこにいたっていうんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "そ、そんなの、私にはわからないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……レユニオンには、二人のリーダーがいる。どちらも、ウルサスとずっと戦ってきた人なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "二人は、ウルサス人の中にも、感染者のために政府と戦ってくれる人間はたくさんいると言っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だけどそんな奴、チェルノボーグには一人もいなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "あの街の連中は、どいつもこいつも冷たい目をして、俺たちが死ぬのを眺めてる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "いいや、眺めるどころか、それを楽しんでるくらいだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "チェルノボーグなんて、滅んで当然の都市なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "だけど、私……ほかにも、感染者を助けようとしてる人たちに会ったよ。あの人たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "それは、ロドスのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "自分たちも感染者のくせに、龍門に手を貸して、俺たちを痛めつけて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――その上、同胞を殺し、兄弟を傷つけるような連中のことか、って聞いてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "違う……そんな人たちじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "お前はわかってない。そろそろ現実を受け入れてくれないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……悪い。どうしても腹が立って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "ううん。……気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……私にも、理解はできるから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "だって……長い間、苦しんできたんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ああ。俺だけじゃなく、皆がそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "でも、少なくとも今は、全員が希望を持っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "タルラは……感染者を率いて、残酷なすべてに立ち向かってくれる人だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "レユニオンは、俺たちの希望なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "そっか……やっぱり、皆苦しい思いをしてきたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……もし、レユニオンが本当に皆を守ってくれるのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "もちろん、守るさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "そして、それと同じように……俺は、ミーシャを守ってみせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "もう二度と、お前を傷つけさせたりなんかしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "――スカルシュレッダー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "おっ、いたいた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "向こうさんも、結構消耗してるみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "にしても、会社戻らずに待機しといてよかったよ～……一回戻ってまた出発、ってなったら一苦労だもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシア、レユニオンの撤退ルートの予測を頼む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "それが済んだら、大まかな経路をアーミヤに送ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "お安い御用！　ちゃちゃっと終わらせちゃうから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ああ、任せた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "奴らに息つく暇を与えるわけにはいかないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うんうん……えーと、これがこうで、この辺がこうなって～……大体こんなもんかな！　送信完了、っと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "よし。――準備はいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もっちろん！　さてさて、何からやっちゃいましょっかね～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "では、ウォーミングアップといこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "まずは見張りから片付けるぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
