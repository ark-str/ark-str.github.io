{
  "server": "jp",
  "storyId": "main_9_level_st_09-01",
  "groupId": "main_9",
  "stageId": "st_09-01",
  "title": "暗雲の中へ",
  "storyCode": "9-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_st_09-01.txt",
  "sourceHash": "8770ef5c9305b772041199379f5418943a79b000554ccfef327f71f3aec68898",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――倉庫内に入った。偵察チーム、状況を報告して。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "南東にバイタルサインあり。隊長の位置から七列目の棚付近、活動範囲は1メートルです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "数は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "一つです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "源石反応はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "現状、ありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "よし――各自、配置について。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ちょっと、バグパイプ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "はい、隊長！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "何か気になることでもあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "えっと、誰かの歌が聞こえた気がして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "歌はターゲットが気を緩めている証拠よ。集中して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "作戦通り、私の合図で突入してちょうだい――さあ、行くわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "5、4、3……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "用意――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "遮蔽物を破壊！　突入！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "わっ――！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "ごほ、げほごほっ……な、なんだ！？　急に煙が……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "動くな！　その場で両手を挙げなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "お、お前たち……ヴィクトリア……ヴィクトリアの兵士か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "それはそうだけど、おめーさんもヴィクトリア人でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "う、ううっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ターゲットは逃走する気よ！　チェロ、止めて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "待って隊長！　あの人、出口には向かってない――引き返してる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "トライアングル！　ターゲットは後ろの棚へ向かってる！　源石反応を感知したら即、狙撃して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ほかのメンバーは、この盾の後ろへ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "早く！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……ッ！？　バグパイプ、何を！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "目標物は押さえた！　総員退避して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "あなたっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "隊長、源石反応がありません。バグパイプが押さえている箱は爆弾ではないようです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ほんとに？　ふぅ～……なら、一安心だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……ターゲットの男性は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "それがその、ちょっぴり強めにぶつかったから、しばらく伸びてると思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "じゃあ、この箱は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うちが見てみるよ。どれどれ……ジャガイモと、ニンジン、それにカリフラワーだ！　はぁ、もったいないことしたなあ～。美味しそうな野菜がぺちゃんこだべ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "警戒を怠らずに、確認を続けて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "これも、こっちも。この列も……みーんなおんなじだ！　隊長、この倉庫には野菜と果物しかないみたいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "トライアングル、周囲から接近してくる人物がいないか、目を配っておいて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "オーボエ、あなたはバグパイプと一緒に倉庫を調べてちょうだい。何か見つけたら、すぐに合図するのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "チェロは地面に倒れているターゲットを捕縛して。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "う、ぐっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "さてと……それじゃ、質問に答えてもらいましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "し、知らない！　何も知らないって……！　俺は、毎日ここでジャガイモの仕分けをしてるだけだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "そう。あなた、ヒロック郡に住んでるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "あ、ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "なら、「亡霊部隊」について聞いたことはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "ぼう……何だって？　……は、ははっ、し、知らないよ……でも、その部隊ってのは、あんたらみたいな兵士のことを言うんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "ラウリーもジュリアもクリスも皆、連れてかれちまった。まさか、今度は……今度は俺の番なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "落ち着いて、話を聞いてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "いい？　昨日の夜遅く、源石製品がこの倉庫へと運び込まれるのを見た人がいるの。だけど今、ここに現物はないわよね。その理由を説明してもらえないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "説明……？　本気でそんなもんがほしいって言ってんのか？　俺の首じゃなくて？　お、俺はな……俺は！――ペッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ちょっと！　つばなんて吐かないでよ。不衛生だべ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "はぁ……何か手がかりはあった？　バグパイプ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "全然だよ、隊長。見渡す限りジャガイモだらけ！　目撃情報が確かなら、向こうさんは相当動きが早いみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "そう、了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "彼を連れて行って。話すつもりがないだけで、きっと何かを知っているはずだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "ッ……ちくしょうが！　やっぱりな。お前たちは、どいつもこいつも皆同じだ！　あの手この手でケチをつけて、俺たちを苦しめる機会を狙ってるんだ。このヴィクトリアのケダモノめ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ん？　だからおめーさんだってヴィクトリア人でしょ。そうやって呼んで侮辱になるとでも思ってるのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "――隊長、誰か近付いてきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――数は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "（小声）……散開に備えて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）……はい、隊長。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "報告。隊長、彼らは味方のようです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ここか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）隊長、味方って言うけど、うちら包囲されてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "（小声）人数だけ見れば、そうなるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）でも、聞こえてくる音からすると、外にはあんまり人を残してないみたい。うちの前の、この辺の壁を壊したら突破できるかも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "（小声）ちょっと、落ち着きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……どうやら、激しい戦闘が行われたばかりのようだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――私はリタ・スカマンドロス。第七前線歩兵大隊、第二テンペスト特攻隊の隊長です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "やあ、ご機嫌よう。スカマ……スカマンドロス中尉、だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ええ。覚えやすくはありませんし、どうぞ「ホルン」と呼んでください、大尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "了解した。では、ミス・ホルン。私はケリー、ルイス・ケリーだ。本名で悪いが、ここではコードネームが流行らなくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "お気になさらず。ケリー大尉、あなた方もこの倉庫の調査にいらしたんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "ああ。我々の方でも、情報を掴んでいたものでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ならば、事の大きさはご理解いただけているでしょう。二ヶ月前、軍の輸送ルートから大量の源石製補給物資が盗まれ、この一帯で消息を絶ちました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……ああ、ええと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "申し上げるまでもないと思いますが大尉、こうした兵器に加えて、周辺の各郡で盗難された物品までもが、違法組織の手に渡っていたとすれば、その脅威はヒロック郡を脅かすのみには留まりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……ああ分かっている。説明に感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "いえ。こちらからも、ご協力に感謝します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "――ヒル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官ヒル",
      "text": "はい、上官。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "この若者……いや。この容疑者を、兵営に連行しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "えぇっ、なんでよ！　うちらがやっと見つけた手がかりなのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官ヒル",
      "text": "上官、彼女の矛が任務遂行を妨げているのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "うむ、あー……そうだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "バグパイプ、矛を下ろしなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "だけど、うちらの任務は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――私たちは今、ヒロック郡の管轄地域にいるのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ケリー大尉はポケットからハンカチを取り出し、額の汗を拭った。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "わかってもらえて嬉しいよ、中尉。……君と、そちらの若いヴイーヴルの女性、それからほかの諸君も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "ええと、とにかく皆、ロンディニウムから駆けつけてきたんだし、過酷な道のりで疲労も溜まっているんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "これはヴィクトリアの軍人として、我々が負うべき責務ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "確かに、その通りだな。……それで、もしこの後も君たちがヒロック郡で活動したいと言うのなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――無論、我々には引き続き、源石製品窃盗事件を調査する義務があります。ロンディニウムからの命令に基づいた活動ですので、恐らくハミルトン大佐にもご理解いただけるかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "もちろん、もちろんだとも。我々と共に、兵営へ来てくれても構わない、という話だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "隊長、本当に引き渡していいの？　絶対、わざとこうなるように仕向けられてたよ！　きっとこの人たち、うちらが郊外に入った時から、ついてきてたんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "それで、うちらがこうして捕まえたからって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "――「帝国駐屯軍には、駐屯地の治安を脅かす事件に対処する責任がある」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "彼らの行動は、規定に反するものじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "う～……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ケリー大尉。捕縛した人物は、そちらに引き渡します。ですが規定により、我々も取り調べには参加できますので――その点はどうかお忘れなく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "規定か……は、ははっ……確かに、君の言う通りだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "や、やめろ……放せ！　いやだ、行きたくない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官ヒル",
      "text": "ふん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "助けて……なあ、助けてくれよ！　俺は何もやってない……何も知らないんだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる青年",
      "text": "う、ああああっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "おい、ヒル……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "副官ヒル",
      "text": "ターラーのクズどもときたら、騒々しい奴ばかりだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケリー大尉",
      "text": "……はぁ……連行しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ちょっと！　どうしてそんなひどいことするの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "（小声）隊長、あのフェリーンのおにーさん……うちらに助けを求めてたんじゃないかな。きっと、あの人たちに連れてかれるのが怖いんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "（小声）……トライアングル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "はい、隊長。――倉庫外の樹上で引き続き待機中です。彼らには気付かれていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "（小声）助かるわ。じゃあ、あなたは偵察チームを率いて、付近の輸送ルート沿いに調査を続けて。手がかりが見つかったら、すぐに報告してちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トライアングル",
      "text": "了解。駐屯軍への報告は必要ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "いいえ。いらないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ただ……自分の安全には気を配るようにね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
