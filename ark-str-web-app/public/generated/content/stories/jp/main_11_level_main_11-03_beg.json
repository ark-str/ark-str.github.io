  "sourceHash": "339925e85d5b6eabcf6a7d9ebf138bf997a35ae0fc38110d82c36811a837f878",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "一年前\n1097年\np.m. 4:56 天気/曇天\nロンディニウム ハイベリー区 十一号軍事工場"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "早くしろ、最後の融合剤は届いたか？\nなに――まだだと！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "そいつは困ったな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "今回分の材料輸送の担当は誰だい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "そ……それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "何をもごもごしてるんだ。はっきりお言い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "……フェイストだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "まったくあの小僧ときたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "朝早くに行ったから、とっくに戻ってきてるはずなんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "ついていったのは誰だい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "トミーとパット、それとダイだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あの子たちの作業場は違うじゃないか、どうして同じ班になってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "あいつらは仲が良いもんで、いつもつるんでるからな。フェイストはまあ、言ってみりゃあん中のガキ大将みたいなもんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "トラブルのようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "些細なことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "些細なことってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "キャサリン、あんただって今日がどういった日かわかってるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "忘れるわけないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あたしは十日も前からサインの練習をしているんだよ。酷い字でサインを書いて、上官の機嫌を損ねでもしたら厄介だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "だったら、どんだけ練習しても足りないだろうな。将軍は明後日の引き継ぎ式を大変重視しておられる。都市防衛軍の方の大将も来るらしいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "タバコはやるかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "……フッ、一本もらおう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "今のところ、お前らの工場の工員は全員ぴんぴんしてる。これがどうしてかわかっているだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "そりゃ、あたしたちは一生懸命働いているからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "一生懸命ね、当然だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "確かにお前らはよく仕事をしているよ。その点に関しちゃ、言ってみれば俺たち傭兵と同じだよなぁ。仕事をして、金を稼いで、生き長らえるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "だが雇用主の連中はな、仕事ができる傭兵ほど、信用に値しないのを承知しているもんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "当然だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あんたたちが捕まえてった、例のハンフリー卿。元々この工業区画を管理していたあいつも、あたしたちを信用したことなかったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "俺の手を煩わせるなよ、キャサリン。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "傭兵の口調は落ち着いていた。これまで何度もキャサリンにタバコをたかる時と同じように。\nこれが彼の仕事だった。彼にとって、言うことを聞かないロンディニウム工員の命を奪うことは、彼女が毎日ネジを締めるのと同じ類のものだった。\nキャサリンは、ポケットの中にタバコの灰を落とした。機械の中に灰が入り込んでは一大事だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "何度も言ったと思うけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "生産効率を維持したいんなら、うちの工場の人間は一人だって欠かすことができないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "実はお前にはそれなりに感心してるんだ、キャサリン。傭兵でも、お前ほど肝が据わってる奴はなかなかいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "確かにお前には、それだけの腕がある。だが限度を見極める目も重要だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "この程度の軍事工場なんて、ロンディニウムにはごまんと存在してるんだ。お前らの工場が潰れたところで、摂政王は眉一つ動かさないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あんたの目に引っかかるようなことは、何も起こりやしないよ。明後日の引き継ぎ式では、約束のものをちゃんと差し出すし、工員も全員出席するさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "何も心配しなくていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "そういうことにしておいてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "もちろんさ。で、まだそのタバコは吸わないのかい。火を忘れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "いや、こいつはやっぱり返すよ。ロンディニウムのタバコはどうもマシンオイル臭いからな、いくら吸っても慣れねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "キャサリン、どうする？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "（タバコをもみ消す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "……荷降ろしエリアへ向かうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "パット！　どうだ、終わったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "……このネジでおしまいだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ちゃんと終わらせろよ。そうすりゃ、あいつらがもっと融合剤を欲しくても、最低あと一週間は待つ必要が出てくるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "こんなに多くの融合剤を次から次へと運んでくるなんてよ。サルカズは一体何を作ろうとしてるんだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "それが、まだ覗けてないんだよなぁ。組み立てラインに近づかせてくんなくてさ。ばあちゃんが信用してるベテラン工員しかあそこに登れないんだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "そんだけ厳重に管理してればしてるほど、サルカズにとって重要ってことだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "やっぱ武器じゃねぇか？　俺たちの作業場じゃここ数日、ずっと奴らのためにオートボウガン作ってるしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "武器だろうな。外であれだけ多くの公爵の軍隊が見張ってるわけだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "このままサルカズの思い通りになっちまったらまずいぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺たちで、奴らを止めなきゃな。サルカズの相手は俺らの同胞なんだぜ？　敵の手助けなんかできるわけねーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "ここにある融合剤を破壊したら、あいつらの痛手になるのか？　俺たちが罰を受けることにならねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "そんときゃ俺が受けるよ。捕まるのなんか怖くないかんな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "だめだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……ばあちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "……この子たちを捕らえるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "パット――やれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "えっ――？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "キャサリンは手元にあるヤスリをつかみ取るとそれを投げた。\nヤスリは、彼女の狙い通りに飛んだ。「キン」という音が響き、工員の手にあったレンチが地面に落ちた。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "くっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あんた自分が何やってるのかわかってるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺はサルカズを止めるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "バカ言うんじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "もう全部計画してあるんだ。ばあちゃんたちに迷惑をかけたりしないよ。俺がやったってサルカズに言う。それから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "――それから、サルカズの手にかかって死ぬっていうのかい。自分のことを英雄だと思ってるんだろう、ええ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "大丈夫、ちゃんと逃げるから。ずっと計画してきたんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あんたが改造したクローラーでかい？　輸送ルートに隠れて、ハイベリー区から逃げようって魂胆ならとっくに知ってるさね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "なんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "あたしはね、この工業区画で五十年以上生きてきたんだ。甘っちょろい小僧の考えなんて、当然お見通しだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ばあちゃん、聞いてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "サディアン区で反抗組織が活動してるって情報が入ったんだ。サルカズの手から、かなりの人を救い出して、いくつかの区画の奪還にも成功してるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "その組織の人は、自分たちをロンディニウム市民自救軍って呼んでるらしくてさ――俺はそいつらに参加するんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "……参加、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "それで？　参加したあとは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "えっ……何がだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "その人たちは職人が足りてないのかい？　あんたは、その人たちのために自動生産ラインでも組み立てるの？　それとも次世代モデルのクローラーを設計してやんのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "フェイスト、あんたは武器すら作れないだろうが。その自救軍を名乗る人たちに、自分はレンチでサルカズの頭をぶん殴るつもりだとでも言うのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "勉強中なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ばあちゃんも話してくれたんじゃないか！　若い頃どうやって蒸気甲冑作りの職人に選ばれたか。それに、毎晩毎晩ばあちゃんが動力パイプを研磨する音だって聞いてきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "俺、どうしても納得できないんだよ……俺たちはロンディニウムの工員だって、小さい頃からばあちゃんがそう教えてくれたじゃんかよ。俺たちの工場がどうやってヴィクトリアを作り上げたのか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "なのにさ、今はどうよ？　引き継ぎ式で俺たちの旗を降ろして、サルカズの軍旗と入れ替えなきゃいけないんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "しかもお次は、俺たち自慢の生産ラインがサルカズのために武器を製造するんだろ。最終的にヴィクトリア人に向けられる武器を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "ばあちゃんは、そんな日々耐えられるのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "……そんな日々？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "そんな日々こそが、あたしらの暮らしなんだよ。あたしやあんたの両親がずっと過ごしてきた日々さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "フェイスト、目の前のこの工場を見てみな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "肩書が名字よりも長い貴族に、ビジネスで財を成した商売人、あるいはサルカズ……主だと名乗る者たちはやってきては去っていくんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "でもね、生産ラインはまだそこにあるんだよ。機械だって止まったことはない。あたしたちが両手でかしめたリベットは、一本一本がまだあるべき場所に存在してるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "ロンディニウムの中心にある宮殿に居座ってるのが誰だろうとね、あたしたちが築いたこの都市は、明日も明後日も生きていくんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "でも、俺はそんな明日ならいらねーよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "自由を失った暮らしのどこが生活なの？　ただ死んでないってだけだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "もしこの工場が……ロンディニウムが、もう俺たちのもんじゃないなら、この都市のために俺たちがやってることは何の意味があるっつーんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "知ってるかい、フェイスト……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "二十五年前の、炎に照らされたあの夜、あんたの父親もあたしにそう言ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロンディニウム工員",
      "text": "リーダー、サルカズがもうすぐ戻ってくるぞ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "どこに行こうがあんたの自由だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "だけど今この時から、あんたは出禁だ。工場に入ることは二度と許さないよ、フェイスト。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "自分の両手で仕事を終わらせようとしない工員は失格だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "この子についていきたい者がいるなら、止めないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャサリン",
      "text": "だけど覚えておきな――この扉を一歩でも出たら、あんたらはもうウチの一員じゃないからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
