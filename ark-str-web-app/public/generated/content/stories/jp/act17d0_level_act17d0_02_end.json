{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_02_end",
  "groupId": "act17d0",
  "stageId": "act17d0_02",
  "title": "防衛範囲拡大",
  "storyCode": "OD-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_02_end.txt",
  "sourceHash": "b76fac6f08e5a08cb047041e078cc955eae68838e5b9555d7704e6de7e172c73",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "攻撃やめ！　一般人に注意！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "奴らが逃げるぞ、コーエン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "構わなくていい、他の人を守って！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "誰か手伝って、こっちにケガ人がいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "まずは彼らを安全な場所へ運べ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "先生はどこ！？　大丈夫！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "ここです！　僕は大丈夫です！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の町民",
      "text": "足がっ、足が折れた！！　ううっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "落ち着いてください！　脱臼しただけです。折れてませんからすぐ入れなおします。少しだけ我慢してください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の少女",
      "text": "ママ……ママ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "誰か！　アルガーのお母さんを見ませんでしたか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "重傷の町民",
      "text": "……助けて……たす……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "包帯が足りない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "クソッ！　*スラング*",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "あっち、火の手が上がってないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あの方向は……町の中心？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "襲われたのはここだけじゃないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "どうしてですか？　領主の衛兵隊はどこでなにをしてるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "そんな奴らなど、あてにするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "いたる所から争いの音が聞こえてくる。面倒なことになった。こんな開けた場所に留まってるわけにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "まずはそのケガ人数名を、建物の後ろへ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の町民",
      "text": "モンスターだ！　モンスターがまた来たぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の女性",
      "text": "助けて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ッ!　次から次へと！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "アレクサンドル！　屋根に登って援護を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……時間がない！　先生。ここを離れるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "でも、どこへ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "まずは先生の診療所に行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "ケガ人と患者さんたちを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ここで対応してたらキリがない、動ける人たちは自分で先生の診療所に向かわせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "誰か手を貸してください！　動けない人がいます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ケッツ、ほかに家の中に隠れてる人がいないか見て来て。この地区の人たちを、全員診療所に向かわせて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ちゃんと安全も確保するのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……ほんとにひどい災難ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "40人ちょっと……見つかった人たちは全員ここにいるのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "見つけていただいた人たちは……みんなここに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "どれくらい減ったか、わかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "結構な数だということだけは。町の方に逃げた人もいるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "それに一部のお年寄りたちは……間に合いませんでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "今は気にするな。先生のせいじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "モンスターたちは、どっから来た？　訓練されてる戦闘用のものなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "すいません、わかりません。……僕も初めて見ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "暴徒たちが武器を出した途端、呼吸を合わせてモンスターたちが地面から現れた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "そもそもどこから来たかなどどうでもいい。それより数が多すぎる方が問題だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "周囲の状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "めちゃくちゃだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "町の方から戦闘の音が聞こえていたが、何が起きたかはまだ確認できていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "弾薬の残量は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "多くない。私はマガジン四個だけ。アレクサンドルの弾を使い切ったら、面倒なことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "弾薬よりもこの建物の方が心配。もう持たない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "あのモンスターの大きさなら、1、2匹仕留め損なっただけで、ここの壁をぶち破られる。私たちじゃいずれは防ぎきれなくなる、なんとかしないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "先生、患者の状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "多くの人がケガをしていますが、こんな状況では簡単な手当てしかできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "包帯と消毒用アルコールが足りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "町を離れるという選択肢は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "町を離れるとしてどこへ向かう?　しかもこんなにたくさんの人を連れて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "そもそも食料と水がない。これで町の外へ出るなど自殺行為だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "モンスターたちがあたしたちを見逃してくれるとは思えないわ。荒野へ行けば状況はもっとひどくなるだけ。遮蔽物も身を隠せる場所もない、それにモンスターは地面に潜れる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "とある場所を知っています……。そこなら安全といえるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "町の南に、特殊な建造物があります。恐らくは町で一番安全な場所でしょう。堅牢性だけなら領主の屋敷と大差ないかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "詳しく聞かせてもらえるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "以前、ロドスという医療組織が、町外れの土地を借りたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "その後ロドスは労働者を雇い、土や石をたくさん掘って、そこに頑丈な建物を建てたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……もしかしたらこの辺りでは最も頑丈な建物かもしれません。要塞のような見た目です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "どうして「ロドス」とやらがあたしたちを助けてくれると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "あそこには一人の見張りが常駐しているだけです。僕は彼と知り合いで、彼から医療品を買ったこともあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "土や石をたくさん掘ったってことは、地下室もあるんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "傭兵のセーフハウスってところか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "当てにならなそうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺たちにもっと良い選択があるならともかく、今は行ってみることを提案する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "食料も水もないんだ、この日干しレンガ製の建物にいても、ただ死を待つだけに等しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "その建物は町の外れにあります。一度、町の外に出てから大回りしましょう、そうすれば町の中からは見つからずに済みます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ケッツ、盾はまだ使える？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "半分はなくなっちまったが、殴り飛ばすことぐらいはできる……多分な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あたしと一緒に、もう一人誰かついてきてもらう必要がある……。先生の護衛をする人がいないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "なら、俺が行こう。俺が先生の代わりに弾を受けてやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "バカなことを言わないで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あたしとケッツは先生について、その「セーフハウス」を確認してくる。ティナはここに残ってアレクサンドルのサポートをしてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "先生、今からしばらくは何が起きても、あたしの指示を聞いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ケッツ、先生をお願い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "すべてうまくいくさ。俺がいるんだからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "明かりが見えないが……誰もいないってことか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "まだ近付かないで。扉が壊されてる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……ここも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "この暴徒たちの目的は何だ？　強盗や盗賊と同じように、破壊や略奪か？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "た……助けてくれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "頼む！　誰でもいいんだ！　助けてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "わ……私はまだ死にたくない……。くそ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "ここの見張りの人です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あたしが見てくるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "……こうなるって知ってれば、こんな仕事受けなかったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "こんな所で死ぬのはいやだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "だ……誰だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "動かないで、足が折れてる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "よ……傭兵！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "殺さないでくれ！　お願いだ！　鍵がどこにあるかなんて本当に知らないんだ！　私はただの見張りなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "信じてくれ！　私は本当に知らない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "落ち着いて！　あたしはあんたを助けにきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "あ……あなたはあいつらの仲間じゃない……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "助けて！　頼む……助けてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "落ち着いてって言ってるでしょ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ケッツ！　先生を連れて、こっちへ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "オクフェンさん……足が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "あ……先生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "あぁ……よかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "落ち着いてください。僕があなたの足を診ます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "クソ、部屋がメチャクチャだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "部屋の中は、随分狭いのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "隠し扉に、仕切られた部屋、強化された外壁……。これぞセーフハウスって感じだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……これは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "これは無線？　全部壊されてるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "俺たちのよりずいぶんレトロな感じだな……バカでかい。この世界にもこういった通信手段があるとは思わなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "車があったんだもの、無線があってもおかしくはない。バカにしたものじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "住んでたボロ屋にも「廃棄家電」があった。おそらくは冷蔵庫、扇風機、ケトル……共通点として、通電の必要性がない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ここの無線設備や、前に乗った車のようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "こちらの機械には、どれもこれも黒い結晶が付けられているか、それを付けるための設備がある。これが恐らくこちらの世界のエネルギー源なんだろうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "いててて！　先生、優しくしてくださいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "大したことはないですから、ちょっとだけ我慢してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……よかった。それほどひどい状態ではありません。骨も折れてないようです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あんたがここの責任者？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "ここは……ロドスの駐在事務所で、私はただの見張り役です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "暴徒たちがここに押し寄せ、お前に地下室の扉を開けさせようとしたが、ここを守る義務があるお前はしらばっくれた。その結果、連中にぶちのめされたってところか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "……大体はそんなところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "待ってください。どうしてあなたたちが地下室のことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "かかったな？　実は俺たちはその暴徒の黒幕だ。お前に口を割らせるためにわざわざ来てやったのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "なっ？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ケッツ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "怒るなよ、場を和ませようとしただけだ。というわけで、今の話は冗談だ。本気にしないでくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "あ……あなたたちの目的は何なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "安心してください、コーエンさんたちは良い人たちですから。皆さんがずっと感染者地区を守ってくれていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "か……感染者地区も襲われていたんですか？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "め……めちゃくちゃだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "領主の衛兵隊は？　トゥラ領主の衛兵隊は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "領主の衛兵隊は来てくれませんでした。何かトラブルがあったのだと思いたいです……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "オクフェンさん、あたしたちはあんたの助けを必要としているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "私に何ができるというんです？　今は、立つことさえままならないのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "患者たちも襲われたの。感染者地区の人と建物はすべて見るも無残な状態よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "このセーフハウスを開放してほしいの。彼らをここに避難させたいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "その代わり、俺たちがお前の安全も確保してやる。俺たちを信じていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "でも……ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "ロドスとの契約で、このセーフハウス周辺の土地と、建物内のすべてがロドスの所有物扱いなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "……だから、私にはこの建物を開放する権利が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "いや……感染者たちか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "……いいでしょう。彼らを連れて来てください。命を失うよりは仕事を失う方がましですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "オクフェンさん、ありがとうございます！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
