{
  "server": "jp",
  "storyId": "act20side_level_act20side_08_beg",
  "groupId": "act20side",
  "stageId": "act20side_08",
  "title": "金属臭",
  "storyCode": "IC-8",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act20side/level_act20side_08_beg.txt",
  "sourceHash": "13dfb34ac11ef73c81db562ccd6225fe2d1b534c377304bd6332fdbaa03518ed",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ゴホンッ……お集まりのゼルウェルツァの諸君、私は環境および気象代表の、エッジ・アースハートだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "さて、皆をここへ呼んだのは他でもない、ゼルウェルツァの将来について議論するためだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "観測結果はすでに出ている。それをもとに我々代表たちが協議し、いくつか実行可能な案を用意した。本日の会議で、その中から一つを皆に選択してもらいたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "そして、最終的にこの都市をどう扱うかについても、皆で話し合いを行って決めたいと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ただし、本日の会議の進行を務めるのは私ではなく、アヴドーチャである。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "アヴドーチャ、本当に大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "ゼルウェルツァでの生活は長いし、みんな顔見知りだけど、こうして前に立って話すのは初めてだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "さあ、アヴドーチャ、出番だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "エッジ先生、少し話が長くなってしまうかもしれませんが、構いませんこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "問題ない。どうせ、私が打ちたてた記録は塗り替えられんだろう。かつて私の話で都市の半数の者が眠りに落ちたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "そんなことがありましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "ああ、確かあれは、先生がいつの間にか地質学の知識を語り始めた時だったよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "午後から夜中までずーっと話し続け、先生自身の体が持たなくってようやく終わったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "流石にそこまで長くはなりませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "行きなさい、アヴドーチャ。これは、地上人であるお前がこの地下で過ごした長きにわたる生活の、一つの集大成になるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……ありがとうございます、行ってまいりますわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの声",
      "text": "本当にアヴドーチャさんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "遠くの声",
      "text": "アヴドーチャさ〜ん！　どんな内容だろうと応援するぞ〜！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "どうして私のスピーチはこれとは違って人気がないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "最長記録保持者というだけじゃなく、あなたが取り仕切る会議は、どれも長いからじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "この小娘め、お前がいつも真っ先に寝ているのは知ってるんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "今日は寝たりしないわよ。だってアヴドーチャが普段とはどこか違うもの。一体何を話すのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感動するドゥリン人",
      "text": "よかったー、エッジ先生は確かにすごいんだけど、あの人の長話を聞くのはキツいんだよねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんきなドゥリン人",
      "text": "アヴドーチャさんは綺麗だし声もいいし、彼女のスピーチだったら何時間だって聞いちゃうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ゼルウェルツァ市民の皆様、ごきげんうるわしゅう。わらわは文学代表、アヴドーチャですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "本日、このゼルウェルツァの将来に関わる会議は、わらわが進行役を務めさせていただきますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "まず、災害を避けるため、どのようにしてゼルウェルツァから避難するかについて、わらわたちはエッジ先生と協議を行った結果、最終的に三つの方法を導き出しましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ですが、具体的な案について話し合う前に、皆様に話しておきたいことがございますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "それは、わらわの過去についての話です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "皆様がご存じであるアヴドーチャ・レザーペンの過去ではなく、アヴドーチャ・ニコライェヴナ・イワノワの過去、ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "このドゥリンの都市に来てからというもの、わらわはたくさんの物語を創作し、自身のことについても多くの方々と共有してきましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ですが、一部、誰にも打ち明けなかったことがございますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "今日はそれを皆様にお話ししたいと思いますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "わらわが生まれたのは、あるウルサス貴族の家庭でした――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アヴドーチャは、自分が何を言うべきか途中でわからなくなるかもしれないと思っていた。\nしかし実際に口を開いてみると、記憶は瞬時に流れ出てきた。\nそこで、彼女は何を言うべきかではなく、話すことが多すぎて、どこから始めればいいかわからなかったのだと気付いた。\nドゥリンの人々は、このスピーチが彼女にとって何を意味するのかわかっていない。しかし彼女自身ははっきりと理解している。\nドゥリンの都市に流れ着いてから、彼女が自分の過去を振り返るのはこれが初めてだった。\n今までの彼女は、時間が過去を風化させることを望んでいた。自分がウルサスの一部であったことを、何度も何度も忘れようとした。\nだが今になって彼女はようやく気付いた。出自を抹消することなどできないし、過去から逃れることもできないと。\nしかし、ガヴィルを見て、そして彼女のそばにいる人たちを見て、アヴドーチャはこう思った――\nたとえそうだとしても、恐れていたほどの最悪ではないかもしれないと。\n紐解かれた過去は、潮が満ちるように少しずつ彼女を包み、物語を聴くドゥリンたちをも引き込んでいく。\nだが彼女はもう呼吸ができなくなるようなことはない。そしてドゥリンたちも、語られる物語を楽しいと感じていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "スディチは一人、部屋に座り、余計なことは考えないよう自分に言い聞かせていた。\nだが、そんなことは土台無理だと彼は気付いた。\n彼はわかっている。これが自分にとって最後のチャンスなのだと。\nこのチャンスを逃せば、自分は永遠に師匠を超えることなどできないと。\nそして、ある種の予感があった。この試練に挑戦しなければ、言葉では表せない「何か」に、永遠に打ち勝つことができないだろう。\n彼はわかっていた。\nだが、決断することはできないでいた。\n彼はゆっくりと頭を抱えた。その時――\nコンコンコン──\n扉を叩く音が響いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おい、スディチ、中にいんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "居留守キメ込んでんじゃねぇ、中にいんのはわかってんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレに構わないでくれ、ガヴィル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "それは聞けねぇ相談だ、お前に用があるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ドームのことなら、キャッチの所に行ってくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "どうしてだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "これはお前がやるべきことだからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "とりあえず開けろ、入ってから話す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "絶対に入れないからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前が決められることじゃねぇよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「ドンッ」という鈍い音を立て、周囲の壁ごと扉が倒れた。そしてそこから、巨大な斧を引きずったガヴィルが悠々と入ってきた。\n彼女の目に映ったのは、頭を抱えてうずくまるスディチ。彼女の立つ場所から、彼の表情をうかがうことはできない。\nスディチの手元には、真っ白の紙があった。\nそして彼の足元には、ほんの少しペンを入れただけの紙が、引き裂かれたり、ぐしゃぐしゃにされたりして散らばっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "これは……ドームのデザイン画だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前もホントはやりたいんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ガヴィル、どうして放っておいてくれないんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あのな、お前は誰にも何も言わず、狭い部屋に閉じこもって、真っ白い紙を前に頭を抱えてんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "アタシに言わせりゃ、お前を放っておいてくれねぇのはアタシじゃなくて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前自身だろ、スディチ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "何もわかってないくせに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "知ってるさ。だから別にお前を無理やり連れて帰る気はねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "でもわかってねぇっつーなら、わかるように話せばいいだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "だったらどうして扉を破るんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "破らなけりゃ、お前は話そうともしてくれなかっただろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "完全にオレを脅してるじゃないか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "アタシは話が通じる方だぞ。もしお前がアタシを説得できれば、お前を手伝ってやれるかもしれねぇぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "アタシはな、来る途中で一つ思ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前は初めっから、ドームの改修を拒んでたよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "地上での生活ってこんな多種多様なんだね。今までアヴドーチャはそんなこと言ってなかったなぁ……そうだよね、エッジ先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ん？　何か言ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "いや、何も……というか、あなたがこんな時にぼーっとするなんて珍しいね、どうかしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "スディチの小僧のことを考えていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "スディチ？　あっちにはガヴィルとキャッチが行ってるでしょ。大丈夫だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "そういう問題ではなく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "今日のあいつの様子を見てふと思ったんだが、もしかしたら私は、これまであいつを少し追い詰め過ぎていたのかもしれない。自分でも気付かないうちにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "ドームのことを言ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ドームなど修理しなくても別にいいとは思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "しかし、観測装置が壊れて私が焦っていたのも事実なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ヴィンチが失踪した後のスディチの様子、お前も見てただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "あいつが出したドームの改修案は一つも通らず、いつからか設計部の会議にも顔を出さなくなり、一日中部屋に閉じこもるようになった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "だから私はあいつに発破をかけようと思ったんだ。それであいつが上手いこといい案を思いついたら叩きつけてくるだろうしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "そうなれば、私も手伝ってやれるはずだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "でもその結果、彼は地上へ行って、鉄道を修理してくれる地上人を連れてきちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "そうだ。まさかあいつがドームの修理を回避するために、そこまでするとは予想だにしていなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "そして私は思った。あいつがそんなにやりたくないなら、とりあえずは放っておこう。それよりも──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "源石鉱脈観測の方が急を要する。チャンスは今後また、いくらでもあるだろうと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "だが、もはやそんなチャンスはなかったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "でも、それはあなたが悪いわけじゃないよ。どっちかというと、今までずっと逃げてきたスディチが悪いでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "しかし、このドームがあいつにとって、それほど大事なものだとしたら──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "このチャンスを逃したら、一生後悔するだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "で、お前はなんでそんなにドームの修理を拒んでるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "師匠がオレに残した課題だからだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "師匠？　課題？　キャッチから聞いた話じゃ、確かお前の師匠は失踪したんじゃなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "師匠は……突然失踪したわけじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "他の誰にも言ってないけど、師匠はオレに課題を残した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレのデザインをみんなに認めさせて、ドームをオレの設計に作り替えないといけないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "それが実現した時に、師匠は再びオレに会いに来るんだそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "課題をクリアしなきゃ、師匠はいつまでも戻ってこない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前の名字もブランクキャンバスだが、その師匠はお前の親戚かなんかなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "違う。オレの名字は後から変えたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "八年前、オレは活性源石鉱脈の爆発から運よく生き延びた。そして帰る家のないオレをそばに置いてくれたのが師匠なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "つまりお前の鉱石病は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "そう。オレはその時、鉱石病に感染したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "地上ではこの病気にかかった人間を「感染者」って呼んでのけ者にするんでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ドゥリン人はそんなことしない。だけど、オレたちでも鉱石病は完治できないから、薬で症状を抑えるしかないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そこは地上と同じだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "その後、オレは名字を師匠と同じものに変えて、師匠から建築デザインを学んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前の師匠はすげぇ人なんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "当たり前だろ！　ヴィンチ・ブランクキャンバスは、この都市の前任設計代表なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレたちのデザインのスタイルは、アンタら地上人の分類方法で定義すると、多分「ミニマリズム」ってやつなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレたちが派手で大げさなデザインに異を唱えるのは、それが長年のルーズなライフスタイルが蔓延させた、際限なき欲望の象徴だからだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "このままいけば、オレたちは必ず自分たちの欲望に呑み込まれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "だから、オレたちは事物の本性を表したライフスタイルを主張してるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "事物の本性って何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……はぁ。事物の本性っていうのは、物事の本来あるべき姿のことだよ。オレたちは一切の不必要な機能を排し、物事をあるがままの姿に保たせるべきだと主張してるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "これは欲望主義の生活に対するオレたちの反抗なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あー……えーと、つまりお前の家みたいに、他とは違うシンプルなデザインってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "いや、オレと師匠のスタイルは全部同じってわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレのスタイルは師匠から派生した――しかし師匠のものとは全く違うコンセプトになってるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "都市に最高の姿で破滅を迎えさせる……生産力に余裕があるからって理由だけでそんな真似をするなんて、どれだけ傲慢で無駄なことなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "だって命には限りがあるんだよ。ましてやオレの命なんて、すでにカウントダウンが始まってるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ガヴィル、アンタも感染者ならわかるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "命には限りがある、限りあるエネルギーは、もっと有意義なことに費やさなくちゃならないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "もちろんだ。アタシだって、自身の治療のため、そして同じような境遇の人を治療するために医術を学んでいるんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "だけどよ、お前がそう思ってるんなら、なんでこの最後のチャンスをものにしようとしねぇんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……オレがそうしたくないとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "この設計図を見ろよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ここ何年もオレが失敗してきた証しだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "何度も何度も考えた。繰り返し描いて描いて、だけど、どれ一つとして採用されやしなかったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "いつからか、オレは、自分が満足できるデザインすら描けなくなったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "もはや、ゼルウェルツァの人々に問題があるのか、オレの方に問題があるのかもわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレにわかるのは、あのドームを見ると恐れが湧くことだけだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "あれはまるで師匠がオレに仕掛けた罠の檻みたいに、オレを閉じ込めて逃がさないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "たとえこれが最後のチャンスだとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレには何もできないんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "たとえ今から新しい改修案を描き上げたところで、どうせ採用されることはないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "それに……どうすればこんな短時間で、採用されるような新しい案を描き上げられるっていうんだ！？　教えてくれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "だからガヴィル、オレはアンタとは行かない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレはもう終わったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "戻ってエッジ先生に伝えてくれ。どうしてもあのドームを直したいんなら、キャッチにやらせてくれって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "あいつならきっとオレよりうまくやってくれるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前の考えは、大体理解した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そういうことなら、なおさらアタシと一緒に来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレの話が理解できないのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "理解できてるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "だけどよ、そういう話は自分の口で伝えるもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "クソッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボットA",
      "text": "スディチ危険！　スディチ危険！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボットB",
      "text": "スディチ守ル！　スディチ守ル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ん？　このロボットたちはどっから来たんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "おい！　逃げんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
