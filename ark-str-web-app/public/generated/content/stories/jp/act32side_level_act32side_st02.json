{
  "server": "jp",
  "storyId": "act32side_level_act32side_st02",
  "groupId": "act32side",
  "stageId": "act32side_st02",
  "title": "キュレーターの応接室",
  "storyCode": "CR-ST-2",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act32side/level_act32side_st02.txt",
  "sourceHash": "e49e85656b87d6875b7e5361db70a307af372782e9ad575344d65ca6c3ce7c7f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "くたびれた観客",
      "text": "ふわあ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた観客",
      "text": "レイネルって、マジで人をイラつかせる天才だよな。せっかくの開館式を、わざわざ真夜中から朝方にかけて開くなんてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する観客",
      "text": "でも、あいつのことだから、きっと俺たちに変わったものを見せてくれるだろうと思うからこそ、お前もこんな時間まで夜更かししてるんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた観客",
      "text": "別に。本当は例のコミュニティでやる芸術祭に行くつもりだったんだよ。でもなんでか中止になったから、こっちに来るしかなかっただけ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "若手投資家",
      "text": "レイネル氏の徹底した広告戦略には恐れ入りますね。開館式の具体的なプログラムを、我々のような提携先の上客にまで秘密にするだなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若手投資家",
      "text": "相変わらず、悪目立ちするのはお得意のようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン投資家",
      "text": "その広告戦略が、テラ中の美術投資家をクリスタウォワギャラリーに集めているんだぞ。軽口を叩く暇があるなら、君もバンカーヒルシティの本部にこのくらい集客してみせなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若手投資家",
      "text": "ぜ、善処します……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "崖っぷちの貴族",
      "text": "パンフレットに載っていたカジミエーシュ人か……本当に、彼のサロンに出せば私の絵は売れるんだろうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢なブローカー",
      "text": "ここはリターニアとは違うからな。君のストーリーが投資家の心を打つかどうかにすべてがかかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "崖っぷちの貴族",
      "text": "……君、全部自分に任せろと言わなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢なブローカー",
      "text": "前にも言った通り、髪を染めてボロを纏い、汚い言葉を使って、腐敗した貴族制度への反逆者を自称すれば大衆の興味を引けるぞ。君がやりたくないと言うなら、それ以上言えることはないがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢なブローカー",
      "text": "最後にもう一度アドバイスしておくと、そうした反逆者ほどではないが、没落貴族というのもなかなかウケがいいぞ。投資家を突き動かせるかは、君のパフォーマンス次第だがね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナウンス",
      "text": "間もなく開館式を始めます。皆様、お静かにお願いいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナウンス",
      "text": "繰り返します。皆様、お静かにお願いいたします。間もなく、開館式を――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ギャラリー前の広場に設置された演壇の上へ、レイネルはゆっくりと歩を進める。\n演壇下の群衆を、とりわけ近くにいる人々をゆるりと見渡して、招いた人々が皆揃っていることを確信してから、レイネルは咳払いをした。"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "皆さんおはよう、こんにちは、こんばんは――各自、自身の生活リズムに合わせて、しっくりくる挨拶を受け取ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "拍手をくれた方も、そうでない方にも感謝を。何と言っても君たちは貴重な睡眠時間を犠牲にしてまで、この「双日市」――ドッソレスの偉大なる日の出を、共に拝みに来てくれたのだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若手投資家",
      "text": "ふん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "皆さんの滾らせる情熱と寄せる期待にお礼を言おう。ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "そして、私と共に歴史を作らんとする熱意にも謝意を伝えたい。これは長く続く歴史のほんの一端に過ぎずとも、皆さんにとっては生涯忘れられない記憶となるだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢なブローカー",
      "text": "ずいぶん大げさな演説だな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "ボリバルにご加護あれ　ドッソレスにご加護あれ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "金撒くばかりの観光客　頭の中はすっからかん♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの住民",
      "text": "まるでこの都市の未来のように♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの歌手",
      "text": "なあ、ここの歌詞は変えたほうがいいんじゃないか。ちょっと伴奏してくれよ。もっといいのを考えてやるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの歌手",
      "text": "連合政府にご加護あれ　コワルスキーにご加護あれ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの歌手",
      "text": "ゴミ溜めに住む金持ちは　軍人さんとベッドでねんごろで♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの歌手",
      "text": "あの夜に野郎が生まれたよ♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "このドッソレスへ、クリスタウォワギャラリーへようこそ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "本題に入る前に、とある画期的なプロジェクトをご紹介させていただきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ここにいる全員がこの開館式を目当てに来たわけではないはずだ。「ギャラリーも開館式も、カジミエーシュの金持ち坊ちゃんが企む小賢しい広告戦略でしかない」――と考える者もいるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ゆえに恐らく、式典などより金儲けに繋がる話の方が心惹かれる人も多いはず。そこで君たちの好奇心と欲望を満たすため、さっそくプロジェクトをご紹介しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "会場の皆さんは、各々の携帯端末を高く掲げてほしい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ありがとう。君たちは優れた審美眼を備えているだけでなく、時代のトレンドにまで精通しているのだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "携帯端末というのは、実に偉大な発明だ。時間を無駄にする罪悪感から人を解放し、都市の隅々まで情報を運び、都市全体を一つに結びつけてくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "この端末という未来を拓く豊かな鉱脈を前に、私は閃いた。ここへ芸術の名のもとに採掘プラットフォームを設置して、そこから湧き出す金貨と紙幣で皆の財布を満たすのはどうだろうかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "では、発表しよう。じきに都市間ネットワークに波乱を巻き起こすであろう、偉大なる発明……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ヴァーチャルアートコレクティングだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "あんた、見ない顔だな……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "おいおい、ひどいな！　あんたの部屋の上の階に住んでるだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "ああ、たしか……ピストとかいうんだったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "そうそう、そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "でもあんた、鉱石病で入院してたんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "だからって、コミュニティがレイネルの奴にぶち壊されるのは見過ごせねえだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "確かに、そのとおりだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "なあ、ギャラリーについたら派手にひと暴れしてやろうぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "そりゃもちろん、はなっから大暴れする気満々だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "そうこなくっちゃ！　あんな野郎には、これっぽっちも同情できねえからな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "若手投資家",
      "text": "ヴァーチャルアートコレクティング？　俺たちはこんなものに出資していたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "これが普及すれば、絵具や絵筆を捨てる者が現れるだろう。なぜなら誰もが端末を用いて、都市間ネットワーク上で作品を制作できるようになり、その上それは投資の対象にもなるのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "皆さんも既存の作品と同じくそれらに投資することができる。たとえば収集した絵画のいずれかを私がネットワーク上に複製すれば、誰もが好きな時に、端末上で作品を隅々まで眺められるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ヴァーチャルアートは盗むことも複製することもできない。しかしその権利は皆さんの手に渡り、売るも捨てるも、すべて思いのまま――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若手投資家",
      "text": "――そんなの、芸術に対する冒涜だろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "私が芸術を冒涜していると？　では君の隣に座っている、恰幅のいいベテラン先生をよく見てたまえ。彼こそが、芸術を冒涜する達人に違いないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "君たちはクリエイターの考えていることや表現のこだわりなど何一つ気にもかけていない。ただ作品を好きなように解釈する権利を手にしたいだけだ。その方が、市場価格の操作に都合が良いからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢なブローカー",
      "text": "お前も、お前の父親も、同じことをしていただろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "シュチェパン・コワルスキーが芸術を冒涜していないなどと、私がいつ言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "君の横にいるその気弱そうな彼だって、君に頼んで自分の作品を冒涜することで一儲けしようと企んでいるのだろう？　見なくてもわかるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢なブローカー",
      "text": "……どうかしてやがる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた観客",
      "text": "なぁ。観客と口ゲンカするのも、開館式の一環なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する観客",
      "text": "まあ、あいつは破天荒さで有名になった男だからな。ありえない話でもないが……なあ、あんたはどう思う？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する観客",
      "text": "ちぇっ、つまんねー奴だな。ずっと端末なんか弄っちゃってさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "フン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "（小声）やはりここにいるのは、ろくでなしばかりだな。上っ面だけ取り繕った偽善者どもが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "瞳の奥にたたえた凶悪な光に悟られないように、大尉はあくまで平静を装っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ではそろそろお見せしよう。テラ全土で初となるヴァーチャルアートコレクションのお披露目だ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "演壇の下の群衆が一瞬、静まり返る。\nレイネルが理解不能な人物であることは既に誰もが理解していた。しかしそんな彼も人である以上、今の生活を維持したがるはず――つまりは資産が必要であることに変わりはないはずなのだ。\n彼との違いがあるとすれば、常識人ならルールを守り、誰もが受け入れられる平和的な方法で稼ぐのに対して、彼のように理解不能な人物は他人を見下ろしたまま金を稼ごうとするという点だろう。\nしかしそれはたいした問題ではない。なぜならそういった人物がなおも金を欲する限り、常識人にも狂人の懐の金を食らいつくすチャンスが常に存在するからだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "若手投資家",
      "text": "（小声）先生、どうします？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン投資家",
      "text": "（小声）ひとまず様子見だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン投資家",
      "text": "（小声）奴の紹介するコレクションとやらがどんなものかを確かめなくては。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン投資家",
      "text": "（小声）狭すぎる都市間ネットワーク上では、新たな投資分野にはなり得ないが、あの狂人なら、本当になにかしらの商機を掘り当てている可能性がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン投資家",
      "text": "（小声）欲する物を手に入れる手段なら、こちらにはいくらでもあるのだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "これからお見せするものには、私が近頃ドッソレスで感じた善意、誠実さ、輝き、そして美しさが込められている。それゆえ、比類なき思い出が詰まっていると言えるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ご覧あれ、作品名は――「迷惑大尉」だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "若手投資家",
      "text": "こ……これにいったい、どんな価値が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢なブローカー",
      "text": "ついに気がふれたようだな、非常識な成金め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "崖っぷちの貴族",
      "text": "ああ、もう終わりだ。アートサロンがどうとか言ってる場合じゃないぞ。こんな状況じゃ絵を売るなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する観客",
      "text": "……なあ、あのヴァーチャルアートのモデルって……もしかしてあんたじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "……なんだと？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "大尉は立ち上がり、手元の端末に目を向け、それからスクリーンを見上げ、レイネルと視線を交わした。"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "マッテオ大尉。私たちの初めてのやり取りは随分と愉快なものだったな。その記念と言ってはなんだが、君にプレゼントを用意させてもらった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "君をテラ歴上初の、ヴァーチャルアートコレクションのモデルに抜擢して差し上げたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "さあ、この中から一枚好きなものを選びたまえ。特別に無料で贈呈しよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "会場中の視線が大尉の元に集まる。\n大尉はすぐレイネルに応えることなく、まず端末に視線を向けた。\nそしてしばらくのち、レイネルの待つ返答がようやく発せられた。"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "遠慮しておこう、レイネル殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "会場の諸君。お楽しみのところ申し訳ないが、緊急のお知らせがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する観客",
      "text": "なんだお前？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "俺は、ドッソレスにおけるボリバル連合政府の代表者だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "今受け取った情報によると、このギャラリーを標的にしたテロが間もなく起こるらしい。諸君には、こちらの指示に従って避難してもらう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "取り急ぎ、ギャラリー内への移動を始めてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "遠くに、多くの人影がぼんやりと、ギャラリーへ押し寄せて来ているのが見えた。そちらからは、微かに歌声までもが聞こえてくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "さあ、こちらに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン投資家",
      "text": "断る！　まずはカンデラさんに――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "そういうわけにはいかないな。おいお前、そいつを連れていけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "士官の部下",
      "text": "はっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "来い、レイネル。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "まったく、君というやつは……僕の開館式に、とんでもないサプライズを用意してくれたな――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "誰かそいつを連行しろ。お気に入りのバルコニーで、日の出でも拝ませてやるといい。そのあとゆっくり話そうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "それと、連れていく時は必ずそいつに自分の足で階段を登らせるように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "大半の者は脅され、怯えながらも――いえ、素直に指示に従い、クリスタウォワギャラリー内に移動しているところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "ですが数人、指示に従わないひねくれ者がいまして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "なんだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "まあいい。避難が大方完了したら、そいつらの喉元にナイフでも突きつけてやれ。それでおとなしくなるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "はっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "コミュニティの連中は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隊長",
      "text": "到着までは数分かかるようです。こちらのスパイが煽動に成功したようですし、あとは奴らが広場で暴れて、テロの罪状が確定するまで待つだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッテオ",
      "text": "……じきに夜が明けるな。急ぐぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "そこを曲がれば、すぐギャラリーだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "おう、もう待ちきれねえよ。レイネルの野郎をビビらせてやらねえとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "そりゃあいい！　ギャラリーを粉砕して、ついでに奴のガラクタも残らず奪っちまおうぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "はぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "何言ってんだお前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "な……何って、ひと暴れするんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "ひと暴れってのは、ギャラリーの外で芸術祭を開いて、レイネルのメンツをメタメタに潰してやろうってことだろ。お前、何の話してんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "いや、そりゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狡猾な胡散臭い男",
      "text": "と、とにかく俺は様子を見てくる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "テクノ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "どうかした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "さっき、俺んちの上の階に住んでるって奴がいたんだけど……なんかちょっと怪しくてよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "それで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コミュニティの露店商",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "どうしたの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "露天商は口を大きく開けながら、曲がり角の先にあるギャラリー前の広場を指差した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "広場には演壇と座席が並んでおり、椅子には観客の着ていたコートすら残されているのだが……\nそこには誰もいなかった。\n人影一つ見当たらないのだ。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
