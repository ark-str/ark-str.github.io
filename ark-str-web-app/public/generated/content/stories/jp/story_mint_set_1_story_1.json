{
  "server": "jp",
  "storyId": "story_mint_set_1_story_1",
  "groupId": "story_mint_set_1",
  "stageId": null,
  "title": "デジャヴ",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_mint_1_1.txt",
  "sourceHash": "753970f8ada6db460956e5cc59b7640fb8ea26f6b842ec7228ebc199db9dc865",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（ミランダ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（教授もみんなも、手紙をくれるのは嬉しいけど、なんて長さなの……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（一、二、三……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（全然読み終えられそうにないよ……えっ、これって……何で自分の恋愛日記まで送ってきてるの！　うわ……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "何をモタモタしてるのかしら？　行きますわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あっ、はい。すぐ行きます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（仕方ない、続きは帰ってから読もう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（みんなが私のことを心配してくれてるのは分かるけど、今はまだみんなには会えないんだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（……もっともっと頑張らないと！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ミントさん、こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "スカイフレア先輩！　あっ、マルベリーさんも、こんにちは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "もう、遅いですわ！　一体何をしてらしたの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ご、ごめんなさい。でも、出発時間までまだあるんじゃ……どうしてそんなにイライラしてるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "あの、それはたぶん、私がヴィクトリアの大学のことについてしつこく聞いたせいかと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "えっ、マルベリーさんは大学に興味があるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "は、はい。ヴィクトリアにすごい大学があると聞いたことがありまして。その話をしたら、プロヴァンスさんがスカイフレアさんに話を聞くといいよって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "まったく、プロヴァンスも余計なことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "でもまあ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ちょうどいいですわね。この子をご覧なさい――こーんな気が抜けたような顔をしておりますが、これでも有名な教授の門下生ですのよ。何か訊きたいことがあれば、この子に聞くといいですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あう！　ふかいふれあへんぱい！　ほっへをつねらないでくらさい――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "うぅ、痛いですぅ……暴力反対！　暴力ダメ、絶対！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ふふっ、お二人は仲がいいんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "暴力だなんて心外ですわ。これは指導でしてよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ま、おふざけはこの辺にしておきましょう。今回の任務はこの山岳地一帯の地質調査ですわ。付近の村落から得た情報によれば、近頃は地震が頻発しているとのことで、危険度が高まっておりますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "お二人とも、防護装備の用意はよろしくて？　装着など済み次第、奥に向かって進んでいきますわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "は、はい！　準備整いました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "私も問題ありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "いいサンプルが採れたらいいな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……最初に言っておきますけど、今回の任務はそんなお気楽なものではなくってよ。また前みたいに途中ではぐれてみなさい。もう絶対に探してあげたりしませんからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "だ、大丈夫ですよぉ！　信じてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……たぶん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "フンッ、今の言葉、ご自分でしっかりと覚えておきなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あっ、先輩！　待ってくださいよー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ここですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "この洞窟をさらに進めば、観測地点にたどり着くはずです。うん、事前に行ったシミュレーション結果とも一致してますね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "すごい、データの分析だけでそこまでわかるものですか？　やっぱりプロは違いますね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "えへへ、これぐらい全然大したことないですよ！　マルベリーさんはエイヤフィヤトラさんを知ってますか？　あの人こそプロ中のプロなんです！それからアーススピリット先輩も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あっ、もちろんスカイフレア先輩もですよ！　今はアーツ学での造詣の方が知られてるんですが、大学にいた頃は飛び級で学位をいくつも取得したほどの天才だったんですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "本当ですか！　す、すごい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "お世辞なら結構よ。お喋りしてる時間があるようなら、ここのサンプル採集はきっともう終わってますわよね？　ならさっさと次のポイントまで移動しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "それなんですけど……さっき採取したサンプルを測定器で分析した結果が……見てください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "簡易的な分析の結果でしかありませんが、分かりますよね。深層における源石の活性化が著しいです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "地盤深層部にある源石の活性化ですか……私の経験によれば、この現象が発生する地域では何かしらの災害が起きる可能性が大きいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "たとえば地震……ですよね。それにここ一帯の地盤は軟らかい地層によって形成されてるようですし、あの時と似た状況で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ミントさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あっ！　いえいえ、何でもありませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "これはまだ推論に過ぎないんですから、具体的に分析するには、よりたくさんのデータが必要になりますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "貴方ねぇ……今回の目的を忘れたわけではありませんこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "も、もちろん！　任務完遂のためのデータ集めのことを言ってるんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "覚えてますから安心してください！　スカイフレア先輩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……まあいいでしょう。引き続き奥へ進みますわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "先輩、ここの数値も正常値をはるかに上回ってます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ええ、やはりですわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ここは構造的にも安定していますし、いざという時は避難所として使えそうです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "視界も空気も悪くなって参りましたわ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "――前方に感染生物確認！　下がって！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "フンッ、他愛もないですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "スカイフレアさん！　こうした狭い場所で急にアーツを使用するのは控えてください！　危険です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あはは、先輩ってば相変わらず行動派ですよね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ん？　わぁ、皆さん見てください！　あっちにあるのって、もしかしてこの間ドクターが言ってた鉱物……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "コラ！　勝手に離れないの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "今のって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ここも不安定になってきましたわね。急ぎますわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "さっきの揺れで観測した数値って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ミントさん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "へ？　あっ、大丈夫です……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ここ、歩きにくいですね……二人とも気を付けてください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……お待ちなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "どうされました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ミントが――おりませんわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "間違いない、この数値！　あの事故の時とまったく同じ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "これでコアデータさえ採れたら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……あれ、スカイフレア先輩？　マルベリーさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……はぐれちゃった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（ううっ……落ちてきた小石に当たったのかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（だ、大丈夫、大丈夫……ちょっと痛かっただけだし、防具があるから大丈夫！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（それよりも……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミランダ",
      "text": "ここまで踏み込んだ調査なんてめったにできないんだから、今度こそいいデータが採れるといいわね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な研究者",
      "text": "そう浮つくなって。今回の調査先は危険度の高い場所だぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミランダ",
      "text": "あら、心配？　防護器具があるから大丈夫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミランダ",
      "text": "それに、キミだって危険を承知で教授のゼミに入ったんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミランダ",
      "text": "「真理を追い求めるために、いかなる危険も顧みない」……それが私たちのモットーじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な研究者",
      "text": "……まったく、こうなったら何を言っても聞かないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な研究者",
      "text": "だとしても、注意すべきところはきちんと注意しなきゃ。万が一事故でも起きた場合、最悪……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "フェリーンの女の子は唇をきゅっと結び、視線を落とし、袖に包まれた腕にそっと手をやった。\nそこには、かつて出血が止まらないほどの切り傷ができていたが、今は傷跡も浅くなり目立たなくなった。しかし、その傷の周りには小さな結晶が散らばっていた。\nそれは彼女が目標を追い求めたがゆえの対価であり、感染者であることの印でもあった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（鉱石病に比べたら、こんなのへっちゃらよ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（私は誓ったんだから……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（それに、もしこのチャンスを逃したら、いつどこでこんなデータが手に入るか分からない！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（ミランダのためにも、私が必ず……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（そうだ、まずは先輩たちにメッセージを送ろう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "「……先に安全な場所へ避難してください。データを集め終えたら私もすぐ行きます……」っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……よし、これでオッケー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（結構深いエリアまで来ちゃったよね。うーん……もうちょっとだけ進もうかな。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（きゃっ！　揺れがどんどん強くなってきてる……急がないと！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（あともう少し！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（しまった、防具が引っ掛かっちゃった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（……ええい！　構ってる場合じゃない！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（あともう少し……！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（ついた、ここだ！　活性化が一番目立つ区域……！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "（やった！　このサンプルさえあれば！　これでデータを取って、詳しい分析を行えば……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "わわっ！　ここも崩れ始めてきちゃった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "まずい！　避けられな──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "このおバカ！　伏せて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "入口はもう塞がれてしまいました。こっちへ！　さあ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あうっ！　痛たた……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "あら、痛さを理解できる脳ミソは持ってらしたのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "せ、先輩……マルベリーさんも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "出口はこちらのほうです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "これだけは言わせてもらいます。ミントさん！　私今すっごく怒ってるんですからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "話は後になさい、まずは安全な場所まで避難しますわよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ちょっと待って、サンプルが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "待ちません、行きますよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ここまで来ればもう大丈夫でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ちょっと……ふぅ、はっ……息が……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "フンッ、自業自得ですわ。あとでガツンと叱ってあげますから覚悟なさい！　この場はとりあえず――わたくしよりもっと言いたいことがある方にお譲りいたしますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "そうですわよね、マルベリー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ま、マルベリーさん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "……あんな危険な状況で、勝手に単独行動をするなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "一体何を考えてるんですか！　あまりにも無責任です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ミントさんに万が一のことがあったらどうするんですか！　あそこがどれだけ危険なのかは、あなたが一番よく知ってるんじゃないんですか！？　どうしてそんな考えなしに動くんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ひぃっ！　ご、ごめんなさい！　その通りです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "でも、どうしても必要な、大事なデータがあって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "データがどうとかは私には知りません！　一番大事なのはミントさんの身の安全です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あうぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "うぅ、じゃありません！　可哀そうぶったって私には通用しませんからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ちょっといいかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ミント、貴方まさか……まだ昔に戻れるとでも思ってるんじゃないでしょうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "研究さえ完成させれば、申請を出して学校に戻れるとでも？　そうすればすべて元通りにやり直せると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "もしそうお考えなら、早めに諦めることをお勧めしますわ。貴方の教授や同級生は真実を告げるのが忍びなく言えずにいたかもしれませんが、わたくしは違いますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "いいこと？　貴方はもう、元の生活には戻れませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ヴィクトリアはロドスみたいな甘い場所ではなくってよ。いくらあなたが素晴らしい研究成果を出したとしても――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "そんなの分かってます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "これ以上言わなくて大丈夫です、先輩……全部分かってますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "それでも、私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "……どうだった！？　お医者さんは何て言ってた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "そんな……本当に鉱石病なのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "なんてことだ！　一体どうすれば……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "私のことはいいんです！　それよりミランダの容態は？　それとあの時のデータは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "……ミランダなら、まだ目を覚ましていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "データも……手に入らなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "君たちが事故に遭った直後、教授の判断で調査は中止となり、私たちも急遽引き上げたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "あんな状況で、君たちを放置して進めるわけあるか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "でも私……確かにミランダからサンプルを受け取ったんですよ！　この手にしっかりと持っていたはずです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "あの時、私たちは落石で外側に締め出されていたから、君を助けられなかった……救出された時には重体だったし、確かにずっと拳を握りしめてはいたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦る研究者",
      "text": "何も……握られてはいなかったよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あの時、私は何もこの手に掴められなかったんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "学校に戻れるかなんて、ホントはどうでもいいんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "スカイフレア先輩、私はただ、今回のチャンスをどうしても取り逃がしたくなかったんです！　もし……もしあのコアデータが手に入らなかったら、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あの時、鉱石病に感染してまで観測を続けた私や……ミランダは、一体何のために……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "だから行かなきゃダメなんです！　私……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "そういうことを言ってるんじゃありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ミントさんがどういった過去を経験してきたのか、私には分かりません。ただ、私たちは今、一つのチームなんです。ミントさん個人で判断していい状況ではありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "あなたの研究がどれだけ貴重なものだったとしても……自分のことをまず大事にしてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "私は研究のことはよく分かりません……でもスカイフレアさんならその方面の知識をお持ちでしょうし、きっと力になってくれます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "そして私は、地震が起こった後の対処方法を――どうすればお二人の安全を最大限確保できるのかを知っています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "それでも足りないというのなら、ロドスにはまだたくさんの頼れる先輩方がいるじゃないですか……なのに、なぜ自分一人ですべてを背負いこもうとするんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "でも！　これは私がやらなきゃいけないことなんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "たとえどこにいようと、どんな危機に直面しようと、私はこの研究を成し遂げなければならないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "「真理を追い求めるために、いかなる危険も顧みない」……教授のゼミに入った時、私はそう誓ったんです！　だから必ず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "いいえ！　そうじゃありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "ミントさんが研究者として真理を追い求めたいという気持ちは理解できますよ。でもそれは決して──決してミントさんが一人で重荷を背負わなきゃならないということではありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "マルベリーの言う通りですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ミント、確か貴方の教授やご学友の方たちから、手紙が届いてたのではなくて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "教授の……手紙……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "そう、手紙よ。今日持ってきてるはずでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "まさか手紙では言ってませんの？　心配のあまり、わたくしにまで連絡をよこすくらいですのに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ミランダが、ミランダが目を覚ました……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "本当だ！　本当にミランダからの手紙がある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ひっく、うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ううっ……良かっ、良かったぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ちょっ、何でこんなところで泣き出したりしますの？　見苦しいから早くおやめなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "それで？　これを知った上でも、危険を承知で火に飛び込むおつもりですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "私……ずっと、ぐすん……私の、せいで、ミランダが命懸けで手に入れたサンプルを、失くしたんだって思ってて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "だから絶対に……私が取り戻さなきゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "何やら複雑な過去をお持ちみたいですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "とにかくミントさん、もう自分の身の安全を蔑ろにするようなマネはしないでくださいね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "無茶もダメです！　必要なら私たちを……ロドスのみんなを頼ってください、きっと力になりますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ううっ……うわああああん……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ごめんなさい、ごめんなさい！　またみんなに心配をかけてしまって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あの、それでも地盤の深層部の地質データは採りたいんです……もうやったらダメなんですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルベリー",
      "text": "そ、それは……しっかり対策を練って、勝手な行動さえ取らなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "マルベリー、貴方騙されてますわよ。この子ったら絶対に反省してませんわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "「教授もずっと心配してくださってありがとうございます。ロドスにいても自分の身体に気を付けて、研究に精進します……」っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "うん……よし、これでいいかな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ここにいたのね、探しましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "スカイフレア先輩！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "どうしたんですか？　何か私に用でも……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "この前、参考文献を探してると言ってましたわよね？　役立ちそうな論文を二三見繕ってみましたの。貴方の研究課題と無関係のものもありますが、手法自体は参考になるはずよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "はい、ここにおいておきますわ。あとは自分でご覧なさいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "先輩……まさか、わざわざ私のために……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ストップ！　わたくしはただ、自分の資料を調べるついでに漁ってみただけで、ってちょっと……きゃあっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "先輩、聞いてください！　私……ついにあの深層区域の地質分析に成功したんです！　ううっ！　それでエイヤフィヤトラさんにも褒められたんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "本当ですの？　早く見せてちょうだい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "中々やるじゃありませんの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "もしかしてこのデータのために、また危ないことをしたんじゃないでしょうね？　どうなんですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "してませんよ！　ちゃんと任務申請しましたし、他のオペレーターさんともしっかりと一緒に行動しましたから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "それで改めて分かったんです、スカイフレア先輩！　私、やっぱり自分の研究を続けたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "まだまだ知りたいことがたくさんあるし、究明したい現象もいっぱいあります……だけど、結果がどうであれ、私は絶対に中途半端でやめたりしません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "とはいえ、もうみんなに心配はかけたくありませんので、あんな無茶なマネは二度としませんから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "それに、しばらくしたら友達のお見舞いにも行かなきゃですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "その時に元気じゃなかったりケガしてたりしたら、彼女に合わせる顔がありませんからね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
