{
  "server": "jp",
  "storyId": "act21side_level_act21side_07_end",
  "groupId": "act21side",
  "stageId": "act21side_07",
  "title": "忘れえぬ記憶",
  "storyCode": "IS-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act21side/level_act21side_07_end.txt",
  "sourceHash": "dbecdea9d2cab1cdced86d19e35c457f55e3aa98e60cb04bf251583d0e731aff",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "ほかのどこよりも目立たない部署の……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "評判はいいが軽んじられている部長か……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "今となっては、カラチの時のようにファミリー同士の均衡を保つための人選を行う必要はありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "あなたにも、安全で扱いやすい操り人形がご入用のはず……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "違いますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "そんな操り人形が自分からそう名乗ることはないが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ほかの人よりも自分の立場をわきまえているだけですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "はっはは……わきまえている、か。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "君の言う通り、後任の最有力候補が君であることは確かだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "だが、そこまで率直に話してもらったからには、私からも伝えておくとしようか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ぜひとも、何なりと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "カラチを殺したのは私の部下だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "君は勇気ある人だし、そういう人間と話をするのは嫌いではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "だからチャンスをやるとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "この部屋を出て、今の話を忘れたまえ。そうすれば、君は無傷でいられるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "そのあとは家へ帰って妻や娘と和やかに過ごし、この都市最後の平和な時間を楽しむといい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "――あなたの目的を思えば、なおさら私のような操り人形が必要ではありませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "ほう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "目下、あなたは混乱をお求めのはず。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ミズ・シチリアが定めた秩序を覆そうとお考えなのでしょう。ですがあの方の統治下にせよ、それ以前にせよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ファミリー間の闘争はずっと、一般市民には無関係なことでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "何かが起きたとして、我々にはただその結果を待つことしかできません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "つまりその点で言うと、この国を治めるのがミズ・シチリアであろうが、あなたであろうが、私たちのような普通の人間からすれば何一つ変わらないということです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "しかし、どうあれ最後の勝者には、表面上の秩序を保たせる誰かが必要になるでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ドンであられるあなたなら、この道理をよくおわかりのはず――"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "一般人はマフィアがいなくとも生きていくことができますが、逆はそうとも限りません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "強者は自分たちのほうだと言いたいのかね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "弱者が自らを正当化しようとしているだけのことですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "大した「正当化」があったものだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "だが、それは真の目的を語るものではあるまい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "敬愛なるドン・ベルナルド……私は権力が欲しいのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "私は幼い頃より、この顔とひ弱な体格を理由に、周りから見下されてきました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "マフィアから受けた抑圧よりも、そうした周囲から受けた抑圧のほうが、私にとっては大きなものだったのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "これまで耐え忍んできたのは、このチャンスを得るためでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ですから、あなたがカラチを殺させたと仰った時……今日来たことは正しかったと思いました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "大変失礼ながら、あなたがミズ・シチリアに勝とうとなさっても、それは恐らく難しいことでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ですが、どちらが勝つかはさておきとして――"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "私に権力を与えてくださるとすれば、それはあなたなのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "君は実に正直だな、ルビオ。私はそういう人間を友とするのが好きでね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "おや……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "ドン、失礼します……（耳打ちをする）"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "では、今日は引き上げるように伝えたまえ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "はい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "わっ、今の何！？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "向こうの部屋……揺れてへんかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "へえ？　テキサスはキミたちを選んだみたいだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "えっ……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "この震動はジョヴァンナのアーツだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "二人は決裂したんだろうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "うわ！？　見て、テキサスが窓から飛び出してきたよ！　あたしたちも行こう！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "うん！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "ねえ、テキサス……もしもの話だけど。あの時、キミと友達になってたら、シラクーザに引き止めることもできたのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "アハッ、ううん。無理だろうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "ボクたちは、死ぬまで殺し合うしかないんだから。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "speakerId": null,
      "text": "頼むよ。俺に……手を下させないでくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "speakerId": null,
      "text": "こっちにも仕事があるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "speakerId": null,
      "text": "あんたが来世はシラクーザに生まれずに済むよう祈ってる……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "待ってください。"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "speakerId": null,
      "text": "……あんたは？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "そちらは……サルッツォファミリーの方ですね？　今回の件は……もう終わりましたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ドン・ベルナルドが撤退命令を出したんです。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "ラヴィニア、君はここにいるべきではないだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "あなたには関係ないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "君がサルッツォの仕事を邪魔したとあれば、両家の関係を壊すことになる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "……ふ、ふふっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "だったら、私の首を手土産に、アルベルトにお詫びでもしたらどうかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "お待ちください、監督……いえ、ドン・ベルナルド……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "無理を承知でお願いしたいことがあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "何かね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "レオントゥッツォさんは、今後ご多忙になるでしょう。以前カラチを手伝ってくださっていたように、私にお力添えいただくことは現実的ではないと思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "つきましては、新しい助手をつけていただけませんか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "こちらの裁判官さんであれば、申し分ない人選かと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "なるほど、それもありだろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "……何の話ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "おっと。すみません、ラヴィニアさん。ご本人の意見も聞かず話を進めるところでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "つい先ほど、ドン・ベルナルドのご決定がありまして。不肖私――前食品安全保証部長のルビオが、カラチに代わり建設部長に就任することになりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "ですが正直なところ、私には関連業務の経験があまりなく……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "そこで、豊富な経験をお持ちのあなたに、ぜひお力を貸していただけたらと。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "（ソラたちは無事だろうか……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……なぜお前……いや、あなたがここに？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "人間、老いると悠々自適に暮らせる場所を求めるものでね。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "いたぞ！　あそこだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "取り囲め！"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "道を譲る気はないようだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "あの一件以来、彼女は今でも君のことを大層心配しているんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "私はというと、歳を取ってからは若い人の世話を焼くのが何よりの楽しみでね。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "この年寄りとここでお喋りでもしていきなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……またの機会にさせてもらおう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "クロワッサン！？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "あっれ～、こんなところで一匹狼気取ってんのは誰かな～？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……お前たち、なぜここに……"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "あたしの観察によると――シラクーザマフィアさんは社風として集団戦がお得意なんだと思うんだよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "一方でうちの社風は――"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "パーティー大好き？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "いや、この場合は――"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "顧客に合わせた「おもてなし」ならお任せ、だろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "大正解！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "ねえおじいちゃん、マジメな話、同族のよしみで大目に見てもらえたりしない？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "アホ言うてる場合かっちゅうねん。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "ふむ、一理ある。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "シラクーザの雨期は長い。若い時はどうとも思わなかったが、今では節々の痛みもあるしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "若人たちよ。闘争心を持つのは結構だが、健康にはくれぐれも気を付けなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "えっ、ほんまに退いてくれるん？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "やーりい！　ありがと！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "そういえば、おじいちゃんとお喋りしたくなったら、どこに行けばいい？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "君が救済を求めるのなら、私になすすべなどないが……"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "君が秩序を求めるのなら、私はどこにでも在るだろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……よし、この場を離れよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "オッケー！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ドン……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "状況は？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ベッローネの連中は撤退しました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "そう、よくやってくれたわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "チェリーニアはどうしました？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "行ってしまったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "行ってしまった……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "彼女には私を殺せないし、私にも彼女は殺せないもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "戻って事に備えましょう。ベッローネはこのまま引き下がったりなんてしないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "……わかりました。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "あんたの勝ちだな、レオントゥッツォ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "ウォラックを引き込むのはドンの考えじゃないんだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "だが、あの状況では最善の選択だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "……げほっ、ごほっ……まあ、否定はしないさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "もう喋るな。車まで連れて行ってやる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "レオン、お前はまだ諦めてないんだな？"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "この程度の挫折、ラヴィニアが向き合っている困難に比べれば何でもない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "……お前はいつか大きなことを成し遂げられる人間だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "いつか本当に、お前の理想をこのシラクーザで実現できる日も来るかもな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "その時は俺の右腕になってもらうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "俺はラヴィニアさんとはそりが合わないんだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "お前と彼女では、任せるべき内容が違うだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "ははっ、お前ってやつはもうそんなことまで考えてるのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "……ディーマ。俺はまだ、お前と親父の策略には怒りを覚えてる。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "親父がどうしても今、事を起こすのにこだわっている理由もわからないしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "それでも、結局俺はこのファミリーの一員なんだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "無事とうちゃ～く！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "はぁ……はぁ……やっぱり自分たちの拠点のほうが落ち着くね……"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "ふぅ……あの人たちしつこかったね。お陰でへとへとだよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "ソラ、大丈夫？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "うん、ドレスが少し破けちゃったけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "えっ、それめちゃめちゃ高いやつだよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "あはは、まあ何とでもなるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "それじゃ、はい。一人一本ね！"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "ほら、そんな顔しないでくださいよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "あたしたちは偶然この街へ旅行に来てただけ、とでも思ってくれたらいいですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……それにしても、なぜ役者をやっているんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "あー……ついでに仕事を開拓してみようかなーと思ったんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "それに、このほうがテキサスさんを見つけやすくなる気がして。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "結果的に、目標は達成しとるしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "確かに。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一瞬、その場に沈黙が落ちた。\n避けられない問題が頭に浮かんだのだ。\n――この先どうするべきか？\nテキサスには、それを口に出すことができなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "なあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "――テキサスさん。あたし、監督と約束したんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "というと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "あなたを見つけたあとも、引き続き役者としての契約を終えるまで舞台に立つ、って。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "だが――"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "監督と直接やりとりしたんですよ。今考えると少し怖い気もしますけど、あの人はあたしたちを人質にしてあなたを脅すような人じゃないと思うんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "確かに、あのおじさんにその気があれば、あたしたちもうとっくに捕まってるもんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "うわ、やめーや……聞けば聞くほど怖なってくるわ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "とにかく、あなたを探すついでに観光するつもりだったので……こういう危ない状況じゃなければ、案内してもらいたかったんですけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……ああ、事が終われば、必ず。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "何はともあれ、まずはお祝いしようよ！　ペンギン急便四人組の再会を祝って！"
    },
    {
      "type": "dialogue",
      "speakerName": "四人",
      "speakerId": null,
      "text": "乾杯！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "そんで、一番大事なことやけど――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "知らない番号からだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "ここの番号は誰にも教えてないはずなんだけど……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "はい、もしもし……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "ソラ君か。無事でよかった、安心したよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "……テキサスさんのこと、お耳に入ってますよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "落ち着きたまえ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "おそらく、ペンギン急便の面々は今再会の喜びに浸っているところだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "私もそれを邪魔立てするつもりはない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "ただ、君から私に聞きたいことも色々とあるだろうと思ってね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "――明日、劇場で待っているよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "……わかりました。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
