  "title": "旋回",
  "storyCode": "3-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/main/level_main_03-03_end.txt",
  "sourceHash": "63222d41afc61f782a95f2f06ebb43b784dbe397cff2fcd27bc2cf644b2e7bd0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "見ろ、ミーシャ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "う、うん……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "これが、トリガーだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "こうやって弾を込めて……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "狙いを定めたら、トリガーを引く。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "そうすれば、弾が飛び出していくから――"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "次は、グリップを握って。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "精神を集中させたら……アーツを放つんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "そうすれば、飛んでいった弾薬が爆発する。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……私に、できるのかな……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "できるさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "お前には、俺と似た力を感じるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "さあ、想像してみてくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "この源石を握って……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "っ、う……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "集中しろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "――"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "ちょっとだけ……手のひらが、熱いような。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "よし、その調子だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "ミーシャ、やっぱりお前は……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "っはは、そうだ……そうだよな。はは、はははっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "だって、お前は俺の……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "――スカルシュレッダー！　ここを離れよう、撤退だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "この場所には、もういられそうもない！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "ッ、何が起きた！？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "ロドスが襲撃してきたんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――なっ……！！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "あのクソ野郎どもが……！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "慌てず立て直せ、反撃に出るぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "っ、スカルシュレッダー……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "ロドスが相手なんだったら……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――奴らと話し合えって言うのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "だって、あの人たちは絶対感染者の助けになってくれるから。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "俺の仲間は何人もロドスに殺されたんだぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "あいつらは全員感染者だったのに――"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "ロドスは、皆を助けたりなんかしなかった！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "なのにお前は、そんな連中と話し合えって言うのか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "一体……何がそんなにお前の目を曇らせてるんだ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "そ……そんなこと、言われても……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……悪い。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "つい、腹が立って……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "だけど、本当に――"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "感染者にはようやく、レユニオンという希望の光が訪れようとしているところなんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "それなのに、ロドスは……あの連中は、自分たちだって感染者のくせに、俺たちを傷つけて、殺そうとまでしてくるんだぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "どう考えても、奴らは裏切り者じゃないか……！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "そんな奴らと何を話せって！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……でも……感染者同士で殺し合う必要なんて、どこにあるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "だったら、どうしろって言うんだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "仲間が死んでいくのを、黙って見過ごせばいいのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……心配するな。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "俺たちが、お前を守るから。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "お前は、戦いに巻き込まれないように……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "自分をしっかり守ってくれたらそれでいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……気をつけろよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "あなたこそ……絶対、戻ってきてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "やっと会えたんだから……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "もちろん。必ず戻ってくるさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "だからその時は、一緒に帰ろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……うん。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "ハア～イ、ごきげんよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "もしかして、あたしの助けが必要かしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "ああ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "実は……今の状況が、タルラの予想とは少し変わってきてる気がするんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "思ったより敵が手強くてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "だから、お前には何があってもミーシャを守ってもらう。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "守る？　あたしにそんな義務ないと思うけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "いいや、ある。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "OK、OK……わかったわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "だけど、ミーシャを守るだけじゃ足りないわよねえ？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "あんたたちがしくじったら、あいつらは絶対追いついてくるもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "何か、考えでもあるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "あら、前にも教えてあげたと思うけど？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……それなら覚えてる。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――Dr.{@nickname}……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "あいつを始末すれば、戦況は一気に逆転する……そうだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "ご名答～。簡単な話でしょ？　向こうの指揮官を殺すだけだもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "――いつもウサギちゃんのすぐそばにいる、フードを被った誰かさん……"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "戦場でのロドスは、すべてがその指揮下にある。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "つまり、あいつさえ殺しちゃえば……あはっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "ロドスのブレインは死んだも同然よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "そうなったら、何もかもが楽になるでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "とはいえ、こっちは人手も減っちゃったし、使える戦術にも限りがあるしで……やるとしたら、そうねえ。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "採掘場の近くに、待ち伏せに持ってこいの場所があるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "うちの術師に援護させるから――やることはわかってるわよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "連中の誘導は部下にやらせるし、あんたは心配しなくていいわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "だから、チャンスをきっちり生かしてちょうだいねえ？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……わかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――ミーシャのこと、頼んだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "はいはい、任されてあげますとも。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "char_1504_cqbw",
      "text": "それじゃ……幸運を、な～んてね。"
    },
    {
      "type": "sceneBreak"
    }
  ],
