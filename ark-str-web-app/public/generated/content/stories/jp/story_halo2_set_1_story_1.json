{
  "server": "jp",
  "storyId": "story_halo2_set_1_story_1",
  "groupId": "story_halo2_set_1",
  "stageId": null,
  "title": "イェラグの休日",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_halo2_1_1.txt",
  "sourceHash": "3c63436657f7a9ba45950c2d327ac26e9381d1b16864473e7ed8572abac95ec1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "また日付変わるまで居残っちゃった。はぁ……イェラガンドについてのレポート、早く仕上げないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "それにしても、まさか自分のレポートに「巨獣」なんて言葉を使う日が来るとはね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ん……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "あっ、ミュルジス主任。どうしてこちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "やっぱりエレナだったのね！　こんな時間まで残ってるのは、あなただろうと思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "あなたったら、観測所に戻ってからもう一ヶ月近く、ずっとレポートを書いてるじゃない。そんなに根を詰めなくてもいいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ですが、データの整理にすごく時間がかかっていて……それに、一部の経験については研究室で再現して検証しないと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "はいはい、その辺にしなさい。あなたが二日くらい休んでも、科学は後退したりしないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そういえば、観測所の研究員たちは明日から休暇に入るはずよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "でも、確かあなたは、イェラグに残るって申請してたような？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "まさかと思うけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "そんな目で見ないでください、主任！　仰りたいことはわかってますよ。大丈夫です、こっそり残業したりなんてしませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私、あの天災が起きる前は、ずっと観測所にこもっていて、ほとんど外に出たことがなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "天災が起きた直後に一度下りてはみたんですけど、ご存知の通り、あの道のりはちょっと……楽なものではなかったので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そうね、あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "だから、今回の休暇では、イェラグをじっくり見て回りたいと思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "そういうことなら安心ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "ここに来たのは、あなたに連絡があったからなの。イェラグで休暇を過ごす研究員には、休暇の初日に現地ボランティアがガイドとして付いて、環境に慣れる手伝いをしてくれるんですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "明日の朝早く、ボランティアがあなたを待ってるから、忘れないようにしてね。そのためにも、すぐに休んでちょうだい。寝坊して予定を台無しにしたら大変だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "わかりました……でも、あと数百字で書き終わるので、それだけパパッと終わらせてからにします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "はぁ、仕方ないわね。あなたには敵わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "とにかく、明日は楽しんできてね、エレナ。チーズフォンデュも忘れず食べるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "はい、もちろん。今度こそ絶対食べるつもりです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "キミは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あれ？　あたしのこと忘れちゃったのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "若き狩人が服についた雪を払い落とすと、その左肩に乗った裂雲獣が、エレナに向かって興奮気味に鳴いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "（小声）大丈夫だよ、裂雲獣。エレナはちょっとドジだけど、数日会わなかったくらいであたしたちを忘れたりなんかしないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ジョアンナ、全部聞こえてるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……まあいっか。昨日主任から聞いた話だと、初日は現地のボランティアが案内してくれるらしいけど、もしかして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "うん、あたしがそのボランティアだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "この間、あんたたちのとこの人が、ボランティア募集って張り紙をあちこちに貼っててな。弟と妹を迎えに行った時、偶然それを見たから、申し込んでみたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "ボランティア探してたお姉さんが、あたしをすごく気に入ってくれてさ。一目見て「一番地元民っぽい」って思ったんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "まあ、その格好を見れば確かにね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "んーと……じゃあ、先にエンヤに会いに行くのはどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "エンヤ様は巫女様なんだから、お出かけに誘ったってあちこち歩き回れるような立場じゃないし、そもそも今は状況が状況だから、蔓珠院を離れられないと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あっ、まさかあたしのこと信じてないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "いやいや、そういうわけじゃないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "だったらいいだろ。行きたいところを言ってくれたら、ちゃんと連れてってあげるからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……行きたいところ、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "これから山を下りるとなると、お昼近くになっちゃうけど、実は私まだ朝ご飯も食べてなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "美味しいチーズフォンデュが食べられる、おすすめのレストランとかある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "チーズフォンデュ？　なんでそんなもの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "え？　まさか知らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "キミ、本当にイェラグ人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あのなあ、あんたがイェラグ人の何を知ってるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "チーズフォンデュくらい知ってるけど、あんなの街の連中だけが有難がって食うもんだろ。うちで焼いた肉や燻製ソーセージのほうが絶対美味いって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "でも、クルビアの旅行ガイドブックでは、「各国で絶対食べたいグルメランキング」のトップ10に入ってたよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あんたらクルビア人が何を美味いと思うかなんて知らないけど、このイェラグで一番美味いものって言ったら、山の幸に決まってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "それじゃあ、どうするつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "今から狩りに出るのはさすがに遅すぎるし、うちの備蓄もちょっと足りないんだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "でも、山に住んでる狩人なら、誰でも多少は獲物を備蓄してるはずだから、今からその人たちのところに行けば、良い時間に昼飯にありつけると思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "みんな親切で敬虔な良い人たちだから、心配いらないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私のチーズフォンデュ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "ああもう、チーズフォンデュなんていつでも食べられるだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "夜には街に行くようにするし、今はあたしについてこいって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "待って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……もっとゆっくり歩くって約束してくれるなら、ついて行くよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "やっと麓に着いたな。エレナ、こっち向いてくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私は雪合戦をしに来たわけじゃないんだけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "別にそんなことする気ないぞ。これはイェラグの伝統なんだ。雪を額に塗って、道中の安全をイェラガンドにお祈りするんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "でも今の、塗るって言うより投げつけてなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "意味があってればいいんだって。あたしたちイェラグ人は、きっちりお作法通りに～とかそういうのは苦手なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "適当なこと言わないで。蔵経閣にはたくさん書物があるんだから、その中に礼儀作法の本くらい――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あっ！　額の右側、全然塗れてない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ジョアンナ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "へへっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "待ちなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "うわああっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "しっかり掴まってろよ、エレナ。ソリから落ちても知らないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "いくらイェラガンドにお祈りしたからって、こんなボロボロのソリで林の中を突っ切るなんて、とてもじゃないけど安全だとは言えないんじゃ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裂雲獣",
      "text": "ゴロゴロ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "おまけに裂雲獣までくっついてるし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "ボロボロってどこがだよ？　イェラグのソリに乗りたくたって乗れない人もいるんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "もうちょっとスピード上げるからな。まあ慌てるなって、もう少し慣れたら楽しくなってくるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "うわあ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "ふぅ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あの災厄以来、ずっと天気が良くなかったから、こんなに良い天気は久しぶりだな。裂雲獣も嬉しそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裂雲獣",
      "text": "ゴロゴロ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "……あれ？　エレナ、どうしてまだ追いついてこないんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "羽獣が飛ぶより、速く進んでる、キミに……どうやって、ついていけばいいの……げほ、ごほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "これくらいでへばってるのか？　あたしたち、一緒にカランドにも登っただろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "あの時は……え、エンヤが時々、待っててくれたけど……キミは、全然……げほげほ、ごほっごほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私は、ご飯が食べたいだけで……トレッキングしに来たわけじゃ、ないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "じゃあ、しばらく休みなよ。待っててあげるからさ。それでいいだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "げほっ、ところで、あと、どれくらい歩くの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "ほんとにあとちょっとだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "この山を越えて、三十分も登れば家が見えてくるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その時、裂雲獣が、カランドに登った時のようにエレナの肩に乗った。\nしかし、思わぬことに、それが一人の科学者に「トドメ」を刺してしまったようだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あっ……れ、裂雲獣――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジョアンナとその小さなペットは、思わず呆然と立ち尽くし、顔を見合わせた。エレナはそこに倒れこみ、ぴくりとも動かなくなってしまっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "な、ななな、何やってんだ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "ライン生命の研究員を死なせちゃうなんて！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裂雲獣",
      "text": "ゴロゴロ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "そ、それもそっか！　エレナはこのくらいじゃ死なないよな。だって、どんな困難も乗り越えて、イェラガンドに謁見した人なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "エレナ！　大丈夫か？　絶対死ぬなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あんたが死んだら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "！　動いた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "げほ、ごほっ、うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "だけど、冷や汗でびっしょりだし、咳き込んで泡吹いてるし、唇も青紫になってるし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "どうしよう、どうしよう……クルビア人ってどうしてこんなに身体が弱いんだ？　イェラグ人でこんなふうになった奴なんて見たことないぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "……このままにしてちゃダメだ、すぐに誰かに診せないと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は身をかがめると、エレナの服を掴んで引き上げ肩に担いで、手足を両腕でしっかりと抱え込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "よいしょ――よいしょ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "エレナ、持ちこたえてくれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "こうやって運ばれるくらいなら、いっそ矢で射抜いてもらったほうが楽になれるかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ごほっ――本当に死にそう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "残された力を振り絞ってそう言うと、彼女は目を閉じた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「さあ、ジーニ。あなたがお父さんの語る星の話が好きなのは知っているけれど、もう寝る時間よ。」\n「ん？　自然の中で、星を見てみたいと？　お前はまだ小さすぎるからな。もう少し大きくなったら、一緒に一番高い山へ行って、たくさんの星を見に行こう。それでいいだろう？」\n「そんな顔をするな。今度こそ本当だ、父さんも母さんも約束するよ。いつかは満点の星空の下で、笑顔で眠れる日が来るさ。」\n「なにしろ、お前の名前は『星々の源』という意味だからな……」"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "目が覚めたみたいだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ここは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "山の上の診療所だよ。このお医者さんが助けてくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……あ……ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "礼には及びません。煎じ薬では、症状を和らげることしかできませんからね。今はゆっくり休んでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "先生、エレナはどうしちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "イェラグの山は高すぎますから、外国の方の多くはそれに順応できないのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "通常の状況であれば耐えられたかもしれませんが、エレナさんの場合、ここに来た時点で、過度な運動で体力を消耗しきっていたのは明白でした。そのせいで症状が重くなったのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "本当にごめん！！　裂雲獣、一緒にエレナに謝ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裂雲獣",
      "text": "ゴロゴロ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "いいって、大丈夫。悪気がなかったのはわかってるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "とりあえず、起き上がらないと――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ベッドから下りようとしたエレナは、思わずよろめいてしまった。そこへジョアンナが素早く駆け寄り、彼女を支える。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "頼むから、無理に動かないでくれって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "平気だよ、なんともない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "あまり心配しすぎずとも、大丈夫ですよ。すぐに回復されるでしょうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……先生がこの診療所を開いていてくださったおかげで助かりました。そうでなければ、どうなっていたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "お役に立てて何よりです。この診療所は、こちらの山に狩人が多く住んでおり、麓まで降りるのは不便だという理由で、医者を派遣してほしいと蔓珠院宛に要請があり、作られたものなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "そこで、当時ちょうど蔵経閣で医術を学んでいた私が、アドソ長老の命でここに配属され……それからもう十年ほどが経ちました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "しかし、数年前カランド貿易が街に病院を建てたものですから、ここ何年かは皆面倒でも街の病院へ行くようになり、私もだいぶ暇になりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あの、先生、ところで私の件は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "ああ、ミアさん。すみません、あなたのことが後回しになっていましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "先日出した新しい胃薬の効果はいかがですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "それが、全然効かなくて。お腹がまだ痛むんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "おかしいですね。街の病院には行ってみましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "街の人は信用できません……あの人たちの処方する化学薬品を飲んで、別の病気になった人も多いと聞きますし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "はぁ……ひとまず、お座りください。書籍を頼って、何か方法を考えてみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……もしかすると、お役に立てるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私が持ち歩いている機材の中に、超音波で画像を映し出す装置があるんです。それを使えば、なんとか臓器の検査ができるそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "でも、それって街の人のやり方ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "それの何が悪いんだ？　使ってみても損はないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "いえ……こんなもの見たこともありませんし、やっぱりやめておきます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "ねえ、一緒に説得しよう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "違いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "エレナ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "これは、街の人のやり方などではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "この道具は、あのお方が祝福をお授けになった神秘の道具なのですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その言葉を口にした途端、彼女は自分でも驚愕していた――それは紛れもなく、かつての彼女が何よりも嫌悪していた神秘学的な言い回しだったからだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "あのお方とは……イェラガンドのことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私は巫女様に同行した際、まさにこの装置を用いることによって、あのお方の真の姿を垣間見ることができたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "周知の事実として、あのお方が容易く姿を現されることはありません。このことからわかるように、この装置があのお方を感知できたのは、あのお方のお許しを得たからにほかならないのです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は傍らの狩人に視線を送り、眉をひそめてみせた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "……エレナの言う通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あたしもエレナも巫女様の従者としてついて行ったから、巫女様がイェラガンドに謁見された時、あたしたちももちろんその場にいたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "そうそう、巫女様が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "確かに、巫女様がお戻りになった時、二人の従者がずっと付き従っていて、一人は異邦人だったと聞いたような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "それでは……どこであのお方にお会いしたのですか？　あのお方は何と仰いましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あのお方は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "（小声）何て言ってたっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "「我が居所ではなく、我が心に求めよ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "我々は、あのお方の……この大地における神秘の前には、皆無知蒙昧なものなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ゆえに、自らの常識に背き、禁足地へ足を踏み入れる勇気を持たずにいることは、それこそ本当の愚かさだと言えるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "わかりました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの女性",
      "text": "私は、あなた方を信じます。それで、検査してもらうにはどうすれば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "では、上着を脱いでおいてください。私は準備をしてきますので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "ふぅ……本当にありがとうございます。あなたのおかげで、彼女が胆石を患っていることがわかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ですが、私の検査は受けてくれても、やはり病院での治療は望まない様子でしたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "次にミアさんが薬を取りに来た時に、私からもう一度説得してみます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "お願いします。あれは薬で簡単に治せる病気ではありませんから、もっと強く説得しておけばよかったと少し後悔しているんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "……ミアさんは賢い人です。「神秘の道具」という言い分を本気で信じたわけではないのでしょうが、それでも診断のために検査に同意してくれました。それが、現状彼女にとっての限界なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "賢い人ほど、自分の考えに固執してしまう傾向があるものです。だからこそ、そうした人々の心の中の先入観は、常人よりよほど根深いものとなってしまうのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "身をもって体験しない限り、そこから逃れられる人などいませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……先生も、同じような経験を何度もされてきたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "ええ。かつては私も、カランド貿易のもたらす新しいものが好きではありませんでした。ですが、今日のように、その有用性を目の当たりにすれば、それを認めざるを得ないものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "そうして今では、状況は逆転してしまいました。大勢の人が私に対して偏見を持ち、古いものや過去のものはすべて偽物だと決めつけるようになったのです。これは私にはどうしようもないことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "とはいえ、いつの日か、人々がこうした古いものの良さに気付き、それと同時に自らの視野の狭さに気付く日も来るかもしれません。ははは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "さて、ミアさんに代わってあなた方にお礼をせねばなりませんね。もうすぐ日が暮れますし、夕食でも食べていきませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "えっ、夕飯？　何を出してくれるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの医者",
      "text": "そうですね……今あるのは野菜と、あとは燻製ソーセージが二本ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "やったな！　エレナ、聞いたか？　美味いもんが食べられるぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一足先に夕食を終えたエレナは、診療所の外で散歩をしていた。室内からはまだ食事中のジョアンナと医師が談笑する声が、微かに聞こえてくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "これが……イェラグの星空……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は両手をこすり合わせた。吐き出した白い息は、あっという間に山風に吹かれて夜の色に溶けていく。エレナはゆっくりと前へ、ほとんど手が届きそうな星空のほうへと歩き出した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "なあ、良い知らせだぞ！　今粘りに粘ってお願いしたら、残り半分のソーセージも焼いていいって先生が言ってくれたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "もうちょっとしたら、それを食べさせてもらおう。そのあとは、観測所まで送るよ。食べきれなかった分は全部持たせてあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "……エレナ？　また気分が悪くなったのか？　どうして黙ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……ああ、心配しないで。ちょっと考え事をしてただけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "考え事って、この空のことか？　ずっと見てたみたいだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "うん……何の機材も使わずに、こんなにきれいな星空を見たのは初めてなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "へえ。あたしは子供の頃から見てるから、別に珍しくもないけどなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "実はね、ジョアンナ。私たちウビカ家の人間は、占星学を研究してるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "今は両親とはかなり険悪なんだけど、小さい頃はよく、望遠鏡で星を見るために外へ連れて行ってもらってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "だけど、夜中にカーテンを開けて肉眼で見る星は、すごく暗くて……両親に聞いても、その理由はわからないけど、街中だと野原や山にいる時ほどはっきり見えないって教えてくれただけだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "結局その疑問は、種みたいに私の心に植え付けられたんだ。答えを見つけられない自分の愚かさに、腹が立ってさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "その後少し大きくなってから、図書館で「大気中の乱気流」や「光害」って言葉を知って、やっと合点がいったのを覚えてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "……あたしは星のことなんかわかんないけど、たまにはちょっとくらいバカで居てもいいんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "その話だって、あんたが自分をバカだと思ってなかったら、図書館で答えを探そうと思わなかったかもしれないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "キミの言う通りだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "そういや、あんたの両親は、どうして星を見るのが好きかを話してくれたことはあるのか？　その、なんだっけ、占星学ってやつのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "どうしてって……家業だからやってるだけで、好きも嫌いもないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "うちにも代々、狩りや彫刻が伝わってるけど、ご先祖様たちがそれを好きじゃなきゃ、こんなに長く続けてないと思うんだよな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……そういえば、母さんからご先祖様の言葉を教えてもらったことがあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "「美と未知」が鍵なんだって。美は人々に未知を見つめさせ、未知は人により深遠な美を感じさせるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "多分それが、ご先祖様が最初に星空を見上げた理由なんだろうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "んー……あたしには難しい話だな。修道士たちが『イェラガンド』を読み上げてるのを聞いてるみたいに感じるけど、悪いことを言ってるわけじゃないのはわかるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "結構話し込んじゃったし、そろそろ山を下りるか。焼きソーセージを包んでくるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……ありがとう、ジョアンナ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "現地の研究員",
      "text": "やあ、エレナ。今日は楽しかったかい？　ほかのみんなより、随分帰りが遅かったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "最終的には楽しかったんだけど、途中で紆余曲折があってね。あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "現地の研究員",
      "text": "そうだったか。っと、そういえばさっき受付の人から、今日は君にお客さんが来てると聞いたぞ。「前に手紙を送ったけど返事が来ないから、どうしても会いたくて来た」とか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "現地の研究員",
      "text": "応接室に行ってみたらどうだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "お客さん？　私に……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "すぐ行ってみるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "現地の研究員",
      "text": "待った、この匂いは……燻製ソーセージかい！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "キミも好きなの？　今日ガイドしてくれた子が、イェラグの地元民的には、チーズフォンデュよりこっちのほうが美味しいって言っててさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "現地の研究員",
      "text": "ああ、それは習慣の違いだろうね。僕も子供の頃は貧しかったから燻製ソーセージを食べられるだけで大喜びしていたものだけど、今となってはチーズフォンデュのほうが美味しいと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "現地の研究員",
      "text": "ただ、その……エレナ、良かったら、一つ僕に残しておいてもらえないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "なるほどね……私はまだお腹が空いてないし、お客さんに会いに行かないといけないから、食べたかったらあげるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……やっぱり。お客さんって聞いて、絶対そうだと思ってた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ジーニ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "本当に、無事でよかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "姉さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "天災の後、あなたが無事かを知りたくて、ずっとここに手紙を送ってたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "だけど、その後すぐに、イェラグがヴィクトリアと交戦したと聞いて、心配でたまらなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "そうだよね……少し前まで、国外からの手紙が全部、一時的に差し止めになってたみたいで、最近ようやく配達されるようになったところなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そうだったのね。怪我はしてない？　病気は？　最近はどうだったの、元気にしてた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "えっと……最近いろんなことがあったから、私も少し変わったかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "だけど、元気にしてたよ。最近起きたことは、全部良いことだったから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "心配かけちゃったね、姉さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ううん。それならよかったわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "そうだ、クルビアからあなたのお気に入りのコーヒー豆を持ってきたの。トリマウンツでいつも朝食を取っていたお店と同じものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "それと、手挽きのミルも持ってきたの。もう遅い時間だけど、もし飲みたかったら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "飲みたい！　イェラグに来てから長いこと、好きな味のコーヒーを飲めてなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ふふっ、じゃあ少し待っていて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "そういえば姉さん、今回はクルビアから来たの？　普段はロドスにいたはずだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "最近は、ロドスでもいろいろあったのよ。でも、その話はまた後でゆっくりするとして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "簡単に言うと、ロドスで問題が起きたあと、私は一度家に帰っていたの。イェラグで天災が起きた頃、お母様が倒れちゃったから、私も少し長く実家にいて、お父様と交代で看病していたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "その時に、あなたがイェラグにいることを話そうとしたんだけど……少し話しただけで、お父様の顔が曇ってしまってね。あなたの名前を出すなと、歯を食いしばってそう言われたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "まあ、そうなるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "だけど、それからしばらく、お父様は私に隠れて、こっそり何種類も新聞を買っていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "えっ？　あの人、新聞なんて読まなかったよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "それでも買っていたのは、その時の新聞が、イェラグのニュースばかりだったからよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "お父様は、新聞を手にお母様のところへ行って、新聞をめくりながら何か話をして……そのあと、しばらく抱きしめ合っていたわ。それから、目を赤くしたお父様が部屋から出てきたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "二人が年を取ったからなのかもしれないけれど……お父様もお母様も、本当はあなたのことをすごく知りたがっているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "だけど、知ってるでしょ？　私は……あの人たちのこと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "私はお父様とお母様の気持ちを代弁しに来たわけじゃないわ。私はあなたの味方だってこと、知っているでしょう。二人があなたにしたことだって、私はわかっているもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "だけどもし、いつか二人があなたの消息を尋ねてきたら、その時は伝えてもいいかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "もちろん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "母さんは……今は元気にしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ええ、ただひどい風邪を引いただけだったから、私が出発する頃にはすっかり治っていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "お母様は弱っている自分なんて絶対に受け入れられない人だから、熱が下がった途端、またあの古い石像みたいな厳しい顔つきに戻っていたわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ふふ……そう聞いて、むしろ安心したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "姉さん、いつも持ち歩いてた占星学のノート、まだ持ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ええ。どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……見たいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "だけどあなた、占星学をすごく嫌っていなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私ね……イェラグの天災の真相を調査してた時、イェラグの人が言うところの「神」に会ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "最初は「神」なんて与太話だと思ってたし、同行していた人たちが「神」の存在を信じていることに悩まされたりもしてたよ。源石鉱脈の影響だって考えるのが一番合理的なはずなのに、って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "だけど、それはあの洞窟に入るまでのことだった……どれだけ信じたくなくても、装置に生体信号が記録されたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "頭の中に「巨獣」なんて言葉まで浮かんできた後に、ふと気づいたの。私が携わってきた研究も、もしかしたら、家に伝わってる占星学と大して変わらないのかもって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "あの救いようのないろくでなしの、ミスター・ウビカ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "父さんの気持ちが、少しだけわかった気がするんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "ジーニ、自分の道を否定しなくたって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ううん、違うよ、姉さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私は隠された真実の一端を明らかにしたし、ここで立ち止まるつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "科学は未知を探求するうえで最高の道具であって、私の歩むべき道だと、今でも信じてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ただ、ご先祖様たちは間違った道を歩んでいたかもしれないけど、その研究は決して無価値なんかじゃなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "それでも……ご先祖様たちは、イェラグの星空を見ることはできなかった。だから、私たちがこの未完の探求を続けていかないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アステシア",
      "text": "やりたいようにやりなさい。私はいつでも、あなたを応援しているわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "どうしてここに……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "なんでそんなに驚いてるんだよ。あたしが来ちゃダメか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……主任からは、現地ボランティアの付き添いは初日だけって聞いてたんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "あたしが個人的に、よそから来てる友達をもてなしたいって思ってるんだから、決まりに従う必要ないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "な、裂雲獣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "裂雲獣",
      "text": "ゴロゴロ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "確かに、それもそうかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "それじゃあ、今日は二つ約束してくれるなら、ついて行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "いいぞ、なんでも約束する。どうすりゃいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "一つ目に、もう雪山でむやみに走り回らないこと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "二つ目に……今日は今すぐ私と山を下りて、チーズフォンデュを食べに行くこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "だからさあ、あんなものは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "自分で食べてみないと、美味しいかどうかもわからないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "はぁ、しょうがないな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョアンナ",
      "text": "じゃあ、行こう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
