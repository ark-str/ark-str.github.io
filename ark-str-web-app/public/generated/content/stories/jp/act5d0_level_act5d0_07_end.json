{
  "server": "jp",
  "storyId": "act5d0_level_act5d0_07_end",
  "groupId": "act5d0",
  "stageId": "act5d0_07",
  "title": "11:08P.M.",
  "storyCode": "CB-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act5d0/level_act5d0_07_end.txt",
  "sourceHash": "56597e3426cb33c23ea42c73a3d38302372bd1187dcc297844fc8d0083f4693a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "はぁ、はぁっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "まだだ。まだ終わっちゃいねぇぞ。ペンギン急便よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "キミたちって、何だかんだ言っても仲がいいんだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "チッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ちょ、ウチの方に来んといてぇな！　ハンマーお見舞いしたるで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "うわっ！　テメェ一体どっちの味方だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "お、俺がやったんじゃないです！　あの天使が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えへ、ハズしちゃった。まぁいっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "今のうちに——おっと！　お前、俺の方に向かってなにぶった切ろうとしてんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "悪い、俺やっぱりボスに従うべきだと思って！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "待て、俺もだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "ナニっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "なに寝てんだお前ら？　死んでねぇ奴はさっさと起きやがれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "は、はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ねー部下にパワハラは良くないと思うけど？　ちゃんと傷病手当って完備してる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……状況は少し混乱しているが、要は黒服の連中を全部倒せばいいんだな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "なんか本当にゴチャゴチャになってるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "そうです——えっ！？　モスティマさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君たちも元気そうでなによりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……なぜここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ボスに来るよう言われてさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "チッ、あの変なサンクタ人か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "そこをどけ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "——っ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "やれやれ、ちょっと冷静になろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ここで勝ったところで何の意味があるんだい？　お互い一歩引いた方がいいと思うけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "あの女、ボスの攻撃を受け止めた！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "違う！　あれはアーツユニットだ！　ボス、気をつけてください！　そいつは術師です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "……正面から当たるのを避けたのは正解だったな……。おい、まだ奴らに近づくなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……お前のようなサンクタは見たことがねぇ。いや、サルカズか？　お前は一体何なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "普通のトランスポーターだけどね。そう見えない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "誤魔化すんじゃねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "死ね——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あ、ちょっと休憩……。って言って聞くような人じゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "テメェ、ナメてんのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "みんな、変わりないみたいで良かったよ。前に会ったときからだいぶ経つよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "おい、よそ見してんじゃねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやなぁ、何年やったっけ？　それともまだ数ヶ月やった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ぐあっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "毎日が充実してるから、時間なんて忘れちゃうもんね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……だいたい四年三ヶ月だよ、モスティマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ふむ、じゃあ本当に久しぶりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "——っ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "その顔はやめて。君がそんなシリアスな顔してると病気かと思ってしまうからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ちょっと！　これ感動の再会じゃないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "感動かどうかは置いといて、今は昔話している場合じゃないみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "本当にここでやるつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ちょっとした運動にピッタリなだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……ならいい。手加減はしてやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それに、もう一人のお客さんが私を待ってるんでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "——？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "毎回見て思うんだけど、なんであんな軽くアーツユニット振っただけで、こんな天変地異みたいな効果が出るんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやな。あのマフィアたちも、ポッカーンとしとるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ふーっ、今のうちにもうちょっと敵の数を減らしておくべき？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "どうした？　続けないのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……お前の腕は確かに凄まじいけどよ、そう簡単に逃げられると思うなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そんなに殺気立つものじゃないよ。こんなの食後の運動なんだからさ——おや。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "な、なんだいまの、炎が固まっちまった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……イースくんが近くを通ったみたいだね。やっぱりさっさと決着をつけようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "なにひとりでブツブツ言ってやがる？　相手は俺だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そんなに焦ったらダメだよ。ファミリーのボスとして、戦局をコントロールするのに良くないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "チッ！　お前の余裕ぶっこいた態度は本当に頭に来るんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "アーツだ！　避けろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "お前が行っても邪魔になるだけだ。俺たちは残りのペンギン急便を片付けるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……私たちも軽く見られたものだ。彼らには教育が必要だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "はいな！　いくでぇ——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "これがトランスポーター、モスティマ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "トランスポーター……他社のトランスポーターってみんなこんな感じなのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あれ、風が吹いてきた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "——風？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "テキサス、撤退するんだ！　早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "分かった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "おい、まさか地震か！？　あの術師、何をした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まったく、年寄りは本当にせっかちなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "逃がすか——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "うわっ——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カポネ",
      "text": "チッ、これはアーツだ、一旦退くぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "砂嵐？　こんなところで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "なんや状況がおかしない！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "テキサスさん！　ここが出口です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "バイソンとモスティマは？　うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "砂嵐ではぐれちゃった、あたし見てくる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "待て、エクシア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "——っ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "まったく、モスティマが関わるとすぐ頭がのぼせ上がるな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "テキサスさん！　モスティマさん！　皆さんどこですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あっ、目に砂が——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "慌てないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "モスティマさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "口と鼻を覆い隠して、私についてきて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……それにしても、こんな近い距離で感じると、確かに下手に怒らせてはいけないご老人だと実感するよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "地面が、地面が崩れる！　流砂だ、退がれ！　飲み込まれるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "ボス！　ご指示を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "他の奴は！　カポネは！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアA",
      "text": "砂嵐に乗じて脱出したようです。こちらの人間で向こうのチームに混じっている者も……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィアB",
      "text": "ボス！　ここも崩れます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "……引くぞ、まだ機会はある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "クソが！　いったい何が起こったんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "機会。機会……か……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鼠王",
      "text": "おかしいのぉ……。ワシはお主らに機会なんぞ残してやった記憶はないのだが？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
