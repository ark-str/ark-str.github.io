{
  "server": "jp",
  "storyId": "act35side_level_act35side_03_end",
  "groupId": "act35side",
  "stageId": "act35side_03",
  "title": "グランドバザールで会おう",
  "storyCode": "AS-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act35side/level_act35side_03_end.txt",
  "sourceHash": "c82846d1ba207520042f23e21fff775e5c9f90a3678aadf3dc436c49575ff5ae",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "シーッ、この生け垣の中でしゃがんで待っていてくれ。昼間に君を連れ出すために、ここ数日色々と考えてたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "生け垣が低すぎる。耳が外に出てしまうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "だったらもっとしゃがむんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な女の子",
      "text": "お父さん、あのお姉さん生け垣をなんかもみもみしてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅な男性",
      "text": "シッ、あの人はきっと酔っ払っているんだ。他人のことをあれこれ言うのはお行儀が悪いからダメだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ダメだ！　これじゃあまだ外から見える！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興味津々な女の子",
      "text": "あのお姉さん生け垣に突っ込んじゃいそう。引っ張ってあげた方がいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅な男性",
      "text": "シーッ、こういう時は見ていないふりをするんだ。転んでも大したことじゃない。それを人に見られるのが恥ずかしいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "優雅な男性",
      "text": "ここでは湛水祭開催前の式典が行われる。今日来ているのはみんな申し込みに来た参加者だ。もしコンテストの時に偶然顔を合わせてしまったら気まずいだろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ミナトハマイには湛水祭の前に行うちょっとした伝統があるんだ。付近の住民が様々な貴重なものを川に沈めて川の神を祀り、幸運を祈るんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "以上を踏まえて、この都市で最も貴重な宝石はどこにあると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "この川の中か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ここで待っていてくれたまえ。生け垣を剪定する時に使うカートを持ってくる。そしたら落ち葉を集めた大バケツの中に座るといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "そうすれば君を川辺まで運んでも誰も気づかないさ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "本当にそれでうまくいくのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "おいおい骨董品くん、私の服をそう引っ張らないでくれ、君もいい大人なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ちゃんと隠れて、動くんじゃないぞ！　すぐに戻ってくるからさ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "ニャ……ニャオ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "ん……動物か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "（優雅に尻尾を上げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "おぉ、ここにはそなたの姿を彫った彫刻がたくさんあるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "（得意げに尻尾を振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "本当に美しい。ここの人々があれほど愛するのも納得だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "（ツンと澄ましてお尻を上げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "どうした……余に撫でてほしいのか？　だが少し遠いな。ペペ殿にここから動かないように言われているのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "（わざと気を引く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "もう少し近づいてはもらえまいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "（不機嫌そうに尻尾を振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "怒らないでくれ。余が少し前に移動してみてもよいかもしれぬな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "ニャオ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミオ",
      "text": "ニャ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "逃げるでない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "おーい、ズバイル、そんな這いつくばって雲獣を見てないで、私が見つけてきたものを見てくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……なぜ不機嫌そうな顔をしているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "いいや、別にそのようなことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "なら早く入りたまえ。わざわざ測ったんだ。君が入っても十分な余裕があるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "この中……少々汚れているようだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "汚れてる？　落ち葉と紙くず一枚だけじゃないか。君は砂だらけの穴から掘り出されたのを忘れてはいないだろうな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……拒否する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "わかったわかった。お望み通りきれいにしてやろうじゃないか。落ち葉は……外に捨てて、紙くずは……ただのチラシだよ、汚くないって。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ペペが落ち葉の入ったバケツの中から、丸められた紙を取り出して広げた。\n突然、彼女の表情が固まる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "豊穣祭……それは何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "地元の祭典の一つだよ……参加者が自分の一番貴重な蒐集品を展示して、勝者はスポンサーが提供する賞品をもらえるっていうコンテストなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "これらの賞品、懐かしさを感じるものがたくさんあるな。特に二位のこの賞品は、実に懐かしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それも当然だろうね、ズバイル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……で、やはりこのバケツに入らねばならぬのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それも当然だろう？　君のためにわざわざきれいにしてあげたんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "う〜ん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "（曖昧な寝言）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……こっちにいけば……ミイラにはもう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "…………いやあああ！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……ようやく目覚めたか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "びっくりした。夢でよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "若い身空で死人に取り憑かれるなんてごめんだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "やかんを投げないでくれないか。これがたとえあなたの所有物だとしても、それによって他者の自由を損ねていいことにはならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ハッ、悪かったね。てっきり投げたのは自分の刀だと思ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "謝罪は受け取った。それでは改めて挨拶を。おはよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "待って、おはよう？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ナラントゥヤは、いかにもよく訓練された戦士という雰囲気の相手に素早く視線を走らせ、実力のほどを推し量ろうとした。\nそして、彼女は視界の端でこっそり周囲を観察しつつ、ゆっくりと腰に手を伸ばした。\n金が入っている袋はまだ腰にある。しかし武器のベルトはすでに空だった。\n刀はすべてティーテーブルに置かれ、部屋の反対側にある。\nごく平凡な部屋だが、ここは下水道のマンホールの蓋にさえ宝石がはめ込まれている都市だ。\nこの地に安価なものは存在しないということをナラントゥヤは知っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……あぁ、あなたが助けてくれたんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ありがとう！　親切な人だね！　この家を出たら、すぐに手下全員にあなたの名前を覚えさせるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "それで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いくら欲しいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "もし朝のランニングついでに持ち帰った乾パンとフルーツについて言っているのなら、これらは人からもらったものゆえ、金銭で表せない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そんなこと訊いてるんじゃないよ。あたしが街を歩いててもそんな幸運に巡り合えないのはなぜなのかってことも知りたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いや、待って、つまりタダってことだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "よろしい。太陽の照らす下で口から出した言葉は引っ込められないよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あなたの気持ちはありがたく受け取っておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "気分はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "身体の状態を見させてもらったが、私の知る運動整復法の観点から言えば重傷ではなさそうだ。しかし長時間意識を失っていた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうだね。だけどここしばらくは寝るのも忘れていたくらいだし、これで取り戻せたってもんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "なぁに、心配しないでいいよ。これは……一族の遺伝による持病みたいなもんだと思ってくれればいいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "一族の遺伝……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……なににせよ大事がなければ何よりだ。ほかにどこか具合が悪いところは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は無意識に首筋に触れた。\n針でできた穴はすでに塞がっていたが、長い悪夢を見る前の記憶がゆっくりと蘇る。\n受け取れなかった通行証、失敗した誘拐、恐ろしい古代のミイラ、落下時の無重力感、ぼんやりとした風の音……"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……あれは十階だった。てっきりこのまま落ちていって、二度と目を覚ますことはないと思ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "うわぁ、死ぬのがああいう感覚なら本当におっかないね！　あなたが助けてくれて本当によかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "死んだ後も人々に讃えられて名前を後世に残すことができれば、それは永遠の命を得られたのと同じことだって言われてるけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "もしその永遠の命ってやつが、終わることのない悪夢の中、砂漠の果てまで死体に追われることだとしたなら……サルゴン中に名前を轟かせることに果たして価値はあるのか、よーく考えないとだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "博物館の窓から飛び降りたのは……サルゴンに名前を轟かせたいがためだったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ん？　ま、そんなとこ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あなたたちサルゴン人の「名」に固執するという伝統は、いささか理解しがたいものがあるな……心から同情する。何かままならぬことでもあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "借金があってね、頭が痛いったら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうだ、訊きたいことがあるんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "あなたはあたしを助けてくれた、だから恩返ししなきゃいけない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そこで提案なんだけど……あたしの手下になって、天地を揺るがすような偉業に携わってみたくない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "思い出したのよ。建物の上から落ちたあの時、あたし天に願い事をしたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "今となっては、あなたこそ運命が与えてくれた「頼れる手下」だと思うのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "いいだろう。それであなたの負担が軽減され、生きる意欲が湧くというのであれば、喜んで尽力しよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "アナト！　こっちだ！　早く来てくれ、何を見つけたと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "何を見つけたかは知りませんが、またも博物館の重要文化財を持ち出したのでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "そのうえ彼をそんな汚い……落ち葉でいっぱいのバケツの中に入れましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……悪かったって。ずっと博物館の中にいて気が塞いでたみたいだしさ、なんだか可哀想で連れ出してあげたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "本当ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "あ、ああ……左様だ、アナト殿。余もこの辺りを見てみたくてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ほらね。そんなどうでもいい話は置いておいて、私が見つけた良いものについて話そうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "うーん……このくしゃくしゃのチラシがどうしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "内容をちゃんと見てくれ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "祭典前に行われるいつものイベントではありませんか。\n待って、これは……"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ズバイルと何日も苦労して探していた三つ目の宝石だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "さっきはズバイル氏が博物館で気が塞いでいたから連れ出したって言いませんでした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "なに、ついでだって……これは全部そのついでさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "……では、この宝石をどう手に入れるかは考えてあるんですか？　二位なんてそう簡単に取れるものではありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "豊穣祭に来る人たちは全員が富豪か貴族で、祭りには数え切れないほどの貴重な品が持ち込まれます。わたしが知っているだけでも、素性を隠して観光に来るパーディシャーが二人います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "もし困難だというのであれば、余が文化財を鑑定、あるいは余自身がコンテストへの出品物となることも可能だが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "安心してくれたまえ。私にとっては、それほど難しいことじゃないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "問題は、どんなものを出せば二位を取れるかということだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "特別な価値を有している必要はあるけど、唯一無二であってはならない。一つの時代の様相を呈している必要はあるけど、その時代を代表するものであってはならない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "たしかにその「巨大でユニークなシャア時代の印が刻まれた宝石」を手に入れるには、ちょうど二位になる必要がありますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "うん。二位を取る……これこそが悩ましい点なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "フフーン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "何か思いついたんですか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ペペは答えず、ただ目を細めて天窓を見た。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "正午を過ぎ、日差しが円形の天窓から降り注いで、地面に楕円形の光を落とす。\n光の輪の中心に立ったペペは突如として満面の笑みを浮かべると、手を伸ばして窓の外の丸い太陽を指さした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ハラヘトへ讃美を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "ハラヘトの神像でコンテストに参加するのですか？　悪くない選択ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "違う違う。私はただ神が与えたもうたインスピレーションに感謝の意を述べただけで、神に関する品で参加しようってわけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "地面に映した円形の光を見たまえ、まるで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "わかったぞ、王の名が刻まれし護符で参加しようというのだな？　王名枠（カルトゥーシュ）とはまさに幸運と魔除けの象徴である。審査員はその点を評価するやもしれぬ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "一体何を言っているんだね、君たちは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "この楕円形の光は黄金でできたサンダルに瓜二つじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "サンダル？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "その通り。わが一族に伝わる黄金のサンダルで件の宝石を勝ち取ってみせよう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "余もそなたと共に会場に入ることはできぬのか？　ずっと壁の背後で座していたくはないのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "わがままを言わないでくれ。ほら君が食べたがってたアイスクリームを買ってきてやったぞ。ところで本当に味がわかるのかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "いいや……ただ、あれほど大勢の人が並んで買っているものが一体何なのか気になっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ならこれで君の好奇心は満たされるだろう。早く食べることだな。でないと君の頭が日差しの下で溶けてしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "余の姿を模した氷菓か……まさか余がこの地でかようなまでに好かれていたとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "うーむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "たとえ味はしなくても、冷たい感覚ぐらいはあるんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……感覚ではない。正確に言えば、衝動に近いものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "川に飛び込み、水に浸って、思う存分泳ぎたくなるような衝動だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それはごく一般的な夏期の過ごし方だろう？　あっ……そうか、黄金は水に落ちたら沈んでしまうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "ゆえに余は衝動と表現したのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ハァ……まったく君は仕方のない奴だな。もう少し辛抱してくれ。コンテストが終わった後の夜中に、街で最大の人工湖に連れてってあげよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "それじゃあ行ってくる……また後で。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズバイル",
      "text": "（マントで顔を覆う）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "会場の合唱団",
      "text": "♪川岸に揺らめくパピルス、川面に逆さに映るラピスラズリ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会場の合唱団",
      "text": "♪黄金の砂丘を過ぎる長河よ、捧げられた貴石を呑み込み永遠に涸れえぬ流れよ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の女性",
      "text": "やっぱり。人工合成のクマリンの香りがしたものですから、きっとあなたがいらしたのだと思いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の女性",
      "text": "私の時計では、コンテスト開始の時間まであと三十分もあります。おかしいですね、あなたたち新市街地の方々には早めに到着するという習慣がなかったはずですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "派手に着飾る男性",
      "text": "厳密には二十七分五十秒です。やはり私の時計の方が正確ですね、何せ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "派手に着飾る男性",
      "text": "この時計のメカニズムは、「過去と未来の王」が、時を司る聖遺物を発見した後に開発したものと同様の構造ですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "派手に着飾る男性",
      "text": "あなたの時間に対する概念は博物館の日時計のように曖昧ですな。早めに到着して待ち惚けている間に砂時計から流れ出ているのが、実は金貨であるということに気づいておられないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の女性",
      "text": "そうですね。私のこの古い時計が前回時間を合わせたのは、日時計が地下から発掘された時とのことですから。しかしその時あなたの祖先はどちらにいらしたのでしょうね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "彼らに教えてあげるべきだろうか？　今は十一時二十五分であり、二人とも時計の針を合わせ直した方がよいと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "この運動用の腕時計は優れた防塵防水機能を持ち、位置情報も知らせてくれる。毎月これを着けてヘリア山を登っている私自身の経験からもお薦めできる品だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "お節介はやめときな。そんな暇があるなら、色んな飲み物を試す方が有意義だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "うーん、このグアバジュースはハーブティーより美味しいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "そうか。気に入ったのなら、もう何杯かもらってこよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "いいよ。パーディシャーじゃあるまいし、自分で取りに行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……そうか。本当に……自殺するつもりはないのだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ほら見なよ。街の庭園を通るだけでタダの飲み物がこんなにたくさん手に入るってのに、どうして自殺なんか──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な女性",
      "text": "やっぱり私の十万ディナールもする駄獣は、客車を引くのが速いわね。すれ違う人が風で吹き飛ばされそうなくらいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた男性",
      "text": "安定した走りの方が重要だと思うけどな。僕が飼育場で飼っている特殊な駄獣はまさにそこが優れているんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ちょっと──*サルゴンスラング*！　コップが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた男性",
      "text": "僕の場合は君みたいに、飛び散る砂利や通行人がこぼしたジュースをカーテンで遮る必要はないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "この人たち何しに来たの？　ここが無料のドリンクバーだってのが見てわかんないわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "心配はいらない。あなたのお気に入りのグアバジュースはキャッチしておいた。一滴もこぼれていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "道端で休憩できる場所を探そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "（小声）こいつが運命が与えた頼れる手下だってのは認めるよ。でも……これじゃあまりにあたしがボスらしくなくない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "（小声）早いとこアジャジとアジャニに引き会わせないといけないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "すまない、今何か言ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "何でもない。ここの飲み物を全部味わったら、博物館に行くことにするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あなたも博物館に行きたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "そうだよ。だけどあなたと違って、あたしは文化財に興味はない。単にものを失くしたから、最後に見た場所で探そうってだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "なんだ、あたしの通信端末はここしばらくずっと鳴ってないの。誰からも連絡がないってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "残念ながら、博物館はあの騒動以来ずっと閉まったままだ。博物館の管理者が紛失物を発見したとしても、約束通りにすぐ連絡をすることはないような気がする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "ここ数日、毎晩目を閉じるたびに思い出す。失われた古代ミノスの輝きの一角を仰ぎ見て、この大博物館の乱れた管理を目の当たりにしたあの日の光景を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "その他はさておき、スタッフが展示ホールの位置や見学ルートさえ覚えていなかったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "そのうえパニックに陥った数十名の観覧客を、行き詰まりの北東部……ミノス展示ホールへと誘導した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "博物館の管理者に会ったら、その者たちに関し厳しい意見を述べる必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "……あはは、気が変わったよ。今日はやはり博物館に行くのは中止にしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
