{
  "server": "jp",
  "storyId": "act16mini_level_act16mini_st05",
  "groupId": "act16mini",
  "stageId": null,
  "title": "ニヤリと笑う坑道",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16mini/level_act16mini_st05.txt",
  "sourceHash": "5c145dc2b0c9b238600e7b4516ab557331f6f441b43887dc46fa610c873f3fe0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "行こう、サンドビースト。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "あっ、そっちじゃないよ。忘れたの？　あの採掘場はもうプロの点検員を雇ったって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "……今日は北西のほうの採掘場に運試しに行ってみよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンドビースト",
      "text": "（背びれを気持ち良さそうに伸ばす）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "ほう、そのデカさからしたら、もう大人の個体だな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "探査用のサンドビーストがこの年まで生き延びられるのも珍しい。なかなかツイてるじゃねぇか、嬢ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "そうかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "こういう時分の操業にゃツキが必要だからな。もし今日の坑道探査に行ってくれるんなら、規定通り報酬は倍額支払わせてもらおう。もちろん、目ぼしいもんがあれば好きに持っていって構わねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "わかった。じゃあ案内お願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "おいおい、ちょっと待ちな。何の質問もねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "あんた、この仕事を始めたばかりの新人には見えねぇけど、なんで倍額って聞いても何のリアクションもねぇんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "実は先日、こっから西へ何百キロか行った辺りで天災が起きて、大地震に繋がった。その結果、うちの坑道内の源石結晶まで増殖し始めて、地下は今やひでぇ有様で……てことは全部把握済みなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "はい、今知りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "その素っ気ない感じ、ずいぶんと呑気な性格らしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "それともなにか、この手の現場に慣れたプロってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "プロ？　……多分違う。うちはただ、ここ数年ずっと探査員の仕事をやってるってだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "安全には注意するから。うちが死んだら、サンドビーストの面倒を見る人がいなくなっちゃう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "うーん、それもそうだな。プロの点検員が日雇いを転々としてるはずもねぇし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "とりあえず、伝えるべきことはちゃんと伝えたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "おい、指欠けオーリー！　飲んでねぇでさっさと準備にかかれ。命綱をそいつに繋いだら、坑道の中に下ろすんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "探査員、下の状況はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "サンドビーストの背びれは開いてるけど、血管の色にそれほど変化は見られない。正常な反応です。今のところは安全みたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "平面図は更新されてますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "新設された通路はまだ描かれてねぇが、重要な坑室はどれも変わりはねぇぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "ん、どうした？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "バクダンムシです。もう片付けました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "でも、あまりいい兆候ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "ところ構わず爆発しやがるそのクソッタレは、うちの坑道じゃめったに見ないはずなんだがな。下の状況は予想してたのより酷いかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "一つ注意だが、今の深度から更に下へ進むと、通信はもう繋がらないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "何かあったらここへ報告に戻ります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "どんどん暗くなってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "防水シャッターのシーリング材は特に問題ないね。スラグ輸送パイプも詰まってない。正常に動作する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "ほかに確認すべき事項は……源石結晶の成長範囲と活性状態。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "骨組みの状況、落盤リスクの有無。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "排水システムの状況、漏水リスクの有無。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "それから空気の状況、ガス漏れリスクの有無。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "サンドビースト、気をつけて進もう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "坑道内の照明も壊れてたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "ヘッドライトの灯りだけじゃ、見える範囲が狭すぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "サンドビースト、行って確かめてきて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "通風口が源石結晶に貫かれて、そこら中破片だらけ。結晶体の外殻がかなり薄いみたい。生えてきたばかりのものだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "木板の後ろに大きな空洞があるみたい。焼け落ちてできたのか……それとも虫に食われたのかな？　オリジムシが、いっぱい這い回ってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "天井に水が溜まってる。漏水の痕跡はないけど、泡立ちが激しい。水中に異常な気流の動きがある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "君の背びれ、源石粉塵がいっぱいついてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "血管の色は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "ガス漏れだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "逃げるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "サンドビースト、まだいてくれてる？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "隊長、昇降台を上げてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "サンドビースト、いま地上に向かってるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "今回は報酬がたっぷりもらえるから、新しいエサも買えるし……お医者さんにだって診てもらえるよ。君はきっと無事でいられる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "きっと良くなるからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "地上に出て、新鮮な空気を吸って、お日様の光を浴びれば、今日も無事生き残れたってわかるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "ほら、出口だ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "サンドビーストの健康状態は簡単に判断ができるんだ。背びれの薄膜が充血していれば、毒が体内に溜まってるってことだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "もしこの子が死んじゃったら、新しい子を買って来なくては。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "家にまだエサが二袋もあるから。人間じゃ食べられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "明日の朝起きたら、別の方角の採掘場に行ってみよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "明日の朝……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "太陽が昇れば、何もかも良くなるはず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "あんた、サンドビーストはどうした？　死んじまったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "それじゃあダメだ。サンドビーストも連れていないような探査員はお呼びじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "あいつらはそもそも早死にする運命なんだ。その程度の金もケチるようじゃ、いつか坑道の中でくたばっちまうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "それにあんた感染者だろ？　チッ、厄介ごとに巻き込まれんのは、うちらとしてもごめんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "どうした、聞こえなかったのか？　なぜ答えない？　まさかあんたがヘマをやらかしてサンドビーストを死なせちまったわけじゃないだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "採掘隊隊長",
      "text": "もういい、邪魔だ。さっさとどっかへ行っちまいな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "動物販売人",
      "text": "サンドビースト用の薬？　うちにはないし、聞いたこともないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "動物販売人",
      "text": "普段自分が病気になった時にだって、薬なんかはめったに飲まないだろ？　サンドビーストに薬を飲ませる人間なんて、なおのこといるはずがないじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "動物販売人",
      "text": "新しいのを買いなよ。どのみち短命な生き物だけど、うちの子たちは少なくとも先天的な病気はないから、坑道に入る前に病気で死んじまうようなことはないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "動物販売人",
      "text": "買わないんなら、商売の邪魔はしないでくれ。もう一度言うけど、サンドビースト用の薬なんて普通はどこにも売ってないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "動物販売人",
      "text": "そんな常識もなしに鉱山探査員をやってるのか？　死んだのがあんたじゃなく、サンドビーストの方でラッキーだったな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "サンドビースト、うちは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "夜が明けた。\n空っぽのケージの隙間をすり抜けるようにして、部屋に差し込む朝日がやけに眩しい。長い悪夢がようやく終わった気がした。\nでも、何一つ良くはならなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "大したことじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "……空っぽになっちゃった檻よ……うちの話を聞いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "うちはあの子を死なせてなんかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "うちは頑張った。でも坑道探査で、ガス漏れは避けて通れない。それに、空気を測定するのがサンドビーストの本来の役割だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "坑道の中も、ずっと真っ暗だったし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "……どうしてうち、震えてるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "ねえ、ここから一番早く出るトレーラーはどの便か、知ってる？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アレを探しに行くの？"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "うん。アレと出会った場所はまだ覚えてるから、その近くにさえ行ければ、なんとか探せるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "あの光を……まだ覚えてるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "暗闇以外のものって、どんな手触りだったっけ？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "きっと思い出せるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "アレは……確かにうちを救い出してくれた。そのおかげで、うちは生き延びることができた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "ねぇ、アレって本当に存在するんだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドビースト",
      "text": "うん、存在するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "――サンドビーストは目を開いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "待って、サンドビースト。どこに向かってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドビースト",
      "text": "君の求めるものを探しに行くのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "うちも連れていってくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドビースト",
      "text": "いや、僕一匹じゃそれは無理だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "でも、うちには君しか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「サンドビースト」の声",
      "text": "わわっ、放して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「サンドビースト」の声",
      "text": "フード、フードが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "……フード？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "どうしてドクターのフードを離してくれないんですか……！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "岩壁からも、砂地からも、あらゆる穴から湧き出た水がくぼんだ地面へと流れて行き、中心で沼地を形成していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "いい子だから、放してください！　これ以上引っ張ったらほんとに取れちゃいます――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "石柱や岩壁が連なった崖は、吹き荒ぶ砂嵐を防ぎ、陰になったこちら側を守ってくれている。"
    },
    {
      "type": "dialogue",
      "speakerName": "鍋蓋ちゃん",
      "text": "えへへっ、おいでサンドビーストちゃん！　キャロットクッキーですよ！　こんなの食べたことないでしょう？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "雑貨屋の店主から聞いた話でもそうだったし、動物図鑑にも、こういう場所なんだって書いてた……\n一匹のサンドビーストが、穴の中から顔を出した。二匹が枝の上で幹にもたれかかっている。それから三匹が沼で水浴びをしてる……四匹、五匹、もっとたくさん。\nどの子も背びれを伸びやかに広げていて、そこから健康的な色の血管が見えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "鍋蓋ちゃん",
      "text": "サワーベリーパイもどうぞ！　それから、はい、野草せんべい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "鍋蓋ちゃん",
      "text": "うんうん……どうやらドクターさんよりも、わたしの方がこの子たちと仲良くできてるみたいですね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ、早く何とかしてくれ……",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "はい、でも……ずっとこの子の頭を撫でてるんですけど、ちっとも興奮が収まらないんです……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ドクター、心配しないでくださいね。フードを破いちゃうような真似はさせませんから！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "随分と楽しそうだね、鍋蓋ちゃん……",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "鍋蓋ちゃん",
              "text": "えっ、そんなに顔に出て――あー！　鍋蓋ちゃんって呼んだのは仕返しですか？　ダメですよ、そう呼んじゃ！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……どうして？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "どうしてここに、こんなにたくさんの元気なサンドビーストが？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "鍋蓋ちゃん",
          "text": "わあ、また一匹がドクターさんに飛び乗りました！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、どうか持ちこたえてください……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "うちに任せて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "鍋蓋ちゃん",
          "text": "あっ、やっぱりレイお姉ちゃんに秘策があるみたいですよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "鍋蓋ちゃん",
          "text": "さっきずっとサンドビーストを追いかけ回してましたから、きっと動物が好きなんだろうなってみんなに話してたとこなんです！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "さっき……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私たちがずっと後ろにいたことに、本当に気付いてなかったみたいですね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ブレーキシステムが自然冷却するまで車を止めて休憩してたじゃないですか、するとレイさんが急に魂が抜けたみたいになって、ふらふらとどこかへ行くものですから、みんなで心配になって……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……ごめん。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "ドクター、落ち着いてね。じっとしてて……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "鍋蓋ちゃん",
          "text": "わぁ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "鍋蓋ちゃん",
          "text": "おっきなくしゃみ！　……あ、離れました！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "今のって……葉っぱの先をサンドビーストの背中の穴に入れて……くすぐったんですか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ありがとう、これで頭が働くようになった。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "サンドビーストの呼吸穴はそこにあるのか。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "大丈夫だよ。さあ、もう行って。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "サンドビーストの反応はわかりやすいんだ。この子たちは背びれで呼吸を補助してるから、気流と温度にすごく敏感なの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……今の子たち、小柄だった。人為的に繁殖してるサンドビーストと似たような体格だけど、たぶん生まれてまだ三、四ヶ月の幼獣だと思う。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "これからどんどん大きくなるし、何年も生きられるだろうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "鍋蓋ちゃん",
          "text": "じゃあ、レイお姉ちゃんの後をついてきてるこの子は？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "さっきは暗くてわからなかったけど、君、毛の色があの子より少し薄いね。見間違えちゃった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "でも、どうしてついて来ちゃったの？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "こら！　あんたたち！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "どんだけ探したかわかってんのか！　それになんでこんなとこまで……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "ってなんじゃこりゃ！？　多すぎるだろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "サンドビーストだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "それは知ってるよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "けどこの子たち……いや、それは今はどうでもいい。ドクター、あんた、車に積んである測定計器のデータが読み取れるって言ってたよな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "その数値に変動があってさ。けど今まで九割九分なにも起こらないから、あたしにも法則がよくわかんなくて……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "――皆、今すぐ車に乗り込んで！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "急いでここを離れなければ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "……は？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "まさか、本当に……天災なのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "わかりません。天災トランスポーターが一時乗車の際に使う予備装置は探知範囲が限られているので…そのデータで正確な予測を立てるのは不可能。それが以前ドクターの調べた結果でした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが、ドクターがどうにか身を隠すのではなく、急いでこの場を離れるべきだと判断したということは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "つまりきっと、今ならまだ間に合うということです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "なるほど、わかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "じゃあ逃げなきゃな。天災がここ一帯のすべてを飲み込む前に、なるべく遠くまで！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "ここの、すべてを……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "ハァ、ハァ……ダッシュであんたらに知らせに行って、また走って戻るなんて……こりゃ……ハァ……間違いなく、うちの工場区画の記録更新だぜ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "鍋蓋ちゃん！　タイムとってくれた？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "鍋蓋ちゃん",
          "text": "ランナお姉ちゃん、自分が走るのにそんなに夢中になっちゃダメですよ！　後ろの人たちを待ってあげないと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "サンドビーストと戯れ過ぎたのか？　みんなトロ過ぎるんだよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "あたしが待っても、天災は待っちゃくれないぜ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "相棒よ、頼むからスパッと動いてくれよな……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "ドクター、アーミヤ、準備はできたか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "大丈夫です！　……え？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクターは走り疲れててまだうまく話せないみたいで……はい、はい……わかりました。問題ないそうです！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "よし、準備オッケー、出発だ！　あばよ、天災雲！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "今のスピードで間に合うの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アランナ",
          "text": "問題ない。あたしに追いつけるのなんて、全速力のあたし以外いないんだ。ちっぽけな天災雲なんざ……ふん、相手にもならねぇさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ならいいけど……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "え？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター……なんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "れ……？　れひ……れい……レイ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "そうだ、レイさんは！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "レイさんがまだ来てないみたいです！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "一同",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "一同",
          "text": "ええっ！？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "うっ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "大丈夫だよ、サンドビースト。まだ……間に合うはずだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "天災はまだ来てない。今はただ、砂嵐が酷いだけ。強風の中でも、まだ前には進める。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "今、避難する場所を見つけてあげるからね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サンドビースト",
          "text": "（警戒した様子で砂を掘る）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……うん、やっぱりサンドビーストは喋らないよね。さっきのはうちの幻覚だったんだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "（ホイッスルを吹く）こっち。ついてきて。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "真っ黒な雲に追いつかれる……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "もう目も開けてられない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……もしかしたら、うちが君たちのシェルターになれるかも。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "熟練のハンター",
          "text": "仕方ない。砂嵐が悪化していく一方だろうと、もう進むしかない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "熟練のハンター",
          "text": "レイエーラには苦労させちまってるな。初めて隊で狩りに来たってのに、こんな悪天候に見舞われちまうとは。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "熟練のハンター",
          "text": "お前たち、この子の足を持つのを手伝ってくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "熟練のハンター",
          "text": "全身焼けるように熱いし、足の裏もマメだらけ。まだこの年だ。これから先の道は自力では歩けんだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "熟練のハンター",
          "text": "……行こう。どっちに進めば生き延びられるか、決断するんだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "グォ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……え？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サンドビースト",
          "text": "……グォッ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サンドビースト二匹目",
          "text": "グォッ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "大量のサンドビースト",
          "text": "グォッ――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "君たち……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "待って、うち、今……君たちに背負われてるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "うちをどこへ連れて行くつもり？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "砂埃にまみれた空気。一寸先も見えない霧。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "かすかに見える影。暗闇の中の……光。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……ここはどこ？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "広大で、がらんどうの地下洞窟のようだ。発光生物が、使い古されたカンテラのように淡い光を発している。\nレイの背後では、多くの生き物が暗闇の中をもぞもぞと這い回っていた。彼女は反射的にクロスボウを構える。\n地面に複数の土の山が盛り上がり、動き回ってぶつかり合った後、そこから数匹のサンドビーストが顔を出した。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "サンドビースト？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "君たちがうちをここまで……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "ここは単に君たちの巣穴……ってわけじゃないよね？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "サンドビーストの群れが地面や壁を跳ね回りながら、奥へと続く道を示してくれた。\n洞窟内では傾いた岩の柱が交差し合い、中央の光るエリアを守っている。それは巨大な羽獣が築き上げた石の巣だった。\n地面には何がしかの生物が通った跡のような溝が、巣の入り口付近までずっと続いている。\n辺りで廃棄物のように乱雑に転がった石の梁は、その生き物から剥がれ落ちた鱗であり、高々と積み上がった泥の山は、腐り落ちたフケである。\n狂風の吹き荒ぶ音は完全に遮断されていた。この天然のシェルターには、ただ伸びやかなホイッスルの音だけがこだまし、暗がりに棲む数多の生命に秩序をもたらしていた。"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……うち、覚えてる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "あの時……霧の中にあの影が見えた時、最初に聞こえてきたのは、風に乗ったささやき声。その声を聞くと、なぜか心が落ち着いて、しばらく痛みを忘れられたの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "前へ進みなさい、レイエーラ。この暗闇を抜けるのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "あなたなら、きっと……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……ん？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "サンドビースト……急に止まっちゃってどうしたの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "前に……何かある？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "これ以上闇に慣れることに突然嫌気がさしたレイは、カンテラの灯りを点けた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……行き止まりだね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "岩で塞がれてる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……でもうちならなんとかできる。掘り開けなきゃ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "痛ってぇ……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……！",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ホイッスルのような音がスッと止み、取って代わって音域の異なる無数の声が、人間が理解できるものとそうでないものの音節が入り混じった怒号が響き始めた。\nレイが耳をぎゅっと塞いでも、その声は反響を繰り返しながら頭の中へと流れ込む。"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "んー、目ん玉をほじられる夢を見たような……なわけねぇか。こんな荒地に生き物がいるわけねぇもんな！　――もんな！　――な！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……変だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "サンドビーストが……また言葉を喋った。それも何百匹も同時に喋り出したみたいに聞こえる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "サンドビースト？　――スト？　――ト？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "おらがサンドビーストだと！？　――だと！？　――と！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ったくよぉ。はじめに長耳の小人どもが棒切れでおらの頭をコンコン叩いたと思ったら、次は鉄の塊が耳の穴ん中にドガガーって這いまわりやがるしよ――しよ――よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ようやくやつらがどっか行って、おらもぐっすり眠れると思ったのによぉ……一眠りもしねぇ内にまた叩き起こされちまった！！　――ちまった！！　――た！！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "うっ――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "おおー、すまねぇ、ちっこいの。ちょいと興奮しすぎた。でけぇ声出して尻もちつかせちまったな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "でも先におらの眠りを邪魔して、ベロを踏んづけて間抜けな声を出させたのはそっちだから……これでおあいこだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "む……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "なんだぁ、くせぇなぁ？　……なんだこいつら！　おらの鼻の前からどけてくれぇ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……幻覚？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "幻覚？　それはねぇな、おらが保証する。だってよ、実際こんなにむずがゆいんだから……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "サンドビーストたちが……なんかの植物を引っこ抜こうとしてる……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "こら、それはおらの鼻毛だ！　そんなに引っ張るんじゃ――ハ、ハクション！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "岩壁に穴が空き、暗闇に一筋の光が走る瞬間がまた訪れた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……もしかして、君が「巨獣」？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "うちが探してたのは、君なの？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "巨大な瞳が宝石のような煌めきを放っている。\nレイは自分の心臓がかつてないほど力強く鼓動し、胸の中で震えているのを感じた。\n狩人の娘、暗闇から抜け出した探査員、光を追い求める旅人……過去から今まで、すべての時間の彼女が一斉に、恐る恐るその巨大な瞳に向けて手を伸ばした。"
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "なんだぁ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "「巨獣」？　それっておらのことか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "いい名前だぁ！　サンドビーストなんかよりずっとかっこいいな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "よーく覚えとかねぇと……前も誰かに名前を付けられたことはあったけど、目ぇ覚ましたら忘れちまってよぉ。ほんの一瞬目を閉じただけだったのになぁ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "まあいいっか、そんなのよりたっぷり寝るほうが大事だ……ほれ、早く話せ、ちっこいの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "おらに何の用だ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "君は……うちを助けてくれた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "助けた？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "うちの頭の奥で響く声、大きな影、一筋の光。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……それは、奇跡。君は昔、うちや多くの人の命を救ってくれた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……うちは君の光を覚えてる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "色んな伝説で言われてるように、うちらを助けたのは荒野に棲む大きな優しい獣――前はずっとそう思ってた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "でも、どれだけたくさんの動物図鑑を読んでも、記憶にある影と同じくらい巨大な生物なんてどこにも載ってなかった。ましてや、言葉を喋れる生き物なんて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "うちにわかるのは、あれが幻覚なんかじゃないってことだけ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……そしてなぜか、絶対に君にもう一度会わなきゃって思った。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "……すまねぇな、ちっこいの。それ以上は言わなくていい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "見ての通り、おらは体を動かせねぇ。そこのサンドビーストどもが鼻ん中で跳ね回ろうが、頭が痛くなるほどの臭いを出そうが、おらにはどうすることもできねぇんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "こうやってずっと暗闇に閉じ込められたまんま、何十年、あるいは何百年も過ごしてきた……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "そんなおらがどうやっておめぇや、ほかのちっこい奴らを助けるって言うんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "けど、君じゃなかったら、一体誰が？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "まさかこの荒野には、他にも「巨獣」がいるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "残念だがよぉ、ここにはおらの同類はいねぇんだ。少なくともおらの知ってるこの荒野にはな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レイ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "もういいか？　がっかりすんな、ちっこいの。悩みがあんなら、目を閉じて一眠りすりゃいい。そしたらぱぁっと楽になるかもだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "って、目ぇ閉じたらもっと暗くなっちまうか。おめぇは暗闇が苦手なようだからな……こりゃ参った、おらは人を慰めるのがあんまり得意じゃねぇんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "やめだやめだ、また眠くなってきた……さっさとその臭ぇ奴らを連れて、ここから出てっておくれ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "声が止むとサンドビーストたちはたちまち騒ぎ出し、そしてホイッスルみたいな奇妙な音がもう一度響き始めた。\nレイの目の前はまたしても闇に閉ざされた。自分がどうやって再びサンドビーストの背に乗せられたのかすらわからなかった。\nただ、あの光からどんどん遠ざかっていることはなんとなく感じていた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "すると視界の中で徐々に小さくなっていく岩穴の中から、突如として「巨獣」の声が響いた――"
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "おーい、ちっこいの。せっかくだから教えてやるよ、おらはさっき身体を動かせねぇとは言ったが、実は全然身動きが取れねぇってわけじゃねぇんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "で、おめぇのほうからも一個答えてくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "仮におらがおめぇの言う「巨獣」で、その探してた光とやらだったとしよう――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "轟音と共に岩が崩れ落ち、大地が震え始める。探査員のクロスボウによって、ついに呼び覚まされたかのように。"
        },
        {
          "type": "dialogue",
          "speakerName": "「巨獣」",
          "text": "おめぇはおらに何を期待して、はるばるここまで来たんだ？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
