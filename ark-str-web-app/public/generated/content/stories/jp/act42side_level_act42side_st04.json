      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mon3tr",
          "speakerId": "avg_4179_monstr_1",
          "text": "ああ。信号が急速に弱まってきているのを感じるよ。"
        },
        {
          "type": "narration",
          "text": "再接続してみよう……\nそれで、この後は？"
