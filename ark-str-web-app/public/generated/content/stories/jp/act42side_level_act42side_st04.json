    },
    {
      "type": "choice",
      "options": [
        {
          "label": "家族との団欒を邪魔したくはない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "急ぎ、ラテラーノでの異変を本艦に報告しなくては。",
          "value": "2",
          "blocks": []
