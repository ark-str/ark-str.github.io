{
  "server": "jp",
  "storyId": "act11d0_level_act11d0_06_end",
  "groupId": "act11d0",
  "stageId": "act11d0_06",
  "title": "蔓延する怒り",
  "storyCode": "TW-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act11d0/level_act11d0_06_end.txt",
  "sourceHash": "e43bf69ed0d5313f4d8b4ace2d74ff16ae146d809df19ee7ddd7e5d29b41986e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 6下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "このまま彼らに利用されっぱなしでいるつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "……もし彼らが本当に「レユニオン」の名を語ったら、どうなる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "……彼らは間違いなくそう宣言するだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "そして、私たちは追われる身となる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "移動市街だけでは、私たちをどうにもできない。だが……移動都市規模なら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "リターニアにそびえ立つ塔の上から大地を見下ろしている投資家や音楽家、貴族たちがひとたび号令をかければ、俺たちは簡単にやられるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "傲慢さはいずれ、彼らを滅ぼすだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "奴らの傲慢も悪いことばかりじゃないだろ。ウォルモンドごときどうにでもできる、そんな驕りのおかげで、ここは侵略されずにすんでるんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "とはいえ、それはこれまでの話……このままここで騒ぎになるのはマズい。逃げ場がなくなるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "――私たちは戦場で出会うべきではなかった。ここは……ここは戦場ではない、戦場であるべきではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "君たちの時間ももう僅かだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "――？　誰と話しているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "ただ……ただの愁嘆だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マドロック",
      "text": "もうすぐ、冬が来る。他に道はない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カシャ",
      "text": "うーん……なんか怪しいなぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "――何か質問はあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "念のため聞かせて。あの八人の遺体は……どうやって身元を特定したの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "体型と性別、おおよその年齢をもとに、街の失踪者リストと照らし合わせた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……だが今はあの火災について論議している場合ではないだろう。それよりも差し迫った問題があるのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "否定はしない。だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……何か気付いたことでもあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "私たちが接触したレユニオンによると、あの火災で命を落とした彼らの仲間は「四人」ということだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……敵の言うことを気にする必要があるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "僭越ながら言わせてもらえば、それは必要なことよ。「気にする」と「信じる」は別。行き違いがある場合、お互いに何かを誤解している可能性が高い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "それで何か問題が解決できるとは思えん。というよりも……あの火災の真相を暴いたところで、事態の悪化を止めることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "あなたには必要なくても、私たちからすれば、意味のあることなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……そうか。では僭越ながら、私も言わせてもらおう。フォリニックさん、君はこの件に関わってから、主観的になりすぎているところがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "――そうかもしれません。ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "私はただ、ウォルモンドのために戦う。これは私の義務だからな。君たちの正義感には……興味はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "私はロドスに真実を語るという責任は負うが、君の復讐願望に力添えするつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "何を偉そうに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "――いえ、その通りです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……頭を冷やしてきますね。スズランが負傷者の手当をしているので……その手伝いに行きます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ではこれで結論が出たな。何はどうあれ、ドデカフォニー通りの暴乱を収め、街を奪還するのが最優先だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "全面戦争は避けられまい。我々は、正面から暴徒を抑え込む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ロドスの皆さんは、自律式アーツユニットの奪取と、サルカズを含む武装集団の監視に注力してほしい。一番の難問は、君たちに任せる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "うむ……それにしても、すこし言い過ぎただろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……そんなことないわ。あの街の反乱者たちや、門の外で怒り狂っている住民の目に映っているものは見た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "もし私たちまで冷静さを欠いてしまえば、ウォルモンドはもう死んだも同然よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……それに真相はどうであれ、「再びレユニオンが現れて、リターニアの市街を一つ破壊した」なんてことになったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "あれだけの犠牲と別れを経験した今、そんな場面はもう二度と見たくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……エアースカーペ、カシャに連絡を。合流の時間よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "私はあの感染者……捕虜たちの様子を見てくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "憲兵長？　フォリニックさんは出ていったようですが、会議はもう終わったのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "ああ、君もご苦労だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……外が騒がしいな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "家を破壊されて黙ってられるか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "あいつらは私の店を壊して、子供をぶったわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "反乱者たちめ！　恩知らず！　恩知らずの裏切り者！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "戦え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "戦え！　戦え！　戦え！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "戦え！　戦え！　戦え！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……ふぅ、窓の外を見てみろ。彼らは皆、正義の代弁者にでもなったつもりなのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タチヤナ",
      "text": "伯父さん、もうタバコは吸わないでください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セベリン",
      "text": "……気にするな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "はい、これで大丈夫です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "と言っても……あまり軽率にアーツを使っちゃダメですよ！　せっかく感染状況が軽いんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "捕虜の感染者",
      "text": "馬鹿言うな――俺はリターニア人、それも高等教育を受けたリターニア人だ、アーツを使っちゃいけないなんて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "そうやって戦っちゃダメなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "捕虜の感染者",
      "text": "違う……戦う戦わないの問題じゃない。アーツを使えなければ、家の冷蔵庫だって動かないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "それは普通に装置を通して使ってください。体内の源石さえ刺激しなければ、悪化は防げます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "捕虜の感染者",
      "text": "……術操作が必要な安物の中古品を使ってるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "それでもダメです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "捕虜の感染者",
      "text": "チッ……俺が今さら普通の生活に戻れるとでも！？　お前らみたいな余所者にはわからないだろうが、俺たちが抗議してるのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "まあまあ、ちゃんと体調管理をして悪化を防げば、まだまだ健康体ですから。あ、さっきも言いましたけど、無闇にアーツを使うのはダメですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "捕虜の感染者",
      "text": "抗議……抗議してるのは……いや、やめよう。こんな子供に何言ってんだ、俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "では次の方――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "あ……おじいさん？　こんなお歳で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "……おお、九本の尾を持つヴァルポなど、珍しいのぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "ふむ……そう言えば、近頃冬霊人について尋ね回っている余所者というのは、君か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "あ、はい……おじいさん、どこか痛いところはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "ほう？　いや、大丈夫じゃ。わしは死に場所を探して自首しに来たんじゃ……目もかすんで、まだこんな時間なのにもう眠たくてしょうがない老いぼれじゃからな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "し、死に場所？　そんな怖いこと言わないでください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "お嬢さん、わしが冬霊人じゃ。最後の冬霊人なんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "ほほう、お嬢さん、驚いた様子も可愛いのう、これほどまでに……これほどまでに無垢で敵意のない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "最後の……？　皆さんは、冬霊人が率先して反乱する感染者の部隊に手を貸していると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "憎しみに火がついて初めて、彼らは血統を語り、それを口実にするんじゃ……彼らが憎んでいるのは別のものじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "もう少し話してもいいかの？　どちらにせよ囚われの身じゃ、これ以上……何かをするつもりはない。本当に歳をとったものじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "あ、はい……ですが、ただの怪我でも治療させてください。まだまだ元気でいないといけませんから……おじいさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "はは、ジジイの身体はこう見えて強いんじゃ……いや、若い頃ほどではないかの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "一族の者たちは……他の地区に行ったり、ウォルモンドの人々と籍を入れたりして、各々が生きる土地に溶け込んでいった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "最終的に、真の冬霊人がどれほど残ったと思う？　わしら老いぼれだけじゃよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "おじいさんは……何をしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "わしは……殺した、多くの人を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "ウォルモンドにやって来た商人、闇雲に荒野に踏み込んだ貴族……たくさんの人を、殺してきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "初めはわしらはそれを、当然のことだと思っておった。これは正当な復讐じゃ、とな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "だからわしらは、骨身を惜しまず動いた。だが若者たちは、傍観するだけじゃった。彼らからすれば、そんな復讐は既に必要ないものだったんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "いくら復讐をしても、あの裏切り者たちも腐敗した貴族も、皆殺しにすることはできんかった。結局、わしらは憎しみを多くの罪なき者たちにぶつけていただけじゃ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "わしらは、リターニアも、その法律も、移動都市のエンジン音の轟きも、何も奪うことはできんかった――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "そしてわしらは諦めた。諦めて、ウォルモンドに逃げ込んだ。じゃが他の老人たちはセベリンに片付けられてしもうた。奴は抜かりない男じゃ、加減などせん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "そう言えば……あの男は瀕死の敵とタバコを分け合って吸うという噂もあったのう。現代の工業タバコなんて、旨くもないものを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "わしは、拾い集めたブリキで住処を造り生き延びた……ウォルモンドの地下でな。セベリンと言えども、あんなところに冬霊人が隠れておるとは、思いもしなかったのじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "わしが死を恐れていると思うか？　少しも怖くない。ヴァルポのお嬢さん、わしは本当に死など恐れていないんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "ただ、生涯をかけた復讐が失敗に終わった後、わしは街の動力炉から鳴り響く轟音を聞いてみたかったんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "いつの日か、ウォルモンドは肥大化し一つの移動都市になるかもしれん。あるいは、衰退し滅びるかもしれん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "じゃが……ふぅ……冬霊人のわしは、初めてあの煮えたぎる炉が街を動かすのを見たとき、憤怒したじゃろうか？　無力を感じたじゃろうか？　いや違う、当時のわしは、ただ涙しただけじゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "あの沸騰し、燃えたぎる止めようのない力に……弓やナイフでは決して太刀打ちできない恐ろしい力に……一目惚れじゃった……あの凶器に惚れ込んでしもうたんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "……じゃが、ビーダーマン、あのずる賢い小僧はやってのけた……一人の天災トランスポーターで、部外者に過ぎない男が、わしが一生かけてもできなかったことをやってのけたんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "――ま、待ってください、おじいさん！　ビーダーマンとおっしゃいましたか――？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "リターニアの天災トランスポーターの方ですよね？　でも確か、あの火災で不幸にも亡くなられたはずでは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "ほう？　それはわしもよくわからんが……命令を下したのは確かにあの男じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "お嬢さんは無力感を味わったことはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "ビーダーマンが……感染者たちとともに、アーツを使って動力炉を一瞬にして破壊したとき、わしは完全に無力じゃった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "かつてわしを感服させたものは、ただの鉄の固まりに過ぎんかったのじゃ――。……嫌になるのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "……まだおるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "はい、いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "復讐や戦いを急ぐな、わしの言葉を胸に刻んでいってくれ……お嬢さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "冬霊人はこの紛争の原因ではない……少なくとも、今はもう違う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "そして、多くのウォルモンド人には皆、冬霊人の血が流れておる……この街を打ち建てたのは、わしらなのじゃから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "冬霊、冬霊とはウォルモンドという月そのものじゃ……そして、それは、自ら滅びゆく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "……ほれ、ヴァルポのお嬢さん、この道はどこに続いておる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "この道は……普通の街道ですよ？　議事堂に続く……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "いいや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "あれは山へ通ずる道じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "長い旗が揺れておる……十二の曲がりくねった山道……旅人と雪風……動力炉……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おじいさん",
      "text": "……スゥ……スゥ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "……はい、私の記憶違いでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "この道は山への道です、おじいさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "……おやすみなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "フォリニックお姉さん……聞いていましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スズラン",
      "text": "私たちはずっと、煙に巻かれていたんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "死んだと思っていた天災トランスポーターが、暴徒の指揮をしていた……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォリニック",
      "text": "ビーダーマン……だったわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ララ――♪　ラララ――♪\nそれはいとも容易く折れる枝♪\n冬霊よ、冬霊よ♪\n長き生と長き死に疲れ果てて♪\n執念深くその歌を歌う♪\n夏の間も♪\n冬の間も♪\n冬霊よ、冬霊よ♪"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
