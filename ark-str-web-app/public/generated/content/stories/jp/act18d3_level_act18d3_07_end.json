{
  "server": "jp",
  "storyId": "act18d3_level_act18d3_07_end",
  "groupId": "act18d3",
  "stageId": "act18d3_07",
  "title": "守護者",
  "storyCode": "SV-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18d3/level_act18d3_07_end.txt",
  "sourceHash": "fd2781fb590597790702b66b6f70babd18e1410e7565e6456124a5fa23b18cf5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "今日はいっぱい拾えたんじゃない？　私とペトラおばあさんの分、それからベンチの分に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "うん、歌い手さんの分も。歌い手さん、きっと帰ってくるよね？　お腹すかせて帰ってきたら、可哀想だもん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "残りは……まだ、こんなにいっぱい！　箱に入れておこうっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "えっ、暖炉おじさんも欲しいの？　んー、それじゃ先に、おじさんにあげるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "わあっ、おじさんの腕に絡まってるのって海藻でしょ！　それ、私にちょうだい！　歌い手さんから教わった……えっと、お酒！　海藻のお酒を作ってみたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "……あれ、ベンチは？　またどこかに行っちゃった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "あぅ……あぅ～……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "うぁ……うた……あぅ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……そうやって掴んじゃダメよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "これ、あげるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "んわぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……かじるのもダメ。それは食べ物じゃないのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "きわく、きわく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……彼女を呼ぶのはやめて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私の代わりにハープを持っていって。彼女に渡してほしいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "彼女に伝えて……ううん、あなたじゃ伝えられないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "それに……これはまだ、お別れじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "聞きたいことがあるから行くの。戻ってきたら、自分で言うわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "上官、我々は今から山に爆薬を設置しに行く、ということでよろしいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……先ほど向こうで、何者が教会に入っていくのを見ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "この都市で出会ったあのよそ者に……よく似ていましたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "あの……上官、彼女は一体何者なのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "エーギルだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "."
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "彼女は恐魚と戦っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……私たちの他に、あの怪物を知っていて、あれとの戦いを専門とする人がいたなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "もし教会を爆破すれば……彼女も巻き込まれてしまうのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "元凶を解決することなく、この場所を破壊したところで無意味だ。だが、あの場所が奴らの温床となる以上、選択肢などない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "そう……でしょうか？　ならば我々は、ここに異常をもたらした元凶を知る必要があると思うのですが……上官にも、確証がお有りでないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "自分の任務以外のことは尋ねるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "それと、上官はお気になさらないと思いますが、それでも言わせてください……この都市の耐久構造では、爆発の威力に耐えることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "街の南半分は崩壊する危険性がありますが、ここの住民はそれを知らないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "続けろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "わ、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "私は、彼らを避難させたいと思っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "たとえ、上官にとっての彼らが、奇妙で、問題があり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……浄化されるべき存在だったとしても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "審問官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "ひっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "お前の職責は何か、言ってみろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "「イベリアの国家存続のため、イベリアの敵と戦うため、イベリアの潔白と美徳を守るため、私は剣と灯りを高く掲げる！」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "ならばお前は、彼らに判決を下さねばならない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "判決？　彼らに……死刑を言い渡すのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "上官、昔あった歌を、最後に聞いたのはいつですか？　あのレコードはすべて壊れていますよね？　あなたの機械も、長い間ほこりを被っていますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "私はあの歌を聞きました。あのエーギルが、彼らのために歌うのを聞いたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "あのような歌こそ、本来イベリアにあるべきものだと……私は思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "だからこそ、彼らを殺す前に真実を知りたいのです。上官が黒幕を見つけ出したいとお思いになるのと同じように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "確かに彼らはまだ変異する可能性を秘めていますが……その時は、必ず私の手で彼らを浄化してみせます。ですが今は……今は、彼らを避難させてやりたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "上官、もしご許可をいただけるのなら、私は今すぐ彼らの避難誘導に向かいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "それがお前の判決か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "わかりません、上官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "アイリーニ、お前の判決は、目の前の人々だけに下されるものではない。それは同時に、他の人々への判決にもなりうるのだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "お前が怪物に生の判決を下せば、人々には死の判決が下されることになる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "承知しております！　そうした判決を、私はこれまで何度も下してきました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "お前の判決は、災いを阻止するものかもしれない。しかし同時に凶兆をもたらす可能性もあると忘れるな！　一人を救うため百人を殺すことも、一人を殺して百人を救うこともありうるのだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……承知しております、上官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "判決がもたらすであろう利害も、道徳と経典の間にある矛盾も……私はすべてわかっています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "私は、お前にそんなことを尋ねたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "お前に訊いていることは一つだ……アイリーニ、お前はこの責任を背負うことができるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "お前が苦しみをもたらすならば、お前もまた苦しみを受けなければならない。お前が下した罪悪の判決よりも、多くの苦しみをだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "お前にその度胸があるのか？　精神的な苦痛を受けた時、お前の信仰は揺らぎはしないか？　もし、失敗して悪い結果をもたらしたとしても、もう一度立ち上がることができるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……私は……私は揺らぎません。私には、背負う覚悟があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "裁判所の一員となった時、既に覚悟をしていました。私には、できます。もし間違いを犯すことがあれば、処罰を受けましょう。私にはその義務があるのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "上官！　私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "もう十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "で、ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "十分だと言ったはずだ。お前の職責を果たせ、アイリーニ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "――はい、上官！　直ちに地域住民の避難誘導へ向かいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "それから、上官……残りの爆薬は、サルヴィエント全体を爆破するのに十分な量ですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "つまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "その必要が生じた場合、お前の判決は私が取り消す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "審問官アイリーニ",
      "text": "では、行って参ります、師匠。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大審問官",
      "text": "誰だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ごきげんよう、大審問官殿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "おや、誰かと思えば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "ようこそ、吟遊の歌い手よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
