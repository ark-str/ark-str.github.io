  "sourceHash": "94f425b4a24b7445de1a27f386bc922380c5c2eb37c0543398368267da755b2b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "临光"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……マーガレット。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ……おばさん、来ていたのか。すまない。バタバタしていて気付かなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マーガレット、いつから寝てないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……正直に言いなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "隠すつもりはないが……私も覚えていないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "前回はすぐにカジミエーシュを離れたから、優勝後の対応事項がこれほどあるとは思わなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "そりゃあメジャーのチャンピオンだもの。各方面から注目されるのは当然よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "歴代のチャンピオン──それどころか四強に入賞した騎士でさえ、雑務を代行するマネジメントチームと契約してるほどなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マーガレット、一人で何もかも背負うのはやめなさい。私もマリアもいるんだから、試合が終わってからのサポートだって任せてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ。私も二人がいてくれて心強い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……だったらそれを貸して頂戴。そんな分厚い書類の束、日が暮れるまで作業したって片付かないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ふふっ。間違いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "うーん……九割方は商業イベントのゲストオファーね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ、ほとんど断るつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "残りのものは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "見せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "学校での講演？　子供たちに自分の経験を話すいい機会だし、あなたなら喜んで行きそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "あとは……ヘルスケア商品の発表会？　この企業、メジャーのシーズン中にロドスと協力してたとこ？　マーガレット、ここの責任者と会うつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……まだ決めていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "まぁ、あなたがどうするつもりかくらいわかるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "だけど、その一歩を踏み出したとして……次の一歩はどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "そう、それが肝心なんだ。今になって改めて思い知らされたよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "メジャーは、ただの始まりに過ぎないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "ニアールさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……アイビー？　事務所でトラブルでもあったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "いえ。事務所での業務は今のところ滞りなく進んでいます。……ですが外で少々問題が発生しまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "……原因は一部の感染者なのですが、四都連合が解散したばかりのこのタイミングで、彼らが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "わかった。場所を教えてくれ、すぐに向かう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "そこをどけ！　俺たちを街に入れろ！　お前ら……こんな仕打ちが許されると思ってるのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "お願いです、騎士様。このまま荒野に放っておかれては、私たちは生きていけません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "子供だっているんです！　数ヶ月前に大騎士領へ仕事に来る前は、みんな街でしか暮らしたことないんです……荒野で暮らすなんて考えたこともありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "この近くには鉗獣が出没しますし、食料の備蓄だってほとんどありません……それに、万一天災に遭遇したら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "……泣くな！　こんな冷血な奴らに、泣き落としなんて通用するわけないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "俺は……お前らを英雄だと思ってたんだ。利益に目がくらんだ商業連合会の連中なんかとは違うって信じて──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "身分識別コードを照会したが、君たちはカヴァレリエルキの所属ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "ええ、それはさっきも聞きました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "ですが、先ほど他の三つの街の検問所にも行ってみましたが、どの検問所でも同じことを言われたんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "彼らが言うには、私たちは四都連合の存続期間中は「大騎士領」の所属だったそうです。しかしメジャーが終了し、今日からもう……四都連合はないんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "私たちが再び街に戻るには、次のメジャーまであと三年も荒野を彷徨わなければならないと……それが規則だと言うんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……もう一度言おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "入境許可がない以上、カヴァレリエルキに足を踏み入れることは許されない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "メジャーが終わってしまえば、大騎士領では俺たちのような安い労働力はお払い箱――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "四都市の連結を解く時に出るゴミとして、当然のように捨てられるべきだとでも言うつもりか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "くそったれ……そんなの受け入れられるか！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "それ以上前に出れば、不法侵入行為とみなす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "く……くくっ……それでも進むと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "カジミエーシュの英雄……我らの誇りである征戦騎士が、その槍でカジミエーシュ人の心臓を貫くのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "それとも……俺たち感染者には、もはやカジミエーシュ人を名乗る資格なんてないとでも言うのかよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "感染者よ。我々には君の質問に答える義務はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "繰り返しになるが、もしもこれ以上前に進むなら──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……まだ話し合う余地はあるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "……あんたは……耀騎士！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "どうして耀騎士が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "マーガレット、か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ。また会ったな、ライムおじさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "正直、ここでおじさんに再会するとは思わなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "四都市の分断作業が行われる期間中、我々はカヴァレリエルキの警備を命じられているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……警備？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "今期のメジャー開催前は、カヴァレリエルキでは長きにわたって征戦騎士が動員されることはなかった。ましてや銀槍のペガサスともあろう部隊が、都市ゲートの警備に動員されるなど考えられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "この感染者たちは……カジミエーシュの安全を脅かしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……マーガレット。お前なら分かるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "よ……耀騎士もグルなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "はっ……なに当たり前のことを言ってんだ俺は……耀騎士、お前はあのニアール家だったな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "昔はあんたのことも尊敬していたよ。俺たち感染者に光をもたらしてくれると思ってた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "だけど、あんたが当てにならない偽物だってことはもう誰もが知ってる。感染者の裏切り者さんよ、どうせあんたもこの征戦騎士たちの味方について、その槍を俺たちに向けるつもりなんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私のことは信じなくて構わないが、ひとまず仲間を連れてあちらで休んでいてほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "一旦この件は、私に任せてくれないだろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "……俺たちに待ってろと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "いいだろう。あんたが今度はどんなショーを見せてくれるのか楽しみだぜ！　ここには……観客席もカメラもないがな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "マーガレット、彼らが君に向ける眼差しは、君が彼らに向けるものとは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……分かっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だが私は、感染者をカジミエーシュの敵だとは思わない。感染者は……耐え難い苦しみを味わっている普通の人にすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "あなたの答え──つまり監査会の方針は、私にも想像はつく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だがライムおじさん、私は何度でも問う……必要とあらばこのソードスピアも使って問いかける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "「感染者は、本当にカジミエーシュの安全を脅かしたのか？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "全員散開、その場で休め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "武器を取るがいい、マーガレット。騎士には騎士の語らい方があるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "──わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "おじさん。前回の決闘から……どれくらい経つだろうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……グランドマスター、四都市は今夜十時頃には完全に分割されます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "現在、カヴァレリエルキ都市ゲート、及び街の各重要施設全てに、我ら騎士部隊が駐屯しております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "このような光景を見るのは何年ぶりかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "マーガレットに感謝しなければならないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "マーガレットといえば……グランドマスター、彼女はあなたの提案に同意するでしょうか？　これまでは何度も拒否されていますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "時代は変わり続けている……今の子たちは、あの頃の私たちよりも物事がずっとよく見えているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "だからちゃんと分かっているはずよ──銀槍の一員に加わることが私たちと共に歩む唯一の方法ではないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "ええ。どんな戦場であろうとも、我らはニアールと肩を並べて戦うことを渇望してきました……それは今でも変わりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "……戦場ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "メジャー終了後、商業連合会が譲歩したのは一時的なものに過ぎないわ。私たち……いえ、未来のカジミエーシュにはマーガレットの力が必要なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "そしてあの子が前に進み続けるというのなら、彼女にも我々の力が必要なはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "そうですね……彼女の前途はまだまだ長く険しいですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "彼女がメジャーで最後にやったこと、あなたたちも目にしたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……ということは、あの荒野に留まっている感染者たちの件は……なるほど。それがグランドマスターがライムに本件の処理を命じられた理由ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "いいえ、あれはライム自ら志願したのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "あの時、競技場で偽りに満ちた試合を観たライムは、吐き気がすると言いながらも、かつてのマーガレットとの対決を思い出していたようだったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "マーガレットは必ず介入してくるとお考えですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラッセル",
      "text": "でなければ、マーガレット・ニアールではないもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "見せてもらおうか。この数年で、君がどれ程変わったのかを──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "真の騎士の槍は、競技場の道化に向けるものでも、荒野の盗賊を片付けるためだけのものでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "おじさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "幼い頃、あなたに戦場での槍の使い方を教わったことを、忘れたことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "「騎士が先陣を切るとき、踏みしめる大地のすべてが、守り抜くべき領土だ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私はこの数年間、歩みを止めたことは一度もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "──言葉で問答するつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "この槍が私に代わって、想いを伝えてくれるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "ならば始めよう。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "陽光を受けて無骨に煌めく銀槍の穂先は、烈風と土埃に蝕まれ、黒くくすんですら見えた。\n一方、若きペガサスのソードスピアの切っ先が映す光の残像も少しずつ褪せ、最後には瞳に宿る不滅の輝きだけが残った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突撃、なぎ払い、フェイント、刺突、防御――\n二人の酷似した流れるような動作が、肉眼では判別できないほどの速度で繰り返される。\nそこにはいかなるアーツの輝きもなく、ただ二つの強固な星が荒野でぶつかり続けているのみだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "この程度か？　マーガレット。スピードが落ちてきているぞ──！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "戦場では、急所を貫くチャンスは一瞬しか訪れないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "──！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "……ゴホッ、ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "（こ……これが征戦騎士同士の決闘なのか？　競技場でのやり合いとは大違いだ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "（チッ……なんて砂埃だ！　ここに立っているだけで……息も苦しくなってきた……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "アーツを……使っているわけでもないのに……うぐ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "まずい……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……この状況で他人の心配か？　マーガレット、無駄なことに気を取られて、全身隙だらけだぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……無駄なこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "その言葉は、認められない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……この光は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "私の槍を防いだだけでなく、さらに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私が自らを燃やし、歩み続けているのは、すべての人々を照らすためだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "くっ──！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "銀槍のペガサスが、一歩後ずさった。\nその一歩が、勝敗を示していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "い……息ができる……決闘は終わったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "それよりこの光はいったい……温かい……いや待て、この光が巻き起こった砂嵐から俺たちを守ってるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "耀騎士……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "彼女はやっぱりあの耀騎士のままよ。そうでしょう？　彼女は感染者を見捨ててなんていなかった！　私たちのために剣となり盾となるあの耀騎士なのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "そ……そうなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "耀騎士……耀騎士！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "マーガレット、本当に成長したな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "すまない、ライムおじさん。あなたがアーツを使おうとしなかったので、私も本来は使うまいと──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "征戦騎士同士の決闘で、アーツを使用してはならないという規定はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "ましてやお前は征戦騎士ではないだろう、マーガレット。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "とはいえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "私は競技場で、君の活躍を見たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ずっと騎士競技を軽蔑していたはずでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "ああ、今でもあんな偽りだらけのパフォーマンスには反吐が出る思いだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "だがマーガレット、その中でお前はよくやっていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "それに、あれだけの実力を見せつけておいて、まだ全力を出し切っていなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "それは……褒め言葉と受け取ろう。ありがとう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "今回も君の勝ちだ。十年前も相当なものだったが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "今や、君の技量とアーツは最高の域に達している。溢れる才気で己の武器を自在に操る様子は、君の当時の実力はおろか、私の実力をも遙かに上回っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だが、勝利したところで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "その通りだ、マーガレット。ここで君が勝利したとて、それ以上何ができる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "確かに私はここで君に武器を取らせた。君自身も、もとよりそのつもりだったのだろう。だが……その後のことを考えていたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "私たちはこの決闘に、何も賭けていないのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……決闘に勝てば銀槍のペガサスが道を空けてくれるなどとは思っていないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "仮に──私がそこの感染者たちを街に入れたとしても、だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "その後彼らはどうなる？　カヴァレリエルキはどのように彼らを扱えばいい？　彼らはどうすればここで生きていける？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "おじさんの言うようなことは、私も考えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "現実は……試合とは違う。終わりもなければ、絶対的な勝者も存在しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だから、私は決めたんだ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "昨日、監査会から手紙が届いた。そこには、メジャー開催中にカジミエーシュの感染者連合医療組織が多大な貢献を果たしたと書かれていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "そして各界からの強い要望を受け、監査会は引き続きこの組織をカジミエーシュ内で活動させ、合わせて専属の監督管理機構の設立を考えているとも書かれていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "そしてその管理機構には……両者間の窓口となる人間が必要になるそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "マーガレット、つまり君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "大騎士長に伝えてくれ。私はこの仕事を受けるつもりだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "マーガレット。まさか決闘の前から決めていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だが、あなたたちも私の決意の程を見たいだろうと思ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "は……ははっ……マーガレット、本当に見違えたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "昔の君は、いつも一人で突き進み、周りを一切顧みずに己自身を燃やすことしかできなかった──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "一体いつの間に、その思慮深さを身につけたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……どうすればより多くの人を救えるか考えた結果だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "やむなく故郷を去ってからの数年間で、新たな仲間ができた。驚くような武芸は持たなくとも、どんな騎士にも引けを取らない真っ直ぐな心を持つ者たちだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "今の私は、まだまだ彼らほど思慮深く行動できるとは言えないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "それでも……私の光で、より多くの地を照らしたいと思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だからこそ、私も変わらねばと考えたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "なるほど。悪くない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "マーガレット、本当に素晴らしい仲間に出会ったようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "全隊に告ぐ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「銀槍のペガサス」",
      "text": "感染者の入城を許可する！　今後の感染者の管理については、現段階ではマーガレット・ニアールが担当する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性感染者",
      "text": "街に入っていいの……？　あ……ありがとうございます耀騎士様、あなたは命の恩人です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "耀騎士……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "……あんたを信じていいのか？　俺たちを助けて、あんたにどんなメリットがあるんだ？　カヴァレリエルキに戻るだけで一苦労の俺たちに、これからどんな生活が待ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……すまない。私には答えられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "当分……いや、もしかしたらかなり長い間、あなたたちに何の保証もしてやれないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だがこれだけは約束できる――私は歩みを止めない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "あなたたちが今後も歩み続ける、困難に満ちた長き道、それが……私の守り抜くべき領土だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "耀騎士様──これらの資料にお目通しくださったのですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ええ、全て拝見しました。代弁者さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "私は代弁者の職はすでに辞しております。どうかマルキェヴィッチとお呼びください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "分かりました。ローズ新聞会長補佐の──マルキェヴィッチさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "簡単な取材だと思っていましたが、わざわざあなたがいらっしゃるとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "……簡単な取材？　とんでもない！　耀騎士様、あなたは優勝後あらゆるメディアの取材をお断りになられています。カメラの前に姿を見せるのはこれが優勝後初なのですよ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "メディア業界に足を踏み入れたばかりの新人として、このような得がたいチャンスを逃すわけには参りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "今回の取材を受けることにしたのは、あくまでついでです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ここへ来た一番の目的は、あなたたちにお礼をすることですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "お礼？　ああ、なるほど。先週の感染者の処遇に関する報道のことですね？　あれはただ、医療分野のマイナーな週刊誌に記事を掲載したにすぎません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "正直に言えば、少し意外でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "感染者が直面している様々な困難について、我々が肯定的に報道するとは思わなかったということでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……と言うよりも、報道の内容を問わず、メディアは必要のない時にあえて感染者の話題に触れることはないと思っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "ははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "あなたの中に、私たちに対する小さなわだかまりが残っていることは理解できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "ですが、状況は刻一刻と変わり続けています。ご存じかとは思いますが、メジャーの開催期間中、私とロドスのリーダーの間にも素晴らしい協力関係が築かれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "となれば、私たちの間にもいずれ、友情の火が灯ることを期待してよいのではないでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マルキェヴィッチ",
      "text": "私たちは互いに、カジミエーシュの未来をより良くしたいと考えているのですから。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "正装に身を包んだ会長補佐が手を差し出した。マーガレットは少しためらった後、その手を握った。\nその手は騎士のそれとは違い、鍛錬を重ねた武骨さはなく、ましてや山を開き石を砕くような力は微塵も感じられない。\n──しかし、その手は燃えるように熱かった。\nその温度は、一瞬のうちに戦士の血を滾らせた。\nマーガレットは、この感覚をよく知っていた。戦場へと赴くたび、競技場の中央へ立つたびに、彼女は同じような興奮を覚えるのだ。\nカジミエーシュの未来の日々は、彼女が対峙すべき目に見えない煙と火であふれているのかもしれないのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "そうですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "より良い明日のために。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
