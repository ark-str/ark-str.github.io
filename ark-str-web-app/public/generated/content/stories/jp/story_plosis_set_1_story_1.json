{
  "server": "jp",
  "storyId": "story_plosis_set_1_story_1",
  "groupId": "story_plosis_set_1",
  "stageId": null,
  "title": "真暗の夢",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_plosis_1_1.txt",
  "sourceHash": "94e4210d549ae0b0a5acdb6b12822c91502061e60e73bb188f68e553ac82f6f6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これら全ての情報が我々の仮説と一致する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "データを入手した今、ライン生命の最新の研究成果が、サルカズの古い伝説と符合しているという事実は、偶然の一致ではないと考えられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そしてもしこの仮説が実証されれば、我々の源石に対する多くの認識が改められることになるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "源石はエネルギーであり、災害そのもの、そして兵器としての運用など、制限付きで応用できるもの――それが現状の認識だが、恐らく実際はそれに留まらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もしも本当に源石が「情報を保存」しているとしたら？　想像してみてほしい。私たちは源石から、この大地の百年前、千年前……果てはそれよりも昔の物語を読み取れるかもしれないのだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "実に興味深くはないだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "これまでのレポートは全て拝読しました。あの推測については私も同意見です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョイス",
      "text": "ですが、私は何を手伝えばいいのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "同意してくれたということか。それはよかった……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "実は大胆な計画を練っているんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "6月18日　晴れ",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "今日は食堂で居眠りしてしまい、グムさんに心配をかけてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "サイレンスさんに、フィリオプシスの「過眠症」は、今月になって悪化していると言われてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "身体検査報告書に詳細が記載されています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "「長期的な睡眠の質の問題による精神的疲労」というのが、身体検査による結論です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "サイレンスさんによれば、フィリオプシスの大脳内に埋め込まれているチップ──九号デバイスが原因とのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "それについては、心配をしてくださる方たちよりも明確に、問題の所在を理解しています。しかしそれでも彼女たちの関心を無下にするわけにはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "サイレンスさんからは、休息時間を増やしてはどうかとアドバイスされました。それについてはフィリオプシスも同意しますが、休息中は何をすれば良いのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "次の一手をどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ううむ、もうその必要はなかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "この一局は……儂の負けじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "へぇ、珍しいこともあるもんだ。じいさん、あんたが最後にチェスで負けたのはいつだったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "……相当昔じゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "三時間前の記録開始時点から現在までのフィリオプシスの対局成績は一勝二敗です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "三番勝負の結果算出方式に基づけば、この対局の勝者はレンジャーさんになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "ブハハハハハハ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ハッハッハ……儂に花を持たせてくれるつもりかの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "あなたの言葉の真意が読み取れません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "お嬢さん、おぬしはチェスを教わりに来てから、わずか二十分ほどの手ほどきを受けたに過ぎんじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "それからたった三局打っただけで、儂を完膚なきまでに叩き潰したんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "これを負けと言わずに何と言うんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "真意を確認──理解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "だけど、なんでせっかくの休みにチェスなんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "医療部は最近忙しいんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "サイレンスさんの提言です。サイレンスさんは、フィリオプシスが何か趣味を持ち、気を紛らわす必要があると考えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ふむ、それでチェスか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "はぁ……俺もあんたと対局しようと思ってたけど、やっぱりやめとくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "あんた、本当にこの手のゲームは初めてなのか？　飲み込みが早すぎるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "はい。こういったゲームは初めてです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "ですが以前に他のオペレーターたちに教わって、別のボードゲームやカードゲームをプレイしたことはあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "大部分のゲームは、極めて短時間で終了しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "何が起こったかは大体想像がつくぜ。みんなあんたに負けちまったんだろ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "そうおかしな話でもあるまい。医療部のオペレーターは皆、若くて優秀じゃ。複雑な医療アーツを掌握できる才能があれば、チェスを覚えることなど造作もないのじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "しかしチェスがしたいのならば、ドクターを訪ねればよかったのではないか？　この類いのゲームは一通りできるし、レベルもかなりのものじゃぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "そうは言っても、ドクターが暇なタイミングを見計らうのは難しいだろ……あの人は三人に分裂しても手が足りないくらい忙しいんだからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ああ、今のは失言じゃったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "レンジャーさん、本日の対局を終了しますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ふむ、今は何時かのう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "えーっと……時計はどこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "午後四時三十五分、レンジャーさんの勤務スケジュール──つまり本日の勤務開始まで、あと三時間です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ならば時間は大丈夫じゃな。もう一局お手合わせ願おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "ですが本日、レンジャーさんには緊急任務の発令が予想されます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ほう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "直近十日間の、天災トランスポーターから提供された各種データ、及び源石粒子の検出データから推測を行った結果、ロドスは天災を回避するため、本日中に移動を開始する可能性があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "その際、防衛人員を事前配置する必要があると思われます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "それは儂の耳にも入っておるが、ドクターたちはまだ検討中で──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送",
      "text": "ロドス艦内に告ぐ、ロドス艦内に告ぐ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送",
      "text": "天災を避けるため、本艦は二時間後に回避行動を取ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送",
      "text": "各位、オペレーターマニュアルに基づいて、事前準備を行ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ははは、どうやら本当にそうなったようじゃな。ならば今日はここまでとしよう。儂は仕事の準備にとりかかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "俺は時々、本当に不思議に思うぜ。フィリオプシスさん、あんた一体どうやって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノイルホーン",
      "text": "いや、なんでもない。聞かなかったことにしてくれ。失礼な質問をするところだったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "6月22日　晴れ",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "今日はメイヤーさんの研究室を訪問し、九号デバイスの動作状況について、自分一人では実行不可能な検査を行いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "その結果に基づき、メイヤーさんはある憂慮すべき可能性を提示しました。それについては、フィリオプシスも考えたことはありますし、自分なりの予測もあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "その可能性を除いても、やはり九号デバイスは脳に大きな負担をかけているようです。その影響が強まる傾向は見られませんが、フィリオプシスが常に今の水準で耐え続けることは不可能です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "ダラは天才と言えるでしょう。彼女の研究成果は──たとえ瑕疵があるとしても──守られるべきです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "九号デバイスは、確かに負の影響をもたらしていますし、故障の可能性もあります。しかし、これが脳の機能障害を安定させてくれなければ、このように分析する機会すら得られませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "それ以外にも、ダラの発明は各種機能にアップグレードをもたらしてくれました。実験前に予想していたものも、その予想を超えるものもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "その影響で、フィリオプシスは源石粒子が人体の内部で流動している様子を見られるようになり、それを応用することで、医療系アーツに対する理解とコントロール能力が飛躍的に強化されたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "それができたのは、フィリオプシスの大脳の計算能力が大幅に向上したからというだけではなく、九号デバイスを通して、源石の情報保存媒体としての機能が働いたからだとダラは考えていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "九号デバイスはそういうものなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "これには他の用途も存在しうることは明らかです。源石のように、人を助けることもできれば、破壊をもたらすこともできます。しかしその運用は、より直観的に行われるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "……それはダラが求めた結果ではありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ちょっと待っててね……どれどれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "電圧は安定してる。受信機も問題なし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "特に問題はないかな。九号デバイスは正常に機能してるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "データローディングアプリケーションに変化はありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "……うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "残念だけど、やっぱりないみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "このデバイス、本当にデータ出力なんてできるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "データ出力は設計者が最初に設計した機能です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "でも解析を始めてもうずいぶん経つけど、意味のあるデータは何も受信できてないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それより頭の中にこんなチップが入ってて、本当に辛くないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "単なる電気信号の伝送だとしても、少なからず体への影響は出そうだけどね。精密機械って何があるか分からないから怖いんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "現在まで、生理指標に影響するような副作用は起きていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ダラレイドさんはホントにすごいよね……このプロジェクトにはエンジニア課は関わってないってのに、こんな革命的な発明をしちゃうなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "具体的な構造が気になってしょうがないよ！　どうにかして見せてもらえないかな？　設計図とか、予備のパーツとかないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "いいえ。九号デバイスに予備はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "はぁ、残念だなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "でもさ……ジョイス……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "どんな機器にも寿命はあるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "いや、九号デバイスの設計はかなり複雑だし、もうチップそのものに限った話でもないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "チップはジョイスの小脳と繋がってて、脳内の大量の神経と互いに影響し合ってるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "どこか一箇所でも問題が起きちゃったら、破滅的な被害をもたらす可能性があるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "君とダラレイドさんが何を考えてるかは知らないけど……ライン生命の判断基準に照らし合わせても、危険すぎるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "……生物の構造の──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "言いたいことは分かるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "「生物の構造の本質とは、合理的に動作する精密機械である」ってやつでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まるでエンジニア課のお年寄りたちの言葉みたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "だけど現実的な問題にだって向き合わなきゃだめだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "もしいつか、九号デバイスが故障したり、完全に失効しちゃったりしたらどうするつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "関連のレポートはまだ読み終えてないけど、今の君は生命維持すら九号デバイスに頼らないといけないんでしょ。サイレンスから聞いてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "ですので、定期的な身体検査は必須になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "身体検査がどうとかいう問題じゃないよ。ジョイスの命に関わることなんだってば！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "理解しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "私の口から言うべきことじゃないかもしれないけど、本当に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "本当にロドスに助けを求めようとは考えないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "クロージャさんに相談しに行ってみれば？　彼女は私がここ数年で出会った中で、最高のエンジニアの一人だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "ご心配いただきありがとうございます、メイヤーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "この問題は今後の状況に基づき検討、判断します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "……はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女はまた深い夢の中にいた。\n夢の中で、ジョイスは霧の中に立っていた。ささやき声が耳元をくすぐる。\nその声の内容を理解することはできない。今まで聞いたことも、学んだこともない言語だ。\nそれは遙か彼方から、ほとんど聞き取れないほど低い音で微かに響いてくる。\n彼女は霧に包まれた夢の中を、あてもなく彷徨っている。\nほどなくして、どこからか光が差し込んできた。霧を突き破ったその光は、周囲を照らし出した。\nするとそこに巨大な源石の結晶が見えた。内部には不思議な光が煌めいている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今のところ、重要な生理指標はどれも正常だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "だけど睡眠の質は相変わらず低いままだね。やっぱり一晩中夢を見ているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そういう状態が長く続くのは、良くないサインだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "ですが、生理指標に異常はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "この生理指標じゃ何の参考にもならないよ……あなたも分かってるでしょ？　休みたくても休めない状態が長く続けば、いずれ命に関わるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ケルシー先生に相談するべきかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "先生なら、きっとあなたのストレスを緩和する方法を考えてくれるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "それは拒否します。九号デバイスはライン生命の機密実験プロジェクトです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もうそのプロジェクトなんて誰も気にしていないかもしれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ダラレイドさんのプロジェクトチームだってとっくに解散してる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "恐らく……いや、きっとあなたは、九号デバイスプロジェクトの最後の遺産なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "サイレンスさんは、あの話を信じますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あの話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "「源石の中にはこの大地の情報が保存されていて、百年、千年、果てはそれよりも昔まで遡ることができる。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ライン生命にいた時、ダラレイドさんのプロジェクトについては、ほとんど把握してなかったし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私の専門でもないから、その問題については答えられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "だけど器機のフィードバックデータから判断すれば、あなたの夢の中の出来事全ては、九号デバイスが原因だと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "おそらく起きている間に受け取った情報を、九号デバイスがリファクタリングして、夢の中でループ再生してるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "この「ループ再生」は、あなたが超合理的な論理的思考に固執するようになったのと同じような副作用の一つだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "たとえ睡眠中であっても、デバイスが強制的にあなたの大脳を興奮状態に保ち続ける――それがあなたの睡眠の質が悪いことと「過眠症」の原因だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……あなたも知ってると思うけど、ダラレイドさんのプロジェクトには事実上多くの問題があったんだ。ほとんどの基礎理論は推測の域を出ず、論証が足りなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "実験全体の基礎理論すら固まっていなかったのに、彼らは無理矢理ダラレイドさんに実験を進めさせた……あなたが今のような状態になってしまったのはそのせいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "当時、ライン生命の誰もが、この実験は失敗するって思ってたし、被験者のあなたがこうなる可能性だってみんな──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "否定します。その見解は事実と異なります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "外部の方の判断には、重要な判断材料が欠落しています。失敗の原因はダラにはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "別にダラレイドさんを責めてるわけじゃ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……ダラ？　普段そう呼んでたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そうだね、友人同士だったものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "彼女の死は……あなたと直接的な関係はないし、私に彼女を責める権利はないけど、彼女の研究に対する行き過ぎた執着が悲劇を招いたことは確かだと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "こういう悲劇は……ライン生命にいる間に、数え切れないほど見てきたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "とにかく、もし本当にダラレイドさんに原因があったとして、それを話したくなったらいつでも私やメイヤーに言ってくれて良いからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あの一言に囚われていてはダメ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それから、何でも心の中にため込まないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ずっとそんな張り詰めた精神状態で生活するのは、あなたにとって百害あって一利なしだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今のあなたは私の助手で、友人でもあるんだよ。私は友人には……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……友人たちには、より良い日々を送ってほしいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "理解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "ご心配をおかけしました、サイレンスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "サイレンスさんとの関係を──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "──「友人」として登録し直します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……冗談も言えるくらいだし、確かに大きな問題はなさそうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でもやっぱり心配。来週はケルシー先生と外勤に出るんだけど、あなたのことを思うと気が気じゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "とにかく、今後も何か異常を発見したら、必ず私に言うようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "ありがとうございます、サイレンスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そうだ。悪いけど後でこの薬をイフリータに届けてくれないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今日は帰りが遅くなるかもしれないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "承知致しました、サイレンスさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "つまんねーな……今日はサイレンスは来ねーのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "サイレンスは今日忙しいの。代わり私が来てあげたでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "はぁ……サイレンスがいなけりゃ宿題せずに済むと思ったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そんなふうにダラダラやってたら、後でドクターを呼ばれて、監視されながら宿題する羽目になるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ないない。だってドクターの方がサイレンスより忙しいだろ。いつ執務室に行ってもいねーんだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "確かに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "お、サイレンスか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ジョイ姉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "サイレンスはまだ残業中？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "これはイフリータの薬です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "うへぇ……また苦ぇヤツかよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "そこ置いといて、後で飲ませとくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "それとこれは、イフリータのおやつです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "やったぜ！　サンキュー、ジョイ姉！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ちょっと！　おやつは宿題が終わってからだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "すぐに片付けてやるぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "今日のテストは七十点だったんだぞ、すげーだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "努力をすれば結果として表れます。引き続き頑張ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "簡単な問題にしてあげたんだし、七十点なんてまだまだだよ。もっと頑張らないとね、イフリータ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "分かったよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "そういえばさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ジョイ姉、今日はどうしてそんな嬉しそうなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "偶発的に好ましい出来事が発生したためです。まだ強い感情の動きを表出しなければならない状況には至っていませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "へ？？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "いやいや待って！　イフリータ、どうしてジョイスが喜んでるって分かったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "は？　見りゃわかんだろ？　ジョイ姉が喜んでる時はな、眉毛が少し上がって、おでこがちょっと引き締まって、口角も動くじゃねーか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "……それ、どうやって見つけ出したの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "んなモン、慣れだよ慣れ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "6月23日　曇り",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "サイレンスさんはフィリオプシスのことを友人と語りました。その言葉には本当に感謝しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "サイレンスさんは優しい方です。だからこそ、余計な負担をかけたくありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "サイレンスさんはすでに、多くの重荷を背負っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "イフリータに宿る「炎魔」、サリアさんと向き合うべき問題など、数えればきりがありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "しかし……もし私の運命がすでに確定しているとしたら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "サイレンスさんとイフリータに良い結末が訪れることを、ただ願うばかりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "フィリオプシスと彼女たちの状況は異なりますが、どれも「ライン生命の実験にはつきものの問題」と一括りにすることもできます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "ライン生命には、私たちのような方がたくさんいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "外部の人々は、クルビアの科学研究は人体実験に手を染めていたと認識しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "しかしその実情を説明するならば、もう一言付け加える必要があります。多くの実験は「情熱」を抱きすぎた科学者が、自身の肉体を用いて行ったものなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "日記",
      "text": "……その中で満足な結果が得られたのは、ごく少数でしたが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "夢──\nジョイスの夢は、幻覚とささやき声で溢れている。幻の世界は、理解できないことばかりだ。\n彼女は来る日も来る日も、長い夢の中を歩く。理解はできないが、そんな光景にもとっくに慣れてしまった。\nしかし、彼女はある時、いつもの夢が突然はっきりとし始めたことに気が付いた。\n耳元で聞こえていたささやき声が、徐々に判別できる言葉へと変化していく。\n視界を覆っていた薄い霧もゆっくりと晴れていった。\n彼女は高くそびえる山の頂上に立ち、眼下に広がるものを見下ろしている。\n彼女の前で、雄大な都市が金属の光沢を放つ砂埃の中で崩れ落ち、地面に突き立った鉄骨が粘土のように溶け出す。\n彼女の前で、恐ろしい影が雲の合間を漂っている。そのゆらめく巨大な影は太陽を覆い尽くし、全てを包み込んでいく。\n彼女の前で、すさまじい金切り声と絶望の叫びが都市中に広がる。\nそして彼女の背後では、源石の結晶が妖しい光を放っている。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
