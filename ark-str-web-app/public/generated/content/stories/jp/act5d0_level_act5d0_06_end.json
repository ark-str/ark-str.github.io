{
  "server": "jp",
  "storyId": "act5d0_level_act5d0_06_end",
  "groupId": "act5d0",
  "stageId": "act5d0_06",
  "title": "10:26P.M.",
  "storyCode": "CB-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act5d0/level_act5d0_06_end.txt",
  "sourceHash": "f8f6b1c3720480d8e1d313d6456f3009be16d64f2f8c83412a5f8200611bd1d5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "よぉ、シラクーザの負け犬ども。もう弾切れか？　俺はまだ生きてんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "流石はエンペラーだ。あんだけぶち込んだのに、まだグラス持って余裕こいてやがる。運のいい奴め。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "……本気の殺し合いするなら、龍門も黙ってないと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ゲームはルールを守らないと、強制退場させられるの知らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ルールだと？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "龍門の警察がここに着く頃には、テメェらはバラバラの死体になってるだろうよ。ペンギン急便。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……通りにいるのも、全部奴らの仲間みたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "なんや裏口までびっしりやん。こらキッツいなぁ、あのボス、よっぽど根に持っとったんやな。ホンマ、やることが徹底しよる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "カポネの腰抜け野郎は、鼠王とウェイのヤツを気にしすぎだ。確かにウェイには気をつけねぇといけねぇけどよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "テメェや、あの鼻につくネズミのジジイは、人をイラつかせるのは一流だが、それ以外は一銭の価値もねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "へぇ、お前、マジでそう思ってんのか？　それとも単にイキりてぇだけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "たりめぇよ。マジでそう思ってるに決まってんだろ、「エンペラーサン」よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "おいクロワッサン、瓶を寄越せ！　コイツの大脳皮質を治療してやろうじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやけどなぁ、ボス。ウチらもう百万もするワインをいわしてもうてんやで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "……じゃあ奴らの命の価値はどれぐらいだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "どう考えてもそんなん釣り合わんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "本気を出すのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "まさか。俺はウェイの坊主との約束はちゃんと守るぜ。龍門の中ではな、ガチで戦わず、命の取り合いせず、ビジネスのいざこざは、全部ビジネスでカタを付けるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "まーしっかしよ。今日は俺たち五時間も駆けずり回ったせいで、業務時間が普段の二倍もオーバーしてるんだ。二倍だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "それだけじゃねぇ。まる一年分の活動物資もダメにしやがった！　車にワイン、それから俺のレコードたち！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "いま、俺のこのバーの不幸な事故で死人が出たとしても、別に何の問題もねぇよな？　なぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "テキサス、この名前を聞いただけでもムカつくんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私にお前みたいなシラクーザの知り合いはいない。だがお前は、これからこの龍門からも逃げ出していくだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "俺のファミリーを侮辱したことを後悔させてやるよ。テキサス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ハッ、龍門に逃げ来た負け犬はどちらか。テメェが一番よく分かってるんじゃねぇか。お前なんざシチリア人に挑む資格すらねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "その顔だ、テキサス！　少しはシラクーザの人間らしくなってきたんじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "これは意外だね。君も呼ばれていたの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ええ、一応は。ですが、社交パーティーから抜け出すのもなかなか悪くないですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "うーん、こんなマフィアの小競り合いなんて、そこまで付き合う必要あるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "必要性はゼロですね。なので、私はあの面倒な場から抜け出すチャンスを伺っていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "クロワッサン用ハンマーのパーツ発注に、エクシアの銃のメンテナンスと、私には他にも色々とやることがありますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "うーん、それなら私も頼みたいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "構いませんよ。本業の他に、同僚たちのためにちょっとした雑務をこなすのも私の職務です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "このアーツユニット、保管していてくれるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "白のこちらですか。なるほど。その意味、お分かりですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "今夜はせっかくのお祭りだしね。少しは気楽に行きたいだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それを持ってダンスパーティーの会場に飛び込んでしまったら、さすがに混乱を起こすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "了解しました。お任せください。これも私の職務のうちですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "フフ、あれこれ言っても、やっぱり仕事になるんだね。君も本当に大変だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "終わったら一杯どう？　私が奢るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "喜んで。同僚と杯を傾ける方が、つまらないパーティーよりもずっと面白いですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "でも残念ですが、このままでは「大地の果て」を守りきるのは難しいかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……で？　君は龍門に帰ってきたばかりなの？　今夜のお祭り騒ぎはどれだけ把握している？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "全て。今回の騒ぎの経緯は、別に複雑なことではありませんし、状況は一目瞭然です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "助けに行かなくていいのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お断りです。肉体労働は血気盛んな子たちに任せますよ。私はあなたたちの荷物を預かりながら、お茶でも飲んで、事態が終息するのを待ちますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "鼠王が貴方のことをお待ちである以上、少しは楽しめるかと思いますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君もね、イース。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "せっかくの安魂夜なのに、そこまで根詰めて仕事する必要ないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "じゃあ、私は先に行くから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "……安魂夜ですって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "なんてこと、安魂夜は休みになるはずでしたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "つい働いてしまったようですね……。うーん。これはいけません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "幸い、彼女が貴方を私に預けていきました。珍しく思い出話に花を咲かせられるかもしれませんね。古き友よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イース",
      "text": "ふむ、貴方がこの手に収まる感じはなかなか悪くないですね。ふて腐れていても無駄ですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "もうお前に逃げ場はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "ハア、ハアッ、テキサス、テメェの腕前だけは名に恥じないようだな……。だからお前のファミリーは——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "黙れ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "テキサスさぁ～ん、あたしの方が一人多く倒してますよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "でもリーダーを倒したのはテキサスさんだよ。少なく見積もっても三人分にはなるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "え？　そうなると、もしかしてあたしの負けってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "誰もあんたはんと競争してせえへんって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "おっと、まだこないなところに無事な瓶があったわ。お値段見てみまひょか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ゼロが、一、二、三、……な、七つ？　はぁぁ、神様おおきに！　感謝いたしますよって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ビビるな！　こいつらたかだか五人だけじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "そんな月並みな台詞は要らねぇよ。ホァタァ——！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "ま、また頭を殴……うっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "俺を頭数に入れろっての。六人だろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "たった六人の運送会社と、武装マフィアが正面から戦って、まさか前者が勝つなんて……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "これ、どう考えても変ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "なんもオカシイことあらへん。乱闘ならウチらは龍門のトップやさかい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "——っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "お前らの負けだ。投降しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "負けだと？　投降だぁ？　ハッ、お前は本当にあの「テキサス」なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "一度剣を抜けば、シチリア人には「勝ち負け」なんぞ存在しねぇ！　あるのは「生か死か」のみだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガンビーノ",
      "text": "とどめを刺さなかったことを後悔するんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "爆破しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "——！　隠れろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "うわっ――また爆弾か――。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……チッ、また逃したか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "追いかける？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "いや。私もほんの少し、敵を甘く見ていたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……龍門に逃げて来た、ただの没落者だろうと、曲がりなりにもシチリア人気質があるマフィアということか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "テキサスさん、怪我してる！？　わ、私が手当てします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "傷は深くない。そう慌てるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "ダメです！　とにかく座ってください！　薬箱を探しに行かなきゃ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "シチリア人……。シチリア人とはどういう意味ですか？　シラクーザ人の別名ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "シラクーザ十二家の起源のひとつがシチリア連合だ。このシチリア連合は、最初に武力で戦果を挙げた都市国家なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "これがシラクーザ語の「シチリア人」の語源でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "しかし今は……この言葉は別の意味も含んでいる……もう「シチリア人」を自称するシラクーザ人は少ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "色々事情があり、没落していってるようだが……。奴らがこの名を自称する以上……うっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "もういいよ、テキサス。そんなに一気に喋ると疲れるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "つまり！　奴らは自分たちが強くて危険なマフィアだって、言いたいだけでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "なら、なおさら奴らの襲撃を阻止しないと。このままだと、損害は増えていく一方ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ぼくたちは反撃すべきです。そして必要なのは——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "……まぁちょっと待てよ。ところでお前らさ、あのアルコールアレルギーの間抜けバーテンダーにどんな言い訳すりゃいいと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "言い訳する余地なんてあらへんやろ……あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ボスが座っとるバーチェア、コイツにはキズ一つあらへん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "唯一の生き残りはこのバーチェアだけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "……はい、このバーチェアだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "おお、割れた酒瓶に荒れ果てた店内、これはこれでまた違った美しさがある。間違いねぇ。これぞまさしく俺流のアレンジの結果だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いやいや、さすがに強引すぎるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "こら全額賠償せなアカンのとちゃう？　うひゃ～。ペンギン急便の財布が寒なってまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "酒の匂いは酷いし、体もベタベタだが、傷口の消毒にはちょうどいいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "いやいや、ワインで消毒なんて無理ですよ。ここに医療用アルコールが……。って、なんでストローが刺さってるの？　ま、いいか。テキサスさん、私が消毒しますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "……気が変わった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "奴らがここまで頑なに安魂祭の日に喧嘩を売ってくる以上——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "いっそ奴らを永遠に安息させてやろうじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
