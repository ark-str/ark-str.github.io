{
  "server": "jp",
  "storyId": "story_aroma_set_1_story_1",
  "groupId": "story_aroma_set_1",
  "stageId": null,
  "title": "入職の誘い",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_aroma_1_1.txt",
  "sourceHash": "4a5f5796e64f0e5730b2bc25e867a9f0a5da0b7b7e44e99db7c5c6a3ca3f5138",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "どうぞ、アロマさん。試用期間終了の通告書です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "審査評価課の人事採用申請記録によれば、試用期間中におけるアロマさんの業務成績は大変優秀で、他部門からもスカウトが来ているのだとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "もちろん、最終的にどの部門に入るかは、アロマさんが決めることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "その、いつまでに決めればいいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "今週中にお返事をいただければ大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "どうか慎重にご検討ください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ありがと。ちゃんと考えてみるね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーターA",
      "text": "なんだよ、イレイザー。またランドリールームが使用停止になってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "ごめんなさい！　洗濯機が故障しちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "後方支援部とエンジニア部でなるべく早く修理するから、終わったらまた連絡するね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーターA",
      "text": "せっかくここまで並んだのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーターB",
      "text": "まあまあ、故障なんだから仕方ないだろ。また後で来よう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "本当にごめんなさい。できるだけ急ぐから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "はあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "もうこんな時間なのに、アロマはまだ戻って来ないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "あの子が手伝ってくれないと、こんなにたくさんの洗濯物、私一人じゃさばききれないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "……だけど、戻ってきた時にこの量のお急ぎの洗濯依頼を見たら、あの子でも、さすがに頭を抱えちゃいそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "って、そんなこと考えてる場合じゃないよ。アロマ、まだ宿舎にいるのかな？　呼びに行こっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "湯加減はどう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "もう少し熱くても大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "力加減は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "うん……いい感じ。とっても気持ちいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "でも、位置はもうちょっと上のほうがいいかも。そう、そこそこ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "了解、じゃあブラシはここで固定するね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "何かあったら、いつでも声をかけて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "どう、アロマ？　なかなかいい感じでしょ？　この尻尾専用のエステマシンは、エンジニア部が開発したばかりの新製品だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "うん、ほんとにすっごくいいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "でも、このセミナーって、エステを体験するだけなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "体験って大事なんだよ。人の体に使うものなんだから、ユーザーの感想を把握することが重要になってくるってわけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "へえ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "もちろん、セミナーはこれだけじゃないんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "ところでアロマ、後方支援部って毎日すごく忙しいよね？　仕事が終わったらもうクタクタじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "セミナーに関係なく、時間がある時はいつでもリフレッシュしに来ていいからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "えっ、本当に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "じゃ、ちょうど昼休みだし、お言葉に甘えてもう少しだけここで休んで行こうかな。午後にもまだ仕事がたくさんあるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "ごゆっくりどうぞ！　何か意見があったらぜひ聞かせてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "これはエンジニア部にとって必要不可欠な研究調査なの。みんなにより良い美容ケアとスタイリングサービスを提供するためにもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "そういえば、メイクとか美容とか、スタイリングって後方支援部の仕事だよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "なのに、ロベルタさんはロドスに正式に加入した時、どうしてエンジニア部を選んだの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "アロマー、いるー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "あれ、誰もいない……おかしいな、どこに行っちゃったんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "ん？　机に本が置いてある……『髪と被毛のケア技術』？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "うわっ、空白部分にメモがビッシリ書いてある。アロマは最近こんなことについて勉強してたんだね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "あっ、何か本に挟まってる……エンジニア部セミナーのお知らせ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "って、エンジニア部！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "そういえば、アロマってもうすぐ試用期間が終わるんだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "まさか……後方支援部がいやになったってこと？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "イレイザー先輩、アロマちゃん見なかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "あっ、セイリュウ。どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "今日は大浴場の清掃日なんだけど、アロマちゃん、手が空いてないかなって思って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "大浴場？　そこって別の担当がいるんでしょう？　なんでアロマを呼ぶの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "えっ？　えっと、その担当って、わたしなんだけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "つまり、大浴場だけじゃなくて、いまやアロマは艦内のあらゆるエリアの清掃担当に引っ張りだこってこと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "調理に失敗で油だらけになったキッチンの壁に、訓練場で粉々にされた杭の掃除……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "しかも、療養庭園の虫かごの丸洗いまで頼まれてるって？　アロマは虫が大の苦手なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "そう考えると、あの子ってとんでもない仕事の量を抱えてるんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "で、でも、アロマちゃんはいっつも余裕そうに見えるよ。それに、一瞬でパパっと作業を終わらせてくれるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "そうは言ったって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "はあ、確かに私もランドリールームの洗濯機が壊れると、真っ先にアロマの顔が思い浮かぶから、ほかの人を責めたりはできないや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "アロマはとっくに後方支援部の主戦力なのに、未だに正式採用の面談だってしていないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "色んなことを知ってて、呑み込みも早くて、仕事への姿勢も真面目で丁寧……エンジニア部があの子をほしがるのも当然だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "エンジニア部？　それってどういう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "こうしちゃいられない。このお急ぎの洗濯依頼は、手分けして片付けちゃおう。これ以上アロマの負担を増やすわけにはいかないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "アロマは後方支援部にとって必要不可欠な人員なんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "つまり……ロベルタさんがエンジニア部を選んだ理由は、テクノロジーの力でみんなの作業効率を上げたかったから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "そうそう、だって一人一人の力には限界があるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "あたしがいくらやる気を出しても、オペレーター全員のスタイリングを一日で終わらせるのは無理でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "それと同じで、アロマだって一日でロドスを全部きれいにすることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "でも、全自動のメイクアップマシンや掃除マシンがあれば、みんなの仕事がもっと楽になるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "しかも、対応できるオペレーターや場所の数も増える。ほらね？　「一日で終わらせる」っていうのも夢物語じゃなくなるかもしれないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "みんなに早くて便利でサービスを提供したい。それが、あたしがエンジニア部を選んだ理由だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "そっか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ねえ、ロベルタさん、そういう全自動のマシンができたら、人間の力はもういらなくなっちゃうのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "えっ？　どうしてそんなこと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "毎日繰り返しやるような作業なら、確かに機械のほうが私よりうまくできるかもしれないって、ふと思ったの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "それは違うよ、アロマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "確かに技術が進むにつれて、機械に取って代わられる作業が増えてるのは事実だよ。でも、人間と機械にはそれぞれの長所があると、あたしは思うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "「なぜやらなければならないのか、その理由を知ってるのは人間だけ」――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "おばあちゃんに言われたことを思い出したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "ああ、たしかに、シラクーザの人って機械よりも手作業のほうを信頼していたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "でっかいファミリーに必要とされてるのは、言うことをよく聞く手洗い洗車の働き手で、温もりを感じられない全自動洗車マシンじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "そういうの、ちょっと懐かしいかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "たしか、ロベルタさんもシラクーザ生まれだっけ？　それじゃあ、私たち同郷とも言えるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "まあ、私は小さい時にシラクーザを離れちゃったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "あたしも似たようなもん。もうずっと帰ってないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "シラクーザからきたオペレータに聞いたよ。今のシラクーザはすっかり変わっちゃったんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "アロマはもう一度行ってみたいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "私は――ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ごめん、メッセージが届いたみたい。ちょっと確認させて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "どうかした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……スケジュール変更のお知らせだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "でも変だな、午後の仕事が全部キャンセルになっちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "支援部がお休みになったってこと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ちょっとイレイザーさんに聞いてみる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……ダメ、ずっと通話中だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "時間ができたのなら、ほかの製品も試してみる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "エステマシンの自動運転モードもそろそろ終わりそうだし。次は寝たまま使えるメイクアップマシンなんてどう？　あと最新型の超音波口腔洗浄器もあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ううん、もう十分楽しんだよ。ありがと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "でも、マシンの体験とは別に、ロベルタさんに見てほしいものがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "これなんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "設備工事の申請書……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "よし、各エリアの清掃作業の再振り分けはこれで完了。アロマの担当箇所は、私とセイリュウで手分けするとして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "それにしても、食堂の栄養食のレシピ開発に、廊下の静電気防止装置の取り付けって……アロマ、清掃業務以外にもこんなにたくさんの仕事を抱えてたのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "まあいいや、とりあえず全部キャンセルしてあげたから、後でほかの支援オペレーターにお願いするとして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "さあ、ここからが正念場だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "ごめん、アロマってここに来てる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "あっ、あの子なら少し前に設計図を持って、ロベルタさんのところへ行ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "設計図？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "ああ、ウィーディさんに描き方を教えてもらったらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "最近アロマはよくここを出入りしてるんだ。色んなデータを持ってきては、大量の図面を抱えて帰っていく姿をここ数日ずっと見てるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "データ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "あっ、そういえば少し前に、アロマからランドリールームの資料について頼まれてたんだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "今使ってる配管の太さとか……排水口の瞬時最大流量とか……あと一定期間内の消費水量とか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "ああ、ここ数日ずっと修理のことで頭がいっぱいだったから、すっかりそのことを忘れてたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "いや、ちょっと待って……アロマって、エンジニア部古参のウィーディさんとそんなに仲良かったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "忙しいウィーディさんが、アロマの頼み事を優先してるのに、私は……あの子の努力がまったく見えていなかったうえに、珍しく頼み事をされたのに聞き流しちゃってた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "だから、試用期間が終わったあとのことについて、何も相談してこなかったんだね。アロマの中では、とっくにもう答えが出てたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "終わりよ……もう何もかも、終わり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニアオペレーター",
      "text": "いや、アロマは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "いいの、全部わかってるから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "アロマの選択を尊重するよ。でも、せめて最後に何か手伝わせて。短い間だけど、一応は後方支援部で共に奮闘した仲間なんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "設備工事の申請書……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "しかもこれ、今体験してもらったエステマシンの初期設計図もあるじゃない！？　私が適当にメモした雑誌出版社の電話番号まで書いてあるし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "えっと、実はウィーディさんのところでこれを見つけたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "今日セミナーに来たのも、ウィーディさんからこのエステマシンについて教えてもらったから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "あっ、後ろに挟んである資料も読んでみて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "各種族のオペレーターの髪及び被毛の調査報告書？　しかもすごく詳しく書いてある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "これ全部自分で調べたの？　すごい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ううん、みんなが助けてくれたおかげだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "それで、資料に書いてあるエステマシンの改良提案だけど、いけそうかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "うん、ざっと内容に目を通してみたけど、種族ごとの毛質に合わせて改良を加えるのはできると思うよ。でも、このマシンはまだテスト段階で、最終的な承認審査はこれからなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "改良版の大量生産に、ランドリールームと大浴場での一括設置ができるかどうかは、クロージャが首を縦に振るかどうか次第だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "それなら心配いらないよ。大浴場に新しい設備を増設できるスペースがあるのは、ウィーディさんに確認済みだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "マシンの性能テストもできるかぎり協力するし、興味があるから体験してみたいって言ってるオペレーターもたくさんいるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "……それは別に構わないんだけど、どうして急にこんなことをしようと思ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "このマシンは、体験セミナーのためにあたしが個人的な趣味で開発しただけなのに、どうしてこんなに大掛かりなことになってるわけ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "アロマ、一体どういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "実はね、今のロドスは抜け毛の危機にさらされてるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "あれ……セイリュウさんたち、何を運んでるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "今日の廃棄物搬出申請書にそんなものはなかったはずだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "ええっ？　ちゃんと申請したよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "ここにあるのは、艦内の色んな場所を掃除して出てきた、みんなの抜け毛だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……この「小さな山」が全部人の体から抜けた毛だってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "そうなんだよ！　アロマちゃんは来たばかりだから、まだ知らないのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "ロドスにはたくさんの人が暮らしてるから、毎日髪や毛がいっぱい抜けるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイリュウ",
      "text": "だから、すぐにお掃除しないと、排水管とか通気口があっという間に詰まっちゃうんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "だけど、いくらなんでもこの量は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "うーん、ダメね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ここにある配管はどれもロドスの動力エリアを通ってるの。そう簡単に動かせられるようなものじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "アプローチの方向性を変えたほうがいいと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "例えば……ん？　どうして私をそんなにじーっと見つめてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……ウィーディさん、さっきどこにいたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "えっ？　食堂だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "だいぶ混んでたみたいだね。人混みの中、もみくちゃになってやっとの思いで抜け出してきたんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ちょっとじっとしてて。肩に毛がたくさんついてる。誰かのしっぽの毛みたい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "よし、全部取れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ウィーディさん、大丈夫？　顔色が悪いみたいだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "うわわ、消毒プレーガンをこっちに向けないでよ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "アロマ！　ほんっとごめん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "いいよ、別に……ここにある服を洗えばいいんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "でも、洗濯機の故障は今月でもう三回目でしょ……そのたびにランドリールームを閉鎖してちゃ、きりがないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "エンジニア部は故障の原因はなんだって言ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "それがね、笑っちゃうような話だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "洗濯機の排水管に色んな毛がびっしり詰まってたのが原因なんだってさ。全部の洗濯機がそんな状態だったんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "もう一回エンジニア部のとこに行って、排水管に改修の余地があるかどうか聞いてみる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "解決策が見つかるまでは、洗濯機を回す前にまず徹底的に掃除をしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "なるほど……それは確かに一大事だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "うん、この問題を完全に解決する方法がないことはわかってるよ。でも、それならせめて、抜ける毛の量を少しでも減らしたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "だから、色んなエリアで仕事をする時に、そこにいるオペレーターたちを観察してみたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "そしたらね、ファスナーを開け閉めするだけで、毛が挟まって抜けちゃう人とか、毎日そっとしっぽをズボンから引っ張り出して、丁寧にブラッシングしてる人がいることに気づいたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "しっぽだけじゃないよ。頭に耳、あと首の後ろの毛が抜けると、そのまま服やズボンにくっついちゃうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "それと、洗濯をする前に、一回コロコロで毛を取ってる人もいるんだよ。私に見られてることに気づくと、みんな気まずそうに笑ってた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "それで私、やっと気づいたの。抜け毛の危機の裏に潜んでる本当の問題に……たくさんのオペレーターが自分たちの抜け毛に悩まされてるんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "たしかに私たちは、毎日抜け落ちた毛を掃除してるけど、みんなの悩みを解決しようと思ったことは一回もなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "だから……みんなのために何かしたくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "それでエステマシンを改良することを思いついたんだね……でも、このマシンだけじゃ足りないんじゃない？　もっと色んな方面からの対策が必要だと思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "だから、食堂に毛髪にいいメニューを何個か入れたんだ。これからも、種類を増やしていく予定だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "支援部が提供してるシャンプーも、全毛質共通タイプ以外に、種族ごとの毛質に合わせたものを増やしていくつもり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "それとね、午後に入ってた仕事は、倉庫にある静電気防止装置の在庫確認だったんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "……もう十分だよ、アロマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "本当にすごいね。君のがんばりがよく伝わってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "ところで、さっきあたしたちが話してた内容、まだ覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "えっ、なんだっけ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "たとえば、あたしが誰かにメイクをする時、まずその人の顔のパーツから、活かしたいポイントを決めるの。それがメイクにおいて一番大事なステップなんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "その後、メイクアップマシンに任せるか、手に馴染んだメイクブラシを使うかは状況次第。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "ほら、これってアロマのやり方と同じじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "う～ん、難しいことはよく分からないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "私はただ、みんなのちょっとした悩み事を解決することで、もっと快適に暮らせるようになってほしい……それだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "それが、ロドスのオペレーターとしての私の役割だと思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "……君のおかげで、新しいインスピレーションが湧いてきたよ。エステマシンにカラーリング機能を追加するのはどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "今見せてもらった調査資料にも、たくさんのオペレーターが自分の毛色に不満を持っていると書いてあったしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "とにかく、エンジニア部に君のような新戦力が入ってくれてうれしいよ。そりゃウィーディも熱心に世話を焼くわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "へ？　エンジニア部の新戦力？　私が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "待って……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "アロマ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "イレイザーさん？　どうしてここに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "ほ、ほら！　前に頼まれてたランドリールームの各数値をまとめた資料と構造図！　それと利用者の統計調査資料も持ってきたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "ほんっとにごめん！　最近忙しくてすっかり忘れちゃってたの！　エンジニア部での作業に遅れが出てなければいいんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "あ、ありがと……でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "アロマが請け負ってた仕事は全部、ほかのオペレーターに振り分けておいたからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……私の仕事を全部？　えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "だから突然午後のスケジュールがみんなキャンセルになったのか……でも、どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "実はね、今夜食堂でパーティーを開こうと思ってるの。アロマが無事に試用期間を終えて、正式にエンジニア部の一員になったお祝いにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "きっとがっかりさせないから、ロベルタさんとの話が終わったら絶対に来てね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……何か勘違いしてない？　私、エンジニア部には入らないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー＆ロベルタ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "来週から正式に後方支援部に加入するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "つまり、うちを選んだってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "でも、ロベルタさんのセミナーに参加してるんだよね？　それに設計図だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "ああ、それも後方支援部のためなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "じゃあ……ほかの部門からもスカウトが来てるって話は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……声をかけられてるのは購買部だけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "実家の工房がボディケア用品を大量に送ってきたせいで、私が何か特別な仕入ルートを持ってるんじゃないかって、購買部の人が勘違いしちゃったの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "そもそも、ちゃんと工学の勉強もしたことのない私なんて、その道の専門家とは比べ物にもならないって……エンジニア部が自分に合わないことは、自分が一番よくわかってるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "いいんだよ、違う部門でも、聞きたいことがあったら、いつでもあたしのところにおいで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "……いや、これからも絶対に遊びに来てほしいな。君に似合うリップがあるかもって、今急に思いついたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "とにかく、これもあたしの研究活動の一環だからさ……考えておいてね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "う、うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "つまり、全部私の早とちりだったってことか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "よかった……支援部の部長に怒られるとこだった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "あれ？　もう行っちゃうの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イレイザー",
      "text": "うん！　はやくみんなにこのグッドニュースを伝えないと！　それと、パーティーの飾りつけも「エンジニア部」から「後方支援部」に変えたいから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "はあ、やっぱりちょっと残念だな。頼れる後輩がまた一人増えたと思ったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……ごめんね、ロベルタさん。私が紛らわしいことをしちゃったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "そんなこと、気にしなくていいって。それより、エステマシンの改良の件はあたしに任せて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "だって、これもロドスのみんなのためだもんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "……うん、ありがと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "そういえば、さっきのシラクーザに行ってみたいかって質問、まだ答えてなかったね。手元にある仕事を片付けて時間を作ったら、一回生まれた町に行ってみようと思ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "昔の私じゃ見上げることしかできなかった壁も、今の私ならきっと乗り越えられるはず。きっと、シラクーザも同じだと思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "text": "いいね。予定が合えば、あたしもご一緒させてもらおうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アロマ",
      "text": "もちろん！　楽しみにしてるね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
