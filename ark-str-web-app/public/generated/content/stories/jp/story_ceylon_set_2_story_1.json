{
  "server": "jp",
  "storyId": "story_ceylon_set_2_story_1",
  "groupId": "story_ceylon_set_2",
  "stageId": null,
  "title": "残されたもの",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_ceylon_2_1.txt",
  "sourceHash": "7c9b40a3f4b77a5205d2ac100ea2746c9106db09e7cb1ce3c114b80f654c7358",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任、どうしても無理なんでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "サンドグラスさん、貴方ならよくご存じでしょう。感染者の遺体を外部に持ち出して葬儀を行うことはできませんのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "だったら、遺灰なら構いませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……たとえ遺灰でも、特殊な処理を施し、危険がないことを確認してからになりますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "でも事務所はまだ建ったばかりで、そのような設備はまだ整っていませんの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "だったら、いつになったら持ち出せるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "今すぐ申請を出したとしても、本艦の審査が終わってから機器が届くまで……早くとも、半年はかかってしまいますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "……どれだけ残酷なことを言ってるかお分かりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "私は主治医で、親友でもあったのに、最期の時にすらそばにいてあげられませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "あの子の遺体は、ずっと隔離されたままです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "そして今、遺灰を受け取るためですら申請が必要だと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "しかもその申請も、すぐには通らないなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "サンドグラスさん、お願いだから理解していただけないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "どうしてそのような規定があるのか、貴方は分かっているはずよ。その中にはわたくしたちで一緒に定めたものもありますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "ロドスで働き始めて一年、一度も不満を言うことなく尽くしてきました。これは私のたった一つのお願いなんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "あの子が生きている間、一緒に旅行へ行ってあげることは叶いませんでした。だから、せめて亡くなった後くらい……あの子の遺灰を連れ出してあげたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "それが、彼女の最後の望みなので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "サンドグラスさん、わたくしたちは医者ですのよ。全ての人に平等に責任を負う必要がありますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "だったら、医者は私情を捨てなきゃいけないんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "落ち着いて、サンドグラスさん。口喧嘩をしたいわけではないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "貴方がどれほど辛いかはよく理解していますわ。わたくしも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "もしいつか、シュヴァルツさんにもこんな日が来たとして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任は今みたいに規定を持ち出して、自分を納得させられるんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "なっ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "端末の通知音声",
      "text": "遺体処理が間もなく開始します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "端末の通知音声",
      "text": "責任者の方は識別コードによる認証を行ったのち、焼却室に入り処理を開始してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "遺体は全て事務所の責任者、つまりわたくしの手で処理を行う必要がありますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "でも貴方が望むなら、今回は特例としてお任せします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "わたくしにできるのは……これくらいしかありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "……結構です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "私はあの子の最期に立ち会えず、望みも叶えてあげられませんでした。今さら合わせる顔なんてありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……そう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "全身防護装備に着替えたセイロンは、慣れた手つきでデリアの遺体を乗せた台車を押しながら、火葬炉に向かって進んでいた。\n今では感染者の遺体を目にし、処理することにもすっかり慣れてしまっている。\nそれでも火葬炉の前に立つと、彼女は決まって胸を痛めていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンドグラスの口調には明らかに恨みがこもっていたが、セイロンはそのことに対して憤りなどは感じていなかった。\n彼女は立場上、そういった思いを受け止めねばならないからだ。ロドスのためにこの事務所を設立すると決めた時から、とうに覚悟はできていた。\nそして、サンドグラスの問いに対し――\n「わたくしとシュヴァルツがどうなろうと、貴方に心配される筋合いはありませんわ！」\n無意識にそう返しそうになった。だが、当然そんなことを言うのはもってのほかだ。\nサンドグラスに対して「貴方の辛さは理解できる」などと、軽々しく同情してはいけないのと同じように。\nしかしサンドグラスがどのような気持ちでその問いを投げかけたにせよ、実際にセイロンは数えきれないほどの夜、そのような未来を想像して涙を流してきたのだ。\nそれでもセイロンは、その度に涙を拭って文献を読み報告書を書き続けてきた。\n涙には、研究成果や特効薬のような価値はない。彼女はそう信じているから。\nもしいつか、この台車にシュヴァルツが横たわり、他の誰かが押す日が来たとしたら。それは、セイロンがシュヴァルツの治療法を見つけられなかった時だろう。\n彼女は思う。それが現実となったとしても、自分はおそらく受け入れるだろうと。\nその時はきっと、自分にできることはやり切ったはずだから……"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "ごめんなさい、デリヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "誰もが満足するような方法はありませんのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "セイロンは、台車の遺体を火葬炉の中へと運び込んでいった。\nそしてしばらく黙り込んだ後に、ボタンを押した。"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……おやすみなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……何を見ていらっしゃるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "海です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "あの子、実は海なんて好きじゃなかったんです。子供の頃からずっと見てたから、もう飽きちゃったって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "ずっと旅に出たがってました。お金が貯まったらここを出ていくんだって……でも、結局叶いませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "そうでしたのね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "ようやく落ち着きました。主任、さっきは申し訳ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "構いませんわ、分かっていただければ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "近いうちに、デリヤの葬儀をするんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "もう用意は進んでますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "はい。彼女が亡くなってからのことは、前もって準備を済ませておりましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "遺灰がなくても、葬儀は予定通り行います。今日はただ、最後の望みをかけてみようかなと思いまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "謝らないでください。きっと主任も辛いってこと、理解してはいますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "でも……こういう時、冷静になるなんて無理ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任も、葬儀に参列されますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "ええ、もちろん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数日後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ニューシエスタの商店街から海岸へ続く道は花で埋め尽くされ、道の両端には大きな花かごが置かれている。\n突き当たりには仮設の小さな式場が設けられており、その祭壇の下には十脚以上の椅子が並んでいる。\n式場の壁には、デリヤの写真が掛かっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "葬儀の司会",
      "text": "デリヤさんは早くに両親を亡くし、ずっと一人で鉱石病と戦っていました。そんなデリヤさんを親友として支えられたのがレナータさんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "葬儀の司会",
      "text": "これより、そのレナータさんから弔辞を読んでいただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "葬儀の司会",
      "text": "えー……こほん。事情により、レナータさんはご欠席のようです。そのため録音という形で弔辞を伝えさせていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラスの声",
      "text": "私がデリヤと出会ったのは、何もかもが嫌になり、「どこかへ連れ去って」と海に向かってお願いしていた時のことです。あの時の彼女は、海辺でダンスを披露していました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラスの声",
      "text": "デリヤは私の気持ちを察したかのように、目の前まで来て踊ってくれたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラスの声",
      "text": "あの時のダンスは、昨日のことのように思い出せます。デリヤが砂浜で止まることなく跳ねて、回って。その度にドレスがふわりと靡いて、太陽の光にきらめいていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラスの声",
      "text": "ずっとその光景が目に焼き付いていて……。どうしても忘れられません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラスの声",
      "text": "私は、あの子との思い出をアルバムにまとめました。それだけで十分だと思っていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラスの声",
      "text": "あの子がいなくなる覚悟はもうできていると思っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラスの声",
      "text": "でも、夢から覚めて、あの子がいないことに気付く。そんなことを毎朝、もう何度目か分からなくなるくらい繰り返して……あの子と離れ離れになるなんて、私には無理だと悟りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラスの声",
      "text": "会いたいよ、デリヤ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女の告白に、セイロンは胸が痛んだ。いつか自分にもそんな日が来たら、耐えられるかどうか想像もつかなかった。\nシュヴァルツにはまだ時間が残されている。本当の意味でサンドグラスに共感できるわけではない。\nしかし、恐ろしい悪夢なら幾夜も見てきた。その光景がサンドグラスの告白によって形をなして襲い掛かり、セイロンの心の壁は脆くも崩れ去ってしまった。\nサンドグラスに会って、話をしたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "司会者さん、その、サンドグラス……レナータさんは今どちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "葬儀の司会",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "どうしましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "わたくしは彼女の上司です。信頼していただいて構いませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "葬儀の司会",
      "text": "……実は、彼女は私たちに録音を渡した後、どこかへ行ってしまったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "えっ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "……来たよ、デリヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任に嘘ついちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "こんな小細工、きっとすぐバレちゃうだろうけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "でも、ほんの少しでいいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "ほんの少しの時間があれば、あなたをここから連れ出して、遠くへ行けるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "二人で行った場所にもう一度行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "ずっと行きたいって言ってた場所もあったよね。そこにも連れてってあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "最後は、夕陽を眺められる場所で静かに暮らそうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンドグラスはそう呟きながら、遺灰が保管されている棚でデリヤの名前を探し続けた。\n彼女はここで一年間医師として勤め、多くの患者を担当してきた。見慣れた名前を目にするたびに、どうしても手が震えてしまう。\nいくつもの名前を経て、ついに彼女はデリヤの名前を見つけた。\n容器に手が届かなかったので、下まで椅子を引きずってきた。椅子と床の摩擦音が部屋中に響き、誰かに聞こえはしないかと心臓の鼓動が速くなる。\n彼女は椅子に乗り、デリヤの名前が刻まれた容器の鍵穴に、震える手で鍵を差し込んでいった。\nしかし涙で視界がにじんだためか、手の激しい震えのせいか、どうしても鍵穴の奥まで入りきらない。\n一度、二度、何度も何度も繰り返して――\n涙が、溢れた。\n鍵が手から滑り落ちた。\n拾おうと椅子から転げ落ちた。\n呆然と床にへたり込んだ。\nそして、声を出して泣いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "ごめんね、デリヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "ごめんね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "セイロンですわ。サンドグラスさんを見なかったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "text": "主任？　サンドグラスさんなら、主任の指示でデリヤさんの遺灰を取りに来ましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "彼女は今どちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "text": "つい先ほど、泣きながらここを出ていきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "――！？　今すぐ追わないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "text": "あれ？　でも確か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "どうかしましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "text": "いえ、それが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "text": "様子がおかしかったので、彼女が出た後に状況を確認しに行ったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "text": "そしたらサンドグラスさん、誰の遺灰も持ち出してなかったんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーター",
      "text": "はい、どうやら引き出しを開けてもなかったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……すぐに戻りますわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "うーん、どう踊るんだっけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "絶対教えてもらったはず。えっと、まずは一回ターンして、もう一回――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "きゃっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "はぁ……私、やっぱり不器用だなぁ。あなたみたいな情熱的なダンス、どうやっても踊れないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "サンドグラスさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任！？　どうしてここにいると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "お二人が初めて出会った海岸の話、録音で言ってましたわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "わたくしもよくここへ来てましたの。だから、すぐに分かりましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "……すみません、主任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "あなたが葬儀に参加していた時、こっそり許可証を使わせていただきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "そんなこと……いえ、確かに大ごとね。でも、どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任……どうすれば、大切な人の死と向き合えるのでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任は、大切な人を死なせないために全てを懸けると言っていましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "私も、あの子に関する全てを記録に残しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "でも、結果は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "あの子が亡くなってから、私は一晩すら穏やかに眠れていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "最後は、危険を冒してまであの子の遺灰を盗み出そうとしてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "そこまでしたのに、どうして諦めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "遺灰の棚を見た時に分かったんです。こんなことをしても何の意味もないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "だって私が連れ出したかったのは、あの子の遺灰なんかじゃありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "あの子は、もう……死んだんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "それでも、私はどうしてももう一度彼女に会いたかった。そんな思いが、最後にはあんなバカな行動になっちゃったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "あの時、一つのことを悟りました。それは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "彼女は、もう二度と戻ってこないということ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "そのことに、私は何の覚悟もできていませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "覚悟なんて……できるわけないじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "セイロンはゆっくりとサンドグラスに歩み寄り、彼女のそばで腰を下ろした。"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "わたくしが幼い頃、お父様はいつも忙しそうに仕事をしていましたわ。だから、ボディーガードだったシュヴァルツが自然と遊び相手にもなっていきましたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "あの頃は、家を抜け出して火山まで歩いて行くことが一番の楽しみでしたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "一度もうまくいきませんでしたけどね。毎回途中でシュヴァルツに捕まってしまいましたもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "だけどシュヴァルツがわたくしを捕まえる場所には、いつも面白い物がありましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "だから、二人でたっぷり遊んでから、家まで帰っていましたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "あの頃のわたくしは、そんな日々がいつまでも続くと思っていましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "鉱石病というものが、どんな病気かを知るまでは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "だからわたくしは目標を立てましたの。これから絶対にシュヴァルツを治してみせるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "貴方と比べたら、わたくしの方がずっと身勝手ですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "でも、シュヴァルツを救うチャンスがあるなら、私は絶対に逃したりしませんわ。たとえ彼女と会う時間を犠牲にすることになってもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "そうすれば、たとえ最期の時が来ても慰めにはなるでしょうから。彼女のために、私は自分の全てを捧げたって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "だけど貴方が言った通り、きっと貴方もわたくしも間違っていますのね。親しい人の死に直面したら、どんな覚悟も無意味になってしまいますもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "先ほどの葬儀で、貴方の言葉を聞いていただけでもう心が耐えられませんでしたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "シュヴァルツがいなくなる日が本当に来たら、わたくしはきっと貴方以上に取り乱すでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "一緒です、今までの私と……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "死がもたらす別れと本当に向き合うまでは、どんな人も同じなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "うぬぼれて、根拠もなく自分なら耐えられると思い込んでしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "死は人の命を奪うだけじゃありません。その人と親しい人の一部をも奪い去っていきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "残された者は、そうしてどこかが欠けたまま生き続けていくしかないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……ね、もしもの話だけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "本当にデリヤさんの遺灰を持ち出していたら、どこへ行くつもりでしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "私は……あの子の遺灰と旅に出るつもりでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "前に行った土地を、一緒に歩きたかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "行けなかった土地へ、一緒に行きたかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "でも……それも私の勝手な願望に過ぎませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……行きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "行きなさい、と言いましたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "貴方がわたくしの許可証を勝手に使ったことは誰にも言ってませんわ。つまり、貴方にはまだ遺灰を持ち出す権利があるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "後でわたくしは本艦に戻って、貴方が旅に出られるように申請を出して差し上げます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "もちろん、その期間の給料は差し引かせていただきますけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "それと、ニューシエスタには遺灰を保管するのに適した容器がありませんわ。エンジニア部にお願いして用意していただきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "そうすれば、機器の到着を待つよりは早いでしょうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "ただし、どこかを訪れることがあれば、最寄りのロドス事務所に連絡すること。そこで容器の点検を受けてもらいますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "何か危険なことが起きたり、遺灰をどこかに散布したことが発覚したりした場合――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "貴方をかばうことはできませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "でもそれ以外のことには目を瞑ってもらえるよう、向こうに取り計らっておきますわね。デリヤを悼むために貴方はどこへ行っても構いませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任……そんなことをしたって、もう意味は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "サンドグラスさん。確かにわたくしたちは間違っていましたわ。でも、本当に間違いだったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "死と向き合うにあたって、私たちが全ての手を尽くしたとしても別れは避けられないものなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "その人が残した物だけが、欠けた部分を少しでも埋めてくれると思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "……ごめんなさい、貴方を理解したような口をきいてしまいましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "立場も状況も違うんだもの、貴方に何かを命じる資格なんてありませんわ。だけどもしこれから先、わたくしにも同じような日が訪れたとしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "きっと貴方と同じように、二人の思い出の場所を辿って、そこで思い切り泣くでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "泣き終えて、喉が枯れ、涙も涸れた時、やっと別の事を考えられるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "それでもどうにもならないのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "その時は、また一緒にお話しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "ありがとうございます、主任。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "主任の言うように、強くなれるかは分かりませんけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サンドグラス",
      "text": "私、やってみます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "Medicさん、私の容態はどうでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "去年と比べると、少し進行の傾向が見られます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "あまりいい状況ではないです。この二年間、シュヴァルツさんは教官やオペレーターとしての活動が少し多すぎましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "仕事の負担が軽減できるよう、上に申請してみますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "では私の異動申請は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "ニューシエスタに戻ったら、どうせ無理されるんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "いえ、休みます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "嘘です！　ロドスに来てもう二年になるんですよ？　皆あなたのことはよく分かってるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "もっと自分を大切にしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "本当はセイロンさんにあなたを見張っててもらいたいのですが……ニューシエスタ事務所はまだ治療設備が整っていないので、せめてあと一年はロドスにいてもらわないと我々も安心できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "ですが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "それなら、わたくしが本艦に戻れば済む話ですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "セイロン様！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "あれ？　セイロンさん、もうお戻りになったんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "ちょうどシュヴァルツさんを驚かせるとこだったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "あら、タイミングが悪かったかしら？　ごめんなさいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扉の外のセイロン",
      "text": "やり直しますわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "……分かりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "こほん。ですがシュヴァルツさん、心配は無用です。あなたの病状を改善する、素晴らしい解決策がありますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "それは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "じゃーん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "ご覧の通り、あなたが戻ってきてすぐ、本艦にしばらく滞在したいとセイロンさんから申請が届いたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "さて、これで一件落着ですね。私は先に失礼するので、後はお二人でごゆっくり。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "その、セイロン様……ニューシエスタでご活躍されているとお聞きしましたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "お父様と相談してね。ロドスに色々と便宜を図ってもらえることになったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "向こうはしばらく、わたくしがいなくても大丈夫ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "セイロン様、こちらも心配は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "シュヴァルツ、検査報告をどう隠すか考えていたでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "いえ、そんなことは……どのみちいつかは耳に入るでしょうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "あら、でしたらいいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "Medicさんの言う通り、貴方には休みが必要ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "だから、どこかへ旅行に行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "旅行？　一体どこへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "そうだ！　シュヴァルツ、以前貴方の故郷について話していましたわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "わたくし、まだ行ったことがありませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "あそこには……もう何も残っておりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "それなら、わたくしたち二人で思い出を残しましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "それに、貴方の傭兵時代の経歴は知っているけど、幼少期についてはまだ聞いていませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "セイロン様？　急に一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "ふと思ったの。貴方はわたくしを子供の頃から見ていて、わたくしの全部を知ってるでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "でも、わたくしは貴方の過去全ては知りませんわ。そんなの不公平ですわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "シュヴァルツ、わたくしはとても欲張りな人間なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "ええ、存じています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "ならいいの。さて、検査報告を見せてちょうだい。そしたら旅行の計画を立てましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "承知しました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
