{
  "server": "jp",
  "storyId": "act9mini_level_act9mini_st02",
  "groupId": "act9mini",
  "stageId": null,
  "title": "灰かぶり",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act9mini/level_act9mini_st02.txt",
  "sourceHash": "07645e6eeb268b267af035fdb4e44515fd69faa05a2ddca365e5149fe8c299a9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔1.5-灰松鼠"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "おばあちゃん、どこへ行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "質問は許可していない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "火砲を持ってついてきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "はい、おばあちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "もうすぐ着く。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "あそこは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "競技場だ、大騎士領から来た連中が建てたものだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "フン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "試合を見に行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "試合？　いいや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "お前を訓練に参加させるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "私が教えたことは覚えているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "はい、おばあちゃん。ちゃんと覚えてるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "盾を構えて、砲を向けて、撃つ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "敵をよく見て、残弾に注意し、砲は手放さない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "それから、えーっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "火砲が轟くとき、勝利は我らが目前にあり！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "よろしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "お前は、お前の父親よりも随分と頼りになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "少なくとも私が永遠に目を閉じる前に、すべてを残せる相手がいて良かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "おばあちゃん、そんな縁起でもないこと言わないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "ふん、古木が朽ちるのは自然の道理だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "ただ腐っていくぐらいなら、新芽のための肥料となるのが誉れというものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "おばあちゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "砲を下ろすな、問題ない。少し咳こんだだけだ、心配はいらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "なんということか、お前の父親の世代はもちろん、私の兄弟たちですら、カリスカがいかにして繁栄を手に入れたのか、忘れ去っているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "ふん、林業だと？　あの林は私たちが火砲で、軍功で、あがなったものだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "「火砲が轟くとき、勝利は我らが目前にあり」……金に目がくらんだあいつらは、この格言すら覚えていない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "おばあちゃん、あまり興奮しないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "ふん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "グレイナティ、お前は良い若芽だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "そのまま、まっすぐ成長しなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "はい！　私、おばあちゃんをがっかりさせたりしないから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ブラッドボイル騎士団の誇る競技場のブッチャーが、ケガから回復して再び戻ってきたぞ――！　相変わらずの凶暴さだ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さあ、獲物となってしまうのか、はたまた病院に送り返すのか！　今宵ブッチャーに対する騎士は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "威厳のあるおばあさん",
      "text": "ゴホッ、ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "かつての南部林業の重鎮、カリスカ家の名を持ち――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "けれど今では一人の感染者、レッドパイン騎士団所属――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それではお迎え致しましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "おばあちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "（ふぅ……リラックスだ。おばあちゃんが教えてくれたんだもん。私ならできる。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "（準備はできてる！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "灰毫騎士――グレイナティ・カリスカ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あら、やーっとカイちゃんの登場ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "グレイナティはいっつものんびりと出てくるよな。パフォーマンスの一つもしねぇし、ちっとも面白味がねぇぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "そこが売りなんじゃない。ああいうクールな雰囲気が好きな人もいるの。ほら、あそこを見てみなさいよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮したファン",
      "text": "グレイナティ！　グレイナティ、こっちを向いてくれ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "ふん……まぁいいけどよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "歓声は嘘をつかねぇからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "あの火砲を持つ姿が、なかなかサマになってるのも分かるしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "ま、あたしが一番期待してるのは、あいつが砲撃で敵をぶっ飛ばす瞬間だけどな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "それが見せ場だから、気持ちよく吹っ飛ばしてくれるでしょ。大砲が火を吹く轟音を聞けば、観衆も大興奮よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "だけどもっと面白ぇもんが見てぇよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "なに、砲身で殴りつける姿でも見たいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "ハハッ、機会がありゃそれも一度お目にかかりたいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "破壊の権化たる巨大な斧に対するは、堅牢無比な要塞！　最後に勝つのは一体どっちだ？　これは楽しみになってきました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "今すぐお手元の端末で、選手を選択！　観客からのサポートを多数ご用意しています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "もちろん一番重要なことを忘れてはいけません！　試合結果のベットも受け付けております！　お財布に札束をねじ込むチャンスを、ぜひお見逃しなく！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "それでは、試合――開始――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "お前が持つそのオモチャが、少しでも長持ちするよう祈るんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "鉱石病のゴミめが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "つまんねーな、競技場に上がったらひと言もしゃべりゃしねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃんの試合を見るのは初めてじゃないでしょ。あれは真剣っていうのよ。真剣、わかんない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "だけどこれじゃあ退屈だぜ……それによ、感情を表に出さねぇで、どうやって気迫で相手を圧倒すんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "騎士競技は、声がでかいのを競うわけじゃないんだから。大切なのは対戦が面白いかどうかよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ほらね、こういうことよ。錆銅の奴が打つ手なしで後退していく展開に、観客席も盛り上がってるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "だけど今日の試合、カイは守りに入りすぎじゃねぇのか？　全然自分から攻撃しねぇぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ちゃんと相手を見てるのよ。錆銅みたいに攻撃一辺倒なやつ、防御中心に試合を組み立てるのが最善の策なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "それにカイちゃんの一番得意な技が使えるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "盾で攻撃をさばいて砲撃をくらわせる必中のカウンター戦術よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "（でもいつもに比べて、確かにカイちゃんから勝負を決めにいく意志をあまり感じないわ。一体何を考えてるのかしら？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "これは驚きだ――！　灰毫騎士の火砲と盾に対し、ブッチャーの肉断ち斧はまったく歯がたたない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "ガードの一つ一つ、砲撃の一発一発が、イングラの攻撃を無力化している！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "灰毫騎士の防御は完全無欠。じりじりと前進して、ブッチャーの行動範囲を狭めていく！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "これは長期戦必至！　勝利がどちらの手に渡るか、最後の瞬間まで誰にもわかりません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "みなさまのベットは、まだまだ受け付けております！　今すぐお手元の端末をタップ！　応援する選手に運命を預けてみませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "選手のロゴが入った、競技場限定販売のミネラルウォーターで、一足早い祝杯を上げるのもおすすめです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "今なら座席までのデリバリーつき。こちらも端末での注文をお待ちしております！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "はぁ？　そんなモンまであるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "みたいね、でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "何だこの値段……会場の外なら十本は買えるんじゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "アハハ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "お前、まさか買ったりしねぇよな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "試しに一本だけ買っちゃった、えへへ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "そのプラスチック板の後ろで縮こまってるだけなのか、あぁん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "ハッ、だったらそいつを粉々にしてやるよ。そうすりゃお前に残されるのは、泣き叫ぶ時間だけだ、石ネズミ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "カリスカみてぇなショボい会社じゃ、お前の死体なんか引き取ってくれねぇだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（引き金を引く）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あちゃー、カイちゃん怒っちゃった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "イングラは口が悪すぎだよね。人の嫌がるとこばっか突いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "カリスカ林業か……昔は結構有名だったけど、最近はあんま話を聞かなくなったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "けど、マジでグレイナティと関係あんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "そうね、もし経営をカイちゃんにさせてたら、彼ら一族の会社は今頃もっと大きくなってたかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "自分たちの経営下手を棚に上げて、他人に不平不満をまき散らすのがトップじゃ、うまくいくはずないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃんのカリスカ家追放って、一族全員で集まって、カイちゃんの目の前で決をとったそうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "全会一致だったって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "てことはあいつの両親も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "脅されて自分の娘を一族から追い出すのに、賛成したって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "大騎士領までの旅費だけは用意してくれたみたいだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "でもわかるでしょ？　自分を庇ってくれるはずの両親ですら、追放賛成に手を上げたのよ……カイちゃんは、それを見てたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "つらすぎるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃんがメンタルの強い子でよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "本当に彼女は強い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "でもこれ……まさか本当にキレてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "どれどれ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "まあ大丈夫そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "こんな時はキレるのが普通じゃねぇの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "あたしだったら、まずは錆銅の野郎をぶっ刺すだろうな、話はそこからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃんの戦い方はとても頭を使うのよ。弾数も限りがあるし、冷静さを失って撃ちまくれば負けちゃうかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "おそらく今はまだ、自分が怒ってるって錆銅に思わせてる段階ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "相手をミスリードするのも重要な戦術よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "見て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "素晴らしい一撃！　イングラの鎧の肩部分が粉々に砕かれました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "さらに灰毫騎士はじりじりと距離を詰めていきます。もしやこれは決着の時なのでしょうか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "またもや砲音が響き渡った！　どうやら灰毫騎士は自ら勝利の祝砲を撃つ準備ができているようだぁぁ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "おおっと！　いったい何が起きたのでしょう！？　皆さんはご覧になりましたか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "こ、これは！？　なんとなんと錆銅の斧で、砲弾が両断されました！　まさにドラマの中でしか有り得ないような光景が今、目の前に広がっております！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "そう、まさにあの動画配信サイト、スウォマーTVがスポンサーのサスペンスドラマ『大騎士領二十四夜』の有名なワンシーン！　ご興味のある方はすぐにでも端末からディスクを購入できます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "今ならなんと先着三十名様に、主役二人のサイン入りポスターをプレゼント！　早い者勝ちですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ゴクゴク――ふぅ、なーんだ。この水、その辺のコンビニで売ってるものと変わらないじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "だから言ったじゃねぇか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "えへへ、まあいいわ。デリバリー代ってことで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "それよりモーブの野郎、いちいち宣伝を差し込んできやがって、マジでうぜぇ……逆に買う気失せるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "まあそれが彼の仕事だからね。理解してあげなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "でも錆銅が斧で砲弾を真っ二つにするとはね。モーブがこの宣伝の好機を見逃すわけないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "もしあの時カイちゃんが容赦せず、錆銅を倒すことだけを優先して頭を狙っていたなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "今頃試合は終わってたはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "あいつの弾倉、そろそろ空っぽなんじゃねえか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "残り一発ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "撃ったらすぐに弾をリロードしないといけないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "その隙にイングラが、うちのカイちゃんに何もしなければいいんだけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（弾はあと一発。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（これを撃ち込んであいつを押し出すと同時に私も引く――それでリロード時間は充分稼げるはずだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（イングラのスタイルからして、奥の手などは残してないはず。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（そろそろだな。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "なぁ、お前の実力はこの程度か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（スピードが上がった？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（まずい！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "はえぇぞ。錆銅のあの靴、ブースターを仕込んでやがんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "面倒なことになったわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃん、頑張れ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "砲弾がなくなったお前に、何ができる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃん、まだ弾薬はある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ない。予備の弾倉はたった今、矢を防ぐのに使ってしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "じゃあどうするの？　砲身で殴る？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "もし必要なら、何人かこっちで処理するわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "そして前みたいに隙をついて私のポイントを奪うのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "もう、あれは忘れてってば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あの時は初対面だったんだもの。用心しない方が問題じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "二度としないわよ。約束したでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あたしはグレイナティが、自分の利益のために他の感染者を犠牲にするような人じゃないって信じてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "グレイナティも、ソーナが裏切ったりはしないと信じてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……フンッ、まあいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "で、どうやって目の前の騎士に対処するつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "手を貸すくらいの余裕ならあるわ。もし必要なら早く言ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "私には私のやり方がある――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "優勢を保っていた灰毫騎士がリロードしてる隙をついて、錆銅の復讐劇が始まりました！　いよいよブッチャーの肉断ち斧が血にまみれることになるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "灰毫騎士はどうやって反撃するつもりなのか――おっと！　空の弾倉を取り外して錆銅に投げつけ――次の弾倉を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "いや違う！　大砲も捨てて、錆銅に突っ込んでいきます！　一体何をする気だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "イングラが武器を掲げるが、灰毫騎士には盾しかない！　灰毫――灰毫が斧をガードし、そして――おぉっ！！　頭突きです！　灰毫が見事な頭突きを決めました！　鈍い音がしたぞ！　これは痛い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "そして、おーっと！　素手による連続打撃！　イングラ、たまらず後退！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "ここでグレイナティ、素早く転がって、大砲を手にすると新しい弾倉を装填……流れるような動きだ！　イングラは再び砲火に晒されるのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "ハッハァー砲音が響いた！　灰毫騎士が再び戦局を支配する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "ちょいとダセぇけどよ……あの戦法はなかなか実用的だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "だけど大砲を手放したあいつが、あんなに素早いなんて思ってもみなかったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃんもザラックだもの。身軽なのは当然でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "じゃあ、なんでお前みたいに軽い武器を使わねぇんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "好みよ。あたしはもっと試合に向いた、遠距離武器の方がいいよって言ったんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "槍とか、クロスボウとかスリングとか、色々あるじゃない。でも、カイちゃんはどれも気に入らなくて、故郷から持ってきたあの火砲が一番自分に合うんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "相性によっては全く使えない時だってあるし、メンテナンスにも時間と手間がかかるのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "カイのやつ、マジで頑固なんだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "まぁ、慣れれば平気よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "ところで、残りの弾薬はあと八発だけだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "もし撃ち終わったらどうなるんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "さぁ、どうでしょうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃんが予備の弾まで撃ち尽くすとこなんて見たことないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "……ハァ、ハァ、なめてるのか、灰毫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "何とか言ったらどうだ、この石ころが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（引き金を引く）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "いつまでダンマリを決め込むつもりだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "いい加減にしやがれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "ハァッ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃんってほんと意地悪ねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "まさかあいつ、最初からイングラに長期戦を仕掛けるつもりだったわけじゃねぇよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "ぶっ倒せもしねぇし、会話にも応じねぇし。あの場に立ってたらあたしだって頭にくるぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あら、ユスティナ、来てたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "灰毫はどうして錆銅をコケにしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "それは、話すと長くなるわねー。まずもって、カイちゃんは今の騎士に思うところがあるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あたしがカイちゃんと初めて出会った時ね、彼女は客席にいる騎士のお偉いさんたちに激しい怒りを露わにしていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ほかの感染者騎士は、ただ単に彼女が、ああいう騎士の連中に不満があるだけだと思ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "でも彼女は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "鉱石病に罹ってなければ、カイちゃんだって騎士貴族だったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……聞いたことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "彼女が感染した時、カリスカという名を持つ騎士貴族に、彼女に同情する者は一人もいなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "それどころか、一族が落ちぶれた責任を、みんなして彼女になすりつけたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "あぁ？　普通に考えりゃ、それと病気とは何の関係もねぇってわかるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "それでも、カリスカのザラックたちは、一致団結してカイちゃんの地位を剥奪して、一族から追放したのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "かつてのカイちゃんは、一族を心から信じてたの。彼らと苦楽を分かち合い、一緒に武芸を磨こうとしていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "でも結局、カイちゃんが絆を感じていた親戚も友人も、誰一人救いの手を差し伸べてくれなかったのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "追放どころか、彼女を大地から消し去りたいって思う人もいたって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "おいおい、いくらなんでも物騒すぎるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あら、あたしもこの目で見たのよ。あの日の集団混戦で、明らかにカイちゃんを不自然につけ狙ってる奴を片付けたんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "カイちゃんがあんなに騎士のお偉いさんたちを憎む理由が、これでわかったでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "で、「錆銅」イングラに関してだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あいつは特に、やる事なす事ぜーっんぶ、カイちゃんの逆鱗に触れるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "だから、カイちゃんは長期戦に持ち込んで、戦うつもりなんじゃないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "目の前のお高くとまったイケすかない騎士様を、徹底的にぶちのめして、土を舐めさせるためにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "もちろん……彼女自身の怒りを鎮めるためにも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ねぇユスティナ、カイちゃんの弾倉にあと何発砲弾が残ってるか見てくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……四発。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ふーん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "じゃあそろそろ終わるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "錆銅、怒涛の猛攻をかけましたが、灰毫騎士は倒れない！　一方で錆銅は息が荒くなってきているようだ！　どうする、このままではジリ貧だぞ錆銅！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "さぁ、追い込まれた錆銅が動き出しました！　最後の突撃を仕掛けようとしています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "長きに渡ったこの戦いにも、まもなく終焉の時が訪れるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "観客のみなさまにおかれましては、ベットした際に端末で受け取ったラッキーナンバーをお忘れなく！　勝負が決すると同時に、思いがけないボーナスが得られるかもしれません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "試合後にロアーガードの協賛で行われる抽選は、当選率な、な、なんと驚きの0.5パーセント！　今ならまだ間に合います！　お気に入りの騎士に賭けて一攫千金の最後のチャンスです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "さあ、イングラが斧を振り上げました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "グレイナティも防御の体勢に移る！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "決着か――っ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "わっ、カイちゃんったらいつの間にあたしの技を盗んだのかしら！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "錆銅が突撃！　突撃！　錆銅さらに突撃だ！　灰毫は盾を構えてはいますが、砲口は――後ろに向けている！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "まさか、錆銅の突撃を真正面から受けようというのでしょうか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "両者の距離が縮まる、みるみる縮まっていきます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "わお！　この状態から砲撃だとーー！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "灰毫やりました！　砲撃の反動を利用して、錆銅の斧の脇をすり抜けた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "速い速い！　凄まじい速さです！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "そして盾を捨てた！　振り向きざまにイングラの背中へ砲口を押し当て、トリガーを――引いた！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "錆銅騎士がダウン――！　これは立てない。錆銅、地に伏したまま動けません。灰毫騎士の勝利だ――――！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "いや待って、灰毫騎士グレイナティ、またしても砲口を錆銅に向けています！　ブッチャーとして悪名高いイングラ、ついに自分がいたぶられる日が来たのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "……フッ、引きこもりのザラックが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "灰毫……グレイナティ……お前のことは……覚えておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "傷が癒えたら……お前も……仲間の感染者も全員……ぶっ潰す！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "貴様！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（引き金に指をかける）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "クッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "（砲口を空に向ける）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "この一発は観客へ捧げる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "貴様にはもったいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "っ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士",
      "text": "おま……うぐっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "なんと灰毫騎士、倒れたイングラに攻撃することなく、最後の砲弾を空へ放ち、颯爽と歩き去っていったーー！　その後ろ姿、これぞまさに高潔！　騎士よ、かくあれかし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮したファン",
      "text": "灰毫！　グレイナティ！　グレイナティ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "さて、それでは本試合のオッズを――抽選――発表――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "今回はどうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "良くはないよ、父さん。火砲をずっと持っているとやっぱり手が震えてくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "もっと軽い武器に変えるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "いやいい。火砲は私の性に合ってるし、機動性不足は威力で充分に補える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "それにもしかしたら、いつか競技場じゃなくて、もっと広い場所で戦う日が来るかもしれないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "おばあちゃんみたいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "その時は、きっとこの武器がもっと役に立つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "わかった……好きにすればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "なあナッツ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "父さん、もう子供じゃないんだから、その名前で呼ばないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "グレイナティ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "今回の訓練は素晴らしい出来だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "もしおばあちゃんが今のお前を見たら、きっと喜ぶだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "おばあちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "おばあちゃんは逝く前に、おじさんたちと約束してくれたんだよ。お前が学びたいのなら、彼らは引き続き資金援助をしてくれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "だからお金の心配をする必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "お前が騎士になっても、家業を継いでも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "――訓練を続けていれば、いつの日か、カジミエーシュの名高い砲手になれるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "カリスカ家には、もう何代も本当の砲手が現れていないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "きっと一族の年長者の方々やご先祖は皆、火砲を手にするお前を誇りに思っていることだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子の父親",
      "text": "彼らを失望させるんじゃないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "はい、父さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "成長した女の子",
      "text": "私、頑張る。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ねぇ、カイちゃん？　カイちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ん、うん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "なに突然ボーっとしちゃってんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "何でもない、少し考え事をしていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "イングラも悲惨だねー。退院したばっかなのに、またあなたに病院へ送り返されちゃうなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "当然の報いだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "その割には、誰かさん最後の一発は空に向かって撃ってたけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "試合はもう終わっていたんだ。私がどれだけイングラを軽蔑していようと、あれ以上攻撃はできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "でなきゃあいつと同じになってしまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "残念ね、新聞で「ブッチャー、虐殺に遭う！？」みたいな見出しが見られると思ったのになぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "イングラ家がそのニュースを差し止める可能性の方が高いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ソーナ、さっきから聞きたいと思ってたんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ん、なぁにカイちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "お前が持っているそれは、何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ふふん、あなたの応援ボトル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "またそんなくだらないものを買って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "いいじゃない、喉が渇いてたし買いに行くのも面倒だったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "おっ、あたしらの騎士の凱旋だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……私も灰毫を見習って、強くなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "ユスティナ、「あの件」はどうなったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユスティナ",
      "text": "……終わった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "オッケー、お疲れさま。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "今回の賞金は振り込まれ次第「例の口座」に送金するが、最近頻繁な振込で銀行に目をつけられたらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "個人取引だってごまかしはまだ効く？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……お前はどう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "そうよね……現実ってそうだったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "あたしたちに残された時間は、あまりないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "でも今は、それを考える時じゃないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソーナ",
      "text": "まずは勝利の祝杯をあげましょ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
