        },
        {
          "label": "え？　そんなに急いで？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい。じゃあお先に失礼します。ドクター、ついでにサベージさんとたくさんお話してくださいね。",
