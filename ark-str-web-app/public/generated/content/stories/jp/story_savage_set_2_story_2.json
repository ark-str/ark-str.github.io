{
  "server": "jp",
  "storyId": "story_savage_set_2_story_2",
  "groupId": "story_savage_set_2",
  "stageId": null,
  "title": "パイはいかが？",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_savage_2_2.txt",
  "sourceHash": "59fcf827e06535c82ce0966e44de16bf0d3b9cfdadd2e6c6e65aae33957f7bc1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ふぅ……ドクター、ちょうど試食の時間に間に合ったみたいです。私たちも仲間に入れてもらいましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "食べて食べて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "お味はどう？　ロドスに来てから、本格的にこれを作ったのは初めてだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はふっ……はふっ……ふー、ふー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "アーミヤちゃん、気を付けてね。急いで食べると火傷しちゃうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "お……おいしいです。もちもちした食感のチーズ、サクサクのパイ生地に甘くてシャキシャキのニンジン……昔食べたものと全く同じ味です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "ふぅ……よかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ドクター、早く食べてみてください――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "あ、待って。ドクターの分はこっちだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ん？　何か違うのか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "これはドクターの好みに合わせて味付けを少し変えてるんだ。こっちの方がドクターの口に合うと思うよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "うん……この甘さがいいね。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "うん……このしょっぱさがいいね。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "うん……この激辛がたまらないね。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ふふん！　やっぱり好きな味だったでしょ？　伝統的な作り方を少しアレンジすれば、ドクターの好みにだって合わせられるんだよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "どうして好みが分かったんだ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "わたし、記憶力はとってもいいんだ。昔のドクターが一番好きだったパイの味はこういう……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "……あ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "昔もこのパイが好きだったのか？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "昔から味の分かる奴だったんだな。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ご、ごめん。ドクターは覚えてないんだよね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ごめんなさい、つ、つい無神経なことを……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "思い出を大切にするのは、謝るようなことじゃない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ありがとう、ドクター……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクターもこう言ってますし、大丈夫ですよ。それより、今日のパイは昔食べたのと同じように美味しかったです！　しかも、ニンジンがなんだかより一層香り高くなったような気がします。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ここ数年ずっと練習してたからね。ずっと独り身だし、一人で黙々とね……あは、あはは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "試作したパイは、家族や同僚、ご近所さんたちに味見してもらってたんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "サベージさんのお世話好きなところは、変わっていませんね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "うーん、この甘み……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "さすがレム・ビリトン産のニンジンは違いますね……仕入れるのは大変でしたが、買って大正解でした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "そうそう、大変だったよ……あー、思い出したらムカついてきた。あのいけ好かない商人ときたら……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "え？　何か問題があったんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "うん。ロドスに来てから、みんなにキャロットパイを作ってあげようとずっと考えてたんだけど、まさかレム・ビリトンのニンジン缶が手に入らないとは思わなくって……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "一ヶ月前、家族にニンジンフルコースを作ったばかりだってのに、ここに来たらニンジン一缶すら買えないなんて、おかしいでしょ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "だから、「商売の専門家」っていう人に聞きに行ったんだよ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（クロワッサンのことだろうな……）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "（クロワッサンさんのことだろうな……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "それで知ったんだけど、あるヴィクトリアの商人が値をつり上げてるらしいんだ。レム・ビリトンのニンジンには若さや健康を保つ特別な効果があって、美肌ケアにも効く「霊薬」だなんてうたって……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ええっ？　ニンジンが身体にいいのは有名ですが、特別な効果や美肌ケアに効くなんて話は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "さすがに誇張しすぎだよね。だけど、商人たちが取り上げたことで顧客はそれをすっかり信じてるって「専門家」が言ってたよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "特にレム・ビリトンのニンジンだけが突出した効能を持ってるって商人たちが吹聴し始めてから、すぐに缶詰の需要が高まって、値段もつり上がっちゃったんだって……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "今回なんとか送ってもらったニンジンはね、ご近所さんだった農家の人が自家用に保存してたものを、特別に缶詰にして送ってもらったものなんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "まったく……一体どうしてこういった怪しげな商売が成功しちゃうんだろうね――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "本当に不思議です……でも、商人たちが消費者心理を利用するのは……何というか、理に適っているような気もします。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "最初にこの話を聞いたときはすごく腹が立ったよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "商人たちは、まるまる一年分の生産量を事前に買い込んでから、デマでニンジン缶の価格をつり上げたもんだから、一時はレム・ビリトンに住む現地の人さえも缶詰が手に入らなくなったんだ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "「専門家」はさらにこう言ってたよ。他の商人たちもそれを商機と見て、レム・ビリトンの農家に他の作物をニンジンに変えるよう言葉巧みに迫ったりなんてしたら……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "需給バランスが崩れて価格は急落し、その頃にはブームも去って、ニンジンは売れなくなるだろうって。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "元々、自給自足で成り立っていた農家の作付け計画をかき乱して、大損害を与えてしまったら、怒った農夫たちは余所者の商人と対立する……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "そしたらまた「フェンス事件」みたいな危機が発生しちゃう可能性があるじゃない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "たしかに、このデマをそのままにしておくのはとても危険ですね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "「フェンス事件」といえば……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あ、ドクターも他の人から聞いたことがありますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "過去にレム・ビリトンの三都市間で発生した、現地の人々にとってはとても重要な事件です。あれはレム・ビリトンのエウレカ自治州が成立する契機にもなりました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "食事しながらじゃ、うまく説明できないかも……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "かいつまんで言えば、ヴィクトリアの商人たちが、二つの地区間の小型移動都市を利用して、レム・ビリトンの鉱石資源を大量に採掘しようとしたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "そいつらは街の住民を利用して、レム・ビリトン地区の鉱物資源を奪い取り、ヴィクトリアに持ち込んで荒稼ぎをした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "それに反発した現地の民衆が先頭に立って、ヴィクトリア商人たちが作り上げた「フェンス」から抜け出した……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "その後、より自主路線なエウレカ自治州が成立して、街の統治権は再びレム・ビリトンに戻されたの。すごく立派な市民運動だよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "その際、サベージさんは現地の方々が権利を取り戻すのを助けるために多くの努力をしたんです。だからレム・ビリトンではちょっとした有名人なんですよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "すごい。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "まさかそんなことがあったとは。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "コホン……大したことじゃないよ。ドクターくらいの知識と能力があれば、あの程度の問題を解決するのはきっと朝飯前だろうね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（それほどの知識や能力はあるだろうか……）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "まあ、そうかもね。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが、「フェンス事件」でレム・ビリトンの人たちは誇れる故郷を自らの手で守れるということが証明されたのに、どうしてまたそんな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "そうなんだよ！　平和になってまだ何年も経ってないっていうのに……くそっ！　あいつら商人どもは貿易条例に基づいて正規に事を運ぶ気なんかないんだ。わたしは最初からわかってたよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……サベージさんのその反応を見る限り、すでに何か考えが有るんですね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ふふん……さすがはアーミヤちゃん、わたしのことをよく分かってるよね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "トランスポーターにお願いして、故郷の人たちに手紙を送ってあるんだ。うっかり商人たちの誘いに乗らないようにって。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "みんなが一斉にニンジンを植え始めたら、商人の思うつぼだもん。絶対に農業組合と相談しなきゃダメだって。彼らはこの事態を傍観したりしないはずだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "不当に暴利を貪ろうとする連中のせいで本来の生活がかき乱されるなんてことはあっちゃいけない……とにかく、もう二度と商人なんかに騙されないんだから！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ふふっ、サベージさんらしいですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "素早く的確に対応する手腕は、昔とちっとも変わってません！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "もちろん！　人はそんなに簡単に変わらないからね。今回だって、あなたとドクターのことが心配だったから、約束通り仕事を置いてすぐにあなたたちのとこへ駆けつけたでしょ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "とにかく……レム・ビリトンのニンジン缶を買ってくれるお客さんには、わたしたちの自慢の味を楽しく味わってもらいたいの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "グルメは人に喜びを与えるものであって、捏造された「霊薬」なんかであるべきじゃないんだから！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "絶対に余所の勢力につけ込まれないようにしないと。前回は源石の鉱山資源、今回はニンジン……次は何なんだろうね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "しかもあいつらは資源を奪うだけじゃなくて、自分たちの利益のためなら、現地の人の命をなんとも思わない……わたしは――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "たとえレム・ビリトンを離れても、あいつらがレム・ビリトンから大事なものを奪い去ろうとするのを黙って見てるわけにはいかないんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "サベージさん……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ああ、そんな顔しないの。大丈夫、心配しないでよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "いえ、今のサベージさんはキラキラ輝いてるなって思ったんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "……偉そうに語っちゃったけど、実際わたしにできることは本当に少ないよ……わたしは自分の理想を言葉にして、多くの人の信念を強めるようなタイプじゃないし。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "……だけどさ、アーミヤちゃん。わたしもたくさんの事を経験してきた大人だからわかるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "わたしたちができることは小さなことばかりだけど、それでも行動を起こすことは、状況の悪化を傍観しているよりずっとマシだってね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "何か危機を察知したらすぐに行動しないといけないんだ。状況が悪くなってから全力で動いても、すでに発生しちゃった損失は挽回できないからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "……とまあ、それだけ。これは、わたしが身をもって経験したことにすぎないけど、自分がやるべきことのために奔走し続けるのは、価値があることだと思う。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "分かります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "アーミヤちゃん……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "分かります、サベージさん。ロドスも同じですから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "え、ロドスも？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい……ロドスが、これまでやってきたことも、自分たちの力の及ぶ範囲の小さなことばかりです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私は、小さな争いを平定することも、すべては私たちの最終目標のための努力なんだと信じています。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "その通り！　はぁ……ううっ、アーミヤちゃんの口からそんな言葉を聞けるなんて……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "えっ？　あの、わ、私何か変なこと言いましたか？　サベージさん泣かないで、泣かないでください！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ううん、違うよ！　いい言葉だった！　ただ、良すぎてちょっと感動しちゃっただけ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ううっ、前に別れたときは、あんなにちっちゃかったのに……今はもう、こんなに素晴らしい人に――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "わっ！　落ち着いて、落ち着いてくださいサベージさん。そんなにきつく抱きしめないでください……ううっ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "でも本当は、初めとっても心配だったんですよ。サベージさんとは長い間会ってなかったから、私の変化をどう思うのかなって……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ふふ、それについては心配いらないよ、アーミヤちゃん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "わたしからすれば、今レム・ビリトンのパイを美味しそうに食べてるロドスのリーダーは、昔バベルでわたしにまとわりついてた少女と変わらないよ。善良で、可愛くて、謙虚で、他人に優しくて――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "お互い一番信頼し合える……喜んで自分の力と時間を分け与えたくなるような友だちだよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――サベージさん、ごちそうさまでした。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "おいしかった。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "よかった。ニンジン缶の賞味期限は長いから、残りの缶は保管しておいて、また時間があるときにパーティーでみんなに振る舞うよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "一ヶ月に一回、レム・ビリトン料理の試食会をやるのはどうかな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "えへへ、もう待ちきれません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "そうだ、ドクター。さっきのことだけど……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ん？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "うん……つまり、過去のあなたについてなんだけど……",
