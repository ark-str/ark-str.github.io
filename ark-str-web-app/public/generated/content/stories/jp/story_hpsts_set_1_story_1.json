      "type": "dialogue",
      "speakerName": "ヴァルカン",
      "speakerToken": "avg_163_hpsts_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "これに基づいて温度と時間を設定し直して……"
