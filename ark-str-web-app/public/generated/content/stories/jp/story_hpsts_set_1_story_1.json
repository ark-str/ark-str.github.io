    {
      "type": "dialogue",
      "speakerName": "ヴァルカン",
      "speakerToken": "avg_163_hpsts_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "眠っていてくれよ、少し結晶を借りるだけだから……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァルカン",
      "speakerToken": "avg_163_hpsts_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "マズい、奥にもう一つ巣穴があったのか！"
