    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァルカン",
      "speakerToken": "avg_163_hpsts_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "こっち側の棚と物品をどかそう。もっとスペースを空けないとな。"
