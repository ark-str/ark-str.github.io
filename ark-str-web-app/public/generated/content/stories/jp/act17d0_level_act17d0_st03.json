{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_st03",
  "groupId": "act17d0",
  "stageId": "act17d0_st03",
  "title": "大地を行く",
  "storyCode": "OD-ST-3",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_st03.txt",
  "sourceHash": "e9c8501d23357ba085c00f40ea43afc49f53ece4116399111acdf85393e66ed0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "半月後……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "あなたたちの尽力に感謝いたします。コーエン殿、ケッツ殿、ティナ殿、アレクサンドル殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "私が謹んで……ロングスプリングの……ええと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "申し訳ない……こうした言葉遣いで人と話すのは、慣れなくてな。やはり今まで通りでいかせてもらう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "お前たちのおかげで私は弟の手から生き延びることができたし、私の領民も再び自分たちの土地で暮らすことができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "恩に着る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "当然のことをしたまでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "今回の危機はあたしたちが引き起こしたようなもの。だからあたしたちで終わらせる義務があった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "いや、もしあの救いようのない愚かな弟がいなければ、何も起こることはなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "本当はお前たちに報酬を渡したいのだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "見ての通り、ロングスプリングは壊滅状態だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "残った財産は、すべて町の復興に充てたいと思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "現金による報酬は……申し訳ないが、支払ってやれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "だがこの屋敷にある物で、気に入った物があるならそれを渡そう。遠慮なく持って行ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "屋敷を取り壊して全て持っていってくれると尚良い。新たなロングスプリングを作り上げるには、無用のものだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "その点についてだけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "アレクサンドル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "このヘルメットはよく馴染む……もらってもいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "いいね、それだけピカピカなら目くらましになる。俺も盾に取り付けようかな。そうすれば今後、電池も必要なくなるしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "この結果だけであたしたちは満足してる。もう十分よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "なに？　それだけでいいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "私の武器や父上のコレクション、全部――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "いいのよ……あんたの方が物入りでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "感謝する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "みんな、そろそろ行きましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ケッツさん、皆さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "やっと出てきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "領主のお嬢ちゃんに別れを告げてきたんじゃろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ならば儂らも行くとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "私の小隊がロドスまでお送りします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "すまんのう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "コーエンさん、私たちとご一緒にどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "そうね。あたしたちも休息と補給ができる場所は欲しいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "それにあたしたちには身分が必要よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "この世界……いや、この「大地」を歩いていける身分が。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "わかりました。ロドスが多少なりともご助力できるかと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "車の準備はできています。出発しましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "人事オペレーター",
      "text": "皆さんの情報はすでにロドスの端末に登録されました。今後は各所にあるロドスの事務所やセーフハウスで、滞在および補給をすることができます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事オペレーター",
      "text": "皆さんはロドスの正規職員ではありませんが、任務ネットワークは開放されておりますので、任務を引き受けることで報酬を得ることができます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事オペレーター",
      "text": "説明は大体これくらいです。何か他に知りたいことはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "待ってくれ……聞いてもいいか？　ロドスにはSF小説を読める場所はあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事オペレーター",
      "text": "えっ？？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "つまり、これが俺たちの新しい身分ってことか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "少なくとも、まだこの盾を使ってられる。悪くない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "何か計画はあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "この大地を見て回るのよ。あたしたちはこの世界をあまりにも知らなすぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "詳細な計画書が欲しいところだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "でも今回ばかりは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "自分たちで何とかするしかないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "なら俺たちの最初の目的地は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "シエスタと呼ばれる場所よ。聞いた感じ良さそうな都市だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "なら、そこに行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "結局、家に帰るまでは道半ばってことだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
