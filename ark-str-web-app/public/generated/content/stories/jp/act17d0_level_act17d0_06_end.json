{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_06_end",
  "groupId": "act17d0",
  "stageId": "act17d0_06",
  "title": "領主邸攻防戦",
  "storyCode": "OD-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act17d0/level_act17d0_06_end.txt",
  "sourceHash": "719a50e9eb488cf174c4b25bbf0180f439886e185d9dba4227e13347c786da98",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "クリア！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "よし、警戒は任せた！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "アレクサンドル、倒れてる傭兵の中に、まだ生きてる人が紛れていないか確認して！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "了解、"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "ティナ、包帯を用意して。人数の確認後、負傷者の手当てをする。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "わかった！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "死んだふりをするな！！"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "speakerId": null,
      "text": "ま、待て！　じゅ……銃口をどけてくれ！　何でも話す！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "ケッツ、そいつを縛り上げておけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "わかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "先生は？　ミアロ先生！"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "こちらです！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "……ゴホッ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "ティナ！　包帯を！　早く！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "起きろ！　先生！　目を閉じるなよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "どうして……何が起こったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "無理にアーツを使って……源石の感染が広がったんです……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "ロドスで治療はできないの？　あんたたちの本業でしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "失血、重篤な熱傷、鉱石病の激しい発作……たとえロドス本艦にいたとしても、これは……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "……ゴホッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "持ちこたえろ、先生。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "……遠い異国へ旅したいんじゃなかったのか？　夢にまで見たクルビアを想像するんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "……持ちこたえろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "ゴホッゴホッ……ゴホッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "……ゴホッ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "先生……"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "……彼はもう……"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "申し訳ありません、私が……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "違う……あんたのせいじゃない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "speakerId": null,
      "text": "……違う……俺とは関係ない！　俺じゃない！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "*ロシア語スラング*、ぶっ殺す。"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "speakerId": null,
      "text": "……俺はただ……やめろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "終わりだ！　*ロシア語スラング*、死ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "speakerId": null,
      "text": "やめろ！　やめてくれ！　俺じゃない！！　やめろ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "アレクサンドル！　やめろ！　冷静になれ！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "あの衛兵隊長はどこへ行ったんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "逃げた相手を追いかけて行きました。レンジャーさんも同行しています。ご安心を。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "あれは……！　先生の体の結晶が……光ってる？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "嘘でしょ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "こんなに早く？　どうして！？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "！！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "皆さん、手分けして密閉できる部屋を探してください！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "何をする気？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "説明は後！　急いで！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "布を持ってきてください！　カーテンとかシーツとか……大きな布なら何でも構いません！"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "先生をあちらの小部屋に！　早く！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "何が起きたんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "先生がどうしたの？　どうして……"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "コ、コーエンさん、ひとまず落ち着いてください。今、フランカが処理を――"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "処理？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "何を処理してるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "見たことないんですか？　ですが説明は後です、今は――"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "扉も窓も閉めて！　隙間も全部塞いで！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "煙突！　煙突も塞いでください！　通気口もです！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "これは……これは何事なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "わからない。先生の遺体に……何か問題でもあるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "行くな。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "どうして？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "行くな……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "上は全て塞ぎました！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "扉も窓も塞いだわ！　よし……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "待って！　部屋の中が光った？　扉や窓が光ってる？"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "コーエンさん！　近付かないでください！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "見ないであげてください……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "一体、何が起きてるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "先生は……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "あっ……"
    },
    {
      "type": "sceneBreak"
    }
  ],
