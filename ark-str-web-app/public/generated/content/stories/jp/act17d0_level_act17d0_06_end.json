{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_06_end",
  "groupId": "act17d0",
  "stageId": "act17d0_06",
  "title": "領主邸攻防戦",
  "storyCode": "OD-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_06_end.txt",
  "sourceHash": "719a50e9eb488cf174c4b25bbf0180f439886e185d9dba4227e13347c786da98",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "クリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "よし、警戒は任せた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "アレクサンドル、倒れてる傭兵の中に、まだ生きてる人が紛れていないか確認して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "了解、",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ティナ、包帯を用意して。人数の確認後、負傷者の手当てをする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "わかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "死んだふりをするな！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "ま、待て！　じゅ……銃口をどけてくれ！　何でも話す！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ケッツ、そいつを縛り上げておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "先生は？　ミアロ先生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "こちらです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……ゴホッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ティナ！　包帯を！　早く！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "起きろ！　先生！　目を閉じるなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "どうして……何が起こったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "無理にアーツを使って……源石の感染が広がったんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ロドスで治療はできないの？　あんたたちの本業でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "失血、重篤な熱傷、鉱石病の激しい発作……たとえロドス本艦にいたとしても、これは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……ゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "持ちこたえろ、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……遠い異国へ旅したいんじゃなかったのか？　夢にまで見たクルビアを想像するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……持ちこたえろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "ゴホッゴホッ……ゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "text": "……ゴホッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "先生……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "……彼はもう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "申し訳ありません、私が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "違う……あんたのせいじゃない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "……違う……俺とは関係ない！　俺じゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "*ロシア語スラング*、ぶっ殺す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "……俺はただ……やめろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "終わりだ！　*ロシア語スラング*、死ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "text": "やめろ！　やめてくれ！　俺じゃない！！　やめろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "アレクサンドル！　やめろ！　冷静になれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あの衛兵隊長はどこへ行ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "逃げた相手を追いかけて行きました。レンジャーさんも同行しています。ご安心を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あれは……！　先生の体の結晶が……光ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "嘘でしょ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "こんなに早く？　どうして！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "皆さん、手分けして密閉できる部屋を探してください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "何をする気？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "説明は後！　急いで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "布を持ってきてください！　カーテンとかシーツとか……大きな布なら何でも構いません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "先生をあちらの小部屋に！　早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "何が起きたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "先生がどうしたの？　どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "コ、コーエンさん、ひとまず落ち着いてください。今、フランカが処理を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "処理？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "何を処理してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "見たことないんですか？　ですが説明は後です、今は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "扉も窓も閉めて！　隙間も全部塞いで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "煙突！　煙突も塞いでください！　通気口もです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "これは……これは何事なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "わからない。先生の遺体に……何か問題でもあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "行くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "行くな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "上は全て塞ぎました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "扉も窓も塞いだわ！　よし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "待って！　部屋の中が光った？　扉や窓が光ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "コーエンさん！　近付かないでください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "見ないであげてください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "一体、何が起きてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "先生は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
