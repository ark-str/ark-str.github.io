{
  "server": "jp",
  "storyId": "main_6_level_main_06-05_beg",
  "groupId": "main_6",
  "stageId": "main_06-05",
  "title": "誰を殺る？",
  "storyCode": "6-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_06-05_beg.txt",
  "sourceHash": "a13c22262543d4fe3c9e2e454dedf17b2b44a2c58bc8ecf88b76f0650f52039a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……あまりにも……ひどいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーター",
      "text": "アーミヤさん……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ううん、私は大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ブレイズさん、ドクター、そしてグレースロートさんとは連絡が取れていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オペレーター",
      "text": "はい、問題ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "わかりました。そのまま進行方向のナビゲートをお願いします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "（飢えた叫び）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……あなたたちからは、もう何の感情も伝わってこない……。あの見え隠れしていた憎しみは、全てメフィストのものだったんでしょうか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "メフィストの怨恨が振りまいた毒は……必ず私が洗い流します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたたちと約束します。必ずです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ルート上のレユニオンは全員排除し、目標ポイントに到着した。しかし、スラムの状況が若干不自然に見える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "このエリアの入口に駐留していた近衛局チームはレユニオンの痕跡を発見できていない。こちらで周囲の調査が必要と思われる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "変異した感染者の残存数が減っている？　お前たちの戦果か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "違うだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……気をつけろ。状況が明確になるまでは、どんな危険が潜んでいるかわからん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いいか、警戒を解くなよ。あの感染者たちは、これまでのレユニオンよりもずっと厄介だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "こちらの処理が完了したら、支援小隊を送る。通信には留意するように、以上。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "誰だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "報告！　自分です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前に言ったんじゃない……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "えっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……いや、何でもない。報告を頼む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "チェン隊長に報告、指示通りにこちらのエリアの捜索を完了いたしました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "収穫は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ありません！　レユニオン構成員は一人も発見できませんでした！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "レユニオンだけじゃない、それ以外の異常はなかったかと聞いているんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "も……申し訳ございません。この場所にはあまり詳しくありませんので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "これまでの慣例ですと、直接エリアごとの破壊を要されるほどの事態でなければ、我々はこの場所に関わることはありませんし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……分かっている。大きな騒ぎにならなければ、お前たちはスラムを存在しないものと見なしているのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "我々がレユニオンを押しとどめていた間に、ここから大きな音が響いた。そしてこのエリアの住民の半分が失踪してしまっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "我々の足元に散らばるこのオモチャの数々を……自分で見てみろ、これで何も異常がないと言えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それに本作戦の計画書に「スラム地区の住民を避難させる」といった項目など見た覚えはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……確かに怪しげな形跡はありました。エリア内の住居とみられる独立した建造物は、全て瓦礫の山になっていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "残った街も、もぬけの殻です。レユニオンと現地の住民が交戦した結果である可能性が高いと判断します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "また、火災も発生しておりましたが、我々が鎮火させました。出火の原因は、加熱しっぱなしになっていた調理器具と思われます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "全ての建造物に、無理やり侵入された痕跡もありました。しかし住民が抵抗したと思しき痕跡はほぼ残っていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "レユニオンにいたっては、本当に一人も見つかりませんでした。しかし……何かを消したような痕跡は残されていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前、このエリアの住民に関心はないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……申し訳ありません、チェン隊長！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なにを謝っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "自分には関知するところではありません、隊長！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……もういい。そうだな、お前たちがこの場所に関心を寄せる理由などないものな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "今すぐ、部隊を展開して全エリアを封鎖しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いかなる者も、いかなる車両も通すな。レユニオンは言うまでもないが、どんな者であってもだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "あと、お前とお前は、私について来い。北側へ向かう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（待て、声を出すな！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "（私とこちらへ来い、早くしろ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "鋭い洞察力だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そこで何をしている！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "射撃用意！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "追ってくるべきではなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "部下を黙らせろ、チェン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前たちは、スワイヤーのところへ向かえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "しかしチェン隊長……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "行けっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前たち、誰に言われてここに来た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君に説明する義務はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "逃げるつもりか？　いま動けば即座に逮捕する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "正体不明の武装集団を信用する者などいない。我々近衛局が厳正に対応してやる。お前たちをこの場で裁くこともいとわない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "龍門が近衛局の部隊を新たに訓練し編成するためには、莫大な時間と費用、そして人材を費やすことになるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そして近衛局が壊滅すれば、龍門市民の心理的支柱をも失うことになる。これは君が冒して良いリスクではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ほう、私がお前の脅しに素直に屈するとでも？　それとも龍門の未来を真摯に考えてくれたことに感謝すべきか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "チェン、近衛局は龍門の顔であり、龍門の支柱でもある。龍門が最も誇るべき基盤の一つだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "だがそれ以外の職務に関して、近衛局は関わるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "関わるべきではないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私に脅しは効かない。答えろ、このエリアの住民はどこへ行った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私の指はもう通報ボタンの上だ。お前たちが近衛局全体を敵に回すまでに、一秒もかからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それとも、一秒以内に私の剣をかわし、腕を切り落として通信機を奪えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "スラムの住民は一体どこへ行った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ではこうしよう、我々はこの場所を離れる。チェン、共にここを離れるのだ。今の段階では、互いに干渉を避けるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どこへ行くつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "レユニオンの指揮官が操っている感染者の変異体だが、あれは我々の戦略の障害となる可能性が非常に高い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こちらは近衛局のためにあの脅威を排除する。君たちは一刻も早くレユニオンの主要部隊を殲滅するように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もし近衛局が本来の戦略目標を達したいのであれば、その眼は自身の職責へ向けておけ。そして、君たちがやるべきことを全うするのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "待て！　そうやってのうのうと逃げるつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "近衛局などまるで眼中にないとでも！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "チェン、一つ忠告だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "今ここで起きていることに首を突っ込みすぎるな。と、だけ言っておこう。ウェイ殿の顔に免じて、君とここでやり合うことはしないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "補足しておくが、君の腕を切り落とすことなど容易い。迷いなく行動している時の君は、今の百倍は強いだろうがな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ちょっと——！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "スワイヤー、来るな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どこへ行く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "さらばだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "クソッ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……何があったのよ？　さっき誰と何を言い争ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "龍門に属する特殊部隊が暗躍している。このエリアの住民たちは、みな生死不明の状況だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "えっ？　何言ってるのよ？　そんなものあるわけ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "誤魔化すな、心当たりがあるだろう。少なくとも耳にしたことはあるはずだ、必ずな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……あたしが何を知ってるってのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "というか、あんたも自分で知ってるって口ぶりじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私は知らない。だがお前の祖父は必ず知っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "えっ？　だから何言ってるのよ、訳がわからないわ！　ふざけてないでハッキリ言いなさいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "それに、お祖父様は病床で寝たきりなのよ、喋ることだってままならない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "たとえ病気を患ったからとて、あの人が簡単に龍門を操れなくなると思うのか？　お前の祖父がどんな人間か、私なんかよりお前の方がよくわかっているだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "そんなの、ありえないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……でもお祖父様じゃなくてあの人なら……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "誰のことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "「灰色のリン」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "フンッ、今度は私が「ありえない」と言う番だな。リンはスラムをわが子のように思っている。そんなこと、許すと思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "そう？　じゃあ、電話で聞いてみればわかるかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "あんたがかける？　それともあたしが？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
