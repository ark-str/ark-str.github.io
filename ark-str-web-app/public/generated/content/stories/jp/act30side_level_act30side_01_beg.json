{
  "server": "jp",
  "storyId": "act30side_level_act30side_01_beg",
  "groupId": "act30side",
  "stageId": "act30side_01",
  "title": "乗車時のご注意",
  "storyCode": "RS-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act30side/level_act30side_01_beg.txt",
  "sourceHash": "584ad40f3bebebbdb61a90d0bfffd45b5187a282762b7b3ec573ed6eecfb685a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "身軽なチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "フン！　ハァッ！"
    },
    {
      "type": "dialogue",
      "speakerName": "息を切らすチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "はぁ……はぁ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切ったチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "ハッ……！　セイッ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闘志みなぎるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "食らえ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタたち",
      "speakerId": "avg_npc_275",
      "text": "ハアッ！　かかれ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_275",
      "text": "あなたたち、食事はちゃんと取ってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_275",
      "text": "もう一度。"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切ったチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "む、無理ですよ姐さん、本当にもう限界ですって……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "立ちなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "私はあなたたちにどう教えてきた？"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "立って、武器を握りなさい！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "闘志みなぎるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "はい！"
    },
    {
      "type": "dialogue",
      "speakerName": "息を切らすチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "はぁ……はぁ……やあッ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "遅すぎる。それに軽すぎね。アーツは急ぎすぎているし、戦術がワンパターンだわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "少しは息が合ってきたようだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "全体の実力としてはお粗末ね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "身軽なチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "比較対象が姐さんじゃなあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切ったチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "はぁ……ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切ったチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "まあ、一言褒めてもらえただけでも、ここんところやってた訓練には価値があったってもんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "闘志みなぎるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "こんなもんじゃまだ足りねぇよ！　俺もいつかは姐さんみたいに、片手で岩を細切れにできるようになんねえと！"
    },
    {
      "type": "dialogue",
      "speakerName": "息を切らすチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "お前なんかが……？"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "休憩はこれで十分そうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "それじゃ、もう一度いくわよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタたち",
      "speakerId": "avg_npc_275",
      "text": "えっ！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "姐さん！　大変です！"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "まずは落ち着きなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "はぁ……はぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "何があったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "あっ、た、大変なことが起きたんです！"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "麓のほうで、大騒ぎになってて……ち、血がたくさん……！　俺たちじゃどうすることもできません！"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てるチェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "一刻を争う事態なんです！　早く来てください！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": null,
      "text": "わぁ！　発車したよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": null,
      "text": "あはははっ！　ママ、はやくはやく！"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": null,
      "text": "――うわっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "speakerId": "avg_npc_281_1",
      "text": "列車の中で走っちゃダメって言ったでしょ！　ケガはない！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": null,
      "text": "（首を横に振る）"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": null,
      "text": "ママ、見て見て！　変な帽子の外国人いるよー！"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "speakerId": "avg_npc_281_1",
      "text": "こら、何てこと言うの！　人を指さしちゃいけません！　失礼な子は巫女様に嫌われちゃうわよ。早く謝りなさい！"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": "avg_npc_281_1",
      "text": "ごめんなさい……"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "speakerId": "avg_npc_281_1",
      "text": "はぁ……あの、大変申し訳ありませんでした。なにぶん、まだ何もわからない年頃でして……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "構わない。"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "失礼、私は前の席なので、これで。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（明らかに定員オーバーだな。）"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（現地の住民と観光客でおよそ半々か。ふむ、観光列車にしては珍しいな。）"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（最後列の隅に積まれた麻袋が若干気にかかるな……袋の中で、何かが動いているようだ。動物は持ち込み禁止とされていたはずだが……）"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（ふむ。ほかに異常はなし、注意すべき人物もなし……）"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（あの情報は銀心湖行きの列車を示していただけだった。実際の手がかりを得るのは、そう容易ではなさそうだ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（やはり、機を見て個室を確かめなければ……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドン。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドンドン。"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "先ほどから、背もたれに異常な振動を感じる。\nまさかイェラグの列車には、背もたれを蹴り続ける怪異でもいるのだろうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "…………"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドンドンドンドンドン。\nまるで無反応な彼の様子を不満に思ったかのように、また背もたれが何度も蹴られる。\nしばらくすると、後ろに座っていた子供が、彼のほうを覗き込んできた。"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": "avg_npc_281_1",
      "text": "ねえねえ、変な帽子のおじさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": "avg_npc_281_1",
      "text": "もしかして、おじさんって列車乗るのがすっごく好きなの？　何日か前にも見かけたからさ！"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "……私を見たのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": "avg_npc_867_1",
      "text": "見たよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": "avg_npc_867_1",
      "text": "あっ、もしかして今までレールや列車を見たことなかったとか？　それでそんなに列車が好きなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "ごほん。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": "avg_npc_867_1",
      "text": "なんで咳するの？　恥ずかしがらなくていいよ！　ぼく笑ったりしないから！"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": "avg_npc_867_1",
      "text": "この列車、とってもすごいんだよ！　ぼくもだーいすきなんだ！　ママが言ってたんだけど、これがあるのは巫女様とエンシオディス様のおかげなんだって！　イェラガンドのご加護だよね！"
    },
    {
      "type": "dialogue",
      "speakerName": "やんちゃな子供",
      "speakerId": "avg_npc_867_1",
      "text": "あ、そうだ……ぼくのおもちゃ貸してあげるよ！　ほら、列車のおもちゃ！　だから一緒に遊ぼう、おじさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "speakerId": "avg_npc_281_1",
      "text": "もう、やめなさい！　ちゃんと席に座って、ほかの人に迷惑かけないの！"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "speakerId": "avg_npc_281_1",
      "text": "ご迷惑ばかりおかけして、本当に申し訳ありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "焦る母親",
      "speakerId": "avg_npc_281_1",
      "text": "しつけがなっていないもので……しっかり言い聞かせておきます！"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "いや、気にするな……"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（……）"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（この帽子……）"
    },
    {
      "type": "dialogue",
      "speakerName": "変な帽子の外国人",
      "speakerId": "avg_npc_867_1",
      "text": "（そんなに変なのか？）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "今日は乗客が多いですね。例のイェラガンド像はどうやら大人気と見えますな！"
    },
    {
      "type": "narration",
      "text": "しかし、列車に乗るたび思うのですが、カジミエーシュ騎士競技の競技場は――\nむっ！　わが足指をつついているのは何奴か！"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "こいつは……羽獣か？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "逃げ出した羽獣",
      "speakerId": null,
      "text": "（力強くつつく）"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "おおっとっと、羽獣殿、どうぞおくちばし柔らかに……！"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "うわっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "逃がしちまってよかったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "大丈夫なのかよ。列車の中ってペット持ち込み禁止じゃねぇの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ルール上はそうなっておりますが、そこまで厳しく取り締まらない場合もあるのですよ。それが必要な地元民に便宜を図っているとでも言いましょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ですがご安心を。この手の羽獣は大抵、麻袋に入れて持ち込まれていますので、大きな問題にはなりません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "それはさておき、レディ。私が予約しておいた個室はこの先にございますぞ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "ふぅ……はぁ～、やれやれ！"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "クソ混んでたな！　やっと座れたぜ！"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "立ち乗りも覚悟してたから、個室に入れてもらえてよかったよ。ありがとな、おっさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "お安い御用ですよ、レディ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "やめてくれよ、そんなバカ丁寧に喋らなくていいって。レディとか言うのもやめて、ロザリンって呼んでくれ。"
    },
    {
      "type": "narration",
      "text": "ではお言葉に甘えて……\n「ロザリン」。いやはや、実に美しい名前ですね。貴方によく似合っていますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "へへっ、そうだろ。母ちゃんがつけてくれたんだぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "おっさんはなんて名前なんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ぜひ、ハロルドとお呼びください。無論、引き続き「おっさん」でも構いませんがね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "それにしても、貴方は運の良い方だ。この列車を逃せば、暗くなる前に銀心湖に着くのは難しかったと思いますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "そーなのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "へへっ、間に合ってよかったぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "そういや、ハロルドも銀心湖に向かってるんだよな？　本当は何しに行くんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "はて、その質問にはお答えした気がしますがね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "何しろ、イェラグの景色はこんなにも素晴らしいのですから、良い目の保養になるでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "誤魔化しても無駄だぜ。こんな大所帯で観光なんかするわけねぇだろうが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "おや、観光客には見えませんでしたかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "おう、ちっともな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "どっちかっつーと、面倒ごとを起こしに来たように見えるぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "はっはっは！　そんなことをするはずがないでしょう！"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "私はイェラグの景色と文化にすっかり惚れ込んでおりましてね。引退後はいっそ、この地で隠居しようかとすら考え始めたほどなのですよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ですので、そう、よほどのことが起こらなければ、我々はただの観光客でいられるというわけでして……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "じゃあもし――"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "――ではロザリン、そう言うあなたのほうは……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "観光客にしては随分イェラグ語が堪能ですね。本当にここへ来るのは初めてなのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "無理やり話題変えんなっての！"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "はっはっは。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "まあいいや。まだ話してなかったっけ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "私は半分イェラグ人みたいなもんなんだ。ウルサスで母ちゃんに女手一つで育ててもらってたから、正直自覚はねぇんだけどな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ほう、母君はウルサスの方なのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "ああ。でも母ちゃんが言うには、私はイェラグ生まれで、父ちゃんはイェラグ人らしくてさ……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "つっても、ガキの頃のことなんてあんま覚えてねぇし、言っちまえば旅行みたいなもんかもな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "なるほど、そうでしたか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ところで、お会いした時から聞きたかったのですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "貴方がずっと抱えているその箱は？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "こいつは……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "いや、申し訳ない。プライベートな事情に関わるものであれば、何も仰らないでください。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "別にいいって。ただ、どう言えばいいのか考えてただけでさ……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "これは母ちゃんが私に託した……形見なんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "それは……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "心より哀悼の意を表します。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "つらい過去に無暗に触れてしまって申し訳ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "お悔やみ申し上げます……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "別に、何もつらくなんかねえっての。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "私が今回帰ってきたのは、母ちゃんの願いを叶えるためなんだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣を操る牧畜民",
      "speakerId": "avg_npc_279_1",
      "text": "デーゲンブレヒャーさん、これは……"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "もう大丈夫よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "やれることはやっておいたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣を操る牧畜民",
      "speakerId": "avg_npc_279_1",
      "text": "あなたのおかげじゃ……ありがとう。"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣を操る牧畜民",
      "speakerId": "avg_npc_279_1",
      "text": "デーゲンブレヒャーさんがいなければどうなっていたことか。これもイェラガンドの思し召しじゃな……おかげで皆命拾いしたわい。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "私にできるのはここまでよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "ごめんなさいね。あまり……気持ちのいい眺めではないけれど。"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣を操る牧畜民",
      "speakerId": "avg_npc_279_1",
      "text": "じゃが、今はもう、ほかにどうしようもないしのう……"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "姐さん、お身体に血がついてますが、どうなさいますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "後で考えるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "今は時間がない。一通り対処はしたけど、また問題が起こらないとも限らないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "今は「あの人」を見つけることのほうが先決よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "ですが、あの人はもう駅を離れたって話ですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "今すぐ列車を止めてくれ、なんて鉄道側に連絡したら、パニックになるかもしれませんし……"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "列車を止める？"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "そんなこと、するまでもないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "じゃあ、どうするんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "下を見なさい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "こいつは……"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "列車だ！　ちょうど下の山道に差し掛かったとこですね！"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "ええ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタ",
      "speakerId": "avg_npc_275",
      "text": "え、待ってください、姐さん！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "落ちて行く彼女の姿は、雪より軽いようにも、石より重いようにも見えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "さて……"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "speakerId": "avg_4116_blkkgt_1",
      "text": "あの人はどこかしら？"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
