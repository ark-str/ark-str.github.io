{
  "server": "jp",
  "storyId": "story_firwhl_set_1_story_1",
  "groupId": "story_firwhl_set_1",
  "stageId": null,
  "title": "独り行く者",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_firwhl_1_1.txt",
  "sourceHash": "90c71ec236c60f074778dc0dcbc4ed55638c48d53b5ac65f25ace2031dd79ddc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "浮ついた学生",
      "speakerId": null,
      "text": "ついに待ちに待った完成の日が来たぜ！"
    },
    {
      "type": "dialogue",
      "speakerName": "浮ついた学生",
      "speakerId": null,
      "text": "初めて大学を飛び出し、移動都市を飛び出し、丸々二週間かけて、自分たちの手でレンガを一つ一つ積み上げて……"
    },
    {
      "type": "dialogue",
      "speakerName": "浮ついた学生",
      "speakerId": null,
      "text": "貧窮にあえぐこの村のために建てた学校がついに完成したんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "浮ついた学生",
      "speakerId": null,
      "text": "あぁ……もう授業中の子供たちの声が聞こえてくるよ……"
    },
    {
      "type": "narration",
      "text": "村外れの空き地で、十数人の大学生らしき若者が輪になって座り、興奮気味に話し込んでいた。\n彼らのすぐそばには、完成したばかりであろう歪な形をした二階建ての建築物が立っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "いい加減にしてよ。そんな詩みたいなくさいセリフ連発しないでくれる？　聞いてて鳥肌が立ちそう。"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "それに、この村に学校を建てられたのは、アグニがいてくれたおかげだよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "あはは、そんな大げさなー。"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "本当にそう思ってるの。"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "大学生なんて口先だけの生き物よ。レム・ビリトンの貧しい人々を救うんだって口では言っても、移動都市の外の暮らしなんて見たことすらない。"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "アグニがちゃんと行動に移せって喝を入れてくれなかったら、私たちこの村に来ることもなかったし、ここの人たちの大変さを知ることもなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "浮ついた学生",
      "speakerId": null,
      "text": "みんな、今この瞬間は俺らの思いが詰まったこの学校を共に祝福しようぜ！"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "うわぁ……あいつ今度は何をするつもりなの？"
    },
    {
      "type": "narration",
      "text": "浮ついた学生はシャンパンを取り出すと、瓶を掴んで激しく上下に振り、そして勢いよくワイヤーを外した。\nまき散らされるシャンパンと共に、コルクが勢いよく飛び出し、そして偶然にも学校の歪んだ扉とそのフレームの間に挟まってしまったのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "学生たち",
      "speakerId": null,
      "text": "アハハハハハ……"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "ハハハハ……あいつって本当に馬鹿……ねぇ、アグニもそう思う――"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "アグニ？　どうしたの？　ちっともうれしそうに見えないけど。"
    },
    {
      "type": "narration",
      "text": "声をかけられたアグニは、遠くのほうにいる村人たちを指さした。\n彼らはただただ無表情で俯きながら農作業に勤しんでおり、まるで完成したばかりの学校も、学校を建ててくれた大学生たちも存在していないかのような無関心さだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "誰かね？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "こんばんは、村長さん。アグニといいます。村に学校を建てにきた学生のひとりで――"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "今日はもう遅い。用があるなら明日にしてくれんか。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "その、あたしたち、明日帰る予定なんです。それであいさつに来ました。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "挨拶はいらん。帰りたきゃ好きに帰ればいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "い、いえ、あいさつだけじゃなくて、渡したいものもあって……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "今日はみんなはしゃぎすぎちゃって、これを村の皆さんに渡すのを忘れていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "どうぞ、学校の完成祝いです。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長に受け取る意志がないことに気付いたアグニは、酒の入った瓶をテーブルに置くしかなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "持って帰んな。そんな小洒落た酒、田舎もんの口には合わん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "このお酒、口当たりがよくてすごく飲みやすいんです。ぜひ試してみてください。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長は首を横に振ると、アグニが置いた酒を手に取り、何か読み取れることはないかとラベルに描かれた絵をしげしげと眺める。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "この絵はなんだ？　ブドウ畑？　ブドウ畑はこの「シャンパン」ってやつとなんか関係でもあんのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "どうせ酒屋が適当に描いたラベルと、適当に付けた名前です。炭酸の入ったお酒だと思ってください。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "フン、わしらが作った酒も、こんなシャンパンなんてもんには引けを取らんわい。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "でしたら……！　明日出発する前に、互いのお酒の飲み合いをしませんか？　あたしたちも村のお酒を飲んでみた――"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "もうとっくに作るのをやめたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "近くで鉄鉱石が見つかってから、オリジムシすらここいらで巣を作りたがらないさ。ホップの栽培なんてできるはずがなかろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "そんな……どうして。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "「どうして」だって？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "来てからずいぶん経つってんのに、採鉱プラットフォームの音が聞こえてなかったのか？　頻繁に地面が揺れるわ、山も震えるわで、こんな場所オリジムシすら嫌がるのも当然だろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "たしかに数日前にそんな音が聞こえたような気もしたけど、みんな特に気にしてなくて……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村人の話を裏付けるかのように、遠くから唸り声のような轟音が響いてきた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "今のは流石に気付いたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "お嬢さん、酒は持って帰りな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "ですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "まだ何かあるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "実はずっと気になってたんですけど……初めのうちは皆さんとても歓迎してくれたのに、学校が完成したら、逆に冷たくなったのはなんでですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "あっ、もし完成した学校の出来に不満があるのなら、安心してください。あたしが責任を持って、信頼できる工事業者に依頼を――"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "どうせもう帰るんだ。正直に言おう。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "そもそも村に学校なんて必要ないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "えっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "わしらはただ、君たちがここに来て、村に金を落とすのを期待していただけだ。食事も宿も村の収入になるだろ？　もし寄付なんてしてくれたら、なおさら万々歳さ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "なのに君たちは、メシも村で食わんし、テントを建てて野宿ときた……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君たちが滞在していた数週間、木を切ってレンガを焼く以外で、唯一金を落としてくれたのは焼獣肉を買ってくれた時だけだ。こんなちっぽけな金で喜べる奴がどこにいる？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "でも将来的なことを考えれば、これで村の子供たちは学校に通えるようになるし、その子たちが大きくなれば――"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "村の暮らしも変わるってか？　そもそもなぜわしらは自分の生活を変えにゃならんのだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "まあいい、ここで議論をしても意味がない。そんなことを言うのなら一つだけ答えてくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "誰が授業をするんだ？　こんな将来性のない場所で授業したがる奴がどこにいる？　移動都市で授業をしたり、君たちみたいな金持ちの子供の家庭教師になったほうが、ここよりずっとマシだろ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドン――村長はボトルを勢いよくテーブルに置いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "すみません……そこまでは考えていませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "学校さえ完成させれば、あとは合理的な給料を提示できれば、誰かが求人に応募してくれるものだと……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "ここには鉱物もなければ、契約している鉱業会社もない。奴らの物流ルートも全部ここを避けてんだ。多少金払いがよくたって、毎日荒野を超えてまで通いたいと思う奴がいるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "わしらはそもそも違う世界の人なんだ。こんな場所で時間を無駄にしてないで、さっさと帰ったほうがいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "酒も忘れんようにな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "いえ、せめて……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "ちょっと待ってください！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "浮ついた学生",
      "speakerId": null,
      "text": "ここに残って教師になる？"
    },
    {
      "type": "dialogue",
      "speakerName": "浮ついた学生",
      "speakerId": null,
      "text": "その話にはさすがに乗れねぇな。すまんアグニ、パスだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "村人に教師を雇うお金を渡すのは？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "その方法はもう考えた。でもここは交通も不便だし、誰も来たがらないと思う。だからあたしたちが……"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "アグニ、忘れたの？　あと五日で新学期が始まるんだよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……新学期？"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "まだ単位が足りてないから、講義を多めに取っとかなきゃ。卒業が延期になったら困るよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "新学期？　単位？　延期？　それがなんだっていうの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "ア、アグニ……？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "（深呼吸）"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "別にみんなが間違ったことを言ってるとは思わない。でもここの子供たちは学校にも通えないのに、あたしたちが学校のために帰るって、みんなは……皮肉だと思わないわけ？"
    },
    {
      "type": "dialogue",
      "speakerName": "物静かな学生",
      "speakerId": null,
      "text": "そんなことを言ったって、でも私たちは学生なんだから、自分の学業を第一に考えるのは当然のことじゃないの？"
    },
    {
      "type": "narration",
      "text": "アグニはその場に立ち尽くしてしまった。言いたいことはたくさんあるのに、何ひとつ言葉にならない。\n他の学生たちはアグニに慰めの言葉をかけたが、反応が返ってこないのを見ると、各々その場から離れていった。\n彼らにはまだ荷造りがある。取らねばならない単位と学位がある。ここでアグニと一緒に突っ立っている時間なんてないのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "今追いかけて呼び止めれば、まだ車に乗れるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "残ると決めたんです。考えを変えるつもりはありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君がここに残って教師になったとて意味なんぞないのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "少なくとも、あたしは意味があると思っています。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "ずいぶんと頑固なんだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "あたし、小さい時からずーっと頑固者ですよ。何かをやると決めたら絶対に譲らないから、両親はずいぶんと頭を悩ませたみたい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人は遠ざかっていく車に背を向け、ゆっくりと村のほうへと戻っていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村人たちは学校や教師に対して関心を示さなかった。だけど、大人たちが仕事に勤しむ昼間に、子供の面倒を見てくれる人が必要だったのも事実。\nそのため、村に戻ったアグニは望み通り村人たちの許可を得て、自分たちが建てた学校で教鞭を取ることとなった。彼女は見よう見まねで時間割を作り、授業計画も立てた。\nだが教壇に立ってすぐに、アグニは大きな問題に気付いた。足し算やら引き算やらを教える以前に、子供たちは基本的な読み書きさえできないのだと。\nまだ学校が始まって数日しか経っていないというのに、アグニも子供たちも皆疲れ果ててしまっていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君が真剣に子供たちに何かを教えようとしていることは、村のみんなが気付いているよ。君は他の学生たちよりずっと立派だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "だけどな、もう少し自分を労わるべきだ。子供たちとは適当に遊んでやってくれればそれでいいさ。あまり根を詰めすぎると体を壊すぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "もし嫌だと言ったら？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "今の授業を続けたところで何になる？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "せいぜい文字が読めて、簡単な計算ができるようになる程度のことだろ。それがなんの役に立つんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "役に立つに決まってます。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "これは基本中の基本なんです。これを身に付ければ、もっと難しいことを学べます。知識が増えれば暮らしだって……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "変わるって言いたいのか？　またその話かい。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "アグニ、村のみんなが君を気に入ってんのは、君が無条件にみんなに熱心に親切に接してくれるからだ。生活を変えようとしてくれているからじゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "ここ数年、わしらの生活をコロコロと変え、ビールすら飲めなくさせたのは誰か知ってるか？　鉱業会社だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "だけど、子供たちがもっとたくさんの知識を身につけて、視野が広がれば、きっと今よりもいい生活ができるはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "いい生活ってなんだ？　大学に入ることか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "それも「いい生活」の一部です。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "だったら君はどれだけの時間をかけて、君のような大学生を育て上げるつもりなんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……バカみたいなことをしているのは分かっています。だけど、もう一度始めてしまったのなら、途中で投げ出すなんて、あたしにはできません。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "確かに君は頑固だな。君の親が頭を悩ませていたのも無理ないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "もう好きにしな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "前に持ってきたシャンパンはまだ残っていますよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "飲みたいのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "アハハ、あれはお祝いのお酒ですよ。今飲んじゃったら、ただのヤケ酒になっちゃうじゃないですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "実は……今日が大学の新学期の一日目だったんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "今日からスタートして、子供たちに一学期分の授業を教えることができたら……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "授業の出来に関係なく、学期末最後の日に、村のみんなで一緒にこのお酒を開けませんか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長はアグニを見つめ、そして次にボロボロの戸棚の一番奥に置かれた、場違いに華やかなシャンパンボトルを見つめた。\n遠くから響いてくる採鉱プラットフォームの試掘音に合わせ、液体からの脱出を試みているかのように、ボトルの中で気泡が落ち着きなく浮かび上がる。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君が持ってきた酒だ。やりたいようにやりゃいい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "それから、子供たちは自分たちの名前が書けるようになり、足し算と引き算を覚えた。飲み込みの速い子たちは、掛け算や割り算もできるようになっている。\n授業以外にも、幼い頃から火遊びをしていた経験のおかげで、アグニは村の中で一定の人望を得た。\n少なくとも、お腹が空いているのに薪が湿って火が点かない時、村人は真っ先にアグニを呼びにいこうと思いつくほどである。\n一ヶ月という時はあっという間に過ぎていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "（伸びをする）うーん――"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "やっと今日の授業が終わったよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "疲れたのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "まだ大丈夫です。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "通常の学校なら一ヶ月半はかかるカリキュラムを、一ヶ月で終わらせましたよ。これで一学期で学ばなきゃいけない内容は、もう半分を切りました。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "つまり、あともう一ヶ月もすれば、シャンパンを開けられるってこと――"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "speakerId": null,
      "text": "アグニ先生！　アグニ先生！"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "どうしたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "speakerId": null,
      "text": "あのね、村の入り口前にたくさんの車が止まってるの。そこに乗っていたカチッとした服を着たおじさんが、先生に用事があるんだって！"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "speakerId": null,
      "text": "先生、どうしたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……なんでもないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な子供",
      "speakerId": null,
      "text": "ならよかった！　それじゃあ僕、ほかのみんなと遊んでくるね！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "親父さんかい？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……たぶん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "お祝いのお酒は、どうやらもう飲めそうにないですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "（アグニの肩を叩く）"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君のために取っといてやるさ。まずは親父さんに会ってきな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "父さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "アグニ……顔をよく見せてくれ。うんうん、よかった、怪我はないようだな。だけど少し痩せた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "いい加減気が済んだろ？　もう気持ちを切り替えなさい。父さんと帰るんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "いやだ。子供たちに一学期分の授業をするって村のみんなと約束したの。まだ半分しか終わってないんだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "はあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "たった一ヶ月で半学期分の授業を終わらせたんだよ！　みんな、自分の名前が書けるようになったし、足し算と引き算もできるようになった！　あともう一ヶ月で授業が終わるの！"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "アグニ、こんなことに意味がないことくらい分かるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "意味がない！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "自分の名前が書けて、簡単な計算さえできれば、あの子たちは両親とは違う人生を歩めるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "大学に戻りなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "時間は待ってはくれない。お前の卒業が一年延びれば、鉱業の仕事を任せるのもその分遅れることにな――"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "だから、あたしは父さんの跡は継がないってば！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "車隊のほかの人々は全員黙りこくっていた。\nこのような親子喧嘩は、もう数えきれないほど見てきているのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "アグニ、何度も伝えたと思うが、父さんはお前のような家の経済力を鼻にかけることのない、思いやりのある優しい娘を持てて本当にうれしく思う。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "だが、誰かの生活を豊かにしたいのなら、高い場所から大局を眺めつつ、行動しなければならないことを理解してほしいんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "今はそんな話をしないで！　どうせ結論なんて出ないんだから！"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "……お前はまたそうやって、父さんの話を最後まで聞こうとすらしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "こうしよう、アグニ。父さんからの提案だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "子供たちに授業をする者がいなくなるのが嫌なのだろう？　なら私が村のために教師を雇ってやる。十分な給与さえ提示すれば、必ず応募者が現れるはずだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "また始まった……あたしが気にかけている人たちをだしにして、自分の条件を飲ませる気でしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "そんな風に言わないでくれ、アグニ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "私はただ、こうすればお前が私の言葉を真剣に考えてくれるのではないかと思っているだけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "もしお前が父さんの地位に就いた時、それか父さんよりもっと多くの力を手にした時、この村に……この村と似たような境遇のたくさんの村に何ができるのか、考えてみなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アグニはうつむき、歯を食いしばり、父の目から逃れようとした。\n父と目を合わせてしまえば、自分が頷いてしまうのではないかと、怖かったのだ。\nそんな自分に吐き気がした。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "（歯を食いしばる）"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "村に戻って……このことを話してくる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "あたしは街に戻って、父が代わりに教師を雇うことになるかと……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "やっぱり君の家は……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "鉱業会社を経営していたわけか。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "（黙ってうなずく）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長は棚の奥にしまってあった例のシャンパンを取り出すと、アグニに押し付けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "もう行け。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "わしらは元々学校なんて必要としておらん。鉱業会社の社長が援助する学校なんて、もってのほかだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "そんな……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "わしだってこんなことは言いたくない。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "鉄鉱が見つかってから、この村にはオリジムシも近寄らなくなった話はしたよな？　でも、なぜ村はホップすら植えるのをやめたと思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "どうしてですか……？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "ついて来い、理由を教えてやる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "ほら、この荒れ果てた土地を見てみな。この場所には昔、目の届く限りポップ畑が広がっていたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "採鉱プラットフォームが建設された当初、わしらも期待したさ。これで鉱業会社の作業員が大勢やってくると、物資の需要も色々出てくるだろうとな……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "鉱業会社とは、いい取引きができると思ったものよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "だが、彼らがわしらに声をかけることはなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "自分たちで商品を仕入れ、販売場所を設置し、すべての人に開放したんだ。そこはなんでも売っていた。食料、果物、布……そしてもちろん、ビールもだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "しかも、その値段はわしらのビールの仕入れ値よりも安いときた！"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "そうなっては鉱業会社どころか、今まで取引きしていたほかの村たちですら、すぐにそっちに乗り換えてしまったよ。鉱業会社の商品のほうが質も良くて安いしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "これがホップの栽培をやめた理由さ。他所からビールを買いにくる者などとうにいなくなった。なんせ身内ですら、飲みたい時に真っ先に思いつくのが鉱業会社なくらいだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "そんな時、鉱業会社の人がやってきて、土地の譲渡契約を結べば補償金をもらえると同時に鉱業会社に雇ってもらい、手厚い待遇を受けられると告げられた……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "ハッ、何が手厚い待遇だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "わしらは知ってるんだぞ。鉱業会社はその気になれば、従業員をいつでもクビにできる。そうなれば、食いぶちがなくなるだけじゃない。前に持っていた土地も取られるんだ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "勢いよくまくし立てる村長を見て、アグニは先ほど父に言われたことを思い出した。\n「もしお前が父さんの地位に就いた時、それか父さんよりもっと多くの力を手にした時、この村に……この村と似たような境遇のたくさんの村に何ができるのか、考えてみなさい」"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "アグニ……君が本当に子供たちに読み書きを教えたいという善意だけで来てくれたことは信じよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "だけど今になって、君は自分が帰る代わりに、親父さんの鉱業会社が援助すると言い出した……教えてくれ、わしらはどうやって君の親父さんやその会社を信じればいい？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "それと――"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君がそんなつもりじゃないのは、わしだって分かってる。だがな、アグニ――"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君は自分が親父さんや、親父さんの競合相手と同じことをしているとは思わんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "そんなまさか！　どうしてそんなことを言うんですか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君たちの目指している場所は同じだ。わしらの子孫に土地を捨てるように仕向け、採鉱プラットフォームや移動都市へ向かわせ、なんの保証もない暮らしをさせようとしている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アグニは唇を震わせた。たくさんの言葉が次々と浮かんではぐるぐると頭を駆け巡り、喉がつっかえた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "遠くの方から轟音が響いてくる。\n村で暮らすうちに、すっかりこの音と振動に慣れてしまったはずなのに、今回のものはやけに大きく激しく感じた。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "クソッ、今日の揺れはやけに激しいな！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ひとつの大型採鉱プラットフォームが、大きな音を立てながら村のすぐそばを通り過ぎていく。その振動はまるで天災の訪れを予兆する地震のようだった。\nアグニはよろめきながら、ようやくなぜオリジムシですらここに居つかないのかを理解した。\nその時、彼女は視界の端に別のものを捉えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "学校が！！"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "どうした！？　学校がなんだって？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大型採鉱プラットフォームが遠ざかるにつれ、地面の揺れも次第に収まる。\nだがアグニたちの作った学校はそれに耐えることができなかった。素人の手によるそれは建付けが甘く、元々いつ崩れてもおかしくなかったが、さっきの振動でついに瓦礫の山と化してしまったのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "呆然と立ち尽くすアグニは、揺れが収まってからしばらくして、力なく地面にへたり込んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "みんなが帰った後でよかったな。怪我人が出なかったのは不幸中の幸いだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "帰るんだ、アグニ。もうわしらの心配なんてしなくていい。"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "speakerId": null,
      "text": "君はいい子だよ。だけど前にも言った通り、わしらは同じ世界に住む人ではない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "村長はアグニを置いて、自宅へ向かって歩きはじめる。\nしばらく歩いて振り返ると、アグニはいまだに元の場所から動いていなかった。\n本当に頑固な娘だと、村長は思った。だが、そんな娘でもいずれはその父親のような人になるだろう。いや、嫌いにはなれない分、父親以上に危険かもしれん。\n村長が再び歩き出そうと思ったその時、アグニが地面に転がっていたシャンパンボトルを掴んだのを見た。\nアグニは両手でボトルを抑え、正気を失ったかのように、無我夢中でそれを振り始める。まるでそのボトルに閉じ込められているのが炭酸ではなく、誰かの魂であるかのように。\nボトルを振るために、アグニは全身の力を振り絞っていた。そして体力を一滴残らず使い果たした時、彼女はボトルを高く掲げ、空に向けた。\nポンッ――\nその音が実際に聞こえたものか、空耳だったのかは分からない。\nただ、空に向かってまっすぐに飛んでいくコルクは、はっきりと視界に捉えることができた。果たしてそれはあえなく瓦礫の山に落ちるのか、それともそのまま飛んでいくのだろうか。\n村長が最後に見たのは、シャンパンボトルを思いっきり地面に叩きつけ、大股で歩き去っていくアグニの後ろ姿だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "アグニ、いつまでそうやってだんまりを決め込むつもりだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "意地を張ったところで何も解決しないぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "アグニ、現実を見なさい。鉱業が発展すればするほどに、あのような村には将来性がなくなる。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "だが彼らが過去に縋ることをやめ、差し伸べられた未来を受け入れさえすれば、彼ら自身も、彼らの子孫も、真に豊かな暮らしを送れるようになるのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "そして私や未来のお前は、そんなビジョンを実現させるために行動せねばならない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "今のお前にはまだ分からないだろう。彼らにより良い暮らしを与えるには、まずは過去の幻想から目を覚ますように説得する必要がある。そのプロセスは短いほど、彼らも長く苦しまずに済む。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "ハハッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "そうね、いいことを教えてあげよっか、父さん。そのプロセスならつい先ほど、大きく一歩前進したところだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "あたしたちが村に建てた学校なんだけど、通りかかった採鉱プラットフォームの揺れで倒壊したんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "なんだと？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "確かに今日の揺れは強かったが、まさかそんなことになっていたとは……学校は父さんが手配してもう一度――"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "父さんは今……学校が無くなっちゃったのをいいことに、あたしが約束をなかったことにするんじゃないかって心配してるんでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "大丈夫だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "父さんの言葉、言われた通りちゃんと真剣に考えたんだ。車に乗った時から、今の今まで何時間もずっと。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "あたし、やっぱり今はまだ答えが出せないや――"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "ひとつのことを除いてはね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニの父",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "父さんはいい上司で、いい公民で……いい父親だと思う、心の底からね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "でもレム・ビリトンは外づらのいい人なら余るほどいる。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "父さん、あたし怖いんだ。外づらばかり気にしていたら、周りのことが見えなくなるんじゃないかって……目の前で学校が崩れ去っても何も思わない人になるのは嫌だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "だからね、父さん……"
    },
    {
      "type": "dialogue",
      "speakerName": "アグニ",
      "speakerId": null,
      "text": "あたし……やっぱり父さんの会社は継げないよ。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
