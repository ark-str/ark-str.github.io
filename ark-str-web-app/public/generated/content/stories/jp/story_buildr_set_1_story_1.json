{
  "server": "jp",
  "storyId": "story_buildr_set_1_story_1",
  "groupId": "story_buildr_set_1",
  "stageId": null,
  "title": "戻ってきた羽獣",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_buildr_1_1.txt",
  "sourceHash": "1dd5d3e132aa6bef139b58bc46f2768d033b22e174977c6feb006c3224cc6ac9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "これが……旧シエスタから吹く風。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "空で輪を描いている海羽獣たちも、この場所を新しい家にするためにはるばる飛んできたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あたし、やっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ねぇ、おじい……あたし、見つけたよ……ずいぶん回り道しちゃったけど、ようやく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "スゥー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ただいまーー！　シエスターー！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ノーモアバッドラック！　これで不幸にさようなら！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "未来はきっと……良くなるぞーー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ど、どうなってるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "これって……あたしの履歴書じゃない！　どうしてゴミ箱に入ってるわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ちょっと！　思いつく限りのあらゆるツテを頼ったけど、あたしに合う仕事が見つからなかったって言ってましたよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "なのに、あたしのポートフォリオ、どう見ても誰にも読まれてないのに、履歴書と一緒にゴミ箱に放り込まれてるんですけど！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "アンマイヤーさん、まずは落ち着いてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "確かに可能な限り力になるとはお伝えしました。シエスタ雇用労働課は、職を求める皆様をサポートするのが責務ですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "しかしながら……アンマイヤーさんと共に仕事をしたい相手がいない以上、私にもどうしようもないじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "そんな……どうして誰もあたしを雇ってくれないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "もう遠慮しなくていいんで、はっきり言っちゃってください。でないと今後に繋がりませんので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "大丈夫です。改善の方向性さえ示してくれれば、絶対に期待は裏切りません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "分かりました……改善するのはかなり難しいかとは思いますが、率直にお伝えしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "あなたが仕事を見つけられない理由は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "運が悪すぎるからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……へ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "運が悪すぎるって……どういう意味ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "この書類の山が見えますか？　今日送られてきた履歴書だけでもこの数です！　私一人で目を通せるはずないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "そこで、いいアイデアを思い付いたんですよ。ほら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "職員は積み上げられた履歴書から適当に一束抜き出すと、ゴミ箱に放り込んだ。それによって履歴書の山は目に見えて嵩を減らした。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ま、まだ読んでもいない履歴書を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "仕方ありません。私の時間と気力にも限りがありますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "でも履歴書に目を通すのがあなたの仕事でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "いいえ、その言い方は正しくありません。私の仕事は雇用主のために適切な人材を選び抜くことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "雇用主に幸運をもたらせるか否か、それこそが我々が最も重視する評価基準なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "何にせよ、ここ数年のシエスタはあまりにも多くの不幸に見舞われてきましたからね。雇用主の皆様もこれ以上不測の事態に遭遇することを望まれておりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "そして、あなたの履歴書は「幸運にも」ゴミ箱に放り込まれました……こんな疫病神を雇いたがる企業があると思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "や、疫病神？　君ねえ……本当にがっかりだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "せっかく今日、ワクワクしながらここに来たっていうのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "たとえ小さな建設隊だったとしても、研修基準の給料しかもらえない助手の仕事でも、とりあえずチャレンジしてみようと思ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "それなのに、誰もあたしを雇ってくれないのは、ただ運が悪かったからだって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "……何するんですか！　落ち着いて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "今に見てなさいよ。自分でなんとかしてみせるから！　あたしならできるって証明するよ……どこも雇ってくれないなら自分でチームを組んでやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "君なんかに頼るもんか……この――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "ちょっ、ちょっと……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "アンマイヤーさん、落ち着いてください！　やめ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シティホール職員",
      "text": "私のゴミ箱が……べ、弁償してもらいますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "フン、あんたも運が悪かったみたいだね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ふぅ……とりあえず落ち着こう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "職務放棄をした役員の話なんて、真に受ける必要はないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "シエスタ市の公認建設団体からの応募がダメなら、次は民間の建設会社を狙えばいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "それでもダメなら、街の個人工房を一軒一軒回ることだってできるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "シエスタはそこら中で工事してるんだし、どこかしら受け入れてくれる場所があるはず……だよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "はあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "シエスタって……本当におじいの言ってたような場所なのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "そこのお嬢さん、どうしてそんな悲しい顔をしてるんだい？　ここはひとつ、うちのシエスタ名物でも食べて元気を出しな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "うちのパイは、絶対に食べたいシエスタのご当地グルメランキングに入ってんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ご当地グルメランキング？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "さあさあ、遠慮しないで。ほら、初めてのお客さんへの試食サービスだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "わっ、ありがとう！　いただきます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "（もぐもぐ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "これ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "少女は微かに眉をひそめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "ど、どうした？　口に合わなかったのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あっ、いやいや、おいしいはおいしいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "だけど……どうしてこんなに甘いの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ここまで甘いオレンジパイは初めて食べたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "こいつはオレンジパイじゃないぜ。それを改良した「スイートオレンジパイ」さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "「スイートオレンジパイ」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "まっ、普通のオレンジパイにスイートソースを多めに入れただけなんだけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "でも……酸っぱいオレンジパイこそシエスタの名物でしょ？　おじいがいつも作ってくれたのも、すっごく酸っぱかったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "おじいはパイのフィリングを作る時は、少しも黄色の混ざっていない真っ青なサワーオレンジを使ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ましてやスイートソースなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "へぇ、そこまでクラシックにこだわっていたとはねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "おじいさんはシエスタ出身かい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あたしもそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "へえ？　じゃあ、ここには久しぶりに戻ってきたってとこかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……生まれてすぐに、家族全員でクルビアに引っ越したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "なるほど、道理でクルビアっぽい訛りがあると思ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの男の子",
      "text": "ハンクさん！　スイートオレンジパイ一つ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "おお、ルート！　また来たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの男の子",
      "text": "シー！　ヘイリーには内緒ね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの男の子",
      "text": "（小声）いっちばん甘いのをちょうだい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "おうおう、ほら持ってけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの男の子",
      "text": "ありがとう、ハンクさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男の子は店主からパイの入った袋を受け取ると、一目散に走り去っていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あんなにたくさんハチミツを入れちゃうんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "それだけじゃないぜ。フィリングには通常の三倍もの練乳を入れてるし、パイの底にはカラメルも塗ってある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "だからこんなに甘いんだね。これじゃ元々のオレンジパイとは全くの別物だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "まったくなぁ。だけど仕方ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "子供たちも若い観光客も、みんな甘い方が好きなんだ。売上のためには、サワーオレンジパイの味も改良せざるを得なかったのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "今のシエスタは、昔とは違うからな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "この移動都市は、おじいから聞いてたシエスタとはだいぶ違うみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何もかもが変わったわけじゃありませんけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "シエスタ人は新しい味を受け入れましたが、昔の味が恋しくなることもあるのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "おぉー、これはこれは、我らがシティホールの期待のホープじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "うちみたいなちっぽけな屋台にわざわざお訪ねなさるとはね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "たまたま通りかかっただけですよ……それとオレンジパイを一つお願いします、ハンクさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "おいおい、他人行儀はやめろって。旧シエスタにいた頃はあんなに仲良くやってたのによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "（この人もシティホールの職員なんだ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "観光商店街の老舗がすっかり変わった今でも、こうして昔みたいに接してもらえて嬉しいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "よせよ、再建の件は上手くやったと思うぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "シティホールから結構な額の休業手当ももらえたし、今後も支援策を充実させる予定なんだろ？　みんなもう十分満足してるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "俺みたいにじっとしてられない奴でも、暇を潰しに屋台を出す余裕があるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "ほれ、お待ちどうさん。昔ながらの震えるほど酸っぱいオレンジパイだ。商店街の奴らの好みは、俺が一番よく分かってっからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……皆が私の仕事に協力してくれるおかげだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ありがとう、ハンク。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……あの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "おや？　お嬢さん、まだいたのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ちょっと聞きたいんだけど、二人の話に出てきた商店街って、今もまだ再建築の工事中なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "「今でも」どころか、もう朝から晩まで工事中さ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屋台の主人",
      "text": "なんでも、商店街を再建できたら、海外の大企業がそこら一帯にテラ最大のウォーターパークリゾートを建てるって噂だからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ハンク、そんな大袈裟な話じゃないって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "再建の目的は、旧商店街に古くから住んでいた住民たちに、一刻も早く移動都市での新生活に慣れてもらうために過ぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "シエスタをいつまでも過去の美しい思い出の中に沈めておくわけにはいかないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "（昔のシエスタは……その商店街でまだ見ることができるんだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "（だけど、そんなささやかな思い出ですらもうじき……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "じゃあ、商店街の再建ってまだ人手を募集してたりする？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "もっとそっと運んでちょうだい！　ああもう、見てられないわ……その子たちは私の大切な宝物なのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "だから言ったじゃない……新しい倉庫に全部運び込むのはやめた方がいいって……この子たちはまだ……いいえ、心の準備ができていないのは私の方ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "でもこの子たちをあんな暗いところに閉じ込めるなんて、あんまりだと思わない、あなた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋男性店主",
      "text": "大丈夫さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋男性店主",
      "text": "俺たちの二人の音楽バーベキュー店「ラヴァフィッシャー」が完成するまでは、どのみちこいつらの出番はないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "でも、この子たちは、私のおばあちゃんからお母さんに、お母さんから私に代々受け継がれてきたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "時間さえあれば欠かさず手入れをしてきたんだから！　ピカピカになるまで磨いて、軽く叩いただけで良い音が鳴るようにね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "ああ、やっぱり離れがたいわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "労働者",
      "text": "ご安心ください、女将さん！　ギターだろうとドラムだろうと、それから……木琴だか竪琴だか分かりませんが、全部ちゃんと梱包しましたから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "労働者",
      "text": "どの楽器も緩衝材を何重にも巻いて、隙間なく包んであります。水どころかわずかな湿気すら通しませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "労働者",
      "text": "お二人がその……音楽バーベキュー店を開く日まで、どの楽器の音色も完璧な状態を維持できることをお約束します！　お店の看板に泥を塗るようなことは決してしません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "ちょっと！　いつ宝物が楽器だって言ったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "私の宝物はバーベキューコンロよ！　それも全部きちんと梱包してくれたんでしょうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "労働者",
      "text": "……え？　あれって処分するものじゃなかったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "なっ――何言ってるの！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ここが観光商店街……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あそこのお店……業者とトラブルを起こしてるみたいだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "どんどん騒ぎが大きくなってきてる。仲裁に入った方がいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "大丈夫ですよ。あれは喧嘩ではありません。ここの住民たちにはまだ「過去の日々」とお別れするための時間が必要なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "この通りにあるお店のほとんどは、私とあなたの年齢を足しても足りないくらい、長くここにあったのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あたし……シエスタがまだ海辺にあった頃の、この街の話を聞いたことがあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "夜になると、人々はビーチに色とりどりのパラソルをさし、その下でバーベキューコンロをセットして、波の音すらかき消すほどの賑やかな音楽が鳴り響く中、パーティーを開くんだとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あの頃のシエスタはまだ建設途中で、立派なビルもほとんどなかったし、行き交う観光客の数も少なかったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "人々の喜びは、いつだって十分すぎるほどそこにあったって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あなたのお爺様がうちの祖父と会ったら、きっと意気投合していたでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "コスタさんのおじいさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "祖父は楽観的で、風変わりな人でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "へぇ……でもお年寄りってみんなそんな感じじゃない？　ちょっと考え方が変だけど、いつものんきで……若い頃さんざん大変な目に遭ってきたはずなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "それに比べて、今のあたしは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少女は胸一杯に思いを馳せながら、街の中心部を一望する――\n遠くの方にそびえ立つビルは立派で、その下の交差点では整備された広い車道を車が駆け抜けていった。\nぞろぞろと行き交う観光客の中、オシャレに着飾った小さなグループが街角で立ち止まり、誰かが壁に残した火山のグラフィティにカメラを向けている。\nここの全ては、おじいが夢に描いていた光景のはずだ。\nだけど自分にとっては、ここにある何もかもが遥か遠くに感じる。まるで、自分が未だにシエスタへ向かう道中からこの全てを眺めているかのように。\n一瞬だけ、彼女は皮を剝いたサワーオレンジを丸ごと喉に詰まらせたかのように感じた。"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ああ、そういえば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "今日、シティホールの同僚たちが業務用のチャットグループでとある「ゴミ箱クラッシャー」について語っているのを、偶然目にしましてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "彼女がシエスタへやって来た経緯も聞いたのですが、なかなかに波乱万丈だったようですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あんなに回り道をしてもなお、あきらめずにここまでたどり着いたなんて、きっと彼女もかなりの楽天家に違いありません。大したものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "確か、その方も名前がアンマイヤーだったような？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……分かったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あの時はついカッとなっちゃったの……ちゃんと後であの職員さんに謝りに行こうと思ってたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ごめんなさい、コスタさん。壊しちゃった物は、ちゃんと弁償するから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "私は別に損害賠償の話をしに来たわけじゃありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ただオレンジパイを買うついでに、無責任な同僚の尻拭いをしてやろうと思っただけです――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "職を求めてシエスタにやってきた若者が、就職難を無事乗り越えられるようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "やる気に満ちあふれているのに、どこにも発揮できる場所がなく、行き詰まってしまう感覚を、私はよく分かっていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ありがとう、コスタさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "でも、あたし一体どうすればいいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "まずはあなたがどうしたいのか、聞かせてもらえますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あたしが……どうしたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あたし……本当は商店街のお店を回って、まだ改築の作業員が足りてるかどうか聞いてみるつもりだったの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "でもさっき通りかかった音楽屋のいざこざを見てたら……自分なんかにできるのかなって不安になっちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "なぜです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あたしはニューシエスタのことを何も知らないし、昔のシエスタの知識だっておじいが話してくれた内容しか知らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "黒曜石祭に、移動都市への引っ越し、それとここに来た後に住民から聞いた、シエスタ火山へのお別れパーティーまで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あたしはこんなにもたくさんのものを見逃してきた……今のシエスタが何を求めてるのか、ぜんぜん分からないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "確かに分からないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ですが、それがどうしたと言うのです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あなたのお爺様だって、あの海辺の町にやって来たばかりの頃は何も知らなかったはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "今のあなたは、若い頃のお爺様と同じだと思いませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あなたには一つの街を知るための時間がまだたっぷりあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "本当にできるのかな……あたし、もうたくさんの時間を無駄にしてきたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "そんなに複雑に考える必要はありませんよ。ほら、行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……行くって、どこへ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "あなたが最初にやりたかったことをしに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "昼間とは違い、まもなく夜が訪れようとしている観光商店街は、工事音が少しずつ影を潜め、代わりに住民たちが集い、どこもかしこも賑やかな雰囲気に包まれていた。\nある場所を除いて――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ここは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "このお店……看板も撤去されてる。それに、この香りは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……コーヒー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "はい、ここはかつてはカフェでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "これからしばらくの間、あなたにはここで働いていただくことになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ここで？　このお店を改築するってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "でも……店主さんはどこにいるの？　改築の方向性は決まってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "改築後もカフェを続けるつもりかどうかも確認しなきゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しばしの沈黙のあと、シティホールの職員は口を開いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "店主はすでに亡くなられました。店を継ぐ者もいませんので、あなたに任せたいのは改築ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "改築じゃない？　だったら一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "解体ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "解体？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "このお店を全部取り壊しちゃうってこと？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "職員はうなずいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "そんなのダメだよ。あたしにはできない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "他にも作業員を手配してありますから、人手なら十分ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "給料に関しては……シティホールの観光商店街再建特別資金から出ることになっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "もし引き受けてくださるのでしたら、シティホールを代表して私と労働契約を正式に結ぶことになりますので、あなたの権益もきちんと保証されます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "いやいや、そうじゃなくて……だってこのお店をよく見てみてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "このテーブルに椅子、それにあっちのキャビネットも……店主さんが心を込めて手入れをしていたことが伝わってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "これを全部取り壊すなんて、もったいないよ……このお店全部が旧シエスタのステキな思い出なのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "アンマイヤーさん、あなたは「候羽」と「留羽」の話を聞いたことがありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "候羽と……留羽……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "どっちの言葉も聞き覚えがあるけど、どういう意味だっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "私がまだ小さかった頃、祖父はある羽獣たちの話を聞かせてくれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "言い伝えによると、あのビーチにはかつて古代の羽獣たちが棲んでいたそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "それって……旧シエスタがあったビーチのこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ですが、その羽獣たちが空と森を埋め尽くすようにして飛び回っていたのは、まだ旧シエスタすら存在していなかった頃のことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "それどころか、シエスタの火山もなかったのかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……火山すらなかった時代だなんて、すごく大昔の話だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "で、その羽獣がどうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "かつて、その羽獣たちは「特定の種類」として定義付けることはできませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "なぜなら、それは形態も習性も異なる様々な羽獣によって構成された複雑な群れだったからです。大地の各所から集まってきた候羽だけでも、何種類も存在していました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "初めの頃、群れはビーチ横の森に集まっていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "時折争いが起きては、去ることを選んだ羽獣もいましたが、一部はそこに残り、巣を作り共にヒナを育て始めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "そうして混ざり合い、いつの間にか本当に同類になってしまったのです。同じ木の実を食べ、同じ声でさえずり……そうして、群れはこの地で留羽となりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "私の祖父はこの話をとても気に入っていたのです。祖父の目には、古代の羽獣とシエスタが重なって見えていたのでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "その羽獣は今もどこかで見られたりするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "おそらく不可能かと……物語の最後では、数年間続いた大雨によって海水が逆流し、森が吞み込まれてしまいましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "その羽獣たちも、それ以降姿を消してしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "そうなんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……アンマイヤーさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "あっ、ううん……大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……ただの言い伝えですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "現実のシエスタは、その羽獣たちよりもずっと幸運です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "うん、そうだね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ただ「候羽」と「留羽」をどこで聞いたのか、突然思い出したの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "ねえおじい、このサワーオレンジのドレッシングの瓶には、なんて書いてあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温和な老人",
      "text": "ああ、これはな、「シエスタ」と読むのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "「シエスタ」？　「シエスタ」ってなに……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温和な老人",
      "text": "ははは、アンマイヤーは流石にもう覚えてないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温和な老人",
      "text": "「シエスタ」というのはな……まだ熟していないオレンジのことなのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温和な老人",
      "text": "……私たち候羽を留羽に変えたのが「シエスタ」なのだよ。「シエスタ」は私たちが築き上げた故郷なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い女の子",
      "text": "こうう……？　りゅうう……？　おじいの言ってること……よく分かんない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "温和な老人",
      "text": "焦ることはないさ、おチビちゃん。いつか分かる日が自然とやって来るさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "そうですか……アンマイヤーさんのお爺様も同じような話を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ごめんなさい、コスタさん……また昔のことを思い出しちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "お気持ちはよく分かります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "私自身も、今でも祖父と過ごした日々を恋しく感じていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "とはいえ、そうした色褪せぬ思い出が、私が前を向くための妨げになることはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その時、突如音楽が鳴り響き、少女はその旋律が伝わってきた方向に目を向けた。\n楽器屋の赤い扉が開かれており、薄暗いライトが大小様々なボックスを照らしている。\n店主と労働者たちは地べたに座り、ギターやハンドドラム、マラカス……それから見たこともないような現地の楽器を手にしていた。\n不意に混ざる不協和音に、皆が次々と楽器を奏でる手を止めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "ちょっと、また間違えてるわよ。今の誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "労働者",
      "text": "え？　あー、たぶん俺かも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "労働者",
      "text": "でも、うちの地元じゃ、ここの小節はこうやって弾いてたんだけどな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "それじゃあ、そこだけ他のみんなで音を合わせましょうか！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ある者はコードを変え、またある者はリズムを緩めた。労働者の鳴らす音色は先ほどのままだったが、再び鳴り響いた旋律は見事に調和していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "楽器屋女性店主",
      "text": "良い感じね。それじゃあ、もう一回よ。三、二、一……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "一同",
      "text": "縄を手繰り寄せた手にできたタコ、レンガを担いだ肩に残った灰♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "一同",
      "text": "皆で笑って乾杯を、さよならの時には歌を♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "一同",
      "text": "ここはシエスタ、我らが故郷♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "ここは……シエスタ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ええ、ここがシエスタなのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "もしもし？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "はい……アンマイヤーです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "えっ、昼間のお詫びとして、建設会社の面接を受けさせてくれるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "せっかくですけど、そのお話は辞退させていただこうと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "いえ……今日のことはあたしにも非がありましたから。本当にありがとうございます。はい、ではまた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "シティホールからの電話ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "どうして面接を断ったんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "たぶん、候羽と留羽の話が何を伝えたかったのか、やっと分かったからかな……いや、全部理解できた確信はまだないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "でも、コスタさんが言ったように、あたしがこの街を知るための時間はまだたっぷりある……だからまずは歩幅を緩めて、そのことにじっくり時間をかけてみようと思うの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "だから……解体の仕事、引き受けるよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女はホコリが積もる小さな店を見つめた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "解体は期限内に終わらせる。だから、古い家具たちを全部運び出したら、壁を塗りなおして、一回この建物を一番初めの姿に戻そうと思うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンマイヤー",
      "text": "……それが、あたしのシエスタでの初仕事だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
