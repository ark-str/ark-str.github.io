{
  "server": "jp",
  "storyId": "main_12_level_main_12-03_beg",
  "groupId": "main_12",
  "stageId": "main_12-03",
  "title": "高望みの団結",
  "storyCode": "12-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_12-03_beg.txt",
  "sourceHash": "45f5c7f22fafdfaf768d769d700e7b9bf69b5ebeef71c0a5cd51b1a389a3aabd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "随分と思い切りがいいな、ロドスのドクター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "安全な場所の位置をアレクサンドリナ殿下の端末に送っておいた。そこで指示を待て。指示の範囲を超えたいかなる行動の安全も保証することはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "端末？　いつの間に……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あなた方の中には、何人か腕の立つ者がいる。実に素晴らしいな。それが、我々の協力関係を壊す切っ掛けではなく、共通の目的を達成する力になってくれると信じているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "同意を得られるものと思うが？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それは我々だけで決めることではない。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "「グレーシルクハット」",
              "text": "もちろん、我々はゆっくりと信頼を築いていく必要がある。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "「グレーシルクハット」",
              "text": "用心深い沈黙だな、称賛に値する。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "脅迫を協力と呼ぶのはヴィクトリア人の伝統か？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "「グレーシルクハット」",
              "text": "非常に残念ながら、その通りだ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "「グレーシルクハット」",
          "text": "次の連絡を待っていてくれ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "ドクター、私はクロージャに報告に行かなければならない。ロドスの通信セキュリティを見直す必要がある。それまで無線封鎖の状態を保て。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "text": "もちろん、それに加え……ヴィクトリアにおける本艦の停泊手続きの処理もな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "イネスさん、ありがとうございます。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "こんにちは、イネス。初めましてかな？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "恐らく違うわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "記憶を一部……失っているんだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "……知ってるわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "今のあなたにとっては、初対面なのよね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "あなた本当に……記憶を失っているの？　それとも、これもあなたの計画の一部かしら。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "本当に多くのことを忘れてしまっている。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "君はどう思う？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "返答は保留するわ。Dr.{@nickname}、軽はずみな判断を下さないようにしてるの。今のあなたに感じるのは、確かに少し……変化が見られることね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "今後、私たちが共に行動する時間はたくさんあるわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "口先だけの言葉に耳を傾けるくらいなら、自分の目で確かめる方が好きよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "イネスさん、ドクターに対して……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "安心して、アーミヤ。偏見は心にしまっておくから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "ひとまずはね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "撤退がほぼ完了した！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "了解、私たちもここから退却しないと。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロッベン",
          "text": "あのロドスのサルカズが、Logosと呼ばれている方ですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "Miseryさんとしばらく共闘した経験もあるし、もうロドスの戦い方に驚くことはないだろうと思ってたけど……勘違いだったわね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロッベン",
          "text": "そうですね。あのLogosさんが何者であれ、彼の呪術のおかげで我々は大いに助かりました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "ハッ、それに彼はダーツの腕も相当だしな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "何回か勝負をさせてもらったが、あの正確さは彼の術と同じくらい恐るべきものだぞ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "……ある友が、伝授してくれた小技にすぎぬ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "スツール滑走競技においては我に敵わぬが、ことダーツに関しては……あやつも我に引けを取らなんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "ホルン女史、サルカズの部隊はすでに一時退却したと見える。急ぐとしよう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "計画では、ロドスと自救軍は補給ルートを通って輸送路の出発点、ブレントウードの町辺りまで撤退し、そこに新たなセーフハウスを設置するはずです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "そこでみんなと合流しましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "城壁の方面を突破するのが上策でしょうね。ノーポート区が切り離されて以降、サルカズは城壁を封鎖していますが、その穴を埋める区画の建設にはまだ手が回っていません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "露出している地下構造は我々にとって有利に働きます。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "どうやら、また一人古い馴染みに再会したようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "text": "そのダーツを教えてくれたご友人ですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "生憎と、異なる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "我の友垣らは、この旧知の者と違い、死して変じることなどない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "皆の者、聞くがよい。我は都市にて対処せねばならぬ些事がある。ホルン女史であればうぬらを連れてロンディニウムから撤退できよう。我が同僚Miseryも必要に応じてうぬらを支援する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "……わかりました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルン",
          "text": "総員、隠密行動を維持しつつ、私に続け。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "昔日の山の頂は、真実斯くも偲ぶべきものであろうか？　涙も血もうぬが魅入られるには値せぬぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「モリー」",
          "text": "そうしたものにさほど興味がないことは認めます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「モリー」",
          "text": "ですがもし、山の頂だけが住処を与えてくれるなら？　栄光によってのみ温かさを得られるなら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "もう十分な数のうぬを狩ったはずだと思っておったが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「モリー」",
          "text": "三十一人の「モリー」でしょう。あなたはよく頑張りましたよ、バンシー。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "それでもうぬにはしてやられた。うぬはテレシスのために自救軍を瓦解させたのだからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「モリー」",
          "text": "それが僕たちの仕事だから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "……変形者よ、ロンディニウムのタイル一つ一つをこじ開け、暗がりに潜むうぬの破片を余さず見つけ出してやろうぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "text": "うぬは変化する可能性を信じることを、今もって拒絶しておろう。それがかねてより変わらぬうぬの選択である。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "若きバンシー、君ちょっとうぬぼれすぎやしないかい？　僕たちは変化を理解し、変化の中からやってきたんだけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "でも変化って所詮は適応の手段にすぎないんだ。どんな変化も最終的な目的があるんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "サルカズが今の姿を得るよりも前から、僕たちは大地を歩いていたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "理念、信仰、主義、スローガン……歳月の洗礼を逃れられるものは一つもなかったね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "君が新鮮だと思ってる発想は、とっくに誰かが考えてたものだし、君が高尚だと思ってる道は、とっくに誰かが実践したことがあるんだよね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "でさ、その人たちは今どこにいると思う？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "だけど僕たちは、今も君の前に立ってるんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "変形者",
          "text": "これこそが一番の証拠でしょ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "バシッ！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "バシッ、ビシッ！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "ふぅ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "体力を温存して、カドール。あなた食べ過ぎ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "デルフィーンから何度もあなたの食事量について抗議されてる。今はもう前とは違うのを理解して。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "安心しろ、ベアード。状況はそこまでひどかねぇ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "あの魔族どもは見た目ほど強いわけじゃねぇ、あいつらはただオレらに不意打ちを食らわしただけだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "運輸組合のマーシャルが話をしに来たんだが、あいつらの方も団結したってよ。もっと仲間を増やせば、あんなサルカズどもなんざ敵じゃなくなるさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "前にオレらといくつかのギャングで組んで、ポリ公どもとやり合った時とおんなじさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "背後から連中を奇襲して「シュシュッ」、「バシッ」ってな具合で終わりだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "数発ぶん殴りゃノックダウンさ、超簡単だよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "サルカズの軍隊は警察じゃない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "わかってるさ、ポリ公よか手ごわいだろうよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "だがオレらは血を流すことも犠牲も恐れやしねぇ！　倒れた仲間を踏み越えて、この拳を奴らの顔面に思い切りぶち込んで──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "「スロバーノッカー」っつーこのジムの名前の通り、顎に強烈な一発をお見舞いしてやるさ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "マーシャルとシミュレーション済みだ、オレらなら絶対に勝てる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "あなたのあの、くだらない龍門ビデオ集みたいにってこと？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "真剣に言ってんだぜ。オレだって伊達にノーポート区のストリートでやってきてねぇよ。荒波渡ってきた時間はオマエにも劣らねぇ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "オレらは、自分たちのために活路を見出さなきゃならねぇんだ。昔みてぇにな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "あん時、シージの奴があっさりグラスゴーからいなくなったせいでオレらはおめおめと他人にシマを渡すことになった。で、オマエとオレでどうにかして足場をここに再建したんじゃねぇか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "今だって前と同じだ。みんなで一丸となって、準備して、あいつらをぶっ飛ばす。オレらはこれまでずっとそうしてきたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "外がどんな状況だろうが、ストリートにゃストリートのやり方ってモンがあんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "あとは、チャンスさえありゃ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "デルフィーンたちが帰ってきたようね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "ハゲ頭のペアの野郎は首を縦に振ったか？　こんな状況でも、オレらの提示した金額は相当おいしいはずだ、きっと──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "これは……血か？　どういうことだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "ペアは死にました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "サルカズか──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "い、いや、あれはサルカズじゃなかった！　クソッ、あれが何者か知らないが、俺たちがあの店に着いた時は、もう修羅場の真っ最中だったんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "奴らは殺人鬼だ！　この目で見たんだ、バールを持った奴が一人を地面に押さえつけて、そいつを──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "おえっ──ゴホゴホゴホッ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "状況は良くありません。おそらく空腹で気が立った浮浪者がペアのお店を狙ったのだと思います。あのおバカときたら、パンをショーケースに入れていましたから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "結果がどうなるかなんて、簡単に想像つくでしょうに。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "だって今現在、この封鎖されたエリアで、そういった「浮浪者」がどれくらいいると思いますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "クソったれの狂人どもめ、禁制品か何かで頭がイカれちまったか！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "……バールを持っていた人は知っています。尻尾のトリートメントクリームを売る販売員で、いつも笑顔の方でした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "何度か商品を買ったことがありますし、割引もしてくれましたよ。クリーム自体は微妙でしたけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "だけど……さっき見かけた時、彼の目は血走っていました。口からは血が流れて、バールは殴りすぎて変形していて……あれが彼だと気づかないところでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "街ではパニックが広がっています、カドール。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "運輸組合の奴も同じようなことを言ってたぜ。ちょっと臆病なら気が狂っちまうかもしれないってな。だがどうして……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "ドアを押さえて！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "わ、私が……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "ぼさっとしないで、手伝って！　カドール、ソファを持ってきて！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "バカが、オマエら死にてぇのか？　*ヴィクトリアスラング*、一体どういうつもりだよ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドアの外の音",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "失せやがれ、ここはグラスゴーのシマなんだぞ！　こちとら、まだテメェらみたいな*ヴィクトリアスラング*にどうこうされるほど落ちぶれちゃいねぇ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドアの外の音",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "ベアード、危ねぇ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "一本の消防斧がボクシングジムの分厚い扉を突き破り、鋭い刃先がベアードの毛先を掠めた。\n髪の毛が数本、はらりと落ちる。"
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "言っただろうが！　*ヴィクトリアスラング*！　ここにはな、まだグラスゴーがいるんだよ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "カドールはドアを押さえ、突き破ってきた斧の刃を両手でがっしりと掴んだ。扉の外にいた者は何度か斧を引き抜こうとしたが、それはかなわなかった。"
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "オマエが誰かは知らねぇが、とっとと消えろ！　さもなきゃこの斧をオマエの脳天に突き立ててやる！　冗談なんかじゃねぇぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドアの外の音",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "斧がまた何度か動き、ドアが数回激しく蹴られた後、外の者はとうとう諦めたのか、足音をバタバタと響かせて徐々に遠ざかっていった。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "君、手が……君の指が……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "ありがてぇことに、ジムってのは包帯にだけは事欠くことはねぇからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "ベアード、デルフィーン、もう一回全部の物資を確認するぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "オレはサンドバッグを何個か下ろして、扉を補強する。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "こ……ここの人たちは、みんな狂ってしまったのか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "彼らは……ノーポート区民はみんな善良な市民だったはずなのに……警察は？　普段は誰よりも熱心に切符を切っているだろう！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "もしオレが区画から逃げ遅れたツイてねぇポリ公だったら、今頃は武器を握りしめて家に閉じこもってるだろうな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "もう一度……運輸組合に行かなくちゃな。ここの連中はマーシャルの話なら一応は聞いてくれる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "あいつなら──普段からみんな、あいつの言葉には耳を傾ける。あいつなら何か考えがあるかもしれねぇ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "カドール",
          "text": "クソッ……クソったれめ！　サルカズがまだ外にいるってのによ、トチ狂いやがってこいつら、なんで身内同士で──",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "我々は……これからどうすればいいんだ？　カドールが言っていただろう……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "チャンスさえ来れば？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "あのさ「次期会員」さん、十五年前に発生した、ノーポート区の大火事は知ってる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "臆病な市民",
          "text": "ああ、聞いたことがある。たしか埠頭で……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "埠頭を丸ごと火の海にすることは別に難しくない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "猛暑日、木屑で満たされた倉庫、火の消え切っていない吸い殻……それだけでも十分火災は起こり得る。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "だけどそうした火は、誰にも消し止めることができない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ベアード",
          "text": "私たちは、目の前のものが燃え尽きて灰になるのを、何もできずに見てるしかない。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
