{
  "server": "jp",
  "storyId": "story_acdrop_set_1_story_1",
  "groupId": "story_acdrop_set_1",
  "stageId": null,
  "title": "壁",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_acdrop_1_1.txt",
  "sourceHash": "21aa119722d12914b31cd4f0656a39b1a5c757deba74827fd8d544b7894463aa",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おい、そこの君！　ちょっといいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "……ボク以外誰もいないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ああ、君に用があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "表の通り沿いの壁、あそこに落書きをしたのは君かい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "な、スケボーで逃げる気か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "止まりなさ――違った。待ってくれ、捕まえに来たわけじゃない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "だったら何の用だよ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "いや、その……ストリートアートコンテストに参加してみる気はないかなと思って。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "は？　冗談はよせ。今どき誰がそんな、自分から進んで街の景観を破壊するようなイベントを開くってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これを見てみろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "フライヤー？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "油断させた隙にひっ捕らえるんじゃないかって心配してるんなら、フライヤーだけここに置いておくからさ。自分で取ってくれ、な？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "アーバン……ストリート……カルチャーフェスティバルだって？　ストリートアートコンテスト、スケボーレース、ストリートダンスバトル、パルクール――高額賞金も？　それにライブ中継まで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "おいおい、これは一体どういう風の吹き回しだ？　あんたら市議会は揃って脳がショートしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "知らん。俺は雇われて宣伝してるだけで、ただの使い走りだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "嘘だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "路地裏で「君、ちょっといいかな。」で人を呼び止めて、そのまま尋問を始めるような人が、ただの使い走りのわけがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そいつは、職業病ってやつだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "自分が警官だって認めてるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警官",
      "text": "非番のな。今の俺は小遣い稼ぎをしてるただのビラ配りさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警官",
      "text": "興味があるなら、このフライヤーを持って申し込みに行くといい。ついでにそれに載ってる番号を記録してもらえば、大会中はずっと無料でミネラルウォーターが飲めるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "そんであんたもコミッションがもらえるってわけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警官",
      "text": "……お嬢ちゃん、これは覚えておけ。尋問されるのが嫌いなのは警官も同じだ。それが勤務中であろうと退勤後であろうとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "あ、いや――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警官",
      "text": "参加したくないのなら別にそれで構わないが、探偵ごっこは他所でやるんだな。俺だって金が入用じゃなければ、器物損壊がどれだけ人様に嫌われる行為か教えてやりたいところだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "（警官の肩をポンポン叩く）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "悪かったよ、しつこく聞いたりして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "申し込みたかったら、ここに書かれた場所に行って、そんでこのフライヤーを見せればいいんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警官",
      "text": "（ためらいつつもうなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "今もまだ受け付けてるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "警官",
      "text": "……オールタイムで受付中だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "以上で登録が完了しました。他に何かご不明な点はございますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "こんなコンテストをやろうだなんて、一体どこのどいつが思いついたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "そうですね――このコンテストの趣旨は、若者の思想や、若者に人気のストリートカルチャーを都市全体にアピールすることで、彼らに対する理解をより深めるよう促し……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "同時に、若者にもっと都市の建設と維持に参加してもらおうと、市議会議員のクーパー氏が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "はいはい、わかったわかった。そのクーパー議員が主催者、そういうことだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "そう理解していただいて構いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "他にまだ何かございますか？　後ろにもう一人、申し込みに来た方がいらっしゃるので、特になければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "えっと、じゃあ最後に一つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "フライヤーをくれた人に聞いたんだけど、このフライヤーを持って申し込みに来れば、これを配った人にお金が入るんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "はい、もし明日の予選にご参加いただければ、翌日には報酬がその方の口座に振り込まれます。その後、決勝に進出し優れた成績を収められれば、さらに追加の報酬を獲得できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "もしかしてコンテストの宣伝にご興味がおありで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "いや、ちょっと気になっただけで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "そうなのですね。ちなみにこちらが報酬表です。宜しければぜひ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "へぇ、誰かをコンテストに参加させるだけで、こんなにお金がもらえるなんて。そのクーパー議員って人は相当お金持ちなんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "（微笑む）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "ここでタイムアップ！　クーパー議員と各審査委員は本グループの作品の採点をお願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "採点終了まで、選手の皆さんは敷地内を自由に行動していただいて構いません！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "参加者",
      "text": "ねぇねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "ん？　ボクを呼んでるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "参加者",
      "text": "そうよ！　私はアルバ、あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "アシッドドロップ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "ふ～ん、ここに住んでるんじゃなくて、会社の出張で来てるだけなのね……なんだかついでに参加しただけのあなたが優勝しちゃいそうな気がするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "そんなことないって。そっちこそ、この黒い……えーっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "墨汁よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "そう、墨汁。で描いたモノクロのグラフィティもなかなかクールだと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "実はね、うちのお爺ちゃんが炎国人で、炎国画を描くのが趣味なのよね。それで子供の頃に教わったこともあったんだけど、私、半月で飽きちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "でも、このコンテストのために、またお爺ちゃんに教わりに行ったのね。今回は三ヶ月も猛特訓したんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "今日のコンテストのためだけに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "今日のコンテストのためだけによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "クールだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "そちらのお二人、お待ちください。これより先はパルクールの会場となります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "おっと、ごめんごめん。ここで立って観戦してもいいか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "警備員",
      "text": "会場内に入らなければ、もちろん構いません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "あれがパルクール？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "そう。この人、結構いい線行って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "バク宙？　あれって体操の動きでしょ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "頑張って、お兄さん！　いけるよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "でも彼……ただの体操選手だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "派手なひねりや宙返りをたくさんやってるけど、着地時のロールはまるでなってないからさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "ロールってそんなに重要なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "もちろん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "彼がやってるような着地の仕方じゃ、そのうち膝がイカれちゃう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "そうなんだ……うーん、そこんとこはまだ分からないな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の声",
      "text": "グレイソン選手の最終タイムは三分十七秒！　本大会新記録です！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の声",
      "text": "体操競技を引退した後、グレイソン選手は本市のパルクール協会を設立しました。彼の素晴らしい成績に敬意を表しつつ、パルクール協会により多くの若者たちが参加してくれることを期待して……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "（小声）パルクール事業に身を投じるだって？　パルクールはいつから事業になったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "なになに？　あのグレイソンって人、ズルでもしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "いや、してないな。彼はあくまでフェアな戦いをして勝ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "ただ何て言うか……そういうのはあまり、クールじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "他のとこを見に行こう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の声",
      "text": "……スケボーの選手……第七位の成績で……スケボー協会は毎週土曜の午後に……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の声",
      "text": "……に輝き……進出……ストリートダンスにおいては……より正式なストリートダンスバトル、より厳密な採点基準を……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "アシッドドロップ、あなたの言いたいことが大体わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "このストリートカルチャーフェスティバルとやらは、確かにどこかおかしいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "妙に色んな協会の宣伝ばっかりで――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の声",
      "text": "……アルバ選手……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルバ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の声",
      "text": "……アシッドドロップ選手……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アシッドドロップ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の声",
      "text": "以上の選手は決勝進出が確定となりましたので、ストリートアートコンテスト会場にお戻りください。これより出場者に向けて注意事項の説明が……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフ",
      "text": "（小声）クーパー議員、決勝進出選手が全員揃いました。",
