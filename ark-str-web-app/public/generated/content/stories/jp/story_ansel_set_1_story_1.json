{
  "server": "jp",
  "storyId": "story_ansel_set_1_story_1",
  "groupId": "story_ansel_set_1",
  "stageId": null,
  "title": "医者として",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_ansel_1_1.txt",
  "sourceHash": "b90a4418acacc0448c1a45ae34f7e6eab047a1e17603b4bd559dc42dc0922273",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "こんだけでいいのか、アンセル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "はい、行動予備隊A4の来月の任務地点がアイアンリストシティなんです。だから、このタイミングで故郷から特に何かを持ってきてもらう必要はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "それは分かってるけど……家族に手紙は届けないのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "この手紙を、友人のエンガラに届けてくれるだけで十分です。きっと彼なら。私の悩みを解決してくれるいい案を出してくれるはずですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あっ、それと、彼に渡す荷物はあの大きな包みだけですからね。小さい箱に入っているのは、あなた用の炎症止めです。虫刺されや動物の咬み傷によく効くので、ちゃんと持っていってくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "……はは、もし君の家族とばったり出くわしたりしたら、さぞや気まずいことになりそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "そんじゃ行ってくるよ。薬、ありがとな、アンセル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "よし、私も準備を終わらせないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……ふぅ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "メランサちゃん、どこにいるんですか？　視界の届く範囲にいてくれないと、援護ができません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "北東より小型鉗獣が二体、再び接近中！　カーディちゃん、今は突撃しちゃだめです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "アンセルが計画した医療支援ルートに従ってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "大丈夫！　アンセルくんに迷惑かけたりしないから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "スゥ……クンクン……見つけた！　誘引剤の匂いはあっちから漂ってきてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "メランサちゃん、鉗獣たちを操ってる猛獣使いは間違いなく北東の方向にいるよ。ひょっとしたら、あの真っ黒な採掘所の入り口に隠れてるのかも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "了解しました。ここは私に任せてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "スチュワードさんは、アンセルさんに協力して護送対象の対応をお願いできますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "さあ、横になってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "こんなところで横になれですって！？　冗談はよしてちょうだい。今は早く車に戻らないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "あの虫と鉗獣の群れが見えていないの！？　それとも、爆弾の音が聞こえていないわけ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私の仲間たちをどうか信じてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "この位置からなら、いつでも仲間に迅速な支援を提供できますし、仲間も私たちをちゃんと守ってくれます。彼らは鉄でできている車よりもずっと信頼できますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "ほ、本当でしょうね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "――うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あなたを刺したのは有毒性の鉗獣です。血流を抑え、中枢神経が取り返しのつかない損傷を受けるのを防ぐためにも、横になっていち早く処置を受ける必要があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "心配いりません。解毒用の血清はちゃんと携帯しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "そ、そう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "……分かったわ、あなたの言う通りにするわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "……だけど、本当に診断結果に間違いはないのでしょうね？　もし鉗獣の種類を見間違えてたら、ど、どう責任を取るつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "間違えるはずがありません。私はレム・ビリトンの野生生物には詳しいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "さあ、肩の力を抜いてください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "お、お医者様！　あっちのほうから、また奴らが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "アンセル、伏せて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "近くの敵は全部片付けたよ。あっちに怪我人が一人いたから、安全な位置まで運んでおいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "分かりました！　こちらの処理が終わったらすぐに向かいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "血清を打ったので、もう少しこのまま安静にしていてくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "これから、負傷した商隊のメンバーの治療に向かいます。全員の手当てが終わりましたら、予定通り皆さんを目的地まで引き続き護送します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "はあ……はあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "ありがとう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "……その若さにしては、怖いくらいの落ち着きっぷりだと、誰かから言われたことはない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いえ、私はただ自分のできることを全力で取り組んでいるだけですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる商人",
      "text": "本当に大したものよ。きっとたくさんの人を救ってきたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "アンセル、そっちはどうなってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "……何かあったのか？　急に元気がなくなったように見えるけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "――あっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "エネルギー補給剤はカバンの中に入っています。すぐに傷口の手当てをしますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "すみません、少しぼうっとしてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "ははっ、それだけ僕たちを信用してくれてるってことだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "こんなのただのかすり傷だ。手当てするまでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "それよりも……君の方こそ、ちゃんとエネルギー補給できてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "……まったく、レム・ビリトンに戻ってから、ずっと働き詰めじゃないか。昼間は任務をこなして、夜も夜勤を担当するんだって言って聞かないし、ちゃんと自分の体を労わってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "夜勤を交代してやるって、何人からも提案を受けてるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "それは、夜に働く生活リズムに慣れてしまってるからですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "さっきはただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ただ、自分が医者として、他人から感謝されるだけの働きができているのか、考えていただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私はちゃんとたくさんの人を救えているのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "メランサさん、検査結果が出ましたよ。全員しっかりと対策を行っていましたので、負傷も感染の悪化もありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "明日の朝には皆にも結果を伝えますので……って、えっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "どうして全員まだ起きてるんですか！？　早く寝てください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "特にカーディ！　明日は一緒に源石製品加工所に行く日なのを覚えていますか？　夜更かししてたら、また会議中に寝ちゃいますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "でもレム・ビリトンのヘンテコお菓子試食大会がまだ終わってないんだよっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "パパイアの葉包みパイに、タンポポと羽獣卵のフライに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "次はこれ。ハイビスカスさんが血糖値が爆上がりするから控えるように何度も注意喚起し、アンセルが真剣な顔で本当に不味いと言いつつも、こっそり自分用に買い溜めてる一品。試したい人はいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "そんなコメントを聞かされたら、断れるわけないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "アハハ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "――ほら、アイアンリストシティで買った手作りミントキャンディだよ。アンセルも食べてみて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "今日君が話していたことは、確かに難しい問題だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "もし僕が君なら、きっと同じように入るかどうか迷って、実家の前で立ち往生してたと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "「お前がうちの家業を継いでくれなかったら、後継ぎがいなくなってしまうだろ？」……伯父さんからそんなことをに言われたら、確かに返事に困ってしまうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "でも、だからといって休まずに働き続けるのは良くないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "そうですよ。そうやって自分が立派な医者であると伯父さんに証明できたとしても、今のアンセルから体調に気を付けるように言われたところで、全く説得力がありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……分かりましたよ、夜食を食べたらもう寝ることにします。本当です！　もう階段の途中で気を失って倒れるようなことは絶対にしませんから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "メランサちゃん、今回はアンセルくんのこと信じてもいいと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "そうですね……今回だけ信じてみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "分かったよ。それじゃあアンセルくん、私たちは先に戻るね！　階段で転んだらすぐに呼んで。一番下に転げ落ちる前にダッシュで駆けつけて受け止めてあげるから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "もしかしてアンセルくん、今もまだごまかしきれてると思ってるのかな？　コータスがみんな生まれつき夜型じゃないってこと、もう全員知ってるのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "まあまあ、それで夜食をモリモリ食べてくれるなら、それはそれでいいんじゃない。でないと彼の体じゃ、訓練に耐えられないだろうしね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "はあ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "――もしもし、こちらはレム・ビリトンのロドス・アイアンリストシティ事務所です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な男の声",
      "text": "えっと、そっちで働いてる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "情熱的な男の声",
      "text": "いや待った……お前アンセルだろ！　声を聞いた瞬間にすぐに気付いたぞ！　ようやく戻って来たんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……もしかして、エンガラ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "最後に話したのはいつだっけ？　うわあ、懐かしいなあ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "てっきり予定が空いてる日を手紙に書いて、トランスポーターに届けさせるのかと思ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "ははっ、電話帳にお前んとこの会社の番号が載ってたから、公衆電話からかけてみたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "どこの公衆電話？　君の家の近くにあるアニメのステッカーがいっぱいに貼られたとこ？　それとも火事騒ぎになった精錬所の入り口前のところかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "おいおい、興奮しすぎだろ。どっちも違うよ。この辺の通りはもう全部新しく整備されたんだ。そう焦らなくても、もう少ししたら案内してやるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "今すぐ飛び出していきたい気分だって、よく分かったね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "分かるに決まってんだろ、お前のことだぜ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "まあ、元気そうな声が聞けてとりあえず安心したよ。お前の会社は悪いとこじゃなさそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "覚えてるか？　二年前にお前が実習に行くってなった時、二人で調べてもその会社の情報が全然見つからなかったんだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "うん、あの時は正直すごく不安だったよ。うちの下の階の雑貨屋の番号すら電話帳に載ってるくらいだから、まさか詐欺に引っかかったんじゃないかってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "お前なあ……医学校で「青菜の缶詰に体力増加の効果はない」って学んでから、なんでもかんでも疑うようになっちまったよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "うっ、その話は勘弁してよ……何年も信じ切って青菜の缶詰を食べ続けてきたのに、本当のことを知った時にすごいショックだったんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……サッカーでも、工場でのパルクールでも、ドラム缶転がしでもなんでもいいから、小さい頃はとにかくみんなと一緒に何かして遊びたかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "何回も話したでしょう？　君のように小さい時から背が高くて、力持ちで、家の手伝いをいくらしても疲れないような体に憧れてるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "だけど実際には、みんなの後ろにくっついて少し走っただけでも、フラフラになって息が上がってしまうから、いつも端っこで眺めてることしかできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "君があの時、解説をやってくれってメガホンを手渡してくれなかったら、きっとずっと独りぼっちで端っこからみんなを眺めてるだけだったんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "前にうちの鉱区と隣の鉱区の綱引き大会を見るために、こっそり夜中にみんなで家を抜け出してスラグ堆積場に行ったこと覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "堆積場のサーチライトの眩しい光に目を細めながらも、みんな大声で応援してたっけ……僕は小さなノートを片手にカッコいいと思った掛け声や解説のセリフを必死にメモしていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "まあ、今思い返すとバカだったなーって思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あはは、ごめんごめん。手紙で何度も書いた内容なのに、実際に声を聞いたら思わずまた一人で勝手に語っちゃった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……エンガラ？　急に黙り込んで、どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "……あっ、いや、なんでもねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "まさか……具合でも悪いの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "送った薬はちゃんと決まった時間に飲んでる？　前に何度か話した鉱石病の進行度合いの判断基準も、覚えてるよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いつ会える？　病院で詳しい検査を受けられなくても、最低限の診察くらいなら僕が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "……プッ、あはははは！　そんな焦んなって、アンセル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "それより、お前の方こそ体は平気なのかよ？　なんだっけ……あのなんちゃら性貧血ってやつ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "えっ、ああ、心配いらないよ。生まれつきのものだから根本的に治すのは不可能だと判明したけど、幸い今は症状は安定しているんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "おいおい先生、俺が鉱石病にかかった時には、そんな言い方はしてなかったよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "「現時点ではまだ完全に治せないだけ」なんじゃねぇの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "うん、その通りだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "お前が自分の医術でいろんな奴を助けて、伯父さんに自分のやっていることの価値を証明したいって気持ちは分かる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "だけど、お前が最初に医者を目指したきっかけは、自分を助けるためだったんじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "あんまり自分を追い詰めんなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "エンガラ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……確かに故郷に戻ってきてから、自分の行動ひとつひとつが家族や友人に影響を与えるかもしれないと思うと、つい気負い過ぎていたのかもしれないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "そんな心配すんなって。お前はいつもみたいに、自分のできることに集中してればいいんだ。あとのことは俺らダチに任せときな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "明日の夜、一緒に夜食でも食おうぜ。じゃ、いつものも場所でな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "本当に……それでいいのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "企業代表",
      "text": "申し訳ありません。やはり、ロドスの皆様よりご提供いただいた鉱石病抑制剤にそれ相応の価値があるとは思えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業代表",
      "text": "それにご覧の通り、作業員の防護服も二本の生産ラインもどれも新しいものでして、しばらくは設備や鉱石病対策をアップグレードする予定はないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業代表",
      "text": "そちらが提案した内容はコストがかかりすぎますし、弊社には不用のものが多すぎるんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "待ってください……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業代表",
      "text": "説明はすでに何度もお伺いしました。もう結構です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "企業代表",
      "text": "本日のお話はここまでということで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "……彼女は間違っています。ここの工場が労働者に提供している薬品の入手経路は、信頼できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "でも……どうしてアンセルさんが何度も専門的な説明をしたというのに、納得してもらえなかったのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "仕方のないことですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "レム・ビリトンでは、基本的には家族で代々受け継いだ経験や、近所で聞いた話の方が信用されるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "特に医療方面についてはその傾向が強いですね。レム・ビリトンの住民を取り巻く自然環境は厳しいものですが、現地の医療水準は決して理想的とは言えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "だから「重病でない限り医者にかかる必要はない」なんて間違った認識が生まれてしまうんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "みんな軽い病気は家でなんとかしようとするんです。そのせいで、突然怪しい薬が特定の地域で広まったりすることもあるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "だから、こうなる覚悟は最初からできていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "だけど……それでも……少し残念ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "うん、だってあの会社が前向きに提携を検討してるって聞いた時のアンセルくん、すごく喜んでたもんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "準備もたくさんしてたし、物流会社を説得してまでコストを下げようと頑張ってたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そうですね。この件はすこしばかり私情も挟んでおりまして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "このようなレム・ビリトンの大きな会社には、数万人もの労働者を抱えています。もしかすると鉱石病予防を受けられる者の中に私の友人や親族もいるのかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私は自分が医者になったのは価値あることなんだと、彼らの役に立てられるんだと、証明したかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……だから、とても残念です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "大丈夫ですよ、アンセルさん……今日がダメなら、また明日話しにくればいいじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "あなたがいつもそうしているみたいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "そうだそうだ！　自分が正しいと信じていることなら、相手が納得するまで説得し続けるのがアンセルくんのやり方でしょ？　さっきだって、あの人を追いかけて話しを続けるのかと思ったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "それに、アンセルくんはもっとたくさんの人を助けたいって言ってたよね。ならそれは、私情とは違うんじゃないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私はただ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "厳粛な男性",
      "text": "アンセル、ダウニーさんの検査結果だが、なんて書いてあるのか分かるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "はい……臓器に異常な陰影があり、肺にも問題が見られます。この造影検査の結果からして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳粛な男性",
      "text": "つまりは、鉱石病にかかったってことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……はい、伯父さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳粛な男性",
      "text": "何か手立てはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "もう採掘場に行くのはやめてくださいと忠告はしたのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳粛な男性",
      "text": "誰しもがお前のように選択の余地を持ってるわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳粛な男性",
      "text": "私とてお前が正しい選択を下せるように……自分の成すべきことをきちんと選べるように願ってはいるがね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……私がこの土地を知りすぎているせいかもしれません。だからどんなに努力したって、何も成し遂げられないことが怖いのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "すみません、中学時代の友人に会う約束をしているので、皆さんは先に事務所へ戻っていてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あっ、エンガラの言った通り、ここの電話ボックスが新しくなってる……ふふっ、ニンジン色に塗り替えようとしたのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "雑貨屋の窓には、相変わらず真っ黒なオイルがこびりついてるみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そうだ、エンガラって今もサイダーが好きなのかな？　とりあえず一本買っていこう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……薬を求める人たちは、追い詰められれば結局は闇市に頼るしかないってことかな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "すみません、少しいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あなたが必要としているのは、鉱石病の治療薬ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染労働者",
      "text": "あっ、ああ……仲間が危険な状態なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染労働者",
      "text": "あそこで倒れてる奴だよ。もう起き上がれないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "労働者が指さした先には、アンセルの見知った姿があった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "っ……大丈夫だって、アンセル。ちょっと痛むだけさ。あいつが大げさすぎんだよ。\n俺のことなら心配すんなって。せっかく会えたんだから、お前が旅して回った場所の話聞かせてくれよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう騒ぐなって……大した症状じゃなきゃ、医者には行かなくてもいいって言うじゃねぇか。俺はまだマシな方だし、痛みも大したことはない。\n俺より重症の同僚はたくさんいるし、みんな奥さんや子供もいるんだ……だから、お前からもらった薬はみんなに譲ってやった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "でもよ、お前の会社の薬、すげぇよく効くらしいな。みんな褒めてたぜ、アンセル。お前は自分のやってることを誇りに思っていい。とにかく、俺は誇りに思ってるからな！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "さっきの人……アンセルくんのお友達？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "すごくひどかったよ……上着を脱がせたら、腕にも胸にも源石結晶がいっぱい生えてた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "だけど、意識ははっきりしているみたいですね。つまり、急性感染による発作ではなく、少しずつ今の状態にまで悪化していったということです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "……はあ、アンセルがなぜそんなに医者になりたがっていたのか、そしてどうして家族がそこまで反対していたのか、少し分かった気がします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "アンセルさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……検査結果が出ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "もし本人に言いづらいなら、オレたちで遠回しに伝えましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いえ……もう彼には本当のことを伝えました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "とっくに覚悟ができていたみたいです。ここの鉱区は他の場所とは違い、感染者が集まって仕事を続けているんです。だから……似たような光景を何度も目にしてきたことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……彼はここの全てにあまりにも慣れすぎてしまったんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "もし私がもっと早く様子を見に戻って来ていたら……病状の判断や薬を飲む規定を、もっと厳しく伝えられていたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "痛みの感じ方には個人差があることをもっと考慮できていたら……重病でなければ医者にかからない人々の考えを変えることができたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "レム・ビリトンの医療水準や、鉱石病への予防意識がもう少し高ければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……現在、彼の病状は中期から末期へと進行しつつあります。この段階まで来ると、私の知る限りでは、いかなる抑制手段も、もはや効果をなさないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "持って一年か、二年……それ以上引き延ばす方法はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "ごめんなさい、アンセルさん……あなたの力になりたいのに、なんて慰めの言葉をかければいいのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……いえ、謝るのは私の方です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そもそもこんな話、皆さんにするべきではありませんでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……体が弱い私はいつも周りから面倒をみてもらってばかりだったのに、どうして毎回病魔に倒れるのは他の人なのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンガラ",
      "text": "俺を引きずって無理に走るなって、アンセル。お前の方が倒れちまわねぇか心配だぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "はい、またクロスボウを改良しました。前と比べて力が強くなりましたからね。これでもっと遠くの方から君をサポートできますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "この手のアーツなら、痕跡を追えるはず……心配いらないよ、アンセル。感染が悪化したわけじゃない。ただアーツに対する理解が深まっただけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "奇襲は……私一人で十分です。フランカさんから指導を受けたこの剣も、私自身も、そう簡単に倒されたりはしません……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "その通りよ、アンセルくん。ロドスの鉱石病研究は全体を見てもかなり進んでいるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "それでも、進行した鉱石病の症状を逆行させる術は存在しない。私たちにできることはただ、死が患者を連れ去る時間を少しでも遅らせてあげることだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "もちろん、実習期間を終えたあとは外科医を希望するのなら、鉱石病と直接関わる機会は比較的に少なくなるでしょうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "だけど、同じ医者である以上、私たちのできることは似たようなものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "迫りくる死に対して、まだ今日じゃないって毎日告げることしかできないの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……僕にも……初めから選択肢なんてなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "僕にできないことがある、救えない人がいる……そんなもの、認めない。認めるものか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "「ただまだ今日じゃないだけ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "一人の医者として……今はただそう言うしかない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
