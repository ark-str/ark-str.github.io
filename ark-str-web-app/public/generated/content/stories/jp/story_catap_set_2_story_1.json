  "sourceHash": "9633a326ed6c236df852f01afc44be4bea8ee6ee59bcb7242e2e9c9caab540d3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "カジミエーシュ辺ぴな場所\nカタパルトの故郷"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "着いたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "うん、ここだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "前にこの道でお金をばらまいたんだよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "おい。この見た感じ平凡な通りを前にして、まだ言うか。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "そりゃあホントのことだからね～。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "ホントのこと？　お前が？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "アッハハハハ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "はぁ、笑わないでよ～。あたしは真剣なんだってのにさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "ホント？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ホント。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "分かった分かった、ひとまず信じるよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "で、いつロドスへ戻る？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "今日の夜には出発するよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "それだけでいいのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "一目見るだけなんだし、半日でも十分なくらいだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "ふーん。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "今が朝の七時だから……"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "それじゃあ――夕方七時ごろに、ここで待っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "オッケー。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あとでたくさんお土産を持ってくるね～。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "そういうのは、ちゃんと待ち合わせ時間まで捕まらずに逃げおおせてから言えよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "端末を忘れるなよ。いつでも通信できるようにしておくんだ。もし問題が起こったらすぐ連絡しろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "もー子供みたいに扱わないでよ。ほれ行った行った。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "ったく、雑な厄介払いしやがって。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "土産を持ってこなかったら乗せてやらないからな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "心配しなさんな、あとで地元名物のナツメを食べさせてあげる！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ふう……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "さーて！　あのクソみたいだった場所が一体どう変わったのか、見せてもらおうじゃないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "外っかわは前と変わらない雰囲気だね。でも町の中心は……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ありゃま。かなりのお金をつぎ込んだみたいだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "クソじじいなら、金貨一枚どころか、削りかすだって出さないはずだし……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "騎士だって噂の若旦那って、もしかしていい人なのかなぁ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "若旦那は本当にいいお方だ。俺たちの暮らしも以前と比べれば随分と良くなったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "およ、フェロン兄じゃん。手紙受け取ったよ～。……なんか会わない間に、ずいぶん羽振りが良さそうになってんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "まだ故郷を覚えてたようで結構なこったな、アリータ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "見たところ、お前も上手くやってるようだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "えっなにそれ。昔はめったに本名で呼んだりしなかったじゃんか。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "どーしたのよ、あたしのあだ名を忘れちゃったの？　それともよそ者扱いしようってわけ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ハイハイ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "カタパルト。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "これでご満足か？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "うむ、苦しゅうない。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "出てった頃とそんなに変わってないな、お前。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あれから何をしてたんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "んー、ちょっとした体力仕事を見つけたんだよね。キツイけど報酬はそれなりだし、いろんなとこを旅することができる感じ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あんたは？　暮らしはマシになったんじゃないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "はぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "知らなかっただろうけど、お前が出て行ってからすぐ、あの老いぼれは奪われた財宝を取り返そうと町全体をひっくり返すように探したんだよ。だけど戻ってきたのは元の四分の一にも満たなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "で、あいつは、怒った勢いで税を元の倍にしたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "そんな……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "い、今は？　今もそうなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "まさか。二、三ヶ月間だけさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "その後、なぜか大都市から調査団がやってきたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "どんないきさつがあったのかは知らないが、それ以降、あの老いぼれは二度と姿を見せなくなった。噂じゃ先祖の残した屋敷に隠居したらしい。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "新たに領主になった若旦那は、まず税金を元に戻した。それから町の発展に金を掛けてくれたんだ。それで今の状態になったのさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ふ～ん、若旦那は見込みがあるねぇ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "そうだお前、久々に帰ってきたんだから、道も分からねぇだろ？　今日は俺が町を案内してやるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "行こうぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ちょちょちょ！　待って、待ってよ～！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "どうした？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あたしがこんな堂々と町に入って大丈夫なの？　仮にも指名手配中なんだし……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "おいおい、手紙を読まなかったのか？　若旦那が着任してすぐ、あの件に関する指名手配を取り下げたんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "それホントなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "なんだ、このフェロン兄の言うことが信じられないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "なわけないじゃん、信じるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "じゃさ、さっさと案内してよ。見た感じこの町もはや迷路になってるんだし、一人で歩いたら絶対迷っちゃうよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "そういえば、今回はどのくらい居られるんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "うちの会社の船が、ちょうどこの辺りを通りかかったから、休みをもらって来ただけなんだよね。だから今日中に戻らなきゃなんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ここを出た途端、ハードワーカーになったってか？　やってんなぁ、カタパルト。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "手紙もらって、こうしてわざわざ戻ってきたじゃんか！　まったくもう。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "いいから早く案内してよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "はいはい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ほら、ここは知ってるだろ。前に俺が働いていた工場だ。今は全て建て替えられたけどな。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "エアコンまでついて、以前とは比べものにならない快適さだぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "うーん……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "フェロン兄、訊きたいことがあるんだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "なんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "昔は町の一番端の土地が穀物の畑になってたよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "そうだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "どうして今は全部葡萄になってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "そこだけじゃないぞ。若旦那は全ての農地を葡萄畑にしようと考えてるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ここは土がいいから、高品質な葡萄ができて、高値で売れるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "じゃあ主食は？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "まさか一日三食、葡萄だけ食べてるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "はっ、そんなわけないだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "葡萄で稼いだ金で、よそから食料を買えるようになったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "全部外から買ってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ああ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "都市の大商人はいろんな食材を取り扱ってる。今じゃ、ここの市場でもこれまで食べたこともない物がたくさん買えるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "お～そうだったんだ、いいじゃんいいじゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（やっぱり若旦那はじじいよりちゃんとしてるみたいだね。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（でも葡萄以外育てないってのは……もしも都市の大商人が食材の値段をつり上げたら、どうするつもりなんだろ？）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "昔は街の工場はあっちこっちに建ってたろ。若旦那はそれを一つにまとめようとしてるんだ。大型工場の建設が終わったら、若旦那の下でもっとたくさん稼げるぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（まぁいっか。場が白けそうだし、訊く必要もないよね。）"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ちょうど話題に上ったことだし、大型工場に行ってみるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "任せるよ。あたしがいた頃には、影も形もなかったところだから分かんないしね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ホント大きいなぁ。じじいの屋敷だってここまで大きくないでしょうよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "そうだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "まだ建設は終わってなくて、建てながら稼働してる状態だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "施工が完了すれば、住民全員が働けるようになる予定だぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "全……員？　ありえないでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "「働きたい人には仕事を用意する。」"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "若旦那自らが俺たちにそう言ったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "子供の頃、俺たちに大根を食わせてくれた爺さんを覚えてるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ハゲ頭の？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ああ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "元々、あそこの家は人手が充分足りていて、爺さんが畑に出る必要はなかった。だから毎日暇してたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "でも、若旦那がここの警備員の仕事を爺さんに世話してくれてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "今じゃ爺さんもやることができて、家にも金を入れられるってんで大喜びさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "へぇ～いいじゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（だけどこの環境……あまり安心して働ける場所じゃないような気が……）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ところで、若旦那は工場周辺を綺麗にしようとか考えてないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "今歩いてきた道、すっごく酸っぱい臭いがして鼻が曲がりそうだったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "工場の完成に合わせて改善するから、少しの間だけ我慢してくれって言われてるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あのじじいの息子だよ？　そいつの言うことを全部信じてるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ああ。若旦那のおかげで、みんなもここしばらくはいい暮らしができてるからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "みんな？　あんたがでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "はは、そうだな。以前に比べりゃずいぶん良くなったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "いいように道具として使われてるだけじゃないの？　裏切られるかもよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "そんな心配はいらないって。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "じゃあ具体的に説明してよ。若旦那はあんたにどんなことしてくれたのさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ここで話してたら日が暮れちまうよ。レストランで食べながら教えようか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "レストランだって？　そんな大層なものまでできたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "そうだ。安くてボリュームたっぷりで、味も悪くないぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "へぇ～。早く連れてってよ、ちょうどお腹がすいてたんだよね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ふぅ、食った食った。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "どうだ、美味いだろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ああ、うん……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（高級レストラン的な店かと思ったのに。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（ただの酒がでるファーストフードじゃん！？）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（うーん……）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（だけど昔のこの町はじじいに搾り取られて、今日食べたら明日の食事はない、なんてこともよくあったし。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（まぁファーストフードだとしても……レストランと言っていいのかもね。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（ボリュームがあって、そんなに高くもないし。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（だけどこの町……変わりすぎだよ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "若旦那って、町の中心部を全て取り壊したわけじゃないよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "いや、まあ基本的には全部取り壊したよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "このレストランができる前、ここに何があったか当ててみろよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "何だっけ……？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "噴水広場？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "違う。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "じゃあ、広場は今もあるんだよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "取り壊した。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ちぇっ、ヒントになる場所もないじゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "広場じゃないなら、そうだなぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "裁判所？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "お、近いぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "うーん……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "もしかして……？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あの場所だったりして――"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（手振りで爆発の真似をする）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "いやぁ～まさかね……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "そのまさかさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "若旦那は、町からじじいの痕跡を全て消し去ろうとしてるなぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ホントにあの屋敷まで建て替えたのかぁ～。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あれ待って、じゃあ若旦那は今どこに住んでるのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あっちの高層ビルの最上階だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あとで外に出て見れば分かるさ。あんな高層ビルはここじゃたった一つだけだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "町の金持ちと有名人は、みんなあそこに住んでるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あんたもたくさん稼いだんでしょ？　何でそこに引っ越さないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "はっ、大儲けした連中に比べれば、俺なんか全然だよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "でもお前のおかげで、俺にも蓄えはできてよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "老いぼれが幅を利かせてた頃は、その金を使わないでしっかり隠してたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "領主が若旦那に代わった後、俺はその金を元手に、ちょっとした商売を始めようと思ってた。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "いいじゃん！　あんたは小さい頃から頭が良かったし、運もいいんだから、きっとかなり儲かってるんでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "儲け？　いや……そんな簡単じゃないさ……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "元々若旦那は工場を建設するために、広い土地を整備してたんだ。俺はそのそばに店を開く準備をしていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "だけど店舗を借りた後、工場のほかのエリアが先に建設されてさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "でも金は払っちまったし、俺は歯を食いしばって店をオープンさせるしかなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "それで来てくれるのは、近所の数軒の住民だけで……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "これまで毎年赤字続きなんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "この辺の工事が始まるのはいつになることやら……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "じゃあフェロン兄は、若旦那のせいでカツカツなんじゃん。それでも持ち上げてるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "わかってねぇな。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あの騎士様が老いぼれを訪問した後に、俺たちの町でも騎士競技が導入されたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "だけど本格的に普及したのは、あの若旦那のおかげさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "今の俺たちは、試合を観戦するだけじゃなく――"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "（小声）金を稼ぐことだってできるんだぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "試合を見て……稼ぐ？　そんな都合のいい話があるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あるんだな、それが。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "（腕時計を見る）"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ちょうどいい、午後の試合がもうすぐ始まるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "お前のチケットも買ってやるよ。行こうぜ、自分の目で確かめな。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "まあいいけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（聞いた限りでは面白そうだけど。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（どーも、うさんくさい感じがするんだよなぁ。）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "座席はこの列だよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（座る）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "うわっ！　何このソファー、ふっかふか～。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "若旦那はホントにしっかりお金を掛けてるねぇ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "おうよ。この室内競技場は、若旦那が住んでるあのビルよりも大きいんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "大型工場が出来る前は、ここが町のシンボルなんだぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "広いし、おしゃれだし、居心地もいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "こんな贅沢な体験できるんだから、少しは若旦那を褒め称えなきゃだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "まあ、確かにね。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "どうして席に端末が置いてあるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "これか。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "いいかカタパルト、これこそが金儲けの秘密だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "どういうこと？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": null,
      "text": "ようこそ競技場へ！　本日の試合、解説員はこの私が務めさせていただきます。"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": null,
      "text": "まずは我々の町が誇る若きヒーローに登場してもらいましょう！　独立騎士ラズ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ラズだって！？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あいつはじじいの下で働いてたんじゃないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "一体どうしちゃったの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あの日、お前の件で何人もクビになったんだ。ラズも中の一人さ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "元々は実家に帰って農業を継ごうと思ってたらしいが、あの高貴な騎士様に出会ってから、突然「本当の騎士になる」とかなんとか言い始めてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "俺も最初は単なる気の迷いだと思ってたんだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "でもあいつは本気だったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "騎士競技が町に導入されるや、すっ飛んでいって、町で最初のプロ騎士の一人になったんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ラズは元々顔も良いし、腕も立つ。今じゃすっかり町のスターさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "だが一番重要なのは――"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あいつは勝てるってことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "けど今日のこの一戦は……分からないな……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": null,
      "text": "対する相手は、グローリーシールド工業の元装備テスター、独立騎士ストーン！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "装備テスター……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ねぇねぇ、あのストーンってやつ、見るからに手強そうだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "分かってる、そう焦るな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": null,
      "text": "さあ皆様、まもなくお手元の端末からの入力が有効となります！"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": null,
      "text": "選手に賭けるのか！　それとも支援物資を投入するのか！"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": null,
      "text": "騎士たちの運命は、いままさに、彼らに――そして、皆様の選択にかかっています！　それでは、どうぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "端末が光った……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "（しばらく端末を操作）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "何やってんの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ちょっと待って、今は話しかけないでくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ストーンが勝つ確率が高い……だが……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ラズのオッズは……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "よし、やっぱりラズに賭ける！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "（しばらく端末を操作）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ねぇそれ……五千って。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "この数字……まさか現金じゃないよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ああ。今はただの数字だ。だが競技場を出る時、端末に打ち込んだ金額から賞金を差し引いた額を支払わなきゃならない。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "そんなの、払えない人も出てくるんじゃないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "払えなけりゃ……若旦那の下で働いて返済するのさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ちょっ、あんた、自分が何してるかわかってんの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "俺はラズが勝つ方に賭けてる！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あいつが勝てば、俺はまた一儲けできるんだ。分かるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "俺は考えたんだ。確かにデータで見ると、ラズの方が旗色が悪い。だが、あいつは勝つぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "俺はあいつを信じてるさ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "もし負けたらどーすんのさ！　自分を担保にした借金なんだよ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "まあ、俺もたまに読みを外す時だってある。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "だが俺がラズの勝利に賭けた時、あいつは必ず勝つんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "あいつを信じろ、そして俺を信じるんだ。いいな！？"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": "char_282_catap",
      "text": "試合開始！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "（カタパルトに構わず、真っ直ぐ競技場を凝視する）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（フェロン兄……）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（ラズの技量と装備が、相手と比べることすらおこがましいって、ホントに理解してる？）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（かたや手練れの戦士、かたやちょっとばっかしの才能があるだけの田舎兵士なんだよ？）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（あんたの運が良いのは知ってるけど、さすがにこれじゃあ……）"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "よし！　ラズ、その調子だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（力任せに突っかかってるだけじゃん、ドーベルマン教官の前であんなことしたら鞭打ちもんだっての。）"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ほら、あいつは勝つって言ったろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "（端末に1000と入力）"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "いいぞラズ、そいつをぶちのめせ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（これでいつまで持つだろう？）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "十五分後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ラズ、どうしてそんなダサい野郎に勝てないんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "う、後ろに下がっちゃダメだ。支援物資を送ってやるから！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "（しばらく端末を操作）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（相手が反撃を始めたな……）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（待って！？）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あのよそ者、ラズを殺すつもりで戦ってるんだけど！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "こ、この試合は元々、デ、デスマッチなんだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "チッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "俺の金……お、俺の金がぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（連絡用端末を取り出す）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（小声）もしもし、聞こえる？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "char_282_catap",
      "text": "ああ。どうした？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "char_282_catap",
      "text": "いよいよ捕まったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（小声）まぁそんなとこ。迎えに来てよ。車を町の中心の競技場のそばにつけて。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（小声）生きて抜け出せる自信は？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "char_282_catap",
      "text": "……了解。俺のことより自分の心配をするんだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "char_282_catap",
      "text": "到着直前にまた連絡する。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（小声）サンキュー。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（弾薬を装填）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（武器を加圧）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ラズ、ラズ、負けるな！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "お前は死んでもいいが、俺の金はどうなる！！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "そこどいて！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（この距離から当てて、なおかつ傷つけないようにってなると……こりゃちょっと厳しいな……）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（ロックオン）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（いちかばちかだ！）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（ラズ、あんたみたいなお人好しがこんな所で死ぬ必要はない。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（受けた恩は返すよ。もうこのクソみたいな場所に、思い残すことはないしね。）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（デカブツめ、もうちょいこっちに来なさいよ！）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（トリガーに指をかける）"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（息を止め集中する）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": "char_282_catap",
      "text": "うおぉぉぉ素晴らしい一撃！！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": "char_282_catap",
      "text": "迫りくる斬撃をかいくぐっての、ラズ選手の鋭い刺突！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": "char_282_catap",
      "text": "客席を振り返っているストーン選手に、鮮やかな一撃を与えた！　相手はラズ選手をあと一歩まで追い詰めながら、何かに気を取られて、最後の瞬間によそ見をしてしまいました！！"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": "char_282_catap",
      "text": "息もつかせぬ猛攻で、ストーン選手が勝利を収めるかと思われていましたが、ラズ選手、ほんのわずかな隙を逃さなかった！"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": "char_282_catap",
      "text": "まさにお手本のような、起死回生の反撃です！"
    },
    {
      "type": "dialogue",
      "speakerName": "解説員",
      "speakerId": "char_282_catap",
      "text": "勝利を手にしたのは――独立騎士ラズ！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "えっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "か、勝ったのか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "勝った！　勝った！！　また儲かったぞ！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ほら言ったろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "俺がラズに賭けさえすれば、あいつは必ず勝つんだ。必ずだぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "ハハハハハハ！！！！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "（武器を収める）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェロン",
      "speakerId": null,
      "text": "カタパルト、おい？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "もしもし。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": "char_282_catap",
      "text": "着いたぞ。右だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "すぐ行く。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "最悪の状況は避けられたようだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "良いことも起きなかったみたいだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "カジミエーシュって他の場所もこんな感じなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "騎士競技と競技場のことを言ってるんなら――"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "そうだとしか言えんな。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "そっか。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "今って何時？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "大体、夕方の五時か六時ってとこか。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "どこかで適当に食事して、お土産を買って帰ろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "このクソみたいな場所から遠ければ遠いほどいいや。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "*カジミエーシュスラング*"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "ふーん……"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "とりあえず乗れ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "ところで、後ろから追いかけて来る奴はお前の友人か？　なんか金の入った袋を抱えてるみたいだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ちょっと付き合いがあっただけで、そんな親しい関係じゃないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "スピード上げてくれる？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "その必要はないな。あいつの持ってる袋が破れたようだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "お金を拾いに戻った？"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "（ハンドルを切る）"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "みたいだな。どうした、もう少し見たかったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "見たって何も面白くないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "あ～ぁ――お腹すいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "ご飯食べに行こうよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "今向かってる途中じゃないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "任せろ、カタパルト。調査済みだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーター",
      "speakerId": null,
      "text": "レストランはすぐそこだぜ。"
    },
    {
      "type": "sceneBreak"
    }
  ],
