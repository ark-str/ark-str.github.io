{
  "server": "jp",
  "storyId": "act19side_level_act19side_03_end",
  "groupId": "act19side",
  "stageId": "act19side_03",
  "title": "パワードスーツ",
  "storyCode": "DV-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act19side/level_act19side_03_end.txt",
  "sourceHash": "5aeb872e6cd8250df1e4bcc5162b40985e06a40246877cb054ffefbf02e3468d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "text": "この馴染み深い香り……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "text": "これが仕事中でなければな。身体に染み渡る酒の味が恋しいよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君はバーでよくマシンオイルを注文するらしいな。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Mechanist",
              "text": "……どうせブレイズから聞いたんだろう。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Mechanist",
              "text": "新しい武器のテスト中に、あいつが手加減を要求してくるのを無視している分の腹いせか。大方、自分ばかりあれこれ噂されるのが気に食わないんだろうさ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Mechanist",
              "text": "だが、実のところ「マシンオイル」というのは私の好きなスペシャルカクテルの名前なんだ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Mechanist",
              "text": "「ワン・モア・グラス」の常連なら誰でも知っていることさ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "酔っ払った君は椅子の上で詩を朗読すると聞いた。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Mechanist",
              "text": "その手の噂に興味があるなら、今度ブレイズから飲みに誘われた時は断るなよ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Mechanist",
              "text": "おそらくはLogosたちも来るだろうが――",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Mechanist",
              "text": "その時は、私の噂など記憶から吹き飛ぶような光景を目にすることができるはずだ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "ときにサリア、目当ての人物は？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "あそこだ。彼はここで毎日の二十時間を過ごしていてな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "……失礼、「トリマウンツ・サンシャイン」を二つ頼む。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "おや、君は仕事中に酒を嗜むようなタイプには見えないが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "その認識は正しい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "アルコールで脳の働きを乱されるのはどうにも慣れないのでな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "相変わらずつまらない奴だな、サリア。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "今頼んだ二杯はお前の分だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "一気に飲みきるなよ。三杯目を奢るつもりはないからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ちぇっ……なんだよ。ライン生命を離れたら、あんたも俺みたいな宿なしの貧乏人になっちまったのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "酒代としていくら払うかは、お前が提供する情報の価値次第だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "そうかい。言ってみろよ、何が知りたいんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "……この試験管を見ろ。中の液体が見えるか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "へえ、どれどれ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "言っておくが、飲み物ではないぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "だったら無駄足だったなあ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "――右手を見せろ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "……何のつもりだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "お前は右利きだが、今は左手でグラスを持っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "どれだけ小型化されていても、アーツユニットを埋め込んでいる以上今も痛みが生じるんだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "アーツユニットを……その右腕にか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "……サリア。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "この男と、そっちの顔が見えない奴は何者だ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ライン生命のエンジニア課……あるいは、ヴォルヴォート・コシンスキーか……ひょっとすると、名前を言っちゃいけないタイプの機関の人間か？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "あの連中、気が変わって俺を完全に黙らせようとしてるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "君の言及した企業や組織とは、一切関わりがないと保証しよう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "口先だけで保証されたところで、そんなものは目の前の酒ほどの価値もない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "ドクター。我々がいる限り、彼は真実を語りそうにないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "……問題なのはあんただけだ。妙な格好をしてるし、どうにも信用ならないんでね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "俺はクルビアの技術界隈のエリート様にはうんざりなんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "フードをかぶった奴は残っても構わない。あんたはなんだか安心できる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Mechanist、少し休んでいてくれ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "休憩時間と考えて、一杯飲んできたらどうだ？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "仕方がないな。近くにはいるようにする。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "なあサリア、これまで何度も奢ってくれたあんたにはちゃんと忠告しておくが――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "俺みたいになりたくなければ、それ以上の追求はよせ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "試験管の中身も、パワードスーツのことも……そしてその背後にいる連中も、あんたがちょっかい出せるようなものじゃないんだぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "そう……あんたでさえ無理なんだよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "君は、自分が何を言ったかわかっているのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "もちろん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "君が言うように、私はまだそこまでもうろくする歳でもないしね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "……まったく、言いがかりも甚だしい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "ほう、言いがかりか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "それはミュルジスの失踪が君と関係しているのではという推測のことかな？　それとも、君がライン生命統括の肩書を我が物にせんと企んでいるという推測のことかな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "私を脅すつもりなら、もっと説得力のある証拠を見つけてからにしたまえ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "まあ落ち着け、我々も長い付き合いじゃないか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "一緒に働き始めてからもうどれくらいになったかな？　君は加わるのが少し遅いほうだったが、それでも十年は経っていそうだ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "それなのに、まだ私のことを理解してくれていないのかな？　私が書類の束や通信記録、あるいは法律文書の下書きを持って旧友を訪ねてくるようなタイプに見えるかい？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "君は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "昔君にそうされたからと言って、私も同じことをやり返すとは限らないだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "クルビア人はすべてを話し合いのテーブルに載せるのが好きみたいだが……君が言ったように、私はとぼけた素振りが大好きで、とても陰険なリターニアの爺さんヤギだということを忘れないでくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "それで、一体何が目的なんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "通りがかりに古い友人を励ましてあげようと思っただけさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "理解できないな。私はてっきり……君はもっと統括に肩入れしていると思っていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "理解できることよりも、理解できないことのほうがたくさんあるというのは、研究の醍醐味の一つじゃないか。我々は皆研究者だというのに、まだその道理がわからないのかい？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "実のところ、君とクリステンはよく似ている。君たちはどちらもあまりに若く、そしてあまりに賢い人だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "――上だけを目指して一心不乱に飛ぼうとすれば、それについていく者たちはいずれ疲弊してしまう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "私はただ、もうしばらくは平穏に研究をしたいだけで、君たち共々地面に落ちるつもりはない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "仮に君がトップに立つとしたら、ライン生命は二、三年後には軍やその他の大資本によって引き裂かれるかもしれないが、今すぐバラバラになるということはないだろうしね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "まさか君が私をそこまで買ってくれているとはな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "ただ、クリステンをどうにかしたいのなら、まずは警備課の主任に対処すべきだとは思うよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "今のライン生命にそんな人物がいた覚えはないが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "おや。君はまだ若いのに、記憶力が悪いと見える。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "クリステンはまだ、サリアの辞表を承認していないじゃないか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "正直言って俺はあんたのやってることがさっぱり理解できないよ、サリア。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ローキャン……俺の元雇い主の件があってから、あの頃のことをわざわざ口に出すような奴は誰一人いなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "どんなに当時の実験を深く知っていたとしても、皆示し合わせたように無関係の体を装っていたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "それが賢いやり方ってもんだからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "その定義でいくと、お前自身も愚かだということか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ははっ……相変わらず癪に障る言い方するな、あんたは。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "簡単に逃げられるなら俺だって逃げたいよ。でも、あいつらは俺を見逃しやしない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "あんたはいつも、まだ右手は痛むのかと訊いてくるが、痛まないわけがないだろう？　それでも、この手を実験台として差し出してなければ、俺は今まで生かされてたかどうかもわからない……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "――当時、奴らが移植させたがってたものが何なのか知らなかったとはいえ……俺は……俺はろくでなしの執刀医なんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "そうして怒りをあらわにするのは珍しいな。まだお前の神経は酒に麻痺させられきってはいないと見える。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "……そう言うあんたのほうは随分変わったな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "何年か前、初めて俺を訪ねてきたときのあんたには、強い怒りが見て取れた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "そうだったか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "……まあ、表情からはわからなかったがな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "だが、俺にはその怒りを感じ取ることができたんだ。自分がどんな実験に関わっていたかを知ったとき、俺も同じように感じたから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "――なあ、サリア。ライン生命を潰すだけなら、方法はほかにいくらでもあるよな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "あんたはライン生命創設者の一人だし、あの会社を潰したがってる組織ならどこも大喜びであんたを迎え入れようとするはずだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "盲目にライン生命を狙ったところで問題は解決しない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "猛獣の屍肉は、より恐ろしい獣を養う餌となる。ローキャン水槽の崩壊はその証明だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "言い訳はよせよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "この数年ずっと、あんたはライン生命のために奔走してるんだろ。表面上は敵対してるように見えるが、実際は奴らのために後始末をしてるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "こうして会ってすぐわかったよ。例の噂は嘘じゃないってことが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "――あんた、ライン生命のために監獄にまで入ったんだろ？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "マンスフィールドでの事件のことか？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "概ね事実だが、その表現は……",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "……真実は噂通りのものではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "そうか？　ハイドブラザーズの倒産は、エネルギー課主任の頭痛の種になるはずだよな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "基礎資材のサプライヤーがなくなれば、新たな実験基地の承認が滞るケースは多い。おかげで奴は大口の受注をいくつも逃したらしいぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "どういう実験をしていたにせよ、その進行を遅らせるしかなかったのさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "最終的にハイドブラザーズを監獄送りにしたのは私ではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "いいや、あんたの功績は少なくない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "俺も道理くらいはわかってる。ハイドブラザーズが収監されたら、検察はそいつらをエサにもっと大きな鱗獣を釣ろうとするはずだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "それなのに、この件の報道にライン生命の名が出ないのは――この手の事件への関与を疑われずに済むのはなぜなのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "答えは一つ。あんたがライン生命の犯した過ちを全部片付けて回ってるからだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "そうでもなきゃ、あんたが俺を訪ねてくるわけがない……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "この試薬がライン生命に関係してるかどうかを確かめたいんだろ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "結局、あんたは今でも心の奥では警備課主任のつもりでいるのさ。ライン生命の不始末を処理することが自分の務めだ、ってな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "あの場所には、あんたにとって捨てきれない何かがあるんだろう。それが特定の人間だろうと、あるいはくだらん情だろうと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ははっ、あんたにも感情で行動することがあるってわけだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "どこまでいっても、俺たちは所詮生身の人間でしかないんだよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命研究員",
          "text": "制御不能……実験体、暴走しています！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命研究員",
          "text": "拘束器具の破損を確認！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命研究員",
          "text": "実験体の意識、検出不能……鎮静剤の注入に失敗しました！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命警備課職員",
          "text": "実験体による大規模なアーツの発動を確認！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命警備課職員",
          "text": "あれは化け物か、巨大な生き物か……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命警備課職員",
          "text": "いや、炎の化身とでもいうべきか……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命警備課職員",
          "text": "……今すぐ主任に連絡を！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "//模拟火焰烟雾"
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "なんて大きな炎なの……ごほ、ごほっ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "イフリータはどこ……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "返事をして！　イフリータ――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "っ、サリア……！？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "廊下のすべてが炎で満たされているにもかかわらず、彼女は熱さを感じなかった。\nというのも、彼女を見つめるヴイーヴルの目がその盾よりも硬く、白刃よりも冷たかったからだ。\n彼女には、その感情を読み取ることはできなかった。\nその瞳の中に見たものに――今なお、彼女は確証を持てずにいる。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "大丈夫か？　サイレンス先生。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "あ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "きっと疲れてるんだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "ここまでずっと、モル先生や俺たちの手当をしてくれてたしな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "……さっきはすまなかった。過剰反応した挙げ句、あんたを傷つけるところだった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "ロドスはライン生命とは違うんだな。あんたとグレイさんは、俺たちに見返りを求めず良くしてくれてるし……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "……あなたはそう言うけど……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私も、過ちを犯したことがないわけじゃない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私はライン生命の研究員でもあるんだ。自分で主導していた実験で危うく一区画の人全員を殺しかけたことだってあるし……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "え……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "その実験の被験者として――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私によく懐いていて、家族のように思ってくれている子供を使っていたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "その子は今……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "生きてる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "と言っても命はあるというだけ……何年も力を尽くしてきたけど、彼女を元の生活に戻してあげることはできなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私には、状況が悪化するのを止めることすらできない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "あまり自分を責めるなよ。あんたは別に、その子を傷つけたかったわけじゃないんだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "ふ……ふふっ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私自身、そんなふうに自分を慰めたことがあるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私は何も知らなかった――本当に恨むべきはほかの人たちだって。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "でも、本当にそれだけのことだったのかを考えると……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "実験の第一責任者として、当初の私は、この研究の潜在的なリスクに気付いていなかったのか？\nその答えは明らかだ。\n達成間近の革新的な偉業に目がくらんでいたか……\nあるいは、自分の実力を見誤ったかのどちらかだろう。\nそれを認めるのは、他人を恨むよりも難しいことだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "もしかすると、私が本当に許せないのは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "あんたにそんな過去があったとは思わなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "……これは単なる過去の出来事ではなくて、私がここにいる理由でもあるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "理由って……友人を助けに来たんじゃなかったのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "もちろん、ジョイスのことも理由の一つだけど、私が助けたいのは彼女だけじゃない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "あなたたちのことも、エレナのことも、ドロシーのことも救いたいんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "そのためにも、手遅れになる前に、最悪の事態を阻止したいと思ってる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サニー",
          "text": "……俺の言葉を信じてくれるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "言ったでしょう。私は真実を――この目で見たものを信じる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "さっき思い出したんだけど、前にも似たような光景を見たことがあるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サイレンス",
          "text": "私たちを追ってくるあの銀色の物体――あれは、制御を失ったアーツの産物によく似てる。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "そういえば、ベンに君宛の届け物を頼んでおいたんだが、あれは今頃君の机の上に届けられているだろうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "ベン……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "それも覚えてないのかい？　私とお茶でもしてこいと言ったのは君だそうじゃないか。あの子は大層話が長くてね、私のお茶っ葉のストックが全部飲み尽くされるかと思ったよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "……君に貸しがあった記憶はないが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "ほう？　私の源石嵌合体実験が終わったばかりの時は、そうは言っていなかったと思うが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "……あの炎魔の実験か。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "思い出してくれて嬉しいよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "あの実験の最終段階では、私の教え子が自分で調合した神経麻酔薬を使っていたんだが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "その麻酔薬は驚くほど効果があったんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "いやはや、サイレンスは本当に賢い子だよ。こうして話しているとまた彼女が恋しくなってくる……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "ともあれ、私の実験が中断されたあと、以前手に入れたデータをいくつか確かめてみたら、その結果が偶然ではないことがわかってきたのさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "データというと？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "たまにガラクタを漁っているのは、何も君だけじゃないんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "……ローキャン水槽のことか？　あれの資料はすべて……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "手続きについて君にとやかく言われる筋合いはないはずだろう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "しかし、ローキャン・ウィリアムズは本物の天才だね。彼のデータに目を通してようやく、自分の実験構想が少し回り道をしていたことに気付かされたよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "当時の私は、埋め込まれた破片のエネルギーと実験体の同調率を上げるために、彼女の細胞をより活性化させようと手を尽くしていたが――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "まさか、実験体の神経反応そのものを抑制することこそが正しいアプローチだったなんてね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "何……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "そうそう、今述べたような推測に基づいて、君の公式にいくつか変更を加えたものを届けておいたよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "私の勝手な振る舞いを許してもらえるといいんだが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "……君はつくづく狡猾な男だな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "おや、どうしたんだい？　そんな顔をして。私は君に頼まれる前に自分から贈り物をしただけなのに。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "私に対して切れる手札が一枚減ったからって、そんなに悔しがるようなことか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェルディナンド",
          "text": "……こちらの実験に役立つものでなければ承知しないぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "それはもちろん。きっと喜んでもらえると思うよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "ところで、君の思惑通りになったら、ミュルジスがくれるはずだった黒豆茶十箱は君が肩代わりしてくれるのかな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パルヴィス",
          "text": "私が公式を変更していなければ、あの賭けは私の勝ちだったはずだからね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "本題に戻ろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "この試薬だが――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "あんたが取り出したとき、においは確かめた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "俺の知ってるのと同じにおいだったよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ははっ……俺の手術台で死んだ奴らの亡霊が、戻ってくるなんてな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ただ、あれはもっと濃度が高かったし、量も多かった……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "一体誰が……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "そんなの決まってるだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ローキャン水槽の廃墟から一番多くの遺産を掘り出してきたのはどこのどいつだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "家に帰って見てみるといいさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サリア",
          "text": "……ライン生命か。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "ほらな。あんたには答えがわかってるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "「ブリキの男」にはもう会ったんだろ。俺を見つける手伝いをしたのはあいつだよな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "――「炎魔」実験最大のスポンサーは、そしてローキャン水槽に投資したのは誰だった？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "トップレベルのラボといくつも契約して、同時に同じ研究をさせられる余裕があるような奴っていうのは一体誰だと思う？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "普段なら些細な特許を巡って争い合ってるラボ同士に、研究資料を仲良く共有させるなんて、それがどんなに拒めない案件なのかを物語っているだろう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "それに……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "酔っぱらった男",
          "text": "生き残った実験体がクルビアから送り出される前に、誰の元を通っていたと思う？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
