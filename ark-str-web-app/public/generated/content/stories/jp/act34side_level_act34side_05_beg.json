{
  "server": "jp",
  "storyId": "act34side_level_act34side_05_beg",
  "groupId": "act34side",
  "stageId": "act34side_05",
  "title": "不治の運命",
  "storyCode": "BP-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act34side/level_act34side_05_beg.txt",
  "sourceHash": "2e1fab6abaf69cfc50b6f68c0d51022fb050addf5b5ba50104f416f30e64958b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "「リトル・ハンディ」",
      "text": "読み込みエラー。二度目のエラーメッセージです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リトル・ハンディ」",
      "text": "トラブルシューティングを実行しますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "アウィトゥスさん、何かお手伝いしましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "いいや、大丈夫だよ。この捨てられたリトル・ハンディを観察していただけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "捨てられたって……誰がそんなことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "まあ、それはどうだっていいんだ。それよりジョディ君、なぜここに来たんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "自分にできることを見つけたいと思って。今は明らかに差し迫った状況ですし、この都市内にもすぐさま解決すべき問題がたくさんあるはずなのに、僕はそれができていないものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "普通なら、そういう場合は展望研究所に向かって、彼らに評価を頼むといいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "だが、もし私の意見を聞きたいというなら、喜んで精一杯力を貸そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ぜひお願いします。アウィトゥスさんは学者さんとして尊敬を集めていらっしゃいますし、都市の人も大勢があなたを先生とお呼びしているくらいですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "先生だなんて。私が最後に出版した『生活の死』は、人々に何を教えることもできない本なのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "そ、その本なら僕も読みました。ただ、用語が難解すぎて内容がよくわからなくて。宇宙船だとか、スターゲートだとか、まるで遥か遠い空の上から来た読み物みたいで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "「遥か遠い空の上から」か。ははっ、その表現は実際正しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "だが、私は本当に、先生と呼ばれるほどの人間じゃないんだ。私自身もしばしば迷いを抱えているくらいだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "この間、血の繋がりなど重要ではないと言ったことは覚えているかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "はい。ですが、僕はもう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "あの時の言い方は、少し誤解を招きかねないと後から思ってね。確かに我々は血の繋がりをあまり気にはしないが、「繋がり」という着眼点自体はいいと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "迷える時、人は自分と現実との繋がりを頼りにして、生活や理想の方向性を探るべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "でなければ私のように、長らく自分の存在価値に対する疑念に囚われることになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "アウィトゥスさんにとっての「繋がり」のこと、よろしければ教えていただけますか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "「知己」の話か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "知己……ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "同じ志を持ち、心と思想を豊かにしてくれる人のことだよ。私は、エーギルと、この国のために行われるすべてを愛するように、彼女を愛している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "先史文明が残したおびただしい数の史料や、見たこともない文字、そして難解な文法……そうしたものを少しずつ解読して、エーギルの文字にする過程を、私は楽しく思うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "彼女とは、そんな過程の中で出会った。仕事に打ち込む彼女の姿は今でもよく覚えている……会話が盛り上がると、彼女の眉は踊るように動くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "そんなことを伝えて褒めたら、彼女は興味を持ったようで、身体芸術研究所の人を訪ねて、眉毛でダンスを成立させる方法を聞いていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "変わった芸術に聞こえますけど……上手くいきましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "厳密に言うと、上手くはいかなかった。だが、そこからヒントを得て、身体芸術研究所の人はその後、頭でイメージするだけで頭髪をひとりでに踊らせる技術を開発していたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "我々は、海のすべてを沈黙させたあの災いを経験しようとも、シーボーンがエーギルの存続における脅威となろうとも、科学と芸術の探究を、未来への想像を諦めはしなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "エネルギーをマントルから汲み上げるマグマの誘導橋や、海流を噴水に変える水脈ハブ、海淵の最深部を照らす人工太陽、不毛の海底を生命で満たす生態基地……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "我々は、すでに失われた先史人類のものを一つ一つ、人智を超えたメガストラクチャーに変えようと努力してきた。一瞬のひらめきだけで、多くの物事の誕生を促すことができるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "しかし、百五十年という時間はあまりに短すぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "百五十年というと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "エーギルの平均寿命だよ。たったのそれだけしかないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "「たったの」……ですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "危機の迫った時代であるほど、我々の創造には価値が生まれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "私と彼女は、自分たちが充実した歳月を過ごし、未練を残すことなく命を終えて、文明の火種を継承していくことだろうと固く信じていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "そして、自分たちなら公共養育所よりも上手に子育てができると信じて、教育計画まで立てていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "保育室で子供が生まれたら、自分たちの手で育てたいと思った。あの子には躍動する心と生き生きとした精神に、さらなる創造力を持つ次世代の人となってほしかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "自ら子育てをするのは確かに珍しいことだが、我々の人生はこれほど充実しているのだから、自分たちが大切にしている価値観を直接伝えたいと、そう思っていたのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "でしたら、その「知己」は今どちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "死んだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "『生活の死』の元になった、あの先史人類は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "場所も知れない避難所に縮こまり、大地へと迫りくる空を来る日も来る日も見つめていた。彼はすでに、自らの結末を予感していたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "さらにいえば、静かにその訪れを迎える以外、彼にできることなどなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ですが、それは僕たちとはかけ離れた人の生活ですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "本当にかけ離れていると言えるだろうか？　我々は今まさに、彼の経験したような出来事の中にいるんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "五十年、あるいは百年もすれば、この広大な海の中、澄んだ海水は一滴も見つからなくなっているかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "知らず知らずのうちに、シーボーンが海を取り込む速度は我々が創造をする速度を超え、かつて我々が誇っていたすべては飲み込まれて、生き延びること、「生存」だけが唯一の課題になっていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "私は、知己たる人が失望に飲まれていくのを見ていた。彼女はある日、ごく冷静に、子供の養育計画を断念したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "結局、これまで継承してきたすべてが滅びる定めにある、そんな時代が来ているわけだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "五年前、アビサルハンターたちは「ファーストボーン」の巣穴へと向かい、誰一人生きては帰ってこなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "その後すぐ、彼女が病気にかかり、鬱々としたまま最期を迎えた。私たちの子供は保育室で無事に生まれたが、私はその子を公共養育所に送ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "私が自らの存在意義を疑い始めたのはそれからだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "すまない、ジョディ君。本来なら君を導いてあげたいんだが、私と現実世界の繋がりはすでに断ち切られてしまっているんだ。けれども君は、まだ誰か、あるいは何かとの繋がりを持っているだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "僕は、ブレオガンのことを追うのはもう諦めたところなんです。追いつけない影を追って、時間を浪費するわけにもいきませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "もしかしたら……もしかしたら、僕がブレオガンの遺した手記を研究して、彼の技術を学んできたのは、自分が彼の子孫かもしれないというだけの理由ではないんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "……それは、君にその分野の才能と、理想があるからでもあるのだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "何かしたいというのなら、ビーコン塔に行ってみるのはどうかな。ブレオガンはあれの再構築工事に携わっていたから、彼の技術を学んだ君にも、何かできることがあるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アウィトゥス",
      "text": "エーギル人というのは皆、自らの著作や理論、技術にちょっとしたオリジナリティを加えるものなんだ。時としてそれは、その人をよく知る人間にしか解読できないものにもなりうる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョディ",
      "text": "ありがとうございます、アウィトゥスさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "ブランドゥス顧問、大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "ああ、もちろんだとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "あの深海教徒たちには、狩人たちの手術を止めることはできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "小官は貴殿の体調について伺っているのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "ありがとう、セクンダ。やはり君は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "貴殿の、医療援助に対する不可解な抵抗を考慮すれば、誰かが進んで貴殿の安否を確かめねばならないというだけのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "その健康状態を見るに、小官が来る前にも、貴殿を病院に行かせようとした人間は大勢いたでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "航路計画の負担が大きすぎるせいかもしれないな。だが、私とて半分医者のようなものだし、計画の進捗に後れを出さない程度に健康を維持する方法くらいは心得ているさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "しかし、深海教徒が殺人に用いたあの植物は一度君も見ておくべきだと思うね。生態芸術創作所に、あんなものを用いて絵を描く人間がいるとはなかなか思えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "それよりも、無事であった以上、貴殿には重ねて調査にご協力いただけたらと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "つい先ほど、ウルピアヌスに出会いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "……どうやら貴殿も、彼を見かけたようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "闘智場で、ほんの一瞬見ただけだがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "ですが、それを誰にも報告なさらなかったでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "群衆の中に見覚えのある人をちらりと見かけるくらい、報告書を出すほどのことでもないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "これは冗談では済まないのですよ、顧問。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "データエンジニアの失踪事件はすでに、深海教徒が主導した殺人事件であることが立証されました。この件は、奴らによる研究所襲撃にも関係してるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "加えて、ウルピアヌスはデータエンジニアの件に詳しく、エーギルに対する不信感をあらわにまでしていたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "彼はいつもそうなんだ。多くを語らず行動するその背後には理由がある。人には明かしたくない理由がな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "彼の独特な行動方式だけで、その嫌疑のすべてに説明を付けることはできません。深海教会の主導した事件に関わっているか否かを確かめなければ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "はぁ……セクンダ、本当はもっと明らかに怪しい容疑者や、調査に値するターゲットがいるんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "それとも、また一時的な感情でウルピアヌスに執着しているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "やれやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "あの当時、君の申請を却下したのは私なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "今何と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "君が提出したアビサルハンターへの改造申請を却下したのは私だ、と言ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "ウルピアヌスも同じ考えだったが、手続き上この決定を下したのが私であることに変わりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "……なぜですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "展望研究所で君の資料を見た。希望欄には「遺伝子研究」と書いていただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "もう一つのファイルをご覧になれば、改造手術を受けることも小官の希望通りであるとご理解いただけたはずですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "アビサルハンター計画の参加者の中でも、君は特異な才能の持ち主だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "当時の技術討論において、ウルピアヌスに十回連続で質問したうえで、すべてに回答を得られた研究員は君しかいない。あれは「新人研究員の最高記録」だったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "初期の改造技術は安全性と信頼性が不十分で、我々はより優れた嵌合手段を模索し続けていた。最終的に、その技術の進歩を後押ししたのは君の理論だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "当時は、それを光栄に思っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "だが、この計画自体が誇るべきものではないのだよ、セクンダ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "アビサルハンターという概念は、人々が一般的な認識を持つよりもずっと昔、二百年ほど前に誕生したんだ。しかしそれが実行に移されたのは、二十数年前、ウルピアヌスの手によってのことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "それまでの百年余り、「アビサルハンター」という概念は体系的な精査や研究をなされることなく、終わりなき議論が繰り返されるのみだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "人類を救うために同胞を犠牲にし、人間の体内に異種族の血肉を組み込むなど、エーギルの根底を覆すことにほかならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "だがウルピアヌスは決然とその実行を主張した。彼は、自らの研究も、理想も、感情も、そして人間性さえも、「エーギルの利益」という唯一の原則のためなら、躊躇なく捨てられたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "彼ならば本当にエーギルを救えるかもしれないが、エーギルという国は道義にもとる犠牲の上に立つべきではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "ウルピアヌスは、誰より深く理解していたよ。自分が存在すること自体が、エーギルにとっては悲しいことなのだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "ゆえにこう言っていた。「アビサルハンターに第二のウルピアヌスはいらない。エーギルから俺と同じ人間を出してはいけない。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "「このエーギルという国においては、誰であれ別の誰かになりたいなどと思うべきではない。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "……あの人が、それをどんなふうに口にしたかは想像がつきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "私は彼に「セクンダが私の生徒ならどんなに良かったか」と冗談を言ったことがある。君ならば我々の「エーギル細胞発展史」を継いでいたかもしれないし、新たな分野を開拓していたかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "そうなれば君は、現代において最も優秀な科学者の一人となって、万物の始まりの謎を探求し、我々の未来を導く機会すら得ていたのだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "どういった立場で、他人の未来を語っておられるのでしょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "すまない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "急に長々と昔話をしてきたのは、ウルピアヌスを恨むなと伝えるためですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "彼の問題を再検討してもらうためだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "ウルピアヌスの捕縛を急いだところで、彼にとっても、君にとっても、いいことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "それよりも、今はあの深海教徒たちを尋問すべきだろう。自分の責務を忘れるな、セクンダ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "奴らはどこに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "一階だ。設備管理室の中にいる。案内しようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セクンダ",
      "text": "場所は把握しています。海巡隊が犯人護送の責を負いましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "すまない、それ以上は進まないでいただけるかな。ここは今――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "待てよ……この間、評議の場であなたを見たように思うが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブランドゥス",
      "text": "そうだ、あなたは陸から来た使節だな。失礼ながら、使節団の中でどういった役割を担っておられるかを伺っても？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "発見した時にはすでに、あのデータエンジニアは完全なシーボーンになりかけていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "そのため、このデータが「航路」と「ビーコン」に関係しているのだろうということ以外、彼女の口から有力な情報を得ることはできなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "データを解析したところ、今も都市内にあるビーコンと、シーボーンの巣穴に投下済みのビーコンとの間に、異常な交信の痕跡が見られた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "発信源は都市内の複数個所にわたっている。ポートターミナルと、関与している可能性のある船はいずれも調べておいた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "……そうして最後に残ったのがここだ。C-22研究所。最初期のアビサルハンター実験基地の一つだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君の良く知る場所だろう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "だが、ここは今、記憶の中のどんな日よりも騒々しい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "そのうえ、セクンダがブランドゥスを保護するという名目で駐屯部隊を配置している。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "面倒なことだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "必要なら、注意を引くことはできる。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "海巡隊の巡回に対処するだけなら、俺一人でも可能だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "お前には、一番厄介な奴への対処を頼むべきだろうな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "あなたは……ロドスのドクターかな？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ご覧の通り。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "正真正銘のな。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "あなたの所属している機関が、狩人たちの鉱石病関係の診療をしてくれたと聞いている。今度は、彼女たちの身体のメンテナンス手術も手伝いたいというご意向かな？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "まさしく。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "裏表なく、その通りだ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "ならば、安心してここを離れてくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "深海教会の襲撃は些細なアクシデントだ。狩人たちは今や、再び休眠に入っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "身体状況は、全工程において私が監視している。それに、あなたがここにいてくれても、その眼差しがどれほど愛情深いものであっても、それが彼女たちの実質的な助けとなることはないからな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "狩人たちの話に嘘はなかったようだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "センスが壊滅的な研究員というのはあなたのことだな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "……彼女たちが陸を彷徨う間に、あなたと深い友情を結ぶに至ったことはよくわかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "だが、それをどれだけ強調されても、この手術においてあなたにできることは何もない、という事実は変わらないのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "失礼な言い方をして申し訳ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "つい先ほども、ここで襲撃事件が起きたばかりなのでね。あなたの身の安全のためにも、お帰りいただけないだろうか。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ブランドゥスはそう言うと、それ以上あなたに構うことなく、視線を前方のホログラムへと戻した。\nそこに映った複数の映像を通して、あなたはグレイディーア、スカジ、ローレンティーナの姿をはっきりと見た。狩人たちは透明なゾルの中で深く眠っている。\nあなたにはまだ、エーギルの記号システムを完全に習得することはできておらず、ここ数日模索してみてはいたものの、映像の中の記号は半分ほどしか読み解くことができなかった。\nだがあなたは、それよりも注目すべき現象に気が付いた。\nブランドゥスが一つの映像を選ぶごとに、映し出されたその場所から小さな通知音が聞こえるのだ。\nつまり、どの映像を見るかを選択するたび、そこを映している観測ユニットが、その場で通知音を発しているということだ。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "この映像の表示順切り替えを手伝ってもいいだろうか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "ああ、もちろん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "あなたがそうまでして帰りたくないと仰るなら、私も無理に追い出すわけにはいかないな。本気で狩人たちを気にかけてくれる人には好感が持てる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "リトル・ハンディ。ドクターはまだエーギルの設備に慣れていないんだ。操作をサポートして差し上げろ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「リトル・ハンディ」",
          "text": "了解しました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "触れてはならないものに触れないのなら、手伝ってもらっても――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "廊下の観測ユニットが通知音を発したな。誰かがこの場を監視しているということだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "続けて前方の実験室、そしてその先の曲がり角か……ほう。どうやらパターンがあるようだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "中央制御室の中で、ホログラム映像の表示順を高速で切り替えている人間がいるのだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "……ドクターが何かを伝えようとしているのか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ならば、こちらへ進むとしよう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "これで手術は完了だ。ドクター、あなたの……慌ただしい協力に感謝を。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "狩人たちが目を覚ますにはあと10分ほどかかるだろう。だが、手術はとても順調に進んだということは確かだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "あなたもこれで、安心してここを離れられ――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "随分とよく眠っているな、狩人たちは。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "あなた方がどれほど力を尽くしても、彼女たちは陸で本当の休息を取ることはできていない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "そして今も、故郷に戻ったばかりだというのに、また前線へと赴かねばならないんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "一度の手術、一度の休眠では、彼女たちの体力を回復するには足りなすぎる。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "あなたはベストを尽くしたのだろう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "職務は果たしているかもしれないが、ベストを尽くしたとは言えない。この二つは本質的に違うものだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "あなたは、鉱石病の専門家だそうだな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "鉱石病にかかるというのは、どういったことなのかを教えていただけないだろうか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "患者はその余生で運命の重圧と戦わねばならない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "「運命」？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "人や物事に定められた傾向と結末のことだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "興味深いな。古の先哲は、いわゆる「運命」という概念について議論していたものだが、その言葉に再び言及する者は長い間存在しなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "ご覧の通り、海には鉱石病が存在せず、ほかの病気もほとんどは治療可能なものでね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "我々の人生の道は我々が選び、我々の文明の行く末は我々自身が決定づけるものというのが当然なんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "ゆえに長きにわたって、我々は「定め」の何たるかを忘れていた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "しかし今、狩人たちの血に刻まれた不治の病は、私の手を以てしても医学的な手段によって根絶することはできなくなっている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "あなたの言う概念を拝借するなら、この病は「運命」と呼べるのかもしれないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "狩人たちには本来、自らの理想と、人生があった。だが今では、彼女たちはその身が亡びるまで殺戮と共に在らねばならない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "私はこれまで、多くの方法を試してきたが、狩人たちをこの残酷な破滅への道から抜け出させることはできなかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "今でも……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "グレイディーアが目を覚ました。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "ローレンティーナが目を覚ました。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "スカジが目を覚ました。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "慌ただしく行ってしまったな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "……では、私ももう行こう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブランドゥス",
          "text": "お話しできて光栄だった。機会さえあれば、狩人たちのことをこれからもよく気遣ってやってもらえると有難い。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
