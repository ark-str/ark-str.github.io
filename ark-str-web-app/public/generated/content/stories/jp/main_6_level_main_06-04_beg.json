{
  "server": "jp",
  "storyId": "main_6_level_main_06-04_beg",
  "groupId": "main_6",
  "stageId": "main_06-04",
  "title": "化膿した傷跡",
  "storyCode": "6-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_06-04_beg.txt",
  "sourceHash": "20246fc4e1e40854c30b939f19d6540137a1c8efaea8dd10d201fc91f8dc6eac",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "早く！　早く撤退だ！　あの感染者たちはもう完全に化け物になっている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "うわあ！！　噛まれた、噛みつかれてる！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "アアアア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "ア、アアアアアアア！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "（恐ろしい叫び声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……何でこんなことに……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あの白髪のガキンチョだね！！　今度は何をしたっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ドクター、早く！　さっさと目標ポイントへ向かってアーミヤと合流するよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "これだけの化け物、少数でバラバラの火力小隊じゃどうにもならないから、臨機応変に動かないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "こんな時に近衛局をサポートしようなんて考えちゃダメだよ、私たちの立場の方がよっぽど苦しいんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ひとまず近衛局への援護は必要最低限に留めよう。今は私たちの安全しか保証できないから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ダメだ、この攻撃は凌ぎきれそうにない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "撤退だ！　これ以上粘ったら、俺たちは全滅だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "慌てなくていいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ああ！？　誰だ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "その格好……まさかあなたは……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "援軍はもうすぐ駆けつけます。ここはもう少しだけ、持ち堪えてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "まずは二つに分隊し、彼らの両脇に移動してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ですが、我々は……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私を信じてもらえればと。直接手は出せませんが、これくらいならいいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "挟撃の後、両脇から敵を抑えてください。残りは援軍に任せておけば問題ありませんから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "ぐ、ぐあっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……ありがとうございます、上官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "もし、あの攻撃を受け止めていただけなければ……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "後ろだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "は、反撃だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "無駄だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "部隊を集合させ、防御を固めろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "了解しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "いや、ですがそれでは……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ダメです。この場所の状況では、防御に回っていてもどうにもなりません。どうにか活路を見出さなければ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "そうだ、上です！　階段を上がって、建物の中の通路を利用して反撃に出るんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……いや、それでもやはり防御に回るしかなさそうです。ですが上に行けば、少なくともこの化け物たちに袋小路に追い詰められることはなくなります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ええ、まずは上に移動して出入り口に集まって、それから部隊を集めて防御態勢を築くんです！　全員、早く行動に移るぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "悪くない。評価点を追加だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "上官、我々と共に上へ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君たちだけで行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は地上から行く。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "なんて激しい攻撃だ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ダメです。我々の装備はどれも刺突型の武器です、奴らにはほとんど効きません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "下がるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "我々の後ろは避難区画だ！　もし奴らの侵入を許せば、市民たちも一巻の終わりだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ではどうすれば！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "戦うだけだ！　近衛局の最後の一人が倒れるまでな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "敵が投げてくる源石には気をつけろ、装備を腐食させる以外に、爆発するものもある！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "あっ……！　ジョンが怪我を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "おい、ジョン、下がれ！　お前、受け止めろ！　奴らに防衛線を跨がせるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "ぐう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "うわああ！　つ、捕まった、噛み付か、いや、ぐわあああ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "おい！　イー、しっかりしろ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "情けない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "縦貫白雷正法（じゅうかんびゃくらいせいほう）、行け！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "ぐっ、ぐぅ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "電撃系のアーツ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "な、なんだと……一瞬であの凶暴な化け物たちを消し去った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "はぁっ、はぁっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたがたがそんな様子で、どうやって市民を守るつもりですか？　私は手を出さないと言ったはずなのに……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "結局私に手を出させるなんて、情けないとはこのことです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "監察官様……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "口を開けば監察官様ですか。私を存在しないものとして扱えと警告したはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "……いえ、ですがあなたが……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "熱意のある方々だと評価していましたが、何もできずに混乱してドタバタするだけとは何事ですか！　そんな様子で他に一体何ができると言うのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "行きますよ！　次の目的地に！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "ですがあなたは先程……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "早く道を教えなさい！　私が手伝ってあげているのです、何をダラダラしているんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "それと、もう一つ。先程ですが、私は何もしていません。くれぐれも間違わないように。いいですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "承知いたしました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "ですがもし市民が少しでも損害を負うような事があれば、あなたがたの首は皆飛びますし、私も辞職せざるを得ません。ええ、全員失業ですからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "わ、わかりました……尽力致します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "わかればよろしい！　そこで突っ立って何をしているのですか？　行きますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "……そういえば、あの黒装束たちはお知り合いで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "黒装束？　なんですかそれは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "監察官",
      "text": "見ていないのですか！？　屋上にいた、あの黒い装束を着た人たちのことですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊長",
      "text": "……申し訳ありません監察官様、何のことを仰っているのですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "防衛隊、前へ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "偵察隊、下がれ！　火力点を死守せよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "この突然変異した感染者、電波妨害までできるのか？　このままだと偵察隊も危険だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……クッ、止められない！　もう保たないわ！　アンタさっき一人であれだけ倒したでしょ？　もう一度実演してくれないかしら！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "状況が違う！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "はぁ？　大事な時に使えないゴロツキ龍ね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だったら、まずはお前が実演して見せてみろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ドローン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なにっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "チェン隊長が言ってるわ！！！　偵察隊！！！　下がれ！！！　火力点を死守せよ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "どうよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "どうだって聞いてんのよ！　火力小隊、一斉掃射！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なんだって？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前のバカデカイ声のせいで、耳鳴りがして聞こえないんだ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それより、お前のそのデカイ声でβ号源石発信機を所持している通信小隊に各部隊へ通達を出すように伝えろ。「敵は強大、戦線の維持を第一とし極力死傷者を減らせ。火力は惜しむな！」と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "あんたって、ほんっとーに*スラング*ね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "おい、今言った言葉、口が読めたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "（*龍門スラング*の口パク）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "チェン隊長！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なんだ！　聞こえない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "チェン隊長！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "（ひっきりなしに響く咆哮）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "もっと大きな声で言え！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "チェン隊長！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局守衛",
      "text": "グレネードを使え！　早く！　グレネードを撃て！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "静かになったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "チェン隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ、今なら聞こえる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どうした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "客人が……いらっしゃっているようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "もう来たのか？　どうやらそのまま我々の小隊に混ざり込んだようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "まぁ想定通りだな。彼らが手放しに全てを近衛局にやらせるはずもないだろうしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "問題ない、計画は一切変更なし。彼らに龍門の実力を見せてやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "更にもう一つ情報があります。とはいえ……その正確性は保証できませんが……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "言ってみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "全身に黒ずくめの装束をまとった不審な者たちを目撃した隊員がいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "レユニオンの増援か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "いえ、どちらかと言えばその逆です。レユニオンと彼らが交戦した痕跡が見つかっています。しかも……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "しかも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "しかも……交戦したとみられるレユニオンたちは、どれも悲惨な死に方で……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "一体何の都市伝説だ。こんな非常事態に黒装束を着て龍門を跋扈する者たちだと……？　それを目撃したと言っている者たちの精神状態を確かめねば……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いや待て、黒装束……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "これは……何？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "第十二区クリア。感染者は全て抹殺した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "第三隊、第四隊は引き続き行動中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "次のエリアへ向かう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "ぐうっ……ぐうっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "家畜",
      "text": "（奇怪な鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ど、どうして！　どうして同胞に攻撃するんだ、目を醒ませ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "だ、ダメだ！　早く、早く逃げろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前たちは先に行け、こいつらに捕まるな！　早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "想定外の目標を確認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "逃走中の感染者群、第十三区と第六区との境目エリアで発見。数は計四十四人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "完了所要時間、五分以内。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "行動開始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "あ……あ……た、助けてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "待ってくれ！　投降する！　俺たちは投降——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "………………。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレースロート",
      "text": "うう……ダメ、いや……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
