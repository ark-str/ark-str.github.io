{
  "server": "jp",
  "storyId": "story_lava2_set_1_story_1",
  "groupId": "story_lava2_set_1",
  "stageId": null,
  "title": "誰しも同じ",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_lava2_1_1.txt",
  "sourceHash": "18bc1d50b08f4e08ba941ca7630ddecf191f0dd5c0465fc5d85ec624ebe64ee2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ラヴァちゃん、チリパウダーは見つかった？　そろそろお肉を漬けておかないと、晩御飯に間に合わなくなっちゃう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "急かすなって、二人が戻ってくるまでに仕上がればいいんだろ。それにしてもあいつらの荷物、なんでこんなに多いんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ハープ？　父さんと母さん、音楽できたっけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "親友のバロックさんのものらしいよ。戦争が始まってから、バロックさんとは連絡が取れなくなったみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……うわ、アタシたちのガキの頃の宿題ノートまである！　捨てればいいのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ダメだよ、私たち二人がずっと家にいないから、お母さんはいつもこれを読み返してるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "こんなもん読み返してどうすんだよ、二度と帰ってこないわけでもないのに……それと、この山ほどあるアルバムは何だよ！　くっ、重い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "これ……全部父さんと母さんがロンディニウムで働いてた頃の写真か？　知らない奴ばかりだな……服装を見る限り、二人の同僚か。どれも綺麗に保存されてるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "その下は、全部手紙か。ったく、何度も引っ越したんだから、こういうものはさっさと捨てろって……だからごちゃごちゃしてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "だって、これはお父さんとお母さんの人生の積み重ねそのものだもん……今日明日で整理できるものじゃないよ。そんな簡単に自分の人生を整理できる人間なんて、そうそういないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "それに二人とも、昼間は働かないといけないし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ここにもない、こっちもないな……棚の上か？　あれ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……なあハイビス。見ろよ、これ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "新聞の求人広告……？　タイピスト、庭師、保育士……全部にバツがついてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "二人とも、元々はエンジニアだったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "こんなにしてまでヴィクトリアに住みたいのかよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ここから離れちゃったら、行く場所なんてないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ラヴァちゃん、新聞紙を元に戻して。二人の前ではこの話をしちゃダメだよ。私たちは……私たちにできることをしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……チリパウダーが見つかんねぇ。近所の人に借りてくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "待って――もう、気が立ったまま飛び出して行っちゃった……ご近所さんと喧嘩しないようにって注意しそびれちゃったな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "こんにちは、東の一番端の家に住んでる者です。ちょっとお借りしたいものが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人A",
      "text": "えっと……悪いけど、ないわ。ごめんなさいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（最後まで聞くのも嫌ってわけか……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "すみません、チリパウダーをお借りしたいんですが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドアは、ぴしゃりと閉じられてしまった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（都市よりもサルカズに寛容……ねえ？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "すみません、東の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "知ってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "えっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一人の好奇心旺盛な子供が母親の背から顔を出し、こっそり訪れたサルカズの少女を盗み見ていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "イルサ、部屋に戻りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "実は引っ越してきたばかりで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "だから、知ってるわ。近所の家のドアを叩いて回っていたものね。何か用かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "姉が料理をしてるんですが、チリパウダーが見つからなくて。お借りしていいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "……そんなことだったの。そこで少し待ってて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドアは閉じた直後、また静かに開いた。好奇心に満ちた小さな顔がそこから覗いており、ラヴァを――正確にはラヴァの頭の角をじっと見つめている。\n子供は緊張しているのか唾を飲み込んで、かなり迷った後、ラヴァへ手を伸ばした。\nここまでの道すがら、ラヴァはこのような視線にすっかり慣れており、動かずその場に立っていた。女の子の小さな指がゆっくりと近づき、ラヴァの服のすそに触れた。"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心旺盛な子供",
      "text": "わあ――本物の服だ、巫術で出したものじゃないんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "はあ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "イルサ！　こっちに来なさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "母親は手に持っていたものを放り出し、駆け寄って子供を背後にかばった。その顔からは冷静さが消え失せていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "隣人B",
      "text": "うちにあなたが欲しいものなんてないわ。帰ってちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ガサゴソと、イルサと呼ばれた少女は屋根裏部屋の窓から外に這い出て、興奮気味に友人たちに暗号を送った。ほどなくして村の人々は足を止め、遠くから目に入る奇妙な光景を眺めていた――\n嫌われ者のサルカズが不機嫌な顔で村を歩き、そのすぐ後ろを数人の子供たちがこっそりと後をつけている。\n子供たちは茂みに隠れたり、一斉に木陰に転がり込んだり、互いに目をパチパチしてみせて暗号を送ったり、ときおり想像上のトランシーバーを手に何か話したりしている。"
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "報告、悪魔はトムの家の藁ぐまの前まで来たよ。もうすぐ彼の家の前につきそう。どうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "了解、都市防衛砲準備よし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "心配する通行人",
      "text": "ねえあなたたち、スリングショットを人に向けちゃだめよ。危ないから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大人が口を挟むと、子供たちは羽獣のようにきゃあきゃあ叫びながら散り散りになるが、すぐにまた集まってくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ちっ。オマエら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供たち",
      "text": "ヤバい、悪魔に気付かれた！　撤退だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "悪魔……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（ウザいな、さっさとビビらせて追い払うか。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "ねえ見て、悪魔が通った道、足跡がキラキラ光ってるわ。あれってなにかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "ちょっと待てよ、偵察してくる――うわあ、火だ！　悪魔が通った道は燃えちゃうんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "私にも見せて――本当だ！　足跡が燃えてる、すごい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "いけない、遠くに行っちゃうわ、追いかけましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（は？　これでもビビらねぇのか？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "子供たちが手に持つスリングショットをしばし見つめるラヴァ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ちっ、いいだろう。怪我でもさせたら面倒だしな。もっとスゲーのを見せてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "へっくしょん――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "わっ！　悪魔がくしゃみして炎を噴いた！　ああっ、悪魔に、炎の翼が……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ&ローズ",
      "text": "わあ――！　か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ&ローズ",
      "text": "かっこいい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……見る目あるじゃん、ガキども。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怯える幼い患者",
      "text": "（すすり泣く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラヴァはばつが悪そうにポケットをまさぐり、飴玉で子供をあやそうとしかけたが、子供たちは空腹のままで血液検査を受ける必要があるとハイビスカスが言っていたことを思い出した。\nハイビスめ、手伝いに来てってアタシを呼んでおいて……同族がいれば戦争で両親を亡くした子供たちも怯えないと思うとか言ってたくせに、コイツらさっきから泣きっぱなしじゃねえか！\n病室で次々と上がる泣き声に、ラヴァは途方に暮れた。このような声は戦争が続く限り、毎日、それこそ一日も欠かさず、止まることはない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "なあ……オマエら、花火は見たいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える幼い患者",
      "text": "（すすり泣く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "見たいってことでいいな。よく見てろよ、一度だけのチャンスだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "コホン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "炎よ、この大地を照らせ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "炎からなる花火が天井へとまっすぐ昇り、病室の上空で炸裂した。ラヴァがこっそりと子供たちの表情を窺うと、全員が花火に心奪われ、泣くことさえ一瞬忘れていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そして炎は消防装置を起動させてしまい、全員がびしょ濡れになった。病室の泣き声は僅かばかりの間ではあるが、笑い声へと変わったのだった。\nどこの子供たちも同じようなものだ。ちょっとした小細工で簡単に引っかかる。\nだが本当にどこの子供たちも……同じなのだろうか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ラヴァちゃん、お帰りなさい。ご近所さんたちは、どうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ご近所さんたち？　アタシはチリパウダーを借りに行ったんだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ぐるっと見て回って、安心できた？　誰かと喧嘩してないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "だから、チリパウダーを借りに行っただけだって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ラヴァちゃん？　なに探してるの？　外の子たちは新しいお友達かな？　相変わらず子供をあやすのが上手なんだから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あれ、そんなに大きな荷物を持って……また出かけるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "報告、悪魔が家から出てきたよ！　今はお庭の方に向かってる、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "わあ！　炎だ！　えっと、悪魔が炎を操って……幹を焼き切って木を倒したんだ！　報告、悪魔がたくさんの枝で怪しいでっかいものを作ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "でっかいものって何なの、説明して！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "わかんないよ！　報告、悪魔が今白いシーツを……じゃない、白い巫術材料を広げて木の枝にかぶせた。情報員、分析頼む！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "情報員了解！　えっと、これはね、きっと……なにかの危険な祭壇だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "きっとそうよ、木の枝で幕を支えて、ほら、倒した木の幹をこっちに動かしてる。きっと生贄を捧げるための台にするんだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "（息をのむ）村が危ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "（声にならず縮こまっている）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "お、臆病者！　私たちがあいつを見張って、村を守らなきゃいけないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "待って！　悪魔がまた何かを取り出したわ！　機械装置ね、あれは……プロジェクター？　ううん、きっと巫術を使うための装置よ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その言葉が終わるや否や機械装置が起動し、白い「巫術材料」には高層ビルよりも大きい、遠吠えをあげる巨獣が映し出された。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供たち",
      "text": "きゃー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ゴオオン！　ドカン！\n「巫術材料」に映し出された映像の中では、変異した巨獣が一瞬で高層ビルを粉々に踏み潰していた。絶望した人々は泣き叫び、ヒーローの登場を待ちわびている。\nラヴァ、ロドス所属エリートオペレーター、アーツマスター、災害専門家。今、この都市が生き延びるための希望は、彼女の手に握られている。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供たち",
      "text": "見て！　ヒーローが来た！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "あれ、あの大怪獣と戦ってるヒーロー、あっちの悪魔……じゃなくて、あの人と……そっくりじゃない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラヴァは堂々と子供たちが「生贄を捧げるための台」と呼んだところに座り、さも心地よく映画を楽しんでいる振りをした――\nまだ未上映のこの映画を持ってきたのは、本来は親を喜ばせるためだった。\n無理やり付け加えられた上にひどく誇張されたシーンに対しては鼻で笑っていたが、こうして見てみると全体的には良い演出だったようだ。\n子供たちは皆、盗み見るように、映画のヒーローと彼女の容姿を見比べている。\n彼らは炎国の言葉こそわからないが映画の特撮技術に魅入られたようで、知らず知らずのうちに、だんだんと、ラヴァのすぐ側まで近寄っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（ふん、見る目がある奴らだな。じゃあとっておきを見せてやるか――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "まずいよ、大怪獣がお家をぺしゃんこにしちゃった、ヒーロー逃げて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "ヒーローは逃げないんだよ。ほら、炎を撃とうとしてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "ねえ……二人とも、あの、あの人は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "きゃああ！　大怪獣が追いついちゃう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "ねえ！　ねえってば！　あの人が、あの人がいなくなってるよ！　私たちのご近所さんのあの人が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "あっ！　あの人、さっきまでここに座ってたのに、どこに行ったんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラヴァが座っていたところには、いつの間にか誰もいなくなっていた。突如、炎が子供たちの背後から、襲いかかるようにシーツでできたスクリーンめがけて飛んでいき、子供たちは悲鳴を上げた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "ねえ、こ……これってもしかして本当に祭壇なんじゃ……私たち、騙されておびき寄せられたのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "早く逃げよう……早く……あっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "だが子供たちは足を止め、目の前の光景に驚き、言葉を失う。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼らの前にいたのは、戦闘服に身を包む颯爽とした女性だった。彼女が格好良くクールに手を振ると、炎は「巫術材料」、すなわち、スクリーン代わりとなっているシーツに襲い掛かった。\nスクリーンに映る巨獣は苦悶の咆哮とともに、燃やし尽くされて灰となった。やがて炎が消えると、周りの草や花には焦げ跡ひとつなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供たち",
      "text": "わあー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "すごいよ！　ヒーローさん、本当に大怪獣と戦ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テオ",
      "text": "さっきの技、教えてくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローズ",
      "text": "戦闘服がとっても素敵で、えっと、かっこいい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "ねえヒーローさん、先に質問したのは私なんだから、まず私に答えて――あっ！　……お母さん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "映画が炎の中で幕を閉じると、子供たちはようやく親が近くでハラハラしながらこちらを見ていることに気がついた。親たちは前に出ると、言い分も聞かずに子供たちを家へと引きずっていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "イルサの母親",
      "text": "イルサ、こっそり出てっちゃダメだって言ったでしょ。今晩は部屋でしっかり反省しなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサ",
      "text": "引っ張らないでよお母さん。あのね、さっき私、すごいものを見たんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イルサの母親",
      "text": "お黙り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "そんなにさっさと逃げなくても、こちとらオマエらより牙が多く生えてたりも、羽が生えてたりもしねーし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "まあいいや、いなくなってくれて清々した。ガキどもの機嫌取りもしなくていいし、うるさくて仕方なかったからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ん？　これは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "イルサが座っていた場所には、チリパウダーが瓶ごとポツンと置かれていた。少し呆気にとられたラヴァが、顔を上げて感謝の声を掛けようとしたが、すでに人影ひとつすら見当たらなくなっていた。\nかくして、ラヴァは荷物を片づけて家路につくことにした。その足取りは、先ほどよりも幾ばくか軽やかになっていた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
