{
  "server": "jp",
  "storyId": "act32side_level_act32side_05_beg",
  "groupId": "act32side",
  "stageId": "act32side_05",
  "title": "消防用通路",
  "storyCode": "CR-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act32side/level_act32side_05_beg.txt",
  "sourceHash": "f97549d7ffec5e0658cd4482fa9238da593a82d7345149bc59d4411a2dc5da28",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "昨晩、この町のストリートアートコミュニティに、二つの巨大な木製の人形が現れました。その見事な出来栄えには、誰もが目を丸くするほどです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "コミュニティ在住のアーティストがデザインし、皆で制作したというこの二体の人形は、昨晩行われたリハーサルにて、月明かりの下を優雅に舞い踊っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "撮影された映像では、住民たちの繊細な操作によって、まるで本物の人間のように生き生きと、美しく踊る人形の姿を見ることができます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "ご存知の通り、当該地域はギャングや浮浪者が多く住む治安の悪い場所で、普段は誰も近付こうとしません。しかし、昨晩のリハーサルに惹かれ、大勢の人が見物に向かったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "ここからは中継先のリポーターから、現地の声をお届けします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "アイスください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露天商",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "あのぉ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "すみません、一つお聞きしてもよろしいでしょうか？　人形が現れた時、あなたは何をしていましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "ランニングしてたら建物の間から突然でっかい人の顔が現れてさ。驚いて腰抜かしちゃったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "それから勇気を出して近付いて、様子を見に行ったんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "見終わった後もずっと足の震えが止まらなかったよね。今度は驚いたからじゃなくて、感動でさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "なるほど、ありがとうございました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "ふふっ、ご覧ください。お答えいただいた方の、あのおぼつかない足取りを。まだ感動している様子を見るに、どうやらすべて本当の話のようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "では続いて、コミュニティに住むアーティストに伺いましょう。なぜあのような巨大な人形を作ったのか、そしてそこにはどのようなドラマがあるのかを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カジノのディーラー",
      "text": "皆様、最終ラウンドを始めます。ベットをお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客",
      "text": "シッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カジノのディーラー",
      "text": "ええと……皆さま？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "あっ、今通り過ぎた少女をご覧ください。彼女こそ、この人形制作の中心人物だそうです――少々お時間よろしいでしょうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "あなたが今回のショーのチーフデザイナーだそうですね。その若さでこのような大役を任されるとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "あーもう、そういうのいいから、さっさと質問して。手短にね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "では早速、なぜあの人形たちがこの場所に現れたのかについてお聞かせください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "人形にこれほどの労力を費やしたのは、やはり人々の注目をコミュニティに集めるためでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "注目？　数年前にビルが火事で二棟も焼け落ちた時ですら、ほとんど誰も注目しなかったのに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "火事、ですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "（小声）やっぱり誰も覚えてないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "あの人形は、その火事の日を、その日亡くなった友人たちを偲ぶためのものなんだよ。だからこそ、芸術祭の開催日は火事が起きたのと同じ日にしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "ですが、大勢の脚光を浴びているクリスタウォワギャラリーの開館式も同日に開催される予定ですよね。何かプレッシャーを感じることはありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "リハ前はそういうのもあったかもしんないけど、今は特に……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "……芸術祭の開催日当日には、もっととんでもない演出に進化してるから。ギャラリーの開館式なんかが、アタシたちの祭典と張り合えるとは思えないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "どんなに大袈裟に宣伝したって、ギャラリーの開館式が大衆に伝えられることは、たった一つ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレビの声",
      "text": "レイネルさんが商売上手のビジネスマンだって事実だけだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "おいおい、どうしてテレビを消すんだ？　せっかく見ていたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "そろそろ寝た方がいいんじゃないかと思ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "必要ない。眠気なんて少しも感じてないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "それでも、寝てくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ミウォシュ……そんな不満気な顔をして、どうしたんだ？　もう少し嬉しそうにしてくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "いいから、今日のところは休んでくれ、レイネル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "十数年の時を経て、誕生日プレゼントとして贈られるはずだったものをついに取り戻したんだ。僕はいま、とても嬉しいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "本当か？　君の取り乱しようを見ていると、何の説得力もないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "あのオルゴールは本来、僕への贈り物だった……誕生日の前に、母がプレゼントすると言ってくれてたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "だがあの老いぼれはそれを快く思わなかった。経済的な利益をもたらさない作品など意味がないと言ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "母は天才で、スターなのだから、展示すれば莫大な価値を生む彼女の作品が、一人の子どもの枕元にひっそり置かれたままなど絶対に許されない、とも言ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "……だが、それは君の手に戻ってきた。長い年月を経て、ついに本来の持ち主のもとに帰ってきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ああ。どんなに変わり果てた姿になっても、僕はこのオルゴールが本当に好きなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "けれど、母はどうだろう？　僕からのお返しを、本当に気に入ってくれるだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "……君の贈り物なら、なんだって大切にしてもらえるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "どうした、急に黙り込んで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "……君の言うとおり、一眠りしたくなってきたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "さっきテレビで話してたのを見たぞ。あんなふうに、メディアの前で尖った態度を取るのはよせ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "でっかい人形を作ろうなんて提案したのはおっちゃんでしょ。今さら目立つ心配なんかしなくていいって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "まったく。っと、そういや、さっき市政府から手紙が来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "芸術祭を無事に開催できたら、将来的にはリターニアの文化交流使節団が俺たちの人形ショーを見に来るとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "それって、政府の支持を得られるかもってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "奴らの支配を受けるって方が可能性としては高いだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "軍閥、商人、それに政治家、この土地を狙う連中はどんどん増えていく一方だ。こうして急に注目を浴びると、正直少しプレッシャーを感じるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "俺には荷が重いのかもしれん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "そんなこと言わないでよ。おっちゃんがここに来る前なんて、一昼夜続くような大火事に見舞われても誰も気にしてくれなかったし、報道するマスコミすらいなかったくらいなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "この数年、皆が安心して暮らせてるのはおっちゃんのおかげだよ。その苦労がどれほどのものかだって、皆わかってるしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "アタシたちのためにそこまでしてくれるのは、皆が太陽の下でもう一度踊れるようにするためなんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テクノ",
      "text": "目標達成まであともう少しじゃん。なのに何がそんなに心配なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "もう少し考えさせてくれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディアス",
      "text": "皆を無防備に太陽の下へ連れ出すわけにはいかないんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "ミウォシュさん、お聞かせください！　あなたとレイネルさんは例のコミュニティで行われた人形ショーをご覧になりましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "あなた方のクリスタウォワギャラリーは、コミュニティの芸術祭と同日に開館する予定だそうですが、ショーのリハーサルが成功したことで、人々の注目を奪われる可能性が出てきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "そのことについて、何かプレッシャーに感じていることはありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "通していただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "ミウォシュさん、質問にお答えください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "申し訳ありませんが、本日はいかなる質問にも答えるつもりはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "何も答えないということは、何か問題があると考えているというふうに受け取っていいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボディガード",
      "text": "それ以上近付かれると困ります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リポーター",
      "text": "ミウォシュさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "Elaさんはもう来ているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボディガード",
      "text": "はい。ホールでお待ちです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "彼女と話してくる。誰も近づけるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ボディガード",
      "text": "はっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "お待たせしました。外に記者の人だかりができていたもので、道を塞がれてしまって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "それで、どうして急に呼び戻したの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "コミュニティの方々とはうまくやっているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "……まあね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "あそこに住んでる人は皆、とても活気に満ちている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "病に苦しんでいても、創作意欲を持ち続けている人もいるくらい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "昨今は「アーティスト」の称号がありふれたものになりつつあるけれど、彼らは真の意味で芸術を愛していると言わざるを得ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "……では、レイネルはどうでしょう？　あなたは彼をどう思っていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "彼は……面白い人よね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "それだけですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "……残念だけど、彼の中に同じものは見出せないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "そういえば以前、シュチェパン氏の肖像画に不快感を覚えると仰っていましたね。実のところ、ご本人が与える不快感は肖像画のそれを遙かに上回るのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "あの方さえいなければ、あなたもきっと、レイネルの目に彼らと同じものを見ていたことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "シュチェパン氏はカジミエーシュで最も有名な美術商でした。彼は言論での攻撃も、暴力的な威圧も、経済的な支配も、ありとあらゆる手段を用いて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "契約したアーティストに、自分の意のままに作品を作らせました。その中には彼の妻……レイネルの母君すら含まれていたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "クリエイターというのは誰しも、そういう束縛を嫌うものだから、お母様もきっと、とても辛い思いをしたのでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "ええ。夫人は自らの手で作品を壊してまで反抗の意を示したこともありました。ですが一週間後、その彫像は破損部に高尚な哲学的意義があるとされ、オークションでは高値で取引されたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "……そこを去るべきだったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "夫人には、あの尊大な卑劣漢の下に、我が子を置き去りにすることなどできませんでした。自分とよく似た息子とあれば、なおのこと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "……こんな時に彼への同情を誘おうとするのは、一体なんのためかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "やはりあなたは勘の鋭いお方だ。鋭すぎてあなた自身をも傷つけてしまうくらいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "クリスタウォワギャラリーの開館日は、レイネルの母君の命日にあたります。つまり彼にとっては、その日に開館式を行うことに特別な意味があるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "あなた方であれば、彼の助けになれるかもしれない。大がかりなスケジュール変更は必要ありません。両イベントの開催日を、ほんの一日でもずらすことができれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "申し訳ないけど、お断りするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "ニュースを見たのなら、その日はコミュニティの人たちにとっても特別な一日だって、知ってるわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "どんなに難しくとも、試してみた方がいいと思いますよ……これはお願いではなく、忠告です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "当日を迎えればご理解いただけるでしょう。彼らの人形ショーがどれだけ感動的なものであろうと、クリスタウォワギャラリーの開館式の前では霞んでしまうことを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "起きていたのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "君は、出かけてたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "ああ。Elaさんと会っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "彼女はなんて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "断られたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "だろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "……わかっていたならなぜ呼び戻した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "彼女がいれば、人形ショーは安泰だ……彼らの望み通り、いつか芸術祭はこの街の象徴となるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "だが、それは今じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "本当に残念だよ。彼らが大きな時間と労力を費やして、心血を注いだショーなのはわかっているからね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "正直なところ、日程さえ被らなければこの足で見に行きたかったくらいだよ。階下に置かれた、美術商どもの手垢にまみれたゴミに比べたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "彼らの作品の方が余程興味深い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "ここ数年、君がアートに興味を持つことなんて、ほとんどなかったのにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ああ。だから彼らには好きなようにしてもらおう。しかし、それにしてももったいないな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "生まれたばかりの作品がどれだけ人の心を打つものだろうと、壮絶な死とは比べようがないのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "爆弾の運び込みは全て完了している。開館式当日、全て君の望み通りに運ぶよう、明日最終調整を行う予定だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "僕のために、何から何までありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "気にするな。それより、気づいているか？　先ほど死について語っていた君の目の中に、輝くものがあったのを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "それは以前、創作について語る君の瞳の中に見たのと同じ輝きだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "……それと似ているだけのものさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "だとしても、私にはそれで十分だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "……誰だ？　こんな時に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "私が出よう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "ずいぶん長電話だな。なにがあった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "（口パク）向こうの話が長いんだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "（口パク）相手は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "（口パク）例の大尉。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "（口パク）何の用件なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミウォシュ",
      "text": "（口パク）コミュニティの件以外にないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "わかった、僕が引き継ごう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイネル",
      "text": "もしもし、マッテオか。いま忙しくてね、用なら後にしてくれたまえよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう言うとレイネルは躊躇いなく電話を切り、電話線をぶつりと引きちぎった。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
