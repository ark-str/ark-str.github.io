    {
      "type": "dialogue",
      "speakerName": "センシ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "色々な種類がいるようだ！　液体を吐くものもいた！　気をつけろ……触れれば溶けるぞ！"
