  "sourceHash": "78f8550be0122b7d91e6272f70e9590296aa779a7f9371bee71583adba3e346f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "片付いたぜ、トミミ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……ま、まだです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ヌール、ペータ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディラン",
      "text": "ドクター！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "ドクター様！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "な、仲間を傷つけられたくなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "アタシを怒らせるんじゃねぇぞ、トミミ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "……ガヴィルさんが残ってくれると言うまで、絶対にやめません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ディラン",
      "text": "助けてくれ、ドクター！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lancet-2",
      "text": "ドクター様、怖いですううぅ……",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "任務は終わったのか？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ディラン",
              "text": "ちょっとドクター、空気を読んでくれよ。こんな健気なお嬢ちゃんなんだから、少しくらい乗ってやっても死にゃしねぇだろうよ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Lancet-2",
              "text": "はぁ、ここの人たちは本当に純粋ですから、正直彼らを騙すのは良心が痛みます。私に心はありませんが。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ディラン",
              "text": "おいおい、そんな目で見るなよ、ドクター。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ディラン",
              "text": "安心してくれ、こんなんでもロドスのオペレーターだからな。このくらい自分でどうにかできるぜ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "安心しろ、今助ける！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Lancet-2",
              "text": "ドクター様あああ！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Lancet-2!",
          "value": "4",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "トミミ",
              "text": "えっ？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アダクリス人",
              "text": "いつの間に縄を！",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ディラン",
              "text": "ははっ、わりぃな、最初から縛られてねぇんだ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ドクター、まさか最初からトミミの企みを見抜いてたのか？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "ドクター様あああ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ディラン",
          "text": "うわっ、二人とも俺よりノリノリで演技してんな。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "当たり前だ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "見抜けない方がおかしい。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "な、なんでわかったんですか！？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "まず、君は最初にズゥママの名を出すときにためらった。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "えっ？　そうだったっけ？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そして、祭典では、ガヴィルの突然の行動に焦りを見せた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "……",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そして最後に、ディラン、例の物は？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ディラン",
          "text": "おう、Lancet-2に積んであるぜ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "うう……私の身体に物を入れさせるなんて、ドクター様の為でなければ絶対にしませんからね。本当ですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "これは……ロケットランチャーか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ディラン",
          "text": "そうだ、トミミの部族で見つけたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "まさか……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ディラン",
          "text": "そのまさかだ。俺たちを撃ち墜としたのは、このお嬢ちゃんってわけさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "トミミ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ううう、ごめんなさい、ガヴィルさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "こっち来い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "うううぅ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "アタシの脚の上に伏せろ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさん、ぶたないでください。反省しますから……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ダメだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "言うこと聞かない悪ガキは、お尻尾ペンペンだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ううう……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "text": "お尻尾ペンペン、なんか痛そう……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "これで懲りたか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "懲りました、ううう……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "それならよろしい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "とりあえずこれで一件落着だ、ドクター。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "疲れた。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ははは、確かに災難の連続だったな。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "おい、ドクター、立ったまま寝てんじゃねぇだろうな。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "あの大風車を使うと思った。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "トミミをケガさせるわけにもいかねぇからな。しっかし、さすがのアタシも疲れたぜ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "この大きなロボット……一見不格好に見えますが、この角々しさや粗削りな造形、雑然としながらも理に適った配線など、よく見れば独特の美が感じ取れます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "これは結婚向きのタイプですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "おい、Lancet-2、エンジンが使えるか見てやってくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "え？　まさかエンジンはこの巨人さんの中に！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああそうさ。アタシらがボコボコにしてやったけどな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "ああ、可哀想なエンジンちゃん、可哀想な巨人さん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "ディランさん、手伝っていただけませんか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ディラン",
          "text": "おうよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "おい、ズゥママ、どうしたんだ、ボケーっとして。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "ガッ、ガヴィル！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "あぁ？　なんだよ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "あれ、あれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "どれだよ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "あれ、あの自分で動いたり話したりする機械はなんだ！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああ、Lancet-2のことだな。あいつもアタシらの仲間さ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "は、話しかけてもいいか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "好きにしたらいいじゃねぇか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "や、やあ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "はい、こんにちは。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "お前は機械なのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "私の製品名は「レイジアンイグジスターシリーズS-Typer62六輪作業プラットフォーム」です。ロドス所属で、コードネームはLancet-2です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "おお！　し、質問してもいいか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "私には一定の知能が備わっておりますので、そこまで難しくないご質問であれば、回答可能かと。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "ちなみに、私は医療用の作業プラットフォームのため、提供可能な知識は医療方面に偏ったものとなります。ご了承ください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "^%&$*#(#……！！！！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "何でしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "だ、抱っこしてもいいか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "はい？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "何やってんだあいつ、おかしくなったのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "見ればわかるじゃろ。あの機械に衝撃を受けたんじゃよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "あぁ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "自らの意思で動き、喋る機械から受けた衝撃は、初めて移動都市を目にしたとき以上のものじゃった。つまりそういうことじゃ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "わしも同じくらい、興奮しておるがな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "のう、美しいお嬢様、わしとのデートに付き合ってもらうことはできんかの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "このジャングル一番の景色を知っとるんじゃ。そこで素晴らしい午後のひとときを共に過ごすのはどうじゃ！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "ええ？　わ、私、誘われました！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Lancet-2",
          "text": "どうしましょう、ちょっと嬉しいような……ドクター様、これは受けるべきでしょうか？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "受けてやれ。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ユーネクテス",
              "text": "じいやは引っ込んでいろ。でないと長年のよしみを捨てることになるぞ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "……多分私もドクターと同じ気持ち。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "吹き出しそう。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "Lancet-2は誰にもやらん！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Lancet-2",
              "text": "えっ、そんなドクター様、急にそう言われましても、心の準備が……",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "ガヴィル、お前たちが住んでいるところは、こういう機械も造れるのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ん？　あー、まぁクロージャなら造れるかもな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "そうか……よし、決めたぞ、ガヴィル。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "そのロドスというところだが、人手は足りているか？　私も加入したい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "あぁ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "そこで機械の技術を学びたいんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ハァ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
