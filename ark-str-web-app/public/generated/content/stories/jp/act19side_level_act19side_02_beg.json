{
  "server": "jp",
  "storyId": "act19side_level_act19side_02_beg",
  "groupId": "act19side",
  "stageId": "act19side_02",
  "title": "開拓者の小屋",
  "storyCode": "DV-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act19side/level_act19side_02_beg.txt",
  "sourceHash": "e6973c0d9a73d8c506e96d99bae4f8be4d4fe35acc0ac5af4e3278065a6b93eb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "俺の人生はお終いじゃないか……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "……ええと、リーダーさん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "ご気分が優れませんか？　なんだか呼吸が乱れているような……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……うわっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "すみません、驚かせてしまいましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "僕はサイレンス先生の同僚です。危険な武器は持っていません。開拓隊の方のチェックを受けてきましたから、ご安心を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "悪かった。つい、反射的に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "謝らないでください。理解はできますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "電気が消えて、暗闇が広がっていくと、気持ちが張り詰めてくるものですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "よかったら、もう少しこちらへ来ませんか？　人が集まれば暖も取れますし、もし寝てしまっても凍えずに済みますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……ほかの奴らはどうしてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "サイレンス先生なら、フィリオプシスさんを診察中です。エレナさんも一緒にいますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "先生の医療ドローンには非常用電源が搭載されているので、それで検査するそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "サムは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "あなたの指示通り、容体が思わしくない開拓者さんたちを屋内に集めていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "一つ頼みがあるんだ。サムやほかの奴には言わないでくれないか。俺が、今……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "もちろん、誰にも言いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "皆さんのリーダーはあなたですから。この局面であなたの具合が芳しくないことを知られたら、開拓隊の人たちが暴走してしまう可能性もありますしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "開拓隊の結束を疑っているわけではないんですよ。ただ……暗闇は不安を生むものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……随分色んな経験をしてきたみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "それほどでも。……僕はボリバル人なんですが、昔住んでいた都市ではよく停電が起きていたもので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "ボリバルっていうと……紛争地帯か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "はい。僕の故郷は、戦争がいつ収まるともわからないような場所でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "そんな場所から抜け出すのは、簡単なことじゃなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "今の仲間たちが、僕を助けてくれたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "僕からすれば、あなたや開拓隊の人たちのほうがすごい人ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "俺がすごい人……ね。ははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "な、何か変なこと言いましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "いいや。クルビア企業の連中は、遠いボリバルにまで広告を出してるのかと思ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "ああ……いえ、そういうことじゃなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "どうあれ、あなたがご自分の足でここへ来たことは確かだと思いますから。それに、ヴィクトリアやガリア、ボリバルから来た移民たち……あなたの先人たちも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "皆さん一人一人の足跡が、この荒野を照らしたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "はは……あんた、上手いこと言うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "えっ？　事実を言っただけですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "僕はここに来る前から、クルビアの有名な開拓地がどんな場所なのか見てみたいとずっと思ってたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "だったら失望したんじゃないか？　ここはあんたの故郷以上につまらん荒れ地だろうしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "そんなことはありません。僕はここで多くを学んだんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "たとえば、ここで生まれた電源回路の設計は、Mechanistさんの仰っていた通り簡潔で効率的ですし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命警備課職員",
      "text": "保安官、車の準備ができました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "了解。防護用の装備も忘れずにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "向こうが自作のクロスボウを持っているのを見かけたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "もう少し暗くなってきたら、ドローンを何機か開拓者居住区に飛ばして、人質と犯人の位置を確認するわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "それが済んだらタイミングを見計らって突入。いいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命警備課職員",
      "text": "では……サイレンス研究員と、ロドスとかいう会社のオペレーターはどうしましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "何が言いたいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命警備課職員",
      "text": "彼らがどちら側につくかわからないので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "……それがライン生命の考え方なの？　何をするにもどっちの味方か最初に決めなきゃダメなわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命警備課職員",
      "text": "我々はただ、問題を確実に解決したいだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命警備課職員",
      "text": "それが我々警備課の仕事ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "あら、そう。じゃあ言うけど、私の仕事は人命救助よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "よく聞きなさい。あなたたちが何をしたいかなんてどうだっていいけど、私の仕事の邪魔だけはしないほうがいいわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "つまり、そのロドスの人間があんたを助けてくれたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "そうなんです。事故で死にかけていた僕を救ってくれた上に、勉強を続ける機会まで与えてくれて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "こうして今の僕があるのも、全部ロドスが僕の人生を変えてくれたおかげです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "はははっ……本当に良い会社らしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "こんな状況じゃなきゃ、今のは就職説明会みたいに聞こえてたんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "……もし本当に興味がおありなら、ロドスに履歴書を送ってみてもいいと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "俺はただの開拓者だし、それどころかもう誘拐犯にすらなっちまったかもしれないんだ。……なのに、そんな良い会社に履歴書なんか送れるわけないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "あんまりからかわないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "あんたがどんなに謙虚でも、実際は前途有望なエンジニアだってことくらい俺はわかってるんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "ましてや、あんたの同僚だっていうあの三人なんか……感染者の身でライン生命に雇われてるんだぞ。これがどれだけ難しいことか、あんたはわかってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "うーん……確かに、あの人たちは本当に優秀ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "あれは優秀なんてもんじゃないだろ。それぞれの分野で飛び抜けた才能を持ってる、ああいうのを選ばれた人間っていうのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "感染者は毎年山ほど増えていってるが、「恩赦」を得られるのはほんの一握りの天才だけ。三人はその天才なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "ですが、ロドスは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "わかってるよ、グレイさん。「ロドスが人を救う条件はそこまで厳しくない」って言いたいんだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "だが、自分の命を救ってくれた会社にあんたが特別な信頼を寄せてることや、その会社が利益追求は二の次ですべての感染者に分け隔てなく接してるっていう言い分を、俺が喜んで信じたとしても――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "あんたも選ばれた幸せ者だってことは否定できないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "それ以外のツイてない連中は、囲いの中で飼い殺しにされながら泥水に頭まで沈むのを待つか、あるいは次のささやかな仮住まいを見つけるために、リスクを承知で踏み出していくしかないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "俺は……その一人なんだよ。誰も俺たちを救えやしない。俺たち自身にすらな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "オリヴィア、これで本当に上手くいくと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……ジョイスの脳波は少し安定してきてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも、普段と同じ治療――神経弛緩薬を打つことでは、期待通りの効き目を得られなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "もしかして、この発作には別の要因があるのかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ってことは、まだ危険な状態なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うん、原因がわからない以上、もっとちゃんとした治療環境が必要になる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "そっか……うん。その辺りのことも聞きたかったんだけど、それだけじゃなくてさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "さっきグレイに、開拓者たちのリーダーと一緒に電線を点検してくるように指示してたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あれは私が頼んだわけじゃない。グレイ自身の考え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……でも、隊長はキミでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "確かに、私がロドス本艦で過ごした時間はキミたちほど長くない。それでも、ロドスの人たちがどういう行動を取るかくらいはわかってるよ。オリヴィア、キミを非難するつもりはないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "もしグレイが危険な目に遭ったり、ジョイスの病状が手遅れになったりしたら、キミは自分を許せないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "――エレナ。私たちとグレイのうち、サニーさんが信頼を置くとしたらどちらだと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……？　そもそも何が違うっていうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたは、ライン生命本部での実験事故で運悪く鉱石病に感染したんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "その時……もう二度と研究ができなくなるんじゃないか、って思わなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "それはもちろん、思ったけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "でも、すぐにうちのボス――フェルディナンドさんが雇用契約を新しく結び直してくれたんだ。契約期間は三年から十年に延長されたし、給料も三割アップしたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あの年、あなたはライン生命の年間最優秀社員にも選ばれてたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "うっ……でも、それは鉱石病とは関係ないと思うよ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "どうあれ、ロドスでの治療中にも、主任のためにトップカンファレンスの論文を三本書いてたわけだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そう考えるのもわかる。私も似たようなものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "とはいえ、昔の私はあなたほど楽観的でも純粋でもなくて、将来に不安があったからこそ、パルヴィス先生とライン生命に感謝していたんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "それでも……私は自分の才能と、それがライン生命にもたらす利益を疑ったことはなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "つまり、私たちにとって、鉱石病は克服しなければならない課題であり、人生を食い潰すようなものではないよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "一方で、グレイは大きく影響を受けている……だからこそ、私たちにはできないことが、彼にはできるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "サニーさんが仰ったことは、少し間違っていると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "っていうと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "あなたは、次の仮住まいを見つけるためには、リスクを承知で踏み出していくしかないと仰いましたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "そもそもまだ僕らのほうへ踏み出してもいないのに、どうしてその一歩で活路が開けるわけがないなんて決めつけてしまうんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "開拓隊の隊員",
      "text": "リーダー、見ろ――電気が復旧したぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "なっ、どういうことだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "上手くいったみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "もしかして、あんたがやったのか……？　俺と話してる間に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "……サニーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "あの時、外の暗闇に飛び出していなかったら、僕は明かりを持ったロドスの先輩に会うことはありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "どうか信じてください。時には、あと一歩を踏み出すことが真の意味で助けとなるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "そいつは、たとえ……もう崖っぷちに立ってるとしてもか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "――それどころか、崖から飛び降りたあとでも、ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "僕たちには、あなたが手を伸ばしているのが見えました。あなたが助けを求めているなら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "僕たちは、全力であなたの手を掴んでみせます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "どんなことがあったにせよ、諦めるにはまだ早いです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "あ……電気が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "グレイが……やってくれたのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "よかった。ジョイスが光に反応してる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……こんな時まで集中してるなんて、さすがだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……なあ、先生たち。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "なんで一人で戻ってきたの？　グレイはどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "あの人は別の居住区へ向かったよ。現状、通電したのはこのエリアだけだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "俺を信用してない。だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "来ないで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "エレナ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "オリヴィア。キミは、彼が信じるとしたら私たちではない、なんてことを言ったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "こっちのほうこそ、この人を信じる理由なんてないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "始めに私とジョイスを騙してここに連れてきたのは彼なんだし、それに、これまで言ってなかったけど……私、この人たちが研究エリアを包囲するためにたくさん人を送り込んでるのを見たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "研究エリアへ向かう開拓者たちは、みんな武器を持ってたんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "事情があるんだ。あんたが想像してるような理由じゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "何？　言い訳？　恩知らずな真似はしたくないとか言ってたけど、ドロシーがキミたちにしてくれたことを忘れてるんじゃないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "身勝手な理由で彼女を傷つけようとするなんて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "これは……警報？　あんたが鳴らしたのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "本当はもっと早くにこうしたかったんだけどね。今頃、保安局と警備課の人たちがここに向かってきてるはずだよ。こうすれば、私たちの位置をドローンで確認する必要もないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "グレイには感謝しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "あいつが電気を復旧させたのはそのためか……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "そうやって邪推するのはやめて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "グレイは心からキミたちを助けたいと思って行動したの。ドロシーやジョイスと同じようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "そういう人たちのためにも……あなたのことは見逃してあげてもいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "キミたちがどんなつもりだったか知らないけど、早く諦めたほうがいいんじゃない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "……もうドローンを飛ばしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ライン生命警備課職員",
      "text": "いえ、まだです。保安官の指示をお待ちしておりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "だったら、基地上空でいくつも飛んでるあの光は何……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "あと少し、もうちょっとですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開拓隊の隊員",
      "text": "この光……すごく、綺麗だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "本当ですか？　ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開拓隊の隊員",
      "text": "ははっ……こうしてあんたと作業してると、体も暖まってきたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開拓隊の隊員",
      "text": "残りはあそこだけだろ？　大企業のお偉方め、俺たちの手が動く限りは、電気が止まったくらいじゃ屈しないってところを見せてやるぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "……？　何かがおかしいような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "待ってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開拓隊の隊員",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "そ、それ以上進まないで！　あの光は僕のアーツじゃありません！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……サイレンス先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "改めて聞かせてほしい。あんたは、ただの開拓者のことを本当に信じてくれるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私は医者であると同時に、研究者でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私も、同僚たちと同じように――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "真実を信じるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……ねえ、なんだか外が騒がしくない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "走ってる音がたくさん聞こえてくるような……もしかして、キミが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "いいや、俺は何も指示してなんか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開拓隊の隊員",
      "text": "クソッ、こっちに来るな！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "ッ、まさか――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "保安局が助けに来てくれたのかな……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "違う！　いいから外には出るな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "何をそんなにピリピリしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "多分アレがまた近付いてきたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "アレってなんのこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "あんたたちに伝えようとしていた……真実ってやつだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "エレナ、ドアから離れて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "開拓隊の隊員",
      "text": "リ……リーダー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "開拓隊の隊員",
      "text": "にげ、ろ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "怪我？　それとも……発作？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "今は近付くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも、あの人を助けないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "――あいつの後ろを見ろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼の指さす先には、不規則な形の物体が宙に浮いていた。\nその表面は非常に滑らかで、柔らかい銀色の光を放っている。そして呼吸のリズムに合わせるように、微かに上下し続けていた。\nそれは倒れ込んだ開拓者の後ろからゆらりと浮き上がり、空中で三秒ほど停止した。\nかと思うと、それはゆっくりと回転を始める。まるでその場の人間を一人一人興味深げに観察しているかのように。"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "こ……これって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "走れ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
