{
  "server": "jp",
  "storyId": "1stact_level_a001_05_end",
  "groupId": "1stact",
  "stageId": "a001_05",
  "title": "話が平行線",
  "storyCode": "GT-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/a001/level_a001_05_end.txt",
  "sourceHash": "5967663bc0ef4f0c787ece861c9c70370386485d2683c60219eddda1efb5c00b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ぐっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "こ、このクソチビがぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "血まみれになりながら、まだ俺たちの邪魔をしようってのか――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ヘンッだ。このくらいの傷、いつもの訓練よりずっと軽いよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "ぐっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "これで倒したのは何人目…？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ううん、人数なんてどうでもいいや…。これで全員止めたはず――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "じ、地震？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あれは……岩盤が崩れて穴が？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ウソでしょ？　あんなに厚い岩を破って来たの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "おい、ここから中に入れるぞ！　進め！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ダメ…。スカジの開けた穴から敵が入ってくる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "早くキャロルのところへ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "止まりなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "スカジ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "山に穴を開けて無理やり道を作るなんて、ロドスで流れてた噂は本当だったんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あの子はどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "教えられないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あれに目をつけてるのは私一人じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたに言うことを聞かせるためには、一度徹底的な教育が必要かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "何の説明もなく急にキャロルを連れて行くって言われて、はいそうですかって渡せるわけないじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたはロドスの任務を……邪魔するつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ロドスのどんな任務を受けてるかも教えてもらってない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "本当にロドスの任務かだって……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "それに、急に仲間を攻撃するのだっておかしいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "誰があなたの仲間ですって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "最後にもう一度言うわ。私をあの子のところへ連れて行って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "キャロルはあたしの依頼人なの。絶対にそれはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "クッ、うわっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あの剣の軽い一振りを槍で受けただけなのに、腕が折れそうなほど重い……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたのその程度の力で、彼女を守れるとでも思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "できるかどうかと、やるかやらないかは別だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あれは…。ごめん、ちょっと待って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "来るっ、避けて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "チッ、さすがに当たっただろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "んん？　当たっ……てない！？　クソッ、ピンピンしてやがる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……またあなたたちなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "ウッッ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "お、おい！　や、厄星！　大尉を怪我させたのはお前だろう！　今日という今日はこの落とし前――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "チャンスだ！　今のうちに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "そこのチビ、お前も逃すかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "いやいや、今の状況、スカジだけで手一杯でしょ？　それっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "――なっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "なんだ！？　あのガキ、俺たちを飛び越えただと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "スカジ、あたしは先に行くから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなた……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ごめんね！　少し頭を冷やして任務について教えてくれる気になったら、キャロルのことも考えてあげるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "止まりなさい、どこへ行くつもり！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "じゃあね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "オイ、なぜ奴を逃した！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "あんなの早すぎる。捕まえろったって無理な話だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "まぁいい、どのみち大尉の仇はこいつだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "そのデカイ図体、俺たちを飛び越えるなんて無理だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "もう終わりよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "本当に分かれ道だらけだ…。ここがキャロルの言ってた財宝が眠る……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あっ、あれは……賞金稼ぎ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "ガハッ……助けて……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "ううう……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ひどいやられっぷり……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "まるでボロ雑巾じゃないか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あれ？　でもまだスカジは入ってきてないはずだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "こんな所にも外から爆破されたような穴があるということは…？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "つまり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "もう、腹を決めるための時間が経ったということだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ヤレヤレ…。うまく演技できていると思っていたんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "やっぱり君は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
