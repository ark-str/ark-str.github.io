{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_05_end",
  "groupId": "act17d0",
  "stageId": "act17d0_05",
  "title": "物資回収計画",
  "storyCode": "OD-5",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act17d0/level_act17d0_05_end.txt",
  "sourceHash": "92fc741ea9580a602c933043bfb408f9c3953784def0dc42ab7ac936605baf02",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "何か見つけた？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "そうね。多くないけど、収穫としては十分。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "これらの食料に加えて、セーフハウスの緊急用備蓄があれば、なんとか一週間は食いつなぐことができるじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "もう遅い。そろそろ戻りましょう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……誰か来ます。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "数は？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "集団です……十数人。傭兵かと思われます。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "構う必要はない。セーフハウスへ急ぐぞい！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "まだついてきておるじゃと？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……はい。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "はて……おかしいのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "そう簡単に諦めるような連中ではないってことだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "ここで戦えば、容易に包囲されてしまう。引き続き撤退じゃ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "どうした？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "追っ手よ。戦闘準備。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……いや、あれは……"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……撃たないでください。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "どうした？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……彼らは、セーフハウスを襲った傭兵たちではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……レプロバの軍人です。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "現地の衛兵か？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "手を出すでないぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": null,
      "text": "この建物を包囲せよ！　一人として通すな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": null,
      "text": "待て待て……俺たち、包囲されてるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "……まずいことになったのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "領主の衛兵隊が、どうしてわたしたちを包囲するんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "皆、ひとまず静かにしておれ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "中で隠れている連中よ、聞くがいい！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "私はピカール・トゥラ！　ロングスプリングの衛兵隊長にして、ロングスプリング領主の娘だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "全員ただちに武器を捨てて、おとなしく出てこい！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "逆らおうと思うな！　後悔することになるぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "傭兵、また傭兵か。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "下品で無価値で恥知らずなクズどもめ。愚かな弟から一体いくら金をもらった？"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "貴様らはもう逃げられん！　粉々に叩き潰してやる！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "悪事の代償を支払う時が来たのだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "汚れた金をいくら手にしていようと、次の命は買えないということを思い知るだろう！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "おいおい……本当にあいつらが「助け」に来たって言うのかよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "俺たちの首を刈りに来たの間違いだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "一番恐れていた事態ね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "何か誤解があるようじゃのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "ピカール殿。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "儂はロドスの外勤オペレーター、コードネームはレンジャーじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "ロドスはここの領主様と協定を結んでいるはずじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "儂らは決して……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "黙れ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "ロドス！　篤志家気取りの偽善者どもか！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "私の父は貴様らを信じ、貴様らの約束を信じたからこそ、このセーフハウスの存在を許したのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "だが貴様らはどうやって父に報いたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "貴様らは町民を拉致し、彼らの財産を略奪した！　その一部始終を見てきた！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "善意につけ込む悪党どもめ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "ちょっと待って。少し考えればわかってもらえると思うんだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "あたしたちの目的がこの町の略奪だとしたら、こんなに長い間略奪を行った場所にとどまる必要があると思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "黙れ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "そもそも何様のつもりだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "銃器を持って父の領地に足を踏み入れておきながら、それでもまだ言い逃れするつもりか！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "あんたがそんなにすごいなら、これまでどこで何してたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "あんたと領主の衛兵隊は、病人地区を襲う暴徒を放っておいた。命懸けで助けたのはあたしたちの方よ？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "今更やって来て、この茶番は何？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "落ち着けよ。話が通じるような状況じゃなさそうだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "ピカール様！"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "僕は感染者地区の医者、ミアロです！　以前、お目にかかったことがございます！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "……覚えている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "ロドスの皆さんは略奪などしていません。僕が証明します！　僕たちは、別の暴徒たちに襲われてここまで来たんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "僕だけではありません。ここにいる感染者たちも同じことを証明できます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "ピカール様、どうかご理解ください。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "あなたのことは大勢の人から聞いている。先生の言うことならば、信じねばならぬか……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "ありがとうございます、ピカール様。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "だが、それとこれとは別だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "貴様ら、許可なく武器を所持して父の領地に進入したことに間違いはあるまい！　禁忌であることは承知の上だな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "今回は、父の領民を守ったことに免じて……"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "この件の責任については、追及しないこととする！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "だがロドスが父と交わした約定は、今この場にて破棄する！"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "……考えて直してくれんかのう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "この件については交渉の余地などない！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "ロングスプリングは他の武装勢力の必要を認めない！　たとえロドスであっても同様だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "私が感染者全員を連れて、安全で適切な場所へと送り届ける。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "貴様らの手出し口出しは無用！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "avg_npc_156_1",
      "text": "ですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "仕方あるまい。今はやめておくのじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "ここがサルゴンの土地である以上、領主に逆らってはならぬ。儂らは今、ロドスを代表してこの場にいることを忘れるでない。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "avg_npc_156_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "41、42……"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "ほかに人は？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "これで全員です……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "大丈夫だ。あんたらに身の危険は無い。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "コーエンさん……アレクサンドルさんも。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "ここしばらくの間、本当にありがとうございました。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "そう言わないで。こちらこそ助けてもらったのだから、感謝すべきなのはあたしたちの方よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "これからどうされるおつもりですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "まだ決めてない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "そんなに悲観的なものではないさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "今後二度と会えないと決まったわけじゃないしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "次に会った時はお前に……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "えっと、あれだ……コボルトの話をしてやらないといけないしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "ハハハ……期待しています。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "先生、これをおぬしに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "これは……源石錐！　受け取れません！！"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "報酬じゃよ。オクフェンの足を治療してくれたじゃろう？　これはロドスからの謝礼じゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "あんなの簡単な応急処置です。これほどまでの価値はありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "いや、これだけの価値があると思っておるから差し出すのじゃよ。儂らのわがままじゃと思うてもいい。受け取ってくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "あ……ありがとうございます、レンジャーさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "それに……皆さんも、本当にありがとうございました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "さようなら。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "こんなことになるとは。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "うむ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "慎重に行動すれば、問題は起こらないと思っておったんじゃがな。むしろ誤解を招いてしまうとはのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "avg_npc_156_1",
      "text": "衛兵隊長があんなにも話が通じない人だなんて、誰も想像できませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_npc_155_1",
      "text": "あのバカ女、頭の中まで筋肉でできてるの？　ああいう奴はBSWにいる分でもう十分だってのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "avg_npc_156_1",
      "text": "それより……これからどうしますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": "avg_npc_012",
      "text": "セーフハウス内にあったものは……基本的にすべて没収されてしまいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "よいよい。少なくとも皆が無傷じゃったのは、不幸中の幸いじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "オクフェン、おぬしも儂らと共に行こうぞい。まずは事務所で記録をつけて、本艦に連絡した後、今後の行動を話し合うとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": "avg_npc_012",
      "text": "わかりました。そうするしかなさそうですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……私は少し心配です。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "何がじゃ？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……あのピカールという女性……彼女こそ、このすべての元凶である可能性はありませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "領主がいつまで経っても現れず、傭兵が感染者たちを拉致しようとしていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……そして今になってようやく衛兵隊長がやってきて、大義名分を掲げて全員を連れ去った。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "よくできた展開だとは思いませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "……確かに一理あるのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……私が尾行して……様子を見てきます。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "あたしも行こう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "いや、人数が増えれば容易に気付かれてしまう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "他の者は先を見越した準備を整えておくんじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "どうしたのじゃ？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "あなたなら私の提案に反対するものかと。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "臨機応変に、じゃ。それに、現地の領主との衝突を避けることは、儂らが何もせぬという意味ではないぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "ちょっとした策が必要な時もあるということじゃよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "avg_npc_166",
      "text": "……わかりました。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "まずは全員を避難場所へ連れて行け。その後、一緒に動けそうな人間を三人ほど連れて来い。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "坑道内に問題があると、私は疑っている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "了解。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "避難所はまだ空きがあるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "いえ、もうあまり。町民の半数が現在避難所にいますから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "入り切らなくなったら上の階を与えてやれ。父上の部屋をな。"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "い……いいんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "もし父上がまだ生きていたなら、きっとこうしている。"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "……わ、わかりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "とにかく、警戒は怠るな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "……待て、私たちが出てきた時、明かりは全て消したか？"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "覚えていませんが……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "！！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "どけ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "うわ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オリジニュータント",
      "speakerId": null,
      "text": "グオォ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "敵襲だ！　町民を守れ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "どこから湧いてきた！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "ここでぐずぐずしてられない！　突破するぞ！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "領主の衛兵",
      "speakerId": null,
      "text": "敵が多過ぎます！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "お前たちは住民を連れて先に行け！　私がしんがりを務める！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "来い！　腑抜けの賊共が！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "ふぅ……これで何体目だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "やっと着いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "ピカール様！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "先生！　どうしてここに？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": "avg_npc_160_1",
      "text": "この先に行ってはダメです！　ご領主さまのお屋敷はもう……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "先生！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "ドラッジ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "今すぐ出てこい！　貴様の首を斬り落としてくれる！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": "avg_npc_158_1",
      "text": "ハハハ……相変わらず声がでかいな、我が愛する姉よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": "avg_npc_159_1",
      "text": "この……この愚図が！　許さんぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": "avg_npc_158_1",
      "text": "ほう？　許さなければどうするというのだ？"
    },
    {
      "type": "sceneBreak"
    }
  ],
