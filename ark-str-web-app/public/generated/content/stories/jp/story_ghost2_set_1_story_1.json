    {
      "type": "dialogue",
      "speakerName": "アイリーニ",
      "speakerId": "avg_4009_irene_1",
      "isRemote": false,
      "text": "……綺麗な名前ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "speakerId": "avg_1023_ghost2_1",
      "isRemote": false,
      "text": "それじゃ、またね。頑張り屋の小鳥ちゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "スペクター",
      "speakerId": "avg_1023_ghost2_1",
      "isRemote": false,
      "text": "……♪　……♪♪"
