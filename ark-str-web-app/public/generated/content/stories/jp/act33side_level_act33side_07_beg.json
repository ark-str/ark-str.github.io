{
  "server": "jp",
  "storyId": "act33side_level_act33side_07_beg",
  "groupId": "act33side",
  "stageId": "act33side_07",
  "title": "顕現せし影",
  "storyCode": "BB-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act33side/level_act33side_07_beg.txt",
  "sourceHash": "83e748dba2b72d41b75a34d4a6a18a0ad57e95f6c86c7560795713989598a1f5",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "管理者権限の暗号化をアクティベート。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "映像番号<color=#FF4200>（0018_admin）</color>……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "記録モード起動……撮影開始。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……長い眠りについている間、我々の故郷は破滅の中に新たな命を育んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "源石は彼らの案内人であり、タロⅡから来たる生命を我々に近しい姿に形作った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "万年の時を越えて彼らと交流することができたのは、幸運だったと思う。あまつさえ、一度は自らをこの大地の一員と見なし、彼らの過去と未来を感じたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "しかし、自分は結局この文明には属さぬ存在だ。テレジアの努力に……不安を感じ始めてさえいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "もしも源石計画が失敗に終われば、いや、たとえわずかでも遅れが生じたら、テレジアやケルシー、そしてこの自分までもがアーミヤに約束したあの未来が実現してしまえば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "この星で育まれた我々の認知する生命はそう多くなく、どれも触れれば弾ける泡沫にすぎないというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "これまでずっと自分に嘘をついてきた。しかし……どうケルシーに説明すればいい？　どうテレジアに、アーミヤに説明すればいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "「君たちの受けている苦しみこそ君たちを救う唯一の方法であり、抵抗をやめるべきだ」と、そんなことをどう彼女たちに伝えればいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "「テラ文明は泡沫の幻影に過ぎず、源石に受け入れられることこそが、唯一の運命を逆転させる方法だ」などと……どう彼女たちに教えてやればいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "血の通った一つ一つの命が、感染者という名でもって目の前で煙のように散っていくのを見届けるのは、とてもつらい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "テラにおいてはとうに見慣れた光景だが、これも結局は命が失われることであり、悲しく残酷だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "あまりに長い間、躍動する生命が発する言葉を聞いていなかったように思う。ゆえに、そんな彼らを心から想定外の産物と見なすことは到底できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "しかしこの目に映るのは、決して戦士の死などではないことにも気が付いた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "彼らは源石の同化プロセスに順応し、死という手段を通じて内なる宇宙の一部となったのだ。それは生命が究極の暗黒を突破する契機とも呼べるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "ならば果たして自分は、彼らの死をうなだれながら弔うべきか……それとも計画がうまくいっていることを密かに喜ぶべきなのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "テレジアは、未来のためにたゆまず研究を続けている。そしてケルシー、我々のAMa-10は、彼女と同様にテラの可能性を信じることを選び、源石に抗い、戦争を止めようとしている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……だが、自分は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "源石計画は、何世代もの人々の努力の上にあるものだ。これまでに我々の同胞は百億千億と失われ、それと引き換えに得られた手段は万年を越えて待つことのみ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "そして万年の時を経た今、火種が自分の手に渡った。そんな灯火を……このまま手放そうというのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "ほんの数年ばかりテラで過ごしている間に与えられた驚きに心動かされて？　テレジアとケルシーが……下した選択を尊重して？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "たとえアーミヤに対して同情心が湧いただけだとしても、常に身勝手なのは、自分自身なのではないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "自分は……救世主として呼び起こされた。しかし実際には、彼らにとっての破壊者でしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "彼女たちは破壊者を、救世主のごとく呼び覚ましたにすぎない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "（咽び泣く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……アーミヤ……ケルシー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……いったいどうすればいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "プリースティス……いったいどうすればいいんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プリースティス",
      "text": "……そんな！　私がどうしてあなたを責めるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリースティス",
      "text": "あなたの不安は理解できるわ。私たちが議論していることは、そもそも「人類」という小さな生命体が介入していい範疇をはるかに超えているもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリースティス",
      "text": "だけどこれが唯一の方法なの。私たちがそう固く信じなくてどうするの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリースティス",
      "text": "もし……再来の時までまだ時間が残されているのなら、私たちで一緒に想像して、実現しましょう。宇宙の境界と万物の形を描くの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリースティス",
      "text": "そして、そんな脆弱なひとときには、あなたにいつもそばにいてほしいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プリースティス",
      "text": "きっといてくれる、そうでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "では、殿下、今回の報告は以上だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "軍事委員会は、私たちがC8からC10エリアまでの村と物資を取り返し、そこに歩哨所を建てるつもりと断定しているようね。こちらの思惑通りよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "しかし……一部の士官がマンフレッドのものとは大きく異なる軍事戦略を見せ始めている。異常事態と言えるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "スパイの情報だと、ナハツェーラーが部隊のテントに出入りしているのを見たという。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "ネツァレム……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "ドクターの意見は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "ドクターは、どんな形であれサルカズの戦神が関与の意をあらわにすれば、俺たちの計画はすべて狂うと見ている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "それじゃあ、あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "……かねてより、強大な王庭メンバーの多くが反撃と暴力を唱える軍事委員会を好んできた。これは周知の事実だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "しかしある種の制約――慣習による暗黙の了解とも呼べるものにより、内戦に率先して参加する王庭は一つとしてなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "カズデルに集う王庭の主たちがもし本当に俺たちとの開戦を決めたのなら、いまだバベルに戻らぬサルカズたちは、今後地図の上でバベルのいかなるマークも目にすることはなくなるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "そしてもっと現実的な話をすれば、王庭の加入によって生じる戦力差も大きな懸念点だ。俺たちを支持する者のほとんどが戦士や兵士ではないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "俺たちの部隊にも、初めて武器を手に取る奴が何人もいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "つまり、正直に言うなら……真相が何であれ、俺たちの状況は急転直下にある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "……わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "引き続きナハツェーラーの王庭の行動を追って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ネツァレムが本当に座視に耐えられなくなったのなら、ドゥカレも同様に動いてくるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "それに、三週続けて「ローズ河畔に船はなかった」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "ローズ河畔は非常に優秀なスパイシステムだけど、彼女たちはどんな人も欺けても、唯一、自らの君主だけは欺けないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "彼女たちをすぐに撤退させましょう。必要なら、カズデルを離れて別の場所で身を潜めるよう指示して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Scout",
      "text": "では俺は先に失礼する、殿下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "王庭……彼らは暴力を行使する最も直接的な権力を有している。ネツァレムは大地を変えられる戦火を約束されたからこそ、喜んで主導権を差し出したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "厄介ではあるが、我々の望むものを実現するには、いずれ直面しなければならない試練でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "……バベルは暴力を一概に否定しているわけではないわ。必要に応じて、暴力でもって私たちの信仰を守らなければならないこともよくわかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "だけどそれは……サルカズがより一層自らを消耗し、この大地に対する恨みを晴らすために自身を燃やすことも意味している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "結局この先にあるのは、行き詰まりなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ああ。軍事委員会を打ち負かしても問題の解決にはならない。憤慨と苦難をむさぼり成長するサルカズに、他の方面から具体的な成果を見せる必要がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "鉱石病と源石に関して、我々は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "どうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "殿下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス＆W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "アスカロン……あなたの傷はまだ完治してないわ。ほかの人を寄越してもよかったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "もう回復した。それと、ヘドリー小隊が巫術解読器の入手に成功した。それの対応が目下の急務なのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "ドクターはすでに敵の暗号の解読に着手している。いくらもしないうちに結果が出るだろう。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "そう……\nイネス、W。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "よくやってくれたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "お褒めにあずかり光栄です、殿下。いち早く敵の通信が解読され、次の行動の計画が立てられることを祈ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "あなたたちの隊長は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ヘドリーは……少しかすり傷を負いました。大したものではなく、今は医務室で治療を受けています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "そういうことなら、あまり時間を取らせちゃ悪いわね。彼のそばにいてあげてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……わかりました。感謝いたします、殿下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "W。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "――はっ？　なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "ヘドリーの所へ行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あー、えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "はいはい、わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ったく、ヘドリーなんて放っといても死にゃしないんだから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "では、殿下、私はほかに用があるから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "……そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "まだあの子にちゃんとした名前を考えてあげてなかったわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "1093年冬\n天気/雨\nカズデル地区　カズデル国境"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドクターは目を閉じ、雨が葉を叩く音を聞いていた。\nポタリ、ポタリ。\nドクターは心の内の苦しみに耐えていた。羽獣がはるか遠い場所で鳴いている……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私の質問に答えるか、ここで死ぬか、選べ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "質問に答えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前はバベルを裏切ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "そもそもバベルに属してなどいない。しかし彼らのための奮闘を放棄するつもりもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "なぜ私に会いに来た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "求めるものがあるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私は名もなき輩には付き合わぬ……悪霊よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前は誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……{@nickname}。Dr.{@nickname}だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……{@nickname}。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "テレシスが武器を下ろす。雨粒が目元のくぼみを伝って大地へ落ちる。\n彼は自らを密会に誘った者には目を向けず、ただ視線を上げると、「英雄」という名の巨大彫刻を見つめた。\nそれは移動都市カズデルを打ち建てた双子を記念する像だ。\n彼の石像は百余年経った今でも、天災や雨風に倒れることなく剣を持ち彼女の傍らに立っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "当時、生まれたばかりの都市の破壊を企てた反乱を彼女が鎮めてほどなくして、我らは喜び祝うカズデルの者たちに、この二つの像の除幕を見届けてほしいと招かれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "（古代サルカズ語）「英雄」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "この像はこれまでも、そしてこれからも何代にもわたって、我々がこの手で引いた国境を見守り、我々の敵に警告を発し、我々の友を歓迎していくだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "私はかつて彼女の像の下で誓った。この剣で彼女のすべての敵を斬り払おうと。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ドクターはテレジアの像を眺め、一瞬たりとも視線をそらさない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "軍事委員会は彼女の敵だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "否。カズデルのいかなる部分も彼女の真の敵であったことはない。私こそが彼女の敵である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "では、お前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "テレシスが顔をフードで隠す人物を見やる。そのコートには汚れのしみができており、コートの裾にたまった水滴がリズミカルに滴り落ちていた。\n水滴は二人の足元の浅い水たまりにぽたりぽたりと波紋を描く。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "この場所を覚えていたであろうサルカズは、ほとんど歴史の中で死んだ。この場所を見つけられる者はもはやほとんどおらぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "一人この地を目指し、長い道のりを歩んで来たのだろう。どれほどの距離を歩いたのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "長い長い距離を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "そうか。お前はマンフレッドご自慢の部隊が作った巫術の暗号を解読したのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "ああ、随分前にな。だが誰にも言っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "テレジアですら、自分が「暗号の解読に着手し始めたばかり」だと信じている。しかし実際のところ、すでに暗号を通じて軍事委員会のほぼすべての作戦計画を把握するに至り……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "こうして君と二人だけで会う機会を作ったというわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "お前は我々にとって極めて大きな脅威となる戦略家であるにもかかわらず、私がお前を殺しはしないと確信しているようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "こちらが提示するものには、十二分にその価値があると確信しているだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "源石を制御できる技術だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "君たちはヴィクトリアの圧力の中でどこまでやれる？　いかにしてサルカズの……ひいてはこの大地すべての現状を覆すつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "その答えを与えてやれる、と言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "随分と大きな口を叩く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "では、お前は私に何を成せと申す。悪霊よ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……バベルを滅ぼせ。テレジアに付き従う者を薙ぎ払い、彼女も君の計画に加えるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "サルカズを軍事委員会が統治するカズデルの下で統一するんだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ドクターは、この言葉を口にする時に自分がどういう感情を持つだろうかと、繰り返し繰り返し考えてきた。\n「バベルを滅ぼせ」……\nしかし実際に言葉が自らの口から放たれた時、むしろ胸のつかえが下りるのを感じた。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ドクターは微動だにせず、テレジアの像を見上げている。一切の感情を表に出さずに。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "私と彼女が今に至るまでカズデルを率いてこられたのは、決して敵の施しがあったからではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "我ら双方のどちらかが完全に失脚せぬ限り、この戦争に真の終結が訪れぬのは明白であるが、しかしその提案をすべき人物はお前ではなかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "続けるがよい。お前の求めるものを語れ、旧時代の悪霊よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……知っていたのか。不思議でもないな、テレジアはかつて君と二百年近くにわたって手を取り合ってきたんだ。そのくらいの予想がつくのも当然か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "こちらの求めていることは……源石の拡大だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "バベルがいくら手を尽くしても、ただこの大地が余命をつなごうと悪あがきする時間を延ばすだけだ、テレシス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "抵抗するにせよ、受け入れるにせよ、どのみち文明は様々な形態で源石に呑まれ、彼女の懐に収まることになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "君は……空を見たことがあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "あの空の外、双月よりもさらに遠くにあるところが、かつての我々の帰る場所であり、我々の眠る地だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "しかし今や、ただ一人残った自分が、こうして君と対話している。サルカズが外敵に対抗するため、死した神々のなきがらを探し求めている時、君たちは一瞬でも疑問に思ったことはないだろうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "神々はいかにして死んだのか、と。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "雨が強くなる。ドクターはフードを深くかぶり直し、像の下に立った。\n像の影がドクターを包み、石像の下の姿は次第に小さくなる。\nテレシスはふと、目の前で一人雨の中に立つ人物が、ますます捉えられなくなったように感じた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "この両肩に課せられているのはサルカズの未来だけではない。何かを滅ぼすことでしか、望み通りの階段を作ることができないのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "自分はそうする。そうするしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "下すべき決断を、あまりに長くためらいすぎた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……何かを滅ぼし、階段を作る、か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "犠牲を随分軽く語るのだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "決して軽くはないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "自分が経験してきたことは、君には想像もつかないものだ。その上で言っているのだと信じてくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "ならば、私が協力することに対する誠意は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "「ザ・シャード」だけでは足りないか？　あれを落とせなければ、聴罪師の助けがあっても君たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "足らぬ。悪霊よ、はるかに足らぬのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "それではお前の命を買うことしか――軍事委員会の指導者テレシスが、定められた敵をここで殺さぬことしかできぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "私には、この戦争を次の段階へと進めるための、より直接的なものが必要なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "バベルの面々の命を守りたいのであればそうしてやっても構わぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "「バベル」が敗北を宣言しカズデルを離れるのであれば、軍事委員会は決して投降者と脱走兵に対する殲滅を仕掛けることはないと約束しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "だが、そのためには何が必要なのか……私の言わんとするところは理解しているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "いや……それは無理だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……ナハツェーラーの王をして興味深いと感ぜしめる悪霊であっても、かように軟弱であったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "テレジアを生かすことと、バベルの者たちを生かしたまま逃がすことは、完全なる相矛盾である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "バベルが徹底的に打ち砕かれ、あの者たちの希望が完全に潰えねば……テレジアは私と共にロンディニウムへと向かうことができぬのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "それが実現せぬのなら、再び軍事委員会による平民や移民、反戦者に対する鎮圧が起こり、またもや新たな分裂が生じるのみ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "それには私の命令さえ必要とせぬ。必ず、自ずと発生することだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "しかしテレジアがそのすべてを嬉々と眺めていると思うか？　否。彼女は最後まで抗うであろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "もう答えはわかっているのだろう。本当により多くの仲間を救いたいのならば……彼奴らに敗北を受け入れさせ、私への投降を促すのならば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "彼奴らの王を殺せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "さすれば、バベルが逃げ延びることを許そう。たとえバベルが崩壊することになろうと、サルカズのものでなくなろうと、力が弱まり隅へと追いやられようと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "「何かを滅ぼし、階段を作る」のだ、{@nickname}。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "お前の言う通り、これは確かに軽い犠牲ではないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "君にとって、この内戦や彼女の死は何を意味する？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "土地の奪還、故郷の再建、差別の解消、種族の復興……こうした常套句をお前は何度も聞いたであろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "どれもあまりに複雑であり、あまりに単純でもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "小さく哀れな種が、自らの運命を掴もうとしている過程にすぎぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "では、その運命の天秤を傾けてみせよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "バベルを滅ぼし、彼らを分裂させ、弱体化し……彼らをかつての生活に戻す。これで少なくとも最後の百年間において、彼らは束の間の安寧を謳歌できる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "そうすれば……テレジアを殺さずに済む……あるいは少なくとも、失われる命は最小限で済む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "暴力を振りかざすのは息が詰まるぞ。お前のサルカズに対する理解は常人よりはるかに勝るが、まだまだ足りぬかもしれぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "私からも一つ質問がある、Dr.{@nickname}。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "大いなる者、神、創造主、サルカズの運命を支配する旧時代の悪霊を名乗る者は、お前一人だけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドクター",
      "text": "……そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "……ならばよい、Dr.{@nickname}。負い目など感じず、お前の決めたことを成せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "高みにいる悪霊を制裁する者がいないことが心配なのであれば、私がお前の罪を裁こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "text": "――サルカズの運命をもてあそぶ者がいなくなる、その時まで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドクターは背後で水たまりが跳ねる音を聞いた。足音は次第に遠のき、弱まっていった。\nテレシスが去った。彼はもうこれ以上ここに留まりたくなかったのだろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "青白い日差しがすでに像の隙間から漏れ出ていた。\nしかしドクターはその貴重な日差しの中から、微塵の温かさも感じることができない。\n「英雄」という名の巨大な像は依然として遠くを望んでいる。しかしその視線を足元へ向けることはない。\n像の足元には、いつまでも立ち去らない一人の人影が残っていた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
