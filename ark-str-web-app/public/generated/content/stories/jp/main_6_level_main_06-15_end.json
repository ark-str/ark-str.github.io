{
  "server": "jp",
  "storyId": "main_6_level_main_06-15_end",
  "groupId": "main_6",
  "stageId": "main_06-15",
  "title": "冬逝",
  "storyCode": "6-17",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_06-15_end.txt",
  "sourceHash": "7489f782b98177f1b3e54a7affb7f7964ba6330a0c138e581699d86e6901f357",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "……フッ……砕けた、か。"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "あの石頭が……どこぞの巫にもらってきたものだ。……私の命を繋ぎ止めることができる、などと言ってたが。"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "一度の戦闘すら持ちこたえられないとはな。フフ、やはり贋物か。"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "私たちの「親子関係」も同じようなものかもしれんな……。そして今のデタラメなレユニオンも……同じようなものだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "speakerToken": "char_017_homura_3#5",
      "operatorId": "char_017_homura",
      "portraitKey": "char_017_homura",
      "text": "うっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "speakerToken": "char_017_homura_3#5",
      "operatorId": "char_017_homura",
      "portraitKey": "char_017_homura",
      "text": "ぐっ……。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "ゴホゴホッ……ブレイズさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "speakerToken": "char_017_homura_3#5",
      "operatorId": "char_017_homura",
      "portraitKey": "char_017_homura",
      "text": "寒流が……消えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "speakerToken": "char_017_homura_3#5",
      "operatorId": "char_017_homura",
      "portraitKey": "char_017_homura",
      "text": "私は大丈夫！　アーミヤちゃん、早く、あの白ウサギを！"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "素晴らしい。お前たちの完勝だ、ロドス。"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "私の兄弟姉妹たちは……私がむざむざ死なせてしまった。"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "私たちには、何もできなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "speakerToken": "char_1505_frstar_1",
      "operatorId": "char_1505_frstar",
      "portraitKey": "char_1505_frstar",
      "text": "私の命には……何の価値もなかった。"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "違う。君の志は彼らに信念を与えた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "speakerToken": "char_017_homura_3#5",
          "operatorId": "char_017_homura",
          "portraitKey": "char_017_homura",
          "text": "……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1#7",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "死にゆく私に、これ以上付き合う必要はない。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "お前たちがまだ救える者たちを救うんだ。急げ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "早く行け。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "あの黒装束の者たちの阻止、メフィストへの追撃、帰る場所を失った感染者の収容……何でも良い。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "往くんだ。そして価値のあることを成せ。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#4",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "……。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#4",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "ドクター……。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自分は残る。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "先に行ってくれ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#4",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "分かりました。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#4",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "ドクター、フロストノヴァさんにあの言葉を伝えてください……。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#4",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "……お願いします。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "本当に……甘い子ウサギだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "似ているな。あの頃のタルラにそっくりだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "死を前にしてそんな奴に会えるとはな。堅い意志で理想を成そうとしている者に……。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君が言っていた責任はどうする！？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "ロドスに入ると言ったのは嘘だったのか？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "お前のことだ。もう分かっているのだろう。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "悪人には悪人としてあるべき姿がある。この結末に、私は不満などない。自業自得さ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "お前たちを傷つけ、レユニオンと共に罪なき龍門人を標的にし、結果としてウルサスの感染者たちの暗い未来の訪れを早めた。そんな者には、ロドスに行く資格などありはしない。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "私の兄弟姉妹は……あの馬鹿者たちは、私が生きることを望むだろうな。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "私が死んだとしても、あの馬鹿者たちには生きていくことのできる居場所が見つかるだろうと考えていた。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "だが、それは間違いだった。彼らは皆死んでしまった。この元から先の長くない私を守るために。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "無念だ。私たちの命は、全部いいように利用されてしまった。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "そして私のこの最期の一時は、自身で勝ち得たものなどではない。これは彼らの血を代償に手に入れたものに過ぎないのだ！"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "この残された僅かな命は……せめて信頼できる者のために使うとしよう。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "ありがとう。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……フッ……仮にもし我々が生き延びたとしても、どこに行けと言うのだ？"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "我々には元より他に行ける場所などない。唯一知る土地といえば、あの凍原だけだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "龍門はウルサスにはなり得ない。同胞と感染者たちを救い出し、暖かく、食べ物も住まいもある場所に連れて行くとしても……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "その場所は龍門であるべきではない。初めから、龍門を目指すべきではなかった。龍門の市民とて同じように苦しい思いで日々の生活を生き長らえているのだから。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "我々が帰るべきは、ウルサスだけだ……我らが祖国に……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "雪……静かに流れる河……風に揺れる松林……深緑の苔……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "この大地は、なんと美しいのだろう……。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "全てを画策したのはタルラだというのか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……そうだ。私の推測が確かならば……既に力を蓄えた陰謀が、虎視眈眈と機会をうかがっている。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "ボジョカスティの老いぼれが、いくらか時間を稼いだとしても、あのタルラがこのような陰謀を画策したからには、必ず何か対策をしているだろう。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "龍門には、もう手出しをする機会はないだろう……ウルサスも成り行きを見守るだけだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "だがまだお前たちがいる。感染者には、まだ希望が残されている。たとえ一縷の望みであったとしても——"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "——タルラを打ち滅ぼせ。彼女の狂気を止めろ、レユニオンがさらに多くの感染者を飲み込まないために。レユニオンに、タルラはもう必要ない。いかなるタルラも必要ない……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "あるいは……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……私個人としての願いだ、彼女を救ってやってくれ。いや、彼女の助けになってほしい。私たちのような数多の感染者の同胞たちと共に……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "あの本物の……泥に塗れながら進み続ける……タルラを……。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "フロストノヴァ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "なん……だ……。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君の父は、君を心から愛していたと思う。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君のために死んだ両親を、君が覚えていたように。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "父が君のためにやってきた全てを、君は覚えている。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "そんなこと……もちろん知っているさ……。ただ……いま私は奴よりも先に、死のうとしているのだ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "もし……奴が私を拾わなければ……どんなに良かったか……。そうすれば……奴も私のために……苦しむことはなかった……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "元から……あれほど苦しい思いを……してきたというのに……。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "苦しい思いをしてきたからこそ、君を大切にしていた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "フフ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……ドクター……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "そう呼んでも……いいだろう……？"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "ドクター……この大地では……我々の選択など……意味を成さないのかもしれない……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "だがそれでも……たとえ結果は変わらなくとも……私は自ら選びたいと願った……。そして……自ら選んだのだ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "この手で拭ったのだ……己の行いが……実らせた果実を……。"
        },
        {
          "type": "narration",
          "text": "フロストノヴァの指があなたの頬をなぞる。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……君の指が、温かい。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "変だな……。お前の顔が……冷たく……感じるなんて……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "私の体温は……もうそれほど……低くないというのか……？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そうみたいだ。鉱石病の症状が消えている。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "温かい手だ、フロストノヴァ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……死を前にして……ようやく……再び人と触れ合えるようになったか……。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤも自分も君がロドスに来ることを望んでいる。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……この私に……本当に……その資格が……あるのか……？"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ただ死んでいけば、過ちを挽回することも叶わない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……それに……応えないのは……非礼というものか……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "どうか……アーミヤに伝えてくれ、Dr.{@nickname}………。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "この大地では……人は一人の力だけでは……何も……成し遂げられない。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "だが……お前は一人ではない……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "今この瞬間から……私がお前の側にいる……。私が……お前たちと共に歩む……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "私も……ロドスの一員となろう……。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ありがとう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "いいや……。感謝したいのは……私の方だ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "お前のその目は……私の古い知り合いに……よく似ている……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "遠い昔に出会った男の子だ……。あの子の兄は……敵の許しを請うために……意思を曲げるくらいなら……吊るし上げられられたほうが……マシだと言ったそうだ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "その意志を継ぎ……あの子は……雪原を越え……ウルサスの地を踏破しようと……目標が異なる我々と別れたが……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "あれは……私が今まで出会った中で……最も理想に生きた者だった……。少なくとも……今までは……そう考えていた……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "だが……お前とアーミヤを見て……理想すらも一つの信念に……なり得ると知った……。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ロドスは一つの信念の元で戦っている。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "レユニオンも……最初は同じだったはずさ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "本当に……よく似ている………。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "お前の目は……あの子に……本当にそっくりだ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "ただお前は……あの子のような……揺るぎなさの代わりに……優しさを持っている……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……もう放していい。兄弟姉妹たちが……私を待っている……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……父さん……私は本当に……馬鹿な娘だったよ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "……でも……許して……。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "彼女は腕から滑り落ちた。\nその口元に誇らしげな笑みを湛えたまま。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
