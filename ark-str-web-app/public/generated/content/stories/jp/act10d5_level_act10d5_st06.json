{
  "server": "jp",
  "storyId": "act10d5_level_act10d5_st06",
  "groupId": "act10d5",
  "stageId": null,
  "title": "いつも通り",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act10d5/level_act10d5_st06.txt",
  "sourceHash": "dc6e948e85b73124a2b30dbab8342889bc2b6fff073f72830b05ec855ca2ee32",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "总集篇 太阳照常升起"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……ミヤ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "えっ？　あ、すみません、ドクター。ボーっとしてしまいました。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "顔色が悪いようだが。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ちょっと気になることがあって。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、この部署異動申請を見てください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "申請者は、ナターリア・ロストワ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "後方支援部から前線への異動を希望しています。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ウルサス自治団の……",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "はい、彼女は自治団のメンバーの中で、唯一後方支援部に所属しています。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "とても仕事ができるようで、後方支援部ではすごく評判が良いんですよ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ドクターも気になりますか？　正直に言うと今回私は、この異動にあまり同意したくないんです。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "えっと、誰だっけ？",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ウルサス人の名前は、ちょっと覚えにくいですよね。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "彼女は以前私たちがチェルノボーグから救出した難民の一人で、唯一の貴族です。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ズィマーさんがリーダーをしているウルサス学生自治団の一員でもあります。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ズィマーさんたちがオペレーターになったのは、彼女たち本人の要望があってのことですが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "最初、私はとても反対していたんです。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼女たちは救出されたばかりだったから……",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "はい。だから初めは本人たちの意向であっても、ケルシー先生を説得して却下しようと思っていました。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ただ……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "彼女たちは今、定期的にカウンセリングを受けています。報告を見る限り、多少のトラウマは残っていますが、全体としては問題なしという状態です。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ただ……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "アーミヤの判断を信じている。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ありがとうございます。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ですが……",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "なんと言うか、どう説明したら良いかわかりません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ドクター、ナターリアさんの様子を見てきていただけますか？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "わかった。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ではよろしくお願いします、ドクター。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "お手数をおかけしますが、ドクターにしかお願いできないんです。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "面倒だな。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "ドクター、これはとても重要なことなんです。面倒でもどうかお願いします。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "text": "そこまで真面目に観察しなくても大丈夫ですから、仕事外の気分転換だと思ってどうか。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あ、でもその前にお昼休みですね。そんなに急がなくても、食事が済んだ後で問題ありませんので。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "text": "おい、ドクター。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "何か用か？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ズィマー",
              "text": "なんでもない、ただ見かけたから声をかけただけだ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ズィマー",
              "text": "おい、とぼけてんじゃねぇ。聞こえただろ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ズィマー",
              "text": "オマエは忙しいんじゃなかったのか、なんでこんなところでブラブラしてんだよ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "やあ、ズィマー。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ズィマー",
              "text": "暇なのか。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "text": "アタシがこれから行く任務は、オマエみたいにブラブラする余裕はないんだけどな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "ズィマー、出発前はウロウロするなと言っただろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "ごきげんよう、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "さあズィマー、休憩室に戻れ。そろそろ時間だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "text": "フンッ、いつかアタシが隊長になってオマエをあごで使ってやる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "text": "オマエもだ、ドクター。いつかオマエを超えてやる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "その志や良し。だがせめて私の片腕に敵うようになってから言うのだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "そしてドクターを超えるとなれば、うむ、全力の私に勝利してから言うと良い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "text": "チッ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "そうだ、ドクター。もう知っているとは思うが、念のため説明しておくと、ここ最近は私が新人小隊の引率をしているんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "では、要件がなければ私はこの辺で……",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ニアール、ズィマーのことはどう思う？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "ん？　ズィマーか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "うむ……先程見た通りだな。言うことを聞かず、慇懃無礼だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "戦士と言えどあの年頃であれば、自分が何と戦っているか、何のために戦うべきかがわからないのはよくあることではあるが――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "彼女はその傾向が明らかに強い。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "彼女からはとても大きな迷いが感じられる。その正体を知ることはできないが、悪い傾向であることは間違いない。これから私が念入りに正していかなければならない部分だ。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "つまり、彼女が凶暴なのは外面だけ？",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ニアール",
              "text": "その通りだ。外面の乱暴さはある種の防御壁だろうな。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ニアール",
              "text": "内側に守られている心が弱いものであると断定はできない。しかし彼女の凶暴さは、私の前ではひとたまりもないということは間違いないだろう。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ニアール",
              "text": "心配するな、ドクター。彼女はまだ子供だ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ニアール",
              "text": "彼女はチェルノボーグ出身だと聞いた。嫌な思い出が色濃く残っているのかもしれないが、彼女に未来がある。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "彼女とは仲良くなりたいのだが。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ニアール",
              "text": "フッ、ドクター、慌てなくていい。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ニアール",
              "text": "わかっているだろう、彼女はあなたのことを嫌ってはいない。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ニアール",
              "text": "と言うよりも、彼女は自分に親しくする者に対して、無意識に攻撃的になっているように思える。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "それにドクター、私もあの子のことは嫌ってはいない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "むしろ気に入っているんだ。彼女はある種の純粋な正義感を宿している。たとえ心に迷いがあったとしても、その実直さゆえに、大きく道を踏み外すことはないだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "それはとても貴重な素質だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "おっと、そろそろ出発の時間だ。では、今度こそ失礼する。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "あれ、ドクターだ！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "こんにちは、グム。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "グム",
              "text": "こんにちは！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "グム",
              "text": "まさか見えてない？　グムが小さすぎるのかな！？",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "グム",
              "text": "ドクター、おーい、グムだよ！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "あれ、グムだ！",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "グム",
              "text": "ドクター、今日はごきげんだね！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "ドクターは食堂にご飯を食べに来たの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "グムはねえ、最近あんまり任務がないから、キッチンを手伝ってるんだー。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パフューマー",
          "text": "グムちゃん、香料を持ってきたわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "あっ、ありがとうパフューマーお姉ちゃん！　そこに置いといて！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "パフューマーお姉ちゃんも食堂でご飯？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パフューマー",
          "text": "いいえ。私は自分の作業室で自炊するほうが好きなの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "ええっ、グムも食べに行っていい？　パフューマーお姉ちゃんの香料の使い方を勉強したい！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パフューマー",
          "text": "フフ、もちろんよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マッターホルン",
          "text": "グムさん、お手すきならこちらのお手伝いをお願いします。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "はぁい！　今行くよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マッターホルン",
          "text": "ウンさんが任務で出ているので、人手不足で手が回らなくて。この鍋は任せますね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "うん、わかったよ、マッターホルンおじさん！　あ、パフューマーお姉ちゃん、お部屋に行くのはまた今度にするね。ドクターもたくさん食べていってね！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パフューマー",
          "text": "ええ、いつでも大歓迎よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "おっ、今日はグムちゃんが作ったメシを食えるのか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "支援オペレーター",
          "text": "クソっ、さっき食べたばっかりなのに！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "支援オペレーター",
          "text": "今日はツイてないな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "はは、じゃあ俺はもう一杯食べるぜ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グム",
          "text": "みんな慌てないで、ちゃんと全員分作るから！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パフューマー",
          "text": "グムちゃんは本当に元気な子ね。ねぇドクターくん？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そうだな。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "確かに！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "パフューマー",
          "text": "前に一度私の作業室で居眠りをして、心配になる寝言を言っていたから気になってはいたんだけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
