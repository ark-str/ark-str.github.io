{
  "server": "jp",
  "storyId": "story_yuki_set_1_story_1",
  "groupId": "story_yuki_set_1",
  "stageId": null,
  "title": "忍びの道",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_yuki_1_1.txt",
  "sourceHash": "c27842de0180723dd020c4921b4a8ae3feb7cc203d012968def3c725c5047be6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "おユキ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "ここに。"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "イェンウーには話しましたが、これからあなたには、オペレーターとしてロドスという製薬会社に行ってもらいます。"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki#2",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "ロドス？"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "ええ、聞いたことくらいはあるでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "チェン殿と深い関わりがあるということだけは。"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "姫は、このシラユキにチェン殿の護衛に行けと？"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "ええ、それもあります。あれは感染者が築き上げた組織ですから。でもフェイゼなら自分でなんとかできるでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki#4",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "感染者……姫は信頼できるとお思いで？"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "ええ、安心なさい、気を付けて観察しましたが、組織を率いているのはなかなか良い子のようでしたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "あのような子が束ねているのですから悪い会社ではないでしょう。信頼に値すると判断します。というわけで、これは好機です。"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki#2",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "好機？"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "ええ、ユキちゃんは幼い頃から私に付き従い、龍門に来てからもそばを離れたことはありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki#5",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "それが我が使命でございますれば。"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "だからです。あなたも外の景色を見て来なさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "シラユキが必要とするのは姫の見ている景色だけです。"
    },
    {
      "type": "dialogue",
      "speakerName": "フミヅキ",
      "speakerToken": "char_2006_weiywfmzuki_1",
      "operatorId": "char_2006_weiywfmzuki",
      "portraitKey": "char_2006_weiywfmzuki",
      "text": "ユキちゃん、これは命令です。お行きなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki#4",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "……御意。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シラユキ",
      "speakerToken": "char_118_yuki",
      "operatorId": "char_118_yuki",
      "portraitKey": "char_118_yuki",
      "text": "我が名はシラユキ、姫の命によりチェン殿の補佐に参上した。御身の指示にも従おう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "やあ。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……"
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……"
            }
          ]
        },
        {
          "label": "ようこそ！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "4",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "シラユキ",
          "speakerToken": "char_118_yuki",
          "operatorId": "char_118_yuki",
          "portraitKey": "char_118_yuki",
          "text": "……"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "5",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "数日、観察した。ドクターは変人。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "お湯を使って直接口内で即席食品を加熱する。天才。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "しかしこの者、指揮能力と各業務の処理能力は確かに相当なもの。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "ロドスは、見かけでは判断できぬ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "表面上は製薬会社、しかし実態は民間軍事会社ともいうべき組織である。かなりの実力を有し、ウェイ殿がこの会社と協力すべしと言うのも頷ける。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "姫は明言なさらぬが、チェン殿がここにおられるからには、チェン殿を守護しつつ、私にこの組織を調査しろということであろう。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "ドクター以外に、ここにはあと二人の指導者がいる。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "アーミヤにはすでに会った。姫の仰るように、良い方だった。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "しかし指導者であるからには、人が良いだけではないだろう。気は抜けぬ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "もう一人のケルシーという者にはまだ会っていない。他の者の話からすれば、かの者こそこの会社の核心となる人物。知っておく必要がある。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "艦内の大まかな通行可能区域は頭に入った。時刻、午前一時。行動に移す。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "潜入。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "ロドスの配管設計は悪くない。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "秩序立ち、四方に通ず……それに加え、実に適切な監視システムである。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "だがこの程度、些事にすぎぬ。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "通路と宿舎を繋ぐほとんどの出入り口が厠であり、一部の窓だけが宿舎の内側を確認できる……実に合理的だ。"
            },
            {
              "type": "dialogue",
              "speakerName": "？？？",
              "speakerToken": "char_2013_cerber_1#3",
              "operatorId": "char_2013_cerber",
              "portraitKey": "char_2013_cerber",
              "text": "ふぁ……クマちゃん。おいらお肉食べたいよぉ……"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "ケオベ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "寝相が悪い。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "ミッドナイト",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "ふぅ……よし、今日の訓練もこれでノルマ終了だ。"
            },
            {
              "type": "dialogue",
              "speakerName": "ミッドナイト",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "遅くなったな。明日は任務はないけど、スキンケアをして早く寝ないとね。"
            },
            {
              "type": "dialogue",
              "speakerName": "ミッドナイト",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "やれやれ、オペレーターになってからというもの、身だしなみが随分とおろそかになってしまったな。"
            },
            {
              "type": "dialogue",
              "speakerName": "ミッドナイト",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "でもまあ、止むを得ないか……これも必要な犠牲だから。"
            },
            {
              "type": "dialogue",
              "speakerName": "ミッドナイト",
              "speakerToken": "char_283_midn_1",
              "operatorId": "char_283_midn",
              "portraitKey": "char_283_midn",
              "text": "それにそこまで繕わなくても、俺ってもう十分にカッコいいしね。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "（悪寒）"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "コードネーム、ミッドナイト。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "ナルシスト。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "だが……確かに、いい体をしている。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "ドーベルマン",
              "speakerToken": "char_130_doberm_ex",
              "operatorId": "char_130_doberm",
              "portraitKey": "char_130_doberm",
              "text": "……む？　もうこんな時間か。"
            },
            {
              "type": "dialogue",
              "speakerName": "ドーベルマン",
              "speakerToken": "char_130_doberm_ex#4",
              "operatorId": "char_130_doberm",
              "portraitKey": "char_130_doberm",
              "text": "まあいい。クルースたちの訓練プランの構成がもう少しだ。"
            },
            {
              "type": "dialogue",
              "speakerName": "ドーベルマン",
              "speakerToken": "char_130_doberm_ex",
              "operatorId": "char_130_doberm",
              "portraitKey": "char_130_doberm",
              "text": "若者の成長速度は確かに目を見張るべきものがあるな。ロドスに来たばかりの頃とは大違いだ。"
            },
            {
              "type": "dialogue",
              "speakerName": "ドーベルマン",
              "speakerToken": "char_130_doberm_ex#2",
              "operatorId": "char_130_doberm",
              "portraitKey": "char_130_doberm",
              "text": "フッ、まあ私が要求するレベルにはまだ程遠いがな。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#5",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "ドーベルマン教官。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#5",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "見た目は厳しいが、内面は優しい。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "ほとんどの者がすでに就寝中だ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……ロドスのオペレーターの環境適応率はかなり高いと見た。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "確かに姫が仰っていた通り、良き場所である。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……前方にもう少し進めば宿舎区域を抜ける。慎重に行動すべし。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "ロサ",
              "speakerToken": "char_197_poca_1#3",
              "operatorId": "char_197_poca",
              "portraitKey": "char_197_poca",
              "text": "ハァ……ハァ……"
            },
            {
              "type": "dialogue",
              "speakerName": "ズィマー",
              "speakerToken": "char_115_headbr_9",
              "operatorId": "char_115_headbr",
              "portraitKey": "char_115_headbr",
              "text": "ナターリア……いや、今はロサか。さっさと休めよ。"
            },
            {
              "type": "dialogue",
              "speakerName": "ロサ",
              "speakerToken": "char_197_poca_1",
              "operatorId": "char_197_poca",
              "portraitKey": "char_197_poca",
              "text": "ふぅ……先に休んでていいわよ。私はもう少しやっていくわ。"
            },
            {
              "type": "dialogue",
              "speakerName": "ズィマー",
              "speakerToken": "char_115_headbr_9#2",
              "operatorId": "char_115_headbr",
              "portraitKey": "char_115_headbr",
              "text": "……しょうがねえ、もう少し付き合ってやるよ。"
            },
            {
              "type": "dialogue",
              "speakerName": "ズィマー",
              "speakerToken": "char_115_headbr_9#2",
              "operatorId": "char_115_headbr",
              "portraitKey": "char_115_headbr",
              "text": "アタシがオマエを生かしたんだ、戦場で簡単に死なれたら、アタシが恥をかくからな。"
            },
            {
              "type": "dialogue",
              "speakerName": "ロサ",
              "speakerToken": "char_197_poca_1",
              "operatorId": "char_197_poca",
              "portraitKey": "char_197_poca",
              "text": "フフッ、ならお願いするわ。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "二名のウルサスの学生、以前に収容された難民の模様。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "チェルノボーグ事変の生き残りだろうか？"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "二人の幸運を願う。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "む？　あれは……"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "speakerToken": "char_003_kalts_1",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "アーミヤ、今日の業務はこのくらいにしておけ。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#6",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "はい、ケルシー先生。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "この時間、ドクターはもう寝てるのでしょうか？　ちょっと見てきます。"
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "speakerToken": "char_003_kalts_1",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "Dr.{@nickname}はやるべきことくらいちゃんと自分でわかっている。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "そうなんですが、ドクターの健康もとても大事ですから。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#3",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "ドクターの様子を確認したら私も休みます。それでいいですか、ケルシー先生？"
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "speakerToken": "char_003_kalts_1#4",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "……好きにしろ。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#10",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "はい！"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "これがケルシー先生とやらか……"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "speakerToken": "char_003_kalts_1#3",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "……"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "こちらを一瞬見たようだが、気付かれたのか？"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "ケルシー",
              "speakerToken": "char_003_kalts_1#2",
              "operatorId": "char_003_kalts",
              "portraitKey": "char_003_kalts",
              "text": "……"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "（ただの偶然か。だが今し方の感覚は一体……）"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "まあ良い、続けよう。"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "（む？　前方から強烈な騒音が……方向から推測して、エンジニア部か。）"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "ちょっとちょっと、嘘でしょ！　どう見てもここはそのままキスすべきでしょ！？　ヒロインがためらう理由はどこにあるの！？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "チェッ、ないなこれは。こんな展開一回やれば十分でしょ？　毎回同じネタの使い回しって、脚本家の人、頭大丈夫なの？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "うっわぁ、あたしがいっちばん嫌いな流れに……道理で七シーズンも出したのに評価がどんどん下がっていくわけね。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "こんなのただの時間稼ぎじゃない！"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "……くっそー、でも主人公はやっぱりイケメンだな～。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#4",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "まあいっか、もうちょっとだけ我慢しよ。最後にあっ、というどんでん返しがあるかもしれないし！"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "チーフエンジニアのクロージャ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "聞くところによると、ロドスの艦船の設計は彼女が一手に引き受けたとのこと。驚愕だ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "（小声）しかしこのドラマ、本当にがっかりさせるのはまだそこではない。第四シーズンに、突然、主人公のライバルが登場する。そこからが悪夢だ。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "えっ？　嘘でしょ！？　今のでもう十分ひどいのに！"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……気付かれた！？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "あっ、しまった……つい返事をしちゃった。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "まあいいや。降りてきなよ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……"
            },
            {
              "type": "sceneBreak"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……いつからだ？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#5",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "最初からだけど？"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#4",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "あぁ、誤解しないで。キミの忍者としての腕は確かだから。でもあたしはキミがこういうことするって最初から知ってたんだよねー。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#3",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……これは個人の行動であり、いかなる者とも関係ない。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "うん、それでいいんじゃない？　っていうかさ、緊張しないでよ。あたしがキミをスパイだと見なしてると思う？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "キミが来た時に、フミヅキ姫がアーミヤに電話くれたんだってさ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#2",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "キミを寄越したことに裏はないけど、キミは真面目だから余計な気を回して何かしでかさないか心配で、注意を払ってほしいって、わざわざアーミヤに言ったらしいよ？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "しかも、アーミヤにキミの行動パターンを教えてくれてたんだ。だからあたしも一応キミには気を付けてたってわけ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……この件は姫とは関係ない。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "キミの立場なら、実際のところはどうでもそう言うしかないよね。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#4",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "確かにあたしが言ってることにも信憑性はないけどさ。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "でももしキミが本当にスパイだと疑われてたら、この前の部屋でケルシーに始末されてたよ？"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#2",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "今回は初犯だし、この件でキミがどうこうなるっていうのは心配しなくていいよ。フミヅキ姫にも迷惑がかからないことは保証する。そこは信じてもらうしかないけどね。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "ただ、さっきみたいな方法でロドス内を移動するのはオススメできないな。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "それから、核心エリアには絶対、ぜ～～ったいに入れないから。少なくとも配管を通ってなんて間違いなくダメ。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "あとね、他人のプライバシーを覗くのもよくないよ？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "それにキミ、こんなことして疲れないの？"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "疲れない。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "だが、もうしない。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#2",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "それで別の方法を探しに行く。でしょ？"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki#4",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……しない保証はできない。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#6",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "うわぁ、ケルシーのところにキミを放り出してやりたいよ。よその忠臣って、本当に扱いが面倒くさいね。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "じゃあ、ケルシーからの伝言だけ伝えておくよ。「君は君の方法でロドスを観察してもいいが、ロドスも君を観察している」だそうだよ？"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "……分かった。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "あのさ、夜に暇を持て余してて動き回りたくなったら、その辺をうろつくなんてことしないで、あたしのところにおいでよ。一緒にドラマでも見よう？"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "さっきの感じだと、キミはこっちのことに詳しそうだし、ロドスってアウトドア派ばっかりでさ、なかなか趣味が合う人が見当たらないんだよね～。ほんと息が詰まっちゃうよ。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "では一つ忠告しよう。先ほどのドラマは、これ以上見る必要も価値もない。"
            },
            {
              "type": "dialogue",
              "speakerName": "シラユキ",
              "speakerToken": "char_118_yuki",
              "operatorId": "char_118_yuki",
              "portraitKey": "char_118_yuki",
              "text": "おすすめを紹介することも吝かではないが、ここにあるかは知らぬ。"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#5",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "いいよ、いいよ！　それよそれ。そういう話がしたかったんだよ！"
            },
            {
              "type": "dialogue",
              "speakerName": "クロージャ",
              "speakerToken": "char_007_closre_1#4",
              "operatorId": "char_007_closre",
              "portraitKey": "char_007_closre",
              "text": "教えて教えて？　今はないものでも何とかして探すから一緒に見ようよ！"
            },
            {
              "type": "dialogue",
