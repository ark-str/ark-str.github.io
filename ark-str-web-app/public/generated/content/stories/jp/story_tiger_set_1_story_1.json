  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 因陀罗"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "a.m. 8:27 天気/晴天\nロドス本艦 訓練場"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "準備はいいかな？　それじゃあ、行っくよー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ざけんなぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "手ぇ出す時に声掛けるバカがいるか！？　あぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "くっ……なら、こいつを食らえ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ちっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "枕よりも柔らけぇ拳だなぁ、おい。二日凍らせた黒パンのほうがまだ硬ぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "ぐっ……スピードはぼくの方が上のはず……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "なのに……どうして当たらないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "無駄だ無駄！　お前のやることは全部無駄だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ったく……誰だよ、お前にケンカを教えたバカは？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "近接戦闘なら……父さんに……あのね、父さんはすごい警察官なんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はぁ？　口を開けばすぐ父さん、父さんって……ガキかよお前は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "隙あり！　へへっ、よそ見してると危ないよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "おっ、今のはなかなかサマになってたじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だが、こいつはどうだぁ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "（そんな！　よ、避けられない……！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "まさか……あんな角度から拳が来るなんて……！　それ、なんて拳法なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はぁ？　拳法？　んなもん、ケンカで使うわけねーだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "っつぅかよ。べらべら喋ってる暇があんなら、少しは実力を見せてみろや！　こちとらまだまだ暴れ足りねぇんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "くっ……ますます速くなってる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "おせーなぁ！　遅すぎるぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "オラァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "（っぶなー……もうちょっとで目に当たるとこだった……！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "ふぅ……ふぅ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "（どうしよう、反撃する暇がない……しかもお腹にもろ食らったし……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "つまんねー……マジでつまんねーなあ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……お前、まさかこの俺を下に見ちゃいねーよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺はマジで殴りかかってんだぞ？　なのに、いちいちもたついた動きなんかしやがって……マシなのは構えだけかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "いいかガキ、よく聞け。さっきの拳はな、俺の鼻を狙うべきだったんだ。わかるか？　ここだ！　ここをガツンと一発食らわせれば鼻血がぶわっと出るぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "はぁ、はぁ……ぼく……は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "敵の血しか……流させるつもりは……ないよ……そう、父さんに……教えられたから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あー、うっぜぇな！　くだんねぇ御託ばっか並べてんじゃねーよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "これはケンカだぞ？　なのに、あれこれ考えてどうすんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "……ぐぅっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はんっ……殴り甲斐だけはあるよなあ、お前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "こんだけ殴られりゃ、普通ビービー泣きながら許しを乞うはずなんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "ぼくは……そんなこと……しない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "確かにきみは……強いよ。でも……ぼくを甘く見てもらっちゃ……困る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "なんだ、少しはおもしれーことが言えんじゃねーか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "そんじゃあ、その逃げ出さねぇ根性に免じて……今、楽にしてやるよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "そこまでだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "なっ……俺の拳を止めただと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "こいつは……鞭か？　へぇ……お前、なかなかやるじゃねーか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "ドーベルマン先生……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ジャッキー、お前は下がってLancet-2の処置を受けろ。そしてそれが済んだら、医務室へ向かえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "でも、訓練が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "午前の訓練は欠席を許可する。ただし、今回は特例措置だ。次はないと思え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "それともう一つ。ロドスにおいても、訓練場は戦場そのもの。訓練の際は目の前の相手を敵と思え。敵前では、お前の優しさは弱点にしかならん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "次も全力が出せんようなら、訓練を追加する。私からは以上だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "……！　はいっ、先生！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "それとインドラさん！　今日はぼくの訓練に付き合ってくれてありがとう！　次はもっとカッコイイとこ見せてあげるから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……ちっ、興醒めもいいとこだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "待て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あぁ？　お前も俺とやり合いたいってのか？　いいぜ、お前となら少しは楽しめそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "生憎、ままごとに付き合うつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ままごと……？　お前、今ケンカをままごとって言ったか？　なんか勘違いしているみてーだが……俺がどう生きてきたのかを知ってて、んな口をきいてんのか？　ああ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……オペレーター・インドラ。お前の言動は、私からすれば幼稚が過ぎる。まるで赤子だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "それにお前は既に生徒ではない。ゆえに、私が指導してやる必要もないのだが……少しだけ注意しといてやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "まず、一つ目――真っ当な心構えができるまでは、二度と訓練場に足を踏み入れるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はぁ？　なんでだよ？　喧嘩がしたけりゃここへ行けって、あのウサギから聞いてきたってのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "お前の発言に含まれた誤りを全て訂正してやれるほど、私も暇ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……二つ目だ。訓練場はストレスを発散させる場所ではないし、オペレーター間の手合わせも相手に後遺症を与えることを目的としていない。覚えておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……だが心構えができたら、また訓練場へ来ても構わん。新人たちへの実践指導には、お前の戦闘経験が役に立つだろうからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "しかし、今はその時ではない。直ちに出て行け。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はんっ、ここには口だけの奴しかいねーのか。ったく……どいつもこいつも面白みってもんがねーな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "毎日ここに閉じこもってばっかで、喧嘩もろくにできねぇなんて……ほんっと最悪だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "出てくる料理も趣味が悪ぃしよ……俺ぁ肉とジャガイモがありゃ十分だってのに、あれこれ弄っては調味料なんざ加えやがって……噛んでるうちに飽き飽きしちまうぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "そして、極めつけはこの部屋だ！　冷たい鉄板で狭っ苦しいスペースを囲んだだけじゃねぇか！　これが人の住む場所か！？　牢獄の間違いだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だああ～～～～っ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "（ドカン――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あははっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……あ？　誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ほらほら、頑張れ～。あとちょっとでその壁にも穴があくかもしれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はっ、よりにもよって一番つまんねーやつのお出ましか。おいモーガン、そんなとこ突っ立ってないで入ってこいよ。お前を一発ブン殴れば、ちっとはストレス発散になりそうだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そう言われて入るバカはいないでしょ。まっ、拳は当たらずとも、次に壁を殴ったら巻き込まれるくらいの可能性はあるかもだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "それにさ、あんたと違ってこっちは忙しいんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ちっ、お前の用事なんざ知ったことかよ。どうせ昔と同じで、そこらを走り回ってるだけだろうが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "やだなあ、拗ねてるの～？　どんなに忙しくっても、吾輩は可愛いハンナちゃんを忘れたりなんかしないって～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "それより聞いたよ～？　訓練場で大暴れして、追い出されちゃったんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……からかいに来ただけだろ、お前。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "酷いなぁ～。そう言われたら悲しくなっちゃうじゃないか～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "まっ、どうせ心配で様子を見に来たと言っても信じてくれないだろうし……ここはヴィーナの代わりにあんたが騒ぎを起こしてないか確認しに来た、ってことにしておこうかな～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "まさか……訓練場の件を王が知ってるってのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そんな神経質になんないでよ～。言っておくけど、吾輩は告げ口なんてしてないからねぇ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "でもね～、人様の船に乗ってる以上、あんたのやったことが彼女の耳に入らないとでも思う？　彼女を誰だと思ってんの～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ちっ、悪かったよ！　俺が悪かった、それでいいんだろ！　……今すぐ王に会いに行かねぇと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "まぁまぁ、そう慌てなさんな。ここまで長居させてもらってるんだもの。なら、ロドスの人たちの性格くらいよく知ってるでしょ？　それにヴィーナもよくしてもらってるから、へーきへーき。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……そうだな。それは認める。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "たしかにここの連中は悪人じゃない。今まで見てきたような……性根が腐ってる連中とも、弱すぎる連中とも違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "けどな、だからと言って俺がここの生活を気に入らなきゃなんねぇ理由にはなんねぇだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ん～？　口ではそんなことを言ってるけど、本当はただ慣れてないだけじゃないの～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……ッ！　……ああそうだよ！　こんなん慣れるわけねぇだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "毎日隠れて逃げ回って、寝床が見つからねぇまんま何日も過ごして……それでやっと寝床にありつけても、近づく敵を警戒しなくちゃならねー生活……そんな掃き溜めから突然抜け出したんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "今思えば、ちょっと懐かしい気もするよねぇ～。あの頃のあんたってば、寝てると思ってもちょっとした音ですぐ目をかっ開いて、何もないとこに拳を振るってたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……こっそり近づいてきたのはどこのどいつだよ。言っとくが、お前の目に痣を作らないでやったのは俺の優しさだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あはははははっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "今はいつでも寝床を得られるどころか、あったけぇ食い物にまでありつけるようになった。しかも食ってる最中、向かいのやつが突然武器を構えて襲いかかってくる心配もねーしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……ロンディニウムを離れてから、こんな暮らしを送ったことなんざ一度もねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "それによ……もう丸14日も血を見てねぇ。モーガン、こんな生活どう慣れろって言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ほ～らね。あんたが言ったことは全部、ヴィーナが吾輩たちをロドスに連れてきてくれたことの正しさを証明してるじゃないか～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "吾輩たちが必要としているものを、ロドスは全部提供してくれる。それは寝床や食べ物に限ったことじゃない……あんたはいつも吾輩の言葉に無関心だったけど、本当は分かってるんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……クソッ、わーってるよ。誰が敵かなんざ知らなくても、何と戦うべきかが分かりゃあそれでいい。誰が本当の味方で、王の助けになれるのかってことくらい、俺にだって見分けられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だが、王についてきた理由まで忘れたわけじゃねぇぞ。王が剣を抜く姿を見る……そのためなら、俺はなんだってするつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "けどな、モーガン……何故か知らねぇが、最近俺の夢に残してったガキどもがよく出てくるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ふむふむ。それは、あの子らのことが心配だからじゃないのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺がんなことするような奴に見えるか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "それ、本気で言ってる～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……知るかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺が知るわけねぇだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あいつらがどう過ごしてるのか、怪我でもしてねーか、病気になってねーか、それに……ちょっかい出してくるやつがいねーか……特に、あの連中が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……まぁ、心当たりがあるとすりゃ……柔らけぇベッドに寝転がるたびに、あいつらは今頃どうしてんのかって考えちまってるからだろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あんたは、誰よりもあの子たちのことを分かってるよ。長い間、一緒に過ごしてきたんだもの。もはや吾輩たちはお互い、自分の体の一部のように分かり合ってると言っても過言じゃないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "忘れたわけじゃないだろう？　小さい頃からロンディニウムで過ごしてきた吾輩たちは、果てのない争いの中で生き延びる術を誰よりよ～く知ってるってことをさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……ああ。だからこそ……俺は、あいつらを信じてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "――あいつらが俺を信じているのと同じように、な。モーガン、お前だって覚えてるだろ？　あいつらは、どいつもこいつもチビの頃から俺たちの後についてきたことをよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ははっ、もちろんさ。懐かしいねぇ～。まっ、あの頃はあんたも吾輩の後ろにいたけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "おい、話を逸らすな。仮に俺がお前の後ろにいたとしても、それはお前の足が速いせいだからな。言っておくが、俺はいつでもお前の尻を蹴飛ばしてやれたんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "とにかく、だ。あの頃……俺たちは誓い合っただろ。いい暮らしなんざできなくてもいい。たとえどんな暮らしになるとしても、皆で一緒に生きていこう、ってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "なのに今は……今は……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そんなにくよくよするもんじゃないよ～。まさか今更になって後悔してるのかい？　ヴィーナとここまで来たこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "インドラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "作戦内容は以上だ。頭に叩き込んだか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "大体はわかった。けど、最後のほうは……なあ、ヴィーナ。事が済んだら俺はどこに行けばいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "それは、貴様自身に選ばせたいと思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "この位置に来て、私と合流するもよし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "またはその位置へ行き、貴様を待つ彼女たちと合流するもよし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "その場合、彼女たちを連れて速やかに移動し、貴様らの為すべきことを為せばいい。だが、二度とここへは戻るな。私を探す必要もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ヴィーナ……それって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "……ああ、去るべき時が来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "外の奴らか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "暗雲が近付いている。貴様も気付いているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ちっ、鼻水みてぇにしつけぇ連中め！　一人で来ようが大勢で来ようが、俺が蹴散らしてやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "既に縄張り争いの範疇を超えているのが実情だ。怪我人も増え続けていることだしな。局面はじきに、我々の力では制御できない事態へと発展するだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "だが、我々もただ黙って敗北を喫するわけにはいかない……そうなる前に、主導権をこの手に握っておかなければ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "そうか。そういや、モーガンのやつも同じことを言ってたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だが――俺はあいつとは違う。あれこれごちゃごちゃ考えるのは好きじゃねぇ。だからよ、これだけ教えてくれ……「その日」が来たんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ああ……今日が「その日」だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "私がここに残れば、貴様ら全員が危険に晒されるだろう。臆病者の誹りを受けるのは忌々しいが、それ以上に無用な犠牲が出ることを私は忌み嫌っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "それに、争いが止むことはない……ロンディニウムにおいても、この大地においてもそれは同じことだ。我々が為すべきことはまだ無数に残っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だったら、俺はヴィーナについていく！　お前がいる場所が、俺のいるべき場所なんだ。俺の拳が必要になる限り、俺はお前の傍を離れない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "インドラ。貴様は私が最も信頼している友人だ。私は貴様と共に戦う日々を心から享受してきた。だが……どうかわかってほしい。私は貴様についてこいと言っているわけではないのだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "私自身、いつここに戻ってこられるかも分からない。もし私についてくるとなれば同じ境遇に置かれることになるだろう……そうなれば、日々転々とする生活を送ることだって有り得る……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "待ち構える困難の数々は、私が口にせずとも想像はつくはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "それに……私はまず、貴様に聞くと決めていた。私がグラスゴーに入るまで、彼女たちのリーダーは貴様だったのだからな。故に貴様は、彼女たちのために残る可能性が高いと私は見ている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……言ったはずだ。んなこと、考える必要はねぇってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ヴィーナを主と認めたあの日から、俺はこの先どう生きるのか決めたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "お前が行く先が、俺の行く先だ。俺の両手はお前の敵を薙ぎ払い、お前の友を抱き寄せるためにある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "今日ここでヴィーナが俺に残れと言ったなら、俺は何も言わず残っていただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "だが、お前は俺に問いかけた――なら、これ以上の問答は不要だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺の答えは……とうに決まっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "信じてるぞ、ヴィーナ。お前は俺の――王だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "後悔なんざ……するわけねぇだろ。それはこの先も変わらねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "王についてきたことは、俺の人生の中で一番正しい選択だったと今でも思ってんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ちょっと、急に大声出さないでよ～。廊下の突き当たりにヴィーナの部屋があるんだよ？　あんたの大声で起きたらどうすんのさ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はんっ、バカ言うんじゃねぇ！　王は昨日も夜遅くまで考え事をしてたんだぞ。今頃ぐっすり眠ってるに決まってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "はいはい。まっ、元気そうで安心したよ。その調子なら、もう話し相手も必要なさそうだねぇ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "そんじゃ、引き続き頑張って壁に穴でもあけてくださいな～。そうすれば、いつでも逃げ出せるもんねぇ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あははっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "なっ……俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "くそがっ！　俺の辞書に逃走なんて言葉はねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ったく……調子狂うな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ロドス……俺の王はロドスを選んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "なら、俺だって一緒だ。けど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……だあああ！　ちくしょうが！　部屋に閉じこもってっと何もかもが気に食わねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "うぜぇったらありゃしねぇぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あ？　誰だ！　モーガンじゃねぇな。あいつはノックなんてしねぇし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "ぼ、ぼくだよ。こんにちは、インドラさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……あぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あんだけボコボコにされたってのに、まだ歩き回れんのか？　大したもんじゃねぇか、ガキ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "あ、この傷のこと？　あははっ、大丈夫だよ。先生たちが手当てしてくれたからね。それに、父さんと訓練してた時もよく体中痣だらけになってたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "そんじゃあ、仕返しにきたわけじゃねーんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "え、仕返し？　どうして？　確かにインドラさんにはこっぴどくやられたけど……でも、あれはぼくを鍛えてくれてたんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ハッ……お前、おもしれーじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "へへっ、褒められちゃった。じゃあ、また今度訓練に付き合ってくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "んだよ、まだやられ足りねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "さっきね、医務室で考えてたんだ！　インドラさんの拳法――あ、拳法じゃなかった。えっと……そう、喧嘩！　インドラさん、本当に喧嘩が強いんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "それに、ぼくが今まで教わったことがないものをたくさん持ってると思ったんだ。だから、もっと学びたくて……お願い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……俺から学びてぇ……だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "おい、正気か？　さっきあんな目に遭ったばかりだろうが。それでも俺に頼むってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "でも、ボコボコにされちゃったのは、ぼくの実力不足だし。インドラさんのせいじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はっ、なんだよ……やっぱここの連中は、外の連中とは違うみてーだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あの鞭使いのペッロー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "ああ、あの人はドーベルマン先生だよ！　ぼくたちの教官なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "あーはいはい、名前なんざどうでもいいっつーの……って、んだよその顔は。わぁった、わぁったよ、ドーベルマンな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "そのドーベルマンが言ってたんだ。心構えができたらまた入れてやる……ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "……なら、試しに行ってみっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジャッキー",
      "text": "本当に付き合ってくれるの？　やったぁー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "はんっ、喜ぶにはまだ早いぜ。言っとくが、俺は手加減しねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "しっかし……ふん、手合わせねぇ。要は節度を弁えりゃいいってことだろ？　なら簡単じゃねーか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "お前みてーなチビをしごくだけなら、何も難しい事なんざねえぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
