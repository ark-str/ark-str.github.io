{
  "server": "jp",
  "storyId": "act21side_level_act21side_03_end",
  "groupId": "act21side",
  "stageId": "act21side_03",
  "title": "衆矢の的",
  "storyCode": "IS-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act21side/level_act21side_03_end.txt",
  "sourceHash": "69ef3999c13513b5dcd6e95d5673497f8cec9870319892425553010b11f7b76e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "……あの女、どうしてここに？"
    },
    {
      "type": "dialogue",
      "speakerName": "用心棒",
      "speakerId": "avg_npc_698_1",
      "text": "て、テキサスが現れました！"
    },
    {
      "type": "dialogue",
      "speakerName": "用心棒",
      "speakerId": "avg_npc_698_1",
      "text": "こちらの被害は甚大です！"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "チッ、あいつらを悠長に喋らせすぎたな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "まあいい。落ちるところまで落ちた同業者を見れば、あいつも心が折れただろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "レオンの甘えを消せるのなら、過程自体はどうでもいいことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "行くぞ。うちの連中にも撤退を伝えろ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "書記官",
      "speakerId": "avg_npc_697_1",
      "text": "あ……あの人たち、いなくなったみたいです！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "この男は死んでいるな。心臓を矢で貫かれている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……ありがとうございます。あなたたちがいなければ、死んでいたのは私でした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "せめて目を閉じさせてあげましょう。どうか安らかに……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……？　これは……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "手帳か？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "シラクーザの裁判官であることを証明するものですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ここ、カドが切り取られています……手帳の所有者は三年前、汚職行為により資格を剥奪された、と書かれていますが……"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "「汚職」……ね。よくもこんなことが書けたものです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "もっとまともな口実を用意できなかったのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "……大丈夫か？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……それより、まずはあなたがどう監獄を出たのかを聞かせてもらいたいですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "企業秘密だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "はあ、いいでしょう。今は追及する気も起きませんし。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "休んだほうがいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "それでも、休んでいる場合ではないのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "手がかりが途絶えてしまいましたから、新しい手がかりを探さないと……"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "炎国には「急いては事をし損じる」という言葉がある。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……もちろん、その理屈は理解できます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ですが、もう時間がないので。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "カラチはお前にとって大切な人間だったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……いいえ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "あの人とは数回会っただけの仲です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "仕事上の関わりもありませんしね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ですがウォルシーニの住民なら誰もが知っています。活力に溢れ、マフィアたちにも穏当に立ち回っていた彼のことを。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "彼は新市街の建設に全力を注ぎ、市民がもっと安全に過ごせる場所を確保しようと手を尽くしていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "彼の死について調査したことで、私はようやくこの人を知ることができたんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "カラチさんは薄氷を踏むようにして、手元にあるものをすべて差し出してまで、事を行う余地を少しでも得ようとしていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "たとえば、利益を巡って争うマフィアたちから遠く離れた区画に、学校や病院を建設したりして……"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "彼をどう評するべきかまではわかりませんが、きっと彼は良心を持つ善人だったのだと思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ですがこのシラクーザでは、善人の末路は定められたものです。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "……この元裁判官と同じだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……シラクーザには、正規のロースクールがあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "教材にはクルビアで出版されたものを使っているので、卒業後はシラクーザの法務機関で働くことができるだけでなく――"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "クルビアでも認められるくらいの力をつけることができるんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "昨今は龍門との交流も盛んになってきていますし、もうしばらくすれば炎国でもある程度認められるようになるかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "良いことのように聞こえるが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ええ、もちろんそれ自体はいいことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ですが、それでは何一つ変わりません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "以前、母校から頼まれたことがありました。後輩たちに自信を持たせてやるために、スピーチをしてほしい、と。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "私はそれを引き受けました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ですが、壇上に立った時に気付いたんです。自分が学んできたことを信じてほしいとは言えないということに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "シラクーザにおいて法が効力を発揮するのは、あの方が存在するからであり、法の下の平等が認められているからではないのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "これはある種、無法地帯より不条理なことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "実際、シラクーザ人はこんな環境で六十年近くも暮らしてきたせいで誰もがそのすべてに慣れきっていて、今さらそれに疑問を投げかけられる人などほとんどいません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "私は公正の化身であるなどと言えるでしょうか？　いいえ、私は何らかの象徴でこそありますが、その背後にあるのが何なのか、自分でもわかっていないのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "……何か食べにでも行かないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……そうですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ありがとうございます。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "まさかいるとは思わなかったわ、レオン。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "あんたが襲われたと聞いて、急いで来たんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "大丈夫よ。テキサスさんのおかげで大事には至らなかったから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ただ、手がかりは途絶えてしまったけれど。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "この辺りで手を引いておけ、ラヴィニア。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……前に約束したわよね、レオン。食事中は喧嘩になりそうな話はしないって。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "そんなこと言ってる場合か。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "これは私たちがお互いの立場を気にせず一緒に食事を取るための、唯一の方法なのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "約束事を破るつもりなら失礼するわ、レオントゥッツォ閣下。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "自分の命を粗末にするな！"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……この都市の裁判官になった時からずっと、私は自分の命をおろそかにしてきたのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……俺はロッサティと話をつけてくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "あいつらがチェリーニアの存在にどう反応するにせよ、対話には乗らざるを得ないだろうしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "主導権はこちらのものだ。ロッサティを牽制できれば、裏切り者にせよほかのファミリーの奴らにせよ、抑え込むことはできる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "問題はそこじゃないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "市内はかなり緊迫していて、誰もが事件の犯人を知りたがってる。この状況を落ち着かせないと、事態は悪化する一方だわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "正直に言えば、あんたが本当に犯人を見つけられるのなら、俺も協力は惜しまない。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "だが、向こうは明らかにもう準備を整えてきてるんだ。今日遭ったのは間違いなく警告だろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "このまま続けたところで、調査は進まないし、あんたが危ない目に遭うだけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "だからあなたの言う通り調査を切り上げて全部うやむやにしろっていうの？"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "そんなふうに感情で道理を押し通そうとするなんてらしくないぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "カラチさんと仕事をしていたあなたなら、私よりも彼のことを理解しているはずでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "あの地位に就いた理由がなんであれ、彼は街をもっと良くすることができたはずなのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "こんなの日常茶飯事だろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "だからって――善人になるには死ななきゃならないなんて、おかしいじゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "俺にとっては、カラチよりあんたのほうが大事なんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……彼の死は、あなたからすれば、少し重たい雨くらいのものなんでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "あなたは家の中にいるから雨に濡れたりなんかしない。ただ、どうしてこんなに雨が続くのか不思議に思うだけなのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "親切な気持ちがあれば、雨の中に立つ人たちに傘を届けようと考えるかもしれないけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "私は……いつまで屋根の下にいるのか、なんて自分に問いかけるのはもうたくさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……だが、どうやってあんた一人で雨を止ませるつもりなんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "わからない。だけど、カラチさんのような人の死を見ておいて、何も行動しないわけにはいかないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "これまで私は、何度も自分の意志に背くようなことをしてきたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "もし……私の命と引き替えに、何かを得ることができるのなら……"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "少しは楽になれるのかもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "俺がクルビア人から学んだのは――"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "他人に言うことを聞かせたければ、暴力よりも利益のほうが有用な時もあるということだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "しかし、それを学んだとて暴力を行使しなくなったわけではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "それこそがあなたと私の最大の違いなの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "あなたは暴力という手段を持ちながら、教養と自制心によってそれを使わずにいることができる。私はその「優しさ」に感謝しないといけないのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……そういうつもりで言ったんじゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "私も責めてるわけじゃないわ、レオン。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "どうして雨が続くのかを考えようとしているだけでも、あなたは得難い人だもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "だけど、あなたはベッローネの次期当主で――"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "私は思ったように行動する力もないただの裁判官。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "やっぱり、立場が違いすぎるのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ね、話はこれでおしまい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "本気で私を助けたいと思ってくれるのなら、あなたのやるべきことをやってちょうだい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "本当にロッサティと話をつけられたら、状況はきっと好転するはずだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ただし、今すぐ私を閉じ込めてでもおかない限り、誰も私の犯人探しを止めることなんてできないわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……"
    },
    {
      "type": "narration",
      "text": "レストランは静まり返っていた。\nレオントゥッツォは何か言おうとしたものの、思いつく限りのどんな言葉も意味を成さないと気付いてしまった。\nのどは幾度か動いたが……結局、彼は一言も口にしなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "待った。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "どうされました？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "ああ、そういえば、レオンのもとへ戻っていただかないといけませんね。ロッサティとの話し合いにはあなたが必要でしょうし。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "いいや。もっと良い方法がある。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "犯人が必要なら、私がなろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……何を仰っているかおわかりなんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "状況を落ち着かせたいのなら、これが最善だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……同情からのご提案ならお断りします。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "誤解しないでくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "自分のためにそうするんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "お前たちの意見はどちらも正しい。だが、このまま事態が悪化していけば、黒幕の捜索は困難を極める。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "となれば、状況が今以上に悪くなる前に、犯人を見つけることが理想だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "無論、向こうも手を尽くして邪魔をしてくるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "つまり、あんたが囮になるということか？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "ああ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "私以外には務まらないだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "テキサスを犯人に仕立て上げ、名声を多少犠牲にすれば、すべての過ちを「ベッローネに人を見る目がなかった」という一点に収束させられるというわけか。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "そうなれば、お前たちは私を手放せるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "迅速に状況を鎮められる上に、黒幕までおびき出すことができる……か。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……リスクはあるが、妙案だな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "しかし……テキサス家の末裔が、よりによってシラクーザでそんなことをすれば、その名は完全に地に落ちることになるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "……テキサスの名がもたらす名誉など、私には至極どうでもいいことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "言っただろう。私の目的はただ一つ、ベッローネとの契約を果たしてシラクーザを去ることだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "なぜ……そこまでしてくれるのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "ロドスという場所にも、お前たちのように物事を良いほうへ向かわせたいと考えている友人が何人もいてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "そいつらをそう易々と死なせたくないのと、同じ理屈だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "この方法がうまくいけば――"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "黒幕を追い込むこともできるかもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "ようやくあんたがこっちについてくれて良かったと思えてきたな。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "別に思われなくてもいいんだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "さて、そうと決まれば、この裁判を大きな騒ぎにして、最終的にほかのファミリーを黙らせられるようにしなければな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "段取りは俺がしておこう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "ここからは、反撃の時間だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": "avg_1028_texas2_1",
      "text": "それで、私がシラクーザを去ることに関しては保証してもらえるんだろうな？"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "ああ。計画が成功すれば、誰もあんたの行方を追うことはないと保証しよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "ロッサティにせよ、ほかのファミリーにせよ、あんたに興味を持つ連中が知るのは……"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "「チェリーニア・テキサスは脱獄し、すでにシラクーザを離れた」という事実だけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "すまない、ラヴィニア。今のは法の威厳を損なう発言だったな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "……私はそこまでお堅くないわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": "avg_4065_judge_1",
      "text": "今は……やるしかないんだから。"
    },
    {
      "type": "sceneBreak"
    }
  ],
