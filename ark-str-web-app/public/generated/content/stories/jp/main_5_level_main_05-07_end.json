{
  "server": "jp",
  "storyId": "main_5_level_main_05-07_end",
  "groupId": "main_5",
  "stageId": "main_05-07",
  "title": "一蓮托生",
  "storyCode": "5-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_05-07_end.txt",
  "sourceHash": "4e4c4febcbb6c076553199b4a500b4f991ee6d4afd7c6e270d3cbe704ff2f72b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "メディーク、大古プラザの南12番出口に負傷者一名。“上級”督察官だ。急げ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "血は止まったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "小官のことはよくご存知でしょう。傷はもう塞がりました。ですが盾を振るうにはしばらく苦労しそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "他の近衛局員は無事でしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ、巻き込まれたのは我々二人だけのようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……本当に小官抜きで行くつもりですか？　近衛局ビルで待ち構えているのはレユニオンの指揮官かもしれません、間違いなく厳しい戦いになるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私はどちらでも構わんが、お前の状況を見ればその方が良いというのは分かる。お前も合意してくれるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "傷つく言い方ですが……小官も自分の状況はよく分かっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "くれぐれもお気を付けて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "今のところレユニオンの実力は我々の想像以下だと思いますが、どれだけ弱いと言っても、チェルノボーグを落としたのは事実ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "それに、隊長にも弱点もありますからね。何があっても、一つの考えに囚われてしまわないようにしてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "何かに執着して周りを見ずに行動しないようにしてください。今戦うべき相手が誰なのか見極めることが大切ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうだな。提案として、受け取っておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "早く治療に行け。こちらのミッションが終わったら、戻ってくるのを待っていてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "メディーク部隊の安全は小官にお任せ下さい。ではご無事で。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ、行ってくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "こちら偵察隊。レユニオンの銅鐸の通過を確認しました。以上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "下環エリアにも同じようにレユニオンのアジトがあり、敵は部隊の再編中のようです。AU7より以上です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "こちらAO3小隊。既に前港エリアのレユニオンを掃討完了しております。残存勢力を近衛局の方向に押し上げているところです。以上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "こちらはタイケツ宮のレユニオンを掃討しました。チャールズ大道へ向けて撤退中。規定ポイントで合流します。AL1からは以上。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "各部隊からレユニオンの動向と作戦の進捗が届いております。各エリアの作戦は順調に進行中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "報告は以上になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "引き続き作戦を進める。目標、全レユニオン勢力を指定エリアへ誘導せよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "他のエリアに未だ小規模なレユニオン部隊が潜んでいる場合は、直接殲滅することを許可する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "可能な限り、敵の方からアクションを起こすように誘い出せ。こちらの人員の消耗を最小限に抑え、戦力を温存するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信",
      "text": "了解しました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ふぅ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "むっ？　また通信か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "もしもし？　チェン嬢ちゃん？　まだ生きてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "は？　お前、今私をなんと呼んだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "なによ、アンタだってお嬢でしょう。それより大古プラザの件、あとでキッチリ損害の落とし前をつけて貰うわ！　はっきりとアンタが部下に命令を下すのを聞いたんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それを言うためにわざわざ通信を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "違うわ、ロドスの協力を拒むなんて、何か気が咎めでもしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "勝手に人の心を読もうとするんじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "まあいいわ。アタシが穴埋めしといてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "穴埋めだと？　何をだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ふふ～ん、まだ秘密よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "でも大古プラザの件は請求書の束を覚悟しときなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ところで上環にあった喫茶店を覚えているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "えっ？　どの店よ？　どのみちこの状況でやってる店なんて、もう無いでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "――あ！　話をすり替えるつもり！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だから、カツサンドのカツがサクサクなあの店だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "うん？うーん…あっ！　思い出した！　あの両手の大きさほどあるカツバーガーを出す店でしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そう、それだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "前はパトロール中によく食べに行ったわ……って、このザコ、寝てなさい！　誰が起き上がっていいなんて言ったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ぐわぁ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "確か店の名前は「レンヤム喫茶」だったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ははーん、私と飲茶をしたいってわけね？　でもどうしてもっといいお店にしないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前が言ういい店と私の思ういい店は違うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "別にあたしが奢ってあげても良いのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "スーお嬢様、私がそんなヤツに見えるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "アンタ、イイ度胸ね。もう一回アタシをそう呼んでご覧なさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "気にするな、口が滑っただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "どう考えてもわざとじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "スワイヤー、私は思うんだ。龍門の市民たちのためにも、今回の作戦は絶対に成功させなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私たちの職務が龍門を支えているように、龍門も私たちを支えてくれている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "まあそうね。でも感慨に浸るのはこの辺にしといたら？　さっさとレユニオンを片付けて、ゆっくり食事と決め込むわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そちらの戦闘も激しそうだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ああ、大丈夫よ。このくらいどうにかなるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "早くしろ！　逃げられるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "あーもう面倒くさい！　ほら！　早く片付けなさい！　時間がないのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "あ、アタシはトマトエッグカツバーガーね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ、わかった。今回は私が奢ってやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "あと前回うっかり金庫に閉じ込めてしまった件、いま思い出したから謝ってやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "あれがうっかり！？　どう考えてもわざとに決まってるわ！　まぁいいわ。今朝、アンタをずぶ濡れにしてやったから帳消しにしといてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ちょっとアンタ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "命ってね一番大事なものだって知ってる？　目の前のことになんでも命を掛けるのはやめなさい。アンタにも沢山頼れる人がいるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "フンッ、そうか。忠告感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "そのお店の前にいるってことは、もう少しで近衛局のビルに到着ってところね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "幸運を祈るわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m.　07:40　天気/曇天\n龍門アップタウン、上廠（じょうしょう）街、近衛局ビル東670m"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局員",
      "text": "チェン隊長、第四機動小隊、到着しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ご苦労だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "総員そのまま聞け！　まだ各地で奮戦している部隊もあるが、ここに集まってくれた諸君は近衛局のなかでも精鋭だと私は確信している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "前に見えるビルは、かつての龍門の治安維持の象徴、そして法の執行機関でもある龍門近衛局のものだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だが今はレユニオンに奪われ、暴徒の根城と化している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ただの業務の一つと考えている者、感情を動かされている者、怒りに震えている者など、様々な者がいるかと思う。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "しかしいずれにしろ、我々こそが近衛局だ。我々は暴徒でも、犯罪者でもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "近衛局を取り戻すことに、諸君は必ずしも尊厳や正義を掲げる必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "我々は龍門近衛局だ、奪われたものを取り戻す、ただそれだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "揺るぎない信念に従い、職務を全うせよ！　総員戦闘準備！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "時は来た。ビル内のレユニオンを一掃する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局員",
      "text": "了解しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "出発する！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
