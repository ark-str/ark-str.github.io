  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……ここに隠れておけば、きっと見つからないよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "代わりに、あの子たちのところには戻れそうにないけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……無事でいてくれるといいな……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "はぁ……どうしてこんなことになっちゃったんだろ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……！"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "そこにいるのは誰？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……すみません、脅かすつもりはなかったのですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "あなたが、ミーシャさんでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……えっ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "先ほどは驚かせてしまってごめんなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "そうだ！　お二人のことも、ご紹介しないといけませんね。こちらがフランカさん、そしてリスカムさんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "よろしくね～。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "初めまして、よろしくお願いします。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "では、改めて……私たちはロドス・アイランド製薬という、感染者向けの医療提供などを行っている組織なんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "その活動の一環として、あなたさえよければ、力になれたらと思っているのですが……少し、お話をしませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "お話……？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "はい。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "とはいえ、あなたの安全が最優先ですから……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "場所を移して、ということにはなりますが。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "もちろん、その間は私たちがお守りしますから、ご安心ください。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "一体、何を……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……あっ。も、もしかして……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "そんなこと言って、私を捕まえるつもり！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "来ないで！　わ、私の爪は、すっごく鋭いんだからっ……！　近付いてきたら、怪我するよ……！！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "……ぷっ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "な、何がおかしいの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "だって……本当に捕まえる気があったら、とっくにやってるもの。抵抗のチャンスなんて与えずに、ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "ミーシャさん……我々は本当に、あなたの力になりたいんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……そんなふうに言われても、信じられないよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "龍門が感染者をどう扱うかは知ってるでしょ！？　犯罪者より厳しいくらいなんだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "それなのに、感染者を助けたいだなんて……そんなこと、あるはずないじゃない……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "――ミーシャさん。これを、見てもらえませんか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "え……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "！　その手……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "まさか、あなたも……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "感染者、なの……？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "はい。あなたと同じ、感染者です。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……実は先ほど、あなたを慕う子供たちに出会ったのですが……あの子たちに限らず、このスラム街にはたくさんの感染者がいるようですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "ミーシャさん。……あなたの行動が、みなさんを危険に晒すかもしれないということは、お考えになりましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……あの子たちをだしにして、私を脅そうって魂胆？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "いいえ、そんなつもりはありません。……けれど、そういうことを企む人はいるものです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "現に私たちは、そんな人たちを追い払ってきたところですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "そういったこともあり、我々としては、追手が来る前にあなたを保護したいと考えています。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "あなたがここを離れることで、子供たちも脅威を免れることができるでしょうし――"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "あなた自身の安全を守ることもできますから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……あなたは、あいつらが私を捕まえたがる理由を知ってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "っていうか、そもそも……どうして私を守ろうとしてくれてるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "感染者たちがあなたを追う理由は、私にもよくわかりません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "一方で、後者の理由は簡単です。現状これが最善策ですし、罪のない感染者を守ることは、我々にとって当然ですから。……と、言って信用していただけると嬉しいんですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "ひとまず、一緒にここから離れませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "……わかった……行くよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "speakerId": "char_012_misa",
      "text": "どっちみち、選択肢なんてないんでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "そういうわけではないんですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……でも、ありがとうございます。ミーシャさん。"
    },
    {
      "type": "sceneBreak"
    }
  ],
