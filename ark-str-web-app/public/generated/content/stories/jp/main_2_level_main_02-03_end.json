  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……ここに隠れておけば、きっと見つからないよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "代わりに、あの子たちのところには戻れそうにないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……無事でいてくれるといいな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "はぁ……どうしてこんなことになっちゃったんだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "そこにいるのは誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……すみません、脅かすつもりはなかったのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたが、ミーシャさんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……えっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "先ほどは驚かせてしまってごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そうだ！　お二人のことも、ご紹介しないといけませんね。こちらがフランカさん、そしてリスカムさんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "よろしくね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "初めまして、よろしくお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "では、改めて……私たちはロドス・アイランド製薬という、感染者向けの医療提供などを行っている組織なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "その活動の一環として、あなたさえよければ、力になれたらと思っているのですが……少し、お話をしませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "お話……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "とはいえ、あなたの安全が最優先ですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "場所を移して、ということにはなりますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もちろん、その間は私たちがお守りしますから、ご安心ください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "一体、何を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……あっ。も、もしかして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "そんなこと言って、私を捕まえるつもり！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "来ないで！　わ、私の爪は、すっごく鋭いんだからっ……！　近付いてきたら、怪我するよ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "……ぷっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "な、何がおかしいの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だって……本当に捕まえる気があったら、とっくにやってるもの。抵抗のチャンスなんて与えずに、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ミーシャさん……我々は本当に、あなたの力になりたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……そんなふうに言われても、信じられないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "龍門が感染者をどう扱うかは知ってるでしょ！？　犯罪者より厳しいくらいなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "それなのに、感染者を助けたいだなんて……そんなこと、あるはずないじゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――ミーシャさん。これを、見てもらえませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "！　その手……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "まさか、あなたも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "感染者、なの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。あなたと同じ、感染者です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……実は先ほど、あなたを慕う子供たちに出会ったのですが……あの子たちに限らず、このスラム街にはたくさんの感染者がいるようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ミーシャさん。……あなたの行動が、みなさんを危険に晒すかもしれないということは、お考えになりましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……あの子たちをだしにして、私を脅そうって魂胆？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "いいえ、そんなつもりはありません。……けれど、そういうことを企む人はいるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "現に私たちは、そんな人たちを追い払ってきたところですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そういったこともあり、我々としては、追手が来る前にあなたを保護したいと考えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたがここを離れることで、子供たちも脅威を免れることができるでしょうし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなた自身の安全を守ることもできますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……あなたは、あいつらが私を捕まえたがる理由を知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "っていうか、そもそも……どうして私を守ろうとしてくれてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "感染者たちがあなたを追う理由は、私にもよくわかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "一方で、後者の理由は簡単です。現状これが最善策ですし、罪のない感染者を守ることは、我々にとって当然ですから。……と、言って信用していただけると嬉しいんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ひとまず、一緒にここから離れませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……わかった……行くよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "どっちみち、選択肢なんてないんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そういうわけではないんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……でも、ありがとうございます。ミーシャさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
