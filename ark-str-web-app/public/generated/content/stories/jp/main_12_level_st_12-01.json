{
  "server": "jp",
  "storyId": "main_12_level_st_12-01",
  "groupId": "main_12",
  "stageId": "st_12-01",
  "title": "火と熱風",
  "storyCode": "12-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_st_12-01.txt",
  "sourceHash": "f12966594079b676edf1113ef1a1e85bbc0188342acae49ebe1aeaec96bc0b26",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "ピアース。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "はっ、上官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "休暇の承認が下りたらしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "はっ、なんとか滞りなく。上官、これも全て──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "全てお前のベビーフェイスのおかげだな、小僧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "上のお歴々も、たまには部下を気遣うポーズをとってみたくなるもんさ。いわゆるイメージ作りだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "ハハッ、恐らく機嫌が良かっただけでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "実家の粉挽き小屋の天井が崩れましてね、間が悪いことに町の大工は足を折ってて修理もままならないんで、母から帰って手伝うよう言われたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "十日間の休暇から移動日数の八日を差し引いて、あっちにいれるのは一日半ってとこですが、それだけあれば半壊した粉挽き小屋くらい何とかなりますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "万一に備えて、半日分のマージンを持たせました。上手くいけば父のために畑を耕してやれるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "あ、そうだ、作業用の手袋を一ダース買って行かねばなりません。家にあるのはとっくに替え時が過ぎてますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "うむ、それは……買い物リストか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "はい、上官。漏れがあってはいけませんので用意しました。次の休暇がいつになるかわかりませんし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "その時には、お前も正真正銘自分の力で勲章を勝ち取っていてほしいものだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "もちろんです、上官。全ては我らがヴィクトリアのために！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "野心は十分だな、小僧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "俺の知り合いにトッドという老いぼれがいてな、共に国境で高塔の術師たちとやり合ったことがあるんだが、あいつは純金の記念章を授与されていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "あの勲章は、本当に美しいものだったよ。胸元でキラッキラッ光りやがってな、目が離せなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "しかも我らの敬愛すべきウィンダミア公爵様が、御自ら授与なさったんだ。軍人にとっては最高の栄誉さ。だが、その後の祝勝会で、トッドはずっとしかめっ面だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "なぜだかわかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "自分の功績に、まだ満足していなかったからですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "いや違う、もっと深刻だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "自分の手でグラスを持ってビールを飲めなかったからだ。あいつの両手は木製の義手になってたんだよ、ハハッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ベテラン将校は口の端を歪め、その黄ばんだ歯を覗かせた。\n若い兵士はそれに続いて乾いた笑いを発した。上官が言ったのが、ブラックすぎるジョークだと彼にはわかっていた。\n甲板の上の風は強く、兵士は帽子のつばを押さえながら、控えめにくしゃみをした。\n疾走する高速戦艦の甲板上ほど、人がコートを必要とする場所はないだろう。\n若い兵士はこのようなことを考えていた。「今日の食事はウェルズが担当だ。あのハゲ頭のデブっちょ、軍用缶詰をどれだけ盗み食いすることやら」と。\n「でもあいつの作るクリームシチューは絶品だ。今日のシチューには羽獣肉をたくさん放り込んであるといいけど」と。\nそして若い兵士はこう思った。「日が暮れた後、夕食を食べてから出発しよう」。\n彼らが駐屯する移動要塞は、すでにロンディニウム近辺までたどり着いていた。天気が良ければ、地平線の向こうにザ・シャードの先端も見える距離だ。\n彼は駐屯地に戻ったら、後方支援中隊の輸送車に乗り込み、最寄りの町まで行こうと算段を立てた。\nそこのバーで一杯引っかけたあと、朝まで待てば、仕入れをするため郡に向かう革職人がいるはずだから、それに便乗する。タバコを二箱も渡せば乗せてくれるはずだ。\n若い兵士は実家の納屋を思い出した。藁の堆肥の発酵した臭いが常に充満していた。\n納屋のあの臭いは今でも時折、夢に出てくる。良い香りだとは口が裂けても言えないが、故郷の村との繋がりを示してもいるのも確かだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「たまには……いや──」若い兵士は静かに眉根を寄せ、こんな風に感傷で自分を偽るのはもうよそうと思った。\nたまにであろうと、彼はあの臭いを嗅ぎたくなかった。納屋の悪臭は実家に戻るのを躊躇する一番の理由だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "はぁ、また霧か。いつまで経っても、ロンディニウムの天気にゃ慣れないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "俺たちがリターニア国境に駐屯していた時も、良い天気だったとは言えないが、それでも午後にはよく日光浴ができたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "艦長に伝えてきてくれ。この天気では監視所からは何も見えない、それにレーダーも干渉を受ける。帰航すべきだとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "カスターの部隊はおとなしく自分らの戦線にとどまり、ゴドズィンは部下をまた少し後退させた。そしていくつかの顔馴染みの前哨部隊を除いて、ウェリントンの主力はいまだ姿を見せていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "敬愛すべき我らがウィンダミア公爵様を除き、残りの七名の公爵様は相変わらず様子見だ。巡回完了だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "上官、ではサルカズは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "それは俺たちの仕事ではない。お偉方にはそれぞれお考えがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "ですが聞いた話だと、最近ロンディニウム内では……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "ピアース、俺は十数年も兵士をやってきた。酒とトランプ以外に、軍隊で学んだ最も重要なことは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "そういうくだらん噂に耳を傾けないことだ。後方で地図を見ている上官たちがすべてを解決してくれる。俺たちは自分の本分を守っていればそれでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "我々の本分は……ヴィクトリアを守ることではないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "その「ヴィクトリア」が何であるかを決められるのは、我々の上の者だけだ。小僧、俺たちの本分はただ命令に従うことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "戻るぞ、平和な一日は終わった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベテラン士官",
      "text": "早く熱いシャワーを浴びないとな。このバカげた霧のせいで体がダルいったらありゃしない──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "若い兵士は、ここ最近疲れすぎていたのかもしれないと感じた。そして、ちょうどいいタイミングで休暇を取ってよかったと思い始めた。\n戦場は常に兵士に緊張を強いる。ましてや、今の彼は果たして起こるのか、いつ起こるのか、信じられるのは誰なのかがわからない戦争に直面しているのだ。\n少し暑い――若い兵士はそう思った。\n彼は腕を上げ、シャツの第一ボタンを外そうとした。彼の尊敬する上官が、たった今平和な一日が終わったと宣言したのだ。ならば少しくらい風紀を無視したところで問題ないだろう。\n彼は実家の暖炉を思い出した。数年前、真新しい軍服を着て里帰りした時、暖炉の熱で汗だくになっても彼はボタンを一つも外そうとしなかった。そのことをシェリーにずっとからかわれていた。\n若い兵士は微かに笑った。"
    },
    {
      "type": "dialogue",
      "speakerName": "若い兵士",
      "text": "ふっ、あんなことでからかうから、お前のためにバカげたロマンス物語なんてみやげを持って帰るのをやめたんだぞ、これでおあいこだからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "主砲の出力は正常、目標の破壊を確認しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "よし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "次の準備に取り掛かるのだ。大公爵たちはすぐに何があったか気付くだろうからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "で……殿下！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "あら、見ない顔ね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "は……はい！　殿下！　以前は傭兵分隊にいました。将軍に目をかけていただきましてこのお役目についたばかりです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "た、大変光栄です……あなた様はずっと私の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "私も会えて嬉しいわ、あなた何て名前なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "わ……私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "（小声）私に正式な名前はございません、皆からは「エルボー」と呼ばれております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "クソッ……こんなことになるなら、本の中から名前を取って付けておくべきだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "「エルボー」……どうしてエルボーなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "スープを飲んでいた時に肘を火傷を……いえ、くだらない話です。殿下が気に掛けるほどのことではございません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "きっとスープカップを高く持ち上げすぎたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "違います！　「プラグ」の野郎がぶつかってきたせいです！　あのバカ、次に会ったら必ず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "あっ、も……申し訳ございません、将軍、テレジア殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "行っていいわ。まだお仕事が残っているのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "今日のあなたたちの夕食はクリームシチューだそうよ。食べそびれないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "ありがとうございます、テレジア殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "我々は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "我々は「戦争が終わるごとに、サルカズは帰ることができる場所を得る」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍兵士",
      "text": "我々はすぐにカズデルへと帰ることができますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "もちろんよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "私は王庭の主たちといるより、彼らと一緒にいる方が好きだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "サルカズの魂たちはいつも私を蹲らせて、長く苦しい歴史の中に沈めるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "だけど彼ら……さっきの子みたいに新たに成長した子たちは、私に確かな未来を感じさせてくれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "私たちは……この未来をどこに置くべきなのかしら？　再び大地を席巻する戦火の中？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "私たちの目の及ぶ場所全てが焦土になったとき、新芽は本当に私たちの望んだ通りに芽吹くのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "希望っていつも重いものよね、マンフレッド。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……殿下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "軍事委員会の手はず通り、一部の区画はすでにロンディニウムから切り離されました。現在は指定の位置へ到着し、中心部と大公爵たちの包囲網の間に停止しております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "あの場所は今後、我々の攻撃の拠点及びハブとなり、この飛空船も一時的に停留することになります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "ウィンダミア公爵はすぐに自身の高速戦艦が破壊されたという報告を受けるでしょう。しかし彼女は飛空船の脅威を無視できません。これはナハツェーラーの王が戦線を展開する一助となります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "テレシス殿下の指示に従い、これより我々は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "窓の外を見てごらんなさい、将軍。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "言われるがままに、マンフレッドは窓の外へと顔を向けた。\n計画の通りではあるが、実際に炎が目の前で赤々と燃える様子は想像していたほど……感情を沸き立たせるようなものではない。彼はその事実を認めざるを得なかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……炎の光とは眩しくて、目が開けぬものですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "我々の戦争が、ついに始まりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "軍事委員会の推測によると、大公爵たちは今後十六時間以内に慎重に軍事行動を展開すると思われます。対して我々の準備はすでに完了しております。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "いいえ、戦争はずっと続いていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "戦争と呼べるのは、軍団と軍団の殺し合いだけではないの。たとえばカーテンの後ろに隠れている目、闇夜の中でささやかれる呪い、抑えつけられた泣き声、そのどれもが戦争よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "荒野で孤独に倒れた我らが同胞、黒の慶典で引きずられたローブ、コレクターがガラスケースに飾ったカズデルの煉瓦、これらもまた戦争よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "戦争は、いつも私たちの一部だったわ。私たちはただ……再びそれを人々の前へと押し出しただけ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "たとえ戦火が燃え上がった場所がヴィクトリアであろうと、カズデルは戦争の一部です。これについては、テレシス殿下ともすでに多くの計画を立てております……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "いいえ、マンフレッド、私が聞いたのはそういうことではないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "私たちの足元、この飛空船の影が一人一人を平等に覆っているのが見えるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "戦争を終わらせましょう、将軍。結局のところ、これがサルカズが採れる唯一の方法であると証明されたのであれば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "text": "――涙で涙を沈め、苦しみで苦しみを埋めましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "それが……唯一の方法です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "あなたのお望みのままに致しましょう、殿下。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "本当か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "間違いねぇ、まるであの伝説の中から出てきたみたいだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "災いの予兆、動乱の前触れ、悪夢の化身……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "つまり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "山のような大きさの鉗獣が、香水で満たされた宝箱を引きずってるのを見たのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "そうだ、赤鼻のハンバートの言ってた通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "ナインが言ってたぞ、あんたの身体の状態を考えるともうこれ以上酒を飲んじゃダメだってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "ちょっとだけだろ！　オレに残された日々は多くねぇ、最後の希望まで捨てろっつーのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "お前も覚えてるだろ？　あの雪原の夜、みんなが死にそうなくらい凍えてる中、ハンバートがオレたちに話した、あいつの村の奇妙な伝説をよ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "……すまない、俺が加入したのはあんたたちがヴィクトリアに来た後なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "そうだったのか、オレはてっきり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "そうだ、ハンバートはウルサスで死んだんだったな。あいつは本当によくやったよ。少なくとも監視隊のクズどもを四人道連れにしたんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "お前ならあいつとあいつの話を気に入るはずなんだがな。クソッ、あいつのために乾杯しないとな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "また飲んでるのか、ロマーヌイチ。何度言わせる気なんだ？　ほら酒を渡せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "ナインさんよ、オレはもう長くねぇんだ。酒くらい好きなように──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "お前の寿命はまだ長い、医者の言う通りにすればな。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "お、オレは医者なんて嫌いだ、あいつらは全員恥知らずな詐欺師だからな！\nオレにゃ、この液体が必要なんだ……オレは全部分かってるんだ……むにゃ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "ロマーヌイチのジジイ、また寝ちまったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "毛布をかぶせてやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "もうロンディニウムまで遠くないはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "ああ、運が良ければ、あと一週間ちょっとで城壁が見えるだろう。あのボロ車を直せれば、もっと早く着く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "ロンディニウム周辺じゃ天災は稀だが、今の情勢からして、どこかの大公爵の部隊と出くわす可能性はある。奴らはどいつも友好的な連中じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士A",
      "text": "それに、サルカズだっているしな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "今後の行動は、これまで以上の慎重さが求められる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "我々は幽閉されている仲間を見つけなければならない。たとえもう彼らが、我々の一員であることを認めていなくてもだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "再び団結することは非常に難しい……だが我々は同じ苦痛を感じ、同じ悲しみを分け合っている。この感覚が我々を駆り立てるのだ。まだ立ち止まることは許さないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "私はこれが何かの埋め合わせだと言うつもりはないが、我々が今安心して取り組めることも……これ以外にはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "絶望の淵にいる感染者たちに知らせてやるんだ。自分たちにはまだ仲間がいる、自分たちは誰も気にかけない廃棄物などではないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "お前はいるべき場所にいろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "タルラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "ナイン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "私は少し外の空気を吸いに来ただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "好きにするといい。私がお前を見ている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……遠くに、火が見えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "火が見えてからしばらく経つ。林が落雷で燃えているだけであってほしいものだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "我々の部隊はあそこを迂回していく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "そうか、雷か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "お前が野営地で粥を作っているのを見た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "料理人を手伝っただけだ。ジャガイモをカゴ二つ分も処理しなければならないと言っていたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "私も食べたが、味は悪くなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "アリーナ……いや……昔、ある友人が教えてくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "作り方など、とっくに忘れているものだと思っていたんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "裁きが下される前に、お前がまだ力を尽くしたいというなら、私は止めない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "だが自分がどういう立場にあるのかはよく自覚しておくことだ。タルラ、我々はお前を見ている。我々全員がだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "text": "……分かっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナイン",
      "text": "荷物をまとめろ、そろそろ出発だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "……寝ちまってたのか？　クソッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "ナイン、お願いだ！　ジジイを哀れだと思うなら、もう一口飲ませてくれ、でないとオレはくたばっちまいそうだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "おい！　あれが見えるか？　空の向こうが真っ赤に燃えてるぞ！　ハンバートが言ってたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "あいつはこれを良い兆しだって言ってたぞ……吉兆だって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "あいつが言うには、これは……彼岸？　勝利だっけ？　えーっと、思い出せねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "もしかしたら、もしかすると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン戦士B",
      "text": "単に……明日は良い天気ってことかもしれねぇぞ、お前ら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
