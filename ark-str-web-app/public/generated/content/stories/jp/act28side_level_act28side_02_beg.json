{
  "server": "jp",
  "storyId": "act28side_level_act28side_02_beg",
  "groupId": "act28side",
  "stageId": "act28side_02",
  "title": "二重の備え",
  "storyCode": "CV-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act28side/level_act28side_02_beg.txt",
  "sourceHash": "3318bdf2aa29ab87bd055a60b09a9663e69bd5bfaa06b75914b598436db84c56",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ、そんな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ちょっと、お嬢さん、どこへ行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "彼を探さないと――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ジェシカ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……フランカ先輩？　ローラさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "うそ本当にいた。どうやって来たの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "報告、ジェシカの所在がわかったわ、例のレストランよ。しかもお口のまわりをテカテカにしちゃって……ちゃっかりお店のメニューも把握済みのようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "了解、銀行の方もだいたい片付いたから、これから向かう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "やっと来たのね。あたしたちもう待ちくたびれて腹ペコよ、優等生サマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ここが思ったよりも街はずれで、探すのに時間かかったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はぁ……まあ、ここしかないみたいだし、しょうがないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "ちょっと、そこのお嬢さん。マイルズを無事に送り届けてくれたことに関してはとても感謝してるけど、あたしの料理にケチをつけようってんなら話はまた別よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あー、そういうことじゃ。こんな凍えるような寒いところであったかいご飯が食べられるだけでもありがたいわ、文句なんてあるはずないじゃない。そうでしょ、ローラちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "え？　ああ、そうだね、あたしちゃんもそう思う！　うちのママとおばあちゃんの料理よりも美味しいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "あら、わかってるじゃない！　お嬢さん、あなたのお母さんとおばあさんは何してる人なの？　料理人とか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "えーっと、ママはお医者さんで、おばあちゃんはエンジニアだよ。二人ともあまり料理が得意じゃなくて……うちの料理担当はだいたいパパなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "プッ、プハハハハハハハ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "レオーネ、笑い過ぎじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "コホンッ、いやいや気のせいだって。飯を食おうな、飯を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あの……おかみさん、お水はありますか？　良ければ一杯頂きたいのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "はいはい、とってくるね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "女店主はテーブルにある空のコップを手に取ると、窓を開けて外の分厚く積もった雪にそれを突っ込み、なみなみとすくった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘレナ",
      "text": "少し待ってて、溶けたら飲めるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そうだ隊長、どうして銀行の人が迎えに来たのか結局わかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "現地の政府機関がギリギリで回ってて、わたしたちに協力する余力がなく、それで今回の件の全権を銀行に委ねたらしいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はぁ？　まあいいわ、で、銀行側はなんて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "「全力でサポートいたします」「ただし具体的な内容については一度持ち帰って検討させていただきます」、ざっとまとめるとこんな感じだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "チッ、やりづらい相手ね……あなた、まさかはいわかりましたと引き下がって、ご飯を食べに来たわけじゃないでしょうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "彼らにはリソースも人手もないけど、お金だけはたんまり握ってるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "でもわたしたちだって経費が不足してるってわけじゃないですし。ただ……銀行がちゃんとサポートしてくれるっていうのなら、デイヴィスタウンでもっと多くの労働者を雇うというのはどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "動力炉で事故が起きてからというもの、大多数の住民は区画を去ることを選んだからね。いま町にどれだけの労働者が残ってるのかもわからないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "道理でね。もう八時になるっていうのに、窓から明かりが漏れてるアパートはほとんど見当たらないんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "実はそんなに人手はいらないんだよね。修理作業はあたしちゃんと小隊メンバーでできちゃうからさ。必要なのはエネルギータワーに詳しい人だよ。銀行から誰か適任者を紹介してくれてたりする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "いや、特には。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "コホンッ、あのよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "レオーネさん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "さっきはあんたの通信機の修理にかまけて自己紹介を忘れてたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "レオーネ・テルメン、ここの採掘工場の発破技士だ、よろしくな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "採掘工場の発破技士……そんな方がなぜ、まだ町に残っていらしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ま、他にもここを離れたがらない頑固野郎が何人もいるからな。俺なんざ四歳の時からこの採掘工場育ちだ、今さらほかの場所に行ったところで馴染めやしないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "年初めに事故が起きた時も、俺がすぐさま人をかき集めて対応したんだ。完全には修復できなかったが、しばらくの間稼働させることには成功したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "そのおかげで、今もまだ稼働しているわけですしね。あなたのお力ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "この話はもういい、過ぎたことだ。それよりさっき言ってた報酬のことだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あっ、それについては……任務の要件は可及的速やかに作業を完了させることですので、日当制ではありません。ただし、必要な経費および食費と宿泊費は毎日支払われます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "報酬は動力炉の復旧後に一括清算となり、早く復旧できれば、それだけ金額も上乗せされます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もちろん、協力の観点から、報酬の一部前払いも可能ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "具体的な数字は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "あなたの場合、業務は顧問になるかと思いますので、二ヶ月で解決した時の報酬は4万、一ヶ月以内であればその倍、一週間以内であれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "さらに倍か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "もっとです、20万になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "交渉成立だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "おじさん、随分と快く引き受けるのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "20万だぞ、大金だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ここじゃお金がいくらあったって使い道がないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "青いな。20万ってのは、若者が飲んで食ってはしゃぐには十分かもしれねぇけど、中年の債務返済の当てとしちゃ焼け石に水くらいの額でしかないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……債務？　借金があるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "俺だけじゃない、区画の全員が借金を抱えてる。はぁ……ここまで話したからには、全部ぶっちゃけるか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "あんたがここに来るなり尋ねた、例の雪原へ歩いて行った男のことだが、あれも大方借金がかさんでのことだろう……ここじゃよくある話だ。負債を抱えて破産し、行き場を失って仕方なく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "何も持たないで、雪原に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……そんなの、到底生き延びられるとは思えません。やはりあの時止めておくべきでした。レオーネさん、今から探しに行っても間に合うと思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "はあ、やめておくんだな、助けられやしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……ジェシカ、これは君のせいじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "コホン……ローラ、ほかにレオーネさんに話しておくことはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "えーっと……そうだ、おじちゃん、資料があるなら明日ここに来る時に持ってきてほしいんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "よし、わかった。それとほかに何人か採掘労働者を知ってるが、そいつらのことも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "必要ないよ、おじちゃんだけで十分。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "そう言うなって、もう何人か呼ぼう、な？　わかるだろ、この場所にこだわらない若者はみんな出て行っちまって、残ったのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "俺みたいなジジイばかりなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "ベニー、来てくれてありがとうな。わしは本当にもう大丈夫だ。だから、そろそろ家に帰りなさい。これ以上遅くなったら、レオーネが心配する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベニー",
      "text": "まだ練習問題が終わってないんだ……それに、家へ帰りたくない。父さんとは……いや、何でもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "レオーネの奴は確かにちとせっかちな性分だが、長年一緒に暮らしてきてわかるだろう？　お前さんのことは本当に大事に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベニー",
      "text": "マイルズ、わかってるよ、僕はただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "……まあいい。冷えとらんか？　火鉢にもっと薪を入れようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベニー",
      "text": "平気、十分暖かいよ……ねぇマイルズ、今日マイルズを家まで送ってくれてた人たちって、助けてくれたっていうBSWの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "そうだ、エネルギータワーの修理を手伝いに来てくれたと言っていたな。タワーが復旧して暖房さえつけば、わしらもこんな火鉢で暖を取る必要はなくなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベニー",
      "text": "でも、エネルギータワーが直ったって……区画が元通りになって、何もかもが良くなっていくわけじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "……お前さんは一日中心配事ばかりしているな。そんなことじゃ髪が抜けちまうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベニー",
      "text": "父さんはこんな心配をしないからね。僕が代わりに考えなきゃ、ほかに考えてくれる人もいないよ。以前ならまだカールがいたけど、今はもう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "ベニー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "マイルズ！　マイルズはいるか？　感謝しろ、良い仕事を見つけてきてやったぞ！　これで動力炉は直るし、大金も舞い込んでくる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベニー",
      "text": "父さん？　どうしてここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ベニー、お前もいたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "お前はここで勉強しててくれ。父さんはマイルズを連れてBSWのお嬢ちゃんたちと顔合わせをしに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "とっくに会っとるじゃないか。わしは彼女たちに助けてもらったんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "おっとそうだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "ほかの連中のとこには行ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "……一通り当たってみたが……もういなくなっちまってたり、これから引っ越すとか言ってたり、あとはもうどうでもいいとかほざいてる奴しかいなくてな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "まだ動力炉のことで苦労してもいいと思ってそうなのは、あんたと俺くらいのもんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "セーフハウスが正式に運用できるのは明晩になりそうだから、緊急集合場所はひとまずここにしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ローラ、明日のエンジニア小隊の指揮は君に一任する。最短期間で区画の移動能力を復旧するように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "オッケー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカとジェシカには、色々とやってもらいたい仕事があるの。とりあえず、一人はわたしと来てほしい。もう一度銀行に向かうから。それで、もう一人は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "区画の周囲や無人地帯の安全状況を確認してもらいたいんだ。銀行の人の話では、この頃よく外から野盗が入ってくるらしいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの……そっちはわたしが行ってもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "いいわよ、それじゃ銀行の方にはあたしが行くわね。われらがリスカム隊長を悩ませた連中が一体どんなものか、見てみようじゃないの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "みんなよく聞いて。事故からしばらく経ってるし、活性源石粉塵はほとんど床面に落ちて、タワー内はほぼ安全になってる……とはいえ、今も基準値を超えたエリアがまだ一部残ってるみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "危険エリアの位置はすでに端末に同期してあるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "出力は低いけど、エネルギータワーは稼働状態にあるから、今回は稼働させながらの緊急修理になる。作業時はしっかり防護をして、何かトラブルが発生した時はすぐ報告してね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "二人には感謝しないとね、ありがとちゃん！　お爺ちゃんたちがいなかったら危険なエリアを一つ一つ時間をかけて調べるはめになってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "役に立って何よりだ。わしは人生のほとんどをこの場所に費やしてきた。通路の中のボロ屋より、むしろこっちを「我が家」だと思っとるくらいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "んじゃおうちにがっつり手を加えちゃうよ、マイルズさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "ああ、存分にやってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "うっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "……ここまで壊れてるのに、よくまだ燃えてるなコレ。まさに奇跡だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオーネ",
      "text": "ああ、数年前にマイルズと俺でここの燃焼室を補強したんだ。事故防止と、それからボイラーで源石燃料以外のものも燃やせるようにするためにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイルズ",
      "text": "今年の冬に入ってから、初めの方は廃棄された源石製品がまだあったが、最近じゃ燃やせる木が見つかれば御の字だしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "とりあえず……状況を見ながらやってみるしかないね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "Aチーム現着、ほかの小隊も位置と状況を報告して。一分後に故障箇所の調査を開始するよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通信音",
      "text": "Bチーム、位置につきました。コンバインドサイクル装置の損傷は目測でおよそ30%です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信音",
      "text": "Cチーム、到着しました。冷却システムは完全に破損しているようですが、冬季の低温環境を利用し臨時で空冷システムを作ることは可能です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通信音",
      "text": "Dチーム、位置につきました。灰処理ダクトは現在順調に稼働中、各チームの要求に応じて随時速度を調整できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "了解。それじゃあ、みんな準備して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "作業開始！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "隊長、最後の巡回ポイントに到着しました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "道中で野盗の痕跡は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "いえ……運転の途中には何も発見していません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ジェシカ、わたしはこれからフランカと引き続き銀行の相手をするのに専念する。そちらも気を付けて行動して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ただもし何かあれば、こっちの都合を考える必要はないから、すぐに連絡すること。わかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ヘレナさんの話だと、ウッドロウさんは狩りの帰りにこの近くを通るらしいけど……会えるといいな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "松ヤニの匂い……どうしてここでこんな匂いがするんだろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "松の枝……誰かがここで火を？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "誰かがあそこを通って……ん？　あれは？　ウッドロウさんが区画の外から帰ってきたのかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ハァハァ……ウ、ウッドロウさん、待って、待ってください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "後ろにいるのは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "まずい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ウッドロウさん！　危ない！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "潜伏する野盗",
      "text": "なんだ！？　クソッ、また邪魔が入った。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "……なぜここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ウッドロウさん、この付近は野盗が潜んでいる可能性があります。すぐに区画の安全なエリアまで戻って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの、どうしてそんなに怒った顔を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "お前は本当に余計なことばかりしてくれるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ですがさっきの人は背後からあなたを不意打ちしようとしていて、わたしはそれを助けようと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "俺が苦労してようやくあの野郎を引っ張り出したってのに、お前のその銃弾ですべての手がかりがパーになっちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そ、そんな……ごめんなさい、えっと……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "な、何を調べてるんです？　お詫びに何か力になれることがあれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "ここに野盗が潜んでるってことには気付いたようだが、あいつらがここに来る目的が何か、考えたことはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "生活が苦しくて……物資の略奪とか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "俺たちですら腹を満たすのに苦労する区画の物資なんぞにあいつらが目をつけるとでも？　あいつらは普段、キャラバンを襲って物資を奪うことを生業としてるんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "じ、じゃあ一体何の目的で……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "最近、区画から人間が大勢消えてる。そいつらが失踪する前に、この辺りのチンピラどもと親しげにやり取りしているのを目撃した住民がいる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "次はこっちが訊く番だ、お前はここへ何しに来た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "わたしは……割り当てられた任務に従って、区画の外に潜む野盗が動力炉の修理に影響を与えないよう、区画周辺の無人地帯の安全を確保しに来ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "お前一人でか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "いえ……ほかに数名のチームメイトがいます。それに、ウッドロウさんもここにいますし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウッドロウ",
      "text": "俺は関係ない。じゃあな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そうだ！　弾の件――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あっ、行っちゃった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
