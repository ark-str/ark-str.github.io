  "storyId": "story_melan_set_1_story_1",
  "groupId": "story_melan_set_1",
  "stageId": null,
  "title": "小隊長",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_melan_1_1.txt",
  "sourceHash": "db93fef65a204f5f6970994082e5241d37df94871a362cec7c5ccf533a4a17ea",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 玫兰莎"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "10:30p.m.\nロドス訓練室外"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "どうしてこんな夜遅くに、訓練場の明かりがついてるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "まだ誰か訓練してるのか？　うわぁ……よくやるなぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "あっ、メランサちゃんだったか！　今日もお疲れ様！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "……こ、こんばんは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "こんな時間まで訓練かい？　ここ最近、予備隊の訓練時間がどんどん長くなってきてる気がするけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "やる気があるのは良いことだけど、くれぐれも身体には気をつけるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "あ、えと、ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "ですが大丈夫です。ファロン教官がオーバートレーニングにならないようにコントロールしてくださっていますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "なるほどね。そうだメランサちゃん、晩ご飯はもう食べた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "まだです……でも大丈夫です、お気遣いなく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "まぁそう言わずに。毎日ちゃんと規則正しく食事しないと身体がもたないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "……とはいえ、この時間じゃもう食堂には大したものも残ってなさそうだね。ちゃんと食べるなら自炊するしかなさそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "メランサちゃんは普段料理する？　あっ、もしよかったら俺が手伝おうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "えと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "通路のど真ん中で何をしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "あっ、ドーベルマン教官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "ドーベルマン教官、フランカさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あらお嬢さん、また会ったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "コリン、無駄話している余裕があるということは、今週の書類整理は全て終わっているんだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "しかし、料理を手伝うだと？　お前がまともな料理を作ったことなど今まであったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "それは……ハハッ、ドーベルマン教官、痛いところを突きますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "そういえば、さっきビンスがお前を探していたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "あ、しまった！　まだ仕事が残ってたんだった。それじゃ皆さん、失礼します……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "支援オペレーター",
      "text": "主任には俺がここに来たこと言わないでくださいね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "アハハハハッ！　やっぱりロドスって面白い人ばっかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "まったく、あいつは相変わらずだな……恥ずかしい限りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "メランサ、コリンのやつが失礼をしたな。悪い奴ではないんだが、いつも軽口ばかり叩いて……迷惑なら無視すればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "い、いえ、コリンさんはとても親切ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "そうか、ならいいんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そりゃ親切にするでしょ。こんな可愛いお嬢さんが相手なら、あたしだって親切にするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "え、え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "フランカ、何をニヤニヤしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "何か企んでいる顔だ。私の訓練生を怖がらせないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あらら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "厳しい教官さんだこと。メーちゃんもそう思うでしょ？　ねえ、この人っていつもこんな感じなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "メ、メーちゃん？　えと……それは違います、ドーベルマン教官はとても優しいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "厳しい時もありますが、それはすべて私たちのためを思ってくれているからです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あらあら、褒められてるわよ。人望があるのねぇ、気分はどう？　内心すっごく喜んでたりして——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "コホンッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "それよりも、メランサ。今回の予備隊編成について、すでにファロンから聞いていると思うが——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "検討した結果、お前を隊長に任命することとなった。予備隊コードは「A4」だ。問題なければ明日、署名が必要な書類を準備して渡す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ロドスには全部でいくつの予備隊があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "私が何もかも教えると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "別に。聞いてみただけでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それに安心して、ただの好奇心よ。BSW規模の組織からすれば、ロドスがいくら予備隊を組織したところで、何の脅威にもならないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "結局外部のパートナーより、身内の育成に力を注ぐ方が重要よね。わかるわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "でも……ほら、予備隊の新隊長さんは何か心配事があるみたいよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……メランサ、どうした。何か言いたいことでもあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "あの、教官……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "私——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "もうパンも残ってない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "（今日はやっぱりちょっと遅くなりすぎたみたい……参ったな）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "（職員の人もいない。呼び出したら迷惑をかけるだろうし……仕方ない。今日は食べるの我慢して、戻って早く寝よう）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ため息なんてついてどうしたの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "うわぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "うわぁ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "わわわっ、なに！？　ビックリしたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "えっ……あっ、メイリィ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "えへへ、私だよ～",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "メランサちゃんはここで何してたの？　ディナーの営業時間はもう終わっちゃってるよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "あっ、もしかしてメランサちゃん、まだ晩ご飯食べてないの！？　お腹すいてる？　アドナキエルくんがお菓子を作ってくれたから、一緒に食べようと思って探してたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "そう言えば、今日の訓練で教官に残るように言われてたけど、何の話してたの？　いい話？　メランサちゃんが私たちの隊長になるってスチュワードくんが言ってたけど本当！？　それに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "――あっ！！　いっけない、スチュワードくんはこれは内緒だよって言ってたんだった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "まぁいっか、もう言っちゃったし。それにこーんな嬉しいこと黙ってられないよ！　本当なの？　本当だったらいいなぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "えと……メイリィ、本当に私で務まると思う？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "教官、私じゃ……A4の隊長は務まらないと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "申し訳ありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "ファロン先生と教官でもう一度……人選し直していただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あら、まさかの回答ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "この子、自分じゃ無理だと思ってるみたいだけど、あなたはどう考えてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "何か言ったら？　あなたたちみたいに生真面目な人って、なんでこんなにだんまりさんが多いの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "はぁ……メーちゃん、じゃああなたは、誰なら隊長にふさわしいと思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "例えば……スチュワードさんなら、私よりも物事を全体的に捉えることができます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "以前の模擬戦で私たちは三回ミスしましたが、スチュワードさんがすべて陰でカバーしてくれていました。そのおかげで最終的に好成績を収めることができましたし、みんなから信頼されています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "アンセルさんは、常に私たちの健康状態を気にかけてくれてます。何も言わなくても私たちの体調を見抜いて、その対策をしてくれるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "アドナキエルさんは……えっと、彼が何を考えているかはまだよくわかりませんが、チームが火力を必要とした時、いつも皆の考えをいち早く察知し、最適のポジションからサポートしてくれます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "メイリィ……カーディは明るいムードメーカーでありながら、気配りもできる人です。戦闘ではチームメイトの防衛を第一に考えてくれるので、カーディを中心に陣形を展開することがほとんどです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "隊長には、この四人のうち誰かがふさわしいと思います！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "お前が今言ったことはすべて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……まぁいい。自分で気付いた方が良い物事もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "とにかく、現時点でこの任命を撤回はしない。こちらにもこちらの判断というものがあるのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "教官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "今日はこれ以上議論する余地はない。戻ってよく考えてほしい……できれば小隊のメンバーとも話し合ってくれ。そして明日、改めて回答をくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "その時は、我々はお前の判断を尊重しよう。隊長として相応しいかどうか——できるかできないかは、自分で決めるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "だがその前に、お前に一つ訊いておきたいことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "メランサ、お前はなぜ前線のオペレーターであることにこだわる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "私は——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "私はよく知っている。香りをまとったあの美しいものたちを。\n澄み渡る午後の日差し、キラキラと煌めくガラス瓶、きめ細やかなベルベット……それ以外にも優雅で、文明的で、享楽的なものたちを、私はよく知っている。\n当然だ。なぜならそれらはすべて、私がかつて過ごしてきた日々の欠片なのだから。\nでも血が流れる戦場は、それらとは違う。\n私はどうして戦場に立たなきゃならないの？\nどうしてそんなリスクやプレッシャーを背負わなきゃならないの？\n私は一体……\n私は一体どうしたいの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "メイリィ、私は……オペレーターに相応しくないんじゃないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "ちょ……！　何バカなこと言ってるの！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "えっ？　ちょっとメイリィ、待って、落ち着いて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "テーブルが――メイリィ、そんなにテーブルを叩かないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "テーブルなんてどうでもいいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "だって、どこが相応しくないの！？　自分でそんなふうに言っちゃダメだよ、メランサちゃんが一番——いっちばんいいんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "やめて、私はそんなに褒められるような人じゃないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "もうっ！　反論は許さないからね！　メランサちゃんは自分のことをわかってないんだよ！　私の方が何百倍もメランサちゃんのことをわかってるよ！　自分をそんなふうに言うのは私が許さない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "それでも反論するつもりなら、いいもん！　私がメランサちゃんの良いところをたーくさん教えてあげる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "メランサちゃんはいつも私の訓練に付き合ってくれるし、私のために新しい防御戦術のテストもしてくれる——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "私のためにいつも予備の装置を用意してくれてる。それをわざわざ言うようなことはしないけど、私はちゃんと知ってるんだから！　メランサちゃんはサイコーだよっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "いつもみんなに美味しいおやつを分けてくれるし、よく見たら全部みんなが大好きな味なんだ！　メランサちゃんはサイコーだよっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "他にも、こっそり教官の髪を結ぶイタズラにまで付き合ってくれるんだよ！　メランサちゃんは、ホントにサイコーなんだよっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "ま、待って、最後のは、私やった覚えがないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "えへへ、さすがにそこは騙せなかったか。スチュワードくんは全然気付かなかったんだけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "あっ、でも最後の以外は全部ホントだよ！　メランサちゃんが誰よりもチョーチョーサイコーなのは間違いないんだからっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "ふふーん、まだ反論はある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "ないならもう心配いらないね！　メランサちゃんが隊長に相応しくないなんて思ってる人は、私たちの中には一人もいないよっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "でも……やっぱり一番重要なのは、メランサちゃんがどうしたいかだと思うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "私がどうしたいか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "本当に私でいいの？\n私にそんな能力があるの？　みんなの期待に応えられるの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "わ、私は多分、力不足だと思う。きっとまだ学ばないといけないこともたくさんあるし……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "他の人の考えはともかく、私は……私自身はどう思ってるの？\n私は一体どうしたいの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "私はみんなを守れる力が欲しい。お父さんやお母さんに守られてばかりで、家族と連絡もとれないなんて、そんなのはもう嫌……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "私……挑戦してみたい！　一人前の隊長になって、みんなと一緒に頑張りたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "メイリィ、私……大丈夫かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "もちろんだよっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "これまでだってずっと一緒に頑張ってきたでしょ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "……うん、ありがとう、メイリィ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "うんうん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "えへへ、よかった、やっとメランサちゃんが笑った！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "うーん……もうオレたちも出てって大丈夫なんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "冷凍庫で冷凍食品を見つけて、レンジで温めてるところみたいだけど……スチュワード、どうする？　このお菓子も持っていこうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そもそもなんでずっと隠れてるんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "待って、アドナキエル、アンセル、まだ行かないで。しばらく二人だけにしてあげよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "メランサがあんなにうれしそうに笑ってるのは初めて見たよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "いや、でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "なるほど、スチュワードさんの言う通りですね。今出ていっても雰囲気を壊すだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "そうじゃなくて、カーディに機械を操作させると……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "ええっ！　なんで？　どうして動かないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メランサ",
      "text": "これは……加熱ボタン？　接触不良みたいだけど、そうやって回すものじゃないと思う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "大丈夫大丈夫、やり方はわかってるから。機械は大体こうやれば動くはずだよっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "text": "へへっ、見てて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "……あんな使い方してたら、そろそろレンジが壊れちゃうけど、本当にいいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "そういうことは早く言ってくれよ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "text": "待て、カーディ！　そのスイッチに触るな！　ダイヤルにも！！　メランサ、カーディを止めて！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "text": "アハハ！　もう間に合わないよ、やっちゃったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……はぁ。騒ぐのは構いませんが、ケガはしないでくださいよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あら、頭痛？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……ちょっとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それは部下がキッチン用品を壊して、また請求書が増えたから？　それともあの恥ずかしがり屋の小隊長さんが原因？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "両方だ。メランサは自分にもっと自信を持つべきなんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そう？　あたしはそんなに悪いことだとは思わないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "力不足なのにいっつも自信満々な奴より、慎重な人の方が信頼できるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それにあの子が言ってたこと、覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あの子は、隊員一人一人をよーく見てるわ。それこそ隊長の資質があるって証拠じゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "そこに彼女本人が気付いてくれればいいんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "安心しなさいよ、あの子たちならきっと問題ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そうだ！　あの子も剣使いよね？　なら、あたしに指導させてよ。少しは自信をつけさせてあげるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
