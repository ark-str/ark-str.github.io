{
  "server": "jp",
  "storyId": "act22side_level_act22side_02_end",
  "groupId": "act22side",
  "stageId": "act22side_02",
  "title": "不幸な再会",
  "storyCode": "FC-2",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act22side/level_act22side_02_end.txt",
  "sourceHash": "4f82970d7cf830f4645d26ddd8ac7df9a89c4d22994de9e787e87aecae6857c4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "死にぞこないのターラー人どもめ！　ほんとツイてないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "斬れ！　ぶった斬るのよ！　痛い目に遭わせてやりなさい！　二度と他人のものに手を出そうって気が起きないようにね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンの護衛",
      "text": "そうだ、ターラー人に思い知らせてやれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンの護衛",
      "text": "聞こえたか、このクズども。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ううっ……腕が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "……お前ら、俺たちターラー人が……死にぞこないだと言ったな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ハァ……ハァ……やれ、この商人どもをぶっ殺せ！　死にぞこないはどっちなのか教えてやれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "うぐっ──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "退がれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "あ、あなたどうして鞘で殴ってるの？　真面目にやりなさい、私はあなたたちにお金を払ってるのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "鞘で十分だ。もしこれ以上やるつもりなら、私はキミたちにも鞘を向けるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "それに、私とバグパイプはキミたちに同行しているだけであって、ボディガードとして雇われているわけではない。勘違いするな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "チッ、アンタもあっちの槍の奴と同じ、バケモンか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "前に聞いた「普通の」キャラバンはここを通らないって噂は本当のようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前がリーダーか……その格好、随分と目立つな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "……チェンさん、逃げるわよ！　急いで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "ハッ、何を急にビビってんだ？　アンタさっき、ターラー人を痛い目に遭わせてやれとか言ってたじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "ダブリン……亡霊部隊……化け物め！　やっぱりターラー人が多い場所には亡霊が出るのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "そうさ、アタシらを怒らせるなんてもってのほかだ。姿を見ただけでも、全員口封じのために殺されるんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "デタラメだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私は長い間友人と調査してきたが、あの亡霊部隊がどういった奴らなのかは、よく理解している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キャラバンを連れてできるだけすぐ離れてくれ。この盗賊どもは、私とバグパイプで止める。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "今後、ダブリン部隊の調査は私たちだけで行う。もうキミたちの手は煩わせない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンのリーダー",
      "text": "わ、わかったわ……ハァ、ほんっとツイてないんだから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "まだ追うつもりか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "うぐっ──！　ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "……おいセルモン、何とかしろ！　早いとこあいつらを追っかけて殺さねぇと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "物資の問題だけじゃない……奴らに逃げられたら、必ず警察や軍に告げ口するに決まってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "アンタに言われなくても分かってるさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前たちの力では、私の剣を防ぐことはできないというのも、よく分かっているだろう。だから先ほどは虚勢を張って、私たちを退かせようとしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "……チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "これからどうするんだ？　何か策はあんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……道理で危険が及ぼうとも、その格好を選ぶわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "お前はこの隊の「リーダー」になろうとしているんだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "うっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "軽く当て身しただけだから、ちょっとくらくらする程度でしょ？　人質救出の時に何度も試したから、加減は大丈夫なはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……ああっ、気絶しちゃった。これでも強すぎた？　それとも、元からお腹ペコペコでふらふらだったのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ごめんね……でも、強盗なんて絶対ダメだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "──不意打ちは効かないよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "背中に槍が迫った瞬間、バグパイプは反射的にそれを防いだ。\n双方が一定の距離を取る。相手の顔をはっきり確認し、バグパイプは目を大きく見開いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "──リード？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……傷はもう治ったの？　大丈夫？　どうしてこんな所に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "って、違う違う、おめーさんも強盗しに来たの？　もしそうなら、うちは放っておけないべ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……違う、彼らが手荒な真似をするのを止めたかったんだけど、間に合わなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "でも、いずれにせよ、私は彼らが傷つくところを見たくないし……捕まってほしくもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "そっか、じゃあうちらの目的は大体同じだね。そんな警戒しないでほしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ヴィクトリアの軍人としても、ロドスのオペレーターとしても、うちらが民間人を傷つけるなんてありえない。うちもチェンちゃんも仲裁に来たんだべ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……あ、だけどうちの力は一般人相手には強すぎたかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "とりあえず倒れてる人たちを涼しい所まで運んで休ませようか？　みんなこの村に住んでるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……お願い、出て行って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "もう争いは終わったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "だけど、うちはやっぱり手伝いたいよ。おめーさんも、なんだか考え事がある顔してるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ハァ……わかったべ。相変わらず話すのが好きじゃないんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ロドスにいる時も、お見舞いに行っても門前払いだったからね。うちはてっきり、おめーさんがヒロック郡での出来事を思い出したくないからだと思ってたんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "それならおめーさん、どうしてここに来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "なんか荒野で何日も彷徨ってたみたいな雰囲気だし……おめーさんの任務は何なの？　うちとチェンちゃんがついてってあげようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ありゃ、訊きたいことが多すぎて、頭がこんがらがってきたべ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……大丈夫。私はただ、偶然この人たちに誘われて……護送しているだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "これまでもずっと外で単独行動してきたから、荒野での危険にも慣れてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "それに、私はロドスの任務に就いているわけでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……私はダブリンに関する情報を追っているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "道理で……うちとチェンちゃんも同じだよ、だからここで出会ったわけだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ヒロック郡であんな大怪我を負ったんだもん。やっぱりおめーさんもダブリンが気になるんだね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "ダブリンの中に、私の人生を一変させてしまった人がいるんだ。だから私は……何か取り戻せないか試してみたくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "ダブリンがもたらした苦しみを和らげるためであろうと、私自身が平穏を感じるためであろうと……できることはやるつもり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……よかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うちらはキャラバンと一緒にここに来て、最近この近くに現れたというダブリン部隊を探すつもりだったんだべ。でも突然おめーさんと出会っちゃって、ものすごく驚いたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "でもよかったよ。おめーさんたちがダブリンと繋がってなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "じゃあこうしよう。うちがチェンちゃんに任務を数日延期しようって提案してみるよ。チェンちゃんもきっとこの人たちを助けてくれるからさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "さっき私が何人に尾行されながらこの応接室に入ったと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "ターラー人とヴィクトリア人の間で、君がどういう役回りを演じているかは興味がない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "だったらあなたがわざわざトレント郡まで駆けつけて注意を引いてくれたことに感謝すべきね。あなたのことだから軍の内部でずっと隠れてるだろうと思ってたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "リーダーの計画はすでにここまで進んでいる。私がウェリントン公爵の親衛隊メンバーであるか、あるいはダブリンの将校であるか、この二つの身分の違いなど、もはやどうでもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "君を監視しているのがカスター側の人間である以上、恐らく彼らもこの情報をとっくに把握しているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "というか、都市の外で小規模のダブリン部隊が絶えず出現していることや、ダブリンの大軍が通過したって噂が流れてるのは……わざと彼らに知らせるためにやってるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "それにいくつかの怪しい取引の情報によって、鉄公爵がこの都市において何か企んでいるって噂は、今はもうゴシップ好きの商人たちの間にさえ浸透しているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "誰もが必死に嗅ぎ回って色々と推測してるでしょうね。あの公爵がトレント郡を舞台に何がしたいのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "まさにリーダーの期待通りだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "そうよ。もし私たちの真の目的地が早いうちに見つかって、各公爵がリーダーの決定を事前に知れば、オークグローブ郡の外もきっとロンディニウムみたいに賑やかになるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ねぇ、彼らはサルカズとターラー人のどっちをより恐れると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "ターラー人と魔族を比べるなど……君にそんな冗談を言う資格はないな、ヴィクトリアのフェリーン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "……「スパイ」が死んだと聞いたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "そうなのよね。あれから、ロンディニウム内で得られる情報が大幅に減っちゃったの、ほんと残念だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あそこにはサルカズ以外にも、そうね……なかなか面白い勢力が潜んでいるみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "前にも言ったはずだ。その感情的な性格がいつか君の計画を台無しにするだろうとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "感情的？　私をそんなふうに見る人はもうあまりいないと思ってたけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "マンドラゴラを生かそうとしたのは、感情的な判断ではないとでも言うつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "彼女は「雄弁家」に利用され、ダブリンの分裂を試みた。本来ならあの六人の裏切り者と共にヒロック郡で死ぬべきだったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "マンドラゴラは「スパイ」が最も信用する人物だった。「スパイ」が裏切るかどうかの確認が取れる前に彼女を処刑することは、賢明な選択とは言えないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "詭弁だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "「スパイ」救出の任務は、君と私が行くまでもなかったとはいえ、より信頼できる者に行かせるべきであった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あら？　でも私とあなたは仲が悪いわけだし、一緒に行かない方があなたにとっては僥倖だったんじゃないかしら？　私に何かされるかってビクビクしたくないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "口先ばかり達者だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あなたも、公爵様とリーダーが最終的な決定を下すまでは、軽率に動いちゃダメよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ロンディニウムの情報の重要性が、あなたにわかって私にわからないはずないでしょ？　でも最終的に私たちがロンディニウムに進軍するかどうかは、今はまだ未知数なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "公爵間の協力関係の進展次第か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "もちろんよ。何のために私が今、駆けずり回ってると思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "……フッ。四年前の飛び地におけるあの戦争において、「大貴族たちが協力した成果」を、我々がどんな思いで待っていたか、未だに覚えているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "各勢力の思惑を抱えた使者たちが、数千キロ離れた場所で奔走し、公爵への一言を届けるために何週間にもわたって辛抱強くあらゆる手段を駆使したものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "アルモニ、せいぜいリーダー側についておくんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "当たり前でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "マンドラゴラはすでに死んだ……君が彼女を助けようとした件についてはこれ以上追及しないでおいてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "だが、あっちの方はまだ生きている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ああ、あの愛しくて可哀想なラフシニーのことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "「雄弁家」のヒロック郡での陰謀を再演させてはならない。彼女が生きている限り、ダブリンとリーダーへの脅威は依然存在する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "リーダーは君に彼女の行方を掌握する任務を与えた。これ以上情にほだされるなよ、アルモニ。失敗はそう何度も許されないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ハァ……あなた、プロのスパイの感情だとか、気持ちに勝手な想像を膨らませ過ぎよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「将校」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ほらほら「将校」さん、そんな怖い目で見ないでもう出て行って。メイクの手伝いをしてくれるなら話は別だけど。私はまだこれからパーティーに行かなきゃいけないのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "やるじゃねぇか、ヴェン。あん時と一緒だな。アンタっていつも頼りねぇのに、結局は毎回うまいことやってくれるんだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ハァ……でもこれっぽっちの食料じゃ、何の役にも立たないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "あの二人、ヴィクトリア人だろ？　町へ行っていらねぇモンを交換して、護身用の棍棒も手に入れてきてくれるってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "まともな武器が持てるんだぜ、うれしくねぇのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "まあいいや。ラジオでキャラバンが襲われたってニュースはやってなかったか？　そもそもあの臆病者ども、ダブリンの報復を恐れて通報する勇気がねぇのかもな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "……おい、ヴェン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "何見てんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……あの感染者たち、村を出てからずっと、私たちの後ろを一定の距離を取ってつけて来てる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "まだついてきてんのか？　こんなに速く歩いてるってのに、病人の足で──しかも子供まで連れてるくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そうだね、ついてくるのはそう簡単なことじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "私は……私はモランが心配なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "彼女は数年前の飢饉で目を患って、夜になると道が見えないんだ。今さっき鎮火の鐘も鳴ったし、道には明かり一つない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "そうか、そいつは可哀想にな。で、あいつらはなんでついてきてるんだ？　アタシらが救援隊か何かに見えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "わからない、うーん、もしかしたら君のその服のせいかも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ほら、私以外はみんな、君を本当のダブリンだと思ってるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ダブリンがターラー人に良くしてくれるってのはみんな知ってる。そういうことじゃないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……私が、彼らと話してくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "わっ、ビックリした……どうして声が震えてるんだい？　大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……見張りの交代要員が増えるのは悪いことじゃないよね……巡回隊をより避けやすくなるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "だから私が……彼らを連れて行く。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
