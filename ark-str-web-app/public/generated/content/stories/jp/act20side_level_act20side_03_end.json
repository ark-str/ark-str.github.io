{
  "server": "jp",
  "storyId": "act20side_level_act20side_03_end",
  "groupId": "act20side",
  "stageId": "act20side_03",
  "title": "奇談怪論",
  "storyCode": "IC-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act20side/level_act20side_03_end.txt",
  "sourceHash": "98c5401583aabced7ff6718bd9b503b6497c503cd60e9be328d6136fd271dd14",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "スキャン完了デス。機体リニューアル。パーフェクト！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ハハ、そんなにグルグル回って……チビすけ。お前が元気を取り戻せて、私も嬉しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "ズゥママ！　メンテナンス、トテモ上等。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "ズゥママ！　ヘルプ申請。小規模。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "ナンバー0428ノ仲間。引退後活動停止中。要修理。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "当機ト同ロット。施設建造ニ共同従事。現在応答ナシ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "応答がない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "焦らなくていい、案内してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "コッチ。ズゥママ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "動かないロボット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "この構造、この部品……うーん、やはり単純な修理では無理か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "これはどういう原理だ？　このパーツは何のためにある？　姉様の機体とは構造が全然違う。クロージャ師匠からも類似する技術は聞いたことがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ここを繋げれば……いや、やはり慎重にいくべきだ。この子はお前の友達なんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "トモダチ？　ズゥママ。未定義コードニヨル入力ヲ反復。当機未ダ理解不能。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "修理不能デスカ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "資料があればいいんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "資料？　図書館。資料保存。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "連れて行ってくれるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "ヨロコンデ！　ゴ案内。ズゥママ、コッチ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "面白いわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "見たことない対話モードを使いこなしてるわ。地上人……研究する価値があるわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔ったドゥリン人",
      "text": "エリジウム、あのスーパースパイラルスライダーを頭から滑って、誰が一番早く逆さのまま飛び出せるか勝負しようぜ、どうだ？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ハッ、ロドスの華麗なる水上レジェンドを見せてあげるよ！\nソーンズの奴ですら、これで僕に勝ったことないからね！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "正直さ、アンタとこんな所をブラつく気なんて少しもないんだよ。それならあの最悪なアカフラのジャングルの中で、鉗獣に食われた方がまだマシだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "そんなこと言わないでよスディチ。僕はただ、君の意見を聞きたいだけなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ゼルウェルツァの住民がどう思おうと、君が優秀な建築デザイナーなのは僕が一番よく知ってる──君も、君の師匠も、どっちもその名に相応しいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ゼルウェルツァのこの素晴らしいドーム構造は、ドゥリンのどんな建築学の書籍にも載っていないオリジナリティがある。もし君が──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "そのことでオレを呼び出したんなら、やっぱり帰らせてもらうよ。お互いの時間を無駄にしない方がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "「どでかい水たまり」のデザインを君が嫌ってるのは知ってるよ。あの滑り台にしろ、噴水にしろ、確かに素晴らしいとは言えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "でもスディチ、僕が本当にデザインしたいものが何か知ってる？　君と同じで、頭上にあるこのドームなんだよ！　僕たちがこれまでずっと競い合ってきたこのドームなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……ハハッ、オレの前でそんなこと言うなんて、ほんと図太いな。そんなに殴り合いたいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "僕たちはいいライバルだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "ハッ！　いいライバルだって？　オレを高く評価し過ぎだ。いっそ抱き合って、熱い涙でも流すか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "僕は真剣に話してるんだよ、スディチ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ただ確認しておきたいだけなんだ。どうして数年前、ドームの改造計画を途中で諦めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "あれ以来、君は表舞台から去って、多数決大会で君のデザインを目にすることはなくなったよね。まさか本当に、自分の美学で人々を納得させる気がなくなったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "本当に、ヴィンチ先生が何も言わず去ったことを受け入れたの？　でもあの人は君の──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレに説教するな、キャッチ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "……オレはただ、飽きて嫌になったんだ。それだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレはただ、自分のあらゆる野心をこのボロドームに注ぎ込んで、ゼルウェルツァの住民たちがオレのデザインに納得できるように、あれこれ説明を考えるのにうんざりしただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "アンタみたいな「理想を抱えた建築デザイナー」と一緒に、あちこちに提案を売り込む日々にはうんざりなんだ。くだらないんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "いいか、よく聞け。オレたちの頭上にあるこいつが水漏れしようが爆発しようが、多数決で取り壊すことに決まろうが──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "オレには何の関係もない、勝手にしろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "だけどこのドームは君の師匠が──",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "これが最後だぞ！\nかっ！\nて！\nに！\nし！\nろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "ハァ……わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "スディチ、ほんとは君に協力してもらって、一緒に新たなドームのデザイン案を考えたかったんだ。そうすればきっと、大多数の住民から改修の同意を得られるはずだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "でも君がそこまでドームに関わりたくないというのなら、僕も強制はしない。君の意見を尊重するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "でも、あと少しだけ時間をもらえないかな？　ドーム改修についての新しいアイディアを聞いてほしいんだ。それとアドバイスもしてほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "全く興味な──いや、とりあえず聞かせてもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "本当？　よかった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "まずはね、もっとカラフルにすべきだと思うんだよね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "複雑な幾何学模様にすれば、ドームの美しさが増すと思うんだ！　ガラスのフルーツ皿みたいにさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "黄色や緑、赤や青がぶつかり合うんだ！　ゼルウェルツァの住民は空を見上げた時に特別な美しさを感じられるはずだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "昼夜を問わず、いつだって新しいドームはみんなの注目の的さ！　安らぎを得たい時は、いつでも心の拠り所になってくれるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "キラキラした巨大な宝石みたいに！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "どう？　個人的には、とても独創性あふれる素晴らしいアイディアだと思ってて、すごく満足してるんだ。でも君の意見にもちゃんと耳を傾けないとね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "キャッチ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "もしかして考えを改めてくれた？　良かった！　それじゃあ一緒に僕たちで──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "このドームには指一本触れるな。オレが全力でアンタを阻止する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "たった今、「全く興味ない、勝手にしろ」って言ったじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "アンタらはこのドームの死骸を、元通りの形に蘇らせるか、いっそ破壊して埋葬するかと思ってたんだよ、それならどうだっていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "だけどそんなやり方で汚すことは許さない！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャッチ",
      "text": "えぇっ？　僕のあふれんばかりの敬意が表れているだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スディチ",
      "text": "──ダメだ、今日こそアンタを殴らないと気が済まない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "修理資料ノ位置ヲ検索……文書保管室エリア59開架書庫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ここか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "ハイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "どれどれ、うーん……これはドゥリンの文字か？　全く読めない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "書名読ミ込ミ。『大冒険家ノ地上旅行記』及ビ『ドゥリン美酒ノ基本的ナ醸造法127種』。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "再検索……発見：『アナタノ知ラナイスーパークレイジードゥリン人大計画』、『社会行動ノ影響ニ基ヅクサイバネティクス研究』……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "チビすけ、本当に探している資料はここにあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "存在確率42.377%デス。ドゥリン人ハ整理メッタニシナイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ、この辺の文字は読めるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "『奇談怪論』が棚三つ分もある。もう十年以上前のものだな。この列はヴィクトリア語の本だ……カジミエーシュの『ザ・レッドワイン』まであるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "私たちはそれで地上の言語や文化、情報なんかを学んでいるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "なるほど、道理で意思疎通にあまり困らないわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "これはドゥリン人が作った雑誌か？　……『爆裂改造！　セルカー大出撃』……「雑誌購入でベースマシンを一台プレゼント」……これはあちこちで走り回ってるあれのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "クロッケは、セルカーのカスタムを商売にしてて力を注いでるの。そのブースターパックはゼルウェルツァ中で大ヒットしているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "「みんなランダム要素が好きなんだ」って彼女は言ってたわ。私にはさっぱりわからないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "しかし、どうしてサルゴン語を使っているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "『奇談怪論』の素晴らしさを受け継ぐため、雑誌はサルゴン語で書くべきだと言われているわ。少なくとも私たちドゥリンはそう考えてるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "あなたが探してるのはこれ？　『三秒であなただけのアシスタントロボットを作ろう』。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "使えそうな本だな、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "ナンバー0429ヨリ、ゴキゲンヨウ！　デカルチャー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "知り合いか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人",
      "text": "自己紹介をさせてもらうわね。私の名前はデカルチャー・シルバーミント、ゼルウェルツァの工業代表よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "アシスタントロボットの管理者でもあるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "管理者……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "ええ、ゼルウェルツァのアシスタントロボットはすべて私が製作、監督、管理しているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "R3-E3型アシスタントロボット、ナンバー0429、あなたはここで何をしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "当機、ナンバー0428ノ修理申請ヲズゥママニ提出。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "0428はもう引退したのよ。今すぐ持ち場に戻って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "text": "……承知シマシタ。指示ニ従イマス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "ズゥママ、あなたとアシスタントロボットとのコミュニケーションは変わってるわね。0429の反応も少し……異常だったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私たちのコミュニケーションのどこが変なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "うまく言えないけど……ていうか、コミュニケーションを取ること自体が変よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前はこのチビすけたちとコミュニケーションしないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "しないわ……ロボットたちにはただ仕事を命令するだけだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "それは良くない。私は姉様としょっちゅう会話をしているぞ。姉様はひんやりした金属のボディに寄りかからせてくれるし、アームで私の肩を叩いてくれる。それに姉様の美しい合成音声ときたら──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "……は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "そんなこと『奇談怪論』には書いてなかったわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "えへへ、大収穫です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "サイズが合う服は買えませんでしたが、この小物も素敵です！　初めて見る鉱石に、珍しい金属の風鈴、それとこの可愛いストラップ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "何よりも！　ガヴィルさんが私のために選んでくれたもの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ああ〜！　ガヴィルさんも一緒にペアネックレスを買ってくれたら最高だったのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……彼女、大丈夫ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あー、大丈夫だ。こいつはガキの頃からずっとこうだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "本で読んだことがありますわ。こういった物品をため込む行為は、地域によっては「ザラック症」と呼ばれているそうですわよ。原因は恐らくストレス、もしくは別の何か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "違います、私は嬉しいんです！　これらは私にとってどれも大切な思い出なんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "そうですか。ではお好きになさいまし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ところで、アヴドーチャってのはウルサス人の名前だろ？　お前の故郷はウルサスか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "わらわの名はアヴドーチャ・レザーペン。一般的なドゥリン式の名前ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "けど、アヴドーチャはウルサス語だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "何が仰りたいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ただの世間話だ、そうムキになるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……あそこはわらわの家ではありません。わらわはただ、あの場所から来たというだけにすぎませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "わからねぇな。お前はなんでそんなに地上を警戒してるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "幼い頃、わらわは家庭教師である文法の先生と一緒に過ごす時間が好きでしたわ。彼女は基本的にはつまらない方でしたが、たまに面白いことを言いますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ウルサスには故郷を描写した文学が数多くございますわ。先生はいつもそれらを褒めたたえ、わらわにそういった作品のモチーフや文章を分析しましたわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "当時のわらわはこう思っておりましたの。人は皆、故郷を懐かしむものであり、遠くへ行った者たちもいつかは出発点へと戻って永い眠りにつくのだと。……ですが、後に違うと気付きましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "故郷に関する記憶が苦痛ばかりで、移った先こそが安住の地であるなら、なぜ、ただ生まれ育ったからというだけで、故郷を懐かしく思わなければならないのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "そこは旅の途中の宿場と何の違いもありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "アヴドーチャさん、あなたはどうしてウルサスを去ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……口にしたくもありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "吐き気を覚える出来事でしたわ。たった一晩でわらわは身分も、家族も、友人もすべて失いましたの。わらわはあそこから命からがら逃げ出したのですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ウルサスからサルゴンへ、そしてドゥリン人の地下都市か……楽な道のりじゃなかったろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "目的地すらない状態で、楽も何もありませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "わらわはただ運が良かっただけですわ。最終的にここ──ゼルウェルツァと呼ばれるこの小都市を見つけられたのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ドゥリン人は、わらわのことを受け入れてくれましたの。ならば、わらわはさらなる善意で彼らにお返しをしなくてはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……ここはわらわが、自分で選択した居場所ですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ですから、何であろうと地上のものに彼らを傷つけさせませんわ。純粋なる悪はもちろん、たとえ善意によるものであったとしても、許しはしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "これは貴方がたへの警告ですわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "……そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前と仲良くしようと思って、一杯おごるつもりだったんだがな。そういうことなら、やっぱりナシか──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "一杯おごるのがナシという意味ではありませんわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "──ぷはぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "うん、飲みっぷりはやっぱウルサスっぽい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "お黙りなさい。ドゥリン人もこのようなノリでしてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "マジな話な、アタシは心理カウンセラーじゃないし、人の心に関することは詳しくない──てかわかろうとも思わねぇ。体を治療するだけでも大変だしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "だけど、お前がどんなに装おうと、本当のドゥリン人にはなれないと思うぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "わらわたちはまだ、お互いの身の上に意見し合えるような間柄ではありませんわよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "さっき、お前とドゥリン人の店主が話してるのを聞いたけどよ……お前、雪原に関する物語を書いてるそうじゃねぇか。しかもそれがあんま流行ってねぇとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "……ええ。地下には雪もなければ、平原もありませんもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ハッキリ申し上げますけど、わらわがそれを書いているのは、あの場所を懐かしんでいるからではありませんわよ。ただ……あそこが物語が起こる土壌であるというだけにすぎませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そこで物語が起こることを知っている時点で、お前はドゥリンとは違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "覆い隠せない痕跡はありますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ですが、わらわは努力し続けます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "たとえお前がありのままでいたとしても、ここのドゥリン人たちはお前を大喜びで受け入れてくれるはずだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "ですが、もしわらわ自身が新たな自分を欲しているなら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "……そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "貴方の仰る通り、ドゥリン人は常に大喜びで他人を受け入れます。今回はわらわや貴方がたですけれど、では次は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "お医者様である以上、人の心に潜む悪を理解していないはずはないでしょう？　人が互いに傷つけ合うために、どのような恥知らずな行為をするかについても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "これは種族の問題などではありませんわ。地上か地下かですのよ。暴力を振るうのに慣れ、蓄財に飢え、野心に満ちあふれる……わらわたちをこのような姿に変えたのは、他でもない地上の全て……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "わらわはかつてその中に浸かり切っていましたわ。ですから新たな自分を求めていますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "「悪」は学習され、伝染いたします。地下の人々はその経験がないため、「悪」への抵抗力がありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "確かにわらわはドゥリン人にはなれません。ですがこの場所を守るためであれば、わらわはゼルウェルツァの市民として、喜んで尽力いたしますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "──汚れたことのない、この純真さを守るためなら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "お前、ドゥリン人は自分たちで問題を解決できるって言ってなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "text": "揚げ足を取らないでくださるかしら！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
