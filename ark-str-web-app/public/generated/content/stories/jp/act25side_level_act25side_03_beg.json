      "speakerName": "サリア",
      "speakerId": "avg_npc_896_1",
      "isRemote": false,
      "text": "独善的で自分が他者より優れていると思い込んでいる人物だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_896_1",
