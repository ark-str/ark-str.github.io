{
  "server": "jp",
  "storyId": "story_snakek_set_1_story_1",
  "groupId": "story_snakek_set_1",
  "stageId": null,
  "title": "リュック争奪戦",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_snakek_1_1.txt",
  "sourceHash": "8346a6258cf819f2cb39ab753cffe9d5382c2b5013c2060f8cad45841bba99e7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "うーん……地図通りなら、この商店街で合ってるはず。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "想像していたよりもずっと大きいや。屋台もいっぱい並んでる……サイフに入ってるお金で足りるのか、心配になってきちゃった……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "わ、水晶餃（シュイジンジャオ）だ！　蓮蓉包（リエンロンパオ）もある！　おいしそうなものがいっぱいだ……ちょっと味見するだけなら、そんなにお金は使わないよね？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ふぅーーゲフッ、おなかいっぱい！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "いやいや、食べてばかりじゃダメだよ！　みんなへのプレゼントを買わないと！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "はあ……だって悪いのはボクだもん。カーディちゃんにリュックを踏まれちゃっただけで怒るなんて……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "本当は怒るつもりじゃなかったのに、でもリュックが……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "やっとみんなと友達になれたんだ！　このままずっとぎくしゃくするのはダメだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ステキなプレゼントを持っていって、カーディちゃんにきちんと謝ろう！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "この光沢、模様、そして重量感……"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "間違いねぇ！　こいつが売れれば俺たちは億万長者だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "フフッ、あのクルビアの女、蔑んだ目で俺たちを見やがって。"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "ナメんじゃねぇつーの！　自分の持ちモンの価値も把握できねぇってなら、代わりに「大切」にしてやるよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "さすが兄貴だぜ。二言三言で言いくるめて、手に入れちまうなんてさ……"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "あの馬鹿女、自分が騙されたなんて夢にも思わねぇだろうよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "言葉に気を付けな。俺たちは騙してなんかいねぇぜ。お願いしただけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "ずっとその日暮らしで頑張ってきたんだ。天が俺たちの味方をしてくれるのも当然のことだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "兄貴の言う通りだ！　それでよぉ……"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "なんだ兄弟！　言いたいことがあるならはっきり言ってみろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "そのペンダント、ちょっと触らせてほしいなあーって……"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "そんなことか！　ほらよ！　窓辺に立って光に透かしてみな！　模様がさらにくっきり見えるぜ！"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "ほんとだ。やっぱ外国のもんは龍門と少し作りが違うんだなあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "ん？　この模様……獣の形に見えるぞ？　背中についてんのは――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "青年は手を滑らせてしまい、ペンダントは窓から外へと真っ逆さまに落ちていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "これと、あとこれもちょうだい！"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の店主",
      "speakerId": null,
      "text": "はいよ、お嬢ちゃん。包んでやるからちょっと待ってな！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "袋は大丈夫だよ、全部リュックに入れちゃうから！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "そうだ、まだお金払ってないんだった……えっと、サイフは上着のポケットに入れてたっけ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ペンダントはちょうど、クオーラが開けっ放しにしたリュックの中に落ちてきたが、会話に夢中だった店主とクオーラは全く気付かなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の店主",
      "speakerId": null,
      "text": "お嬢ちゃん、格好からして龍門人じゃねぇな。旅行かい？　なら特別にお安くしとくよ！　ほら、お釣りだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の店主",
      "speakerId": null,
      "text": "ずいぶんたくさん買い込んだな、ご両親へのお土産かい？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ううん、友達へのプレゼントだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の店主",
      "speakerId": null,
      "text": "へぇー、お嬢ちゃんは友達が多いんだねぇ。これも持っていきな、オマケだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の店主",
      "speakerId": null,
      "text": "全部手作りの龍門の特産品さ。友達に分けてやりな！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ありがとう、おじさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の店主",
      "speakerId": null,
      "text": "いいってことよ！　龍門を心行くまで楽しみな。でも荷物からは目を離すなよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の店主",
      "speakerId": null,
      "text": "最近は観光客を狙ったコソ泥が多いんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "大丈夫だよ！　ボクこう見えてけっこう強いんだから！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "もしコソ泥が襲ってきても、カーンってかっ飛ばしちゃうよ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "龍門の人たちがこんなに親切だったなんて！　店主のおじさんもオマケをいっぱい持たせてくれたし……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "帰ったら一個ずつちゃんと整理して、ロドスのみんなに分けてあげるんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "動物の置物セットはちょうど二個ペアだから、アドナキエルくんとスチュワードくんに一個ずつで……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "それと、この炎国のシルクで編んだ帽子はメイちゃんに！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "オルゴールはラヴァちゃんでしょう……スカーフはドーベルマン教官……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "はあ……いっぱいお店を見て回ったのに、カーディちゃんにピッタリなプレゼントは結局見つからなかったな……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "何をあげたらいいんだろう？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "お嬢ちゃん、ちょっと待った！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "へ？　ボクに何か用？"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "さっき土産屋で買い物してただろ？　俺、あの時ちょうど上の階にいてさ、窓から物を落としちまったんだよ。金属製のペンダントだけど見なかったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "そうなの？　全然気づかなかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "ちょうどあんたのリュックん中に落ちた気がすんだよな。ちょっと開けて中を見せてもらえねぇか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "待って、ボクが探してみるから……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "あれ？　さっき店主のおじさんからもらったオマケ、みんな金属製の小物だ……さてはそれを見てたから、こうしてボクにたかりに来たんだな！？"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "なっ！？　言いがかりだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "さっさとリュックを寄越せ！　俺が探す！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "やめてよ！　ボクのリュックに触らないで！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ふん！　ボクの物を奪おうだなんて、このバッドが黙っちゃいないからね！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三十分後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "ふむふむ。"
    },
    {
      "type": "dialogue",
      "speakerName": "そそっかしい青年",
      "speakerId": null,
      "text": "兄貴、そりゃナイスアイディアだ。すぐに準備に取り掛かるよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "もうドジ踏むんじゃねぇぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "ったく、あの間抜けめ、役に立たんどころか、足ばっかり引っ張りやがって。"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "あんな小娘にああもあっさりのされちまうとはな。"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "力でダメなら頭を使うまでだ。計画を変更するぞ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "屋台のおじさんが言ってたのは本当だったんだ……でも、ボクってそんなに観光客っぽいのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "龍門ってあんまり治安のいい街じゃないんだね……"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "ちょっと待った、お嬢ちゃん。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "えぇー、またぁ……？"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "おっと、誤解しないでくれよ。さっきすれ違った時に、龍門は治安が悪いとか聞こえたもんだから、ちょっと詳しい状況を把握しておきたくてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "この通り一帯は俺の担当エリアなんだ。ほら、俺の身分証。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "龍門……街道管理員？　つまり何をする人なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない青年",
      "speakerId": null,
      "text": "(こっちはあらゆる状況に対応できるよう、前もって準備を済ませてあるんだよ。身分証の数だけ、信用を獲得できる要素が増える。今回はこの設定で遊んでやるさ。)"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "街の秩序を保ち、力の及ぶ範囲で市民の困り事を解決するための存在だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "それで、何か嫌なことでもあったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "近頃、偽物や粗悪品を観光客に高額で売りつける露店があるとの情報を聞きつけたから、今日は私服でこの辺りをこっそり調査していた最中だったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "もしそのような状況に遭遇したのなら遠慮なく教えてくれ。俺が解決してやる。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "うーん……でも、さっきの店主さん、すごくいい人っぽかったけどなあ。割引してくれたうえに、オマケもいっぱいつけてくれたし……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "しかも、あんなにたくさん買い物したのに、大してお金も使ってないよ。むしろクルビアにいる時より安く感じるくらい……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "そうだ！　さっき変な人がボクの荷物を奪おうとしたんだった！"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "ほう？　そいつの見た目や格好を簡単に説明してくれるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "うーんと……男の人で、ボクより背が高かったよ。それから、えっと……はれ？　どんな見た目をしてたのか、よく覚えてないや……"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "それだけの情報で見つけるのは難しいな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "今回はいいや。カーディちゃんのプレゼントを探す方が大事だし。ありがとう管理員のお兄ちゃん、ボク他の所を回ってくるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "友達にあげるプレゼントを探しているのか？　何をあげるかはもう決まってるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "俺はこの辺りで何年も働いているから、お勧めの店を紹介できるかもしれないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "よそのことは詳しくないけど、龍門のことなら任せな！　なんだって俺たちは人々の困り事を解決するためにある龍門街道管理員なんだから！"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "龍門の公務員として、外国からわざわざ来てくれたお客様に「治安が悪い場所」なんて印象を残すわけにはいかない。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "だからお嬢ちゃん、困ったことがあれば遠慮せずになんでも言ってくれよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ええと、そういうことなら……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "実は少し前に友達とケンカしちゃって……だからプレゼントを持って謝りに行こうと思ってるんだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "でも色んなお店を回ったのに、ピッタリなプレゼントが見つからないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "喜んでくれそうな物はなかったわけじゃないけど、「これだ！」ってピンとくるものがなくて……"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "友達へのプレゼントなら、真心がこもっていれば十分じゃないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "俺もせっかちだからさ、つい友人にカッとなることもあるけど、飲みに誘って真面目に謝ったあとに奢ってやれば、大抵のことは水に流してもらえるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "だから、その友達にはちゃんと声はかけられたのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ううん、まだ……気まずくてうまく話しかけられないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "じゃあ、その子の好きなものは？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "あっ……そういえば、カーディちゃんって何が好きなんだろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "カーディちゃんは昔、スキー選手になるのが夢だったって、アドナキエルくんが言ってたっけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "それと前にカーディちゃんの部屋に行った時、長い間使ってなさそうなスキーウェアがかかってたのを見たな……"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "だったらスキー関連のプレゼントはどうだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "うーん……でもボク、スキーのこと全然分かんないよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "ははっ、君は見るからに野球好きだもんな。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "野球は試合応援だけ？　それとも自分でもプレーするのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "もちろんするよ！　それとボクは野球が何よりも大好きなんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "それなら野球関連の物を送ったらどうだ？　友達に好きな物を共有するのも、プレゼントのコンセプトとしては悪くない。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "うーん……だけどカーディちゃんは、まったく野球に興味なさそうだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "前にロドスのデッキでちょっとした野球試合をやった時も来てくれなかったし……"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "そうだ、野球と言えば、この先の通りにショッピングモールがあるんだが、そこのバッティングセンターで何やら景品がもらえるイベントをやってるみたいなんだ。行ってみるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "何も思いつかないのなら、景品をプレゼントにするのもアリだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "自分で勝ち取った景品は、買ったものよりももっと気持ちがこもってるだろうしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "確かに……ラヴァちゃんもプレゼントは手作りの方が喜ばれるよって言ってたけど、ボクは工作が全然得意じゃなくて……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "でも野球はボクの一番の特技だから、これで手に入れた景品をプレゼントにするのは悪くないかも……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "よし、行ってみよう！　しばらく野球できてなかったし、ついでに思いっきり楽しもう！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "あそこがゲームエリアだな。ちょうど空いてるみたいだし、行ってみよう！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "あの変な機械が置いてあるところ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "寄ってらっしゃい見てらっしゃい！　バットを振って豪華景品を手に入れよう！　本日がイベント最終日、どうかお見逃しなく！"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "(へぇ～、あの間抜けでもきちんと変装すりゃ、そこそこサマになるじゃねぇか。)"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "(休業したばかりのゲーセンを利用して小娘を引っかけるくらい朝メシ前さ……ああ、俺ってほんと天才だぜ！）"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "あのー、ここでバッティングができるって聞いたけど本当？　景品はどんなのがあるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "あっ、えっと……景品は……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "わあ！　このショーケースに入ってるの、全部景品？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "あれは！　ねぇ、あのスキー板も景品なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "おっ、スキー板がお目当てかい？　だけどコイツは一等賞だから手に入れるのはちょっと難易度が高めさ……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "はれ？　店員さん、どっかで見たことあるような……"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "お嬢ちゃん、そんな常套句で好感度を上げようとしたって、ゲームの難易度を下げてやることはできないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "あのピッチングマシンが見えるか？　あそこから飛んでくるボールを打ち返せば、球が当たった位置に応じて得点がスコアボードに表示される。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ということは、真ん中の赤いとこに当てれば大賞をゲットできるってこと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "そう簡単にはいかないよ！　一ゲーム10球で40龍門幣。それで得点が475を超えれば大賞ゲットだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "試してみるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "475点って、最低でも赤い部分に5回は当てないといけないってこと？　それはいくらなんでも難しすぎるよ！　もっと低い点数でもらえる景品はないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "街道管理員？",
      "speakerId": null,
      "text": "（何やってんだ。そんなに条件を厳しく設定したら、一回試しただけですぐにあきらめて帰っちまうだろうが！）"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "ああ、もちろん。お客さんには何回でも挑戦してほしいからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "一回のゲームで475点に届かなかったとしても、連続で挑めば次のゲームでは大賞のボーダーラインが下がる。何度か挑戦すれば、最終的には200点で大賞がゲットできるようになるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "（小娘相手なら、この程度の時間稼ぎで十分だろ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "うんうん……このスキー板だったら、カーディちゃんもきっと喜んでくれるはずだよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "それに、カーディちゃんがスキーしてるところを想像したらボク、なんだかワクワクしてきたかも！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "よし、とりあえずやってみよう！　一発で取ってみせるよー！　オラオラー！"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "それじゃあ先に参加費を払って、後ろのロッカーが荷物を預けてきてくれ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "さすが龍門だね！　こんなに歩いたのにまだブロックを二つしか通り過ぎてないなんて。もう足もガクガクだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": null,
      "text": "片っ端からお店に入ろうとするからですよ。しかもさんざん商品を見て回ったのに、結局何も買わないなんて。"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "だって今金欠なんだもん！"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": null,
      "text": "ああ、そういえば数日前にグローブとバットを注文してましたね。"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "うん、クオーラちゃんへのお詫びにね。しかもお金がちょっと足りなかったから、自分の持ち物を何個か売ったんだよね……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイ",
      "speakerId": null,
      "text": "あれ、まだクオーラと仲直りしてなかったのだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイ",
      "speakerId": null,
      "text": "この前、二人が遊戯室で大喧嘩していたところを目撃したのだ……クオーラが人に噛みつくところなんて初めて見たのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "……今思い返せば、悪いのは私の方だよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "私ってたまに無神経すぎる時があるからさ。みんなと楽しく遊ぶのに夢中になって、ついつい悪ふざけしちゃって……"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": null,
      "text": "クオーラちゃんのリュックへの防衛反応は無意識によるものだと、医療オペレーターさんが言っていました。彼女は昔の記憶がほとんどないので、具体的な原因は誰も分からないそうで……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイ",
      "speakerId": null,
      "text": "クオーラは家族や昔の友人のことまで忘れてしまっておるのか……なんだかかわいそうなのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイ",
      "speakerId": null,
      "text": "でも前に「ロドスのみんなと友達になれたから、もう寂しくない」と言っていたから、それは喜ばしいことなのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイ",
      "speakerId": null,
      "text": "そういえば、今日は朝から一度も姿を見かけていないのだ。一体どこへ行ったのだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "はあ……きっと私のことを避けてるんだよ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "やぁっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "（小声）さ、さすがにまぐれだよな？　一発目から真ん中の赤いとこに当てるとか……運のいい奴め。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "よっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "また真ん中だと！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "（小声）まずい……ゲームの難易度を低く設定しすぎたか？　確か球のコース変更と障害物の追加機能もあったっけ……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "さあ来い！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "わっ！　変化球も投げれるんだ。それになんか障害物も出てきた……フフーン、そういうことならボクも本気を出さなきゃね！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "フゥ～！　気持ちいい！　野球はやっぱりこうでなくっちゃ！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "球はまだ残ってるよね？　全部投げてきちゃってよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "う、うそだろ……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "全部の難易度設定をマックスにしたってのに！"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "あのフォームとパワー、そしてスイングの正確さ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "まさかコイツ、アンブル・エドワーズなのか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ねぇ店員さん、ボクのスコアいくつだったの？　大賞はゲットできそう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "ええと……スコアがカンストしてボードに表示されてないが、どう考えても475点は超えてるだろうな……"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "（やべぇぞ！　兄貴が離れてからまだちょっとしか経ってねぇ。恐らくペンダントも見つかってないはず……まだ時間稼ぎしねぇと。だけど、どうすりゃいい？）"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "じゃあスキー板はもらっていくね！"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "あ、ああ……いや！　待ってくれ、お嬢ちゃん。まだ遊び足りないだろ？　もう少し打っていかないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "お目当ての景品はもうゲットしたけど、確かにまだもうちょっと打ちたい気分かも……でもお金いるんでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "いやいや、もうすぐ閉店で他にお客さんもいないし、好きなだけ遊んでってくれ！　それと景品のスキー板だ、こいつはもうお嬢ちゃんのもんだから、ちゃんと持ってな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ボールがクオーラ目掛けて飛んでくる。それが視界の端から消えかけた瞬間、クオーラは力いっぱいバットを振った――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「ゲーセン店員」はその姿に、何人ものスター選手の面影が重なって見えた気がした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "打ち返されたボールはまたもや赤い中心部に勢いよく命中する。直後にピッチングマシンが火花を散らしながら、不吉な音を発し始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲーセン店員？",
      "speakerId": null,
      "text": "な、なんだ……？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドッカーーン"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイ",
      "speakerId": null,
      "text": "びっくりしたのだ。さっきの爆発音はなんなのだ？　てっきりまた事件に巻き込まれたのかと……"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": null,
      "text": "あっちのショッピングモールから聞こえてきたようですね。あれ、あそこに落ちているのは……"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "クオーラちゃんのリュック！"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "そんな……まさかクオーラちゃんに何かあったの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイ",
      "speakerId": null,
      "text": "クオーラはあそこなのだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "クオーラちゃん！　クオーラちゃんっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": null,
      "text": "よかった、眠っているだけのようです。ん？　何か抱えているみたいですね……"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "これって……スキー板？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "うーん……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "ここは……ロドスのボクの部屋？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "確かボクは野球をしてて、それから「ドカーン」っておっきい音がして……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "それから……管理員さんと店員さんはどこに行っちゃったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "楽しいゲームをありがとうって、お礼が言いたかったのに……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "それにしても、龍門の人たちはみんな優しかったなー！"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "あっ、そうだ！　ボクがゲットした景品！　カーディちゃんにあげる予定のスキー板は！？"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "よかった、壊れてないみたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "他のみんなへのプレゼントも……全部あるね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "どうぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "あっ、カーディちゃん……"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ&クオーラ",
      "speakerId": null,
      "text": "その……"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ&クオーラ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "クオーラちゃんが先に話して。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "あ、うん！　このスキー板、ショッピングモールのイベントでゲットした景品なんだけど……カーディちゃんにあげる！　それとこの前はゴメン！"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "……これ、私へのプレゼントだったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "カーディちゃんはスキー選手になるのが夢だったって、前に聞いたから……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "それとスキーウェアも持ってたの思い出したから、それで……"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "あっ、あのスキーウェアは……"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "えへへ、実は先月ちょっと手元が厳しくて……あれを売っちゃったんだよね……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "そ、それなら次はスキーウェアをプレゼントするね。それとも他に何かほしい物はある？"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "そうだなあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "speakerId": null,
      "text": "うんうん！　なんでも言って！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "カーディは新品のバットをクオーラに握らせ、もう片方の手を上げてひらひらと振ってみせた。\nその手には野球用のグローブがはめられていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": null,
      "text": "じゃあさ……今日から野球、教えてよっ！"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
