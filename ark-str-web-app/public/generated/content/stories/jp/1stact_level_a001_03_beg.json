{
  "server": "jp",
  "storyId": "1stact_level_a001_03_beg",
  "groupId": "1stact",
  "stageId": "a001_03",
  "title": "思わぬ旅",
  "storyCode": "GT-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/a001/level_a001_03_beg.txt",
  "sourceHash": "087264b62856e50774b315a617790459e9afcb88f982bd036d144028f2a0841e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "ぐ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "お、お前が俺たちの仲間を……全部やっちまったのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "……く、来るな！　頼む！　来ないでくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "お、俺の金貨は全部やる！　武器も全部やる！　お前が欲しいものは全部――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あの子はどこいるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "何のことだ――？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "近づくな――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "この化け――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "晴天 / 視界：14km\nタラート山付近 森林地帯"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……この岩は……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "君たち、そのまま私についてきてくれ。足元には気をつけて。私の足跡を踏むんだ。どこにも触れないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "この森、私が想像していたよりずっと危険だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あの岩に何か書いてあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "これは賞金稼ぎが残した暗号だ。ここに示してある通りに動かなければ、罠にかかるというものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "じゃあトラップを避けながら進んでいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ああ、私の動きを見ていろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "――縄とベアートラップを組み合わせたものだな、なんとも古臭いおもちゃだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "さらにここは木の裏にハンマーが隠されている。何も知らずに進めば直撃だろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "そこだ、キャロルお嬢ちゃん、気をつけろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "は、はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "そこから一歩でも外れると、中が針山になっている落とし穴に落ちることになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "あっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "さすが賞金稼ぎ、同業者の罠はお手の物って感じだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "もちろんだ。私はかつて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "罠を全て避けて進むのは現実的じゃないな。やはり全て解除しながら進むのが効率がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "わざわざ罠まみれの道を進むなんて、これを仕掛けた連中なら考えないだろう。だからこそこのルートは我々にとって奴らの裏をかいた最も安全なルートというわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "行こう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "ん？　止まれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "何か変だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "また罠？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "血の暗号だ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "「――怪物？　」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "どういう意味だ？　こんな暗号を使う賞金稼ぎは知らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "……あ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "まさか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "か、怪物だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "来るな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "やっぱり君だったんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "スカジ……スカジでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "――あなたが滴水村の村長を連れていたのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "え、なんで？　キャロルを知ってるの……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "彼女を渡しなさい。今すぐに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "グラニ嬢ちゃん、あの眼、ヤバいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "それはできないよ。まずは相談――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "え、えっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "これは警告よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ダメっ、キャロル、ボブおじさん……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "彼女はどうして君を攻撃するんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "君と彼女は知り合いのようだが？　どうして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "し、質問はいいから！　今は逃げて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "はあっ、はあっ……まだ追ってくる？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "グ、グラニ……もう……走れない……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "彼女は本当に……怪物と言っていいな……。　まったく息切れもしていないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "逃げても無駄よ。これ以上、私に手間をかけさせないで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ほ、本気であたしを切りつけてきた……いや、それよりキャロルをどうするつもり！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "あの人の眼……赤い……グ、グラニ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ダッ、ダメだよ！　なんでこんなことに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "止まって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "待ち伏せだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大尉",
      "text": "今だ！　放て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大尉",
      "text": "奴だ！　我々を襲撃した厄星だ！　は、早く射殺せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "やめてっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大尉",
      "text": "このチビがっ！　何のつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "どうしてあたしたちを追ってくるかはわからないけど、あの人はあたしの仲間なの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大尉",
      "text": "な、なぜ俺たちの邪魔をする！　クソがっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "今のうちに逃げよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・ボブ",
      "text": "――東へ向けて突破だ！　行くぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "逃げられると思うな！　この化け物が、くたばれ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "（エーギル語）どけ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
