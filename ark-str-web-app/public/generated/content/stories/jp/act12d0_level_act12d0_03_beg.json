{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_03_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_03",
  "title": "昔話",
  "storyCode": "RI-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_03_beg.txt",
  "sourceHash": "37b83ffa55fcbb3f021e1ac421af5610496e2239414b99b9ad906d388cc8c99f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ドクター、少し回ってみたが、他のみんなはいなかったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "祭典が終わったあと、ジャングルを探索しないとダメそうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペータ",
      "text": "――！（勝利の雄叫び）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あっ、ペータが勝ちました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あのペータってヤツは中々やるねぇ。一回やり合ってみてぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ペータは私の部族の勇士です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "でも、きっとガヴィルさんには敵いませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ハハ、そいつはどうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "だってガヴィルさんはあんな小さい頃に、もう少しで大族長ってところまでいったじゃないですか！　ペータなんかに負けるはずがありません！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "小さい頃？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ん？　ああ、あのときか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "アタシがまだガキンチョの頃、面白そうだなーって思って、一回祭典に出たことがあるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさんは昔からすっごく強かったんですよ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリスの勇士",
          "text": "ガハッ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリスチャンピオン",
          "text": "ワイルドウィル族最強と言っても、この程度か！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "つ、強い……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人A",
          "text": "クソっ、オレたちの勇士をあんな簡単に打ちのめすなんて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人B",
          "text": "全員で囲んでやろうぜ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人A",
          "text": "ダメだ、人数じゃなおさら敵わねぇ……今回は諦めるしかねぇよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリスチャンピオン",
          "text": "挑戦者はもういねぇのか！　いねぇなら俺が大族長に挑戦するぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "アタシがやる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリスチャンピオン",
          "text": "お前は……ワイルドウィルのみなしご、ガヴィルだな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリスチャンピオン",
          "text": "若ぇヤツらの中ではそこそこの腕っぷしらしいが、祭典にガキの出番はねぇ。帰ってミルクでも飲んでな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ハッ、そんなこたぁアタシに勝ってから言いな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリスチャンピオン",
          "text": "おもしれぇ！　さすがみなしご、死ぬのが怖くねぇのか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "アタシはみなしごじゃねぇ！　部族のみんながアタシの家族だ！　うだうだ言ってねーで答えろ！　やんのか？　やんねぇのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリスチャンピオン",
          "text": "フンッ、生意気なガキめ！　後悔すんなよ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリスチャンピオン",
          "text": "バ、バカな……たった二発で……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさん、すごい……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "フンッ、威勢がいいのは口だけかよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "他に挑戦者はいるか！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ガヴィルは孤児なのか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "あれガヴィルさん、言ってなかったんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああ、そういえば話してなかったっけ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "まあ、大したことでもないからな。別に隠してたわけじゃないぜ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "確かにアタシは親ってやつを知らねぇけど、そんなのここじゃ珍しくも何ともないんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ここでは、簡単に人が死んでいく。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "天災が出しゃばる必要すらありゃしねぇ。風邪が流行っただけ、天気が荒れただけで、人がバタバタ倒れてくんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "アタシの両親も、そうやってあっさり死んじまったんだろうな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "まぁそんなことはどうでもいいんだ。アタシは部族のヤツらに育てられてデカくなったって事実は変わらねぇ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさん……",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "苦労したんだな。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "よせって、ドクター、アタシが可哀想なヤツみたいじゃねぇか。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "別にアタシ一人だけが孤児ってわけじゃねぇよ。たくさんの家で協力して孤児たちの面倒を見てくれるし、ここじゃよくあることだ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "考え込んだって何にもなんねぇよ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "アタシはここを離れて初めて、ここの暮らしが特別だったってことを知ったが――",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "それは全然、悲しいことじゃなかった。むしろアタシはそのおかげで医者を志す決心をしたんだ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "誰よりも健やかに育ったな。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ハハ、そうだな。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それで、そのときの祭典は結局どうなった？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "あんときはな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "見つけたぞ！　賞金稼ぎの悪党め！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ペータ",
          "text": "オマエ、何者？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ん？　あの声は……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "text": "ドクターを返せ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ペータ",
          "text": "何言ってる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ケーちゃん！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "トミミ、お前の子分たちが縛り上げて連れてったんじゃねぇのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "えっ、そのはずですよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ああ見えて怪力だし、自分で縄を引きちぎったのかもな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "text": "賞金稼ぎ、ドクターを返せ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "text": "じゃないと地の果てまで追いかけてやる！　絶対逃がさないぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "チッ、まだ正気に戻ってないみたいだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ペータ",
          "text": "ぐはっ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ペータがぶっ飛ばされました！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人A",
          "text": "あいつ、ペータを倒しちまいやがった！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人B",
          "text": "強そうだな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人C",
          "text": "なんなんだあの変なヤツは！？　どこの部族だ！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人A",
          "text": "さあ、何言ってんのかもさっぱり分からねえ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アダクリス人B",
          "text": "構うな！　倒しちまえば同じだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "チッ、あいつら、ケーちゃんが新たな挑戦者だって勘違いしてやがる……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "トミミ",
          "text": "ガヴィルさん、助けに行きますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "いや、少し様子を見た方がいいな。ありゃおバカちゃんだけど喧嘩させたら強ぇから、たぶんどうにかなるだろ。アタシらが加わってもとばっちりを食らうだけだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "だけどこのままだと周りも混乱しそうだな。ドクター、トミミの子分に指示を出して、なんとか場を収めてくれねぇか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
