  "stageId": "main_03-05",
  "title": "コール",
  "storyCode": "3-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_03-05_beg.txt",
  "sourceHash": "3f46eb87989c4a4bf8e0f6c345542c752ad2dadf7f862cad5f63b213676cab54",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十七关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "……ドク、ター……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "……わ、たし……そんな、つもりじゃ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "――霧が、晴れていく……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "……近衛局からの通信が入りました。レユニオンの残した痕跡を多数確認したとのことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "なお、現在追跡中のターゲットは、白い髪をした女性で――"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "アーミヤさん、チェン隊長からご伝言が……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "――顔色が優れないようですね。"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "この場は任せてほしい。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "……わかりました。"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "お願いします、Dr.{@nickname}。"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "可能であれば、5分以内に出立できたらと思っておりますので……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#4",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#4",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "――ドクター……"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "怖いのか？　アーミヤ。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#6",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "わた、しは……"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "……何も、怖くなんて……"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "…………いえ。ドクターの言う通りです。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "……また失うことになったらと思うと、どうしても怖くて……"
            }
          ]
        },
        {
          "label": "……自分の力が、嫌になったとか？",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#6",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "……自分でも、よくわかりません……"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "どう言えばいいのかも、わからないんですが……それでも……"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "この力は……人を傷つけるためだけのものではないんです。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "だから……ドクターには、見られたくありませんでした……"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "……私が、誰かの命を奪うところなんて。"
            }
          ]
        },
        {
          "label": "後悔する必要はない。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "……はい。後悔は、していません。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "……と、いうより……"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "ドクターのためなら、相手が何を背負っていようと、殺めることに後悔はしません。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "ですが……本当は、もっといい方法があったはずだとも思います。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "……私がそれを見つけ出すことができなかったから、彼の命を奪うことになってしまったんです。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "その一点だけは……悔やまずにいられません。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "……できることなら……"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "ドクターにだけは、こんな姿を見せたくありませんでした。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "普段は、この大地に生きる感染者たちを、苦しみから救ってみせると口にしているのに……"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "いざ危機的な状況に陥ったときには、いつも自分を無理やり納得させて、彼らの命を奪う選択をしてしまっているんですから。"
            },
            {
              "type": "dialogue",
              "speakerName": "アーミヤ",
              "speakerToken": "char_002_amiya_1#4",
              "operatorId": "char_002_amiya",
              "portraitKey": "char_002_amiya",
              "text": "私は、本当に無力ですね。"
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それでも、君が守ってくれたことは事実だ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "――――"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "……なんだか、わかった気がします。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "それが、私のやるべきことなんですね。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "――私は、運命なんて存在しないと思っているんです。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "ですが、それでも……この先、何があったとしても。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "私は、あなたを守ってみせます。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "絶対に。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "！　マズい……！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "お前ら、先に行ってろ！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "俺はスカルシュレッダーを助けに行く！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "お前なあ……気でも狂ったのか？"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "一人で行くのは自殺みたいなもんだ。……俺たちも行くに決まってんだろ！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "……！　すまん、恩に着る！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "あいつを置き去りにするなんて、できやしなくてよ……"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "そんなの、俺も同じさ。――行くぞ、皆！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "なんだ……？"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "レユニオンが……引き返して来る……！？"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "一体、何のつもりだ？"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "ホシグマさん！　撤退しましょう！"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "了解です！"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "――近衛局各員に告ぐ！　気を抜かず、攻撃に備えろ！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "突っ込むぞ！　援護してくれ！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "くそっ、この女……！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "ダメだ、こんな盾歯が立たない！　俺たちじゃ相手にならないぞ！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "急いで回り込め！　奴らが態勢を整える前に……！"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "とにかく、スカルシュレッダーを――"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "あいつを取り戻すんだ！！"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "ロドスの皆さん！　奴らの目的が変わったようです、注意してください！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "！　危ない！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "ホシグマさん！　右から来ます！"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "――ッ……"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerToken": "char_1504_cqbw",
          "operatorId": "char_1504_cqbw",
          "portraitKey": "char_1504_cqbw",
          "text": "あら、防がれちゃった。ふふっ――やるじゃない。"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "爆弾？　――奇襲をかけてきたか！"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerToken": "char_1504_cqbw",
          "operatorId": "char_1504_cqbw",
          "portraitKey": "char_1504_cqbw",
          "text": "あははっ！　もちろん、それで終わりじゃないわよ？"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerToken": "char_1504_cqbw",
          "operatorId": "char_1504_cqbw",
          "portraitKey": "char_1504_cqbw",
          "text": "あんたには、じっくり相手してもらうから――よそ見しないでね？"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "チッ――また爆発か……"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "まったく、どこから潜り込まれたのやら……"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "――アーミヤさん！　こちらは、遠距離からの爆撃を受けて動けません！"
        },
        {
          "type": "dialogue",
          "speakerName": "ホシグマ",
          "speakerToken": "char_136_hsguma",
          "operatorId": "char_136_hsguma",
          "portraitKey": "char_136_hsguma",
          "text": "ほかのレユニオンがそちらへ向かっていますので、お気をつけて！"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerToken": "char_1504_cqbw",
          "operatorId": "char_1504_cqbw",
          "portraitKey": "char_1504_cqbw",
          "text": "へ～え。その盾、ほんとに頑丈みたいね。"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerToken": "char_1504_cqbw",
          "operatorId": "char_1504_cqbw",
          "portraitKey": "char_1504_cqbw",
          "text": "……にしても、うっかり自分から面倒事に首突っ込んじゃったけど……"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerToken": "char_1504_cqbw",
          "operatorId": "char_1504_cqbw",
          "portraitKey": "char_1504_cqbw",
          "text": "まあ、たまにはレユニオンに貢献してあげるとしましょうか。"
        },
        {
          "type": "dialogue",
          "speakerName": "W",
          "speakerToken": "char_1504_cqbw",
          "operatorId": "char_1504_cqbw",
          "portraitKey": "char_1504_cqbw",
          "text": "――それじゃ、せいぜい楽しませてちょうだいね。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "あれは……チェルノボーグで遭遇した、Wです！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "もしかして、近衛局の追跡を振り切ってきたんでしょうか……！？"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "とにかく、早くホシグマさんを援護しなくては！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "みなさん、注意して対応してください！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "レユニオンはまだ大勢潜伏しているはずですから、痕跡を頼りに先手を打っていかないと、不利な状況に陥りかねません！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "――ドクター！　各小隊の指揮をお願いします！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
