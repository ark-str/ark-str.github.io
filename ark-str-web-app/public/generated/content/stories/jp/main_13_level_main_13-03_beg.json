{
  "server": "jp",
  "storyId": "main_13_level_main_13-03_beg",
  "groupId": "main_13",
  "stageId": "main_13-03",
  "title": "傭兵の一日",
  "storyCode": "13-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_13-03_beg.txt",
  "sourceHash": "e38387a71d34fb2fc522750a669b34b38e5d9a547dfa0c6f49f7ef0c576932c6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "将軍、市長が死んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "その剣、血が付いたままだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "軍事委員会の剣が、傭兵の剣と同様に、扱いやすいものだとよいのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "武器である限り、そこに大した違いなんてない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "傭兵から連絡があった。摂政王の暗殺計画に関与した十四名の議員が逮捕されたそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "他の議員たちはどんな態度を取っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "何も。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君ならもっと直接的なやり方を取ると思っていたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "軍事委員会が望むのなら、直ちに全議員の処刑を執行しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "いや、今の状況では、これで充分だ。飛空船の建造がまだ完成していない以上、我々には今しばらくの辛抱がいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君の部下たちを撤退させなさい。ナハツェーラーの王の軍団が到着した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……軍団？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "いつ到着したんだ？　一体どうやって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "カズデルからの部隊であれば、どの方角からヴィクトリアに入ろうと必ず大公爵の領地を通過することになる。どう隠蔽しようと、それほどの大部隊であれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "王はすでにロンディニウム近郊に到着しており、再編された彼直属の王庭軍もすでに都市の外に駐屯している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "分かった。傭兵たちに撤退命令を出すとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "あのレト中佐なる男もすでにテレシス殿下と話を付けた。今後、彼と彼の都市防衛軍はロンディニウムのあらゆる行政を引き継ぐことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "ロンディニウムは都市防衛軍を主体とした半軍事的管轄下に置かれることになる。表向きは、「駐屯軍の反乱」を理由にな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "それでは大公爵たちの目はごまかせまい。奴らが都市内に敷いた情報網はかなり広がってきている。今後数ヶ月以内には兵力動員を開始するだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "そこまで時間はかからないだろう。一番早い部隊なら、二十日以内にはロンディニウムの城壁の下に現れる可能性が高いと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "だが心配は無用だ。真っ先に到着するのが誰であれ、軽率に手出しはしないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "単独での進軍を敢行しようとする公爵は、他のすべての者にとって共通の敵となるからだ。ちょうど二年前に失敗に終わった、ウィンダミア公爵の急襲のようにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "彼女の高速軍艦は自らの身内の妨害を受け、駐屯地を出ることすら叶わなかったのだからな。バカげた話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ウィンダミア公爵は……勘の鋭い人だ。彼女は摂政王がヴィクトリアと接触したばかりの頃から、ずっと議会に警告し続けていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "我らをロンディニウムに引き入れたのはキャヴェンディッシュ一人ではないのだよ。どの公爵も殿下に「従順な軍事力」を期待し、難題の処理に力を貸してもらおうと望んでいたからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "分かるかな？　あのウィンダミア公爵とて例外ではないんだ。辣腕の軍人としての身分の裏では、相も変わらず王侯貴族たちのゲームルールに従っているということだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "彼女はただ、誰よりも急いで我らを道具箱へとしまおうとしているというだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……ヴィクトリアが誇るかの蒸気騎士は、もう存在しないと聞いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君は情報収集が得意なようだな、ヘドリー。それは軍人としてはあまり好ましい素質とは言えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "将軍、俺は傭兵だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "摂政王と軍事委員会の計画は想像以上に上手くいった。まさかサルカズが、本当にヴィクトリアの首都に足場を築き上げるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "公爵たちは異分子弾圧のために切り捨てられる部隊を欲している。議会も同様に「適切な」防衛人員の調達が急務だ。あの愚かな公爵二人のような軍事的リスクを冒す輩を二度と出さないためにも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "彼らにとっては、内戦を終えたばかりのサルカズなどまさにうってつけだったわけだ。袋を開ければすぐに食えるし、用済みになったら捨てればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "今や工業区も、議会も俺たちの支配下にあり、ザ・シャードまでをもじきに手中に収めんとしている。摂政王は本当にロンディニウムを手に入れたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "だが俺たちにはこの都市を移動させることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "紛争をけしかけることはできるさ、だがその後は？　ロンディニウムと共に、他国の連合軍にこの地に埋められるのを待つだけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "軍事委員会の計画とは一体なんなんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "傭兵というのはそこまで知りたがりなのかな、ヘドリー？　私は少し君を優遇しすぎたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "俺はただ、任務の目的が何なのかを知る必要があるだけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "私の知る傭兵は、どこの雇い主の方が気前がいいのかを聞きたがったり、どうやってサンクタのキャラバンを略奪するかについて思考を巡らせるものだったがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……個人的な習慣は人それぞれってだけだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "「個人的な習慣」か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "目の調子はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……剣を振るう際の距離判断に多少影響はあるが、なるべく早く克服してみせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君の尋問記録は見せてもらった。刺客のイネスという女性は、傭兵でもあるそうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "イネスのようなサルカズが、まさか議会に買収されて摂政王の暗殺を企むとは予想もしていなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "イネスは死に、君はそのために片目を失った。君は軍事委員会の表彰を得ることになるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "そんなもの俺には必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "では報酬を受け取りなさい。一人の傭兵らしく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "何と言っても、君はイネス、それからあのWと呼ばれる狂人と三人で傭兵小隊を率いて長いこと活動してきたのだから。スカーモールの老いたサルカズも君のことを高く評価していたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君は思い切りよく、手を下した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "傭兵はこういう生き方しかできないんだ。生きるためなら、俺たちは何でもする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "同僚を殺すことすらも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "では君は、いつの日か私も殺しに来るのだろうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君はさっき、軍事委員会は一体何を計画しているのかと聞いたな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "我々はただ、戦争を勃発させるところまでしか計画していない。その後に何が起こるかは……あの兄妹の計画だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "この地は怨嗟の中心だ。ここもまた、怨嗟に埋もれることになるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君の書くそれらのノートと同様に、そして我々が経験してきたあらゆる戦争と同様にね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "気にするな。執筆を続けたまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "重大な任務だ。君は責任を背負うことになる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ノートは書き終わった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "いや、何も書いてはいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "この剣を磨き直していただけだ。傭兵の大剣など……長らく使っていなかったからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あんたってほんと冷たい男ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "欲しいのならくれてやっても構わないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "剣のこと？　そんな効率悪い武器、興味ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "はぁ……髪の手入れなんてする余裕がまだあったとはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "まあ確かにね。これからはロンディニウムにいた頃みたいに、毎日トリートメントなんてする時間もなくなるでしょうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "こうした方が楽というだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あの服も残しておくべきよ。そうすれば、将軍から重用される傭兵のリーダーをこれからも演じ続けられるんじゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "軍隊の連中はなんて言ってたかしら？　服従こそが使命？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "傭兵の使命は報酬を得ることだ。弔慰金をもらうことじゃない。二人とも無駄話はその辺にしておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ここが防衛線偵察エリアの穴か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "戦争が始まる前までは、そうだったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "今は……奴らも全員進軍し始めてる。たとえ公爵間の仲がどれだけ悪かったとしても、いずれ手を組んでここの戦線を包囲するわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "例の奴がここを通るって話は確かなの？　ここからはザ・シャードが打ち出した天災雲がよーく見えるけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "天災が着弾するのはウェリントン公爵とナハツェーラーの王の交戦地点だ。鉄公爵はおそらく戦線を縮小させるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "ウィンダミアに関しては、娘を移動要塞に送り返すまでは、自身の兵力を即座に展開するだけの余力はないと思われる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "件の人物がロンディニウムを離れるとなれば、残された道はそう多くない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "待って。来たわ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "かなり速い影ね。これは……\nなんだか、多角形の……糸玉みたいだわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "多角形の糸玉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "全体的には多角形だけど、かなり不規則な形をしてるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "アーツよ。おそらく肉眼で捉えるのは不可能だわ。じゃなきゃ奴もここまで来れないでしょうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "目標確認。多少荒っぽくやらざるを得んな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "W――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "はぁ……追うぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……傭兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ちょうどいいところへ来ましたわね。どうぞ、追いかけてきてくださいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "不思議な感覚はちょうどこの辺りのはずです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "逃げられたの？　だから言ったのに、爆弾程度ではリッチはやられないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "いや、まだ近くにいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "追いかけなくては。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "まずいわね。さっきはこんなエリアには来なかったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……ここのもの、どれも影がないわ。幻覚かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "大柄な奴の集団がいるみたいよ。ほら、そこの山の下。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "……ずいぶん大袈裟な剣を持ってるわね。あんなのどうやったら振れるのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズの旅人？",
      "text": "（古代サルカズ語）あの灰色の都市は目の前だ、あとひと踏ん張りだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズの旅人？",
      "text": "（古代サルカズ語）あそこなら俺たちを受け入れてくれる。土石の子らが哀愁の地にすでに城壁を築き上げているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズの旅人？",
      "text": "（古代サルカズ語）カズデル。この言葉の響き一つ一つが苦難に満ちた旅だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズの旅人？",
      "text": "（古代サルカズ語）それはどこにあるんだろう？　俺たちはそれを求めて、夢から離れこの地までやってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズの旅人？",
      "text": "（古代サルカズ語）流浪の時代はもう終焉を迎えた――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あいつら、なに話してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……とても古いサルカズの方言だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "「哀愁の地」、「灰色の城壁」。他はよく聞き取れなかった。文脈から推測するしかないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あいつらもカズデルの話をしてるみたいね。どのカズデルのことかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズの旅人？",
      "text": "（古代サルカズ語）譴罰氏族の炎魔バロルサッカに「遊侠領主」クイロンが俺たちを出迎えてくれるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズの旅人？",
      "text": "（古代サルカズ語）ああ、それとそこには彼もいたな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズの旅人？",
      "text": "（古代サルカズ語）「魔王」、ゴルドル――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "その影たちが語っているのは、カズデルと呼ばれるに値する都市の中でも二つ目に築き上げられたものについてですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "最初のカズデルが神民と先民たちによって壊滅させられた後、千年もの間、カズデルは垣根と茅葺きを積み上げただけのごく小さな集落に過ぎませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "脆弱で壊れやすく、植民者の意志によって幾度となく蹂躙され、サルカズたちも次々に亡命していきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そしてこの時代に、また力を蓄えたサルカズは再び……真の都市を築き上げたのですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "彼らは今やクルビアと呼ばれる辺りの荒野を離れ、テラの中心地へ足を運びました。そのために生き、死んでいったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それから……裏切りが起こり、再び東への旅が始まりました。やがていくらも歩かぬ内に、蒼き怒火が再びの裏切りに遭ったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それ以来、サルカズの歴史はまるで呪いを受けたかのようですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "歴史の流れはいつまでも渦を巻き続けるものです。絶えず破滅と再建を繰り返し続けてきた都市は、今日に至るまでなおもその付近にあったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そして彼らが口にしたのは、その都市に君臨した最初の魔王たちの名ですのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "七千年前の、魔王たちのね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "あなた方――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "どうやってこんなものを顕現させたのです？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "この時代のカズデルが持つ歴史的意義や後世への影響を鑑みれば、これらの魔王たちの伝説は確かに広く伝わっていると言えますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ですがこの流れ者たちは一体どうやって？　私たちですら持ってはおりませんのよ。ここまで細かい……その、記述をね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "こんなもの、巫術ですら断じてあり得ませんわ……どんなアーツだろうと、これほどの効果は実現し得ませんもの。うーん、何とも言えませんけど、少なくとも歴史学者でなければ不可能です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "もしや、物理的な方法を用いたのかしら？　霧を利用したプロジェクターとか？　あの兄妹、いつからこんな技術を持っていたの？　隠し事とは好ましくありませんわね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "うーん……それも違うわね。この光景は記述にある真相にあまりに近すぎますわ。技術的な手段だとしても、資料は一体どこから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ということは、やはり何らかのアーツなのかしら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "しかしどの既知のアーツの範疇にも収まりません……アーツでない可能性すら濃厚なくらいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "不思議ですね――もしや巨獣かしら？　いや、ヴィクトリアが巨獣を手懐けて参戦させるつもりなら、とっくに手を打っているはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "この女、なにやってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "どうやらあなた方のアーツによるものではないようですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "何のひねりもなく、単に私のお気に入りのキューブちゃんを爆破しただけの方々ですか。あの中はすごく快適だったんですけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "リッチの王庭のトランスポーター、エルマンガルド女史。このようなやり方で接触したこと、謹んで詫びよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "……あなた方、リッチに何か誤解があるんじゃないかしら。私はそこまでお年寄りではありませんのよ。そう恭しい態度を取らなくても結構ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘドリー",
      "text": "つまり、あなたのアーツというわけでもないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "七千年前の流れ者を顕現させるなんて才能は持ち合わせておりませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "うーん……アーツで刺激してみたらどうなるかしら？　そう、一番基本的な、ごく普通の小さなエネルギーで……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "……これは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "このエリアなら三日前に確認したけど、その時はこんなものなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あなたたち……ちょっと、ヘドリー、W、どうかしたの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
