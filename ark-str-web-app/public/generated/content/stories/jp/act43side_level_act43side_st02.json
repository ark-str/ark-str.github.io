{
  "server": "jp",
  "storyId": "act43side_level_act43side_st02",
  "groupId": "act43side",
  "stageId": "act43side_st02",
  "title": "焦点",
  "storyCode": "AD-ST-2",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act43side/level_act43side_st02.txt",
  "sourceHash": "53aba3ddd47d0f29eaf744b79a5f7320e0813aa565f034f8a0e010b3708b531e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "スタッフＡ",
      "text": "おいおい、お前もマイケルさんとマリオンさんの死体を見ただろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＢ",
      "text": "やめてよ、やっとあのおぞましい光景を頭から追い出したのに、なんでまた言うの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＢ",
      "text": "て、手が震えて、もうガンマイクを握れそうにないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＡ",
      "text": "仕事のことなんてもうどうでもいいだろ！　俺たちが今いる場所は本当に連続殺人鬼がいるんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＢ",
      "text": "なら急いで逃げようよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＡ",
      "text": "逃げる？　マイケルさんとマリオンさんがなんで犯人に目をつけられたのか忘れたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＡ",
      "text": "マイケルさんの足元には荷物が置かれたまんまだったんだ。周到な準備をして、密かに撮影区画から逃げ出す手はずを整えていたらしい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＡ",
      "text": "それでも離れる直前で殺人鬼に見つかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＡ",
      "text": "犯人は誰もここから逃がす気はないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフＡ",
      "text": "まるで『ジャック・ザ・リーベリ』だ。ここは奴の狩り場で、俺たち全員が奴の獲物なんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "アブナーさん、チェストホルダーはいつからチェックしてないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "ほら、可動式アームのネジがいくつか緩んでる。気をつけないと、カメラが落ちて粉々になっちまうぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "なんならなっちまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "じゃあレンズの手入れを手伝わせてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "いらん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "俺はあんたのアシスタントなんだぞ、アブナーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "お前さんが何のために媚びてくるのかわからないとでも思ってんのか――離れろ、小僧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "ダルトンさんが死んだのは事故なんかじゃないんだろ？　ダルトンさんだけじゃない、シェリーさん、マイケルさんとマリオンさんだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "これは絶対に無差別殺人なんかじゃない。犠牲者は全員、五年前のあの事故に関係してるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "アシスタントなんか辞めちまえ、ゴシップ紙の記者のが向いてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "辞めなくても両方なれるし、後者の方が稼げるって話でね……アブナーさん、五年前あんたもその場にいたんだろ。どうせ今は時間があるんだし、教えてくれよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スティーヴン",
      "text": "メラニー、今は君のシーンではないが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "「ミズ・デュポン」が死ぬ前のメイクについて部屋で安心して考え続けられるとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スティーヴン",
      "text": "それは結末のクライマックスシーンに関わることだが、すまない、まだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "あら、あなたの神は遅刻しているのね。でも、今はあなたとあなたの神様を責める気にはならないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "これだけのことが起きたんだもの、もし中心部から離れてなければ、今頃は警察が区画全体を封鎖して、撮影もとっくに中止になっていたでしょうし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "まあもちろん、今の状況もそう大して良くはないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "スティーヴン、私ね、自分の投資が全てパーになるんじゃないかと心配になってきたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "ここ数日の出来事について、あなたはどれだけ事情を知っているの？　グレータはどれだけ知っているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スティーヴン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフC",
      "text": "スティーヴン監督、メラニーさん、お二人ともここでしたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフC",
      "text": "プロデューサーは？　グレータさんは全員に納得のいく説明をすべきです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ひそひそ。\nそこかしこでひそひそと話し声が響き、スタジオ内で仕事をしている者は一人としていない。\n三つの事件、四人の死者。立て続けに起きた出来事がここにいる者たちの精神状態を最悪のものにしていた。パニック、怒り、困惑、迷い……制作チーム全体が制御不能に陥る寸前だった。\nうるさい。騒がしすぎて、心の中までかき乱される。彼女はこの感覚が嫌いだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "グレータは真っ直ぐスタジオの中央に歩んでいくと、一番明るい照明をつけた。まばゆい光が全員の動きと会話を止め、人々が彼女の登場に気づく。\nグレータは深呼吸をした。"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "みんな、いくつか言いたいことがあるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私は役者じゃないから、発声の訓練はしてないの。聞きにくかったら近くへいらっしゃい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スティーヴン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スタッフたち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ここに来る前、制作チーム全員の残りの報酬を全て支払うよう、経理担当に頼んでおいたわ。数分後にはランクウッド専用金融端末で確認ができるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "もちろん、ダルトン、シェリー、マイケル、マリオンにもしかるべき報酬と、それから遺族への弔慰金を支払う。これは後ほど個別に対応するわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "確認するまでもなく『ミズ・デュポンの死』の撮影は終わってないし、契約はまだ有効よ。だから本来こんなことをする必要はない――だけど、もう仕事に身が入っている人はほとんどいないものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "あら、グレータ、あなたらしくないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "チーム内でいくつか……些細とは言えない出来事が起きただけよ。まだ諦める時ではないでしょうに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "それとも、こうしたことを経験したせいで、プロデューサーとして映画の最終的なクオリティに自信を失くしてしまったのかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私が自信を失う？　メラニー、考えすぎよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私は自分の見る目を疑ったことはないわ。当然諦めるなんて論外ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "でもあなた今……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "みんなに、お話をしてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ねえ、あなた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "俺のことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "レコーダー、ノート、速記端末……何でもいいわよ。取り出して、それから座ってよく聞きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "ど、どういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "もうこそこそしないで。私がこれから話すことは全部、堂々と記録していいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "『トリマウンツ・エンターテインメント・ウィークリー』、『ランクウッド・コーヒータイム』、『パーソンズ・マガジン』、好きなところに持ち込めばいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "情報を外に持ち出せるのなら責任を追及しない。あなたがそれを売って得られるのが褒美であろうが、罰であろうがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "「ランクウッド・アカデミーアワード」――ここにいるみんなが、よく知っていることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ランクウッドの新人向けのこの賞には、毎年数え切れないほどの映画アカデミーの学生や映画愛好家が作品を投稿するわ。自分が創作やマーケットをどれだけ理解しているか証明しようとしてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "彼らは作品の受賞をこれ以上ないほどに望む。なぜなら一番下の賞を取れただけでも、ランクウッドへの仲間入りの資格を得られたことを意味するから……とあるフィディアも例外ではなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "彼女は自分には見る目があり、頭がキレて、根気もあると自負していた。今は狭い借家に住むしかなくとも、いつかはランクウッドの新作発表会のレッドカーペットに立つ自信があった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ついに、彼女は最高のストーリーを手に入れ、最高のパートナーを見つけ、チームを集め、その物語を撮影して投稿した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "しかし、田舎からやってきたフィディアはあまりにも成功することに取り憑かれていたの。ましてやその時は仲間全員の信頼を背負っていたわけだしね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "選考終了のカウントダウンが近付くにつれ、彼女の成功への渇望は強くなり、一方で自身の作品への疑念も強まっていった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "それで、どうしてそんなバカな考えに思い至ったか、親戚や友人に頼み込み大金を集めた――当時の彼女にとってのね……それから、選考委員たちを訪ねたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "なんだか聞き覚えのある話だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "「アカデミー賞」の発表当日、組織委員会はそのフィディアの不正を公表し、テラ全土の観客に向けてランクウッドの専門性と高潔さを示したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "一方で、そのフィディアはというと、投稿した作品は受賞資格を取り消され、チームの全員から見放され、全てを失った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "思い出した！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "とんでもなく皮肉な話だったんだ！　組織委員会が後日公表した資料によると……その作品は本来、最多得票数を獲得してて、選考委員たちから最も注目されてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "その後、彼女は十年の時間をかけ、あらゆる手を尽くしてようやくランクウッドに戻り、少しずつ成果を出していった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "もちろん、名前を変えたわ……グレータ・ストーンにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "メラニー、これでわかったでしょ。私は極めて愚かな人間だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……私は、わざわざ自分から運命に冗談をせがんだのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "幸い、自分でも呆れるほどバカげたこの経験からあることを学んだ――自分を疑うべきではないってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私は自分の見る目を信じているし、自分のやりたいことは何一つ諦めない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "ふふ、あなたって想像していたよりも、ほんのちょっとばかり面白いのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "正直、あなたのナルシズムに近い自信は、相手を脅すための虚勢だとずっと思っていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "そのくらいにしろ、グレータ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "急にこんなことして、わけのわからない話を始めたのは、俺たちの同情を買うためなんだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "いま俺らが立っている区画で人が死に、移動先には天災が待ち構えている……これだけのことが起きて、まだお前さんのために命懸けで働けと？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "あなたがずっと私を恨んでいるのはわかっているわ、アブナー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……五年前からね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "そんなわけないだろ。何せ、俺はあの映画の名シーンで、その年のランクウッド最優秀撮影賞を貰ったんだからな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "あれは映画カメラマンが得ることのできる最高の栄誉だ……お前さんが俺に与えてくれたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "でもその後は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "キャリアのピークを迎えたというのに、自暴自棄になり、わずか半年後には、あなたにカメラを任せようとする人はいなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "昔はあんなにカメラを大切にしていたのに、今じゃ空になったポテトチップスの袋みたいに扱っているわよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "『ミズ・デュポンの死』のチームに加わる前なんて、カジノで負けて十数年来の相棒を失ったんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "あなたは五年前のあの映画を、あなたに賞を取らせたあのシーンを、当時そのシーンを残すよう指示した私を恨んでいる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "そうさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "あの時、俺のカメラは偶然にもローラという娘が高くから落下する場面を捉えていた。当時、お前さんの表情を見て、よからぬことを考えているのはわかってたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "俺は何度も警告した。だがお前さんは無理やりあのシーンを映画にねじ込んだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "映画評論家たちがあのシーンのリアルさと衝撃を褒めれば褒めるほど、俺はバカらしく思った！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "映画ってのは夢を創り出す芸術で、カメラはその夢を形にする手、そして夢を見る目だ。お前さんはあの娘を侮辱し、俺を侮辱したんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "俺はもう、機材も、仕事も嫌いなんだ。わかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "アブナー、そういうことなら、もう手放せばいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "何だと？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "話がそれて申し訳なかったわね、本題に戻りましょう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "報酬の入金を確認後、みんないつでもチームを去っていいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "この危険に満ちた区画から今すぐ逃げ出したい人は、どうぞご自由に。連続殺人犯が怖くて隠れる場所を探したい人も、ご自由に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "様々な目的で探偵の真似事がしたいなら、それもご自由に。復讐を諦めるつもりがない殺人犯も好きにすればいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "『ミズ・デュポンの死』の撮影はほとんど終わっているもの。残るは最後の数日と、いくつかのクライマックスシーンのみ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "残ってくれる人だけでも、撮り終えることができるかもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "カメラマンに関しては……私がアブナーの代わりを務める。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "メラニーはどうするつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "さすがに、私も今すぐ「ミズ・デュポン」の代役を見つけることはできないのだけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "わかっているでしょ。私に選択肢なんてないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "私はこの映画でマリアンナを打ち負かしてやりたいのよ、グレータ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "災いもまた、別の形の恩恵じゃなくて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "マリアンナが引退してからもう何年も経っているというのに、その執着はどこからやってくるのかしらね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "それには口出し無用よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "でも先に断っておくけど、みんないなくなったら、あなたがこだわる主演女優への扱いや、現場のルールなんてものは……構ってられなくなるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メラニー",
      "text": "ふふ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "スティーヴン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スティーヴン",
      "text": "わかったわかった。今夜には結末を書き上げるさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私はこの物語を落札した時の自分の判断を信じているわ。ここ数日、あなただって十分考えただろうし、アイデアもたくさん出ているはずよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "天災が迫り、死が目前にあるわ……あなたの神が、こういう素材を愛していないとでも言うつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スティーヴン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "これまでのみんなの頑張りに感謝するわ、全員の今後の幸運を祈ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私からの話は以上よ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
