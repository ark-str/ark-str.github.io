{
  "server": "jp",
  "storyId": "main_13_level_main_13-10_beg",
  "groupId": "main_13",
  "stageId": "main_13-10",
  "title": "砕けた温室",
  "storyCode": "13-12",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_13-10_beg.txt",
  "sourceHash": "3284a2ca0eb89507f01a91d57ca2f19a93496ed97c2587c32caf3d0aacd1fe54",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "よお、マグダレーネ。お前が花を持ってる姿は、やっぱりすげぇ絵になるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "ありがとうございます、ハンクさん。ウィルさんを見かけませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "朝にお花を頼まれたんですけど、午後になっても取りに来なくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "ウィルの奴が花を？　ああ、フリーダの誕生日にか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "昼間から仕事サボってどっか行っちまったよ。多分フリーダへのサプライズを準備しに行ったんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "フリーダに叱られりゃ思い出すだろうから、心配すんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "みなさん、すごくお疲れみたいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "最近は毎晩工事現場の方から音が聞こえますけど、ずっと休みなしで働いているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "近頃の魔族どもときたら、まるで誰かに功績をアピールするみたいに必死こいて俺たちを一日中働かせやがる。だがお偉いさんらしき人なんて見かけもしねぇんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "お前は幸運だったな。いい仕事を与えられたおかげで、こんな目に遭わずに済むんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "けど皆で歯ぁ食いしばって頑張った結果、まさか一ヶ月もかからずにあんな不思議なもんを建て終わるとはな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "ありゃあちょっと前だったら、間違いなくロンディニウムの貴族連中が博物館に丸々運び込んでたような代物だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "ハンクさん、前はこの仕事がお嫌いでしたよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "……時代は変わったんだよ、マグダレーネ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた住民",
      "text": "（小声）お前も、あのサルカズ士官へのご機嫌取りを学んでおくんだぞ。お前にとって損にはならないはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "……ご忠告ありがとうございます、ハンクさん。考えておきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ住民",
      "text": "またか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ住民",
      "text": "最近砲声がどんどん近付いてきてるが、こりゃどういうわけだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ住民",
      "text": "ブレントウードを狙う勢力は複数あるとは聞いたが、もし本当に戦いが始まったら、また滅茶苦茶になっちまうじゃねぇか……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苛立つ住民",
      "text": "現状皆で仲良くやれてるんだから、それで十分だってのに。頼むから俺たちの仕事の邪魔だけはしないでくれよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア少年",
      "text": "マグダレーネお姉ちゃん、やっと見つけた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア少年",
      "text": "お姉ちゃんの家によく来てたあの魔族の人が、仲間と一緒に温室に押し入って暴れ回ってるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "もう十分だろう？　ここにあのヴィクトリア人どもを匿うなど不可能だと言ったはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "それはあんたが決めることじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "この何の役にも立たねぇ施設は、あんたの裁量で残したもんだ。何を隠してるかなんて分かったもんじゃねぇだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "チッ、みんな殿下のために命懸けで戦わなきゃいけねぇってのに、軟弱なあんたのせいで俺たちゃ毎回毎回、チャンスを逃してきたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "口の利き方に気をつけろ、傭兵。私は今なお王庭軍の一員であり、この場所の指揮官なのだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "安心しな。俺がここに匿ってる遊撃隊を見つけた暁には、すぐにあんたをぶち殺して手柄を立てて、王庭軍に参加を申請するからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "そのクソッタレの厭戦感情は大事に取っときな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "奴らの行動のせいで、ここでの軍事委員会の計画にはすでにかなりの支障が出てる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "あんたが前線で敗北したせいで、奴らが調子づいてなけりゃ、ボスもさっさと任務を終わらせて成果を出すっていう決断はしなかったはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "つまり、今は黙ってろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "私の温室が……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "やめて――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "（小声）シッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "（小声）じっとしてなさい。黙って見ているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "ぐっ、むぐっ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "力を抜け、指から血が出ているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "振り払おうなどとは考えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "（小声）私は君の命を救いたいんだ、「ガーデナー」。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "そいつを解放してやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "マジに俺とやり合うつもりなら、そうしてみろ。バッサリ斬っちまえばそれで済む話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "あんたはこの町に丁寧にしすぎなんだ、「指揮官」。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "睨むだけじゃ俺を殺せはしねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "チッ、しらけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "草花なんて、この戦争にとっちゃ何の役にも立ちゃしねぇんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "造兵所に、爆薬工場、焼却炉。それこそがお前らに本当に必要なもんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "放してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "私は冷静です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "探し物は見つかりましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "いいや、何も。運がよくて助かったな、小娘が。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "では、どうかお引き取りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "ほう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "あの工事現場の間抜けどもよりかは、ちったぁ根性あると思ってたがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "text": "チッ、ヴィクトリア人め。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "動かないでくれ、その指は手当が必要だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "私では彼らを止められなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "前線で……色々としくじってしまってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "もうすぐ別の者が私の地位を引き継ぎに来ることになっている。彼はこの町に対して私とは違う考えを持っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "ブレントウード入口から西に二百メートルほど先のコンクリート製の塹壕に、空いたばかりの穴がある。付近をうろつく遊撃隊の爆破によるものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "奴らはこの機会を逃さないだろうと考えた我々は、明日の早朝五時にその穴を塞ぐことにした。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "何株か難を逃れたバラがあるようだ。この憐れな子たちを、何とかして植え替えてやってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "もしその穴に興味があるなら、今夜そのバラたちを持って我々の兵営を抜けるといい。それが最も安全なルートだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "誰かに引き止められたら、私に注文を届けに来たと言いなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "もちろん、ついでに私のテントに花束を届けてくれれば、とても嬉しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "踏みにじられるべきでないものもあるのだ、「ガーデナー」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "私の名前は「ガーデナー」ではありませんよ、サルカズさん。マグダレーネです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "ふっ、では改めて自己紹介といこう。私の名は「シャベル」だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "……「シャベル」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "王庭軍尉官",
      "text": "覚えておけよ、マグダレーネ。時が過ぎるのは一瞬だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "あの人のテントは、確かこっちだよね……急いでお花を届けに行かないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "あれは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "どうしてあなたがここに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "マグダレーネ！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "……外出禁止時間に花なんて持って、どこへ行くつもり？\nそっちは兵営の方向よ、早く離れなさい！"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "いえ……大丈夫です。ただ少し歩きたかっただけですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "そうだ、今日はフリーダさんのお誕生日だってハンクさんから聞きましたよ。おめでとうございます！　ウィルさんからあなたへのお花を注文されたんですけど、まだ取りに来ないんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "ウィルさんを見かけたら、注意しておいてくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "フリーダさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "どうして黙ってるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "ついてきて、ここは危険だから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "あっ……この花は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "……ウィルが父への手向けにと置いていったものよ。この倉庫は私がずっと施錠してて、あいつがこっそりお酒を飲みたいと言う時にだけ鍵を貸してあげてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "こちらの礼砲は、ウェストさんが農業祭のために用意してたものですか？　すごいですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "……ウィルを助けてあげられなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "ウィルさんに何かあったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "さっきサルカズの兵営で、ウィルが魔族たちに引き留められたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "あいつ、今日はサプライズを用意したいからって早めに私のところへ来たの。けど私が工事の進捗報告に兵営まで行くって聞いたら、不安だからついていくって自分から言い出して……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "でも、サルカズたちがウィルさんを引き留める理由はないじゃないですか……こんなこと、今までなかったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "よく分からないの……怖くて、ウィルを拘束させろって要求を拒むことはできなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "だって、奴らの言うことは何でも聞いてたのに。奴らに頼まれたことは全部やったのに、どうしてウィルまで引き留めるの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "どうして……マグダレーネ、私、何か間違ってたかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "フリーダさん、きっと……きっと彼らも、ウィルさんに何か訊きたいことがあっただけですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "前向きに考えましょう。彼らだって、ウィルさんの労働力はまだ必要なはずです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "そうね……あのおかしな物体の完成はまだだし、ウィルの力はまだ必要なはずよね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "私は兵営の入り口で、ウィルが出てくるのを待つわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マグダレーネ",
      "text": "フリーダさん……見えますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フリーダ",
      "text": "さっきのあれ……私たちを見つめてた？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
