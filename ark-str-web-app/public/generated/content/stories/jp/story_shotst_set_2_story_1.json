{
  "server": "jp",
  "storyId": "story_shotst_set_2_story_1",
  "groupId": "story_shotst_set_2",
  "stageId": null,
  "title": "板挟み",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_shotst_2_1.txt",
  "sourceHash": "cc9627e2dd9019e9c2997d5e7dc2b674a5b5107b934172d95b32e619ff146beb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "流星"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "みんな、ご苦労様。何日も強行軍が続いたから、今日は早めに休みましょう。任務の目的地まであと二十五キロ、早朝に発てば午後には着くはずよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "メテオ姉さんもお疲れ様でした。外勤では携帯食で我慢するしかないと思ってたのに、温かい食事にありつけるなんて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "ああ。まさかメテオがこんなに料理上手だったとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "そうだ！　何を煮込んでたんですか？　テントを立てていた時に、いい匂いがしてきて気になってたんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "私の故郷の家庭料理よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "家庭料理……「おふくろの味」ってやつかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "いや、私は子供の頃から両親がそばにいなかったから、山の麓の村人たちに助けられて育ったの。みんないい人だったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "このスープもその人たちから教わったの。簡単に作れて、野外でも調理できるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "おっと……すまない。余計なことを聞いてしまったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "いいのよ、気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "うん、本当にうまいな。レシピを聞いてもいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "もちろん。材料はシンプルよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "さっき採ったコリアンダーの根と野生姜、それに午後に捕った縞鱗獣を、持ってきた干し肉の酢漬けと塩で味付けして、とろ火で十五分ほど煮込めば完成よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "みんなの言う、メテオに同行すれば絶対に後悔しないっていうのはこういうことだったんだなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "大げさね。野外料理のレパートリーがいくつかあるだけで、私なんかマッターホルンさんのような名コックの足下にも及ばないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "でもスタリシトロンの種があったら、辛みが増してさらに良いわ。こういう寒い日にスタリシトロンを使ったスパイシーミートスープを飲めば、体が温まるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "スタリシトロン……？　なんか聞いたことがあるぞ。確かそんな名前の珍しい木があったはず。名門貴族お気に入りの家具によく使われるような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "あっ、確かカジミエーシュ特有の木でしたっけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "――はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "メテオ姉さんの故郷はカジミエーシュですよね。もし見たことがあるなら、どんな木か教えてくださいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "そうだな。メテオが暮らしていた場所がどんな所だったのか興味がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "メテオ姉さん？　どうかしたんですか？　急に黙っちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "えっ！？　ああ、故郷ね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "もう離れて長いから、どんな感じだったかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "すぐには思い出せなくなっちゃったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "えー残念――ってちょっと！！　なんで叩くんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "早く食べな。いっぱい食べないと大きくなれないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "もー！　今の見てました？　この人ったらいっつも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "はいはい。あまり遅くなるわけにもいかないわ、スープのおかわりをどうぞ。マッターホルンさんが焼いてくれたチャパティも食べてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "わぁ、すごい。ありがとうございます、メテオ姉さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "食べ終わったら早く休むのよ。私はちょっと疲れたから、先に寝るわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ここはどこ？　真っ暗だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メテオ、メテオ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "誰……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "おいで、メテオ。ずっと待ってたんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "誰なの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メテオ、こっちよ。今夜は月影があるわ、一緒にスタリシトロンの木に登ってお月見しようよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ラナー？　どうしてあなたがここにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私、ずっとここで待ってたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ほら、湿った葉の間を風が抜けていくよ。その音が私を促すの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "風？　風なんて吹いていないわ。ラナー、こっちへいらっしゃい。離れちゃだめよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もう行くよ。メテオ、早くついてきて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ラナー、戻って来て！　どこへ行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "早く来て、メテオ。待ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "いなくなった……どうして。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メテオ！　メテオや！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ん……おじさん、どうしてここに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "まぁいいわ。それよりラナーを見かけなかった？　さっきここにいたはずなのに、どこかへ行ってしまったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前までおかしくなったか。ラナーは病気になってもう一ヶ月だ。あいつが外をうろつけるはずないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "病気に！？　でもあれは間違いなくラナーだった……おかしいわ……そうだ、じゃあ今の様子は？　少しは良くなった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うーむ、一向に良くならん。今朝、どうにか粥を一杯だけ食べたんだが、半分はピンク色になって吐き出されたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "そんな！　ならお医者さんは？　お医者さんに診てもらったの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "メテオよ、それが……ワシが今日お前に会いに来た理由でもある。ワシらはもうどうしようもない。今年は秋が短く、冬が長すぎて、もう何も残っていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "村の子供たちは、もう何人も深刻な病状になっている。ラナーもあの容態じゃ、薬が手に入らなければ、この冬は越せないだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "蓄えなら私のが少しあるわ。全部あげるから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "足りないのだ、メテオ……それでな、村を通りかかったお偉いさんがスタリシトロンの木が欲しいと言ってきた。引き換えに金と物資をくれるそうだ。それがあれば、ワシらもこの冬をやり過ごせる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "どうしても、スタリシトロンじゃないとだめなの？　あの林は、うちが先祖代々、何人もの手で守ってきたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "別の、別の木じゃだめかしら？　お願い。もう少し待って。他に方法があるかもしれない、きっと見つかるわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "いや、メテオ。ワシらには……もうこれしかない。ワシらとてお前同様、あの木々を愛している。だが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しそうな声",
      "text": "助けて、メテオ。ゴホゴホッ、もうどうしようもないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い声",
      "text": "メテオお姉ちゃん、助けて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "年老いた声",
      "text": "メテオや――どうかばあさんを救ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "焦った声",
      "text": "メテオ、メテオ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ああぁ、助けるわ、きっと助けるから、はぁっはぁっ、うっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "メテオ姉さん、どうしました？　悪い夢でも見ましたか？　大丈夫ですよ、みんなここにいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "そうだぞ、メテオ。水でも飲むか？　すぐ持ってきてやるからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ふぅ……あなたたちだったのね。私はてっきり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "救援任務だからプレッシャーがかかったんでしょうか。はい、汗を拭いてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "大丈夫よ、ありがとう。連日の移動でずっと気が張っていたから、疲れちゃったのかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "メテオ、何かあるのなら遠慮なく話してくれ。俺たちにできることならぜひ助けになりたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "本当に大丈夫だから。まだこれから移動しなきゃいけないし、片付けて出発しましょう。私のことは心配しないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "メテオ姉さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターB",
      "text": "（首を横に振る）やめろ、ジーラ、これ以上聞くな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "フォン、目標地点までの距離は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フォン",
      "text": "もうすぐだ、残り三キロを切って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外勤オペレーターA",
      "text": "大変だ！　メテオ姉さん、見てください。目標地点の方向に――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フォン",
      "text": "なんて濃い煙だ。報告には火事の情報なんてなかったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ジーラ、この付近で生存者を探してちょうだい。それからその人たちに指示を出して消火にあたるように。アルフォンは医薬品の用意を。あんな規模の火事、負傷者は必ず出てるわ。早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "わかりました。メテオ姉さんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "火災現場の近くへ行って、他に生存者がいないか探してみるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "それは……気をつけてくださいね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ええ、あなたたちも気をつけるのよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（火の勢いが強すぎる。中にはまだ人がいるのかしら。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "誰かいる？　聞こえたら返事をして！　誰かいるかしら！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "誰かいる？　聞こえたら返事をして！　誰かいるかしら！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倒れた村人",
      "text": "メ、メテオか！　早く逃げろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "一体どうしたの？　おじさん、さっき爆発音が聞こえたから、急いで来たのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倒れた村人",
      "text": "近づくな、早く逃げろ！　騎士様が持ち込んだ伐採機の源石エンジンが爆発したんだ。辺りは源石粉塵だらけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "おじさん、もう喋らないで、今手当てするから。ここにはほかにまだ誰かいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倒れた村人",
      "text": "いや、メテオ、ワシの言うことを聞くんだ。早く逃げろ、手遅れになるぞ。あの機械、いつまた爆発してもおかしくない。お前が……病気になってしまう！　早く、ここから離れろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "おじさん、あ、あなたたちを置いていくなんてできないわ……あと少しの辛抱よ、すぐ助け出すから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傷ついた村人",
      "text": "ああ、痛い、目が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "号泣する村人",
      "text": "脚が、俺の脚がぁ……！　助けてくれ、助けてくれぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（どうしよう、どうしよう、どうしよう！　くそっ、どうすればいいのよ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倒れた村人",
      "text": "何をぼけっとしてるんだ、早く行け！　ここは危な――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "あ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ゴホゴホゴホッ、喉が――ゴホゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（手の甲に、血が……私、ケガしたの？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "おじさん！　おじさん大丈夫？　おじさん……みんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "返事してよ、ゴホゴホッ、返事を……ううっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倒れた村人",
      "text": "メテ……オ……こっちだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "うっ、おじさん、なに？　聞こえてるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "倒れた村人",
      "text": "ああ。ゴホゴホ……皆、お前にはすまないと思っている……ラナーのことを……頼んだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "おじさん！　おじさん！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "............"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "どうしてこんなことに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "何をしても間違いで、何をしても無駄だなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "どうして……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "灼熱の空気に当てられ、乾ききったはずの頬に、メテオは水滴が伝う湿り気を感じた。"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（手の甲で頬を拭う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "――くっ。こんな時に、あの日のことを思い出すなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うう、あの子が……あの子が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（何か聞こえるわ、誰かが泣いている？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ女性",
      "text": "ううう……あなた！　何で私を助けたの！？　あの子がいなくなったら死んだほうがマシだわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "すまない、俺はとんだ役立たずだ、自分の娘すら助けられないなんて……　ああ、父さんを許してくれ、うううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "どうしてまだここにいるの、早く逃げなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ女性",
      "text": "逃げる？　どうやって？　もう無理よ、何もかもおしまいよ！　うううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "お嬢さん、俺は脚を怪我してしまって動けないんだ。俺のことはいいから、妻を連れて早くここから逃げてくれ、頼む！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ女性",
      "text": "行かないわよ……うううっ、あなたたちとここにいるわ。死んでも一緒よ。ああ、私の可愛い子――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "どういうこと？　中にまだ人がいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "そうだ……娘がまだ中にいる。いきなりすぎて妻を助け出すのに精一杯だったから……娘は、娘は間に合わなかったんだ。俺が甲斐性ないせいで、うぐっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "わかった、状況は把握したわ。それで、お子さんは家のどの辺りにいたか覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "もう無理だ。こんなに燃えてるんだ。いいから、妻を連れて逃げてくれ、もうどうしようもない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（男性の胸ぐらを掴んで）言って！　どこ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "し、寝室だ。ロ、ロフトの一番南……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "わかったわ。奥さんのことをお願い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "気をつけてくれ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "悲しむ女性",
      "text": "ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "苦しむ男性",
      "text": "おい、大丈夫か？　誰か来て、助けてくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（目が痛い。火の勢いが強すぎるわ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "お嬢ちゃん、聞こえる？　ゴホゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（ロフトの南……あそこだわ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "あっ、熱っ――ゴホゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（蹴り破るしかないわね。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（何も見えない……くそっ、なんて濃い煙なの。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "誰かいる？　ゴホゴホッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "たす……けて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（クローゼットからだわ！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "見つけた、よかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意識の朦朧とした少女",
      "text": "パパ……マ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "もう意識が……しっかりして！　あと少しの辛抱よ、すぐ連れ出してあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（女の子を抱きかかえる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "振り向いたメテオはようやく気がついた。彼女が来た道は、すでに燃え盛る炎に飲み込まれていた。\n真っ赤な炎は壁や階段、ドア枠を伝ってジリジリと燃え広がる。すさまじい熱さの火の手は逆巻くようにうねり続けて二人に迫り、衣服や肌をかすめる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（しまった、どうすれば！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "まずい――崩れる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ゴホゴホゴホッ、ッ――ハァッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（痛い……何かが背中に落ちた……？　そうだ、子供は！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（は……よかった、無事だ。いけない、どうにかしてすぐに離れないと、立ち上がらないと。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "くっ、かなり、痛いわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "意識の朦朧とした少女",
      "text": "た、助け……て……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "助ける、助けるわ。必ず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（辺りを見渡す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（裂け目がある。あそこなら這って外に出られそうだわ。さっき崩れた時に壁が壊れたのね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（……小さすぎて通れそうにないわ。子供を先に行かせるしかないわね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "メテオ姉さん、どこ！？　ゴホゴホゴホッ、どこにいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ジーラ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ジーラなの！？　ここよ、ここにいるわ！　南の方に、小さな穴があるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "メテオ姉さん！　あっ、見えました！　こんな小さな穴、どうやって通るんですか？　どうしよう……ううっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "泣かないで、私のことはいいから。子供を、子供を連れて逃げて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "メテオ姉さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "しっかり受け止めて。とげが刺さらないように気をつけて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "あなたはどうするんですか！　フォンを呼んできますから、待っててください。どうか持ちこたえて――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "聞きなさい。私のことはいい。間に合わないわ。早く子供を連れて逃げなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "そんな、そんなことない。きっと方法があります。絶対に一緒に帰れますから。っんん！　ん――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "くっ――無理よ、重すぎる。ジーラ、私たちじゃ動かせないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "もう一度やりましょう。私の手を掴んで、放さないでください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "早く行って！　じゃないと、あなたたちまで巻き込まれるわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "いけない、早く子供を連れて逃げて！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "メテオ姉さん！！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "メテオ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ラナー……待たせちゃったわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "（首を横に振りながら笑う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "あなたを、みんなを救えなかったわ。結局……私は何も守れなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "ううん、よくやってくれたよ。もう十分……十分だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "私を待ってくれていたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "いいえ、お別れを言いに来たの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "お別れ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "（抱きしめる）もう行くわ、メテオ。あなたはついてこないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……やっぱり行ってしまうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "うん。どうか泣かないで。あなたは誰よりも勇敢な狩人でしょ？　この先も、長い道のりを歩まなくちゃいけないの。それに、たくさんの人があなたを必要としているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "本当にあなたが恋しいわ、本当よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "私もだよ。だけどもう時間なの。行かせて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラナー",
      "text": "さようなら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "メテオ、気がついたのね。気分はどう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ミー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "まったく、こんなひどい傷を負って。生きてたのは奇跡みたいなものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……ナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "二度とこんなことしちゃだめだからね。任務に出て少しも自分の安全を顧みないなんて。私とジェンナが心配で死んじゃうじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ぷっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "あっ！　痛っ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "よく笑えるよね！？　背中に大火傷を負って、気道も焼けて、脊柱骨折もして……まだまだあるのよ。全部数えてあげようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "てっきり……こっぴどく……叱られるかと思った。ゴホゴホッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "なによ。私がそんなひどい人間だと思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "うっ……ふぅ。ごめんなさい、ミーナ。あなたと医療部のみんなに迷惑をかけてしまったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "謝らなくてもいいのよ。私たちもやるべきことをしたまでだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ッ――だけど、ごめんなさい。約束はできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "あなたね――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "今回は医療部が全力であなたを死の淵から救い出したのよ。だけど次またこんなことになれば、誰も命の保証はできないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "私は……放っておけない……誰かがあんな窮地に立たされるのを、二度と見たくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……片方を取れば、もう片方が手からこぼれ落ちる、そんな板挟みの窮地にね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "どんな人もそんな選択を迫られるべきじゃない。手放すことを、失うことを……迫られるべきじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "私には見過ごせないわ。ただ……それだけなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "……メテオ、まだ過去のことを気に病んでいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "やっぱり、あなたは何でもお見通しね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "あの時私は、ずっと守ってきた林を犠牲にすれば、ラナーを、そして穏やかな村の生活を取り戻せると思ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "でも運命はあまりにも貪欲だった。それが欲しがったのは、私の譲歩だけじゃなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "運命の欲望には際限がなく、私のポケットの中身を一つ残らず奪い去ろうとする……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "前にも言ったよね。いつまでも過去にこだわるのはよくないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……ええ。もちろんわかってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ラナーが病気で逝ってしまってから、私は彼女の弓を持って、他の鉱石病の人たちと一緒にあの林を離れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "放浪の日々の中で、私は長い間無為に過ごしたわ。責任を取ることを拒み、何もせず背を向けた貴族を恨んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "大切な人や愛すべきものを守れない無力な自分も恨んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "だけど初めてあなたに会った時は、そんな感じじゃなかったよね。何があったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "きっと多くのことを経験して、考えも変わったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "かつての同行者は、行く人は行き、去る人は去った。私だけが残ってあてどなくさまよったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "それでようやく気づいたの。この大地には私と同じような境遇の人がたくさんいて、絶望的な板挟みの中で苦しみもがいているって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "そういう苦しみを身をもって経験した私が、同じような苦しみを受けている人をどうしても見過ごせないの。だからそのためなら命も惜しまないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "だって、一度は失ったはずの笑顔が再びほころぶのを見ると、私の心も満たされていくような気がするもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "……まぁいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "あなたが……そう思うのなら、私はもう何も言わない。あなたが昏睡状態だったここ数日、ジェンナがずっと付き添ってくれたのよ。あとでお礼を言ってあげてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーナ",
      "text": "まだやることがあるから、先に失礼するね。ゆっくり休んでて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "ジェンナ、さっきメテオ姉さんの意識が戻ったって。今から会いに行くけど、飛びついたらだめだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "わかってるよ、ジーラお姉ちゃん。メテオお姉ちゃんにビンいっぱいのバラを折ったんだ。どれにも祝福の言葉を書いたから、これがあればきっとすぐに良くなるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "（笑いながら首を振る）あの子ったら。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "メテオ姉さん、ミーナから目覚めたと連絡をもらいました。気分はどうですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "メテオお姉ちゃん！　お姉ちゃん、ひぐっ――やっと目が覚めたんだね、怖かったよぉ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "ジェンナ、泣かないで。お姉ちゃん、すぐに良くなるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "……うん。このビンをあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "これは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "見てあげてください。ジェンナがずっと折ってたんですよ。メテオ姉さんが意識不明の間、この子が夜ふかしして折り紙を折ってるのを、ミーナが何度も捕まえたんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "……ごめんなさい、ジェンナ。心配をかけたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "メテオお姉ちゃん、「ごめんなさい」はいらないから、もう二度と怪我しないって約束してよ。お姉ちゃんに会えなくなるのが怖いの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオ",
      "text": "大丈夫よ、ジェンナ。そんなことにはならないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェンナ",
      "text": "わあぁぁんお姉ちゃん！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジーラ",
      "text": "ジェンナ、もう泣かないの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
