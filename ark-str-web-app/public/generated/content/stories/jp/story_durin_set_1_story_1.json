{
  "server": "jp",
  "storyId": "story_durin_set_1_story_1",
  "groupId": "story_durin_set_1",
  "stageId": null,
  "title": "お昼休み",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_durin_1_1.txt",
  "sourceHash": "22baf16afb2891656fd4363f954066679129b59e18c027b1f096b56bebbd6951",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "p.m. 12:10 天気/晴天\nロドス食堂"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "すみませ～ん、ランチメニューのキノコセット一つ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "いちごジャムとマッシュポテトは多めでお願いしまーす。うん、ありがとー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "……よいしょ。よーし、食べよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ふー、ふー……あちちっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "よっ、ドゥリン。隣いいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "どうぞー、ご自由にー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "悪いな。この時間は混んでて、どこも満席でさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "そんで、一人か？　レンジャーの爺さんや、ヤトウたちは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "私だけ先に来たんだよねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "さっき訓練が終わったばっかりだから、皆はまだ片付け中。で、それが終わったら、みんなで焼肉するんだー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "ん？　この後焼肉なのに、キノコセットなんか頼んだのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "平気だよー。これくらい、すぐ食べ終わっちゃうから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "あー……むっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "もぐ、もぐ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "……ま、待った。……俺の目がおかしくなったのか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "その皿、今さっきまで一杯だったよな？　なのにもう半分なくなってるじゃないか！？　食べるの速すぎだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ふふん、言ったでしょー？　すぐ食べ終わっちゃうって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "地上の食べ物って、私の故郷の味とはかなり違ってるからさー。これでもゆっくり味わって食べてる方なんだよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "まあ、キノコはどう料理してもおいしいけどねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "ああ、お前がキノコ好きなのはみんな知ってるもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "けど真面目な話、そんなに偏食して栄養失調とかにならないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ならないよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "……ふぅ、おいしかった。ごちそうさまー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "は……はあ！？　待て待て、いつの間に食べ終わったんだお前……本当に大丈夫なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "大丈夫、大丈夫。心配しないでー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "本当はもっと速く食べられるくらいだし……でも、この間ノイルと早食い対決した時に、医療部に捕まってお説教されちゃってさー。だから、最近はちょっとおとなしくしてるんだよねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "text": "……お前ら、いつもそんなことばっかやってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "まあ、大体ねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ふわぁ～…食べたら眠くなっちゃった……爺たち、遅いなぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "何か飲んで眠気を覚まそーっと――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（うーん、確か前に買ったジュースがまだ残ってたような。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（でも休憩室に戻るには遠いなぁ……ふ……わあぁ、ほんとに眠い……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（そうだ、今の時間なら談話室にコーヒーがあるはずだよねー？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "……おー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "何の騒ぎだろー？　うるさいなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "んー、あそこにいるのはー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "ったく、お前ときたら、この麗しい午後を慈しむことすらできねーらしいな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "感じるぜ。邪悪な力がざわめいてやがる……なあ、よく聞け、「鉄の巨人」よ。己の力を制御するんだ。決して――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "って、おいやめろ、待てっての！　暴れんなって言ってるんだよ、ブラザー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "こいつは一体誰の仕業だ！？　大型マシンにこんな危ねぇ兵器なんか装備させやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "もしもーし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "くそっ、なんでこんなことに……！　このままいったら、邪悪なる霧が蔓延っちまうじゃねーか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "くっ、こうなった以上、こっちも禁じられし手段を行使しなけりゃならねぇようだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "あのさー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "ふっ……もっと早く気付くべきだったぜ。腕の震えは……この瞬間の前触れだった、ってことにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "「鉄の巨人」よ、恨むんじゃねぇぞ。今からこの俺が、お前に引導を渡して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "小さなドゥリン族の少女は無言で跳び上がると、赤い髪のヴイーヴルの脛に正確な蹴りを入れた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "ぐぉっ！？　だ、誰だ、不意打ちなんてしやがっ――って、あんたは……たしかA4の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "もーう、さっきからー、うーーるーーさーーいーー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "で、何してたのー？　んー、『おとぼけ赤トカゲVS装甲ロボ』の撮影とか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "お、おとぼけ赤トカゲ……だと！？　それ、タイトルの時点で駄作決定じゃねーか！　品もセンスもありゃしねぇぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "いや、今はそんなこと言ってる場合じゃねぇ！　早く下がれ、俺の後ろに隠れるんだ。いいか、邪悪なるエネルギーに気をつけ――って、おいぃ！　勝手に動くな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ちょっと黙っててー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "こういう時は、これをこうして……いけー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "注意しろ！　眠れる猛獣を無闇に刺激すれば、お前に災厄が降りかか……待て、聞けって！　闇雲にアーツで攻撃するなって言ってるんだよ！　万が一、そいつの迎撃システムが作動したら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "……ん？　「鉄の巨人」の動きが、鈍った……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ふふーん、当たりだねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ふ……わぁ。すっごい、眠くなっちゃった……じゃあ、お兄さん。後はよろしくー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ほら、急いでー。ロボットアームの下にカバーがあるから、それを開けて……メインのコントロールボックスは、多分その中だよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "はぁ……え、はあ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "操作できるー？　できなかったら、うーん……アームの下を直接、爆破しちゃってもいいと思うよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "さぁ、ぼーっとしてないでー、早く早くー。さっき私が撃ったところねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ぐずぐずしてたら、また砲弾が飛んでくるよー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "ああ、分かったって！　ったく……そう急かすなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "はぁ……この天より賜りし力は本来人目に晒すべきもんじゃねぇんだが、今回は特別に披露してやろう！　……機械油が匂うヤツの扱いは得意なんだ。甘く見るなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "さあ……少々荒削りな趣のある「鉄の巨人」よ！　大人しく止まりやがれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "……えっと、さっきから気になってたんだけどー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "そういうセリフ、言ってて恥ずかしくないのー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "うるせー！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "ふー……成し遂げたぜ、ようやくな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "どんな身の程知らずが作ったのか知らねぇが、こんな危険な装甲マシンに武器まで装備させるとは……まあ、俺に遭遇したのが不幸中の幸いってとこか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（うーん、どれどれ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（あ……！　この構造、前に近所の子供たちが自力で組み上げてたオモチャにそっくり……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（だったら、こっちのカバーを開けて、こうすれば……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ふぅー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "大体、考えが幼稚すぎんだよ。武器ってのはこんな風に軽々しく見せびらかすべきじゃねーし、そもそも趣……って、うおおおっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "おいおいおい！　何やってんだ、危ねーだろ！！　無闇に配線をいじるんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "大丈夫、大丈夫ー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "これを抜いておかないと、あとでまたこの大きいロボが勝手に動き出しちゃうからさー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "うーん……こうやって巻き付けてー、ここを切って……よーし。これでもう大丈夫……なはず。多分ねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "適当すぎるだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "……よし、そこを動くな、そしてよく聞け。いいか、迸る電流に魂を貫かれたくなければ、俺のチェックが終わるまでその体勢を維持するんだ。もう一度言うぜ、絶対に動くなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "おー……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "漏電してたら最悪だからな。さて、この辺りは表面の損傷だけか……なら、恐らく問題ないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "こっちの傷は……うん、さっき俺が攻撃した時についたもんだな。マザーボードへの影響はなし、リスクも高くない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "ほーう……この回路、なかなか面白いじゃねーか。エネルギー装置の組み込み方も荒削りだが……アイデアは悪くねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "……ん？　この痕跡……アクションモジュールに干渉を受けたらしいな。アーツの影響か？　それに、こっちのエネルギー供給配線……切断されてるじゃねーか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ねーー、まーーだーーー？　もう手が疲れたよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "それにす……ごく、ねむーい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "「鉄の巨人」は一時的な行動停止状態になっちゃいるが、危険度の高い箇所にはまったく損傷がない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "ってことは……あんた、まさか……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "これ、全部狙ってやったってのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ん、なーにー？　この制御線がどうかしたの？　私、これでもう大丈夫って言ったはずだけどー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "わざわざ助けに来てあげたんだからー、先輩をもうちょっと信頼してほしいなー、新人さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ふわ～ぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "私は他のドゥリン族の人たちほど機械に強くもないし、金槌も打てないし、こんなロボットも作れないけどー。でも別に対応ができないわけじゃないんだよ……これは簡単な方だしねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "そのドゥリン族のことは兎も角として、だ。あんたにはこれが……簡単な構造に見えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "まあ――原理は単純だもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "うーん……赤毛くん、疑ってる顔だねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "「赤毛くん」じゃねぇ、シェーシャだ！　人のコードネームぐらい覚えておけよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "どっちでもいいでしょー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "そうだなー、じゃあ……シェーシャは、テンちゃんのリンゴを見たことある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "前にエンジニア部が借りて研究してた魔導器のことか？　あれは単なる「リンゴ」なんかじゃねぇだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "でも、私たちにとっては一般的なものなんだよね。お店で売ってるやつなの、あれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "なっ……一体どんなとこなんだよ、あんたの故郷は！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ん～……ごく普通の地下都市だよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "地下に棲まうドゥリン族、か……けどそれ、どっかで聞いたことあるような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "あってもおかしくないと思うよー。地上に遊びに来る同郷の人とか結構多いみたいだしー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "私からすると――地上もいいところだよー。広々してて明るいし、面白い物もたくさんあるしね。だけど機械に関しては、どれも作りが粗すぎると思うなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "……何にせよ、だ。ロドスには、「能力」がありながら群衆に紛れることを良しとする、あんたみたいな奴もいるってことを「理解」した……ふっ、あんたを見くびってたぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "あー皆まで言うな。俺は分かってるぜ……あんたの事情について、多くは追求しねーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "「それが俺たちのような人間の――運命（さだめ）だからな」……みたいな感じでいいよな、多分？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（この赤毛の巨人くん、ちょっとばかなのかな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（まあ、どうでもいいや……ふあ……眠い……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（眠すぎて、死にそう……運動したから……睡眠……取らないと……明日は、もう、起きられない……かも……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "もし私がすごい人だったらー……ふわぁ……家族に一日中、くどくど言われることもなかったと思うけどねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "お前は身体が弱いし、いつも寝てばっかりだ、ってさ……もーう、私だって、好きでこうなったわけじゃないのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "……どうやら、あんたにも知られざる「過去」があるらしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "いいだろう、肩を並べて戦ったよしみだ。あんたの「思い」に耳を傾けてやらなくもねぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "っておい、目を瞑ったまま歩くんじゃねぇ！　転んじまうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "だいじょーぶ……転ばないってー。……ふぁあ……ねむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "それとー、話すことなんて……大して、ないよー。家で、ぐちぐち言われ続けてさ、うんざりしたから逃げ出そうと思った、だけでー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "でもさ……ふあ……生まれつきだもん。治らないんだから、どうしようもない、わけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "……すぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シェーシャ",
      "text": "ちょっ、まだ話は終わってねぇぞ！　立ったまま寝るなって！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ん……あれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "うーー……ん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（また……寝ちゃってた？　それにこの毛布……誰のだろ？　あったかい……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "（あの赤毛の巨人くん、いないなー……もう行っちゃったんだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "うぅ……頭いたーい……今、何時なんだろー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "もう随分遅い時間じゃぞ、ドゥリンよ。えらく寝ておったのう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "あ……レンジャー爺、いたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "今日はちょっと頑張ったから、すごーく眠くて、そのまま寝ちゃったんだ。他にどうしようもなくてさー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "そういえば、この毛布、爺が掛けてくれたの？　ありがとー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "いや、儂ではないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "儂がおぬしを見つけた時には、既に掛けられておったわ。しかし、おぬし……それはもうぐっすりと寝ておったぞ。見ているこちらまで眠くなるほどにのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ふぁ～あ……私の睡眠の質は、羨ましがったところで手に入るようなものじゃないよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "はは、確かにのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ところで、あのシェーシャという若人。ずっとここに座って、おぬしを見守っておったぞ。おぬしに借りがある、と言うてのう。ほっほ……誠に良い若者じゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "わーお……さっさと帰ったわけじゃなかったんだ？　艦内なら、そこまで警戒しなくてもいいのにー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "でも……うん。やっぱりロドスには、優しい人が多いねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "はは、そうじゃのう。よきかな、よきかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "しかしドゥリンよ、おぬしがあの若人を助けたと聞いて、儂は驚いたぞ。他の人間に頼まず自ら手伝うとは……何か理由でもあったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ううん、大した理由はないよー。成り行きで助けただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ほう……そうも熱心なおぬしを、儂は見たことがないぞい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ああいう機械ならよく知ってるしねー。でも、地上であんな大型装甲を見るのは珍しいし……だから、ちょっとだけ懐かしくなったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "なるほど。機械に関しては、儂らではおぬしに敵わぬからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "はい、この話はおしまーい。んー、この毛布は……今度赤毛の巨人くんに会った時にでも返せばいーよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "あ、そうだ……爺、焼肉は？　まさか私抜きで食べ終わっちゃったりしてないよねー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ははっ、そのような意地の悪いことなどせんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "それにしてもおぬし、ちょうどいい時に目覚めたのう。今、ノイルが肉を焼いておるところじゃ。無論、おぬしの分もたっぷりとってあるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "いえーーい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "これこれ、あまり急ぐでない。転ばぬようにな……それにしても、まさかこんなにも速く走るドゥリンが見られるとはのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "ポカポカな毛布で眠れたからねー。おかげで、すっごく元気になったよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "のう、ドゥリンよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "時折、眠るおぬしを見ているとな。少なからず心配になるんじゃ……きっと他の者らも同じ気持ちじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "んー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "その……おぬしの身体は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "レーンージャーーじい～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "しーっ。しー、だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "私は大丈夫だよー。ただ、人より睡眠時間が多いだけだしー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "しかしのう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "安心してよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "医療部の検査には定期的に通ってるし、普段の任務でも全然問題ないでしょー？　私たちドゥリン族は、そんなに貧弱じゃないよー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "それにさ、体質のせいでって言えばー、勤務中にだらけても誰も私を責めないし……どう考えてもお得でしょー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "うーん。けど、どうしても気になるって言うなら、お肉をたくさん食べさせてくれたら、もっと元気になれるかもねー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ははっ、そうか、そうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ならば、今日はよく食べて、栄養をつけるんじゃぞ。さぁ行こう、ノイルと皆が待っておるでのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "おおー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥリン",
      "text": "よぉ～し。焼肉ーー、待ってろよー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "集中力に欠け、非力で病弱。少しでも疲れてしまうと、眠って回復しなければならない――このひ弱な身体に、ドゥリンはとっくに慣れている。\n生まれつきの欠点というものは、病気と違って薬で簡単に治すことなどできない。\nかつてはそれを不満に思い、怒りがこみ上げることすらあったが……地上に来て、この大地の上で起こる数多くの出来事を知ったドゥリンは、自身の虚弱体質と和解したのだ。\nもうー。\nちょっと身体が弱いからって、それが何だっていうのー？\n勤務時間でも、急ぎの仕事さえなければ、誰にも邪魔されずに太陽の下で眠れる。それが本当に気持ちいいんだよねー。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
