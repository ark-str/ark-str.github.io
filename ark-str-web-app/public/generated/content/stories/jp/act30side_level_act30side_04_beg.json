{
  "server": "jp",
  "storyId": "act30side_level_act30side_04_beg",
  "groupId": "act30side",
  "stageId": "act30side_04",
  "title": "軌道修正",
  "storyCode": "RS-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act30side/level_act30side_04_beg.txt",
  "sourceHash": "ef5d36742504a5e96db42d8f0dabf5830632e81c3b078af3fd21d12344d9a2fe",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "フルハウス！"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "ストレートフラッシュ！"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "*ヴィクトリアスラング*、お前イカサマしやがったな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "あんた相手にイカサマなんかする必要あるかよ。いいからおとなしく――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な兵士",
      "speakerId": "avg_npc_1158_1",
      "text": "ロイヤルストレートフラッシュ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "*ヴィクトリアスラング*、んなバカな！？"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な兵士",
      "speakerId": "avg_npc_1158_1",
      "text": "ジャック、お前の袖。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "は？　おま――どうしてわかったんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "ジャック、この*ヴィクトリア語特定名詞*、騙しやがったな！"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "気付かねえあんたが悪いんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "*ヴィクトリア式のご挨拶な言葉*。"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な兵士",
      "speakerId": "avg_npc_1158_1",
      "text": "シャッフルしろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "はいはい、シャッフルシャッフル。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "ったく、今日はツイてねえな。お前と組んで当番なんてよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "誰が一緒でもどうせトランプしかやることねえし同じだろ。うちの連中でイカサマしねえ奴を数えるほうが簡単だっての。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "フンッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "にしても、ここでの毎日はほんとにのんびりしたもんだよな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "そうだなあ。ボスが俺らを観光に連れていくって言った時は、正直少しも信じてなかったんだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "一ヶ月が経った今は、すっかり信じられるようになったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な兵士",
      "speakerId": "avg_npc_1158_1",
      "text": "飲食も申し分ないしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "本当にな。おかげで食欲まで入隊したての頃に戻ったみたいだぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "っ――うわあっ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "いきなりなに大声出してんだ、チャールズ！　脅かすなっての！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "*ヴィクトリアスラング*！　夢見が悪くてさ……まただよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "今度のはサルカズに剣で真っ二つにされる夢だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "チッ、何かと思やそんなことかよ。俺なんか一昨日、偵察中に源石爆弾で粉々にされる夢見たぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_408_1",
      "text": "俺も今すぐお前の口に爆弾でもぶち込んでやりたいところだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "やってみろってんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "お前ときたら戦場じゃ*ヴィクトリアスラング*なブラッドブルードよりもイカれた野郎だったのが、戦場の外じゃ誰よりうじうじしてんじゃねえか。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_408_1",
      "text": "うるさいな、俺にどうしろって言うんだ。悪夢を見ないようにできるなら、俺だってとっくにそうしてるよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "前向きに考えようぜ。前回はミンチにされたんだろ？　今回はただの真っ二つなら上出来じゃねえか。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "もしかしたら良い兆候かもしれんぞ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_408_1",
      "text": "……*ヴィクトリアスラング*、割と筋が通ってるな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "ほら、一口飲んでトランプでもしようや。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "おお、そりゃちょうどいい。俺の代わりにしばらく遊んでてくれ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "なんだ、用事か？"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "……ちょっとな。麓の農家に頼まれたんだよ。畑仕事の人手が足りんから手伝ってくれってさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "農家って？"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な兵士",
      "speakerId": "avg_npc_1158_1",
      "text": "よくミルクを届けてくれてるトゥリエルさんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "あー、わかった。あそこの娘さん結構かわいいよな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "ヒュウ！　意外と隅に置けねえな、リスバーン。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "……ただの手伝いだって。バカな勘繰りはよせ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "何なんだ、さっきから。数百メートル離れたところからでも、お前たちロートルどもの騒ぐ声が聞こえてきたぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "しかし、お前たちときたら実に有能だな。兵営をポーカールームに仕立て上げるとは。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "観光に連れてってやると最初に言ったのはボスじゃないですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "我々はご命令を遵守しているまでのことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "我々が悪いイメージを持たれないよう、地元住民に対する慈善活動を行えとも言ったつもりだが、そちらのほうはどうなんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "それなら、ちょうどリスバーンが行くところですよ。ま、単なるボランティアというよりは、ここで所帯を持とうとしてるようでもありますがね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ほう？"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "そいつの出まかせに耳貸すな。俺はただ手伝いに行くだけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "俺たちがここに来たのは、結局のところ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "無駄話は結構。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "お前は一体いつからそんな心配をするような立場になったんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "本当に所帯を持てたなら、むしろ見直すくらいだよ。いいからさっさと行きなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "speakerId": "avg_npc_1157_1",
      "text": "イエッサー！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "しかし、すごいニオイですね、ボス。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "また獣医の腕でも磨いてたんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "そう言ってくれるな。レオン殿のところのリリーが早産してしまってね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "お産に間に合えなかったから、産後のケアを多少しておくくらいしかできなかったんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "おまけに不吉な奴にも遭うし、やれやれだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "不吉な奴というと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "同郷の徒さ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "同郷って……ヴィクトリア人観光客なら、この一ヶ月だけでも俺はしこたま見ましたけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "だろうな。お前は街をぶらつくのが大好きだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ほら、カードを配ってくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な兵士",
      "speakerId": "avg_npc_1158_1",
      "text": "では俺が。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な兵士",
      "speakerId": "avg_npc_1158_1",
      "text": "そういえば、さっきチャールズの奴がまたうなされてましたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "そうなのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ちょっと見せなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "いえ、大丈夫です。ボスの手を煩わせるほどのことじゃありませんから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "お前たちが死んでしまったら、誰が私のために戦ってくれるっていうんだ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "……戦うことになるんでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "今は黙って、我慢しなさい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "うっ――"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ふむ……確かに悪化はしていないようだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "まだ前と同じくらい痛むのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "イェラグに来てからはだいぶマシになりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "ふっ、当然だろ。大枚はたいてコネを作ってようやく機会を手繰り寄せたのだから、これだけやってお前たちの身に何の恩恵もなかったら、かけたコストが水の泡じゃないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "とはいえ、ここじゃ療養にしかならんがな。"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "はは、わかってますよ、ボス。"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "俺の腕はとっくに使い物にならないってのに、それでも面倒見てくれるのはあなたくらいのものです。"
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "speakerId": "avg_npc_414_1",
      "text": "とはいえ、たとえ両腕がダメになったとしても、口さえあれば武器をくわえて戦場に立って見せますがね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "まったく、腕をなくした兵士に何ができるっていうんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "強がる必要なんかない。何しろ、お前たちがここにいるのは――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "speakerId": "avg_npc_867_1",
      "text": "もう一度ご忠告いたしましょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "speakerId": "avg_npc_867_1",
      "text": "ご自分の責務をどうかお忘れにならぬよう、そして公爵様のご期待に背かれぬようお願いします。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "speakerId": "avg_npc_867_1",
      "text": "これは決して観光旅行などではないのですから。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "おーい、ボス？　どうしたんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "もしかして、ついにボケちまったとか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "お前たちと違って、自分の体を顧みない愚か者ではないのでね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "たとえお前たちがボケてしまっても、私だけそうはならん自信があるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "はは、そもそも俺たちゃそんなに生きられませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "はぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "致し方なし。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "悠々自適な老後のためにも、私が顔を出しておくしかないようだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "何言ってんですか、ボス。"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "そんなことしたって、イェラグ人にはあなたみたいにキザでうっとうしい貴族なんて好かれませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "だが、盛大なパーティーへの誘いを断る人間などいないだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "speakerId": "avg_4114_harold_1",
      "text": "少し出てくる。お前たちは続けてくれ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "手札が悪すぎたから逃げ出す口実を作ったわけじゃないだろうな……"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "どれどれ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "speakerId": "avg_npc_408_1",
      "text": "Jのフォーカードか。良くも悪くもねえ手だな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "ははっ、これは良い酒だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "これが例の、エンシオディスがわざわざ送ってきて、式典前夜のかがり火の宴で宣伝するとか言っていた……ううむ、何だったか……"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "「シャトーカランド・雪境（ヒーラ）の春」ですよ、旦那！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "ここんとこ毎日テレビでやってますから、つい覚えちまいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "派手な宣伝で歓心を買おうというわけか！"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "ふむ、しかしこの酒は確かに悪くない。飲みごたえも十分だ。エンシオディスの奴もたまには良いことをするものだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "とはいえ、うちで醸してる年代物の酒も決して負けてはいないぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "でしたら、もっと飲まれますかい？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "ブラウンテイル家が持ってきたのも合わせれば、全部で三種類もありますぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "無論だとも！　自分で飲んでみなければ、どれが一番かなどわからないだろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "巫女様は今回の宴の準備をペイルロッシュ家にお任せくださった。となれば俺がしっかりと責任を持って事に当たらねば。"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "その準備の中でも、酒は最重要事項だ。我らイェラグが客人をもてなすにあたり、最高の酒を選出しなくてはならん。巫女様を失望させないためにもな！"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "さあ、残りの酒をまとめて持ってこい！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "はい！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "おーい、誰か！　一緒に酒を運んでくれ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "将軍、一つよろしいでしょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "何だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "旦那様のお話では、これは宴の準備だそうですが、最近はいくらなんでも運ばれてくるお酒が多すぎませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "兄弟たちも皆疲れ切ってしまっていて。"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "余計なこと考えてんじゃねぇよ。イェラガンド像の完成なんて大ごとには、酒がいくらあっても足りねぇくらいだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "兄弟たちにはもうしばらく辛抱してもらえ。この件が落ち着いたら美味い飯でも食わせてやるからよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "わかりました。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "（ペイルロッシュ家の人間はもう少し警戒心を持つべきだな。）"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "（まさかこれほど容易く紛れ込めるとは。）"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "（あのご隠居はすでに、ロザリン嬢を連れてこちらへ向かっている……）"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "（となれば次は、ペイルロッシュ家の企みを確かめさせてもらうとしよう。）"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "（それにしてもこの大量の酒……そして、アークトスのあの振る舞いも……本当に宴に備えてのものなのだろうか？）"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "（これも手がかりになりそうだ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "おい、グズグズしてねぇでさっさと手伝え。"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "はっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "（だが、ペイルロッシュ家に何か隠された秘密があるとすれば、それは恐らくロザリン嬢と関係しているはず。）"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "speakerId": "avg_npc_283_1",
      "text": "（まずは彼女のほうを優先するか。）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "着いたぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "へえ、ここが爺さんちか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "でっけー家だな。爺さんがこんなに金持ちだったなんて意外だぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "それほどでもないさ。少しばかり蓄えがあるだけでな。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "うぉっほん。ほれ、見てみなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "この家は山に面しているだろう。明日山を登るのなら、家の裏にある近道を使いなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "わかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "ありがとな、爺さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "先に謝らせてくれ、お嬢さん……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "ん？　どうしたんだ急に。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "おぬしを家へ招いたのは、実のところ私のわがままでもあるのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "このことは、おぬしに隠すべきではなかった……我らがイェラガンドよ、どうかお赦しください。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "……何だってんだよ、そんな真剣な顔してさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "ちゃんと聞いてるから、話してくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "おぬしはまったく、良い子だな……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "一人、おぬしに会わせたい人間がいてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "あやつは……"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_1160_1",
      "text": "あれ、大旦那！？"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "爺さん、でっかい奴が向こうで呼んでるぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "あんたの息子か？"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "あんな息子はおらんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "しばし待っていなさい、お嬢さん。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "何だって急にお帰りになったんですか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "……なんだ、帰ってきてはいかんというのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "んなわけねぇでしょう！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "ただ、なんつーか今はタイミングが悪いんですよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "そんなもの、良いも悪いもあるか。私がいつ帰るかなど、お前に口出しされる筋合いはないぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "アークトスはどこだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "だ、旦那はですね……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "なにを口ごもっているのだ、言え！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "はいっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "旦那は、明日開かれるかがり火の宴の準備をなさってます！"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "聞こえの良いことだけ言うでない！　ほかに報告すべきことがあるのだろう！？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "……実は、明日出す酒をご自分で確かめなきゃならんとかで、各地から送られてきたのを飲んでるとこです……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "あのバカ息子……！"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "酒を断つと先月言っていたばかりだというのに、もうそれを破ったのか！　デタラメにもほどがあるぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "そんな朝令暮改の体たらくで、どう威信を保つつもりなのだ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "これも国事のためですから……巫女様への忠誠心もありまして……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "フン！　どうせ酒飲みたさに勝てなかっただけだろう！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "は、ははは……そういえば、そっちの嬢ちゃんは誰ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "礼を失する言い方はよせ！"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "この子はロザリン、私の客人だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "ロザリンお嬢さんですね。ようこそおいでくださいました！"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "（小声）ええと、それで……このお嬢さんは一体どこのどちら様なんですかい？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "（小声）なんとなく、旦那に――"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "（小声）シッ！"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "（小声）……まだ確証はないことだ。それ以上問うてくるな。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "よいかグロ、この子を中へ案内するのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "そう……ろくでなしのアークトスの所へな。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "それと、下の者に客室と食事を用意させ、しっかりと手厚くもてなすように。"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "……はい！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "待たせたな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "気にすんなって。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "話は終わったのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "さっきこのデカいのが来る前に、爺さん何か言おうとしてたよな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "まあいいや。それで、私を誰に会わせたいんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "……そやつはこの中にいる。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "会えばすべての疑問が解決するであろう。まずは、こやつについて中へ入りなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "わかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "でも、爺さんはどうすんだ？　一緒に行かねぇの？"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "またすぐに会えるさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "すぐに、な……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "こちらへどうぞ、ロザリンお嬢さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "うーん……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "なあ兄ちゃん、グロっていったっけ？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "さっき爺さんとこそこそ喋ってたみたいだけど、何話してたんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "もしかして、私には言えねぇようなことか？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "おーい、何とか言ってくれよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "（人差し指でバツを作る）"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "マジで言えねぇことなのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "（繰り返しバツを作る）"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "うーん……わかった、無理に聞いて悪かったな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "どのみち、会えばすぐわかんだろ？　私も気になってたとこなんだよな。あんたらが揃いも揃って私の顔をジロジロ見てくんのは、どういう理由があってのことなのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "もしかして、私が誰かに似てるとか？　いや、逆かな？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "まさか私に会わせたい奴って――"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "い、いやいや、ち、違いますって……！！"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "ちぇっ。まあいいや、どう見たってあんたは嘘をつけそうにねぇ奴だしな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "だけど、マジであんたらの視線は妙な感じだぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "悪意がないって知らなかったら、思わず手ぇ出してたくらいだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "――！"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "おい、入るんだろ、行こうぜ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "speakerId": "avg_npc_260_1",
      "text": "あっ、お嬢さん！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すいません旦那！　実は大旦那がお客人を連れていらしたんですが……\nって、旦那！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "うわっはっは！　美味いな、こいつは実に良い酒だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "おお、グロ！　ほら、お前も飲め！"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "わっはっは！"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "爺さんが会わせたがってたのはこいつか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "見た感じ……ただのひげ面の酔っ払いっぽいけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "んん？"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "誰だ、この小娘は。バカなことを言うんじゃない！"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "ペイルロッシュ家当主であるこのアークトスが、このくらいの酒で酔うはずがないだろう！？"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "ハッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "酔っ払いはみんなそう言うんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "しっかし、私はてっきり……いや、でもそんなはずねぇよな。私の父ちゃんはすげえイケメンのはずだし……"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "親父の客人である以上、うるさく言うつもりはないが……ヒック。"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "ううむ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "もっとこっちへ来い、小娘。顔をよく見せてみろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "speakerId": "avg_194_leto_1",
      "text": "な、なんでだよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "その顔……どこかで見たような。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "speakerId": "avg_npc_254_1",
      "text": "お前は……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "ごほっ、ほこりっぽいな……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人が部屋へと足を踏み入れれば、分厚いほこりが舞い上がった。\n扉は外れかけており、床板は一歩ごとにきしむ。\n彼自身の命令により、この部屋はもう長らく客人を迎え入れてはいなかった。\n誰も住む者のない部屋は、誰にも気にかけられることのない人のように、いつのまにか歳を取っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "さて、あれはどこへ置いたか……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "確か……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "……ああ、ここだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人は部屋の隅にある木製の棚を手探りで開け、中からあるものを取り出した。\nそれは、角が磨かれ綺麗な丸になっている飾り気のない石だった。\nその石には、イェラガンドの祝福を表す模様が刻まれている。\n老人は、自らの願いで手に入れたその石を握りしめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "よかった、よかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "すっかり仕舞い込んだままだったが、まさかこんな日が来るとは。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "タチアナよ、ロザリンは良い子だな……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人は思い返す。あれも冬のことだった。\n彼は当時この窓越しに外を、重苦しい声なき別れを見つめていた。\n異国から訪れた何の罪もない若き女性が、氷雪を燃やすほどの怒りと失望を抱いて去って行く姿を――\nそして、物心もつかない幼子が母の胸に抱かれたまま、その顔に浮かぶ怒りの理由を理解できずにいる姿を、ただ見つめていたのだ。\n老人はそれを長いこと見つめ続けていた。\n二人の後ろ姿が、風雪の中で次第に消えていくまで。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "あれから幾年もの時が過ぎ去っていった。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "当時の私は、これをロザリンに渡そうと思っていた。だが、そうはならなかった……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "あの時、アークトスにはおぬしらが非難を受けているのを黙って見ていられるはずもなかった。あやつを薪小屋に無理やり閉じ込め、おぬしを庇えぬようにしたのは私だ……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "その後、ペイルロッシュ家のためにおぬしらを追放すると決めたのもな。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "恨むならどうか私を恨んでくれ、タチアナ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "今や、ペイルロッシュ家はアークトスが継いでいる。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "イェラグも昔とは大きく変わった。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "今の私は、誓いを立てた身だ。一人の修道士として、この命続く限りイェラガンドのために街路を掃き清め続けるという誓いをな。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "もし、あの時もこうであったなら……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "このような夢を見るとは、私も本当に老いたものだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "ああ、イェラガンドよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "speakerId": "avg_npc_1160_1",
      "text": "どうかお見守りください……"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
