{
  "server": "jp",
  "storyId": "main_12_level_main_12-13_beg",
  "groupId": "main_12",
  "stageId": "main_12-13",
  "title": "穴だらけ",
  "storyCode": "12-15",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_12-13_beg.txt",
  "sourceHash": "8e99c2b9f54a7efa83f52e5451388d5ae513baff4251dbacd926663bffaf8e00",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "此度はイベリアか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "我慢してほしいな、バンシー。私にとって、ここでの日々は最も忘れられないものなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "うぬは彼の地を嫌うと思っていたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "あの災いが起こるまでは確かにイベリアが好きではなかった。大言壮語ばかりの独善さにはうんざりだったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "イベリア人は、畏怖というものを知らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "ならば、あの災いがうぬを満足させたと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "いいや、私は赤目の老いぼれのようなサイコパスではないのでな。災い自体は珍しくも何ともない。この大地は災いにだけは事欠かないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "しかし、あの生物たちは私を魅了した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "噂で聞いたに過ぎぬが、実のところ、あれらについて我は不安を感じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "あれは、我々とあまりにも異なるゆえに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "では私と君は異なると思うかい、バンシー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "君は知っているはずだ。私はどのような姿にもなれるが、いずれも本当の私ではないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "源石はすべての人間の体に、問答無用で烙印を刻み、君たちを今のような姿で生かしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "だが源石はただひとつ、変形者のことを忘れたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "私たちだけが、いまだ原初の姿を残している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "変形者、うぬは己の純潔を誇るか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "いいや。いいや違うよ。この世界がすでに姿を変えてしまっているのに、今さら純潔に何の意味があるというの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "私は源石がもたらす変化を、そして君たちの後ろを追いかけることしかできないんだよ。君たちが創造したものを追いかけることしかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "かつてあらゆる手を尽くして、イベリアに荒廃した町を見つけて、そこに居を構えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "私たちはそこに定住することにしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "そして私たちは町を再建した。仕事や、交流や、商業、そして交通――そういったものを少しずつ復活させて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "二百人の私によって、一つの町を作り上げた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "今なお狂気に囚われていないのは、うぬにとって幸福であるか、はたまた無上の不幸であるのか、我には分からぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "ハッ、そんなもの誰にも分からないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "とにかく、私はそこで忘れられない時間を過ごした。やらなければならないことが多く、毎日その中に溺れていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "その日々は、ある錯覚を生んだんだ。私たちは有意義に生きているのではないかと思ってしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "しかし、退屈はやはり訪れた。細々とした作業に専念することは面白い。だがそれらを全部合わせたところで、結局答えを見つけることはできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "「あれ」らを見つけるまではね。ある者はあれらを「シーボーン」と呼んでいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "私は、あれらを長きに渡って観察した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "うぬは、あれらに己を投影したのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "いいや、統一という観点において、私たちはシーボーンとその大群を超越している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "どれほど多くの姿に分裂しようと、私たちの思考は常に一つだ。しかしシーボーンは、数の多い方に身を投じて群れることしかできないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "しかし、意外かもしれないが、私はあれらが羨ましいのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "あれらは、本能に従ってさえいれば十分なんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "食べ物を探し、養分を求め、繁殖し、進化する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "あるいは、君がさっき言った「純潔」という言葉は、あれらにこそ相応しいかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "当時、私はその場にいて、すべてを観察していた。あの多種多様な小さい生物たちが、海草を自らの一員として同化させる様子を見ていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "あれらは何も考えず、己のすべきことだけをする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "では私たちは？　私たちの本能は何を命じている？　私たちは何をすべきなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "バンシー、君は私たちに何かアドバイスを与えてくれるだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "笑っているのか、バンシー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "すまぬな。変形者よ、決してうぬを嘲笑しているわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "最古の王庭の主ともあろう変形者殿が、ただ生きる意味を模索していようとは思わなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "それは重要だ、論ずるまでもなく重要なことである。ただ、我の目の前に立っておる者が実のところ、彷徨える哲学者だったとは思考の埒外だったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "私たちが、ヴィクトリアの大学で一体何年哲学の教授をしていたと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "君たちにとっては、生きる意味を見つけるのは簡単なことだろう。ごく一部の存在を除けば、君たちの命は短いと言える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "目標を見つけて、それに向かうことによって短い歳月を埋めるのはさほど難しくはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「イベリア人」",
      "text": "しかし、それは私たちには通用しないんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "君の提案も、テレシスの描く未来も、僕たちは特に興味がないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "僕たちにとっては、どれも等しく暇潰しでしかないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "どうして僕たちが、そんな一瞬で過ぎ去るようなものに感情を抱く必要があるのさ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "僕たちはどれほど低い可能性であっても一つ一つを試したよ。あらゆる楽しみをほぼ味わい尽くしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "うぬが哀れに思えてきた、変形者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "そう。僕たちが、何に対してもつまらないと喚いてるだけの老いぼれだと気付いたんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "この秘密を知る人は、多くないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "我の友人の何名かが下らない遊戯を教えてくれたことがあるが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "いいや、やめておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "教えてよバンシー、君が思ってるより僕たちは興味がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "とは言っても、次に会う時までお預けになりそうだ。どうも面倒な仕事がやってきちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "変形者",
      "text": "この場所で起きてるわけじゃないけど、多少は向こうに集中しないといけないね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ない……とはどういう意味ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "そのまんまの意味です、もうっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "通信基地局はなかったんです。あそこは空っぽでした！　誰かに先を越されたんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ダブリンの部隊でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "多分もっと前ですね。溜まっていた埃の厚さからして、ノーポート区がロンディニウムから離れた時には、誰かがすでにあそこに目をつけてたんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あの赤鉄親衛隊の隊長も騙せはしない。予想された放送が行われていないことに彼はすぐ気付くだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "だがこれで我々は、少なくとも同じスタートラインへ逆戻りしたということになる。ボーナスチャンスの再来だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "カスター公爵に仕えるあなたも、ダブリンの亡霊部隊も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "こっそり忍び込んだということはつまり、表向きはノーポート区の現状を維持したいんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "でも公爵たちの主力部隊に行動を起こさせなければ、私たちの計画を本当に実現することはできませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "デルフィーン、勿体ぶるのはもうやめたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "あなたがまだここにいることを公爵が──あなたの母親が知れば、彼女は何としてもあなたを救おうとするはずでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "保証はできません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イネス",
      "text": "ママとの関係が良好だって認めるのは、別に恥ずかしいことじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "何か方法はないか、イネス？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "面倒くさいの。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "どうやらあるみたいだな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "……あなたのそういうところ、ほんとに嫌いよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "まぁいいわ、やってみましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "あまり期待しないでちょうだい。まずは高い場所を見つけないと。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "イネスさん、それが完了するのにどれくらいかかりますか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "日の出まではかかるわね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イネス",
          "text": "シージと市民たちに準備をさせて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "皆様、どうかご無事で。次回もまたホテル・サンセットストリートをお選びいただければ幸いです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "私はここで素晴らしい時間を過ごし、素敵な方々と出会いました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "ノーポート区は活気に溢れた素晴らしい場所です、このまま思い出や廃墟にしてはなりません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい、決してそんな結末にはさせません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "陰謀や紛争はいずれなくなります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私の……とてもとても大事な人が言っていました……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "いつの日か……この大地の一人一人が、落ち着いて静かに眠りに就くことができる日が来ると。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "ハァ、やれやれ……ホテルがさらに散らかってしまいました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "自分で掃除をしない人たちは、秩序を維持することがどれだけ大変であるか、知りもしないんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "パーシヴァル！　パーシヴァル！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "どこへ行ったのでしょう？　まったく……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "まぁいい、しばらく一人でのんびりしますよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "年老いた支配人は、自分と同じくらい年季の入ったアームチェアを引き寄せて腰掛け、楽な姿勢を取った。"
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "彼女……あのコータスのお嬢さんが、魔王なのでしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "この私ですら驚きです……時代の変化に追いつくことは、ますます難しくなってきましたね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "変化……変化ですか……私自身がそういった変化を怠っていたかもしれませんね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "変化は前進とは異なるものです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "さてと、そろそろこの旧友ともお別れをすることに致しましょう。正直言って……この場所は本当に気に入っていたのですがね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "はぁ……コルバートもあと二ヶ月持ちこたえていれば。まさか二ヶ月後にサルカズの軍隊が都市に入り、一人の魔族が清掃員からホテルの支配人になるなんて誰が想像できたでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "いつになっても、運命というものが分かりません。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "サルカズの老人は立ち上がり、ホテルのロビーを見渡した。ここにあるもの一つ一つが彼と密接な関係がある。"
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "あのイネスというキャプリニー、戦争は修飾するに値しないと言っていましたね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "コルバート",
          "text": "では、私たちの力でその本来の姿に戻すとしましょう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "その絨毯は、これまでどれほど多くの政界の要人や貴族に踏まれてきたであろう。精緻に織り上げられたアンティークに、サルカズの老人は火のついたライターを放り投げた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "たちまち、炎が激しい勢いで燃え上がってゆく。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "ここの……この兵士たちは、みんな殺されたんすか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "まさかここに敵が！？　うちがもっと早く気付いてれば……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "彼らの遺族には弔慰金が支払われるだろう。もし遺族がいればの話であるが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "警戒しないと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "必要ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "その顔……とっくに知ってたんすか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "まさか……これもあんたの計画の一部……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "これはカズデル軍事委員会の仕事だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "幼き傭兵よ、犠牲とは決して避けられぬものだ。君も傭兵部隊の隊長からそう教わっているものと思っていたが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "あんたは将軍で、あの人たちはあんたの兵士じゃないっすか！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "そうだ、私は将軍だ。そして、これこそ私の仕事なのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "我らの敵にしろ、我ら自身にしろ、すべきことは変わらない。戦争という名の巨大な口に一人一人の命を投げ込むこと──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "そして、その口が私たちの望み通りの結果を吐き出すのを、願うことだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "これが、将軍である私の立場でできることの全てなのだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "あんたは──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "だから私はここへ来るのだ、すべてをこの目に焼き付けるために。ここにいる青白いを表情した若者たち一人一人の顔を見るために。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "私は、覚えておく必要があるのだ――これが自分の下した決定であると。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "これが、目的を達成するために避けられぬものだとは言わない。サルカズの支払わねばならぬ代償とはな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "彼らを殺したのはヴィクトリア人だ。だが、彼らをヴィクトリア人に殺させたのは私なのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "どうしてそんなことを？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "炎を点すためだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "この大地の隅々まで広がる炎を点すのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "我々……サルカズは、そのような紛争に溢れた大地でのみ、自らの居場所を、活路を見つけ出すことができる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "幼き傭兵よ。君は、こうしたものに慣れることを学ばなければならない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "馴染み、恨み、最後には受け入れるのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "それが唯一の方法なのだから。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "封鎖エリア内で、真っ赤な炎が猛然と上がり、古びた建物が赤々と燃える。"
        },
        {
          "type": "dialogue",
          "speakerName": "パプリカ",
          "text": "また……火災っすか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "いいや、あれは最初の火種だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "飛空船に戻らねばならぬ。ついてくるがいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "text": "客人たちはすでに席に着いている。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
