  "stageId": "main_03-07",
  "title": "とどろく",
  "storyCode": "3-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_03-07_end.txt",
