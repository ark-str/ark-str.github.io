{
  "server": "jp",
  "storyId": "act42side_level_act42side_09_end",
  "groupId": "act42side",
  "stageId": "act42side_09",
  "title": "釈義",
  "storyCode": "MT-9",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act42side/level_act42side_09_end.txt",
  "sourceHash": "85dcd04cc7efc29197c8db6571d9e7c6629596b7bea6dc6331baf88e121c819a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "くっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……今は応急処置しか施せません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アンドアイン、あなたの視神経は、光学系アーツを際限なく使い続けたことで、不可逆的な損傷を受けています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "この種の外傷を治療する資質も能力も、私にはありません……こんな状況でなければ、すぐにでも医者に診せるべきなのですが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "気にするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "道はすでに、我々の足元に現れている。目が見えずとも、前に進むことはできるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "床に光のしるべをつけた。それに従って進もう……この迷宮は複雑すぎて、このアーツもそう長く持ちそうにない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "わかりました、行きましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "この場所だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "災厄の発端がここにあるかまではわからないが、この扉の奥にあるものは、我々に答えをもたらしてくれるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ついてきてください、アルトリア。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しかし、その呼びかけに答える声はなかった。\n育児聖堂の外でアルトリアに追いついて以来、彼女はこれまでフェデリコの出す指示のすべてに協力してきた。\nだが今、黒髪のサンクタは数歩離れたところで優雅に弦を弄ぶばかりで、一向についてくる気配はない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "今度ばかりは、本当に脱走することにしたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "アンドアインさんは怪我をしてるし、実質的にあなた一人だもの。今が絶好のチャンスでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "我々は今、真実の扉の前に立っているのですから、そうした行為が無意味であることはお気付きでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "真実……意味……ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……ええ、そうかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたは誰より優秀な執行人で、「歩く法典」で、教皇を除けば初めて聖徒に任ぜられた……「葬送人（イグゼキュター）」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "その「理性」も、「冷酷さ」も、そしてその二つの性質さえを疑う心も、すべては法の存続そのものを体現しているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "聖都自体の本質がそういうものであるなら、その言葉を理解できるのはあなただけかもしれないわね、ふふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "それと、アンドアインさん……ごめんなさいね。そんなつもりはなかったのだけど、さっきあなたがアーツを放った時、心の声に無意識に触れてしまったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたの音色は、大抵の人より随分と複雑な音色だったわ。だけど……そこまで特別なものではなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "偏執的すぎる主旋律のせいで、すべてが同じ楽曲の編曲や、反復になってしまっているのよ。そして、その音が物語るのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたの起点も、終着点も、ラテラーノにあるということ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ただ、その時あなたは独りになってしまうのかもしれないけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ああ、無礼な物言いになっていたら、許してちょうだいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ああ……アルトリアさん、あなたの言う「無礼な物言い」は、私からすれば、ある種の告解の機会だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "今の言葉については、むしろ祝福と捉えたい……それは、私が真の意味で目的地に辿り着いたということだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ふふっ、面白い回答ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アルトリアは背を向けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "でも、誰もがラテラーノの「真実」や「意味」にそこまで執着しているわけではないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "少なくとも、私からすれば何の魅力もないものだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "さっき、少しだけその一端が見えたけれど、扉の向こうにあるのは……機械よね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "だったら、その答えはきっと退屈なものでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ツヴィリングトゥルムでの出来事を思い出してみて、フェディ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あれと同じ規模の災厄が、今も都市を襲っているのよ。人々はその中で迷い、もがき苦しんでいるでしょう……ラテラーノには今、耳を傾けるべき心の声が何百万と存在するの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アルトリア、ここで背を向ければ、迷宮内の敵に一人で立ち向かうことになるのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "どのみち、あの連中を引き付けてくれる囮が必要になるわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたは守護銃を失っている以上、防衛手段を持たないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あるいは、私の音楽で彼らを聴衆に変えることならできるかもしれないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "心配しないで、フェディ。私も、ラテラーノが危険分子に認定した人間なんだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "現状評価、危険度「高」。生存確率「低」。執行人の判断により……彼女を解放します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ふふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "時間は待ってくれないわよ、二人とも。振り返る気がないのなら、お別れはいらないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "それじゃあまたね、私の愛しい弟くん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "はぐれ者のサンクタ",
      "text": "……つまり、教皇庁の手助けをしろっていうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "素晴らしい理解力だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "はぐれ者のサンクタ",
      "text": "お断りよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "ええ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "はぐれ者のサンクタ",
      "text": "私たちに、そんなことをする義務はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "はぐれ者のサンクタ",
      "text": "ここにいる人たちの半分は、教皇庁によってラテラーノを追放されてるのよ。堕天か、あるいは鉱石病が原因でね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "はぐれ者のサンクタ",
      "text": "それでもう半分は、自分からラテラーノを離れた人なの。失望していたり、疑いを抱いていたり……具体的な理由はそれぞれだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "えっ、じゃあどうしてこんな時に戻ってきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使",
      "text": "理由に心当たりもないのに、光輪が急に砕けたからよ。そのくらいわかるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使",
      "text": "私たちはもうラテラーノの人間ではないの。少なくとも、異端者と言える存在よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使",
      "text": "自分から離れたにせよ追放されたにせよ、この都市とは縁を切ってるの。だけどそれから何年経とうと、街が変われば私たちにも影響が出る。いつまでもいつまでも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使",
      "text": "*ラテラーノスラング*、このクソッタレの光輪のせいで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "聞く限り、公証人役場の執行人を総動員したって、君たちのクレームには対応できなさそうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使",
      "text": "だから、私たちはケジメをつけるために戻ってきただけなのよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "君たちに、何かを救ってほしいなんて言ったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "堕天使",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私も、ある任務中にうっかり堕天しちゃってね。そのあとレガトゥスになったのも、ラテラーノに居続けなくて済むからっていうのが主な理由なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "この国からすれば、私だって異端者なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "だから、君たちの気持ちは誰よりもわかってるつもり。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "はぐれ者のサンクタたち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "もしかすると、君たちがここに戻ってきたのは、光輪の異常がラテラーノへの負の感情を増幅させたせいかもしれないね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "どうあれ、恨みや、苦痛や、失望を理由に戻ってきたのなら……なおさら、私と一緒にあの隊列を止めに行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "だって、君たちの苦痛の元凶はあの隊列の中にいるんだから。爆弾でも銃弾でも、好きな手段であいつらに思い知らせてやるといい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "はぐれ者のサンクタ",
      "text": "……そうやって言いくるめるのはやめて、モスティマ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "おっと、バレちゃったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "まあでも、何かはしてみようよ。せっかく帰ってきたんだし、ね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "ちょっと、ヌエダ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヌエダ",
      "text": "何でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "この路地を真っすぐ進んだら、適当に空き家を探して隠れててちょうだい。一人でそんなにたくさん子供を連れてたら、動き回るのは危険よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "この場所なら、隊列の進行方向からはだいぶ距離があるし、怪物も来ないはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヌエダ",
      "text": "パティアさんたちも、ラテラーノを救いに行くのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "ふん、求道者ってのはそんな高尚なものじゃないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "だけど、あたしたちの先導者がこの災厄の最深部に踏み込んでいった以上、黙って見てるわけにはいかないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "向こうは大勢を伴っては行けない場所だって話だし、こっちはこっちでやれることをやらないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "シスター、あんたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヌエダ",
      "text": "私は子供たちを守ります。この子たちがどこの出身であろうと関係ありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祝福を受けた生き物たち",
      "text": "（焦るような祈りの声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "啓示の石塔の鐘が鳴り止んだと思ったら、あちこちでこいつらがブツブツ何か言ってるし……ほんっとうるさいわね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "どんなに宣伝されたって、あなたたちの光輪なんかいらないわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祝福を受けた生き物たち",
      "text": "（焦るような祈りの声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "チッ、どんどん増えてる……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "フィアメッタ！　三秒あげるから、そこを離れて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "三秒！？　ちょっと、そんなのどうやって――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "どう？　結構速かったでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……みんながみんな、あなたみたいに素早く動けるわけじゃないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "まあいいわ。前方の状況だけど、相当悪いわよ。啓示の石塔の鐘も鳴らないし、エクレシエン区は完全に陥落したと見てよさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "隊列がミカエレオン区に入るのも時間の問題よ……あの化け物が一歩歩くだけでバリケードを踏みつぶせるなら、公証人役場の防衛設備も大して役には立たないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "道を封鎖するだけじゃダメね。もっと破壊力のある手段がないと、足止めにすらならないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "同感。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "それで、あなたが呼んできた援軍は？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それじゃ、始めよう、みんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "きっとみんな、銃工房へ行くなり、公証人役場へ行くなり、何かの用事でミカエレオン区には来たことあるよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "堕天使の大半は、ラテラーノを追放される直前に、ここで守護銃を返却したかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "だとしたら、それぞれの銃工房の前に立ってる、銃を構えた聖像は見たことあるでしょ……ああ、公証人役場の入り口前にも、大砲を構えたやつが二体置かれてたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ちょっと待って。そもそも、私たちにあの聖像の射撃機能を扱う権限なんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そこはレミュアンが何とかしてくれるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "みんな、この聖像を全部引き倒して、持ってる銃を街道のほうに向けさせるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "銃声なんてもう何年も聞いてないでしょ？　その分ここで取り戻そうよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うっそ、キミの皮膚って弾丸まで防いじゃうわけ？　とんでもなく分厚いんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "持ってる銃を全部試したのに、傷一つ付けられないなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "こんな気持ちにさせられたのはボスとゲームやってた時以来だね。あの人、裏でゲームをいじって難易度最大にしてきてさ、おかげで一晩かけてもクリアできなくて……心が折れるとこだったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "心が折れる、と言いますが、私には見えていますよ。たとえ光輪が砕けようとも、揺らがぬあなたの在り方とその感情が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "我が子よ、私の肩の上に立ち、この光景を見てみなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "啓示の石塔から、ミカエレオン区の公証人役場まで、道沿いに明かりが灯りつつあります……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "新たに生まれた同胞たちが、この都市を少しずつ照らしているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "遥か昔の、あの旅の時と同じように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "真なる故郷のために、我らはどこよりも険しい峡谷と、どこよりも痩せた荒野を越えて、眠れる銀色の山脈を追い求めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "あの時とただ一つ違うのは、此度は主が眼前におられると確信していることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "救済は必然の結末であり、ラテラーノが闇夜に沈むことは永遠にないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "我が子よ、今のラテラーノに残された唯一の選択は、前へと進むことなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "それでもあなたは、たった一人でこの隊列を、種族すべてを、都市全体を止めようと言うのですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "やっと聞こえてきた！　この音聞くと安心するね。ラテラーノはこうでなくちゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ねえ、あたしがほんとに一人ぼっちなら、今の爆発音はどこから聞こえてきたのかな？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "誰が一緒に戦ってくれてるかは知らないけど、怪物の相手は向こうに任せておこうっと。こうなれば、あたしのやるべきことは……\n徹底的にキミとやり合うことだけだからね！"
    },
    {
      "type": "dialogue",
      "speakerName": "「聖徒」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "キミの言う災厄って何？　未来って何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "一体どうして、キミたちのしてることこそ救済だって、唯一の選択だって断言できるわけ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "ええと、助けに入るべきでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "必要ないじゃろう。彼女からすれば、手のかかる子供のやることでしかないからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "それで、隊列の行進を妨害しとるのは誰じゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "モスティマとフィアメッタが、ラテラーノへ戻ったばかりの人々を率いて動いているようです。アンドアインとフェデリコたちの行方は現状掴めません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "……フィア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "またしても、親しい身内と敵対することになろうとは……世は無常と言ったところじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "パトリツィオ殿、大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "おぬしは自分の役目に集中せい、ヴェルリヴ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "祝福を受けた生き物たちとの繋がりは確立しました。彼らには道を示してあります。我々の共感はますます強まり、もはや共感と呼ぶのも憚られるほどになりつつありますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "総主教——いや、聖徒閣下が仰られたように、それが共感の持つ本来の力なのじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "あの方が見せてくださった光景は真実だったということですね。災厄は確かに存在しており、ラテラーノを救うには、こうした過激な方法を取るほかない、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "ですが今は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "何しろ、夢が崩壊してしまったからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "混乱は避けられぬが、あくまでそれは一時的なものに過ぎん。今は前に進むのじゃ。立ち止まることなどもはや許されぬのだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "とにかく聖徒を確実に大聖堂までお送りせねばならん。さすれば、中断された「降誕の儀式」も再開できよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "今ならまだ間に合う。より良いラテラーノを築き上げ……我々を縛る問題すべてを解決することができるはずじゃ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "未知の通信",
      "text": "（ジッ——ジジッ——）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "どうされました？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "未知の通信",
      "text": "久しぶりだな、ジジイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "未知の通信",
      "text": "動かないほうが身のためだぞ。私はもう、お前の喉元に狙いを定めているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パトリツィオ",
      "text": "久しぶりじゃな……アウレラ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "大聖堂最深部、迷宮の最奥で、最後の扉がフェデリコとアンドアインへと開け放たれた。\n扉の奥、中央にあるプラットフォームの上には、リング状の冷たい機械が鎮座している。その内部から放たれる奇妙な赤い光が、はっきりとした機械音を伴って、部屋の隅々を照らしていた……\nそれは「演算」の足跡だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "教皇聖下？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "プラットフォームの下には、老人が静かに立ち尽くしていた。\nその目は固く閉じられており、法衣には分厚い埃が積もっている。フェデリコとアンドアインが近づいても彼は何の反応も示さず、目も耳も持たぬ岩礁のように微動だにしない。\nただ……\nひび割れた唇だけは、まだかすかに震えていた。何かを呟いているようだったが、何一つ聞こえてはこなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴァンジェリスタⅪ世",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "現教皇、イヴァンジェリスタⅪ世は、神の前に沈黙していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "明らかな失語症と神経退行症状が見られます。現状の判断では、教皇聖下は体力、精神ともに崩壊寸前の状態にあると考えられます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "都市全体を覆っていた夢が崩れ去ったにもかかわらず、なぜ聖下はいまだ目覚めていないのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "彼もまた、我々と同じ目的でここに来たのかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "だが、今も求める答えを得られていないのだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "「適格者」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "君は聖徒だからだろうか？　しかしなぜ私まで……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "教皇聖下はこれまでに、私の聖徒という身分について何度か言及なさいましたが、そのたびに言葉を濁されていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あるいは、聖下自身も聖徒の本当の役割を理解していなかったのかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ですが、法が我々を「適格者」と見なし、明確な役割を与えるのなら……聖徒であるか否かにかかわらず、我々は法に対する責任を果たすべきです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "機械音声が部屋の中に反響する。一定の速度で安定的に再生されるその声には感情の起伏はなく、性別さえ判然としなかったが、言い知れぬ威圧感があった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "私は結局、これに答えを求めることになるのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あるいは、答えを求めているのは向こうのほうかもしれません。私たちは「特殊個体」であり、「サンプル」だそうですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "現状評価、状況は「未知数」。リスク評価「未知数」。執行人の判断により……実行いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人のサンクタはイヴァンジェリスタⅪ世の横を通り過ぎ、共に冷たい機械へと、二つの光るポートへと歩み寄っていく。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
