  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/main/level_main_08-03_end.txt",
  "sourceHash": "91747cdda09a1ee5022c1bb2d6b4c635a1e224e7a9819f413c7ffd7f87ede276",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "感染者監視隊",
      "speakerId": null,
      "text": "うわあああああああ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者監視隊",
      "speakerId": null,
      "text": "うぅ……ああああ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "タルラ！　あなた――うっ……！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "この火はあなたが？　あいつらはあなたが燃や……きゃあっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "アリーナ、すまない。これが村にとって、大きな災いになることはわかってる。でももう耐えられないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "こんなの……もう耐えられない。"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "……アリーナ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "これまで見たことのない目つきで自分を見るアリーナに、タルラはたじろいだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "あなたの瞳の中には炎が宿っている……"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "あなたがここに来た時からわかってたわ。この村でおとなしくしているわけがないって。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "あなたにはあなたの元いた場所、いずれ帰るべき場所がある……あなたはこの村には収まらないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "私には帰る場所などない。そんな目で私を見ないでくれ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "でも、あなたの瞳の中には確かに炎が見えるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "その炎で燃やしたいものがあるんでしょう。すべて間違ってると思いながら、耐えて、耐えて、限界まで耐えて……"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "でもそれが今であるべきじゃなかったわ、タルラ。今じゃないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "村人たちは何も悪いことしてないのよ。衝動的な怒りの炎じゃ、彼らも傷つけてしまうだけよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者監視隊",
      "speakerId": "avg_npc_082",
      "text": "一体何が――あぁっ！？　何が起きた！　誰だ？　誰がやった！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "speakerId": null,
      "text": "タルラ！　タルラ逃げて……逃げなさい！！　戻ってきちゃダメ！　絶対に戻って来るんじゃないよ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "おばあさん",
      "speakerId": null,
      "text": "陛下、どうかあの子を……私の娘をお守りください！　生き延びさせてください。あの子に幸せな人生を歩ませてやってください！！"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "タルラ、行きましょう！"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "ダメだ！　……くそっ、監視隊の奴らめ！"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "私たちは感染者だけど、村の人たちは違うの！"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "私たち？　アリーナ……一体何を――"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "私もそうなのよ、タルラ。私も……感染者なの。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "ハァハァ……ここが……村が移動する予定だった場所よ。場所の整地はもうほとんど済んでる……でも……"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "みんなは……爺さんは……"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "あの人たちを……二度と同じような目に遭わせたくない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "おじいさまは、あなたと私――そして村の人たちを助けようとしてくれたのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "でもあなたは……そんなおじいさまの心遣いを、全部台無しにしてしまったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "何を言っているんだ？　そもそも村人の誰かが密告を――"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "……いや待て。つまり、爺さんを密告したのは――"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "そう……おじいさま自身よ。あのままいけば、監視隊はあれ以上調査を行わなかった。それで終わりにできたかもしれないのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "あなたにどんなに力があっても、監視隊には対抗できない。"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "私にならできる。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "じゃあ、その後は？　憲兵が来たら？　都市の駐屯軍や貴族の私兵たちが来たらどうするの？"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "今はまだ力不足なだけだ。時間をかけて力さえつければ――"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "いや違う、そうじゃない。力不足だろうが、問題はすぐ目の前で起きているんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "目の前の悪行から目を背け、自己の保身だけ考えろというのか？　それこそ違う！"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "……そんな自己中心的で冷酷非道な行為は、やつらと同罪だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "犠牲ありきの正義は、本当に正義と呼べるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "……その質問に私は答えられないわ。その答えを見つけ出すのは、あなたよタルラ。私知ってるもの、あなたが私よりたくさんの本を読んでいるって。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "ともかくもう既に村では死人が一人出てしまった。これ以上犠牲者を増やすわけにはいかないわ……"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "あなたは賢い。あなたならいつか答えを見つけられるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "行きましょう、タルラ！"
    },
    {
      "type": "dialogue",
      "speakerName": "タルラ",
      "speakerId": "avg_npc_078",
      "text": "……私は必ず帰ってくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "アリーナ",
      "speakerId": "avg_npc_079",
      "text": "そうね、タルラ。そう自分に言い聞かせてあげて。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
