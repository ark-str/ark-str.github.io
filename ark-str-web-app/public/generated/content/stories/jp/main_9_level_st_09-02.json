{
  "server": "jp",
  "storyId": "main_9_level_st_09-02",
  "groupId": "main_9",
  "stageId": "st_09-02",
  "title": "灰燼に散る詩",
  "storyCode": "9-8",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_st_09-02.txt",
  "sourceHash": "594dd0eaebb1eedc7d15e3df3f3e61f4a2c8582ac34f2c044fa1979349ccab0c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "リーダー、例の者を確保しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "わかった。連れてきて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "一体何なの！　は、放してちょうだい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "ヴィクトリア軍に集会の情報を流したのは、キミ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "えっ？　どうして、それを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "待って！　あ、あなたは……あなたがあの人なの！？　編集長たちが噂していた、あの……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "彼らが言ってたみたいに、革命をもたらし、私たちを率いて抑圧者を追い出すなんてこと、本当にあなたにできるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "いいえ、そんなはずない……あなたがもたらすのは死よ……私たちの故郷を廃墟にするつもりでしょ、ちょうど今やったみたいにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "すべての元凶は、あなたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "私がもたらすのは、勝利だけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "そして、キミ……シアーシャ・ケリーは、私たちの同胞がキミにおいた信頼を裏切り、深く傷つけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "キミの裏切りによって、多くの志士が敵の牢獄に繋がれてしまうところだった。それによって、無数の戦士が勝利の栄光を逃すことになるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "だからキミは、その行いの責任を取らなければいけない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "彼らが死んだのは、私のせいですって？　本当にそうなのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "昨晩、あの屋敷に集まった人たちのほとんどは、あなたを歓迎したくて待っていたのよ。あなたがより良い変化をもたらしてくれると信じていたから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "だけど彼らは今や、街と同じように灰になってしまった。まさかこの火を放ったのが、私だとでも言いたいの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "黙れ、裏切り者め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "貴様のような軟弱者が、烈士の決意を理解できると思うな！　彼らは皆、敵の手に落ちて屈辱を味わうくらいならと、胸を張ってリーダーの炎を迎え入れたのだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "ターラー人の幸福のために……彼らは、戦火の犠牲となるよりほかになかったのだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "さあ、判決を！　リーダー、彼女を死刑に！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……死刑？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "当然よ。戦士たちの怒りを鎮められるのは、裏切り者の死だけなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "それに――周りの地元の奴らを見てみなさい。近付きたいけど近付けない、って感じでしょ。あれはあたしたちとあんたを怖がってるからよ。つまりこれは彼らを徹底的に服従させるチャンスなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "この裏切り者を殺せば、ダブリンを裏切った奴は皆死ぬんだってことを連中に教えてやれるってわけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "そうすれば、誰も……裏切れなくなる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "シアーシャ・ケリー。裏切りの結末を、考えたことはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "きっと私は……死ぬんでしょうね。でも、後悔はしないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "私は、家族や友人を救いたくて行動したんだもの。それで殺されるなら、私の行いの正しさが証明されるだけ――誰かが止めないと、もっと多くの人があなたのせいで死ぬことになるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……勇気があるんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "聞き間違えじゃないわよね？　あんた今、裏切り者に向かって勇気があるとか言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "彼女も、同胞だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "「元」同胞よ、彼女が邪魔した瞬間からね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ねえ、こんなふうにグダグダ話したところで無意味でしょ？　そもそも、ここにいるのがあのお方だったらこんな質問しないわよ。死ぬと決まった奴の言葉なんて聞くべきじゃないもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……「あなたのお姉さんだったら、どうする？」\nみんな同じことを聞いてくる。\nだけど……私は、そうやって考えるのが嫌い。ずっとずっと大っ嫌いだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "さっさとやりなさいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "こんなに大勢が見てるのよ。あんたがチンタラやってると、あたしたちが軟弱な集団だと思われるわ。ビビリのリーダーが率いる軟弱な部隊なんかに、誰がついてくると思うの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は、私に選択肢など与えなかった。\n同胞を殺すのは初めてじゃない。最初に殺したのは、私たちにパンを売ろうとしないヴィクトリア人の商人だった。私は言われるままその人を焼き殺そうとしたのだ。あれは、私がいくつの時だろう？\n今となっては、どうやったのかは覚えていない。その時の私は目を閉じて、ナイフを両手で握ったはずだ。だが、その刃が突き刺さったのは、焦げ臭い灰の山だった。\nそれからというもの、灰はどんどん増えていった。目の前にいるこの子のように、勇気ある人ほど、灰になるのは早かった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……シアーシャ・ケリー。ダブリンの「リーダー」の名の下に、キミを死刑に処す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "刑は今ここで、私自ら執行する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "……私は死ぬのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "リーダーさん。きっとあなたを止められる人はいないだろうし、私の家族も結局は、死ぬのでしょうね。……最後に教えてくれるかしら。私たちが勝つ未来はあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "私たちターラー人が、もっと良い生活を送れる日は来るのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "来る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "そう。ならいいわ。少なくとも今この瞬間は……喜んでそれを信じましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "ほかに、言っておきたいことはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "火……あなたの槍の先に、火が見えたわ。焼け死ぬ時って、痛いのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "……ううん、やっぱり言わないで。聞きたくないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "……一つお願いがあるの。私の両親に伝言を……もしも、すべてが終わった後二人が生きていたら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "隠していたんだけど、枕元にあるタンスの三段目にお金が入っているの。来月はお母さんの誕生日で、花束を買おうと思ってたから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "伝えておいて。「ごめんね」って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "ええ、約束する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "……死にたく、ないなぁ。怖いよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シアーシャ",
      "text": "……はぁ、春が来たら、焼けてしまった大地にも、柳の木が芽吹いてくれるかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "ダブリンの……ために！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "この言葉は……数え切れないほど口にしてきた。\nけれど、言葉にするたび、胸の辺りが焼けるように痛んでかき乱される。手に握っているはずの槍が、私の身体に突き刺さっているかのように。\n私は何度も、何度も自分に言い聞かせてきた。――命は容易く燃え尽きる。彼らはみんな燃料に過ぎないのだ、と。\nそして……それは、私自身も同じことだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……ハハ、死んだわ。ま、こんなところね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "裏切り者が処刑されたことを、全員に通達しなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "もしも、また密告者が現れたら……そいつは、あいつみたいな燃えかすになるってこともね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "はっ。了解しました、上官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "で……あんた、今日は一体どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "随分グズグズやってたじゃない。戦士たちからすれば、リーダーが裏切り者にほだされたように見えたと思うけど？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ちょっと、本当にほだされたわけじゃないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "今更、たった一人の人間なんかに？　だってあんた、昨日は通りを一気に焼き払っていたじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "やっと「リーダー」らしくなってきたと思ってたのにね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「らしくなってきた」？\n私には分からない。ずいぶん長い間、自分がどう見られているのか気にしてこなかった。\n彼女の姿、彼女の口調、そして彼女の炎。子供の頃からずっと、私が見ていたのはこれだけだ。\n彼女は、私にも同じように在ることを望んでいた。だけど私にはできなかった。彼女の炎の影に隠れるしかない運命だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "うわ……こいつ、またぼーっとしてんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "この表情見てると、顔の真ん前で叫んでやりたくなるのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あら、嫉妬？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "冗談やめてよ。この顔で頭の中まで空っぽでーすって表情されると不愉快ってだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "リーダーはなんでこいつを、こんな立場に置いてるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "生まれ持った顔がなかったらゴミ同然じゃない。裏切り者の処刑さえ満足にできやしないのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あぁ、だからあなたが代わりにやったのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "彼女は気付いてないけど、私の目にははっきり見えたわよ。あの女の子が焼かれる前に、見えない石錐で胸を貫かれてたところ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "そうよ、だって我慢できなかったのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "金も力もある支持者たちを苦労して集めたのに、あの恥知らずな裏切り者のせいで、みんな死んだり逃げたりしちゃったのよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "へえ？　あなたにもまだ憐れみなんてものがあったなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ハンッ……そんなんじゃないわよ。肉獣レベルの連中でも、ちょっとは役に立ってから死ぬべきでしょ？　それがあっさりと全員灰になって、ムカつくったらないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あっさり死んでくれただけ、よかったかもしれないわよ？　あなたが欲をかいて余計な計画を立てたおかげで、危うく私たち全員が道連れにされるかもしれなかったんだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あっ……あたしは、リーダーとダブリンのためにやったのよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんただってこいつは相応しくないと思ってんでしょ？　こいつが人を連れてこなくたって、あたしならヒロック郡を掌握できてたわよ。ううん、掌握するだけじゃない、もっと上手くやれてたはず！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "リーダーが、あたしをもっと信頼してくれたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "「相応しくない」？　そうね、あなたの言う通り。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "人間、目の前の物事にはちゃんと向き合った方がいいものよ。身の丈に合わない地位ばかりを追ってちゃいけないわ。さもないと、足を踏み外して身を滅ぼすことになるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんた……あたしに説教してるわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ふふっ、まさか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "さあ、いつまでも彼女にイラついてないで、もう行きましょ。次はどう動くべきかを話し合わないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "「略奪者」、「放火魔」、「会計官」、「劇薬学者」、「囚人」、それと「雄弁家」ね。昨日の夜、全員に連絡しておいたから、今頃みんな到着してるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "今や市庁舎は私たちのもの。要人や貴族たちも、多くが私たちの支配下にある。でも、まだ不十分だわ。リーダーが到着する前に、ヒロック郡を完全に制圧しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "そんなに噛んだら、爪がなくなっちゃうわよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "うっさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "あとでネイルを塗ってほしい、なんて泣きついてこないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "はぁ！？　あんたに泣きついたことなんかないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……あたしは、ほかの奴に手柄を譲りたくないだけなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "はいはい、わかってるわよ。あなたは最初期からずっとリーダーについてきたメンバーなのよ？　もっと視野を広く持ちなさいな。たかだかヒロック郡くらいで、こんなに振り回されてみっともない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんた、それって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ここでの仕事が終わったら、リーダーには彼女の代わりにロンディニウムへ行ってくれる誰かが必要になるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "そういうことは早く言いなさいよ！　ほら、急いで！　あと半日でヒロック郡を攻め落とすわよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "誰もが皆、心の中に自分自身の欲望を持っている。どんなに強烈な炎でも、それを焼き尽くすことはできない。\nなら、私の望みは？　「ただ隠れていたい」、それだけ。\nでも、影に、逃げる権利なんてあるの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "リーダー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "アルモニ様が、会議へお越しいただきたいと仰っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "それは……重要な要件？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "アルモニ様は、「本当に来たくないようなら、あなたの意向を尊重する」と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "尊重？　上手い言い回しね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "戻って伝えて。すべて計画通りに進めて、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "みんなやるべきことはわかっているし、私が何か言う必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "考え事をしたいの。キミの部下たちにも、余計なことをせず持ち場を守るように伝えておいて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士",
      "text": "はい、リーダー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……少しだけ……こうして、いよう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーダー」",
      "text": "これは……何？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "私は、廃墟に落ちた一枚の紙に目を引かれた。\nその紙はボロボロで、四隅は既に焦げていた。手に取れば紙の半分は灰となり、そこに書かれた文字もまた、半分しか残らなかった。\n「何を落胆することがあろうか」\n「大火は大地を焼き尽くしたが」\n「一人の魂が、両天秤のもう一方にあるのを見たのだ」\n始まりが失われた、一編の詩。\nそれを綴る文字は、書かれて間もないうちに――インクが自然と固まる前に、炎に焼かれて乾いていた。\nそう、私の炎で。\n私の、魂は……"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
