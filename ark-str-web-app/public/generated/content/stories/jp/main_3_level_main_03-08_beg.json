{
  "server": "jp",
  "storyId": "main_3_level_main_03-08_beg",
  "groupId": "main_3",
  "stageId": "main_03-08",
  "title": "たそがれ",
  "storyCode": "3-8",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/main/level_main_03-08_beg.txt",
  "sourceHash": "9cf25879dcb25fa0b9a7d5057314084052c2269afd5c9ab19c07840cf13b0437",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "ぐっ……あいつら、まだ反撃してくるぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "だが、それでも……今、奴らを撃退することができたら、勝利は俺たちのものだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "だよな、スカルシュレッダー！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "ああ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "だから今は……戦い続けるだけだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "こいつら……少々厄介ですね！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "うっ……！　くそ、なんなんだよあの盾は……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "……そうか、奴があの……近衛局の……！"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "――今ならまだ間に合う。武器を捨て、降伏しろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "無駄死にしたくないのなら、な。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "ハッ、どうせ俺たちを騙すつもりなんだろ！　誰がお前の言葉なんか信じるかってんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "ウルサスでも、そういう説得で降伏を選んだ感染者は確かにいた。だがその後、そいつらは一人ずつ、やがては全員が処刑されていったんだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "そうして、俺はその死体の山に紛れて、なんとか生き延びた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "だから、よくわかってるのさ。お前らは、俺たちを根絶やしにするために……どんな卑劣な手段でも使ってくるってな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "どうせお前も、俺らを皆殺しにするのが目的なんだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "だったら、とことん戦い抜いてやろうじゃねえか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "そこの大きいお姉さん。残念だけど、何を言っても向こうさんには届かないと思うわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "だってあの連中、龍門の良い人と、ウルサスの悪い人の区別もつかなくなっちゃってるもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "ウルサスでは――っていうか、大概の場所は同じようなものだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "非感染者と感染者の間には、お互いへの憎しみのほかに何もないのが普通だからでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "なるほど。交渉は難しい、ということですね。……道は目の前に開かれているというのに。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "「道」？"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……それを選んだとして……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "私たちに……そしてあなたたちに、何ができるっていうの？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "あんな奴と話したところで、時間の無駄だ！　一気にかかるぞ、スカルシュレッダー！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "――爆撃か？"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "speakerId": "char_015_lmg",
      "text": "向こうの人員が、散開しました！　こちらを取り囲むつもりのようです！"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "speakerId": "char_010_chen",
      "text": "防戦一方では両翼が持たん……反撃に出るぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "俺がカバーする！　あいつらを倒して、この戦いを終わらせよう！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "頼むぞ、スカルシュレッダー！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "ああ……俺は必ず、皆と一緒に……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "そうだ――絶対に！！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "speakerId": "char_010_chen",
      "text": "時間がない！　行動するぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "speakerId": "char_010_chen",
      "text": "ホシグマ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "準備はできていますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "speakerId": "char_136_hsguma",
      "text": "慎重に動け。奴らに隙を見せるなよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "speakerId": "char_136_hsguma",
      "text": "もちろんですとも！"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "speakerId": "char_015_lmg",
      "text": "ッ、奴らが突撃してきます！　ご注意を！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "アーミヤ！　近付きすぎよ、下がって！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "――やっぱり……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "あそこに、いるのは……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……ドクター……私は一体、どうすれば……"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……君の為すべきことをするんだ、アーミヤ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "っ、ですが……"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "……ごめんなさい、ドクター……私……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スカルシュレッダー",
          "speakerId": "char_1500_skulsr",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "スカルシュレッダー",
          "speakerId": "char_1500_skulsr",
          "text": "……あ……"
        },
        {
          "type": "dialogue",
          "speakerName": "スカルシュレッダー",
          "speakerId": "char_1500_skulsr",
          "text": "アーミヤ……？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "どう、して……"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "……あなたが……？"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "なぜ……こんなことに……"
        },
        {
          "type": "dialogue",
          "speakerName": "スカルシュレッダー",
          "speakerId": "char_1500_skulsr",
          "text": "……きっと、こうなる運命だったんだよ。"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "何をしている、アーミヤ！　早く――"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "……私、は……"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "……ッ……"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "チェン、隊長……？"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "――もう十分だ。"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "こうなっては……"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "ここで、始末をつけるしかない。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "……そんな……"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "……一つ、忠告をしておこう。"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "これからはすべての感染者を敵だと思ったほうがいい。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "――運命は不公平なものだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "恨むのなら、私を恨め。"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "speakerId": "char_010_chen",
          "text": "――近衛局、総員に告ぐ！　攻撃開始！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
