{
  "server": "jp",
  "storyId": "main_3_level_main_03-08_beg",
  "groupId": "main_3",
  "stageId": "main_03-08",
  "title": "たそがれ",
  "storyCode": "3-8",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_03-08_beg.txt",
  "sourceHash": "9cf25879dcb25fa0b9a7d5057314084052c2269afd5c9ab19c07840cf13b0437",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ぐっ……あいつら、まだ反撃してくるぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "だが、それでも……今、奴らを撃退することができたら、勝利は俺たちのものだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "だよな、スカルシュレッダー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "だから今は……戦い続けるだけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "こいつら……少々厄介ですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "うっ……！　くそ、なんなんだよあの盾は……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "……そうか、奴があの……近衛局の……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "――今ならまだ間に合う。武器を捨て、降伏しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "無駄死にしたくないのなら、な。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ハッ、どうせ俺たちを騙すつもりなんだろ！　誰がお前の言葉なんか信じるかってんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ウルサスでも、そういう説得で降伏を選んだ感染者は確かにいた。だがその後、そいつらは一人ずつ、やがては全員が処刑されていったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "そうして、俺はその死体の山に紛れて、なんとか生き延びた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "だから、よくわかってるのさ。お前らは、俺たちを根絶やしにするために……どんな卑劣な手段でも使ってくるってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "どうせお前も、俺らを皆殺しにするのが目的なんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "だったら、とことん戦い抜いてやろうじゃねえか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そこの大きいお姉さん。残念だけど、何を言っても向こうさんには届かないと思うわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だってあの連中、龍門の良い人と、ウルサスの悪い人の区別もつかなくなっちゃってるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ウルサスでは――っていうか、大概の場所は同じようなものだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "非感染者と感染者の間には、お互いへの憎しみのほかに何もないのが普通だからでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "なるほど。交渉は難しい、ということですね。……道は目の前に開かれているというのに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "「道」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "……それを選んだとして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "私たちに……そしてあなたたちに、何ができるっていうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "あんな奴と話したところで、時間の無駄だ！　一気にかかるぞ、スカルシュレッダー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "――爆撃か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "向こうの人員が、散開しました！　こちらを取り囲むつもりのようです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "防戦一方では両翼が持たん……反撃に出るぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "俺がカバーする！　あいつらを倒して、この戦いを終わらせよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "頼むぞ、スカルシュレッダー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "ああ……俺は必ず、皆と一緒に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "そうだ――絶対に！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "時間がない！　行動するぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ホシグマ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "準備はできていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "慎重に動け。奴らに隙を見せるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "もちろんですとも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ッ、奴らが突撃してきます！　ご注意を！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "アーミヤ！　近付きすぎよ、下がって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――やっぱり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あそこに、いるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……ドクター……私は一体、どうすれば……",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……君の為すべきことをするんだ、アーミヤ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "っ、ですが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ごめんなさい、ドクター……私……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スカルシュレッダー",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカルシュレッダー",
          "text": "……あ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカルシュレッダー",
          "text": "アーミヤ……？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "どう、して……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……あなたが……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "なぜ……こんなことに……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカルシュレッダー",
          "text": "……きっと、こうなる運命だったんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "何をしている、アーミヤ！　早く――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……私、は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……ッ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "チェン、隊長……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "――もう十分だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "こうなっては……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "ここで、始末をつけるしかない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……そんな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "……一つ、忠告をしておこう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "これからはすべての感染者を敵だと思ったほうがいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "――運命は不公平なものだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "恨むのなら、私を恨め。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "チェン",
          "text": "――近衛局、総員に告ぐ！　攻撃開始！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
