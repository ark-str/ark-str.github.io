{
  "server": "jp",
  "storyId": "act14side_level_act14side_02_beg",
  "groupId": "act14side",
  "stageId": "act14side_02",
  "title": "鎮静化",
  "storyCode": "BI-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act14side/level_act14side_02_beg.txt",
  "sourceHash": "48d2d4a48ac3ffa651e27adc035ba2190d000beff9ac9f9e79c03c86bb86faa1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "帰ってくるなり家の手伝いだなんて、ララはほんとに親孝行よね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "そんなことないよ。別に普通のことだし、私だって体を動かしたいからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "はぁ……やっぱり外へ留学するような子は偉いわね。うちの弟なんかとは人間の出来が違うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "こんなにいい子がお隣に住んでたってのに、残念ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "引っ越した先にも、あなたみたいな子がいればいいんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "えっ、ササ姉さん引っ越しちゃうの？　ここでの暮らしに、不満でもあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "全部父さんのせいよ。昨日の三家会議で、巫女様に三大名家を管理させるって発表があったでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "それで、うちの父さんったら張り切っちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "あっ……ゾルおじさんはずっとエンシオディス様の開放政策に反対してたもんね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "そうなのよ。うちは私と弟の仕事の都合で北の方から引っ越してきたでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "数年過ごすうちに、父さんもここに慣れてきたはずだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "でも昨日の主権奉還の話を知った途端、そりゃもう大喜びで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "夕食の間、ここ数年のエンシオディス様の政策に対する文句をずっと言ってるもんだから、私もイライラして喧嘩になっちゃったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "だからといって父さんには逆らえないわ。それでペイルロッシュ家の領地に戻るかもしれないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "じゃあ弟さんの仕事は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "わからないわ。そもそも今回の主権奉還後、トゥリクムで今まで通り商売をやっていいのかどうかも知らされてないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "ペイルロッシュの人から聞いた噂じゃ、元々巫女様は前回の三家会議でもエンシオディス様に谷地と鉱区を引き渡すよう要求してたらしいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "巫女様がイェラグを管理することになったら、エンシオディス様はもう幅を利かせることはできないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "……そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "でも、それもいいかもよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "あなたはここ数年外にいたから知らないでしょうけど、三大名家は最初はうまく協力し合ってたのよ。でも最近になって、だんだんと険悪になってきてるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "前回の会議の後なんか、みんな戦争が始まるんじゃないかってヒヤヒヤしてたくらいなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "……そうなんだ。でもまさかエンシオディス様が譲歩するなんて……しかも巫女様に権力を譲るなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "ホントにね。でも私は、もっと早くにこうすべきだったと思うわ。うちの今の商売はエンシオディス様の開放政策ありきだから、政策自体が嫌な訳じゃないんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "でも、時々老人たちが言うように、イェラグが本来のイェラグじゃなくなっちゃったように感じることも確かにあるのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "だからあのエンシオディス様が事を荒立てないために譲歩を決めたことには、みんな驚きつつも賛成してるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "隣人",
      "text": "反対するのはあなたのお兄さんのような頑固者だけね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "兄さん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "ただいま。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラの姉",
      "text": "はぁ、ホントおバカさんね。ちゃんと休みなさいって言ったのに、なんで働いてるんだか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラの姉",
      "text": "（小声）その石がどうとかって病気、あなたは平気でも、こっちは心配なんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "大丈夫だよ、姉さん。これくらいの作業はなんてことないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "あれ、兄さんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラの姉",
      "text": "工場に行くって言って、さっき慌てて出てったわよ。今日は帰ってこないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "工場？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "隊長？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "隊長、どうかしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "休暇は終わりだ、オーロラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "昨日、ドクターが駅でペイルロッシュ家の奴らに連れて行かれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "えっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "いや、連れて行かれたと言うよりも、自ら進んで付いていったと言うべきだな……つまり、俺の言ってる意味がわかるだろ。何か考えあっての行動だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "周辺の地図をざっと見た限りじゃ、駅からペイルロッシュ家までは少し時間がかかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "今頃、ドクターはペイルロッシュ家に到着しているはずだ。俺たちも動くぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sharp",
      "text": "俺はお前の家を訪ねるという口実でそちらに向かい、お前と合流することにしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オーロラ",
      "text": "……まずは合流、っと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラ",
      "text": "なるほど、あなたがそのロドスの人だったのね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "知らなかったのか。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "それを知って訪ねて来たのではないのか。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "そうよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "あなたはとても独特な雰囲気を持ってるけど、でもそれが何なのかはわからないのよね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君が市場で言っていたのは、どういう意味だ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "ああ、あれ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "ちょっとした忠告よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "ほら、今のあなたは見ず知らずの人たちに監視されて、外をぶらつくことすらままならなくなっちゃってるでしょ？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君は何を知っている？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "その質問に答える前に、まずは教えてくれる？　あなたがイェラグに来た目的は何？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "カランド貿易との業務提携。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "つまり、あなたはエンシオディスのお友達ってこと？",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        },
        {
          "label": "クリフハートのために兄妹の関係修復に手を貸す。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "旅行。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "状況による。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "興味深いわ――あなたのような余所者の目に、イェラグという地はどんなふうに映っているのかしら？",
              "portraitKey": null
            },
            {
              "type": "sceneBreak"
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ここはとても平穏だ。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "平穏……そうね。ここはもう千年以上平穏よ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "でも平穏は停滞をも意味する。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "イェラグの人々は、長い間この状態に慣れ過ぎてしまったわ。外で何が起きているのか気にもせず、興味もなくなるほどに。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "これは良いことであるはずよ。でも最近私はね……はぁ……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "信仰心にあふれている。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "イェラガンドへの信仰は、この土地の人々が一つにまとまるための基盤だもの。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "でも、たまに人々は少し信仰に頼り過ぎてるんじゃないかって思うことがあるわ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "あなたに理解できる？　悩みを神に訴え、神が解決してくれることを期待する。そして──",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "自分の意志で変えていくべき状況に出くわしても、神意を停滞の口実にする。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "自分の両手で耕して得た収穫であっても、神の寛大さのおかげだと感謝しなければならない。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "本当に決断し、努力したのは、自分たちなのに……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "時代遅れだ。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "ずいぶん無遠慮なのね。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "でも、あなたのような外から来た……新しい言い方だと、「外国」の人は、ほとんどがそうした印象を抱いているわ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "外国の人たちは楽をするための――良く言えば、手間を省くための技術を、早くからたくさん開発してきた。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "あなたたちにとっては、そういう便利な生活が当たり前になっているけれど、イェラグの大多数の人々は未だにそれらに触れたことすらない。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "もしかしたら、イェラグに住む人々は、便利さに欠ける生活の中で勤勉さや勇敢さを鍛え上げ、享楽とかけ離れた環境の中で信仰と美徳を身につけるのかもしれない。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "でも、それが永遠に在るべき形だとは私も思わないわ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "イェラグ人はこの雪山に安息の地を切り拓いたけど、伝統に頼るだけで故郷を堅固に維持していくことなんてできるのかしら？",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "あなたから見て、イェラグは変化すべきだと思う？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "思う。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "はぁ、やっぱりあなたもそう思うのね。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "先見の明がある人々は皆、エンシオディスがもたらした変革を止めることはできないとわかっているのよ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "自分の生活をより楽で便利にしてくれるものを、簡単に拒絶できる人なんていないわ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "一概に論じることはできない。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "私はてっきりあなたも、「後進的な物事はすべて変えるべきだ」とでも言うんじゃないかと思っていたわ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "多くの人がそう語るのを聞いてきたから。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "しかも、そういう人のほとんどが、この地で生まれ育ったイェラグ人なのよ。",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "判断できるほどこの地を理解できていない。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "慎重なのね。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "でも、慎重な人は嫌いじゃないわ。",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "イェラ",
              "text": "だけど残念ね。あなたがこの国の現状を理解するために残された時間は、恐らくもういくらもないわよ。",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それで、君は何を知っている？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "私は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "私にはある友人がいるの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "その友人は、どうすればこのイェラグを良くしていけるかをずっと考えている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "でも、どれだけ考えても答えは出ない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "彼女は次第に、皆が自分とは違う考えを持つことに気付き始めた。それらの考えは、たとえどんなものだろうと、彼女を不安にさせてしまうの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "彼女が何かをしたいと思っても、それをしようとするたびに、誰かに反対されてしまう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "そしてそれとは逆に、そういう人たちがやろうとしていることを、彼女では止められなくなってきていることにも気付いた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "そんな時に、あなたがやって来たというわけ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それが何かの予兆だと思っているのか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "予兆……というよりも、ワラにもすがる気持ちと言った方が合っているかもね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "エンシオディスの招待を受け、異国からやってきた者……あなたの放つ光と息吹に、私は不思議なほどの新鮮さと神妙さを覚えた――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イェラ",
          "text": "教えて、異邦人……あなたの来訪は、いったい何を意味するの？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "まずは、君に手伝ってもらいたいことがある。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "まったくお姉ちゃんったら……こないだ手紙をもらったばっかりなのに、まるで久しぶりに手紙を寄越したみたいな書き方しちゃってさ……いっつも心配してばっかなんだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "ヤエルお姉ちゃん。いつもお姉ちゃんの手紙を届けてくれてありがとう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "いいのよ、巫女様は好き勝手に下山できないから、私が代わりに外の情報を持ち帰っているだけよ。これも巫女様の望みだもの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "でも、ごめんね。今は返事を書いてる余裕はないんだ。ちょっとほかにやらなきゃいけないことがあって。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "そのバッグ……どこか出かけるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "そうだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "どこへ行くの？　ユングフラウに登りにでも行くのかしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "あっ、たしかにまだユングフラウには挑戦できてないね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "でも今回行くのは、谷地だよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "谷地？　あそこは蔓珠院に譲渡するんじゃないの？　それにあそこは工場ばかりよ、何しに行くの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "ドクターがそこにいるから会いに行くんだよ……あっ、そういえばヤエルお姉ちゃんにはまだドクターを紹介してなかったよね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "ああ、噂は聞いたわ。ペイルロッシュ家に連れて行かれたあの客人のことでしょう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "うん。ドクターはあたしのお客さんだし、無事を確認できないと落ち着かなくてさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "あなたったら、本当にいい子ね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "でも気を付けなさいね。あのあたりは最近、あまり治安が良くないらしいわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "うん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マッターホルン",
          "text": "エンシアお嬢様、もう出発できます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マッターホルン",
          "text": "ご心配なく。今回の外出、すべての責任は俺が負いますので。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "ヤーカおじさん、よろしくね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "マッターホルン",
          "text": "エンシアお嬢様が、珍しく真剣な眼差しで助けを求めてくださったんです。力を貸さない道理などありませんよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エンシア",
          "text": "ヤエルお姉ちゃん、もしかしたらしばらく帰ってこれないかもしれないから、お返事はまた今度ってお姉ちゃんに伝えといて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "わかった、待ってるわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "情報は限られているが、なんとかドクターの状況を判断せねばな……オーロラ、イェラグ人であるお前の意見を聞かせてくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "うーんと、まずノーシスっていうのは鉱区と谷地の前責任者で、今とても微妙な立場に追い込まれてるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "それで、ノーシスの代わりにエンシオディス様が新しく置いた責任者──それがドクターだね。だからアークトスはドクターを警戒しているんだと思う。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "鉱区と谷地が複雑な状況にある理由も詳しく教えてくれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "えーっと……地図があれば説明しやすいんだけど……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "イェラグの地形はそれほど複雑じゃなくて、細かく区分されてるわけでもないんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "私たちイェラグ人は、地形に基づいてそのまま各所を鉱区、谷地、林地、湖区、山区、渓地、平原って呼んでるよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "渓地と平原、そして大半の湖区は北部のペイルロッシュ家の領地。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "西部のブラウンテイル家は、林地を中心とした領地を持っていて、湖区の一部も領地に含まれてる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "シルバーアッシュ家は主に山区、あと谷地と鉱区を領地として持ってる。湖区はほとんどないかな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "その谷地と鉱区は……実はシルバーアッシュ家の領地の半分近くを占めてるんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "その中でも、鉱区はシルバーアッシュ家にとってかなり重要な領地だよ。イェラグ全土で消費される鉱石のほとんどがここで産出されてるからね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "それから、谷地が発展し始めたのは最近だね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "元々、谷地はとてもやせ細った土地で、村だって少ししかなかったから、ずっと価値がない土地だと思われてた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "でも、エンシオディス様はカランド貿易を設立すると、谷地を工業用地に選んで――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "それでカランド貿易のほとんどの製造工場がここに建てられた。しかも、その一部はカランド山のすぐ近くに建設されてるよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "あと、出発前にイェラグの商人たちと情報交換をしたんだ。ここで商売してる人はみんなカランド貿易と関わりがあるからね。その人たちが言うには――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "一ヶ月前、巫女様合意のもと、ブラウンテイル家とペイルロッシュ家が工場の安全リスクを調査する部隊を組織したらしいんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "でも協力を拒んだノーシスが裏から手を回して部隊を襲撃させた。その情報がどうやって表沙汰になったのかはわからないけど、この事件には間違いなくノーシスが関係してるってみんな思ってる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "そして、ペイルロッシュ家の当主であるアークトスが、蔓珠院の命を受けて谷地に兵を送り込むことになった。一方ノーシスは今回の過激な行為の責任を取る形で解雇されたんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "会議の時に、ドクターがエンシオディスからの招待を受けた理由を説明していたが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "鉱石病関連施設の建設についてカランド貿易に協力するとは言っていたが、ドクターがそのノーシスとやらに代わって何かを管理するなんて話は、全く聞いていないぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "つまり、ドクターは自ら陰謀の天秤に乗っかったわけだ。まったくドクターらしいな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "たぶんそういうことだと思う。でもドクターは、カランド貿易とロドスの良好な関係を踏まえて、今回の招待を受けたんだと思うよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "今のところ、エンシオディス様がドクターを陥れようとする理由なんてまったく思いつかないよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "それでどうするの？　ケルシー先生に連絡する？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "ロドス本艦はヴィクトリアに向けて航行中だ。俺たちが持ってきた端末だけでは連絡がつかない。大型通信基地局でもあれば別だが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "（深いため息をつく）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "隊長……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "しばらく観察したが、今ドクターがいる場所の警備は、それほど厳重というわけではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "ペイルロッシュ家の邸宅にはおよそ二百人の衛兵がいるが、装備や練度はいずれも外の正規軍ほどではないから、奇襲で十分突破できる。周囲の地形も確認済みだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "あるいは潜入作戦も考えられるのだが、その場合、事前に複数のポイントに爆弾を仕込む必要がある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "侵入および撤退時に爆破によって注意を引くためだが、いくつかの壁の構造は──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "隊長、ちょっと待って！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "ん？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "まだ……そこまでするほどの状況じゃないと思うんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "どんな状況だろうとドクターの安全を確保する……それが俺の任務における最優先事項だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "……それには私も同意するよ。でも──",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "大典が近づいてるこのタイミングで、ペイルロッシュ家の領地内で武力行使なんてことをしたら、カランド全体への宣戦布告だって思われちゃうかもしれない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "もしそうなったら、ロドスにいるイェラグのオペレーターたちは、どうすればいいの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "俺は常に最悪の事態を想定し、万一のための解決策を用意しておく必要がある。この芳しくない状況で選択を迫られれば、ドクターを選ぶしかないというのはわかっているだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "俺たちは皆、事態がそこまでに至らないことを願っている。だが、俺たちにその決定権はない。いいか？　俺はドクターを無事にロドスへ連れ帰る責任を負っているんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "私は……エンシオディス様には何か考えがあるんだと思う。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "相手の計画にあえて乗ったということは、多分ドクターはその何かに気付いて、すでに対応する準備ができてるんだよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "ああ。俺もドクターの能力を疑ったことはないし、ドクターを信じている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "だが事前に準備は必要だ……ドクターは俺に待機を命じた。ならばドクターの計画には俺たちの役割もあるはずだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "じゃあまずはドクターに連絡を取らないとね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "オーロラ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "ん？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "お前はエンシオディスを尊敬しているんだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "……うん。エンシオディス様がいなければ、イェラグから出て外の大地に触れる機会なんて絶対なかったから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "気持ちはわかる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "だがそれは一旦忘れろ。今から、お前は彼を仮想敵と見なすんだ。できるか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "もしできないなら今すぐ帰ってもらう。別にお前を責めはしない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "わかった……私はロドスの一員でもあるから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "その言葉を忘れるなよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "はい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オーロラ",
          "text": "でも……クリフハートたちも警戒しなきゃいけないの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "俺はクリフハートのことは信じるが、エンシア・シルバーアッシュのことまで信じるつもりはない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "ではどうやってドクターにコンタクトを取るか考えるぞ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "あなたたちがドクターの部下かしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "（斬りかかる）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "瞬きをする間もなく、鋼の刃が走り、女性の頸部まであとわずかというところで止まった。"
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "へぇ……その剣術、珍しいわね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "……何者だ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "それより、会ったばかりのか弱い乙女を相手に、よくこんな恐ろしい仕打ちができるわね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sharp",
          "text": "この場所を特定し、その上この状況で冗談を言えるような奴が、か弱い乙女だと？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "まずは刀を下ろしなさい。ドクターからあなたたちに会いに行くよう頼まれたのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヤエル",
          "text": "あなたたちに伝言があるわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
