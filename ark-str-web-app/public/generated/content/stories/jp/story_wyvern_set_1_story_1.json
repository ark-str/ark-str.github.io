{
  "server": "jp",
  "storyId": "story_wyvern_set_1_story_1",
  "groupId": "story_wyvern_set_1",
  "stageId": null,
  "title": "オリジムシとホップ",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_wyvern_1_1.txt",
  "sourceHash": "6f43cfed3df4718ed20cf1a64c7ce6172425673ac098b32004eb628abb92e328",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "a.m. 7:40 天気/曇天\nカジミエーシュ某村郊外"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "そういえば、バニラさん。ずっと気になってたことがあるんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "ドスグロちゃんって、普段何食べてるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "あの子は好き嫌いがないので、野菜やお肉を少しあげるだけで喜びますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "餌をあげていれば大きく成長するんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "もちろんです！　飼い始めた頃は手のひらサイズでしたけど、今はもうこんなに――そうだ、もし良ければ今度会いに来てください、とっても可愛いですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "えっと、聞いた話ですが、プロヴァンスさんとスカイフレアさんが任務でシエスタへ行った時、超巨大な――小高い丘ほどの大きなオリジムシに遭遇したらしいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "なにやら現地の……黒曜石？　とかいう石を食べて、大きく成長したみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "オリジムシの体の大きさは確かに生育環境によってかなり差異が出るようですが、小高い丘ほどの個体はさすがに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "ドスグロちゃんも黒曜石をあげ続けていれば、いずれはそれくらい大きくなったりしますかね。もしそれにまたがって出陣できたら、とてもカッコよくないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "チャードさん――そんなことは、絶対にさせませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "（うっ、バニラさんの目つきが……なんか急に険しくなった！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "あ、到着したみたいですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "確認してみますね！　地図の方向は、大丈夫。村の名前は……ロックヴィル村、これも合ってますね。はい、ここで間違いないようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "一見何の変哲もない、普通の村ですね。どういうことでしょう。変異どころか、ここに来るまで、普通のオリジムシすら一匹も遭遇しませんでしたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "でもクルビアの怪物映画って大抵こういう始まり方だった気もします……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "（映画……って、スクリーンの上で画面が動くあれのことかな？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "そうですね……オリジムシはありふれた生き物ですので、道中で全く見かけなかったのは少し変です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "どうしましょうか。先にここら一帯を回ってみます？　それとも依頼人を待ちますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "……あっ、待ってください。なんかすごくいい匂いがしません？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "この匂いは……嗅いだことがあるような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "ホップの匂いだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "そうでした！　たしか任務概要に、この村の主要産業はビール製造と書いてありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "こういう場合、お土産を持って帰ってもいいですよね？　ケルシー先生だって、あとから何も言いませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "いいえ、チャードさん。まずは任務に集中してください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "出発前にドーベルマン教官が口を酸っぱくして言ってたじゃないですか、この任務は非常に重要だって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "このレポートを見てみろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "これは……オリジムシが人に重傷を負わせたうえ、村に侵入して田畑を荒らしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "先日、ロドスは近辺の病院から移送された負傷者数名を収容した。彼らは皆同じ村の出身で、負傷原因はどれもオリジムシによる襲撃だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "村人たちは負傷者の治療のほか、我々にオリジムシ問題の解決を希望している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "病院は彼らの鉱石病感染を懸念してロドスへ移送してきたが、幸い怪我だけで、感染はしていなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ですが……術師に操られでもしない限り、野生のオリジムシは人間を襲ったりしません。ましてや人の住む集落に侵入するなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……きっと何か特別な原因があるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "村人によれば、村を襲ったのは、極めて大きな変異オリジムシだそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "変異オリジムシ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "詳細は不明だ。だが村人たちは、孤立無援の状況下で我々に助けを求めてきた。このまま見て見ぬふりはできん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "そこで、お前を調査に派遣したい。もちろん他のオペレーターを補佐として同行させる予定だが、任務中の具体的判断はすべてお前に任せる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ですが教官、本当に私にオリジムシ関連の任務を担当させるおつもりですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "いいかバニラ。これは何もお前に対する試練などではなく、深刻な問題を解決するために、お前の知識と能力が必要なのだ。僥倖に頼ろうなど思わないことだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "お前なら適切に処理できると信じている、オペレーター・バニラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "は……はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "（まさか、リスカム先輩やフランカ先輩のように、私が任務をまるごと担当することになるなんて。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "（ドーベルマン教官が信頼してくれてるんだ、絶対に失望なんかさせられない！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "（もしちゃんと任務を達成できなかったら、きっとお給料を全部引かれて、ドスグロちゃんまでお腹を空かせるはめに！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ですので、チャードさんも真面目に対応してください。任務が完了するまで、絶対に気を散らさないこと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "わ……わかりました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "（なんでいきなり厳しくなったんだ！？）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "すまんが、お二人がロドスの職員の方ですかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "はい！　こんにちは！　……あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "わしがここの村長じゃ。ロドスに連絡をしたのもわしじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "はぁ、やっと来てくださいましたか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "えっ、もしかしてすでに何か取り返しのつかない事態に――なってるようにも見えませんが……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "とりあえず、わしについてきてください……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "これは……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "つまり……この広い農園の惨状は、すべてオリジムシによるものということですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "それは、一ヶ月ほど前のある晩のこと。農園から助けを求める声を村人が聞きつけました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "皆が急いで行ってみると、その晩に森林警備をしていた者が倒れていました。全身傷だらけで虫の息、農園もこのありさまで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "その者は、丸々三日経ってようやく目覚めましてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "彼が言うには、あの晩、農園で物音がして、泥棒と思って近づいてみれば、十数匹のオリジムシがいたそうじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "ちょっと待ってください。夜で、しかもこんなうっそうとした林の中で、オリジムシが何匹いたかなんてわかりますかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "彼はこう言ったんじゃ――小さいのでも人の背丈くらい、大きいのだと小屋くらい大きかったと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "えぇ……いよいよ怪獣ホラー映画ぽくなってきましたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "あの、その人が見間違えたってことはないんですか？　実は何か別の野獣だったとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "噛み跡から見るに、確かに一般的なオリジムシの大きさをはるかに超えているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "バニラさん……これほど大きなオリジムシを見たことありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "そうですとも、初めは誰も信じませんでした。村の若いもんが自ら調査隊を結成し、裏山の林に調べに入りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "皆でしばらく探索したんじゃが、今度こそはっきりと、ありえないほど大きなオリジムシを目にしたのじゃ……調査隊は襲われ、何人も重傷を負った次第。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "それ以来、皆気軽に村を出られなくなったのじゃ。一方でオリジムシが村に侵入し、人を襲う事件はいまだに時々起こる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "わしらは都会の方にも救援を求めましたが、貴族のお偉いさんたちがこんな小さな村を相手にするはずもない……負傷者がロドスへ送られた時、初めてあなた方のような会社があることを知りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "はぁ……本当に助かります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "安心してください、村長さん。私たちが全力で問題を解決します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "お聞きしたいのですが、事件以前に、村にオリジムシが現れたことはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "全くないわけじゃないが、たまに一、二匹のオリジムシが畑に侵入してホップを盗み食いする程度で、それも人が来たらすぐ逃げたもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "あんなにも大きく、しかも人を襲うオリジムシなぞ、一度も見たことがないのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ということは、村の周囲にはずっとオリジムシが生息してたんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "村の外の林は、地形が複雑で、中に何がいるかわしでもよく知らんのじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "それから、近頃村で何か変わったことはありませんでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "と、おっしゃいますと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "例えば、村に不審な人は来ませんでしたか？　それか、突然の気候変動などは？　思い出してみてください、どれも重要な情報です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "強いて言えば、三ヶ月ほど前に、村で唯一のビール工場が倒産したことくらいかのう。まさにホップを他の町へ運んでいる最中に、オリジムシに襲われた者たちもおりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "手がかりになりますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "村長さん、他のオリジムシが現れた場所にも連れて行っていただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "ええ。ついてきてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "あれ？　あそこの人たちは何をしてるんです？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "これは、オリジムシの死骸……？　こんなにたくさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "お前たち！　やめなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "少女",
      "text": "パパ――！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "村長、いいところに来たな！　悪の元凶を見つけたぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "野次馬村人",
      "text": "道理でどこを探しても捕まえられないはずだ。オリジムシはコイツが全部家に匿ってやがった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "野次馬村人",
      "text": "ヤバすぎだろ。まさかこんなものを村の中で飼ってる奴がいるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……あなたたちがこのオリジムシたちを殺したんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "村長、みんなが証人だ。コイツをしっかり処罰してくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "ゴホッゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "私のオリジムシはもう、君たちが全部殺し尽くした。これ以上どうするつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "どうするつもりだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "どれだけの人がお前の虫に噛まれたと思ってるんだ。感染者になる可能性だってあるんだぞ。それに作物の被害だって――俺たちは、お前がここに居続けることを許さない。家族もろとも出て行け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "お前らみたいな奴は、外で野垂れ死ね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "野次馬村人",
      "text": "そうだ！　ロックヴィルを出て行け！　死んじまえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "私のオリジムシがやったんじゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "しらを切る気か？　ならオリジムシを飼って何をするつもりだったか言ってみろよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "なぜ教える必要がある？　まさか、君のビール工場が倒産したのも私のオリジムシのせいにする気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "んだとこの*カジミエーシュスラング*――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "やめんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "説明してくれ。このオリジムシたちは一体どういうことじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "……酒作りに使うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "私もたまたま気づいたのだが、オリジムシはホップを食べると特殊な液体を分泌する。それをビールに入れると、ビールの風味が良くなるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "他の人に教えて、この方法を広めようとしたこともあるが、みんな私がおかしくなったと言うんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "へぇ、そんなこともできるんですね。それはぜひとも飲んでみたいものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "確かに、故郷にいた頃、通りすがりのキャラバンがそんな話をしていたのを覚えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "おい、あんたら誰だ？　余計な口を挟むなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "この方々はわしがお呼びした鉱石病の専門家で、事件の解決を手伝いに来てくださったんじゃ。失礼は許さんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "こちらのお兄さん、ちょっと落ち着いて考えましょうか。このサイズのオリジムシがどう噛めば人に大けがを負わせられるんです？　あんなに大きな農園をかじり壊すには、数年はかかりますよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "それに、調査隊は村の外で変異オリジムシを見つけたじゃなかったんでした？　なのに、なぜご近所さんのペットなんかを目の敵に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "けっ、人よりも大きな変異虫なんざ、俺はこの目で見てないしよ。調査隊の者はみんな入院しちまったし、いくらでも作り話ができるわけだ、信じられるかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "こういう鉱石病の虫なら何かのアーツを持ってる可能性だってあるんだろ？　そんな薄汚いものを飼ってる奴、ロクでもないこと考えてるに決まってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "汚くなんかありません！　オリジムシは鉱石病に感染することもないんですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "――？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "オリジムシは、たしかに源石成分を含む甲殻を持っていますが、その体内には源石結晶は絶対にありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "これについては多くの生物学者が研究をしてきました。原因はいまだはっきりしませんが、自然環境下で鉱石病に感染したオリジムシは今まで一匹も見つかっていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ましてやオリジムシに噛まれて鉱石病に感染するなんて、ほとんどありえない話です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "そんな根拠のない話で無実の人に罪を着せないでください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "誰が信じるかよ！　あんたの言ってることだって本当かどうか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "村長さん、もう少し時間を頂けませんか。私たちがこの件をはっきりさせるまで、どうかこの方をむやみに責め立てないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "む、いいだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "それからもう一度村の外を調査させてください。田畑を荒らしたオリジムシたちは、恐らく村には留まらないと思うんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "村長",
      "text": "もちろんじゃ。ただ、村の外の山林は道が入り組んでるからのう。あなた方だけでは道に迷ってしまうかもしれませんなぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "それなら、俺が同行してやろうじゃないか。こいつらの言う変異オリジムシっていうのが一体どんなものか、俺も見てみたいからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "はい、ではお願いします。あまり時間がありません、すぐに出発しましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "だめですね。林があまりに密集しているせいか、オリジムシの姿が全く見当たりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "ふん。あんだけ確信持った物言いをするもんだから、さぞや凄いお方かと思ったのによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "あんたらも意地を張るこたァねぇぜ、さっさと引き上げな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "あっ、後ろに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "ひぃっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "……って、何もねぇじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "はっ、大口叩いてるくせに、本当は怖くて仕方がなくて、絶対に遭遇したくないって思ってるんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "なっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "二人とも落ち着いてください。喧嘩してる場合じゃありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "実際、人間がオリジムシを怖がるのと同じように、オリジムシも人を怖がってますから、普通は居住地に近づいたりしないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "人間に出くわしたとしても、普通は自ら逃げます。だから村の近くでは活動しないはずです。私たちは村を出たばかりですから、オリジムシが見つからないのも当然です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "それで、今回の事件についてはどう考えますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "常識的に考えて、野生のオリジムシの群れに突然攻撃性が現れたとしたら、最も可能性が高い原因は生息環境の急変です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "そういった状況なら、普通は正しく誘導をすれば、暴走したオリジムシの群れを落ち着かせることができるはずですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "具体的に何が起こったのかを知るためには、やはりまずは林の中でオリジムシが元々住んでいた場所を見つけなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "でも、この広大な林の、一体どこを探せばいいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "うーん……そうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "オリジムシたちが頻繁に村に出入りしているなら、その活動範囲は相当広いと言えます。であれば、くまなく探せば見つかるはず……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "やっぱりありました！　チャードさん、ほら！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "これは……野生のホップ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "はい！　見てください、この辺のホップはまばらに生えています。自然に育ったわけではなさそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "村長さんの話からすると、この辺りのオリジムシはホップを好むはずです。それでオリジムシがホップの実を食べ、消化されなかった種が至る所に散らばるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "つまりホップの生えてる周辺が、オリジムシが活動していた場所ってことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "確定はできませんが、可能性は大です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "さすがバニラさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "そ……そんなことありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "おい、あの小娘と歩き回ってもう随分経つが、あんたらの言う変異オリジムシってのは一体どこだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "……あっちを見てみな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "よせよ、もうその手は食わない――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "（弓を引く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "お前がなんと言おうが――ひぃっ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "待ってください、チャードさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "敵意はないようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "（じっと見つめる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "こちらに気づきましたね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ほら、去って行きましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "ふぅ……びっくりした。あのデカさだし、一発で倒せなかったらどうしようかと思いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "おい……どうしてあの虫を逃がした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "攻撃してこなかったんですから、わざわざこちらから刺激する必要はないですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "ふざけるな！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "あんたらが今殺さなきゃ、ソイツは俺らの作物を荒らし、人を襲うかもしれないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "あれは私たちが探している変異オリジムシとは違います……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "こちらに気づいても、襲ってはきませんでした。ということはその習性は普通のオリジムシと同じで、自ら人間の活動場所に近づきはしないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "そうだとしても――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "必ず全力で村の危機を解決するとお約束します。ただ現状では、罪のないものは見逃してもらえませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "ふん……その言葉、忘れるなよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ありがとうございます、チャードさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "いえいえ。俺はバニラさんの判断を信じていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "あなたのいう方法で探したら、見事オリジムシが見つかりました。オリジムシに関してはもはや専門家ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "「専門家」は大げさですよ。私はただオリジムシについて少し詳しいだけです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ヴイーヴルにいた頃、ああいった動物をよく見かけました。その頃から、そうした生き物たちも他の動物と同じで愛すべき命だと思っていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "戦場でオリジムシを前にしてためらうと、いつもドーベルマン教官に叱られます。自分でも良くないとわかってるんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "でも戦場の外では、できることならあの子たちを救ってあげたいんです。何の罪もない命ですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "ほら、元気出してくださいよ。俺はバニラさんが正しいと思ってますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "さすがにオリジムシじゃないけど、俺も小さい頃にペットを飼っていました。だからそういう気持ちはわかります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "今度機会があれば、バニラさんが飼ってるドスグロちゃんにも会いたいなーなんて、ははは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ほ、本当ですか？　それはもう、ぜひ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "ん？　あそこに洞窟が見えませんか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "あそこは……たしか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "なんてことだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "こ……これは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三人は洞窟の入り口に近づいた。\n黒みがかった黄色の源石廃棄物が洞窟を半分ほど埋め尽くし、その上に虫の卵がびっしりとくっついている。\n更に奥の暗がりで、赤い光が明滅している。規則正しく呼吸をしているようで、ぼんやりと見えるその輪郭は、どれも驚くべき大きさだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "う……嘘だろ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "黙れ！　おとなしくしてろ。あいつらに気づかれたら終わりだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "バニラさん……どうしますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "バニラさん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ひとまず、ここを離れましょう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "源石廃棄物については、各国で処理規程が異なります。ですがこれは……どこにおいても間違いなく違法ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "すみません、あなたは村のビール工場で働いていたんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "工場が潰れた後、源石廃棄物が山に投棄されたことは知っていましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "俺じゃない……俺がやったんじゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "いや、オーナーが俺たちにそうしろって言ったんだ！　こんなことになるなんて知らなかったんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "おい、お前ら！　何ぼうっとしてるんだ？　早く虫を殺せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "あ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "どうして当たり前のように言えるんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "あの子たちは元々ただここに住んでいただけなのに、あなたたちが居場所を奪ったんですよ！？　自分たちが間違いを犯しておいて、そのうえ人に殺させようとするなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "バニラさん、落ち着いて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る村人",
      "text": "なんなんだよ……ただの虫だろ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ただの虫……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "生き物を変異させておいて、今度は残酷にも殺せだなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ことの真相が判明する前にも、身勝手に周りの人を傷つけて、しかも「野垂れ死ね」などと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "命の生死を決めるのは、そんなに簡単なことなんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "バニラさん、落ち着いてください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "チャードが止めていなければ、バニラは自分がどれほど強い力でハルバードを握りしめていたか気づかなかっただろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……すみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "この話は後にしましょう――それよりこの状況、どうしますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "もう……どうしようもありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ごめんなさい、私たちがもっと早く来ていれば……あなたのオリジムシたちを、死なせずに済んだかもしれないのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "謝らないでくれ。汚名を晴らしてくれた、それだけで十分感謝しているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "あの男性から伝言があります。さきほどはすまなかったと……今後は二度とあなたにぶしつけなことはしないそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "はぁ……秘伝のレシピで作ったビール、飲みたかったなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "ははは、残念だったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "誤解が解けたならもういいさ……だが事件が解決しても、みんなオリジムシに対してトラウマを抱いているだろうし、私ももう迷惑をかけたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "誠実な村人",
      "text": "だけど、いずれまた誰かがあの「秘伝のレシピ」にたどり着くさ。君もいつかオリジムシを使って作った酒に出会えるかもしれない。その時はしっかりと味わってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "はは、よく覚えておきますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少女",
      "text": "お姉ちゃん、外には本当に変異したオリジムシがいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……安心してください。もう別の場所へ行きましたから、これから村を襲うことはありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少女",
      "text": "本当？　前にみんなが村の外には怪物がいるって言ってて、とっても怖かったの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "怖がらなくて大丈夫ですよ……オリジムシたちも、本当は怖かったはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "オリジムシたちは怪物ではありません。私たちと同じで、この大地で頑張って生きている生き物なんですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少女",
      "text": "うん……そうだお姉ちゃん！　はい、これ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "これは……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少女",
      "text": "あの人たちがうちに押し入ってきた時、一匹だけ隠したの……一匹しか隠せなかったけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "少女",
      "text": "私も飼えなくなっちゃったみたいだから……お姉ちゃん、引き取ってくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "……任せてください、私がしっかりとお世話をします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ありがとう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "爆弾、設置完了しました。あとは起爆するだけです。洞窟全体を完全に破壊できます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "ですが……バニラさん、本当にもう他の方法はないんですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "村を襲撃したのは、明らかにこのオリジムシたちです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "このような源石環境に長くいたせいで、体内まで変異しています。急激に巨大化しただけでなく、とても攻撃的になっているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "具体的な原因ははっきりしませんが、詳しく研究する時間もありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "放っておけば、いずれ周辺の村をすべて破壊するでしょう……だからこうしなくちゃいけないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "バニラさん、大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "チャードさん、起爆装置を貸してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャード",
      "text": "なにもあなたが押さなくても――はぁ、わかりました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ごめんね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "うーん……保温箱、飼料、水……全部ドスグロちゃんと一緒だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ここがあなたの新しいお家だよ、ようこそ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "わっ、また増えたの？　さすがはバニラちゃんね、外勤に出るたびにペットを拾ってきて……こんなにたくさん飼っちゃって、本当にケルシー先生から許可をもらえたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "もちろんです。ドスグロちゃんやトゲオと同じく、この子もちゃんと登録してきましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "なんだかここはそのうちオリジムシ博物館になっちゃいそうね……それで、この新入りさんはなんて名前なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "ドスグロちゃんより丸っこいので、マルコにしたいと思います。ドスグロちゃん､トゲオ、マルコと仲良くしてね。絶対にいじめちゃだめだからね……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "バニラ、あなた、泣いてるわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "えっ……そんなこと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "グスン、大丈夫です……うっ、フランカ先輩……私、今回は逃げませんでした！　私、やりきりましたよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バニラ",
      "text": "う……ううっ……うわあぁぁん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
