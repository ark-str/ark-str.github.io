  "stageId": "a003_03",
  "title": "徒競走",
  "storyCode": "OF-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act3d0/level_act3d0_03_end.txt",
  "sourceHash": "d4ee41b315d1cece9d63e55ee14f7d4cb112a0dfaabfc6da7991d6614e5c025b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛A",
      "speakerId": null,
      "text": "あああ熱い！　焦げちまう！"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛B",
      "speakerId": null,
      "text": "うわ！　俺の髪が！"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛A",
      "speakerId": null,
      "text": "チッ、撤退、撤退だ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "speakerId": "char_134_ifrit",
      "text": "ハハハ、やっぱり喧嘩はおもしれーな、ドクター！"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "speakerId": "char_134_ifrit",
      "text": "あ、そうだドクター、これはオマエを助けるためにやったことだからな。しかも言われた通りちゃんと手加減もしたんだぜ。だからサイレンスには絶対言うんじゃねーぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "speakerId": "char_134_ifrit",
      "text": "もしバレたらまた山程宿題を出されちまう！"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "問題ない。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イフリータ",
              "speakerId": "char_134_ifrit",
              "text": "ヘヘ、やっぱドクターはいいヤツだな！"
            }
          ]
        },
        {
          "label": "宿題は頑張れ。",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "イフリータ",
              "speakerId": "char_134_ifrit",
              "text": "フンッ、知らねぇよ！"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "源石を動力にした火炎放射……しかもこの出力、素晴らしい術師ですわね。"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "おお、姉ちゃん、見る目あるな。オレサマはすげーんだぜ！"
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "わたくしはセイロン。"
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "わたくしたちを救っていただき、感謝いたしますわ。"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "お、おう……別にいいぜ。こ、これはオレサマの仕事だしな。"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "おいドクター、この姉ちゃんって、アレだ。「レイギタダシイ」ってやつだよな。お、オレサマはどうすれば良いんだ？"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "微笑む。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "お辞儀する。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "踊る。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "そうか、じゃあやってみる……。"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "あ！肉を焼いてる途中だった！　悪ぃがオレサマはもう行くぜ！"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "ドクター、それにセイロン、バーベキューを喰いたくなったらオレサマのとこに来るんだぜ！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "行ってしまった。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "ドクター、わたくしたちも急ぎ戻りましょう。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerId": "char_188_helage",
          "text": "ドクター、そしてそこのお嬢さんも無事なようで何よりだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "ご助力、感謝いたしますわ。あの、お名前をお聞かせいただいても……。"
        },
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "speakerId": "char_188_helage",
          "text": "ヘラグだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "speakerId": "char_188_helage",
          "text": "ドクターと同じロドスに所属している。"
        },
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "speakerId": "char_188_helage",
          "text": "ドクター、時間がないところすまんが、貴殿に伝えておかなければならないことがある。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
  "observedOperators": [
