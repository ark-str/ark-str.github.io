{
  "server": "jp",
  "storyId": "act5d0_level_act5d0_02_beg",
  "groupId": "act5d0",
  "stageId": "act5d0_02",
  "title": "7:15P.M.",
  "storyCode": "CB-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act5d0/level_act5d0_02_beg.txt",
  "sourceHash": "5f0cc661411f5539fd9431922029f7431ddce1d9afa0ed940c94418fce5570c4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ゲホゲホッ、みんな生きとるん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "なんとか、防ぎました——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "良い反応だった。二人とも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "やれやれ、もうみんな爆弾好きすぎでしょ。ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "——*言葉になってないペンギンの呻き声*——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "（な、なんや？　ボスがけったいな声出しよるんやけど！？　）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "（ねえ！　さっきの箱に入っていたレコードって、もしかしてボスが闇市で買ってきたクルビアのレアもの？　）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "（ありゃ多分そやな。どないしよ、ボスが虚空を見つめて虚無の表情になっとる……ボスとはもう長い付き合いやねんけど、あんなん見たんホンマ久々やな……。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どないもこないも——って、あっ！　あいつら車乗ってる！　あの黒服の奴ら！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "待ってください！　もし奴らが初めから罠を仕掛けていたとして、どうしてぼくたちを待ち伏せしなかったんでしょう？　この状況は怪しすぎます。ここは具体的な計画を立ててから奴らを追い——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "テキサス！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "乗れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "……お前たち、良く聞け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "今夜のどんな違反の罰金も俺が全部出す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "奴らを俺のレコードの副葬品にしてやれや！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "見えたで。前におる、あの車や！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "エクシア！　俺のバディをかせ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ラジャー！　ボス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "あれは銃！？　でもどうやって引き金を引くんでしょうか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "アハっ！　なかなか見識があるじゃねぇか、坊主。てことで我が社の銃のプロ、解説ヨロシク！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ん～、全四十二層の段ボール板を工業用ボンドでシームレスに接着して、そして高品質ゴムバンドで駆動…ってとこかな。うん、本当に良い銃だね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "……つまりは、おもちゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "要はスリングショットってやつだね。アウチッ！　違いました、平和の銃でしたー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "龍門市街では実弾の使用は許可されていない。ま、表向きのルールなんだけどよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "毎回思うけど、ボスは変なところで律儀だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "もし俺たちがルールを守らなかったら、龍門は銃弾の応酬になるだろうが。そんなの子供でも分かるコトだぜ？　おう、テキサス、車の屋根開けろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "了解。気をつけて。前みたいに信号に衝突しないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "いや、俺そんなに身長あったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "こっちも狙撃準備完了だよ。ボス～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ま、待ってください。道路には他の車もいます。まさか直接——",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "運転手のマフィア",
      "text": "奴ら撃ってきたぞ！　おい、迎撃だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後部座席のマフィア",
      "text": "冗談言ってんじゃねぇぞ。こんな雑な運転でどうやって狙えってんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "運転手のマフィア",
      "text": "お、お前撃たれたのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後部座席のマフィア",
      "text": "血がっ、血が出てる！　早く包帯を寄越せ——いや待て、これはなんだ、ゴム？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "運転手のマフィア",
      "text": "ただのゴムだと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後部座席のマフィア",
      "text": "こんなゴム弾でガラスを突き破ってきたのかよ！　いいから早く奴らを振り切れ。あっ、痛ってぇ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ナイスショット、ボス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "奴らに食らいつけ、テキサス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "スピード上げるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ちょ待って、前にトラックがっ——おわあぁぁぁぁ——。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ええから、黙って掴まっとき。テキサスはんのドライブテクニックはハンパないでぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "おいエク、奴らのタイヤぶち抜け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "りょーかいっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ゴム弾でゴムのタイヤ撃ち抜くんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "なぁに俺らにとっちゃ簡単だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "テキサスさん、止めなくていいんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "（そっぽ向いて）……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "さっき言うたやろ？　「楽しみどきを逃すな」ってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "さぁて、盛大なスピンをしてちょーだいっと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "運転手のマフィア",
      "text": "くそっ、やられた。ハンドルが利かねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "後部座席のマフィア",
      "text": "そんなの言われなくても分かってる！　車から飛び降りろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バイソン",
      "text": "ま、待ってください！　こんなスピードが出ていたら、ぼくたちも巻き込まれちゃいますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あ～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "はいっ、テキサス！　あとよろしく！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "チッ、面倒ばっかりだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
