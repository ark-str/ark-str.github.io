ak"},{"type":"background","backgroundId":"bg_room_2"},{"type":"narration","text":"ケオベの部屋"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うぅ……"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うーん……これでいいのかなぁ？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"お宝のメンテナンス、終わり！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"お宝を入れる袋と、リュックもきれいにしたよ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"あとはお姉ちゃんを待って……"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"早く帰って来ないかなぁ、そしたらクマちゃんの腹ペコの時間が短くなるのに……"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"誰？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":null,"isRemote":false,"text":"私だ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"あ、お姉ちゃん！　今開けるね！！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"お姉ちゃん、待ってたんだよ！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"今日の仕事は順調だったからな、これでも早く帰ってきたんだよ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ところで、メンテナンスの成果を見せてもらおうか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"さっき終わったばっかりだよ。お宝は全部机の上に並べてあるよ！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"よし、見よう。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"……"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（大丈夫！　ちゃんと絵の通りにしたから。）"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（自信あるよ！）"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（間違ってないよ！）"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"ど……どう？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"うん、油が均一に塗ってある。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"（近づいて嗅ぐ）"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"指定した油が指定されたところに使われている。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ふむ……"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"鞘もきれいにしたんだな？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん、そうだよ！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"よし。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"うむ、よくできている。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"ありがとうお姉ちゃん！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"えへへ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"では私は工房に戻るが……一緒に来るか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_corridor"},{"type":"narration","text":"ヴァルカンの工房"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"今回の材料は質が良い。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"材料に恥じない、使い手に満足してもらえるものになればいいのだが……"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（早く言わないと、クマちゃんがまだお腹ペコペコのままだよ！）"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（でも……なんか緊張する、言えない……）"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"……"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"どうした？　何か言いたそうにしているが。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"あっ、うん……えっとね。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"うん。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"お姉ちゃん、おいらにおっきくておいしいクッキーの作り方教えてくれる？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"どうした？　ついに自分で作りたくなったのか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"あっ、そ……そう！　そうだよ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"早く教えて？　クマちゃんがお腹ペコペコで死んじゃう！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"クマちゃん？　……グムのことか？　どうかしたのか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"えっ……うん！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"お昼……そう、お昼にね、お昼にクマちゃんに会ったの！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"それでおいしいクッキーくれたの！　だからお礼したいなぁって。大きくておいしいのを贈りたいの！　でもクッキーなんか作れないし、クマちゃんのお家がどこなのかも知らないから――"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"だから、おいら……"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"分かった。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"お姉ちゃん――"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"安心していいから、落ち着け。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"本当に？　おいらちょっとどうしていいか、分からなくなっちゃって……"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"うん、大丈夫だ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"今から言うことをよく聞くんだよ。いいか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん……"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"グム……クマちゃんの部屋なら知ってる。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"だから、一緒にクッキーを作って、一緒に持っていこう。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"本当に！？　良かった！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ああ。ケーちゃんが作りたいというなら、いつでも教えるよ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！　作りたい！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ちょうどここに少しだけ発酵させた小麦粉がある。大きなクッキーを作ろう。いいか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"どれくらいの大きさがいい？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"とにかくおっきいのがいい！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"なるほど、いいだろう。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ではまず準備をしよう。そこの作業台を片付けてくれる？　その間に私は、炉に火を入れて温めておく。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"よし、これくらいスペースがあれば十分だ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"さて、ケーちゃん。　手はちゃんと洗ったか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"洗ったよ！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"わぁ、これって何？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"これは生のクッキー生地だ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"おいらは何をすればいいの？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"簡単だ。この生地をこねてくれ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"まずは思うままにやってみて。もし間違ってたら私が教えるから。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"……こねる？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"こう、かな？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そうだ。ほら、続けて。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"大丈夫だ。そのまま力を入れてこねるのを続けるんだ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"もうちょっとだ。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そろそろいいだろう。それをプレートに載せて――"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ナイフで、二つに分ける。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"こう？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そうだ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"生地を二つに分けたら、それぞれを伸ばして丸い形にするんだ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そう……そうだ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"今回はオーソドックスな、生地の味を楽しめるプレーンクッキーを作ろう。もっと上手になったら、生地そのものの作り方や混ぜ込むのに適した材料の使い方も教えるよ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"この端のところがまだ平らになってないぞ？　そう、そこだ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"よし、よくできている。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"あとはプレートを炉に入れれば終わりだ。ほら、炉は熱いから手袋をはめて。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"炉の中にある棚に載せるの？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そうだ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"よし――載せたよ！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"クッキーって意外と簡単なんだね。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"あとは何かするの？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"時間を見る。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"あぁ――"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"それが一番難しいや。"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_corridor"},{"type":"narration","text":"10分ほど経過――"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ケーちゃん。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"え？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"もう時間だ。クッキーを出してみよう。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"できたのか！？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ああ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"おおおっ！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うわ！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"危ない！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"まずは手袋をはめて。気を付けて取り出すんだ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"う、うん。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そこのテーブルに置いて。あとはクッキーが手で持てるくらいに冷めたら完成だ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"本当に？　やったー！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（くんくん）"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"いい匂い！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"絶対、おいしいよね？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"ちょっと味見してみるね？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（端を少し割って、欠片を口に入れる）"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"どうだ？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"おいしい！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"やっぱりクッキーはホカホカのが一番おいしいね。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"早くクマちゃんに渡しに行こう？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そういうことなら、木の板で挟んで持っていこう。これで多少冷めにくくなる。ケーちゃんが好きなホカホカで渡せるよ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"今回は私が連れて行くが、次からは一人で行けるように場所も覚えるんだよ？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！　わかった！"},{"type":"sceneBreak"},{"type":"background","backgroundId":"bg_room_2"},{"type":"narration","text":"宿舎エリア\nグムの部屋前"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"さあ、着いたぞ。ここだ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（ノックをする）"},{"type":"sceneBreak"},{"type":"narration","text":"コンコンコン"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"？？？","speakerId":"char_115_headbr","isRemote":false,"text":"入っていいぞ、開いてる。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"（キョロキョロ見渡す）"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"クマちゃん、いる？"},{"type":"dialogue","speakerName":"グム","speakerId":"char_196_sunbr","isRemote":false,"text":"ケーちゃん！　どうしたの？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"いた！"},{"type":"dialogue","speakerName":"グム","speakerId":"char_196_sunbr","isRemote":false,"text":"えっ、グム？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"あのね、クマちゃん。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"お昼にクッキーを貰ったから、お返しに来たよ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"ヴァルカンお姉ちゃんが作り方を教えてくれたの。ほら、できたてだよ！"},{"type":"dialogue","speakerName":"グム","speakerId":"char_196_sunbr","isRemote":false,"text":"うわあ、ありがとう！　でもちょっと……大きすぎるよね？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"そうかな。早く食べてね！　冷めたら美味しくなくなっちゃう。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"じゃあ、ばいばい。"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"どうだった？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"クマちゃん喜んでくれた！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そうか、それはよかった。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"お姉ちゃん。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ん？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"クッキーの作り方、教えてくれてありがとう！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"フッ。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"礼を言われるほどのことでもない。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"それに上手になれば、自分で作って独り占めして食べることもできるぞ？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"いつかは、自分ではちみつクッキーも作れる。好きだろう。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"わあ、それすっごくいい！　食べたい！！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ああ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"でもおいら、やっぱりお姉ちゃんが作ってくれるはちみつクッキーがいいな。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"そうか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"そうだよ！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"フッ、それもいいな。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"戻ろうか、誰も炉を見てないのはよくないからな。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"それに、さっき作ったクッキーがまだ半分残ってるだろう。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"そうだった！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"急いでクマちゃんに渡しに行ったから、味見しかしてないや。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"ああいったシンプルなクッキーを、もっと美味しく食べるには他の材料も必要だ。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"！？"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"例えば……そうだな。　今日のお昼のソースを覚えているか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"あれにつけて食べてみたいと思わないか？"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"思う！"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"なら急ごう。"},{"type":"dialogue","speakerName":"ヴァルカン","speakerId":"char_163_hpsts","isRemote":false,"text":"それに、私もいささか腹が減ってきた。"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"うん！"},{"type":"dialogue","speakerName":"ケオベ","speakerId":"char_2013_cerber","isRemote":false,"text":"おいしいクッキー、楽しみだなぁ！"},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_109_fmout","aliases":["ギターノ"]},{"speakerId":"char_115_headbr","aliases":["？？？"]},{"speakerId":"char_163_hpsts","aliases":["ヴァルカン"]},{"speakerId":"char_196_sunbr","aliases":["グム"]},{"speakerId":"char_198_blackd","aliases":["クーリエ"]},{"speakerId":"char_2013_cerber","aliases":["ケオベ"]},{"speakerId":"char_260_durnar","aliases":["ジュナー"]}]}
