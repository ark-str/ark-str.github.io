{
  "server": "jp",
  "storyId": "story_almond_set_1_story_1",
  "groupId": "story_almond_set_1",
  "stageId": null,
  "title": "航海",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_almond_1_1.txt",
  "sourceHash": "8933321a2a7f8b41b1cb23cdec8a408028cf021fd362625261800e043b0d7a8f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "どうしたの、ローラ？　バロン基地なんて、今さらもう珍しくともなんともないでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "えっ……あ、ごめん、ちょっとボーっとしてただけ……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "さっきから机に置いてある模型をじーっと見つめてるから、何か問題でもあるのかと思っちゃったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "先輩たちの話によれば、その模型はバロン基地の改装工事が竣工した時に、エンジニア部が記念として作ったものらしいんだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "本当に大丈夫なのよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "うん。見た感じ……今の基地とそっくりだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "そう言ってくれると安心だわ。それじゃあ……さっきの続き、いいかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "うん。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "まずは報告書にサッと目を通させて……いくわよ、コホン……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "ローラ、銀行強盗の捕縛命令を受けたあと、あなたはどういった行動を取ったのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "命令を受けた時、ちょうどエンジニア小隊を連れて区画のドッキング構造の安定性を再確認していた最中だったから……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……作業を続行することにした。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "そう判断した理由は？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "あの時の命令は、区画のドッキング作業の担当を除き、全員銀行強盗の束縛に向かえという内容だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ドッキング作業のほうはまだ人手が必要だったし、あたしちゃんたちはもともとその作業に割り当てられていたんだから、間違いなく担当のはずだよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "だから命令に従って、目の前の作業を優先したんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "だけど報告書によれば、強盗犯の一人に親しい友人がいたそうじゃない？　そのことは命令を受けた時点でもう知っていたのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "う、うん……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "じゃあそれについてはどう判断したのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "判断って……あたしちゃんの？"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "「同じことを言わせるな。」"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "あたしちゃんが……判断とかそんな……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……あたしちゃんはBSWの社員だよ。あたしちゃんの仕事はただ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "命令に従うことだけ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "（眉をひそめる）……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "「命令に従う、か。正しい決断だ、ローラ。」"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "どうかしら？　結構似てると思わない？"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "特にさっきの「同じことを言わせるな」ってセリフなんて、我ながらそっくりだったわ。そうでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "あら……ローラ、どうしたの？　顔色が悪いわよ？　もしかして……圧をかけすぎちゃった？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ううん、平気……ただ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "気にしないで。続き、お願い。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "えっと……さっきの質問で最後だったけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "ローラ、この際はっきり言っちゃうわね。あなた、デイヴィスタウンから戻って来て以来ずっと様子がおかしいわよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "あの任務が特殊だったことはみんな理解しているわ。それにあなたがその騒動の真っ只中にいたことも知ってる。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "一体何を経験したのか想像もつかないけど……でもね、いつまでもそう気を張り詰めてちゃだめよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "そろそろ休まなきゃ、ローラ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "休む……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "それもしっかりと身も心も休めるの。もう報告書のことは忘れて長期休暇でも取りなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "そうだね……このまま落ち込んでてもしょうがないんだし。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ねぇ、アリーザ。もう一回予行練習をお願いできないかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "あなたねぇ……私の話聞いてたの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "なあローラ、もう報告なんてしなくてもいいんじゃねぇか？"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "あれから二週間経ってんだぞ。今さらあの話題を掘り返す奴なんていねぇよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "所詮あれは会社で起きたちょっとしたトラブルに過ぎねぇ。真面目に報告したところで、上はどうせ適当に聞き流すだけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "それよりも事務員さんの言う通りに、部長に長期休暇の申請をしてきたほうがよっぽど有意義だぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "いや……今回の報告は絶対にしなきゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "あたしちゃんは最初からデイヴィスタウンにいて、色んなことを実際にこの目で見て、この身で体験した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "作戦中はきっちり命令に従い、作戦終了後はしっかり報告を行う――これがBSWに所属する人の義務でしょう。それに……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "アリーザ、あたしちゃんの報告書を読んだよね？　どの内容も上に報告すべきものだと思わなかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "それは……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "報告する必要なんてねぇよ。デイヴィスタウンで起きたことはもう誰の目にも明らかなんだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "政府から委託された任務の遂行中に、BSWの社員が一名規約を破り犯罪に加担し、それにより会社の名声と評判に重大なダメージを与えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "ローラ、こんなの何度も蒸し返していい話じゃないのはあんただって分かってるはずだろ？　特に……二週間も経過したとなればなおさらだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "俺たちは給料のために働いてるんだ。ただ命令に従って、自分たちの食いぶちを守れればそれで十分なんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW傭兵",
      "speakerId": "avg_npc_1045_1",
      "text": "余計なことで悩む必要なんてないさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "だとしても、ハッキリさせたいんだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "どこが痛いの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "お尻だけなら平気ね。その痛みの分だけ悪さをしたってことよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "これでもう反省したかしら？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "自分のどこが悪いのか、何も分かっていないようね。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "あとで見せたいものがあるわ。今はとりあえずご飯にしましょ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "急に呼び出すなんて一体どうしたのかしら、ローラちゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "フランカちゃんの意見を聞いてみたいなーってことがあって。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "どうせデイヴィスタウンのことでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "えっ、そんなに分かりやすかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "いつもみんなを笑顔にしてくれるムードメーカーちゃんが帰って来てからずっとムスッとしてるんだもの。気付かないほうが無理よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "デイヴィスタウンのことを報告書にまとめたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "その任務の報告書ならリスカムがもう上に提出したよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "とっくの前にね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "知ってるよ。でも――"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あなたが報告書になんて書いたのか、大体予想がつくわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "その報告書を上に提出したらどうなるか、教えてあげよっか。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "報告書はろくに目を通されることなく、何を聞いたって答えてはくれない。もし報告書を受け取った側の機嫌がたまたま悪かったら、余計な処罰まで食らっちゃうかもね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "以上。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "もう二週間も経ってるのに、いまだに時々思い出しちゃうんだよ、デイヴィスタウンでの出来事を。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "あそこがどんな状況だったのか、みんな目の当たりにしたよね？　一番頑張っていたのはジェシカなのに、あの子はまだ自分の努力が足りないんだって思ってた。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "ジェシカはいつだってそんな子だったでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……ねえフランカちゃん、今回のデイヴィスタウンでの任務、あたしちゃん全然役に立たなかったよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あらあらあら、みんなのムードメーカーちゃんにそんな正義感の強い一面があったなんて、初めて知ったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "正義感どうこうとかじゃなくて――"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "フランカちゃんたちは最後にジェシカちゃんの元へ駆け付けられたでしょ。なのにその時、あたしちゃんは……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ジェシカちゃんが色んな人に追われてピンチだった時、あたしちゃんは本艦で作業してるだけだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "あ、あたしちゃんだって……あの時……ジェシカちゃんと一緒に残りたかったのに……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "「BSWの制服を身に纏っている間は、命令には必ず従わなければいけない。何もできなかったとしても、それはあなたのせいであるとは限らない。」"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "もし我らがリスカム隊長がここにいれば、大真面目な顔でこんなことを言ってくれてたはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "それからローラちゃんを優しくそっと抱きしめるの、この船であなたは一人じゃないよって伝えるためにね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "フランカちゃん、もしかして――"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あたしはただ、優しいアドバイスや慰めの言葉がほしいなら、今すぐリスカムのところに行ったほうがいいよって言いたいだけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あたしに意見を求めたって、心にグサッと刺さる言葉しか出て来ないよー。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……ううん、それが聞きたいんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "結局のところ、ローラちゃんはあの時ジェシカを助けられなかったことを後悔してるのか、それとも決断を下せたジェシカに嫉妬してるのか、どっちなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "報告書を書いたのも本当に真実を伝えたかったからかしら？　自分は臆病者じゃないんだって自分に言い聞かせたかっただけじゃないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "あたしちゃんはごく普通の家庭に生まれたんだ。ママもごく普通の医者で、あたしちゃんの人生は、自分で何か決断を下せるほど自由じゃなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "家族と一緒にボリバルからクルビアに引っ越して、やっとの思いで大学に受かったのに、卒業間近で鉱石病に感染しちゃうなんてさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "BSWに来たのだって仕方なくだよ。どこのテクノロジー会社も採用してくれなかったからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "そして、ここに来て最初に学んだことが、命令に従いチームで行動すること。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "別にジェシカちゃんに嫉妬なんてしてないよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ブリンリーなんて名前はジェシカちゃんに与えられたものと比べればあまりにも重すぎる。そんなのみんな分かってたじゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "別に、ジェシカちゃんの財力を羨ましいと思ったことなんてない。あの子が背負っているものはあたしちゃんよりずーっと多いことを知ってたから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "でもだからこそ分からないんだ。どうしてジェシカちゃんはあんな決断を下せたの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沈黙が二人を包み込んだ。\nやや間を開けて、茶髪のヴァルポが顔を上げると、すでに降りきってしまっている夜の帳に向かって小さくため息をつく。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "もしあの時、ローラちゃんも命令を受けてあたしたちと一緒にジェシカ追っていたら、あの子に銃を向けてた？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "向けないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "そうしろって命令されてたとしても？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "そうだとしても……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "やらない。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "どうして？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "だって――"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ジェシカちゃんを傷つけたくないから。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "ほら、あなたも一つの決断をしたじゃない？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "こんなの、なんの――"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "意味もないはずないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あたしたちはジェシカと違って、地位ある名家に生まれたわけじゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "大物が下す決断はたくさんの人に影響を与えるけど、あたしたちみたいな一般人が下す決断なんて、せいぜい自分に影響を与えられれば十分よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ほんとにそれでいいの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "どうしてダメなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "それに、自分が臆病者だって認めたほうが……真実を追いかけることよりもずっと素直で可愛げがあるわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "真実はどうでもいいの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "物事はね、時々真実よりも忘れ去られないことのほうがずっと大切なの。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あっ、そうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "今からする話はただの思いつきだから、聞き流しちゃって。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あたしとリスカムは今、ロドス・アイランドという会社に派遣されてるんだよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あそこの任務はどれもかなり手強いけど、待遇は悪くないし、一緒に働いてる人もみんな親切よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "もしどっかのムードメーカーちゃんが、BSWの雰囲気じゃ重苦しくて息がし辛いというのなら――"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "環境を変えてみるのも一つの選択かもね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……うん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ありがとう、フランカちゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "やっぱみんなの言った通りだ。こういう悩みはフランカちゃんに相談するのが一番だね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "うん？　どういう意味？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "「フランカは言葉はキツイけど、悩んでいることがあるのなら絶対に解決してくれる」ってみんな言ってた。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "そんな適当なことを言ってるのはどこのどいつよ！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "ローラはここにある機械に興味があるのよね？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "だったら触ってもいいか、事前にママに訊いてくれなかったのはどうして？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "えぇ。確かにママはローラが機械のパーツをいじくり回すのは嫌いだわ。おばあちゃんのように、一日中工房に引きこもってるような大人になってほしくないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "それでも触る前に訊いてほしかったわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "確かにダメだって言うかもしれないわね。だけど、そうじゃない可能性だってあったかもしれないじゃない？"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "でもそれは訊いてみなければ、永遠に分からないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "あそこに机があるわね？　今日からあれがあなたの作業台よ。ベッド下に隠していたものを全部机の上に移しなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "今すぐにね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_1045_1",
      "text": "入りたまえ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "失礼します、部長。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "ローラか。何か用かな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "えっと、この前あたしちゃんが担当した任務の遂行地点がデイヴィスタウンだったことって……部長は知ってますよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "知っているが、それがどうかしたのかね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "仕事のフローに従って、その任務を報告書にまとめてきました。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "はて、そんなフローなんてあったかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "あります……"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "任務報告書……ああ、思い出した。確かにあったな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "あれは大変な任務だった。途中で色々なことも起きただろう。それを報告書にまとめあげてくれるとは、ご苦労だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "いや、それは別に……"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "君の報告書はきっと、事件の解像度をより上げてくれると信じているよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ローラがじっと見つめる中、デスクの向こう側に鎮座する人物は、彼女が提出した報告書をペラペラと手早くめくる。\nそしてため息をついた――\n彼女の予想していた通りに。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "ローラ、こんなものは報告書とは呼べん。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "うちは技術班なんだ。報告書にエンジニア担当と無関係なことを書いたら駄目じゃないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "それは分かっています。だけど、実際に任務中に、作業以外の出来事も目にしてきました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "それを見なかったことにはできません。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "はあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "まあいい、どうせこんな報告書は誰も目を通さん。とりあえず受理しておくよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は報告書の最後の一枚を開くと、そこにサインをした。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "君のキャリアはまだまだ長いんだ、ローラ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "見ていいもの、見てはならないもの、その区別がしっかりつくように学ばなければならない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "……すみません、部長。あたしちゃんはただのエンジニアだから、そういうのには疎くって。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "だから、一つお願いがあるんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部部長",
      "speakerId": "avg_npc_1045_1",
      "text": "何かね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "新しく始まる交流プロジェクトに参加するために、ロドス製薬に派遣してほしいんです。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "コホン、それじゃあ続けるわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "ちょっとタンマタンマ！　もう少し心の準備をさせてよ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "うん、オッケー、いいよ始めて。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "それでは……ベルトに着けているマスコットについて教えてもらえるかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "マスコットって……何その質問？　本当に面接でそんなことを聞かれるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "もちろん。フランカがくれた『面接予想質問集・完全版』に書いてあるからね。「時折面接官は面接者の服装やアクセサリーについて尋ねることがある」って。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "そっか……えっと、このマスコットは母が作ってくれたもので、いつも肌身離さず持ち歩いているんです――こんな感じでどうかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "回答時間の目安より短いけど、いい感じよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "それにもう、恐ろしい検査の数々を全部クリアしてるし……"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "フランカも言ってたでしょ？　面接前の検査が本番で、面接はただの雑談だって。だから、わざわざ対策する必要もないと思うわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "だーめっ！　念には念をいれなきゃ。ほらほら、次の質問お願い！"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "あっ、この質問は実際にありそう……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "ローラちゃ～ん！　遊びに来たわよ～！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "あら、ロドスの面接の練習をしてたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "avg_106_franka_1",
      "text": "どうやら考えがまとまったみたいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "そりゃもちろん。でも今は静かにしてて。その話の続きはこの質問を終わらせてから。"
    },
    {
      "type": "dialogue",
      "speakerName": "BSW事務員",
      "speakerId": "avg_npc_524_1",
      "text": "ローラさん、あなたの将来のヴィジョンについて教えてください。"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "将来？"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "speakerId": "avg_4105_almond_1",
      "text": "あたしちゃんの……将来……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "ここはもう危険なのよ、ローラ。こんな戦火の中であなたに子供時代を過ごさせたくないの。だからもうここを離れなきゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "ママだって悲しいわ。でもね……"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "私たちの運命はいつだって自分では決められないの。ママには……もう他の選択肢がないのよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "ローラ……"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "そうね……私の可愛いローラ、その通りだわ。あなたがママの選択肢よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "さあ、出発しましょう。新しい場所に行けば、新しい物事と人々に出会えるわ。たくさんの新しい運命があなたを待ち構えている。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "そしていつの日かまた、今日みたいに進むべき道も、先にある将来も見失ってしまうほどの困難にぶつかるはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "その時はどうか思い出して――諦めずに前へ進み続ければ、選択肢はずっとそこにあったことに必ず気付けるのだと。"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "speakerId": null,
      "text": "そうすればきっと、勇気をもって決断を下すことができるわ。"
    },
    {
      "type": "sceneBreak"
    }
  ],
