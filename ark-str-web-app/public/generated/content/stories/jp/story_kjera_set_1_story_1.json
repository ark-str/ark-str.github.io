{
  "server": "jp",
  "storyId": "story_kjera_set_1_story_1",
  "groupId": "story_kjera_set_1",
  "stageId": null,
  "title": "気に掛けるもの",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_kjera_1_1.txt",
  "sourceHash": "9b59ba8d837025004a9dbe1340e308abab76b81d923fc608e2186d557fb008aa",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "ねぇ、新しく改装した印刷所にはもう行ってみた？"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心旺盛な職員",
      "speakerId": null,
      "text": "まだだけど、どうしたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "昨日付き添いで見に行ったんだけど、思ったよりずっとすごかったんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "設備はどれも新しくなってたし、作業スペースも広くて、前のボロボロな印刷所の面影も残ってなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "見てよこれ、印刷所の所長がくれたサンプル。これが今の印刷物のクオリティなんだって。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心旺盛な職員",
      "speakerId": null,
      "text": "この紙質……フォントも細部まではっきり見えるし……本当にすごいね！？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "でしょう？　これからはあたしたちの書いたものを、あそこで本にしてもらえると思うと、ワクワクが止まらないよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心旺盛な職員",
      "speakerId": null,
      "text": "それ本当？　うれしい！　前の印刷所は設備が古すぎて、ほとんど使い物にならなかったもんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "だよね。所長も大喜びで、印刷したいものがあればいくらでも持ってきて構わないって言ってたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "好奇心旺盛な職員",
      "speakerId": null,
      "text": "あははっ、なら私たちも遅れを取らないようにしないとね。このクオリティにふさわしい文章を書かなきゃ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "遅くなっちゃってごめんなさい！　今朝は厨房の人手が少し足りなくて。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "ヤエル、来たんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "まったくもう、侍女長の仕事だけでも忙しいんだから、こっちの心配までしなくてもいいのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "それはダメよ。私が巫女様にお願いして引き受けた仕事なのに、きちんとやらないと申し訳が立たないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "それに巫女様だって、この『イェラグ旅行ガイド』の制作をすごく気にかけているの。なんと言っても、イェラグへのイメージを左右するものだからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "さっきちょうどその話をしてたんだよ。今のイェラグは毎日少しずつ良くなっていってる気がするの。だから私たちも遅れを取らないようにしなきゃって。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "今日もまた三家会議？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "ええ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "仕方のないことです。ヴィクトリアの態度はかなり厄介な問題ですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "まったく、エンシオディスが撒いた災いの種が、結局芽吹いたというわけね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "こうなってしまった以上は、状況を見つつことを進めていくしかありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "そうだ、ヤエル。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "少し相談したいことがあるのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "何かしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "主と取り決めを交わしたいのです――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "ヤエル？　ヤエル！　いきなりボーッとして、どうしたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "え？　ああ、なんでもないわ。ところで、日頃から「後れを取る」という言葉が大嫌いな観光部長さんはどこかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "確かに、カーハ部長が遅刻だなんて珍しいね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てた顔の夫人",
      "speakerId": null,
      "text": "すみません、観光部門はこちらでしょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "ええ、あなたは？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な職員",
      "speakerId": null,
      "text": "あっ、カーハ部長の奥様じゃないですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ああ、ここで合っているみたいね。よかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "どうしたの？　顔色が悪いわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "……巫女様に会わせていただけないでしょうか？　急ぎの用があるのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "何があったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "あなたは、いつも巫女様のおそばに控えていらっしゃる侍女長のヤエルさんですよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "よかった……実はうちの夫ですが――"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "あの人、息子の留学にずっと反対していましてね。ですけど息子も意地っ張りなもので、自分で内緒で学費を貯めて決行することにしたんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "私も……はあ、ついほだされてしまって。あの人に黙っているよう息子に頼まれて、思わず同意してしまいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "なのに出発の直前になって結局バレてしまいまして……夫は今息子を連れ戻そうと駅に向かっているんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "夫は確かに頑固な人ですけど、息子も父親に負けじと強情な子なんです。もし言い争いにでもなったら、わ、私じゃどうしたらいいか分からないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ヤエルさん、どうかあなたから巫女様にお力添えをお願いできませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "本日、巫女様はカランドにはいないわ。今からお願いしに行っても間に合わないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "な、ならどうすれば……！"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ああ、私のせいだわ。あの時、カーハをちゃんと止めていれば……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "そうね、今回は私が行きましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "え？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "巫女様と憂いを共にするのも、私の役目の一つだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "このような揉め事であれば、巫女様に代わって私が少し意見を述べても構わないはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ええ、ええ、ヤエルさんが巫女様と懇意にしておられることは、ここの誰もが知っていますからね。あなたの言葉ならきっと耳を傾けてくれるに違いありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "そうと決まったら急がなきゃ。夫はもう駅に着いているはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "ええ、行きましょう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ああ、どうしてこんなに人が多いの。人混みの中で一体どうやって夫を探せば――"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "何度も言ったはずだ！　私の目が黒いうちは、絶対に留学には行かせんとな！"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "どうやら、探す手間が省けたみたいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ああ、人だかりができているわ。あの人ったら、ご近所さんの笑いものになってもいいのかしら。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "俺だって何べんも言ったぞ！　絶対に留学するとな！"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "まるで理解できん。お前は一体どこから、その先進技術とやらの情報を仕入れたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "父さんに分かるはずないさ。毎日毎日、信仰のことしか……いや、信仰を利用して、権力を得ることしか考えていない人ような人にはね！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "黙れ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "父親に黙って家を出て行くだけでは飽き足らず、さらには、公衆の面前でふざけたことまで抜かしおって！　どれだけ恥を晒せば気が済むんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "恥晒し？　そりゃあ父さんの方だろ！　観光部長のカーハ様！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "このばかもんが……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ああ、ヤエルさん、早くなんとかしてください！"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "（はあ、エンヤはよくもまあこんな下らないことを毎日解決しているものね。真面目な顔をして、巫女様と憂いを共にするのが役目だなんて言ったさっきの自分を引っぱたいてやりたい気分だわ。）"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "（適当になだめたら、後の事はエンヤに任せようかしら。）"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ヤエルさん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "はあ、分かったわ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "じいちゃんが欲しい物を渡してくれなかったから、せめて俺は自分の言いなりにしたいんだろ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "もう一度言ってみろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "じゃあ、じいちゃんが今どこにいるか知ってるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "なんだと？"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "いいや、あんたは知らないね。"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "父さんはじいちゃんを理解したことなんて一度もなかったからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "私があの人を……？　違う！　あの人が私を理解してくれなかったんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "ふん、なんとでも言えよ。確かに俺は、じいちゃんみたいに山の雑草や石ころに一生を捧げるようなことはできない。でも、俺はじいちゃんが好きだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "進んだ技術を学んでくれば、じいちゃんがイェラガンドの爪の手入れをするのを、もっと楽にしてあげられる。"
    },
    {
      "type": "dialogue",
      "speakerName": "青年",
      "speakerId": null,
      "text": "俺は、じいちゃんやご先祖さんが残してくれたものを、自分の出世の踏み台にすることしか考えていない父さんとは違うんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "カーハ部長",
      "speakerId": null,
      "text": "お前――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "その、カーハ部長の父親は一体……"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "お義父さんですか？　一年中、山にこもって石を叩いてばかりで、家にも滅多に帰らない変わった方なんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "私が嫁いだ時には、二人の関係はすでに最悪でした。私は義父とも仲良くしたかったのですけど、結局機会が見つからなくて。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "一度、酔った夫がこぼしていましたが、義父は自分がイェラガンドの爪の手入れをしていると思い込んでいて、それでずっと山に籠っているのだと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "……なら、カーハ部長は？"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "あの人は……親父のような生き方は、絶対にごめんだと言っていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "親父は間抜けだ、あんなのは信仰なんかじゃない、と。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "そう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "部長夫人",
      "speakerId": null,
      "text": "ヤエルさん、どこへ行くんですか？　仲裁に入ってくれる約束だったのでは！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "もっといい人選を思いついたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": null,
      "text": "（小声）……多分ね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ほとんどのイェラグ人は大人になる過程で、イェラグという土地を囲む山々の名前を、様々な方法を通して知ることになる。\n訳あってそれらの山に登ることもあるが、大抵の場合は比較的に有名な山であることが多い。\n無名の山々は、イェラグ人であっても滅多に足を踏み入れない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そしてヤエルが今いるこの山は、まさかにそういった無名の山々の一座であった。文字通り名前すら持たぬ山であり、ましてや人が足を踏み入れた様子などなかった。\nもしも今誰かがこの山道を通ったとしたら、きっと不思議に思うことだろう。\nなぜなら、カランド貿易が観光地として開発した山を除けば、これほど整備された山道はイェラグのどこを探してもないからだ。\n――否、たとえ観光地に指定された山あっても、これほど美しく整えられてはいないだろう。\nそう、この山は美しいのだ。\n樹木は剪定されており、草むらはまるで何か規則性でもあるかのように一定の範囲にのみ生い茂っている。さらに、道には石ころ一つ落ちていなかった。\nまるで庭園だ。\n山の中腹まで登ると、カンカンと小気味良い音が響いてきた。時に早く、時に遅く、山上で巨人が武器を鍛えているかのように、谷をこだました。\nヤエルはその音に聞き覚えがあった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "山頂に着くと、音の主が姿を見せた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "それは巨人でもなく、叩いているものも武器ではなかった。\nそこにいたのは、突き出た岩にノミを当て、槌を打つ、腰の曲がった一人の老人だった。\n岩に比べると、老人も、その手に握られたノミと槌も、みな小さく見える。だが老人はそんなことは気にも留めない様子で、ただ黙々と槌を振るっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "ふぅ……"
    },
    {
      "type": "narration",
      "text": "どういうわけか、ヤエルは安堵のため息をこぼした。\nそれから彼女は傍らに置いてあった予備の工具を手に取り、老人の隣へ行くと、一緒に槌を振るい始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "speakerId": "avg_npc_279_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "……"
    },
    {
      "type": "narration",
      "text": "老人は何も訊かず、ヤエルも何も言わなかった。\nしかし沈黙が気まずさを生むことはなく、むしろ二人の間には言葉にし難い一種の暗黙の絆が生まれていた。\nカン、コン、カン、コン。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "speakerId": "avg_npc_279_1",
      "text": "……"
    },
    {
      "type": "narration",
      "text": "老人は依然として黙ったまま、置いてあったリュックのそばまで行くと、中から水を取り出し一口飲んだ。\nそれから油紙で包んだ雑穀のビスケットを二つ取り出すと、一つをヤエルに手渡した。\nヤエルは遠慮することなくビスケットを受け取り、老人の隣に腰かけて食べ始める。\n老人も、もう一つの方の油紙を開け、大口を開けてパクパクと食べ始めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_279_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "speakerId": "avg_npc_279_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "ここで何をしているの？"
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "speakerId": "avg_npc_279_1",
      "text": "知らないのに、何をしに来た？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "だって面白そうだったから。"
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "speakerId": "avg_npc_279_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "老人",
      "speakerId": "avg_npc_279_1",
      "text": "うちは先祖代々、こうしてイェラガンド様の爪の手入れをし続けてきたのじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "爪……？　それって指の爪のこと？"
    },
    {
      "type": "narration",
      "text": "老人は頭を上げ、遠くを見た。そうして最も高く連なる山々を指さすと、次のその隣のやや小さな山に指を移した。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "連なる山々は主の背骨。その背骨の隣に突き出ている小さな峰が、主の「爪」なんじゃよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "でも、イェラガンドは人間の女性だったはずでしょう？　湖心島では今ちょうど彼女の彫像を建てている最中よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "あれは民と交流をするために顕現させた人の姿じゃ。あれもイェラガンド様に違いないが……"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "この山々もまた、イェラガンド様なのじゃよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "かつてわしの先祖がその目で見たんじゃ。空一面から降り注ぐ黒い雨の中、主が神なる力で盾を成し、イェラグの民を守る光景をな。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "最終的に主は勝利されたが、代償に深い傷を負ってしまわれた。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "我が先祖はそんな主の庇護に感謝するために、爪の手入れを引き受けることにしたのじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "そして、それがあなたたち一族の伝統となったのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "そんな伝統があることが知られたら、蔓珠院の人たちが慌ててあなたを訪ねにくるんじゃないかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "お嬢ちゃん、わしの息子の代わりに来たのじゃろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "あいつに伝えといてくれ。ご先祖様が残してくださったものを渡すことはないと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "息子さんに頼まれたわけじゃないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "ただ息子さんもお孫さんもあなたの跡を継ぐ気はなさそうだから、少し残念に思っただけよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "……わしはこの一生、ただ山で岩を叩き続けてきた。これがわしにできる唯一のことじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "わしが父の跡を継いだように、カーハの奴も当然わしの跡を継ぐもんだと思っとった。だが気づけば、息子はあんな有り様になっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "わしは口下手な質で、どうしたらいいのか分からず、だからいっそのこと、山に籠ることにしたんじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "はあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "記憶が正しければ、確かカーハは今年で四十になるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "彼の幼少期は、シルバーアッシュ家の前当主オラファーがヴィクトリア留学から戻ってきた時期と重なる……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "あなたも覚えているでしょう？　ああいう鉄道やら何やらが、ちょうどその頃から造られ始めたことを。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "ああ、覚えておるとも。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "だけど、オラファーが外国の技術と一緒に、その思想も持ち帰ってきたことをきっとあなたは知らないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "当時は彼の開国思想を発端に、イェラグ全体に論争が巻き起こっていたわ。その中で一番影響を受けたのは、間違いなく若い子たちのはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "恐らく、カーハもその影響を強く受けた一人じゃないかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "だけど彼の一族は、先祖代々イェラガンドの爪の手入れを担う運命にあった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "当時の彼は、きっとさぞかし悩んだことでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "その過程で何を考え、何をしたのかは知らないけど――"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "そう考えると、彼がどうして今のようになったのかも理解できる気がするわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "結局はわしのせいじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "いいえ、あなたのせいじゃないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "あなたはお父さんから槌とノミを受け継いだ。そしてあなたのお父さんも、またそのお父さんから――そうして先祖代々同じことを続けてきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "あなたたちはただ自分のやっていることに全力を尽くしていただけなのに、それの何が間違っていたというの？"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "しかしだ――"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "お孫さんが言っていたわよ。おじいちゃんのためにも、イェガランドの爪の手入れがもっと楽になるように、新しい技術を学びに行くのだと。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "……ナーハの奴は、よくここまで会いに来てくれる。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "だがあの子が持ってくる通信端末やらの機械は、どれも使い道がよう分からなくてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "あなたは本当に新しいものが嫌いなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "……鉄道が東から西へと敷かれていく様も、ビルが山よりも高く建てられていく様も、わしは見てきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "イェラガンド様がそれを気に食わんというなら、寝返りを打つだけですべてを振り落とせたじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "わしは……イェラガンド様を信じておる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "それなら、信じ続けて。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "一つだけ保証してあげられるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "いつか本当に、イェラガンドが山々で寝返りを打つ日が来たら、その時あなたが手入れした爪はきっと一番輝いて見えるはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "……"
    },
    {
      "type": "narration",
      "text": "去り行くヤエルの背中を眺めていた老人は、ふとその姿に見覚えがあるように感じた。\nそして、じっくり考えこんだ末、それが先祖が残した伝承に描かれた姿と、どことなく似ていることにようやく気づいたのだった。\nそれは、災が降り注いだ大地を歩き、絶望と悲鳴を通り抜けた姿。そして、雪解け水に濡れる小枝を掠め過ぎ、暖かな陽射しを潜り抜け、このイェラグへ希望をもたらしてくれた姿\n老人は何かを悟ったのか、その濁った両目に一瞬光が灯った。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "我らのイェラガンドに。おお、我らのイェラガンドに……"
    },
    {
      "type": "narration",
      "text": "老人は孫にもらった通信端末を懐から取り出した。\nまだ不慣れではあったが、孫を喜ばせるために頑張って使い方を覚えたものだ。\n端末には二つの番号しか登録されていない。一つは家で、もう一つは孫のものだ。老人はその後者にかけた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "ナーハ、ああ、わしじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "カーハはそばにおるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "あいつに伝えてくれ、欲しがっていたものを渡してやると。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "ただし、お前を行かせることが条件じゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "なに、気にするな。"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "うむ、それとな、あいつに代わってくれんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "爪の手入れ師",
      "speakerId": "avg_npc_279_1",
      "text": "直接話したいことがある――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "……"
    },
    {
      "type": "narration",
      "text": "ヤエルはなぜだか、数歩歩いたところで足を止めた。\n顔を上げ、遠くの山々を見やる。いつの間にやら奇怪な石が彼女の横に浮かんでいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "あらあら、まったく、あなたときたら。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "昔ならそんなこと言わなかったはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "カーハの信仰は敬虔だけど盲目的で、ナーハは血気盛んだけど向こう見ず。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "昔ならダーハみたいな人が、お気に入りだったのに――"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "山の内に横たわって、カンカンと石を打つあの音に耳を澄ませながらまどろむ夜を、一体いくつ過ごしたのやら。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "なのに、恩知らずにもずらずら否定的なことばかり並べちゃって。そんな調子じゃ、嫌われても知らないわよ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヤエルは浮かぶ石をすくうように掲げた。その口ぶりは石の向こうの誰かに文句を言っているふうにも、鏡に向かって話しかけているようにも聞こえる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "石が微かに震え出し、中から声が響いてきた。\nそれは彼女の声だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "あらあら、まったく、あなたときたら。"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "あの子と出会ってから、自分がどれだけ変わってしまったのか、まだ認めないつもり？"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "友人、帰る場所、欲しいもの……そんなのができてしまったら、自ずと立場は変わるものよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "それは昔のあなたが一番嫌っていたものじゃなかったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "イェラグの人々が自分たちの思うように生きていけることを、ずっと望んでいたはずでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "ただ彼らを見守っていたいだけじゃなかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "まったく、シルバーアッシュ家には困ったものね！"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": null,
      "text": "やれ希望だの、未来だのを語ってあなたをたらし込んじゃって、ひどいものだわ！"
    },
    {
      "type": "narration",
      "text": "高原の寒風が山々を吹き抜け、耳元を掠める。だが彼女に聞こえたのは風の音ではなく、自分とよく似た笑い声だ。\n自嘲と諦めが混じった、何かを面白がるような笑い声。\nそれは誰を笑っているのか。当然自分自身だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "友人なら、今までもいなかったわけじゃないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "それに、本当に誰とも関わらずにいたことなんてなかったはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "本当は手を貸してあげたいはずなのに、私には手を出すべきじゃないと言う。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "間違ってると思っているくせに、それでも彼らが自分で判断すべきだと考えてる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "まったくあなたときたら、なぜあの子を選んだのか本当に分からないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "あの子がこの数千年の間に現れた、代わりがいないほどに特別な存在だから？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "それとも、ただ代わりにあなたの望んだことをしてくれるから？"
    },
    {
      "type": "dialogue",
      "speakerName": "浮遊石",
      "speakerId": "avg_npc_251",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "ヤエル、今どこにいますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "今は……どうせ言っても分からないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "そうですか。私の代わりにちょっとした問題を片付けてくれたそうですね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "あらあら、巫女様は耳が早いわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "知りたくなくても、勝手に知らせが来るものですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "はあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "言いたいことがあるのならはっきり言えばいいわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "この間の件について、考えてくれましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "なんの話だったかしら？　今夜の夕飯のこと？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "もう、冗談を言ってるんじゃありません！"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "主との取り決めの件かしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "ええ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "もうすぐヴィクトリアから使者がやってきます。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "その時は、何が起きようとも、主には決して手を出してほしくないのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "まだその時ではない、ということね？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "ええ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "この程度の危機ですら自力で乗り越えられないのなら、身共はいっそ銀心湖に身を投げた方がいいでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "まったくもう、あなたって時々お兄さんよりも強情ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "誉め言葉として受け取っておきます。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "今夜は蔓珠院へ戻るのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "すぐに帰るわ。巫女様にご飯を作ってあげなきゃいけないもの。職務放棄をするわけにはいかないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "なんだか、機嫌が良さそうですね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "そんなことまで分かるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "当然です。どれだけ長い付き合いだと思っているのですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "なんでもないわ。今日は天気が良かったから、少し散歩していただけよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "また夜にね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "speakerId": null,
      "text": "ええ、また。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "speakerId": "avg_npc_250_1",
      "text": "ふふっ、あらあら、まったく私ったら。"
    },
    {
      "type": "narration",
      "text": "澄んだ笑い声が風に乗って山々の頂を吹き抜ける。今度は、紛れもなく彼女自身の笑い声だった。\n彼女は足を止めることなく、カランドへ向かって歩いていく。\nまだ仕事が残っている。もう帰らねば。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
