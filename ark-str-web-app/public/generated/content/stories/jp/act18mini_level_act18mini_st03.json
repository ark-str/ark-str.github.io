{
  "server": "jp",
  "storyId": "act18mini_level_act18mini_st03",
  "groupId": "act18mini",
  "stageId": null,
  "title": "すれ違い",
  "storyCode": "",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18mini/level_act18mini_st03.txt",
  "sourceHash": "b029ac1835214fbb85c89539bfd7aef0db9ed427ed93e4c7d56fb4463db9db59",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "オリー、ちゃんとついて来るのよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "抱っこがいやなら、はぐれないようにしっかりお母さんの服を掴んでなさい。いいわね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "汗だらけで滑ってしまうから……手は繋げないの。絶対に服から手を放しちゃダメよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（頷く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "あ、あれ……コリン！？　どこに行っちゃったの？　ねえ、私たち本当にここから出られるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "無理そうなら、やっぱり家に戻りましょう！　こんな小さな子が、大人の足について来られるはずがないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "コリン――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "キャッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "こっちだ！　抜けられそうな道を見つけたぞ！　模範軍が来たおかげで、見張りの魔族どもはみんなそっちに行ったみたいだ。あとは爆発さえ避けられれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "「爆発さえ避けられれば」ですって！？　シュヴァルさんが家財を背負って雑貨屋から飛び出した時のことを忘れたの？　赤く光っている場所で転んだだけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "こんな手のひらサイズの傷口から、体中の血が全部流れ出ちゃったのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "……ううん、まるで血を「搾り」取られたみたいだったわ……あれが本当にただの爆発なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "傷が塞がらなくてそうなっちまっただけだ！　怪我して血を流さないように気をつけてれば大丈夫さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "とにかく、引き返すのは絶対にダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "さっき二百メートルも離れてないところで爆発があったばかりじゃない。わけもわからずその辺で死ぬくらいなら、家で死んだほうがマシよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "それにコリン、あなたのお祖母様はまだ街に――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……引き返しても、状況が悪くなるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "あんたは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "封鎖エリアのサルカズが全員いなくなっているとは限らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "あんた、外から来たってことは、救援に来た模範軍か？　たっ、頼む！　俺たちを助けてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……すまないな、私は模範軍でもなければ、救援に来たわけでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ロンディニウムには人探しをしにきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "人探しって……靴に穴が空くまで歩き回ってたの？　だけど、今のロンディニウムで誰を探そうっていうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "とにかく、あなたが模範軍じゃないのはよくわかったわ。あなたも私たちと同じ、悲しい境遇にいる人なのね……コリン、帰りましょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "はあ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男は大きなため息をつくと、もう一度慎重に辺りを見渡した。\n長い年月を経て、彼は再び眼鏡士としてロンディニウムへとやって来た。今のこの都市は、熱気に包まれた工房でレンズの検査をしていた時のように、歪み、ぼやけて見えた。\nようやく視界がクリアになったかと思えば、目に映るのは動乱ばかりだった。このような混乱の中から、動向も読めず、面識もない者を見つけ出すのは、至難の業だろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "あ、あの……何か必要なものはありますか？　金目のものは全部お渡ししますから、どうか俺たちをここから連れ出してください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "あなたは傷ひとつ負わず、単独で封鎖エリアまでやってきたじゃないですか。きっと安全なルートを知ってるんですよね？　どうかお願いします……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "痩せた男は、身体中のポケットまさぐった後、バッグの底からいくつかパンを取り出しノウエルに押しつけた。そばにいた女性も、慌てて小銭を取り出す。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルはそれらを受け取ろうとはせず、ただ首を横に振った。彼は思う――この三人の未来と、血を搾り尽くされた死体の間には、紙一重しかないと。\nそして、自分はその僅かな隔たりから一歩引いて、これまでのように傍観しているのだと。\n彼もこれまでに手を差し伸べたことはある。だが、二本の腕だけでは、全員を救うことはできなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "すまない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "お願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "コリン、行きましょう。それ以上言っても無理よ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "だけど、もう他に方法はないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……私は模範軍ではないが、彼らの居場所ならわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "彼らの拠点まで連れて行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "あっ……ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "だけど、私にできるのはそこまでだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "いえ、十分すぎるほどです！　ぜひ案内をお願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "……コリン、お祖母様はどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "すべてが終わったら、迎えに戻って来ればいいさ。魔族がどんなに残忍だろうと、療養所にいる弱ったお年寄りには手を出さないだろ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "そうですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "拠点までは送り届けるが、そのあとのことは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "君たちが自分で何とかするしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "もちろんです、本当に助かりました。ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……気にするな。子供とはぐれないように、ついてきてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "こっちだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ここからまっすぐ外壁を目指すといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "爆撃でできた外壁の空洞を目印に、模範軍の一部が駐在しているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "さらに外へと進めば、公爵連合軍もいるはずだよ。どちらに助けを求めるかは、君たちが判断するといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "ですが、えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "つまり、ここでお別れということでしょうか？　あなたはどちらへ向かわれるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "道中に何度も身を挺して命を守っていただいたのですから、せめて何か恩返しさせてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "けっこうだ。傷ももう塞がり始めているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "あなたがどれほど――どれほど不思議な力に恵まれていようと、砲火は容赦してくれませんよ。やっぱり、私たちと一緒に来ませんか……あなただってヴィクトリア人じゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……いいや。私は……ただここまで流れ着いてしまっただけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "探し人が見つかるまで、止まれないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "その人って、いったいどんな人ですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "道中何度も繰り返された質問だったが、初めて男の返事に何らかの感情が乗った。\n男は常人なら死に至る傷をいくつも負っていたが、そのほとんどが塞がり始めている。流れた血もすぐに止まり、サルカズの法陣でさえ男の体にはなんら影響を与えられていない。\n痛みだけがいつまでも男に付きまとっていた。それでも、男はこぶしを握り締めて口を開いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……探しているのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "私にこの「才能」を与えた者だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "恐れる女性",
      "text": "あ……あの！　わ、私たちはどうすれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "こっちだ。援護するから、次の砲撃が来るまでに避難を――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "急いでいる男性",
      "text": "ど――どけっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急いでいる男性",
      "text": "こんなところ、今日こそ絶対出て行ってやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急いでいる男性",
      "text": "邪魔すんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "下がれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "子供と老人の避難が先だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急いでいる男性",
      "text": "何のんきなことを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "自救軍が策定した避難ルートは最も安全なものだ。どうしても一人でどこかへ行きたいのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "勝手に行くがいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "急いでいる男性",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……失礼、君は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私か？　ロンディニウム自救軍のリーダーだ。クロヴィシアと呼びたまえ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "このエリアで避難の誘導をしている者がいると聞いたが、キミのことだな。協力に感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "ここからは自救軍が避難誘導を引き受けよう。キミの使命はこれで果たされたのだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "いや、まだ手伝える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "他の者を生かすためであっても、キミの身の安全と引き換えにはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "自救軍は何の見返りも約束できないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "いいや、君は知らないだろうが、私は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "すまないが、今は議論する時間さえ惜しい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "はあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "手短に話そう。私は怪我をしてもすぐ治る呪いを受けた身だから、こちらの安全は気にせず援護は任せてくれ。そうすれば、より多くの人々を避難させられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロヴィシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "どのみち、ここでも人探しを続けるつもりだからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "最後のグループの避難も完了したな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "あの自救軍のリーダー……クロヴィシアさんはどこへ行ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルはあたりを見回して逡巡すると、早足で通り過ぎようとした労働者風貌の男を呼び止めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "君、すまないが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "いたっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……すまない。腕を怪我してるんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "手当てをさせてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "そんな大袈裟なもんじゃないよ。そんで、何の用だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "自救軍のリーダー……クロヴィシアを見かけなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "彼女と二手に分かれて避難グループの誘導を行ったのだけど、いつまでも集合地点に現れないものだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "あれ？　あの人が連れてきた人たちだってもうとっくに落ち着いてるぜ。当人はたぶんまだ最後の仕上げをやってるんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "と言っても確証はないぜ。みんな自分のことで精一杯だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "彼女はもう着いていたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "どうやら、君たちの避難経路の方がずっと安全で近道だったようだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "俺たちはただロンディニウムの地下を熟知してるだけさ。地下が絶対に安全というわけでもないしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "さっきの話だけど、クロヴィシアは自ら指揮を取って、サルカズ傭兵の残党による襲撃を未然に阻止する仕事があるはずだ。魔族どもの罠が怖くなけりゃ、封鎖エリアに戻ってみれば見つかるかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "お前さんもかなりの数を避難させた実力者みたいだし、きっと役に立てるだろうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "――あの！　以前に助けてくださった方ですよね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "オリーを……うちの子を見ませんでしたか？　赤毛で無口で、まだ私の膝くらいしかない子なのですが、どこかで見ていませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "なんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "うちの子が、見当たらなくて……どこにもいないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "おーい！　オリー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "くそっ！　いったいどこに行ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "オリーったら、ずっとあなたのお祖母様の話をしていたから、もしかして……あの子もお祖母様が心配で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "この辺りはもう全部探したのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "はっ、はい！　全部探しました！　一緒に来たみんなも手伝ってくれていますが、もう探していないのは封鎖エリアくらいで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "私が行ってみよう。私にとっては、封鎖エリアも外も変わらないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "いや待て、クロヴィシアが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ああ、彼女が戻ってきたら、きちんと全員無事に送り届けたと伝えてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "私も一緒に行きます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "いや、君たちはここに残るんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "そうじゃなくて！　クロヴィシアが戻ってきたんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "ほらあっちだ、赤毛の子供を抱えてるぞ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "――本当ですか？　オリー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "皆が顔を上げ、労働者の指す方向へと向き直る――\nその瞬間、異変が起こった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "いけない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "――全員下がれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "……オリーよ！　あれは間違いなくオリーよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "行くな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルは錯乱した女性を制止するのがやっとだった。\n見渡す限りに尋常ならざる赤い光が明滅した直後、地面が真っ赤な口を大きく開くように崩落し、自救軍のリーダーを呑み込んだ。\n無数の視線が震動する地面の中心に注がれる。震源地に立っていたその人は、最後の瞬間まできつく子供を抱きしめていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "煙と埃が次第に散りゆき、すべてがひと時の静寂に戻る様子には、もはや馴染み深さすら覚えた。\nこの地にいる者たちは、これまでに何度も同じような別れを経験してきたのだ。受難者の身分によって、その結果が変わったことはただの一度もない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ゴホッ……ゲホッゴホッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "待て、まだ近寄っては――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "こうした状況下で立て続けに起こる二次爆発や余震を、ノウエルはこれまでに何度も経験してきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "ううっ……お、オリー……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "……お、俺……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪我した工員",
      "text": "俺、捜索を呼びかけてくる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "あ、あなたは！　まだいらしたのですね！　お願いします、オリーをどうかお助けください――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "あなたは魔族の罠をものともしませんし、体もお強くて勇敢ですから……せめて、せめてあの子を連れ帰ってくださらないでしょうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "あの子はまだ、あんなに幼いんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルはその生涯において、完全に何かを掌握できたことなどほとんどなかった。悠久の生命は海のように莫大な記憶をもたらしたが、その中から一粒の記憶だけを拾い上げることなどできない。\n一般的に年老いた者がそうなるように、彼もまた目の前の情景が記憶の断片と重なって、ぼんやりとしてしまうことがある。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "もう十分だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不明瞭な声",
      "text": "ここまでしか見送らせてくれないんですか？　本当に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不明瞭な声",
      "text": "……残っていただけないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不明瞭な声",
      "text": "あの子はまだ、あんなに幼いんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "不明瞭な声",
      "text": "一番下の子は、まだあなたをおじいちゃんと呼べてさえいないんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……長すぎた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "あまりにも長い日々を過ごしてしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "今よりもずっと早く君の母の元へと旅立つべきだったというのに、いつの間にかこれだけの月日が流れてしまった。君の姿が、父である私より老いてしまうほどに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "私は何一つ成し遂げられていないというのに、いつまでも未練ばかりだった。延々と躊躇い続けているうちに、子供たちからすれば、まったく馴染みのない存在となってしまったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "いずれは周りの人たち全員にとっても、完全なる部外者になってしまうのだろう。その定めを終わらせる手段が、たった一つしかないというのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "今こそ、それを実行しようじゃないか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルは爆発によって崩落した場所へと目を向けた。ぼんやりとした意識の中で、崩れた地面と瓦礫でできた空洞が、百年前の真っ暗な沼地へと変わった。\nそれは今日に似た早朝の出来事だった。耳元に響くのは、彼を引き留める声だろうか。子の救助を哀願する声だろうか。かつては頑なにそれを拒み、失敗が約束された死への旅に踏み出したものだ。\nしかし今回、彼は同じ選択を繰り返すつもりはなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……クロヴィシアさんが落ちる直前に、あの子の頭を庇ったのが見えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "えっ、それは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "つまり、オリーは生きているかもしれないということさ。だけど無事が確認できるまでは、それもあくまで可能性に過ぎない。だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "私が降りて探してこよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "自救軍の助言を受けて、ノウエルは地下通路から崩れた位置を目指すことにした。彼は特異な体質と、長年の放浪で得た経験を頼りに進み続けた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ここから西へ、三百メートルほど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は軽やかに、素早く、一時も休まずに進み続ける。やがて、眼前にこれまでとは異なる光景が広がった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "異族の法陣が起動した痕跡の周囲には、陥落によって降ってきた瓦礫が山になっており、そのすぐ側に赤毛の子供が静かに横たわっていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "（穏やかな呼吸音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルは駆け寄ると、子供を抱き上げた。そっと抱き寄せると、子供の薄い胸が呼吸に合わせて上下しているのが感じ取れた。\n髪についた灰や砂ぼこりがなければ、まるで柔らかいベッドで寝ているかのような穏やかさだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "よかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ひどい外傷は見当たらないし、気絶しているだけのようだな。一人で残されてはいるが、直接地面に叩きつけられたようには見えない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "間に合ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "クロヴィシアさんもこの近くにいるかもしれない。きっとオリーをここに寝かせてから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "クロヴィシアさん！　聞こえるか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "声が出せないのなら、何か硬い物を叩いて音を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "クロヴィシアさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "聞こえ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数歩進んだところで、彼はその光景を目の当たりにした。\n自救軍のリーダーは、体の半分が瓦礫に埋まった状態で意識を失っているようだった。\n若きリーダーの両目は、かくも自然で柔らかく閉じられている。まさか、彼女はこの地中で永き眠りに就いてしまったのだろうか？\n崩落がクロヴィシアにもたらした刹那的な苦痛は、数秒後に平穏のみを残して去って行ったのかもしれない。その結論に思い至ると、ノウエルはこう考えずにはいられなかった――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "クロヴィシアさん！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "――うぐっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "余震で崩れ落ちてきた瓦礫は、まるで雨上がりに羽獣が勢いよく振り払った水滴のように慌ただしく至る所に飛び散り、防ぎようがなかった。\nノウエルは、クロヴィシアに近寄ってまだ息があるかを確認することさえ叶わなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "激しい余震の中で、ノウエルは迷わず幼子に覆い被さり、身を挺して瓦礫を防いだ。鋭く尖った瓦礫はいとも簡単に衣服と皮膚を突き破り、骨身に深く食い込んだ。\nしかし彼は微動だにせず、歯を食いしばって余震が過ぎるのを待った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ぐすっ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "子供のぐずり声が、痛みで意識が途切れかけていたノウエルを現実へと引き戻した。\n真っ暗で見慣れない場所で目を醒ました子供がパニックになって泣き出すのは、最も原初的な本能と言えるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "やあ、オリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……もう大丈夫だ。私がここにいる……ノウエルだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ゴホッ、ゲホッゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "前に会ったことがあるだろう。覚えているかい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "余震はどうやら止まったようだ。ノウエルは片手でオリーを抱きかかえながら、もう片方の手に力を込めると、背中に乗った重みを無理やり押しのけて、上体を起こして座り込んだ。\n幸い、背中に乗っていたのは人を押しつぶすような重たい石板ではなく、ヒビだらけの岩にすぎなかった。それでも動く度に血の匂いが広がり、子供は暗闇の中でいやいやをするばかりだった。\nオリーにはほとんど何も見えていないようだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……クロヴィシアさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "彼女が君を救ってくれたんだよ……だからまずは、君を無事に外まで届けないとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……その後で……彼女を助けに戻ってくるよ。彼女はこんなところで眠りにつくべき人ではないからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルは体を折り曲げ、震える男の子を地面に下ろすと、背中に刺さった破片を引き抜こうとした。\nその様子を見て、男の子がノウエルの服をぎゅっとつかんだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……君を置いていこうというわけじゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（首を振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "大丈夫、こんなことで死んだりしないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……私を殺せるものなんてないんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう言った男は微笑みさえ浮かべていた。話しながらも、彼は手探りで肩甲骨の間に刺さった最後の欠片を探し当てた。\nノウエルは歯を食いしばってそれを引き抜いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "っ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "はは……オリー、驚かせてしまったかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "心配いらないよ、おいで。なにがなんでも外まで送り届けてあげるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "痛みを我慢することは、とうに骨の髄まで染み込んだ習慣となっている。ノウエルは再び男の子を抱き上げると、往路の方角を思い出しながら、二人が安全に脱出できる道を見繕った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "来た道は確か……こっちだったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "もう少し頑張るんだよ、オリー。絶対に連れ出してあげるからね。君のご両親も外で待って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（首を振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "どうしたんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（もがく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "おっと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "下ろしてほしいのかな？　だけどこの方が安全だし、早く進めるからね。君もお母さんに会うのが待ちきれないだろう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（飛び降りる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……わかった。では私に掴まって、しっかりついてくるんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "男の子は頷くと、ノウエルの服のすそをつかんだ。その上、まるで大人の言うことをしっかり聞いているとアピールするかのように、その小さな手の中で服のすそを絞るようにぎゅっと捻りあげた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "よし、では行こう――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……長き旅路を歩んできたのだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……哀れな者よ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "突如、つかみどころのない声が、周囲の瓦礫から幾重にもこだまして響いた。\n暗闇の中、ベールのような霧が次第に色濃くなり、やがてノウエルを包み込む。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何故、ここに来た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルがその声を聞き間違えるはずがない。\nしかし、彼は体が動かないことに気付いた。勢いよく沸き上がった冷たい怒りが、体への命令を押し戻しているかのようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "何を望む？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "やめろ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "なぜその声が今ここで現れたのか？　本能に基づく不信感が、あらゆる判断力を押しとどめていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "小芝居はもううんざりだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ずっと私に会いたかったのではないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ふざけるな！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "お前はいったい何者なんだ？　出てこい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私はここにいる。キミが私を求めてやって来たように、私もキミのために現れたのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "キミはただ……目を開けばいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルは声の主に会ったこともなければ、その姿を確かめる術もなかった。長らくの間、彼は伝聞をつなぎ合わせ、自身の疑問を恨みへと転化することしかできなかった。\nもしこの声が幻ではなく実在しているのなら、きっと……"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "そうか。ならば、きっと教えてくれるのだろうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "君のことはどう呼べば？　どんな願いもかなえてくれる妖精？　それとも偉大なる全知全能の護国卿かな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "歴史の裏側に潜むユニコーンは、時には妖精とされ、時には悪党とされてきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "それらはすべて、私であって私でないものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "私がここに現れたのは、キミに、哀れな一人の者に、償いを約束するために過ぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "お前は私の名前さえ知らないのだね。生ける伝説からすれば、私の身の上など、これまでいたずらにひっかきまわしてきた大事件には遠く及ばないのだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "そうとも限らない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "かつて、キミの可能性には期待していたのだ。品種も知れぬ雑草が枯れぬ命を手に入れたならば、果たしてどのような姿に成長し、どのように周りを感化していくのだろう、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "キミに不死を与えた時、私はそう考えていた。それは祝福であるはずだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "フッ、「祝福」か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "その傲慢な「祝福」が私にもたらしたのは、延々と続く苦しみだけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "……本意ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "だが事実、私は苦しみ続けたんだ！　そのうえ、いくら苦しもうと死ぬことはできない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "こんなものは――ただの呪いだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "その怒りは受け止めよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "ならば、キミに安らぎを与えるには、どうすればいいだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……ハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "また別の祝福を施してくれるつもりか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "男の子の手がさらに強く服の裾を掴んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "オリー……君にもあの声が聞こえるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（うなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……ペテン師の声だよ。何も聞かず、何も考えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "もう行こう、オリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "お前がいったい何者であろうと、手の平で踊ってくれる伝説の英雄たちと問答すればいい。私はもう付き合っていられない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "時代の荒波の中で、舵を取る資質のある者はほんのわずかだというのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "文句でもあるのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "……私の祝福を呪いと断じた以上、償いはさせてもらう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "願いを聞かせてくれ。何を望む？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "この先に挽回の機会はあるはずだ……キミはすでに、他の者より多くを得ているのだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "くっはは。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "決まったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "行こう、オリー。時間を無駄にしすぎてしまった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（ノウエルの服をぎゅっとつかむ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "いい子だ。私はここにいるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "もしあの声が怖いのなら……気にしなくていい。あれが本当に実在しているものだとしても、ただの犯罪者でしかないからね。ほら、街で暴れている人たちと同じだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "君を外に連れ出した後で、私が捕まえてやるとしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ユニコーン」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ふう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する工員",
      "text": "――オリーだ！　ノウエルさんが連れ帰ってくれたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する工員",
      "text": "おい、早く来い！　みんな手を貸してくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "さあ、気を付けて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "下から支えるから、先に上るんだ。ゆっくり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する工員",
      "text": "大丈夫です、俺が上から引っ張りますから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する工員",
      "text": "さあ、ノウエルさんの番ですよ。まさかお怪我でも？　お手伝いは必要でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "いいや、大丈夫だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "オリー！　ああ、私のオリー――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "本当に心配でたまらなかったのよ！　次は、次こそは絶対抱きしめて離さないから……もう絶対に同じ事は繰り返させないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "ふ、服についた血は……どこか怪我したの！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる女性",
      "text": "おかしいわ、どこにも傷なんてないじゃない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（ノウエルを見る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "オリー、一緒に落ちたお姉さんはどうしたんだ？　もしかしてまだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "下にはいないのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無口な子供",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "ったく、お前って奴は……まあいい、無事帰ってきてくれて何よりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "ノウエルさん、本当にありがとう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "手を振る男の顔には、焦りや動揺とは異なる表情――\n困惑するほどの誠実さを湛えた、感激の笑顔が浮かんでいた。ノウエルはうなずくと、かろうじて微笑み返した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "どう……いたしまして。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "しかし男は、そのままノウエルに近づくと、言葉だけでは感謝を表しきれないとでも言わんばかりに、手を差し出してきた。ノウエルは微笑んだまま、無意識にその手を握り返した。\nその時ようやく、彼は次第に広がりつつある痛みを感じた。痛みは背中から胸元に、さらに全身へと広がり続けていた。急激に息が詰まるような感覚に、彼は思わず襟元をつかんで身をかがめた。\n瓦礫に貫かれた傷口が、まだ塞がり始めていなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "――あの、どうしたんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "うわっ、せ、背中が！　こんなにひどい怪我をしているなんて――早く医者に手当てしてもらわないと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "ああ、取り乱してすみません！　ノウエルさんご自身がお医者様でしたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……私が怪我をしている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "は、はい……背中の傷から血があふれてるじゃないですか！　こんなにひどい傷がたくさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "傷口は塞がり始めていないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "え、ええ。俺たちにとっては当然のことですが、あなたがこんなふうになるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "下で何があったんですか？　どうしてこんなにひどい怪我を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "それに、自救軍のリーダーもまだ下かもしれないんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "彼女もオリーを守ってくれた一人ですし、俺も自救軍に何か報いるべきかもしれませんね。たとえば俺が下に行って自救軍のリーダーの死体を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "クロヴィシアだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "クロヴィシアさんって言う方なんですね？　そう言えば聞き覚えがあるような……残念ながら、お人柄を知る機会は失われてしまいましたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "偉大なリーダーがいるとは伺っていました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "偉大な人だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "ははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "……私には……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "わからない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "クロヴィシア……私はどうやら生涯を費やして探そうとしていた者と、すれ違ってしまったようだ。\nだが、そんなことはもはやどうでもいい。どうでもよくなった。痛みと息苦しさに意識が遠のきながらも、ノウエルは必死に顔を上げた。\nぼやける視線の果てには、ぎゅっと母の手を握る子供がいた。子供は見るからに健康そのもので、髪と肌の色は暖かく、眩しい笑顔を浮かべている。それはまるで……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "肩につかまってください！　自救軍か模範軍の所まで連れて行きますから！　きっと軍医もいるはずなので……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "いや、いい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "……えっ？　どうしてですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "ノウエルさん！　いったい――どうしたんですか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "しっかりしてください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ノウエルは自分の体を支えきれず、ついに膝をつき、地面にうずくまった。まるで百年の歩みで蓄積した疲労が、この一瞬でその身に降りかかってきたようだった。\n失血によって手足が冷え切る前に、彼は背中のおぞましい傷口がもたらす痛みには構わず、力を振り絞って頭頂部を地面につけるように体を丸めた。\n敬虔とさえ言える姿勢となったが、それは決して誰かに祈りを捧げるためのものではない。\nほどなくして、彼は顔を上げた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "自救軍のリーダーは、下にはいないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "痛みも、慟哭の衝動も消え去ってはいない。しかし辺りは静寂に包まれており、ただ跳ね続ける心臓だけが、胸の中で轟々と響いていた。\n幸せを感じるものが、死をもたらしてくれるものが……今はもうここにある。"
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "今なんて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "クロヴィシアさんはそこにはいないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "張り詰めた男性",
      "text": "お怪我は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "今は無益なことをするよりも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ノウエル",
      "text": "時間を無駄にできない。できる限り多くの人を助けなければな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
