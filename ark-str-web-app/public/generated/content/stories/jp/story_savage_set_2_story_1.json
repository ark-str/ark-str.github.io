{
  "server": "jp",
  "storyId": "story_savage_set_2_story_1",
  "groupId": "story_savage_set_2",
  "stageId": null,
  "title": "パイはいかが？",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_savage_2_1.txt",
  "sourceHash": "107110dc299bb4680c508a205d05aa45dbaa3745faed70a5c896eadf48697a0f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "ロドス内部 レム・ビリトン鉱業ロドス駐在事務所"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "サベージお姉さん、忙しい……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "あら？　アーミヤちゃん、今日は随分早いじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "今日は引き渡す荷物はないし、特別急ぎの仕事もないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "どうしたの、アーミヤちゃん。今日は何もすることがないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ドクターは、ケルシー先生やテレジアと出かけちゃった。しばらく一人で部屋で待つようにって……晩ご飯までには戻ってくるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "でも、一人でお部屋で何をしたらいいか分からなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "はっは〜ん、それでこっそりわたしを訪ねようと思ったわけね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えへへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "はぁ……大人はみんなそうなんだよね。いつだって終わらない面倒な仕事に追われてるんだよ。それにあの三人はどう見たって、疲れを知らない「ワーカホリック」ってタイプだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "大きくなったら、みんなそうなるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "みんなってわけじゃないよ……でも、必要に迫られてそうなる人もいれば、心の底から全力で仕事に打ち込むことで、充実感を得てるような人も確かにいるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "じゃあ、サベージお姉さんはどのタイプ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "わたし？　うーん……仕事は好きっちゃ好きかな？　仕事の時間はやるべきことをしっかりやるし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "だけど今は休憩時間。それなら仕事なんかよりも、アーミヤちゃんといるほうが断然楽しいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "そうだ。アーミヤちゃん、せっかくだし今日は料理をしてみない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "料理？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "あなたが大好きなレム・ビリトンの料理を教えてあげるよ。そうね……キャロットパイなんかはどう？　作ってみたくない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "調理とオーブン焼きの楽しさを知ったら、きっとアーミヤちゃんもやみつきになるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "サベージさんと一緒にキャロットパイを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うん、作ってみたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "よしっ、じゃあ一緒に作ろうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "前に作ったときは、ドクターも好きだって言ってたから、完成したら三人で食べよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "や……やったぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "OK、決まりだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "おいで、アーミヤちゃん。前に同僚に頼んで持ってきてもらったニンジンが厨房の冷凍室にあるんだ。あとチーズと卵はたしかあそこに――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "サベージお姉さん、卵を溶いたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "早かったね、どれどれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "うっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "（なんで卵液が半分も減ってるの……？　しかも殻が全部中で粉々になってる……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "……うん。だ……大丈夫。わたしが仕上げに調整すれば、きっと使えるはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "し、失敗しちゃったかな……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "そ、そんなことないよ！　あはは。アーミヤちゃんは初めての料理だし、まだ慣れてないだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "そうだ、アーミヤちゃん。ニンジンを洗ってくれる？　うん。そのカゴに入ってる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "ああっ、洗剤は使わなくていいよ。そうそう、水でいいから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "……待って待って！　爪で削っちゃダメだよ、表面はこのピーラーで削ればいいから……デコボコになるのはよくあることだよ、だって初めてでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "……生地はちょっと難しいから、わたしがやるね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "あ、オーブンの設定も私がやるよ。やっぱりちょっと難しすぎたかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "……アーミヤちゃんっ。小麦粉はそんな風に片付けちゃだめ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ゴホゴホッ……ゴホ……ううっ。サベージお姉さん、助けてぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "ぷっ……っははは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ううっ、眼が痛いよぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "待って、今拭いてあげるから……ゴホ、ゴホゴホッ、ぷはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "笑わないでよ、サベージお姉さん……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "ごめんごめん、ぷっ……ただ、今のアーミヤちゃんがとっても可愛いなって思っただけで――ああ、この瞬間を記録しておけたらいいのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "ふぅ……体が小麦粉まみれになっちゃったね。先にアーミヤちゃんをお風呂に連れてって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "だ、だめ！　今大事なのはパイだよ……間に合わなかったら大変！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "サベージお姉さん、全部作り終えてから片付けようよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "ははっ、分かったよアーミヤちゃん、おいで。顔を拭いてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "パイをオーブンに入れ終わったら、焼き上がりまで時間があるからその間にちゃんとシャワーを浴びようね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "ふぅ、ちょうど焼き上がった。……うん、中々の出来だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "見て、三つともいい焼き具合だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うん。いい匂い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "あとは上から軽く砂糖をまぶして、保温しておくだけだよ。これで重要任務完了だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "そういえば……ドクターの味の好みってちょっと変わってたよね。どんな感じだったっけ、アーミヤちゃん、知ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うん！　ドクターの好きな味付けは覚えてるよ。あと……サベージお姉さんが好きな料理も全部。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "えっ？　アーミヤちゃんはわたしの好みまで覚えててくれたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えへへ……だってサベージお姉さんはいつも私に優しくしてくれるからね。お姉さんが好きなものを美味しそうに食べているのを見ると、私も嬉しくなるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "だから、サベージお姉さんが喜ぶことは、全部覚えてるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それから……サベージお姉さん、これからは私も一緒にいろんな料理を作りたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "だから……ずっと一緒にいられたらいいな……ドクターみたいに、いつも一緒にサベージお姉さんと遊べたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "アーミヤちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あっ、でも気にしないでね！　サベージさんは忙しいんだし、お仕事はすごく大事だって知ってるから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "……側にいてあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えっ……本当？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "本当だよ。安心して、アーミヤちゃん。だってもうわたしたちは、とても、とーっても仲のいい友だちでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "コータス人ってね、兄弟姉妹は仲良く、一緒に助け合って暮らしていくんだよ。だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "でも……ケルシー先生が言ってたよ。あと少し経ったら、バベルとレム・ビリトン鉱業の協力案件は終わるって……そしたらサベージさんは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "……知ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "そうだよ。その後、わたしはレム・ビリトンに戻ってしばらく働くと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "もう大人だからね、負うべき責任があるんだよ。わたしには、まだレム・ビリトンでの仕事が残ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "でも、なるべく早く戻ってくるよ、アーミヤちゃん。どんなに遠く離れていても、わたしたちは友だちだし、あなたがわたしの助けを必要とする時は、必ず守ってあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うん……分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "よ、よーし、この話はおしまい。もしかしたら、レム・ビリトンがわたしを忘れてて、呼び戻されないなんてこともあるかもね。そしたらわたしも無職かぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "そしたら、アーミヤちゃんが一生懸命勉強して大物になって、大企業を設立して、わたしをそこで雇ってくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "え？　私が会社をつくるの？　……うーん、できるかなぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "今から努力すれば、いつかチャンスは巡ってくるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "ドクター、ケルシー、テレジア……あの人たちはみんなとってもすごい人だからね。アーミヤちゃんもそんな先生たちからしっかり学ぶんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うん、分かった。サベージお姉さんもすごい人だよ。レム・ビリトンにいたときだって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "いやいや、あの人たちとは比べものになんないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ううん、サベージお姉さんはとってもすごい先生だよ！　美味しいご飯を作ってくれるし、仕事もできるし、レム・ビリトンのお話をたくさんしてくれるし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それに、サベージお姉さんはいつも私を気にかけて、一緒にいてくれる……本当のお姉さんみたいに私に良くしてくれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "サベージお姉さんがいなくなっちゃうのはイヤだよ……だけど、今日のお料理はとっても楽しかったよ。だから寂しくなった時にはこれを思い出せば、きっと一人でも大丈夫。もう怖くないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "わたしもだよ、アーミヤちゃん。バベルに来てあなたに出会って、一緒にお話ししたり、遊んだり、料理をしたりできて……とっても嬉しかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "だから、もうすぐ離れなくちゃいけないって知ったとき、わたしも悲しかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "でも、わたしはアーミヤちゃんを心配させるような顔はしないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "アーミヤちゃん。この大地に生きる人はみんな、それぞれやるべきことを持ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "将来あなたも、自分の進むべき道が見つかると思う。そのときに、わたしたちが同じ信念を持っていれば……きっとまた会えるって信じてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "わたしは頑張って進み続けるよ。アーミヤちゃん、あなたも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サベージ",
      "text": "強く育ってね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......\n何もない平凡な一日。\n朝早くアーミヤが突然あなたを訪ねてきて、わくわくした様子で、今日のお昼はレム・ビリトンの美味しい料理があると告げた。\n五日連続で健康食を食べていた身にとっては、どうにも抗うことのできない誘いだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ずっと楽しみにしていた「ごちそう」なんです！　サベージさんは大概どんなお願いも聞いてくれるんですけど、料理に関しては頑固なところがあって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "すべての材料が揃うまでは、正式にお客さんを招待しないんです。一つでも欠けてたらダメなんですって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "サベージは君にすごく優しいね。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "えへへ……ずっと昔から、サベージさんは私をたっぷり甘やかしてくれるんです。それに、サベージさんの料理はとってもおいしいんですよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "素朴な味付けだと思う人もいると思いますが、私の好みなんです。なんというか、懐かしい、故郷の味なんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あ、でもドクターも好きだと思いますよ。だって……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "だって？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "何でもありません！　ただ、ドクターと一緒に楽しみたいんです。サベージさんも、ドクターをお客さんとして大歓迎しますって。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私たちとサベージさんは、かなり昔からのお友だちですからね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "「私たち」か……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい。サベージさんは過去のドクターとも知り合いです。ドクターにだって、何度もレム・ビリトンの料理を作ってくれたことがありますよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "サベージには……どう思われているんだろう？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "心配しなくても大丈夫ですよ。私と同じく、サベージさんにとってドクターは、とても頼りがいがあって信用のおける人です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "サベージさんも、今回ドクターを食事に招待して、再会のお祝いができることを楽しみにしていると思います。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "サベージさんは、料理の腕前もプロ級ですが、食材についてとてもこだわりがあるんですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "でも……実は、今回の一番重要な食材である、レム・ビリトン産のニンジンの缶詰が、今年はなぜかとても手に入りづらくて……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "価格が上昇しただけでなく、販売経路も減ってるんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "レム・ビリトン人はみんなニンジンが大好物ですから、現地でも需要が供給に追いついてないようで。ロドスまで配送可能なものとなるともっと少なくなるんです……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "もちろん、レム・ビリトンだけがニンジンを生産しているわけではないので、他のエリアを探せば別の品種のものは見つかります。でもサベージさんは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "「レム・ビリトン産の甘くてサクサクのニンジンじゃなきゃダメ。絶対にアーミヤちゃんの記憶にあるのと同じ美味しさを味わわせてあげる！」って。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "聞いただけで、よだれが出てきた。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "ニンジンもさぞ誇らしいだろうな。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あはは……ドクターも楽しみなんですね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私もサベージさんとはもう、随分長く会っていませんでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "でも、サベージさんは今でも昔と同じように私に接してくれます。おかげで……とても安心できるんです……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "静かに！　……ちゃんと座りなさい！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ひゃっ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "食堂の方から声が……サベージさんに何かあったんでしょうか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "パクッ！　モグモグ……うんまっ！　さすがサベージさん、こんな美味い料理をありがとう！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エアースカーペ",
          "text": "（バクバクバクバク……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "もう、そんなに褒めなくったっていいよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイプリル",
          "text": "こ、このパイ、ほんと……プロの味だよ～。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ふふっ……でしょでしょ？　わたし、料理の腕前だけは、だれにも引けをとらないって自負してるから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "エイプリル、俺のやつも食べてみなよ！　今、ヴィクトリアで一番流行ってる食べ方でさ、どんな料理にもドバァーーってケチャップをかけて食べるんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "やめなさい、この悪ガキ！　さっきもう二瓶もかけてたじゃない。料理本来の味がわからなくなるでしょ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "ちぇっ……じゃあエアース、俺の特製バージョンを食べてみなよ。革命的な味だから！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エアースカーペ",
          "text": "俺は元の味付けで食うからいい。自分で食え。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "え～？　そんなつまんないこと言ってないで、もっとクリエイティブになりなよエアース。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "ヴィクトリアにいた頃は、レストランに行くたび、みんながパイを一つ頼んで、その上にケチャップを少なくとも四袋はかけて食べるのを見たよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "「全メニューの中で一番健康的なのは、実は無料のケチャップだ」……ファストフード店でよく聞く言葉でしょ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイプリル",
          "text": "ちょっと！　サベージさんのパイとファストフード店のパイを同列で語らないでよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイプリル",
          "text": "こっちは焼き加減から味まで完璧なんだから……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイプリル",
          "text": "この味、とっても久しぶりに食べた気がするな～。この懐かしさが……ホームシックってやつだね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "そうかな？　俺は平気だけど？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイプリル",
          "text": "どうしてそんなに空気が読めないわけ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エアースカーペ",
          "text": "こいつが言っているのは、天災トランスポーターは、故郷の料理が食べられない生活に慣れてるという意味だ。一つのものに依存しすぎると……外ではやっていけないからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "その通り！　ついでに旅行先で見た、すごいパイの食べ方を披露してあげる。こんなふうに手で持ちながらジャンプして――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイプリル",
          "text": "わっ！　危ない、落ちるよ、パイが落ちちゃうって……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "ちょ――やめなさいレオンハルト！　まだ他の人は勤務時間中なんだから、静かに！　……ちゃんと座りなさい！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "わ、分かったよ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "お邪魔します……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エイプリル＆エアースカーペ",
          "text": "あっ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "うわっ、アーミヤにドクターまで――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "みなさん……これは一体なにをしてるんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "ち、違うんだよ。これは、えっと、サベージさんに「故郷のグルメ試食会」に誘われて……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サベージ",
          "text": "……アーミヤちゃん、ドクター、食堂をグチャグチャにしちゃってごめんね。ちゃんと片付けるから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "大丈夫ですよ。私たちもサベージさんの料理を食べに来たんです。あとで一緒に掃除しましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "エアースカーペ",
          "text": "とんだ醜態を晒したな、レオンハルト。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レオンハルト",
          "text": "俺たちだけだったし、多少ふざけても大丈夫だと思ったんだよ……エイプリル、例のすごい食べ方はまた今度見せてあげるね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
