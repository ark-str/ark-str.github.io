{
  "server": "jp",
  "storyId": "act37side_level_act37side_01_beg",
  "groupId": "act37side",
  "stageId": "act37side_01",
  "title": "怨恨の残滓",
  "storyCode": "GO-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act37side/level_act37side_01_beg.txt",
  "sourceHash": "a00af63e680f5aae699788d704c6af6ae852b0317b080664c4e3c4f6a81710c6",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "<p=1>ロンディニウム廃工場</><p=2>1098年12月8日 p.m. 4:43 </>"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "G12エリア……見た感じ長く廃棄されていたようだわ。番号すら見えない……ここで合ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ふぅ――二度とあのくたばりぞこないの魔族たちに遭遇したくないわ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "そこの奥さん、道を間違っていやしないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "（おい、新入り、この女を送り返してこい。ついでに、どうやってここを見つけたか「優しく」聞いておけ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "（忘れんなよ、今回は後始末をちゃんとしておけ。ボスをまた怒らせんなよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した傭兵",
      "text": "はぁ、あなたも聞こえたでしょ。ついてくるんだ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "放して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "あなたたち、レディに対する基本的な尊重すらないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ミッキー・ロビンソン、模範軍の英雄……えっと、「の一人」ね、つまり私の夫だわ。彼から薬を取ってくるよう頼まれたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "お、恐ろしい黒い石の病を和らげる薬よ。夫は、もうすぐ歩けなくなってしまうほどなの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した傭兵",
      "text": "ふん、そいつもついてない奴ってことか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "黙ってろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "よく聞け、俺はミッキーなんて奴は聞いたことがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "あんたがこの場所で見つけられるのは、浮浪者の期限切れの幻覚剤と、死んだ魔族の骨くらいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "でも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "鉱石病を治す薬が欲しいなら、新しく建てられた療養所で探すんだな。これはあの新任の議長サマが約束してくれたことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "――待って、本当に他に方法がないの。あそこの薬では全く足りないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ここなら薬が手に入るのは知っているわ。夫は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "聞いて。安全な場所にお金になるものを保管してあるの。どれもカンバーランド公爵邸の貴重な品で、閣下から昔に褒美として頂いたものよ。薬さえ手に入れば――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "外を巡回する都市防衛軍の注意を引かないようにしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した傭兵",
      "text": "ついてこいよ、「レディ」。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "端末の声",
      "text": "契約書にサインをさせ、明日彼女に薬を取りに来させなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "はい、ボス！　でも彼女に金がなかったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "端末の声",
      "text": "その時はいつも通りに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した傭兵",
      "text": "おかしいな、ボスがこんなことに直々に関わることなんてなかったのに。うーん、じゃあこれから……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "フンッ、彼女に契約書をやれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "ありがとう。ほんとに――待って、この条項、こんなひどい条件だなんて夫から聞かされてないわ！　こんなものにサインしたら、私たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "元気に生きていけるさ。少なくとも俺たちが取り立てるまではな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "どうやらあんたの英雄の旦那とやらは、自分の妻に対してあまり誠実じゃなかったらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "ほら、ペンをしっかり持て。震えるな。本当に無理なら、俺たちが代わりにサインしてやってもいいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた女性",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "傭兵が、ペンを持つ彼女の手をしっかりと握り締める。彼女の震えはひどく、もはや先ほどまでのように落ち着いていると装うこともできなくなっていた。\n彼女は目を閉じ、歯を食いしばって、傭兵に導かれるままにした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "生きている毎日を楽しむことだ。*ヴィクトリアスラング*な戦争は終わったんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慎重な傭兵",
      "text": "「ミルスカー」に助けを求めることは、あんたと旦那さんにとって最も賢明な決断になるだろう、奥さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "今朝、ロンディニウム臨時公共衛生行政官兼、臨時物資調達室長であるメジャー女史がニューオークタリッグ区にある事務室にて死亡しているのが発見されました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "本日、アレクサンドリナ議長は議会を代表して、メジャー女史の感染者支援の功績を称えるとともに、彼女の逝去に哀悼の意を示しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "メジャー女史の生前最後の予定は、都市内で薬品が不足している状況を解消するためにノーマンディー公爵領へと薬品購入の協議に向かうことでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "しかし信頼できる情報筋によると、メジャー女史の死因は鉱石病の急性発作によるものであるそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "彼女は自身が鉱石病である事実を隠していただけでなく、最近では議長と口論している様子が頻繁に目撃されていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "都市内で報告される感染者数が指数関数的に増加しているこの敏感な時期において、世襲爵位を失ったメジャー女史の死の背後に掘り下げるべき裏事情があるのは明白です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "サルカズが軍を引き上げてから二ヶ月が経った今、サルカズに関わる悪質な事件が、なぜいまだに頻繁に起こるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "そして模範軍を、この伝説的部隊をどう遇するか、その方案はすでに定まったのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "大多数の公爵の支持を得る新たな議長に注目が集まっております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの音声",
      "text": "我々は議長と関係が深いケイト・モリガン女史に連絡を取り、より深掘りを――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "議長室内に響くラジオの音声が突然止まった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "デタラメにもほどがあるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "あいつら療養所の食堂で張り込んで、吾輩がご飯食べてる時に飛びついてきて誘導尋問してきたんだよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "それでそいつらを叩きのめしてやったというわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "てっきりそうすれば……デタラメな報道なんてする気がなくなると思ったんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ごめん。ヴィーナの見られ方に影響するなんて思ってもみなかったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "いいや。その場にいたのが私でも、そいつらを全員蹴り飛ばしていただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "えっ？　でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "自分の憶測を真実にすることを生業とするあの類の情報屋の前では何を言おうと、奴らが最初から用意してある答えを変えることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "どうせ奴らの口を閉じさせることができないなら、いっそ直接やった方が手間が省けるだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヴィーナは拳を突き合わせ、本能に刻まれたフットワークを巧みに踏んだ。\nかつてボクシングジムにいた毎日のように。"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ハッ！　それでこそ吾輩の知ってるヴィーナだよ！　わかってたって。ハンナちゃんなんて――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "えーっと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……この服は本当に不便だな。仕立て直すよう頼むべきか――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "腕のいい仕立屋を知っていますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "若い頃は王室の方へも納めたことがあり、今回は運良く生き延びました。ですが残念なことに今は誰も彼に仕事を頼もうとしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……感染したのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "コホンッ、そうだ、通信で言ってたあの件に進展はあったの～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "状況は少し複雑です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "手を出したサルカズはすでに捕らえ、今はシネセルド大広間の議会ホールに留置してあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "今のところ、この件はあの廃地下工場内で活動する組織と関係があると判断しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……「ミルスカー」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "その背後にさらにノーマンディー公爵のあの継承人の計略があるかどうかは――",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "もう一度彼女と……\n交渉する。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "メジャーさんの身に起きたこと、街の市民たちへの薬品供給状況、それに「ミルスカー」の組織とサルカズたち。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "今は都市での多くのことが、二ヶ月前のような純粋に拳で解決できるものではなくなっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "状況への適応が早いですね、ヴィーナさん。それらは今の議会であれば解決できると信じています。安心してください、私が手伝いますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "かつて母に叩き込まれた訓練はこのような局面に対処するためのものでした……彼女に恥をかかせたりはしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "モーガンさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "扉の外の声",
      "text": "先に議会ホールに行って待ってるよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "モーガンは、まだ今の生活に慣れていないだけだ。私たちの皆がそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "シージにはできても、いわゆる議長ではできないこともある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "例のサルカズに怪我を負わされた当事者の状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "ロドスの医療部の方に見てもらっていて、今のところ命の危険はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "それと、出回っている質の悪い薬も調査し、ほとんどの出所が「ミルスカー」であることが判明しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "多くの者が藁にもすがる思いで頼っていますが、結局は薬をばらまいている流れ者たちのせいでかえってひどく苦しむ羽目に陥っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "「ミルスカー」本人がこのことを知っているのか、それとも彼女の手下の管理が甘いのかははっきりしませんが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "アラデルは知っている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「ミルスカー」。ロンディニウムの影に潜むならず者の中でも、最も凶悪な一人。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アラデル。すでにこの世を去った、高潔不変のカンバーランド家最後の残光。\n一体いつからこの二つの名の下にある姿が次第に一つになっていったのかを、ヴィーナ自身も忘れかけていた。\n先の戦争が終わりかけていた時だろうか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は無意識に自身の服をなでた。模範軍の「英雄的リーダー」がこの王室の古い鎧をまとって聖王会西部大広間から出た時……\nすでに夜明けを迎えようかという時間に、カズデル軍事委員会の旗を引きはがしたあの時。彼女は一つの見慣れた人影が蒸気騎士と共に空を覆う蒸気の中に静かに身を潜めていくのを目にした。\nあの日、アラデルは彼女に会いに来ることなく、彼女に背を向けて満身創痍といった様子の無残な姿をさらす都市の暗がりの中へと消えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……さあ、議会ホールに行く時間だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "（モーガンさん……モーガンさん……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "えっ？　なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "あなたの執筆の邪魔をするつもりはなかったのですが、ただ、その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "（バーナビーがまた遅刻をしているので、探しに行きたいと思います。またどこかで酔いつぶれてるんじゃないかと心配で。）",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "どうせヴィーナはまだ来てないし、行きたいなら行きなよ～。わざわざ吾輩に――\nって待って！"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "思い出した。前もそんなこと言って、二人とも会議中ずっと戻ってこなかったよね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "あ、あれは外に締め出されただけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "モーガンさん、包み隠さずに言いますがね、俺は工場で図面を抱きかかえて人生の大半を過ごしてきたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "品質検査審査会をやれと言うなら、どんな部品のデータを持ってこられようと分かりますし、俺に難癖をつけられる組合長なんていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "けどここに座って……向こうのあのお貴族サマたちと対等に振る舞い、このわけの分からない書類の山とにらめっこしながらこんなでかい都市を管理するとなると――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "（俺が人生で管理してきた一番でかい場所は、俺が担当するあの作業場なんです。なのに……はぁ、正直気が引けますよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "吾輩たちがいるっていうのに、貴族のバカどもの何が怖いのさ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "華やかな服装の議員がモーガンの視線を捉えて、微笑んで挨拶をした。"
    },
    {
      "type": "dialogue",
      "speakerName": "華やかな議員",
      "text": "実に良い天気ですこと。皆様お元気そうで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "コホンッ……そっちもね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "す、すこぶる元気ですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "（気持ちは分かるけど、まあヴィーナのメンツを保つためだと思ってよ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "（あいつらもバカじゃ、んーと、全員がロクでもないわけじゃないよ。でもここに座ってロンディニウムを管理する権利は吾輩たちが命を張って取り戻したものなんだからさ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "（まさか昔のああいう日々に戻りたいわけじゃないでしょ～？　だとしたらあのバカたちが無茶苦茶なことを続ける前に、吾輩が先にぶん殴るからね～。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "分かってます、分かってますって。インドラさんとダグザさんは来ないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "まだ治安関連のごたごたへの対処で忙しいんだよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "（はぁ、俺も帰ってハンマーを抱きしめながら寝たいですよ。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "華やかな議員",
      "text": "議長、到着し……えっとこれは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ヴィーナ！　えっ、あんたが背負ってるのって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "バーナビー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔った議員",
      "text": "ク、クライヴ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "デルフィーン、彼を席に着かせるのを手伝ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "飲み過ぎてシネセルド大広間の入り口で眠りこけて、ヴィーナさんを引っ張って放さなかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔った議員",
      "text": "私は議長を待っていたのであります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔った議員",
      "text": "や、薬品不足問題をすぐさま改善できる一連の提案があります――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "……でしたら正式に上申書を出してください。議会が発布する規則を改革しているのは、そもそも我々自身を制限するためなんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "デルフィーンさん、バーナビーは別に横着してるわけじゃないんです。彼は、自分のアイディアを何度も俺に話してくれました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "でも俺と同じで、この場所に来ると魂が抜けたみたいに調子がおかしくなるんです。うまく話せないだけじゃなくて、魔族を叩き切った時の死も恐れない度胸が全部どっか行っちまうんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "だから俺がしょーもないことを思いついて、少し酒を飲めばもしかしたらって……それで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "安心しなよ。ヴィーナはそんなことじゃ怒んないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "緊張する必要はありません。今の新議会は元々複雑を極めます。誰もが観察していて、私たちも適応と学習をしているところです……議長を含め。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "私たちに悪意を抱く人たちに戦場の外で勝ちたいなら、彼らの考え方を学ばなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "この過程は私たちの誰にとっても簡単なことではありません。あなた方はすでによくやっていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "……もし、吾輩たちも最終的にあいつらみたいになっちゃったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着かない議員",
      "text": "お、俺は絶対になりません、モーガンさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "別にあんたがなるとは言ってないでしょ、クライヴ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "最終的にそうならないとは保証できません、モーガンさん。誰にもできないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "吾輩はヴィーナを信じてるよ。ハンナちゃんとダグザちゃんだってきっとそう……あんたたちがどう考えていようとね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "我々が今日臨時会議を招集した理由は、皆がよく理解しているだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "議会が再結成されて以来、我々はいまだ都市内で活動するサルカズたちが引き起こす問題の解決に尽力してきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "ロンディニウムの市民と議会の間には「安全」を保障するという約束がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "相手が危険なサルカズであろうと、「ミルスカー」のような都市に潜む傭兵であろうと、議会は市民の安全を脅かす問題の解決に全力を尽くしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "議会は、我々の市民に対するいかなる悪意ある行為も容認しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ犯人",
      "text": "……俺を裁こうってか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "サルカズ、裁判などは行われない。議会で新たに可決された臨時法案にて貴様の処罰の方法はすでに明確になり、臨時裁判所の審理も通過した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "――全員が認める方法でな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ犯人",
      "text": "「全員が」じゃねぇ。「テメーらが」だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "貴様は善良な店主に重傷を負わせた。本来なら奪わずとも彼が貴様のために残しておこうとしたパンのために。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ犯人",
      "text": "……あいつはまだ生きてんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "生きている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ犯人",
      "text": "いいだろう。で、いつ俺を殺す気だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……貴様はあの時に同族たちと去るべきだったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ犯人",
      "text": "俺のことを覚えてやがんのか？　それもそうか。あいつらが軍を撤退させた時、テメーが俺を見逃したんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ犯人",
      "text": "言うなれば、テメーは俺の命の恩人だ、模範軍のリーダーさんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……貴様は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ犯人",
      "text": "「ロングショット」だ。娘からはそう呼ばれてる。あの時テメーは俺に名を聞かなかったし、今も同じだろうがな。テメーのそばにいるそいつらも俺の名前なんざどうだっていいはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロングボウ",
      "text": "だが、サルカズの「ロングショット」は一部の奴らの代わりに、ここに座ってる全員に聞きてぇことがある――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロングボウ",
      "text": "生まれた時からロンディニウムにいて、一生の間ここを去ったことのねぇサルカズってのは、ヴィクトリア人だって認められるのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "<p=1>ロンディニウム城壁の上</><p=2>1098年10月8日 p.m. 8:48 </>\nサルカズの部隊が去った。\n飛空船の影が厳粛かつ秩序立った部隊に落ちて、「ライフボーン」の立てる波紋が都市外の廃墟の上の暗雲を引き裂いた。\nヴィーナは城壁の上に立ち遠のく軍隊を黙って見つめる。少し前まで、この者たちは彼女の故郷を引き裂いていたのだ。\n大地は生々しい傷跡と、かさぶただらけだ。\n「アナンナ」がロンディニウムに残した傷が治るには、一体何年必要なのだろうか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "ヴィーナ、ドクターがお前に何を言ったかは知らねぇけど、今ならまだ奴らを全員ぶちのめすに間に合うぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺たちの人間と公爵の方から合わさった仲間がまだ城壁の下で待機してる。お前さえ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "ハンナさん、今一番落ち着く必要があるのは私たちです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "私はあなた方の誰よりも、そいつらを全員ここに留めておきたい……ですが事実として、私たちにはそれができません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダグザ",
      "text": "大公爵たちの主力艦隊はそれほど後退してねーぞ、デルフィーン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ダグザちゃんの言う通りだよ！　公爵たちにどんな企みがあったとしても、吾輩たちが本気でドンパチし出したら、体裁を装うためにもあいつらが吾輩たちを助けざるを得ないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "それで、やっとの思いで生き延びたこの人たちに再び命を懸けさせるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "全員、休戦協定の発表は見たでしょう。今は一時の憂さ晴らしをしている場合ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "我慢我慢我慢ってよぉ、ふざけてんじゃねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "我慢できるわけねぇだろうが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "（咽び泣く）こんなにたくさんの人が……こんなにたくさんの仲間が……ベアードが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "インドラは一秒たりとも留まってはいられなかった。我慢できずに城壁を伝って滑り降りてしまうかもしれないからだ。\n自分がこらえきれず、嚙み締めた唇から血を流している仲間たちを伴って飛び出してしまうのではないかと恐ろしかった――"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "ハンナ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダグザ",
      "text": "ハンナはここしばらくずっと自分を抑えてきたんだ……ヴィーナ、心配すんな。私が彼女を見ておく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダグザ",
      "text": "ハンナは口で言ってるだけで、バカな真似をするような奴じゃねーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ねえ、ヴィーナ。ベアードを殺したサルカズたちが、どうしてこんな風に堂々と都市から去ることができるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "これはドクターとウィシャデルさんが勝ち取った最善の結果です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "ロンディニウムがこれ以上戦火に耐えることはできません。もう十分に……犠牲は払いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デルフィーン",
      "text": "ヴィーナさん……あなたが一番よく分かっているはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "フッ……模範軍の全員に軽率な行動は取るなと伝えるんだ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィーナ",
      "text": "ドクター？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ロドス本艦は同時に複数の公爵から招待を受けた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼らは、我々に戦後処理会議の傍聴をしてほしいらしい。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "処理……サルカズどもが我々の目の前から完全に撤退する前にか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "奴らはそんなに焦っているのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "今この都市が、以前と変わらず奴らにいいようにされるがままだとは思うわないがな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼らもそのことはよく理解している。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "だからこそ、彼らは君を選んだ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "チッ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君は断ることができる、ヴィーナ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "ドクター、ここは私の家なんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "ヴィーナさん、決めたんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "模範軍の戦友たちを率いて都市内に突入したあの瞬間から、これはすでに定められていたことだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "彼らはそれをよく理解している。私もだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "デルフィーン",
          "text": "これは決して簡単なことではありません。ですが私はあなたの決定を支持します。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ではロドスは会議に「出席」しよう。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我々は君のそばに立つ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "感謝する、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "ということはつまり、私にとっての最大の挑戦はこれからということだろう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "ハッ、あいつらのご立派な口からどんなことが吐き出されるのか、楽しみだな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "すぐに君と合流する。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ヴィーナ",
          "text": "……家に帰るのはいつも気楽なものとは限らない。そうだろう？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
