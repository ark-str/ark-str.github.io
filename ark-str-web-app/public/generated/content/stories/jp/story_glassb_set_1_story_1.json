{
  "server": "jp",
  "storyId": "story_glassb_set_1_story_1",
  "groupId": "story_glassb_set_1",
  "stageId": null,
  "title": "さあ、行こう",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_glassb_1_1.txt",
  "sourceHash": "bacfcb840be17c6d43befe0946ae7c1736ddd42af26befa509226aaca0d3134b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "真理个人剧情"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "アンナ、今何時だと思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……アンナ！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ソニア、見ての通り、今服のコーディネートで忙しいのです。時計ならあなたの後ろにありますから、自分で確認したらどうですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "もう11時40分だぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "そうですね、わざわざ知らせてくれてありがとうございます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "わざわざって、オマエ自覚あったんだな？　時間のこともう頭にないのかと思ったぜ！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "前もって言いましたよ、コーディネートを考えるのは大変で、時間がかかるかもしれないと。お腹がすいたなら、先に食堂へ行ってお昼を食べていてください。私は後で一人で行きますから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "たかがグルメフェスティバルだろ、そこまで手間暇かけるもんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "ブースの店番すんのに、小綺麗な格好をしたいのは別に構わねぇけどよ、そんなに時間かけることもねぇだろ？　もう三十分も経ってるんだぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "長いですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "短いのかよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ブースのテーマと合わせるためですから、多少の時間は費やすべきだと思いますが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "テーマは「ウルサス風味のスイーツ」、それだけだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "アタシに言わせりゃ、ウルサス人のオマエがブースに立ってれば、たとえロドスの制服姿だってテーマに合うってんだ。それをいつまでもうだうだと……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ソニア、待ちきれないようなら、ここで時間を無駄にすることはありませんよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "ふんっ、上等だ。アタシは飯を食いに行くぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "そんなこと言って、まだそこで本を読んでいるのは、私を一人きりにしないためでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "無理して付き合わなくてもいいのですよ、ソニア。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "もう行く。何か買ってきてやろうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "大丈夫です。後で自分で食堂へ行きますから。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "帰ったぞ――"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "アンナ……まーだ服選んでんのかよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "もうすぐ終わります。何もなければあと10分ほどで。残るは髪留めだけですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "そーかよ。そりゃお速いこった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ソニア。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "終わったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "このリボンを見てください。全体のコーデとは調和しますが、少々地味だとは思いませんか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……何が言いたい？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "一工夫加えればもっと良くなるかと。ちょうど古い服から取り外したレースの縁飾りを見つけたので、リボンに縫い付けたらきっと可愛くなるはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "アタシを見んなよ。裁縫なんてできねぇぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "では自分でやりましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "オマエだって裁縫は素人だろ、アタシが知らないとでも？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "コホン。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "実践したことはありませんが、関連の書籍なら何冊か読んだことがあるので、基本的なやり方は知っています。レースもたくさんありますし、まずはタオルなどで試し縫いをすればいいでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "そんで、それはどんくらいかかるんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "……1時間くらいでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "アンナ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "午後は焼き菓子用の材料を運ばなきゃいけねぇんだぞ！　忘れてんのかよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "力仕事をするのはアタシとロザリンだが、具体的に何をどんだけ運ぶかは、企画者のオマエが決めなきゃなんねぇんだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "アタシたちが参加するのは「グルメフェスティバル」なんだから、グルメが最重要だろうが。服なんてのは、時間があれば準備して、なけりゃ適当に済ます、そういうもんだろ？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ソニア、午後の段取りを心配しているのなら、これをどうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "あん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……この紙きれは？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "材料リストです。昨晩徹夜して書きました。作るスイーツと、それに必要な材料はすべて書いてあるので、よろしくお願いします。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "それから、あなたの意見はもっともです。確かに、食品自体の方が装飾よりも重要です。でもだからといって、外見はどうでもいいということにはなりません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "仮にナターリアがクッキーを焼いたとして、味はおいしいのに形はグチャグチャだったなら、ラーダの焼いたものと比べてどちらを選びますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "はぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……どーせ口ではオマエにゃかなわねーよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "そういうことで、アタシはロザリンのところへ行ってくる。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "気を付けて。後で私も手伝いに行きます。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ふぅ……どうなることかと思いましたが、なんとかレースは縫い付けられました。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "（ラーダ、ごめんなさい。あなたが隠していたおやつを食べてしまいました……明日倍にして返しますね。）"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "もう二時ですか……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ソニアとロザリンの様子を見に行かないといけませんね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ナターリア？"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "こんにちは、アンナさん――そんなに急いで、どこへ行くの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "こんにちは。ロザリンを見ませんでしたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "ロザリン？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ええ。ロザリンとは、今日の午後ソニアと一緒に小麦粉などの材料を運んでもらう約束をしていました。ですが、見当たらなくて。ソニアと探したんですが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "彼女なら訓練室にいると思うわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "見かけたんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "本人は見てないけれど、訓練室の入り口に蜜無しハチミツ味ジュースが二本並んでいたの。あれを飲むのは、ロザリンとビーハンターさんくらいしかいないんじゃないかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ありがとうございます、ナターリア。たしか、午後は授業があるはずでは？"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "心配ないわ、まだ時間はあるから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "そうだ。ブースの申請の件だけど、アンナの希望は、ブースの周囲にはできれば飲み物のブースがないこと。それから出入り口から近いこと。そうよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "はい。実はもう一つ、ブースの面積をなるべく広くとりたいと考えていますが、それは私たちの方で決められることではないですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "参加者が多いようであれば、拡げるのにも限界があります。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "分かったわ。じゃあ授業が終わったら、クロージャさんの所へブースの相談に行こうかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "お手数をおかけします。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "いいのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "だけど、アンナが勉強以外の事でこんなに熱心になるなんて、初めてじゃないかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "それは、褒めてるんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "そうではなくて？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ありがとうございます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "頑張ってね、アンナ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ありがとうございます、ナターリア。お互い頑張りましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "――ああそれと、ロザリンを訓練室から連れ出せるといいわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "見通しはちょっと悲観的な気もするけれど。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "次は、何を焼くの～？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "クリームチーズパイです。生地はもうプレートに並べたので、最後のフルーツカスタードケーキが焼き上がったら、入れ替えてください。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "わかった！　イースチナお姉ちゃん、手伝ってくれてありがとう！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "いいえ。当然のことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "グム、本当にうれしいの！"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "イースチナお姉ちゃんはブースの飾り付けで忙しいのに、リェータお姉ちゃんを捕まえて来てくれたし、さっきは温室へ行って食べごろの新鮮な苺まで採ってきてくれて……"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "大丈夫？　疲れてない？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "そうですね、確かに楽とは言えませんが。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "やっぱり！　お姉ちゃんは宿舎に帰って本を読んでてもいいよ！　グム、一人でちゃんとできるから！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ええ、私もグムなら一人でできると信じていますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ですが、やはり一人よりは二人でやった方が効率がいいというものです。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "イースチナお姉ちゃんって、すごいよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "え？　何がです？"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "グムはね、グルフェスはおいしいスイーツを焼いて、みんなが楽しく食べてくれればそれでいいのかなって思ってたんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "けどお姉ちゃんはグムに教えてくれたの……ブースを完璧に仕上げるには美味しいものだけじゃダメで、テーマに合わせたデザインやコーデとかも、色々考えなくちゃならないって。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "それを思いつくだけでもすごいのに、ぜーんぶ引き受けて、そのうえ時間を作ってズィマーお姉ちゃんとグムの仕事も手伝ってくれて……"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "今まで気にかけてなかったけど、イースチナお姉ちゃんって、本当にすごいよね！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "そこまで言われると恥ずかしいです、ラーダ――"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "――ごめんなさい。あなたはコードネームで呼ばれる方に慣れていますよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "気にしないで！　イースチナお姉ちゃんにならどっちで呼ばれてもいいよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ありがとう、グム。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "（ラーダにこんな風にほめられるとは……恥ずかしい。）"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "（しかも、お昼に彼女のおやつをこっそり食べてしまったというのに……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "グム。あなたに告白しなければならないことがあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "ん、なーに？　イースチナお姉ちゃん。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "実は、お昼のとき服のコーディネートを考えるのに忙しくて食堂に行けなかったので、グムが宿舎のリビングの棚にしまっていたおやつを食べてしまいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "え？　あそこにおやつを置いた覚えはないよ～？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ですが、確かにカボチャ味のクッキーがありました。あなたは確かカボチャ味のものにハマっていましたよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "カボチャ味……うーむ……"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "ハッ……イースチナお姉ちゃん……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "えっと――グム、どうして突然そんな渋い顔に……"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "そのクッキーって……苦くなかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "その……コーヒーと一緒に食べましたから。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "たぶん、焦げたカボチャクッキーだよ、それ……今朝、失敗したやつ……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "！"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "焦げちゃったけど、捨てるのはもったいないから、何かに使えないかなと思って棚に置いておいたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "食べても平気だけど、でも……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "グム、それ以上言わなくていいです、分かりました……"
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "speakerId": "char_196_sunbr",
      "text": "っと、イースチナお姉ちゃん！　ここはグムに任せて、帰って休んでて！　全部焼き終わったら、みんなに試食するように伝えとくから！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ウルサス要素だけでは、やはり少し味気ないですね……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "何か付け加えてみましょうか。例えば……ミステリー、とか？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "しかし、服装だけでミステリー要素を表現するのはやや無理がありますね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "では、スイーツにひと仕込み……ふむ、絶対にだめですね。本当に事件になったら大変です。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "となると、単に飾り付けに取り入れる――"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "それだけじゃ悔しい気も……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "そうだ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "イースチナは本棚から一抱えの本を取り出した。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "これらの本も使えば、何か考案できるかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "『容疑者イリイチの死』、これは使えませんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "うーん……そうですね。この本の組み合わせなら――"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "アイデアとしては良さそうです。これなら上手くいくでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "残りの本は下に敷いて、と。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "あとは何かシンボルマークとなるものを数点……チェス盤とか？　探してみましょう……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "お帰りなさい、ソニア。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "今度はまた何してんだ……？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "新しいアイデアです。グルメフェスティバルのブースのレイアウトを改修しているんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "ブースのレイアウト？　あー……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "（小声）考えただけで頭が痛くなる。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "聞こえましたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "お、これは、『容疑者イリイチの死』？　この本は借りたことがあるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "私がお薦めしたんですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "忘れてたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "では、本に登場したトリックは覚えていますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "印象にねぇな。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "犯人の名前は？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "思い出せねぇ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "……一体何を読んだんですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "小説なんて、読み終えたら頭から消えちまうもんだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "なんでストーリーまで覚えてなきゃならねぇんだ？　小説家になりたいわけでもねぇのに。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "結構です。あなたに現実的ではない期待をした私のミスです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "（口笛）"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "話を戻しますが、ブースの配置に謎解きを組み込ませてみました、その元となるのがこれらの本です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "『十人のドゥリン』『ビースト4』『五匹の小熊さん』……読んだことあるような、ないような……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ありますよ。ですが、その様子では何も覚えてなさそうですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "この謎解き、あなたならきっと解けると思っていたのですが……どうやら無理みたいですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "元から興味ねぇし。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "謎解きゲームが、幼稚な遊びに思えるからですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "単に興味が湧かねぇってだけだ。昼から荷物運んでて死ぬほど疲れてんだ、これ以上自分に負担をかけたくねぇ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "でしたらこうしましょう。グルメフェスティバル当日に、あなたがもし謎を解けたなら、一回だけ宿題を代わりにやってあげます。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ヒュパティア先生の授業、もう何度もサボっているでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "マジか、乗った！"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "逆に、もし解けなければ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "なんだよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "罰ゲームを受けてもらいます。内容はまだ未定ですが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "へっ、罰ゲームなんざ怖くねぇよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "じゃあアタシは部屋に戻っから。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "もう帰るんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_195_glassb",
      "text": "まだなんかあんのかよ？　くったくただから、もう寝るぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "一冊ぐらいは目を通して、謎解きの準備をするかと思いましたが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_195_glassb",
      "text": "んなことしなくても絶対解けるって！　睡眠確保の方がよっぽど大事だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "そうですか。では幸運を祈っていますよ、ソニア。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_195_glassb",
      "text": "うぃー。"
    },
    {
      "type": "narration",
      "text": "ズィマーは自分の寝室に向かって数歩進んだところで、きびすを返しイースチナの元へ戻った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "じゃなかった、アンナ。朝から聞きたかったんだけどよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "なんです？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "オマエがイベントごとに、ここまで熱心になるのは今まで見たことがねぇ。ラーダよりも執心で、すべてを完璧にしようとしてる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "それはどうしてだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "どうしてだと、思いますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "うーん……ラーダを喜ばせるためとか？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ラーダが喜ぶのはもちろん良いことです。でもハズレ、それは主な理由ではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "スイーツを爆売れさせるため？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ソニア、忘れたのですか？　フェスティバルで出す食べ物は無料ですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "じゃあ他にどんな理由があるってんだよ？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "……一生懸命に打ち込む感覚を、味わってみたかっただけですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "一生懸命だ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "頭がイカレちまったのか？　昔のあの日々じゃ物足りねぇってか？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "別物ですよ。いいですか、ソニア。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "あの頃は……"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "あの頃、みんなが一生懸命になってたのは、ほんのわずかでも気が緩めば、持ち堪えられなかったからです。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "ですが、今は違います。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "今度全力をもって取り組むのは、ただの祭り騒ぎです。私たちがこうしたどうでも良いことに打ち込むのは、どれくらいぶりでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "グルメフェスティバル――食べることをメインとするお祭り。これほど愉快で、気負わなくていいことはない、そう思いませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "……で？"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "必要に迫られて頑張るのではなく、どうでもいいようなことに、単に楽しみのためだけに一生懸命になるのは、経験したことがありません……それを、やってみたいのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "フェスティバル当日は、きっと楽しいでしょう。"
    },
    {
      "type": "narration",
      "text": "ズィマーは肩をすくめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "オマエはもう楽しんでるみたいだけどな。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "そうですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "そうだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イースチナ",
      "speakerId": "char_195_glassb",
      "text": "……なら、そうでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "はぁ。何をそんなに浮かれてんのかアタシにゃ分かんねーけどさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ズィマー",
      "speakerId": "char_115_headbr",
      "text": "しっかり楽しみな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーディ",
      "speakerId": "char_209_ardign",
      "text": "うわぁ、グルフェスってこんなにブースがあるんだぁー。こんなの食べきれないよぉ……"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "カーディ、落ち着いて。急いでがっつくことはないよ、フェスティバルは一日中やってるからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "speakerId": "char_121_lava",
      "text": "なんでこんな時までついて来るんだよ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "speakerId": "char_120_hibisc",
      "text": "ラヴァちゃんはこういう時こそ、食生活に気を配らなきゃダメなんだよ――"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_211_adnach",
      "text": "この独特な甘み――"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_211_adnach",
      "text": "このお菓子について教えてください！　フルーツカスタードケーキという名前ですよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_211_adnach",
      "text": "それとこっちの苺のケーキも！　詳しいレシピと材料の分量も教えていただけると嬉しいです！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロサ",
      "speakerId": "char_197_poca",
      "text": "ええ、喜んで……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "speakerId": null,
      "text": "クンクン！　おいしそうな匂いがする！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "speakerId": "char_2013_cerber",
      "text": "わ！　すごい人、それに食べ物がたくさん！"
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "speakerId": "char_2013_cerber",
      "text": "あっちの甘いのはクマちゃんが焼いたやつかな？　いい匂い！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァルカン",
      "speakerId": "char_163_hpsts",
      "text": "ケーちゃん、待て！　そんなに走らない！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "speakerId": "char_108_silent",
      "text": "あの苺のケーキ、どうだった？　グムが持って来た途端、皆に取られちゃって。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィリオプシス",
      "speakerId": "char_128_plosis",
      "text": "とてもおいしかったです。"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "speakerId": "char_108_silent",
      "text": "イフリータはどう思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "speakerId": "char_134_ifrit",
      "text": "……辛さが足りねぇ……"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "speakerId": "char_134_ifrit",
      "text": "それより、あの明るい髪のヤツ、キレーな服着てんな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "よく見てなよ、ポプカルちゃん――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ポプカル",
      "speakerId": "char_281_popka",
      "text": "スイーツを、お空に投げて、跳んで、お口でキャッチ――すごい！"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "やってみたい？　じゃあ教えてあげ――"
    },
    {
      "type": "dialogue",
      "speakerName": "カタパルト",
      "speakerId": "char_282_catap",
      "text": "うぐっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "オーキッド",
      "speakerId": "char_278_orchid",
      "text": "ポプカルに危険行為を教えないでよ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "speakerId": "char_242_mayer",
      "text": "マゼランちゃんの味覚が変わってることは知ってたけど、まさかここまでとは……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "speakerId": "char_242_mayer",
      "text": "おっ、あそこは謎解きをやってるのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "speakerId": "char_242_mayer",
      "text": "これは見に行かなきゃ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "ドクター。イースチナさんたちが考えた謎解きをどう思いますか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（イースチナはすごいな。）",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（複雑な謎じゃないが、作り込まれてる。）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "（グルメフェスティバルにぴったりだ。）",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "ドクター、どうしたんですか？黙り込んで……"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "（モグモグ）",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "少し節制してください。食べすぎですよ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "speakerId": "char_284_spot",
          "text": "グルメフェスティバル、もう終わったのか……"
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "speakerId": "char_284_spot",
          "text": "ミッドナイトに声を掛けてくれって頼んでたのに、あの野郎、何も言わずに抜けかけやがった。"
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "speakerId": "char_284_spot",
          "text": "ああ、徹夜で漫画を読むんじゃなかったな。"
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "speakerId": "char_284_spot",
          "text": "ん？　あそこに居る女の子たち、ブースの片付けもしないで何を騒いでるんだ？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "speakerId": "char_284_spot",
          "text": "ここからじゃ会話は聞き取れな――あ、階段裏のかき氷ブースの方へ行ったのかな、これで様子も見れなくなっちまった。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マゼラン",
          "speakerId": null,
          "text": "うん、缶詰はまだたくさんのこってるよ！　はいどうぞ！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "speakerId": "char_115_headbr",
          "text": "（深く息を吸う）"
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "speakerId": "char_115_headbr",
          "text": "うおおおおおおおおお！！！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "speakerId": "char_284_spot",
          "text": "これが、うわさに聞くウルサスの雄たけびなのか……"
        },
        {
          "type": "dialogue",
          "speakerName": "スポット",
          "speakerId": "char_284_spot",
          "text": "感服するぜ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "「現実エクスポージャー式トラウマ記録セルフ診療装置」のカメラに向かって、イースチナが話している。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "微かにそんな予感はしていましたが、まさか本当にソニアが謎を解けなかったなんて。あんなに簡単だったのに。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "提案者はロザリンでしたが、みんなの同意の下、罰ゲームとしてソニアにはマゼランさんの看板メニュー、缶詰風味かき氷を食べてもらいました。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "マゼランさんのかき氷ですが、他の味はすべておいしいんです。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "ただ、看板メニューの缶詰風味かき氷だけは——"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "何と言ったらいいんでしょう。ソニアがかき氷を口の中に入れたときの表情は……"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "ぷっ……言葉では言い表せません。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "今日は本当に楽しかったです。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "人混みの中で、みんなの笑顔を見ながら、自分と全く関係のない楽しそうなお喋りを聞いて……"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "普段の私なら、こういったことは避けるとは言わないまでも、それを楽しむことなど無かったでしょう。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "ですが、今回のイベントに全力で取り組んだ結果、混乱や喧騒のすべてが意味あるもののように思えて、それらは私の努力の報酬となりました。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "疲れる準備さえも、今思い返してみれば、ちっとも面倒だとは感じられないのです。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "どんちゃん騒ぎに全力を注ぐのは、本当に、楽しいことですね。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "チェルノボーグでも、かつてはいくつかの高校が集まって、似たようなイベントを開くことはありました。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "その頃の私は、読書と比べたらそんなのちっとも面白くないと思っていました。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "ですから、私はちょっと頭を使って雑務をうまくかわし、イベント当日も家にこもって一日中本を読んでいました。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "まぁ、大したことでもありませんが。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "すべての物事が通常通りだったら、そんなのは本当に大したことではないのです。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "だって、そんな行事、まだ次があるじゃないですか。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "たとえ卒業しても、OGとして参加したり、お客さんとして一般参加すればいいだけ……そんなありふれたことに、尽力する必要はどこにありましょう。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "けれど、私は予想だにしませんでした。本当に思ったこともなかったのです。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "まさか、次が……来ないことになるなんて……"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "もう、二度と……"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "イースチナは思い切り首を横に振った。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "ですから今日のグルメフェスティバルは、しっかりと心血を注いで準備しました。一種の……記念といえるでしょうか？"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "事実、私の努力は無駄ではありませんでした。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "たくさんの人と協力して行うイベントで、こんなにも楽しかった経験は今までありませんでした。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "またこのようなお祭りがあっても……"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "今日のように楽しいものになるとは、断言はできません。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "ですが、きっとまた参加すると思います。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "では、今日はここまでにします――"
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "speakerId": null,
          "text": "アンナ、帰ったぞ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "ソニアですか、どうぞ入ってください。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "本当に楽しい一日でしたね？"
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "speakerId": "char_115_headbr",
          "text": "ああ、もちろんだ！"
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "speakerId": "char_115_headbr",
          "text": "楽しいといえばよぉ、さっき食い物がちょっとばかし残ってたのに気付いてさ、自治団のみんなで分けて食ったんだ。オマエの分も残してやったぞ。"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "ボルシチですらナターリアにすべて飲み干されたのでは？　他に何が残っていたんですか？"
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "speakerId": "char_115_headbr",
          "text": "マゼランの缶詰に決まってんだろ！"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "！！！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "イースチナ",
          "speakerId": "char_195_glassb",
          "text": "もう寝ます。おやすみなさい、ソニア。いい夢を――"
        },
        {
          "type": "dialogue",
          "speakerName": "ズィマー",
          "speakerId": "char_195_glassb",
          "text": "オイ逃げんなよ、食ってねぇのはあとオマエだけなんだからな――"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
