{
  "server": "jp",
  "storyId": "act20side_level_act20side_07_beg",
  "groupId": "act20side",
  "stageId": "act20side_07",
  "title": "生きる道",
  "storyCode": "IC-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act20side/level_act20side_07_beg.txt",
  "sourceHash": "f2ff0237399bade4d36832528137829810bb2bbb908ceb0cb1ed6b4d094a720e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "ところでエッジ先生、ちょっと気になってるんだけど、スディチくんのお師匠さんってどんな人だったのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "お前がついてきたのはきっと別の目的があってのことだとわかっていたさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "随分とスディチの小僧を心配しているようだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "アハハ、お見通しだったみたいだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "僕はそういう人間だからね。みんなには和気あいあいと仲良くやってほしいんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "ならばお前はきっと、あいつの師匠を気に入るだろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "ヴィンチ・ブランクキャンバスという名で、ゼルウェルツァで一番人気の建築デザイナーだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "彼のデザインは、ドゥリンで流行っているスタイルとは一線を画していたが、彼が自分のデザインを言葉で表すと、いつも皆が心を掴まれたものだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "例えば、何と言っていたかな。確か「際限なき欲望に抗え！」だったか。そんな調子だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "彼の理論は独特だったが、ゼルウェルツァの者たちは皆、彼のことが好きだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "そんな人がどうしてゼルウェルツァを去ってしまったんだい？"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "わからん。"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "え？"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "彼は突然去ってしまったんだ。誰にも理由を告げずにな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "それは……おかしな話だね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "残された弟子は、才能に関しては誰もが認めているが、人となりはと言えば……まあ、見ての通りだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "アハハ、それも彼の師匠が突然去ってしまったことと、何か関係があるのかもね。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "かもしれないな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "お？　結果が出たんじゃない？"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "うむ、どれどれ……"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "はぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "エリジウム",
      "speakerId": null,
      "text": "どうだった？"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "ああ、ほとんど予想通りだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "私たちに残された時間は、一ヶ月程度だな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "一ヶ月？　昇降機を拡張するには充分だな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "来たか、ガヴィル。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "ああ、だがアタシの手伝いはもう必要なさそうだな？"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "うむ、観測はここまででいいだろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "アヴドーチャは説得できたのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "ああ、ゼルウェルツァの住民たちに働きかけてくれるってよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "そうか、ならばあとは、正式に住民の皆にこの状況を知らせるだけだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "地上へ向かう件だけでなく、ドームの件も片づけなければならん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "ん？　ドームがどうしたんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "おっと、お前たちがドゥリンではないことを忘れるところだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "ドゥリン人の都市が災害に遭うことはめったにないとはいえ、我々も一生に一度くらいは自分の住む場所の壊滅を経験するものだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "だから故郷を去るということに対しては、特に何も感じない。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "むしろ我々は、自分たちの都市が最高の状態で滅びの時を迎えられるように、離れる前に整えるのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "そいつはカッケーな！"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "そうか？　我々にとっては、当然のことなんだがな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "ドームのあの穴については、これまで放置しておく理由があった。しかし今は何とかしなくてはならん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "ドームっつーと、スディチはどうした？"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "speakerId": null,
      "text": "ん？　お前たちと一緒ではないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "あ？　お前たちのとこに行くっつってたぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "speakerId": null,
      "text": "ガヴィルさん、スディチさんを探してるんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "あいつがどこ行ったか知ってんのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "speakerId": null,
      "text": "はい。来る途中で会いましたけど、何も言わずに洞窟の外に行ってしまいましたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "speakerId": null,
      "text": "は？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "地図があると得意げに言っておきながら、今になって「その地図は多分この書架のどこかにある」ですって？"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "ゴホンッ、仕方のないことなのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "わらわは地上に戻ることに微塵も興味がありませんもの。図書館の本の中に、先人が記録した地図があることを覚えていただけでも、貴方がたはわらわに感謝すべきですわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "時間はまだある。もしあの洞窟内がお前たちの言うように複雑なのであれば、ここで少しくらい時間がかかろうと構わない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "それで、その本のタイトルは覚えているか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "忘れましたわ。ですが微かな記憶ではおそらく旅行記だったような気がいたします。ドゥリンの作者が地上で経験した様々な出来事が書かれてありましたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "それを聞いても意味ないでしょ、私たちはドゥリン語が読めるわけでもないんだし。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "読めはしないが、忘れないでくれ。私にはこの友人たちがいる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "speakerId": null,
      "text": "ズゥママ、ズゥママ、手伝イ必要？"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "アヴドーチャが言っていた、地上へ向かう洞窟の地図が記録された旅行記を探しているんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "speakerId": null,
      "text": "図書館ハ書籍整理サレナイ、捜索難易度高メ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "見つけてくれたら、お前たちに入念なメンテナンスをしてやろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボ0429",
      "speakerId": null,
      "text": "ズゥママ、トモダチ！　ズゥママ、助ケル！"
    },
    {
      "type": "dialogue",
      "speakerName": "奇怪なロボット",
      "speakerId": null,
      "text": "ズゥママ、助ケル！　ズゥママ、助ケル！"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "そう、じゃああんたたちで頑張ってちょうだい。私は外で待ってるから、何かあったら呼んで。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "ああ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "それと……じいや。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "speakerId": null,
      "text": "ほいほい、なんじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "手伝ってくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "こいつは……！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "私の友人だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "speakerId": null,
      "text": "ズゥママ、まずはわしに、ドゥリン語がわかるかどうか尋ねるべきではないかのう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "わからない可能性があるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "speakerId": null,
      "text": "ふむ、地下のことについてちゃんと教えてやらなかったのを、まだ根に持っておるのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "speakerId": null,
      "text": "しかしのぅ、ズゥママ。もしわしの知っていることをすべて教えようとすれば、お主が移動都市を作り出せるようになったとしてもまだ話し終わらんじゃろうて。"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "speakerId": null,
      "text": "個人的に思うんじゃよ、知識を得るにも加減が必要じゃと。まぁわしは人間ではないがな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "手伝うのか手伝わないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "speakerId": null,
      "text": "見つけたらわしを許してくれるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "いいだろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "あら、イナム、どうして図書館の入り口で突っ立ってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "人を待ってるのよ、あんたは？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "図書館の管理者に呼ばれてね。ここの改築について話し合うんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "彼はだいぶ前から改築をしようと思ってたらしいんだけど、ずっと先延ばしにしてたから、今回がいい機会なんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "……前からちょっと気になってたんだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "先の放送からもう半日以上が経ってるわ。都市のドゥリンたちが驚かないのも疑問だけど、まぁ置いといて。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "どうしてみんな自分の家を改築しようとするの？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "ん？　あ〜、あなたは地上人だから、理解できないかもね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "あなたたちは都市を移動させて災害から避難するんだよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "ええ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "でも私たちは違うんだよ。私たちの都市は移動できない。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "地下に建てられた都市を移動させるのは、かなり困難でしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "でも実は、そういう都市を建てようと考えた人もいるんだって。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "ほら、もしドームに岩や壁を砕く機能を加えて、都市にシャーシを取り付ければ、実現不可能ではなさそうでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "うーん……建築には詳しくないけど、それは私たちの移動都市よりクレイジーね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "本当にそんな都市を作った人がいるなんて話は、聞いたことがないけどね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "とにかく、私たちの都市は移動できないんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "だけど、どの都市にも源石鉱脈を探知する設備があって、源石鉱脈を付近で検出すると、警報を発するんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "その設備って、天災トランスポーターの代わりにもなるんじゃないかしら……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "天災トランスポーターの存在に関しては聞いたことがあるよ。でも実際はちょっと違うんだ。なぜならその設備は、源石鉱脈の動きを探知するだけだからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "それもそうね。聞く限りでは、源石鉱脈は発見から活性化までにはしばらく時間がかかるらしいし。もし今回みたいな特殊な状況でなければ、あんたたちが避難する猶予はたっぷりあったでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "でも天災は、兆候を見つけた時点で、そんな猶予はすでにないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "だからあんたたちは、都市を放棄することに慣れてしまったの？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "実は真逆なんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "ドゥリンはこの土地のすべてを愛しているんだ。機械も建築物も、建造した都市の一つ一つを愛しく思っているんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "だけど災害が避けられないなら、私たちの都市は滅びる定めだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "この現実に向き合うため、私たちは一つの命題について考える必要があった。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "住民は確かに災害によって都市を離れるだろう。でもその災害は一時的なものであり、別のドゥリン、または彼らの子孫が再びこの土地にやってくるはずだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "彼らは都市の亡骸を見て、この地で起きた災害に嘆き悲しむだろうけどさ、かつてこの都市で生活していた者として、私たちが彼らに感じてほしいのは、本当にそれだけか？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "逃れられない運命に対して、私たちは服従するしかないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "そんなことは受け入れられない。だから私たちは――"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "災害が来る前に、自分たちの都市がどのような姿で破滅を迎えるかを決めるということにした。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "後世の人たちには、私たちの技術の結晶を賛美してほしい。私たちが残した痕跡に驚いてほしい。私たちの功績を称えながら美味しいお酒を飲んでほしいんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "他の滅びた都市を見た時に、私たちがそうするのと同じように。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "もちろん故郷を離れることは悲しいよ。だけどドゥリンはもう、その悲しみには慣れちゃったんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "それよりも、都市の最後をなにより輝かしい姿にしてあげるのが、私たちにとって、なによりも意味のあることなんだよ。そう思わない？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "これこそ都市に――いわゆる死化粧を施すってことなんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "それはまあ……ロマンティックな考え方ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "もちろん、もっと直接的な理由もあるんだけどね。主要な工業装備とロボットたちの助けがあれば、私たちは数ヶ月であっという間に新しい都市が作れちゃうんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "speakerId": null,
      "text": "でなきゃ、こんなこと考えたりしないって。"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "アハハ、それもそうね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イナム",
      "speakerId": null,
      "text": "あら、あれは……スディチ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "これは……違いますわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "これ……も違いますわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "これは……あら、この本がどうしてこんな場所に？　のちほど持って帰るといたしましょう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "それは、カジミエーシュの騎士小説……お前の本か？"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "あっ。貴方はこれが何かわかるのでしたわね……"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "ええ、そうですわ、わらわが地上から持ってまいりましたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "そういえば……"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "お前のようなウルサス人が、一体どうやってウルサスからドゥリンの都市まで流れ着いたんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "家の者は、栄誉とは程遠い貴族同士の争いで死に、わらわは故郷を追われましたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "殺し屋を差し向けられましたのよ。それで、追い詰められたわらわはとある洞窟を見つけ、中に身を潜めようと飛び込みましたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "そこはこの昇降機の上にある洞窟と同じように複雑で、偶然わらわは地底に通じる昇降機を見つけましたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "そうして、運良く生き延びたんですわ……単純な話ですの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "そうか、それは確かに運が良かったな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "……他に感想はございませんの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "私にどんな感想を望んでいる？"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "……はぁ、貴方はやはり、あのガヴィルさんのご友人ですわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "似たような話は、ロドスでもたくさん聞いたからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "お前が生き延びたこと自体、相当な幸運だったと言える。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "それにゼルウェルツァは良い場所だ。このような場所で生活できるというのは、素晴らしいことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "……そうですわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "わらわは、自分がこの境遇にもっと忸怩たるものを感じ憤るだろうと思っていましたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "ですが……わらわの家は潔白で、両親も普段から慈悲深く善行を施していたにもかかわらず、よこしまな者に逆恨みされただけなのでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "もちろん違いますわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "わらわの父は、最期の瞬間まで自分の家族を心配するのではなく、敵を呪っておりましたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "そして母は、最後まで帰ってきませんでした。わらわが家の裏口から逃げるその瞬間も。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "わらわは……ウルサスの貴族社会にありがちな陰謀の余波で人知れず消えた、取るに足りない者でしかありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "貴方のおっしゃる通り、わらわはとても運が良かったのですわ。ですから、わらわはこのやっとの思いで手に入れた幸運を、大切にしなければなりませんのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "確かにな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "お前、本当はガヴィルと派手にやり合いたいんじゃないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "……どうしてそう思われますの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "お前は彼女の説得に応じたが、よくよく考えてみると、本当に言いたいことは言っていない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "彼女ともう一度議論をしたくても、タイミングを逃し、言葉を飲み込むしかなかったのだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "これまで、ガヴィルのあの性格に腹を立てる奴を山ほど見てきた。私だって時々そうなる。アヴドーチャ、お前は最もわかりやすく腹を立てる奴の一人だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "……ええ、認めますわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "わらわは、ガヴィルさんのような方を見たことがございませんの。彼女には……お手上げですわ。ウルサス人としても、ドゥリン人としても。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "もし本当にぶちまけないと気が済まないことがあれば、私に言ってくれて構わない。私を手伝ってくれているわけだし、代わりに彼女に伝えてやってもいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "……結構ですわ、わらわはそこまで落ちぶれてはいませんのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "ですが、一つ提案がありますわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "わらわは地上の生活に戻るつもりはありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "ですから、危機が去った後は、ドゥリンの方たちに地下へと戻るよう説得いたします。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "もちろん、一度築いた関係を簡単に断ち切ることは難しいですわ。今後一切やり取りをしないなどということはほぼ不可能でしょう。この点についてはわらわも承知しております。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "それに、貴方がたアカフラのティアカウは、交流しても問題のない相手かもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "ですから、ドゥリンが再び地下に自分たちの都市を築いた暁には、わらわは貴方がたに、何もないジャングルから地下に居を移すよう勧めたいと考えておりますの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "そうなればきっと、ガヴィルさんのような方であっても、ドゥリン族の社会がどれほど素晴らしいものか理解できるはずですわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "うーん……それは遠慮しておこう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アヴドーチヤ",
      "speakerId": null,
      "text": "どうしてですの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "speakerId": "char_416_zumama",
      "text": "まずは地図を見つけてからにしよう。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
      "speakerId": "char_416_zumama",
      "aliases": [
        "ユーネクテス"
      ]
    }
  ]
