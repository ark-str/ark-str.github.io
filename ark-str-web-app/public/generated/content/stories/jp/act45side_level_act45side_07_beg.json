{
  "server": "jp",
  "storyId": "act45side_level_act45side_07_beg",
  "groupId": "act45side",
  "stageId": "act45side_07",
  "title": "永遠に輝くアルバム",
  "storyCode": "SS-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act45side/level_act45side_07_beg.txt",
  "sourceHash": "87fa92ed4dc6c79d04fd8ccd4a3fd74cd9a3af7d33acfce02b164e3dfbdfce86",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "上手になったわね、祥子ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "そうかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "祥子ちゃんが成長したことくらいわかるわ。お母さんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "お仕事がどんなに大変でも、ピアノだけはずっと頑張ってきたんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "お母様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "祥子ちゃん、外で色んな経験をしてきたのよね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "父",
      "text": "練習の邪魔して悪いけど、ご飯ができたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "美味しい……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "父",
      "text": "どうだ、お父さんなかなか上手だろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "祥子ちゃんは知らないでしょうけど……この味になるまで、何度も試食させられたのよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "父",
      "text": "このサラダ、味見してみてほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ん――美味しいですわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "父",
      "text": "なかなか上手だろう？　祥子が美味しいって言ってくれるように、何度もレシピを研究したんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "父",
      "text": "祥子の好きなご飯、まだまだ作ってあるからな。さあ、どんどん食べてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ええ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "う……うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "祥子ちゃん……？　祥子ちゃん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "父",
      "text": "ど、どうしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "少し、食べすぎましたわ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "祥子ちゃん、少しは良くなった……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "父",
      "text": "ごめんな、祥子。お父さんつい作りすぎちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "ほんと、清告さんったらいつもああなんだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "でもそれがあの人らしくて、可愛いところでもあるし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "祥子ちゃん、お父さんのこと許してあげてね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "お父さんはね、祥子ちゃんのことを愛してるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "もちろん、お母さんも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "二人のことを、心から愛してるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "お母様、どうして急にそのようなことを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "あなたが家を離れてから、昔のアルバムを見返すようになってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "生まれた時から、一歳、二歳、三歳……って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "そのような時のこと、もう覚えていませんわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "そうかもしれないわね。でも親にとっては、子供はずっと変わらずに、一番大切で、一番特別な存在なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "生まれたばかりのあなたは、手のひらが私の半分もなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "でも……ほら、今は私よりも大きくなったのね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "母は祥子の手を取り、二人の手のひらをゆっくりと重ね合わせる。\nひとりでに、祥子の指は母の手を強く握り締めていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "お母様の手、すごく温かい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "ええ、お母さんはここにいるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "お母様……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "泣いていいのよ、祥子ちゃん。昔あなたが泣いてた時、こうやって慰めていたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "……昔のわたくし、そんなに泣き虫でしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "小さい頃はね。あの頃の祥子ちゃんは、よくキャンディひとつで泣いていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "今はとても強い子になったけど、あの頃の祥子ちゃんは本当に泣き虫だったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "そ、そうだったかしら。そんな記憶、全くありませんわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "うふふ、お母さんは嘘ついたりしないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "では……お母様は、わたくしの高校の入学式を覚えてます？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "ええ、もちろん覚えているわ。あの日は清告さんと祥子ちゃんの三人で、校門の前で記念写真を撮ったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "そうでしたわね……懐かしいですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "ふふっ、ねえお母様、もっとお話を聞かせてくださる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "祥子ちゃん、今日はとても甘えん坊さんね。……それもそうね、久しぶりにお家に帰ってきてくれたんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "お家……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "ふふっ。それならもっとお話ししちゃおうかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "ええと、どこから話そうかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "豊川祥子",
      "text": "でしたら、わたくしが生まれたときから、ずっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "母",
      "text": "ええ、はじめから話すわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そうして、母と娘は肩を並べ、一歩ずつ歩調を合わせるように農地の間を歩いていた。まるで、いつまでもそのまま二人で歩いていけるかのように。\n過去の美しかった時と変わらず、ゆったりと歩き、どこかで立ち止まることもない。\n二人の手は、まるでお腹の中にいた頃のへその緒のように親子を繋いでいた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "祥子――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "よかった。祥子、ちゃんと家に帰れてたんだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ヴィグナさん、車の調子が何やらおかしいですわ！　いったん止めていただけませんこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "えっと……な、何これ！？　ロドスで習った操作方法と違うんだけど！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "ダメ！　止められない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アイリス",
      "text": "ぶつかってしまいますわ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベナ",
      "text": "祥子さんたち、早く避けて――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
