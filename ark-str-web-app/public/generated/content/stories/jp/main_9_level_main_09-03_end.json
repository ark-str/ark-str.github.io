{
  "server": "jp",
  "storyId": "main_9_level_main_09-03_end",
  "groupId": "main_9",
  "stageId": "main_09-03",
  "title": "一触即発",
  "storyCode": "9-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_09-03_end.txt",
  "sourceHash": "fa4a1fbc9a5e65d35770f2a0bb7341cf83903debf877afc579f1503d3581af0c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "はぁ、あんまり色々投げつけられちゃったから、結局ケリー大尉には追いつけなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "まあまあ、元気出して。ほら、ハンカチ貸してあげる！　ちゃんと拭いておかないと、腐った野菜の臭いが残っちゃうからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "わ、ありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "それにしても、自分から十七地区に来る人が、ケリー大尉以外にうちの軍にいるなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うちの軍って、おめーさんもヴィクトリア軍人なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "しーっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "えっと、あたしはこっそり抜け出してきてるから、制服を着てないんだけど、実はそうなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "そもそも、制服姿でここを歩いたりしたら、近くの住民の反感を買うしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "えっ、そうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "道理で、何も言ってないうちにまで腐った野菜とか果物とかを投げてくるわけだべ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "事情を知らないってことは、新しく派遣されてきた人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うん、そんな感じ。うちはロンディニウムから来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ロンディニウム？　わあっ、いいなあ～！　あたし、まだ行ったことないんだよね。きっとヒロック郡よりずっとおっきい街なんだろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ねえ、ザ・シャードのビルって本当に三百階もあるの？　王立科学アカデミーのある山に瞬間移動のアーツが埋まってるって本当？　初代ドラコ王の秘宝が眠る奇跡の空間に繋がってるって話だけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "わわっ、えっと、瞬間移動？　秘宝？　うちはどれも知らないや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "でも、組み上げ終わった高速陸上軍艦が工場から出てくるところとか……水耕栽培の工場とかなら見たことあるから、そういうのでよければ教えてあげられるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "軍艦？　に、水耕栽培……？　うーん……なんだか、小説の中のロンディニウムとはイメージが違うような――って、あっ！　ごめんね、すっかり話が逸れちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "とにかく、事件の調査をしたいなら、その格好じゃ、この辺の通りでは何も聞き出せないと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "多分、さっきみたいな結果になるっていうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "こんなふうに身体中臭くなっちゃうよってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ふふっ、そんな感じ。でも、そこまで臭くないから安心して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "そう？　ここの人たちとうちらの仲間って、よく衝突してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "んー、前は単なる小競り合いだったんだけどね。最近はなんか緊迫してきちゃってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あなたも聞いた通り、あたしたち兵士を狙った襲撃事件だって何度も起きてるし、みんなすっごくピリピリしてるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "――まさか、本当に亡霊部隊が……？　でも、何かおかしいべ。前は普通の兵士をターゲットにすることなんて、ほとんどなかったはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "亡霊……？　って、何の話？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……ううん、何でもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "そういえば、さっき巡回兵が、ここの人たちを「ターラーのクズ」とか呼んでたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ま、待って待って！　そんな言葉、ここで口に出しちゃダメ！　またあの人たちに睨まれてるよ……！　腐った野菜を投げられるなんて、もうたくさんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ありゃ……うん、わかった。それで、ここの人たちって、もしかしてヴィクトリア人じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "もちろんヴィクトリア人だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ええっ？　うち、こんがらがってきちゃった。どういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "彼らもヴィクトリア人だけど、人によっては敢えて別の言葉で、ええと、あなたも聞いたように――ターラー人、と呼ぶ人たちもいるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "地元の人たちと、兵士たちの大半は、そう呼んでるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "へえ～。言われてみれば、その「ターラー」って単語には見覚えがあるべ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "小説の中に出てきたとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ううん、歴史の教科書だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "なるほど。……あの人たちは、ずっとここで生きてきたからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "何百年も昔……あたしたちの移動都市はおろか、ヒロック郡という名前すらなく、青々とした草がどこまでも山あいを覆っていた頃。その時には既に、ここは彼らの家だったんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うちも覚えてるよ！　ドラコのゲル王の伝説……あれの発祥の地ってこの辺りだべ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "当時、ここら辺の土地はターラーって呼ばれてたんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "そうそう！　ふふっ、あたしも、ゲル王関係の伝奇小説はたくさん読んだなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "確か、ゲル王は当時のターラー人を率いて、初代アスラン王と戦争をしたけど、その数年後には、ロンディニウムの王様と平和条約を結んだって話じゃなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "だからその後は、ターラー人って言葉はあんまり使われなくなったんだとばっかり思ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ヒロック郡に来る前は、あたしもそう思ってたんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "まあでも、ヴィクトリアはずっと変化し続けてるでしょ？　あたしたちヴイーヴルだって、昔からここに住んでたわけじゃないけど、今ではみんなヴィクトリアの国民だし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "みんながみんなそう思ってたら、きっと衝突なんてほとんど起こらないんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "そんなに落ち込まなくてもいいのに。うちらがここにいるのは、本当の敵を見つけ出して、もーっと大きな衝突を防ぐためでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……だから、腐った野菜が飛んできても、帰ろうとしないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あははっ。今、うちのことバカだな～って思った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "ううん、そんなことない！　むしろすごいと思ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "さっきの巡回兵みたいな乱暴な振る舞いは、これまでたくさん見てきたの。止めようとも思ったんだけど……あたしは、ただの儀仗兵だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "――儀仗兵だから、何だっていうの？　おめーさんもヴィクトリア軍の一員でしょ。だったら、階級がなんだって関係ないよ。嫌な状況を変えることくらい誰だってできるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "……そ、そう……かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "っ……ありがとう。そんなこと言ってくれたのは、あなたが初めてだよ。……うん。次こそは、やってみる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あっ、そうだ。何かほかに手伝えることはないかな？　野菜の葉っぱを取ってあげる以外で……あたしも、これ以上衝突が激しくなるのは見たくないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "んーっと、それなら……おめーさん、この辺に友達はいる？　ダミアン・バリーさんが普段どこに行ってたのかを知りたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "友達……シアーシャなら何か知ってるかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェニー",
      "text": "あなたへの連絡手段を教えといてくれる？　あたし、新聞社に行って彼女に会ってくるよ。多分今日なら、あたしがいてもいなくても曹長は気にしないだろうしね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "――スカマンドロス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "はい、大佐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "君の父上にはお会いしたことがある――もう二十年以上も前に、カスター公爵が開いた舞踏会でな。無論、当時の私はまだ一介の衛兵で、伝説の白狼伯爵を遠くから一目見たに過ぎないのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "しかしその後、伯爵はロンディニウムの猛獣園で、奇形の羽トカゲに怯えて病を患らい、貴族のコミュニティーからも姿を消したと聞いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "以降は、ハーバーシティの荘園から一歩も出ていないとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "お父上はご壮健かな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "お気遣いに感謝いたします。ですが、どうか昔話はまたの機会に。大佐の貴重なお時間を無駄にしたくありません、何しろ、こうしてお会いするのも一苦労でしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ほう。君はお父上には似ていないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ええ、父には、大佐や私のように帝国軍へ尽くす機会がございませんでしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "しかし、本件――軍用源石製品の窃盗事件が父とは無関係であることを考慮しますと、父の晩年についてこれ以上お話しする必要はないかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "――「人の行く末は出自で決まる」。スカマンドロス、君はこの言葉をどう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "人には、自分の未来を選択する権利があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ふむ。君の身の上を鑑みれば、そう答えるのも当然のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "アスランの側近として重んじられた一族の末裔。王立前衛学校の優等生。ロンディニウム軍期待のエース――君は当然、自分の手で変えられないものなどないと思っているのだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "私は何かを変えたいなどとは思っていません、大佐。どうかご心配なく。我々小隊の到着は、ヒロック郡における大佐の指揮権には一切影響しませんので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "その冗談は笑えんな。まさか私が中尉なんぞに一目置いていると思うほど、傲慢なわけではないだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "君のような奴はごまんと見てきた。大口ばかり叩いておいて、結局すべてを投げ出すのが常だ。……私が君に会ってやったのは、警告するためだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "事情も知らずに手を出すな、とな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "申し訳ありませんが、同意いたしかねます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "我々が受けた命令はあくまで、盗まれた源石製品の行方を明らかにすることですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "大人しく在るべき場所に留まるのなら、君はすぐにでもその任を終え……大手を振ってロンディニウムへと帰ることができるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "結構です。そのような形での帰還など、私自身にもヴィクトリアにも必要ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "何しろ、裁判もせずにはねられた首のことをどう報告すべきなのか――私にはわかりかねますもので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ハハハッ！　君は私が平然と人を殺していると思っているのか？　――まさか、あの連中はまったくの無実だとでも？　笑わせてくれる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ならば聞かせてやろう。十日前のことだ、うちの兵士が無残に殺害された。ジェームズ・コーエン、ロバート・ボリス、ジェレミー・ブラウンの三名だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "コーエンの妻が、第二子を身ごもったと手紙に書いて寄越した時、まさか夫の頭に穴が空き、血が溢れ出していたことなど、彼女は知る由もなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ボリスの方は、今年の下半期にはこの地を離れられるはずだった。退役後は家に戻って、織物業を継ぐと言っていたんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "そして、ブラウン――ほんの一年前まで聡明な学生だった彼は、まだ二十歳にもなっていなかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……彼らの犠牲に、深い哀悼の意を表します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "哀悼の意！　ハッ、随分と軽く言ってくれるな。どうやら、君の口からは薄っぺらい言葉しか出てこないらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……この事件の全貌を暴くという目的のもと、我々は常に立場を同じくしているのではないのですか？　大佐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "フンッ……彼らを殺害したのは、あのターラーのクズどもで間違いない。そして、我々は既に二名を摘発したが、これまでの被害を鑑みれば、決してそれがすべてではないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "例えば十五日前――我々の兵営三箇所で、同時に爆発物による襲撃を受け、十五名の兵士が犠牲になった。爆発によって空いた穴と被害者たちの血痕は、今もなお残されたままだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "そして、二十一日前には、我々の補給品輸送部隊が北部郊外の物流エリア外で待ち伏せに遭い、部隊全員が貨物ごと行方不明となる事件も起きた。彼らの生存に、希望が持てると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "今話したものは、すべてここ一ヶ月の出来事に過ぎない。君は、これまで長きにわたって我々が受けてきた損失を、何一つ知りはしないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ですが――今大佐がお話しくださった事件は、すべて亡霊部隊の犯行であるように聞こえます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "この半年間で、ロンディニウムは十以上の郡から報告を受け、数百にも上る殺人、強盗、損壊事件を記録してきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "その犯人たちは、いずれの事件においても犯行後はすぐに行方をくらましており、また、彼らを目撃した関係者はすべて、我々が接触する前に殺害されています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "そのため、これまでに得られた情報はごくわずかなものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "だからこそ、今目の前にある手がかりは極めて重要なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "亡霊部隊がヒロック郡に出没した目的はわかっていませんが、奴らが私たちにとって共通の敵であることは確かでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "我々が駐屯軍と連携し、亡霊部隊の正体を明らかにすることができれば――それは、ヒロック郡とヴィクトリアにとって大きな利益となるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "フン。やはり何も理解していないようだな。目の前で起きるこの惨劇を、勲章稼ぎの一事件として捉えているのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "だが、それは大きな間違いだ。――いいかね。これは「事件」ではなく、「戦争」だ。ゆえに本当の犯人など存在しない。我々と連中との間で、数十年、数百年と続いてきた戦争なのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "君は連中を「亡霊部隊」などと呼んでいるようだが、その名の意味するところを理解しているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "我々が向き合い続けてきた敵を、一体何だと思っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "私に言わせれば――あれこそまさに「亡霊」だ！　この都市の上空を漂い、愚かなターラー人どもの頭の中で囁き続ける――消えない過去の亡霊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "その亡霊は我々とは違う言語を話し、我々の祖先がその手で築き上げてきた歴史を歪めている……その上いつの日か、我々の都市を用いて蘇ろうと夢見ているというわけだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……つまり、地元住民の中には亡霊部隊の支持者が大量に存在する……と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "「支持者」が「大量に」？　いいや、違うな。連中のすべてが、亡霊そのものなのだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "見たまえ。君はこの詩集を読んだことがあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "シェイマス・ウィリアムズですね。彼の詩は、ロンディニウムでもそれなりに知られていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "だがこれは、ヴィクトリアに関する嘘ばかりをまとめ上げた本だ。ここには、奴らについてこう書かれている――「彼ら自身の言語を持った、この土地における生来の主人」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ヴィクトリアには、様々な文化的背景を持つ創作者の思想を許容する懐の深さがありますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "確かに、夢想家が何を言ったところで、真剣に聞く者などいないだろう。だが、彼が白昼夢の中で斧を持ち、我々の頭を斬り落とそうとするのなら話は別だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "私がこんな馬鹿げた寝言の書かれた本を手元に残しているのは、その表紙に残された血痕によって、記憶すべき事実をいつ何時も忘れぬように己に言い聞かすためでしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "ヴィクトリアの地に生まれておきながら、ヴィクトリア語で名乗ることを望まないなどと言うのなら――そいつはもはやヴィクトリア人ではなく、帝国を脅かす敵なのだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ま……まさかあなたは、その詩集の持ち主を処刑したのですか？　その人がただ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "ご報告します！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "――何だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "先ほど襲撃された第九防衛隊、及び第十三防衛隊ですが――司令部との連絡が完全に途絶しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "そのため、第五、第七、第十防衛隊から、それぞれ先鋒要員を現場に送りましたが、敵の痕跡は発見できませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "こちらの被害は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵",
      "text": "……全部隊員が、犠牲になったとのことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "聞いたか？　スカマンドロス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "君が敵などに同情し、くだらんお喋りをしていた間にも、我々はまた優秀な兵士を失ったのだ！　他ならぬ連中の手によってな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハミルトン大佐",
      "text": "わかったら、執務室から出て行ってくれ。本当にやるべき仕事が私を待っているのでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホルン",
      "text": "ええ、そうさせていただきます。私にも、やるべきことがありますので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
