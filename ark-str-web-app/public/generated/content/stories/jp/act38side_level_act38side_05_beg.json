{
  "server": "jp",
  "storyId": "act38side_level_act38side_05_beg",
  "groupId": "act38side",
  "stageId": "act38side_05",
  "title": "「新しい人生へ」",
  "storyCode": "PV-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act38side/level_act38side_05_beg.txt",
  "sourceHash": "720189f590d3f2e6347be342b1d344765f8f074cc942d9d4b0c2a5a15604ed98",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "へぇ。シラクーザ語でその話を語ってるのは初めて聞いたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "「クラウンスレイヤー」って名前は本から取ってたのか。なんてタイトルの本だっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "『正当と正義』だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "どうもややこしい名前だな……しかし、てっきり理屈だらけの分厚い本だと思ってたんだが、あれは童話だったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "いや、童話じゃない。あの本の中の物語は、娯楽のためじゃなく、警告のためにあるものなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "何が「正当」で、何が「正義」か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "両者は混同していいものか？　矛盾しあうべきものなのか？　誰が定義するものなのか？　私たちは、自分がどちら側に立っていると認識しているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "あるいは、どちらも実在しないのかもしれない。まるで……かつてのレユニオンみたいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "結局それは、美しい理由をでっち上げる時にしか使われないものなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "えーと……あのな、その話もいいが、俺たちこの先どうするんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "私が言いたかったのはまさにそれだ。――ここで別れるとしよう、兄弟。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "この方角にまっすぐ進むと、森の端に出て、古い移動都市の航路が見えてくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "近くにはリターニアの国境警備隊がいるかもしれないし、シラクーザの貨物輸送陸上艦が通ることもあるだろうから、気をつけろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "お前はチェルノボーグと龍門の戦いをくぐり抜けてきたんだ。そういう面倒ごとを避けるのは難しくないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "はぁ、三十人以上いた仲間も、俺が最後の一人なんだぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "俺たち、一緒にいるんじゃダメなのか？　クラウンスレイヤー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "固まっていれば、権力者たちの標的になるか、また利用される捨て駒になるかのどちらかだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "お前たちはナインについて行かなかったから、私が送り出しているまでのこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "これが、レユニオ……いや、私にできる最後のことだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "だが、お前はどこに行くんだ？　お前だって独りになっちまうだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "まずは歩いて、色々見て、考える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "昔シラクーザを離れる時、先生から忠告を受けたんだ。ウルサスに戻って復讐するのはやめておけと。当時の私はあまりに弱く、覚悟も足りなかったから……それでも私は言うことを聞かなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "そろそろ、戻るべきなんだろうな。先生に会いたいんだ。あの人なら……もっと強くなるための助言をくれるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前の先生ってのは、どんな人なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "シラクーザのとあるファミリーを出た人でな。本当に強い戦士であり、私が出会ってきた中で一番知恵のある人だ……あの人には多くを教わってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "シラクーザか。だったら、まだ先は長いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "雪の上で燃えるこの焚火を見ろ。かつては、これが感染者の怒りやレユニオンの理想に火をつけて、ウルサスのすべてを燃え上がらせたものだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "だが今では、ただお前と私を暖めてくれるばかりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "最後にこれだけは言わせてくれ――タルラのことも、チェルノボーグや龍門でのことも、レユニオンのことも、私たちのような人間のことも全部忘れろ。去ると決めたのだから、これ以上考えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "身体に生えた結晶のことさえ忘れてしまえばいい。すべて忘れれば家に戻れるかもしれないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "俺たちは皆去ることを選んだ身だが、ずっとお前は何か俺たちとは違うように感じてたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前は色んなことを知っていて、本だってたくさん読んでるだろ。俺は時々、お前はどっちかっていうと大尉やタルラと似たようなタイプなんじゃないかと思うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "あー……つまりだな。ガキの頃に爺さんがよく言ってたんだ。本を読みすぎてる奴は、つまんないことですぐ頭を悩まされちまうってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "とにかく……まあいいや。またな、クラウンスレイヤー。お前の幸運を祈ってる。何しろ、お前には運が必要そうだからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "またはないだろうな、兄弟。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "ッ……尻尾が濡れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "相変わらずだな、この街は。この薄汚れた通りも、ウザったい雨も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "なぜだか、人の命すら奪いかねないあのウルサスの雪よりも、ここの雨の方が不愉快に感じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "先生の家にドライヤーがあればいいんだが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "先生！！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "濃い血のにおいが鼻をつく。\n師は仰向けに倒れこみ、その血液はなおも流れ出している。\n一本のナイフがその場に落ちていた。\nリュドミラは血を流し続ける傷口を押さえるべく師に近付きたいと思ったが、一歩たりとも動けずにいた。彼女には目を逸らすことすらできないのだ。\n彼女のよく知る、それでいて恐れを感じる気配が影から現れた。\nそれは赤い服を纏った、灰色の髪の狼。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "真狼、死んだ。レッド、オバアサンの言う通りにした。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "……お前が、やったのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "なんてことを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッドはウルフハンターだ。オバアサンの言う通りに、やる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "真狼、死んだ。抵抗、しなかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "なぜ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "なぜなんだ？\nなぜ、赤い服を纏ったこいつは、炎国からシラクーザに至るまで、振り払えない亡霊の如く追いかけてくるのだろうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "お前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "お前は……一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "一体何なんだ、このクソ狼！！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "リュドミラは黙ってその火を見つめていた。そこでは、彼女の師が入った荷物袋が燃えている。\nリュドミラは一晩中一睡もしていなかった。彼女は、いかにして塩と水で部屋の中の血を拭き取り、大雨のやまぬうちに、師の遺体をこの荒野まで運んできたかを思い出していた。\n師は生前からすでに随分と痩せこけており、この一連の作業も大した苦労にはならなかった。\nリュドミラは師との出会いを今でも覚えていた。\n至る所に血だまりが広がり――唯一血の繋がった親族であった伯父と、その家族や使用人の遺体が、屋敷中に転がっていた。\n彼女をシラクーザに送り届けた人は、彼女の伯父はいくつかの通りで商売を仕切っており、大きな権力があるわけではないが、このシラクーザという小さな町で暮らす分には十分だと言っていた。\nしかし、彼女が新たな生活に慣れるより前に……簡易的な源石爆弾がガラスを突き破り、彼女は腕を負傷して、震えながらベッドの下に隠れるよりほかなくなった。\n屋敷に押し入ってきたマフィアたちは、研究所に押し入ってきたウルサス憲兵と何ら変わりはなく、チェルノボーグに、父を亡くしたあの夜に戻ったのかとすら思わせた。\nそうして、すべてが静寂に帰したあと、リュドミラはようやく勇気を振り絞り、部屋から出た。\n血だまりの中には、マフィアたちも倒れこんでいた。屋敷の中で生き残ったのは自分と、一番身分の低いある使用人だけだった。\n彼女はいつも門番小屋にいて、郵便物を担当しており、屋敷の主人たちに手紙を渡すときにだけ、足を引きずって屋敷に入ってくる――そうした印象ばかり残っている人だった。\nそんな彼女は、大きな音を立てぬよう、絨毯の上でもつま先立ちで歩いていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は最初に教わった方法で、師を葬ることにした。\nだが、そのあとは？\nレユニオンを去った後、彼女は二年余りの時間をかけてシラクーザに戻り、そしてたった一日で最後に残された帰る場所を失った……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "火はすでに消え、早朝の風が最後の灰をさらっていって、荒野には何の痕跡も残っていない。\nリュドミラ、これからどうするつもりなの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "仇を……討つさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "見つけたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエが？　レッドを、探してた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "この街では、よそから来た殺し屋を見つけるのは難しくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "お前は目立つしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "邪魔、するな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "逃げられると思うなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "うっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "お前を仕留める前に、一つ聞かせろ――なぜあんなことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "先生にお前のような敵がいるなんて話は聞いたことがない。なぜケルシーとつるんでいる奴が先生を知っているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "真狼……死ぬべき。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "それが、ゲームのルール。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "ゲーム……！？　何の話だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "お前が誰だろうとどうでもいい……お前は、私に残された最後の身内を殺したんだ。絶対に報いを受けさせてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエ、弱い。レッドには、勝てない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "なめるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "前回は不意を突かれただけだ！　お前なんて怖くない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……オマエ、邪魔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "これ以上、つきまとうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "ま……待て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "絶対に……逃がすものか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "クソッ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "知らない街……知らない食べ物……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "少し、変。でも、不味くはない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "フンッ、ちょこまかと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……またオマエか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "言っただろう、報いを受けさせると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "逃げられるとは思うなよ。殺すか、殺されるか――二つに一つだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "グルル……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "腹を立てたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "上等だ。本気でかかってこい――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レストラン店主",
      "text": "お、おいおい！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レストラン店主",
      "text": "お嬢ちゃんたち、やるなら外でやってくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "不吉な匂い。妙な音。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……危険だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "変な奴……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエ……いつまで、ついてくる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "言っただろ……殺すか、殺されるかだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエ、何度も試みた。オマエに、レッド、殺せない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "それに、オマエ、疲れてる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リュドミラ",
      "text": "だったら、お前が私を殺せ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "疲弊しきったレプロバは地面に倒れ、意識を失ってしまうまで、赤い服のループスの裾をしっかりと掴んでいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエ……なんだか、哀れだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソマー",
      "text": "おーい、おーい……どうした、大丈夫か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曖昧な声",
      "text": "待て……行かせるか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソマー",
      "text": "はぁ……こっちは車がぶっ壊れて、行きたくっても行けないってのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソマー",
      "text": "どうしてこんなところで寝転がってる？　怪我でもしたのか？　連絡の取れる家族は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "曖昧な声",
      "text": "いない……誰も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソマー",
      "text": "何だって？　よく聞こえないな……息がしにくいだろうし、マスク外すぞ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソマー",
      "text": "こ、これは……口の中まで結晶が……ひどい状態だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソマー",
      "text": "帰る家のない感染者か。やれやれ、どうしたもんかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソマー",
      "text": "まったく、互助会の初仕事だってのに、こんなことに出くわすとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソマー",
      "text": "お互い、ツイてないな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
