{
  "server": "jp",
  "storyId": "story_lin_set_1_story_1",
  "groupId": "story_lin_set_1",
  "stageId": null,
  "title": "新旧交わる時",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_lin_1_1.txt",
  "sourceHash": "1ac153e75febfb6f73fbbeb78426367c3f58c3cfe858f3b3a876f8f33f9a5fc2",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "局長、指示通りスラム街のすべての出入口に監視を配置しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "よーし、それじゃ交代でしっかり見張ってちょうだい。今日は鼷獣一匹たりとも出入りさせないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "はっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "局長、これほど大規模に人員を動かしては、かえって逆効果では？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "鼠王がリンお嬢さんに跡を継がせると宣言してからもう半月経ちますが、スラム街では特に動きがありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "でも、ネズミだってもう半月も行方をくらましてるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "スラム街を仕切る人間が変わったってのに、このまま何も起こらないなんて信じられる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "痩せぎす張（ジャン）、師爺の李（リー）、鬼眼（グイイェン）……長いこと鼠王に抑えつけられてきた老いぼれどもが、この機に乗じて動かないなんてアンタは信じられるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "今日、痩せぎすジャンがネズミの部下を拉致していったのよ。跡を継いだあいつがそんな状況を見過ごすはずがないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……リンお嬢さんなら一人でもうまく処理できるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "だけど、あいつの手を借りる必要もないわ。スラム街だって龍門の一部だもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "確かに、それについては小官も同意見です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "そっちもしっかり見張っておいて。きっと動きがあるはずだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "お任せを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "待ってなさいよ、ネズ公。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "世間の連中はバーで飲んだり踊ったりするのが好きなようだな。だが、私はバーでつつく火鍋が大好物なんだ。俗っぽいところがあるのでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "以前はリンの兄貴もここをひいきにしていた。兄弟皆でここに集って、うまいものをたらふく食べたものさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "残念だが、このバーは来週取り壊されてしまう。今日はここで最後の食事をして、お別れをしようじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "さあ、召しあがれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える商人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "どうした、汪（ワン）君、箸が止まっているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "私のシマで断りなく病院を建てる勇気はあるくせに、火鍋をつつくのが怖いのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える商人",
      "text": "病院の建設は、リンの姉御の意向で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "ほら、見ろ。これだから最近の若い連中は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "リンのお嬢を誰だと思ってる？　鼠王の跡継ぎで日々多忙を極める方だ！　そんな方がちょっとくらい雑事を忘れるのは仕方のないことだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "我々のような子分の一番重要な仕事は、親分の負担を肩代わりしてやることだ。そうだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "さあ、ワン君。言ってみたまえ。うっかりしていたのは君か？　それともリンのお嬢か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える商人",
      "text": "お、俺がうっかりしていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "そうだろうとも。いいかい、君のリンの姉御だって、私に会えば叔父貴と呼んで敬わなきゃならないんだ。それなのに、こんな大事な話を通さないはずがあるまい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "なにもかも、単なるすれ違いさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "さっきから震えているな。君はどうも身体が弱くて、記憶力もよくなさそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "こうしようか。この火鍋のスープを熱いうちに飲み干して、元気をつけてから姪っ子に報告するんだ。どうだね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える商人",
      "text": "それは……ジャ……ジャンさん、お許しを……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "商人が身体を震わせながら立ち上がり、痩せぎすのジャンに跪こうとしたその時、彼の肩に手が置かれた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "おや、誰かと思えば私の可愛い姪っ子じゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "姪っ子よ、部下がこんなにビクビクしているようでは大事は成せんぞ？　いや、おじさんは責めるつもりはないがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "おじさんも昔は、君のお父さんに恥をかかせないために、お偉いさんが大勢見守るなかで皿を噛み砕いて呑み込んだものさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "今はジャンおじさんの時代とは違うの。昨今の商売で大切なのは、「和により財を生ず」よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "ワンの奥さんは妊婦なの。帰らせてあげてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "用があるのは私でしょう。火鍋なら私が付き合うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "それはありがたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "ワン、早く行きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怯える商人",
      "text": "すみません、姉御。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたのせいじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "さあ、こちらに来て食べなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "おじさん、あなたは年長者なのだから話があるなら直接言って。回りくどい真似をする必要はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "ああ、この数年の君の手腕は誰もが認めるところだ。兄貴が君に実権を譲ったことも、私は支持している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "江湖では何よりも「掟」が重んじられるんだ。君が鼠王の立場を継いだ以上、私も君を道理をわきまえない若者のように扱うわけにはいかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "おじさんの態度は、実権を握る者に対してというよりも、敵に向けるものに見えるけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "いやいや、それは言葉が過ぎる。ここでは掟なくして秩序は成り立たないんだ。だが、仁義を欠いて立場を築くことなどできると思うかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "断りもなく私のシマで工事を始めるのは、明らかに私の面目を潰す行為なんだ。わかるだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "ただ姪っ子に忠告してやりたいだけさ。むやみに人の顔を潰すような真似は、避けたほうがいいってことをね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "もし私が、わざとおじさんに知らせなかったと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "なんだ、可愛い姪も冗談を言えるようになったか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "いいえ、私は冗談なんて言ってないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……まさか兄貴の跡を任されたからって、なんでも好き勝手できると思ってるわけじゃないだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "私がこの座に着いたのは、ある人たちに好き勝手させないためよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "リンの兄貴は知っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたもさっき言ったはずよ。今、実権を握っているのは私なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "どうやら、今日は兄貴に代わって娘をしっかり躾けてやらなければならないようだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "胖坤（パンクン）、姪っ子と一緒に火鍋をつつこうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "仲間を呼べ、武器も忘れずにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクンの手下",
      "text": "パンクンの兄貴、本気でお嬢さんに手を出す気ですか？　相手はスラム街の新しい支配者ですよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "ふん、その権力も下につく奴らの支持があってこそだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "鼠王の地位についたばかりのくせに、ジャンさんを差し置いて舐めた真似をしやがる。スラム街をリン家のもんだとでも思ってやがるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクンの手下",
      "text": "で、ですがお嬢さんは鼠王の娘です。裏に鼠王の意向があるとしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "鼠王の爺さんの性格なら、ジャンさんを狙うのに、わざわざ娘の手を借りるなんてことはしねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクンの手下",
      "text": "それじゃ……鼠王は娘を好き放題させてるってことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "お嬢さんのやり方は鼠王とは違う。それはみんなわかってるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "あの人がカタギとの付き合いを好むのも、今まで見てきた通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "だが、ここまでとは思わなかった。実権を握った途端、数十年間守られてきたスラム街の掟を足蹴にするなんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "おそらく鼠王だって予想外だっただろうぜ。自分の娘がこれほどまでに過去を軽んじる真似をするなんてことはな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "よく聞け、俺たちはお嬢さんに手出しするわけじゃねぇ。鼠王に代わって娘を躾けるだけだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクンの手下",
      "text": "わかりました、兄貴！　今すぐ仲間を集めてきます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "最初から準備していたみたいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "心配はいらん。部下を会食に招いて、賑やかにいきたいだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "リンの兄貴への義理もある。君に手を出すつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "まだ分かってないのね。お父さんはもうここを仕切っていないの。それなのに、なんの義理立てが必要だというの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "リンの兄貴が仕切るのをやめると言っただけで、本当にそうなると思うのか？　スラム街には今でも彼の言うことしか聞かない者が山ほどいるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "そういう連中の支持もなく、実権を握ることができると本気で思っていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "私には私の人脈がある。自分なりの支持基盤があるのよ。お父さんとは関係がないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "ああ、姪っ子よ。一つ忠告してやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "若い連中は我々のような老いぼれを、時代遅れと切り捨てたがる。それは理解できるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "だが、切り捨てたくても、切り捨てられないものだってある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "たとえば今日、君が私のメンツを潰したとしよう。明日には、リンの兄貴は私と過去を懐かしむこともできなくなる。そして明後日には、君の母親は私の妻と買い物にもいけなくなるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "君はいつも抜け目なく立ち回ってきたはずだ。その君がどうして、こんなところでバカな真似をする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたは義理と人情を重んじすぎているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "まったくこの子ときたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "まあいい。手荒な真似をするつもりはなかったが、今回はキツいお灸をすえて目を覚ます必要がありそうだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "もしもし、李（リー）だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "病院の件だ。実行に移してくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "王（ワン）局長、私を覚えていますか？　瑞翔（ルイシャン）建設の李敏恒（リー・ミンハン）です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "おお、もちろんだとも。リー社長がいなければ、この大地にまだあれほどまでにうまいものが存在すると、知らないまま生きているところだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "ははっ、ワン局長は美食家だと小耳に挟みましてね。おもてなしのためにはるばるレム・ビリトンから山の珍味を取り寄せたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "ああ、それは素晴らしい。やはり君と手を組んで正解だった。今後も何か手伝えることがあれば気兼ねなく言ってくれたまえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "ははっ、それは心強い。実はスラム街の病院について話したいのですが……件の病院についてはご存知でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "もちろんだ。事が事だからな。市民の誰もが大変注目しているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "あの件の入札はもう済んだはずだが……スラム街の企業が落札したんじゃなかったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "えぇ、そうです。その……局長もご存知かと思いますが、我々のような零細企業が仕事にありつくのは、なかなか骨が折れるものでして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "あの件は、元は我々が手に入れるはずだったのです。それをスラム街の連中に先を越されてしまいまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "しかしだな、リー君。あの企業は正規の手続きを踏んで、合法的に落札したんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "分かっています。ですが……局長はお気づきでないかもしれませんね。彼らが提出した書類には、ちょっとした不備があったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "ほう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "確かかね？　だがちょっとしたミス程度では、結果は覆らんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "しかし、結果に影響を及ぼすことはあるかもしれない……そうですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "ただお声をかけておきたかったのです……我々が訴訟を起こした際に、首を縦に振っていただくだけで構いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "それ以上にお手を煩わせるようなことは、決してないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "それと、ボリバルから良い品を仕入れました。来月届く予定です。その際はぜひともご賞味ください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "……ははっ、いいだろう、任せておきなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "さて、これで可愛い姪っ子も安心して火鍋を食べられるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "……焦ることはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "先に聞いておきたいことがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "なんだね。私が知っていることなら、なんだって答えてあげよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "龍門はよく、荒野からの流民を受け入れているわ。そして、彼らの多くはスラム街に落ち着くことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "流民があふれないように、ウェイ総督は他国と交渉し、支援協定を結んできたわ。流浪する人々がまた故郷へ帰れるようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "だけどその度に、決まって失踪事件が起きた。目的地に着いたはずの人が消息を絶ったり、支援リストに載ってなかったはずの人が、突然スラム街から姿を消したりね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "初めは単なる偶然だと思っていたわ。だけど調査が進むにつれて、支援の名目で人身売買に手を染めている者がいるということに気付いたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたのやり口は確かに巧妙だったわ。毎回違う買い手と取引し、売り払う人間の送られる場所を意図的にバラけさせたりしてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "ちょっとした手がかりを掴むのに、何年もかかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "この写真に写っている人たちのことを、まだ覚えているかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・ユーシャが鞄から取り出した数枚の写真には、痩せ細った数名の人が写っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "覚えがないな",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "そうでしょうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "準備はいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクンの手下",
      "text": "はい、全員揃ってますぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パンクンの手下",
      "text": "だ、誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パンクンの手下",
      "text": "グッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "ジャンさんのシマで勝手な真似しやがってるのはどいつだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "グハッ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パンクン",
      "text": "て、てめぇ何者だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "出てきてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "こいつで間違いないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒る男性",
      "text": "……間違いない、こいつだ。この声、忘れるもんか……こいつが親父を殺したんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恐れる女性",
      "text": "私も覚えてるわ！　こいつのせいで、私はウルサスの採掘場で十年以上も働かされたのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "緊張する老人",
      "text": "そうじゃ……間違いない……たとえ灰になろうと、こいつの入れ墨を見間違えるものか……わしをレム・ビリトンに売ったのはこいつじゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "こいつはもう動けない。リンの姉御から、好きにしていいと言われている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "パンクンを見る彼らの顔は驚きと怒りの表情を浮かべていたが、リン・ユーシャの部下の言葉を聞くと何人かは勇気を振り絞って、パンクンに蹴りを数回入れた。\nしかしほとんどは、ただ後ろで怯えていただけだった。\n彼らの顔には、見知らぬ土地で何年もの間、怯えて過ごした者の恐怖が色濃く刻まれていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "君たちに約束する。このさき君たちが悪夢を見ることは、二度とない。これはリンの姉御の言葉だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "なぜなら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "全員動かないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "乱闘騒ぎが聞こえてきたわ。ここで何があったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "見ての通りだ。龍門近衛局が公正な裁きを下してくれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……アンタ、ネズミの部下ね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "スワイヤー局長、リンの姉御に代わって告発します。張文浩（ジャン・ウェンハオ）の部下……パンクン一味は長年に渡り人身売買に手を染めてきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "証言者はこちらに。物的証拠も……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "ここにあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "どうか彼らに平和な暮らしを返してあげてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……*龍門スラング*、ネズ公の奴、全部計算のうちだったってわけね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャの部下",
      "text": "リンの姉御はただ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "もういいわ。パンクン一味を連れて行きなさい。それと証人たちを保護して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ネズミの手下も逃げられるなんて思わないことね。連れ帰って調書を取るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "局長はどちらへ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……ちょっと火鍋でも食べてくるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "お嬢は知らないだろう。以前は海外のマフィアが、続々とこのスラム街に根を下ろそうとしていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "兄貴がいくら有能でも、そうなっては多勢に無勢だ。私が負担の一部を引き受けなければ、彼がここで足場を固めることはできなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "姪っ子よ、あの頃まだ生まれていなかった君に、当時の修羅場が理解できないのも無理はない。責める気はないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたの言葉を信じるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "お父さんもよく言っていた。もしもあの時、あなたが立ち上がってくれなければ、スラム街では再び血みどろの争いが起こっていただろうって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "だけど、お父さんは知らなかったのよ。自分の感謝している相手が裏ではマフィアと結託して、人身売買の片棒を担いでいたなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "あの時は仕方なかったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "他にも手はあったでしょう。仮にその時は手立てがなかったとしても、後からなんとでもできたはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "今日に至るまでどれだけ多くのことを正当化して、どれだけ多くのことに……引っ込みがつかないまま手を下してきたのかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "当時のことを経験していない君が、知ったような口で語るものじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "確かに経験はしていないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "でも、できれば自分で味わいたくないことだってあるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたは彼らの元を訪ねたことがある？　彼らの助けになったことは？　彼らのために何かしてあげたことは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "変わり果てた家の前で肩を落とす彼らの姿を、肉親の墓の前で涙を流す姿を見たことはあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……何を言っても無駄だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "そんな話で私が揺らぐとでも思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたも知ってるでしょう。私はそこまで甘くはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたが忘れてしまわないように、思い出させてあげただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "だけど、この写真に写っている人のことは、覚えているはずよね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・ユーシャは鞄の中から写真をもう一枚取り出した。\nその写真には酒の席で痩せぎすジャンと、リー社長、ワン局長が楽しげに談笑する姿が写っていた。\n痩せぎすジャンは、たちまち表情を曇らせた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "長官、リーがワン局長の執務室を出ました。どうしますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "監視を続けろ。私はワン局長と話してくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局局員",
      "text": "かしこまりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "……入りなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "ワン局長、小官は近衛局の督察官、ホシグマと申します。少々お話しが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "近衛局の長官か。いいところに来てくれた、ちょうど告発を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "いや、自首しようとしていたところだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……今なんと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "私はかつて、一部の企業の違法な入札談合行為を見逃していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "それに加えて、告発したいことがある。ルイシャン建設のリー・ミンハンが、スラム街の病院の落札結果を違法に改変しようとしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "さきほど私の元を訪ねてきたんだ。会話は全て録音してある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "背後で糸を引いているのはスラム街のジャン・ウェンハオだ。長年に渡り幾度となく賄賂や暴力的手段を用い、商業的な入札取引を裏から操作してきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "手元に十分な証拠がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……誰の命令でこのようなことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワン局長",
      "text": "……誰の差し金でもない。長官、全て私が自分で決めたことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "……リンお嬢さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "本当に大したものだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "「リー・ミンハン」……多くのスラム街の住民にとって、この名は馴染みのないものではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "スラム街のインフラのほとんどを彼の企業が請け負っている。私たちの恩人と呼んでも過言ではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "幼い頃、お父さんがスラム街のあちこちにある建物は、ジャンさんの友人……リーさんが建てたものだと教えてくれた。心の中で彼に感謝したこと、今でも覚えているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "私が、スラム街で初めての公立病院を作ろうと思ったきっかけは、彼だと言っていいくらいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "けれど、知識を得てこの道を歩み始めて、それからようやく気付いたの。彼が官僚と結託して、どれだけ多くの投資金や補助金を騙し取っていたかを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "私がかつて誇りに思った建物は、実際は安価で粗悪な素材で作られた詐欺同然の代物だった。彼が工事費用から掠め取った利益は計り知れないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "そして、彼をそんな道に唆したのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "ジャンおじさん、あなただった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……誘ってきたのはあいつの方だ。あいつが先に、大きな可能性があると言ってきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "誘ったのがどっちであろうと、大差はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "結局のところあなたたちは手を組んで、スラム街に住む数多くの貧しい人々が享受すべき利益を、自分たちの享楽の元手にしたのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "確かに、私には君のお父さんに隠していたことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "やむを得ずやったこともあれば、少しの気の迷いから手を汚したことも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "そのことを考える度に、いつも心の底ではリンの兄貴に申し訳ないと思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "こうして表立って指摘されて認めたことで、かえって胸のつかえが取れたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "だが、ますます君を帰すわけにはいかなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "悪いが、おじさんと一緒に来てもらうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "私の身の安全が確保されたら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "リーさん、どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "ジャンさん、助けてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "近衛局の奴らがいきなりやって来て、俺を連行しようとしているんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "なんだと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リ社長",
      "text": "もしもし、ジャンさん、切らないでくれ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……チッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "パンクンもお縄にかかったわ。会いたければ自分で牢屋まで会いに行きなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "通信音が鳴ってすぐに、バーの入り口から入ってきたスワイヤーは痩せぎすジャンの前にパンクンの通信端末を投げ捨てた。"
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "まだ電話をかけるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "私が代わりにかけてあげてもいいのよ。誰がいい？　師爺のリー、鬼眼、ワン局長、チェン部長……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "リン・ユーシャはそう口にしながら、鞄から通信端末を取り出し、痩せぎすジャンをじっと見つめた。\n痩せぎすジャンはリン・ユーシャには目もくれず、通信端末を握り締めたまま椅子にもたれかかった。その表情は七変化していた。\n大勢は決した。\n彼は最後に目を閉じると、深々と息を吐き出した。\nほんの一瞬で、彼は十も老け込んだように見えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "自分がしたことの落とし前は、いつか必ずつけなくてはいけないのよ、ジャンおじさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……妻はどうなる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "私の口から直接説明するわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "息子さんの勉学にも影響は出させないように取り計らう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "私も昔は、君のように自分は道理を守ることのできる男だと思っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "だが一歩道を踏み外したら、途端に堕ちるところまで堕ちてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "リンの兄貴に伝えてくれないか……ジャン・ウェンハオは彼に申し訳なく思っていると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "分かったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "痩せぎすジャン",
      "text": "スワイヤー局長、パンクンとリーの元へ連れていってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "パトカーは外にあるわ。送ってあげる必要はないでしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "小さい頃、ジャンおじさんにはとても良くしてもらったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "八歳の時、おじさんは私を笑わせようとして、買ったばかりの高級時計を井戸に投げ込んだ。今でも覚えてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "アンタは本当に血も涙もない、最低のネズ公ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "その通りよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "アタシが感謝してるとでも？　元々、近衛局はジャンの尻尾を掴む寸前だったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "ただ身内の膿を取り除いたまでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "へえ、さすがね。我らがリンさんは、玉門から帰ってくるなり近衛局の目の上のタンコブを取ってくれたってわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "誰も気付かないうちにスラム街に人員を忍ばせて、政府の財務部門にまで影響を与えちゃうなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "いっそウェイ総督に声をかけて、アンタを局長にしてもらうってのはどうかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "今はこういう手段を取るしかないこともあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "スラム街と龍門を隔てる壁は、少しずつ壊していくしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "分かってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "でなきゃ、アンタとここで、こんな風に心穏やかに会話なんてしてないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ねえ、どっちだと思う？　アタシがスラム街を包囲したのはアンタを捕まえるためか、それとも守るためか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたは今日、何がなんでも私を捕まえようとするほど愚かじゃない。だけど、もしも私が隙を見せれば見逃してくれるほど優しくもないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "分かってればいいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "アンタの父親の時代の龍門には、スラム街が必要だった。でもだからって、いつまでも必要ってわけじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "中学の頃に話したこと、忘れたとは言わせないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "「生まれながらにスラム街で生きることを決められた人間なんていない。いつの日か、スラム街に住む人だって太陽の下で暮らせる日が来る。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "私は忘れてないけど、約束を破った誰かさんはどうかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "心の狭い女ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "そのネタ、あと何年続けるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "あなたをからかえるネタが一つでもあるなら、死ぬまで続けるつもりよ。私は血も涙もない最低のネズ公だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ふん、アンタと話してるとほんとーに頭にくる。そのうちホシグマに頼んで、高血圧の薬を常備してもらわなきゃならなくなるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "まあいいわ。アンタがその言葉を覚えていて、自分が誰のために尽くしているのかを忘れない限り……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "近衛局はアンタの邪魔をすることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "それは、近衛局局長が私という一般市民に与える免罪符ってことで良いの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "近衛局局長がアンタという一般市民にかける手錠だとは考えないのかしら？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "スワイヤーはそう言うと、懐から手錠を取り出した。\n一方をリン・ユーシャの手に、もう一方を自分の手にかける。\nリン・ユーシャは抵抗しなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "なんにせよ、アンタを連れ帰って調書を取るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "今日のことは、きっちり説明してもらうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "……ふぅ、スラム街を歩き回ったせいで、もうお腹がペコペコよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "とりあえず火鍋としゃれこみましょうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "さぁネズ公、早く具材を入れなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "どうして私が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "こっちの手に手錠がかかってて、動きづらいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・ユーシャ",
      "text": "まったく……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "お歳を召して手負いだというのに、一人でこんな高いところに登って……落ちても知りませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "旧友が去ったようじゃ。この足のせいで駆けつけることは叶わなんだ。せめて一杯の酒を撒いて餞別にしたくてのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "足のせいではなく、合わせる顔がないからでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "……友よ、覚えておるか？　かつてお主に向かって、自分がいる限りお主には指一本触れさせないと、胸を叩いて言った若造がいたことを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "もちろん覚えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "あやつは三十年もワシに尽くした。そしてワシもまた、三十年間あやつを取り立ててやったんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "それなのに、あんな隠し事をしていたとはのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "ワシはあやつに負い目を感じてはおらん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "だが、あなたは自分では手を下せませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "娘がこれほど躊躇なく決断することも、予想外だったのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "スラム街に冠たる鼠王が、娘に合わせる顔がないばかりにこんなところに隠れているとは、誰かに知られたらお笑い種ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "それは違うぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "今のワシは鼠王ではない。街をぶらついたり、羽獣を飼ったりすることが好きなだけのただの老いぼれじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "娘はワシが思うより遥かに成長しておる。老いぼれは喜ばしい限りじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "随分と割り切りがいいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "当然じゃ。今は合わせる顔がなくとも、いずれ共に食事をすることになるからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "むしろお主の方こそ、会いたくとも会えないのではないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……耳の痛い話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "それでも、私はこう言い続けるつもりですよ。もしも戻る気があるなら、龍門は最も頼れる後ろ盾になると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "ふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "友よ、ワシらも老いたものじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "じゃが、龍門の行く末をあの若者たちに託せるならひと安心じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "そんなことを言っていては、ますます老け込んでしまいますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・グレイ",
      "text": "はははっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
