{
  "server": "jp",
  "storyId": "story_vrdant_set_1_story_1",
  "groupId": "story_vrdant_set_1",
  "stageId": null,
  "title": "草木の叫び",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_vrdant_1_1.txt",
  "sourceHash": "c3c09c9d09dfa86fa8bee6475e221a9245dfbdf3f183639b0cbe507d22eff019",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "ちょいとそこの坊や、何か困ってることがあるなら言ってちょうだいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "そんな暗い顔でずっと店先に立たれちゃ、お客さんが寄り付かないもんだから、こっちもやりづらいのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "えっと、その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "なんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "新しく仕入れた花たちでも紹介して欲しいのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "お母さんへのプレゼント？　それとも同級生の女の子にかしら？　どっちなのか言ってごらん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "あっ、いや……そうじゃないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "求人情報が貼られていたので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "あら、応募しに来てくれたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "はい、もしまだ募集しているのであれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "あなた、感染者でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "それならちょっと厳しいかな。ごめんなさいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……いいんです。断られたのは初めてのことじゃないので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "お邪魔しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "あっ、ちょっと待って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "どうしてこの仕事をしようと思ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……植物が好きだからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "素敵な理由ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "私も好きよ。植物は皆、自身の長所を活かすのが得意だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "話すことも動くこともないのに、鮮やかな花と染み渡る香りで誰もかも虜にしちゃうの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "それはたったの一部ですよね。多くの植物は花を咲かせないし、香りだってありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "それでも、誰かに愛される価値がある、そう思いませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "面白いことを言うわね、ふふっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "そうだ、あなたに合いそうな仕事を思いついたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "大勢の人とやり取りする必要はなく、草木や花々と一緒にいる時間のほうが長い仕事よ。ただ、危ない場所に出入りすることも多いかもしれないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "仕入れ先の知り合いに植物ハンターを募集している人がいてね――早い話、珍しい植物の収集を代行してほしいんですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "園芸店の店主",
      "text": "どうかしら、やってみない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "どわああああ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "こ、これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二人",
      "text": "網のトラップか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "お前ら、何者だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "お、俺たちか？　俺たちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "……俺たちは観光客だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "そうそう、ただの観光客だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "ここの廃荘園の景色がべらぼうにいいって聞いてよ、それがどんなもんか見に来てやったんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "本当か？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "――ってさっきからなんなんだ？　やけにひんやりするんだが……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "俺もなんか変な感じがするぜ……こいつは……\nしょ、植物のツル！？　しかも動いてるだと！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "この荘園がこの頃目を付けられてるのは知ってる。わが身が可愛ければ本当の目的を吐け、さもなければ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "前の人たちと同じように、この食人植物の餌になるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "お前、一体何モンだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "オレのことか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "んなのどうでもいいだろ！　さっさとゲロっちまおうぜ！　くっ、このツル、首に巻きついてきやがる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "……俺たちは「カッシバナ」を探しにきたんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "へぇ、「カッシバナ」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "蕾すら見当たらないこの荘園の中に、「カッシバナ」なんてどこにあるって言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "あるんだって！　ほら、すぐそこの彫像の下に！　見てみろよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "それと「カッシバナ」っていうが、ありゃ別に花じゃねぇ、ある植物の根っこのことだ！　その根っこを掘り起こせば、なんで「カッシバナ」って呼ばれてるのかが分かる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "あそこの雑草がそうなのか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "おい、なんか掘りに行ってねぇか？　まさかあいつも植物ハンターなんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "*ヴィクトリアスラング*！　このツル、ちょっと引っ張ったらすぐ千切れるぞ！　何が餌になるだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる用心棒",
      "text": "……あの野郎、俺たちをコケにしやがったのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "「カッシバナ」か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "この根っこは確かに、ひっくり返せばトゲの生えた褐色の花に見えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "こいつは薬用として高い価値があるから、最近闇市では高値で取引されてるって雇い主が言ってたっけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "花も咲かなければ、香りもない。ただ根っこで病気を治せるというだけで、需要を生み出してる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "おまけに「花」を名前に付けちゃったりしてさ。花なんか咲かない植物なのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "あっ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "吹き飛ばされて田畑に落ちた「カッシバナ」を拾い上げようとしたその時、ヴァーダントはその傍でぽつりと伸びている小さな草に気付いた。\nいたって普通の雑草であるようにしか見えないが、なぜかこの麦畑の中ではかえって目立っている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "次の瞬間、風が吹き抜け、熟しきっていない麦がそれを察したかのように、一方向へなびいた。\nこの一瞬の隙に、その小さな草はようやく太陽の顔を拝むことができた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "草に気を取られていたヴァーダントは、ふいに自分が貴重な「カッシバナ」を拾い上げようと手を伸ばしたことを思い出した。\nもし風が吹かなければ、そんな小さな存在にはまったく気付かないままだったかもしれない。\nふと、彼は言葉にならない後ろめたさを覚えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "農夫",
      "text": "おい、小僧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農夫",
      "text": "どこの村の者だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "――何か用？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農夫",
      "text": "何か用って……それはこっちのセリフだろうが。俺の畑でこそこそしやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農夫",
      "text": "おまけにそんな目で睨んでくるとはな。とっとと畑から出ていけ、除草の邪魔だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "除草？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その言葉を聞いて、ヴァーダントは無意識に自分の背後に隠れた名もなき植物を見やる。\nこんなことしたらもっと不審がられるし、怒りを買うに違いない。そう思いながらも彼の言葉は一足先に飛び出てしまった――"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "それはダメだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "だったらボクは出ていかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農夫",
      "text": "なんだとこの――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ヴァーダント！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "――？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ男性",
      "text": "おいマジかよ……久しぶりじゃねぇかヴァーダント！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喜ぶ男性",
      "text": "ワトソンのおっちゃんも元気かい？　って、鎌をそんな高く振り上げないでくれよ、おっかねぇったらありゃしねぇ……おっ、もしかしてケンカか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農夫",
      "text": "タッカー、知り合いか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "知り合いも知り合い、それ以上の間柄さ！　俺たち同級生なんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……だった、でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "今はもう違うから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ははっ、お前ってば相変わらずだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "おっちゃんは何をそんなにカリカリしてんだ？　何か誤解があるんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "こいつはさ――目つきが悪いし、人見知りのせいでよく勘違いされるけど、根はいい奴なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農夫",
      "text": "そうか、ならお前からちゃんと言って聞かせてくれ。勝手に他人の畑に入り込むのは非常識で迷惑極まりないことだとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "農夫",
      "text": "わかったらとっとと行ってくれ！　これ以上やり合ってたら、今晩女房といがみ合う気力もなくなっちまう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "入って入って、いま家族みんな出かけてるから、適当にくつろいでくれていいぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "君、ここの村の出身だったんだね。初めて知ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "おいおい、そんなの聞きたくなかったぜ。ついさっきまではてっきり遊びに来てくれたのかと思ってたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "でもまあ、それもそっか。昔の同級生に会いに行こうって最中に、田畑に生えてる雑草のことなんかでケンカをおっぱじめそうになるヤツはいねぇもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……さっきは助かったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "いいってことよ……ま、こっちのフィールドワークのレポートを手伝ってくれるってんなら、すげーうれしいんだけどなぁ。休暇後に提出しなきゃなんねぇんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "いやだよそんなの。もうあんな経験は二度と……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "はいはい、冗談だって。断られるのは分かっていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ってお前……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "そのサンプルケースに後生大事に入れてるのは、あの雑草だったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "てっきりテンパって変なこと言い出したのだと思ってたが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ボクにはただの雑草とは思えないんだよ、タッカー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "そうか？　それってヒエの一種かなんかじゃ……って、俺みたいな必修を落とすビリが、上から三本の指に入る優等生に何つっかかてんだか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "いや、別にこれがヒエじゃないとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "どうした？　急に黙り込んで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……今気づいたんだ。これってヒエによく似てるけど、ちょっとだけ違う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ほら見てここ、エノコログサみたいな円錐状の花序ができるんじゃないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "茎の部分だってカヤツリグサに似ている気がするし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "じゃあ、そいつは未発見の新種ってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ボクが把握していないってだけなのかもしれないけど、今まで読んだ本にはそれらしい品種が記載されていた記憶はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "新種か。その可能性も……ないとは言い切れないかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "お前、品種すらわかんねぇのに鎌を持った農夫とやり合おうとしてたのか？　どうしちまったんだよ、お前らしくもねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ボクだって分からないよ……とにかくあの時は、こいつを残しておきたい一心だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "いや、それで正解かもな。もしそいつが本当に新種だったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "はっ、やっぱりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "お前にフィールドワークのレポートを手伝わせたかったのは、こういうことなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "お前だからこそ、こんな地味な雑草だろうと、他とは違うそいつの特徴に気付けたんだ。これが俺と優等生の差ってやつなのかね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "そんなことはないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ボクも、うっかり見逃しそうになってたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "植物ハンターは、こんな商品価値のない品種に用はないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "それがどうした？　大事なのはお前に鋭い観察眼があるおかげで、そいつを見つけられたってことだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "……閃いたぜ。そいつが新種かどうか知りたいんなら、植物研究所みたいなとこに持ってって、鑑定してもらえばいいんじゃね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "鑑定か、そうだね……でもその前に、まだひと仕事残ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "一旦拠点のほうに戻らせてもらうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "はい、「カッシバナ」は入手しました。当品種の採取を終え、植生していた場所の土壌サンプルもまとめて保存しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ライバルですか？　そういえば二人ほど……いえ、大した妨げにはなりませんでした。むしろ助かったというか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "商品価値のありそうな他の植物ですか？　……いえ、特には。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "データと画像はすでにそちらへ転送しました。予定通りであれば、明日には戻れるかと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "新しい仕事？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "でしたら一旦そちらに戻って、直接ブリーフィングに参加した後、再度出発しても遅くはないかと思われますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "急を要する仕事と言われましても……いえ、そちらの判断を疑っているわけでも、信用していないわけでもなくて、ただその――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "はい、分かりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "新しいターゲットの植物を入手後、帰投いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "このまま植物研究所には行けねぇって感じか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "お前の雇い主ってさ……横から聞いても面倒な人だって分かるよ。いっそこのまま帰って、欲しいもんは見つかりませんでした、じゃダメなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ボクがこの仕事を必要としなくなったらそれでもいいかもね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "まっ、しょうがねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "実験室で試験管を洗ったり、サンプルにラベルを貼ったりする仕事と比べりゃ、そりゃ植物ハンターのほうがカッコいいもんな！　俺だったらそんな面白い仕事、死んでも手放さないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "よし、じゃあこうしよう。フィールドワークのレポートの手伝いはなしでいい！　その代わり、俺も植物ハンターとして連れてってくれ！　頼む、この通りだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……いやぁ、ハハ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "周到な計画に沿って潜入し、全員の目を欺きながら、様々な危険を臨機応変にかい潜り、そして「最後の部屋」の中からターゲットを奪取する……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "先月上映されたランクウッドの冒険映画なんだが、お前見たか？　サルゴンのジャングルで、原住民に追い掛け回されながら宝探しをするってやつなんだが、まさにこんな感じだったぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "み、見てないかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "だよなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "タッカー、ボクがそういうものに興味がないことは知ってるでしょ……別に冒険好きだから植物ハンターになったわけじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ボクがこの仕事に就いたのは、収入が必要なのと、植物との関わりを断ちたくなかったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "鉱石病に罹ってからというもの、これが巡り合えたベストのチャンスだったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "……まあまあ、分かってるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "鉱石病を理由にお前を退学させたことは、学校側の損失だよ。あいつらは本気で植物のことを愛している若き学者を一人失ったんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "お前が植物研究を続けるためにこんな危険な仕事をしてるって知ったら、教授はきっとお前のために学校に直訴しなかったことを後悔するはずだぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "はっ……じゃあ教授のせいってことにしとこうかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ねえタッカー、ボクたちは昔、あの地味な実験サンプルたちをどう育てていたっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "……嫌味か？　今だって十分こなれてるくせに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう話しつつも、ヴァーダントは「カッシバナ」を栽培する保温箱の蓋を閉め、代わりにそれよりもさらに小さく、しかしより暖かいサンプルケースを開いた。\n彼は指でサンプルケースに入れた土壌の湿度を確認した後、ケースのガラス面に霧吹きで水を撒く。\n名もなき小さな植物は声や音を出すことなどなかったが、それでも彼にはこの草がすくすくと成長していることが分かった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "正直言うとな、ヴァーダント。植物たちを世話してる時のお前は、まるで別人のように見えるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "そうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "それは多分こいつらに嫌われることはないと分かってるから、じゃないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "嫌われない、か。まぁそうかもな……だが植物だからって、いつも俺たちの都合に合わせてくれるわけじゃないってのはお前にだって分かるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "昔に俺たちが一緒に温室で育ててた実験サンプルのように、育ちが悪かったり、早々に枯れちまったりすることだってあるし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "花開いて実を結ぶ時になって初めて、俺たちが必要としていたものじゃなかったって分かったこともあったよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "だから、そんなに期待することは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "期待だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "もしかして君は、こいつがどこにでも生えているような普通の野草だってことが実証されたら、ボクがガッカリするかもって心配してくれてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "大丈夫だよ。ボクはそんな確証もない可能性のためにこいつを育ててるわけじゃないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "じゃあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "タッカーはさ、農作業をしてる時に、こいつが作物の傍に生えてるのを見つけたらどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "そりゃあ抜いてポイだろうな。肥料としてとっとくのも微妙なくらいだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "そうだよね……ちょっと前までだったら、きっと同じ考えだったと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "けどあの頃のボクは、自分を誰もが必要とする作物みたいに思ってたし、ある日突然居場所を失うなんてことは夢にも思っていなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "それがまさか、作物の肥料になる価値もなかったとはね……肥料なら、少なくとも同じ畑に残っていられるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ヴァーダント……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "平気だよ、タッカー。肥料にすらなれなくても、ボクはこの通りピンピンしてるじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ボクはハッキリ分かったんだ、これが新種かもしれないという期待はそれほど抱いちゃいないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ただ、この植物にも居場所が必要だって……そう思っただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "それに、さほど負担にもならないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "土、水、そして日の光……それさえあれば十分なんだ。それだけでこいつは十分粘り強く生きていられる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヴァーダントはふと、この名もなき草に問いかけたいという衝動に駆られた――\n君の名前は？\n人に注目されたいと思ったことはある？\n君も……人から忌み嫌われるのはイヤかい？\nねえ、小さな草さん。\n……この狭いサンプルケースにいるよりも、あの広々とした田畑に戻りたいと思っているんじゃないのかな？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「……お願いだから、さっさとどっか行ってくれ。」\n「早くこの場から消えてちょうだい！」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "これは……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「ご覧の通り、学校理事会が下した決定だ。」\n「ここは勉学に励むよりも、まず自身の健康を気遣うのが先決だと思わないかね？」\n「……まあ確かに、健康に問題があるからといって勉強ができないわけではない。しかし、こちらとしても、他の学生と教職員の身を案じる必要があるのだよ。」\n「すまないが無理な話だ。君一人のためだけに寮の一人部屋を用意することはできない。」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……\n分かったよ、出ていけばいいんでしょ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「大学生？　大学生なんか必要ないよ、客の呼び込みさえできりゃいいんだから……感染者だって？　なおさら無理だな。」\n「感染者のタイピストは募集しちゃいないよ。家で仕事をする？　ノルマは絶対にこなすって？　無理なもんは無理なんだ！」\n「おい小僧、俺の店からとっとと失せやがれ！　二度とそのツラを見せるんじゃあねぇぞ！　お前の居場所は隔離区画だ。一生そこにすっこんでろ！」\n「申し訳ないが、君を採用することはできないよ。」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……\n分かったよ、出ていけばいいんでしょ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「こんなにたくさんの草履と麦わら帽子があるのに、一つも売れなかったの？」\n「仕方がないだろ！　色々と売り込んではみたんだが、どの卸し先も買い取っちゃくれなかったんだよ。チッ……今じゃ俺たち一家は村長にさえ避けられるようになっちまった。」\n「だったら、移動都市に行ってみたらどうかしら……」\n「確かにそれはいいアイデアだ。婆さんの形見のいい綿布がある。明日にでも市場に行って売ってみるよ。もし売れたら中古の屋台が買えるかもしれない。」\n「それなら私の銀の腕輪も持っていって！　きっとなんとかなるわ……あの子を追い出すわけにはいかない。だって、私たちの子に変わりはないんだもの。」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……\nやっぱり、ボクは出ていったほうがいいみたいだね。昔のようには戻れなくても、ボクはそれらしく生きてみせるよ。\nでも……一体どこへ行けば自分の居場所を見つけられるんだろう？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "なに？\nうるさい……\n分かったよ、出ていけばいいんだろ？　もう追い出そうとしなくていいよ！　ボクは一人で生きていけるんだ！\n「ヴァーダント――」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "うるさいよ！　もう分かったって！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "夢、か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "あの草は……まだある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "あれ？　ここ、新芽が出てる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "確か、生存環境が急激に変化すれば、かえって力強く成長しようとする習性を持つ植物もいるんだっけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "小さな草さん……このサンプルケースを安全な居場所として思ってくれてるのかい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "おーい、ヴァーダント！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "はやくドアを開けろ！　まさかまだ寝てるんじゃねぇだろうな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "タッカー？　なんでこんなところに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "……なんでこんなところにだってぇ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "おいおい、昨日オーケーしてくれたじゃねぇか？　俺にも植物ハンターを体験させてくれるってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "本気だったのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "いいから早く出発しようぜ！　俺が加わりゃ任務もやりやすくなるはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "そうなりゃその植物ももっと早く植物研究所に持って行けて、すぐ鑑定してもらえるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "その話も忘れてなかったんだな……まあ、鑑定する分には別にいいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……はぁ、分かったよ。一緒に行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "でも、そんな風にあちこちに足跡を残されちゃ、任務がやりやすくなるとは言えないかな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "とりゃあ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "へへ、どうだ！　こんだけ屋根が離れてても余裕で飛び移れて――うわああああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "気を付けて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ふぅ、危なかった。俺まで瓦と一緒に落っこちるところだったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "とっさに掴んでくれて助かったよ、ヴァ……って「かかし」かよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ボクは普通に下から登らせてもらうよ。誰かさんとは違うんでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "それに「かかし」に礼を言う必要はないさ。タッカーが村中の人を呼び寄せて屋根の上でショーを始められても困ると思っただけだろうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ホント、お前ってば学校にいた頃と全然変わってねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "一足先に社会人になったっていうのに、少しくらい暖かい目で見てくれたっていいじゃねぇか。俺たちダチだろ？　器が小せぇよな、まったく！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "急ごうか、タッカー。そこの煙突に入るんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "は？　煙突だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ちょっと待て、ノックして玄関から入るんじゃねぇのかよ……？　おい待て待て待て、なんかこの「かかし」俺を押して――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一瞬の静寂。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "大丈夫？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "あ、ああ……「かかし」がちゃんとキャッチしてくれたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "……言っとくが、これでも声を出さないようにちゃんと我慢したんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "分かってるよ。それじゃあ、ボクも下りるとするか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ふぅ――なあ、コレ聞こえる？　心臓がまだバクバクしてるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ついさっき、植物ハンターと一緒に「最後の部屋」に入って、マジもんの「古代の不思議な作物の種」を手に入れたんだぜ？　信じられねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "田舎の空き家で依頼の品を回収しただけじゃん……大げさなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "まあそれはそうだが、言われてみればそこまで刺激的なもんでもなかったかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "それに、謎を解く場面が一切なかったんだが？　入ってブツを手に入れて、そんで出て……これだけか？　ちょっと楽ちんすぎやしないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "となりゃその種も、きっと大して珍しいもんじゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "いや、これは多分、前の連絡係が残していったものだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "連絡係？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "植物ハンターが受ける仕事だって、別に危険に見舞われるようなものばかりじゃないんだ。こんな感じで、指定した場所で物を受け取る簡単な仕事だってあるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "……それってほとんどトランスポーターじゃねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "最初の植物ハンターはまさに、国を跨いで香辛料を売り歩く商人の役目を請け負ったトランスポーターだったって言われてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "なーんだ。蓋を開けりゃ全然カッコよくもなんともねぇな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "まあまあ。とりあえず拠点に戻ろっか。雇い主にも報告しなくちゃならないからね。できればもうこれ以上新しい仕事を増やさないでほしいものだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "あのさタッカー、さっきぬかるみを通った後は靴底をきれいにするようにって言ったよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "え？　ちゃんと拭いたけど。ほら、ピッカピカだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "だったらこの足跡は一体……拠点の周りでも見かけた気が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "まさか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "は？　おい、どういう意味だ？　なんで急に走り出して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "タッカーも急いで！　間に合わなくなる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "遠くから拠点のある方角を見ると、そこには濃い煙が立ち込めていた。\nその方角に向かって全力で駆けるヴァーダント。煙の匂いは鼻腔を刺激するほどにますます濃くなり、息苦しくなっていく。\nそしてつい先ほど抱いた微かな不安は、今や目の前で燃え盛る炎に変わってしまった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ぐはっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "驚く用心棒",
      "text": "おい見ろよ、こいつが持ってたモンを……予想外の収穫だぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "驚く用心棒",
      "text": "シカクヒマワリの種じゃねぇか！　こいつはいい値で売れるぞぉ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "いいから、黙って手を動かせ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "拠点にある緊急通信機のケーブルも切っておけよ。他にも使える物はすべて頂戴しておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静な用心棒",
      "text": "よし、こいつが意識を取り戻す前にズラかるぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "や、め……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "どうして……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "どうして……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ねえママ、田んぼに草がたくさん生えてるよ。全部取っちゃうの？\n「そうね、作物の成長の妨げになっちゃうから。」\nじゃあ、作物から離れたところに移すのはどう？　たとえば、裏庭に植え替えるとか。\nボク、その草たちが大きくなった姿が見てみたいんだ。\n「へぇ……面白いこと考えるじゃない。」\n「育ててみれば、もしかすると麦になったり、アワになったりするかもしれないもんね。」\n「聞いた話じゃ遠い昔、そういった作物たちもその辺の草と大して変わりはなかったらしいわよ。」\n……でも、もし食べられないものになったら？\nもしキレイなお花をつけられなくて、クサイ匂いを出したらどうしよう！\n「ふふ、うちの子ったらもうそんな悩みを持つようになったの？　大丈夫、心配はいらないわ――」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「どんなものになろうと、ちゃんと自分なりの価値というものが見つかるはずよ。」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "ヴァーダント！　さっき逃げてった二人、「カッシバナ」の保温箱を持ってなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "……お前、ケガしたのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "え、なんて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "あいつらを追いかけるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "草が、心配だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "草だって？　……おい、お前まさか拠点に入ろうってんじゃ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タッカー",
      "text": "よせって！　火はどんどん大きくなってるんだぞ！　やめるんだ、ヴァーダント！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "あいつを……植物研究所に持って行ってやらなきゃ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "まだ、名前だって付けてあげられていないのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "あの草は、誰にも注目されなかったとしても、田畑の中で粘り強く生きようとした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "身勝手に取り除かれていいはずがない。ましてやこのまま火の海に消えるだなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "追い払われていいはずも、忘れられていいはずもないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "そいつはただ、生きていたいだけなのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "ゲホゲホッ……ゲホゲホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "よかった……ボクのサンプルケース、まだここにあった……盗られてなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "目立たないこと、それも君の長所なのかもね……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ヴァーダントはケースのガラスに付着した黒いすすを拭き取ると、焦りつつも植物の安否を確認した。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "……えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァーダント",
      "text": "君は……あの草なの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンプルケースの中身が炎に照らされ、ヴァーダントの目にはっきりと映し出された。\n急激に温度が上昇した拠点は、彼の小さな草にとって明らかに快適とは言えない環境になってしまった――\nヒエのような葉は萎れて、カヤツリグサのような茎も折れ曲がってしまったが、あのエノコログサに似た部位は、なんと今まさに「咲いて」いたのだ。\nこれがこの植物の花なのだろうか？　ヴァーダントにはそれが分からなかった。この大火事のせいで、形態が変化したのだろうか？　それも分からなかった。\n芽吹いた細いヒゲのような部位を初めて目にした時、それがその植物の花であると断定できる者はいないはずだ。\n萎れてしまった葉と折れ曲がってしまった茎を見れば、この状態が「咲き誇っている」とも到底言えないだろう。\nだがヴァーダントはこの時、この植物がヒエでもカヤツリグサでもなければ、彼の知るどの野草でもないことを確信したのだった。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
