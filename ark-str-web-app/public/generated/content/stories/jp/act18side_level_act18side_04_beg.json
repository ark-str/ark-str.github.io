{
  "server": "jp",
  "storyId": "act18side_level_act18side_04_beg",
  "groupId": "act18side",
  "stageId": "act18side_04",
  "title": "驚愕",
  "storyCode": "LE-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18side/level_act18side_04_beg.txt",
  "sourceHash": "76eb3bdca27876d2a14ee68454dd3f8b18d500d4e7222a25e809bb2fc3ea3485",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "（あくび）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "はい、今行きます……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "……ハイビスカスさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "おはようございます……随分早いですね、まだ明るくなったばかりなのに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "エーベンホルツさんはどちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "エーベンホルツさん？　まだ寝ていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "目が真っ赤ですけど、徹夜でもされたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "――彼を起こしてください、すぐに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "「疑似回復」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何が言いたいのか全くわからんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "本当にわからないんですか？　それとも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "いいですか、もう一度説明します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私がアフターグロー区に来たのは、ここの感染者の病状が急激に好転する異常回復現象を調査するためです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ここ数日調べ回った結果、アフターグロー区の感染者の症状は回復ではなく、「疑似回復」だったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "つまり、病人の状況は回復しているように見えて、実際は悪化しているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "どうして悪化しているのに、回復しているように見えるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……簡単に言いますと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "通常、身体が損傷を受けた後の最良の結果は、「元の状態に戻る」ことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "それができない場合、身体は損傷を受けていない部分を通常以上に働かせることで、損傷で失われた機能を補おうとします。一般的な医学用語ではこれを「代償作用」と呼んでいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "現在アフターグロー区の感染者のほとんどに、この代償作用が起きています。その結果、表面的には皆さん元気で、中には健常者と区別がつかない人さえいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ですが、見えない場所――体の内部では、鉱石病の感染が急速に進行しているんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "今のペースで進めば、一部の人が代償不全の段階に至るのに、さほど時間はかかりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "代償不全？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "損傷度が身体の代償能力の限界を超えて、ぎりぎり保たれていたバランスが崩れることです。患者さんは鉱石病の急性発作を起こし、病状は急激に悪化して、命の危険が生じます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "事実、すでに急性発作を起こす段階に入っている方もいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君の言いたいことはわかった。しかしそれと私たちに一体何の関係があると――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "待て、まさかクライデも危険な状態なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "いえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "問題はそこではありません。調査結果の分析によると……この状況を引き起こしているのは、どうやらあなたとクライデさんだと思われるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私とクライデが、この状況を引き起こしているだと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何を馬鹿なことを言っている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あなたたちの行動ルートを分析して確信しました。あなたたち……もしくはあなたたちに付随する「何か」が、疑似回復現象の発生と非常に強い関連性を持っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "例えばあなたたちの住居の隣にあるクリーニング屋の女性ですが、一昨日は「とても気分が良い」と言っていたのに、昨夜になり急に病状が悪化し、末期感染者処理場に送られるところでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "お二人にお願いします。もし何か思い当たることがあれば、すぐに教えてください！　アフターグロー区民すべての命の安全に関わることなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "二人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "全く覚えがありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "思い当たるふしがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "万が一ということもあります。一緒に事務所へ来て検査をさせてください。お願いできますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "指標からすれば、一人は正常な健康体、もう一人は安定期の鉱石病患者……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "ハイビスカス、今度はアフターグローホール裏の楽器屋店長だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "――どんな状況ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "幸い、その人はクリフィーパティオ区の病院と契約していたから、すでにそっちに運ばれたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "その方も疑似回復ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "うん、昨日の午後の報告には「どこも悪くない」ってある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "あたしちょっと行って様子を見てくる。病院側から変な契約を押し付けられてるかもしれないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "この二人は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私がついています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "じゃあ行ってくる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "もう一度、お二人に伺いますね。何かこの件で思い当たることはありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "今は一刻を争うんです、お願いします！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "こうしましょう。エーベンホルツさん、私と来てください。二人で話をしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "クライデさんは部屋でしばらく待っていてください、いいですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私一人を呼び出すとはどういうつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "もし何か間違いがあれば謝ります、ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "クライデさんから離れてほしいんです。できるだけ早く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "どうして彼ではなく、私なのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "その「疑似回復」とやらが私の仕業だと疑っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……いえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "むしろあなたがこの事件の元凶であればいいと望んでいます。あなたをヴィセハイムの保安官に差し出せば、すべて解決しますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ですが疑似回復現象はあなたが来る前から起きており、アンダンテさんもそれに気付いていました。でなければ私もヴィセハイムには――アフターグロー区には来ていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ならば、なぜこんなことを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "待て、私が来る前から？　ではクライデは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "疑似回復現象は……彼がヴィセハイムに来てから起きるようになったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "彼がヴィセハイムに来てから……そんな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "クライデさんがアフターグロー区にやって来たのとほぼ同じ頃に、一部の感染者の指標が徐々に良くなり始めています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "でもその時はまだ、感染者に対する彼の影響はごくわずかで、注意深いアンダンテさん以外、誰もそれに気付きませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "データ上では、あなたたちが参加申込会で出会ってから、突然目に見えて指標が上がったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "アンダンテさんがロドス本艦へ報告した内容に基づくと、クライデさんのもたらす影響だけなら、今のレベルまで状況が悪化するには少なくとも半年の時間を要するはずでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "しかし、あなたが来てからたった数日の間で……こうなってしまったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あなたに原因を説明してもらう必要があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "もし説明できなくても、事態の収拾がつかなくなる前にこの現象を止めなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "なので、今すぐアフターグロー区から――ヴィセハイムから離れてほしいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "コンサートはどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "コンサートって――何をバカなことおっしゃっているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "仮に疑似回復現象が何かしらのアーツで引き起こされているなら、あなたたちの演奏がそれを強めている可能性が高いんです――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "まさか……それがあなたの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "やめてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "率直に言って、あらぬ疑いをかけられるのは非常に不快だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あなたが不快に感じたからという理由で看過できる問題ではありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "わかっている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "だから、少し時間をくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "どれだけの時間ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "短くて数時間、長くて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……わからない。だがまた君を訪ねると約束する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……わかりました、今回はあなたを信じます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "待ってください。僕は――僕は同意できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "エーベンホルツさんはようやくコンサートの参加資格を得られたんです。やっとの思いでツェルニーさんに認めてもらえたんです……こんな中途半端で投げ出すなんて、そんなの悔し過ぎます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "個人の感情はもう関係ありません。人の命に関わる重要なことなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "でも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "エーベンホルツさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "エーベンホルツさん、どこへ行くんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "エーベンホルツさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "まあ、そんなに息を切らして……走って来られましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "考えなしに私を訪ねるのはお勧めしませんわ、露見する可能性が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "露見？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今になって、露見を気にしているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "教えろ、貴殿の言っていた「塵界の音」の共鳴とは、他人に影響を与えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "共鳴が？　いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "故意に用いなければ、人になんら影響を与えませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ならば、なぜハイビスカスは私とクライデが疑似回復現象の原因だなどと言うのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "ハイビスカス？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ロドスからヴィセハイムに来ているオペレーターだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "ロドスがこの現象を「疑似回復」と言っていましたの？　さすがは専門家ですわね、正確かつ簡潔な表現ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "貴殿は……やはり知っていたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "この頃アフターグロー区の感染者の身体に起きている異常現象のことでしたら、確かに知っていますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "一体どういうことだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "一言で言えば、クライデの体内の「塵界の音」は損なわれていて不完全ですの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "不完全！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "あなたがアーツを放つ時は、体内の「音」が活性化して力を貸してくれるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ああ。確かに術を放つ時には耳障りな旋律が微かに聴こえる。だがこんなものがどうやったら壊れると言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "クライデの「音」は、常に異常な活性化状態にあり、今のあなたのように「閉じた」状態が存在しませんの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "言い換えれば、彼は常に無自覚のまま周囲に術を放ち続けておりますのよ。そして彼自身もこれをコントロールできていませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "彼に訊いてみれば、恐らくずっと何かしらの旋律が微かに聴こえていると言うでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "この現象を「漏出」と理解すればよろしいですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "いわゆる「疑似回復」とは、彼の「音」が漏れ出た結果として起こる現象――無差別に周囲の源石を活性化し、そのエネルギーを利用して周囲の感染者を「回復」させるのです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "ただ、感染者の回復に用いられるエネルギー源が、彼ら自身の体内の源石であるということですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "感染者自身をアーツ装置として、体内の源石をエネルギーに彼らの代償作用を促している……これがクライデの「塵界の音」が引き起こしている「疑似回復」の正体ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "恐らくかなり前からずっと、クライデはこのような状態にあって、周囲の感染者に影響を与え続けているはずですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ずっとこうであったなら、とっくに誰かがその異常に気付いていたはずだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "拍車をかけたのはあなたですわ、ミスター・エーベンホルツ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私が！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "――「共鳴」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……共鳴によって、クライデの「音」の漏出が強まった。だから疑似回復現象がここ数日で爆発的に広がったと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "全くその通りですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そうか、完全に理解した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "貴殿の計画からは手を引かせてもらう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "手を伸ばせば届く自由を、そんな簡単に諦めてしまいますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "まだ一区画分の感染者の命と引き換えに自由を手にしたいほど、私は狂ってはいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "ロドスの人間に脅されたのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "疑似回復現象は確かに良いことではありませんわ。ですが、あなたとクライデの演奏はたった数日後に行われますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "この数日さえやり過ごせば、あなたの「音」は取り除かれますわ。それからヴィセハイムを去ったところで、犠牲者の数は今とそれほど変わらないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "このようなチャンスはめったにありませんわ。ここでやめてしまったら、ウルティカ伯爵という身分が一生ついて回りますのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "本当にそれを望んでいらっしゃいますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……望んではいない、だが私は外道にはなれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "さらばだ、ミズ・ゲルトルーデ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "どこへ行かれるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "貴殿には関係ないことだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "足元がおぼつかないようですわね。頭痛の発作かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "言っただろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "お前には関係ない！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
