  "sourceHash": "b60da1373f4b4bdfc6b392f9d15e7467936f5f10ddc27ee861d42cb812e217cd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "st03"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "……殿下。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "残念だわ……やはり遅れてしまったわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "そ……それはつまり、私と同様に遺憾に思われていらっしゃるのですか？　我々がここであの者たちを止められなかったために？"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "マンフレッド……"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "昔……カズデルで、あなたが私に話しかけてくれた時はもっと自然体だったわよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "あの時のあなたは、私の目を見て話してくれていたわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "殿下、当時のカズデルは、一面の廃墟と、その横に並べた青写真があるのみでした。あなたと将軍は……"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "いえ、今さら過去の出来事を蒸し返す必要はありませんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "あなたは将軍のおそばへと戻られた。お二人は王庭を率い、必ずやサルカズに勝利をもたらすでしょう。これまで数限りなく繰り返された事実です。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "私や他の将兵たちにとって、記憶しておくべきはこれだけです。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "ええ……"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "でも、マンフレッド……私は本当にあの子に会いたいの。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "それは――！"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "マンフレッド、一度命を失った者に再び夢は訪れると思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "この数ヶ月、私はよく彼らの夢を見るわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "何度も何度もあの船の夢を見た。無愛嬌なお医者様とおしゃべりしたり、無口な指揮官と一緒に甲板に立ったり、それに……"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "……毎晩毎晩、私はベッドに寄りかかって、この大地とサルカズのお話をしながら、あの子を寝かしつけているの。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "将軍は……この件をご存じなのでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "彼はすべてを知っているわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "でも夢はただの夢なの……そうでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "殿下、お顔に……"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "ああ……埃が付いていたわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "speakerId": "avg_npc_404_1",
      "text": "そうですか、私はてっきり……"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "私は涙を流さないから。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレジア",
      "speakerId": "avg_npc_056",
      "text": "そうね……なぜ涙を流さないのかしら？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "摂政王殿下、やはり「彼女」を城壁へと向かわせたのですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "お前は「魔王」の脅威をよくわかっているであろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "十二分に。かの力の継承者を捕らえるのは難題です。マンフレッドや大君であろうと仕損じる可能性があります。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "――「魔王」を打ち破るために最も適した人選は、自ずともうお一方に。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "お前が私にあの提案をしたのは、この算段があったからであろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "確か、初めて「彼女」を連れ戻すことを提案した時、私は殿下に殺されかけました。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "「吐き気がする」――そのように殿下はおっしゃいました。殿下のお怒り、いまだに忘れられません。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "私の評価に変わりはない。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "ですが我々にはやはり「彼女」が必要です。違いますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "お二人が並んで立つ姿を目にしてやっと、先の混乱による暗黒の時代は終わったのだと将兵たちは信じるのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "彼らは二度と、殿下が下す命令の正当性を疑いません。サルカズの心の中に、今後別の声が現れることはなくなるのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "そのためにも、我々は早急にもう一人の「魔王」を掌握する必要がございます。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "ならば、それを確実なものとするのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "将兵たちは戦争に目を向け続ける必要がある。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "理解させねばならない。従うべきは、己を苦境から救い上げる力を持つ君主である。誰の手にあるかも定かではない力など、言語道断だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "ええ、ええ、承知しておりますとも。殿下はあの黒い王冠など気にかけておられない。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "ですからご存じの通り、私が「魔王」に対する研究の手を止めたことはございません。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "「彼女」のおかげで、進展もございました。仮に我々があのコータスをも手に入れることができれば……「魔王」の力を全て明らかにするまで、そう長くはかからないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "サルカズは奴隷であってはならない。いかなる者にも、いかなる力にも隷属してはならない。"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "「魔王」の王冠も枷の一つであるのなら――"
    },
    {
      "type": "dialogue",
      "speakerName": "テレシス",
      "speakerId": "avg_npc_062",
      "text": "それを打ち壊す。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "殿下のご理想はまさに私の理想でもございます……私がそれを叶えてみせましょう、摂政王殿下。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "随分と遅いお戻りですね、大君。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "……フッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "いくらか……お疲れのご様子ですが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "聴罪師、バンシーも参加するとは聞いていません。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "ああ……あなたなら予想がつくと思っておりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "フンッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "バンシーは場合によってナハツェーラーよりもやっかいです。あの若者の才は少し目を見張るものがありました……"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "ですが、次の機会があったなら、彼の舌を水晶の箱の中に飾るとしましょう。彼の母への贈り物としてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "摂政王殿下とナハツェーラーの王は、そのお考えがお気に召さないでしょうね、大君。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "ならば彼らに知られる必要もないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "それとマンフレッド……私の頭上であの城壁のおもちゃを起動させるとは。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "私がここまで汚れたなりになったのは、半分彼のせいです。彼には少し教育が必要かもしれませんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "お怒りは理解できます、大君。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "こういたしましょう。此度お伝えした情報に遺漏が存在したお詫びとして、「魔王」捕縛の任務をあなたに移行していただくよう、私が摂政王に進言しておきます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "フッ、やはりあの者はしくじったのですね。テレシスにはとうに忠告したのです、あれは甘ちゃんのごく潰しだと。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "構いません、これもまたすべて摂政王の計画のうちです。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "逃げ延びた者たちには、束の間の喜びを享受させてやりましょう。人の希望や信念を打ち砕く最も効果的な方法は、それを実現させてやることですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "フッ……確かに都市の貴族たちは、醜い欲に突き動かされて蠢いていますからね。あなたの言う通り、彼らには思う存分愚かな行いを重ねてもらいましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "宴が最高潮に達し、喧噪を途切れさせた静寂が悲鳴に成り代わる瞬間……あの芳醇な香りが悩ましく快い。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "しかし、貴族と言えば――"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "まだほかに摂政王に報告したいことでも？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "いいえ、何も。"
    },
    {
      "type": "dialogue",
      "speakerName": "ブラッドブルードの大君",
      "speakerId": "avg_npc_410_1",
      "text": "テレシスに伝えておいてください……私は次の宴の始まりを待っていると。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "……何かに気付いていながら、あえて隠した？"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "このような小細工……摂政王にも我慢の限界はありますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵",
      "speakerId": "avg_npc_425_1",
      "text": "リーダー。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "都市の外の公爵軍にまた何か動きがありましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "そうですか……"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "ナハツェーラーの王もまもなく戻ります。彼が戻ってきたら、すぐに摂政王に謁見するよう伝えなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "それと……あるヴィクトリアの貴族が、何人かのトランスポーターを送り返してきたと言いましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "行きましょう、その者たちに会うのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵",
      "speakerId": "avg_npc_425_1",
      "text": "リーダー、もう一つお耳に入れたいことが。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "……ほう？"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "彼女が……このタイミングで戻ってくるとは。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "ふむ……"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師直属衛兵",
      "speakerId": "avg_npc_425_1",
      "text": "何かお考えはありますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "王立科学アカデミーに伝えてください。"
    },
    {
      "type": "dialogue",
      "speakerName": "聴罪師",
      "speakerId": "avg_npc_427_1",
      "text": "久方ぶりに……家族団らんといきましょう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "リズさん……調子はいかがですか？　道を急ぎ過ぎて、疲れたりしていませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "speakerId": "char_179_cgbird",
      "text": "……大丈夫です。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "もしどこか具合が悪ければ、必ず教えてください。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "speakerId": "char_179_cgbird",
      "text": "はい……胸の辺りがうつうつとします。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "家に近づいているからですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "speakerId": "char_179_cgbird",
      "text": "いいえ、あれは家ではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "speakerId": "char_179_cgbird",
      "text": "シャイニングさん……あなたとニアールさんのそばが、私の家なのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "本来なら、あなたをここに連れてきたくはありませんでした……"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "speakerId": "char_179_cgbird",
      "text": "ですが、私はついてきたいのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "speakerId": "char_179_cgbird",
      "text": "私はあなたのそばにいたい。そして……失ったものを取り戻したいのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "speakerId": "char_179_cgbird",
      "text": "私……感じます。あれらがここにあると。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "はい、リズさん。きっとあれは見つかりますし、あなたもきっと快方に向かうはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "その時がきたら……ロドスへと帰りましょう。カジミエーシュへ行くのもいいでしょう……あなたが望む場所であればどこでも。"
    },
    {
      "type": "dialogue",
      "speakerName": "ナイチンゲール",
      "speakerId": "char_179_cgbird",
      "text": "……あなたも、一緒に行ってくれますよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "私は……"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "はい、リズさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "シャイニング",
      "speakerId": "char_147_shining",
      "text": "どんな時であろうと、あなたが望みさえすれば……私はあなたのそばにいます。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "speakerId": "avg_4040_rockr_1",
      "text": "あたしたち……みんな生き延びたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "speakerId": "avg_npc_402_1",
      "text": "ああ、どうやら、ようやく一息つけそうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "speakerId": "avg_4040_rockr_1",
      "text": "ううぅ……わぁぁぁん！"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "speakerId": "avg_npc_402_1",
      "text": "うわ、な、なに泣いてんだ？　なな、泣くとこなんて見たこともないぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "speakerId": "avg_4040_rockr_1",
      "text": "うぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "speakerId": "avg_4040_rockr_1",
      "text": "何でもない。ただ……ビルのことを思い出しちゃって。そしたら涙が……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "speakerId": "avg_npc_402_1",
      "text": "ビルか……はぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "speakerId": "avg_4040_rockr_1",
      "text": "ううっ……コホンッ。ダ、ダメだ、こんなんじゃダメ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "speakerId": "avg_4040_rockr_1",
      "text": "戦いは……まだ終わってない。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "speakerId": "avg_npc_402_1",
      "text": "大丈夫だって、今は安全なんだから、もう休んでいいんだ。ビルのことを、仲間たちのことを考えていいんだよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "speakerId": "avg_npc_402_1",
      "text": "……次の戦いが始まるまでの、俺たちの権利だよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_397_1",
      "text": "ようやく会えたね。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "貴様は……"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_397_1",
      "text": "アラデル・カンバーランド。アラデルと呼んでちょうだいな。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "私はクロヴィシアの友人よ。自救軍オークタリッグ区――つまり皆が言う中央区の責任者。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "……カンバーランド？"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "貴様はカンバーランド公爵の……"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "……娘よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "でも父が死んだ時、私は幼い子供でしかなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "父は剣術の試合が終わるたびに、汗ばんだひげを私の顔にこすりつけていたの――二十年以上経つけど、残っているのはこんな記憶だけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "聞くところによると、カンバーランド公爵は……王室に反対する公爵たちの手にかかったということだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "父は理想のために、自分が唯一正しいと信じる道を歩いていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "私は父を尊敬しているの。それも今ここにいる理由よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "貴様と市内の他の貴族は……これまでずっとサルカズに対抗してきたのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "そう。でも、私たちの努力はようやく実を結びそうな気配が見えたばかりね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "イザベルが訪ねてきた時は、本当に驚いたの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "彼女がマンチェスター伯爵の後継者だから、というだけじゃなくて――まあ確かに伯爵はずっと私たちの一番頼りになる後ろ盾の一人ではあったんだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "塔楼騎士は全員犠牲になったものだと思っていたからね……イザベルが帰ってきたことは、我々にとってこれ以上ない励みなの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "もちろん、私を一番驚かせたのは……あなただけどね。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "私が誰かを知っているのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "ハハッ、最初は知らなかったわ。でなければ驚くわけないでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "何年もあなたの行方を捜索し続けてきたけど、手掛かりは全く得られなかったし、とっくに亡くなったと思っている者もいたくらい……"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "私は信じなかったけどね。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "てっきり、私を探している者の大半は抹殺を目的にしていると思っていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "かもね……"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "けど、そうした人々ですら、大半がもう考えを改めていると思う。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "あなたも今のロンディニウムを目にしてわかったと思うけど――"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "人々はとうの昔に自由を失っているの。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "ヴィクトリア人はみんな……まだ称号を奪われていない貴族たちですら明日が見えない状況だわ。サルカズの奴隷になるか、一日を生き残るために戦々恐々としてるかのどっちかよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "夜中に夢を見ている時も、「陛下」と呟いていることでしょうよ――"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "……もしあの日、突如に執行された絞首刑がなかったら、ロンディニウムは今のようになっていなかったかもしれない。この仮定を反芻しないヴィクトリア人なんていないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "私がここにいれば、現状を変えられるとでも？"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "少なくとも我々には一つの可能性が増えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "まだ考え続けているみたいだけど、覚悟を決めたことはわかっているわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "……そうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "イザベルを私のとこに送り込んだのは、私たちを率いてサルカズに立ち向かう準備ができた証拠じゃない？"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "否定はしない。私は確かに一つの決断をした。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "しかし準備というものは……いくらしても足りない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "間違いないね。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "早速だが、アラデルさん……いや、アラデル。我々にヴィクトリアの状況を教えてほしい。"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "speakerId": "avg_npc_407_1",
      "text": "私にはずいぶん補習を受けないといけないことが溜まっているだろうから。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "よかった、そういう心意気は大好き。それこそ我々が必要としているものだわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "では……"
    },
    {
      "type": "dialogue",
      "speakerName": "アラデル",
      "speakerId": "avg_npc_397_1",
      "text": "よくぞご帰還なさいました、アレクサンドリナ……殿下。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "char_003_kalts",
      "text": "ハイディ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "ケルシー……ふふ、ケルシー。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "――あなたとお会いするのは、やはり難しいですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kalts",
      "text": "出てくる際、君をつける者はいなかったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "ご安心ください、ここまでの痕跡は細心の注意を払って消してあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "それすらできず、あなたのトランスポーターなど務められるはずがないでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kalts",
      "text": "君はもう十分に優秀だ。お父上も誇りに思うだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "ハハ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "実はですね、これまで何度も、失敗するかもしれないと思った時……もしケルシーがいたら、あなたはどうするだろうと考えずにはいられませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "私が皆様と一緒に苦境を乗り越えた時、あなたは何と言うだろうかとも考えました……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "ですがこの瞬間、あなたが本当に私の前に立っている今、何もかもどうでもよくなりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kalts",
      "text": "ハイディ、君は確かに準備ができている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "……はい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "少なくとも……私はいつでも問題ありません。私たちは皆そうです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "そうだ、アーミヤにはすぐにお会いになりますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kalts",
      "text": "彼女が現在安全であることは確認している。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kalts",
      "text": "随分ロンディニウムに戻っていなかったからな。私にはまだ処理しなければならないことがある。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "そうですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": "avg_npc_400_1",
      "text": "ある方が……ずっとあなたに会いたがっていますよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_412_1",
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_412_1",
      "text": "ケルシー、説明してちょうだい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kalts",
      "text": "――生きていたのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kalts",
      "text": "今回は何を説明してほしいんだ、W？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "あんたは相変わらず、うざいほど冷静ね。ロドスが来る前に、あんたは一体知ってたのかどうか、あたしには判断がつかないなんて思わなかった……"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "まあいいわ。あたしが知りたいことに比べたら、あんたが化け物かどうかはどうだっていい。"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "テレジア……あれは本当にテレジアよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_412_1",
      "text": "あんた――なんでテレジアの身体をみすみすテレシスに！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "avg_npc_394_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "あっ……すみません、ドクター、気が付かなくて。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "列車を降りてから、浮き足立っているな。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "列車で一体何を見たんだ？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "はい……"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "ドクターに隠すことはできませんし……隠すべきでもないですね。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "Dr.{@nickname}、私は見たんです……彼女を。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "ドクター……ロックロックさんが話していたのは、本当に彼女のことだったんです。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケルシーが言っていたが、彼女はすでに……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "ケルシーが言っていたが、自分が……",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それにWの自分に対する態度は……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "四年前、テレジアさんはすでに亡くなっています。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "この事件の背後にある真相について、ケルシー先生やWさんの見解は私とは違うかもしれません……ですが、全員の認識が一致している事実があります。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "……あの日、私たちは確かに彼女を失いました。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "なら一体どういうことだ……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "……わかりません。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "ですが……駅で彼女を見た瞬間、ようやくわかりました……なぜ私はロンディニウムであのような感情を感じたのかを。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "怒りとは別の……哀しみ。尽きることのない哀しみです。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "そうです……サルカズにとって、怒りと悲しみはいつだって共存するものです。ただ彼らのほとんどは怒りの炎で涙を枯らすことを選びます。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "そういった思いが……満ちて渦巻いた感情が、全て彼女の瞳の中に集まっているかのようでした。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "過去のテレジアさんですら、あんな目はしていなかった……"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君は今とても辛いんだな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "辛いですか？　そうかもしれません。でもこの程度の辛さは、彼ら……憎悪と偏見に身も心もバラバラにされたサルカズたちには、鼻で笑われると思います。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "私が感じられるものは……あまりにも、あまりにも少ない……"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "ほんの一瞬視線を交わしただけで、彼女の瞳の中で逆巻く感情に、私は危うく溺れるところでした。あんな感情――"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "テレジアさんには何があったのでしょうか？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "これは君の責任じゃない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "本当にそうですか？"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "ドクター、私は前にも言いましたよね。あれが本当に彼女本人だとは思えないと。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "でも……この目で直に彼女を見た時、自分の目にしたものを受け入れることは、それほど難しくはないと気付いたんです。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "ここまで来たからには、真相を明らかにしなければなりません。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "テレジアさんだけでなく、この都市にいるサルカズたちについてもです……彼らが一体何を経験して、あれほどまで多くの怒りと哀しみを抱くようになったのでしょう？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "もし真相がより多くの苦痛をもたらすとしたら？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "Dr.{@nickname}……"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君は怖さを感じてもいいんだ、アーミヤ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "自分も怖い、アーミヤ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "だけど我々は共に歩んでいく。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "はい！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "Dr.{@nickname}、一緒に……"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "avg_npc_394_1",
          "text": "答えを探しに行きましょう。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それは自分の求めていた答えでもある。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アラデル",
          "speakerId": "avg_npc_397_1",
          "text": "お二人方、会話の邪魔をして申し訳ない――"
        },
        {
          "type": "dialogue",
          "speakerName": "アラデル",
          "speakerId": "avg_npc_397_1",
          "text": "アレクサンドリナ……ああ、ヴィーナのことだけど、彼女と我々自救軍にとって非常に重要で緊急の用件があるの。"
        },
        {
          "type": "dialogue",
          "speakerName": "アラデル",
          "speakerId": "avg_npc_397_1",
          "text": "ハイディさんからの手紙に従って、この件はあなたを訪ねるしかないと判断した。"
        },
        {
          "type": "dialogue",
          "speakerName": "アラデル",
          "speakerId": "avg_npc_397_1",
          "text": "Dr.{@nickname}――"
        },
        {
          "type": "dialogue",
          "speakerName": "アラデル",
          "speakerId": "avg_npc_397_1",
          "text": "エドワード・アルトリウス氏の遺品は、今あなたがお持ちでは？"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
