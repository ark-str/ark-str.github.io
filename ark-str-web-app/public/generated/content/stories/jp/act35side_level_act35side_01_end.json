{
  "server": "jp",
  "storyId": "act35side_level_act35side_01_end",
  "groupId": "act35side",
  "stageId": "act35side_01",
  "title": "お祭り前の肩慣らし",
  "storyCode": "AS-1",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act35side/level_act35side_01_end.txt",
  "sourceHash": "ff08581daf26553ad1fb9f80b1edd9cb9c755bc6917e7b30cad7611168a14453",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "慌てる観衆",
      "text": "ぎゃあああーー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恐れる観衆",
      "text": "ミ……ミイラが動いた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恐れる観衆",
      "text": "お、お化けだ！　は、早く逃げろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "恐れる観衆",
      "text": "あのミイラ、こっちを見てないか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる観衆",
      "text": "やっぱりな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "慌てる観衆",
      "text": "いずれ起こるだろうと思ってたさ！　これほど長い歴史を持つ都市だからな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "皆さん冷静に。慌てないで、落ち着いてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "みんなこちらへ！　非常口から順番に出るんだ。押さないで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "ちょっと、通して、通してください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "すみません、ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "*サルゴンスラング*、アナト！　聴こえるかしら、アナト！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "メジェティクティがひしめく群衆をかき分けると、床に青ざめた顔をしたアナトが倒れており、何か言いたげに力なく口をパクパクとさせていた。\nしかしその背後に立っている首をかしげてたミイラに恐怖を覚えたメジェティクティは、それ以上足を前に出すことができない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ティティ、君はお客さんたちの安全を確保してくれ。私がどうにかしてアナトとこのミイラを別の場所へと連れていく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "あなた怖くないの？　ミイラが動いてるのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "まあ……多少は。けど今年は二回も古歴紀期の墓の考古学作業に参加してるし、墓の主もこの目で二人見たからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "あれに比べれば、この人はまだ穏やかな顔をしているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "さすが考古学のベテランは肝の太さが違うわね……一人で平気？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "安心したまえ。考古学に携わる者は体力だって並じゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "ティティ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "アナト……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……大したことはないはずだよ。意識を失ってうわ言を口にしてるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "館長のオフィスならここから遠くないわ。あなたたちは通用口からお行きなさい。できるだけ人目を避けるようにね。私はお客さんの避難誘導が終わり次第、あなたたちの元に向かうわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "何が起きた？　まだ待ち伏せ場所に着いちゃいないよ！　早めに発煙装置を起動させたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "左のイヤホン",
      "text": "違う。何もしていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "どういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "右のイヤホン",
      "text": "会場内で別の誰かが騒ぎを起こしたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "ったく……群衆に紛れてターゲットが確認できない。彼女はどこへ行ったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "仕方ない。状況が変わったから計画を前倒しで実行するよ。彼女を見つけて、しっかりと見張り、逐一報告するように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "右のイヤホン",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "手早くね。うまくやりおおせたら群衆に紛れ込むんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ナラントゥヤ",
      "text": "群衆が散らばってからだと、何もかもパーだからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "よし……みんな行ったようだね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "足を前に踏み出したペペは、ミイラの胸の中で青い光が流れているのを見た。\n例の宝石はその光の中に呑まれて、もう視認できなくなっている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ふんっ、やっぱり宝石が原因だったか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "君のその体勢……運びにくそうだな……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ペペは数秒間ミイラを観察した後、高い位置にあるミイラの左腕を低く下ろすことにした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（左腕を下ろす）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "（右腕を上げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ん！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（右腕を下ろす）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "（左腕を上げる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "どういうことだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ペペは眉をひそめ、首をかしげながらどうすればこのミイラに言うことを聞かせられるかを考える。\nすると驚いたことに、ミイラも首をかしげ、考え込むようなポーズを取っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "待てよ、君は……私の真似をしているのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ペペが左に一歩踏み出す。すると次の瞬間、ミイラも彼女の動きに合わせて一歩踏み出した。その足取りはほぼ同じものだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "むむ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "突然、ペペは後ろへジャンプした。ミイラもそれと同じように後ろへジャンプするも、背後は壁だったため、大きな衝突音が響いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ププッ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "どうやら君が動かせるのは手足だけであって、頭の方はちっとも働かないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "待てよ、もし同じ動作をするというのなら、もしかして……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "そばで昏々と眠るアナトを見て、ペペはあるアイデアを閃いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ふぅ、よーし……もう少しで館長のオフィスだ。私の真似をして曲がれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "（右に曲がる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "もっとアナトの肩をしっかり掴ませなくては。さっきは危うくずり落ちるところだったからね。こう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（右手を動かす）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "（アナトの肩を握る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "（無意識に眉をひそめる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "よしよし。そのままついてくるんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "（無意識にうめく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "いやいや待て、ダメだ。あまり歩幅が広すぎるとアナトが不快に感じるかもしれない……次は歩幅を狭くするよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "君も賛成したということで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "これでいけるはず……\nああ、ダメダメダメ――！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "歩幅があまりに狭すぎたため、ミイラは自らの服の長い裾を踏み、前方にバランスを崩して小柄なアナトの上に思い切り倒れ込んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "（無意識にうなる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "あちゃー。顔にできたこの赤いあざ、いつ消えるかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ハァ……まったく、君ってやつは頭が良すぎて困るね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "冷静に行こう。今度はしっかりと彼女を抱きしめるんだ。しっかりとね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "（無意識に眉をひそめる）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "さあ、私と一緒に歩くんだ。歩幅は広すぎず狭すぎず、いいぞ……前に進め……もう少し。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "そうだ、焦るな。ゆっくり行こう。オフィスまでほんの数歩だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ふと、ペペは視界の片隅で床に一枚の通行証が転がっていることに気づいた。それは自分のポケットから落ちたものだ。\n彼女は上げた自分の両腕と、アナトを抱くミイラの両腕を見た。\nミイラは非常に背が高い。もし手を放せば、アナトは悲惨にも後頭部から落下するだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "参ったな。どうやってオフィスに入ろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "どっちの手も下ろせない……足で拾い上げるしかないか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "（片方の足を伸ばす）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "（片方の足を伸ばす）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "よし、バランスは保てる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ダメだ、届かない。体が硬すぎるんだ。こうなることがわかっていれば、体育の授業をサボらなかったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "頑張れ、ペペ。私ならいける！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "くそぉ……はぁー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "全力を尽くしたにもかかわらず、ペペのつま先はすぐそこに落ちている通行証に届かない。\nそして姿勢のねじ曲がった彼女はもはやバランスを維持することができず、足がふらつくままにあっさりと地面へ倒れ込んだのだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "当然ながら彼女の真似をするミイラもまた、アナトを手放し、同じ姿勢で地面に倒れ込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ペペは地面に伏したままどうすることもできず、アナトの頭が鈍い音を響かせて床にぶつかるのを見守るしかなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アナト",
      "text": "（無意識に悲鳴を上げる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "……すまない、アナト。君の次の研究は必ず全力でサポートする。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "あの、手伝いましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ああっ、ありがとう。いいところに来てくれて本当に助かったよ。館長が具合を悪くしたものでね、彼女をオフィスに連れて行くのを手伝ってもらえるかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "あの、館長はソファに寝かせておきました。ところであなたたちもなんだかものすごいことになってるけど、立ち上がる予定は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "お構いなく。これは特別なストレッチ方法なのでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "えーっと、では展示物の方は？　中に運び入れるのを手伝う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "問題ないよ。一人で何とかできるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "わかりました……必要なら、いつでも呼んで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "ふぅ……これでやっと動ける……危うくバレるところだった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "名もなきミイラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ぺぺ",
      "text": "何を突っ立って見ているんだ。一緒に入るよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "ナラントゥヤ、良いニュースだ……ターゲットの位置を確認した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "そうだ。たった今第四号展示ホール付近で彼女に遭遇し、気絶した館長をオフィスに運ぶのを手伝った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "ああ、間違いない。彼女はオフィスの中にいる。中にいるのは気を失った館長を除いて彼女一人だけだ。それから彼女の通行証も手に入れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "わかった。問題ない、ここで待っている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "ジヤア？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "うっ、メジェティクティさん、えーと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "館内がこんな騒ぎになってるってのに、どうしてまだこんな所でうろついてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "もうすぐ閉館にするから、早くこの迷子のお客さんたちを連れ出してあげてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "一体何が起きたんです？　どこへ行けばいいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "私たちは無事に出られるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "皆さん、ご安心を。私共のスタッフがご案内いたします。彼女が皆さんを安全な場所へお連れしますので、慌てず後について進んでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "で、でも……私にはまだほかにやることが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "わかったわ、だったら私が──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "危ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "な、何が危ないんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "博物館に雲獣を入れたのは誰？　館内にはペットの持ち込みは禁止なのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "えっと、雲獣なんて見てませんけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メジェティクティ",
      "text": "あなたの職務怠慢については後で話し合うわ。先に雲獣を捕まえなくちゃ。こんな人だかりじゃ踏みつぶされてしまうわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "……どうやら私がお客さんたちを連れていくしかないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "（小声）まあいい。多分間に合うだろうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "皆さん、私の後についてきてください。ここを右に曲がれば非常口があります。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "待って、こっちは左じゃないの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "でも彼女はここの職員なわけだし、間違えるはずがないわよね……ねぇちょっと、そんなに速く歩かないで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "重々しい展示ホールの扉が押し開けられ、そして閉じた。\n本来その扉は開けたままにしておくべきだと気づく者も、勝手に開けられたことを気にかける者も、「北東部族支系」と書かれた扉のプレートをメンテナンスしに来る者もいない。\n展示ホールは荘厳かつ静寂であった。\nアスパシアの心臓が激しく高鳴る。暴れる鼓動は彼女の慎重な足音をかき消すほどだった。\n彼女の視線は、滅亡した部族の浅黒い境界石、そして五色の糸で編まれたイェラグの絨毯の前を通り過ぎ、展示ホールの暗い深部へと向けられた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……ようやくだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "我々の歴史はここで静かに私を待っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "歴史を仰ぎ見る場は、やはりこのように厳かで静かな雰囲気であるべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あぁ。目の前に広がる絵巻のような壁面彫刻は、いずれの廃神殿の壁であろうか？　これほどまでに純白の完璧な石材は、果たしてミノスにあるどの山で産出したものだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "そして様々な文化財によって家庭の一場面を表現し、古代ミノスの生活様式を具現化している。なんと素晴らしい想像力だろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "ただ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "すべて間違っている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "なぜなら私は知っているからだ。かつて神殿の中央に置かれていた金杯よ。何年も前、私の祖父がここに来てあなたを見た、母もまた同様にだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私の一族はあなたを失ったことにより、数多の苦難に遭った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……この博物館はなぜこれを発酵乳保存用の陶碗の間に置いているのだ？　材質的にもスタイル的にも、それらとセットになるものではないことくらいわかるだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "それにこれと対になるもう一つの金杯はどこへ行った？　当時すべてを掠め取っていったサルゴン人は、なぜ奪い取ったものを適切に保管することすらできないのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "そして展示物の紹介にいたっては──",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は展示物の解説板をじっと見つめると、その金属プレートを壁から取り外し、裏面を調べた。\nどちらの面も滑らかで、ただ彼女自身の姿を映し出すのみだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "失礼、これはただ何も書かれていないだけだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "だがこれらの遺産がここに置かれていることこそ、最大の過ちだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "百年以上も昔、ミノス人はあらゆる屈辱を受けた。サルゴンの軍隊がミノスの領土に足を踏み入れ、我々の文明と歴史を踏みにじる様を目の当たりにした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "決してこれらの本来あるべき姿ではない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "私が持ち帰らねば。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "皆さん、この階段を下りれば、無事に博物館から出られます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歩き回る職員",
      "text": "そのー、私はまだ用事があるから、先に失礼します。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "やっぱり何かおかしいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疑問に思う観光客",
      "text": "来た時はこんな道じゃなかったような……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "でも彼女はここの職員だし……間違えるわけないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "本当にここから出られて、家に帰れるのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あなたたちを家に連れて帰るべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "そしてミノスの祭司に引き渡そう。あなたたちは彼らによって研究がなされ、保存されるべきだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アスパシアは、重々しい足取りで展示台の前に歩み寄ると、金杯を捧げ持った。"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "これらミノスの数々の遺産は、この日の当たらない展示ホールの中に横たわるべきではない。誰にも注目されず、放置されることなどあってはならない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "ちょっと、押さないで！　どこを歩いてるかすら見えないんだから。この非常口はどうして誘導灯の一つもないのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "ねぇ、あっちに展示物を並べている職員がいるわ。さっきの人より頼りになりそうよ！　急いで訊きに行きましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "あなた方は、もしやミノスの展示物を見学に──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の観光客",
      "text": "すみません、展示館から出る道はこっちで合っていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスパシア",
      "text": "何か力になれることはあるだろうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
