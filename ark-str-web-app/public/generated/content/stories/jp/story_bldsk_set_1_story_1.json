  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 华法琳"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "p.m. 10:32 天気/小雨\nチェルノボーグ事件後の廃墟"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "おーい……おーい！　誰かいないかー！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "空が暗くなってきた……学校からケーキ屋さん、ロレーナママの仕立て屋って順番にたどってきたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "もう少し先へ進めば、この街区を抜けるはずだよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "クソッ！　道がどんどんぐちゃぐちゃになってる。全部あのマスクをした頭のおかしい奴らのせいだ。一瞬で何もかもが変わっちまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ユーリ――ユーリ！　どこにいるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "さっきまで一緒だったのに……俺は水を探しにちょっと離れただけなのに、どこ行ったんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ユーリは一番小さいし、怪我もひどい。一人じゃどこにも行けるはずがない……そうだ、あいつの傷からはまだ血が出ていた。その匂いをたどれば……ううっ、どこもかしこも血の匂いがする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "おえっ！　生臭い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ダメだ、吐いちゃダメだ……せっかくオレグ兄ちゃんが、頑張って見つけてきてくれた食料なんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ユーリ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "い、今のは唸り声？　どこだ、壁の向こう側か？　……小動物？　いや、ありえない。俺たち以外の生き物はみんなとっくに街の外へ逃げたはずだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "またなんか聴こえた！　風の音じゃなさそうだし、まさか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ユーリ？　ユーリなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……聴こえなくなった。遠すぎるからか？　この壁の向こうは……デパートの旧倉庫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "この倉庫はずっと空っぽだったはずだ……前にオレグ兄ちゃんが、内緒で忍び込もうって誘ってきたっけな。大人たちは、近づいちゃダメだって言ってたけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ユーリ一人じゃこんなとこに来るはずないよな？　でも万一ってことも…………クソッ！　隙間からじゃ暗くて何も見えない。やっぱり入らなきゃダメか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "中はもっと暗いな……うわっ、顔に何かついた！　なんだコレ？　外から吹き込んだ雨？　違う、ベタベタする……おえっ、生臭い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "そうだ……思い出した……学校で女子たちがこの倉庫には変なものがいるって噂してたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……いや、あんなの嘘だ、嘘に決まってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "でも……ここ数日でおかしなものをたくさん見てきたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ダメだダメだ。今はそんなこと考えてる場合じゃないぞアントン。怖がるな。お前はユーリを探さないといけないんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "うぅ……うっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "泣き声だ！　今度はハッキリ聴こえた！　向こうで誰か泣いてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ユーリ、泣いてるのはお前か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "アントン……アントンなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "そう、俺だよ！　迎えに来たぞ。怖がらなくていい、すぐにそっちまで行くからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "アントン……助けて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "頑張れ、もうすぐだから……でも一体何があったんだ？　どうして一人でこんな遠くまで来てるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "お前足……足を怪我してたんじゃなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "うう……ば、化け物がいた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "化け物？　何をバカなこと言ってるんだ。お前、熱でもあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "化け物が……僕を捕まえて来たんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "お前が見た化け物って、どんな姿だった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "は……はっきりとは見えなかったけど……く、黒い爪があった気がする……それと目が血みたいに赤かったんだ！　僕のことをじーっと見て、それで怖くなって……後のことは何も覚えてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "黒い爪に、赤い目？　どこかで聞いたことあるような気が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "そうだ、あれだ！　学校でリナが言ってたお化けの話。あれじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "うん……リナが……リナが言ってたよ。夜眠らない子供がいると、枕元に化け物がやってくるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "その化け物は赤い目でじーっと見つめてきて……もしそいつと目を合わせてしまったら、魂を吸い取られちゃうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "それで、操り人形みたいになってベッドから降りて、化け物の後ろについて家を出て、街を歩いて、そいつの巣までついて行って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "そこで、そいつに吊るされるんだ……家で干してるソーセージみたいに、軒先にぶら下げられるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "化け物はお腹が空いたら……気まぐれに吊り下げた子供の体から血をじゅるじゅる吸って、飲み干しちゃうんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "ううっ……アントン、もしかしたら僕も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……自分で自分を怖がらせてどうする。そんなの大人の作り話だ。俺たちを早く寝かせるためについた嘘だよ……そうに決まってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "ほ、本当に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "だって考えてもみろ、お前は今、吊るされてるってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "僕……何かに足をつかまれたまま……高い所にいるよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……えっ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "てことは……リナが言ったのは全部本当なのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "ううっ……アントン……僕、血を飲み干されるなんてやだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "大丈夫だ！　もうすぐそっちに着く。すぐだからな、その化け……そいつが何だろうと、戻って来る前に、俺がお前を背負って帰るから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "うん……いや、ダメだ……アントン、来ちゃダメ、早く逃げて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "お前の姿が見えたぞ、ユーリ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "なんだこれは！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "あああ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "捕まえたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "来るな……やめろ！　ユ……ユーリを傷つけたら許さないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "傷つけるだと？　おい小童、妾が何をすると思っているのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "血を吸おうとしてるんだろ、この吸血モンスター！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ふむ、そう呼ばれるのは久方ぶりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "いかにもいかにも、妾はブラッドブルードであるぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ほう、見た目は弱々しいが、反応はそこまで鈍くないようだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "だが、背中に隠し持っておるレンガを投げつけても妾は倒せぬぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "妾はブラッドブルードだと言ったであろう！　ブラッドブルードはとてつもなく素速く、力の強さもサルカズの中で一、二を争う。それにほれ……この歯が見えるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "妾の歯は瘤獣の首を楽に引き裂けるのだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "抵抗を諦めたか。賢明な判断だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "なあ、ユーリは見逃してやってくれ。こいつは怪我してる。血もたくさん流したし、俺の方が血が多く残ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "吊るすなら俺にしろ、腹が減ったら俺の血を飲めばいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "ダメだよ、アントン……そんなのダメだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "仕方ない、この場所が見つかった以上――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "は、早い！　一瞬で手が動けなく――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "うっ……痛っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "こんなの絶対逃げられないじゃないか……これが……噛まれる感覚なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これで良し。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……これで良し？　お、俺はまだ立ってるよな……めまいも感じないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "これしきの吸血では、そなたの体に何の影響もないだろう。副作用もないはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "お前は俺を捕まえて……ソーセージにするのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ソーセージ？　ウルサスの特産品か？　ほう、気になるな。今回の任務が終わって、また来る機会があれば味わってみよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "コンパス殿？　コンパス殿はまだおるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ゴホンッ……ワルファリン先生、俺はここだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾が死ぬほど忙しいというのに、そなたはずっと隠れてこの茶番を見ておるだけとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ハハッ、俺は今来たばかりだよ。それに、ワルファリン先生だって楽しそうだったじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "先……生……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "この吸血モンスターが先生？　医者ってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "見ろ、コンパス殿。この小童、口を開けば妾を吸血モンスターと呼ぶんだぞ？　それを少しばかり脅かしただけで済ませるとは、妾の何と慈悲深いことよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "え……脅かした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "俺が説明してやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "実はな、俺が任務中に君の友達を発見したんだよ。その時の彼は一人で、しかも重傷を負っているようだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "そんな情況だったから、保護するために連れて帰ってきたんだが、最初から意識がもうろうとしていたし、途中で完全に気を失ってしまって、俺たちが誰かを説明する暇はなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ワルファリン先生は経験豊富で優秀な医者だ。だから安心して君の友達を任せて問題ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "あ、それとさっき先生が君の血を抜いたのは、単に検査をするためだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……検査？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "よし、結果が出た。ウルサスのスラングでどう言うんだったか？　ふむ……この子は、野生の駄獣のように頑丈だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "良かったな、小童。そなたはまだ感染してはいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "感染って……鉱石病のこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そうだ。今のチェルノボーグで、命がある上に感染もしていないなんて、これ以上幸運なことはないぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたの友人のように状況は決して芳しくない場合がほとんどだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ユーリはどうなってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ギリギリ持ち堪えたと言うところか……まぁ、妾がいたからな。もしフォリニックらがこのエリアを受け持っていたならば、恐らく妾ほど見事な対応はできなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ゴホンッ……フォリニック先生が聞いたら、絶対怒り出すぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "フン、だからなんだ。学ぶべきことがまだまだ多いのは事実だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "フォリニックの能力では、妾のように血の匂いの変化で、源石結晶が体内のどの辺りに蓄積しているかを迅速に判断することはできまい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "このように感染の兆候が表れたばかりの患者に対しては、進行を抑えるためできるだけ素早く患部へ処置を施すほか、すでに体内に侵入した源石が患部で結晶化するのを防ぐ必要もある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "市場に出回ってる抑制剤では、症状を緩和することしかできない。この妾が対応しても、悪化のリスクを相対的な低値に抑えてるにすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "ユーリの怪我した足をこんなふうに吊るしてるのも、命を助けるためなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "それか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "まあ……そうだな。この方法はずっと試してみたかったのだ。症状の進行からして、効率は数パーセント上がったようではある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ただの誤差という可能性もあるが……ふむ、やはりもう何人かで実験が必要だな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ゴホンッ！　ワルファリン先生、そんなことを言うと、またこの子たちが怖がってしまうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怖がりな子供",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……ってことは、あんたら二人は俺たちを助けてくれたんだよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "礼を言うにはまだ早いぞ。そなたの友人――ユーリといったか？　彼には経過観察が必要だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "もし完全に感染者になってしまえば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "まぁ、今はそこまでは言うまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "アントンくんは、ユーリくんと一緒にここで休んでな。明るくなったら、俺が責任を持って君たちを拠点へ送り届けてやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "拠点？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ああ、俺たちの拠点だ。俺たちはもうすぐチェルノボーグから撤退するから、その時は君たち二人を、近くのウルサス都市まで護送してやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……ユーリくんの感染がこれ以上進まなければの話だがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "オレグ兄ちゃんたちもいるんだ。俺たちは五人だ、行くならみんな一緒がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "そうか……わかった。それなら、俺はひとまずその子たちを探してくるとしよう。ワルファリン先生も後でみんなの検査をしてくれるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "みんな一緒にいられれば、その分生きる希望も大きくなるからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……先生？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "うん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "もう一つ訊いてもいいか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "先生は……本当に吸血モンスターなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ゴホッ！　ゴホゴホッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "（歯をむき出す）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "怖気づいたか？　……ほう、我慢したか。本当に勇敢な子だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "俺もワルファリン先生と知り合って長いが、実を言うとな、彼女は確かにどこかおかしい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "おい！　そなた――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ゴホンッ！　まぁ、ずば抜けた医療技術を持つ先生だが、時々……不意に手術台に縛りつけられると、どうしても背筋が冷たくなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ふむ、背筋が冷たくなるのは本能だ。気にすることではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "砂虫がハガネガニに遭遇した時のように、小動物が獰猛な大型野獣に遭遇した時のように、そなたらがブラッドブルードに遭遇したなら、体が本能的に恐れるのは当然だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "その感覚は忘れない方がいい。外には妾やクロージャのような、お人好しのブラッドブルードなど滅多におらんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ハ……ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "さて……この小童の問いに戻ろう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ま、半々といったところだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "半々？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "今となって、妾の血液に対する関心は、もはや啜りたいという欲求としては表れなくなっておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "じゃあ……化け物じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "化け物って呼ばれて……怒らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ふむ……そなたらにとっては、妾は確かに化け物であろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "妾は、そなたらに同類として見てほしいなどと思ったことはない。そして妾が他の種族を同類と見なすこともない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "だが、他人と違うことで化け物と見なされるのであれば……誰もが化け物と呼ばれる可能性を持つだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "例えば、もしそなたの友人であるユーリが、本当に感染者になってしまえば、多くの者が彼をそう呼ぶであろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "俺はそんなことしない。俺はユーリを化け物なんて呼ばない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたはそうかもしれん。だが他の者はどうだ。他者の考えを変えるのは難しいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "もし誰かがユーリを化け物呼ばわりしやがったら、俺がそいつをぶん殴る！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ほら、今そなたは怒りを覚えたな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたがそやつらを殴れば、そやつらも殴り返す。そうやって殴り殴られることは、たとえ命は無駄にせずとも、時間の無駄になるのではないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "時間の……無駄？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "ああ、時間の無駄だな。そなたが怒りに身を任せて争っているまさに間に、友人は病で息絶えてしまうかもしれぬぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そのうち気付くだろうな。怒りよりも、もっと大切なことに――あるいはもっと意味のあることにエネルギーを注ぐ方が良いと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そなたたちの場合は……そうだな、この先どうやって生きるかを考える、とかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "勇敢な子供",
      "text": "生きる……そうだ、俺たちは生きていきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "それで良い。より良く生きていきたいのならば、自分は異種であるという事実をまず受け入れ、それから他者とうまくやっていく方法を見つけなければならぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "それとな、小童……そなたがもう少し大きくなったら、もっと色んな場所へ行き、色んなものを見るが良い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワルファリン",
      "text": "そうすれば、化け物と見なされることは……怒るほどのことではないと思うようになるかもしれぬぞ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
