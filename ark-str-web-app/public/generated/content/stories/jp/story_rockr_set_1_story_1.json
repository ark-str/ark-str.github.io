{
  "server": "jp",
  "storyId": "story_rockr_set_1_story_1",
  "groupId": "story_rockr_set_1",
  "stageId": null,
  "title": "600ポンド",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_rockr_1_1.txt",
  "sourceHash": "1e49f565f3afc852762e1e17778f47cb90fc2bc8c31062a1d5458d4eb58536ba",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "それを持って、さっさと出て行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "中身を確認したらすぐ行くさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "全部で600ポンドだ。何をグズグズしている？　連合源石工業のような大企業が、たかが君一人の支払いをごまかすとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "だから、確認したら行くって言ってるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "好きにしろといい。それくらいの時間はやるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "鉄道が廃線になってもうすぐ二年……君は補償金の清算条項にサインした最後の一人だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "……58、59、60。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "ようやく終わったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "サインもして、金の確認も済んだのなら、君はもう我が社とは無関係だ。はやく出て行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "今度なんだ？　こっちはもうすぐ退勤の時間なんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "ちょっと考え事をしていただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "金についてか？　これ以上は1ペニーだって出さんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "当時、会社が約束してくれたことについてだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "映画館、公共浴場、託児所、作業場のソルトソーダ……実現されたものもあれば、されなかったものもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "だが昔の俺は、すでにもうある物くらいは、今後もきっと無くならないだろうと思っていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "考え事なら家でしてくれ！　ほら、さっさと帰りな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "会社はあんたに何を約束したんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "会社役員",
      "text": "……頼む、はやく出て行ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "長い間、整備されていない街灯は、半分が光を放っておらず、もう半分は力なく点滅し、商業エリア方面の夜の雪景色をオレンジ色に眩しく彩る。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "止まれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "労働者はその言葉を無視し、さらに一歩前に進もうとするものの、すでに腰にナイフが突きつけられていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "金を出せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "金なんぞない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "お前がさっき大金を受け取ったことは知ってんだ。さっさと出せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "グズグズすんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "あんたは機関区のどの部署の奴だ？　点検修理部か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "なぜそれを――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "……いや、上司みたいあれこれ偉そうに聞いてんじゃねぇよ！　手荒なことをされなくなけりゃ、さっさと金を出しやがれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "少し話そう。どうしても困っているのなら、貸してやってもいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "貸すだ？　そんなことはもう、とっくに試してんだよ！　でもよ、一体誰が病人に金を貸してくれるってんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "それに仮にお前に借りたとて、俺に返せると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "返せるようになるまで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "無駄話はそこまでだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "今から三つ数える。金か命、どっちを選ぶかよく考えな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "三……二……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "…………一！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "さあ、数え終わったぞ！　あんまり俺を追い詰めるなよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "この肺はとっくにダメになってんだ！　こんな命、惜しくともなんともねえ！　本当に刺すからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "ほら！　さっさと金を出せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "はやく！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "労働者は一切反応を示さなかった。強盗はナイフを前に向かって突き出す。刃は労働者の服を切り裂いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "何かを貫通したような感覚が手に伝わり、強盗はまるで感電したかのように、ナイフを数センチ引っ込めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗",
      "text": "お前――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "言葉を紡ぐより前に、肩越しから分厚い封筒を手渡された。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "強盗はハッと我に返ると、震える手で封筒を奪い取る。労働者が振り返るともうすでに、半乱狂状態の強盗は金と共に闇夜に消え去っていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "600ポンド。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "労働者は少し立ち尽くした後、ゆっくりと道路の端まで行き、ズボンのポケットをまさぐる。ようやくタバコを一本取り出すと、残った最後のマッチで火をつけた。\nそして大きくひと吸いすると、まるで酔ったかのようにその場にうずくまる。\n赤い光が暗闇の中で、ポツリポツリと消えては現れた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "ロシェル、帰ったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "ロシェル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "ロシェル・ロックウェル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "出かけてるのか？　外はもう暗いし、雪も降っているのに……探しに行かねば――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "……お父さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "こんな遅くまでどこに行ってたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "ご近所さんから聞いたよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "強盗に……遭ったんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "本当なの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "父親は微かに頷く。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "さっき言われた場所に行ってみたけど、もう誰もいなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "犯人は誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "他のエリアからわざわざ強盗しに来るはずがない。絶対に軽工業区の人だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "しかもお父さんが今日、補償金をもらうことも知ってた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "なんとしてでも捕まえさせ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "ロシェル、いいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "少しだけ話をした。彼も切羽詰まっていたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "お父さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "それなら、ちゃんと相談してくれればお金を貸してあげたのに！　でも無理やり奪ったんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "もし向こうが血迷ったりしたら、お父さんはもう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "彼にそんなことはできん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "本当にそのつもりなら、黙って背後からハンマーで脳天をかち割ってたはずだ。数ヶ月前の事件のようにな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロシェルは思わず身震いした。"
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "彼のあの体調では、このご時勢で金を貸してくれる奴なんざいないだろう。極端な方法に出るのも仕方あるまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "みんな同じ仕事仲間なんだ。今日の彼だって一時の気の迷いに過ぎない。景気さえよくなれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "本当にそんな日が来るの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "きっと来るさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "覚えてるか？　何年か前のお前の誕生日に、機関区のみんなが余ったパーツを使って、ドローンを作ってくれたろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "もちろん覚えてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "機関区だけじゃない……軽工業区の人は全員家族なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "だから彼もきっと、金を返しに来てくれるはずさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "何だ？　父さんが信じられないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "そ、そういうわけじゃないよ。ただ……今日の午後、クラークおばさんが食べ物を分けてもらいに来たの。おばさんち、もう食べ物がないんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "お父さんも知ってるでしょう？　おばさん、子供が五人もいるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "……ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "夜になれば、お父さんが補償金を持って帰ってきてくれると思ってたから、パンを丸ごと一本……全部あげちゃったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人は無言のまま向かい合った。\n何年も前に建てた家のおかげで、とりあえず寒さをしのぐことはできる。ただ窓の隙間から吹き込んでくるヒューヒューという風の音だけが、雪が勢いを増してきたことを二人に告げた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "クラークおばさんの家に行ってくる。もしかしたら食べ残したパンが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "この吹雪だ。外に出るのはやめなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "明日また町に行って、ボイラーマンを探してる工場がないか見てくるよ。どこもなければ最悪、力仕事をすればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロシェル",
      "text": "でもお父さんの腰は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "気にするな。工場働きの奴なら全員、どこかしら体にガタがきてるもんだ。俺はまだマシな方だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "くたびれた労働者",
      "text": "とにかく、俺のことは心配するな。今日はもう寝なさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "数年後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "ロックロック！　ここにもケガ人がいるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "今行く――ロバートソンおじさん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "ロバートソンさん、立てますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "ロックロック、担架を持ってくるから、ケガ人を少し見ててくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロバートソンおじさん、他にケガしてる人を見たりしてない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "おじさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "無理して喋ろうとしなくても大丈夫。もうすぐ担架が来るから、あと少しの辛抱だよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "ロックロック、この通りでサルカズたちが暴行事件を起こした原因が分かったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "一体何が起きたわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "奴らは軽工業区に「労働禁止令」を出したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "労働禁止令！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "奴らが占領している工場以外で、働くことを禁止したのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "それって無理やり自分たちの工場で働かせて、従わない人たちは路頭に迷わせるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "今回の被害者たちが暴行を受けたのも、ルカズ以外の者から日雇いの仕事を受けていたことがバレたからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "じゃあ、身寄りのない老人や病人はどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "奴らがそんなことを気にすると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あの魔族たちめ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "フー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "君は軽傷の人たちの手当てをお願い。薬は節約しながら使えば、足りるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あたしはロバートソンおじさんの手当てをするね。おじさんの容態は……あまり良くないから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "おじさん、はい、午後のお薬。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "起き上がれそう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロバートソンおじさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロバートソンおじさん、お薬の時間だってば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あれ？　午前の薬もまだ飲んでなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "なぜ……俺の世話をする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロンディニウムで働いている人なら、誰だってお世話するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "お父さんも言ってたんだ、軽工業区のみんなは家族だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "それにおじさんは鉄道機関区の――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロバートソンはベッドのシーツを強く握りしめたが、ロックロックがそれに気付くことはなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……くれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "担当を……変えてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "か、変えるって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "他の人に看護してほしいってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（うなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "分かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "今すぐ他の人を呼んでくる。でもお薬だけは絶対に飲んでね、約束だよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（目をつむる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "おじさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（小さくうなずく）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "ロックロック、ケガ人たちの容態はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "もうほとんど回復してるから、今日中にはもう家に帰れそうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "みんなが帰ったら、あたしたちも他の場所に移らなきゃね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "……そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "そういえば、ロバートソンさん、さっきからずっとベッドを叩いてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "水や食事、薬を持って行っても首を横に振るだけだし、トイレに行きたいわけでもなさそうなんだよ。病気のせいで喋れないから、何かを訴えるかのように、ずっとベッドを叩いてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍メンバー",
      "text": "もしかしたら、君を呼んでるんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "今すぐ行ってくる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロックロックが足早にテントに駆け付けると、ロバートソンはまだ力なくベッドを叩き続けていた。\n目を開けた彼が、ロックロックの姿を捉えるとようやく、その単調なノック音が止んだのだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロバートソンおじさん、あたしを呼んでたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "もう大丈夫。あたし、ここにいるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（軽くベッドを叩く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ベッドに……座ってほしいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "木の板を数枚繋ぎ合わせただけのベッドは、大柄な大人一人分の横幅すらない。\nロバートソンの体に腰掛けたらまずいと、ロックロックはベッドの端を手で確認するが、固い床板の感触しかなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "おじさん、あたしはここにいるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "おじさん、最近はちゃんと薬、飲んでるんだってね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "それってすごくいいことだよ。薬を飲めば、傷も治るんだから……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ロバートソンの喉からくぐもった声が発せられた。言葉にならない声ではあったものの、それが意味することは明白であった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "そうだよね。こんなこと言っても仕方ないよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "だったら、昔話でもしようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "お父さんがまだ生きてた頃、いつもあたしに言ってたの、鉄道は軽工業区の血管だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "鉄道を通して原料が絶え間なく工業区に運び込まれ、作業場や工場に流れ着き、製品に変わる。そして、また鉄道を通して工業区からロンディニウムやヴィクトリア全体に運び出される……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "運ばれる荷物は血管に流れる血液で、鉄道職人は鉄道を構成する……えっと、何て言ったっけな――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "そうだ、細胞だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "細胞が心をひとつにし、力を合わせることでようやく、血液は滞りなく流れ続け、細胞は血液が入れ替わることで養分を得られる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "それを聞いたあたしは、お父さんにこう言ったんだ。じゃあ、列車が通る時に聞こえるガタンゴトンって音は、傾工業区の脈拍だねって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "ゼェ……ゼェ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "お父さんは少し考えた後に、うまいことを言うなって褒めてくれたんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あれ以来、列車が通る度に、この会話を思い出すの。すると、列車の音もうるさいどころか、まるで自分の鼓動みたいに、心安らぐ音に感じられるようになったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ガタン……ゴトン……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロックロックが列車の音を小声で真似るのを、ロバートソンはじっと聞いていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "それから、軽工業区の工場が一つ、また一つと廃業になって、ついには鉄道も廃線に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "スー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "――ゲホゲホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロバートソンおじさん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ごめんね、つい話に夢中になっちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "悲しい話はもうやめよっか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "そうだ！　これ、見て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あたしのドローンだよ。ロック十一号っていうの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロック一号から始まって、これでもう十一代目なんだ。だから十一号なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "隊長が寄せ集めのパーツで組み立てた物だから、お店で売っているドローンとは比べ物にもならなけど、この中にはあたしのアイディアが詰まってるんだ。実際に役にも立ってるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "自救軍を設立した後だって、このドローンたちがなかったら、あたしたちとっくにサルカズに捕まってたかもしれないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "でもそれはロバートソンおじさんや、お父さんが機関区にいた頃の同僚のおかげだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "ハァ……ハァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "覚えてる？　あたしが小さかった頃、機関区のみんなが誕生日プレゼントに余ったパーツでドローンを作ってくれたこと。コアエンジンを作ってくれたのがロバートソンおじさんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あのドローン、大好きだったんだ。あまり高く飛べなかったけど、それでも暇さえあれば、家で飛ばしてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "プロペラが回転するのを見るたびに、大人になったら、絶対にこれよりも大きくてすごいドローンを作ってやるって思ってたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "そうすれば、お父さんは一日中ボイラーに張り付いている必要もなくなるし、おじさんだって点検のために何度も上り下りしなくて済むよねって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "それでみんなで仲良く暮らして、仕事が終わったら出かけて、ビールでも飲んで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "ゴホッ……ゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロバートソンおじさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロバートソンの咳がロックロックの会話を遮った。\nロックロックは彼の目頭が濡れていることに気付いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "この話もやめよっか！　あたし――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロバートソンはまた言葉を発しようと試みるが、少し声を出しただけで、激しい咳に中断されてしまう。\n胸の痙攣が少し治まるのを待ってから、ロバートソンはベッドを叩いていた方の手をやっとの思いで持ち上げ、懐を探り始める。\nそしてようやく、懐から小さなビニール袋を取り出した。その中身はお金でいっぱいだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "お金……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "あたしに……くれるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（うなずく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "これはおじさんが長い間、苦労して貯めたお金でしょう？　受け取れないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（ベッドを叩く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "だめ、このお金は絶対に受け取れない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "じゃあ、こうしよう！　このお金はあたしが一旦預かるから、おじさんの家族が見つかったら返すので――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（思いっきり首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "でも！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロバートソンは懇願するかのように、朦朧とした瞳をロックロックに向けた。だがロックロックの断固とした態度は彼をひるませる。\nそしてついに、ロバートソンは諦めた。\n彼はため息をつこうとするも、それすら叶わなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少し呼吸を整えると、彼は再び懐に手を入れた。そして、今度取り出されたのは、シミだらけの汚れた封筒だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "封筒の中は……手紙？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "安心して。手紙は必ず届けるよ。でもこのお金は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバートソン",
      "text": "（力強くベッドを叩く）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "……そういうことじゃないの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロックロックは封筒を裏返すと、そこにはとっくの昔に汗でにじみ掠れた文字が書かれていた。\nロックウェル、補償金600ポンド。\nロックロックは目を見開く。\nそして、彼女の目の前で、ロバートソンは全力でビニール袋を引きちぎり、色とりどりのお金を床にぶちまけた。\n10ポンド、5ポンド、1ポンド。中には鈍く光る硬貨も混じっている。\nそれは、会社が渡してくれた補償金本来の姿ではない。1ペニー1ペニー貯めていなければ、こうはならないはずだ。\nそれはロバートソンがサルカズから暴行を受けていた、本当の理由であった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "ロバートソン……おじさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "返事はなかった。\n彼は職人らしく、体に残った最後の力をすべて使い果たした後、静かに息を引き取った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少しずつ老いていく軽工業区が、何回目の朝を迎えた頃だろうか？\nサルカズの労働禁止令は驚くほどの効果を発揮した。その証拠に、労働者たちは日が完全に昇る前から、もう工場へ向かっている。\n少し前までは、サルカズは数名の監視役を付けていた。\nだがしばらくすると、彼らが歩く屍のように、工場までの道のりで一言も喋らず、監視の目がなくとも定められた規則を破らないことに、サルカズたちは気付いた。\nだから、街に潜伏するレジスタンスの対処に人員を割くために、彼らに監視を付けるのをやめたのだ。\n貧困と飢餓こそが、最も優れた監視役なのである。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な労働者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "寡黙な労働者",
      "text": "ありゃなんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老けている労働者",
      "text": "……ドローンか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ガラクタによって組み立てられたドローンが、彼らの方に向かって飛んできていた。\n一人目の労働者の頭上を通り過ぎたところで、ドローンの貨物室が開かれ、数枚の紙幣がひらひらと舞い落ちた。"
    },
    {
      "type": "dialogue",
      "speakerName": "老けている労働者",
      "text": "これは……金？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドローンはふらふらと労働者たちの頭上を飛び回り、降り注がれる紙幣や硬貨は、湿った奇妙な雪のように、各労働者の頭に、体に、足元に降り注がれる。\nこの雪の価値は、人生の半分を労働に捧げた者がもらえる補償金と同じ額――\n600ポンドだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ頭目",
      "text": "隈なく探せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ頭目",
      "text": "あのクズどもがアジトの在り処を吐いたのは今朝だ。いくら逃げ足が速くても、そう遠くまで行けるはずがない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ兵士",
      "text": "報告します！　すでに人影はなく、荷物も残っていませんでした。見つかったのはこれだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ頭目",
      "text": "……工業部品を入れる箱？　しかもテーブルに置きっぱなしだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ頭目",
      "text": "お前、矢で射貫いてみろ。何か仕掛けられてないか確かめるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ兵士",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ兵士",
      "text": "音から察するに、中身は空のようです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ頭目",
      "text": "開けてみろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サルカズの兵士は恐る恐る箱の蓋を開けた。\n中には弾薬や毒物はおろか、挑発目的のナイフすら入っていない。\nただクシャクシャに丸められた薄汚れた封筒があるだけだった。\n頭目は封筒を手に取り中身を確認するも、中は空っぽで、裏面の一部は何者かによって、カッターできれいにカットされていた。\n頭目は疑わしげに、弱々しく光るランプに封筒を透かし、角度を変え入念に調べる。\n封筒は汚れやシミ以外に、涙の跡が数滴残っていただけであった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "――数年後"
    },
    {
      "type": "dialogue",
      "speakerName": "嬉しそうな労働者",
      "text": "えっ？　他人に金をあげるのはこれが初めてじゃないって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "そうだよ。もう何回余ったお金を人にあげたのか、正直自分でも覚えてないや。どうせ持ってても使い道がないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嬉しそうな労働者",
      "text": "そ、そういうことなら、遠慮なくもらっておくぜ？　ありがとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "どういたしまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "嬉しそうな労働者",
      "text": "それにしても変わった癖だな。なんかきっかけはあったのか？　最初に誰かに金をあげた時は、どんな状況だったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "最初の時？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロックロック",
      "text": "確かあれは自救軍が成立されてすぐの頃、お父さんの昔の同僚を助けたの――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ロックロックは鉛色の空を見上げながら、どこから話すべきかと思案する。\nその時、道端にある新しい建物がふと視界に入ってきた。周りの廃れた風景とは不釣り合いなその建物の屋上は、こんな派手なネオン文字が並んでいた。\n「連合源石工業　ロンディニウム工業振興本部」"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
