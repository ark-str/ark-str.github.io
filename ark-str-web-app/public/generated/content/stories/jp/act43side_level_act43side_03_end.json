{
  "server": "jp",
  "storyId": "act43side_level_act43side_03_end",
  "groupId": "act43side",
  "stageId": "act43side_03",
  "title": "ドラマチックに",
  "storyCode": "AD-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act43side/level_act43side_03_end.txt",
  "sourceHash": "ea52229b2999761b4974c4d12689898ed9d4dfc46c07d17e8558b92c1f5aaaab",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "グレータさん、天災に見舞われるって情報はほんとなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "ランクウッドの都市間ネットワークがカバーする範囲はめちゃくちゃ広い。たとえ区画が中心部から切り離されても、天災警報は届くはずだ！　どうして俺たちの端末は知らせを受信していない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不運なスタッフ",
      "text": "つまり、最近通信が時々悪くなるのは、私の運が悪いせいじゃなくて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "誰かが意図的に通信設備を壊したんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "いい加減にしなさい！　根拠もなしに疑っても意味はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "根拠がない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "オフィスで偶然紙切れを見つけてな、繋げてみたらトリマウンツ大学が出した天災予測レポートと絵コンテだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "しかもグレータ・ストーン女史、ここにはあんたの直筆のサインがある。一体どういうつもりだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "小僧、俺にも見せてみろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "俺はカメラマンだぞ。新しく加えられたこれらのシーン、なぜ俺が知らない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "それに、どうして区画の端にカメラを配置する必要がある？　あそこには何のセットもないぞ……待て、わかったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "グレータ！　*ランクウッド現場用語*お前さんわざとだな？　俺たちにこんな大事なことを隠して、一体何がしたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "不運なスタッフ",
      "text": "アブナーさん、落ち着きましょう……グレータさんは最新のスケジュールを伝える暇がなかっただけかもしれません。シェリーさんが亡くなったばかりで、色んな連絡が間に合ってないわけですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "この狂った女の肩を持つ気か？　こいつは移動区画を嵐に限りなく近付けて本物の天災を撮影しようとしてるんだぞ！　俺たち全員の命の危険を顧みずにな！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "激怒したカメラマンは、撮影機材を激しく床に叩きつけた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "もうたくさんだ！　俺は今すぐこんな*ランクウッド現場用語*場所から出て行く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "相変わらず短気ね、アブナー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "短気？　おかしいのはお前さんの方だろうが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "五年前のあの映画の失敗を補うために、どれだけの資産をつぎ込んだ？　その後の投資も上手くいかず、今回の映画にランクウッドでのキャリアを賭けてるんだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "教えてくれよ、グレータ。もしこの映画も赤字を叩き出したとしたら、ダルトンとシェリーの事故も利用するのか？　あの時に小娘の転落死を利用したみたいにな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "アブナー、落ち着きなさい。そう性急に結論を求めようとしないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私の事情についてはよく覚えてるみたいだけど、自分のことはどうなのかしら？　ここ三年で、あなたが制作チームに加わるのはこれで何度目？　初めてよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "だらしなくて、すぐカッとなって、プロ意識の欠片もない。うちみたいに手放しで撮影機材をあなたに任せるチームが他にある？　あなたのことを兼業カメラマンとして雇ってくれる現場はあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "出て行きたいなら、お好きにどうぞ？　昔馴染みのよしみで違約金も払わないでいいわ。でもどこへ行けるっていうの、アブナー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "余計なお世話だ。俺は最悪――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "職場を変える？　業界を変える？　二度とレンズや撮影機材を粗末にすることはないって？　脅し文句で凄もうが、誓いを立てようが構わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "だけど、もしあなたに本当にまっとうな正義感があるなら、どうして私の誘いに応じて、ここへ来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "それでも出て行くの？　出て行ける？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アブナーは機材を拾い上げることも、出て行くこともなかった。彼は己の人生と過去によって雁字搦めにされ、黙ったまま立ち尽くす。"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ようやく落ち着いたようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "前向きに考えましょう。この映画が完成したら、いくつかは最優秀撮影賞を取れるかもしれないわよ。オファーが殺到するようになったら、今後うちのチームへの加入を断ってもらって構わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "寝言は寝てから言え、グレータ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アブナー",
      "text": "俺はもう五年前からそんなこと信じちゃいないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "ほらみんな、最近起きた二つの事故のせいで、私たちが共に経験したかつての出来事を思い出した人もいるでしょうし、まことしやかな噂を耳にした人もいるのはわかっているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "こんな状態だものね。今後の撮影で、チームのみんなが心置きなく一丸となれるように、ここでみんなに噂について答えるとしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "今チームにいる多くの人は、私が五年前の撮影でも組んだパートナーたちよ。そして当時の撮影現場では、装置の劣化によって、痛ましい事故が起きたわ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "若手女優のローラが、不幸なことに現場で命を落とした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "あの事件に関する警察の調査結果の内容は、調べれば誰でも知ることができるわ。全てが公開されており、隠された事情なんて決してない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "だから、天災を撮影するという今回の決定と、当時の事故に繋がりがあるとすれば、それは私が五年前の件で大変貴重な教訓を得たから今回の決定を下したということだけ。そう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "私たちに足りないのは技術ではなく、度胸よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "もちろん、これは私がみんなの安全を度外視しているという意味ではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "この移動区画がランクウッド中心部を離れる前、私はトリマウンツ大学の天災予測の専門家を訪ねたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "その人から非常に正確な分析レポートを入手して、データを区画ナビゲーションシステムに入力して何度もシミュレーションしたの。だから、撮影区画は天災から十分な距離を保つし安全よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "それと、緊急脱出ポッドにある陸上艇には使用権限を設定するつもりはないから、命の危険を感じたスタッフは誰でも自由に使ってもらって結構よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "付け足しておくと、この区画を最後に離れる者は私になるでしょう。私はこの区画に残るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "以上。問題がないようなら、解散していいわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "あなた、待ちなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "グ、グレータさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "暴露したことで謝る気はねぇぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "緊張しなくていいわ。誰からその文書を入手したのか知りたいだけだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "全部自分で――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "嘘をつくくだりは省略していいわよ。あなたにそんな能力はないし、私にも時間はないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "……情報提供者のプライバシーを守る義務が俺にはある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "現場での撮影を妨害することは契約書の第二条、そして第五条違反よ。金融端末から処罰の結果を見たいのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "ただし、特別な理由がある場合は漏らしてもいいこととする、ってね――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "撮影アシスタント",
      "text": "（小声）ルシアンさんだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "騒がしい群衆と散らかった機材の向こう、グレータの目は、すぐに喧騒からぽつんと離れたその人物を捉えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルシアン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "フェリーンの男はグレータの冷たい視線を平然と受け止めると、軽く頷いて挨拶をした。"
    },
    {
      "type": "dialogue",
      "speakerName": "グレータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "モリー、昨日の夜マイケルさんが会いに行った相手はあんただって言いたいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "でもシェリーさんが出て行った後も、映画を観続けてたじゃん？　たしか炎国のキョンシー映画……あっ――あんた確かにあの時ちょっと外に出てた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "端末にマイケルさんからメッセージがきてたんだよ。とても重要なことを聞きたいから、スタジオに来いって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "ごめんねティッピ。映画ナイトを一緒に楽しむ約束してたのに、途中で抜け出すべきじゃなかったよね。怒らないで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "怒ってるよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "ティッピ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "あたしが怒ってるのはね……どうして一緒に来てって言ってくれなかったのかってこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "だって、危ないじゃない！　マイケルさんの頭がありえんピンクで、あんたに何かしようとしてたとか、昼間の撮影中断でうっぷんが溜まってて、大人しいあんたをイジメようとしてたとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "おい、俺は女の子には優しいぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "その言葉があんたの口から出たところで、ちっとも信用ならないよ。マリオンさんにだってヒドイ態度とる時あるでしょ。ほかの女の子には言うまでもないじゃんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "text": "ふっ、世間知らずの小娘にまで見透かされるなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "本当はティッピに一緒に来てもらいたかったの。でもマイケルさんが一人で来るようにって念を押すから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "私もいくつかの制作チームにいたことあるし、そういう「やり口」には慣れてるよ。どうせまた何かの嫌がらせだと思って、あなたまで一緒に辛い思いをしてほしくなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "モリー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "ランクウッド歴でいうと、あたしの方がちょびっと長いし、色んな仕事にも慣れてるからさ、今後またこういう奴に出会ったら、絶対教えてよね。絶妙な仕返しの仕方を考えたげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "……探偵さん、そういう話は後でしてもらってもいいか？　モイラちゃんが証言してくれたんだから、俺の嫌疑は晴れただろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "うん、マイケルさんとシェリーさんは本当に偶然会っただけかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "昨日の夜、シェリーさんが出て行く前の様子は私たちも見たし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "うわの空で、放心状態だったんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "はい。本当に追い詰められて限界だったのかもしれません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "それはそうだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "モイラちゃん、ありがとう。俺のために証言してくれて、本当にうれしいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "君の勇敢さにはどれだけ感謝しても足りない。ティッピちゃんの君を守ろうとする思いは、実の姉よりも強いかもしれないからな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "そうだ、君のお姉さんはまだランクウッドで女優をやってるのか？お姉さんも君のように可愛いなら……連絡先を教えてくれないかな？　もしかしたら制作チームを紹介できるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "text": "殺人犯扱いされたってのに、まだ浮気性は治らないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "ごめんよハニー、ちょっと聞いてみただけだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "text": "そういうのいいから。話をそらさないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリオン",
      "text": "まだ教えてくれてないじゃないの、モイラと会おうとしてた目的は何なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ティッピ",
      "text": "あたしも知りたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "マイケルさん、ティッピとマリオンさんに話すべきだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マイケル",
      "text": "モイラちゃん、やめ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モイラ",
      "text": "マイケルさんはこう聞いてきたんです。こっそりこの区画から離れる方法はないかって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
