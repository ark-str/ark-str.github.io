{
  "server": "jp",
  "storyId": "story_harold_set_1_story_1",
  "groupId": "story_harold_set_1",
  "stageId": null,
  "title": "老兵の義足",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_harold_1_1.txt",
  "sourceHash": "1f0d9a7452f028c1e53772f655a4adede7412609d82b24b7a61237b17956913c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "リスバーンのやつ、放牧を手伝えとか言って呼び戻しておいて、自分は女の子と楽しくデートしやがって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "なあ、まさかあいつ、本気でイェラグで所帯を持つつもりじゃないよな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "一番応援してたのはお前だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "今さら仲間の結婚が心配になってきたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "あいつが騙されてないか心配してるだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "相手は純粋なイェラグ人だぞ？　こっちが騙すならまだしも、リスバーンが騙されるわけないだろ。お前が嫉妬してるだけだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "いいや、俺たちは国を守る責務を負った兵士なんだし、女性に感情を弄ばれるのも騙されるようなもんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "次の任務報告も、そのくらいバカでかい声でやってみろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "お前こそ、次の任務報告もそのくらいの毒舌でやってみろって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "ったく、いいから仕事に戻れっての。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "なあ、また戦場に戻るより、ここで一生こんなふうに放牧でもして暮らしたほうが良いとは思わないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "そんなうまい話、あるわけないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "そうとも言い切れないぞ。実はこの間、公爵様からボスへの手紙が届いてな。何が書かれてたかまではわからないが、ここ数日ボスはしょっちゅう何かぶつぶつ独り言を言ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "独り言？　なんて言ってたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "「ロドス」がどうとかってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "そうかい。俺は大事な駄獣についての独り言しか聞いてないがな。ほら――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "さあ、いい子だから少しの間じっとしていなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おとなしい駄獣",
      "text": "（弱々しい鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "そう、その調子だ。よーしよし、痛くしないからな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おとなしい駄獣",
      "text": "（痛そうな鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "大丈夫だ、落ち着けランラン。怖がることは何も――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "あまりの痛みに耐えかねて、駄獣はハロルドのほうへ数歩踏み出した。その駄獣をなだめていたハロルドは慌てて避けたものの、一歩遅かった。\nグシャッ――"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おおっと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "足元を見下ろしたハロルドの目に飛び込んできたのは、義足の残骸だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "暗い表情の兵士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "ぷっ……あっははは！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ジャック。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "はははっ……すみません、ボス。病院への使いでしたら、笑いが収まってからでもいいですか？　ははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "確かに使いを頼む気はあったが、行き先は病院ではないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "どうしてです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "来たばかりの頃に調べておいたんだ。イェラグには、私の義足を直せる病院はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "だったら、どこへ使いに行けばいいんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "修理できるとすれば、ロドスくらいのものだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "ロドスか……でも、あの人たちが俺らの相手をしてくれますかね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "簡単には相手にしてもらえないからこそ、行くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "これは、お前たちが出征を逃れるラストチャンスであり、私があの貴族どもの相手をせずに済むようになるラストチャンスでもあるんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "本当ですか！？　ならすぐ行きます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "エンジニア部の人に義足を見せてきましたよ、ハロルドさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "あの義足は、駄獣に踏まれる前から内部構造が壊れかけていたそうです。でないと、いくら駄獣が重くても、踏まれた程度では壊れませんからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "なんと言っても、駄獣の百倍は強大な存在を相手取りましたので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それで、専門家諸氏のご見解はいかがでしたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "良い知らせと悪い知らせがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "では、まず良い知らせからお聞かせ願いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "良い知らせは、ロドスが先日導入した新しい設備を用いれば、あの義足を直すことは可能だということです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ふむ。ならば悪い知らせは、修理用の材料が足りないと言ったところですかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "いえ。材料はロドスとカランド貿易の取引契約に含まれているものですので、その点は問題ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "となると……人手の問題ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "その通りです。イェラグに駐在中のオペレーターには、あの義足に用いられているような先進技術を扱える人材がいないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それはなんとも残念です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "やれやれ。どうやら数年の時を経て、この杖が本来の役割を果たす時がまたやってきたようですな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "待ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "実は、本艦のエンジニア部所属のオペレーターが一人、イェラグへ旅行に来ているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ただ、彼女はあくまで休暇のために訪れているものですから、事務所にも顔を出していませんし、具体的なスケジュールについては私たちも把握していなくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ですが、彼女と連絡さえ取れたら、修理を頼めるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "でしたら、私が探して参りましょう。何か手掛かりはおありですかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "そうですね……クーリエさんがこの間、彼女の同行者に荷物を届けたそうですから、彼ならあるいは何かを知っている可能性はあるかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "クーリエというと、ヴァイス殿ですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "これはまた、難題ですな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "もし難しいようでしたら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いやいや、私が参りますとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ですが、その足では……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ご心配には及びません。私は義足と同じくらい、この杖をつくのにも慣れておりますので。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "シルバーアッシュさん。仰る通りお伝えしましたら、やはりご自分で向かわれました。これでいいんですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "ああ。ドクターともすでに話はつけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "彼がこの機にロドスへ接近するつもりなのであれば、我々はその流れに沿ってことを進めるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "ハロルド氏がそれを知らぬはずもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "あとのことは、彼次第だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "駅員",
      "text": "今日もいらしたんですね、ヴァイスさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "はい。もう少ししたら旦那様についてしばらくロドスへ行く予定なので、それまではこちらのことをなるべく手伝おうと思いまして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駅員",
      "text": "それは有難いです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駅員",
      "text": "そういえば、あちらの方が少し前からあなたをお待ちですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "どなたでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "お久しぶりです、ヴァイス殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "ご無沙汰しております、子爵様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "とうにイェラグを発たれたとばかり思っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ははは、ご冗談を。私の一挙手一投足のすべてを把握しておられるでしょうに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "旦那様はすでに監視を解いておられますし、それをあなたがご存知ないとは思えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "おかげで、僕も随分肩の荷が下りましたよ。少なくとも、誰かの不意打ちを心配する必要はなくなりましたからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ヴァイス殿は率直な物言いをなさいますな。そのような方とお話しするのは、嫌いではありませんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "それで、僕にどんな御用ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "実は、私の義足を修理していただきたいと思い、ロドスのとある凄腕エンジニアをお探ししているところなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ヴァイス殿ならば、居場所をご存知だと伺ったのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "どなたをお探しかは大方見当がつきますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "もちろん、貴方の口から簡単に情報を得られるとは初めから思っておりませんとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "そこで、駅員のレディにもご相談したのですが、義足が直ったら手紙の配達をお手伝いするということで手を打ってはいただけませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "申し訳ないのですが、ロドスのオペレーターについての情報を軽々にヴィクトリアの軍人へ漏らすことはできません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いやはや、案の定一筋縄ではいかないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "となると、ジャックたちに使いを頼むしかなさそうだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "そうはいかんな。今彼らに顔を出させては、いらぬ誤解を招いてしまうだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド&しょげた通行人",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おや、レディ。どうなさいましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "いえ……その、ただ仕事のストレスがひどいだけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "正直なところもう限界なんですが、この仕事を失うわけにもいきませんし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "人生とはままならぬものですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "今日は貴重な休日なのに、これといった趣味もないので、バカみたいにここでぼんやり座ってるしかできないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "楽しいことなんて何もない、こんな生活なんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "レディ、ダンスはお好きですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "うーん、普通ですかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "でしたら、足の自由が利かぬ人間のダンスにご興味はありませんかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "えっ？　でも、その足じゃ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "足が一本欠けてしまえば踊れないなどと、誰が言ったのでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "それだけ言うと、ハロルドは杖をついて女性の前までやってきて、紳士然とした礼をした。"
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "女性が驚きの声を上げるや、ハロルドは杖を振って踊り始める。\n初めに彼は杖を軸にして、円を描くように軽やかなステップを踏んだ。\n時折響く、杖と靴が地面を打つリズミカルな音が、近くの店から流れる音楽と完全に混ざり合っている。\nクライマックスに差し掛かると、彼は杖を頭上に放り投げ、空中でくるくる回転する杖を見事に受け止めてみせた。その曲芸のような踊りに、女性は夢中で歓声を上げ……\nついには触発されたように立ち上がって、彼と一緒に踊り始めた。\n気付けば、周りの通行人もハロルドの踊りに惹きつけられ、ある者は見入り、ある者は思い切ってダンスの輪に加わっていった。\nそうしてひととき、広場は賑やかな空気に包まれた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "このように、迷うくらいなら飛び込んでみるといいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "確かに、その通りですね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "音楽が鳴りやんだ時、ハロルドは鮮やかなアクロバットで締めくくろうと杖を空高く放り投げた。\nしかし――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（おっと――）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "腕がなまっていたのか、あるいは熱気に飲まれたせいか、最後の最後で手元が狂う。\n杖は空中で美しい弧を描きながらも、彼がすぐには受け止められないような位置に向かって落ちていく。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "いかん。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "悲惨な失敗によってショーが締めくくられかけたその時、一筋の影が稲妻のように横切って、空中の杖に軽くぶつかった。\nすると、杖はすぐさま軌道を変えて、ハロルドの手中にしっかり収まった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼はそのまま周囲の人々に一礼し、パフォーマンスを締めくくる。\nその瞬間、群衆から割れんばかりの拍手が湧きおこった。"
    },
    {
      "type": "dialogue",
      "speakerName": "しょげた通行人",
      "text": "私も、あなたみたいになれるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "どうして私のようになる必要がありますか。貴女には立派な両足と美しい容姿、そして十分な時間がおありでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "きっと貴女は、私などよりずっと素敵なお人になられますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気になった通行人",
      "text": "……私、頑張ってみますね。ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "貴女のような若者を勇気づけられたのなら、光栄に思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ときに……デーゲンブレヒャー殿、いつからご覧になっていたのですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "近くで食事をしていて、たまたま見かけただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "悪くないダンスだったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "悲しいかな、社交界に出るためには、いろいろと努力せざるを得ませんでしたもので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "私の足をからかってくる貴族もおりましたから、妻にダンスをみっちり仕込んでもらったのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おかげで今や、このハロルドのダンスの腕、いえ、「脚」はちょっとした評判になっているくらいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "その「脚」はどこへやったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はっはっ、あれは殉職いたしました。原因については、貴殿であればご存知のはずと思いますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そう……今の今まで持ち堪えるなんて、なかなかの出来ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "直せないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ロドスのとあるエンジニアであれば可能と伺っておりますが、ヴァイス殿に案内を断られたとあっては、ここでため息をつくほかないものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ため息をついているのは、エンジニアが見つからないから？　それともロドスとお近づきになれないから、かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……もし貴殿が社交界にお出でになれば、さぞかし恐ろしい存在になるでしょうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "興味ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "でも、あなたが暇を持て余しているのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "コロド。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屈強な青年",
      "text": "はい、ボス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あなたのお父さんのところ、午後の種まきの人手が足りなかったはずね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "マッターホルンに伝えておいて。こちらのベテランヴィクトリア兵が手伝ってくれるって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "なんですと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（しかし、マッターホルン殿ときたか……これなら突破口になりそうだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（どうあれ、彼にはいずれ対面せねばならないわけだしな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屈強な青年",
      "text": "しかし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "行くの？　行かないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "もちろん参りますとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それにしても、先ほどの言葉を繰り返さずにはいられませんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "やはり、貴殿が社交界にお出でになれば、さぞかし恐ろしい存在になるでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "デーゲンブレヒャーさんは旦那様に呼ばれて手が離せないので、代わりにこの方を寄越したと、そう言ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "屈強な青年",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "お久しぶりです、マッターホルン殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "他の質問はあえて控えましょう。畑仕事の心得は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "無論ありますとも。領地にいた頃は、暇さえあれば農作業を手伝っておりましたもので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "このハロルドにとって、畑はわが親友も同然です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "それはよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ああ、ですが少々お待ちいただけますか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "はい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "畑で作業となりますと、杖をつくのは不便すぎるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "簡単な義足を作りますので、いくつか材料をご用意いただくことはできますかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "何が必要なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "木の棒を何本かと、ナイフに綿、ロープがあればそれだけで構いません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "それだけの材料で義足を作れると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マッターホルンは不思議に思ったが、ハロルドはさも当然といった顔で作業を始めた。\n彼はまず細い円柱型の木材を選び、自身の欠けた足の長さと比べると、両端を削ってならし、義足の「脚」とした。\n次に、円形の平たい木片を選び、中央に穴を開け、「脚」をそこにはめ込んだ。至極簡単な「義足」の原形が、こうして完成した。"
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "前にもこうした義足を作ったご経験が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ありますとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "軍でも義足は支給されますが、戦況は刻一刻と変化するものですから、義足に不具合があるからといって直す暇などございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "そんな時、こうした簡単で実用的な義足があれば、ひとまず行軍の足手まといになるのは避けられるというわけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "加えて、義足は安価なものではありません。特に、義足への要求が高くなる軍人にとっては。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ハロルドはそう話しながら、木を削って椀状にすると綿をその中に詰めた。\nそして、足をその椀の部分に入れると、縄で椀と義足を縛り、固く結ぶ。\nその後立ち上がって二歩歩き、くるりと回ると、マッターホルンに礼をして、義足の完成を告げた。\nそれはやや滑稽にも見える光景ではあったものの、マッターホルンは思わずハロルドに拍手を送った。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "実は、故郷の家にもこうした自作の義足を置いていましてね。農作業の時は、いつもこういうものを使っていたのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "なんといっても、普段使いの義足は、大枚はたいて買った物でしたのでね。とはいえあれは、ここ数年大きな不具合もなく、値段に見合った働きをしてくれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "部下にはよく、冗談で言っていたものです。「戦場で私に何か起きたら先に義足のほうから救え」とね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "何しろあれは、私の恩給と同じくらい高価なものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "……ははっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "あなたの故郷にも、たくさんの畑があるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ございますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "イェラグとは違い、向こうは一面、金色の畑なのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "とはいえ、共通項もあるものです。貴殿もそうは思いませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "こんなものでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "そうですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "太陽はすでに西へ傾いている。あぜ道から、自分たちの午後の成果を眺めていたハロルドとマッターホルン、そして農民たちの口からは、思わず大きなため息がこぼれた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "農作業後の達成感は、毎度ながら格別ですな。貴殿もそうは思いませんか？　マッターホルン殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "それはもちろん……ですが、あなたのようなヴィクトリア貴族が、俺と同じように感慨にふけるとは思いもしませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ははっ、だからといってヴィクトリアの貴族全般に期待を抱かれませんよう。失望させてしまいますからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "では、なぜあなたはヴィクトリア貴族でいるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "良い質問ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それは、なぜエンシオディス様はイェラグ人なのかと、カスター家の人々が嘆くのと同じだと思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "我々はそうした問いに答えることはできず、結局は運命のいたずらだと結論付けるしかないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "マッターホルン殿。次にエンシオディス様が我々の郡を通りかかられる際には、ぜひともお声掛けください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "妻に頼んで、ヴィクトリアの家庭料理を振る舞いますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "そうして召し上がっていただいたあとは、エンシオディス様と共にしばらくご滞在いただけたらと存じます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "その折には、故郷の歌を聞かせて進ぜましょう――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ハロルドはそう言うと、故郷の歌を軽く口ずさんだ。\nすると、近くにいた何人かの農民も、ハロルドが口ずさんだ歌を聞いて、思わずイェラグの民謡を歌い始めた。\nそしていつの間にか、農地でヴィクトリアの歌とイェラグ民謡の歌唱大会が始まった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "今日は何やら賑やかですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見物する村人",
      "text": "おおヴァイス、今日も手紙の配達かい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "それにしてもこの歌、聞き覚えがあるんですが、どこか違うような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見物する村人",
      "text": "ヴィクトリアから来たじいさんが一緒に歌ってるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見物する村人",
      "text": "これがなかなか上手でな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "ヴィクトリアから来たじいさん……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼が歌声のするほうを見やると、村人が高らかに歌うのに合わせてハロルドが拍子を取っていた。\nそれを見たヴァイスの表情はめまぐるしく変わり、最後は無表情に落ち着いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "俺からヴァイスに口を利いてみましょう。聞き入れるかまではお約束できませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "あいつはそういう性格ですから、どうかご理解ください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "若かりし頃の私に比べれば、随分付き合いやすいほうですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "どうやら、口添えはもういらないようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おや？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ヴァイス殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "こうなることはお分かりだったんでしょう。ならばなぜ、あんなふうに白々しく頼んできたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "兵士には、恥ずべきことなどないと言い切る資格もなければ、被害者に許しを求める資格もありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ゆえに、私に言えるのは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "私はイェラグが、この土地が、確かに好きだということだけなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "叶うことなら、イェラグには栄えてほしいと願っています。将来的には、家族を連れてもう一度ここへ来たいとも思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "僕は、例のエンジニアさんに荷物を届けに行く途中で、偶然ここを通りかかっただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴァイス",
      "text": "付いてくる分にはご勝手にどうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ヴァイスはそう言うと、背中を向けて歩き出した。\nしかし雪山に向かうその歩みは、数回の跳躍で一瞬にして遠くまで行ってしまうようなものではなく、ただ普通の人が歩くよりもほんの少しだけ速いペースになっているだけだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "ヴァイスも悩んでいるんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "悩まぬ人などおりませんよ、マッターホルン殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "このハロルドも悩みます。ですが、それはこの足の断ち切れた部分が時折かすかに痛むのと同じで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "誰かに打ち明けることも滅多になく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "誰が気にすることもないものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それでは、また。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "ん……？　お待ちください、ハロルドさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "どうなさいましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "たった今、旦那様からメッセージが届きました。数日後に晩餐会を開くので、ぜひあなたをご招待したいとのことです。その会には、俺とヴァイス、それにデーゲンブレヒャーさんも出席します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "どうやら、デーゲンブレヒャー殿のみならず、エンシオディス様にも借りができたようですな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（もとより、この機にロドスとの繋がりを築いておくつもりだったが、どうやら明日にも加入申請を提出して良さそうだな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（――例のエンジニアの行方は貴殿が掌握しているのでしょう、エンシオディス様。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "（いや、そうとも言えませんか。これは我々が同じことを考えているだけのこと。私がロドスへ向かうのは、貴殿にも私にも、イェラグにもカスターにも、誰にとっても良いことなのですからな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マッターホルン",
      "text": "ハロルドさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "エンシオディス様にお伝えください。私は必ず美酒を手に参上いたしますので、とことん飲み明かしましょうと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
