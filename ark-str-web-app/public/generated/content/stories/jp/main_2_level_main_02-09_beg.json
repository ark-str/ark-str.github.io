  "sourceHash": "53a8c6e20235af570c1a1f315e01b44edf5e3d84c0b860e20d4853489f6699f4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十一关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "ッ――"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "どうしてこんなに数が多いんだか……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "ぐあっ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "……んー……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "なーんか、いくら倒してもキリがないっていうか……どんどん増えてる気がするんだけど、気のせいかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": "char_1002_nsabr",
      "text": "う、っぐ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "気のせいじゃないよ。明らかにレユニオン側の増援が来てる。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "っ……こちらは、反撃すらできていないのに……！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "ロドスに隙を与える気はない、ということでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "――フランカ、気をつけて。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": "char_107_liskam",
      "text": "東側出口に、術師が隠れてる。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "了解。……正面の道は、両側のビルに向こうさんのチンピラどもがわんさかいるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "こっちに気付かないフリをして、誘い込もうとしてるみたいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "だけど、お生憎様。ここは屋上なのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "この高さなら、どんなに大勢押し寄せてきても片っ端から落っことしちゃえばおしまいじゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "まったく……こんな場所であたしたちと戦おうとするなんて、随分馬鹿にしてくれたものね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……もしかすると、総攻撃を仕掛けてくるつもりかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "総員、隊列を立て直してください！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "！　待って。あれは――さっきのレユニオン幹部じゃない！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "やっぱり、あいつが部隊の指揮を執ってるみたいね……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……ロドス……"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "お前ら、あいつを龍門に引き渡したのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "（小声）フランカさん、まずは牽制をお願いします。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "（小声）向こうが怯んだ隙に、下層階へ移動しましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "（小声）もっと広い場所でないと、うまく立ち回れませんから……"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": "char_106_franka",
      "text": "（小声）了解。ぶちかましてから走れってことね！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "――彼女の所在など、あなたには関係ないはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……貴様……！"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "……その物言い、後悔させてやる。"
    },
    {
      "type": "dialogue",
      "speakerName": "スカルシュレッダー",
      "speakerId": "char_1500_skulsr",
      "text": "――かかれ、同胞たち！"
    },
    {
      "type": "sceneBreak"
    }
  ],
