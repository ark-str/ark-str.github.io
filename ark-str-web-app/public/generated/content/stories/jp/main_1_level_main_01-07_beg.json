{
  "server": "jp",
  "storyId": "main_1_level_main_01-07_beg",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "暴君",
  "storyCode": "1-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_01-07_beg.txt",
  "sourceHash": "b4f8327901c1a672a1a4beb5a76b12d21c5965e65287ecc680259ca97e5a6e89",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "衝撃に備えろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "総員、散開せよ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "クソッ、規模が大きすぎる！　何もかも破壊し尽くさんばかりの勢いだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "このままではまずいぞ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "急いで退避するんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "は、はい……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "ッ来るぞ、踏ん張れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ひっ……！　あ、ぁ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "空が……空が、落ちてくる……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ぐっ……！　い……痛い……身体が、痛い……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "手が……俺の手がない！　う、あああっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "は、はは……どうして……どうしてこんなことに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "い、嫌だ、死にたくない、死にたく……あああああああっ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "っ、重装オペレーター！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "術師の保護に回れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――！？　なっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "一体何の音だ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "隕石だ、かなりデカい――クソッ、通り沿いに落ちた！　伏せろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "きゃっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　建物が、倒れて――！　危ない！　そこを離れてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "こっちだ、早く！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "――あっ……！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "いたっ……ド、ドクター……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "つ、突き飛ばして逃がしてくれたのか！？　……だけど、それじゃドクターが――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "――ッ、危ない！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "Dr.{@nickname}！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "……えっ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "待っ……ニアールさん、無茶です！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "――伏せろ、ドクター！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "……っ、はあ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "間に合ったようだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "……！　生きてる！　よかった、二人とも生きてるぞ！！　さすがニアールさん……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "……ふぅ、はぁっ……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ニアールさん！　ドクター！　早くこちらへ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "私は大丈夫だ！　先に行け、ドクター！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "この盾は、まだ持ちこたえられる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "だから跳ぶんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "ためらうな、早く！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "だ、大丈夫ですか？　お怪我はありませんか？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "大丈夫。このくらい、大したことじゃない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "ああ。ニアールに感謝しないとな。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "……あなたという人は……もうあんな真似はしないでくれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "仮に無茶をするにしても、まず私に声をかけてもらえねば、守れるものも守れなくなってしまうだろう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "もとより、どのような状況でも、あなたが傷付くことなど容認できないが――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "私の目の前でとなれば、なおのこと見過ごせない。……どうか、そのことを理解しておいてほしい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……とにかく今は、みなさんが無事でよかったです……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ただ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "（あとどれだけ持ちこたえられるのか……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "（本当に、生き延びることができるのか……どうにも、不安は尽きないけれど……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……はぁ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……？　なんだか、降ってくる隕石が減ったような……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "天災の第一波は越えた、ということでしょうか……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "……まだ、気を抜くわけにはいかん。この天災がどれだけ続くかは未知数だからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "とはいえ……天災の中心からは抜け出せたと見ていいだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "ひとまず、乗り切ったようだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "みなさん、動けそうですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "はい！　オペレーター全員、大きな問題はありません！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "一部怪我人もいますが、いずれも軽傷です！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "前衛オペレーター",
          "text": "……俺たち……生き延びたんですね……！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "ア……う、ぁあ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "レユニオンにも、無事な人が――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "……お前……ら……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "ぁ……ああああっ！！　ロドス……ロドスの奴らだ……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "……ッ、なんだ……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "アァ……ぁ……う、アアアアアア！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "まさか、まだ戦うつもりなんでしょうか……！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "……ロドス……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "……殺せ……ロドスを殺せ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "チッ、こいつら……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "逃すな……殺せ……始末しろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "イカれた連中め……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ニアール",
          "text": "なぜこのようなことを……命が惜しくないのか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドーベルマンさん、これは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "ああ。……ほかに道はないようだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "素早く対処し、先を急ぐぞ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
