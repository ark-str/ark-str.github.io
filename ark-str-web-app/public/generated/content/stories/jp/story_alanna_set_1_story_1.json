{
  "server": "jp",
  "storyId": "story_alanna_set_1_story_1",
  "groupId": "story_alanna_set_1",
  "stageId": null,
  "title": "再会",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_alanna_1_1.txt",
  "sourceHash": "badb56cf3efa4b9d02870afff805f31e3e8bed682bf76e7e16e8b25902841adf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "爪楊枝をくわえた労働者",
      "text": "今スコアどんくらいだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "汗だくの労働者",
      "text": "お前、もう俺に十点差もつけてるじゃねぇか。その、一回パスしてみるのとか……どうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爪楊枝をくわえた労働者",
      "text": "ふざけんな！　もういっちょお見舞いしてやる――ノールックバックストライク！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……ティース――おい、ビッグティース！　もう喉がカラカラだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ビールをジョッキ大で頼む！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "おっと、それとキャロットサイダーもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爪楊枝をくわえた労働者",
      "text": "ア、アランナ！？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "おいおい、ビッグティース。爪楊枝を落としてるぞ？\n――って、口に戻すなよ！　汚ぇな！"
    },
    {
      "type": "dialogue",
      "speakerName": "汗だくの労働者",
      "text": "ほ、本物のアランナだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "どうしたんだ、あんたたち？　どいつもこいつも幽霊を見たような顔しやがって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "本当に久しぶりだな。前回お前がこのドアを蹴り破ったのは、もう一年以上も前じゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そんなに経ったか？　それよりもカウンターにあるビールを取ってくれ。喉が渇いて死にそうなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ぷはあーー",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "つまり、今回戻ってきたのは罰金の通知書のためなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ああ、ロドスで残業してたら、突然メールで届いてさ。差出人はレム・ビリトンビッグピラー自治州住宅管理委員会になってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "住宅管理委員会？　いつの間にそんなもんが……ああいや、続けてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "通知書には、あたし名義の住宅が一軒「違反建築物」になってるから、期日内に罰金を払わなきゃ取り壊されるって書いてあったんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "労働者たち",
      "text": "なんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "な？　ビックリだろ？　実家はとっくに無くなってるもんかと思ってたのに、まだ残ってたなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "汗だくの労働者",
      "text": "いや、そうじゃなくて。確かにそれにも驚いているが、俺たちが一番びっくりしてるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爪楊枝をくわえた労働者",
      "text": "トレーラーで寝泊まりしてメシ食って、車じゃなくて地面酔いしたり、トイレ以外で車から降りなくても平気だって賭けをするようなヤツが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "……家を持ってるだと？　いつ買ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "あれはうちの親の――まあ、あたしが継いだから一応はあたしの家か。絶対にバラバラになってると思ったのに！　仮に無事だったとしても、天災が通り過ぎた場所に人なんて住めるわけないしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "なのに今さら罰金の通知を受け取ったってことか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "だからこうして急いで帰ってきたってわけ。もしかしたら、当時撤退を仕切ってたヤツらの勘違いかもしんないし、ひょっとしたら天災なんて来てなかった可能性もあるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爪楊枝をくわえた労働者",
      "text": "そんなに大事な用があるってのに、なんで先にこっちに顔を出したんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "おっ、たまにはいい質問するじゃねぇか、ビッグティース。考えても見ろ、もう何年も経ってるわけだし、家の場所が見つかるかどうかはさておき、まず足がないと探しようもないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "ああ、そういうことか。ほしいのは車だけじゃなくて、できれば運転手も一人ついてきてほしいってとこか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そりゃあな、あたしは居眠り運転はしない主義なんでね――チャーリー、興味あるって顔してるね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "「自由気まま」、「嵐のようにやってきては去っていく」が口癖の荒野のアランナが、誰も知らない古巣を持ってたんだぞ！？　興味あるに決まってる！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "そんじゃ決まりだな！　さっそく出発しようぜ\n――鍋蓋ちゃん！"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ビッグティースから、道中で飲む用にキャロットサイダーをもう何本かもらっときな。金は払わなくていい、こいつはあたしに借りがあんだ――あ、キンキンに冷えたヤツにしてくれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "爪楊枝をくわえた労働者",
      "text": "はは、たくさん持っていけ。気にするな、おチビちゃん。これからも元気でいるんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "あ、ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "その地図にも載ってないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "地図が新しすぎるのかもな……ったく！　たったの十年ちょっとしか経ってねぇのに、あんな大きな町が地図から消えるなんてあり得るか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "ずっと大通りでグルグル走ったってキリがねぇ。天災が通り過ぎた以外に何か特徴はないのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そうだなあ……町のそばには採掘場があって、町に住んでた奴らはほとんどそこで働いてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "……それ、99%のレム・ビリトンの町が当てはまるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんのパパとママも採掘のお仕事をしてたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "いや、二人は採掘場で働いてただけさ。お袋が会計で、親父は溶接工だった。どうかしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "いえ、ただランナお姉ちゃんから一回もパパとママの話を聞いたことがないなあって思って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "あっ！　あの分かれ道……なんとなく覚えてるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ここで右に曲がってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ああ、この道に違いねぇ！　このまま真っすぐだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "道路脇の標識を見る限り、つい最近整備されたばっかみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ってことは今も人が住んでるかも！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナは車の窓から身を乗り出し、砂ぼこりが舞う中、懸命に目を見開く。\n遠く彼方の地平線から、歪な屋根の列がだんだんと姿を現した。煙突から上がる煙が空中に広がっているせいで、背の低い建物はぼんやりとしか見えない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "あのごちゃごちゃした屋根、それと窯を焚いてメシを作ってるにおい……間違いねぇ、あたしの記憶にある町のまんまだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "マジで天災トランスポーターが予測をミスったのかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ああ、そうだな！　もしかしたら天災が他のところに逸れていったのかも！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "鍋蓋ちゃん、見てくれ！　あたしの\n――鍋蓋ちゃん、何してんだ？\nじゅうしち、\nじゅうはち、\nじゅうく……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん、道端にある源石結晶の柱を数えていたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "柱だけじゃありません。源石群も地面のヒビも、他の場所よりたくさんあるような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "昔は採掘場だったんだろ？　それなら多少は多くてもおかしくはないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "チャーリー、あそこの家のそばに車を止めようぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "ああ。ちょうど冷却水も補充しなきゃいけないしな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "この先にあたしが住んでた町があるはずだよ、鍋蓋ちゃん。そんでこの家には、二色のデコレーションケーキを作ってくれるおばさんが住んでんだ……なんて名前だったっけな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そのおばさんちの前には、きれいな庭もあってさ、植えてある花はどれも遠い市場から買い集めた高級品だったんだぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "でも、ここはどう見てもお花が植えてあるお庭には見えませんよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "確かにそうだなあ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の住民",
      "text": "ちょっと、あんたたち！　あたしの苗を踏んづけてるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "えっと……スーザンおばさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の住民",
      "text": "誰が「おばさん」だって！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の住民",
      "text": "ああ、もうこれ以上中に入るな！　あんたたちのせいで、ビーツの苗が三株もダメになってしまったじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "っと、すまねぇ！　知り合いと勘違いしちまったみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の住民",
      "text": "まったく、こんな最悪な場所でようやく見つけた汚染されてない土地なのに……ちょっと、よそ者！　あんたたちのことだよ！　弁償してもらうまではどこにも行かせないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "よそ者……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "一体どうなってやがる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の修理屋",
      "text": "よし、パイプを繋げ終わったぞ。満タンにするには……このタンクのデカさじゃ一時間はかかるだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "すまん、手間をかけたな。このタバコは礼だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "まさか、こんな小さな町に修理屋があるなんて。意外と車通りが多いんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の修理屋",
      "text": "車通りが多い？　ハッ、ここいらじゃ何も物資が入らねぇからよ、全部外から車で運んできてもらってんだ。ここはそんな大切な車サマのための修理屋だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の修理屋",
      "text": "俺は修理屋の仕事がいやになって引っ越してきたのに、結局こっちに来ても同じことをやらされるなんてよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "引っ越してきた？　ここが地元じゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の修理屋",
      "text": "こんな「町」とも呼べねぇような場所に、地元の人間なんているわけねぇだろ。いくら掘り進めても、レンガの欠片と腐った木しか出て来ねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の修理屋",
      "text": "お偉いさんたちが手当てをくれるなんて言わなきゃ、誰も「居住環境改造プロジェクト」なんざのために引っ越してきたりしねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の修理屋",
      "text": "足元の源石クズを見てみな。天災があった場所は、十年以上経とうが住めたもんじゃねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "……本当にこの場所で天災が起きたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "元々あった建物は？　全部なくなっちまったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の修理屋",
      "text": "金にならねぇ鉄クズ以外は何も残ってねぇよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "（車を降りた時は、ここで顔見知りと再会して、少しくらい思い出を振り返れるんじゃないかなって期待してたけど……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "（たしかに鍋蓋ちゃんの言う通り、どこもかしこも源石結晶だらけだ。それに地面の亀裂と、今靴底越しに感じる瓦の破片も……最初からずっと一つの事実をあたしに突きつけていた。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "（天災トランスポーターの勘違いなんかじゃねぇ。町は本当に天災に襲われた。そして、あたしの家も……とっくになくなっちまったんだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん、大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "え？　あ、ああ、大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "あの丘をずっと眺めてましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "あっちにランナお姉ちゃんの家があるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ああ……いや、気にすんな。ちょっとバカなことを考えてた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナはため息をつき、何度も自分の顔を乱暴に擦った。\nだけど、すぐに小さく肩をすくめると、いつも通りのあっけらかんとした表情に戻る。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "あたしの考えすぎだったみてぇだな。それにしても残念だ。タダで家が手に入ると思ったのによ、ハハ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "まあでも、どうせ水も電気も通ってない家だ。トレーラーのほうがよっぽど住み心地がいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "トレーラーは優しくてあったかくて大好きです。でも、ウォーミーとランナお姉ちゃんはもうロドスで自分の宿舎があるので、トレーラーに住む必要はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんにはいつかきっと、もっと広くて住みやすいおうちができますよ……その時は、ウォーミーも一緒に住んでいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "何言ってんだい？　鍋蓋ちゃんがいなけりゃ、毎日自分でメシを作んなきゃならなくなんだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "でもランナお姉ちゃんのごはんも美味しいです――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "アランナ、冷却水の補充が終わった。その、平気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "近所に一通り話を聞いたが、みんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "わかってる。ありがとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "気を落とすなって。もしかしたらお前んちの場所を知ってるヤツがいるかもだろ？　レンガ一個しか残ってなくたって記念にはなる。もう少し聞き回ってみるから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "あいつらは全員、ここに引っ越してきたばっかだ。知ってるはずがねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "行こうぜ、チャーリー。ラストスラグに帰ろう。今から戻ればまだみんなと何杯か飲める。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナは、何もない丘とその丘の後ろに隠れている景色から目を逸らすようにして、振り返った。\n自分よりあの家の場所に詳しい奴なんているはずがない。\nかつてアランナは、いつもあの丘を越えては、青々とした芝生から家の玄関前まで、一気に滑り降りたものだ。\n泥だらけのアランナに、母親が呆れた表情を向けても、彼女はただニヤニヤと笑うだけだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "エンジンを温めてくる。車で待ってるから、ゆっくり来てくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "行こう、鍋蓋ちゃん。もうすぐ日が暮れる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ラストスラグに戻ったらなんか食いたいもんはあるか？　いつものクリームパスタなんてどうだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナは数歩進んで、ようやくウォーミーがついてきていないことに気づいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "……鍋蓋ちゃん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん、見てください。ウォーミーのひざのところ、傷跡が残っちゃいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そいつは宿舎の前で転んだ時に残ったやつだろ？　まだ痛むのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ううん。あの時、すっごく痛かったけど、廊下に人がたくさんいたから泣くのを我慢してたんです。すると、ランナお姉ちゃんがこう言ってくれました――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "「泣くのを我慢するのも疲れるぞ。もうそんなに痛いのに、なんでそれ以上自分を疲れさせるんだ？」って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "その言葉でウォーミーは泣けたんです。泣いたら、転んだところもそんなに痛くなくなりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウォーミーはゆっくりとアランナに歩み寄ると、ぎゅっとその手を繋いだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんの指、ずーっと震えていましたよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ほら、ウォーミーの手を握っていれば、疲れるほど我慢しなくても平気ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "鍋蓋ちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん、怖いと思うのも悲しいと感じるのも、全部普通のことです。ウォーミーも家を出たばかりの頃は、いつも泣いていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんと出会って、いっぱいお世話をしてもらってからは、あまり泣かなくなりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "でも、だからってウォーミーをいつまでも子供扱いしないでください。今のウォーミーは前よりも少し背が伸びたし、ランナお姉ちゃんのお世話だってできます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんが強がってるところは見たくありません。だってすっごく辛くて、疲れるから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "でも、そんな感情を押し付けんのはダメだろ……だってこれは鍋蓋ちゃんとは関係ねぇことなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "家族ってそういうものじゃないですか？　一緒に分かち合って、ごはんを食べて、どっちかが怪我をしたら赤いお薬とか紫色のお薬を塗ってあげて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんとこんなに遠くまで歩いてきたんです。わたしたちはとっくに家族でしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナは、その小さく温かな手をぐっと握りしめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "……ああ、そうだな。うちらはとっくに家族だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんがもう一度おうちを見たいのなら、行けばいいんです。ウォーミーがついててあげますから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ランナお姉ちゃん。\nうん？\nこの坂、すっごく緩やかで、砂もとっても柔らかいです。\nうん……\n家までのこの道を、ランナお姉ちゃんは何回も歩いたんですよね？\n聞かせてください。ここは昔は……どんな場所だったんですか？\nそうだな……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "……昔、ここは草がいっぱいに生えてて、雨が降るとすぐに足を滑らせちまうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "今も少しだけ生えていますよ。短くて、細いですけどね。土から芽を出したばかりでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "鍋蓋ちゃんは、草の生えた坂道を滑り降りたことはあるか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "いえ、なんだか危なさそう……\nでも、すっごく楽しそうです！"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "あたしが鍋蓋ちゃんくらいの年だった頃は、よくここに登っては、滑って遊んでたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんは子供の時から勇敢だったんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "いや、たぶん退屈だっただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "親と一緒にここに引っ越してから、ずっと友達ができなくてさ。でも家にいるのもつまんなくって。家は、いつもその……うるさかったから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "でもうるさいほうが、賑やかですよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "うーん……賑やかとはちょっと違うかな。親は採掘場で働いてたせいで、デカい音の中で喋るのに慣れちまってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "だから家に帰っても、二人は大きな声で怒鳴り合ってた。ケンカしてるように聞こえるけど、顔は笑ってんだ。それに、喋らねぇ時も音楽のボリュームをいつも最大にしてた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "時々、本当にケンカをしてる時もあった。あたしに気付かれないように、笑ってケンカしてんだよ。だけど、笑いながら泣く人間がどこにいる？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "だから、二人がケンカを始めると、いつもここに来て何回も何回も滑ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "その時のランナお姉ちゃん、きっと辛かったですよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "うん。でも結局最後は、泥だらけになって家に帰るしかねぇんだ。いつも玄関の前で、お袋に心配をかけないよう頑張って笑顔を作ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そのあと、親はあたしが泥だらけで帰ってくることでまたケンカをした。そんで、親父は庭にいろんなもんを作ってくれたんだ。ブランコ、トランポリン、それと小さなあまずやもあったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ウォーミーのパパも、ブランコを作ってポーチに置こうって言ってくれましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "大人って全員、それで子供が喜ぶって思うんだよな。不思議だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "でもウォーミーはブランコもトランポリンもあずまやも大好きですよ。ただ……パパが間に合わなかっただけで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "じゃあロドスに戻ったら、あたしが作ってやる。それで宿舎をいっぱいにしようぜ！　な、いいアイディアだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "へへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "あ、もうすぐ丘のてっぺんに着きますよ。向こう側の景色も見えてきました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん？　どうして急に止まっちゃったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "もし怖いのなら、目をつぶっててください。ウォーミーが代わりに見てあげます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ジャリ、ジャリ――焦げた木や砕けたレンガと瓦を踏みつける音が響く。\n地面の隙間に入り込んだガラスの破片や源石結晶に、夕暮れの残照が反射し、きらめいている。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "鍋蓋ちゃん……あとどんくらい歩けばいいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "もうすぐですよ。ランナお姉ちゃん、ゆっくり……足元に気をつけてくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ここ、割れたガラスがいっぱい落ちてて、お星さまみたいにキラキラ光っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ここだけじゃありません……ランナお姉ちゃん、ずっと先の道まで光ってます！　すごい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "鍋蓋ちゃん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "まるで、ランナお姉ちゃんに「おかえり」って言ってるみたい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "おかえり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "鍋蓋ちゃん、もし何もなかったら、黙って車まで連れてってくれないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "……頼む。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "しかし、ウォーミーは突然アランナの手を離すと、前に向かって駆け出した。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "鍋蓋ちゃん！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "どこにいるんだ！？　もうてっぺんに着いたのか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アランナは慌てて前方をまさぐり、ようやくウォーミーの手を掴んだ。ウォーミーはすすり泣いていた。\nそして、ウォーミーは泣きながら笑い出した。彼女はアランナの腕をブンブンと振り回しながら、精一杯叫んだ――"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん！　見て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナはゆっくりと目を開く。\n少し先に見える丘のふもと、その雑草が生い茂った場所。屋根も窓格子もドアフレームもとっくに古いがれきと化していた。\n来る日も来る日も、雨風や日差しに晒され続けたせいか、太い柱と梁もすべて折れ、朽ち果てている。\nだがそんな廃墟の中、一台のブランコがぽつんと立っていたのだ。\n不格好で、頑丈で、錆びだらけのブランコが、夜風に吹かれ微かに揺れている。\nギーコ、ギーコ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「そんなんじゃダメよ！　ほらごらん、あの子が立ってブランコを漕ぐと、物干し竿よりも高いとこまで上がってしまうわ！」\n「危なすぎるわ……ずっと履いてないあなたのキャンバスのズボンを持ってきて。シートベルト作ってあげなきゃ。」\n……\n「ほら、泣かないで。どこが痛いのかお母さんに見せてごらん……まあ、膝を擦りむいちゃってる！」\n「だから危ないって言ったのよ！　いきなりブランコの骨組みが折れるなんて！」\n「ごめん……ごめんよ、アランナ……父さんのせいだ。」\n「あなた？　こんな夜更けにどこに行くの？」\n……\n「さあ、もう寝ましょ。あれはお日様じゃないわ。お父さんの溶接ガンの光が窓に反射しているのよ。」\n「お父さんが何をしてるかって？　さあ……でも、心配いらないわよ。アランナは怒ってなんかいない、すっごくいい子なのよって、お父さんにちゃんと伝えるから。」\n……\n「アランナ、見てくれ！　ブランコをもっと頑丈に加工したぞ！　この鉄筋を見ろ、これくらい太けりゃ――は？　ブサイク？」\n「でも本当に頑丈なんだぞ。これならお前がどんなに高く漕いだって、絶対に壊れたりは……あ、こら、もうあんなに高く漕いちゃダメだからな！」\n「いや、眠くないよ。父さんはこれから仕事なんだ。夜、父さんと母さんが帰ったら、みんなで新しいブランコで遊ぼう。」\n「留守番中にこっそり一人で漕いだらダメだからな。母さんが帰ってきてからシートベルトを締めてもらってから遊ぶんだ。」\n「じゃあ、行ってくるよ！」\n……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "「鉱山事故」が起きたって、みんな言うんだ。その時のあたしは、まだお袋からもらった本でその単語の意味を習ってなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "あたしが覚えてんのは、コップに入っていたキャロットジュースが激しく揺れてたことだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そのあと、色んな人が家に来て、あたしを連れ出そうとした。あいつらは変な形の雲を指差して、今すぐ逃げなきゃと言った。鉱山事故で源石粉塵が漏れ出したせいで、もうすぐ天災が来るんだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そいつらはドアを押し開けると、すぐにあたしを家から連れていってしまった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "この家に……別れを告げる暇すらなかったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "なんつーか……口に出してみると、思ってたほど大したことなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "それでもずっと心の中に押し込んだままだと、大きな石になっちゃいます。トレーラーでこっそり荷物運搬をしてた頃も、ランナお姉ちゃんは石材を長距離運ぶのが嫌いだったでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ああ、速く走れねぇし、ずっとビクビクしなきゃなんねぇからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナは地面から石をひとつ拾い上げると、全力で遠くのほうへと放り投げた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "でもほら、石はもう捨てた！　これで思いっきり走れるぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "鍋蓋ちゃん、丘の上まで連れてきてくれてありがとな。次はあたしが鍋蓋ちゃんを案内する番だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "え、ランナお姉ちゃ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナはニヤッと笑うと、ウォーミーの手を引っ張って、廃墟に向かって大股で坂道を駆け下りた。\nあの頃、何度も何度も歩いた帰り道。天災によって掻き消されてしまったが、今この瞬間、それは彼女の足元に再び現れた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん！　も、もっとゆっくり……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "うちへようこそ！　ほら、みんな鍋蓋ちゃんを歓迎してる――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ギーコー……\n夜風が吹き抜ける。鉄筋とチェーンの間から、金属が擦れ合う音がぎしぎしと響いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "乗ってみるか？　安心しな、このブランコはすっげぇ頑丈なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "い、いいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "いいもなにも、ちょうどここにあるからな。ずっとブランコ、ほしかったんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ロドスに帰ったら、もっとかわいいのを作ってやるからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "でも、これはランナお姉ちゃんのパパが、ランナお姉ちゃんに作ったブランコで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "あたしはもう昔たくさん遊んだんだから、鍋蓋ちゃんに譲ってやらねぇと。それに、ブランコが嫌いな子供なんていねぇだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ウォーミーはもう子供じゃありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "そうだな、鍋蓋ちゃんは今じゃもう、ランナお姉ちゃんも大助かりの立派な子になったもんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "いつかあたしの背を越えたら、次は鍋蓋ちゃんがブランコを押してくれよ。だけど……それまではあたしに世話をさせてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナはウォーミーを抱き上げ、ブランコに座らせると、シートベルトを手に取った。\nベルトの布地は完全に色あせていたが、キャンバス生地越しに感じる金属チェーンは頑丈なままだった。\nウォーミーは顔を上げ、アランナがベルトを締めてくれる動作をひとつひとつじっと眺めていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "このベルト、お袋が何度も縫い直してくれたやつなんだ。他の人には安心して任せられないと言って、一度も親父に締めさせてくれなかったっけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃんのママもきっと、小さい頃のランナお姉ちゃんともっと遊びたかったはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "どうやって締めるんだっけな？　たしかお袋はこうやって……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "よし、できた！　これでどんだけ高く漕いでも、落ちたりはしないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ブランコも表面が錆びてるだけで、骨組みはしっかりしてるしな。ほら、どんなに揺らしてもビクともしねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "親父が一晩かけて直してくれたんだが、小さい時はただ溶接ガンの光が窓に反射して眩しいことしかわからなかった。でも、今この繋ぎ目を見てやっと気づいたよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "確かにこれが一番頑丈にする方法だけど、一番疲れる面倒くさいやり方でもあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "大きくなれば、少しずつ色んなことがわかってくるようになる……ランナお姉ちゃんが何かをうまく説明できない時、いつもそう言ってくれましたね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナはウォーミーの背中をそっと押した。ブランコが揺れる。夜の静けさの中、そのきしむような音はどこまでも響いていった。\nどこまでも、どこまでも……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ランナお姉ちゃん……雨が降ってきちゃったみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "夜空にはまだ……お星さまたちがあんなにキラキラ輝いてるのに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "もういいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ああ、話は帰ってからにしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "そういえば、ランナお姉ちゃん……罰金はどうなったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "おっと、忘れるとこだったぜ！　たしかに言われてみればどうなってんだ？　もう一回メールを確認してみるか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "話を聞いた時も思ったんだが、「住宅管理委員会」なんて聞いたこともないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "「期日までに入金を確認できなかった場合、当住宅は取り壊しとなります。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "どこにお金を振り込めばいいのか、書いてないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "「……同時に個人の銀行口座は凍結されます。スムーズなお取引きのためにも……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "「どうぞ預金をすべて私たちが用意いたしました、安全な口座へ移していただきたく存じます。当口座はレム・ビリトン総合銀行の管轄にあり、安心安全をお約束いたします」だあ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "なんだこりゃ！　詐欺メールじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "もっとちゃんと読めばよかった！　あん時は「取り壊し」って言葉にビビって、最後まで目を通す余裕がなかったんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "でも、このメールがなければ、ここに戻ってくることもありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "ああ、運命ってやつはいつもこう奇妙なのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "あの町で会った修理屋が言ってたんだ。環境推進プロジェクトが終われば、住民も増えて、新しいコミュニティができるだろうって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チャーリー",
      "text": "お前の家が建ってた辺りは、子供の遊び場になるらしい。シーソーやら滑り台やらも設置して、ガキどもがエネルギーを発散させるための場所にするってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アランナ",
      "text": "おっ、楽しそうだな。鍋蓋ちゃんもそう思うだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウォーミー",
      "text": "ふわぁ～……はい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アランナは、視線を窓の外の夜色から、自分にもたれかかっているウォーミーの顔へと移した。\n今にも眠ってしまいそうな顔。まつ毛は、あくびの時に出たのか、涙で少し濡れていた。\nアランナもそっと目を閉じた。まぶたの裏に、きらきらと光る小道とその先にあるブランコの景色が蘇る。\nさようなら――アランナは心の中でそっと呟く。\nさようなら。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
