{
  "server": "jp",
  "storyId": "act30side_level_act30side_05_beg",
  "groupId": "act30side",
  "stageId": "act30side_05",
  "title": "不正乗車？",
  "storyCode": "RS-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act30side/level_act30side_05_beg.txt",
  "sourceHash": "ce7639876804c8afa5ed35c6161b0d015b7fe86f82c32cf2a279b7d045df4eb9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "う……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "どういうことだ……？　なぜ空の酒瓶がこんなに転がっている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……妙だな。俺はなぜ応接間の床で寝ていたんだ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "ロザリン……良い子だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "……アークトス……この……バカ者が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "ぐう……ぐう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "親父！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "ん？　うぅむ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "何を騒いどるんだ！　ゆっくり眠らせてもくれんのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "いや、待て、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "いつ帰ってきてたんだ、親父！　どうして事前に連絡しなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "昨日はここで何が？　俺たちはなぜ床で寝ているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "……大声を出すな、頭に響くだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "旦那、それに大旦那も！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "よかった、二人ともやっと起きてくれたんですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "グロ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "一体何があったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "昨日は旦那も大旦那もしこたまお飲みになりまして。酔っ払うまで眠らんぞとか言って、何度言っても部屋に戻って寝ようとなさらず……俺たちにはどうにもできなかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "それで仕方なく、暖炉に薪を多めにくべておいて、せめて身体が冷えないようにさせてもらったって次第で。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "旦那、昨日のこと覚えてらっしゃらないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "俺は……待て、今思い出す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "昨日、昨日は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "確か、落成式前夜に開く宴の準備をしていたはずだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "客人をもてなすためにイェラグで一番の酒を選ぶよう巫女様から仰せつかり、一つ一つ試飲をしていたが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "そのあと……のことは、あまりよく覚えていないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "フンッ、それも当然だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "お前ときたら、人の見分けもつかんほど酔っ払いよって、柱を抱きしめて乾杯なんぞしていたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "一体いくつだと思っているんだ、この恥さらしめが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "わかった、わかった。だがこれも巫女様とイェラグのためだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "グロの目の前で叱るような真似はやめてくれ。俺にも面子ってものがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "面子というのは、自分自身で保つものだと散々教えて来ただろう。それを潰さないでくれなどと頼んでどうする、情けない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "……まあよい、このくらいにしておいてやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "して、グロよ。ロザリンが見当たらんようだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "ロザリンお嬢さんなら、朝一で山登りに行かれましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "何だと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "お嬢さんは早く目が覚めたんですが、その時は旦那も大旦那もまだお休みになってたもんで、もう少し寝かせてやりたいと仰って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "俺もそのほうがいいと思って起こさなかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "こうして去るのも、またいいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "あるいは、これこそイェラガンドの思し召しなのやもしれんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "出会えど互いにその縁を知らずということは、いまだその時が来ていないのだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "何を訳のわからんことを言ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "昨日客人が来ていたのは覚えているんだが、ひどく酔っていたものだからその娘の顔をよく思い出せないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "聞く限り、彼女はロザリンというのか？　その名前は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "アークトス、来い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "このことは、お前に隠すべきではなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "あの時もそうだったように――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "今どうすべきかを決断するのは、結局のところお前自身なのだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "……我らのイェラガンドに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "親子三代で本当に一晩中飲むとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "おまけに私やほかの護衛まで巻き込んで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "こんなに酒を飲んだのは久しぶりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛？",
      "text": "しかも、重要な発言は何一つなかった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……脇から攻めてもダメなら、いっそ正面から行くとするか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "方角を見るに、ロザリン嬢は登山をしに行ったようだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おお～っ！　でっかい山！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "近くで見るともっと壮観だな！　イェラグの山ってのは、大したもんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "うっ……ちょっと頭が痛えや。昨日はマジで飲みすぎたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "爺さんとおっさんもそろそろ起きた頃かね。しかし、イェラグ人がこんなに親切だってこと、どうしてドクターは教えてくれなかったんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "山を下りたら、何かお礼をしてやらないと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おー、さむっ！　風が吹いてくると肌が痛いくらいだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "確か……イェラガンドへの敬虔な信仰心を証明するには、この山を自力で登らなきゃダメなんだったよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "いくら見ても、すんげえ高さだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……ま、せっかく来たし、試しにやってみっか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客A",
      "text": "「雪山の一番清らかな空気」？　空気を売ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客A",
      "text": "へえ、良さそうじゃない。ここってカードは使えるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客A",
      "text": "そう、じゃあ二箱いただくわ。ホテル・バーデンピークの606号室に届けておいて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない商人",
      "text": "はいよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客B",
      "text": "あーあ、ゾフィア姉さんったらまたこんなに買っちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客B",
      "text": "昨日も雪山の湧き水とかいうのを四箱も買ってたじゃない。こんなにたくさん、どうやって持ち帰るの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客A",
      "text": "バカねえ、自分で持って帰るわけないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客A",
      "text": "ムリナールとマーガレットにもいくつか送ってあげないとね。そう考えると、まだ買い足りないくらいだわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客A",
      "text": "イェラグは空気も水も確かに美味しいし、この地を選んだからには黒騎士もきっと今頃良い暮らしをしているんでしょうね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客A",
      "text": "それはさておき、イェラグで敬虔さを認められたければ、ここの雪山を自力で登頂しないといけないって話よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客A",
      "text": "だからほら、私たちも登りましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客B",
      "text": "確かに、この旅行ガイドにもそう書いてあったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "外国人観光客B",
      "text": "ゾフィア姉さん、どっちが先に山頂に着けるか勝負しようよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "なあ、ライリー爺さん。どうして山頂まで行けるケーブルカーがあることを教えてやらないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "ふぉっふぉっふぉ、観光客にも考えがあるんじゃよ。老いぼれが余計な世話を焼いても仕方なかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "それもそうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "今じゃ喜んで登る奴なんて観光客くらいだし、山登りが好きそうな二人だったしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "だけど、あの人たちの言ってたことも一理あるかも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "ほれ、行くぞ。ケーブルカーに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "本気か爺さん？　それ、イェラガンドへの信仰が足りないって話になんねえか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "何を言う！　これぞイェラガンドが民への慈しみゆえに与えたもうた進歩の表れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "有難く乗らねば、それこそ信仰が足りん証になろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "はあ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "はあとは何じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "我らは皆イェラガンドの民。ゆえにイェラガンドを軽んじず真摯に想い続けさえすれば、イェラガンドは我らをお守りくださる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あっぶねー。ケーブルカーもあったのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "どこの観光地も同じだな……地元民についていかねえと、すぐ損しちまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "何をもって、イェラガンドへの信仰が揺るぎないものだってことになんのかはわかんねぇけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "イェラグの現状を見る限りじゃ、イェラガンドはこの場所をちゃんと守ってくれてるんだよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おーい、そこの爺さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "教えてほしいんだけどさ、ケーブルカーのチケットってどこで買うんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "少々よろしいですか、ご老人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "お主、何者じゃ？　その格好は一体？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "私はヴィクトリアから来た記者です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "皆さんはこのイェラガンド像が素晴らしいものだと仰いますが、こうしたものを建設するために費用や労力を随分と無駄に注ぎ込んだことでしょう。そこで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "帰れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "わしの息子はずっとあそこで仕事をしとるんだ。しばらく帰って来とらんが、毎月仕送りをしてくれるうえに、電話したときは、仕事にも満足していると話しとった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "お主ら外国人は、よっぽどわしらイェラグの良さを認めたくないとみえる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "でしたら、なぜ息子さんは帰ってこないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "何とかいう契約書にサインしたから、向こうに留まらねばならんという話さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "ええと、何と言ったか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの青年",
      "text": "機密保持契約だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……像を建てるのにそんなものが必要だ、と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "よそ者よ、言っておくがな。わしらのイェラガンドを貶めるつもりなら、今すぐ杖をお見舞いしてやるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イェラグの老人",
      "text": "むっ、どこへ行きおった？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "ふん、ふふふ～ん、イェラガンドを讃えよ……♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "勇敢なる駄獣～、勇敢なる人よ～、家を守れとイェラガンドが～、お教えくださる～、ふんふ～ん♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "ふん、ふふふ～ん……♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "ん？　この雪、何か……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "うおっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "気を付けて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "この下は落とし穴よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ケガはしてない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "おお、デーゲンブレヒャーさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "しかし、なんだってこんなところに穴が……ああ、きっとライリーの奴が獲物を捕まえようとして掘ったんだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "いやあ、本当に助かったよ、ありがとう。お前さんがいなけりゃ、今頃滑って落ちちまってただろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "いいのよ、気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "今日は、山に用事でも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "何か手伝えることはあるかい？　実は今日、わしとライリー、それとレオンの爺さん仲間で山に登ろうって約束しててな。何かあったら遠慮なく言っておくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "確かに山に用事はあるけど、手伝いはいらないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そういえば、あなたとライリーって、ヴィクトリア人とよくお酒を飲んでたわよね。一体いつまでやってるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "それがなあ、いつも飲み比べをしてるんだが、今のところは引き分けなもんでな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "こいつは負けられない戦いなんだよ。ヴィクトリアの連中に負けでもしたら、エンシオディス様や巫女様に大恥かかせちまうからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "あいつらときたら、急にわしらのところへ押しかけてきて、駐屯までしよってからに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "屈強な男どもが大勢でドカドカやってくるなんぞ、大して学のないわしにも、良からぬことだとわかるわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "そこでわしらは考えた。一緒に酒でも飲んでおれば、エンシオディス様の代わりに奴らを見張っておけるんじゃないかとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "なあに、安心しとくれ。わしらは絶対に勝つからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そうね。吐くまでとことん飲ませられたらそれが一番だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "うまくいかなかった時は、私を呼んで。あまり無理はしないでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ヴィクトリア人を見張ろうっていうのは、あなたたちが自分で考えたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "ふっふっふ、わしらとほかの連中で一緒に考えたのさ。地元の連中は皆賛成してくれたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "このところ、暮らしは毎日良くなっているし、皆分別くらいはつくからな。誰にもわしらの良い暮らしを邪魔はさせんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "だがな、少し本音を言うから怒らんで聞いておくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ええ、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "わしらは最近、ヴィクトリアの連中としょっちゅう酒を飲んどるわけで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "この一ヶ月接していて、少しはあいつらのことがわかってきてな。ほかのことはそこまで詳しかないが、少なくとも悪い奴らじゃないと思うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "酔っ払った時も大した迷惑をかけてはこんし、普段からたまに仕事を手伝ってくれるしなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "わしと同じくらいの年寄りもおるんだが、飲みすぎた時も周りに面倒などかけず、雪の中を泳ぐぞなんて言っていきなり服を脱ぎだすくらいのもんでな。その時見たあいつの背中は傷だらけだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "どんな修羅場をくぐってきたかはわからんが、想像するだけでもつらいものがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……それなら、このくらい話してもよさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あのヴィクトリアの子爵は、イェラガンド像の完成を祝うためにここを訪れたんだけど、一緒に連れてきてるのは皆彼の近衛兵なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "だからそのほとんどは、彼と戦場を共にしてきたベテランなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "ほう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "でもあなたたちは、あまり深いことなんて考えずに、彼らとお酒を楽しんでくれたらいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "はぁ。近衛兵やら何やらはわしにはようわからんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "確かに、あいつらの中には若者なんぞほとんどいなかった。何人かは見かけたが、皆身体に石が生えているようでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "あれが例の、なんとか石病ってやつなんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……鉱石病よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "日常的な接触くらいなら感染しないし、あまり神経質にならなくても大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "だけど、しかるべき予防策だけはしておいてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "街にあるロドスの事務所か、最近建てられたばかりの病院へ行けば予防マニュアルをもらえるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "いやいや、それはわしらもわかっているから、心配しなさんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "わしはお前さんが相手だから、こういうよもやま話ができるのさ。これがエンシオディス様やノーシス様なら、気軽に話しかけるのは申し訳ないしなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ふうん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "私なら暇そうだから平気ってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "いやいや、そういう意味じゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "旦那様方は毎日大忙しだし、そうそうお邪魔はできんってだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "もちろんデーゲンブレヒャーさんも忙しかろうが、普段から頑張ってくれとるからな。お前さんがわしらの味方だってのは皆よく知っとるし、もう家族みたいなもんなのさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "家族……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "おっと違った、旦那方もだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "どうもわしは気が回らんで困るな。ともあれ、そういうことさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "そういや、お前さんの時間を随分使わせちまったかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "大丈夫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……一つお願いしたいことがあるの。あなたと、山にいるライリーたちにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "お安い御用だ。なんでも言っとくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "気取った格好のヴィクトリア人を探してもらえない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "気取った格好のヴィクトリア人……っていうと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "シルクハットを被っていて、黒いコートの襟を立てて顔を隠している男よ。それと、肩からいくつも宝石を下げてたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "すごく目立つから、一目でわかるはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "そいつは、わしらのイェラグへ来てそんな格好で何をしとるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "さあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "きっとあんまり頭が良くないんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "ともかくわかった、任せとくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりした地元民",
      "text": "何かあったら、レオンのとこの駄獣をお前さんのところへ向かわせるからな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "なっ、本気で言ってるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "昨日のあの子……ロザリンが、俺の娘！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "恐らく間違いないだろう。あの子の顔立ちは、お前にも、タチアナにも似ているからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "老いたこの目もまだかすんではいない。見間違うはずもなかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "そうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "娘……俺の娘……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "はっはは、道理で出来た子だと思った！　器量良しの性格良し、素晴らしく良い娘じゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "ロザリンか……あいつが俺に似ていると？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "確かに似ている……思い出した！　あいつの髪の色は、俺と同じ茶色だったな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "目と口はタチアナに似ていた……特に目などはそっくりだ！　美しい目だった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……しかし、時間が経つのは本当に早いな。あの子が、あっという間にあれほど大きくなるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "待てよ、あいつは山へ向かったんだったな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "それならいつ帰ってくるんだ？　いや、そもそも帰ってくるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "アークトス。もう一つ伝えねばならぬことがある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "親父、悪いが、俺は娘のために手土産を用意しなくちゃならないんでな。用があるなら後にしてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "たしか小さい頃のあいつは焼きスイートチーズと獣肉シチューが大好物だったはずだ。すぐに買いに行こう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "もしかすると、タチアナ……あいつも来ているんじゃないのか？　俺に会いたくないから姿を見せてくれないのか？　だとしたら、俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "いや、今は考えないでおこう！　とにかくまずは、山へ登ってロザリンのもとへ手土産を届けるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "タチアナのことは、その時あの子に聞けばいいだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "アークトス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "どうしたんだ親父、今は急いでるんだぞ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "待てと言っている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "……落ち着け。まだお前には、知らねばならぬことがある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "父の怒声でその場にとどまったアークトスは、心の中に湧き上がる嫌な予感を抑えきれなかった。\n二日酔いのせいか、ふと耐え難い頭痛と胃の不快感が襲ってきて、どこからともなく生じた冷たい感触が背を這い上る。\nアークトスはその時ようやく、久々に見た父の背が少し曲がっていることに気が付いた。記憶にあるほど大きくはないその背は、まるで次第に枯れ萎んでいく大樹のようだった。\nしかし、老修道士のしわがれ声は、アークトスの胸中がざわつこうとも止まらない。"
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "ロザリンから聞いた話では、あの子は母親と共にここを離れた後、ウルサスに移り住んだそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "ここを去った時のあの子はまだ幼すぎたから、当時のことは何も覚えていないと言っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "ロザリンはこれまで何年もの間、父親が誰なのかも知らずに生きてきたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "あの子が今回帰ってきたのは、我らがイェラガンド像を目にするためであり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "母の形見をイェラグへ持ち帰るためでもある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "嫌な予感というのはいつも当たるものだ。\n屋外で吹きすさぶ風雪に、室内で跳ねる暖炉の火、そしてどちらのものとも知れない呼吸音。そのすべてが一瞬静止したように感じられた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……なんだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "形見……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "どういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "だ、だがタチアナはまだ若いだろう、なぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "そんな……そんなはずが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "私はこの耳で聞いたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "当時のことについては……我々ペイルロッシュ家は、彼女たち親子に申し開きなどできん立場だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "しかし、我が心には罪悪感こそあれど、後悔はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "アークトス、お前はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "いや、良い。何を言うにせよ、私に伝えたところで意味はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "お前の父は完璧な人間でも、聖人でも、ましてや被害者でもないのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "私は老いた。お前に何かを示してやることはおろか、お前の言い分を聞いてやることもできん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "今はただ、日々イェラガンドの足元のほこりを払いながら余生を過ごしたいとばかり願っているのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老修道士",
      "text": "お前は……自分でよく考えてみると良い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "タチアナ……ロザリン……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "旦那、大旦那！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グロ",
      "text": "ラタトス様がお越しです！　急ぎで話したいことがあるとか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "チッ、酒臭いな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "明日は式典だぞ、アークトス。今から酒浸りじゃ支障をきたしかねんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……今はお前とやりあってる気分じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "何かあったんだろう、言え。お前が用もなく訪ねてくるとは思えんからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ふふっ、わかってるじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "だったら単刀直入に行こう。あんたに忠告しに来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "私の記憶が正しければ、あんた昔、家の反対を押し切りウルサスの女をめとって、娘まで生まれてたはずだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "その後、シルバーアッシュ夫妻が事故に遭い、それからほどなくしてあんたの妻子はイェラグを去った。このことを知らない人間は私たち三家にはいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……フンッ、相変わらず鼻が利くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "褒め言葉として受け取っておくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "今日はあんたの娘――ロザリンのことで話をしにきたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "ロザリンが一体どうしたと言うんだ？　娘にかこつけて適当を抜かすなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "あいつは三家とは無関係なんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "昔のことを蒸し返す気はないけど、どうも帰ってくるタイミングが悪すぎてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "あの子が今どこにいるかわかるかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "今はヴィクトリアの密偵に目をつけられてる可能性が高いんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "やっと着いた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ケーブルカーがここまでなら、結局あとは自分の足で登るしかねぇみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "まあいっか。山頂まではそんなに遠くねぇみたいだし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "しかし、さっきまではほかの観光客もちらほらいたってのに、ここに来て完全にいなくなっちまったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "四方八方真っ白けだ……う～っ、なんかちょっと気味が悪ぃや。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ん……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……つい……てない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……な、何の声だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……イェラグに来てから、何もかもがうまくいかないな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そこにいるのは誰だ！？　で、出てこい！　ビビらせようったって無駄だからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あれ……あそこにあるのは、穴……か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "道端に穴なんか掘るバカは一体どこのどいつだ？　って、いや……こいつはただの穴じゃねぇな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "誰かが作った落とし穴だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "その通り。これは落とし穴です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "お嬢さん、足元にお気をつけて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "それと、もしよろしければ、引き上げていただけませんか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
