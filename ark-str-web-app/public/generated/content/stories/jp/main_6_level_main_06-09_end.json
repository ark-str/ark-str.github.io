{
  "server": "jp",
  "storyId": "main_6_level_main_06-09_end",
  "groupId": "main_6",
  "stageId": "main_06-09",
  "title": "ベルを外して",
  "storyCode": "6-10",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_06-09_end.txt",
  "sourceHash": "ad6146d81a305bdb0b0756f5281a464b3d45b72a94c7b7513e5f28d199c08486",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "はぁっ、はぁっ……やるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "あの黒装束たちを退けたぞ！　お前たちは今のうちに早く逃げろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "感謝する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "感謝など結構だ、もし余力があれば我々と共に戦ってくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "四階からゆるりと降りてきたかと思えば頭の上をかすめていった……あの技を見たか？　バッグに入ってた姐さんの源石で奴の武器を凍らせなかったら、今頃死んでるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "ホントにすげぇ連中だ。ウルサスのガスマスクを付けた軍刀使いみたいだ。いや、それ以上かも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "死にかけたというのに、何をそんなに盛り上がってるんだ？　そのガスマスクの軍刀使いというのは、ウルサス皇帝の衛兵だろうが！　あの時はたった五人だったが……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "今相手にしてる黒装束は何人いると思っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "つまり俺たちは前よりも強くなったってことだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "冗談を言ってる場合じゃない、奴らの戦闘技術と装備は、どう考えても都市丸一つ……いやいくつもの都市の工業力がないと成り立たないものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "他の小隊の助けがなければ、奴らを一時的にであっても撃退することなんて不可能だった。数を減らすなんてもってのほかだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "いやつまり俺は……俺も頑張ってるってことをだな……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "だが今の状況は、我々がどうにかできる範囲を超えてる……こちらも長くは保たないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "静かにしろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷彩狙撃兵",
      "text": "どうも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "姐さん。彼らは……ファウストの隊員たちだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ゴホゴホッ……ああ、お前たちか。覚えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷彩狙撃兵",
      "text": "……フロストノヴァ。あんたの通信を受けて、それで……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "どうしてメフィストがお前たちのところにいる？　何があった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷彩狙撃兵",
      "text": "メフィストは恐らく……精神的な傷を負ってしまって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "メフィストが？　精神的な傷？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "それより、ファウストはどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷彩狙撃兵",
      "text": "ファウストは俺たちと他の小隊を無事に撤退させるため、スラムの外に残った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "あの状況では、生き残るのは難しいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ファウストは良い戦士だった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷彩狙撃兵",
      "text": "フロストノヴァ、できることなら、俺たちもスノーデビルと一緒に戦わせてくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "良いだろう。我々も残った同胞たちを逃してやらねばならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "狙撃位置について待機しろ。ここからの戦いでは、必ずお前たちの援護が必要になる。敵がいつ次の攻撃を仕掛けてくるかわからない状況だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "迷彩狙撃兵",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "我々の位置を各小隊に伝達せよ！　彼らを迅速に撤退させ、我々が撤退ルートの安全を確保する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "避難の列を途絶えさせるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "奴らはウルサスの兵士と同じで、周囲の地形や住民の被害は全く顧みないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "いや、さすがに同じではないだろう。ウルサスの兵士は市内で艦載砲を使おうとするような連中だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "冷酷な奴らだとは知っていたが、そんなことまでするのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "ああ、実際にこの目で見たことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "だからこそ、この黒装束たちは違うと分かる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "奴らからすれば、スラムの住民は障碍でも何でもない、俺たちと同じターゲットだ。感染者かどうかはぱっと見わからないし、俺たちが住民のフリをする可能性だってあるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "ウルサスは一般市民が逃げようが我関せずという顔だったが、奴らはそれが人であれば誰一人漏らさず逃さないつもりなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "それにしても避難する奴らが多すぎるぞ、もう秩序なんてあったもんじゃない！　フロストノヴァは本当に難しいことをさせるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "姐さんは見て見ぬ振りなどしない主義だ、レユニオンかそうでないかは関係なくな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "龍門に来たのは作戦に参加するはずだったが、来てみれば人助けばかりやってる……不思議なものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "作戦どころか、お前たちの支援が来なければ、俺たちみんなとっくにここで死んでたさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "ひどいものだな。本当に我々に全てを託していたということか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "そんな偉そうなことを言うもんじゃないぜ……これまではお前たちを恐ろしい奴らだと思ってたが、それもさっきまでだ。今じゃ、大道芸人みたいに親しみが湧いてくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "我々を誤解してるのだろう。普段の口数こそ少ないが、恐ろしいとまで思われていたとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "まぁ一つだけ言っとくと、お前たちに全てを託してたってのはナシだぜ。今だって一緒にここを守ってるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "その通りだ！　兄弟よ、我々はここを守り抜くぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "何があった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "はい……室内から出られなくなっている住民を見つけました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "母親とその娘、親子のようです。ここに火点を敷くつもりですが、どうやって説得すべきか……。二人とも怯えて会話が成り立ちません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門市民",
      "text": "（現地方言）！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門市民",
      "text": "（現地方言）……（現地方言）……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……この子はお前の娘、そうだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "わーん……わーん……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "元気な子だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ああ、怖がるな、怖がらなくていい。泣くな、お母さんがそこにいるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "お母さんがいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "うう、わ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "うー、うん……うう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "えへへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "あっ、笑った……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "早くこの子を連れて逃げろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "龍門市民",
      "text": "……（現地方言）？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "お前たち、ゴホッ、彼女を安全なところまで送ってやれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "でもこいつらは非感染者ですよ。まだ撤退が終わってない同胞もまだまだいます。もう時間もあまり残されていない状況ですが……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "それで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "……いや、こんな状況です。感染者も非感染者もありませんよね。分かりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "うん、あの、えーっと、こうか……コッチダ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門市民",
      "text": "ド、ドウモ……アリガトウ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員",
      "text": "姐さん、俺たちが戻ってくるまで待っていてくださいよ。くれぐれも無理はしないでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ふんっ、お前たちの「姐さん」はそこまでヤワじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……早く行け！　奴らが来るぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "それに制服を着た他の部隊も展開している……恐らくあれが龍門の近衛局だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ゴホゴホッ、ゴホッ、ぐっ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "いいから行け！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "エリア内の気温を最大限まで低下させた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "制服の連中は俺たちの相手にならんだろう。だがあの黒装束たちには警戒しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "ビッグベアーはどうした？　今の火力じゃ足りない、火力で押さえつけるんだ。もっと派手にやれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "「分かった」、だそうだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "姐さんの身体はもうギリギリだ、これ以上温度を下げたら危険だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "ここの路面構造ごと破壊できないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "ダメだ、道路を破壊してしまえば、避難中のレユニオンと住民がこの出口にたどり着く術がなくなる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "出口は本当にここだけなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "ああ……他の出口は全部破壊されてる。もう私たちがこじ開けたこの出口しか残ってない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "……俺たちに残された時間はあとどれぐらいある？　というか、姐さんに残された時間は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "なんでこんな時まで姐さんに無理させなきゃいけないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "……よし、そろそろ一段落だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "姐さんを見てくる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "姐さん、さっきの感染者たちはみんな避難させた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "戦況……は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "近衛局は完全に封じ込めた。ここは私たち向きの地形だ、近衛局も数の有利を活かせない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "だが……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "何も隠すことはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "黒装束の龍門部隊は、ここの地形や住民たちのことなど意に介していない。奴らは……この場所ごと徹底的に破壊するつもりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "スラムを片っ端から更地にしていってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "では、これまでに見た龍門の非感染者たちの無残な姿も……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "恐らく奴らの仕業だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "姐さん、アーツを止めてくれ！　奴らは私たちが止める、少し休んでくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストノヴァ",
      "text": "ゴホッ、ゴホッ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "姐さん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "……気温が限界を更に下回り始めてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "よし上手くいった……やったぞ！　ここの鉄骨構造はもうかなり脆くなってるはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "あいつらを足場ごと破壊して撃退するぞ！　早く！　撃て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員B",
      "text": "敵が後退したぞ、続けて一斉掃射だ！　敵を退却に追い込め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "お前ら、さっさと動け！　今のうちに、早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "わ、わかった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "さすが姐さんだ、本当にやっちまいやがった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員C",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "ペトロワ、そんな暗い顔してどうしたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スノーデビル隊員A",
      "text": "……姐さんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペトロワ",
      "text": "ヤング、来い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤング",
      "text": "嫌だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペトロワ",
      "text": "いいから来い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤング",
      "text": "嫌だ、そんなこと俺は信じねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペトロワ",
      "text": "信じざるを得ないんだ。姐さんの時間は、もうあまり残されてはいない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
