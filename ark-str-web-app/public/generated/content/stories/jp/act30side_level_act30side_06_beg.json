{
  "server": "jp",
  "storyId": "act30side_level_act30side_06_beg",
  "groupId": "act30side",
  "stageId": "act30side_06",
  "title": "不正乗車の代償",
  "storyCode": "RS-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act30side/level_act30side_06_beg.txt",
  "sourceHash": "749d799878bfb213972e8b73d05500e53b9f7d604ab7557cc770c803030ffc9e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "私は悪い子なんかじゃねぇ！\nこのっ、デタラメ言いやがって……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "来るなら来い、ちっとも怖かねぇぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "私は悪い子なんかじゃねぇ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "私には母ちゃんがいれば十分だ！　父ちゃんなんかいらねぇ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "いらねぇんだよ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "はっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "まさか、上から落ちたおかげで見つけられたなんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "双子の木……こんなとこに隠れてたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "こいつで間違いなさそうだ。マジで絡み合って生えてんだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ふぅ……これでよし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "母ちゃんの用事は済ませられたな。さーて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "チッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "やっぱダメだ、全然登れやしねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "雪は深すぎるし、崖も急すぎる。こんなん素手じゃ無理だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "試してないのはこっちの崖くらい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "待て、ロザリン！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "ッ、ぐっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "あまり近付くな！　そっちは危険なんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "わかったわかった、行かねぇよ。おっさんもじっとしててくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "まだ足が動かねぇんだろ？　無理すんなって。今は座って休んでてくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "いいや、大したことじゃない。お前にケガをさせるわけにもいかんしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "まさかお前が、あのヴィクトリア野郎に目を付けられるとは。このままでは済ませんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ってことは、あいつマジでヴィクトリアのスパイだったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "まあ、でも……正直あいつにはまだ何もされてねぇんだけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "何かあってからでは遅いんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "こうも時期の悪い時でなければ、我がペイルロッシュ家の領地に二度と踏み込めなくなるくらいには殴りつけてやったというのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そもそもおっさんが急に出てこなければ、私があいつを縛り上げて懲らしめるつもりだったんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "まあいいや、この話はよそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "ところで、さっき……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あーもー、ウダウダやるのは性に合わねぇんだ！　ストレートに聞かせてもらうぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "さっきここに落ちてきた時、どうしてわざわざ私の下敷きになってくれたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "それに、あのヴィクトリア人、私のフルネームを知ってたりとか変な言動してたけど、あれってどういうことなんだ？　おっさん、何か知らねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "ロザリン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "今こんな話をしても、受け入れがたいことはわかっている。だが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "俺とタチアナ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "……つまり、俺とお前の母親は、この山頂で出会ったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "母ちゃんと……ってことは、おっさんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "お前の想像している通り――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アークトス",
      "text": "ロザリン。お前は俺の娘だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "これはまた、珍しい客人だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "ラタトス、お前がそうも慌てて訪ねてくるとは何事だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "私が来た理由くらいわかってるだろう、エンシオディス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "あんた、今やってるような根拠のない誘導なんかでヴィクトリアの「グレーシルクハット」を騙しきれると本気で思ってるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "賢い人間ほど、自らの判断を深く信じ込むものだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "そこは否定しないがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "忠告はしておこう。あまり他人を見くびらないほうがいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "あの密偵は確かにアークトスの娘を追っている。誘導は成功しているように見えるが、そう簡単に事が運ぶとは思えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "万が一、あの男があんたの予想通り動かなかったらどうするつもりなんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ほかに手を考えてないわけじゃないんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "アークトスの娘がこのタイミングでイェラグへ戻ってきたこと自体が予想外の出来事だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "この場当たり的な計画ですべての問題を解決できるとは当然思っていないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "つまり、手はあるわけだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "それで……今日はどうしてノーシスの姿が見えないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "あいつだけじゃない。普段あんたのそばに控えてる護衛の女もいないだろう。うちの妹夫婦から聞いた話じゃ、あの女ここ数日はほとんどチェゲッタの訓練に出てないそうじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "お前は耳が早いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "だが、ノーシスとデーゲンブレヒャーにも自分たちの仕事がある。あの二人に会いに来たのなら、その期待には応えられまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "あいつらに用なんかないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ああ、でも……そうだね。ノーシスがいたら、伝えておきたい「良い知らせ」があったんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "ほう……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ま、大したことじゃないよ。明日になりゃわかることだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "ノーシスにも伝えたことだが、あんたにも改めて忠告しておこう。いいかエンシオディス、イェラガンド像の足元の件についてはしっかり掌握しておきな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラタトス",
      "text": "これはもう、あんたらシルバーアッシュ家だけの問題じゃない。ブラウンテイル家もそこにすべてを賭けてるんだ。そのことを忘れるんじゃないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "肝に銘じておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "だが、三家に対してであれ、巫女様率いる蔓珠院に対してであれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "お前はもっと信じる心を持つべきだ、ラタトス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "お前も私も、ノーシスも、そしてデーゲンブレヒャーも――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "我々の全員が、イェラグの未来のためにここにいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンシオディス",
      "text": "私はそう強く信じているんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "追いかけっこはもうおしまい？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "もう十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "それと先ほどの言葉は撤回しましょう、デーゲンブレヒャー女史。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "あら、その賢い頭で今度は何を思いついたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "やはり黒騎士は、人を騙すような真似はしないのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "これは私の勝手な勘違いでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "当初私は、ロザリン嬢こそがイェラグの計画における重要人物だと思い込んでいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "でなければ、少し彼女への興味を持っただけでこれほど多くの手がかりが出てくるはずがない、と思っていたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ですが、あなたがここに現れたのは、私がアークトス氏やロザリン嬢に接触するのを阻止するためではないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "むしろ私の誤解をさらに深めるためにいらしたのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "話はそれで終わり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "頭のいい人って、そうやってよく喋るのよね。だけど私にはわからないし、別に理解したくもないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "さあ、武器を取りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ヴィクトリアの牙の鋭さを見せてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いやいや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "その前に私は降参します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "手がかりのすべては勘違いだったのですから、私たちが戦う必要などどこにありましょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "先ほどあなたが仰った通り、私は山を下りてランチでもするべきなのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「グレーシルクハット」は静かに両手を上げ、デーゲンブレヒャーのそばを通り過ぎる。\nが、彼女の背後まで来たところで、彼はふと足を止めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "とはいえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "これは些細な憶測なのですがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "私の知る限り、エンシオディス氏という方は目的もなく無駄な行動など取らぬ人です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ゆえに、もしロザリン嬢が少しも重要な人物でないのなら、彼が餌に使うことはないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "しかし、彼女自身には何の嫌疑も見当たらない。となれば、もしや何かあるのは彼女の背後……ペイルロッシュ家のほうなのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ペイルロッシュ家が運んだ酒、あるいは手配した輸送ルートに、その何かがあるのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ロザリン嬢の出現は単なる偶然であり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "そしてそれゆえに、あなた方は私がロザリン嬢との出会いの後、図らずもペイルロッシュ家に探りを入れ、気付くべきでない物事に気付くのを恐れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "だからこそ、こんな芝居を打って見せたのではないでしょうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "デーゲンブレヒャーは黙したまま、ゆっくりと武器を振り上げた。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ペイルロッシュ家はイェラグの資源輸送を担当していますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "他方で、イェラグの全鉄道には共通の合流地点があります。それは銀心湖であり、さらに言うなら注目すべきなのは……イェラガンド像の足元にある小島でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あのイェラガンド像には、恐らく何かしらの秘密があるのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "諜報員ってそんなふうに自分の考えを口に出してしまうものなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ですが、人には得手不得手というものがあります。武力に限った話で言えば、ヴィクトリア中の傑物と比べたとしても、あなたは相当ずば抜けた力をお持ちだと言えましょう。しかし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "無意識に起きるわずかな表情の変化を、完璧にはコントロールできていないのは確かです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "私の推測は正しいと考えて良さそうですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "デーゲンブレヒャーは容赦なく武器を振り下ろしたが、「グレーシルクハット」はとうに準備を整えていた。\n彼は衝撃を、雪を、殺意をすり抜け、麓に向かって走り出す。\nデーゲンブレヒャーもその後に続いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "銀心湖行きの駄獣観光車、もうすぐ出発しますよ～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "専門の訓練を受けた駄獣が、観光名所の一つ一つへお連れしますので最高の景色が楽しめること間違いなし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "道中の風景を楽しみたい旅行客様はぜひお見逃しなく～！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "銀心湖に行きたいんだ。一番速い駄獣を頼む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "一番速いのですと、追加料金がかかりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いくらでも払おう。今、極悪人に追われているところでね。私の命を救うと思って、頼む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "この後、私がどこへ向かったかを聞いてくる者がいれば、知らないと言ってほしい。いいな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "……娘が送ってくれた映画のディスクにこんなシーンがあったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "（口笛を吹く）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "こいつにしましょう。うちで一番速いタクメイです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "このことは誰にも言いませんから、安心してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「グレーシルクハット」は駄獣の背へと素早く飛び乗った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すると駄獣は大きく足を踏み出して、銀心湖へと駆け出した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "いやあ、外国のお人は面白いなあ。娘が帰ったらこの話をしてやらないと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "黒いコートを着た外国人を見なかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "おお、本当に来たぞ！　いや申し訳ない、見ていな――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "ありゃ、デーゲンブレヒャーさんじゃないですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "前に会ったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "忘れちまったんですか？　去年うちのタクメイが荷物を運んでる時に沼にはまっちまいまして、そこへ通りかかったあなたが引っ張り上げてくれたんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ああ、そんなこともあったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "それで、例の外国人は見てないのよね？　だったら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "待ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "あの野郎、デーゲンブレヒャーさんを悪人呼ばわりするなんざ、とんでもない嘘つきだな！　こっちはタクメイまで貸しちまったってのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "ここはきっちり懲らしめてやらんと！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "牧畜民はそう言うと、トランシーバーを取り出した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "止まれ、タクメイ！　そいつは悪い奴だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ふぅ……駄獣の機動性というのは侮れないな。そして何より、とてもタフだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "もしかすると、一種の戦略資源になるのでは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "んっ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "またがっていた駄獣が、突然落ち着きのない動きをし始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "駄獣貸しの牧畜民",
      "text": "デーゲンブレヒャーさん！　タクメイはあそこです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "チッ――追いつかれたか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "しまっ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "くっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "もう諦めなさい。今日の所は、私の目からは逃れられないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "単なる観光目的でも、ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "イェラグの案内なら私もできるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "それはご遠慮いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "はぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "元気なイェラグ人",
      "text": "今日こそスケート滑れるようになるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "もう一ヶ月も同じこと言ってるじゃない。これ以上かけてたら、夏になっちゃうわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "そうなったら、また湖が凍るのを待たなきゃいけなくなるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気なイェラグ人",
      "text": "だからこそ、今日滑れるようになるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "はいはい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "悪いが、借りていくぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "元気なイェラグ人",
      "text": "うわっ、俺のスケート靴！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "この金で新しいのを買ってくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「グレーシルクハット」は、各地を調査して回っていた時に、イェラグ人が冬の暖かな日差しの下で氷の上を滑っている光景を目の当たりにしていた。\nその遊びはなかなか楽しそうで、時間があれば自分も試してみたいものだと彼は思っていた。\nとはいえ、こうも早く機会が訪れるとは思ってもみなかったのだが――\n実行してみてすぐに、彼は判断ミスに気付いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "うっ、これは――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "あら、てっきり滑れるんだと思ってたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "あなた初心者ね？　重心が不安定だもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "転んだ密偵",
      "text": "重心……？　ふむ、なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "転んだ密偵",
      "text": "ッ、まずい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "どいてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "元気なイェラグ人",
      "text": "うわあっ、空から人が！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "重心……重心か。よし、わかった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「ドーン」という大きな音と共に、デーゲンブレヒャーの攻撃で氷面に大穴が空き――\n「グレーシルクハット」はそれを間一髪でかわした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ワーオ、できたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "何と愉快なスポーツだ！　国に帰ったらぜひとも広めよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "まあ、そのためにもまず今日を生き延びなければいけないが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "元気なイェラグ人",
      "text": "あ、あ、あいつ滑れてるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "あんなに早く滑れるようになった人なんて初めて見たわ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "やれやれね。ほかにスケート靴はある？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "あっ、でしたら私のを貸しましょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "滑れるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "冷静なイェラグ人",
      "text": "はやっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
