{
  "server": "jp",
  "storyId": "act27side_level_act27side_st02",
  "groupId": "act27side",
  "stageId": "act27side_st02",
  "title": "雨、雨、あっち行け",
  "storyCode": "SL-ST-2",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act27side/level_act27side_st02.txt",
  "sourceHash": "102120e469a03d2c0a3b0e9d6b4f2eb550ea57760fcf27b3c987b474ab20882a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "差し込む夕日が、この小さな店の最後の客のようだった。しかしカウンターの向こうに立っているのは見慣れた老人ではなく、一匹のコーヒー色の生物だ。\nその生き物がコーヒーミルのハンドルを回すたびに、コーヒーの香りと豆の粉末が空中に飛ぶ。\nレコードはゆっくりと回転し、スピーカーがゆったりと歌う。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "コーヒー色の生物",
      "text": "おや、いらっしゃい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "初めてお会いしたように思いますが、あなたはここに来たばかりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーヒー色の生物",
      "text": "多分そうだろう。何分わしは昨日の記憶がなくてな。なぜ自分がここにいるのか分からないんだが、どうしてかここでコーヒーを作った方がいい気がしているんじゃ……うーむ、一杯飲むかの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーヒー色の生物",
      "text": "コーヒーというのは、手で淹れてこそ、しなやかで素晴らしい風味を出せるんじゃよ。どれどれ、届いたばかりの種はどこに置いたかな。自分でしまったはずだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーヒー色の生物",
      "text": "ギターとやらの後ろだった気がするが、うーん……ギターと口にしたらなんだか突然怒りが湧いてきたぞ。おかしい、どうして胸の中がざわざわするのじゃろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ギター？　怒り？　えっと、大丈夫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーヒー色の生物",
      "text": "まあいい、きっとそこに置いてあるギターがあまり面白くなさそうな代物だからじゃろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーヒー色の生物",
      "text": "適当に座ってくれ。君が待っている人はすぐに来る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "私が待っている人……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コーヒー色の生物",
      "text": "君が待っているのか、それとも君を待っていたのだったか？　わしには分らん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "あら、ここにいたわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あなたは……あなたのことは覚えてます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "こんばんは、アデル。遅れてごめんなさい――今日はちゃんと朝ごはんを食べた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "はい、食べました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "でも、どうしてそんなこと聞くんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "良い子ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "もう服を着替えたのね、準備はできたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "服……？　あれ、この防護服はお母さんのじゃ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "支度ができたら、一緒に買い物に行くわよ。火山を登るために必要なものを買うの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "太陽が少しずつ傾き、通り沿いの店の明かりがぽつりぽつりと灯り始めた。アデルの目の前は少しぼやけ、昔どこかでこのような空を見たことがあるような気がしていた。\nリターニアの南の国境にあった小さな町の、学校から家に向かう道にも、こんな通りがなかっただろうか？\n彼女は、あの時の空気の匂いすらも覚えていた。ほんのりと湿っていて、太陽と成長する植物の気配をわずかに帯びていた。まさに今と同じだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ここは、あなたたちのデパートですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "ええ。火山に登る前に準備をする必要があるから、それをここで揃えるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "火山に行く時に準備しなきゃならない物がたくさんあるのは知ってます。コンパス、防護服、カメラ……山で夜を過ごすなら、火打ち石やテントも持って行く必要があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "いいえ、ここではそういう物の準備はいらないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "まず欠かせないのは「知識」ね。たっぷりと買いましょう。それから「勇気」と「好奇心」だけど、これは値段を比べて安い方を買えば大丈夫よ。最後に、少しの「運」も手に入れるといいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "だけど「運」はとても高くて、いつもすぐに売れてしまうの。だから予算が足りないなら買わなくてもいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "そうなんですか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ふわふわの生き物が体を揺すると、サイダーのキャップが何個か毛の中から転がり出す。チャリンチャリン、キャップは商人のポケットに落ちた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない生物",
      "text": "お買い上げありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "うーん……もう少し「勇気」を買っておく必要がありそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "火山を登る「勇気」はもう足りているけれど、家を離れる「勇気」が少し必要だわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "柔らかな生き物が再び体を揺すると、また何個かのキャップが毛の中から転がりだした。商人はポケットを開き、さらに入ってくるのを待つ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない生物",
      "text": "足りない、まだ足りないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "抜け目ない生物",
      "text": "ポケットがいっぱいになってないよ。いっぱいじゃないと「勇気」はあげられないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "「勇気」が買えなかったら、火山には登れないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "大丈夫よ、アデル。こういうのはよくあることだもの。だから、私も「勇気」を自分で見つけることには、もう慣れてきたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "行きましょう。それと、これからの道は気を付けてね。自分の物から目を離しちゃいけないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "自分の物？　私は何も持っていませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "「写真」を盗もうとしている人がいるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "一緒についてきて、私の荷物をちゃんと見張っていてくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……すみません、今何て言いました？　はっきり聞こえませんでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "このままではいけないわ。アデル、これをあげるわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ふわふわの生き物が体を揺すると、ひとまとまりの羊毛が落ちた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "これは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "おいで。それを耳に付ければ、聞こえるようになるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "それでね、まだもう一人会いに行かないといけない人がいるの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "もこもこの生き物が、写真で窓を覆っている。彼は足音を聞いて振り返った。\nそれと同時に、ふわふわとした体で、写真の貼られた窓を隠した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "おっと、うん……君たち……やっと来たか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "準備しなければならないことが多かったの。天気はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "空の雲が分厚いから、すぐに雨が降るだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "時間はまだあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "あまり多くない。急ぐ必要がある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アデルは空を見上げたが、そこに雲などなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……傘を買いに行きましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "大丈夫よ、アデル。ほら見て、私が傘になるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "「写真」は濡れてはいけないし、誰かに盗まれてもいけないの。私の荷物の中にしっかりとしまっておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "「写真」って何ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "しーっ。あなたには、それが何であるか知らないでいてほしいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "知るとしても、それは遠い遠い先のことよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "厳かな生物が首を垂れた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "行こう。少ししたら上に行く、上が私たちの行く場所だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "今のままだと、君にはまだ羊毛が足りないな。ほら、アデル、これは私のだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "え……？　は、はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二匹のもこもこは一回り小さくなったように見え、アデルはというとまるで彼らの一員になったかのようだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "うぅ……わっ！　このふわふわの毛、私を連れて跳ね上がってるみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "つまり、私たちの旅が始まろうとしているということだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "上の景色はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "雨が降るまでは素晴らしいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "あなたの気分はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "……雨が降るまでは素晴らしいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "アデル、あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "うーん、あなたは今、気分が良いんじゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "例の小柄な生き物が、アデルたちについていこうと少しずつ飛び上がる。\n通りを伝い、灯りを伝い、雲と星を伝い、その生き物は必死に高く飛び跳ねていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "わぁ……あの子、だいぶ丈夫になったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あの子も私たちと一緒に行くんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ふわふわの生き物は答えることなく、アデルの服の裾をくわえた。タン、トン、タン、トン、彼女たちは光を踏んでいく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アデルはまるで空を飛んでいるような気分だった。道には人々が、いや、黒い羊たちが行き交っている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "――わっ！　気を付けてください、ぶつかっちゃいますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽しそうな生物",
      "text": "あっちでお花を売ってる！　早く行かなきゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "急いじゃダメですよ。走ったせいで、あなたの虹が曲がっちゃってます。ほら、直してあげますね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "直りました、もう行っていいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "楽しそうな生物",
      "text": "ありがとう、またね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "羊たちが街を行き交い、店を出入りする。夜の街並みはすでに別の姿に変わっていた。\nアデルは振り返り、羊たちに押し出された二匹の同行者を探す。そちらへ体を向けると、ふんわりした生き物は彼女の背後で静かに見守っていた。\nまるで長い間ずっとそこで待っていたように慣れた雰囲気だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "アデル、帰ったら、石を植えるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "石？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "ああ。前に石を植えたことがある私たちのようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "我々はそれを地面に植えたんだ。地下はとても暗かったけど、その石は様々な石に出会った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "きっと、あなたがその石のためにたくさんの「運」を買ってあげたんでしょうね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "より遠くの空に向けて、二匹のもこもこは上へと跳ね続ける。\nアデルは二匹の間に立って、両手で彼らを掴んでいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "うん……それも理由の一つだ。しかしそれよりも重要なのは、私が毎日それに「愛」を注いだことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "それと「思い出」もね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "それも、お店で買ったものですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "いいえ、アデル。「愛」と「思い出」の二つはね、私たち自身の宝物なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "それらは、あなたの歩いた道、あなたの胸の中、そしてあなたのキスした頬から生まれるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "でも、それらは時にないがしろにされてしまう。だから私たちはいつだって懸命に探すのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "私たちが埋めた小石は、地下でたくさんの山を走り抜け、川に沿って様々な場所を流れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "それは各地を渡り歩いた。最終的に、私たちは小石がどこへ行ってしまったか分からなくなっていた。つまりは、それを失ってしまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ならお二人は……小石を失って、とても悲しいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "……いいや、私たちは後悔している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "私たちは、あれを植えるべきではなかったのかもしれない。あるいは目の届くところに植えておくべきだったのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "石の一つ一つが唯一無二だ。私たちは、自分たちの石を永遠に失ってしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "でも、小石が最後にはマグマになったことは覚えているわ。とても熱くて、私たちはそれがとても好きなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "そう、私たちはとても好きなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "なら、それで十分だと思います……最後にはマグマになれて、お二人もずっと忘れないでいてくれてるんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "その小石はもう、十分幸運ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "きっと夢でしょうね。そう……夢。物語よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "頭の中にずっとあって、私たちがあなたに話してあげないといけないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "なら、もしいつか小石をまた見た時、お二人は自分の小石だと分かりますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "アデル、私のかわいい子。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "その質問の答えは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "いいえ、よ。小石はもう美しいマグマとなったの。真っ赤で、情熱的で、振り返ることなく前へと湧き出ていくのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "私たちが小石と再会することはないの。ただその背後にいるだけなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "小石は、私たちの行ったことのない場所に行き、私たちの見たことのない景色を見るんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "私たちはただその物語を覚えておいて、お前に話してあげるだけでいい。お前も自分の石を植えて、それが根を張り芽を出すのを、遠くへ行くのを見守るんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "見て、アデル。もう頂上に着いたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "小さな石ころもマグマとなって、噴火しようとしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……この物語も終わってしまうんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "そんなことはない。これは始まりにすぎないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "それは雲となって、また地面に落ちるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "もはや石ではなくて、ひとすくいの暖かくて白い火山灰に変わるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "栄養が含まれていて、土に混じると花を咲かせることのできる火山灰は、小さな石からできているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "私たちの小石は、いつの日か戻ってくるの。その時になれば、私たちはまたそれに会うことができるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "それってずっと先のことですか、それともすぐですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "もしかしたら誰にも分からないかもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "さぁ、アデル、私に掴まりなさい。私たちも雲となって、地上に戻るわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "一緒に下まで飛んでいきましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アデルはそばにいる生き物を抱きしめて、探り探り一歩踏み出した――\n彼女が地面に向かって落ちる。ゆっくりと、ふわふわと、地面に近づく様子は、落ちているというよりも舞い降りていると言う方がふさわしいだろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は自分の髪がなびくのを、それから羊たちが店の明かりの周りを軽やかに飛び跳ねているのを目にした。\nもこもこの毛が彼女を支え、包み込む。それは記憶の奥深くの子供時代、両親に支えられて高い高いをしてもらい、空の星を掴もうとした時のようだった。\nアデルはふかふかの毛の上に落ちた。星が目の中に落ちてきて、彼女の目頭が熱くなった。\n通りにたくさんの影が行き交う中、アデルは体を起こそうとした。この不思議な感覚をそばにいる二匹のもこもこに伝えたかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ふぅ……えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "次はどこへ行くんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "さっき上から見た時、遠くに大きなお店がいくつかあって、それから小さいお店もたくさん並んでました。行ってみませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "サイダーのキャップを探してきますね。そうすれば欲しいものが買えますよ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "アデルの呼吸は荒くなり始め、少し興奮していた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "さっき、あのちびめーちゃんがあっちにお花屋さんがあると言ってました。子供の頃、私の枕元にはお母さんがお花を飾ってくれてたんです。お二人はお花は好きですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "小さくて、白いお花は、お二人にとてもよく似てますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "見てください、あのちびめーちゃんみたいなお花です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "次々に声をかけるアデルに対してもこもこの生き物たちは沈黙し、返事はなかった。\n空の星が暗くなり、そしてまた明るくなり、二匹はようやく口を開いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "アデル……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "知っているわ。枕元のお花はとても良い香りで、私も大好きよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "なら、私買ってきますね。お二人にお花の冠を作ってあげます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ここで少し待っててください。お花の冠を作るのなんていつぶりだろう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アデルは残りの言葉を喉に詰まらせた。ふわふわの生き物はすでに彼女についていく歩みを止めていて、アーツユニットの枝葉が二匹の周りを舞っていることに彼女は気付いた。\n二匹は数歩下がり、その姿が夜に溶けていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "いいえ、アデル。私たちはもう行かないといけないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "雲はすでに集まったわ。もう散ることはないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "そうだ、時間が来た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……どこへ行くんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "雨が降る前に火山へ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "火山へ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "火山へ行かないで……だって二人は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "いいや、アデル、もうすぐ雨が降る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "もしも火山へ行かなければ、これまで行ってきたことが全て意味を失うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "窪地に残っていては、水没してしまうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "アデル、山頂へ行きなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "あそこに美しい風景と、そして真相があるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "厳かな生物",
      "text": "アデル、君には今の純粋さを、そしてひたむきさをずっと持っていてほしい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "アデル……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "穏やかな生物",
      "text": "さようなら、アデル。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
