{
  "server": "jp",
  "storyId": "act22side_level_act22side_05_beg",
  "groupId": "act22side",
  "stageId": "act22side_05",
  "title": "祝福の歌",
  "storyCode": "FC-5",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act22side/level_act22side_05_beg.txt",
  "sourceHash": "97a92b5cc3678cec1e21d49ba7f7073ed4c2ec10eab79c89536949ef39b79883",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "リード、そっちは固定できた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "うん、問題ない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "よいしょっと──オッケー、これが最後のテントだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "うおっ、二人ともすごい力持ちだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "そういえば、君たちそろそろ行ってしまうんだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うん。うちとチェンちゃんが調査しようとしてるのは、あのアーツに操られた「亡霊兵」なんだ。それが済んでも、まだ他にも任務があるんだべ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ここはもうトレント郡の管轄区域との境界だから、きっと駐屯軍もこれ以上おめーさんたちにちょっかい出してこないと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……ハァ、うちらがもっとしっかり治安維持できてれば、こんなにたくさんの混乱や罪なき人が傷つく事件なんて起きなかったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "え？　何言ってんだ。もし君たちがいなけりゃ、俺たちは今日まで生きていられたかどうかわかったもんじゃないぜ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ここがもし俺の家だったら、今夜は君たちにうまいニワトコ酒でもごちそうして、見送ってやりたかったんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "つっても、今俺たちの手元にある物資のほとんどは、君たちが……その「ロドス」って会社から持ってきてくれたものなんだけどな、ハハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ロドスに手紙を送れば、君たちの所に届くのか？　今後、みんなが落ち着ける場所を見つけたら報告するよ。もし君たちがその近くを通りかかったら、今度は客として来てくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "うん、わかったべ。ヴィクトリアの紛争が終わって、チェンちゃんの探してる人が見つかったらね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "……リード、おめーさんは？　これからどこへ行くの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "私は……みんなが落ち着けたら、自分のすべきことをやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "スカハンナ原野を離れて、罪から逃れて、鎮火の鐘がなくなったとしても……ターラー人は沼に囚われたままで、なかなか前へは進めないと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "だから私は、みんなのために何かしてあげたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "私はターラー語もヴィクトリア語も話せるから、今後都市で色んな人に出会っても、誰とでも交渉ができる……他の人がやるよりずっと楽にね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "そっかぁ、きっとみんな喜んでくれるべ。あ、そうだ、今日おめーさんがロドスのセーフハウスに行った時、誰かにつけられたりしなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……つけられてないと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "大丈夫、キミの忠告は覚えてるから。もしあの兵士たちの目当てが私自身だとしても……恐れはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "それと……ずっと親切にしてくれてありがとう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "リードさんに頼めば、テントを一つ売ってもらえるだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "あれは都市の工場で作られた帆布で、いくら大雨にさらされても水漏れしないし、リヤカーを改造するのにもってこいなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "彼女は優しい方ですし、あなたもとんでもない値段で買い叩こうとは思っていないのでしょう？　きっと譲ってもらえますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ハハッ、冗談だよ。あんなにいいものを買うお金なんてないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "でも誰が想像できただろうか。数日前まではどうやって命を繋いでいこうかと悩んでいた私たちが、今は工場で作られた丈夫なテントで寝て、夜には火も起こせるだなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "ええ、彼女たちはとてもすごい人です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "鉱石病のこともよく理解してるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "（口笛）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "（途切れ途切れの口笛）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "渓谷を覆う霧……♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……離れゆく彼女の姿を覆い隠す……♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "やっぱりきれいな歌声だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "……私に好意を寄せてくださった人の中で、今でも私のことを覚えているのはあなただけでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そんなこと言わないで……みんなきっと覚えてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "鉱石病になったのは君のせいじゃないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "（少し音程がずれた口笛）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ハァ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "あの青年──セルモンのお兄さんは死んでしまった。あの時私たちが助けた難民たちも、ダブリンに加わった後、みんな死んでしまったのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "あの時の苦労はすべて水の泡になってしまったかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "でもよかった……少なくとも君がまだ生きていて。あれだけ長い間行方がわからなかったのに、君はまだ生きているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "リードさんが君に薬を渡していたのを見たよ。鉱石病は本当は治療できるのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "いえ、彼女たちも治らないと言っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "ですが、どうかダブリンの兵士たちを恨まないでください。当時彼らを工場の輸送車に隠れさせた時、うっかり傷口に源石粗鉱の欠片が付着してしまったのは……彼らのせいではありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "いや、恨んでなんかない、私はただやりきれないだけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "君たちはダブリンを信じているけど、私は信じられない。ダブリンは私たちより強く、武器だって持っている。でも私たちは、彼らの悲惨な最期だって目にしただろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ダブリンはターラー人に親切だし、ターラー人に代わってうっぷんを晴らしてくれる。でもその後は？　私には明るい未来なんて想像できない……脳裏に浮かぶのは、あの日荷台で見た血だけなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "セルモンは今でもダブリンを探し出し、ヴィクトリア人と戦いたいと思っているようだし、私では彼女を止めることはできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "はぁ……あの日、彼女はリードさんと話し込んでいたけど、リードさんは止めてくれなかったのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "でも私は、セルモンがそうするのも悪いことではないと思います。彼女なら、ターラー人のためにたくさんのことができますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "私が感染してからまもなく、感染者地区の全員が一斉に町を追い出されたという話を……覚えていますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "あの話には続きがあるんです。あの後、追い出された町民の中でも体格のいい人たちが、他の人の物資を奪い、力の弱い老人や子供、それに私のような虚弱な病人を置き去りにしていったんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……そんな辛いこと、もっと早く言ってくれてもよかったのに。話せばちょっとは気が楽になるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "実は忘れかけていたんです。なぜ誰も抵抗せず、誰も他の人たちを守らなかったのか、今ではすっかり思い出せません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "以前の私は、生きるとはそういうものだとずっと思っていました。手の上にあるのが何であろうと、お腹が空けば、目を閉じてそれを飲み込むしかないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "リーシュも、クローダも、鉱坑の底で命を落としました。あなたの家族で、採掘場の仕事に文句を言ったことがある人はいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "うーん……どうかな。誰かを恨んだことはないかもしれない。でも少なくとも二人の姉さんが亡くなった時、私は悲しかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "その辛さを誰かにぶちまけたかったけど、でも暗く息苦しい鉱坑の底では、誰も私の話など聞きはしない。外で雑貨を売っていた時も結局どの家にも悩みはあって、他人の話を聞く余裕などなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "でも、そうだな……今話してみても遅くはないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "はい、遅くはありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "そろそろ一日分の薪は拾えたはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "（口笛）……それじゃ行こうか。太陽も沈んだことだし、道が見えなくなってしまう前にね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "おい、鍋がグツグツいってるぞ、もう食べてもいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "落ち着けこのバカ！　アンタ家で飯作ったことねぇのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "テントに入って待ってろ、肉が煮えたら持ってってやるからよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "彼女、随分と気が晴れたようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "ええ……でもきっとまだ心は痛んでいるはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だが少なくとも、ダブリンへの加入を諦めさせたのは正しい選択だと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……知っていたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ。キミがいれば、彼らも道を踏み外すことはないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……キミが――一人のドラコが、彼らと共にいつまでも歩んでいくのは難しいだろうがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私の目をごまかせはしない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "馬鹿言わないで、ファーガル。去年の劇であなたがゲル王の戦士を演じた時、重傷を負って三回倒れて三回起き上がるお芝居をして、腕と足が青あざになっちゃったのを忘れたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "だったら今年はその戦士を無敵の役にしようぜ。毎年毎年ゲル王が負けて、ガストレルが王城の下で死ぬシーンばかり演じてるんだ。衣装を工夫する以外に、目新しいものなんてないじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "お、セルモン、こっち来て座れよ。お前さ、今年はゲル王の手下の第一大将軍を演じてみろよ。ちょい若すぎるかも知れんが、気迫に関しちゃ、誰もお前に勝てないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "はぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "あなた、セルモンが持ってきたお鍋をたくさん食べたくて、そんな調子のいいことを言ってるんでしょ。本人がやりたがってないじゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "ていうか、アンタたち何の話をしてるんだ？　第一大将軍とか言われてもピンとこねぇんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ほら、夏の定番のあの劇よ。今配役を話し合っていたところなの。あれ？　あなたの住んでた場所ではやらないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "うーん……劇の最後に、河の神とか名乗る奴が立ち上がって見物人に水をかけるあのイベントのことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "……それなら見たことあるぜ。でも興味ねぇな、アタシに河の神を演じさせてくれるならやってもいいけどよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "あれは河の神が亡くなった戦士を悼んでいるのよ。でもあの役は、他の役よりもセリフを覚えるのが大変なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "でも家が完成する前に、今年の夏は終わっちゃうかもね。そしたらあなたも来年に備えて稽古ができるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "……ああ、かもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "心ここにあらずね……まだダブリンを探す気でいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "当たり前だろ。アタシがアンタらみてぇに、諦めのいい奴に見えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "これは、あの日リードと話した上でたどり着いた結論なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "ダブリンの理想は実現可能だし、誰かが実現しなきゃならねぇ……アタシはやっぱりそう思ってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……何が目的？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いいや、何も。私はキミの行動を見てきたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私はこの目で見て下した判断を信じているし、ロドスの判断も信じている。キミが何者であってもそれは変わらないさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "しかし今、多くのヴィクトリア人がその存在を認識している生きたドラコはただ一人。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……ダブリンの赤き龍、ターラー君主の末裔。あのドラコ一人だけでも公爵たちにやましい考えを抱かせ、貴族たちを怯えさせるには十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キミはきっとその出自に困惑しているのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "じゃあ……彼女も私の正体を知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "バグパイプか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ見えて彼女は実に聡明で注意深いが、闇雲にネガティブな想像を巡らせるようなことはしない。自身が認める友人のこととなればなおさらだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だがこのまま共に進めば、彼女もいずれは様々な事実に直面せざるを得なくなる。もちろんキミもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……私に早くここを去るよう忠告しているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どうかな。キミが過去にやったことは消えはしない。もちろん、その責任から逃れることもできないのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "だが私は……一部の人にしてみれば、キミがドラコであるかどうかは大して重要ではないと思う。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "しわがれた歌声",
      "text": "細い渓流が、青々とした野原の間を流れる♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "しわがれた歌声",
      "text": "今はもういない人のため、私たちはグラスを掲げる♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "歌声が聴こえる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……きっとファーガルね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ターラー語か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "ええ、夏の野原とお酒の歌みたい。初めて聴いたけど……とても良い歌ね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "羽を広げて目を覚ませ、水辺の羽獣よ♪\n私たちが集った報せを、波に乗せて届けておくれ♪"
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……とても楽しそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "テントと火があるというだけで、彼らはあんなにも幸せそう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なら家や田畑を持った時には、きっとさらに喜ぶだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "私たちも中に入ろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "遅いよ二人とも！　ほれ、オランさんの演奏を見てみなよ。草の茎さえあれば笛にして吹けるんだって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "（鋭い笛の音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ハハッ、あんまうまく吹けないな。うちの親父が得意だったんだ。俺はただ、親父から軽く教えてもらっただけでさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "フン──フフーン──♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あっ、うちが一緒に歌っても別に嫌じゃないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "もちろんさ、これは俺たちの祝杯の歌なんだ。俺が嫌なのは酒瓶に酒が入ってないことだけさ、ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "どんな歌詞なの？　ヴィクトリア語で歌ってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "うーん……じゃあまずは聴いててくれ。他の奴に歌ってもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ヴェン、お前が歌えよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ハァ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「この地には常に涙が実り、私たちは昔日の露と火を飲む──」"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "曲がりくねった小道には、バラとカンパニュラが咲きこぼれ♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "音程がずれてるじゃねぇか！　この音痴が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "うるせぇ！　アンタだって同じようなもんだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "（耳障りな笛の音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ううっ……お願いだから酷い音を出さないでくれよ。そんな喧嘩のやり方がどこにあるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "おい、石を投げ合うのもやめろ！　本当に当たったらどうする！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "わぁ、美味しそうなパンの匂いだべ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幼い流民",
      "text": "半分あげる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ありがとう！　ほら、チェンちゃん見てこのパン。一口でいいから食べてみて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "とってもいい香りだべ？　うーん、これ何の草を香料に使ってるんだろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "香りか……私にはよくわからん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "あれぇ？　チェンちゃん、炎国に長い間帰ってたせいで、味覚が鈍くなったとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どうだろうな？　龍門人は夏にお茶を飲む際、二十四種類の生薬を煎じるんだ。それを感じるくらいの味覚はあるはずだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "ホントに？　……また冗談言ってるんだべ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いいや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……楽しんでるか、リード？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "彼らの生活は本来こうあるはずだった。もちろん、これからもっと良くなっていくだろう──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キミが彼らに生活を取り戻してあげたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "リード、君はターラー語がしゃべれるんだろう？　もったいぶってないで、歌ってくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "（遊び心のある笛の音）さぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "特殊行動隊兵士",
      "text": "ぬかるみに残った轍は目立つ。迂回すべきか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "その必要はありません、直接目標地点へと向かいましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ほら、君もだ、モラン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バグパイプ",
      "text": "モランさん、なんでそんな離れた所に座ってるの？　リードが何度も大丈夫って言ってたべ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そうさ、「カマイ谷の吟遊詩人」さん……歌ってくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "text": "渓谷を覆う霧……離れゆく彼女の姿を覆い隠す……♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "あれっ……この歌声、何年も前に聴いたことがあるような？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そりゃそうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "そうだ、あの時俺は妹の手を引いてた。あいつの病もまだ歩けないほどじゃなかったからな。俺たちは石橋に立って、しばらくその歌を聴いていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ハァ……カマイ川は遠くまで流れている。故郷に帰れなくたって、他にも同じような橋がきっとあるはずだよな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "まずは民間人を制圧します。ですが誰も傷つけてはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "調査対象は、非常に優秀な軍人としての素養を有しています。正面からの交戦はできるだけ避けてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "セルモン、見ろよ、俺のこの構え。どうだ？　お前を真似てみたんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "どうって言われてもな。アンタが相手にするんのはこれからも羽獣くらいのもんだろ？　そんなもん学んでどうするんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "誰とも言葉を交わす必要はありません、一言たりともです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "その後のことは私にお任せください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "忘れるなよ、私たちは夜が明ける前に出発するんだからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "矢をつがえて、発煙弾の準備を。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ハァ……ちょっと外の空気を吸いに行ってくるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ん？　こんな時間に、霧が……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "君たちは……\nい、\nいつの間に……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィッシャー",
      "text": "ごきげんよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
