{
  "server": "jp",
  "storyId": "act21side_level_act21side_06_end",
  "groupId": "act21side",
  "stageId": "act21side_06",
  "title": "迫りくる過去",
  "storyCode": "IS-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act21side/level_act21side_06_end.txt",
  "sourceHash": "39fb456d5f7319e6daa5d879f8ec6f1334d3698dc842b679ef96eab1970a4406",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "撤退しろ！　こいつ、やり手だ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "無理に相手する必要はねえ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "ドンがいるボックス席への通路と階段を守れ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "ふふっ、ロッサティの人もなかなかやるね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "強行突破は無理そうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "うーん……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "アッハハ！　テキサスったら、ウッドベースの中にスピーカーを仕込んでる！"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "結構弾いてるフリが上手だね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "アハッ、みーつけた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "正面から抜けられないなら……抜け道を作るだけだよね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "慌てるな！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "この場を守れ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "チッ……こいつら、死ぬのが怖くねえのか！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "ぐっ……あ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "ほかの連中の状況は？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "ジョヴァンナのボックス席への通路と階段は、どこも固められています。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "向こうの備えは万全のようですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "さすがはロッサティってところか……"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "まあ、俺たちは最初からジョヴァンナを見くびってなんかいない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "このまま人員を投入し続けろ。彼女をここから生きて出すわけにはいかないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "確かにジョヴァンナさんを見くびっちゃいないかもしれねえが――俺のことはちょっとナメすぎじゃねえか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "なっ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "ウォラック……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ハッ、こんな愉快なショーになるって知ってたら、悠長にドンの酒を取りになんか行かなかったんだがな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "ドン・ジョヴァンナはいける口か？　それなら良いワインがあるんだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "いいや、結構。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ドンはシラクーザの物なら大概お気に召すんだが、酒だけはどうも口に合わなくてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ここの酒はお前らが武器を振るう力みてえに弱っちいから刺激が足りねえんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "そりゃあ、あんたらがシラクーザの本物の美酒を飲んでないからだろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "だったらこいつは良い機会だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "俺がこの時をどれだけ待ち望んできたか……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ベッローネとサルッツォ――シラクーザの美酒ってやつを味わわせてもらおうか。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "この階段は通さねえぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "そいつを止めろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "フフッ、通してなんて誰も言ってないよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "なっ――爆薬！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "下がれ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "うわあっ！？　なんや向こうの席が崩れてくるで！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "あれは――ラップランド！？"
    },
    {
      "type": "dialogue",
      "speakerName": "怖がる観客",
      "speakerId": null,
      "text": "きゃっ、あれを見て！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "う、ぐっ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怖がる観客",
      "speakerId": null,
      "text": "ま、まさかファミリー同士の抗争……！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "どけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "こ、こいつ……！　楽器の中に武器を隠してやがったのか！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "テキサスさん！"
    },
    {
      "type": "narration",
      "text": "テキサスは黙ってソラを一瞥し、何やら口を動かすと、上の階へと駆け上がっていく。\nその口の形で、彼女にはテキサスの言ったことが伝わった。\n「待っていろ」と、そう言ったのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "取り乱す観客",
      "speakerId": null,
      "text": "ひぃっ――は、早く逃げないと！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "どないする！？　ほっとくとソラが危ないで！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "だけど――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怖がる観客",
      "speakerId": null,
      "text": "た、助けて……！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "――！　伏せて！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "ワ～オ、おじいちゃんやっるう！"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "おや、「おじいちゃん」なんて歳に見えたかね？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "んー……そこまでじゃなかったかも？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "しかし、この状況を見るに、今日の演目は『テキサスの死』ではなく『ロッサティの死』のようだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "君たちもすぐに避難しなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "……そうしたいのは山々なんだけど、まだ舞台の上に友達がいるんだよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "せやけど舞台周りは大混乱やで！　まっすぐ突っ込むのは無茶や！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "じゃあ舞台裏から行こう！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "了解！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "あーもう、邪魔邪魔！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "えっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "往け、勇敢な若者よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "ありがとう、おじいちゃん！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": null,
      "text": "お礼にあとでピッツァを奢るからね！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "おおきにな！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "はっは……若人というのは、つくづく元気がいいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "さて――君はどう出るのかな、ジョヴァンナ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "通用口はすべて我々が確保しました。今のうちにお逃げください。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "あら、どうして？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "こんな素敵なショーを観られる場所なんてなかなかないわよ。せっかくなら思いっきり楽しんでおかないと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "――ソラ……あなた、本当に彼女の友達だったのね……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "にしても、チェリーニアはあそこから上がってくるつもりかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "近道があろうと、ここまで来るのはそう簡単なことじゃないわよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "しかし――"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "ここで逃げたら、ベッローネとサルッツォが見逃してくれるとでも思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "これは戦争なのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "両家はミズ・シチリアのルールを無視して、ほかのファミリーとの全面戦争を選択したの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "皆に伝えなさい。私たちにできるのは――彼らと最後まで戦い抜くことだけだ、とね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "わかりました。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "……うっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "シラクーザの美酒も大したことねえな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "調子に乗るなよ、クルビアのクズが……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "ッ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ああ、わかってるさ。お前らシラクーザ人からすりゃ、俺たちみたいなクルビアのマフィアは、何の積み重ねもない新参の成金だってことくらいな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "確かに、クルビアにそういうバカが山ほどいるのは事実だが……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "だったらそっちはどうなんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "いわゆる「銃と秩序」の下にいるお前らに、まだ気概だの気骨だのは残ってんのかって聞いてんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "シラクーザを見くびったことはねえが――"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "こうしてみると、少なくともお前らには見どころなんざ一つもねえみたいだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "ウォラック！　劇場で何か起きてるみたいだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "誰かが観覧席を爆破して――チェリーニアがその瓦礫を踏んでまっすぐ三階へ向かってる！"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "五秒やろう。最後に言い残すことがあれば言え。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "ハハッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "あるわけないだろ、そんなもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "本当にそんな時間があるなら、俺の代わりにレオンに謝っといてくれよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "いいだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "なっ――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "っ、レオン！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": null,
      "text": "お前……"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "ディーマ……俺は自分のやり方で大局を見て行動する。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "俺たちは仲良くやれると思ってたんだがな、レオン。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "今からでも遅くないと思うが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "いやはや、でかいファミリーのお生まれは言うことが違うな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "いつも上からものを言っといて、こういう時はまだやり直せるなんてぬかすんだからよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "――事ここに至った以上……"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "賭けをしないか、ウォラック。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "賭けだあ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ッハハハハ！　我らがレオントゥッツォさんよ、ここはパーティー会場でもオフィスでもねえんだぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "ここは戦場だ。あるのは生きるか死ぬかだけさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": null,
      "text": "俺を信じろ。お前もこの賭けは気に入るはずだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "チッ……ロッサティの連中はつくづく厄介だな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "……ラヴィニア裁判官？　あんたが来るなんて聞いてねえんだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "そもそも、これはあんたが首突っ込んでいいような話じゃないぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "……あなたたちの邪魔はしないわ。もうそんな気にもならないし。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "私、人を探してるの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "この状況でか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "劇場の中はめちゃくちゃだし、ここには多分いないと思うが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "自分で探すから、そっちは私の邪魔さえしなければそれでいいわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "そう言われても……"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "私がここで死んだとしても、ベッローネとは無関係だと考えてちょうだい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "speakerId": null,
      "text": "……わかったよ、好きにしてくれ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "！　見つけた……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "止まれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "speakerId": null,
      "text": "俺はここのスタッフなんだが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロッサティの構成員",
      "speakerId": null,
      "text": "バカ言うな、ここの連中ならとっくに俺たちが追い出したあとだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "っ、どうして彼がこんな場所に……！"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "speakerId": null,
      "text": "危ない、ダン――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "飛び散った血の数滴が、ラヴィニアの顔を濡らした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "speakerId": null,
      "text": "――ラヴィニアさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "speakerId": null,
      "text": "……どうしてここにいるんだ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "narration",
      "text": "ラップランドが開いた「道」は実に有効な方法であり、テキサスは旧友との再会まであと少しのところへ来ていた。\n彼女は小さく息を吐く。\n混乱した状況の中でも、テキサスには自分のやりたいことがわかっていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "やっぱり来たな、チェリーニア。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "良い目をしてやがる……まるで自分が獲物になった気分だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "――お手並み拝見といこうか、最後のテキサス！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "これは……監督殿、この混乱も……演出の一部なんでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "混乱、か。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "私からすればすべて順調に見えるがね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "クライマックスはここからだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "……なるほど。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "さすがはウォルシーニでも指折りの劇団です。これほど斬新な演目を観たのは初めてですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "だが、今しばらくは幕間だ。この間に聞くとしようか。――君は私に何を望んでいるのだね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "私の望みは……簡単なものです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "カラチの死後、建設部長の座は空席になったまま……"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "あなたも後任を見つけたいとお思いなのではないでしょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "自分こそがその任に相応しいと言いたいのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "speakerId": null,
      "text": "私以上の適任者はおりませんよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "げほ、ごほっ……ぐっ、ごほっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "こんな時まで……情けを、かけてくるとはな……大したもんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "お前はかかってこねえのか、サルッツォのイカレ女……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "最初から全力を出す気のない人と無駄にやり合う気はないからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "……フッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": null,
      "text": "ねえ、キミは何を待っていて、何に期待してるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": null,
      "text": "賭けをしてるんだが、それに負けたくてな。"
    },
    {
      "type": "narration",
      "text": "ウォラックはテキサスが去っていった方向を見た。彼女がジョヴァンナを殺すのを止められる者はもはや――\nジョヴァンナ自身を除けば、誰もいない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "部屋はもぬけの殻に見えた。\nテキサスは何が起きたかを即座に理解したものの、時すでに遅く、一本のナイフがその首に当てられていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "シラクーザに来て以来、誰がどんなふうに殺しにくるか、いろいろなケースを想定してきたけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "あなたが来るなんて考えてもみなかったわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "それに、あなたがこんな時に気を抜くとも思わなかったしね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "まさか、顔を合わせた私が「ああよかった、無事だったのね」なんて言いつつあなたを抱きしめて……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "座って一杯飲みながら、ここ数年のことを語らう時間を取ると思ってたのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "――私はお前を殺しに来た。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "そう。何よりだわ。"
    },
    {
      "type": "narration",
      "text": "口にした言葉と裏腹に、彼女はナイフを下ろした。\n先ほどまで見せていた殺意がほんの冗談だったかのように、その顔には笑みが、そして懐かしさが満ちている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョヴァンナ",
      "speakerId": null,
      "text": "久しぶりね、チェリーニア。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerId": null,
      "text": "久しぶりだな、ジョヴァンナ。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
