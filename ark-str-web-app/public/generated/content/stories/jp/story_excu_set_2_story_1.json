{
  "server": "jp",
  "storyId": "story_excu_set_2_story_1",
  "groupId": "story_excu_set_2",
  "stageId": null,
  "title": "敵",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_excu_2_1.txt",
  "sourceHash": "2264059c7d1517813800a31c88c6310263a0d9a8aa7b9edf335682624c1a55c3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "フェデリコ……おいフェデリコ！　ちょっと待て、待てって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "執行人見習いロベルト、何か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "水臭いなぁ。俺たちはまったく同じ日に公証人役場に入職したんだから、ダチになるのが運命ってやつだろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "まあいいや。今日の仕事終わりにラニエリのスイーツ店でプリンを食べる約束をしてるんだ。フェデリコも一緒に行こうぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それはあなたと執行人見習いラニエリとの約束です。私がそこに加わる合理的な理由がありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それともう一点、私の肩に置いた手を下ろしてください。不必要な身体的接触は任務の効率に影響を及ぼします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "任務って言うと……さっき行ってきたステファン区中央病院の調査のことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ええ、現時点で与えられている任務はそれだけですので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "でも医者によると、異常が見られた人は何かしらの病気を患った可能性が高いって話だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "確かに共感がおかしくなった患者さんたちは気の毒だけど、医者でもない執行者の俺たちにできることはないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "病院側の記録によると、共感の失調をもたらす疾病は、過去にはわずか七例のみの極めて珍しい症例のようでした。しかしここ三日間で、各区の病院にて同症状を訴えた患者は十五例にも上ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "このように異常な増加傾向は軽視できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "つまり、ただの病気じゃないかもって言いたいのか？　じゃあ他に何があんだ？　ははっ、まさかどっかの暇な変人野郎が、他の誰かの感情を無理矢理頭にぶち込んだってんじゃないだろうな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それも一つの可能性です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "……冗談だろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "踏み込んだ推察をする前に、さらなる調査が必要です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "はぁ、今日のアフターファイブはお前にゃ無縁ってことだな。あとでマフィンを持って行ってやるよ。好きな味は……って、もういないのかよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……おおよその事情は以上になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "名高い精神外科医の視点から、より専門的なご意見をいただけますと幸いです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "サンクタ同士の共感に対し、人為的に干渉する方法というものは存在するのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "共感に干渉などっ……ゲホゲホッ！　フェディ、バカげたことを言うもんじゃない。共感はサンクタにのみ与えられた奇跡だ。それを易々と拡大できる者などいるものか。そんなことはあり得ないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……あり得ない、ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "分かりました。ご意見ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "いつも通り食料を持って来ました。冷蔵庫に入れておきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……冷蔵庫が満杯ですね。消費期限が過ぎているものは、帰り際にすべて処理しておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "それは助かるが、そう頻繁に私のところに来なくたっていいんだ。君も仕事で忙しいだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "カーテンが開いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "……は？　カーテン？　ああ……ゲホゲホッ、今朝に部屋を出たときに開けたんだ。それがどうかしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "おじさん、学校が長期休暇に入ったので、今回は七日間家に滞在する予定です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "今日の午後はリビングを掃除します。学校で硬い物を手早く粉々にする手法を学んだため、大掃除には役立つはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "騒音に備えて、おじさんは部屋の中で待っていてください。貴重品は安全なところに移動させるので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "チェロです。アルトリア姉さんがずっと窓辺に置いていたはずなのですが、カーテンが閉じられていて、チェロも見当たりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "姉さんは、出て行ったのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "……私が追い出した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "リターニアに行かせたんだ。どうせあいつの「素質」を評価してくれる教師ならごまんといるだろうからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "くくっ……そう、「素質」だ！　まさにあの素晴らしい「素質」が君のおばを、我が最愛の人を殺したのさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "まだ姉さんのことを受け入れられないのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "受け入れられるわけがない。あいつを目にするたび、あのチェロの音色を聞くたびに……最愛の人を失った苦しみが蘇ってくるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そしてその苦痛は今や、おじさんの健康にまで害を及ぼしている……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "フェディ、私がどれだけ君を羨んでいるか分かるか？　君は離れ離れになってしまった人たちを……たとえば君の両親やおばを、恋しく思うことはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "彼らと過ごした日々ならば、細部に至るまで記憶していますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "では、気が狂わんばかりに彼らが恋しくなり、もっと時間をともにすべきだったと後悔することは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "一つひとつの選択がその時点における最善のものであったのなら、何も悔やむことはない――母さんからはそう教わっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "……羨ましいと言ったのはそういうところだよ。あいつの音色は君には響かない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "ははっ、それだけじゃない。君の共感能力の欠乏や、感情に溺れず後悔もしないことがどれだけ羨ましいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "つまり、おじさんは後悔しているのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それは、リターニア人が音楽の素質とアーツの素質を結び付け、姉さんのアーツをさらに強化するであろうことをよく理解しているからでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "――あの葬儀では、姉さんはチェロの音色によって、参列者全員におばさんとの思い出を想起させ、心の内に秘めていた感情を爆発させました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "幸い、ほどなくして落ち着きを取り戻した参列者は、特に問題なく日常へと戻っていきました。姉さんのチェロが参列者に残した傷跡は、あの場で取り乱した気まずい記憶のみに留まっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ですが次も同じとは限りません。姉さんが再びラテラーノに戻ったとき、あの特殊な「素質」がさらに大きな混乱をもたらす可能性があるのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "さらに大きな混乱。\nそれはごく低確率の、本来起こり得ない事象。\nフェデリコはカーテンの開かれた窓を見やった。当然ながら、窓辺にチェロの姿はない。\nこの四年間、外がどれだけ晴れ晴れとしていようとも、マルチェッロおじさんがカーテンを開けることは決してなかった。\n彼はかつてチェロが置かれていた窓際に近づいただけで、耐えがたい苦しみに苛まれている様子だったのだ。フェデリコの記憶に間違いなどあろうはずもない。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "先ほど事のあらましを述べた際に、それが「共感の拡大」によるものと関連付けられる要素はなかったはずですが、あなたは「共感を拡大できる者はいない」と断定的に否定されましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "ッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "以降の質問には答えなくても構いません。しかし黙秘された場合、それがあなたの回答であると判断させていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "マルチェッロおじさん、ここ最近、アルトリアが家に戻ってきたのではないですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病院の看護師",
      "text": "修道士さん、検査結果が出ましたよ。交感神経はまだ少々興奮状態ですが、身体的にはもう問題ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病院の看護師",
      "text": "でも、やっぱりまだ話したくない感じですかね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "病院の看護師",
      "text": "あの二人が……いえ、若い執行人が一人、また来たようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病院の看護師",
      "text": "ずっと面会を申請されてたんですけど、あの人の言葉はかなり……直球と言いますか。先生も、あんな風に話されてあなたの情緒がまた不安定になっては大変だと心配してるんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "病院の看護師",
      "text": "あれ、これは……メモ？　ドアの隙間からメモを入れてきたみたいです。何か書かれていますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病院の看護師",
      "text": "えーっと……「アルトリア」？　どういう意味かしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "……ああっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "病院の看護師",
      "text": "どっ、どうされました！？　先生を呼びましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "い、いえ……その人と話をさせてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "失礼します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "……あなたのことを、何一つ感じ取れませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "共感で私の接近を感じ取れなかったという意味であれば、それは私の問題です。あなたの共感に問題が生じたわけではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "あなたは自ら共感を拒んでいるのですか？　それとも生まれつきのものでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "専門家は生理的なものと判断しているようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "なんと哀れな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "ご自身が一体何を失っているのか……きっとよく分かっていないのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "お心遣いに感謝します。ですが私は、自分が正常に職務を遂行する能力を十分に備えていると判断しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "単刀直入にお聞きしますが――最近、アルトリア・ジアロと接触したことはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "……ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "最近お会いしました。それだけでなく……聴いたんです、彼女の演奏を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "これは推測ですが、その演奏はあなたが仕えている教会で行われたのではありませんか？　そして、その日教会に来られた方全員が、彼女の演奏を耳にしたのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "ええ。本来であれば、あれは私の受け持つ説教の場でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "以前からアルトリアとはお知り合いだったのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "……いえ。あれが初対面です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "彼女は最前列の端に座っていて、説教を聞き終えたあと、問いを投げかけてきたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "問い、とは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "彼女はこう言いました……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "さっきあなたは、目を閉じて、周りに座っている同胞たちの感情を感じるように言ったわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私も言われた通りにやってみたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そうしたら……まるでラテラーノで過ごした一瞬一瞬が蘇ってくるかのように、喜びと安らぎに浸ることができた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "けれど修道士さん、私はふとこう思ってしまったの。五年前のあの日はどうだったのか、って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "戦乱に追われ、流浪を強いられた人たちが、荒野を越えてラテラーノへとたどり着いたのに……あなたに拒絶された。その時の彼らの心に突き刺さるような苦痛を、あなたは感じたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "何を……おっしゃっているのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "どうやら記憶が薄れてしまっているようね。それなら、私が思い出させてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "彼らの中には老人も子供も、フェリーンもリーベリもいた。さらには……ほかの場所で生まれたサンクタたちまでいたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "彼らは、とあるお人よしの言葉に導かれ、ラテラーノなら自分たちに救いの手を差し伸べてくれると信じ、はるばるここまでやって来たのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "けれど、その哀れな人たちの希望は虚しく散ってしまった。ほどなくして、彼らのほとんどが砂嵐の中で死んでいったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "……彼らに代わって、私に復讐するおつもりですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "私が鉱石病に恐れを抱くあまり、受難者と苦しみを分かち合うことができなかったから……私の前に現れ、私の心を暴き、罪悪感で満たそうと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "いいえ、修道士さん。あなたに復讐する資格なんて私にはないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "それに、あなたの心の奥底にある感情と、その行いに矛盾がなかったのなら……あなたを批判することもしないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "けれどあなたは優しい人のはずよ。だから知りたいの。あなたがあの哀れな人たちを拒んだのは、共感に慣れすぎたせいで、他者の感情を真に心で感じられなくなったからではないのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなただけじゃなく……この場に集った皆もよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アルトリアは立ち上がり、人だかりの中へ入っていった。\n彼女は一人ひとりのサンクタの前で立ち止まり、まるで最も仲の良い友人であるかのように彼らの想いを感じ取っていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたは今朝、通りの花壇を吹き飛ばしたわね？　けれど、同じ街で暮らすほかの人たちが、幼い頃の思い出を奪われる無念さを……あなたは感じ取れていたかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "それからあなた。昨日急いで帰宅するために、我先にと車両に乗り込んだわね。その時に押し出されたお婆さんの、病院の時間に遅れてしまうという焦りは感じ取れたかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "責めているわけじゃないわ。私もあなたたちと同じだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私たちは決して、生まれながらにして利己的で、臆病で、不誠実な人間というわけではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ただサンクタの光輪のもとに、「共感」を互いを思いやる前提条件や一つの在り方として定め、それで満足しているだけ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "けれど私たちは本当に、自身の感情を受け入れるのと同じように、他者の感情を受け入れることはできるのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それで、あなたはその問いに答えたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "いえ、答えられませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "彼女はこの問いを、その場にいた全員に投げかけました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "それから、「もっと多くのものを感じたいと思わないか」とも訊きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "そうやって彼女は教会の中央に歩み出ると、チェロを構えて……聖歌のメロディーを演奏し始めたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "彼女に場を支配するような意図はなさそうでしたが、私たちはすっかりあの音色に引き込まれてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "これまでに何度も聴いたはずの聖歌でしたが、あの時ばかりは、まるで初めて聴くような感覚を覚えたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "そして、ラテラーノの街全体が……私の脳裏に蘇ってきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたは今、微笑みながら涙を流していますが、それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "ええ。今でも、あの生き生きとした感情を鮮明に感じ取ることができるものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "悲しみに涙を流す方がいれば、喜びに笑顔をこぼす方もいて、生まれてくる方も、亡くなっていく方もいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "お医者様は、この症状を「共感失調」と称し、私が見た記憶はただの錯乱による幻覚だと診断されました。それから、鎮静剤を服用するようにと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "ですがあれは私にしか……いえ、あの聖歌を聴いた者たちにしかわかり得ない感覚なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "私たちはこれまで一度たりともあのように互いを、ラテラーノを、命の誕生から成長、そして朽ち果てる過程を「感じた」ことなどありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "そうして、豊かな感情の波に揉まれているうちに、当時の行いに対する羞恥と後悔も洗い流されて……消えていったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "沈黙する修道士",
      "text": "最後に、彼らの苦しみは私の苦しみとなることをはっきりと理解しました。今や私自身のものとなったその記憶は、次に決断を下すべき瞬間が訪れるまで、しかと背負い続けていくつもりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ご協力に感謝いたします。前述の証言は、後ほど中庭公証人役場に報告させていただきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "フェデリコ、今どこにいるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ロベルト、業務上のパートナーであるあなたには、私のこれからの行動計画を事前に共有しておきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "現在、私は「共感拡大」事件の容疑者アルトリア・ジアロを追っています。そして、彼女はいま私の目の前にある墓地にいる可能性が極めて高い、といった状況です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "座標はお送りしましたので、私の行動に合わせて動けるよう備えておいてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "アルトリア……ジアロ？　それってお前の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……遠い親戚です。ですがそのことが私の判断に影響を及ぼすことはありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "姉さん、また一人でここにいたんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "おじさんもずっと部屋に引きこもったままで、姉さんとはもう随分と長い間会話すらしていませんよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "どうしておじさんに、それを悲しんでいると伝えないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "無駄だからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "フェディ、パパがママに向けた愛は、ママの本当の気持ちを蔑ろにするものだったの。パパはママをずっと側に置いておきたいと思っていたようだけれど、ママはそうやって縛られたくなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "私はそれをパパに気付いてもらいたかっただけなのに、パパは私を拒んだのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "私に憎しみを向ける方が、ママが自分の意志で去っていったことを認めるよりもずっと楽だったんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "だとしても、葬儀であんな大きな混乱を引き起こすべきではなかったと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "みんな姉さんの演奏で心に傷を負ったんです。私もおじさんと同じ意見で、そんなことは間違っていると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち着いた声",
      "text": "フェディ、あなたもパパやほかの参列者みたいに、私のことを恐れているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……姉さんのことは怖くありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ただ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サンクタの少女は黙ったまま、墓標の前に立ち尽くしていた。\n繰り返し奏でられる彼女のチェロは、フェデリコでは感じ取れない感情で満たされている。\nフェデリコは近くの草地に座り、図形を描いて感情の分析を試みながら、時折顔を上げては固く閉ざされた窓と、震える弦と、言葉を発さない墓標を見やることしかできなかった。\n風に漂う音色が徐々に狂い出していることは、彼の耳ですら判別できた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたを止めます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "これ以上自分勝手な演奏はさせません――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "――アルトリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "久しぶりね、フェディ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたもママに会いに来てくれたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私の目的は分かっているはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "小さい頃から変わらないのね。いつも真っすぐで……雰囲気をぶち壊すのが大得意。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "三日前、あなたはステファン区の教会に集まった三十一名ものサンクタにアーツを使用し、彼らの共感を失調させました。これは重大な規律違反に及ぶ行為です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "中庭公証人役場の執行人として、あなたを逮捕します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……ねえ知ってる？　あなたがまだ小さい頃から、私はあなたがいずれとても優秀な執行人になるって信じてたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "だけど……そうね、まさか自分があなたの最初の任務対象になるなんて思ってもみなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フェデリコ・ジアロとアルトリア・ジアロが生まれついての宿敵だなんて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "改めて考えてみたら、なかなか面白いと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私は何の面白みも感じません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたの行為はラテラーノの安寧を脅かしています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フェディ、どうして私はあの教会に行ったと思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……あの修道士が見殺しにした流民たちは、かつて戦場でルチアーナと名乗るサンクタの女性に救われたそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そうよ。ママがラテラーノを去ってからどこに向かったのかを知りたくて、私はママの足取りを追ったわ。その先で、ママが助けた人たちに会えたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そんな人たちの集落もあってね、ママはラテラーノの素晴らしさを彼らに伝えて、もし行き場が無くなったらラテラーノに助けを求めなさいなんて教えてたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "彼らのほとんどが感染者だったから、穢れなき聖都は受け入れないだろうことはママも分かっていた。けれどママは、直筆の手紙を出せばきっと元同僚や友人の心を動かせるって思い込んでいたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "その同僚や友人たちのほとんどが、葬式の場ではママの想いや理想を笑いのタネにするような人間だったなんて、知る由も無く、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ママに善意を抱いていた残りわずかな人だって……たとえばあの修道士さんも、他人の苦痛には背を向けるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "だからといって、その修道士やあの場にいたほかの方々を傷付けていい理由にはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "傷付ける？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私はただ、彼らに互いの感情を分かち合ってもらっただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そうすれば、彼らもママみたいに優しくて勇敢で、慈悲深い善良な人になれるかもしれないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "その言動には根拠がなく、あなた自身が制御できる事象でもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "共感の範囲をむやみに拡大することは、サンクタの日常生活に大きな影響を及ぼし、予期せぬパニックや混乱をもたらすだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "人々がこれまでに慣れ親しんだ秩序は滅び、外出でさえも困難な状況となるでしょう。法に背く行為も大規模に発生し、大勢のサンクタたちがごく短時間のうちに堕天してしまう恐れもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "無論彼らがより友好的になる可能性もあるでしょう。しかし暴力的かつ狂気的な、公共の安全を脅かす犯罪者になってしまう可能性も否めないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたはただ、その「慣れ親しんだ秩序」が理性を失っていくことを受け入れられないだけでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "現実を受け入れなさい。直接狂気をもたらす感情なんてないの――むしろ受け入れがたい感情を拒み続けていると、いずれそれが理性の糸を断ち切って、あなたたちの言う狂気になるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "個人の感情を縛り付け、人間を鈍く偽りまみれの脆弱な存在にしてしまう秩序なんて、早々に切り捨ててしまうべきよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そうすれば、感情に導かれるままの新たな暮らしが作られ、私たちはより自由に……より悔いなく生きていくことができるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたの言う「私たち」の具体的な対象が不明ですし、あなたが思い描く「新たな暮らし」も見えてきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私に分かるのは、ルチアーナおばさん――あなたの母親には、もはや新たな暮らしは訪れないということだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フェディ、あなたって本当にすごいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "傷付ける意図がないのは分かっているけれど、それでもあなたはこうも容易く……私を痛めつけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "概して、痛みは人の目を醒ます助けになるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "しかしその後の行動を見ても、あなたが一時でも後悔の念を抱いたと判断することはできませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "後悔？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "もし後悔があるとすれば、当時ママをうまく支えてあげられなかったことくらいね。結果として、ママは心に思い描いた道の上で、あまりにもあっけなく命を落としてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたの選択はまったくもって理性を欠いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フェディ、あなたに私の音色が響かないのが本当に残念よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ママの墓標の前に立って、あの頃の記憶を何度も思い起こしながら感じているものを、どんなにあなたと分かち合いたいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "お断りします。如何なる感情も、あなたが罪から逃れていい理由にはなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "罪から逃れたいわけじゃないわ。私はただ……想いを理解してほしいだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "チェロを置きなさい。これ以上弦には触れないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ねえフェディ、本気で姉さんに銃口を向けるつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "おとなしく捕まるつもりがないのであれば、致し方ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そんなことできっこないのはわかってるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アルトリア、私はラテラーノの敵が何の制裁も受けずに聖都を跋扈する様子を見過ごすことはできません。それが誰であろうとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そのチェロは私に影響を及ぼすことこそありませんが、付近にいる方が被害を受ける恐れがあるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "これ以上、あなたが幻覚を生み出し、不要な感情で他者の頭を埋め尽くすような行為を――ひいては、共感の根底を揺るがしかねない行いを許容できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたは、私の音色が人々の心に蘇らせる真実の記憶を……まるで正反対の「幻覚」と呼ぶのね。あなたはこれまでもそうやって、感情が自身にもたらす意味を否定してきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フェデリコ、私はそんなあなたを嫌悪すべきなのかもしれないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "それでも、久しぶりの再会を祝して、一つプレゼントを用意してあげたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あちらをご覧なさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あれは……行商の車両？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "おーい！　フェデリコ、遅くなってすまねえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "道中で若い連中に引き留められちまってな。ここを風船射撃大会の会場にしたいから、執行人に立ち会ってほしいなんて言うもんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "っておいおい、フェデリコ、お前何やってんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "サンクタに銃を突き付けて何のつもりだ？　堕天したいのかよ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それは現状考慮すべき事柄ではありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "そんなことさせられねぇって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "お前が追ってる容疑者、アルトリア・ジアロって言ってたよな。遠い親戚って誤魔化してたが、お前の姉妹とかじゃないのか？　複雑な事情があるんだろうが、それでも……早まっちゃダメだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "唐突に発車した車両に、停止する気配は皆無だった。\nフェデリコは一息で車両に飛び乗ると、素早く運転席と助手席に乗る二人を引きずり下ろし、そのまま草地に放り投げた。\n無人になった車両から、無数の風船が飛び立っていく。高々と飛ぶ鮮やかな色彩が、空とフェデリコを結ぶ視線を遮った。それは一瞬の出来事だったが、彼女にはそれで十分だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アルトリア……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……消えた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "あたた……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……あなたは車内にいたもう一人を連れて、ステファン区中央病院まで向かってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "お前はまだほかに調べることがあるのか？　てっきりもう全部片が付いたもんだと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなた自身も、一度総合的なメディカルチェックを受けることをお勧めします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "つい今しがた、あなたたち両名ともアルトリアの音色に影響された可能性がありますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "でも俺は特になんも感じないぜ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "仮に、影響されていないにも関わらず車をぶつけて制止を試みようとしたのであれば、別のアドバイスをさせていただきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "アドバイスって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "執行人見習い",
      "text": "あっ、分かったぞ！　転職したほうがいいって言いたいんだろ？　奇遇だな、俺もちょうどそう思ってたんだ！　やっぱ俺たちって、運命で定められたダチ同士だったんだな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……以上が、私とアルトリアが対面した際の概説です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "マルチェッロおじさん、申し訳ありませんが、すでに証拠はすべて中庭公証人役場に引き渡してあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "聞くところによると、数名の枢機卿が自ら内容を確かめた後、彼女を指名手配にしたとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "フェディ、君は私にはできなかったことを……正しい決断をしてくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "だが、考えてしまうんだ――もしあの時、私がアルトリアを追い出さなければ……もしルチアーナの訃報が届いたとき、彼女との共感を拒んでいなければ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "アルトリアがこの誤った道に踏み出し、どんどん遠くへ行ってしまうこともなかったんじゃないだろうか――とね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "仮定に意味はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アルトリア・ジアロが今日の混沌とした道に踏み出したのは、彼女自身の選択です。私に分かるのはそれだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そして私は、彼女を逮捕し、自身の行いがもたらした結果の責任を取らせるつもりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "上は君に自分の姉を捕まえろと命じたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ええ、私が一番の適任ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "それは私がアルトリアの音色の影響を受けない稀少な人間というだけではなく……たとえ当人が認めずとも、おそらく私がラテラーノで最も彼女を理解しているからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "ならば捕まえた後はどうなる？　法が……彼女を裁くのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "公文書の記載によれば、ラテラーノの法は都市が建てられてから数千年の間に、何度か改訂されています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アルトリアが扱うアーツの特殊性から、彼女の罪を現存の法で裁くことは困難かと思われますが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "――彼女の脅威が客観的に存在している限り、執行人の銃は正しい判断を下すことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "とはいえ、君は……まだ卒業したばかりじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私の現状の能力では、このように重大な責務を背負うことは難しいとお考えですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "ははっ……むしろ「背負えすぎてしまう」から心配なのかもしれないな。フェデリコ、君は両親にそっくりだよ。きっとラテラーノで最も優秀な執行人になるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "私も……歳を取ったのかもしれない。近頃は昔のことを思い出してばかりさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "君の両親が亡くなって間もなく、君はうちにやってきた。あの頃はルチアーナもいて、君もアルトリアも愛くるしい子供だった。みんなで水鉄砲遊びなんかもしたのが懐かしい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "もしお望みであれば、ただちに半休を取得して、今から水鉄砲遊びをすることも可能ですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "はは、君は本当に優しい子だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "一つ、思ったことがある……君自身もはっきり自覚していないのだろうがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "アルトリアは、感情が自身にもたらす意味を否定してきた君のことを嫌悪すべきかもしれない、と言ったのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "それはもしかしたら、彼女の方が君自身よりも君のことを理解しているからこそ出た言葉だったのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "詳しくお聞かせ願えますでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "フェデリコ、君は私がこれまで見てきた中で一番誠実で、心に一点の曇りもない子だ。どんな記憶だろうと逃げることはせず、感情を押し殺してもこなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "アルトリアはそんな君を見て、自身のアーツの……そして、彼女自身の存在意義が揺らいだように感じたのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そのような説明には、困惑を覚えます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "ならば、たまには思考を放棄したっていいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "疲弊した声",
      "text": "さあ、部屋に入ってきなさい。おじさんに君を抱きしめさせてはもらえないだろうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そのような身体的接触の要求についても……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "八年も閉ざされていたドアが再び開かれた。\nカーテンはもはや閉じられることなく、綺麗に磨かれた窓には青い空が映っていた。\n机にはいくつかマフィンが置かれ、コップに注がれた白湯からはまだ湯気が立ち上っている。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……抱擁程度であれば、受け入れても構わないでしょう。",
