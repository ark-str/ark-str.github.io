  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えっ……もしもし？　フロストリーフさん……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "一体、何が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "――こちら、第二偵察隊！　アーミヤさん、聞こえますか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "我々は現在、廃都市から撤退中です！　というのも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "レユニオン……が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "また、通信が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "っ、第三偵察隊！　聞こえたら応答してください、第三偵察隊！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "――アーミヤ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　ケルシー先生！　今、どこにいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ロドス本艦のブリッジだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君に頼みがあるのだが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "隣にいるだろうチェン警司に、一つ聞いてみてくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "「龍門はいつまで下らん意地を張り続けるつもりだ？」と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……今の言葉、聞かなかったことにしておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "とはいえ、確かにこれは一刻を争う状況だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "報告書をお持ちしました。……おや、どうかなさいましたか？　お二人とも、随分険しい顔ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "――もしや、緊急の任務でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "みなさん、準備をお願いします。すぐに出発しますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――チェン隊長。この救援任務のため、我々は龍門に対し、近衛局を派遣しての協力を要請します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの場所には、一時的にレユニオンの司令部もおかれているようですし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "通信が途切れた今も、偵察隊のみなさんは、それぞれの場所で抵抗を続けているはずですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
