{
  "server": "jp",
  "storyId": "main_15_level_main_15-06_end",
  "groupId": "main_15",
  "stageId": "main_15-07",
  "title": "臨界の時",
  "storyCode": "15-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_15-06_end.txt",
  "sourceHash": "0f0aed6bd7853b1bee193815feab2d2a23d955ed9cc5a160f0dbe68ddc624ce0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "コータスは破滅が、特に迫りくるのを鮮明に感じられる破滅が、平然と受け入れられる事実であるなど思ったことがなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "み、自らが愛した全てが破滅しても何も感じないままでいられるなんて、私にはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "理解できません――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "何も感じないわけではなくて、宇宙の絶対的平等を信じているの。残念だわ、あなた来るのが少し遅かったみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "この船はたった今数万光年離れた所で、超新星爆発を目の当たりにし、無事に逃げてきたところよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "もしその光景をその目で見ることができたなら、あたしの言っていることがもっと理解できたかもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ホール内の計器が高速で回転し始め、コータスはその軌道を肉眼で捉えることができなくなるほどだった。\nそれから、彼女は流れ動くたくさんの光と影が現れるのを見た。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "暗い深紅色の光を発した巨大な球体、それと球体の表面を素早く飛ぶ青色の小さな点も見えます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "ですが、その大きな球体は小さな青い点を周回しているようでもある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "あなたの言う青い点は超新星爆発を起こしたばかりのパルサーよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "あの次第に引き裂かれつつある赤い恒星はかつてその同行者だったけど、今では不可逆的な死に向かっているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "あれらはかつて興味深い原始生命体をたくさんもたらし、あたしもあの星系の惑星の中を歩いた経験がとても懐かしいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "でも残念なことに、そうした生命は空の外の世界を見る時間すらなく、死を迎えたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "……どうしてこうしたものを私に見せるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "あたしたちが持っている知識を共有しているだけよ、旅人さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "一方的な偏見や無知は有効な情報伝達における障害になりがちだもの。あたしもあなたの素性について無知なわけだし。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "コータスはすでに目の前の人物が言った言葉を理解している暇がなかった。突然の間に触れた新たな知識が彼女の思考に衝撃を走らせ始めていたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "大地は……生命を二度誕生させる？　こうした空から落ちてくる星も……生命をもたらす？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "「破滅」の果ては……絶望ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "私たちは……あの大地にとって特別ではない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "生命を養い得る星は、そこで生活するあらゆる生物を平等に愛するわ。生命の起源がどこであろうとね。これは自然の法則よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "謎の精霊",
      "text": "まだ完全には理解できない知識を、あまり貪欲に汲み取ろうとしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "その中にあなたの姿も見ました。あなたのそばにもたくさんの同族がいた。だけど突然――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "「幽霊」、多くの人があなたをそう呼んでいる。そうですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "確かに、あたしはただの彷徨う幽霊よ。言ったように、本当の破滅があたしと同族の前に訪れた時、あたしにはどうすることもできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "……あなたの言う破滅とは一体何ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "私はもうここで神にしか実現できないようなことをたくさん見ました。一体どのような破滅であればあなたたちを脅かせるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "旅人さん、あなたの質問に答えられる人は多分この船にいないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "たとえあなたにしてみれば、あたしたちの有する知識が宇宙の多くの生命から「神の力」と見なされるに十分であったとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "宇宙の広大さを考えると、あたしたちに探索できる領域にも限界が存在する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "がっかりした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "つまり永遠の国、誰もが無限の幸福と喜びを得られる楽園は存在し得ないということですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "そんな国が存在していてほしいの？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "コータスは少しためらった後に、うなずいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "永遠の生命なんてないわ。あたしのよく知る歴史においても、無数の星系を征服した伝説的な文明があった。彼らが宇宙の中で歩んだ時は百万年を超えたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "だけど宇宙にとって、彼らが残した痕跡は結局のところひどくちっぽけなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "あたしたちはみんなかつて存在しない信条や理想を盲目的に追求した……追憶できない黄金時代の中、自分の存在には絶対的な目的があると固く信じた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "でも結局は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "知恵を持って生まれたあらゆる生命は、かつて自分こそが世界の中心であると信じて喧伝した。だけどこういう可能性は考えたことがある？　宇宙にしてみれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "最初から最後まで、あたしたちはただ取るに足らない存在にすぎないと。これこそ宇宙を理解する前に学ぶ必要のある最初の教えよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "さっき見たあのきらびやかな超新星爆発を覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "生命はいずれ墓の中で再び誕生し、そしていつの日か、彼らはあたしたちが墓石に刻んだ印を理解するでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "あれはあたしたちのかつての日々。あたしたちが存在した証明。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "……あなたの話は、理解できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "なら私たちはどうやってその大地で誕生したんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "私たちよりも前に、もっと輝かしい文明が誕生したことはあるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "そして、私たちもすぐ先の未来で破滅を迎えるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "あと私がもっと気になっているのは、源石がもたらす病気や苦しみも、根絶できるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "これらの知識に通じる道へと導いてほしいです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "あなたのどの質問にも答えられないわ。初め三つの質問は、宇宙において異なる言語の異なる言い回しがあり、あなたたち自身にしか答えられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "そして最後の質問だけど……ごめんなさい、「源石」というものを聞いたことがないし、既存のデータベースの中にも「源石」に関する情報は何も見つからないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "――？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "でも一人面白い人を知っているわ。この船の主でもあるの。彼女なら、あなたの疑問に答えられるかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヒアダ",
      "text": "この船の主？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "幽霊",
      "text": "名の通った言語学者でもあるわ。彼女の名は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「プリースティス」。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ドクター、今はぼうっとしている時ではありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "掴まってください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "――！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "アーミヤ、見たか？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "いいえ。今は気を散らすことができません。特異点への道を編み出すのは難しいんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "たとえテレジアさんの助けがあっても……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、何が見えたんですか！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "あなたは見覚えのある人影を見た。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "何も気にする必要はない、アーミヤ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "我々の本来の計画を実行するんだ。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "このまま「橋」を架けるんだ！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい！　接続ポイントを一つ一つ安定させているところです、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ケルシー先生が以前検索した全ての記録がテレジアさんにマークされているので、それらを繋ぎ合わせています。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが、この先へ進むには、帰り道を指し示してくれる道標が必要です――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シヴィライト・エテルナ",
          "text": "私はここで留守を守り、あなたの道標になるわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シヴィライト・エテルナ",
          "text": "進み続けなさい、アーミヤ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ピンク色の糸が集まり始める。\nうねった線が絡み合いながら螺旋を描いて境界の向こうへ、さらに遠くへと伸びていく。\n境界を越えて、特異点に通じる道が次第に形成されていく。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "うまくいきました！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ここではアーツが機能しないようですが、アーツの術ロジックでここに出現する情報を再構築することは可能です！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "全く未知の情報により「橋」を架けることはできるか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "だめです。ここは私では解析できない、「文明の存続」ですら翻訳することのできない情報で満ちています。私一人で道を構築することはできません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ですが幸いケルシー先生のアクセス記録が残っており、彼女の研究データをテレジアさんの協力によって捉えることができます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "それがあれば十分です。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ピンク色の糸がゆっくりと円を描きながら、膨大なデータに結びつく。それは無秩序な情報の中にケルシーが残した足跡だった。\n一本の糸が徐々に数を増やし、数多の糸によってついに道が浮かび上がる。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "通路の構築状況は順調だとは言えませんが、機能はするはずです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "通路に入って、特異点に近付いてみたいと思います。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "自分もついていこう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ダメです。私が状況を明らかにするまで、ドクターは通路に入ってこないでください。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "私のわがままを許してください。そう決めたんです。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "複雑に入り組んだ情報から成る通路はすでに特異点まで遠く伸びていた。\nアーミヤはためらうことなく通路を進み、初めて境界の外へと踏み出した――"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "波。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "この感覚、まるで情報が実体を持って波を形成しているような。そんなこと――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "恐らくこれは始まりにすぎない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "「特異点に近付くほど、情報の密度は高くなる」……",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "やはりテレジアさんの言うように、ここの情報は質量を生み出せるほどになっているようです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "このまま引き続き深くへと進めば、恐らくさらなる障害が待ち受けているでしょう。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "アーミヤ、ひとまず戻ってくるんだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "より良い対応方法を考えなければならない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "この脆い道を維持し続けられる保証はできません。深く入ることによる消耗は予想を遥かに上回っています。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "いえ、私は進み続けなければなりません。ケルシー先生が残してくれた目印に従って行けばきっと……",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ティカズの歩いた銀色の山脈が彼女のそばをかすめていき、氷原に墜落した巨獣が落とした漆黒の影が一瞬にして過ぎ去る。\nアーミヤの見ている光景は高速で通り過ぎていく。まるで時間の流れに逆らって進んでいるようだった。\n理解できず表現できない光景が、アーミヤの思考を押し流そうとする。その勢いは増すばかりだ。\nそうした混乱を極めた際限なき情報を彼女は必死に遮る。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "集中、集中。ケルシー先生が残してくれた目印から目を離さずに……前へ進めば……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "特異点に触れさえすれば――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "何一つ聞こえない静寂。\nアーミヤは自分の呼吸音すら聞こえなかった。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ここは……どこ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あの巨大な球体は……砕けている？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "崩壊する球体は眩く、空に浮かぶ奇妙な形状の船は彼女の意識を一瞬さらっていった。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "一体……何が起きているんでしょう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "どうして私は――",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "彼女が呆然としたその時、回転する巨大な石がゆっくりと、しかし止めようのない勢いでアーミヤに迫ってきた。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "黒い影が瞬く間にアーミヤの視界を全て覆った。彼女は無意識のうちに自分を守ろうとしたが、続けてやってきたのは制御不能な落下する感覚だった。\n失敗したのか……情報の波によって？\n「アーミヤ！」"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ドクター……？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ここにいる。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "アーミヤは自分を支える手を感じた。思考を安定させようとしてくれている。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我々をかき乱す情報を遮断するんだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "自分が君と一緒にいる。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "間に合ったのならいいが。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "言いつけを守れなくてすまない、アーミヤ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター……よかった……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "今あの瞬間……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "あなたはふらつくアーミヤの体を全力で支える。特異点から噴き出した情報の波は、絶えずあなたたちを襲い続けている。\n実体を伴いかけている情報があなたたちの思考を押し流し、入り乱れた残像を虚空に残した――\nそれはすでに失われた過去であり、膨大な情報に記録された今であり、あなたたちの次の行動を予知した未来のようでもある。\nしかし残念ながら、今のあなたたちにはそれに注意を払う余裕はなかった。\nここから境界の方を振り返ると、あなたたちはいつの間に遠くまでやってきていて、そして特異点は……\nすぐ目の前にある。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、先ほどの恐ろしい光景を見ましたか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "見た。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "そこに含まれる意味は理解できなかった。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あれはきっとテラで起きた光景ではないはずです……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "だが少なくとも特異点に接近していることを意味する。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "より多くの情報が我々に向けて明かされつつある。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "まだ大丈夫そうか、アーミヤ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "も、もちろんです。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "自分たちが今置かれている状況をあなたはよく承知していた。効果など微々たるものだろうと知りつつも、あなたは無意識に手を伸ばし、アーミヤの壁になろうとした。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "衝撃は思考に対するものだ。自分なら対応できる。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "自分が前を歩く。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我々が探している鍵に関して、手がかりを得た。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケルシーが残したアクセス記録を収集し計算してみた。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "鍵となる情報を自分の思考から直接読み取ってくれ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "見つけました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "「眠りの橋」というキーワードをフィルター条件として、ケルシー先生は計七万九千三百四十六回検索を行っています……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "全ての検索は「源石」に関連したものですが、ドクターの推測によれば、これらのデータは源石の持つ本質とそれほど関係がないはずです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "アクセス拒否によって何も得るものがなかったのなら、手がかりは完全に断たれたのではないですか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そうではない。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケルシーは同じ項目を繰り返し検索している。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そのこと自体が我々に何かしらの情報を伝達している。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "繰り返し検索をしている？　待ってください、繰り返し検索した回数から成る無限ループのコードも解読できるでしょうか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……ドクター、すでにその答えを出していますね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そうだ。よく知る名だ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "これは指示かもしれない……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "これは警告かもしれない……",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "この名前は聞いたことがありません。ドクターからもケルシー先生からも、一度も――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "「プリースティス」？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――ドクター、私たちが見ているのは同じ光景ですか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……恐らく、そうだ……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "narration",
          "text": "「プリースティス……」\nあなたはこの光景を見たことがない、ましてや――"
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）来たのね、{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "あれは……？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "「自分」……？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "オラクル",
          "text": "（未知の言語）君の設計したPRTSを改良するのに少し時間がかかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オラクル",
          "text": "（未知の言語）もう休んでいるかと思った。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）いいえ、あなたがさっき話したことをずっと考えていたの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）「神を描写する言語は存在しない。なぜなら神自身の存在が絶対的に理解不能だからだ。」",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オラクル",
          "text": "（未知の言語）それはとりとめのない会話の最中に思いつきで言ったことにすぎない。よくわかっているだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）それが正しい前提であると仮定すると。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）それを出発点として、神を描写するに十分な言語を創造することができるなら、つまり、私たちも神を理解し得ることを意味しない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）あなたは胸が高鳴らないの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）もしかしたら、私たちはその問いの答えを見つけるために誤った道を歩んできたのかもしれないわね――宇宙がすでに生んだ規則を借りて、宇宙の本質を解読しようとするという。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "オラクル",
          "text": "（未知の言語）君は、我々が一から創造した言語によって宇宙を解釈したいと思っているのか。あまりに大胆な発想だ、プリースティス。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）ふふ、そうかしら？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "彼女は指先でこれ以上ないほど正確な菱形を宙にさっと描いた。"
        },
        {
          "type": "dialogue",
          "speakerName": "プリースティス",
          "text": "（未知の言語）ならいっそ今から始めるのはどうかしら？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ドクター、あの二人は何を話しているのでしょうか？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "あなたはすでに目の前の人物を見たことがあった。内なる宇宙で、彼女はかつてあなたのそばにいた――"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "恐らく二人が話しているのは……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "源石についてのことだ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
