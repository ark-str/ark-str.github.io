{
  "server": "jp",
  "storyId": "story_huang_set_1_story_1",
  "groupId": "story_huang_set_1",
  "stageId": null,
  "title": "意思を問う",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_huang_1_1.txt",
  "sourceHash": "58f5c5bb25768ebd7dc77f029d95f01fdcabc43260e6676c320f2d0a739b6c5d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "――マズい、この先の道……塞がれてます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "こっちも追っ手が来てる！　ダメだ……逃げ場がない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア構成員",
      "text": "ようやく追い詰めたぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア構成員",
      "text": "もう逃れられんぞ。奴らを出せ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "狙撃オペレーター",
      "text": "クソッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狙撃オペレーター",
      "text": "感染者たちを守るんだ！　待ってろ、俺が前の連中を何とかする――お前らは隙を見て突破しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "あっ、おい！　戻ってこい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "冷静になれ！　今はヒーローなんて気取ってる場合じゃないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "そうですよ、そんなに傷だらけなのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狙撃オペレーター",
      "text": "でもっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "でもじゃない！　慌てるな！　Aceさんは絶対、応援を送ってくれる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "――彼の言う通りだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "この声は！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア構成員",
      "text": "誰だ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア構成員",
      "text": "親分、気をつけ――ぐぅっ！　あつッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "狙撃オペレーター",
      "text": "なんだ？　急に暑くなってきたような……ま、待て、向こうを封鎖してた障壁が……全部切り裂かれてるぞ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "……助けが……助けが来たんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "暑い？　ごめんごめん！　これを切り裂くのに手こずってさ……やりすぎちゃったかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "精密操作時の温度調整はまだ勉強中なんだ。次こそはいい具合に調整してみせるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "狙撃オペレーター",
      "text": "そのチェーンソー……あなたは、Aceさんのチームの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ブレイズさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "はぁ、やっと来てくれたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "やっほー！　今そっちに行くからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "お待たせ！　向こう側にいた追っ手を片付けるのに、ちょっと時間がかかっちゃってさ。もう暫くしたら、他の小隊も合流するから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "分かった。それなら俺たちは包囲網を突破し、当初の計画通り行動しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア構成員",
      "text": "おいおい……最新鋭の封鎖障壁だぞ！？　一体どうやって切断したんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "いやぁ、ごめんね。私もあんなふうにスパッと真っ二つになるなんて思ってなかったからさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "さて……真面目な話、命をかけてまで争う必要なんてないよね？　私たちが感染者を連れて行っても、君たちには何の損もないわけだし……だから、私の仲間に手を出すのはやめてくれないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ここはお互いに引き下がるってことで手を打たない？　私だって、君たちに手出しなんてしたくないしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア構成員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ちょっと、ひどいじゃない！　それが君たちの返事？　まったく……話し合うのってそんなに難しいことかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ブレイズ！　無駄口叩いてないで準備しろ！　突破するぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "分かった！　じゃあ、もう少し温度を上げるからね――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "最後にもう一つだけ。こうなっちゃうのは本当に残念だよ……これは本音だから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "いたたたた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "う～っ……う、腕がぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "この前、未完成の技を無理矢理使っちゃったけど……やっぱり無理が過ぎたかな。腕が千切れるかと思ったし……いたたぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "推進速度が調整しきれてないみたいだけど……計算が間違ってるのかな？　だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "こんな所で独り言なんて……どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "えっ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "なんだ、ウィーディじゃない。びっくりしたぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "びっくりしたのは私の方だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "あと……「なんだ」って何？　私じゃいけなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ちがっ、そういう意味じゃなくて！　ほら、この時間に君とここで会えるとは思わなくてさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "珍しいね。普段は昼食とか夕食とか……必要な時以外は、ずっとラボに籠もってるじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "たまに三食全部抜いちゃって、私がラボから引っ張り出そうとしても嫌がることがあるくらいだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "大げさすぎ。私だって息抜きくらいするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……それと、もしまた勝手に土足で私のラボに入ったら、すぐにあなたの入室権限を取り消すからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "わ、分かった。気をつけるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "あとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "まだあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……服はちゃんと着てくれない？　上着の裾、シワが寄ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "えっ？　裾？　どこかな、この辺？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "そこじゃない……って、無理に引っ張らないで。もっとシワになってるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "はぁ……見てられない……手をどけて、私がやるから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "へへっ、ありがと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ウィーディはそういうことに、すごく気を配ってるよね。君にかかれば、工場から帰ってきたクロージャが自主的に手を洗うっていうじゃない。それってすごいことだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……あっ、そうだ。ウィーディ、君って勉強できるよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "研究……も、勉強に入るのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "入る入る！　もちろん入るよ、当たり前でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あのさ、実はちょっと教えてほしいことがあって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "珍しいね。どんなこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ええっと、動的加速度に関する問題で……摩擦抵抗とエネルギー膨張の公式も関係してるんだけどさ。君、その辺詳しいでしょ？　教えてくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……って、えっ？　何？　なんで私のおでこ触ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……うーん、熱はないみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……まさか、ブレイズの口からそんな質問が出てくるなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "変なの。今って外は晴れてるのかな？　急に雨が降りだしたりしてない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "そんなこと言わないでよ。確かに物理は全然好きじゃないけど……でも、仕方ないじゃん。役に立つんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はぁ……とにかく、これを見てよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "えっ……？　これ全部、ブレイズが読んでるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "どれも上級課程の教材じゃない……それに、ここにメモしてある疑問点って……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ごめん。さっき言ったこと、撤回するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ん？　急にどうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "本当に努力してたんだね。こういう疑問は、なんとなく読んでるだけじゃ浮かんでこないもの。謝るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ええっ？　やめてよ。別に私は気にしてないし……だから、そんなに畏まらないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "それに、ウィーディ以外からもよく言われるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ほら、私ってそんなに頭が良くないから、これを勉強するのもすごく大変だしさ。そもそも、こういう学問ってガラじゃないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "仕方ないよ。私にはまだまだやりたいことが沢山あるけど、そのためには強くなるしかないわけだし。だから、役に立ちそうなことは何でも試してみなくちゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "それにさ、頭を使うだけなら訓練場でAceにサンドバッグみたいに殴り飛ばされるより楽だと思わない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ほぅ、お前は普段そうやって俺の陰口を叩いてたんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "げっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "元気そうで何よりだ、ブレイズ。だが、でたらめを言うのもその辺りにしろよ。ウィーディに悪影響だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "Ace！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "Aceさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "何よ、悪影響って。私は本当のことを言ったまでだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "この前AceとMechanistに特訓してもらった時なんて、おへそのあたりで真っ二つにされるかと思ったんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "あれはお前の新しい武器の調整をするためだろ。お前の望む破壊力まで到達するのはそう簡単なことじゃないんだ。お陰でMechanistはもう何日も作業台に張り付いてるんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "嘘だと思うなら、あいつが破いたラフの山でも拝んでこい。紙の使いすぎで後方支援部に怒られたと言ってたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "それは……マズいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "けど今回も、Mechanistがくれたこのでっかいやつのお陰で何でも斬りたい放題だったよ！　へへ、これがなかったら、私の新しい技だってお披露目できなかっただろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あっ、そうそう。これ見て！　今回はシラクーザのご当地チーズをお土産に買ってきたんだ。独特な味がするんだって。後でMechanistの所にも持っていって、食べさせてあげようっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "うわっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ひどい臭いね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "ははっ、あいつが気に入るかは知らんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "ああ、そうだ。ウィーディ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "前にお前がエンジニア部へ提出した申請だが……クロージャから書類を受け取った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ちょうどその件について聞きに行こうと思ってたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "正直、こんな申請を受け取ることになろうとは思ってもみなかったが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "本人にその意志がある上に、クロージャもお前の製品について戦闘での機能面を保証すると言っていた。となれば、俺たちにこの申し出を拒否する理由はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ってことは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "正式なオペレーターとして歓迎しよう、ウィーディ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……ありがとう、Aceさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "えっ？　なになに、どういう風の吹き回し？　ウィーディ、君……戦場に出たかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "そうだけど。何か問題でもある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あ、違う違う、もちろん問題なんてないよ！　一緒に作戦に参加できるのは楽しみだし、君を見くびってるわけじゃ絶対ないからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ただ、えっと、身体のほうは……本当に大丈夫なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "私だって、何かを変えたいって思う時があるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "確かに私は体が弱いし、身体能力ではみんなに敵わないかもしれない……でも、得意なことはあるし、この蓄水砲だって伊達じゃないよ。この子たちの推力ならブレイズを越えてるかもしれないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "すっごく頼もしいじゃない！　それじゃ、今度同じ小隊で出撃することになった時はよろしくね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……考えとく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "こほん……さっきの質問だけど、まだ続ける？　もし、ちゃんと聞く気があるなら、また夜にでも見せに来て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "……じゃあ、先に行くね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あれっ、どうしたんだろ？　もしかして照れちゃった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "それ、本人の前では言うなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "そのくらい分かってるってば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うーん……やっぱり、この前の任務記録を整理し直さなきゃいけないね。あの時は咄嗟に使うことになったとはいえ……やっぱり新しい技には何かが足りない気がするし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "手の感覚とか？　ううん、多分もっと細かい計算の問題で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "だから上級課程の教材なんぞ借りてきたのか？　お前、数式や計算が嫌いだったはずだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "もちろん好きじゃないよ。お陰で最近抜け毛が二倍になっちゃったんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "でも仕方ないでしょ。私のアーツは何も考えずに相手を倒せるってタイプじゃないんだから。つまり良い仕事をしたいなら、努力するしかないってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "はは、そうか。そいつはいい心がけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "なら、Mechanistも改良を続けているらしいし、一度見せてもらうといい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "もちろん、この後すぐに会いに行くよ！　また何時間もドアの前で待ちぼうけを食らって、ずーっとノックし続けることになっても、今回は絶対に文句なんて言わないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "いや、そこまでせずともすぐに会えるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "ケルシーから、例の件について聞いたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ああ……あのことね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ケルシー先生、私を捜してるって聞いたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "何かあったの？　真剣な顔だけど、もしかして大事なこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ああ、確かに重要な話と言えるだろう。君自身にとっても……そしてロドスにとってもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ヤバい、そんな風に言われると緊張してきたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ブレイズ。君はロドスに加入してどのくらい経つ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うん？　……えーと、大体一年くらいかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "時間が経つのってあっという間だよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "時間というのは、常に我々のすべてを置き去りにするものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "この一年、君の成長には目を見張るものがあった。行動によって何かを証明する意図はなかったかもしれないが……結果として君は、皆に自分自身を証明してみせた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "Aceや他のオペレーターも、君のことは高く評価している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "突然どうしたの？　面と向かって褒められたら照れるじゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君の体温は正常値の範囲だが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "我慢してるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "私が君を捜していた理由だが……予想はついているのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "まあ……いくつか心当たりはあるけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そうか。ならば、こう伝えるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ロドス設立以来、多くの者がロドスへ加入し、また幾人かはこの場所を去っていった。その事実について、多くを語るつもりはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "我々は志を同じくする者を歓迎するが、その一方で、いかなる思想であろうと、それを強制されるべきではないと考えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "しかし……ロドスが、我々と歩みを共にする者を必要としていることもまた、確かな事実だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ブレイズ。まだ心の準備ができていないのなら、それもまた正常な反応だ。誰も、君に何かを強制することはないと伝えておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "だが、もし心の準備ができたのなら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ブリッジの下の階へ行き、階段左側の扉を開くといい。我々は、そこで君を待っている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……って言ってたんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ねぇ、Ace。ケルシー先生が何のことを言ってたか……分かる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "俺から言う必要なんてあるのか？　察しはついてるんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "まあ……そうだけどさ。でも、確信はないっていうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あのケルシー先生が改まって私に通知してくることって考えたら、大体見当がつくよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……私にも、Aceと本当の同僚になるチャンスが回ってきたってことだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "まあ、そんなところだな。やっぱり分かってるじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "私だってバカじゃないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はぁ……でも、なんだか現実味がなくてさ。夢みたいっていうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "何でだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "だって……私は自分が他の人より強いと思ったことなんてないし、君たちと比べたらまだまだでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "お前なあ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あっ、ブレイズさん。ここにいたんですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ずっと捜してたんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ん？　あら、ウサギちゃんじゃない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "捜してたって、私を？　あっ、転ばないよう気をつけてね。もう、どうして今日はそんなに積極的なの？　嬉しいなー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ひゃっ？　わ、やめへふらはい！　ふれいふはん、ん～っ！　……はあ、もう、ほっぺをつまむのはやめてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ケチケチしないでよ、減るもんじゃないんだし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "（……俺が言うまでもないらしいな。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "（後は任せたぞ、アーミヤ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "じゃあ、頑張れよ。また後でな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "え？　ちょっ！？　待ってよ、Ace……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……行っちゃった。あいつ、あんなに急いでどこへ行くんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "きっとAceさんは、まだお仕事が残ってるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "え、えっとそれで、ブレイズさん！　もうご飯は食べました？　今日はブレイズさんの好きなあのメニューですよ。一緒に食堂へ行きませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そ、それから、前にブレイズさんが好きだと言っていたCDも！　エリジウムさんから借りてきたんです……い、一緒にどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "わあ、それってあいつが超大事にしてるやつだよね？　聴く聴く、もちろん聴くよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "でも……今日は一体どうしちゃったの？　ウサギちゃん。積極的を通り越して、ちょっと変だよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "うっ……そ、そんなに分かりやすいですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うん、すーっごく分かりやすいかな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "その……ごめんなさい、ブレイズさん。Aceさんとお話していたのが、少し聞こえてしまって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "なーんだ、そういうことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ほらほら、そんな顔しないの。気にしなくていいから……ね、笑ってみせて？　……うん、その顔が一番。そもそも、謝る必要なんてないから！　隠すことでもないんだからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "聞こえてたと思うけど……ケルシー先生に呼ばれた理由、大体見当がついてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "アーミヤちゃんも知ってるんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "やっぱりね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ってことは、私がプレッシャーを感じてないか心配して和ませに来てくれたのかな？　もう、君ったら本当に可愛いんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ああっ、またそういうことばっかり言って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ごめんごめん、もうからかわないよ。ちゃんと話そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "私はね……正直そんなに自信もないし、自分の実力じゃ、まだみんなの背中に遠く及ばないような気がしてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "だってさ、考えてもみてよ。Mechanistが設計した武器がなかったら、この間の任務で小隊を救うことすら出来なかったんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ねぇ、アーミヤちゃん。真面目な話……本当に、私なんかが務まるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……さっき、Aceさんと話している声が聞こえた時、絶対に私の考えを伝えなくちゃって思ったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "そう……それじゃあ、聞かせて。アーミヤちゃんの話は、いつだってよく聞くようにしてるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ブレイズさんは、肩書き欲しさに努力しているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "もちろん、違うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そうですよね！　ブレイズさんは何かになるために努力しているわけではなくて、むしろその真逆の人だと思います。そんなあなただからこそ、この役目に相応しいと私たちは考えたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "実際、誰もがブレイズさんを信頼しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "シラクーザの任務から戻った隊員たちは、口を揃えてこう言っていました――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "「ブレイズのお陰だ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "「封鎖障壁を切り開くことができなければ、そう簡単には任務を終えられなかった」って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "す、すごいのは私じゃないから。全部Mechanistがくれた装備のお陰で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですが、ブレイズさん以外にこんな大型の特製装備を使いこなせる人はいません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "っ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もしブレイズさんがいなかったら、Aceさんも速攻とは程遠い安全重視の戦術を選ばざるを得なかったかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですから……ブレイズさんは既にみなさんからの信頼に足る人で、ロドスにとってなくてはならない存在なんです。実のところ、それこそが一番大事なことなんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "アーミヤちゃん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私が言いたいのは――ブレイズさんにその役割を負わせるために肩書きを与えようとしているのではない、ということです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "全て、ブレイズさんの行動が築き上げた結果なんです。あなたがどんな人でありたいかを考え、責任を負うことを選んできた結果なんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もし、ロドスが必要としているのが単なる強さや戦力だけなら、他の人でも構いません。強大な怪物級の力が必要というだけなら、それはブレイズさんじゃなくてもいいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "怪物っていう言葉は……あんまり好きじゃないんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あっ、そういう意味ではなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "つ、つまりですね、私が言いたいのは！　ロドスが必要としているのは、単に実力があるだけの人じゃないってことなんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですからブレイズさん、もっと自分に自信を持ってください。もっと私たちを信じてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もし気持ちが決まっているなら、私も一緒に行きますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はいはい……も～う、顔が熱くなっちゃうじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "オッケー、ウサギちゃん。君の言いたいことはよーく分かったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うん、確かに君の言う通りだ。ああもう、なんでそんなに話が上手なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えへへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "よーし、そろそろ時間だし、気合い入れて行ってくるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ま、最初から尻尾巻いて逃げ出すつもりなんてなかったけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あっ、わ、私もご一緒します！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "いいよー！　じゃあ途中まで一緒に行こうか、その方がリラックスできそうだし……って、どうして君の方が緊張してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そ……そう見えますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "そりゃもう、カチコチに見えるよ。ほら、笑って。せっかく可愛い顔なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "え、へへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "うんうん。やっぱり笑顔が一番だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……大丈夫。絶対に君を失望させたりしないから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ブレイズは長く薄暗い廊下を進む。船の航行に伴って頭上の灯りはゆらゆらと揺れ、その動きに合わせるかのように彼女の影もまたゆらめきながら床へと黒く落とされていた。\nその傍にはアーミヤの影があり、二人は共に進んでいく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そしてブレイズが扉を開いた。\n下へと続く階段は、まるで終わりがないかのように長く、そして仄暗かった。ブレイズは深く息を吸い、アーミヤをそこに残して降りていく。\nここから先は、彼女一人で進まなければならないのだ。\n階段の終わりが見え始めると、そこにはぼんやりとした光があるのが分かった。飾り気のない部屋の中央には長机が置かれ、四方を囲む冷たい鉄骨の上から、黄色く暖かな灯りが差している。\nそして灯りの下には、見知った人物や見知らぬ人物の姿があった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一通り周囲を見渡した時、暗闇から見慣れた顔が現れた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "来たか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "堅苦しそうな場だとは思ってたけど、まさかここまで仰々しいなんてねぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あっ、Ace！　それにMechanistもいるじゃない。って……そこにいるのは……Logosさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "敬礼はいらぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "よかった、君たちがいてくれてすごく落ち着いたよ。部屋に入る時なんか本当にびくびくしてたんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "お前を推薦したのは俺なんだぞ。立ち会わないわけにもいかんさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "text": "おや、君はそんなに小心者だったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "もう、人の気も知らないで……あんまり面白がらないでよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mechanist",
      "text": "分かったから騒ぐなって。仕事の話をしよう……そうだ、いい機会だし、この後一緒に工房へ来てくれ。君が持ってるその武器を調整してやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "いいよ。私も君に渡したいものがあったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "ほら、その辺にしろ。本題に戻るぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Logos",
      "text": "……ああ、始めようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "では、手短に進めるとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "オッケー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ロドス前線作戦小隊、Ace分隊所属、アタッカー・ブレイズ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "この部屋に在るすべての者を証人とし、君の意見と選択を問う。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "オペレーター・ブレイズ。ロドスのエリートオペレーターとなる意思はあるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
