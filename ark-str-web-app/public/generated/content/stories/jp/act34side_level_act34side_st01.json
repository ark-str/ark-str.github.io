{
  "server": "jp",
  "storyId": "act34side_level_act34side_st01",
  "groupId": "act34side",
  "stageId": "act34side_st01",
  "title": "波を見守る者",
  "storyCode": "BP-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act34side/level_act34side_st01.txt",
  "sourceHash": "674848a3a7261a56d2876e186382100aadbbfaa6596f22c0f6a6dec24565a128",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "choice",
      "options": [
        {
          "label": "久しぶりだな、スカジ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "こんにちは、スカジ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "久しぶり、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "驚かないのね。約束では、あのツラの皮の厚いお喋りリーベリが迎えに来るはずだったのに。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君もエリジウム同様、ロドスのオペレーターだしな。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "ここは君の故郷のほうにこそ近いからな。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "まあ、そうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "それにしても、ケルシーの予測より着くのが遅かったわね。一時間遅れよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "聖徒の発行した公文書があっても、裁判所は審査プロセスを一つも省略しなかったのね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "――三ヶ月と経たないこの間に、ここの住民は使える労働者を除いて全員、内陸の街に移動したわ。それと入れ違いに、懲罰軍の大部隊がいくつかやってきてる。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "彼らは、随分急いで何かの準備をしているようだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "とても緊迫した様子に見えた。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "一週間前、イベリアがエーギルからの連絡を受け取って以来、この忘れ去られた小さな町は静けさを失ってしまったの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "至る所に海の残滓があるせいで、あの若い戦士たちは神経を尖らせている。そんな時に届いたエーギルの声が、彼らの不安に拍車をかけているのよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "エーギルの行動は、確かに注目と警戒に値する。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "遠海の国家が急に声を発すれば、聞き流せはしまい。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "彫刻の左側の通りを行きましょう。少し速足で歩けば、10分くらいで海が見えるわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "そのあとは、イベリアの眼に直行するわよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "ねぇ、ドクター。波の音が聞こえる？",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "スカジは海風に向けてわずかに顔を向け、彼女の長い髪がなびく。その髪は、瞳の中の陰りと同じ色をしていた。"
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "波が複雑に重なり始めてるわ。それに、流れる星空の音も、決して止まない自然の歌も、理解されようのない言葉も聞こえて……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "大丈夫か？　スカジ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "故郷との繋がりを取り戻して、むしろ不安にでもなったのか？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "長く離れた故郷との距離が近付いたからこそ、思うこともあるのよ……まあいいわ、この気持ちは一言では言い表せないしね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "あるいは、単によく眠れていないせいなのかも。前回海へ帰った時に、サメから彼女が見ていた夢を移されたような気がするわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "ところで、ケルシーはどうして、こんなに急いでドクターを呼び出そうとしてるのかしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "あなたは海と接触したことなんてなかったわよね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そうとも限らないが、はっきりとは覚えていない。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "なんだか、まるで知らないわけでもないように思う。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "すごく曖昧な答えね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "でも確かに、あなたの事情を忘れていたわ。それを思えば、そんなにおかしな答えでもないわね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "まあ、ケルシーがわざわざ呼ぶからには、何か理由があるんでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スカジ",
          "text": "行くわよ。もうじき暗くなるわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "私が水気を落とすまで、そこでお待ちになって。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "あら、先生。アビサルハンターの足取りを正確に追える人なんてほとんどいないのに、どうしてここに？　カジキからこの岸に上がると連絡を受けていたのかしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "エリジウムがこの海域に配備していた、情報収集装置を利用した。調整はすでに完了し、イベリアの眼の中央制御システムに接続されているのでな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "この短期間に、水中の測位システムをセットアップしたの？　あのリーベリもなかなかやるわね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "ロドスは裁判所との協力関係を深めている、と理解してもよろしいかしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "一週間前、かの水中都市が特殊な周波数を通じ、イベリアに向け告げてきた。エーギル本つ域（もとついき）と陸地を結ぶ「航路」を拓く、と。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "しかし、この巨大な計画を前に、イベリア側には大灯台の測位システムを除けば、情報を入手する手段がほとんどない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "言うまでもなく、総戦略設計士の一人である君も、この件については何も知らないだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "サメ、我々の発見をケルシーにお伝えして。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "私たちがスタルティフィラの沈没した場所に潜るのは、これで三回目。前回潜ってから、たったの十日しか経っていないんだけどね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "最初に潜った時はまだ、爆発後に残った船体が海底に突き刺さっているのが見えていたの。船体内部の金色が、海面から届くわずかな光を受けて、水で滲んだ絵の具みたいに光っていたわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "でも、今回見たのは、巨大な金属の船体構造が完全に消え去って、代わりに鮮やかなサンゴの森が現れている光景だった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "……夢を見るのは慣れっこだけど、あれが現実だとはとても思えないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "文明と歴史を追悼するあの記念碑が建っていたのは、本当にわずかな時間でしたわね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "「狂人号」はもはや、完全に海の一部と成り果てましたわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "正確に言うと、シーボーンの巣の一部にね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "シーボーンの環境同化速度が加速しているということか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "ええ、それもかなりの速さで。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "けれど、それより注目に値することもありますの。私たち、戦争の痕跡を発見しましたのよ。それも、少し前に起きたばかりと思わしきものを。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "海雪さえも見当たらないほどの、完全なる空白となった海域。明らかに小型の特異点に引き裂かれ、ねじ曲がったのであろう海底……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "それほどのことを成せるのは、エーギル正規軍の艦隊以外にないだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "陸を歩む者としては、あなたのエーギルに対する関心と理解は並外れたものですわね、ケルシー。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "果てしない海に隔てられていようとも、エーギルがテラの一部であることに変わりはないのでな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "ともあれ、私とグレイディーアはあの都市へ向かうことにするわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "それは紛れもなく、危険な決定だと言えるだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "確かにちょっと危険かもね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "ええ、相当に危険でしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "だからこそ、アビサルハンターは長い間、観察を続けてきたのですもの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "例の作戦より前、私はアビサルハンターの総戦略設計士として、科学アカデミーと技術アカデミーの軍事会議に参加しておりました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "けれど、当時両アカデミーが策定した戦争対応策には、陸に近い軍事要塞など存在せず、「航路」にまつわる計画もありませんでしたのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "そう思うと、エーギルには重大な異変が起きたと見て間違いはないでしょうね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "とはいえ、イシャームラを殺した後、本つ域との繋がりが完全に断たれている以上、既知の情報を繋ぎ合わせて真相を追うのは困難ですわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "それは君たちがエーギルへと帰還する十分な理由にはなり得ない。そもそも、初めに君たちを思いとどまらせたのは私ではなく、君たちのかつての僚友だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "……ウルピアヌスのことを仰ってるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "彼もきっと、陸には答えがないことを理解していたはずでしてよ。ですから、私たちは海に戻らねばなりませんの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "仮に、エーギルと距離を保つことが彼の策ならば、なおさら我々は正式な形でエーギルへ帰還しなければ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "……目を覚ましてからずっと、波が語りかけてくるの。迷える者は家路につけ、ってね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "スペクター",
          "text": "アビサルハンターは、故郷に戻らないといけないのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "理解はできる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "ならば私も同行しよう、グレイディーア。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "確かに、あなたにとっては貴重な機会ですものね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "この旅は私個人として、あるいはロドスを代表してというだけのものではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイディーア",
          "text": "では、イベリアも？　すでに負担をかけられすぎたその両肩に、彼らはさらに重荷を背負わせましたの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "これは私自身が選んだことでもある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケルシー",
          "text": "我々の協力関係が依然、始まったばかりであるように、ロドスとイベリア裁判所の協力も芽吹いて間もないものだ。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ケルシーがグレイディーアを見つめる。視線を向けられたその顔は海風に吹かれようとさざ波も立てず、無表情を貫いていた。\n短い沈黙の後、グレイディーアはうなずいた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "我々がエーギルからの連絡を受け取って、今日で何日経ったかね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "八日です、閣下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "この八日間、必要な準備と会議、休憩の時間を除けば、ずっとこちらで海を観察していらっしゃいますね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "エーギル側は明確な接触時間を提示しておりませんので、彼らの動向を見逃がすまいとお思いになるのはわかります。ですが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "眼前の海を見てみなさい、アイリーニ。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "何色ともつかない深い海から、波が打ち寄せている。海面が広すぎるせいか、空はより低く見えていた。\n潮水が岩礁にぶつかり、数メートルの波を起こしては、この狭い場所に轟音を響かせる。"
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "イベリアにとってこの海は、どれほど騒がしかろうとも、恐魚の血肉が渦巻くことさえなければ、慈悲深きものだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "私の古い友人は、かつて港都で最も才能に富む詩人だった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "壮大な港都が静謐に陥った後、彼はもがきながらも北へと逃げた。飢えた人々で埋め尽くされた地面を踏み、内陸深くの小都市に――後に首都となる場所にたどり着いたのだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "私は、彼が朽ち果てた城門の前でひざまずき、泣き叫び続ける様子を目にした。そうしてその都市は、彼の泣き声から新たな名を得るに至った。ペルドニドーラ、「許しは去った」という意味だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "だが、当時の人々が必要としたのは哀悼ではなく、慰めだった。ゆえに多くの者たちは、その名をただペルドニ――つまり「許し」と呼ぶようになった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "そして今、黄金時代の遺産である、最後のイベリアの眼が再び輝いた。これは何を意味すると思うかね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "希望と決心です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "「希望と決心」。無論その答えは正しい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "若人よ、それを口にする君の目は、若かりし頃のダリオよりも毅然としているな。実に素晴らしいことだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "しかし、そうした心を鼓舞する発言は、往々にして、最も正確な回答とは言えない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "我々は、半世紀の間繰り返し後退させてきた防衛線を、今、ついに再びここまで前進させた。この地はすぐに、裁判所の新たな中枢となるだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "しかし同時に、我々は海の、シーボーンの、そしてエーギルの前にすべてをさらすことにもなった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "イベリアにもはや猶予はない。この国が慢性的な疲労と困窮を隠し切れないことは、紛れもない事実だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "同様の事実はもう一つある――我々は二度と、後には引けないということだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "先生――あっ、アイリーニさん。お久しぶりです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "久しぶりね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "その服、よく似合ってるじゃない。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "あ、ありがとうございます。\nっと、そうだ、緊急のご連絡が。たった今、灯台が発信源不明の信号を検出しました。"
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "どうやら出所は海底ではなく、空のようなのですが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "ジョディ、それならもう肉眼で見えてるわよ……",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "カルメンとアイリーニは遠くの空をじっと見つめていた。若き書記は二人の視線を追ってそちらを見やる。\nそして、呆然と立ち尽くした。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "彼らは、飛翔する鱗獣の群れを見たのだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "あれは、なんでしょう？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "バイオドローンだ。昔「島民」が陸へ持ってきた物の中にも、似たようなものがあった。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ドローンの隊列は、高くそびえる大灯台に呼応するように、はるか遠くから瞬く間に海を渡ってやってきた。その中の一機が隊列を離れ、ゆっくりと三人の前に近付くと、その場で浮遊する。\n翼はひれのようにはためき、光の微粒子が虚空に舞い、親しみのこもった魅力的な女性の声が響いてきた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "（イベリア語）イベリアの皆さま、どうぞ警戒なさらないでください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "エーギルより、謹んでご挨拶申し上げます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "私はクレメンティア。エーギル本国における社会行政監督所、技術執政官の一人です。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "カルメンは灯りを掲げ、目の前のドローンを静かに直視している。\n二つの光のまったく異なる輝きは、まさしく二つのまったく異なる文明同士の対話、あるいは対峙のようだった。"
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "私はイベリア裁判所の聖徒、カルメン・イ・イベリアだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "恐らく、これが両国間では初の正式な交流となるだろうな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "左様でございますね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "貴女は随分とイベリア語に堪能なようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "本つ域を出る前に、イベリアの言語モジュールを自らにインストールしておきましたので。もし不適切な表現がございましたら、どうかご容赦くださいませ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "また、現状はこのような形でしかコミュニケーションが取れないことをお許しいただけますと幸いです、イベリア……閣下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "形式に異論はないが、こちらとしては、交流自体がこれほどまでに遅くなったことを遺憾に思っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "そちらが「航路」と呼ぶ計画はすでに後半に差し掛かったと聞き及んでいるが、それが目前に迫っていながら、イベリアはその詳細について何一つ知りえていないのだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "ゆえに、我々はイベリアの使節をこちらの都市へとご案内すべく、お迎えに上がったのです。シーボーンのもたらす危機が飛び火した際、イベリアが行ってきた努力を、エーギルは尊重しております。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "「飛び火」か。イベリアが直面しているのは、危機の余波に過ぎないと言うのかね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "はい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "外交辞令にこだわらずお話いたしましょう、閣下。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "言葉の力というものは、我々も認めるところです。カルメン・イ・イベリアというあなたの名、それ自体が、勇気と胆力の象徴であるのでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "エーギルがこの地を訪れたのはそのためです。我々はイベリア、並びに陸上諸国との協力を実現し、陸への直通航路の開拓を望んでおります。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "我々はエーギル本つ域から陸地へと至る広い海域を掃討し、エーギルの主力が海岸へと到達できるようにするつもりです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "……他国との国境まで大量の軍隊を派遣するという行為が、陸において何を意味するか、あえて口にする必要はないと思うのだが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "無論それは、来たる巨大な脅威に対抗すべく、我々が全力を尽くすことを意味するでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "必要とあらば、喜んで陸へお伺いし、すべてを詳しくご説明させていただきます。ですが私は、深海へお越しいただくほうが、我々の現状をより深く理解していただけると考えております。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "そのため、現在第八および第十軍団の艦隊が、道中のシーボーンを順番に掃討中です。完了次第、彼らが皆様をお迎えに上がり、我々の都市、ミリアリウムへとお連れする予定です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "無事に到着するまでの間は、このドローン編隊が皆様に戦況と環境の変化を随時共有いたします。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "海は今まさに、未曾有の災害に見舞われているのやもしれません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クレメンティア",
          "text": "一方で、大地がどれだけ広大であっても、それは単なる孤島に過ぎないと思うと、私は心配なのです。審問官閣下。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ドローンの隊列が光を失っていき、突如始まった通信は終了した。\n海風はなおも吹きつけており、老人は手にした灯りをゆっくりと下ろした。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "「陸への直通航路」ですか。言葉遣いこそ丁寧でしたが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "エーギルの傲慢さは疑いようもない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "鋭利な武器を手にした傲慢な大人は、何も持たぬ子供に対しては、謀りごとや策など弄するに値しないと考えるものだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "アイリーニ、今の通信内容を我々の協力者に共有しなさい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "ケルシー女史はすでに、イベリアの使節としてエーギルを訪問することに同意している。かねてより航路計画に疑念を抱いていたアビサルハンターも、今頃は決断を下しているだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "はい！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アイリーニ",
          "text": "グランファーロの他の審問官たちにも、迅速に伝達します。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "先生、先ほどのエーギルとの通信はすべて記録しておきました。どうぞお目通しください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "あの、僕の同行も許可していただくことはできるでしょうか……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "君は一週間前には申請を出してきていたな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "はい。エーギルの艦隊がもうすぐやってくるのなら、僕は、その……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "決断を下したのなら、ためらってはならない。君の発言が説得力を失うぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "……僕の小さい頃、ティアゴおじさんはいつも、心配そうな顔でこう言っていたんです。「ジョディ、お前はグランファーロを、イベリアを去るべきだ」と。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "それでも、どこへ行くべきかは教えてくれませんでした。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "エーギルは僕の故郷ですが、海の中にあって、近付くことはできなくて。僕はエーギルの声を聞いたこともなければ、その姿を見たこともありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "ですが今は、それがすぐ近くに迫っているんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "ジョディ・フォンタナロッサ。裁判所は君の申請を承認しよう。イベリアの使節として、アイリーニとケルシー女史と共に、エーギルの都市へ向かいなさい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "ありがとうございます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "いいや。裁判所としても、君にはまだまだ成長してもらわねばならん。これは単なる帰郷ではない、ということは覚えておくように。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "アイリーニを選んだのは、彼女がすでに準備を終え、このために自らが長く抱いてきた信念さえも捨てたからだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "そして君を選んだのは、君が今なお困惑と悲嘆を抱えているからこそだ。その弱さは、いずれ君を蝕むことになる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "聖徒カルメン",
          "text": "裁判所への加入と同じように、故郷へと戻ることもまた、君への試練となるだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジョディ",
          "text": "わ、わかりました、先生。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ロシナンテ",
          "text": "（興奮したいななき）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ここはすでに、海溝の最深部だ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "奴らは海溝両面の壁をくり抜き、内側に営巣しているようだな。道理で何度回っても見つけられなかったわけだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロシナンテ",
          "text": "（警戒するようないななき）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "ああ。俺も嗅ぎ取った。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "この匂い……シーボーンはここで本来の生態系を破壊した後、自分たちのためだけの生態系を築き上げたようだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "これほど完璧なシーボーンの生態系は、通常、海の深部にしか存在しないものだがな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "戻れ、ロシナンテ。この中へは俺一人で行く。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ロシナンテ",
          "text": "（不満そうに首を振る）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "大陸棚全体が変化している。一体誰が波を騒がせているのかを、知らねばならない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "騎士に伝えてくれ。狩りを止めるなとな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "これは一時の離別にすぎん。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ウルピアヌスは巣穴へと入っていく。\n彼は潜入を選ぶことはしなかった。というのは、発光する植物性のシーボーンが巣穴を隅々まで照らしており、身を隠す場所がなかったからだ。\n螺旋を描いて上へと伸びる分厚い葉の間に、奇妙な形の微生物が眠り、あるいは泳いでいる。\n元々海底にあったはずの岩は見当たらない。溟痕がゆっくりとその細かな触手を揺り動かし、有機物の欠片を捕らえている。それらは幾重もの菌鞘を形成し、ウルピアヌスの泳ぐ音をかき消した。\n彼は自らの身体の変化をはっきりと感じていた。意識は広がり、肉体は緩み、体内の細胞一つ一つが何かに反応しようとしている。\n彼はこの場所に侵入した異物であるにもかかわらず、巣穴全体が彼に向かって開かれている。"
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "Ul……Ul-pian……グ……Ul-pianus、同胞。",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "ウルピアヌスはシーボーンの透明に近い身体を見透かせるほどの位置まで接近していた。そして相手が、捕食してやる、あるいは捕食しろというような戯言を吐くのを待ったが、そうはならなかった。\nシーボーンは、ウルピアヌスの思考に思い巡らせていたのだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "つイに。オ前は、長イ道を歩ミ、辿リ着いタ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "ここ。栄養、十分。邪魔ナ血肉を、脱ぎ捨テよう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "回帰。成長。移動。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "フン。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "私ハ、オ前のたメ、生まレた。Ul-pianus、お前ノためダけに。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "お前ノ、疑問ヲ解く。一族ノ、抱擁に導ク。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "貴様らはなぜ移動を繰り返す？　一体どこを目指している？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "Ul-pianus、揺らイでいル、な。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "同胞、オ前は、大群を知ル必要がアる。大群ヲ、知リたイはズだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "初源ガ、目覚めヨうとシテいル。初源は、帰ラねばナらなイ。新たナ循環。海ノ、構築。海ヲ、去るのダ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "初源が目覚める？　海を去る……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シーボーン",
          "text": "大群。見タ。新たナ、長イ道。我ラは、でキるだケ早く――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウルピアヌス",
          "text": "……では、あの都市で今起きていることと、貴様らの間にはどんな関係がある？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
