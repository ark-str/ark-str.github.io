{
  "server": "jp",
  "storyId": "main_8_level_main_08-09_beg",
  "groupId": "main_8",
  "stageId": "main_08-09",
  "title": "再会の為の「離別」",
  "storyCode": "M8-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_08-09_beg.txt",
  "sourceHash": "a693fdd8f49ac4c8c36c46c219af8e3a16daf1cd88d13a144105c96e7d957535",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "司令塔の下で待ち伏せるとは、どこのレユニオン小隊だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "投降するか、それとも逃亡するか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "俺たちと戦うつもりなら止めはしない。だがそれは無意味であり、恥ずべきことだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "待て……この小隊の面子に見覚えはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "知らん。雪原を出てからレユニオンに加わったメンバーには興味がないのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "なんと言うか、こいつらはどこかレユニオンらしくないような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "Guardさん！　気をつけてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "（暗号）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "その暗号……ウルサス軍か！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "クソが……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "総員退避！！　ウルサス軍だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "死ぬまで口を閉ざし続けるつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "俺を裏切り者だと思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "ウルサス軍を離れ、卑しい感染者に肩入れするとは何事か、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "無価値な連中のために戦う、時勢の読めない不名誉な者たち……そんな俺たちの名前は、あらゆるリストから消されるべきだとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "お前は陰謀家の駒になって、自分の命を他人任せにしてるのか？　それとも、家族を人質に取られてここに無理やり送られたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "いずれにせよ、哀れなものだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "お前はウルサス人を殺したことがあるな？　殺したのは感染者か、それとも市民か？　その手を血に染めた時、怖ろしかったろう？　今でも夜はよく眠れないのではないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "先帝が崩御された後も、未だにあそこに残っているお前たちのような連中は皆……あまりにも哀れだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "無理するな！　早く後退しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "みんな気をつけろ！　ウルサス軍がレユニオンの制服を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ダメです、Guardさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "その伝令内容はマズいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "どうしてですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そんな風に言うと、敵も味方も疑心暗鬼に陥ります……情勢が混乱するほど、彼らが行動しやすくなってしまいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "エリジウムさんの推測が正しければ、私たちがまずやるべきことは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "誰一人としてここを通さないことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "けどあまり時間はありませんし、ほかのレユニオンがいつ司令塔に押し寄せてくるかわかりません……そうなったら統制を取って進攻するのが更に難しくなります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですので、全員がこの戦闘に加わる必要はありません。そもそも、対タルラ戦においては、軍編制されていない小隊では役に立ちません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "なので……私が行きます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "後退だ、後退しろ！　破城矛の射撃に気をつけろ！　遮蔽物に身を隠せ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "アーミヤさん！　あなたはまたそんなことを……！　あなたはロドスのリーダーなんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "「なおさら私が行くべきなんです」とは言えませんが……これだけは言えます。もし自分にしかできないことがあって、それが本当にやり遂げなきゃいけないものなら、私はためらわずにやります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドス前衛オペレーター？",
      "text": "じゃあその援護は誰が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "私がやる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "盾兵たち、あなたたちの負傷者も動員して、戦線を安定させて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "フェリーン……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "あいつらは今も特殊感染者たちのことを追い立ててる。ひどいやり方だし、優しさなんて少しもない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "私があいつらの陣地と待ち伏せ地点を破壊する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "……了解した！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "フェリーン、部外者にウルサス盾兵と遊撃隊戦士が手を貸すのは、お前が初めてだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まだ幼い術師が手を上げる。戦場の騒々しさをよそに、彼女は深く集中していた。その眼差しは燃え盛る炎のように強く激しい。\n以前の彼女は、恐れと痛みから、過ぎ去っていく記憶をひたすら追い続けていた。\nしかし今、友人との約束、そして仲間と共有している責任が、彼女をそこに踏みとどまらせていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "違う、私は部外者じゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "私たちはこの都市を止めなきゃいけない。今はみんなで一つの部隊――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロスモンティス",
      "text": "だから、部外者なんかじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "盾兵",
      "text": "盾兵！　盾を構えろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
