{
  "server": "jp",
  "storyId": "act15d0_level_act15d0_04_beg",
  "groupId": "act15d0",
  "stageId": "act15d0_04",
  "title": "勇敢、かつ無鉄砲",
  "storyCode": "MB-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act15d0/level_act15d0_04_beg.txt",
  "sourceHash": "9b172a723d5e0465419065eccdf15baaa8b640215d51b74de846bcbcfb6cdbef",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "サイレンス、大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "平気。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ずっと戻ってこないから、様子を見に来たんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あれ、この瓶……まさかお酒を飲んでたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ちょっとだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ミュルジス主任は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あっちで私たちを待ってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "どこまで話したの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "アンソニーがカフカに助けてほしいって言ったとこまでだよ。それと統括とサリアに関することを教えてもらった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "聞きたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "いや、今はいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "なんだか辛そうだね……さっきミュルジス主任から嫌なことでも聞いたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "違う……いや、違わないんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "なんと言うか……上手く言えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今は頭が混乱しているの。後悔も少し……自分には向いてないことをしてしまったんじゃないかって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "今回の件について言ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……私はあなたに謝るべきだね、メイヤー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたを巻き込むべきではなかった。それなのに私は臆病だから、今回の件をあなたに話し、一緒に抱え込ませてしまった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "いや、私は全然大丈夫だよ。これでもサイレンスに信用されて結構嬉しいんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "それにどうせ私が実際にやったことといえば、サイレンスに付いてクルビアを一回りしただけだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……実は、ずっとメイヤーに言ってなかったことがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "この件の……ハイドブラザーズの背後には、エネルギー課がいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "え？　エネルギー課が！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたたちエンジニア課とエネルギー課は密接な関係にあるから、どうやってあなたに伝えようかずっとわからずにいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うん……まあ大したことじゃないよ。確かにうちの課は、業務上エネルギー課とかなり近い関係にあるけど。でも私、実はエネルギー課があんまり好きじゃないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "っていうよりエネルギー課のあの主任が怖いんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "エネルギー課の主任って、どんな人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うーん、そんなに頻繁に会うことはないんだけど、時々うちのところに来たり、会議の傍聴をしたりするんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "確かに彼の発言は的を射ていて、賢い人だなっていう印象だけど、なんだかちょっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "なんて言えばいいのかな……私たちの研究を何に使うことができるのか、何をもたらすことができるのか、そういうことをやたら気にしてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "なるほどね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あと、サリアが責任とって辞めてから、うちの課とエネルギー課の関係はさらに近くなったって感じるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "時々変な仕事を割り振られて、自分の研究ができないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "だから派遣のチャンスに飛びつくようにしてロドスに来たんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "確かにクロージャも変人だけど、ロドスでの仕事は結構楽しいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "とにかくそんなに気にしなくていいよ、サイレンス。それに、私はサイレンスが正しいことをしたと思ってる、違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "正しいこと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君が提供したこれらの情報と分析資料は、非常に高い価値がある。君の意見を重視せざるを得ないな、サイレンス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "じゃあ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "しかし、これらの情報の出所は明らかにライン生命の内部だ。内部情報を無断で他所に流す者を、すまないが、私は信用できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "しかし、君の日頃の行いを見るに、君がそのような軽率な者であるとは思えない。だからまずは説明をしてもらいたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "これらは、私が個人的なルートで収集し分析して得た情報であり、ライン生命とは直接的関係はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "そうだとしても、ライン生命内部で提出し処理されるべきだろう。ロドスがこの件の仲裁人になることは決してない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……いえ、私は別にロドスに仲裁を望んでいるわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私はただこの人を助けたい。そしてあなたの意見を聞きたいだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "なぜ私なのだ？　というより、なぜロドスなのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今の私は、ライン生命より、ロドスの方を信じているから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君はライン生命の何を疑っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "わからない……自分が何を疑っているのかさえわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも、私もここで働き始めてからだいぶ時間が経っている。ロドスの活動を自分の目で見て、少なくともロドスが何をしているかはわかっているつもり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "目で見たものが必ずしも真実とは限らないぞ、サイレンス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "今回のこともそうだ。このアンソニーというフェリーンの男一人だけが、バンカーヒルシティではなくアイアンフォージシティの監獄に収容されている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "資料には、彼がアイアンフォージシティまで逃れて、そこで捕縛されたためであると記載されているが、果たしてそれだけなのだろうか。私には目に見えない意図が隠されているようにしか思えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも事実としてアンソニーは今日まで監獄を出られていない。彼はすでに六年も投獄されているし、そして恐らく永遠に出られないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "どうして君はこんな無関係の者にそこまでこだわるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私はハッキリさせたい。自分がずっと奉仕してきたライン生命が、本当はどんな企業なのかを。アンソニーはそのための手掛かりになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君は失望するかもしれないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも何も知らないよりはまし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "……確かにその論理は普遍的な説得力を有することを認めよう、サイレンス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ロドスは表立って君をサポートすることはできない。だが個人的な立場でなら、私の意見を述べても問題はないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "君には最後まで君の思いを貫き通してほしいと思っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "私の……思い？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "自分が正しいことをしているという思いだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今になって少し疑問に思う。これは本当に正しいことなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "えっ、どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "メイヤー、私は少し怖くなってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "何が怖いの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "これまでずっと、あらゆる問題は、努力すれば必ず解答を得られると考えていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "でも今回は、解答できない問題にぶつかったんじゃないかと思うと少し……怖い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "問題が解けないってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "解けないんじゃない、解く勇気がないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "メイヤー、私とカフカがどうやって知り合ったか、彼女はあなたに話したことはある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "ん？　忘れたの？　ミナとの会話で言ってたよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ミナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ふぅ、やっとミナと話す隙を見つけたよ。成果はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "カフカさんに言われた通り、ここしばらくはこの監獄の構造をこっそりと探っていました。今はもうほぼ全容を把握しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "看守は気を抜いていますが、それもそのはずで、この監獄の構造はかなり強固なものです。抜け出すのは至難の業でしょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "大丈夫大丈夫、何とでもなるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "それより、そっちはどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "アンソニーとは接触できたよ。彼はもともと抜け出すつもりだったみたい。だからプランAでいこう。アンソニーの脱獄を手伝う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "これからは医務室を秘密基地にするよ。あそこのドゥーマ先生に、ミナのことは話してあるから、直接行っても大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "そうですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "どうしたの？　念願のデカブツさんに会えるっていうのに、なんでそんなに元気ないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "何でもありません。ただ……何度か遠くから彼を見ましたが、以前私の家を救ってくれた時とは違う人のように見えて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "そうなの？　前はどんな感じだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "前はもっと、うーん……カッコよかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "なにそれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "彼が私の家を救ってくれたと知って、一度こっそり見に行ったことがあるんです。その時の彼は今よりもずっと明るい人でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "どんなふうに？　湯水のようにお金を使って、後ろにボディーガードを十何人も引き連れてるようなお坊ちゃんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "違いますよ！　んー……私もどう説明していいかわかりませんが、多少はそんな感じだったかもしれません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "じゃあお坊ちゃんじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "いずれにしても、今の彼はとても寡黙で、感情が読めません。それを見ると少し辛く感じます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "まあここに六年も閉じ込められてるからね、どんなに明るい人でもそういうふうになっちゃうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "確かにそうですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "だからカフカたちが手伝って脱獄に成功すれば、アンソニーだって前みたいな明るい人に戻るよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "多分ね。あでも、お坊ちゃんに戻るのは良くないと思うな～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "私はいいと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "はいはい。ミナの好みはよくわからないや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "それを言うなら、カフカさんの方がよくわかりませんよ。サイレンスさんっていう友達に頼まれてデカブツさんを助けに来たと言ってましたが、どうしてその友達のためにそこまでやるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "……だってサイレンスは良い人だと思うから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "どういうことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "うーん……カフカたちが知り合ったのは、サイレンスが外勤に出ていたある日のことなんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "その時カフカは、あんまり人に言えないような仕事をしてたんだ。そしてそれをサイレンスに気づかれてしまったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "あの時は、結構大きな騒ぎになってね、サイレンスのせいで危うく取引がなくなるとこだったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "でも結果オーライかな。仕事はなんとかなったし、サイレンスとも知り合えた。雨降って地固まるっていうことわざがあるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "それからサイレンスは、時々色んな仕事を紹介してくれて……カフカにもちゃんとした仕事をしてほしいって思ったみたいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "確かにすごく良い人ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "そうだよ。でもサイレンスは、この大地を美化し過ぎなんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "彼女が考えてるように物事が運ばないことも、実はたくさんある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "サイレンスはちょっとロマンチストだけど、とっても賢いし、頭が固いわけでもない。だからカフカは、サイレンスはずっとそれでいいって思ってるし、彼女と友達でいられることが嬉しいんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "カフカに友達はいっぱいいるけど、サイレンスみたいな人はほかにいないよ。だからサイレンスを大事に思ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "だから彼女のために監獄に入ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "あー、でも全部が全部じゃないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "この監獄のことは前から聞いていて、ずっと興味があったんだ。それが理由の一つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "もう一つの理由は、今回のサイレンスの様子が少し違ったってことなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "カフカさんに他人の脱獄の手伝いをさせたってことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "うん。それから、いくつかの企業の情報を集めてほしいってお願いされたんだ。これまでのサイレンスの性格だったら、こんなことをするなんて考えられないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "うーん……彼女に何かあったんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "わからない……サイレンスがクルビアを去ってロドスっていう会社に行ってから、カフカたちは会ってなかったから。手紙でしかやり取りをしてないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "クルビアを去った理由もハッキリとは言わないし……でも、きっと何かあったんだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "とにかく、今回のサイレンスはすごく思い詰めている感じだった。だからカフカが助けてあげるつもりなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "……カフカさん、もしかしてあなたってすごく良い人なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "えぇ？　まさか君の目にはカフカが悪い人に映ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "私は、あなたがどうやって私を騙してこの監獄に連れて来たのか、忘れてはいませんよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "アハハッ、でもさ、突然知らない人に一緒に監獄に入ってくださいなんて言ったら、絶対頭おかしい奴って思われるでしょ？　だからある程度の作戦は必要だったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "はぁ……もういいですよ。あなたには敵いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "へへ、でもさ。間違っちゃいないけどね。そういうのって、良い人だとか悪い人ってくくりで判断できることじゃないと思うし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "例えば家を救ってくれたアンソニーのために、君があえて危険を冒してるけど、やってることは脱獄の協力……これは良いこと？　それとも悪いこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "もし、友達のために身を捧げることが善良な行為だと言うのなら、カフカの友達の中にいる良い人の数は、そこら辺のいわゆるまともな仕事をしてる人よりも多いってことになるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "でも悪いことをしてる人が良い目的を持っていたとしても、その人が良い人って呼べるわけじゃないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "うん……そうかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "だったら最初から自分は悪い人だって認めた方がすっきりするよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "看守",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "あっ、看守が来た、仕事に戻らなきゃ。じゃあまた医務室でね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "text": "ミナも早く行った方がいいよ。ここの囚人たちは、またすぐ喧嘩しだすかもしれないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミナ",
      "text": "はい。カフカさんも気を付けてくださいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
