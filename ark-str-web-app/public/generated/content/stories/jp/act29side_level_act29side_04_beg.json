{
  "server": "jp",
  "storyId": "act29side_level_act29side_04_beg",
  "groupId": "act29side",
  "stageId": "act29side_04",
  "title": "狂想曲「想望」",
  "storyCode": "ZT-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act29side/level_act29side_04_beg.txt",
  "sourceHash": "b120ee906e0bedd1f3d8fab6e019c007c9554fa1f259c83e660198848f77e954",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "すみません、アルトリア先生、また間違えてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "どうして止めるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "前の行の最後の一小節がうまく弾けなかったので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたの感情は正しいわ。旋律にとらわれないで、意志で旋律を導くのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "どうしても自分のミスについて考えてしまうんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "それなら我慢しなくていいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "音楽はあなたの心の声。あなたが自分を表現するための言語よ。発声を学ぶ前に文法に縛られてしまうと、言語は意味を失ってしまうわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたの恥じらい、自己不信、未来への渇望……どれもが本当の感情だわ。それらを、あなたの音色の中で生かすのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "ですが、アーツの授業の先生はそうは言っていませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "アーツとは厳格な学問分野であるとおっしゃっていました。無関係な音符の集まりを美しいコードに構築するのと同じように、本質は混沌の中で秩序を発掘することにあると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "しかし私は雑念が多すぎるため、チェロの音がひどく乱れ、そのせいでアーツエネルギーもうまく制御できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私にはあなたのほかに、もう一人の教え子がいたわ。彼もあなたのように、謙虚で、内気で、感情の表現ができなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "そ、その人はどうなったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "とても勇敢な人になったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "残念なことに、私が望んだのように、幸せな暮らしをずっと続けられたわけではなかったけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "だけど幸運にも、彼の最後の演奏を聞くことはできたの。彼の叫びは……同じ姓のかの大音楽家と比べても遜色がなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "その生徒さんはどの大音楽家の子孫なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ヘーアクンフツホルン。彼の曲は聞いたことある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "え……今なんて？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたたちが巫王と呼ぶ人よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "か、かの陛下ですか？　その、かの陛下の名前を直接呼ぶ人なんてほとんど聞いたことありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そうなの？　でも私にとって、彼は何よりもまず一人の音楽家よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "えーっと、かの陛下は後期には通常の楽器で演奏しなくなったと言われていますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "その音楽……いえ、その音はもはや音楽とも思えないもので、耳にした全員が恐怖を感じたとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ええ。彼の旋律は調和とは一切無縁よ。小節一つ一つが前の一節を聞いた時の予想を超えていくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "だけど私はこれほどまで……強い意志を感じたことはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "キャンパス内で絶対にそんな話はしないでくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "積極的な学生",
      "text": "女帝の声や憲兵たちが常にルートヴィヒ大学を監視してるらしいですから。もし聞かれでもしたら、面倒なことになりますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "宿舎に戻りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "引き続きこの曲を練習するのよ。外でどんな物音がしても、あなた自身の旋律に集中するの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "彫刻から響く奇妙な声",
      "text": "アルトリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなただったのね。あなた自ら口を開くからには、舞台が始まるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "彫刻から響く奇妙な声",
      "text": "そんなところね。来るべき者は続々と到着している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "彫刻から響く奇妙な声",
      "text": "これまでと同じように、あなたは私のために今日起きたことを全て奏でてくれるでしょう？　旋律が響く時、私はここで聞いていたいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "最初から最後まで聞くつもりかしら？　この曲はきっととても長くなるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "彫刻から響く奇妙な声",
      "text": "今日は多くの人が傷を負い、死に至るでしょう。犠牲は私によって起こるのだから、私は、私が向き合うことから逃げるのを許さないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "辛く苦しいと思っているのに、誰よりも意志が固いのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ねぇ……私の演奏があなたの命の終わりにたどり着いた時、私は何を目にするのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ルートヴィヒ大学。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "多くの本の中でこの名を見たことがあります。最近ですと……最先端のアーツ理論雑誌ですね。最も古いものは、秘密の術式が刻み込まれたアーツの巻物でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "その校章はリターニアのアーツ史において燦然と輝いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "ウルティカ家の紋章が形を変えたにすぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "それでもリターニアで最初に設立された大学であることに変わりありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "かつて想像したことがあります。ああいった場所でキャンパスライフを送るのは、どういったものなのかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "紅葉に覆われたキャンパスを歩き、そばには同年代の友人たちばかりで、図書館には読み切れないほどの本があって……このような毎日はきっと充実したものでしょうね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "女帝の特別許可があれば、君はリターニアのどの学校にも自由に出入りできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "そうですか……行き交う学生たちの目をご覧になりましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "知識への渇望は、互いの出自の隔たりを一時的に忘れさせることができるようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ルートヴィヒ選帝侯が自らの高塔を「大学」として確立する前、知識は権力により高塔に封じられていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "それなのにどうして私が……再び権力によってこの得難い純粋さを汚すことができましょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……憲兵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "いわゆる純粋さなどというのは、現実には存在しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "あなたが彼らを呼んだのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "呼ぶまでもない。高塔の上の視線は、リターニアの土地から離れたことなどないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "特にこの場所。君の眼前にそびえるのは、ウルティカ領最古の高塔である。巫王はかつて塔内で十数年過ごし、即位後も頻繁に戻ってきていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "上辺は平和らしく見えるこのキャンパスであるが、どこもかしこも巫王と切り離せない関係を持っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "我々が探しに行こうとする者を含めて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ゲルハルト・ホフマンさんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "いや、その前に彼の師にあたる者を訪ねる。ルートヴィヒ大学を最もよく理解している人物だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "巫王の時代……いや、さらにはるか昔から現在に至るまで、彼はこの学校の最古の高塔に居続けている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "……学校内にどうしてこんなに憲兵がいるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたは私が指名手配犯だと言っていたと記憶しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "あなたを捕まえるために？　ありえません……それに、かなり慎重にここまでやってきたんです。憲兵に目をつられるはずがありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "早くどこかに隠れましょう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "第五隊六隊は前を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "四隊はこの塔をくまなく捜索しろ。怪しい奴は誰一人逃すな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "いや、やめてください。そんな歩き回って好き勝手アーツを使うのはだめです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "ここは大学なんですよ。僕たちが行う研究の多くは、安定した環境が必要不可欠なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "ほんのわずかな変化であっても、精密なアーツ計器や複雑な術式に不可逆的なダメージを与えるかもしれないんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "捕らえろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "どうして？　僕は何も法律違反していません！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "お前名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "ルイ、ルイ・シュニッツラーです。って、先に質問したのはこちらでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "フォルツガルドのシュニッツラーか？　教室まで連れてけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "引き続き捜索しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "平民は中庭に、貴族は教室に閉じ込めておくんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "ウルティカ家と関わりを持ったことがある奴は全員監視下に置け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "僕はただ名字がシュニッツラーなだけです！　僕の父は爵位すら継承していませんし、そんな数十年前の昔の出来事でどうして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "我々が調査しているのはその昔の出来事だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "シュニッツラーお坊ちゃま、おとなしく待機していろ。余計なことをしなければ、何も危険はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "うちの一族は今度の祭典に参加するんです。女帝陛下に謁見するんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "ルートヴィヒ大学はリターニア最古の大学。二十三年前ですら、女帝の軍隊はここの高塔のレンガ一つだって傷つけなかったんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "腑に落ちない学生",
      "text": "何の権限があって知識と芸術をこれほどまで侮辱し、リターニアの伝統を踏みにじるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "女帝の命令の権限があってだ、若造。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "我々の憲兵隊上官を殺害した犯人がこの学校に潜んでいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "憲兵",
      "text": "学校を守りたければ、同級生たちに伝えるんだな。奇妙なサンクタや巫王派の残党に関する手がかりがあれば、率先して報告しにこいと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "……女帝の命令？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "そんな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "とても驚いていますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "驚く？　いや、僕は本当にバカだったんですよ。まさか思い至らないなんて。彼女の性格と手腕であれば、無関心であるはずありませんよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "僕はもうこれ以上アルトリアを追えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなたの任務目標もアルトリアだと思っていましたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "アルトリアは任務の一環です。僕の……依頼人は、アルトリアの存在が我々の計画の妨げとならないように、彼女の行動目的を知りたいと思っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "ですが今はより大きな危機が生じました。計画自体を狂わせるわけにはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "その他に聞きたいことはありません。あなたはリターニア人なので私が執行する必要のある遺言もないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "まあいいです。あなたの口からまともなお別れの言葉が聞けると期待するべきじゃなかったですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "執行人さん、アルトリアが関わっている事件はあなたが想像するよりはるかに深刻です。たとえあなたたちの教皇様でも、手出しする資格はありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャ",
      "text": "善意の忠告だと思ってください。憲兵に見つかる前に、任務を放棄して、ツヴィリングトゥルムから立ち去った方がいいです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "評価完了。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "当該任務に放棄の選択肢はありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "着いたぞ。ドロステ、君は外で待て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "え？　危険は感じませんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "動くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "動くな……何がでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私のパイプの邪魔をするな。そう、煙が出ている左手のそれだ。それ以上動いたら、煙の輪が通った後に、お前の左手が元の位置にある保証はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "パイプをアーツユニットにしたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "アーツユニット？　バカを言うな。タバコは休憩のために吸うものだぞ！　どこのマヌケが仕事なんて考える！　私は実験をしていただけさ。煙の輪が双子の羊の塔のてっぺんまで届くかどうかのな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……我々は真面目な話をしに来た、フレモント殿。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "本当にお前は見た目だけで場を白けさせるな、ライナー。そっちの鹿のかわいこちゃんの方を見習え。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "私も煙の輪が何十キロも飛ぶのかどうか見てみたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "いや、距離は重要ではない。重要なのは……金ぴかで目に悪い甲冑が傍をうろちょろしないことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "まあいい、興ざめした。言え、お前をここに寄越したのは陰鬱な羊か派手な羊か？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "つまり金律楽章の副本を失ったと。しかも、よりにもよってシュトルムウィンドにやった一冊を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "お前らは揃いも揃って穀潰しか！？　何が金律法衛だ。大層な名前をしやがって。楽章すら見張っとけないとは、そのキラキラしい甲冑は高塔のてっぺんに飾る他に何の役に立つんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "グリムマハトもグリムマハトだ。何が、渦の中心から離れた方が安全だ。あいつもお前たちと一緒にいすぎてマヌケがうつったな！　まさか本当に角がでかいほど知能が落ちるのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "あのシュトルムウィンドの小僧にしたってそうだ！　自分の命に替えても約束を果たすとか何とか抜かして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……ウェルナー選帝侯はもう亡くなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "あなたの前にいるのが、彼の娘だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ご機嫌よう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "すまなかったな――もしこの言葉が必要であればだが。だがそれでも今回の件がマヌケすぎる事実に変わりはない。特にグリムマハトはすぐに連絡も寄越さなかったのだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "盗まれた楽章はそれほどまで特殊なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "二十三年前、ウェルナー選帝侯はツヴィリングトゥルムからシュトルム領へ戻った時に、その楽章を携えていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "女帝と選帝侯本人以外に、それに近づける者はいない。恐らく、巫王時代に広く伝わった多くのアーツ装置と同様で、楽章にはは巫王の術式が残っているのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "巫王の術式……巫王の術式！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ルートヴィヒ大学の入り口にもあやつの術式がある。道端の甲冑にブレイクダンスをさせるといったようなものがな。だがそんなものに意味はあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "グリムマハトから聞いていないのか？　あの副本はそんなデタラメな術式ではなく、ヘーアクンフツホルンが最強の敵に打ち勝つために一生をかけ開発した切り札なのだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "巫王が打ち勝った最強の敵とは、まさか、ガリアのコルシカⅠ世ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "たった一人の君主、一つの軍隊にすぎん。世間一般の意味で言われる「強大」など、全盛期のヘーアクンフツホルンにとっては取るに足らん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "あやつが当時打ち勝ったのは、全リターニアの意志だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……金律楽章。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "フン。さすがにそこまで愚かではないようだな。リターニア帝国の誕生以来、金律楽章はたった一度だけ変更されたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ヘーアクンフツホルンは、リターニアの歴代先賢、つまり金律楽章の構築のために力を注いだ全アーツ大家に一人で挑んだのさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "気分はどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "頭は……はぁ……痛みはだいぶ引いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "痛みを引き起こしているのは傷口ではないため、普通の治療術ではあまり効果がありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "そんなことは言われるまでもない。邪悪な老いぼれが私に向かって癇癪を起しているだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "あなたは……本当に彼の声が聞こえるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "たまにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "きっととても苦しいでしょう。巫王の声は彼の旋律と同様、常人では耐えられない力を持ちます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "彼が人を殺したいと思えば、軽くハミングするだけで事足ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "貴殿は彼に会ったことがあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "私の師、フレモント先生は、巫王が最も重んじた親友です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "かの陛下が巫王の塔の最も高くに座していた頃、数千の術師が玉座の前の階段にひれ伏していました。そして私も……そんな術師の中の一人でした。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "貴殿も……\nうっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "また頭が痛みますか？　怖がらなくて大丈夫です。その後私は彼を裏切りました。私は反抗部隊に加わり、グリムマハトとイーヴェグナーデが率いる中で巫王の塔に突入したのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "あの日、かつて私がひざまずいた階段は……ルートヴィヒ大学の紅葉よりも色鮮やかになりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "きっと厳しい戦いだったのだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "私と肩を並べて戦った友人で生き残ったのは……一割にも満たないです。彼らは皆かつてこの国で最も才能ある者たちでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "もし彼らが私のように運良く生き延びていたら、必ずやもっと優秀な学者や偉大な術師になっていたでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "道理であの日密林公園にいたわけだ。貴殿とその犠牲者たちに敬意を表すべきだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "体力を使わないでください……もったいないことですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "つらいのであれば、もっと私に寄りかかっていいですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "そいつを放せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "レッシング……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "やはり追って来たんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "フレモント先生は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "爺さんはあなたにとても失望している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "申し訳ありません。レッシング、私はあなたを傷つけたくないし、先生を敵に回したくもありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "じゃあなんで俺たちの邪魔をする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "「始源の角」をこのまま降臨させるべきではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "俺たちは悪いことをしてるわけじゃない。もとから俺たちのだったものを取り戻して、ついでに敵を打ち砕こうとしているだけだ。あなたはそのことをよく分かっているはずだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "巫王が残した遺産は……誰のものであるべきですか？　誰がそれを決めるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "レッシング、あなたは頭が良く真っすぐです。二十年、三十年後に後悔しないように、もう一度よく考えてください。あなたは私の最も気に入っていた教え子だからこそ、同じ轍を踏んでほしくない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "俺も……あなたを師と仰いでいた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "たしか、フレモント先生がその剣をあなたに渡した時、あなたの身長はまだ剣の半分にも満たなかったですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "あっという間に、こんなに大きくなって、もうすぐ私が巫王の塔に攻め入った時と同じ年齢です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "学校の中で過ごしていると、時間は一層早く過ぎるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "俺が心配しているのは、俺がまだ弱っちく、守りたい人のために剣を振るうに相応しくないのではないかということだけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "巫王派の残党、お前の狙いは私だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "目標である私からお前への言葉はただ一つ――今すぐ失せろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "もうすぐで授業が終わる時間になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "こっちへ来てください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの学生",
      "text": "マイヤー、こんな所に立って何してんだ？　今日は聴講する授業はないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの学生",
      "text": "おい、どうして校舎で剣を持ってるんだ？　ほんとにトレーニング中毒だな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "……あえてこの道を選んだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの学生",
      "text": "聞いたか？　今日は憲兵たちが学校に入ってきてるらしいぜ。会う人ごとにチェックして、特にお前みたいなウルティカ領出身の平民は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの学生",
      "text": "待てよ、走るの速すぎるだろ？　階段を飛び越えるなんて、学校で禁止されてるぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "大丈夫ですか？　私のためにそこまでする必要はなかったのに。私の方がずっと年上なんです。あなたを守らなければならないのはこちらなのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "はぁ……はぁ、彼の目的は私だ。もう誰にも私のために血を流してほしくはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "レッシングの能力と性格からして、すぐ追いついてくるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "もっと安全な道を行かなければなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "我々は学校にいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "ルートヴィヒ大学です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "あなたはウルティカ家の血筋です。もしあなたが生まれた時に巫王がまだ在位していたら、あなたもここでアーツを学んでいたことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……あいつの血など引きたくなかったがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "ウルティカ出身のリターニアの君主は一人だけではありません。巫王と他の数名の皇帝以外にも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "ルートヴィヒ、人々に「学士」と称されるかのアインヴァルト管区の選帝侯もまたリターニアの皇帝になる一歩手前でした。彼もあなたの先祖です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "皆に等しく「最上の知識を身につけ」させ、大地によってリターニアが「これ以上の制約を受けないように」する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "一族が所有していた高塔をすべてのアインヴァルトの民に開放すると彼が独断で決めた時、多くの人が彼を狂人だと見なしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "狂人か……フフッ、ウルティカ家の者を形容するのに、本当によく使われる言葉だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "狂気と偉大の併存、これはかねてよりウルティカ家の伝統でした。巫王も、狂気に陥る前は、傑出した才を持つ明君だったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "狂った暴君は、狂った一般人よりはるかに恐ろしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "もしウルティカの伝統が私を狂気に導く定めならば、その前に人のいない隅を見つけ、どうにかして全身の血を引き抜いてやるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "初めて会った時から、あなたの芯にある勇敢さは見て取れました。ですがあなたの命はとても貴重です。自己犠牲だけが、道ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "フランツ……あなたのことをフランツと呼んでもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "捨てた本名を知っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルハルト",
      "text": "これからはもう孤独でいる必要はありません。私があなたの力になりましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "……ゲルハルト・ホフマン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "私の教え子の中で、金律楽章とは何かをあいつが最もよくわかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "あいつがここにいてくれれば、私がこんな話に時間を費やさずに済んだのだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "なぜ私たちの来意をご存知なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "来意だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "巫王派の残党は私の父、そして二十三年前のあの政変に関わった他の二名を殺害しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "次のターゲットはホフマンさんだと、私たちはにらんでいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "フッ、お前たちは本当にタイミングが良かったな。ちょうど十五分前に……待て、今何と言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ゲルハルトが、巫王派の残党と関わりがあると？　どうでもいいコンサートホールを爆破するために、ヘーアクンフツホルンのひ孫に実験を施した「残党」どもか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……恐らく。彼らが本当に同一グループであるとは限らないが、同じような名目で動いているのは確かだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "ところで、あなたはなぜヴィセハイム事件についてそこまで知っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "このエネルギーの波動は……空間構造の安定を維持するために用いる術式が残した痕跡。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "アインヴァルトの術師軍が使用する術式と元を同じとする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ガキの手ほどきのためのおもちゃと私の術式をを同列にするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "今のアインヴァルトは言わずもがな、ヘーアクンフツホルンがまだいた頃も、あやつが下の者をしつけるために用いていた空間術式は私が教えたのだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "ドロステ、下がれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "剣に触れてどうした。抜くつもりか？　私の計器から離れろ。それとこの塔は数百年修理されていないのだ、衝撃に耐えられん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……フレモント殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "あなたが先ほどここで行った実験は、「塵界の音」と関係があるのでは？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
