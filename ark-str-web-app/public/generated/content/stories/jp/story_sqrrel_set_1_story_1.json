{
  "server": "jp",
  "storyId": "story_sqrrel_set_1_story_1",
  "groupId": "story_sqrrel_set_1",
  "stageId": null,
  "title": "火の用心",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_sqrrel_1_1.txt",
  "sourceHash": "de906a34013befdf3993a51ae7487806a4ac136e1debc7d350e1aec73944f0e8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "sqrrel"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "スゥ……ハァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "緊張しない。緊張しない緊張しない。絶対に緊張しないぞ……フゥ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ダメだ全く効果ないよあああああどうしよう、明日が第二回の講義だなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "うぅっ、胸が苦しくて息ができない……うぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "……フゥ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "やっぱりどうしても緊張しちゃう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "原稿の調整も上手くいかないし……も、もっと簡潔でわかりやすくして、段落に分けて、一文は二十文字以内にしないと。前回みたいなことがないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ううっ、それと話す速度……でも……こればかりは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "こればかりは制御できないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "うわぁ！　あっ……アラームか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "もうこんな時間！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "今日は設備点検がまだだし、報告書も整理しないと。このままじゃダメだ、職務怠慢は絶対に許されないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "しっかりしないと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "貴方ね、謝りたいなら一人で行けばいいじゃないの。なぜわたくしまでついて行かなければなりませんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "まさか恥ずかしいのかしら。あなたが？　冗談でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "あ？　誰が謝りに行くっつったんだよ？　オレサマはな……はぁ、ウゼェ……とにかくちげーんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "なら手を離してくださる？　そんなに引っ張らないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ヤだね！　クソッ、もしサイレンスとドクターが、あれは良くないことだなんて言わなきゃ、オレサマだってわざわざ説明しに行こうなんて思わねーよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ちょっとバーベキューしただけじゃねーか。あんなことになるなんて思わなかったんだよ……もう最悪だ、仏頂ヅラに借りたノートまでびしょ濡れになっちまったし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "あら、貴方がちゃんと勉強してるという話は本当でしたのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "な、なに笑ってやがる！　いけねぇのかよ？　ってかオマエだってオレサマと同じように燃やしたじゃねぇか、なんでオレサマだけ怒られなきゃなんねぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "だって貴方とは違いますもの……わたくしのはうっかりですわ！　わたくしだってあの時、突然制御が効かなくなるなんて思っておりませんでしたわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "んなの知るかよ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おい静かにしろ！　見つけたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "声が大きいのは貴方だけでしょう！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "換気状態良好。非常口に遮蔽物なし。非常灯異常なし。消防設備異常なし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "よし、この通路は問題なし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "次は生活エリア、そして医療エリアと甲板か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ふぅ、夕飯前には全部点検できそうでよかった。その後は今季の火災リスク評価に、パンフレットの配布……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "まずい、どう見積もっても時間が足りないよ。どうしよう、明日の講座の準備も終わってないし、このままじゃまた失敗しちゃう……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おい！　呼んでんだろーが！　無視してんじゃねぇよ、失礼なヤツだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "失礼だなんて、貴方がそれを言えますの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "えっ？　は、はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "あっ、イフリータさんにスカイフレアさん！　申し訳ありません。仕事のことを考えていて少しぼうっとしていました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "小官に何かご用でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "あっ！　またどこかで火事ですか！？　おかしいですね火災警報器が鳴っていません。もし何かあったなら小官まで連絡が来るはずですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "たたたた大変です早くしないと──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おい、ちげぇって、待てよ、今回は火事じゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おい待て走るな……火は出てない、マジで出てねぇんだって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "えっ、あっ、違うのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "よかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "どうしてわたくしたちを見ると、毎回当然のごとくそのような反応をなさるのですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "それはもちろんお二人がいつも火災現場に現れるからです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "あっ、も、申し訳ありません！　そういう意味ではないんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ならどういう意味ですこと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オマエら、そんな話はどうだっていいだろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おいチビ、さっきは何やってたんだ？　あんなマジメによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "チビ！？　小官はショウです、コードネームで呼んでください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "はいはい、わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "んじゃあショウ、オマエこれは何やってんだ？　こんなに紙がたくさん……しかも文字ばっかじゃねぇか……このチェックマークの列は何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "これですか？　これは各エリアの点検表です……このチェックマークはすでに点検済みで、安全上の問題がないことを表しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "あ？　一つ一つ点検すんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "はい。一つ一つすべてです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "うわっ、めんどくさそうだなおい！　こんなにたくさん……まさかこれ全部点検したのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "もちろんです！　これが小官の仕事ですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "なかなかの量ですわね、ご苦労ですこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……ふーん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "じゃあこれは？　この束は何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "わっ！　待ってください、グチャグチャにしたらダメですよ。これはクロージャさんとドクターに提出する報告書です。まだ書いている途中なんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オマエさ、毎日こんなにたくさんの仕事しなきゃなんねぇのか？　飽きねぇのかよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オレサマだったら絶対ムリだね。毎日点検して報告書書くなんて、退屈すぎんだろ。もっとなんつーか……カッケー仕事はねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "例えばよ……えーっと、オマエがその消火器を噴射してる時って意外とカッケーんだぜ。オレサマはずぶぬれになっちまうけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "（ぎこちない褒め方ですこと……まさかこの子、遠回しに謝罪の意を伝えているつもりですの？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "（絶対に伝わりませんわ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "職場でそのようなワガママを言ってはいられません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ですが……うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "イフリータさんがそう思われるのも無理はありませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "だよな！　そうだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ですが、消防活動は小官たちの仕事のほんの一部にすぎませんし、ほとんどの時間は紛失物捜索の手伝いなどのささいなこと、あとは設備点検などを行っているんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "確かに退屈でつまらなく感じられるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "防災知識も面白い内容ではありませんし、何度も繰り返し呼びかけていると嫌がられます。安全を考慮したものではありますが、一部の規定は日常生活においては少し厳格すぎるものもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "以前小学校へ行って説明を行った際も子供たちは全く興味がなく、途中でみんなどこかへ行ってしまいました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "それに小官は……話すのが苦手ですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おぉ……オマエも自分でわかってたんだな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "──ですが！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "うおっ！　きゅ、急に大声出すんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ですが……何かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "たとえ指から抜けなくなった指輪を外してあげるといった救助活動でも、意味があるものです。誰かがやらなければならないのです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "小官は……消防隊に入ってもう何年も経ちます。もう新人ではありませんから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "同じ作業をずっと繰り返していると、もちろん飽き飽きすることもあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ですがこれが小官の仕事です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "消防士になることが、小官が子供の頃に決めた目標でした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "小官はこの仕事と自分の選択に責任を持ちます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "君が今回の責任者か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "は、はい……そうです長官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "あっ、あっ、あの……お会いできて光栄です、長官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "緊張する必要も、堅苦しくなる必要もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "今回の災害救助活動で死傷者がゼロだったのは、君と消防隊各員の功績が大きい。全龍門市民を代表して君たちに感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "何か望みの報酬はあるかな。ボーナス、あるいは長期休暇、何でも今回の働きに妥当なものを与えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "か、過分なお言葉感謝いたします、長官！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "報酬に関して、一つお願いしてもよろしいでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "言ってみなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "近衛局と消防署の合同で、都市全体に向けて大規模な防災宣伝キャンペーンを実施したいと考えています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "もし可能ならば、各学校に防災安全に関する授業のカリキュラムを新設することも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "消防知識を学ぶことは火災発生率の低下および災害による死傷者や財産損失減少に非常に有益だと考えます！　ど、どうかご検討をお願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "うーむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "いいだろう。この件は承諾しよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "本当ですか！？　ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "だが、この規模のキャンペーンを行いたければ、実行可能な企画書を持ってきなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "また、君発案の企画となるからには、責任者も当然君になる。できるだけ早く推し進めたいのであれば、今回の報酬の休暇はなくなってしまうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "わかりました長官！　問題ありません、小官にお任せください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……今回面談するにあたって、君の個人資料と業務記録に少し目を通させてもらったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "君の学生時代の成績は非常に優秀だった。その気があれば、もっと待遇の良い仕事はあっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "今の仕事においても、君ほどよくやっている者はいない。業務記録には、今日までの二ヶ月間、毎週末自主パトロールを行っていると書いてあったが、それは本当か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "一つ質問がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "はい、長官！　何なりとお尋ねください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "そう畏まる必要はない。もし嫌なら答えなくても構わない。これはただの個人的な疑問だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "なぜ、そこまでするんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "それは……何か特別な理由があるわけではなく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "小官はただ、これらすべてに意味があると思っているからです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "ほう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "子供の頃、学校の近くに大好きなお店がありました。何か良いことをするたびに、両親はご褒美として小官をそのお店に連れて行き、ナッツを買ってくれたものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "そのお店には、学校でもらった花まるシールを貼りつけていくボードもありました。それがシールでいっぱいになると、店主のおじいさんがナッツの詰まった小袋をプレゼントしてくれるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "あのお店のナッツは香ばしくてサクサクで、今思い出しても、あれよりおいしいものはないと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "しかし……ある日そこで火事が起きたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "恐らく、電気回路の老朽化とメンテナンス不足による故障が原因となり、そこから出火して夜中に店が燃え始めたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "おじいさんは店にいなかったので、ケガ人は出ませんでしたが、店自体は全焼してしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "いつもショーウィンドウに飾られていたきれいなナッツも……小官の花まるシールも……何一つ残りませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "店主のおじいさんはほかの大人たちにこう言っていました。みんなが無事でよかった、誰にも何もなかったならそれでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "でも……小官がこっそり見に行くと、おじいさんは泣いていました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "小官はもう善良な人が大切なものを失うのを見たくないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "ふむ、そうか……普段の仕事は大変かね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "いいえ、大変ではありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "これは個人的な会話だ、考えを正直に述べてくれればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "はい……少しだけ……大変です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "頑張れるか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "確かに疲れはしますが……でも問題ありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "……素晴らしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "君のような若者がいて、龍門は幸運だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "企画書の準備に取りかかるといい。今回の防災宣伝のために専任者を手配しよう。やると決めたからには、できるだけうまくやり遂げなさい……最後まで後悔のないようやるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "はっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウェイ",
      "text": "各員に、そして君たちが龍門のためにしてくれた全てに対し、感謝する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "実はほとんどの状況において、危険は事前に回避できるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "しっかりと点検を行い……何に注意すべきか、どうすれば安全かをみなさんが知ってさえいれば、多くの損失は完全に回避できるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "確かにそうですわね。例えば、屋内でバーベキューをしないとかかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "うっせぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "屋内でのバーベキューは絶対に禁止すべきです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "設備が老朽化しているにもかかわらず、点検や交換がされていない場合、必要な時に正常に使用できなくなってしまいます。それでは本来簡単に解決できたはずの問題が災害に繋がる恐れがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "例えばこの消火器……見てください、もしここのボタンが動かなければ、スムーズに取り外すことができません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "それとこちら、ここにレバーがあることに気付いていましたか？　もしこれが故障していたら、防火壁を開くことができず、火の手の拡大を阻止できなくなります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "これらはすべて小官が真面目に仕事をこなしてさえいれば、避けられることなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ここにこんな物まであったんだな、全く気付かなかったぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "これらはすべて前回の講義で言ったことです！　覚えておいてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "しょうがねぇじゃねぇか！　あん時はオマエが早口すぎて何言ってんのか全然わかんなかったんだからよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "うっ！　そ、そうですね……それは確かに小官の問題です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "今回はしっかりと準備をして必ずみなさんに火災の危険性と予防法を学んでもらえるようにします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "そんなことよりその話すスピードを何とかしろ！　また早口になってんじゃねーか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ううっ……おっしゃる通りです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "先ほどの消火器や防火壁もそうですが、実はロドスには、当初よりケルシー先生とアーミヤさんから承認を頂き、艦内すべてのエリアに一定量の消防設備が設置してあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "イフリータさんやスカイフレアさん、それに他のみなさんもあまり気にしたことはないと思いますが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "これらの設備が常に正常に使えるようになっていて、みなさんが使用方法を学びさえすれば、万一何か事故が起きても、慌てて小官を探す必要はなくなるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ロドスのどこで不慮の出火が起きようと、近くに設置された消火器を使いさえすれば、迅速に消火することができるんですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "こいつで火を消すのか？　まぁ確かにどこにでも置いてある気がするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "だけど消火するってんなら、ミューたちみたいな術師のアーツでもいいだろ？　こんなめんどくせぇことしなくてもよくねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "確かに一部のアーツはそういったことができます、それは否定しません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "しかしイフリータさん、すべての人が都合良くそのようなアーツを使えるわけではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ですが消防設備なら、正しく操作しさえすれば突然起こった火災に誰でも対応できるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "こうした設備の使用は少しも難しくありません。一定の防災知識さえ身につければ、誰でも使うことができます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "……それに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "もしロドスで講義を行い、防災知識を広め続ければ！　規定違反の電気製品使用のような、散見される危険行為もなくせるはずです……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おい待て、オレサマのことをディスってねぇか！？　もうあんなことはしねぇって前も言っただろうが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "コホンッ、そんなことはありません、考え過ぎです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "とにかく、火に善も悪もありませんし、燃えてしまったものは何をしたって元の状態には戻りません。前回、ドクターも仰っていましたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "わたくしのアーツもそうですわね。愚かな者たちを、元に戻るどころか灰さえも残さないほど確実に燃やし尽くしますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "戦闘時であっても、スカイフレアさんのアーツは危険すぎます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "あなたがいるエリアにはほとんどのオペレーターが近づけません。それにあなたの放った火の後始末をしないと、延焼によってさらに大きな損失を招く恐れが多分にあります……森での一件のように！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "危うく森全体を燃やすところだったんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "ううっ、そ、そうだったかしら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ハハハ！　ダッセー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "イフリータさんは人のことを笑えませんよ、あなたも同じです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ううっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "とにかく、火災が起きた後に消火するのではなく、火災の可能性を根本的に排除していただきたいのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "小官がこの仕事をしているのは、ただみなさんに大切なものを失ってほしくないからで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オマエ……なかなかカッケーじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "え？　今何とおっしゃいましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "何でもねぇよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "つーかよ、そんなスゲー考えを持ってるんなら、オレサマのためにもちゃんとやってくれよな！　明日の講義にはオレサマも行くからうまくやれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "え……はい！　頑張ります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "いや、待てよ。たしかこないだは、オマエの姿が教卓で隠れちまってたぞ。あんなんじゃどこにいるか誰もわかんねぇよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "あれじゃダメだ……ちょっと待ってろ、クロージャに聞いてくる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "えっ？　ですが──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "行ってしまいました……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "構う必要はありません、やらせておけばいいですわ。もしかしたら本当に何か良い方法を見つけてくるかもしれませんしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "それよりも……講義の原稿の方は書き終わりましたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "書くには書いたのですが、どうにもうまく書けてる気がしなくてですね……前回もみなさんよくわからないとおっしゃっていましたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "フンッ、あの程度も理解できないなんて、その方たちのレベルの低さを証明しているだけですわね。ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "まあいいわ、原稿を見せてごらんなさい。わたくしが修正して差し上げますわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "え？　いいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "わたくしがいいと言ったらいいのです！　これは決して前回廊下を燃やしてしまって申し訳ないと思っているからではありません！　くれぐれも勘違いなさらないようお願いしますわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "速すぎます！　早口すぎて聞き取れませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "……みなさんが小官の話を聞く時も、このような苦しみを味わっていたのですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカイフレア",
      "text": "一言多いですわ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ここが最後だ……よし、問題なしと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "術師訓練場の重点チェック……シミュレーション訓練室……食堂……漏れはなし……よし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "ふぅ……あとは報告書を整理してドクターに提出しないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "スカイフレアさんもイフリータさんも行っちゃったけど、本当に大丈夫かな。まさかまた何か事故が起きたり……はぁ、心配だなぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "うぅっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "──危ない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ん？　あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "も、申し訳ありません！　注意が足りませんでした……お怪我はありませんか？　医務室へ行きますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "あぁ……大丈夫、私は平気です。そんな謝られなくても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "それよりもあなた……あなたは、龍門消防署の消防士ですよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "あっ、そうです！　ロドスでのコードネームはショウです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "やはりあなたでしたか！　人違いではありませんでした……まさかロドスでお会いできるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "失礼ですが、どちら様でしょうか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ワイフーと申します。どうかあまり畏まらないでください。あなたのことはテレビで見たことがあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "規則違反の暖房設備による事故だったのですが、覚えていらっしゃいますか？　当時はかなりの影響があったようで、ウェイ長官本人までもが自ら防災宣伝を行った時の報道です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "あっ……あの時ですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "私の同級生が当時あの建物に住んでいたんです。事件の後、彼女はあなたたち消防士のおかげで、自分と隣人たちは火災現場から生還できたんだと何度も言っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "皆さんあなたたちにとても感謝していますよ！　あれ以来、私たちは安全規則に一段と気を配るようになり、都市全体で防災意識強化キャンペーンまで行われて……本当に多くのことを学びました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "えへへ……それはよかったです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "聞いた話によると、ショウさんはあの火災では最前線で突き進み、他の隊員を指揮して救助活動を行ったらしいですね。とてもカッコよく勇敢で、印象的だったと伺っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "えっ？　い、いえ、しょ、小官はそんなにすごくありませんよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ご謙遜なさらず、これはとてもすごいことですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "あ、そうだ。さっき言った同級生ですが、彼女は今、消防署関連の職に就こうとしているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "えっ、本当ですか！　合格できるといいですね。もし必要なら、小官の持っている資料をそのお友達にお貸ししますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "それはありがたいです！　彼女は毎日、必死で試験の準備をしているんです。私がショウさんにお会いしたことを知ったら、きっと羨ましがりますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ショウ",
      "text": "そんな、大げさですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "いいえ、これっぽっちも大げさではありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "あなたにとってはささいなことかもしれませんが、彼女からしてみれば、あの時死傷者が出なかったのは、奇跡のようなものですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ショウさん、あなたこそが、彼女の目標なんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
