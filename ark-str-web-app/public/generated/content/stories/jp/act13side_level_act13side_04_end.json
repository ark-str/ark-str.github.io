{
  "server": "jp",
  "storyId": "act13side_level_act13side_04_end",
  "groupId": "act13side",
  "stageId": "act13side_04",
  "title": "詩の容貌",
  "storyCode": "NL-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act13side/level_act13side_04_end.txt",
  "sourceHash": "6cf434f701e27a5875dad9645d5975bc40804dd8ec7123859e9f751245c11287",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "卡西米尔2 4-2"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……くっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "蝋燭の火……そして、影か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "あなたの観察眼には、本当に驚かされます。アーツの引き起こす現象を、しっかりと判別できているのですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "部屋の中、蝋燭に火を灯す時、最も目を引くのはその光でしょう。……しかしその際、あなたを包み込んでいるのは光ではなく、周囲の万物の影なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "これは驚嘆すべきアーツだな、ヴィヴィアナ。私の光では……あなたを照らし出すことすらできない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……申し訳ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "礼儀知らずな真似をしました。私もあなたを名前でお呼びするべきですね、マーガレットさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "こ――これは、本当に我々の知る騎士競技なのでしょうか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "二人の騎士には、戦いやその決着を急ぐ様子はありません！　この光景は――最早貴族の優雅な社交風景とすら言えそうです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "と、とはいえ――先ほどのアーツ、燭騎士のすさまじい速さで繰り出された剣術が、光を飲み込んだように見えました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "耀騎士の果てしない輝きにも、遂に衰えが生じつつあるのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "観客の皆さん！　蝋燭の灯火より、その微かな光の周囲にあるもの……照らされざる闇こそに目を引かれるとは思いませんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "燭騎士のアーツは、微光を操っているのではなく、光のもとに広がる影を操っているようです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "数少ないチャンピオン対決の中でも、このような展開は大変珍しいものだと言わざるを得ません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "エレガントでありながら、超ハイレベルなアーツのぶつかり合い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "皆様！？　これぞ耀騎士マーガレット・ニアール！　そしてこれぞ燭騎士ヴィヴィアナ・ドロステなのです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリア？　マリアー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "どこにいったのかしら……バーにも家にもいないなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "……もしかして……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "うっ……うーん……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あれ？　私、どうしてここに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……あなた、確か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "無冑盟。それが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……そこまで警戒しなくてもいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "おとなしくしといてくれたら、私たちも何もしないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "ニアール家の一番大事な末娘が傷ついた、となれば……耀騎士とムリナールが黙ってないだろうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あなたたち……お姉ちゃんを脅すつもりなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "まあ、そんなところかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……錆銅の件は知ってる？　今、感染者関係の問題がすごい取り沙汰されてるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "そんな状況で、耀騎士がチャンピオンになんてなっちゃったら……一体どうなるか、想像できる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "アンタのお姉ちゃんがおとなしく燭騎士に負けてくれれば、そこまで多くの問題には直面しないで済むんだし。これが一番楽な選択だと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "お姉ちゃんは……わざと負けたりなんて、しないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "マリア・ニアール。アンタ、知ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "カジミエーシュって……まるで塔みたいになってるんだよ。一番下から、らせん状に伸びていく階段の頂上を見上げようとしたところで、そんなもの永遠に見えやしない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "フォー！　コーヴァル！　マーティンおじさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリアが――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ムリナール",
      "text": "……マリアが、どうした？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "なぜ、ご自分で詩を書いてみないのですか？　人気を思えば、読みたがる人も多いと思いますが……よければ、私が出版社に話をつけてきますよ。それだけの名声と才能をお持ちなのですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "私が、ですか……？　私には……できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "またまた、ご謙遜を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "いえ、これは謙遜などではないのです、マッキーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……私は…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……マーガレットさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "巨大な塔に火をつけたとして、どれほど遠くの人々にまで、その煙を見せられるでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "炎では、人々の心の矛盾は焼き払えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "はるか遠くの人々も、その黒煙を見るだろう。だが、その塔は彼らの故郷、日々を暮らす我が家かもしれないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……それを聞いて、もっとわからなくなってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "あなたのような騎士が……何かを変えるべくカジミエーシュへ帰ってきたのでないのなら、その目的は何なのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "先ほどあなたが言った通りだ、ヴィヴィアナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "時代は変化し続けているが、かつて美徳や正義と呼ばれていたものまでが共に変わりゆくわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私がここへ戻ってきたのは、カジミエーシュの騎士たちに、そしてこの国の一人一人に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "――長年忘れ去られていた栄光を思い出させるためだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "思い出させるんですか？　今のこのカジミエーシュで一体、どのように？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……あなたは私から答えを得たいと思っているようだが、私にその答えを与える資格があるとは言い切れない。何よりそれは、単純な対話のみでは実現できまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "ふふっ……あなたのアーツは、心を読むことまでできるのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "いいや。ただ、あなたの正直さをより深く知っただけのことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ところで、この数年の放浪の中で、私が何を見たのかを知りたがっていたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "――私は、この大地における最も底の深い惨劇を見た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "死にゆく感染者たちがもがくさまを、降り注ぐ天災の下、巨大な都市が崩壊するさまを見た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……あなたが……慈悲深く思いやるこの大地に見た苦しみは、それなのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私には良き仲間がいてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "いや。単に良き仲間であるにとどまらず、彼らは……理想の輝きを放つ人々なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "かつて私は、確かに迷ったんだ、ヴィヴィアナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "あなたは若くして優勝し、そして追放された。迷うのも当然です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "だが、今の私に迷いはない。長き旅路の果てに、私は仲間と信仰のありかを見つけたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私はもう、一人ではない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "マーガレットが剣を地面に突き刺した。\n音もなく光が広がり、騎士の瞳は黄金を湛えたように輝いていた。\n彼女自身が光を放つ灯台であるかのごとく……\n彼女は命尽きるまで、時間の果てが訪れるまで、ここに立ち続けるのだろう。\nその光が照らし出す道を歩む者がいなかったとしても、照らし続ける――\n――もっとも、そんな心配は不要だと思わせるほど堂々として、惹きつけられる姿だった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "ご報告します、プラチナ様。……既に、騎士協会には連絡を行いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "しかし、試合はまだ続いている模様です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "騎士協会が早く動いてくれるといいんだけどね。でないと、彼女の妹が少し苦しむ羽目になるかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "言ったでしょ。お姉ちゃんはわざと負けたりなんてしない、って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "別に、それでもいいよ。そうなったら、アンタの指をニアール家の玄関に並べて置いとけば……アンタのお姉ちゃんだって、次の試合に出る気はなくなるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "反抗的な目だね。アンタって、ううん、アンタたち姉妹って本当に不思議。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "名高い英雄一族だとは聞いてるけど、この大騎士領に、連合会の手下がどれだけいると思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "耀騎士とムリナール、その二人がちょっと強いってだけで、何ができるの？　この大騎士領で何千何百と殺し屋を返り討ちにしたら……法で裁かれることになるんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あなた、そんなにお喋りじゃなかったと思うけど、緊張してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……そうかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "前の仕事は、弓を引いて、狙いを定めて、手を離せば、ターゲットは少し苦しむだけで息絶えるっていう、そういうものだったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "でも、最近の命令は、子供に手を出すこととか、耀騎士とやり合うこととかだし。あ〜あ……ほんと、仕事するのが嫌になるよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "最近の無冑盟って、ちょっとダメになってきてない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "……ご報告します！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "耀騎士が降参でもした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "い、いえ！　先ほどの定期連絡で、E7、E9からの応答が確認できず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……だったらぼやぼやしてないで、戦闘準備でしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "全員、建物から離れて。A1、A2の高所を確保。ターゲットに逃げるスキを与えないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "三番四番、援護して。侵入者に対応するよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "（……爆発？　人質を顧みないにもほどが――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "（――いや、違うな。マリアを助けに来たわけじゃなさそう……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "煙の中に人影を確認！　敵襲に気を付け――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "――うっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ジャスティスナイト」",
      "text": "“Di-di”！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……何これ？　デリバリーロボかなんか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "――ッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "よぉ、元気か？　無冑盟の手先ども。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "チッ、感染者騎士か……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "へーえ、軽く跳んだだけでここまで距離を取られるとは。お前、すげえ身軽だな――って……んん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "マリア・ニアール？　なんでこんなとこに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "あ、あなたは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "おい、あんた走れるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "う、うん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "事情は知らねぇが、耀騎士に貸しを作っておくのもアリだよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "そうそう、先に言っとくと、無冑盟を攻撃するのは重罪だ。やつらのリストに名前が入るぞ、それでもいいか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "自分で決めな。このまま逃げるか、あるいは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "――あの人たちを止めなくちゃ。ほっといたら、お姉ちゃんの邪魔をし続けるだろうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "ほう、思い切りがいいじゃねぇか。ちょっぴり気に入ったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "けど――悪いな。無関係の奴を、無冑盟との戦いに巻き込むってのはあたしの良心が許さねぇ。ソーナの奴も、あんたを気に入ってるみたいだしな。だから今回は、いい子にしててくれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "トーランドッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "なっ、何っ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マリア",
      "text": "え、だ、誰……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トーランド",
      "text": "いいからいいから。ほら、ついてきな、ニアールのお嬢ちゃん。――しかし、お前さん……見たところ、叔父さんにはちっとも似てねえなあ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュ騎士",
      "text": "――監査会に報告……無冑盟と感染者騎士の衝突を確認。マリア・ニアールも連れて行かれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カジミエーシュ騎士",
      "text": "耀騎士の試合日程に影響していないことが確認できれば問題はありません、以上。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "試合開始からどれだけ経ったのでしょうか？　おそらく、会場の皆さんも私同様、このような対決は初めてご覧になったことと思います！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "アーツのことをよく知らなくとも、二人の騎士が超ハイレベルな使い手だということは誰にでもわかる事実です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "光と光のぶつかり合い！　これこそが本試合のテーマであることは間違いありません！　微弱な燭光が、輝ける光芒に挑み続けています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "九時の時点で、都市間ネットワークや各種放送を通じて本試合を観戦している方々の人数は、二百万人に到達しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "こちらは第二十二回大会で耀騎士が優勝して以来、メジャー史上最多の同時接続者数を再び突破する記録です！　無数の観客が今、まさにこの瞬間、マーガレットの勇姿に注目しております！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "こういう時、私はつい考えてしまうのですが……まるでSF小説のように、各国のファンたちにもリアルタイムで試合を楽しんでもらうことができたら、どれほど良かっただろうと――あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "ここで、巨大な光が再びぶつかり合いました！　――まばゆい――なんとまばゆい光でしょうか！　しかし、逆巻く輝きの潮流の中――驚くべきことに！　燭騎士は平然と立っています！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……君の実力は大したものだ、ヴィヴィアナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "光と影を用いて……不可侵の領域を織り上げるとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "この小さな蝋燭の灯火が……耀騎士をここまで長く阻むことができようとは。光栄の至りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "けれども、あなたはまだ全力ではないようですね。ご家族を心配されているのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "――あなたの行いは矛盾しています、マーガレットさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "あなたは、良き仲間が在ることを誇りに思っているのでしょう。だというのに、ご自分のために定めた道は……あなたを、その素晴らしい仲間たちから遠ざけていくばかりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "遅かれ早かれ、妹さんは無冑盟の陰謀による「事故」に遭い、あなたのいらっしゃる場所も、商業連合会による妨害を受けるかもしれません――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ヴィヴィアナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "あの騎士が、果てしない波に向かって突き進んでいった時……この大地に打ち勝つことなど、望んでいたと思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……ふふっ……あなたも、あの本をご存知だったのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ああ。私の妹も、あの本が大好きなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "セントーレアが感染者の襲撃を受けた。相手は野鬃騎士だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "そ。あんな騎士一人満足に始末できないなら、さっさとこの仕事を辞めてもらいたいところね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "それで……私たちはどう出るべき？　連合会は明らかに感染者を処理したがってるわよ……さっさとやれって圧も感じるし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "ん～……確かに、感染者は面倒な連中ではある。だが、俺たちはあいつらにまだまだ騒ぎを起こしてもらわなきゃならねーからなあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "何かいいアイディアはないの？　エンターテイナー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "えっ？　もしかして褒められてる感じ～？　いや～、自分的にも、髪を青く染めてから、どっかのスターに似てるような気がしてたんだよなあ～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "……は～いはい、わかったわかった。そんなに睨むなって。――俺の提案は至ってシンプルだ。感染者連中の一部を殺す。容赦なく、できるだけ残酷にやって、恐怖をまき散らすんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "そしたら残りの感染者たちがカジミエーシュと連合会をもっと憎むようになって、今までよりも～っとメチャクチャやるようになるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "で、面倒事は全部プラチナに丸投げさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "そんじゃ、仕事にかかろう。騎士でもなく、別に目立ってもない感染者たちを殺しに行くんだ。狩りでもするみたいにして、いい具合に冷酷にな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "なるほど。本当に技を放っているのは、蝋燭の火が消える瞬間……というわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "一瞬の暗闇ですら、私のアーツを飲み込み得るものだ。もしや蝋燭の光がちらつくたびに……競技場の光すべてを、その中に飲み込んでいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "素晴らしい洞察力です……これまで、決闘中にこのアーツの本質に気付いた騎士はいませんでした。そのご慧眼もまた、放浪の歳月の賜物でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "残念ながら……アーツの本質は見抜けても、あなたの本質までは見抜けていないがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……私はかつて……このアーツを忌み嫌っていました。自らの才能が磨かれるほどに、出自が思い起こされ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "私の……境遇を意識させるものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "教えてください、マーガレット・ニアール、耀騎士よ。……信念を抱く騎士ならば皆、あなたに好奇心をそそられるもの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "私は、あなたの答えを知りたいのです。「騎士」というものへの、答えを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "――おや？　耀騎士と燭騎士が、同時に動きを止めました……両者慎重に相手を見つめながら、試合場を悠然と闊歩しています――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "これはどうしたことでしょう！？　まさかこの競技場は、本当に彼女たちの社交場となってしまったのでしょうか――二人の騎士はこの探り合いののち、ダンスを始めるつもりなのでしょうか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "ふふっ……聞こえましたか？　ダンス、ですって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "では、一曲ご一緒しようか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "拡散する光が、穏やかな朝日のように、蝋燭の火が灯されたその闇夜へと手を伸ばす。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "続けて、その光が競技場のすべてを満たしていった。\n今夜のカヴァレリエルキには、昼が訪れたかのようだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "マリアが向かったのは――こっちか？　早く、ついてこい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "――誰もいないぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "そんなはずないだろう！　記録によると、マリアはよくここに……震鉄騎士のバーに訪れているんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "屋根裏部屋か、裏口がないかを探して――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "やあ。悪いが、今は営業時間外でね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "貴様……っ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "う、ぐ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "殺すんじゃねえぞ、あとが面倒だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "はは、知らんのか？　わしは昔、戦争で砲兵術師を何人も生け捕りにして武勲を立てたんじゃぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "クソッ……貴様ら、命が惜しくないのか！？　俺たちは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "無冑盟だ、と言いたいのかな？　じゃあ、そうなる前は何をしてたんだい？　強盗かバウンティハンターか、はたまた退役軍人か……没落騎士って線もアリだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "はっきり言っておこう。我々は、君たちなんて怖くないんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "……こうして一度刃向かってきた以上、無冑盟は貴様らをどこまでも追い詰める……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "一日中、寝てる時だろうと、飯を食ってる時だろうと、いつ追手が来るかもわからない生活を送ることになるぞ。覚悟しろ……貴様らに逃げ場などない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "忠告に感謝しとこう……ペッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "しかし正直な話、無冑盟は歴戦の先鋒ほど恐ろしい相手ではなさそうじゃな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "はっは！　せいせいしたわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "……ほかの連中もここを嗅ぎつけたらしいな。おいマーティン、こうなったらこの店、多分もうやってけねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "それは残念。二年分の家賃を前払いしてたんだがねえ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "――！　貴様ら、一体何をした！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "抵抗するつもりなら――班員整列！　一斉に構え――ん……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "無冑盟がクロスボウを構える。\nだが――その弦は切れていた。より正確に言えば、「今まさにねじ切られている」ところだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "な、なにっ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "これでも喰らいなッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "ぐっ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……ちょっと腕がなまったかな？　アーツを使うのは久しぶりだからねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "チッ……それにしても、無冑盟はいつの間にここまで人数を増やしたんじゃ！？　よもや連合会の連中、余った金の使いどころに困っとるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "ハッ、数だけ揃えて雑魚ばっかりじゃどうにもならねえがな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "気を付けろ！　あのハゲは「震鉄」マーティンだ！　あとの二人も征戦騎士だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "この場は2チームで対処しろ。奴らを殺すなよ、ニアールへの切り札になるからな。もう1チームは、引き続きマリアの追跡に当たれ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老職人",
      "text": "おいおい……厄介なことになってきたぜ、フォー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老騎士",
      "text": "ふっ、泣いて許しでも請うてみるか？　笑ってやるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "狙撃用意、撃――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無冑盟構成員",
      "text": "なっ……！？　今度は何者だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "君たち、一体……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゾフィア",
      "text": "マリアに何をしたの！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "――光。最早この光というものに、人々は辟易し始めていた。\n耀騎士が太陽のごとき後光を背負って相対するは、ここに再び灯された蝋燭の光だ。\nそして、観客たちが光の中から二人の騎士を見つけ出すことに疲れ果ててきたその瞬間。\n――光芒、光輪、すべての光がまたたく間に消え失せた。"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ハァ……ハァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ヴィヴィアナ、あなたにはまったく……感服した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "見ろ。私の光は……すべて、あなたの影に飲み込まれてしまった……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……耀騎士をそこまで疲弊させることができたことを、大変光栄に思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "ですが、あなたはその絢爛なるアーツに頼るばかりのお人ではないようですね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "燭騎士は、高く掲げていた燭剣をゆっくりと下ろした。\n蝋燭の火は消え、しかし乳白色の断面はいまだ輝いていた。\n半分になった蝋燭が、羽のように落ちていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "私の剣は、あなたに切り落とされてしまいました。どうやら敗者は明白であるようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……この試合、燭騎士ヴィヴィアナ・ドロステは敗北を認めます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "なんと――燭騎士が敗北を認めました！　これは聞き間違いではないようです――たった今、燭騎士が敗北を宣言しましたっ！　組織委員会もこの宣言を認めております！　ということは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "長い長い戦いの末――本試合を制し勝者となったのは、若き伝説、耀騎士マーガレット・ニア～～ルだ～～～ッ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "突如として帰還した彼女は、人々の期待を裏切ることなく超ハイレベルな戦いを繰り広げ――大騎士相手の最初の試合で、見事に勝利を収めました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグマウスモーブ",
      "text": "片や燭騎士、これは栄誉ある敗北と言うべきでしょうか――ここで二人の騎士が握手を交わし、互いに敬意を表しています！　しばらくはこの光景がトップニュースを飾ってくれるに違いありません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観戦する騎士",
      "text": "うっそだろ！？　燭騎士が負けた……！？　何ヶ月分も給料注ぎ込んだってのに！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "歓声を上げる騎士",
      "text": "ほ～ら言わんこっちゃねえ。まあ、確かに俺も大して儲かってるほうじゃねえが。にしても、マジで目がチカチカする試合だったな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "……ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……騎士とは、大地を照らす崇高なる存在、ですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "ふふふっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "ヴィヴィアナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マーガレット",
      "text": "私はあなたの生まれに――あなたの心のしこりに対して何を指摘するつもりもない。だが、これだけは言わせてもらおう。あなたは私が出会った中でも……最も強大な騎士の一人だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "ありがとうございます。それだけで、十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "古典的な騎士小説の中では、騎士たちは決闘を通して心を通わせるものですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "現実はそれほどロマンチックではありませんね、マーガレット。私は今日あなたと知り合ったばかりの相手にすぎませんし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "あなたがこの先、一体どこまで歩んでいくのか、是非見届けさせてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "楽しみにしています。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "チッ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "（こいつ、できる！　――きっちりブロックしてるってのに、それでも武器を放しちまいそうになる――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……次は、両足を射抜く。もう逃げ回れないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "それから、オマエの鎧を射抜く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "最後の一矢は、胸に。苦しみは一瞬だけ。すぐに湿った道に倒れて死ぬことになるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "……ははっ、なるほどな。ソーナの奴が、ランク持ちの無冑盟を見たらすぐ逃げろって言ってたのはこういうわけか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "お前の若さでこんだけ強いとなると、お前より上の連中はどんな化け物揃いなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "それはもう。一生会わずに済むように祈っとくことだね――ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者騎士",
      "text": "野鬃！　援護しに来たぞ、早く撤退しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ジャスティスナイト」",
      "text": "“Di-di-di”！！　“Di-di”！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "……わかったよ、ジャスティスナイト。お前がそこまで言うんだったら、今日のところは無冑盟と白黒つけるのはやめとこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イヴォナ",
      "text": "あばよプラチナ！　また会おうぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "う……ごほ、ごほっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……逃げたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "あの連中、どうして爆薬ばっかり使うの……！　けほ、ごほ……お陰でほこりまみれなんだけど……はぁ、シャワー浴びたばっかりなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……あーあ、どう説明しようかなぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "説明ならいらないぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "ちゃ～んと見てたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "……さっきの奴ら、レッドパイン騎士団以外の人間も多かったけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "感染者の連中、団結早すぎない？　……そもそも、大騎士領内の感染者っていつの間にここまで増えてたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "さあな。その辺の原因を追求するなら、信用ならねぇ建設業者と天災で半々くらいになるんだろうが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "ともあれ、零号地が役割を果たさなきゃなんねえのは、こういうわけなのさ……っと、そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "ペガサスちゃん。悪いが、お前に頼みたいことがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "どうぞ、何でも言えば。たった今上司の前でトチった以上、文句言える立場じゃないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "よーし、じゃあこの会社調べといてくれ。なんでも、耀騎士と繋がりがあるらしくてな。おまけに今は零号地にいるんだとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "感染者の件は、俺たちがまとめて引き継ごう。……ちょうどその会社のほうは耀騎士関係なんだし、お前の仕事の範疇だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "……ロドス、か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "調べるだけでいいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "ああ。聞いた話じゃ、向こうさんのほうから積極的に連合会へ接触してきてるらしくてな。いや～、これまた貪欲な製薬会社様が来たもんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "ま、利益をもたらせるような会社ならそれでいい。たとえば、そいつらが耀騎士の問題を金で解決しようとしてきたとしても、お前の判断で好きにしな。俺のほうからは、特に意見なしだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロイ",
      "text": "ただし、この件は完全に理事会の意向次第で動くことになる。理事会から誰かがお前を訪ねてきたら、そっちの指示を優先しろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "それで、アンタたち二人はどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "は？　あんたいつからラズライトの仕事に意見できるほど偉くなったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プラチナ",
      "text": "いや……そんなつもりで聞いたわけじゃないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モニーク",
      "text": "だったら黙って自分の仕事だけやってなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観客A",
      "text": "燭騎士さん！　サインください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観客B",
      "text": "燭騎士！　こっちを見てくれ！　――うわ～～！　最高～！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マッキー",
      "text": "……見たところ、ご機嫌のようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……マッキーさん。ご存知ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "――多くの人が、耀騎士は追放されたあと、その地位から転落し、最年少チャンピオンの神話は最早崩れ去ったと口にします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "ですが、感染者となり、放逐され、さらに六年の時を経た彼女に直接会って、私はようやく気付きました。彼らが口にしていたことは何の根も葉もない噂話だったということに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "彼女は今や……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "燭騎士",
      "text": "……頭上に輝く、太陽のようです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "ふぅ……有意義な面会でしたね、Dr.{@nickname}。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "代弁者マルキェヴィッチ",
      "text": "おそらく、貴殿は幹部数名のお眼鏡にかなったことと思います。彼らは皆、商業連合会に不可欠の重要メンバーばかりですよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "礼を言わなければな。君のお陰だ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "この会には、多くを学ばせてもらったよ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "……とはいえ、貴殿が求めているのは口先だけの関係ではない、ですよね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "好奇心からお尋ねするのですが……カジミエーシュ以外の国には、貴殿のように、商業における戦場に精通した科学者が多くいるものなのでしょうか？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "かもしれないな……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "社会は発展しつつある。これも必要な技術だ。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "恐らく、ほかにはいないだろう。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "はははっ……そうですか。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "少し歩きましょうか。ここからホテルまでなら、徒歩で行っても大した距離ではありませんから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "あっ、この近くには、私の最初の職場があるんです。あの頃の私はまだ、単なるトレーダーで――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "感染者騎士",
          "text": "う……あぁ――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "――！　お下がりください、ドクター様！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ケガを負った感染者騎士が、あなたの顔をぼんやりと見つめる。\nその騎士から感じ取ったものが、怒りでも、恐怖でも、悲しみでもないことはわかった。\nだが、あなたには彼の複雑な感情を細かく読み取れるほどの時間はなかった。\n彼は鞭打たれた駄獣のように懸命に体を起こし、走り出したのだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "感染者騎士",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "無冑盟構成員",
          "text": "……代弁者様、こちらの方は？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "今のは、一体……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "無冑盟構成員",
          "text": "……不法居留感染者です。必要でしたら、のちほど法定文書をお送りいたします。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "無冑盟構成員",
          "text": "この場ではお話しできかねますことを、どうかお許しください。たとえ代弁者様でも、ここに部外者の方がいらっしゃる以上、お伝えできることは多くありませんので。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "無冑盟構成員",
          "text": "この付近で衝突が発生しておりますため、お連れの方もご一緒に、できるだけ早く避難してください。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "……夕食会のあとだというのに、このようなことに出くわしてしまうとは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "ご気分を害されたでしょう。大変失礼いたしました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君なら、あの感染者を助けられないか？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "私は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "……私には多分、そんな力はありません……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "我々の友情のために。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "ロドスと君の友好関係のために。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "カジミエーシュの進歩のために。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "代弁者マルキェヴィッチ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "マルキェヴィッチは、感染者騎士が逃げていった方向へ無言で視線を向けた。\nそこにあるのは、とある路地だ。どこからか音楽が聞こえ、深夜のレストランからは騒ぐ人々の熱気が漂っていた。\nまばらな血痕が、遠くまで続いている。\nそれはまるで、人が生み落とした宝石のようだった。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
