{
  "server": "jp",
  "storyId": "main_0_level_main_00-10_beg",
  "groupId": "main_0",
  "stageId": "main_00-10",
  "title": "苦境",
  "storyCode": "0-10",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_00-10_beg.txt",
  "sourceHash": "7dd67e8ec087327e1bf87b49bc25a47de58baec9586fcf247df600103f9b7636",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "何なんだ……この、女は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――その指揮、見るに堪えんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "レユニオンがチェルノボーグの軍事拠点を制圧した際、その構成員たちは、精密機械のように効率的な動きをしていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "だが、それに対して貴様のやり方は、半ば錯乱状態の部下を無秩序にのさばらせているだけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "虐殺、放火、そして狩猟に見立てた残酷な行為の数々……これらはすべて、貴様の残忍な嗜好を満たすためだけのものだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "この状況でこうした蛮行を働く人間に、都市のすべてを陥れるほどの策など、もたらせるはずもない。となれば、指揮官はほかにいるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "その人物は恐らく、貴様に戦場のかく乱を命じたのだろうな。そしてその命の元、貴様は己の低劣な趣味に突き動かされて暴走した、というわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "――ファウスト。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "あいつを黙らせてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ファウスト",
      "text": "……了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "くっ、今のは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――ニアールさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "全員、構えろ！　あの狙撃手……かなり手強いぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "いくらニアールでも、もう一撃食らうのはまずい……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "下がってください、ニアールさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――いいや。今退くわけにはいかない。あの尋常ではない威力……あれが直撃すれば、部隊は壊滅的な被害を受けることになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "ゆえに――私はここへ立つ。皆を守り抜いてみせる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "……ファウストの砲撃が、防がれた……？　たった一枚の盾如きで……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "ありえない……そんなのありえない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "……もう一度だ。もう一度やろう、ファウスト！　あいつをバラバラにしてやるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ファウスト",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "っ……！？　――右か！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "いかん！　ニアール――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "――そうはさせんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "Aceさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "狙撃オペレーター、構えろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "目標、南方の高台！　撃てッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ファウスト",
      "text": "……ッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "何っ……！？　お前ら、よくも……！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "命中、したんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "そう簡単にはいかんだろうな……今のはあくまで、ちょっとした時間稼ぎさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "とにかく、急ぐぞ！　連中に構っている暇はない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "同感だ！　モタモタしていると、あの一撃をもろに喰らうことになりかねんからな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "アーミヤ！　E3小隊が食い止めているうちに、打って出るぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "了解しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――E1小隊の狙撃オペレーターは、私と一緒にレユニオンへの牽制を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "E2小隊は、最大火力で包囲を切り崩してください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "……どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "どうして素直に死んでくれないんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "お前たちの命運なんか、とっくに尽きてるはずなのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "――こうなったら、全員まとめて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "ニアール、今だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "了解！　――E4小隊に告ぐ！　これより敵陣へ突入する！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "一気にたたみかけ、皆の道を共に切り開こう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――行くぞ、私に続け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "撃て！　撃てーッ！　奴を近付かせるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "？　待てよ、いつの間に近付いてき――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "なっ……！？　う、嘘だろ！？　さっきまでもっと遠くにいたはず――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ひっ、やめ――うわあああっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "甘い！　カジミエーシュの騎士を本気で相手取るつもりなら――あと数十年は訓練を積んでもらおうか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――さあ、ドーベルマン！　私についてきてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
