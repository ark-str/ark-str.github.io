{
  "server": "jp",
  "storyId": "act23side_level_act23side_03_beg",
  "groupId": "act23side",
  "stageId": "act23side_03",
  "title": "木々でさえ",
  "storyCode": "WB-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act23side/level_act23side_03_beg.txt",
  "sourceHash": "62cdca3220b75841ef823852185d25140379a9d4f0f58ddb6d2122e3c867209f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "行かせろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "さっきも言ったはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "将軍の命により、玉門の安全のため、戒厳令が解けない限りは、いかなる者もこの門から出ることはまかりなりません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "お帰りください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "玉門の安全だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "我々がこの玉門を守っていた頃、お主なぞまだ刀にさえ触れてすらいない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "非常事態につき、ぜひ大局を優先に考えていただきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "大局を優先と言ったか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "かつて盗賊どもが街に忍び込んで金品を奪い、何人もの罪なき人を傷つけたことがあった！　忘れたとは言わせんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "突然の出来事で具体的な状況がわからず、お主ら守備軍は下手に動くことができなかったな。それで我々の兄弟が丸々三日も、砂漠の中を数百里にわたって追いかけたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "幾人もの兄弟たちが息も絶え絶えの状態に陥ったが、我々は彼らを背負ったまま、最終的に賊を捕らえて街へと連れ帰った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "そして今！　我々の兄弟が街の外で死んだ。骨すら持ち帰ることができていない。それなのにここで待てと言うのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "ジィンさん、あなたの話は我々みな知っています。あなたのこともとても尊敬しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "ですがズオ将軍のご下命です。現在都市内では重要な犯人を追っているため、将軍ご本人の許可がなければ、何人も玉門への出入りはできないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "随分とそっくり返ってやがるじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "ならばそのズオ・シュアンリャオを呼べ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "無礼者めが！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "親方……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "遠くからでもお前たちが騒いでるのが聞こえてきたぞ。兵士たちも上の命令を受けてるだけだ、困らせてやるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怒った武人",
      "text": "しかし、納得いきません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お前たちはみんなこの街の古株さ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "都市防衛戦に何度も参加し、天災の中だって何度も信使を護送してきた。今日の玉門の平穏は、お前たちの苦労があってこそだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "だがそれでも上にゃ平祟侯がいる。宗師だっているだろうが。お前らごときが、何をふんぞり返ってやがんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込んだ武人",
      "text": "親方、お主とて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "本当の漢ってのは、昔の手柄をひけらかさないもんだ。わざわざ言わなくったって覚えてる奴は覚えてる。覚えてねぇ奴には、言ったところで意味がねぇんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "先に帰ってろ、もう騒ぐなよ。――俺がいる限り、兄弟たちの死が曖昧なまま終わることは絶対にねぇ。言われなくてもわかれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "落ち込んだ武人",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "俺の教育がなってないせいで、お前らには迷惑かけたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "いえ、モン殿のせいではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "亡くなられた四名の兄弟については……どうか気を落とされずに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "あいつらの家族は、俺がちゃんと面倒見る。平祟侯が気を煩わす必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "だがあいつらは玉門のため荷を届ける途中で死んだ。兄弟たちを代表して俺は問いたい。平祟侯はこの件に対して、どう対処するつもりかをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡防営守備軍",
      "text": "物事には軽重があります。都市の刺客を捕らえたら、平祟侯は必ずや兵を出して盗賊を一掃してくださるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "はっ……「物事には軽重がある」か、まあその通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "俺は平祟侯の一言が欲しかっただけだ。その言葉が何であれ、兄弟たちには伝えておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "事が終わったら、またみんな鋳剣坊に酒を飲みに来いよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ユーシャ姉。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "そっちの状況はどう？　犠牲者の家族は見つかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "実は四人のうち、二人は一人暮らしだったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "ほかの二人に関しては、ちょうど家族が不在で、勝手に上がったんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "おかしいのは、彼らの家はいつも通りの様子だったんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "たまたま家族の人が外出してたとか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "信使部隊の訃告が伝えられてから、もう丸一日ほど経っているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "誰ですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "わっ、なに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "今何者かがこちらを見ているように感じました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "通りにはこれだけたくさんの人が行き来してるのに、わかるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "客桟に戻ってから話しましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "リン・ユーシャ、待て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "見ていたのはこの人……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "この人と話があるから、少し待っててちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "……わかったわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "粛政院の監察御史が私のことを覚えていたなんてね。前に会ったのはもう五年前かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "あの対面の時のことは、忘れられぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "でもあまり愉快なものではないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "公務は公務である。貴殿も我もしかり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "リン特使がここにいるのも、玉門で生じた騒動の調査のためかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "何かアドバイスでもあるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "ない。今の我は公人の身分で介入しているわけではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "平祟侯のかつての部下として、炎国の民として、民の安寧を乱す悪党を拿捕するだけである。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "今回は関わるなと言ってこないなんて、少し意外だったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "リン特使には職責があるゆえ、我が諫止する理由はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "であるが、一つ問う。リン特使は玉門へ初めて来たばかり。都市の事情に明るいとは言えぬが、いかに調査するつもりか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "もちろん私なりの方法があるわ。心配ご無用よ、タイホー御史。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "リン特使の方法が、優れたものであるとは我も信じている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "もっとはっきり言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "先ほどの言葉通り、公務は公務である。それのみ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "我はリン特使に忠告に来ただけだ。敵は影に潜んでこちらを伺っている。くれぐれもご注意を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "では。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あのバカでかいの、尚蜀で見たわね……たしか粛政院の人だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "あんた、一体どれだけの高官と知り合いなのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "知り合いじゃないわ、関わったことがあるだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドゥ",
      "text": "それの何が違うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "両者の違いは、別に知り合いたくない人も中にはいることよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "ひとまず戻りましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "薄暮。\n初春の頃、日は駆けるように落ち、肌に触れる外気は僅かばかり冷たさを残す。\n老人は、薪を一束手に取ると炉にくべた。\nこの程度の火では、暖を取ることもできない。ましてや鍛造など夢のまた夢だ。しかし工房の全設備を源石で点火する今日でも、老人はいまだこうした役に立たない炉を残して置くことに拘る。\n炉の火が勢いを増すまでの間、彼はほうきを手に取り、昨夜積もった中庭の砂を丁寧に掃く。石畳みの隙間一つ一つも見逃さない。\n今きれいに掃除したところで、ほどなくすれば再び砂だらけになることを、老人は当然承知している。\nそれでも彼は飽くことなく、倦むこともなく、繰り返し地面を掃いている。まるで塵一つない工房を眺めることこそが、己の宿願であるように。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "この足ときたらなぁ、暖かくなってきたってのに、まだ寒さで痛みやがる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "今日はもう店を閉じまいだ。急ぎじゃなけりゃ、明日にしてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "ん……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お嬢ちゃん、場所を間違えてないか？　ここは医館じゃねぇぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "異民族の装いの少女",
      "text": "話で聞いた場所を……探してるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "重傷を負ってる奴が、外をほっつき歩くのはよくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "こんなこと言いたくないがな。戒厳令が敷かれてるこの状況で、刀傷を負った人間が突然家の前に現れたってなると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お嬢ちゃんを役人に引き渡さなけりゃ、俺の問題になっちまう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "俺だっていざこざはごめんだ。お嬢ちゃん、あんた何者なのか教えてくれねぇか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "異民族の装いの少女",
      "text": "あなたが……モン・ティエイー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "今の玉門で、その名前を知ってる若ぇのなら、見覚えはあるはずなんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お前は記憶にない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "異民族の装いの少女",
      "text": "師匠が言ってたんだ。移動都市には工房があって、工房の主人はとても腕の立つ刀匠だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "異民族の装いの少女",
      "text": "その人は武器と鎧を作っていて、面白いおもちゃなんかも作って街の子供にあげてるって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "ぱっと思いつかねぇな。まだ誰がいたか……俺のことそんなふうに言う奴。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "異民族の装いの少女",
      "text": "工房の中庭に、槐樹（えんじゅ）が植えてある。師匠が刀匠と一緒に遠い場所から移植したものだと聞いた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "老人が思わず振り返った。\n中庭の一角で、一株の槐樹が夜風を受けてわずかに首を揺らす。北地の春は遅く、枝にはいまだ若葉はない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "ここまで来れば、戦いは終わりを見たと言えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ将軍",
      "text": "我々にも多くの死傷者が出た……だが少なくとも二十年は、この賊どもも何もできんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "古人は遠征で大勝を収めると、最も遠くの岩に自らの戦功を刻むと聞いた。今日のこの戦いも、その旧風を模倣するに値するだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズオ将軍",
      "text": "ハハハ、それはいい。しかしこの辺りはどこまでも続く砂漠だ。近くに文字を刻める場所などない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "あるのはこの木だけか、なら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "よし、いいじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "剣を背負う女侠",
      "text": "何がいいのよ！　枯れかけてるのが見えないの？　この上文字まで刻むなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "ならお前の考えは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "剣を背負う女侠",
      "text": "何千里と進む移動都市は一つ所に留まりはしないわ。それなのに戦功を動かない場所に刻んで何の意味があるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "剣を背負う女侠",
      "text": "私たちは今日という日にこの木に出会ったのだし、いっそのこと持ち帰って玉門に植えたらどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "剣を背負う女侠",
      "text": "この木が玉門で根を下ろして、生きている限り、今日の奮戦という日を忘れたりはしないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "（拍手をする）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "うむ、うむ、いい考えだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お前ら日差しで頭がやられちまったかよ……ここから玉門までたっぷり百里はあるぞ、この木を担いで帰ろうってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "差し支えなどないだろう。来る途中で、あれだけ多くの食料と水を消費したんだ、帰りに木が一本増えるくらいなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュオ",
      "text": "ズオ殿とティエイー、こっちにきて手を貸してくれ。根っこを切らないようにな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お前、今師匠と呼んだか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "異民族の装いの少女",
      "text": "師匠は荒野で私と部族のみんなを救ってくれた。家を持つことも教えてくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お前の名は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "異民族の装いの少女",
      "text": "截雲（ジエユン）。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "俺の勘違いじゃなけりゃ、お前はアナサだろ……なのにそんな風流な名を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "師匠が名付けてくれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "道理でな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "「雲動けば千里雨降るも、截てば此の山にて晴るるに在り。」お前らに二度とあてどなく彷徨ってほしくなかったんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "師匠の方が、きれいに諳んじてた。でも同じような意味を話していたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "……ハハ、違いねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "そういや、宗師の名前もあいつが付けたんだったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "薄情者の裏切り者！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "どうしたんだ、急に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "待て、お前のその剣……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "宗師の剣を盗んできたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "私はこの剣を、師匠の墓前に供えに行く。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "風が木の葉を揺らし、槐樹の老木がざわめく。\n炉の火は落ち、空がさらに暗くなる。しかし老人は動かなかった。\n少女には彼の表情がよく見えなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "彼女は――死んだのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "うん。師匠は重い病気にかかったんだ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "師匠の最後の願いは、もう一度この剣を見ること。だから師匠の願いを叶えてあげないと……\nあなたも剣を奪う気か？"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "……もちろんそんなことはしない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "今の玉門は危険だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "知ってる。この剣をとったから、都市の兵士がみんな私を捕らえようとしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "違ぇ、俺が言ってるのは、この都市はこれから危険になるっつーことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "玉門はこれから試練を迎えることになる。だがその前に、せめてお前を送り出してやるべきだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お前の師匠が答えを待っているように……俺たちも決着を待ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "でも、どうやって街を出るの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "来た時には考えてなかった。城門も封鎖されてるし、無理やり出ようとしても……今は怪我をしている。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "風が吹いた。\n細かい砂が老人の顔に舞い上がり、長い歳月によって刻まれたしわの間に入る。\n初春の暮れのしっとりとした空気に包まれて、柔らかだ。\n老人が手で顔をこねた。"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "俺に考えがある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おっと、お帰りですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "状況はどうです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "使い走りの通行人",
      "text": "医館には医者も下働きもいなかったわ。でも官服姿の若いお兄さんがいて、何をしに来たかと聞かれたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "それであなたは何と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "使い走りの通行人",
      "text": "あなたに言われた通り「昨日の夜に店の棚が倒れて、うちの人が頭を怪我したから医館に連れてきたけど、その時は急いでいてお金を持ってなかったので医療費を払いに来た」って言っといたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "使い走りの通行人",
      "text": "そのお兄さんは、私の言葉を聞いて行っちゃったわ。変なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "使い走りの通行人",
      "text": "はい、預かった医療費。払えなかったから返すわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そのままもらってください。ちーとばかりの手間賃ということで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "使い走りの通行人",
      "text": "おかしなこともあるもんね。玉門の観光シーズンってこんなに稼げたかしら……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "リーさんは抜け目ないお方じゃが、若輩にまで一杯食わせるなんてのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "若輩ってねぇ。彼は司歳台の持燭人ですよ。騙す度胸なんておれのどこにあるっていうんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "おれは、彼のために間違った答えを一つ排除してやっただけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ところでリンさんは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "散歩じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "龍門の市民公園でお会いしたんなら、その言葉もまだ信じられますがねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "リーさんの方は進展あったかね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そういえば変ですねぇ。リンさんに依頼された件の手がかりはありませんが、むしろおれが探してる人の方は少し糸口がつかめましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "それも吉報じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "リンさんはこの件をおれに依頼しても、ご自身が安心できるとは限らないでしょう。ならどうして、自ら動かれないんです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "わしが手を出せばのう、ウェイの顔をつぶすことになるのじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "それにちょうど、あの子のやり方を見る機会じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "さすがはリンさんですねぇ。こんな時でも、まだ娘さんを鍛える余裕があるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "転ばぬ先の杖じゃよ。それにリーさんは信頼に値するからのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "リーさんを近衛局に留められんかったことを、ウェイはよく嘆いておるわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "その話は勘弁してくださいや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ウェイ・イェンウって人は……使える奴は何人たりとも逃したことはありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "ところで、リンさんはやはりユーシャのお嬢さんに跡目を継がせるおつもりで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "それはワシが決めることではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "もしあの子が残りたいのであれば、龍門には当然あの子の居場所がある。仮に離れたいのであれば、龍門はあの子の後顧の憂いとなるべきではないのじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "あの子がどの道を選ぼうと、リーさんにはいくらか気にかけてやってほしいもんじゃのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "そこまでご信頼いただけるなんて、光栄の至りですねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "お嬢さんの方で、もし力になれることがあれば、もちろん労は惜しみません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン",
      "text": "ではワシは散歩の続きをするので、ここらで失礼しようかの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "なあワイ・テンペイ。ワイ・テンペイよ。おんなじ父親だろうに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リー",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "お前、ここに来る途中に巡防営が都市全体に公布している通知に気付いたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "欽天監の観測台が出した最新の測定結果によるとな、天災を避けるため、玉門は航路を修正するようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "明日の申の刻から、都市全体が減速を始め、およそ酉の刻の終わりに速度が最も遅くなり、航路修正完了後に再び加速する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "その時がチャンスだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "でも、都市が減速するなら、城門の守備はきっとより厳重になるはずでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "ジエユン、お前さんは玉門に入る前、この都市をよく見たか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "千里も続く果てない砂漠。人の訪れもまばらな辺境。災いが頻発する場所。だがそれでも炎国の領土だ。玉門は初めから、北方を守る軍事要塞として設計されている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "だからこそ、他の一般的な移動都市とは違って、玉門の外壁にゃ特別に「排砂溝」が設けられているんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "まあまともに考えりゃ、排砂溝が人の通る道になることは絶対にありえない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "排砂溝になんて飛び込んだら、タービンにミンチにされるか、逆巻く砂に埋もれて窒息するかだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "けど明日の酉の刻、玉門が最低速度で移動し、排砂溝の稼働も最も遅くなる時なら……まだわずかな可能性があるかもしれねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "やってみる！　私はどうしても都市を出ないといけないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "だがお前、その傷で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "もう医館で手当てはしてもらってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "排砂溝は普段警備が薄いとはいえ、今は場合が場合だ。街全体で戒厳令が敷かれているから、どうなってるかはわからねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "ここに来る途中、今は玉門の将軍が自ら城楼で兵を率いて指示してると聞いたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "どうやら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "結局は会わなきゃならねぇか。そうしないと結果はでないようだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジエユン",
      "text": "出掛けるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "善は急げだ、状況を探ってこなきゃならん。それに排砂溝から都市を出るなら、まだちょっと準備が必要だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "俺が出ている間は入り口に一時休業の札を掛けておく、お前はこの隙にちゃんと休んでおけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モン・ティエイー",
      "text": "時が来たら迎えに来る。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お嬢様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワイフー",
      "text": "ユーシャ姉？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "あなたたち私の部屋で待ってて、すぐに行くから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "何か異常はあった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "お嬢様が去った後、中から鉄匠のなりをした奴らが出てきて、荷物をほかの場所へと運んで行きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "後をつけようとしましたが、相手は明らかにその道の者のようで、すぐにまかれてしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "倉庫に戻って確認しましたが、中はもぬけの殻でしたね。何を隠していたかは知りませんが、怪しいのは明らかです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "お嬢様の勘は正しかったですね。あの鋳剣坊には何らかの問題がありますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "藪を突つくのが早すぎたわね。まだ確たる情報を握れていないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "玉門を覆う暗雲は分厚くなる一方ね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "事態は急を要するし、疑わしいなら少し突っ込んでみましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "龍門諜報員",
      "text": "お嬢様？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーシャ",
      "text": "軍営までお使いを頼むわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
