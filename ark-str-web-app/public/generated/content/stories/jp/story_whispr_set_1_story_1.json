{
  "server": "jp",
  "storyId": "story_whispr_set_1_story_1",
  "groupId": "story_whispr_set_1",
  "stageId": null,
  "title": "雨降る前に",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_whispr_1_1.txt",
  "sourceHash": "15a7e71be99c34c3932cab01ef912dce1da70f70cd9776859ea4feb904a06ffd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "こんにちは、ローラさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "「……高き塔を水煙が立ち隠し、雨はしとしとと、幾千本の傘に降り注いだ……」",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あっ、先生。こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "読書してるところを、お邪魔してすみません。今日の具合はどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "うーんと……ケガしたところはもうそんなに痛くないけど、よくめまいがするし、物がはっきり見えなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "そうですか……点滴の速度はどうですか？　気分が悪かったりしませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "ちょっぴり腕がひんやりするけど、もう慣れましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "先生、点滴はあと何日続くんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "それは……経過によりますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "長くなりそう？　外に出て散歩したいなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "もう何日も寝っぱなしな気がして……動いてないのに、なんだかすごくだるくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "そんなに長くはかかりません。ただ、傷口はまだ完全には塞がっていませんから、自由に動くのは治りきってからですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ただ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "あの源石爆弾の爆発に巻き込まれた子ですが、血液検査の結果が出ました。病状は目に見えて悪化してきてますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "こちらでできる限りの応急処置はすべて行い、悪化の速度はある程度抑えられましたが……急性感染ですし、開放性損傷も数箇所に及んでいましたから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "それと、造影検査の結果によれば、彼女の体内にある源石はすでに視神経を圧迫しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "はい……本人も自覚症状を訴えています。時折、視界がぼやけることがあると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ロドス製の抑制剤を投与しても、病状は落ち着いていません。このままだと……おそらく彼女は失明してしまいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "あの子の今の状態を考えて、これ以上悲しい知らせを受けたら、耐えきれるかどうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "病床にいるのが私なら、何も知らずに不安でいるよりは、どんなに残酷な事実であっても教えてほしいと思うかもしれません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "しかしあの子の場合、まだ恐怖に直面していませんし、永き悪夢も始まっていません。少しでも長く、安らかな日々を過ごさせてあげられたらと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "私知ってるよ。自由に動けるようになっても、しばらくはお医者さんの観察が必要なんでしょ？　鉱石病が落ち着いてからじゃないと退院できないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "それとね、昨日もう一人の先生が教えてくれたの。ロドスはとっても大きな船で、スタッフさんに付き添ってもらえば、病棟の外を散策してもいいんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あと、図書室からこの本を持ってきてくれたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ええ、ロドスはとても広いです……できることは、まだたくさんあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "さぁ、ガーゼの交換をしますよ。こちらの作業は気にしないで、どうぞ本を読んでいてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あの、声に出して読んでいてもいいですか？　薬瓶とピンセットの音がちょっと怖くて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ええ、もちろん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "「傘を忘れた私は、通りの向かいの喫茶店の軒下に……不思議な人がいるのを見た。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "「彼女は……時代遅れの服を着て……リュートを抱え、ささやくように……雨の帳に歌いかけていた。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "「音符が、途切れ途切れに漂ってくる。しばらく経って、ようやく聞き取れた。歌っていたのは……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "……歌っていたのは……えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "「春雪を忘れるように、私のことを忘れてください。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……すみません、つい言ってしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "いえ、ありがとうございます、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "目を閉じてしばらく休んでください。今日はたくさん本を読みましたから、目が疲れて、文字が霞んで見えるのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "先生もこの本を読んだことがあるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ええ。ただ、この本を原作にした映画の方がもっと有名で、私は何度も観ました……馴染みのあるセリフを聞いたら、思わず口に出してしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "じゃあ、映画での主人公はどんな見た目ですか？　私はね、髪が赤くて、背が高くて、線の細い女の子だと思うの。話す時はこんな変顔もして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "――うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "う、動かないでください……顔の傷はさほど深くないですが、治るまで時間が掛かりますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "えへへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……映画の主演俳優の外見は、あなたの想像とはやや異なります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ただ、映画のストーリー自体、原作そのままというわけでもありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "まずは自分で想像しながら原作を読んで、それから映画でどう表現されるのかを見比べる……私はその方を好みますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "へぇー、いいですね。じゃあ私ももうネタバレは聞きません。この本を読み終えたら、自分で映画を観に行きます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あっ、でも私、感染者になっちゃったから……映画館にはもう入れないのかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "昔はよくママに連れて行ってもらってたよ。超ビッグサイズのポップコーンを買って、二人でシェアして食べるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "ママがね、映画の途中は喋っちゃダメだって教えてくれたの。それを守って、わからないところがあっても、ちゃんと映画が終わってから聞くようにしてたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "私、ずっといい子にしてたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "うぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……あまり落ち込まないでください。少なくとも、ロドスのマルチメディア室で映画を観ることはできますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "本物の映画館規模のスクリーンはありませんが、自分だけで鑑賞したり、友人同士など少人数で映画を観る分にはぴったりではないかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "映画の音声を楽しむだけでも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "それじゃあ先生、私が歩けるようになったら、連れていってくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "えっ、私ですか？　でも私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "ロドスを離れるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "はい、もう随分と長く滞在しましたから。それに、いつの間にか皆さんとも親しくなってしまい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……それが怖くなるほどに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "あ、いえ、ウィーディさんが怖いという意味ではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "うん、わかってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "いつ行くか、もう決めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "この前、新しい患者さんが入りましたから、彼女の病状が落ち着いてから行こうと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "じゃあ、とりあえず秘密にしとく？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "はい、お願いします。人を悲しませるようなことを口に出すのは……やはりどうしても……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……すみません。もしかしたら、忙しくて行けないかもしれませんから、今はお約束できません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "大丈夫だよ。そうなったらまた他の先生にお願いしてみるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "薬、塗り終わりました。何か気になるところは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "特にないと思う。ありがとう、先生。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あ、待って先生、このブックスタンドの高さを調整してもらえませんか？　このままだと字がぼやけて、なんだか見づらくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "鉱石病にかかってから、目が悪くなったみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "いえ、それは目が悪いわけでは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "そうですね、視力に影響が及ぶのは事実です。ですが具体的にどの程度になるのかは……今の段階では、確かなことは言えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "たくさん本を読んで、外の綺麗な景色もたくさん見ましょうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "つまりその子は、自分がじきに失明するとも知らずに、映画を観たいと思ってるわけね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "はい。でも私は彼女の期待に応えてあげられませんでした……真実でも嘘でも、あまりにも残酷ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "でも、その子の願いは叶えてあげたいんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "できることなら、一緒に観てあげたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "それに、映画の半券を記念にとっておけたら、私も嬉しいです……ロドスで観る最後の一本になりますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ただ、その時には、あの子はもう見えなくなっているかもしれません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "そうね。過去にロドスで開いてきたような上映会なら、ちゃんとした規模でも技術面で言えばシンプルだし、会場のセッティングもわりと簡単にできるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "つまり……あの子の願いを聞くべきということでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "その判断は、もちろん医師であるあなたがしないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "でも、人のためじゃなくとも、単に自分のために企画して、半券を残すのもありじゃない？　ロドス最後の記念として。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "自分のため、ですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "しかし、設営を手伝ってくれそうな人選など、私には……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "そういう心配ならいらないよ、それくらい私一人で十分だから。畑違いだけど、想像するに大した工事じゃないはずだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "チケットで入場できるようにするだけでいいなら……うん、券売機と自動ゲートを導入して、無人映画館風にしようか。その方があなたも気が楽でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ありがとうございます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "いいの、私にとってはなんてことないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィーディ",
      "text": "素敵な思い出になるといいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あなたは……映画の話をしてくれる、あの先生ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "すみません、このところ目がよく見えなくて、足音でしか区別できないんです……間違ってたらごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……いえ、間違っていませんよ。こんにちは、ローラさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あぁ、よかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "先生、そういえば先生のことは何と呼んだらいいんですか？　他の先生は名札をつけてるけど、先生はつけてなかったから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "私のことは、気にしなくても大丈夫です……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "もう一回、身体検査をしますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "はい、それじゃお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あのね、先生。わたし、本当は怖いの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "目がどんどん悪くなっているのに、なんでなのかはみんな教えてくれなくって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "鉱石病は治らない病気だっていうのは知ってるけど、まだ心の準備が……私、もしかして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "そんなに心配しないでください。今のところ、命の危険はありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "病状はだんだん安定してきていますし、お腹と足の傷も順調に回復しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "今回の検査の結果を見て、抜糸の日を決めましょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "もうすぐです……早ければあと二日もすれば、映画を観に行けるかもしれませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "本当ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ええ……あっ、そうでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "数日後にちょうど映画の鑑賞会が開催されるそうです。ローラさんの読んでいる本を原作にした、例の映画が上映されますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "自由に動けるようになったら、一緒に観に行きましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "本当？　わぁい！　約束ですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ええ、約束します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "じゃあ……検査しながら、あの話の続きを教えてくれますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "本当は自分で読みたいけど、今字を読むのが大変だから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "目を閉じて、リラックスしていてください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "たしか昨日は……主人公が過去からやって来たという吟遊詩人とともに、リターニアのとある移動都市にたどり着いたところまで話しましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "その吟遊詩人は移動都市に入るのが初めてで、入口の昇降機に乗っただけで、とてもびっくりしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "吟遊詩人からすると、都市はきっとすごく騒がしい場所だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ええ、とても。彼女は鋭い耳を持ち、音律を聞き分けることができますが、そんな彼女にとって、都市に身を置くと耳に入ってくるのは騒音ばかりでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "アーツユニットをはめ込んだ、機械で調律する楽器を目にするのも初めてでした。奏でる音そのものがまるでアーツのようで、彼女の心を掴みました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "都市の人々は吟遊詩人の到来を歓迎し、多くの塔の主が彼女を客として招きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "でも彼女は過去から来た人で、元の時代に帰る方法を探しているんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ええ……しかし実は、彼女には帰れる場所がないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "――あっ、やっぱりいい！　そこは映画を観る時に、自分の目で確かめることにするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……そういえば、ローラさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……映画の楽しみ方は、画面を見る以外にもありますよ。様々な音や声を聴いて、楽しむこともできるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "弾き語りをする吟遊詩人の声、空を飛ぶ羽獣たちの鳴き声。主人公たちが歩いた森を通り抜ける風の音、小屋の屋根瓦にサラサラと降り注ぐ雨の音……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "マルチメディア室を借りて行う上映会なら、小声で話しても大丈夫ですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "その時、もし……よく見えないところがあれば、説明してあげることもできますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "ウィスパーレインさん、少し休憩しませんか。ドライベリーをどうです？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ありがとうございます……でも、大丈夫です。患者さんを待たせていますので、ローラさんの検査結果を確認したらもう行きます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "たまには息抜きも大事ですよ。ウィスパーレインさんも、お身体が弱いんですから、人の面倒を見てばかりじゃだめですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ありがとうございます。私のことはどうぞご心配なく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "そういえば、この間ローラさんと映画を観に行くって言ってましたよね。ひょっとして土曜日の鑑賞会のことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "そうなんですね……それで、もうあの子には伝えたんですか？　最悪の場合、その頃にはもう何も見えず、映画も音しか聞けなくなるかもしれないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "それは……まだです。今のあの子にとっては、映画を観に行くことが一番の楽しみですから、先走って失望させたくはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "そうですね。いずれにしても、源石事故が起きる前の日常を追体験させることができれば、いくらかはストレスの緩和にもつながるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "彼女の体調が落ち着いてきたら、わたしもおやつを持って会いに行きますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "もちろん、ウィスパーレインさんの分も持っていきます。今度こそ一緒に食べましょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "今度、ですか？　……はい、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "そうだ、最近談話室に来るオペレーターたちにも、週末の鑑賞会を勧めてみますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "観客が多い方が、より映画館っぽくなりますよね？　患者さんたちにとってもコミュニケーションの場となって、自信回復のきっかけになれるかもしれませんし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "はい……ありがとうございます。ロドスでの出来事は、きっと忘れません……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "――これは……ハニーベリーさん、ここを見てください……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "さぁ行こう、もうすぐ上映会の時間だよ！\nそれ、いったい誰が企画したんだろうね。\nさぁ……聞いてないし、見当もつかないよ。私はハニーベリーさんに勧められて知ったんだ。\nだってチラシも看板もないんだぞ。一夜にしてマルチメディア室にミニ映画館が出来たって感じ。\n入り口でチケットのもぎりもないようだし、全部セルフサービスみたいだな。\nでもさ、チケットを印刷できるってことは、入ってもいいってことだよな？　対象外とかどこにも書いてないしさ。\nへえ、この映画、ずっと気になってたやつだ。ウィスパーレインさんの評論を読んでから観てみたいと思ってたんだ。\nうん、私も！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ローラさん、気をつけてくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "大丈夫だよ、先生。ちょっと暗いけど、これだけ高い階段は流石に見えるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "わぁ、本物の映画館みたい……人もたくさん……私、入ってもいいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "大丈夫ですよ。日常的な接触では感染を引き起こす心配はありませんので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "じゃあ、一番前の列に座るね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "おっきいスクリーン……これなら私でもよく見えるかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "先生、忙しいんだったら私に構わず、行ってもいいですよ。あとで自分でちゃんと病室に帰れるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "いえ、一緒に居させてください。私もこの物語を、もう一度観たいですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "――これは……ハニーベリーさん、ここを見てください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "こちらの造影検査の結果を比較すると、ローラさんの体内の源石の拡散は……抑制されているように見えますが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "わあ……本当だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "これで二人とも安心して映画を観られますね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "まだほかに心配事でも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "何か悩みがあるのなら、わたしに話してみませんか？　嬉しいことでも、悲しいことでも、口に出すと気分が良くなりますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "安心してください。こう見えて資格のある認定心理カウンセラーですから、遠慮は要りませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハニーベリー",
      "text": "それに、口に出してみないと、相手がどう反応するか案外わからないものですからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "この映画……エンディングがよくわからなかったけど、ぼんやりと何かがわかった気もする……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "あれ、先生、泣いてるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ええ、ですがお気になさらず……これは単に、ラストシーンの音楽を聴くたびに、色々な思いが浮かんでくるからで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "この結末は、人によって捉え方が違うんです。私もその時々の心境で感じ方が変わります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "じゃあ、私ももう少し大人になってから、もう一回この映画を観てみようかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "先生、ここまで付き合ってくれて、本当にありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ローラさん、少しお待ちを……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "お詫びしたいことがあります。とても大事なことをひとつ、ずっとあなたに黙っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "もう自覚されているように、あなたの視力は鉱石病の影響を受け、少しずつ落ちてきています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "今のところ病状は抑えられていますが、源石による体の損傷は……元には戻せません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "つまり、いつかは何も見えなくなってしまう、ということですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……はい。それがいつになるかは断言できませんが、そう遠くはないはずで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "実はね、そうなんじゃないかなって薄々気付いてたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "ずっと黙っていて、ごめんなさい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "大丈夫だよ、先生。私、もうじっくり考えたの。この映画だって、観られなくなる覚悟が出来てたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "ここ最近は、毎日精一杯目を見開いて、街並みや建物、花や草の姿を覚えて、青い空も白い雪も目に焼き付けるようにしてるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "鉱石病で、いつまた体が痛くなるかわからないし……朝起きたら何も見えなくなってる日だって、いつ来るかわからないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "それでも、そんな日が来るまでに出会えた全ては、頑張ってぜーんぶ頭に入れようって決めたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "……好きな人も、気にかけてくれる人も、みんな覚えていたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "名前を聞くだけで、その顔を思い出せるようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "年をとったおじいちゃんが、私のことがわからなくなるのと同じように、本当にどんなことでも、月日が経てば忘れ去られていくんだとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "たとえいつか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "たとえいつか、映画のタイトルを聞いても、それが自分にとってどんな意味を持つのかさえ、思い出せなくなったとしても……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "それでも、映画の最後のシーンで雨の中に消えた吟遊詩人のように……この時代の風雨に打たれながら、舞い踊った彼女の姿は、ちゃんとそこにありましたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "あっ、ごめんなさい。また勝手に続けてしまいました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "いいえ、私も同じようなことを感じてたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ローラ",
      "text": "そういえば、吟遊詩人さんは最後、元居る場所に帰ったのか、それとも私たちの時代に残ったのか、先生はどっちだと思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "今であれば、私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "あなたは、よくマルチメディア室にいらっしゃる方……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "（会釈）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "（会釈）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "……来週の土曜日、マルチメディア室を借りて、『メモリー・ドリフト』を上映しようと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "text": "観に来ないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "来週の土曜日、ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウィスパーレイン",
      "text": "……はい、ぜひ。お誘い、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
