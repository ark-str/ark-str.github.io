  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第八关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――突撃する！　私に続け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "！？　は……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "な、なんだあいつら……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "――まったく、注意が足らんな。どこを見ている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "う、うわああっ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ふぅ……って、うおっと、まずい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "レユニオンの連中、後ろから迫ってきてます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "この速度ならついてはこられん！　奴らに構わず、全力で進め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "あと少しで、レユニオンが占拠したエリアを抜けられるはず――だから止まるな！　走るんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "――貴様らのような狼藉者に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "text": "我らの道を、阻めるとは思うな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
