  "blocks": [
    {
      "type": "narration",
      "text": "第八关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "――突撃する！　私に続け！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "！？　は……？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "な、なんだあいつら……！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "――まったく、注意が足らんな。どこを見ている！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "う、うわああっ！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "ふぅ……って、うおっと、まずい！"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "レユニオンの連中、後ろから迫ってきてます！"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "この速度ならついてはこられん！　奴らに構わず、全力で進め！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "あと少しで、レユニオンが占拠したエリアを抜けられるはず――だから止まるな！　走るんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "――貴様らのような狼藉者に――"
    },
    {
      "type": "dialogue",
      "speakerName": "ニアール",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "我らの道を、阻めるとは思うな！"
    },
    {
      "type": "sceneBreak"
    }
  ],
