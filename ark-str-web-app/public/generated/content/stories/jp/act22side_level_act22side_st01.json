{
  "server": "jp",
  "storyId": "act22side_level_act22side_st01",
  "groupId": "act22side",
  "stageId": "act22side_st01",
  "title": "荒地に響く鐘",
  "storyCode": "FC-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act22side/level_act22side_st01.txt",
  "sourceHash": "d820e14daef4fefad9d1a719022e524fc4780d48735338eee8a8529bf92b6f5e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "八年前\n1090年\nオークグローブ郡"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーモラスな貴族",
      "text": "伯爵、私たちの次の計画について、多くの方々が知りたがっているようですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーモラスな貴族",
      "text": "伯爵のご支援のおかげで、私たちの演目は大成功を収めることができました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーモラスな貴族",
      "text": "ターラー人自身の劇場、ターラー人自身の歴史……初公演で二百人もの方々が見に来てくださるなんて、大変喜ばしいことですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーモラスな貴族",
      "text": "今後は、マケナニー男爵の領内にある複数の工場に対して協力を求めたり、あるいはこちらにいらっしゃる銀行家の方々による共同誘致を受け入れることも視野に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "そういった話はパーティーの後にしていただけるかな、パース卿。どうしても商売の話がしたいのなら、手持ち無沙汰のタイピストにでもお願いするといい。誰がやろうと結果はそれほど変わらんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "このパーティーで取り上げるべき話題は、先ほど終演したばかりの舞台、そしてターラーの文化についてのみであり、ヴィクトリア人の煩わしい礼節や利益の追求は捨て置くべきだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "諸君、こうした身分やマナー、雅やかな話し方、思想を語り合うための耳障りの良い語彙の数々は、すべてヴィクトリア人による教えだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "こうしたものはヴィクトリア人の機械と同様に、身も心も冒す現代病をターラー人にもたらした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "かつての我々には、生来の高潔さと勇ましさしかなかった。ゲル王から受け継いだのは、戦いの号令が聞こえれば猛り昂り震える、そういう血だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "しかし、ヴィクトリア人の狡猾さと虚栄を学んだ今、我々は正しき物事や理想を前にしても、利益を目的とする駆け引きを行うことしかできなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "我々のみならず、街中でよく見かける小市民のターラー人においてもこれは当てはまる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "彼らはヴィクトリア人の悪徳に染まったがゆえに、鉱石病患者やごろつき、そして暴徒になるのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーモラスな貴族",
      "text": "まさにおっしゃる通りですわ、伯爵──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の詩人",
      "text": "──申し訳ございません、手が滑ってグラスを床に落としてしまいました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "ふむ、グラスは口ほどに物を言う――ということかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の詩人",
      "text": "……伯爵、あなたにお伺いしたいことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "構わないが、まずは名前を伺っても構わないかな。すまない、物覚えが悪いものでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の詩人",
      "text": "ウィリアムズと申します。詩作を生業としていまして、今宵の演目に関しては劇作家でもありますが、名を覚えていただく必要はありません。文壇では取るに足らない小粒です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "ウィリアムズ君、そうかしこまらずともよい。先にも言ったが、私はヴィクトリア人の煩わしい社交辞令など不要だと考えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "何でも遠慮なく尋ねてくれて構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の詩人",
      "text": "……あなたはターラー人を病人になぞらえましたね。では、我々はどうやって自らを治療すればよいのでしょうか？　どうやって他のターラー人を救えばよいのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "恐らくどれだけ努力をしても、我々の身に巣食う病を根本から治すことは不可能であろう。すでに濁った水が、自ずから澄んだ状態に戻ることが叶わぬように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の詩人",
      "text": "つまりあなたは、ごろつきや暴徒を救うことは不可能だと思われているのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の詩人",
      "text": "彼らは単に知識や教育が欠けているだけで更生の余地はあると――私たちの筆で助けることができるとは思われないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "はぁ、過ぎたる知識こそまさしく我々の敵なのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "もちろん、我々はターラーの理想郷を書き、叫び、夢見ている……この身に流れる血に眠る、ターラーの記憶を呼び起こそうとしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "だが君や私は、結局のところこの旧時代で生きるしかないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "私は今宵の君の作品に心からの賛辞を送りたい。しかしながら、今それをヴィクトリアの言葉で君に伝えている。つまりは、そういうことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の詩人",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "「私が戦士の栄誉を手放すのは、今後ターラーの土地を二度と血に染めぬようにするため。そしてドラコの同族が二度と剣を向け合わぬようにするためである。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "「赤き龍の炎が、死した戦士を溶炉の中から蘇らせるような日が来ない限り、私の選択は変わらない。」――印象的な一節だったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "質素な服装の詩人",
      "text": "お気に召されたようで大変光栄です。とはいえ、これらは元をたどれば民謡の記録であって、私は舞台での響きを重視して少々言葉に手を加えただけですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "いや、私が言いたいのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "ターラーに次の赤き龍が現れないとは限らない……ひいてはもう現れているのかもしれない、ということだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ワーウィック伯爵",
      "text": "ドラコを見たことのない現代人に、目の前を横切った者がヴイーヴルかそうでないかの判別などできないだろうからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "1098年\nスカハンナ原野 レッドリッジ"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "見付けたぞ。街をうろついてたのはこの二人だ。さっきの窓ガラスが割れた音もこいつらに違いない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "お前ら、首にも縄を掛けられたくなきゃおとなしくしてろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ペッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "やめろ、この期に及んでまだそんな態度を……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "も、申し訳ありません！　士官殿！　どうかお許しを！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊長",
      "text": "ダブリンと繋がっている指名手配の連中か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "片方はリストにいますが、もう片方は見たことがありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊長",
      "text": "フッ、やっぱりな。ターラー人なんてのは全員グルなんだよ。まともな奴なんてほとんどいないんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ううっ！　どうか暴力だけは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "私たちが盗ったのはこれだけです。ボディチェックもしたでしょう……質問がお有りでしたら、嘘偽りなく答えますから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊長",
      "text": "つべこべ言うな。お前たちの仲間は？　どこへ行った？　ダブリンに伝令に行ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そ、それは本当に知りません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "私たちに仲間なんていません。ダブリンの人たちだって見たこともありませんよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "お前らはただ、上の貴族に報告するために、そこら辺の奴を適当に捕まえて殺したいだけだろ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "この……ヴィクトリアのクズどもが！　ペッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊長",
      "text": "いい度胸だな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊長",
      "text": "皆の休憩の邪魔だ、このごろつきどもを騒がせるな。連れていけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊長",
      "text": "まずは、そっちのおとなしい荷物持ちを尋問しろ。素直に吐くようなら、あまり痛めつけなくていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "わ、私は全て正直に話しました。何も知らないんですよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "待ってください、隊長。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "付近にまだ何者かがいるようです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "なっ！　あ、あれは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "おいお前、何を勝手に叫んでる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……火だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "黙れ、仲間を逃そうなどと考えるなよ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "──本当にあなたたちの後ろから火が出ているんです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "……倉庫の方だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊長",
      "text": "*ヴィクトリアスラング*、第一小隊を呼べ！　消火が先だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "あれ、私たちを置いていった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ヴェン、早く縄を解いてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ど、どうしろって言うんだ？　私だって縛られてるんだぞ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……君は誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……早く逃げて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "はぁ、どちらのお嬢さんかは知らないが、巻き込んでしまって申し訳ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……もう振り切ったし大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "おい、ヴェン、ラジオは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ここにある。まだ使えるはずだよ。音は少し小さいけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "小さい方が好都合だ、気付かれにくい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ふぅ……じゃあ耳寄りな情報が聞こえてきたら教えてくれ。私は水たまりで顔を洗って頭を冷やしてくるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そっちのヴイーヴルさん、もし身の危険を感じているなら、行ってもらって構わないよ。道を教えてあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "大丈夫……キミたちの準備が整うのを待つよ。私が見張りをやっておくから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……そうか、ありがとう。君はほんと親切な人だな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "（深呼吸）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ビクビクするな、ヴェン、気を強く持って……血が見えなきゃ別に何も怖くないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "お前が触ってるのは血じゃない。本当に血なんかじゃなく、単なる沼の泥だ。洗えばきれいになる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "（大きく息を吸う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "くっそ……おい！　これ本当にまだ使えるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……頼むからでかい声は出さないでくれよ。兵士がまだ近くにいるはずなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "叩いたり振ったりしても直らないかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの声",
      "text": "……夜九時三十分頃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "よし。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの声",
      "text": "トレント郡付近の集落で発生した放火事件は……手口がダブリンのものと酷似しており……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの声",
      "text": "……容疑者三名が、現在も逃走中……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの声",
      "text": "……ダブリンの情報を持っているにもかかわらず、それを隠匿した者は……反乱組織と同罪であると見なされ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの声",
      "text": "……再度お知らせします……鎮火の鐘が鳴った後は外出禁止となります。採掘場、工場以外の地区では、一切の灯火を禁じ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの声",
      "text": "……反乱組織に与するような行動に及ばぬよう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオの声",
      "text": "（無信号のノイズ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "*ターラースラング*。夜九時以降は、ニュース以外マジで何も放送してねぇみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "こりゃどんな*ターラースラング*な決まりなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "おっと……もしかしてターラー語がわかんのか？　汚ねぇ言葉が出ちまったけど、まぁ許してくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "ええ……でも大丈夫。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "けどやっぱ謝るよ。あんたみたいな部外者を巻き込んじまって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "平気……ターラー人は、どこでも一緒だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "だけど、前にスカハンナ原野に来たときは「鎮火の鐘」なんて規則はなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "そうか──ってことはあんた、移動都市に住んでる人なんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "鐘が鳴ったら明かりも火も全部消せだなんて呆れるよな。この規則は実際何年も前からあったんだが、元は荒野だけの決まりで、お偉いさんの狩り場で密猟する奴を見つけるのが目的だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "もし誰かが荒野で松明を灯して野獣を追っていりゃあ、遠くからでもはっきり見えるってわけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ただ、規則が変わって厳しくなってな、そんで今みたいに面倒なことになっちまったんだ。夜中に巡回してる奴らは、街を出歩く人間を見つけ次第、捕まえるんだぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "おう、ヴェン、頭は冷やせたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "まあ少しは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……それで、薬は一つも残ってなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "わかりきったことを聞くな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……はぁ。万年筆を無駄にしたよ、これじゃ帳簿もつけられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "俺たちは奪うために行ってんだ。料金代わりに金目のものを置いてくるなんて呆れるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "私たちが出てきてどれだけ経った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "真夜中を回ってなければ、十二日目だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そうか。十二日歩いても、全然遠くまで来てないな。晴れればここからでも村から上る煙が見えそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "こんなふうに兵士に追われて、この辺を堂々巡りしてばかりで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "私たちは本当に逃げられるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……キミたち、何があったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "巡回隊と少しいざこざがあって、指名手配されたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "ヴェン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "別に話してもいいだろ、ファーガル。彼女はきっと親切な人だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "巡回隊が私たちの所にやってきて、前科のある人間が全員呼び出されたんだ。その後、彼らが殴りかかってきたから、私たちは応戦して……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "お前はやり返してねぇだろ、ヴェン。自分の手柄にすんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……まぁ、そうだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ああ、前科と言ったけど、大した罪じゃないんだよ。税金を払えず逃げた一家の親戚だったとかね。ファーガルは自家用酒の密造、私は物を売るための手続きに不備があっただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "はぁ、これまではみんな大人しく過ちを認めてたんだけど、あの日はどうにも耐えられなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "巡回隊と争いになった後、逃げたのも私たち二人だけじゃないよ。他にもあの日兵士に呼び出されたのは十人以上いて、みんなで一緒に逃げ出したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "あの兵士たちが捕まえると決めたら、誰も逃げられない。私たちがいくら無実を主張しようと、聞く耳を持たないんだ。だから、ああするしかなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……それで、キミたちは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "そうさ、二人殺ったよ。一人は奴らが油断してる隙にクワで殴りつけた。もう一人は乱闘の最中にどさくさに紛れて倒した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "残った奴を逃がしちまったのが悔やまれるぜ。でなきゃ、俺たちの仕業だってバレることもなかったのによ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ああもう！　逃げる時間がもう一日あれば、こんな悲惨な状況にはならなかったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……ファーガル、自首しないか？　嫌なら私だけで行ってもいい。こんな逃亡の日々にはもう耐えられないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "薬も手に入らなかったし、もうオランの傷口が……彼自身が腐っていくのを、ただ見てるしかできない。私はもううんざりなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "何が自首だ、あいつらが楽に逝かせてくれると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "おめでたいこと考えるなよ。あいつらはまずお前を痛めつけて、それから拷問が始まるだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "お前みたいな奴は、どうせすぐに俺たちのことを全部喋っちまうだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "はぁ……でも薬がないんだ。怪我や病気になったら、苦しむのは結局一緒だろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……キミたち、薬が必要なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "ハハッ……私たちは薬を手に入れる役割を任されてるんだ。彼らは遠くでまだ私たちを待っているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "元々はちゃんと買うつもりだった、本当だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "でも鎮火の鐘が鳴れば、店が全部閉まっちまうことはわかってる。鐘が鳴る前にたどり着くなんて絶対に無理だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "だから巡回隊の交代時間を見計らって──閉店した薬屋で盗みを働こうとしたんだけど……彼らに気付かれるなんて思わなかったよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……今更言っても遅いけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……君は？　都市から来たみたいだけど、なんでこんな廃れた場所に来たの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……探し物をしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "「ダブリン」って知ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……そう、わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "それより、ヴェンさん、怪我しているでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "止血剤と包帯ならここにあるから、これで手当をして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "えっ、気付いてたのか。そんな大した傷じゃないけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "でも、薬を分けてくれるなら、とても助かるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "仲間が重傷で、彼らにも持って行ってやりたいんだけどいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……鉗獣に咬まれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "それなら、私もキミたちと一緒に行って診てあげるから……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "あっちだ！　泥に足跡がある、あっちに向かってるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "必ずこの近くにいる！ 　火を放ったターラーのクズどもめ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "──は、早く隠れるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……一部隊、六人だ、こっちを照らそうとしてるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "姿勢を低くしろ！　急いでこっちにこい！　こっちの足場はしっかりしてる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "大丈夫……あの兵士たちも沼地ではあまり速く動けない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "──シッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "（小声）ヴェン、歯がカタカタいう音がここまで聞こえるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "（小声）私は……ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "懐中電灯が彼らの方向に向けられた。\nリードは槍を握り締めた。その手を伝って金属が熱を帯びる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士？",
      "text": "人に禁止しといて、てめぇらは平気で灯りを点けやがって！　ムカつくんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "ダブリン！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "あの女を捕らえろ！　情報を引き出せるはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士？",
      "text": "アタシを捕らえるだって？　無理に決まってんだろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "うわっ！　泥を投げてきやがった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "うっ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ターラーの流民",
      "text": "行くぞヴェン、あいつに加勢するんだ！　ビビるなよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "えっ、えっ、わかった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "巡回隊隊員",
      "text": "ぐっ──！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士？",
      "text": "ハッ、この新兵ども、大したことねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダブリン兵士？",
      "text": "おい、ヴェン、ファーガル！　一体何をやらかしたんだ？　アタシが来てやんなきゃ、今頃死んでたんじゃねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "はぁ、まったくだ。君のおかげで、命拾いしたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "だからこういう荒事は私には無理だって言ったんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……待てセルモン、何をする気だ？　気絶させれば十分だ。まさか全員殺す気か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そんなことしたら、私たちの罪が重くなるだけじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "変わりゃしねぇよ。こいつらにとっちゃ罪の重さなんて関係ねぇんだからな。ただ捕まえて殺すしか能がない連中だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "いや、でも私にとって罪の重さは重要なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "この腰抜け野郎が。よく見とけ、アタシがこのヴィクトリアのクズどもを──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……待って。やめて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "ああ？　アンタ誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "ハッ、なにガン飛ばしてんだ？　密告でもする気か？　やれるもんならやってみろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "密告？　そもそもキミはダブリンの人間ではないでしょう。どうして……そんな格好をしてるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "どうして亡霊部隊の真似なんかを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "──なにを根拠にそんなこと言ってんだ？　ダブリンをよく知ってるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "あー、落ち着いてくれ、セルモン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "彼女はただの医者で、私たちと一緒に逃げてきただけなんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "……彼女は良い人だよ。私たちの事情はすべて伝えてある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "そうだ、えーと、先生……さっきの負傷者を診てくれるって話は、まだ有効かい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェン",
      "text": "セルモン、頼むから落ち着いてくれ……私たちはヘマをして、薬を手に入れられなかったんだよ。でもこちらの心優しい先生が助けてくれるって言ってるんだ。今は彼女に頼るしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セルモン",
      "text": "……チッ、そりゃこいつの態度次第だ。この医者はアタシの着てる服のことを知ってるみたいだしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "……ごめん、私は正確には医者ではないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リード",
      "text": "でもやっぱり、私はキミたちを助けたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
