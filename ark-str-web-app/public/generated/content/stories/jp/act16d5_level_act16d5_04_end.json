{
  "server": "jp",
  "storyId": "act16d5_level_act16d5_04_end",
  "groupId": "act16d5",
  "stageId": "act16d5_04",
  "title": "女将",
  "storyCode": "WR-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16d5/level_act16d5_04_end.txt",
  "sourceHash": "a09b69cd8ac9b941a9898c546f1dbeeda7d530a7d3229d68439e07434c2ab8bf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うう、ううぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "お嬢ちゃん、ほら空が明るくなってきたよ。もうかなり歩いてきただろう？　もうすぐ着くから、泣かないでおくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "ううっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "大丈夫、お兄ちゃんがついてるから、安全だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "あぁ……いい子だから泣かないで。もう庭園は見えているよ。あと少しで到着するから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "いやあぁ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ど、どうしてこんなところにいるんだ！　こいつらは太陽を怖がるはずじゃなかったのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "くそっ！　お嬢ちゃん、おぶってあげるから、しっかりつかまっていてくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガアッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "おじさん！　おじさん急いで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "か、髪の毛を引っ張らないでくれ！　メガネが、メガネが落ちる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガァッ！　グァッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "……ウユウくん、逃げ足だけは本当に速いなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "町民",
      "text": "英雄さん、何かおっしゃいましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ん～？　何でもないよぉ。あなたたちは早く庭園に隠れてねぇ。外の警備は私に任せて〜。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "あの小さな墨魎は、普通のオリジムシなんかよりもすばしっこいみたいだけど……どんどんウユウくんに離されてるねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "まさか追いつけないほどウユウくんが速いのぉ？　そんなことってあるぅ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガッ……ガァ……ガァ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "くらえ！　えい！　はっ！　やぁっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "ははっ！　どうだ？　これで追いつけないだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガッ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "おじさん！　もっと速く走れないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "これ前からやってみたかったんだ。映画のカンフースターたちは、路地で追いかけられるときに、必ず何かを投げるからね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "い、いいから！　もっと速く走って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "痛っ！　頭を叩かないでくれよ、私は駄獣じゃないんだから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガウッ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "回り込んできた！？　太陽があんなに眩しいのにどうしたんだ！　こいつらは光を恐れるんじゃなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "た、助けて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "チッ！　仕方ない……お嬢ちゃん、先に逃げるんだ。私が――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガッ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "墨魎",
      "text": "ガ……ガ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "……クルース嬢！？　ああ～恩人様、助けられるんならもっと早く助けてくださいよ――って、どこにいるんです？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ここだよぉ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "わっ……！　お、お姉ちゃん、どこから出てきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "さすが非凡なる狙撃の名手、神出鬼没かつ軽やかな身のこなし、真に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "お姉ちゃん！　おじさんを助けてくれてありがとう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "うっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "早くお家に戻ってねぇ、お母さんがずっと探してたよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女の子",
      "text": "うん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "恩人様、早くラヴァ嬢とお坊様を助けに行った方がよろしいかと。ここは私が守りますのでご安心ください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "あれぇ……？　さっきラヴァちゃんに、必ず助けに戻るって誓いを立ててなかったぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "お、恩人様はなんと恐ろしい地獄耳……ああいや、素晴らしい聴力をお持ちで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "別にそんなことないよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ところでその扇子、どうしていつも手に握ってるのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "や、これは必需品でして。私の一番のお気に入りです。恩師からの贈り物でもありますし、片時も手放したくないんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "それに……へへ、手に扇子を持っていれば、何となく文化人っぽいでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "ふうん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "さっきの墨魎は、どうしてここまで来て平気だったのかなぁ？　ここはもうお昼だよねぇ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウユウ",
      "text": "それはこっちが聞きたいです！　あいつに追いかけ回されて本当に疲れ果てましたよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルース",
      "text": "うーん……まぁ、まずはラヴァちゃんと合流しよぉ～。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……静かになったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ここは夜の端で、明かりもわずかに見えるだけだっていうのに、どうして化け物が襲ってこないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "それは拙僧も不思議に思っておった……今までこんなに静かだったことはないぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "静かなのは、良いことでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "む！　いかにも。これで拙僧もようやく一息つけるでござる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "よっこらしょっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "気をつけて。店の物を壊さないでね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "サガ、さっき言ってたシーウ……というのは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "もちろん『夕娥（シーウ）、月に奔る』の美談に登場する夕娥のことだが？　ああ、拙僧は今でも彼女の両の瞳を忘れられぬ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……？？？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "サガ、もっと順を追ってゆっくり話してあげたら？　ラヴァさんの顔がどんどん曇っていってるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "お、すまぬすまぬ、つい興奮してしまった。さっきは墨魎と戦い、ラヴァ殿もくたびれたであろう？　ここで茶でも飲みながらゆっくり話さぬか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "じゃあ私はお茶を入れてきますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "ああ、先に聞きたいことがあるのだが、レイ殿はここから出る方法を知っておるであろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サガ",
      "text": "知らぬのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レイ",
      "text": "（軽く首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "講談師",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
