  "storyId": "main_4_level_main_04-02_beg",
  "groupId": "main_4",
  "stageId": "main_04-02",
  "title": "雨の中を歩く",
  "storyCode": "4-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_04-02_beg.txt",
  "sourceHash": "2a0151b9c3d3561a421cc3dd22a495f62fde94782baee4fb42ad145d6fe0415a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "て、敵兵をさらに二名確認！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "東側の建物に向けて逃走しています！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "大丈夫、捕捉したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ふっ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "うわっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "我ながらいい狙いね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "だが、少し音を立てすぎじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "そうかしら？　この廃都市ではしょっちゅう爆発が起きてるみたいだし、相手も気にしないと思うわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "それで、ケルシー先生には連絡してくれた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ああ。戦闘が始まる前にしておいた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "というか、今も通信は繋げたままにしてある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "それと、この場所でレユニオンが活動しているようだ、というのはすでに伝達済みだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……ところで、話を戻すが。もっと隠密に徹して行動するべきじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あら、こうする理由はちゃんとあるのよ？　さっきのレユニオンは探知型のアーツを使ってるみたいだったから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "こちらの位置を悟られないように、先制攻撃する必要があったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "だって、ほかの仲間に連絡されるのだけは避けたいでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ふぅ……やっと一段落、ですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "――フロストリーフ、周囲の偵察をお願い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "では、通信機を渡しておこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……ジェシカ、まだ気を抜いちゃダメよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そ、そのくらいは……私にもわかってます、大丈夫ですから……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "はいはい、だったらこれ以上は言わないでおくわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "――ケルシー先生、聞こえてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ああ、聞いている。――君の言う通り、気を抜くべきではない状況だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ジェシカ。君の背後に、敵兵がいる可能性がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "へ！？　わわっ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ど、どうやって……俺の、後ろに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……えっ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "――お前は遅すぎる。だから、こうして背後を取られたんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……ケルシー先生、聞こえたな？　こちらで対処はしておいた。今のところ、問題なしだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "あなたって本当に素早いわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "いつ向かったのかもわからないうちに、気付いたら戻ってきてるなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "実を言えば、まだ偵察に向かってはいなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "では、話を続けよう。――先ほど、レッドから連絡が入った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "龍門内部に潜伏しているであろうレユニオンには、現状、活動の兆候がないそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "となれば、現段階で藪をつついて蛇を出すのは避けるべきだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "また、そちらの廃都市にいる偵察隊からの報告も考慮すると、その場所には、予想を超える規模のレユニオンが潜伏しているものと思われる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "つまり、「当たり」を引いたのは私たちってことかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "こっちはあくまで偵察向けの編成だし、ちょっと荷が重いわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それって、私たちがここで対処してきたレユニオンは全員、その潜伏中の部隊の一員ってことになりますよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "全員？　じゃあ、最初に撃ち合った相手もレユニオンだったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい、間違いないかと。狙撃を始めていただく前に、お伝えしたと思うんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……ごめんなさい、私が聞き逃したみたいね。弾道計算に気を取られてたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "それで、敵兵の数は確認できたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "正確な数は、まだなんともってところね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "フロストリーフ、そっちはどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……？　どうかした……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "text": "ひとまず、そちらの対応を。何かあれば、随時連絡してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "了解しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "フロストリーフさんのほうに、行ってみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "何が気になってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……お前たち、気付かないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "えっ？　何にでしょうか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "温度の違い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……言われてみれば、少し肌寒いような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "そういうことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……確かに。都市の外とは、5度以上差がありそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "もしかして、前触れもなく天気が変わったってことですか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "空を見ればわかるだろう。天気自体に変化はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "それなら、どうして……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "原因は天気じゃなく――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "これにある。触れて、確かめてみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……これ、って言うと……この壁のこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "そうだ。こいつが熱を吸収して、周囲の温度を変化させていたんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……そ、そんなこと、できるんですか……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ああ。だが見たところ、我々が到着する前にその吸熱反応は終わっていたようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "この壁の温度は、もう正常に近いしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "しかし、なぜこんなことが起きたのかという疑問は残る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "そもそも、一連の痕跡を残したのは誰なのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……ここで動き回ってるのは、レユニオンくらいよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "じゃあ、レユニオンの仕業ってことですか……？　一体、どうやって……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "彼らは感染者だ。そう考えると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "昔聞いた噂話を思い出すな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "確か、その連中は――「スノーデビル」と呼ばれていたはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……なんだか……嫌な予感がするわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
