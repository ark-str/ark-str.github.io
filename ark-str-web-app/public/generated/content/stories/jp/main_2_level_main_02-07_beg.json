  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十九关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "う、うぅっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "この子、一体どうしちゃったの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "恐らく、鉱石病発作の前兆だと思います……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "たったの一週間で、ここまで状態が悪化するなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ということは……鉱石病には、急性のものもあるんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカ、君のはどうなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あらら～？　心配してくれてるの～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……アーミヤさん。フランカが死んだら、ロドスでの火葬をお願いしたいのですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ちょっと、リスカム！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "その言い草はひどすぎるんじゃないの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "いつも「言うこと聞かなきゃ鉱石病うつしちゃうわよ～」とか言ってくるフランカが悪い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あ、あはは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ええと……急性のものと慢性のものの違いについては、お話しすると長くなるんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ひとまず、ミーシャさんが非常に危険な状態にあることは確かな事実です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "このままでは、すぐにも彼女の命が脅かされる事態に発展しかねません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "今は、応急処置以上のことはできませんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "病状を鑑みると、なるべく早くきちんとした治療を施すべきだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですから、龍門側には表明しておきましょう。この件の収拾がつき次第、ミーシャさんはロドスに引き渡してもらう、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それが、彼女を連れてきた私たちの責任ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でも、それじゃこの子は……もうじき爆発しちゃいそうってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あいたっ！　なんで叩くのさ～……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "言い方には気をつけろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あっ、そっか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "そういう言い方するようなら……いつかあたしが死んで爆発する時が来たら、最期の力を振り絞って、あなたのそばまで行くことにするわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "えっ、そんなぁ～！　ごめんなさいフランカ様！　罪深い私めをどうかお許しくださ～い！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ふふっ、ちょっとは悔い改めなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "さて、どうあれまずは、ミーシャさんを安全な場所まで送り届けるとしましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――と言っているそばから、何やら揉めごとのようですが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "お前ら、一体何を企んでるんだ！？　さっさとここから出て行け！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "いいからそこを通してくれ！　俺たちだって、感染者同士で争いたくはないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "ハッ、言うに事欠いて通せだと！？　俺たちの家を壊しておいて、近衛局まで呼び込むつもりか？　お断りだ、絶対に通さん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "消えろ、何も知らないよそ者どもめ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "――うわっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者",
      "text": "クソッ、これ以上俺たちを巻き込むんじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "（小声）どうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "（小声）一回撒いたとは言え……ここで動けば、またレユニオンに見つかっちゃいそうだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "（小声）やるとして、どのくらい任務に影響する見込み？　支障が出たりしないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "（小声）ま、確かに多少の影響はあるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "（小声）でも、「支障」ってほどにはならないんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "では、やってみましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "できる限り、感染者の助けになることも、ロドスの責務の一つですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ふふっ、了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "やっぱり、あなたについてきて正解だったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……？　それは、どういう……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ううん、なんでもないの。気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "アーミヤさんの人柄を気に入ってるなら、そう言えばいいのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あら～？　随分あたしをわかってくれてるのね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "いつも鬱陶しい誰かさんに付き合わされてるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ふふっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "さーてと！　それじゃあ、そろそろ悪党どもを懲らしめてやるとしましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "みなさん、ビルの間を飛んでくるレユニオンには気をつけてくださいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "自分の安全に注意した上で、一般の感染者を保護することもお忘れなく！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……簡単な任務、とは言いがたいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "――だが、問題はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だね！　そんじゃ、行ってみよ～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あ、そうそう、Dr.{@nickname}！　ここはあたしとテキサスの指揮もお願いね～！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
