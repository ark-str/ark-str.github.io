{
  "server": "jp",
  "storyId": "act19side_level_act19side_st02",
  "groupId": "act19side",
  "stageId": "act19side_st02",
  "title": "旅立ち",
  "storyCode": "DV-ST-2",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act19side/level_act19side_st02.txt",
  "sourceHash": "1566a0e82bddf4ea026587a086ad3a9674d4f8358344073ced2b92ffd23eb2ae",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ドロシー……ドロシー！　大丈夫なの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "ええ、私は平気よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "す、ストップ、落ち着いて。そのままじゃぶつかっちゃうわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ごめんね、全部私のせいだ……！　フェルディナンドさんが何か企んでるってこと、もっと早く気付いて、みんなに注意してあげられてたら……もっとキミと話ができてたらよかったのに……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あなた……もしかして、監視ステーションから走ってきたの？　顔中煤だらけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……あの人に一発お見舞いしたときについたのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "あの時のこと、よく覚えてなくて……何を掴んでそうしたのかもわからないけど、すっごく手が震えてたことだけは覚えてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "それで少しは気が晴れた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……ううん、ちっとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "最初は失望したんだ。それから、腹が立ってきて……全部終わったあと、逃げたあの人を軍の人たちが追いかけていくのを見たら……今度は悲しくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "フェルディナンドがしたことを考えたから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ううん。あの人が……本当ならできたはずのことを考えちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "こうなった今も、あの人が教えてくれたことは全部覚えてるし……大きな理想を語るあの人の目の輝きは、全部が全部嘘だったわけでもないと思ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "それに、私は今までずっと……あの人に認められることだけ考えてたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "……私って、ほんとにバカだよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "そんなことないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "受け入れることのほうが、否定することより難しい時もあるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "でも……あなたはもう、誰の助手でもないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "彼の影響を受けることだってないけれど、あなたの目には、彼が燃やした炎がきっと焼き付いているはず。だから、彼の終着点はあなたの出発点になるわ。彼よりもずっと遠くまで行くのよ、エレナ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "ドロシー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エレナ",
      "text": "誰の助手でもない、って……これでお別れみたいな言い方じゃない……そういえば、「メインコア」に接続してたみたいだし、どこか具合でも悪いんじゃ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "……そう慌てないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "私は本当に大丈夫だから。信じられないなら、主治医の先生に聞いてみて。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "あなたの身体のことなら、何の保証もできないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "あら、オリヴィア。開拓隊のみんなの検査は終わったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ここにいる最後の一人で終わりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "え、ええっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "「伝達物質」は今も、あなたたちの身体の中に残ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今のところ異常はないけど、この先どうなってしまうかは誰にもわからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "心配しないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "身体の中を流れるこれは、前触れもなく訪れる嵐やそれによってもたらされる恐ろしい病気よりかは怖くない……私のことより、あなたたちのほうが心配なくらいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドロシー",
      "text": "でも、私たちはこんなところで立ち止まったりなんかしないわ。……そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……もちろん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "制御不能となった被造物は、基地を完全に破壊した。\n目前には瓦礫すら残っておらず、ただ一面の銀色が広がっている。\nそう遠くないうちに、それも片付けられてしまうだろう。\nけれども、その痕跡だけは……残り続けることになる。\nふと、銀色の川が動いたように見えた。"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "なんだ、雲が映っただけか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "text": "……情報は受け取った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "text": "基地の件はすでに政府に引き継がれている。協定に従い、ロドスは入手した情報を処分しなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "text": "だが、これで終わりではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "text": "フェルディナンドの協力者について、先程新たな手がかりを得た。今からその情報提供者に会いに行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "text": "ドクター……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サリアは足を止め、顔を上げた。\n雨雲が都市の外からゆっくりと流れてくる。\nその時、100キロ以上離れた場所で――\n二人は同じことを考えていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス/サリア",
      "text": "ひと雨来そうだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……ここまででいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "荷造り、手伝ってくれてありがとな、グレイ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "お役に立てたなら嬉しいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "それに、お荷物自体……その、そこまで多くはなかったですし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "はは、まあな。けど、来た時もこんなもんだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "そうだ。ロドスの人たちにお詫びと感謝を伝えといてくれないか。あんたの言った通り、あの人たちは俺らを崖っぷちから引っ張り上げてくれたからさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "いえいえ、それは皆さんの行動あってのことですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "あなたが声を上げてくれなかったら、僕たちはその手を掴むこともできませんでしたしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……あんたみたいな奴と友達になれて幸せだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "俺はあんたの言葉を忘れない。……それと、あの基地で起きたこともな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "そんで……メアリー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "何？　言っておくけど、あんたたち全員が基地を離れるまで見届けるのが私の仕事ってだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "……俺のこと、逮捕しなくていいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "今回の事件は、一個人の法令違反によって引き起こされた実験事故だ――っていうのが上の見解なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "ライン生命の研究員たちもこれ以上追求する気はなさそうだし、あんたのやった「誘拐」については記録にも残らないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "いや、ここ数日のこともそうなんだが、それより……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "俺が言ってるのは……四年前のことだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "実のところ、俺は一度、実験への参加を考えてたんだけどさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "開拓者ってのは、そんなことしてでもって思うくらいには、それぞれ都市に戻りたい理由を持ってるもんなんだ。で、俺の理由は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "昔、深く傷つけてしまった人に……一番の大親友だった人に会いたいと思ったからだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "俺は、彼女に謝らないといけないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "それに……俺のやったことは、裁かれるべきことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "俺は四年も逃げ回ってきた。最初のうちは、荒野が俺の夢を飲み込んじまったせいで、自分らしさをなくしちまったんだと思ってたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "本当は違ってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "四年前のあの夜、正義と公正を追い求めていた過去の自分を殺したのは、俺自身だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "あんたを捕まえたとして、課される刑罰は二つに一つよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "一つ目は刑務所での懲役。この場合、刑期満了後は感染者収容区送りになるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "そして二つ目は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "開拓者としての労役。この場合、移動都市には二度と入れない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "ああ、わかってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "それじゃ、これからも開拓者としてやっていくことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "お前、それって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "許すとか許さないとか、そういう話はやめましょ。幼馴染がわざわざ見送りに来てあげたんだから、もっと意味のあることに時間を使うべきじゃない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "久方ぶりの暖かな抱擁。\nそれは本当の意味での再会であり、長い時間を経て告げられた正式な別れでもあった。"
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "この先はどこへ行くつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "それが、何日か前にDなんとかいう妙な名前の奴からメールが届いてさ。ちょっと変わった仕事のオファーをくれたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "仲介会社ってわけでもなさそうだし、そいつがどうやって俺たちみたいな開拓隊の連絡先を手に入れたかはわからないんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "……次の仕事は慎重に選びなさいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メアリー",
      "text": "それと、もう犯罪行為は絶対にしないこと。でなきゃ、どんなに遠くへ逃げたって私が必ず捕まえてやるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "あははっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サニー",
      "text": "仰せの通りに、保安官。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう遠くないところから、開拓隊の仲間たちが呼ぶ声がする。\nサニーには今度こそ、本当の意味で旅立つ準備ができていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミュルジス",
      "text": "……基地の撤去が始まったわよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "厄介事を起こしたのはエネルギー課主任だと思うが……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "後始末を引き受けるのは結局ライン生命か。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "んー……でも、これはライン生命が大企業として果たすべき社会的責任ってやつじゃない？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "どちらかというと取引のように思えるが。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "その言葉自体には賛成だ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "まあ、こんな言い分を信じる人はここにはいないでしょうけどね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "……ねえ、あの開拓者たち……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "君はずっと彼らを見ていたようだな。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "……あの人たち、また旅に出るのね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "次は……どんな出会いが彼らを待っているのかしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "何度も何度も、繰り返し旅立っては彷徨って……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "一度離れた家には二度と戻れないし、赴いた先に家と呼べる場所があるかもわからない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "ドクター、ライン生命の社員たちが研究エリアの瓦礫を掘り起こしているんだが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Mechanist",
          "text": "……ミュルジス主任、君もいたのか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ミュルジス……",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "あの質問にはいつ答えてくれるんだ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "質問って言うと……あたしが何を気にしてるのか、っていうやつ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "それを話せるようになった時には……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ミュルジス",
          "text": "あなたならもう知ってると思うわよ、Dr.{@nickname}。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "……ご安心くださいな。すべて片付けましたから。359号基地で起きたことは誰も知りませんし、この件があなたの次の選挙に影響することもありません。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "……ええ。もうトリマウンツを離れて、今はD.C.へ向かっている最中です。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "フェルディナンドですか……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "彼は脅威にはなり得ません。私が保証します。……はい。それでは失礼しますね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クルビア傭兵",
          "text": "ホルハイヤ様……な、なぜ副大統領に嘘を……？　トリマウンツを離れるどころか、ここはまだライン生命の近くですよ……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "それはもちろん……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "当初の目的をちゃんと覚えてるからよ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "彼にはもはや、どれほど歩いたか思い出すことはできなかった。\n喉が痛み、そして渇き、これ以上は身体がもたないと思い知らせてくる。\nそれなのに、トリマウンツはまだすぐ後ろに――\nあるいは目の前にあるようにすら感じた。\n移動都市の影はただでさえ巨大で、それが時間と共にさらなる成長を遂げていく。\n彼は思った。「できるだけ早く……ここを離れなければ。」\nけれど、どこへ向かえばいいのだろう？　一番近い合流地点に行ったとしても……そこにいる人々も、エレナやホルハイヤのように、彼を裏切るのではないだろうか？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "開拓隊の隊員",
          "text": "……止まれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "沈黙するパワードスーツ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "開拓隊の隊員",
          "text": "お前が誰かってことくらい、俺たちにはわかってる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "開拓隊の隊員",
          "text": "フェルディナンド……俺たちにあんな真似しておいて、タダで済むとでも思ってんのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "沈黙するパワードスーツ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "開拓隊の隊員",
          "text": "鉄の塊着てるからって俺らがビビると思うなよ。お前は口だけは達者だが、そんなもんは上手く扱えない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "開拓隊の隊員",
          "text": "仮に、俺たち全員を撃ち殺したところで……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "開拓隊の隊員",
          "text": "お前はまた、別の開拓者たちに出くわすことになるだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "開拓隊の隊員",
          "text": "目の前の荒野すべてが、お前の敵になるんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "沈黙するパワードスーツ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "それ自体は問題ではなかった。\n彼の手元には、自ら開発した「伝達物質」がある。これを注入してしまえば、即座にスーツを容易く操れるようになり、目前の敵など恐るるに足らなくなるだろう。\nけれども彼は動かない。\nそれは、ドロシーと違って、彼にその勇気がないからなのか？\nあるいは……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "「あなたは自分が思い描いた大きな理想に――『時代』に取り残されたんだよ。」\n「だって、あなたはこれまで、自分がこの時代に身を置いているとは思っていなかったから。」\n「自分は『今』を掴んでいるし、それについて考え、操っているとあなたは主張するけど、本当は『今』なんて感じたことがない。」\nこれは……エレナの声だろうか。\nそうだ。取り残されたくないのなら……その中の一部にならねばならない。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "沈黙するパワードスーツ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "パワードスーツは沈黙し、もはや前進も抵抗もしなかった。\nそれは両腕を広げた。\n目前の風を、陽射しを、そして大地を、抱きしめようとするかのように。\n怒り狂った開拓者たちはそこへ一斉に押し寄せて、基地の上空で吠えていたあの銀の化け物さながらに――目の前の鉄の塊を飲み込んだ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クリステン",
          "text": "……マイレンダー基金のほうから聞きたいことでもあるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "いいえ、統括。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "今回はマイレンダーの代表として訪れたわけではないの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クリステン",
          "text": "……あまり時間はないのだけど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "そう。ちょうどいいわ、私も率直な会話のほうが好きだもの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "あなた、359号基地から実験の中核部分を回収したでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "「メインコア」はドロシーによって完全に破壊された――政府への報告書にはそう書いてあったけれど。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "私、見ちゃったのよね。わざわざ目立たない格好をした人たちが、中の見えない車に乗ってあなたのプライベートラボに入るところ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "サリアは、あなたがフェルディナンドを野放しにしたと言ってたけど……むしろ彼を利用したって表現のほうが正しいみたいね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "あなたが一番欲しがっていたものは、今やあなたの机の上に乗っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クリステン",
          "text": "359号基地の事後処理は、ライン生命が負うべき仕事だというだけのことよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クリステン",
          "text": "実験の失敗に伴って、無数の副産物が廃棄されるのは日常的なことだしね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クリステン",
          "text": "あなたが見たものだって、ライン生命以外の人からすれば注目には値しないものよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "廃棄、ね。確かに、あのガラクタはとっくにあなたの机からは片付けられちゃってそうだわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "証拠は消してしまえるし、記憶は改ざんできるけれど……何かが起きたあとには、必ずほかのことに影響が出るものよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ローキャン、パルヴィス、そしてフェルディナンド……彼らの名前はそのうち記録から消えることになるのかもしれない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "だけど、彼らが歴史を変えたことは間違いないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "埋め込み式のアーツユニット、古代サルカズの力を蘇らせる源石嵌合体技術、遠隔操作のできるパワードスーツ、より広範囲にわたる精神実体ネットワーク……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "次はどんな実験がこの時代を揺るがすことになるのかしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クリステン",
          "text": "研究者はあらゆる可能性を探るだけ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クリステン",
          "text": "私は予言なんてしないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "記憶が時間の制約を超えられるとしたら、予言というのは埋もれた歴史を再発見することでしかないわよね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "ここはもう一度、お互いを知ってみることにしない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "――私はホルハイヤ。歴史学者で、クルビア占星術研究協会の名誉会長よ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "せっかくだから、勝手に予言をさせてもらうけど――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ホルハイヤ",
          "text": "きっと……私はすぐにでも、あなたに一番必要なパートナーになれると思うわ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命研究員",
          "text": "エレナならまだ戻っていませんよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アステシア",
          "text": "ええ。……あの子からもそう聞いてるわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アステシア",
          "text": "でも、ここで待っていたいの。そうすれば、帰ってきたらすぐ会えるでしょ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ライン生命研究員",
          "text": "あはは……たまにエレナが羨ましくなりますよ。こんなに妹思いのお姉さんがいるなんて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アステシア",
          "text": "ん……？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アステシア",
          "text": "あの人は……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アステシア",
          "text": "……あれ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アステシア",
          "text": "今、天球儀が……光った？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "雨上がりの空は格別に澄みわたるものだ。\nこれは、クリステンがラボを出るに値する数少ない理由の一つでもある。\n彼女はあの輝く光が好きというわけではない。証明不能な推測は、単なる嘘でしかないのだ。\nけれど、その嘘は無意味なものではない。何千回もねじ曲げられようと、影というのは何かしらの真実から生まれるものなのだ。\n嘘の存在意義はただ一つ――真実の存在を証明することにある。\nそれは輝く星々の間に隠されているが、空は見た目ほど遠くない。\n彼女が手を伸ばせば、触れられるに違いない――\n何千年もの間人々の頭上に存在し続けてきた、唯一の真理に。"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
