{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_07_end",
  "groupId": "act17d0",
  "stageId": "act17d0_07",
  "title": "最終防衛線",
  "storyCode": "OD-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_07_end.txt",
  "sourceHash": "5d3d0153def1940e5c7bf2410d3f7cd96aa93a7e916ec5da9f8fc78096ca685d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "ええい、どけ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "次から次へと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "あいつら一体どれだけ化け物を作ってたんだ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "リスカム！　後ろじゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オリジニュータント",
      "text": "グアァ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "危ない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "フランカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "何してるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ピカールさん、手を貸してください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "わ、わかった！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "早く……逃げなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "黙ってて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "足がちょっとね……構わなくていいからさっさと逃げて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "バカなこと言わないで！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "わたしが背負うから、ほら乗って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "text": "奴らがまた来るぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "今のうちに！　早く逃げろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "こちらへ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "オクフェンさん！　どうして出てきたんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "text": "ただ下で待ってるなんてできません！　私もロドスのオペレーターなんですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……ありがとうございます！　助かりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "爆発物を起爆するぞい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "3、2、1……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "どうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ほんの少し散らしただけじゃ。すぐにまた集まってくるじゃろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "奴ら……少しは数が減った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "「ウェルカムマット」を設置した。あと、私も弾切れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "アレクサンドル、次はどうするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "避難所へ行け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "避難所へ急げ！　ロドスのオペレーターたちを連れて避難所へ行くんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "なら、あなたは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺はお前たちをカバーする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "カバー？　なら誰がアレクサンドルをカバーするの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺にそんなもの必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "熱くならないで、アレクサンドル！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺は冷静だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺はもう、隠れるのにも逃げるのにもうんざりなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "撤退では戦争に勝利をもたらすことはできない。歴史がそれを数え切れないほど証明している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "でもこれは戦争じゃないのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺に言わせれば、これこそが戦争だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "あいつらが武器を掲げ、俺の仲間に危害を加えようとし、俺がそれを防ぐ。それを戦争以外の何だというのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺はあまりに多くの戦争を経験してきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "俺がここでクソッタレなモンスターを殺せば殺すほど、町民たちの生存率が上がる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "だから俺がここを守る。弾が尽き果てても、永遠に守り抜く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "戦争の最中にいて、撤退なんて選択肢はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "「英雄になろうとするな、必ず失敗する」。あなたの言葉よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ティナ、俺は英雄になるつもりなんてない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "正しいことをしているだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "何が何でも……すべて今日で終わらせるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "アレクサンドル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "儂が残ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "ご老人、なぜあなたまでも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "こうなることはわかっておった。おぬしらが力を貸してくれると言うた時から、おおよその展開は予想できておった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "儂が残って、この戦士と共に守ろうぞ。もし状況があまりにひどくなれば、あやつを引きずってでも撤退するわい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "ご老人……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "アレクサンドル、これを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "これは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "私が試作した源石爆発物。最後の二つよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……助かる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "生きて帰ってきて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "……保証はできない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "人が悪いな、あんたも撤退するつもりなんてないくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "ハハハッ……老いぼれの心を読むでない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "おぬしの武器を活かすには、前線で押し寄せるモンスター抑えておく者が必要になるからのう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "そいつは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "先代の領主の刀だそうじゃ。拝借してきたんじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "いい刀じゃのう。悪くない趣味をしておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "美しい刃文、手作業ではめこまれたターコイズの柄。現代の工業製品に全く劣らぬ逸品じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "最前線で刀を振るうより、後方で弓を構えておった方が安全なのは目に見えとるがのう……儂にも格好つけさせてもらうぞい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "老いたものじゃな。動きがだいぶ鈍っておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "だが刀もあんたも動きも、抜群にキレてるぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "そういえばまだおぬしの名を知らぬな、戦士よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "アレクサンドル・セナフィエフ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "アレクサンドルと呼んでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "わかった。ふむ、儂もおぬしに名を告げるべきなんじゃろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "text": "じゃが鮮血が谷を染めたあの日、儂の名は過去のすべてと共に、砂漠の下に埋もれてしまったんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "あんたは残って戦うと決めてくれた。それで十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "「レンジャー」、準備はいいか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "「皆は、俺が死んだと言う。だがそれは違う。俺は生まれ変わったんだ」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "あのモンスターがどれだけいようと……関係ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "さあ、かかってこい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
