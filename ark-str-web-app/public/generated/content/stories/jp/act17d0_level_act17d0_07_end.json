{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_07_end",
  "groupId": "act17d0",
  "stageId": "act17d0_07",
  "title": "最終防衛線",
  "storyCode": "OD-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act17d0/level_act17d0_07_end.txt",
  "sourceHash": "5d3d0153def1940e5c7bf2410d3f7cd96aa93a7e916ec5da9f8fc78096ca685d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": null,
      "text": "ええい、どけ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": null,
      "text": "次から次へと。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "あいつら一体どれだけ化け物を作ってたんだ！？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "リスカム！　後ろじゃ！"
    },
    {
      "type": "dialogue",
      "speakerName": "オリジニュータント",
      "speakerId": null,
      "text": "グアァ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "危ない！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "フランカ！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "何してるの！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "ピカールさん、手を貸してください！"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": null,
      "text": "わ、わかった！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "早く……逃げなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "黙ってて！"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "足がちょっとね……構わなくていいからさっさと逃げて。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "バカなこと言わないで！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "わたしが背負うから、ほら乗って。"
    },
    {
      "type": "dialogue",
      "speakerName": "ピカール",
      "speakerId": null,
      "text": "奴らがまた来るぞ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "今のうちに！　早く逃げろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "こちらへ！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "オクフェンさん！　どうして出てきたんですか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "ただ下で待ってるなんてできません！　私もロドスのオペレーターなんですから！"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "……ありがとうございます！　助かりました！"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "爆発物を起爆するぞい……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "3、2、1……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "どうだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "ほんの少し散らしただけじゃ。すぐにまた集まってくるじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "奴ら……少しは数が減った？"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "「ウェルカムマット」を設置した。あと、私も弾切れ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "アレクサンドル、次はどうするの？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "避難所へ行け。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "えっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "避難所へ急げ！　ロドスのオペレーターたちを連れて避難所へ行くんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "なら、あなたは？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "俺はお前たちをカバーする。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "カバー？　なら誰がアレクサンドルをカバーするの？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "俺にそんなもの必要ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "熱くならないで、アレクサンドル！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "俺は冷静だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "俺はもう、隠れるのにも逃げるのにもうんざりなんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "撤退では戦争に勝利をもたらすことはできない。歴史がそれを数え切れないほど証明している。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "でもこれは戦争じゃないのよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "俺に言わせれば、これこそが戦争だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "あいつらが武器を掲げ、俺の仲間に危害を加えようとし、俺がそれを防ぐ。それを戦争以外の何だというのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "俺はあまりに多くの戦争を経験してきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "俺がここでクソッタレなモンスターを殺せば殺すほど、町民たちの生存率が上がる。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "だから俺がここを守る。弾が尽き果てても、永遠に守り抜く。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "戦争の最中にいて、撤退なんて選択肢はない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "「英雄になろうとするな、必ず失敗する」。あなたの言葉よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "ティナ、俺は英雄になるつもりなんてない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "正しいことをしているだけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "何が何でも……すべて今日で終わらせるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "アレクサンドル！"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "儂が残ろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "ご老人、なぜあなたまでも……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "こうなることはわかっておった。おぬしらが力を貸してくれると言うた時から、おおよその展開は予想できておった。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "儂が残って、この戦士と共に守ろうぞ。もし状況があまりにひどくなれば、あやつを引きずってでも撤退するわい。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "ご老人……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "アレクサンドル、これを。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "これは？"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "私が試作した源石爆発物。最後の二つよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "……助かる。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "生きて帰ってきて！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "……保証はできない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "人が悪いな、あんたも撤退するつもりなんてないくせに。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "ハハハッ……老いぼれの心を読むでない。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "おぬしの武器を活かすには、前線で押し寄せるモンスター抑えておく者が必要になるからのう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "そいつは……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "先代の領主の刀だそうじゃ。拝借してきたんじゃよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "いい刀じゃのう。悪くない趣味をしておる。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "美しい刃文、手作業ではめこまれたターコイズの柄。現代の工業製品に全く劣らぬ逸品じゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "最前線で刀を振るうより、後方で弓を構えておった方が安全なのは目に見えとるがのう……儂にも格好つけさせてもらうぞい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "老いたものじゃな。動きがだいぶ鈍っておる。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "だが刀もあんたも動きも、抜群にキレてるぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "そういえばまだおぬしの名を知らぬな、戦士よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "アレクサンドル・セナフィエフ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "アレクサンドルと呼んでくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "わかった。ふむ、儂もおぬしに名を告げるべきなんじゃろうな……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "じゃが鮮血が谷を染めたあの日、儂の名は過去のすべてと共に、砂漠の下に埋もれてしまったんじゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "構わない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "あんたは残って戦うと決めてくれた。それで十分だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "「レンジャー」、準備はいいか。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "「皆は、俺が死んだと言う。だがそれは違う。俺は生まれ変わったんだ」"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "あのモンスターがどれだけいようと……関係ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "さあ、かかってこい。"
    },
    {
      "type": "sceneBreak"
    }
  ],
