  "stageId": "main_02-06",
  "title": "手すりを握る",
  "storyCode": "2-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_02-06_beg.txt",
  "sourceHash": "eec5ee489a1b60f50df5e603ab9d3a6a59a63f33f3376779412b090bf947943b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十八关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "よし、ここだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えっ？　もしかして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "屋上に出るってことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……でもこの扉、鍵がかかってますね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "下がっていていただけますか？　ここは、私のアーツで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "その必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "蹴り飛ばせば済む話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "勉強になったわね～、リスカム？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "や、やり方なんてそれぞれ違ってもいいでしょ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……それで……屋上には着きました、けど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ひょっとして、エクシアさんの言う「撤退ルート」って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "アーミヤ、あの辺を目指してね！　そしたら、そのまま向こうまで行けるからさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの辺、といいますと……や、やっぱり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ここから飛び移れ、ってことですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ビンゴ！　その通り～～！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "天才的なアイデアじゃない！？　こんなの絶対予想外でしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "いや～、龍門みたいな秘密に溢れるすんばらしい街でも、ここまで――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――待て！　そう簡単に逃げられるとは思うなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……ええっ！？　うっそ、どっから来たの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "予想外のアイデアを持っているのは、向こうも同じのようですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "だけど、入り口は塞いだのにどうやって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……恐らく、近くのビルから飛んできたのだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あの人たちが背負っているジェットパック……簡素な作りをしていますが、使う分に支障はないようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あれで奇襲をかけられたら、まずいことになるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ちぇっ、しょーがないか。待っててね、今助けに行くから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "悪いけどさっさとしてよね、ラテラーノの救世主さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "重装部隊は、防衛陣形に移行して！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……来るぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "みなさん、先鋒オペレーターの援護をお願いします！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
