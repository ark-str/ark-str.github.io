{
  "server": "jp",
  "storyId": "story_savage_set_1_story_1",
  "groupId": "story_savage_set_1",
  "stageId": null,
  "title": "痛ましい転機",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_savage_1_1.txt",
