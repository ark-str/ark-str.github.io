{
  "server": "jp",
  "storyId": "story_lava_set_1_story_1",
  "groupId": "story_lava_set_1",
  "stageId": null,
  "title": "姉妹",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_lava_1_1.txt",
  "sourceHash": "065547a781f17d26406355ee476f639d27f5db9949f4c55578879949211f8c03",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "a.m. 11:10 天気/晴天\nロドス本艦 第二船室 オペレーター生活エリア"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "スー――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "フー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（頭を空っぽにして、雑念を取り除け。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（よし、問題ない。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（心臓はバクバクしてないし、感情も落ち着いてる……大丈夫だ、ラヴァ、オマエならやれる！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（今度こそキレずにちゃんとハイビスと話ができるはずだ！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "あっ、ラヴァちゃーん、ちょうどいいところに来た！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "今日も健康食を用意したから、ちゃんと食べるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "あぁ？　ウザい。健康食だか何だか知らないが、あんなもん毎日食べてらんないんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "――スーッ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（ダメだダメだ、ラヴァ。そんな話し方しちゃダメだろ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（我慢しろ、オマエの大占い師の意志でもって、己の感情を抑えるんだ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（心を落ち着かせろ、心頭滅却……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……ふぅ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "えっと、違うんだ、アタシが言いたいのはな――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "毎日健康食ばかりだと、ちょっと飽きちゃうなって……別にオマエがウザいって意味じゃないんだ、あんまりマジに捉えないでくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ハハッ、何おかしなこと言ってるの？　ラヴァちゃんがお姉ちゃんのことをウザいなんて思うはずないでしょ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "はい、今日のお昼ご飯。ちゃんと残さず食べるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "最近は寒くなってきたから、こうやって栄養バランスの取れた食事をしないと、風邪ひいちゃうんだからね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "おえっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ん？　どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "あのさ……これ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "味についてはひとまず置いといて……トマトはアタシが一番嫌いな食べ物だって知ってるよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "うん、もちろん知ってるよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "だったらなんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "なんでこんなにトマト煮が入ってんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "もう、怒らないの。それはもちろん、トマトが栄養たっぷりだからだよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私知ってるからね。ラヴァちゃんったら嫌いなものをいつもこっそりクルースちゃんのお皿に移してるでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "それに、最近お肉ばっかりで全くお野菜食べてないでしょ、違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "好き嫌いしちゃいけないよ！　ラヴァちゃんみたいに言うことを聞かない「悪い子」には、お仕置きも厳しくしないとね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "今日はラヴァちゃんが食べ終わるまで見張ってるからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "スー――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（キレちゃダメだキレちゃダメだキレちゃダメだ。）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "キレちゃ……あああダメだ我慢できないもう無理だああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "いっつもいっつも！　アタシを！　子ども扱いするんじゃねぇぇ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "なんでまたこうなっちまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "喧嘩なんてするつもりなかったのに、人を怒らせる天才なのかアイツは……嫌いなものをああやって無理やり食べさせようとするなんて――おえっ、今思い出しても吐き気がする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "まぁ、結局は怒りを抑えられなかったアタシが悪いんだけど……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "なになにー？　ラヴァ、誰かにイジメられたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "誰がやったか教えて、ボクがそいつをボコってきてあげるから！　人をイジメる悪いヤツはボクがギッタンギッタンにするよ！　こーんなふうにね――フンッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "うわっ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "無闇にバットを振り回すなよ、危ないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ていうか、確かこないだドクターに、艦内でバットで人を殴るのは禁止だって言われただろ？　罰として反省文を書かされたってのにまだ懲りてないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "あ、そうだった！　うぅ……反省文は嫌だ、もう書きたくない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "でも大丈夫、バットじゃなくてもできるからさ！　ほら、リュックでも悪人をボコれるよ！　ボクのリュックはすっごく便利なんだ、アーミヤたちもすごいって褒めてくれたんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "だからラヴァも心配しないで、悪人退治はボクに任せてよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "別にアタシは心配なんてしてないんだけど……それよりほら、もう暴れるなって。また見つかったら怒られるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ていうか、アタシは誰にもイジメられてないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ホントに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "本当だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "（じぃー……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ラヴァの嘘つき！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "はあ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "だって悲しそうな顔してるよ？　イジメられてないなら、どうしてそんな顔してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "悲しそう？　ア……アタシが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ありえない、オマエの見間違いだ！　アタシが悲しむなんて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ホントだよ、ボク見間違いなんかしないもん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ラヴァの眉間に、前にピアノのフタで指を挟んだ時と同じくらい、シワが寄ってたよ！　すごくツラそうだった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "大げさだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ボクの言ってること、間違ってないでしょ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……うっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "わかった。正しいってことにしといてやるよ。でもそんなに大したことじゃないんだ。えーっと、ハイビスの奴とちょっと揉めただけだから。いつものことだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "あーっ、またハイビスお姉ちゃんとケンカしたのー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "うーん、ハイビスお姉ちゃんが相手だったら、ボクは力になれないや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "なんでだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "だってハイビスお姉ちゃんは悪人じゃないもん。検査をしてくれた時もすっごく優しかったし、おまけにケーキまでくれたんだよ！　あのケーキ、とーっても美味しかったんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "チッ、アイツいい子ぶりやがって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ケーキがなんだってんだ、そのくらいアタシだって作れるさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "それにアイツのお菓子作りの腕前といったら……食べられるレベルのケーキが作れるようになるまでに、アイツがどれだけ失敗したか知ってるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "失敗したケーキも、捨てるのがもったいないって言って、無理矢理アタシに食べさせるんだ。酷くないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "んー……？　よくわかんない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ケーキがいっぱい食べられるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "そういうことじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "はぁ……もういい、オマエに言っても仕方ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "とにかく！　もしオマエにも兄弟姉妹がいたら、姉なんて生き物がどれだけウザいかきっとわかるはずだ。特にハイビスなんて、偉そうだし、強引だし、嫌いな野菜を食わせようとするし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……おい、なんで急に黙り込むんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "うーん、なんて言うか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "なんか、いいなぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "あぁ？　何がいいんだよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "いいないいなぁ、きょうだいかぁ……ボクも欲しいなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ドクターにボクのきょうだいになってってお願いしてもいいけど、でもそれってラヴァとハイビスお姉ちゃんの関係とはちょっと違う気がするよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "うーん、それは、確かに……違うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "やっぱり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ラヴァ、ボクいいこと思いついたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ハイビスお姉ちゃんをボクにくれる？　ボクのお姉ちゃんになってもらうから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ブッ――！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ゴホッ！　ゴホゴホゴホッ！　……オ、オマエ、いきなり何バカなこと言い出すんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "バカなことじゃないよ、ボク真剣に言ってるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "オマエわかってんのか？　実の姉妹ってのは血が繋がってるんだ。オマエがいくら欲しいって言ったって、あげられるようなモンじゃないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "えーそんなのどうだっていいよ、血の繋がりがあるかなんて、ボク気にしないもん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "そんなこと言っても無理なものは無理なんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "なんで無理なの？　おーねーがーいー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ラヴァだって、いっつもハイビスお姉ちゃんのことを天敵だとか、悪の化身だとか言ってるでしょ？　ラヴァがいらないんだったら、ボクにくれたっていいじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "いやそれは……アタシは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ダメだ。とにかくダメなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "どうしてもなにもない！　ダメったらダメだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ラヴァのケチ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "なんとでも言え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "はぁ、仕方ないなぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "でもさ……ラヴァはどうしていつも、ハイビスお姉ちゃんとケンカしちゃうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "フェンが言ってたよ。ラヴァが一緒のチームに入るってなった時、ハイビスお姉ちゃんを見るなり抜けるって言い出しそうだったって——それってホントなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "フェンの奴、そんなことまでオマエに話してたのか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "つまりホントだってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ああ、本当だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "うーん……でも変だよね、ハイビスお姉ちゃんがそのチームにいることラヴァは知らなかったの？　あれれ？　二人は一緒にロドスに来たんじゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "なんでそんなの気にするんだよ、その好奇心はどっから来るんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "教えて教えてー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ゆ、揺らすなって……わ、わかったから。教えればいいんだろ？　めんどくさいな、でも別に隠しとくようなことでもないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "アタシとハイビスは確かに一緒に家を出た。だけど、途中でちょっとした事故が起きたんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "実は……コホンッ！　まぁつまり途中でアイツとケンカになって、それでアタシたちは別々になっちまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ぜんっぜん事故じゃないでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "うっさい！　全然クールじゃないってのはわかってる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ケンカの原因は、何だったかな？　思い出せないな……まぁいい。とにかくケンカした後、腹の虫がおさまらず、気晴らしに散歩でもしようとしたんだけど、うっかり遠くまで行っちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "荒野はどこも同じような景色だろ？　アタシが散歩してたのは標識があるような道路じゃなかったし。それで……その……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "うっそー！？　まさか遠くまで行ってそのまま迷子になったの？　荒野で一人？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ああ。まあ、そんなところだ。幸いその後キャラバンに出会って、リターニアの近くまで連れて行ってもらえたけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ラヴァって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "おバカさんだね――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "はあ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "おバカさんだよ！　ラヴァったら、迷子になってヴィクトリアからリターニアまで行くなんて、アハハハハ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "オマエにだけは言われたくない！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "でもアタシの占いは間違ってなかった！　あの事故だって定められた運命だったんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "もしキャラバンについてリターニアに行ってなければ、先生に会うこともなかったし、先生から音楽を教わることもなかった。アーツの習得だって、今頃もっと苦労してたはずだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "あっ、確かに。ラヴァはアーツの習得が早いし上手だよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "教官たちもPithお姉ちゃんもみんなラヴァのこと褒めてたよ。あと前に任務で会った、仏頂面で目がこんな感じで、めちゃくちゃいい声のエリートオペレーターの人も、同じこと言ってた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "そういえば、最近ラヴァ毎日訓練場に行ってるけど、そのエリートオペレーターの人に教えてもらってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "チッ……そうしたいのは山々だが、そんなうまい話があるはずないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "Logos大先生みたいなエリートが、わざわざアタシに稽古つけてくれる時間なんてあるわけない。前みたいに二言三言指摘してもらえるだけで御の字だよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ていうか、オマエさっきあの人のことなんて言った？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "とぼけるな！　あのLogos大先生だぞ！　クールで強くてイカしてて優雅で神秘的で落ち着きのあるLogos大先生だぞ！　大先生には最大限の敬意を払えよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "うわぁ……わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ラヴァは本当にあのエリートオペレーターにゾッコンなんだね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ゾッコンじゃない、尊敬だ！　強者に対する尊敬だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "フンッ、いつかアタシも大先生みたいに強くなってやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "う、うん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "（でも今のラヴァの表情って、前にソラちゃんが歌ってる姿を見た時の支援部のお兄さんお姉さんたちと同じ顔だよね……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "（なるほど！　それが尊敬ってことなんだね！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "うーん……でも、やっぱり残念だなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "何がだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "本当はね……ハイビスお姉ちゃんがボクのお姉ちゃんになったら、ラヴァもボクのことお姉ちゃんって呼んでくれるんじゃないかって思ってたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "ホントに残念！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "バカ言うな！　アタシは絶対そんなふうに呼ばないからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "それにアタシはハイビスと同じ日に生まれたんだ。なのにどうしてアイツが姉ちゃんでアタシが妹なんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "いいか、アタシの方がオマエら二人より背が高いんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "身長は関係ないよ。ハイビスお姉ちゃんはボクの面倒を見てくれるからお姉ちゃんなんだよ。でもラヴァは、ボクより年下っぽいじゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "意味がわからない……アタシはオマエの面倒見てないってのか！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "痛い痛い、頬っぺたつねんないでよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "フンッ、きっちり教えてやらないとダメみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "いいか、見た目で人を判断するな！　特にサルカズはな……アタシたちサルカズの年齢は、見た目とは一致しないものなんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "えぇっ！　まさかラヴァは、見た目は若いけどおばあさんなの？　ワルファリン先生みたいな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……そうじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "違うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……もういい。この話はやめだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "だけど、今の言葉はワルファリン先生の前では絶対に言うなよ？　もし言ったら百パー殺されるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "じゃあな。アタシはまだやることあるから――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クオーラ",
      "text": "あっ！　どこに遊びに行くの？　ボクも一緒に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ダ・メ・だ！　遊びに行くんじゃない、ついてくるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "どうしてもやらなきゃならないことがあるんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……いない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "おかしいな……いつもならハイビスは、この時間には戻って来てるはずなんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（ったく、クオーラの奴が変なこと言ったせいだ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（何が「お姉ちゃんをちょうだい」だ！　できるわけないだろ……物じゃないっての。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（それにケチだなんて心外だ。むしろ本当に交換できて、ハイビスが姉ちゃんじゃなくなれば願ったり叶ったりだっての！　誰を兄弟姉妹にするかなんて、誰も選べやしない……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（……ま、まぁいい。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（昼間の件は確かにキレたアタシが悪い……間違いは間違いだ、それは認めよう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（ハイビスが帰ってきたら、謝ろう――）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "これは……ケーキ？　それと……手紙？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……なんだよ！　こ、こんなお涙頂戴の手紙なんか書いて、アイツ恥ずかしくないのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "やっぱアイツは悪の化身だ……こんなのズルいだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "詫びまで先に言われるなんて、全然クールじゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "（ケーキをほおばる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "おえっ、アイツまたなんか変なもの入れやがったな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "しかもアタシが好きな味だとかテキトーなことばっか……フンッ、甘さが全然足りてない、完全に不合格だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "それにアイツ、夜は医療部に残るとか書いてあったけど……どうせまた忙しくてご飯食べるの忘れるんだろ。アタシに体に気を付けろとか言っといて、自分も同じことしてんじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "しょうがないな……このケーキに免じて、夜は何か食べるもん届けてやるか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴァ",
      "text": "ふんっ、やっぱりアタシがいないとダメだな。バカな姉ちゃんを持つと苦労するぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
