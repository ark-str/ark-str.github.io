{
  "server": "jp",
  "storyId": "main_0_level_main_00-01_beg",
  "groupId": "main_0",
  "stageId": "main_00-01",
  "title": "崩落",
  "storyCode": "0-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_00-01_beg.txt",
  "sourceHash": "2afe1ccd453f5f10026c8c7ed7ff1c06606920d60c593164fb96d5484928d1ce",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "くっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "どうなってるんだ、この状況は……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――探せ！　家の中まで徹底的に調べるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "やめて！　その人を放して！　一体、どうしてこんなことを……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ハッ、抵抗する気か？　チェルノボーグのクズめ！　今更何しようが遅いんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性",
      "text": "ッ……！　もういい、お前だけでも逃げろ！　俺のことは気にするな……子供たちを、頼んだぞ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "――ママ……！　ママ、どこにいるの……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵",
      "text": "――市民のことなど捨て置け！　総員、防衛ラインを死守せよ！　……クソッ、相手の規模が読めん！　仮面の反逆者どもめ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "皆、手を緩めるな！　隙を与えず攻め続けるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵",
      "text": "おい、援軍はまだ来ないのか！？　このままでは……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "――行くぞ！　突撃ッ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "っ、レユニオン……どうして彼らが、こんなことを……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "恐らく、何年も隠し続けてきた本性がついに牙を剥いた……といったところだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "で、ですが……彼らのような感染者が、ウルサスの国民を……チェルノボーグの市民たちを襲うなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "ほんと何考えてんだよ、あの連中……！　感染者がウルサス政府に刃向かったら、タダじゃ済まないってのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "だが、この猛攻を見るに、今回の行動は計画的なものと考えて間違いあるまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "加えて、我々がドクターを救出したあの場所にさえ、レユニオンが侵入していた以上……何らかの陰謀が動いていると見るべきだ。あそこは本来、秘匿されたエリアだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "しかし、だとしたらすでに被害はチェルノボーグ全域に及んでいる可能性もある、か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "text": "クソッ……どうすりゃいいんだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "！　（小声）静かに。彼らが来ます……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "text": "逃げ出した奴らの足取りは掴めたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "text": "申し訳ありません、現在捜索中です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "text": "了解、そのまま続けろ。一匹たりとも逃がすなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "text": "――血も涙もないチェルノボーグの連中め……俺の父と母、親の世代が受けた苦しみ、必ず味わわせてやる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "（っ、土ぼこりが……！）　――ごほっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "text": "……何の音だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "text": "向こうから聞こえたようです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "（小声）ひっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "（小声）き、気付かれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "（小声）――落ち着け。静かに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "（小声）はっ、はい……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "……きゃっ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "text": "いたぞ！　奴らはここだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "……い、いやあああっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "やめて、来ないで……！　――ど、どこかに隠れないと……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "text": "……チッ、どこへ行った……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "text": "逃げ足の速い奴め……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "text": "さっさと出てこい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "ひっ……い、いやっ……！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "text": "こそこそ隠れたところで無駄だ。――見つけたぞ、女。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "text": "ッ……！　ゆ、許してください……！　どうか……どうか、この子だけでも見逃してください……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……これ以上、黙って見てはいられません。――戦いましょう、レユニオンと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……アーミヤ。そうは言うが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もちろん、リスクは承知しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "けれどそれでも、こうしている間に失われていく命を、見過ごすわけにはいきません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "その上、この状況がいつまで続くかわからないという意味でも、彼らの撤退を待つ時間はないはずです。静観するよりは、行動すべき局面かと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですから――彼らを止めましょう。ドーベルマンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "――――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "……わかった。お前の指示に従おう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "――ロドス各小隊に告ぐ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "現状、レユニオンはまだ我々の存在に気付いていないようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "よって、奇襲で一気に畳み掛ける。総員、迅速に行動せよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "さて、Dr.{@nickname}。ここからはお前に部隊の指揮を委ねよう。――その力量、確かめさせてもらうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "text": "言うまでもないが、見ての通りの状況だ。手は抜くなよ。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "任せてくれ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "このくらい、すぐに終わらせてやるさ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "ふっ。……頼んだぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "text": "では、アーミヤ。号令を。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "はい。――みなさん、行きましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……「それが避けられる戦いならば、沈黙を守り」――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――「必要な戦いならば、最後まで戦い抜く」！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "それが私たち、ロドスの往くべき道ですから！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
