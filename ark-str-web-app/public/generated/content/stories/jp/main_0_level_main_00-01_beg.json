{
  "server": "jp",
  "storyId": "main_0_level_main_00-01_beg",
  "groupId": "main_0",
  "stageId": "main_00-01",
  "title": "崩落",
  "storyCode": "0-1",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/main/level_main_00-01_beg.txt",
  "sourceHash": "2afe1ccd453f5f10026c8c7ed7ff1c06606920d60c593164fb96d5484928d1ce",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "くっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "どうなってるんだ、この状況は……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": null,
      "text": "――探せ！　家の中まで徹底的に調べるんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "speakerId": null,
      "text": "やめて！　その人を放して！　一体、どうしてこんなことを……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": null,
      "text": "ハッ、抵抗する気か？　チェルノボーグのクズめ！　今更何しようが遅いんだよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "男性",
      "speakerId": null,
      "text": "ッ……！　もういい、お前だけでも逃げろ！　俺のことは気にするな……子供たちを、頼んだぞ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "speakerId": null,
      "text": "――ママ……！　ママ、どこにいるの……！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵",
      "speakerId": null,
      "text": "――市民のことなど捨て置け！　総員、防衛ラインを死守せよ！　……クソッ、相手の規模が読めん！　仮面の反逆者どもめ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": null,
      "text": "皆、手を緩めるな！　隙を与えず攻め続けるんだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ウルサス憲兵",
      "speakerId": null,
      "text": "おい、援軍はまだ来ないのか！？　このままでは……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerId": null,
      "text": "――行くぞ！　突撃ッ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "っ、レユニオン……どうして彼らが、こんなことを……！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "恐らく、何年も隠し続けてきた本性がついに牙を剥いた……といったところだろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "で、ですが……彼らのような感染者が、ウルサスの国民を……チェルノボーグの市民たちを襲うなんて……"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "speakerId": "char_013_riop",
      "text": "ほんと何考えてんだよ、あの連中……！　感染者がウルサス政府に刃向かったら、タダじゃ済まないってのに！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "だが、この猛攻を見るに、今回の行動は計画的なものと考えて間違いあるまい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "加えて、我々がドクターを救出したあの場所にさえ、レユニオンが侵入していた以上……何らかの陰謀が動いていると見るべきだ。あそこは本来、秘匿されたエリアだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "しかし、だとしたらすでに被害はチェルノボーグ全域に及んでいる可能性もある、か……"
    },
    {
      "type": "dialogue",
      "speakerName": "前衛オペレーター",
      "speakerId": "char_013_riop",
      "text": "クソッ……どうすりゃいいんだ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "！　（小声）静かに。彼らが来ます……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "speakerId": null,
      "text": "逃げ出した奴らの足取りは掴めたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "speakerId": null,
      "text": "申し訳ありません、現在捜索中です！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "speakerId": null,
      "text": "了解、そのまま続けろ。一匹たりとも逃がすなよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "speakerId": null,
      "text": "――血も涙もないチェルノボーグの連中め……俺の父と母、親の世代が受けた苦しみ、必ず味わわせてやる！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "（っ、土ぼこりが……！）　――ごほっ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "speakerId": null,
      "text": "……何の音だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "speakerId": null,
      "text": "向こうから聞こえたようです！"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "（小声）ひっ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "（小声）き、気付かれ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "（小声）――落ち着け。静かに……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "（小声）はっ、はい……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "speakerId": null,
      "text": "……きゃっ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員A",
      "speakerId": null,
      "text": "いたぞ！　奴らはここだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "speakerId": null,
      "text": "……い、いやあああっ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "speakerId": null,
      "text": "やめて、来ないで……！　――ど、どこかに隠れないと……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "speakerId": null,
      "text": "……チッ、どこへ行った……？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "speakerId": null,
      "text": "逃げ足の速い奴め……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "speakerId": null,
      "text": "さっさと出てこい！"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "speakerId": null,
      "text": "ひっ……い、いやっ……！！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "speakerId": null,
      "text": "こそこそ隠れたところで無駄だ。――見つけたぞ、女。"
    },
    {
      "type": "dialogue",
      "speakerName": "女性",
      "speakerId": null,
      "text": "ッ……！　ゆ、許してください……！　どうか……どうか、この子だけでも見逃してください……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員B",
      "speakerId": null,
      "text": "…………"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "……これ以上、黙って見てはいられません。――戦いましょう、レユニオンと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "……アーミヤ。そうは言うが……"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "もちろん、リスクは承知しています。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "けれどそれでも、こうしている間に失われていく命を、見過ごすわけにはいきません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "その上、この状況がいつまで続くかわからないという意味でも、彼らの撤退を待つ時間はないはずです。静観するよりは、行動すべき局面かと。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerId": "char_002_amiya",
      "text": "ですから――彼らを止めましょう。ドーベルマンさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "――――"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "……わかった。お前の指示に従おう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "――ロドス各小隊に告ぐ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "現状、レユニオンはまだ我々の存在に気付いていないようだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "よって、奇襲で一気に畳み掛ける。総員、迅速に行動せよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "さて、Dr.{@nickname}。ここからはお前に部隊の指揮を委ねよう。――その力量、確かめさせてもらうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドーベルマン",
      "speakerId": "char_130_doberm",
      "text": "言うまでもないが、見ての通りの状況だ。手は抜くなよ。"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "任せてくれ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "このくらい、すぐに終わらせてやるさ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "speakerId": "char_130_doberm",
          "text": "ふっ。……頼んだぞ。"
        },
        {
          "type": "dialogue",
          "speakerName": "ドーベルマン",
          "speakerId": "char_130_doberm",
          "text": "では、アーミヤ。号令を。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "はい。――みなさん、行きましょう。"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "……「それが避けられる戦いならば、沈黙を守り」――"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "――「必要な戦いならば、最後まで戦い抜く」！"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerId": "char_002_amiya",
          "text": "それが私たち、ロドスの往くべき道ですから！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
