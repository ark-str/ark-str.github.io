  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "シュヴァルツ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "今のクローニン様の命令は、市長閣下の命令と同じです。各員、行動開始。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "全員捕らえろ。お嬢様は絶対に傷つけないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "何を言っているの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "わたくしが、ただワガママを言っているだけだと思っているの！？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "逃げろ！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "今そんな事を言っている暇はない！",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "護衛A",
          "text": "道沿いにビーチの方向へ逃げたぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "護衛B",
          "text": "チッ、人が多すぎる、追いづらいな。ビーチの見張りに連絡しろ、奴らを挟み撃ちにする！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シュヴァルツ",
          "text": "逃さない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シュヴァルツ",
          "text": "！？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "なにっ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "ドクター、ここは私に任せてもらおう。行くんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "えっ！？　あ、貴方は……！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "セイロン、早く逃げるぞ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "待って、はぁ……はぁ……ドクター、もう足が……。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "やっと……ビーチに着いた……。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "自分も……もう走れない……。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "護衛",
          "text": "お嬢様、私たちと一緒に戻りましょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "嫌です！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "護衛A",
          "text": "お嬢様に怪我をさせるなよ。あのドクターとかいう奴は好きにしていい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "あぁん？誰がドクターを好きにしていいって！！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "護衛B",
          "text": "あっ、熱いっ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "護衛C",
          "text": "お前、どこのガキだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "護衛C",
          "text": "うわっ！　ケツが燃えた！　ケツがああ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "text": "おいドクター、また面白いことやってんな。オレサマを呼ばねーなんてツレねーじゃんか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "護衛A",
          "text": "チッ、ガキ一人だ、目にもの見せてやれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "text": "フンッ、ちょうど退屈してたんだ、へへ……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "ドクター、急に顔色が悪くなっているような……どうなされたの？",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "イフリータ、あまりやりすぎるな！！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "服を燃やす程度で十分だ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "text": "チェッ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "text": "じゃあミディアム・レアぐらいにしとくぜェ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
