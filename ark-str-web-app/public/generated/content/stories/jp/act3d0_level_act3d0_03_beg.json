  "title": "徒競走",
  "storyCode": "OF-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act3d0/level_act3d0_03_beg.txt",
  "sourceHash": "c365afa87643d41762994ef5b08e7c02159bbf5ac53e05a51efbd8c525138099",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "char_340_shwaz",
      "text": "……。"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "speakerId": "char_348_ceylon",
      "text": "シュヴァルツ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "char_340_shwaz",
      "text": "今のクローニン様の命令は、市長閣下の命令と同じです。各員、行動開始。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": "char_340_shwaz",
      "text": "全員捕らえろ。お嬢様は絶対に傷つけないように。"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "speakerId": "char_348_ceylon",
      "text": "何を言っているの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "speakerId": "char_348_ceylon",
      "text": "わたくしが、ただワガママを言っているだけだと思っているの！？"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "逃げろ！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "今そんな事を言っている暇はない！",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "護衛A",
          "speakerId": null,
          "text": "道沿いにビーチの方向へ逃げたぞ！"
        },
        {
          "type": "dialogue",
          "speakerName": "護衛B",
          "speakerId": null,
          "text": "チッ、人が多すぎる、追いづらいな。ビーチの見張りに連絡しろ、奴らを挟み撃ちにする！"
        },
        {
          "type": "dialogue",
          "speakerName": "シュヴァルツ",
          "speakerId": "char_340_shwaz",
          "text": "逃さない！"
        },
        {
          "type": "dialogue",
          "speakerName": "シュヴァルツ",
          "speakerId": "char_340_shwaz",
          "text": "！？"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "なにっ？",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerId": "char_188_helage",
          "text": "ドクター、ここは私に任せてもらおう。行くんだ。"
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "えっ！？　あ、貴方は……！"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "セイロン、早く逃げるぞ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "待って、はぁ……はぁ……ドクター、もう足が……。"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "やっと……ビーチに着いた……。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "自分も……もう走れない……。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "護衛",
          "speakerId": null,
          "text": "お嬢様、私たちと一緒に戻りましょう。"
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "嫌です！"
        },
        {
          "type": "dialogue",
          "speakerName": "護衛A",
          "speakerId": null,
          "text": "お嬢様に怪我をさせるなよ。あのドクターとかいう奴は好きにしていい。"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerId": "char_188_helage",
          "text": "あぁん？誰がドクターを好きにしていいって！！？"
        },
        {
          "type": "dialogue",
          "speakerName": "護衛B",
          "speakerId": null,
          "text": "あっ、熱いっ！"
        },
        {
          "type": "dialogue",
          "speakerName": "護衛C",
          "speakerId": null,
          "text": "お前、どこのガキだ！"
        },
        {
          "type": "dialogue",
          "speakerName": "護衛C",
          "speakerId": null,
          "text": "うわっ！　ケツが燃えた！　ケツがああ！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "おいドクター、また面白いことやってんな。オレサマを呼ばねーなんてツレねーじゃんか。"
        },
        {
          "type": "dialogue",
          "speakerName": "護衛A",
          "speakerId": null,
          "text": "チッ、ガキ一人だ、目にもの見せてやれ！"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "フンッ、ちょうど退屈してたんだ、へへ……。"
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "speakerId": "char_348_ceylon",
          "text": "ドクター、急に顔色が悪くなっているような……どうなされたの？"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "イフリータ、あまりやりすぎるな！！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "服を燃やす程度で十分だ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "チェッ。"
        },
        {
          "type": "dialogue",
          "speakerName": "イフリータ",
          "speakerId": "char_134_ifrit",
          "text": "じゃあミディアム・レアぐらいにしとくぜェ！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
