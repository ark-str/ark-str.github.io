  "stageId": "main_04-03",
  "title": "人工的冷却",
  "storyCode": "4-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_04-03_end.txt",
  "sourceHash": "1234a6b9758c91be740528c1b247c8d4e07154ba283050351751bbbff1d662ae",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン",
      "text": "急げ、素早く行動しろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "あの人たち、どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）静かに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）は、はい……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）あいつら、まだいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）……ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）何か探しているみたい――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）――！　隠れて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "なんだ、気のせいか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）……厄介だな。狙撃はできないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）ちょっと遠すぎるわね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）あの人たちが現れたあとは、爆発音も止まってるし……撃てばその音が目立っちゃうのも難点だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）向こうは三人で散らばってるから、一度に全員仕留めきるのも難しいでしょうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）おまけに、あの動き……ほかのレユニオンとは明らかに違うわよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）確かに……あの人たちだけ重装備ですしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）ええ。こうなると、軽率に動いて一人でも逃せば、大量に増援を呼ばれて、もっと危険な状況に陥るのは目に見えてるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）その上、向こうに探知型のアーツを使える人員がいた場合は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）一度狙撃を試みただけで、こちらの位置を把握される可能性もあるしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）術師らしい格好の人がいるのは確認してるし……何かテストをしている様子なのも気になるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）なるほど。結論として、今は何もできないということか。数の上では3対3でも、包囲されているようなものだしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）ええ。……最悪の事態ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）まるで、追っていたはずの獲物に、気付けば追い詰められていたような……嫌な感じだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）……見て。あの人たち、誰かに連絡しているみたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）ここからでは、内容まで聞き取れそうにないな。私が行ってこよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）ダメよ。周りが静かすぎる……今動くのは危険だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）そもそも、向こうの実力もわからない状況だしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）耳ざとい相手に気付かれでもしたら――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）……？　あの人たち、何を待ってるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）……何か……妙な感じがするわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）どこか、違和感があるような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）あなたもそう思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）た……多分……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）また、温度が下がったせいだと思います……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）さっきから……すごく、寒くて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）……！　もしかして、あの人たちが何かしたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）……って、ジェシカ……？　どうしたの？　急に指をくわえたりして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）寒さで身体が震えても、歯が鳴らないようにしているんだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）今必要かどうかはさておき、この手の心得があること自体は見所がある。大した子供だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "（小声）大した子供、って……私からすれば、あなたもまだまだ子供なんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）……はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "（小声）そういうのは止してくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……温度が元に戻ってきたわね。あの三人もこの場を離れたようだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "それにしても、さっきのテスト……やっぱり、気温の変化と関係している気がするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "――音もなく、冷気と共に現れて、熱を奪うと静かに去って行く。そうして、あとに残されるのは、暗がりで震える人々だけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "……こうして言葉にすると、やっぱり「スノーデビル」の噂を思い出しちゃうわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "そうだな。まだ推測の域を出ない話ではあるが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "もしかすると、奴らがその「スノーデビル」なのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……見つけた。この壁、まだ凍り付いているな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "だが、見ての通り――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "黒い源石が、隅に埋め込まれてる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "冷気の元はここと考えて良さそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ああ。こうして、壁面に霜が降りていることから見ても――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "この源石が、辺り一帯の温度を下げている大本の原因だろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "――これは、傭兵時代に耳にした話だが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ウルサスの西北部には、感染者で構成された遊撃隊がいて、そいつらはずっと政府と戦い続けているそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "聞くところによると、その遊撃隊の中には、要塞を思わせるほどの怪物がいるという噂でな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "なんでも、そいつの歩みを止められるものはなく――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "相対すれば、盾は砕かれ、武器は折られるという話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "挙げ句、怪物が去ったあとには、ただの更地が広がるばかりで、命あるものなど残らないと聞いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "加えて、その遊撃隊には――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "厳しい冬を体現するような、とある小隊が所属しているとかで、そいつらの噂も色々と耳にしたものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "たとえば、その小隊が通った場所は、すべてが氷に覆われるだとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "そうして凍り付いた建物は、崩れ落ちて粉と化したとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "戦場にあった塹壕の中は、凍り付いたウルサス兵で埋め尽くされていたとかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "その話をしたのって、つまりは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ああ。思うに、先ほどの連中が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "件の「スノーデビル小隊」だろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "だが、何はともあれ今は前進しよう。レユニオンの拠点は、恐らくこの近くにあるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "どうしたの、ジェシカ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……何かのにおいがするんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "なんというか、焦げ臭いような……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
