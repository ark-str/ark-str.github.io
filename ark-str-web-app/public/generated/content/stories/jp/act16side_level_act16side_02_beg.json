{
  "server": "jp",
  "storyId": "act16side_level_act16side_02_beg",
  "groupId": "act16side",
  "stageId": "act16side_02",
  "title": "散歩の時間",
  "storyCode": "GA-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act16side/level_act16side_02_beg.txt",
  "sourceHash": "1793c1906b58ed3dc7905b7be3f018c6d2a5bf597a5c928098c3d92f205e7c01",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "それでそのまま出てきたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "あの子の相手をしてても意味ないし、時間稼ぎが目的の可能性だってあるでしょ。ターゲットが病院にいない以上、今は所在確認が最優先事項よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "そっちは？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "近道を通ってもうすぐで大聖堂ってところかな。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "できればでいいけど、教皇庁から公証人役場に協力命令を出すよう伝えといて。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "病院の人によると、女の子を連れてきたのは執行人見習いで、両親からはぐれて迷子になった子を拾ったって言ってたそうよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "協力命令が出れば、その見習いはきっとその子を連れて公証人役場に戻るわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "たとえ戻らなくても、公証人役場システムから位置を特定できるはずよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "フィアメッタが優秀すぎると、私にとっては損な気がするんだよね……"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "そうだ、報告を終えても大聖堂からは離れないで。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "あれ？　手伝いは必要ないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "……そういうわけじゃないわ。何かが起こる気がするのよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "もう起きてるんじゃないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "誰のこと言ってるかわかってるでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "とにかく、あなたは大聖堂にいて。その方が役に立つかもしれないから。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "もしかして心配してくれてるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "私はただあなたにあちこち動き回られたくないだけよ……何かあったときに備えて大人しくしてて！"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "了解、幽光の夜警さん。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "……名前で呼びなさい！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "ふぅ……"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "ここ、人がたくさん……"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "おかげでそう簡単には見つからないはずだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "ここはアンブロシウス区だけど、来たことはあるかい？"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "アンブロシウス区……ママが時々お買い物に行くって言ってたよ。ママはここにいるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "いや、まだわからないんだ。ママが連れて行かれちゃったって話、詳しく聞かせてくれるかな。"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "ママは病気になっちゃって……朝、ママとお話ししてたの。そしたらその後に、白いお洋服を着た公証人役場の人が来て……"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "その人が帰った後、今度はマントみたいな服を着た人が来て、ママを連れてっちゃったの。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "（公証人役場の……本当に誘拐事件なんだろうか……違和感が拭えない。）"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "じゃあその時セシリアはどこにいたのかな？　その人たちには見られてない？　それと、パパはどこに？"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "……それはママと関係あるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "うーん、今のところあるかはわからないけど……ただ、いろいろ教えてくれれば、何か手がかりが見つかるかもしれないからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "重病の母親",
      "speakerId": null,
      "text": "……いい、セシリア。見つかってしまわないように、ちゃんと隠れて……"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "……では、この子の両親の名前、自宅の住所、身分識別番号、およびあなたとの血縁または法的な関係を教えてください。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "もしセシリアを連れて行く正当な理由があるなら教えてください。そちらも考慮したうえで判断しますので。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "エゼルおにい……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "あ、ちょっとだけ待ってもらえるかな。ごめんね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "もしもし、はい、エゼルです。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "はい、今はアンブロシウス区にいます。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "はい、この子の母親を探しているところです。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "公証人役場に戻れ？　はい、そうしようと思ってたところですが……およそ三十分ほどでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "はい、わかりました。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "エゼルお兄ちゃん……わたしを公証人役場に連れて行くの？"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "うん。なにか気になることでも――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "一つ忠告しておくわ！　あんたが本当にセシリアを気にかけているなら、絶対に公証人役場や教皇庁に渡さないことね！　でないと後悔することになるわよ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "……セシリア、もしかして行きたくないのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "……ママが、行っちゃダメだって……"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "でも！　ママが見つかるなら、わたし……行ってもいいよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "ママは病気だから……とっても心配なの……"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "……セシリア、もう一ついいかな。さっきのリーベリのお姉さん、今まで会ったことある？"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "ないよ。わたしあの人嫌い……"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "ありがとう。……ちょっとだけ考えさせてね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "セシリアの母親は、公証人役場に行ってはいけない、執行人には近づいてはいけないと言っていた。\nセシリアの母親が失踪する直前に、執行人が現れていた。\nそして、セシリアの母親は失踪した。\nセシリア自身も怪しいリーベリに誘拐されそうになった。そのリーベリの名は恐らく「パティア」だ。\nパティアは、セシリアを公証人役場や教皇庁に引き渡してはいけないと言っていた。\nそして最後に、セシリアの光輪には……異常が見られる。\n......\n今ここで身を引けば、面倒事に巻き込まれずに済むんじゃないか？\nいや違う……\n逃げるな、エゼル……\n考えろ……\n僕のやるべきことは、何だ？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "ねぇエゼルお兄ちゃん……病院にいた時、ママを探すのを手伝ってくれるって言ってたけど、ほんと？"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "今でも……まだほんと？"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "何かほかの道もあるはずだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "本当だよ、約束した通りさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "セシリア、僕たちは公証人役場へは行かないよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "お家の場所は覚えてる？　まずはママの知り合いを探してみよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "約束したからには、絶対にママを見つけてあげるからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "ありがとう、エゼルお兄ちゃん！"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "でも、ここに来るのは初めてだから、どうやっておうちに帰ればいいかわからないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "speakerId": null,
      "text": "お兄ちゃんと会った場所に戻れれば……おうちがどこかわかるけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "speakerId": null,
      "text": "わかった。じゃあ来た時とは別の道からステファン区に戻ろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "おかえり、モスティマ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "教皇聖下、お久しぶりです。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "此度はどんな情報を届けてくれるのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "ご安心を、あの時ほどひどいものじゃありませんから。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "これが先ほどお話しした身体検査の結果報告です……最後のページにあるのがステファン区中央病院院長の所見です。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "……なんとも慎重な言葉で綴られておるな。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "モスティマ、君の考えは？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "診察と検査を担当した医師によると、その検査報告の被検者は……八歳のサンクタの少女だそうです。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "少なくとも外見とほとんどの指標を見るに、サンクタであることは間違いないかと。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "共感指標はそれほど高くありませんが、被検者の年齢と健康状態を考えると、基準値の範囲内です。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "問題があるのはこちらのいくつかの指標です……私が以前受けた身体検査でも、似たような傾向が確認されています。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "ですがこの少女は十二歳未満ですので、まだ守護銃を手にしていないはずです。他に戒律を破る能力が彼女にあるとは思えませんし、外見的特徴からも堕天した可能性は否定できます。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "となれば、考えられる可能性はもうわずかです。教皇聖下は私なんかよりもずっとお詳しいですし、もう見当は付いているかと……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "堕天でないとしたら、残る可能性は……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "いや、それも外見の特徴と矛盾するわ。その手の子孫が光輪を得られるはずないもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "そう、普通ならね。だけど実際、そういう事例自体少ないんだし、例外がないとも言えないんじゃないかな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "うーん……その子はまだ病院にいるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "いや、病院にはいなかったみたいで、フィアメッタが追跡中だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "あ、そうだ。病院に連れてきたのは公証人役場の執行人見習いらしいから、フィアメッタが公証人役場に協力命令を出してほしいってさ。本人も今公証人役場に向かっている途中だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "公証人役場……"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "不幸中の幸い、でしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "協力命令だけでいいの？　フィアメッタ一人で大丈夫かしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "ヴェルリヴ、慎重なのはいいけど、大聖堂で開かれようとしている一大イベントを忘れてない？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "その執行人見習いは、どのくらいその子の情報を手に入れているのかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "まだなんとも。病院によると、ただの「正義感から迷子の子供を助けた」真面目な執行人だったって。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "まずはフィアメッタに任せておくとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "わかりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "だけど、モスティマは行かなくていいの？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "ひとまずはね。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "フィアメッタが病院で元護衛隊のリーベリとも会ったらしいんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "おそらくそのリーベリは女の子に接触してる。ただ、向こうの目的が何であれ、うまくいってない様子だったみたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "だけど、ちょっと反抗的な発言をしてたらしいよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "うむ……やはり君は大聖堂に残りなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "ヴェル、焦らずともよい。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "使節の到着状況はどうなっている？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "残りあと二組ですが、到着予定時刻までまだもう少しあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "構わん構わん。"
    },
    {
      "type": "dialogue",
      "speakerName": "教皇",
      "speakerId": null,
      "text": "ゆっくり待つとしよう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "緊張するパティアの手下",
      "speakerId": null,
      "text": "パティア、すまない。見失っちまったようだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……仕方ないわ。あいつはわざと人が多くて道も入り組んでるアンブロシウス区に逃げ込んだのよ……新米ヅラしてなかなかのやり手じゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "はぁ、面倒なことになったわ。どうしてよりによって執行人の手に渡るのかしら……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "こんな時に誰よ……オレン？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "パティア、まーた面倒なことになったな。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "なに、茶化すために連絡してきたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "なわけないだろ。おふざけは順調に進んでる時にしかしねえよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "いいニュースと悪いニュースがあるんだが、どっちから聞きたい？"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "それがふざけてるって言ってるのよ……悪い方からにしとくわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "悪いニュースは、教皇庁に知られちまったことだ。正式に人をやって介入してくるみたいだが、任務を受けたのは誰だと思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……どうせフィアメッタでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "正解！"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "だったら、いい方って……？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "いいニュースは、フィアメッタ一人だけってことだ。モスティマは大聖堂に残ってるらしい。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……まぁ、一応いいニュースってことにしとくわ。でもあたしが聞きたかったいいニュースはそんなのじゃないんだけど……オレン、あんた今何してるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "冴えてるな。モスティマが残ることになったから、報告の順番をあいつと交換してもらったんだ。つまり、今俺は手が空いてるってことになる。喜んでいいぜ？"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "全っっっ然うれしくないけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "それとオレン、一つ警告しとくけど、先輩ヅラはやめなさい。あたしはあんたよりずっと早くから先導者様のとこにいるんだから。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "へいへい、わかりましたよっと。どうせ俺はお前の大好きな「フィアメッタ先輩」とは違って……って切ろうとすんなよ、まだ話は終わってねえ。お前にフィアメッタの足止めをしてほしいんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "じゃああんたは何するの？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "俺はセシリアを迎えに行く。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "なに勝手に決めてんのよ。逆じゃダメなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "そう怒んなって。理由はわかってるだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "執行人の対処は、お前がやるより俺がやった方がうまくいく確率が高い。それに、最悪フィアメッタの足止めには失敗しても構わないぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "なぁパティア、サンクタが嫌いか？"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……何よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "答えろよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……サンクタ自体はどうでもいいわ。あたしが嫌ってるのは、サンクタを祭り上げることによって自分を下げてる自覚がない間抜けなリーベリよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "興味なしか。それじゃサンクタが理解できなくて当然だな。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "なによ、あんたと執行人はサンクタ同士だから、同族のよしみでセシリアを引き渡してもらえるとでも言いたいわけ？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "ちげぇよ。光輪のおかげで感情は伝わるし相手を理解しやすくはなるが、思想を共有できるわけじゃねぇんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "ただ、俺は身をもって理解してる――感情の繋がり、ひいては強すぎる感情の繋がりってのは、弱点になることもあるんだぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "サンクタは「共感」に慣れきってるせいで、ひとたび共通認識を逸脱する物事に出くわすと……疑念がわき上がって、迷いが生じるもんなのさ。そこを突くってわけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……あんたも「迷い」が生じたからあたしたちに味方してるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "お前たちの味方？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "何言ってんだよパティア。俺は味方になったつもりはねぇぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "たまたま同じ道を歩いているだけだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "オレン、誰と通信してるの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "モスティマか。お前は本当に屋上が好きだな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "お互い様だよ。レガトゥスはみんな屋上に出るのが好きなんじゃないかな。そうでしょ、オレン？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "あぁ……朝も見られてたってわけか。さすがだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "君だったんだね。どこかの家の屋上の植木鉢かと思ってたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "んだよ、この髪色もイケてるだろ。こういうファッションがヴィクトリアのトレンドなんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "私はファッションって、自分に似合っているかどうかが大切だと思うけどね。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "というか君、本当にヴィクトリアが好きだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "責務があるからな。栄光あるレガトゥスとして相応の使命を背負ってんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "なら私の使命も当ててみてよ。どうして私が急にヒゲ爺さんに会いに来たのか気にならなかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "もしかしたら、ラテラーノがひっくり返るような極秘事項を持ってきたのかもよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "やめろやめろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "そんなの聞きたくもねぇよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "あれ、本当に？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "もう一人、助っ人が欲しいんだけどなぁ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "フィアメッタとは合流しないと言っておいて、オレンを助っ人にするつもりなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "妬くなよヴェルリヴ、俺はお前一筋だぜ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "オレン・アルジオラス、気持ち悪い冗談はやめてくれるかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "そんな言い方されると俺だって傷つくぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "わーお、オレンにそんな気があっただなんて初耳だよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "……ここでおしゃべりしてる暇があるなら、二人とも報告書を書き直したらどうかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "え？　私の報告書に何か問題でもあった？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "私が何秒であなたの報告書を読み終えたと思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "あー……フィアメッタの文字数も足して計算するのはダメかな。二人で一万文字超書いたってことでなんとか……"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "俺は大真面目に五時間もかけて書いたぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "あなたの報告書のうち、事実に即した内容はモスティマがラテラーノに帰ってきた回数よりも少ないわ。あなたの手当も同じように減らしてあげてもいいのだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "……ねぇオレン、あたしゃ心配だよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "ああモスティマ、一体どうしたっていうんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "レミュアンが……ヴェルリヴみたいになっちゃったらどうしよう？"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "……そ、そんな恐ろしい話やめてくれ。震えが止まらねぇよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "あなたたち、本当にお暇なのね。"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "オレンは大忙しだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "はぁ、そうだな。忙しいったらありゃしねぇ。そろそろ行くぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "speakerId": null,
      "text": "じゃあまたな、我が愛しのヴェルリヴ。手土産にエクレアでも買ってきてやるからよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "speakerId": null,
      "text": "……睨まないでよ。別に笑ってないって。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "speakerId": null,
      "text": "オレン・アルジオラス……せいぜい私に弱みを握られないようにすることね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "speakerId": null,
      "text": "フィアメッタさん、エゼルは公証人役場に向かってる最中みたいなんで、もうちょっと待っててもらえますかね。"
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "speakerId": null,
      "text": "お茶でも淹れましょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "いらないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "そのエゼルって人とは知り合い？"
    },
    {
      "type": "dialogue",
      "speakerName": "公証人役場職員",
      "speakerId": null,
      "text": "ええ、あいつは俺の後輩ってとこです。あそうだ、俺はリケーレっていいます。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "彼の仕事ぶりはどう？　普段疑わしい点はなかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "疑わしい？　うーん、全然残業しないのは疑わしいですか？　あいつときたら、退勤時間になるとすぐに姿を消すんですよね。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "ですが仕事はしっかりこなしてますよ。実務研修期間もまもなく終わりますが、良い評定をもらえるはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "俺は正直、残業嫌いでも構わないと思ってますけどね……実務研修中の新米ですし、楽ができるのも今のうちです。今後外勤に出るようになれば、仕事と休みの区別もなくなりますから。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "……彼の現在地を調べてちょうだい。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "まさか本気でエゼルを疑ってるんですか？　俺はあいつのことは信用してるんですけどね……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "……ん？　この位置……本当に違う方向に向かってる！？　どういうことだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "見せて！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "この方向……ステファン区に戻るみたいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "フィアメッタさん！　ちょっと待ってください！　もし本当にあいつがなにか企んでるなら、位置情報を切るはずです。どうか慎重なご判断をお願いします！"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "位置情報を目くらましに利用してる可能性だってあるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "もしこの位置情報を目くらましにするつもりなら、おとなしく公証人役場に向かわせるはずじゃないですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "フィアメッタさん、どうか公証人役場の執行人を信じてください。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "……別に信じてないわけじゃないわ。私だって公証人役場の一員みたいなものだし。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "彼の疑いを晴らすためだと思ってくれればいいわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "ったく……"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "あれ？　位置情報が切れた。今更気付いたか。エゼルもまだまだ青いな……"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "だが、最初から切られてたら逆に弁解のしようもなかったな。運のいい奴め……"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "お前が何をしようとしてるかは知らんが……やるからには自分で責任取れよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "まぁ、一度フィアメッタさんにこってり絞られるのもいい経験だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "おう、おかえり、フェデリコ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "speakerId": "char_279_excu",
      "text": "はい。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "今日のステファン区はやけに賑やかだな……そう思わないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "speakerId": "char_279_excu",
      "text": "あのご遺体に何か問題でも？"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "どうやらその後の出来事は見てないようだな……遺体は問題なく安魂教会に送られたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "speakerId": "char_279_excu",
      "text": "そうですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "……俺の言う「出来事」が何なのか気にならないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "speakerId": "char_279_excu",
      "text": "何ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "……まあいいや、聞かなかったことにしとけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "だが、あのフェオリアって女性はもう亡くなってるんだ。お前の方の手がかりも途絶えたんじゃないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "speakerId": "char_279_excu",
      "text": "ほかの方法があります。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "どんな方法だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "speakerId": "char_279_excu",
      "text": "リケーレ・コロンボさん、フェオリア・ラポルタの外出記録を調べてください。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "……お前とのコミュニケーションはいつまで経っても慣れないな。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "調べてやってもいいが、お前の代わりに報告書を書くのはごめんだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "speakerId": "char_279_excu",
      "text": "ええ、追加審査のフローに基づき、私が申請および報告を行いますので、ご心配なく。"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "……はいはい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "どれどれ……"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "……ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "……んん？"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "speakerId": "char_279_excu",
      "text": "何か発見がありましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "speakerId": null,
      "text": "……なかなか興味深い。見てみろ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "……いつまで付いてくるつもり？"
    },
    {
      "type": "dialogue",
      "speakerName": "市民？",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "とぼけても無駄よ。公証人役場を出てから、コソコソ私をつけてくる人が増える一方じゃない。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "もう少し自然な尾行のやり方を学ぶべきね。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "みんな戦士上がりじゃないし、訓練だってまだそれほど受けてないんだから仕方ないでしょ。ここまでできるだけでも十分よ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "パティア、もう誤魔化そうとはしないのね？"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "邪魔をしてこないなら、あなたを相手にするつもりはなかったんだけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "昔のよしみで、一つ忠告しておくわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "あなたがどんな人に出会ったかも、誰の言葉に従っているかも、何をするつもりかも一切知らないけど――今手を引けばまだ間に合うわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "誰の言葉に従ってるかって？"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "フィアメッタ、あんたこそ誰に従ってるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "パティア、教皇庁を敵に回さないで。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "もしそれこそが目的だって言ったら？"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "speakerId": null,
      "text": "……今ならまだ聞かなかったことにしてあげるわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "……あんたは何も変わらないわね……"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "ちっぽけな情のために……そうやって相手の肩を持とうとするなんて……"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "でも残念ながら、あたしはもう昔のままじゃないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "speakerId": null,
      "text": "あんたは聞かなかったことにできるかもしれないけど、あたしは言わなかったことにはできないのよ。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
      "speakerId": "char_279_excu",
      "aliases": [
        "フェデリコ"
      ]
    }
  ]
}
