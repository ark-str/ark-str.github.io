{
  "server": "jp",
  "storyId": "story_greyy2_set_1_story_1",
  "groupId": "story_greyy2_set_1",
  "stageId": null,
  "title": "綴られる光",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_greyy2_1_1.txt",
  "sourceHash": "cc7ce9ae87c46fd26bb636d85faaa34efc95ea53eb8fc6032c6b88a6317273bf",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "グレイか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "新しい外勤任務の要請があってな。悪いが、エンジニア部まで来てくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "わかりました、すぐに行きます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "簡単に説明すると――前にアップデートした防災用電力システムとそれに対応した照明器具を量産したから、設置しようってところでな。人手のある大きな事務所にはもう配送してもらったんだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "街から離れた小さな事務所は、駐在してるオペレーターも少ないからさ。システム導入と取り付け作業ってなると人手が足りないんだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "そこで、エンジニア部のオペレーターを直接派遣して手伝おうって話になったんだ。派遣先のリストはこれな。割り当ては今からやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "いつも通り、行きたいところがあれば言ってくれ。ただし、個人的な用事で工期を延ばすのはナシだぞ。作業を終えたら好きに過ごして構わないが、それで予定の期限を過ぎたりはするなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "わかりました。リストを見てから、派遣先の希望を出してもいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "もちろん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "……僕、このボリバルの裏山にある事務所に行きたいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "わかった、それで申請しておくよ。そうそう、テスト用のデバイスと照明はこれな。システムのインストールと更新の方法は、エンジニア部の端末に入ってるファイルで確認してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "……ところで、ボリバルはお前の故郷だったよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンジニア部の先輩",
      "text": "里帰りなんて滅多にできないんだし、気をつけて行ってこいよ。出発は明日の朝七時だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "ありがとうございます。さっそく荷造りしてきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "手荷物はクライアント訪問の時と同じでいいよね。ほかに何か持っていくものは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "新商品が入ったんだって、見に行こうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カゼマル",
      "text": "ま、まだ任務の引き継ぎを終えていないのですが……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "そこをなんとか！　イースチナお姉ちゃんがテストに合格したって聞いたから、プレゼントをあげたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グム",
      "text": "カゼマルお姉ちゃんはプレゼント選ぶのが上手だって聞いたから……お願い、手伝って～！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "……みんなが噂してた秘密の雑貨屋さん、そういえば行ったことないな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "確か、ここを真っすぐ行って……左に曲がるんだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "あっ、本当にあった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘密の雑貨屋さん",
      "text": "あれ、グレイ。久しぶりじゃん。最後に会ったのは～、エンジニア部の人たちと一緒に実習行くとこ見かけた時だっけ？　どうよ、最近は忙しいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "実習のほうはもうすぐ終わりなんですが、最近は論文の答弁の準備をしているところで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘密の雑貨屋さん",
      "text": "あ～、それは大変だねえ。あたしも卒論書いてた時はストレスで毛が抜けちゃって、耳がはげはげになったりして……生え揃うのに結構時間がかかったなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘密の雑貨屋さん",
      "text": "ちなみに、その時使ってたのがこの育毛剤で～す。一本どう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "え、ええと……遠慮しておきます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘密の雑貨屋さん",
      "text": "あははっ！　じゃあ、この栄養満点のくるみミルクは？　 最近の売れ筋だから買って損はないと思うよ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "そ、それもちょっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘密の雑貨屋さん",
      "text": "ふふっ、そんな困った顔しないの。これはあげるよ、サービスね。答弁は大変だろうけど、それ飲んで頑張って！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "ありがとうございます、リリーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "秘密の雑貨屋さん",
      "text": "どういたしまして。……で、今日は何を買いに来たのかな？　あたしの品揃えなら、絶対損はさせないよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "うーん……ガラス細工のオリジムシに、ハガネガニ型の植木鉢、それから自家用醸造機、って……本当にこれでよかったのかな……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイ",
      "text": "あとでもう一度荷物を整頓しておかないと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "おはよう、グレイ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "何を運んでるんだ？",
          "value": "2",
          "blocks": []
        },
        {
          "label": "引っ越しでも始めたのか？",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "おはようございます、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "明日から、防災用の電力システムを更新しに、ボリバルの事務所へ行くので……事務所のみなさんにお土産をと思って。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "答弁の準備はどうだ？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "論文は順調か？",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "それが、論文は書き終わったんですが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "最後の謝辞の書き方で少し悩んでまして。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "やっぱり、良い形で締めくくりたいですから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "この任務から戻ったら、最終稿を提出しますね。本番の答弁でもよろしくお願いします、ドクター。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "引き続き頑張って。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "当日は厳しくいくぞ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "それにしても、里帰りとなると喜ばれそうだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……君の帰郷と同じように手土産も喜ばれるといいな。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "そうですね……っと、すみません、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "まだ荷造りもありますし、明日は早いので、そろそろ失礼します。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "無事に帰ってきますから、どうかご心配なく。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "そうか。道中気をつけて。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "ありがとうございます、ドクター。それじゃ、また！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "数週間後"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "えっと……本当に気に入ってくれたんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "ええ！　ガラス細工はいい感じだし、この植木鉢もとってもかわいいし……えっ、醸造機……！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "グレイ、これはどういうこと？　どうしてこれを選んだの？　まさかその歳でもうお酒を飲んでるわけじゃないでしょうね？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "ち、違いますよ――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "しっかし、わざわざ手土産を買ってくるなんてなあ……あんなに小さかったグレイが、立派になったもんだ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "ははっ、こっちはなんにも変わってないのにな。ちょこちょこ人の出入りはあったが、俺たち三人は相変わらずここにいるしさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "はぁ……ところで本当に大丈夫なの？　さっき着いたばかりなのに早速仕事を始めちゃうなんて……少しは休んだほうがいいんじゃない？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "別に急ぎのスケジュールってわけでもないんでしょ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "聞いた話じゃ、お前を本艦まで送っていったすぐあとに、ドクターとかいうリーダーが来たんだろ？　なんでもこの数年で色々成果を出してるらしいが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "それにしたって、治療のために本艦に行ったはずのグレイが、どうしてこういう大変な外勤任務に行かされてるんだ？　ドクターって奴に無理やり働かされてるんじゃないだろうな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "お前は病人なのに、何日もかけてここまで来た挙げ句水も飲まずに働くなんておかしいだろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "落ち着け、フェルナンド。これがこの子のやりたいことなんだよ。手紙にもそう書いてあっただろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "安心してください、フェルナンドさん。ドクターはそんな人じゃありませんし、本艦もすごく良いところです。ここに来るのだって、僕が自分で決めたことで……とっても良くしてもらってるんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "普段はエンジニア部で実習を受けさせてもらっていて、今もその関係で論文を書いたりして……それにほら、見てください。僕、前よりも背が高くなりましたし、身体も強くなったんですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "今やってる作業だって、単なる明日の準備です。電気系統を確認して準備済みのモジュールと合うように調整するだけですから、疲れるような作業じゃないですし。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……本当だな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "まったく、お前はいつまで経っても気ぜわしい奴だな。グレイが嘘をつくはずないだろう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "ふふっ、本当に本当ですよ。そういえば、出発前ドクターに会った時なんて、僕が戻ればみんな喜ぶだろうって言ってくれたくらいで……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "そのドクターってのは、そんなことまでわかってくれるわけか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "だったら……まあ、悪い奴じゃなさそうだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "さてと、グレイ。とりあえず、ハシゴから降りておいで。実は、君が帰ってくるっていうから、張り切ってボリバルの郷土料理を作ったんだ。まだまだ成長期なんだし、たくさん食べてほしくてさ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "おお～、本当に背が伸びたなあ。俺に追いつきそうじゃないか。最初に君を抱えて帰ってきた時は、まだこのくらいだったのに……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "え、えっと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "あら、照れてるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "ふふふっ。……そうだ、話は変わるんだけど、実は相談したいことがあるの。さっき私たち三人で話し合ってね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "ほら、手紙に書いてくれてたじゃない？　あなたが今、電気関係のエンジニアを目指して工学の勉強をしてるってこと……もちろん、それ自体はすっごくいいことだし、立派だと思うわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "でも、一人の医者としては、やっぱり……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "……リィタ、俺が言おうか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "機械を作ってること、論文の執筆や答弁の準備をしてること、今後はもっと難しい研究をしたいってこと、そして「現代科学の最先端に触れていきたい」ってこと……色々手紙に書いてくれたよな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "……あなたの選択に口を出すつもりはないの。でも……こんなこと言いたくないけど、今もあなたが病人であることに変わりはないのよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "心配しないでください、リィタさん。本艦でもらっている薬はすごく効き目がいいですし……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "それに、あそこには僕と同じくらい……あるいはもっと重症の患者もたくさんいますけど、みんな僕よりもたくましく暮らしていて……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "自分の病気を甘く見ているわけじゃないですが、頑張るみんなを見ていると僕まで元気をもらえるんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "そうか……自分でもわかってるならいいんだ。ただし何事も慎重に考えて行動するように。俺が伝えたいのはそれだけだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……おいおい、お前らからはそれだけか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "グレイ、立ち上がってぐるっと回ってみせろ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……その年頃のペッローだと考えりゃ、まあまあか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "――お前、それでも自分が感染者だっていう自覚はあるんだな？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "フェルナンド……そういう喋り方はよせ、怒るな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "子供相手にけんか腰になるんじゃない。煽るような言い方しても、何にもならないんだぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "……もちろんわかってますよ、フェルナンドさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "それでも、これが僕のやりたいことなんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "お前の考えも理解できる。子供ってのはみんな、小さい頃は夢を見るもんだからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "もちろんその夢だって大事だが、俺としちゃ、お前の身の安全のほうがもっと大切なんだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "――俺は明日、申請を出してくる。この先もお前がここにいられるようにな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "えっ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……昨日、昔のお前の診断書を見返したんだ。血中源石密度の値……0.3u/Lもあると、気を抜けば病状が悪化しかねない。最新の診断書までは確認の権限がないが、今は一体いくつになってる？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "本艦が前と変わらない目標のために努力してることは信じてるさ。だがお前はコードを書いたり、機械を作ったり、金属加工の実習を受けたりなんてしてる場合なのか？　身体のことを考えるなら――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "フェルナンド！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "そんなことを言う必要はないわ。この子はもう小さな子供じゃないんだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "そもそも、心配なのはみんな同じよ。それでも、自分の考えを押しつけるようなことは……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "コホン。――なあ、先に飯にしないか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "スープが冷めたらもったいないしさ。ほら、グレイも食べな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "……ありがとうございます、ペドロさん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "お皿洗いは、あとで僕がやりますね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……ダメだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "グレイは休んでろ、俺がやるから！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "うーん……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "グレイは鼻先の汗をぬぐうと、端末に更新データを入力していく。\n照明は明滅するも、次第に落ち着いていった。\n事務所の部屋のいくつかは一瞬電気が落ちたものの、新システムが再びともしたその明かりは前より明るく輝いている。\nグレイは手にした端末を確認し、静かに息をついた。"
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "時間が押してたりはしないかい？　よかったら、何か手伝うよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "ありがとうございます。大きなアップデートですから、やることはたくさんあるんですが、僕ひとりでできるので大丈夫ですよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "なあ、グレイ。実は俺も子供の頃に病気をしてたことがあるんだ。……そん時、両親はそれを早く治そうと俺を家に閉じ込めて、何もさせてくれやしなくてさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "その頃の俺は、そんなことする理由がわからなくて、自由を奪われてるようにすら感じてた。ほかの友達は病気になっても親と一緒に出かけたり働いたりできるのに、俺はひとりで留守番かよってな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "でも、十年以上経った今では二人の気持ちが痛いほどわかる。うちはそこまで貧乏じゃなかったから、俺の命を削ってまで働かせず、治療に専念させる余裕があったんだってことも理解できた。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "俺はさ……電気の交換なんかのために、病人をこんな遠くまで派遣してくるような環境で、お前が本当にやりたいことを見つけられるとは思えないんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "そうやって決めつけるのはやめなさい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "初心を忘れちゃったのなら、何日か休んで頭を冷やしてきてちょうだい。……自分がロドスに入った理由を思い出してから、物を言うことね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "さっきの発言はグレイだけじゃなく、本艦への侮辱でもあるわよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "なんだよ、怒ったのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……俺だって腹が立ってんだよ。自分の無能っぷりにな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "グレイにもっと良い未来を与えてやれなかったからって、こうして理不尽で威圧的な親みたいになってる自分にも腹が立つ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "フェルナンド、これはグレイ自身が選んだことなんだぞ。本艦はこの子の選択を尊重するからこそ、色んな可能性を与えようとしているだけさ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "グレイの人生はグレイのものだ。この子にとって、本艦は大きな足がかりになる場所なんだよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "それでも、俺にはグレイが死にに行ってるようにしか思えねえんだよ……！　実際、ガキの頃の友達はみんなどこぞの工場で鉱石病になって死んじまったし……今も元気に働いてる奴なんか俺だけだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "あいつらの遺灰が移動都市から撒かれていくのを見ていることしかできなかった俺の気持ちがわかるか……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "その点、グレイにはまだ選択の余地があるんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "感染者にだって、平穏な一生を送れる道もある！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "俺たち三人は感染してないし、戦争でも起こらない限り長生きできるだろうが……この子は俺たちより先に死ぬかもしれない。俺の昔の仲間たちみたいに……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "俺はやりたいことがあってロドスに入った口ではあるが、それは大層な志のためとかじゃない。ボリバルで生まれ育ったから、自分の仲間やもっと多くの感染者たちを救いたくて働いてるだけだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "それに、俺は病人を働かせるために救ってるわけじゃない……！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "フェルナンド！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "私たちもフェルナンドに何があったかは知ってるし、理解はできるけど……これじゃ落ち着いて話し合うこともできないわ。本当、短気なんだから。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "そうだなあ。前に似たようなことがあった時は、俺たちで二時間くらい説教することになったけど……そういや、その週末にはお前たち二人で裏山に釣りに行ってたよな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "あれと今回の件とじゃ訳が違うわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "これはグレイの人生にも、私たちの理想や目標にも関わってることなのよ。あの時みたいなちっちゃい話じゃ――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "ん、なんだ？　明かりが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "グレイ、どうしたの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "う……ううっ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "……っ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "……あなた、泣いてるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "大丈夫よ。今のはケンカしてたわけじゃなくて、ただ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターB",
          "text": "まあまあ、とりあえずまだハシゴの上にいるなら降りておいで。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "text": "……ぐすっ……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "……フェルナンド、あなただったの？　じゃあ、グレイはどこ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "僕はここです！　すみません、さっきのは電源系統にトラブルが起きたせいみたいで……でも、もう修理に取りかかってますから安心してください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "……フェルナンドさん……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "っ……こんなことになるってわかってたら……またいつか俺たちを助けに戻ってきてくれ、なんて言わなかったのによ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……本艦からはるばるこんなとこまでやってきて、疲れてるだろうに……文句の一つも言わねえで……っ、どうしてそんなに頑張っちまうんだよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……俺は毎日考えてんだ。お前がこんなつらい道を選んだのは……あの時、俺たちが「お前にならこの場所を照らせるはずだ」なんて言ったせいなんじゃないかって……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "全部俺のせいだ……！　そんなに急いで仕事してんのも、すぐ戻んないといけないからなんだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "お前を帰しちまったら、次会えるのは何年も先なんじゃないか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "……そんなことありませんよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "僕が文句を言わないのは、つらいのを隠してるからじゃなくて、本当につらいと思ってないからです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "だから、泣かないで。……ちょっと見てほしいものがあるんです。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "この電気……供給しているのは、エンジニア部のみんなと作った防災用の電力システムです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "これなら、照明はこんなふうに前より明るくなりますし、供給が安定しているので、雨の日も風の日も問題なく使えます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "以前は、山でテントをひとつ照らすだけでも発電機が必要でした。でも、今ではこの建物どころか、山全体を照らし続けることができるようにまでなりました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "これが僕の学んでいる技術であり、僕がやっている仕事なんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "確かに、フェルナンドさんの言う通り……僕の選んだ道は、身体のことを思うなら良くはないかもしれません。残された時間も、多くはないだろうと思います。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "でも、それと引き替えに得た物だってあるんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "今の僕は、スラム街で電球をいくつかつけたり家を何軒か照らしたりするだけじゃなく、もっとたくさんの場所を照らせるようになりました。しかもこれはこの先十年、何十年と役立つものなんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "僕は……僕にできることがあるのなら、その力を磨いていきたいと思うんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "もし、あの頃……僕の家に明るい光が届いていたなら、きっと僕は今とは違う人生を送っていたでしょう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "それでも、今の僕になら、昔の僕みたいな人たちを照らして、同じような道を辿らずに済むようにしてあげられるはずです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "それに、フェルナンドさんのお友達みたいな目に遭う人が出ないようにすることもできると思ってます。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "（やっぱりケンカになっちゃった……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "（僕が仲裁しようとしてもダメだろうな。フェルナンドさんが考えを変えることはないだろうし……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "（ケンカを止めるには、僕の実力を証明して、フェルナンドさんを安心させるしかない。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "（となれば、このコードを――ごめんね、すぐ直してあげるから……ここに一旦間違った値を入力して……）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "……グレイの言いたいことはわかるわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "だけど、医者として……それに、昔あなたに嘘をついてしまった人としても、聞いておきたいことがあるの。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "あの時私が嘘をついたことには、もう気付いているでしょう？　私もあれがあなたを守る方便だったなんて言う気はないわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "大人のくせに深く考えもせずあんなことを言って、他の二人まで巻き込んで……あなたの将来にも多かれ少なかれ影響を与えてしまった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "だから、もう一度聞いておきたいの。――あの時、私たちが嘘をついていると知っていたら……それでもあなたは、私たちのために、必要ないかもしれない光をともしてくれたのかしら？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "はい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "本当にそれが役に立つかなんて、わからなくても？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "それでもそうします。これからもずっと。……僕は暗闇が嫌いなんです。だから、誰も暗闇の中で怯えずに済むようにしたいんです。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "本当にそれが役に立つかなんて、わからなくても。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "……そう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "医療オペレーター",
          "text": "それがあなたの夢なら。それがあなたの人生なら。……もちろん、私たちは応援するわ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "事務所オペレーターA",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "ドクター、おはようございます。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "おはよう。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "論文も装置も準備が整いました。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グレイ",
          "text": "本日はお付き合いのほど、よろしくお願いします。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
