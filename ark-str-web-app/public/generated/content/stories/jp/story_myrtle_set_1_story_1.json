{
  "server": "jp",
  "storyId": "story_myrtle_set_1_story_1",
  "groupId": "story_myrtle_set_1",
  "stageId": null,
  "title": "任務報告書作成指南",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_myrtle_1_1.txt",
  "sourceHash": "47aab7eeb0600ccbea4b5850dbe902e3f907647d2af4b10fa3bdfd1a38ff6d79",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "スーザン、おいスーザン！　聞こえてるか！？　相手は情報にない重火器を持ってやがる。火力支援を頼む！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "スーザン、応答しろ──クソッ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンの隊長",
      "text": "こんなところまで追うべきじゃなかったんだ。まさかあんな武器で反撃してくるなんて……だからやり合うとロクな目に遭わないって言ったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンの隊長",
      "text": "い、今から逃げればまだ間に合うんじゃないか？　積み荷なんてもういらねぇ！　は……早く逃げよう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "伏せろ！　バカ野郎！　物陰から飛び出すな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "今さら慌てたってしょうがねえだろ。みんな落ち着け、俺が策を考えるから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "みんな、無闇に動かずにあたしのそばにいて！　あたしがみんなを支援するから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "諦めちゃダメだよ！　せっかくここまで来たんだし、積み荷を取り返すところまで頑張ろうよ。そしたらお給料とおいしいご飯が待ってるんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャラバンの隊長",
      "text": "ご、ご飯なんて言ってる場合か！　命すら危うい状況なんだぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "「一歩下がれば、一歩失敗に近づく」ってママが言ってたよ！　向こうだって人手が多いわけじゃないし、みんなで頑張ればきっとコテンパンにできるって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ほらほら、あたしがみんなのことを鼓舞してあげるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "今はそれどころじゃないだろ！　奴らの補給拠点はきっとあそこにある。向こうの射程は……ちょっと場所を変えればいけるかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……何だ？　奴らの攻撃が落ちついてきたぞ！？　チャンスだ！　テンニンカ、今すぐに彼らを連れて……おいテンニンカ？　どこ行きやがった！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "な……お前何して……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "強盗のリーダー",
      "text": "何やってんだ？　どうして急に攻撃を止めた！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "荒野の強盗",
      "text": "ボス、あそこを見てください。あれは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "スーザン、もうお腹いっぱい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "うん、もう満足かな。もう食べきれないよ……このもも肉のソテーも食べちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "それじゃ遠慮なく！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "ちょっと、そんなかっこむと喉に詰まっちゃうよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "テンニンカ、こないだの任務がうまいこといったおかげで、上が追加で五日も休暇をくれたんだぜ。今後しばらくは毎日たらふく食えるんだから、そんなにがっつかなくていいだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "つまり一日たりとも無駄にはできないってことでしょ……あっ、そうだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "任務と言えば、今朝テーブルの上でこんなのを見つけたよ。えーっと……「任務報告書（外勤オペレーター）」って書いてあるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "二人とも、これが何だか知ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "それを知らないってことは、もしかして任務報告書は未提出？　初めての任務なのに誰も教えてくれなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "任務報告書……うーん、どこかで見た気もするけど、どこに書くか分からなかったから、ほったらかしにしちゃってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "それで、この紙に書いて出すだけでいいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "うん、そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ラクショーだね！　今から書いてみる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "ほら、ティッシュ。手の油拭いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "ホーガー、食器を片付けちゃおう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "スーザン！　できたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "えっ、もう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "こんなの余裕だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "どれどれ……報告……任務完了。たったこれだけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "「報告──任務は順調に終わりました。」これで大丈夫でしょ！　どこか変なところある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……テンニンカ、さては任務報告がどういうものか知らないな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "そのくらい知ってるよ。実家のミード酒のお店で店番してた時は、品物が整理できたらリストに「整理済み」って書く決まりだったんだ。任務報告だってそんな感じでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "毎回いちいち文字を書くのはメンドーだったけど、あたしったら、確認が終わったらリストの品目の横にチェックマークを付ければいいって閃いたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "そしたらすっごく楽になったんだ！　あたしってすごいでしょ？　えへへっ",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……やっぱり俺が説明してやるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "任務報告書には、自分が作戦中に何をしたか、その時どんなことを考えていたかを詳しく書かなきゃいけねえんだ。そうじゃなきゃ、そいつはただの紙切れさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "そんで書き終えたら、人事部だけじゃなく、お前の上司にも提出しなきゃならない。俺たちオペレーターにとっちゃかなり重要なもんだから、真面目に書かなきゃダメだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ええっ！　そんなメンドーなの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "わかったよ……じゃあ空いてるところになんか書いてみるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "コードネームは、テンニンカ……戦闘経験は、うーん……五歳の時に街一番のムカつく酔っ払いをこらしめた時から数えると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "そんなことは書かなくていい……お前の端末にテンプレートを送っといたから、そいつを参考に上から空欄を埋めてみな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ありがと！　助かるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "ちょっと待って。ホーガー……今回の任務報告の提出期限って、昨日までじゃなかったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "そうだっけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……いや、そうだったな。俺も締め切りギリギリに大慌てで提出したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "スーザン、上のところは埋まったからちょっと見て──ってどういうこと！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "つまり……もう間に合わないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "うーん……業務フロー的には、まだ人事部で報告書を整理してる途中だとは思うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "初めての任務でこんな大ポカなんて……もしかしてあたし、試用期間中にクビになっちゃう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "テンニンカ、ひとまず落ち着こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "何か方法はないの？　今からこっそり人事部に忍び込んでどうにかできない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "忍び込むってそんな……あっ――ホーガー、人事部に知り合いがたくさんいるんだったよね。書類の整理にどれくらいかかるか聞いたことない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "だいたい二、三日ってことだな。多分今もまだ作業中……って、まさか本気で──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "作業が終わる前に紛れ込ませておけばきっとバレないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "でも、本当に忍び込んで大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "そんなの規則違反だろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "そうだ、思い出した！　入職マニュアルには、必ず任務報告書を提出するようにって書いてあったけど、いつどうやって提出しろとは書いてなかったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "もう少し早く入職マニュアルのことを思い出してれば、こんなことにはなってないんだけどな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ふぅ──なんか急に安心してきちゃった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "いやいや、安心するのはまだ早いって。最速で書き終えて、書類整理が終わるまでに紛れ込ませないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "だから……これ以上変なことを書いて時間を無駄にしないように、私たち一緒に任務を振り返ってあげるから、思いついたことを書いていくように。わかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "急に真剣な顔しちゃって……わ、わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "まずは任務に加わったところから。まだ覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "もちろん！　あたしたち、任務内容に従ってあのおじさんのキャラバンと一緒に荒野に入ってったんだよね！　任務の内容は、キャラバンを目的地まで護送すること。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "そうだね、じゃあそのまま書いて。それから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "それから……あの日は日差しがすっごい強くて、空気もカラッカラに乾いてた。地上にはこんな場所があるんだってビックリして、次に来る時は日焼け止めを塗らないとって──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "そういう任務と関係のないことは書かなくていいから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "じゃあもういっそこうしよう。俺が振り返ってやるから、それをそのまま書いてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "ごほん――護衛任務が始まると、私はキャラバンに着いて荒野を進んだ。任務前半は、獣の襲撃以外に特に異常はなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ふむふむ……書けたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "よし、続けるぞ。午後4時04分……分の前に0を書くのを忘れるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "我々は荒野で待ち伏せしていた盗賊に遭遇した。私は戦闘の支援、及びキャラバンの護衛を任された。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "戦闘中、私は敵の攻撃を分析した後、タイミングを見計って積み荷を降ろすことで、一旦敵を引かせることに成功した……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "書けたか？　ちょっと見せてみろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "はい、読んでみて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "「それから、逃げようとしたら敵が帰ってった」……って俺が言ったことと全然違うじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "でも、あの状況を一言で言うとそんな感じだったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "そうなのか？　しかし俺が見た感じだと──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "だって、あたしの仕事はおじさんたちを守ることだったからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ホーガーたちが向こうでドンパチやってる時、別の方角から大勢の人が突っ込んでくるのが見えたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "大将軍として、「敵が進めば後退すべし」って心得はあるからね。それでおじさんたちを急いで車に乗せて、一刻も早くそこを離れようとしたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "でも、確かにその後積み荷を降ろしただろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "だって荷物を捨てた方が速く逃げれるでしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……つまり、積み荷を引き渡して敵を引かせたのかと思ってたが、たまたまそうなっただけってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "スーザン、こいつの言うとおりに書かせていいもんかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "それは構わないと思うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "テンニンカ、偶然がああいう結果を生み出した理由について，きちんと振り返った方がいいよ。それもまた任務報告の一環だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "えっ？　特に考えてなかったことまで書かなきゃいけないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "任務報告書を書く目的は、自分たちの作戦遂行方針をみんなに共有したり、指揮官が今後の作戦を立てるときの参考にしてもらうためだけじゃなくて、自分の行動を振り返るためでもあるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "普通ああいう状況に出くわしたら、リスクを十分に考慮した上で解決策を立てて、それから実行に移すものだよ。任務報告書はその時の狙いとか考えを書くためにあるんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "もし仮に何の考えもなかったんなら、報告書を書く時に改めて整理してみればいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "おー、なるほどね。報告書には一つひとつの行動に伴う考えを書かなきゃいけないけど、もし何も考えてなかったんなら、報告書を書く時に改めて考えて、それを書くってことだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "そういうこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "えへへ、わかった。じゃあ後は自分で書いてみてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "いいんじゃないか。書き終わったらまた見せてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "待って、ホーガー。その前に一つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "積み荷を取り返すために強盗たちをアジトまで追いかけて行った時のことだけど……あの時はお互い別行動をしてて、私は二人から離れたところにいた――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "私は火力支援を行うために高所に狙撃用クロスボウを設置して待機してたけど、二人は正面から強盗とやり合ってたはずだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "あの時の行動には私も少し不明点があるから、もう一度全体を整理しておこう。テンニンカが……奇抜な発想をしないためにもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "あっ！　その時のことならちゃんと覚えてるよ！　あの人たちのアジトの入口でやり合いになったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "元々はみんなを連れて突撃しようと思ってたんだけど、あんな戦場を見るのは初めてだったから……結局みんなには物陰に隠れてもらうことしかできなかったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "それでも大手柄だったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "あとあと、途中まではあたしたちが優勢だったんだけど、敵の人たちがこーんなおっきいやつを持ち出してきて、「ドカーン！」って音が鳴ったと思ったら、車が吹き飛んじゃったの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "もしホーガーがあたしを物陰まで引っ張ってくれなかったら、みんなお空まで吹き飛ばされちゃってたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "ああ。確かに奴らがあんな兵器を持ってるって情報はなかった。おそらく最近どこかで奪ってきたばかりの物なんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "大まかな状況はインカムで聞こえてたけど、あの時は辺りが煙で覆われてたし、こっちは位置調整とか距離の計算に手間取ってて、何が起きたかまではわからなかったんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "それでずっと不思議だったんだけど……二人はどうやってあんな集中砲火を浴びながら敵陣に突っ込んで、全員を片付けたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "ホーガー、あの時一体何をやったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "いや、俺じゃなくてテンニンカが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ホーガーだよ！　あの時はホーガーが大活躍だったんだ！　ホントにすごかったんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "……どういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "嘘じゃないよ、あたしこの目で見たんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ホーガーが大声で叫びながら飛び出して、一人で突っ込んでったんだよ！　その後すぐ、それを見たみんなもホーガーに続いて突撃したんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "強盗たちはアーツにかかったみたいに、ぼーっとその場に立ち尽くしちゃってさ。きっとビックリしすぎて動けなくなっちゃったんだよ。あははっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "それからホーガーが、思いっきりガンッ！　って、パンチ一発で相手を倒しちゃったの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "あれ、急に黙っちゃってどうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "とにかく、全部はっきり覚えてるんだから！　じゃあ今話した感じで書いちゃうからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "ホーガー……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "テンニンカ、あの時自分が何をしたか覚えてないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "あたし？　あたしはホーガーに言われた通りに、その場にいたみんなの安全を確保してから、できる限りの支援をして、最後に──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "大将軍の務めとして、みんなのことを鼓舞してあげたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "地上での任務は初めてだったけど、あたしはこれが一番の得意技だからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "そ、それだけか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "そうだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……そうじゃないだろ。テンニンカ、俺たちが勝てたのは全部お前のおかげだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ホーガー、からかわないでよー。やってもないことをやったって言うのはダメってママも言ってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……スーザン、あの時起こったことを俺の視点でまとめるとこういう感じだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "テンニンカがいきなりキャラバンのみんなの前に飛び出して、弾よけに使ってたオフロード車に飛び乗ったのさ。それから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……あの白い旗を掲げて、高々と振り回したんだ。きっとあの場の全員がその様子をはっきりと目にしたはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "俺もかなり驚かされちまったけど、テンニンカを引きずり下ろそうとした矢先にふと気づいたんだ……俺たちだけじゃなく、向こうも呆気にとられてるってな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "そんで俺は、奴らの攻撃の手が緩んだ隙に突っ込んでいった。後のことはテンニンカの言った通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "あっ！　あたしが旗を振ってたって話？　あははっ、当たり前のことすぎて忘れちゃってたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "あんなの別になんでもないでしょ。みんなの士気を鼓舞することが大将軍の務めだからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "故郷にいた頃も、旗を振るとすっごい効果があったんだ！　みんなあたしが旗を振ってるのを見るだけで、モリモリ元気が湧いてくるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "そ、そんな理由で旗を振ってたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "そうだよ。まずはみんな一致団結しないと何もできないからね。あんなふうにみんなで一緒に頑張れば、何事もうまくいくんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "なるほどな。「白旗を振る」なんて奇策を一体どうやって思いついたのか不思議だったが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "でも二人の話を聞く限り、また予想外の結果を生んじゃったみたいだね。よーし、どう書けばいいかわかってきた気がする……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "どう書くつもり……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "もちろん、あたし自身の振り返りと反省だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "「あたしは時々、自分でも予期してなかったような結果を生み出すことがあるけど、仲間たちはきちんとチャンスをものにして、敵を倒すことができた。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "「だからあたしは自分の後ろに立つ人たちを信じて、全力でみんなのことを応援しなくちゃいけない……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "どう？　これなら問題ないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "テンニンカ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "ホーガー、テンニンカの書いた内容が間違ってるとは言わないけど……やっぱりちょっと心配だよ。この先も自由に書かせてたら、要点がどんどんズレていっちゃうかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "……まぁとりあえず書かせてみようぜ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ふぅ、手が疲れちゃった……これで書き終わったよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "うん。提出できる状態にはなったと思うけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "書くのは大変だったけど、みんなの仕事がどんな感じなのか何となく分かった気がする。すっごくタメになったよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "本当に分かってるのかな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "安心してよ！　それじゃあ次は……いよいよ一番手に汗握るパートだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "……ホーガー、様子は見てきた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "ああ、人事部の人たちは全員会議中だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "事務室の様子は大体把握してるから、こっそり提出するくらいなら大丈夫だと思う。唯一の懸念点は、途中で誰か戻ってくるかもってことだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "じゃあこうしよう。テンニンカは先に報告書を持って人事部の入口で待機してて。私たちが会議室の様子を見てきてあげるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "絶対に人事部の人に報告書を持ってるのを見られないようにね！　見つかったら作戦失敗だよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "大丈夫だよ、あたしに任せといて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "よし、じゃあ始めよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三十分後"
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "テンニンカが……まだ来てない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "もう中へ入っちまったんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "それはないと思う。報告書をどうやって紛れ込ませるかまでは伝えてないし……そこまで一人で解決しちゃうとも思えない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "シッ──静かに、人事部の人が戻ってきたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "スーザン、あれを見ろ。あいつが手に持ってるのは──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "テンニンカの報告書だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "やあスーザン！　そんなところで何やってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "あ、あの……ちょっと訊きたいんだけど、それってテンニンカの報告書だよね。どこで手に入れたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "えっ……どうしてそんなことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "それは……そうだ、ほら、こないだ私もテンニンカと一緒の任務に参加したでしょ。任務報告書はとっくに提出したはずだから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "そうやってわざわざテンニンカの報告書を持ち出してるのを見て、ええと……そうだ、何かミスでもあったのかなって心配でさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "いやいや、何も問題はないよ。実は僕も少し妙だとは思ってるんだけど、この報告書はさっきドクターから渡された物なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "ドクターから！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "それに、「これからは、新人たちの任務報告書の提出期限を少し延ばしてやってほしい」だなんて言われちゃってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "でも提出期限はまだ過ぎてないはずなんだけどな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "過ぎてない？　じゃあ私たちは何のために──あっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "邪魔してごめんなさい──ホーガー、早くあの子を捜そう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "わっ！　あたしはここだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "そんな慌てて、二人ともどこ行くつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "そっちこそどこに行ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "今ドクターの執務室から戻ってきたとこなんだ……待たせちゃってごめんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "なんでドクターのところへ？　それに何でドクターが報告書を持ってたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "今ちょうどその話をしようと思ってたんだ！　ここへ来る途中で、ドクターとばったり会っちゃってね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ここでの生活には慣れたかって訊かれたから、思わず報告書のことをドクターに話したの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "ドクターは人事部の人じゃないから、言ってもいいかなと思って……大丈夫だよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "そしたらドクターが報告書を受け取るって言うんだ。ドクターはあたしの上司だし、どのみち最後にはドクターのもとに届けられるんだから、いいかなーと思ってそのまま渡したの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "報告書の件はうまく片付いたんだけど、二人がここで待ってるのを思い出して……ずっと待たせちゃって悪いなと思ったから、お詫びに何かしたくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "……それでドクターに執務室まで連れてってもらって、すっごくおいしいキャンディーを貰ってきたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テンニンカ",
      "text": "これを食べたら、あたしのこと許してくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "はぁ……じゃあ一つもらうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一ヶ月後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "今回二人にわざわざ足を運んでもらったのは、テンニンカの任務中の状況を確認しておきたかったからなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "ああ、と言っても何か問題があるわけじゃないから、心配しないでほしい。最近君たちがテンニンカと一緒に出た任務はどれもスムーズに片付いてるし、念のための再確認みたいなものさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "その……気になる事があるなら単刀直入に言ってよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "……分かった。実は二人が提出した任務報告書とテンニンカが提出した任務報告書の内容に……かなり食い違いがあってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "正直に言わせてもらえば、まるで別の任務の報告書みたいなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "……あの子、書き方はもう分かったって言ってなかったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "簡単に信用しちまった俺たちの落ち度だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "それと……前回の任務終了後、彼女は報告書と一緒に手書きの冊子も提出してきた……これだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "テンニンカ……カッコ大将軍……の戦術大全？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "どうやら彼女は、自分の作戦時の考えを仲間たちも把握しておくべきと考えたらしい。そこでこの冊子を作って、皆が読めるようにと人事部に預けたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "それで、彼女と親しい君たちに聞きたいんだけど、これらのことを踏まえた上で、彼女に対して……何か疑問や懸念はないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "……ホーガー、どう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "ないわけないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "でもそれ自体は特に問題ないんじゃないかな。テンニンカはいつも物事を簡単に片付けちまうし、そういう才能があるのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "私に言わせれば、あの子を理解したかったら、こんな冊子を読むよりも、一緒に敵陣に突っ込む方がずっと簡単だよ。テンニンカは言うまでもなく信頼に値する優秀なオペレーターだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "人事部オペレーター",
      "text": "分かった。そういうことならもう問題ないよ。わざわざ来てもらって済まなかったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "（小声）ホーガー、さっきの回答でいいよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホーガー",
      "text": "（小声）まぁ、多分な……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スーザン",
      "text": "えっと……それで悪いんだけど……そのテンニンカの「戦術大全」を借りてもいいかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
