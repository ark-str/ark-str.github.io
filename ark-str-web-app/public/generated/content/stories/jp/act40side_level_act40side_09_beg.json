{
  "server": "jp",
  "storyId": "act40side_level_act40side_09_beg",
  "groupId": "act40side",
  "stageId": "act40side_09",
  "title": "長寿麺",
  "storyCode": "OR-9",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act40side/level_act40side_09_beg.txt",
  "sourceHash": "25a218574dee922b45206257ea55fc6a7d57a67ac90591ea905094bef19b6f22",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "男は官服を脱いで丁寧に畳む。携えていた書籍と共に置くと、東に向かって繰り返し叩頭した。\nそして野営地を出た。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "どうやらお前の火が以前よりも燃え滾っているようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "感染者、お前のアーツは消耗が激しいものだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "熱いのが怖くなってきた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "ふっ、これはたった一人分の血だよ。私が今ここに立てているのは本当にたくさんの人が血を流したからだってよく分かってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "どうやら、多くのことを知ったらしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "多くはないよ。でも一つのことだけ、知っておけば十分だ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "名前をなかったものにされた人たち、そして訳も分からず死んだ人たちのことは……うやむやのままに終わりにしてはいけない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "正直、自分の出自にこんな複雑な事情があるとは思ってなかった。それに、感染者のために戦うこと以外にも使命があるなんて今まで想像したこともなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "でも、よくよく考えた結果分かったんだ。理屈は変わらないって。私の血は、曲がったことをこの目で見たとき、声を上げて立ち上がるために流れてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "血でもって火を起こすか……感染者、お前は古代の義士の気風をいくらか持ち合わせている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "だが、今のお前は細かいことに気を取られて本質が見えていない。軽々しく公正を語らないことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "いずれにせよ、お前を連れ戻せという命を受けている。今回は断じて逃さない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "分かってるよ。君みたいな人は見たことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "君たちのことを、頭ごなしに悪人だって決めつけるのは違うかもしれない。だって、血も涙もない兵士になるように鍛え上げられただけだから。鍛えられた通りに振舞ってるだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "でも別にいいよ、御託を並べるつもりはない――私を止めてみたらいいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "逆賊ではあるが……その勇気は称賛に値する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "気を付けることだ。命は残してやるが五体満足までは保証しない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "縦貫白雷正法、破っ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ホァン",
      "text": "レイズ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "言いたいことがたくさんあるのは分かっています。ですが、目下の急務はただ一つ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "真龍に拝謁しに行くのでしょう。助太刀します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "リン・チンイェン？　お前は牢獄にいるはずだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "私は今、あなたの目の前にいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "一度私に負けた分際が生意気な口を利く。二人とも、逃げられるとは思うなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "心配は無用です。そもそもあなたに一人で挑む気はありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シエ・ジェン",
      "text": "駆けつけるよう提案したのは私ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シエ・ジェン",
      "text": "相手にするのがこの方では……分は良くないですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "まだ仲間がいたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "こいつを牢獄から連れ出したのはお前だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シエ・ジェン",
      "text": "少し荒っぽい手段ですが、罪なき者に危害が及ぶのは避けられました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シエ・ジェン",
      "text": "債多ければ、却って愁うことなし。私には逃れられない罪が多くありますからね。今更一つ増えようが大差ありません。これが終われば、自首して法に従いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シエ・ジェン",
      "text": "しかし今この時に成さねばならぬことがあり、会わねばならない相手がいます。そこで答えを得ねばならないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "粛政院御史と大理寺少卿が共謀して朝廷に盾突こうとは……これほどまでバカげた光景は見たことがない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ふむ。すでに考えるまでもなくバカげているのであれば、一人増えたところでよかろう。我も数にいれてもらおうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "久しいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "タイホー！？　玉門で重傷を負ったのではないのか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "左様……傷が少々深かった。この身の武芸は、元の三割にも満たぬやもしれぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "ゆえに今日は、可能な限り、やり合うのを避けたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "なぜお前まで関わろうとする……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "リン少卿の訪れは突然であり、我はいまだ全容を理解しておらぬ。されど両名は我が最も尊敬する同僚である。旧友の誼から、和議の余地を残すよう説得することしかできぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "このような大逆無道な行いに及ぼうとしながら、私が見て見ぬふりをするのを望んでいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タイホー",
      "text": "「忠を取り義を棄てる」と言うが、この両者のうち一つしか選べぬと誰が言った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "正義……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リン・チンイェン",
      "text": "長居せずに、早く行きなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "させん――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "これは、禁城の撤退合図……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「禁軍の若き教官」",
      "text": "陛下……まさか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "ここから禁城が見えるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "前回この城楼に立った時には、まだ春であった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……この半年で、多くのことが起きた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "寒くなってきましたし、城壁の上は風が強いです。太傅、お体にお気をつけください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "朝廷の諸公に、この角度から百灶を見た者はいくらもおらぬだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "高所に登り遠くを望めば、時に浮雲が視界を遮る。常に曇りなき視界であるとは限らん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……事を行う際には、進退を考えるべきと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "わしが当時お主を玉門参知に任じた意図は理解しているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "私見では、太傅は私に視野を広げ、大局観を培うことを望んでおられたのだと理解しております。あれは私に与えられた機会であり、試練でもあると認識しております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "何に対する試練だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……重任に堪え得るかどうかのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "では、今日お主を呼んだ意図はなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "太傅が私に失望なされたからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "それはもっともらしい言い逃れか、それとも真実そう考えているのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "先の百珍宴での行いが、甚だしい下策であることは承知しております。しかし他に方法がありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……太尉が既成事実を作ってから真龍に決断を迫る機会を与えぬために、先手を打って百珍宴を中止へと追い込みました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "お主はこの争いに巻き込まれて以来、三度選択を迫られた。そのいずれにおいても、最も危険な手を指している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "友人は言うに及ばす、自分の身すらも、お主はこの盤上に置いているが……躊躇ったことはないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "私情が皆無であるとは言えません……ですが、考慮に考慮を重ね、大局を第一に動きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……謀を巡らせることはできたと言える。だが最善を選び取ったとは言えん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "わしは元々、理想を抱くも私欲なく、優れた手腕を持ちながら私心のない若き人材を選び、経験を積む機会を与えたいと思っていたのだ。育ったあかつきには、大事を託したいとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "本来であれば、お主は適任だと思っていたが……打ち手が自身を碁石とするようであれば、およそ良い終局図は期待できぬ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "お主を見ていると、ある同僚を思い出す……今は亡き者を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "お恥ずかしい限りです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……リャン・シュンよ。今一度選択の機会を与えられたとしたら、お主は此度もまた尚蜀を去るか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "学問に励み始めた時、この生涯で学び得たことを天下の人々のために用いると志を立てました。どんな地位に身を置くかは、境遇次第にすぎません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "私の抱いた初心はこれまで変わったことはありません。下した選択に後悔もいたしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "ふむ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "百珍宴での出来事には、皆を納得させるに足る落しどころが必要である。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "このリャン・シュン、喜んで法に従いましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "天鏡閣の蔵書楼で謄録郎の席に欠員がある。明日より、お主はそこで勤めるがよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……大傅の寛大なるご配慮に感謝いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……遂に来るか。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "分厚く層をなした雲が、満月の清らかな光を遮った。"
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "太傅は、かの者に会ったことが……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "一度もない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "この一局で、彼が求めている対局相手は一体誰なのでしょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "時に盤上で求められるのは相手との勝ち負けではなく、解法であることもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……無数に存在する変化の中で、双方が受け入れられる両全の解を追求するのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "太傅にご教示いただきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リャン・シュン",
      "text": "太傅は何故、当時あのような大いなる試験を設けようと思われたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "店主、まだやっているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "えらくちょうどいい時に来たね。あんたの注文が終わったら閉めるところだ。でも、もう遅いから、店に残ってるものは少ないよ。ご注文は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "適当に見繕ってくれ。道すがら腹を満たせれば何でもよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "じゃあこれ。肉まんが蒸篭に半分残ってるんだ。朝作ったやつだしお代はいらないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "このような商売をしては、赤字ではないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "そうだよ。私はもとから料理しかできないからね。商売の方はあんまりなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "これだけの腕を持っているというのに、名利を得たいとは思わんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "何の意味があるの？　王侯貴族も物売りや使い走りも、みんな一日三食食べなきゃいけないのは同じでしょ。名利なんか求めてあくせくするより、肉まんを蒸してた方が面白いね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "もう一つ聞かせてくれ。普段庶民がここで食事をすれば一食いくらいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "なぁに、高くないよ。よく出るおかず二つにスープをつけて小銭数枚でこと足りる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "百灶で仕事してる人なら、この店にきたらお腹いっぱい食べられるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "店主は、世を救う仁愛の心を持ち合わせているようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "いやいや、そんな大層なものじゃないよ……私はただの料理人で、毎日もてなせるお客さんなんて、せいぜい百人くらいだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "世の人の衣食の憂いをなくすには、あんたにもっと気張ってもらうしかないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "肉まんを馳走になって、教訓まで聞けるとは……儲けものだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "はは、普段からお客さんとおしゃべりするのが好きなもんでね。とりとめのないことや根拠のないことをぺらぺらと言うから、あんたが怒らなきゃいいんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "時に、この店は随分と長く経営していると記憶しているが、上がりの方はどうなのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "はぁ……頭が痛い話だね。ご覧よ、この小さな店じゃ、一年くらいかけて出てくのと入ってくるのの帳尻を合わせるのが精一杯だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "大荒城で不作が起きたり、馳道が塞がって輸送が遅れたりしたら店の運営費用が高くなって、ここの人も、今の値段じゃご飯が食べられなくなるだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの老人",
      "text": "それは、他の数名の代理として功に評価を求めているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "はは……清算がまだ済んでいないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "ここに食べに来るのは、みんな隣近所の人たちさ。ツケで払う人もいるし、支払いの代わりに大きな箱に入った新鮮な果物をいくつも譲ってくれたり、店の家具の修理を引き受けてくれたりもする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "彼らが世話してくれなかったら、この店はやっていけないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "だから、そうしたツケはほんとに清算がしにくいんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "商売ってそういうものでしょ、食うか食われるかの勝負だなんて誰が言ったの？　関係を築いて、和をもって財を生ず。そうやって商売は長く続くものなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "小さな料理長",
      "text": "太傅様、持ち帰り用の肉まんを詰め終わったよ。先に一つ食べてくかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……味は確かに上等だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "だが、あの商売人の話し方を真似せんでよい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "太傅様、食事は買い終わりましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "うむ、この店の肉まんは百灶随一だと聞いた。お主も食してみるがよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "あむ……わあ……美味いなぁ。ほんとに美味しいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "御者",
      "text": "さて、腹も膨れて元気が出てきました。どちらへ向かいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "太傅",
      "text": "……尚蜀へ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
