{
  "server": "jp",
  "storyId": "story_ayer_set_1_story_1",
  "groupId": "story_ayer_set_1",
  "stageId": null,
  "title": "黄砂の追跡",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_ayer_1_1.txt",
  "sourceHash": "1b783a53843ddb7fc209317deef05c1c44eb87dce419a86bfd7158e241e35dbc",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "見知らぬ女性",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見知らぬ女性",
      "text": "こっち……いや、あっちかしら？　なんて言ってたっけ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見知らぬ女性",
      "text": "やっぱりこっちだと思うわ。あっちは汚染エリアだったはず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "見知らぬ女性",
      "text": "念のためにもう一度確認させて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "見知らぬ女性",
      "text": "あっ、ちょっと待ってよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "見知らぬ女性",
      "text": "あら、こっちの方向で合っているみたい。あなた、運がいいのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "さっき言っただろ。今はまだアンタの出る幕はないが、これから先アンタが役立つ場面は自ずと来ると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "だけど今、天災トランスポーターとしてのアンタの能力に疑問を抱き始めている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "失礼ね。これだから素人は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "天災トランスポーターは責任重大なのよ。天災の動向を正確に判断できるかどうかで、多くの命が左右されるんだから、慎重になるに越したことはないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "そんなに楽な仕事なら、天災トランスポーターがこんなに少ないわけないでしょう？　あたしに会えただけでもすごくラッキーなことよ。どうせ今まで天災トランスポーターに会ったことない癖に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……よく喋るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "いい加減認めなよ、エアースカーペさん。天災が通過したあとの現場に踏み込むのなら、あたしの助けは絶対に必要だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "認めるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "そろそろ先を急いでもいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "そのキューウェルに天災エリアの奥に連れ去られちゃった人って、エアースカーペさんとどんな関係なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "（息を吸う）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "断るのは言い分を聞いてからにして！　あたしがキューウェルを探してるのは奴らと因縁があるからって言ったわよね？　もしそっちの探し人がキューウェル側の人間だったらまずいでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "だってあなた、キューウェル鉱業の手先を全部一人でやっつけちゃうし、電気椅子に笑いながら座るし、あたしじゃ絶対に敵わないもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "一緒に行動するなら、その仲間の正体を把握しておきたいって思うのは当然でしょ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……あいつは俺の雇い主だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "雇い主？　その人の護衛ってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "俺たちはキューウェル鉱業の競合企業に雇われていた。コーンドリルカンパニー――アンタも名前くらいは聞いたことあるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ええ、今回の天災のあと、調査のために真っ先に天災エリアに採掘隊を派遣した鉱業会社でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "その発掘隊が南東から驚異的な速度で突入すると、あっという間に鉱区を発見したおかげで、コーンドリルカンパニーがその所有権を得られたって聞いたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ああ、それが俺たちを雇った会社だ。その時に発見したのは鉱脈のほんの一部だけで、調査の結果、元々中央広場があった場所に天災で露わになった鉱脈がまだ大量にあることが分かったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "だからコーンドリルは、北部からもう一度天災エリアに突入し二度目の調査を行おうと、被災地のすぐ隣に臨時の野営地を設立した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "だが昨日の明け方、町で枝豆を買って戻ると、野営地は誰かによって荒らされ、隊員も全員いなくなっていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "俺は雇い主が付けている発信器の信号を辿り、アンタのいた野営地を見つけた。だけど潜入したもののあいつは既にそこにはいなく、発信器だけが残されていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "あとのことはアンタも知っての通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "責任感が強いのはいいことだけど、今回はキューウェルが直々に部隊を率いてる。奴の性格からして、道中で多くの人が処分されちゃうはずよ。あなたの雇い主が生き残っている確率は低いわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "よく考えてみて？　どうせここはレム・ビリトンなのよ。こんな状況で面倒事に首を突っ込むような真似は無駄でしかないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "契約に基づいて、雇い主の死亡を確認するまで俺の護衛任務は終わらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "もらった報酬分だけ働く、当然のことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "だったら好きにすれば？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "この先にまだ汚染エリアがあるかもしれない。もう一度確認するわね……あっ、ちょっと待ってってば！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ふぅ……まったく歩くの速すぎよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "文句を言うな。そうやってブツブツ言っているところ、まるでレ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "レ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……なんでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "エアースカーペさん、あなた他にも何か隠しているでしょう。すごく怪しいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "アンタに隠していることはたくさんある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "それはそうだけどさ……じゃあ、今から単刀直入に聞かせてもらうわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "エアースカーペさん！　あなた、雇い主と連絡が途絶えたのよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "だったらどうして正確な方向が分かるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "それに何度もあたしの判断を聞く前に勝手に行動してるのに、毎回あたしの割り出した方角と一致してる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "一体どうやってやったの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "そんなに知りたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "あなたまさか……本当はキューウェルの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ここを見ろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "えっ、何かある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "地面だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "源石粉塵、砂粒、灰……天災が過ぎ去ったあとは、どこもかしこもこんな感じよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "グレーの粒は灰じゃなくて砂だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "黄色い砂とは種類が異なる。それは石灰岩が風化してできた細かい砂で、通常は黄砂に少量混在している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "そんな専門知識、よく知っていたわね……でもそれがどうしたっていうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……本来ならば黄砂の中に混じって目立たないはずのそれが、今はまとまって表面に浮き出ている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "つまり、人為的な操作によるものってことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "確かに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "これは俺の雇い主が残した目印だよ。砂粒を種類ごとに分離させるのはあいつの特技だ。それに、この方法なら敵に勘付かれることもそうそうない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "今までずっとこの目印を頼りに進んでいたってことね……色々深読みしちゃって損した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ここと、あとそこにも灰色の砂が浮いてる……かなり細かく目印を残してくれているわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "とても賢いやり方だわ……あなたの雇い主はなかなかの切れ者ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "なんで舌打ち！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "あいつは金遣いの荒い……ウザイ奴だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "へぇ、仲良しなのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "その「仲良し」というのがぶん殴ってやりたいって意味なら、否定はしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ちょっと気になったんだけど、それほどの腕前を持っているのに、どうしてそんな……「ウザイ奴」の元で働いているの？　まさか何か弱みを握られてるとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "転職するのが面倒なだけだ。あいつは俺の最初の雇い主だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "でもその腕なら護衛以外の仕事もできるよね？　他にやりたいことはないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "さあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "じゃあ前は何をしていたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "前は……レオンハルトの元で働くまでは、故郷から出たことなんてなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "じゃあもし、もしもの話だからね？　あなたと雇い主がとても仲良しだとして、彼を見つけた時、すでに亡くなっていたのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "二人の契約はそこで終わるけど、あなたは……契約外の行動に出たりする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "しないな。そもそもやることなんてあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "そんなに腕が利くのなら、できることはたくさんあるじゃない。たとえば……仇を取るとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "そんなことは無意味だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "簡単な話さ。俺の雇い主を殺せるほどの実力者なら、俺一人でどうこうできる相手ではない。立ち向かったところで無駄死にするだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "そんな状況に出くわした時、護衛として最も理性的な行動はすぐさま立ち去ること。その時点で契約は打ち切られ、仕事は終了しているのだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "仮にそれが俺の不手際のせいであろうと、状況をさらに悪化させないためにも、必要以上に留まるべきではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "たとえついでに復讐してやりたいという気持ちがあったとしても、感情任せでいきなり突っ込んでいくような真似はしない。やるとしてもせめて策を練って機を伺う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "復讐に囚われるのは、馬鹿のすることだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "また無駄話に時間を費やしてしまった。ペースを上げるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "あそこ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "伏せろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "はやく防護マスクをつけて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "源石粉塵の拡散状況からして、余震によるものじゃないはずよ。これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……感染者の崩壊か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "だったら近くに相当数の感染者の遺体があるんだろう。だが……なぜなんだ？　まさかこのエリアを担当してる天災トランスポーターが、事前に避難勧告をしなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "いや、それはあり得ない。東側の状況を見る限り、今回の天災の予兆はずいぶん前から出ていたはずだ。勧告が間に合わないことは考えにくい。むしろ避難する時間は十分にあったはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "だったらなぜこんなことになったんだ？　ここを担当していたのは経験の浅い天災トランスポーターだったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "一つだけ可能性がある……分かるかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "天災トランスポーターはちゃんと即座に勧告を出した。だけどその情報は……誰かによって故意に遅らされたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "だから住民に伝わった頃にはもう、天災は間近に迫っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "天災の警報を遅らせることになんのメリットがある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ここはレム・ビリトンよ。鉱業会社にとって鉱区の所有権は何よりも大切なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "天災によって発掘可能な鉱脈がたくさん出現することは、レム・ビリトンの人ならみんな知っている。天災が収まると、多くの鉱業会社が我先にと採掘隊を派遣する光景もいつものことだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "鉱区の所有権は早い者勝ち。だから一部の人でなしにとって、避難勧告を遅らせることは先手を打つための大切な手段なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "狂ってやがる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "全てはキューウェルの計算通りにいってた。なのに準備していた自分よりも、あなたたちの採掘隊の方が早く鉱区に到達するなんて夢にも思わなかったはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "きっとそっちの部隊に優秀な天災トランスポーターがいたのね。とにかく、奴の計画は最後の最後で失敗したのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "競争に負けたら次は拉致か……どんどん手段を選ばなくなってきているわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "レオンハルト……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "さっきも言ったでしょ？　キューウェルの手に落ちたとなれば、無事でいられる可能性は高くないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "先を急ごう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "何もないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "周辺は全部探したか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "地面に顔がくっつくくらいの勢いで探したけど、新しい目印は見つけられなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……目印は確かにここで途絶えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "予想だと新たな鉱区は南の方にある。仮にあいつらの目標が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "考えたって無駄よ。コンパスはとっくに狂ってるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "捜索範囲を広げよう。さっき遠くで砂嵐が発生している兆しがあると言ってたな。それは後どれくらいでこっちに到達するんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "長くても二十分かしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "あっ、思い出した。さっきあっちの山の裏に洞窟らしきものが見えたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "人工的に掘られたものかどうかも分からないし、敵が待ち伏せている可能性もあるけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "案内してくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "真っ暗ね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "エアースカーペさん、奥から血の匂いがするわ。それとも私の気のせいかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "そのまま進め。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "……そんなに強いくせに私を先に行かせようっていうの？　せっかくここまで必死に汚染エリアや二次災害を避けながら案内してあげたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "アンタが勝手に俺に付いてきたんだろ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "分かったわよ――\nうわっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "退がれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "待ってくださいエアースカーペさん、俺です！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "アンタは……採掘隊の測量士の、クルーズか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "よかった、覚えててくれたんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "アンタしかいないのか？　他の隊員は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "その手……見せてみろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "右腕の傷は鈍器に殴られたのか。皮膚も裂けてる。幸い適切な処置が施されているから、大したことはなさそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "この包帯の巻き方……レオンハルトだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "は、はい……そうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "キューウェルは罰を与える時に、手を痛めつけるのが好きなの。手が使い物にならなくなれば、レム・ビリトンでは何もできなくなるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "他の奴らがどこに行ったのか分かるか？　レオンハルトもそっちにいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "エアースカーペさん……ここにいるのは俺だけです。レオンハルトさんが……身を挺して俺を救ってくれたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "あいつは何か言ってなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "亡くなる前に……ここで、エアースカーペさんを待つようにと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "は？　亡くなる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "はい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "本当なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "エアースカーペさん、俺だって信じたくはありません。だけど……あんな爆発を受けて、生きていられるはずなんかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "いや……爆発？　一体なんの話をしている……レオンハルトに何が起きたのか、もっと詳しく説明しろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "最初から最後まで全部だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "エアースカーペさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ほら、そんな怖い顔しないで……彼だって今さっき死にかけたばかりなのよ。問い詰めるような口調はよくないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "それとレオンハルトさんが、これをエアースカーペさんに渡すようにと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "エアースカーペの力のない視線は、くしゃくしゃに丸められた衣服の上に落とされた。\nいつも見ていたもののはずなのに、目の前にあるそれはなぜか知らない人の服のように感じられた。ところどころに付着した血の跡が目に刺さってひどく痛かった。\nレオンハルト……嫌味なまでにいつも汚れ一つない服を身に着けていたあいつが――\nなぜこうなった？"
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "それと……レオンハルトさんから伝言も預かっています……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "「エアース、来ちゃダメだ……」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "後半の言葉はほとんど聞き取れませんでしたが、恐らくこう言っていたはずです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "「契約はもういい」と。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その言葉は針のように耳を貫く。服を受け取る手がピクリと震えるのを抑えることができなかった。\nゴクリ――喉の奥に何かつっかえているような息苦しさ。喉を上下に動かすものの飲み込めそうにない。\nだが最終的に彼はただ息を深く吸い込み一言呟いただけだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "そうか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "エアースカーペさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "あなたの雇い主……いえ、あなたの友達も、天災トランスポーターなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ああ、腕は悪くなかった。惜しいやつを失ったが、今さらどうしようもないことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "本当に残念だわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "気にするな。あいつもそう言っていたのなら、俺の護衛任務はここで終わりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "少し休んだら、来た道を引き返すことにするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ええ、分かったわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "二人ともなぜ俺をずっと見ているんだ？　座って休んだらどうだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "エアースカーペは岩壁にもたれかかってゆっくりと座り、持っていた衣服をそばに置こうとした。\nしかしふいに、服の一部が膨らんで微かに重みを持っていることに気付いた。ポケットに何か入っているのだろうか？\n手を入れて探ると、ある物が出てきた。\nそれは枝豆の入った箱だった。"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "待って！　どこへ行くつもり！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "どけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "どうしちゃったのよ！？　落ち着いて、外ではまだ砂嵐が吹いているのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "たかが風がなんだってんだ……レオンハルトがそう簡単に死んでたまるかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "たとえ……たとえ本当に死んだとしても、俺は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "感情的になっちゃだめよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "こういう状況だからこそ落ち着かなきゃ！　事態を把握しないと何もできないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "あたしを信じて。キューウェルの人でなしを誰よりも恨んでるのはあたしなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ここは天災エリアの奥よ。ここまで来てしまったら簡単に引き返したり、身動きを取れなくなるのは向こうも同じ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "だから焦る必要なんてないの、ね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "せめて砂嵐が収まるまで待ちましょ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "十五分後"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "あそこの坑道から逃げ出した直後に、中で大きな爆発が起こったんです。外にいた俺すら吹っ飛ぶほどの衝撃でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "起き上がったあとも振り返るのが怖くて、防護装備を整えると真っすぐここまで走ってきたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "念のためにもう一度確認させて。あの岩山から南へまっすぐ逃げてきたのよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クルーズ",
      "text": "はい、そうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "砂嵐もだいぶ収まってきたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "エアースカーペさん……もう少し落ち着く時間が必要なら、まだここにいてもいいのよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "いや。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "坑道が完全に塞がれているわ。あたしたちだけじゃ中に入れない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "分かってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ここにタイヤの跡がある。奴らはここを通り過ぎたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "来た時の跡か離れた時の跡かは分からないわ。それに、外からじゃ洞窟内に何があるのかも分からない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "あいつがこんなとこに閉じ込められるのはあり得ない。こんな岩、簡単に粉々にできるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "でも実際には塞がっている。それにあの爆発のこともあるし、もしかしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "もしレオンハルトが生きているのなら、きっと皆を助けるために、奴らを追いかけようとする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "あいつらの目的地が新しい鉱区だと仮定するのなら……中心広場へ向かうしかないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "だけど、この先の汚染はかなり深刻だし、二次災害のリスクもさらに高まる。あたしたち二人だけで乗り込むのは危険すぎるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "仮にキューウェルたちが専用の防具を持っていたとしても、戻る時は来た道を引き返すしかない。ここで待ち伏せる作戦が一番安全で確実よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "先へ進もう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "まだ現実を受け入れられないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "現実ってなんだ？　俺はまだこの目であいつを見ていない。これが現実だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "さあ、アンタの出番だ。レオンハルトは汚染エリアでも思いのままに行動できた。同じ天災トランスポーターなら能力の差はそこまで大きくないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "や、やってみる……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "砂ぼこりのせいで何も見えないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "あたしの判断が正しければ……もしかすると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "静かに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "えっ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "後ろ！　感染生物だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ありがとう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ここで戦うのは分が悪すぎる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "あそこに小屋があるわ！　一旦隠れましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "ふぅ……だから言ったじゃない。こんなところにたったの二人で来るのは無謀だって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "砂嵐がまた強まってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター",
      "text": "そうみたいね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "アンタ、天災トランスポーターじゃないな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター？",
      "text": "……その通りよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター？",
      "text": "あなたの雇い主が天災トランスポーターだって聞いた時から、絶対にバレると思ってたの。でも今さらこのタイミングで指摘されたのは意外だったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "アンタの正体は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "天災トランスポーター？",
      "text": "あたしの名前はタメカ。あなたと同じ、護衛よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "あたしの正体を知っててもまだ一緒に進むつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "でもあたしたち、どっちもここで死ぬかもしれないわよ。仇を取ることも、友達を救うこともなくね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "だから提案だけど、エアースカーペさんはここに残って、あたし一人で先に進むのはどう？　二人とも死ぬよりはマシでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "断る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "どうして友達が死んだ事実を受け入れようとしないの？　自分の目で確かめるためだけに命を賭ける価値なんてあるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "エアースカーペさん、さっきあたしが話したこと覚えてる？　天災警報がわざと遅らされたって話。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "その警報を出した天災トランスポーターはね……あたしの大切な親友だったの。トランスポーターになったのもあたしの推薦よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "天災に関する知識は、その親友から教わったものなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "ええ、あの子からたくさん話を聞いたの。この防具もあの子の遺品なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "キューウェルのせいで死んだのか？　やつは……何をした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "天災の予兆が出現した通達は、キューウェル鉱業によって遮断されたせいで、住民たちの元にはそもそも警報が届かなかったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "状況を知ったあの子は急いで現場に引き返したけど、天災はもう間近に迫っていたわ。住民を避難させるために、あたしが止めるのも無視して危険エリアへ飛び込んでいった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "あたし、一歩遅かったの。あの子を見つけたと思った瞬間に、あの子は源石粉塵に吞み込まれていった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "あの子が死ぬ直前に見た景色を想像するたびに、キューウェルを八つ裂きにしてやりたくなったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "だけど、あたしと同じように目の前で大切な誰かを亡くした人を――そう、あなたよ、エアースカーペさん。あなたを見て、突然気付いたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "あたし、本当はあなたを利用してキューウェルを始末しようと思っていたわ。でも今はあなたの言葉が正しかったと認めるしかない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "復讐に意味なんてないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "エアースカーペさんほど強い人なら、きっとここを生きて抜け出せるはず。これから先、友達のためにできることはたくさんある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "でもあたしは違う。もうここまで来てしまった以上……あとのことはあたしに任せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "考えすぎだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "アンタがいようがいまいが、俺は先に進む。今一緒に行動しているのは、ただアンタの目指す先に俺の確認したいことがあるからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "俺が先に進むのは……レオンハルトが生きているから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "護衛対象が生きているのなら、俺は自分の職務を果たさなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "どうしてそんなに確信が持てるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "レオンハルトは確かにウザイ奴だ。お喋りだし、身勝手な行動ばかりで、いつも面倒事を連れてくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "だが……あいつは他の誰よりも荒野で生きる術を熟知している。俺はあいつと何度も絶体絶命の危機に陥ったが、あいつがいたからこそ、そのたび生き延びてこられた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "俺が荒野の干からびた死体になることなく、こうして生きてアンタと話ができているのも、レオンハルトのおかげだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "レオンハルトは死ぬ間際にあんなことを言ったりしない。恐らく何か事情があるはずだ……だから必ず自分の目で確かめねば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "それに……俺との約束もまだ果たせていない癖に、死なせてたまるかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "仮に生きていたとしても、あたしたち二人だけでその彼を見つけ出せる方法はあるの？　その友達が空から降ってくるのを祈るわけにもいかないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "いや、俺もアンタの話を聞いて気付いたことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "レオンハルトのやつはいつも「天災を見分けるコツだけは覚えておくんだ」と口やかましく言っていたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "チッ、あいつが死んだことを聞かされた瞬間、色んな記憶が脳裏をよぎった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "都合のいいことに、その中に必要なものがすべてあったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "レオンハルト、待ってろよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "こんなのめちゃくちゃすぎるわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "あなたたちはいつも、こんなとんでもないやり方で天災エリアを生き延びてきたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "レオンハルトのアイディアだ。その場でかき集められた材料だけで即座に作ったものではあるが、何か問題でもあったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "こんなの、自分で自分を別の危ない目に晒しているようなものじゃないの……どうりであんなに速く天災エリアの奥まで到達できたわけだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "着いたぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "タイヤの跡……ここを通ったんだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "誰か来る！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "武装した用心棒よ……全員キューウェルが重宝している護衛だわ。野営地にいたやつらより遥かに手強いわよ。いくらエアースカーペさんでも一筋縄ではいかないはず……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "きちんと作戦を考えなきゃ。とりあえず警備の薄いところから攻めて……エアースカーペさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "ちょっとエアースカーペさん！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "武装した用心棒",
      "text": "ぎゃあ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した用心棒",
      "text": "助けてくれぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した用心棒",
      "text": "に、逃げろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "武装した用心棒",
      "text": "やめろ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "戻ったぞ。さっき何か言いかけてなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "ぜ、全員やっつけちゃったの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "ほとんどは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "攻めるのは俺の得意分野だ。何か問題でも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "……限度ってもんがあるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "友達は見つかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "まだだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……もしあいつが本当に死んでいたら……これからは俺が天災トランスポーターになるのもアリかもしれないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "エアースカーペさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "待て、あそこにもう一つ部屋がある。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キューウェル",
      "text": "誰だ貴様らは？　おい、護衛！　侵入者がいるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キューウェル",
      "text": "なぜ誰も反応しないんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "やかましい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キューウェル",
      "text": "貴様ら、何が目的だ？　金か？　私はキューウェル鉱業の社長だ。この鉱区はもう私の物、いくらでも言い値を払おう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "シッ……黙れ。俺の質問に答えるだけでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "アンタたちが連れ去った天災トランスポーターはどこにいる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キューウェル",
      "text": "あいつか……坑道に連れていかれてるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "つまり死んでないんだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キューウェル",
      "text": "ああ、もちろんだとも。そもそもここへ案内してくれたのもあいつなのだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "そうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "なら後は任せたぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "キューウェル、あたしを覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キューウェル",
      "text": "貴様は……タメカか……私を守ってくれ！　金なら好きなだけやるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "あんたがクレアを殺したあの日から、護衛はもうやめたのよ。あたしはあの子のために……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "タメカ",
      "text": "クレア……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キューウェル",
      "text": "やめろ……く、来るなあぁ――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "エアースカーペは振り返ることなく、坑道を辿って、一歩一歩深部へと潜り込んでいった。\n初めは急ぎ足だった歩みも、岩壁に反響して聞こえる声がはっきりとなるにつれて、徐々に緩やかなものへと変わっていく。\n最後には、その足取りはすっかり落ち着き払っていた。\n長い付き合いの友人にでも会いにいくかのように。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "お、落ち着きなってば！　ちゃんと話し合おうよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "やれやれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "いやー、夕陽の下で自由に動き回れるって最高だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "レム・ビリトンの企業はどこもかしこも似たようなもんだ。もううんざりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "正直、最低でもひと月くらいは依頼を忘れてゆっくり休みたいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "適当なことを言うな。アンタがサボったら、俺たちの収入源はどうなる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "それは……まだ貯金があるでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "論外だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "あーあ、そろそろ安定した収入が入る仕事を探すタイミングかー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "ねえエアース、ちょっと気になったんだけどさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "もう死んだから、契約は終わりだって言ったのに、探しに来てくれたわけでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "もし駆け付けた時に俺が本当に死んでいたら、どうするつもりだったの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "ちょっと、せめて返事くらいしてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "まさか君にとって、俺が全くの無価値ってことはないよね？　ちゃんと約束を守って、色んなところへ旅に連れて行ってるし……出張も旅みたいなもんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "ちょっと貯金を使い込んじゃっただけじゃん。恨むほどのことじゃないよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エアースカーペ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオンハルト",
      "text": "ねぇ、黙り込まないでよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
