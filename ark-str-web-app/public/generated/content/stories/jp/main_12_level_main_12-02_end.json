          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "「グレーシルクハット」",
          "text": "あえて言うのであれば、私はヴィクトリアに仕えている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「グレーシルクハット」",
          "text": "しかし残念ながら、現実には、一部のヴィクトリアに仕えているにすぎない。とは言えその状態ですでに十分忙しいがね。",
