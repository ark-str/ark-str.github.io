{
  "server": "jp",
  "storyId": "main_12_level_main_12-02_end",
  "groupId": "main_12",
  "stageId": "main_12-02",
  "title": "善意の裏切り",
  "storyCode": "12-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_12-02_end.txt",
  "sourceHash": "1b76f04c639100acf11736ca18821a716de004e08f45e15ca348b46754c5cdb1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "入りなさい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "来たか、ゴールディング。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "レト中佐……あなたは想像以上に私たちを理解されていらっしゃるのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "何のことを言っているのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "ロンディニウム市民自救軍です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "どこから、彼らの情報を得たのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "それは重要なのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "座るといい、ゴールディング。そうピリピリする必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "この戦争は、君と私との間で起きているわけではないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "答えてください、レト中佐。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ゴールディング、君が何をしに来たかはわかっている。時間稼ぎをしたいのだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "まだ私と交渉するのに十分なチップを自分が持っていると思っているのだ。自分ならば、あの友人たちを助けてやれると思い込んでいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "非常に残念だよ、ゴールディング。君はここまで甘い考えの持ち主ではないと思っていたのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……レト中佐、私たちはつい先日話したばかりでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "あなたは、このロンディニウムを第二のリンゴネスにしたくないと仰いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私たちの周りを見てください。ロンディニウムが今まさに落ちようとしている深淵をよく見てください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "これが、あなたの言う「自らの選択に対する責任」ですか？　あなたが選んだものなのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "……ゴールディング、君はもう十分私に反論をしたと記憶しているのだが？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "そうだ、我々はまさに今その深淵へと滑り落ちている最中だ。戦争は始まった。戦争はかつてガリアを、我々の故郷を引き裂いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "今回、あれが引き裂くものは一体なんだ？　それはサルカズたちかもしれないし、ヴィクトリアかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "あなたはこれがどれだけ深刻な結果をもたらすか……数十万、いや数百万の人が──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "血を流し、息絶え、この時代に葬られるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "分かっているではありませんか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "そうだ、よく分かっているよ。君が私に教え諭し、私にもう一度自らの選択について考えさせたことについては、認めざるを得ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "そして、己の心に問うてみた結果──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私はそこまで気にしていないというのが分かったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "「人類」や「文明」に対する、道徳に強いられた薄っぺらい高望みは捨てようではないか、ゴールディング。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "若かりし頃、我々はそういったものについて大いに語り合い、憧れを胸に抱きながら、歴史上の傑出した人物たちを賛美しただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "人類は万物の霊長である！　知恵と勇気が我々と野獣を区別し、この大地において輝かしい奇跡を創造せしめたのだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "しかし本から顔を上げ、そういう伝説の一つ一つを現実と比較してみれば、結末がどれも似ていることが分かるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "同じように堕落し、腐敗し、自滅していくのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "もし我々が熱く褒め称えていたそれらが、初めからただの束の間の泡沫だったとしたら？　もしそれらが永遠に存在すると思っていた我々が浅はかなのだとしたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "もしも、破滅願望こそが、我々の本性だとしたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "以前のあなたは、ここまで悲観的ではありませんでしたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "……悲観か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ゴールディング、君の表現はとても優しいな。私のこの狂った言葉を「悲観」と呼ぶとは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "てっきり、もっと辛辣な批評をされると思っていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "どうやら……君も私が思っていたほど固い意志を持っているというわけではないらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私はただ……疲れたのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ただ現実に向き合おうとし始めているだけだ。それはとても苦しいことだが、こうするしかないのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "今なら、あの日の対話について、君に新たな回答を与えてやれる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私は自分に何の使命も課していないのだ、ゴールディング。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ただ……迫り来る破滅から逃れ、生き延びたいだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "いかにも哀れで軟弱で、ちっぽけで薄っぺらいな。だがこれが私の出した答えだ。私が唯一出せる答えだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "他に何ができるというのだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "あなたは軍人ではありませんか、だとすれば……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "命令に従うべきか？　誰の命令に従えというのだ？　国王はとうの昔に死んだな。議会はサルカズに支配されていて、大公爵たちはそれぞれの算盤を弾いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "あなたは本来──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "英雄になれたはず、とでも言いたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "だがその代償はなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "もしその代償を……私が払い切れないと感じたら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "君は部屋に入る時、入口の衛兵の目を見たか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私の部下の士官たち、仲間たち、困惑する若者たち……ティルには五人の子供がいる。ササンの母はもう三年間寝たきりだ。トッテンの弟は鉱石病を患っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "……ブラッドブルードが彼らの血を吸い尽くすだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "相手に屈服したところで、その結末を避けることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "だが少なくとも……今日それが起こることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ゴールディング、個人的な観点から、私は君にも生き延びてほしいと思っているよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "根っこを見れば、私たちは同類なのかもしれない。ただ私は諦め、君はいまだに持ちこたえているだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "私とあなたは、決して、同じではありません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "君はこう訊いたな？　ロンディニウム市民自救軍の情報をどこから得たのかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "答えてやろう。ある意気地なしの教師からだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "……どういう意味ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "振り返ってみるがいいさ、ゴールディング。自分の不手際を、臆病と恐怖によって残した痕跡の数々を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "諜報活動というのは、君のように多感で繊細な人間には向いていない仕事だ。初めから分かっていただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "そんな……まさかそんなはずは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "無線がずっと鳴りっぱなしだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍戦士",
      "text": "サルカズの奇襲……！　カルダン区のセーフハウス……我々は……奴らの部隊……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍戦士",
      "text": "オークタリッグ区のセーフハウスが……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "自救軍戦士",
      "text": "もしもし、聞こえるか？　マグナ区のセーフハウスが襲撃を受けている……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゴールディング",
      "text": "これは……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "ゴールディング、彼らは君のせいで死んだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "君が、彼らを死地へと追いやったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "これこそが、君の「戦い」がもたらした結果だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レト中佐",
      "text": "私はそれに対して哀悼の意を示そう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "奴らは人数が多く、装備も充実しており、巧みに連携している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "傭兵ではこうはいかない、あれは正規軍の精鋭部隊だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "奴らの一人一人が、無数の戦いを生き抜いてきた、血に飢えた殺戮マシーンだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "俺の道を塞ぐな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モーガン",
      "text": "ハンナちゃん、後ろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "防戦一方になってしまっている、このままではまずい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アスカロン",
      "text": "私がこの小隊の指揮官を見つけてくる。アーミヤ、陣形を維持して移動を続けろ。止まるなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "わ、わかりました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダグザ",
      "text": "チッ、路地の向こうにもいやがる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "ドクター、ついてこい。突っ込むぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シージ",
      "text": "誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ドクター、聞こえましたか？　今声が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダグザ",
      "text": "アーツに気を付けろ！　この危険地帯を抜けるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ドクター、掴まってください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "この声に従うんだ。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "賭けてみるしかない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "他人に指図されんのが一番うぜぇんだがな！　チッ、仕方ねぇ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "ふざけんな、そこは壁だろうが！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "違う……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "何かの幻術か？　突っ込むぞ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "ハァ……ハァ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
