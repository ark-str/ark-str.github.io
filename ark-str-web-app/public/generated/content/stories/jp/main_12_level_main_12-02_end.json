      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "「グレーシルクハット」",
          "text": "ロドスの指揮官「ドクター」……あなたに関する資料が数えるほどしかないのは、そこまで重要な人物ではないからだろうと思っていたのだが。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "「グレーシルクハット」",
          "text": "これで、あなたに関する我々の内部評価は引き上げられるだろう。",
