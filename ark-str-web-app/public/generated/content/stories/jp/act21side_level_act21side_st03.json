{
  "server": "jp",
  "storyId": "act21side_level_act21side_st03",
  "groupId": "act21side",
  "stageId": "act21side_st03",
  "title": "摘出",
  "storyCode": "IS-ST-3",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act21side/level_act21side_st03.txt",
  "sourceHash": "1ae229c4603f7a4f4211134a553b269a269d0d06c6adce6bffe65f5fb111f42e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "あっ！　本当に来てくれたんですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ルビオさんの娘さん……ですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "はい。……お父さんから、ラヴィニアさんが来てくれるって聞いてはいましたけど、冗談だとばかり思ってました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "私も友達も、ラヴィニアさんをすっごく尊敬してるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "お父さんみたいな人たちと違って、ラヴィニアさんは政府で唯一清廉潔白な人ですから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……お父さんとは仲が良くないのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "……良くも悪くもない、ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "あ、お父さんのことは好きですよ。いつも時間がたっぷりある分、たくさん遊んでくれますし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "でも、あんなふうに保身に走ってばかりの人は、野心がなさすぎるとも思うんですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "あの歳でようやく地味なポストに就いて、出世しようとしてないのなんてお父さんくらいですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "お父さんの下積み時代からの同期は、みんな大出世してますし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "同期というと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "少し前に亡くなった、建設部長のカラチさんもそうですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "あれは本当に危険な立場でしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "私も知ってます、けど……あの人は毎日テレビに出てましたし、大きなファミリーの人だってあの人には丁寧に接してました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "どうせ役人になるなら、そこまで登り詰めないと意味がないと思いませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "そうかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "だから……お父さんが急に建設部長になると決まって、正直すごく驚いてるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "どうして急に気が変わったんですかね……もっと早くこうしてくれてたら、お母さんと別れることもなかったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "お母さんはお父さんの不甲斐なさに愛想が尽きちゃって……二人は数年前に離婚してるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "まあ、お母さんはあんまり性格の良い人じゃなかったので、私はお父さんについていくことにしたんですけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "そういえば、ラヴィニアさんならお父さんがどうやって建設部長に選ばれたか知ってそうですよね。教えてくれませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……ごめんなさい、私は知らないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "そうなんだ……いえ、大丈夫です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "それじゃ、よかったら適当に座ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "今日はここで、お父さんの就任演説を聞くつもりなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "（ルビオさんの部屋……思ったより整頓されているのね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "今、意外って思いましたよね。見た目はだらしないですけど、ああ見えてすごく規則正しい生活を送ってるんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "日記を書く習慣もありますしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "日記を……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "はい。確かここに……うん、ありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "まあ、厳密には日記っていうか、思いつきを書き留めてるだけみたいですけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "ここ数年書いたり書かなかったりして、全部合わせてもこのくらいしかないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "勝手に見てしまっていいんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "大丈夫ですよ。こんなところに置いてるのは、見られても問題ないからですし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "私も何回か読んだことあるんですけど、つまらない内容ばっかりでしたよ。典型的な中年男の回顧録、って感じで、長いし退屈なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "ご興味があれば、読んじゃってもいいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "ルビオさん、演説会場はこちらです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ありがとう。では、皆さんは下がってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "ですが……あなたをお守りするようにと命令を受けていますので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "この場には誰も入れない。そうでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベッローネの構成員",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "いやはや……権力、か。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "このソファで扉を塞いで……このくらいが関の山だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "カラチ、もう少し待っていてくれよ。すぐそっちに行くからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どうだった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "……お医者さんが言うには、刺されたところが心臓から何センチか離れてたおかげで、即死はせずに済んだみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "でも、まだ予断を許さない状況だって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "テキサスさんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "んー……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "昨日帰ってきてからずっとぼーっとしてるんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あそこに座ったままぴくりともしないし、ご飯食べよって声かけても反応なし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "……今はそっとしといてあげよう。あたしとクロワッサンはこのまま病院で見張りを続けるから、テキサスさんのことはお願いね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "任せといて。病院組も気を付けてね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……あ～あ、退屈だな～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そういえば、今日って何かの演説があるんじゃなかったっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "聞いてみよーっと。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "親愛なる市民の皆様、こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "ほとんどの方は私のことなどご存知ないでしょうが、無理もありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "私はこれまで、取るに足らないポストに就いていたのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "そもそも、市民の皆さんの多くは、前任のカラチ氏と、かのラヴィニア裁判官を除けば、我々政府の人間などほとんど知りもしないことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "私は、裁判官さんと親しくはありませんが、カラチ前部長とは交流がありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "今日の演説は、皆さんご存知の彼のことから始めるとしましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "私とカラチは、市場監督局の同期でした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "こちらが後方で書類仕事をしているのに対して、逞しく精力的な人物だった彼は、実地調査を担当していました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "その当時から、彼は物怖じしない言動で有名で、大ファミリー相手でも果敢に立ち向かっていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "しかし実のところ、そんな彼に不満を持つマフィアもいたのです。彼は何度も始末されそうになりながらも、うまくやり過ごしたり、何とか耐え忍んだりしていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "つまり、当時の局内では誰もが彼を厄介者扱いし、助けようともしなかったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "それゆえに、彼の報告業務は、同じく嫌われ者だった私に押し付けられました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "その業務は苦労の絶えないものでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "けれど、私に達成感を与えてくれもしたものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "私には彼のような大胆な行動は取れませんでしたが、彼は私のやりたいことを代わりに実行してくれました。そして私も、彼の手伝いという形で恩を返していました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "そのようにして、我々の付き合いは深くなっていったのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "レオン。この数年カラチと仕事をしてきたお前も、彼を高く評価していたことは知っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "お前の知るカラチは、どんな人物だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……あの人は、活力にあふれた人だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "マフィアへの対処法をよく知っていて、単に角が立たないようにするだけでなく、マフィアに利益を与えつつ、目的のためにうまく利用することもできる人物だったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "本来なら様々なマフィアの手で妨げられていたであろうことも、彼の手にかかれば、いつもうまく片付いていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "お前のやり方が、彼の影響を強く受けていることは見ればわかる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "……俺はただ、カラチのやり方と俺の考えには類似点があると思っただけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "今はもう、殺し合いで問題を解決するような時代じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "マフィアたちが時代に適応したいと望むなら、相応に変わらなければいけないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "やはり、わかっていないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "何をわかっていないと言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "お前は無意識のうちに、自分とラヴィニア、そしてカラチを同じように見ているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "彼らとお前は違うということを忘れるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "わかっているさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "本当にわかっているのなら、ここに立ってはいないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "残念だが、時間切れだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "text": "親父……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "もし、お前が生き延びてくれたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "text": "いいや、やめておこう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "――彼は多くのマフィアたちからすれば目障りな存在ではありましたが、その秀でた能力については誰もが認めるところでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "そのため、私よりもはるかに早く昇進していったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "正直なことを言えば、当時は、彼が昇進すればすぐに死んでしまうだろうと思っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "というのも、それまで彼が死なずに済んでいたのは、諸々の利権に関わりすぎない立場にいたからこそだと考えていたためです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "地位が上がってもやり方を変えずにいたならば、彼はきっと手に負えない人物まで刺激してしまうだろうと私は思いました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "けれど、それは間違っていたのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "……お父さんがこんなにたくさん喋る人だなんて知らなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "あの、ラヴィニアさんはどう思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "……ラヴィニアさん？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ラヴィニアがその呼びかけにまったく気付いていないことに、ルビオの娘は気が付いた。\n彼女は手にした日記を読むのに集中しきっていたのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "ルビオさん、あなたは一体……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "実際、我々の組織では、カラチと同じ初心を持つ人間は決して少なくありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "ですが様々な理由から、彼らは最終的にマフィアに屈し、ひいてはこびへつらうことを選びました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "けれども、カラチは違ったのです。彼は屈しないだけでなく、彼らに対抗するすべを常に模索し続けていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "彼の努力は価値あるものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "私の予想は外れ、カラチは出世後もすぐに死ぬことはなく、むしろさらなる高みへと上り詰めていきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "あるパーティーで再会した時、彼が私に言ったことは今でもよく覚えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "「今のファミリーはどこも軟弱だ。」と、彼はそう言いました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "このおじさん、肝が据わってるなあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "んー……なんか外の様子が変だから、ちょっと見てくるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "エクシア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ジョヴァンナを龍門に連れて帰ると言ったら、どう思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "良いと思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あの人すっごく面白いしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "だけど――それはキミの本心じゃないような気もするな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "テキサスは視線を窓辺のテーブルへと移した。そこにはネックレスが置かれている。\nそれはかつてミズ・シチリアが贈った証であり――\nジョヴァンナが残した贈り物でもあった。\n――祖父からすれば、クルビアのマフィアたちは変わってしまっていた。\n彼らは利益のためならどんなに汚いことにも手を染めて、道義の欠片もない殺人を行っていたのだ。\nそして父からすれば、シラクーザのマフィアは腐敗していた。\n道義などというもののために、手を伸ばせば得られる利益を諦め、そのために戦うこともせず、自らの歩みを制限する。そんなやり方は愚かとしか言いようがなかったのだ。\nけれども、テキサスからすれば、祖父と父はいずれも正しく、そして間違っていた。\n仮に、彼女がただジョヴァンナの身に起きたことに憤っているだけであれば……\n今度はジョヴァンナを共に連れ、七年前のように立ち去ればいいだけの話だ。\nしかし、祖父の死を知った時にも、あの洗車工を見逃してやった時にも、父の助けを求める声を黙殺した時にも、彼女が思っていたのは――\nこのすべてに終わりはないのだろう、ということだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "彼は私にマフィアへの対象法を教えてくれたのですが、それは笑ってしまうほどシンプルなものでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "彼らが断れないような品物や利益を差し出す――それだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "マフィアたちには、カラチが持つパイプを奪えないわけではありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "けれど一方で、彼らには優れた管理者が欠けていたのです。彼らは略奪しか知らず、真の管理とは何たるかを知りませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "ゆえに、カラチはその卓越した能力を武器にして、次第にいくつかの大きなファミリーのお気に入りになっていきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "そうして、彼らが建設部長の座を巡り争っていた時、誰もが満足する候補者として選出されたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "こう聞くと、疑問を感じる方もいるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "実質的に、カラチは誰にでもいい顔をする連中と変わらなかったのではないか、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "ですが私に言わせれば、シラクーザのような――根底に悪が存在している国において、善人が存在することなど初めから不可能です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "少し過激な言い方をするのなら、私たちは皆悪人なのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "……これって、就任演説でしていい話なの……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "うーん、やっぱりさっさと拠点を移しとくべきだったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "でも、昨日みたいなこともあったし、しょうがないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "チッ、あのサンクタ手ごわいな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "text": "相手は一人だ、囲め！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしの大事な相棒が休憩中なんだ、ちょっと静かにしてくれる？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "はあ、ほんと迷惑な人たちだなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "……あ～あ……こんな時誰かいてくれたら、「エクシア、お前が言うな！」とか言ってくれるのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "独りぼっちだとほんと退屈！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あれあれ？　もしかして、助けが必要かい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "前から思ってたんだけど、キミって……もしかして暇なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミと同じで、答えを待ってるだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "どういうこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "テキサスが龍門に戻るかどうかが、キミにとって重要なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "重要だよ、すごくね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "それに、今はあの子に戻ってほしいと思ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ってことは……つまり、あたしたちに味方してくれるってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "正解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "オッケー、一人っきりよりそっちのほうがマシだしね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "と、申し訳ない。つまらない話をしてしまいましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "ですが、皆様お気づきの通り、私が今日ここにいるのは、就任演説をするためではなく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "本心を語るためなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "――カラチは高い理想を抱いていましたが、私に新都市の今後について語ったことは一度もありませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "というのも、この地位に就いた時、彼にはすでに死ぬ覚悟ができていたからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "彼がここ数年で成し遂げたことは誰もが知るところでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "そして、彼がその目で新都市の完成を見ることが叶うだろうと思われた矢先、彼は数日前に突然亡くなりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "……私は結局、この怒りを抑えきれなかったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "それゆえベッローネに近付いて、自己推薦の上で、建設部長の地位を得ました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "さらにその過程で、ベッローネとサルッツォの衝撃的な陰謀を知るに至ったのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "彼らは初めから都市を混乱させることを計画しており、新たに建設された移動都市の占領を目論んでいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラジオ",
      "text": "そうして、ミズ・シチリアに対抗するつもりでいるのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "忠実なマフィア",
      "text": "ドン、これは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ベルナルドに動きは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "忠実なマフィア",
      "text": "ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……あの野郎、一体何考えてやがる……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "おい、ダンブラウン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "――ダンブラウン！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "……聞いてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前、今ルビオの近くにいるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "その狂った野郎を始末しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "……了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "やれやれ……やはり本気の相手には大した足止めにならないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "あんた、バカだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "こんなことして何の意味があるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなたは……その服装から判断するに普段は労働者のようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "「ダンブラウン洗車店」って店をやっててな。いつもは洗車工をしてるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "そのお店なら、見覚えがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "そうかい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "つまり、あなたはダンブラウンさんというお名前なんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "ああ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ご自分のお仕事について、思うところはありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "ないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "ヌルくなってきたこのシラクーザじゃ、やることが何もなくなったから、適当に始めてみただけだしよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "それは残念です。あなたには、より多くのことに目を向けていただきたいところですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなたたちのようなマフィアのお偉方は、我々を永遠に支配できるものと思い込んでいるのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "常に自分たちの敵はお互いだけだと思っていて、私たちのことなど一顧だにしていませんしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ですが、進み続ける時代の中で、いつまでも変わらぬものなどないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "どんなにご立派なことを言おうが、あんたはほんの少し演説しただけだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "たったそれだけの言葉でファミリーの――ミズ・シチリアの統治を覆せるってのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "何にせよ、この千載一遇のチャンスを用いて、私の考えがすでに伝えられたことは確かでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ベルナルド氏とミズ・シチリアのどちらが勝つかなど私は知りませんし、興味もありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ただ、信じるのみです。――いずれ時代があなたたちを見捨てることを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "シラクーザが新たな時代を迎える命運にあるのなら、その主人公はマフィアであるわけがないのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "私たちには力はなく、まさしく弱者と呼べるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "しかし、いわゆる文明というものは、そもそも暴力を克服するために存在しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "我々は平等を――暴力に基づくことのない秩序を追い求めているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "暴力は俺たちの本能だろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "そうでしょうか？　であれば、すべてのファミリーが同じ方向へと進んでいる理由は何だと思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "彼らが皆、暴力と闘争ではなく、金と権力を追求するのはなぜだと思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "よもや、今日ここで私を殺すことは、単なる衝動的な暴力の発露だとでも言いたいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "あなたが私を殺しに来たのは――その背後にいる人物が権力を握るために、私が邪魔だからではないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "ご覧なさい。あなたは答えをわかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "さて……もしよろしければ、この命を終わらせるのは私自身に任せていただきたく思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "これが何かはご存知ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "洗車工",
      "text": "銃、か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "はい。数年前あるルートを通じて、BSWから購入したものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "銃は扱いが難しいですし、血の気が多いマフィアが相手なら、これで解決できるとも限りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "せいぜい、自分と同じ弱い人間から身を守るのに使えるくらいのものでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "思えば私は――何年も前から、これを誰に向けるべきかを理解していたように思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ルビオは、その銃口をゆっくりと自分のこめかみに当てた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "そうだ、ダンブラウンさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオ",
      "text": "いつかあなたが、シラクーザの地で、武器を手に取ることもなく、ただの洗車工として生きていける日が来ることを願っていますよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "ラヴィニアさん、私夢でも見てるんでしょうか……？　うちの、お父さんが……殺し屋相手にあんなことを言うなんて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ルビオの娘",
      "text": "やめて、お父さん……どうしよう、お父さんが危ない……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラヴィニア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ラヴィニアは涙が込み上げてくるのを感じた。\nけれど、それを拭うだけの余裕はない。これから起きることが、彼女にはわかっていたからだ。\n彼女はルビオの娘のそばへと歩み寄り、そっと耳を塞いでやった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウォルシーニの住民たちはこの日を決して忘れはしない。\nその早朝、よく通る一つの銃声が、ラジオを通じてウォルシーニ中に響き渡った。\n前食品安全保証部長ルビオは、建設部長への就任演説中に命を落とした。\nその後の混乱は半日のうちに収まったものの、この件はのちに、シラクーザの未来を変える発端となる。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
