  "stageId": "main_02-04",
  "title": "ペンギン急便",
  "storyCode": "2-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_02-04_end.txt",
  "sourceHash": "b2c3466d90846e99cff4e93be090160b508f864988a045ace115515f0de76010",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "お掃除お～わり、っと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "それにしてもこいつら、確かに相当準備してきてたみたいね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "ほら、みんなも急いで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "はぁ、はぁ……もう……一体、なんなの……これ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "みなさん、ペースを上げてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "――アーミヤさん、後ろから追手が来ています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "ここは迎撃しておくべきでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "いえ、今のところは必要ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "戦わずに済めばそれが一番ですし……できるだけ振り切ってしまいましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "確かにこの状況では、確実に安全を確保して、などとは言っていられませんしね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "こうなれば、なるべく早くスラム街から抜け出して、チェン隊長の待つ合流地点に辿り着かなくては。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "なにしろ、レユニオンはこちらの動きに気付いているようですし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "時間をかければかけるほど、危険も大きくなるでしょうから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "そういうことなら任せて！　向こうさんがぜ～ったい予想もしてないようなルートを一つ知ってるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "本当ですか？　そんな妙案が……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ほんとほんと！　あたしを信じてよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "まあ、マジで使えそうかどうかは、一回確認してみないとなんとも言えないけどね～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "text": "では、そちらはお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "りょうか～い！　そんじゃ、パパッと行って、ササッと戻ってくるからね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "なんかあったら、ペンギン急便のほかの誰かに連絡してちょ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……ねえ、ところで……どこに向かってるのか、教えてくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "今は、近衛局の方との合流地点に向かっているところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "彼らであれば、責任を持ってあなたを保護してくれますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……近衛局、って言った……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。今の私たちの任務は、あなたを近衛局の保護下まで送り届けることですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……そう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……ちょっと信じかけてたのに。あなたたちは本当に、私を助けに来てくれたんだ、って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そんな……あなたを助けに来たというのは、本当なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私たちは元々、感染者の一部を保護してもらえるよう、龍門に依頼するつもりでしたし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ただ、近衛局が我々の報告を聞くと急に、ミーシャさんを引き渡してほしいと言い出したのは事実なのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それでも……龍門では、近衛局の保護を受けるのが一番安全だと思いますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私たちの判断を、信じていただけませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あなたを追っている感染者たちの多くは、レユニオンのマークを身につけていましたし……彼らのような危険な組織から、あなたを守りたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……そのレユニオンがどんな連中かなんて、私は知らないけど……近衛局のことは知ってるし、感染者にどんな態度を取るかってこともわかってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "私を捕まえたいだけなら、最初からそう言ってくれればよかったのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……そんな誤解をさせてしまって、ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それでも……私たちはどんなに悪く思われてもいいですから……どうか、しばらく辛抱してくれませんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "今はあなたの安全が最優先ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そうして、このあと改めて時間を取れたら、もっときちんとお話をさせてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "私自身、知りたいこともありますし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミーシャ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
