{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_08_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_08",
  "title": "ガヴィルの拳",
  "storyCode": "RI-8",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_08_beg.txt",
  "sourceHash": "62d50c079bc6704afc472f7d9c6db6c3f70d0d42d71440daa4d7c2adc2d1fd7a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ここの建物は、ほかの部族のものとは明らかに違いますね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "text": "オンボロだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "うーん、確かに雑な作りと装飾だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ヘンテコな機械の残骸は、そこら辺に散らばっとるけどな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ズゥママ、お前の部族はホント変わってるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "みんなお前と同じように、機械いじりが好きなんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ、ここにあるものは全部、部族の者たちの傑作だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "彼らは皆機械の魅力に気付き、そしてその熱意をもってあれらを創り上げたんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "見ろ、ガヴィルだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "大族長が言ってた通りだ！　ビッグ・アグリーでもう一度、ガヴィルと勝負するつもりなんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "なんですって！？　こりゃ見逃せないわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "text": "うわ、人がいっぱい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ここには、祭典の後に集まった他部族の者たちも多くいる。彼らはいずれ、私たちの一員になる予定だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "んだよ、何が言いてぇんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ガヴィル、お前があのままここを出て行くのであれば、私は見逃してやるつもりだった。だがお前が再び現れたとなれば、今ここでお前を倒さなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "なんでだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前は強すぎるからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "あの日のことを覚えているか、ガヴィル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あの日？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……あの日までは、私もお前と同じように、己の拳こそがすべてだと盲信していた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "はぁあ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズゥママ",
      "text": "うわああ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの老人",
      "text": "勝者ガヴィル！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ハハ、またアタシの勝ちだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズゥママ",
      "text": "ふん、もう一回だ！　次は絶対負けない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "いいぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズゥママ",
      "text": "ん？　地面が揺れている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ズゥママ、あれを見ろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ズゥママ",
      "text": "あれは……あれは一体なんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "でっけー鉄の塊だな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの老人",
      "text": "ありゃあサルゴンの移動都市じゃよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズゥママ",
      "text": "サルゴンとはなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの老人",
      "text": "わしらの国のことじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズゥママ",
      "text": "ではイドウトシとは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの老人",
      "text": "移動都市というのは大きな部族のことじゃ。あそこにはたくさんの人が住んでおる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの老人",
      "text": "わしも若い頃に一度だけ、行ったことがある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの老人",
      "text": "まあ怯えなさんな。あれがこっちに来ることはないからの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリスの老人",
      "text": "そう、あれは一生、わしらとは無縁なんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズゥママ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ズゥママ、どうした、調子でも悪いのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ズゥママ",
      "text": "なんでもない、先に帰る。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ああ、サルゴンの移動都市が近くを通った日か。覚えてるよ。あの日を境にお前はおかしくなったんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "おかしくなった、か。私は逆にお前のことが不思議でならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "あれを見せつけられて、お前はなぜ驚かない？　震え上がらない？　自分はちっぽけな存在だとは思わなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そりゃ当然「うわー、でっけぇなー」とは思ったさ。でもそれとアタシに何の関係があるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "はぁ……お前はいつもそうだ、ガヴィル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "あの日から、お前と喧嘩することに楽しみを見いだせなくなった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "それからイナムに頼んで本を集めてもらい、サルゴン語と機械について学び始めた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "そしてある日大祭司のじいやと出会い、一緒にビッグ・アグリーを作り始めたというわけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "それは知ってるよ。その頃お前に会いに行ったこともあるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "つーことはあそこの変なヤツが、その大祭司とかいう空想上のお友達だったってわけか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "その通りじゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "うわっ、いつの間にこんな近くに！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "なんかウチらのボス……エンペラーはんと似とるなぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "エンペラー？　あのペンギンのことかの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "せやで。って、え？　ボスのことを知ってるん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "知っとる知っとる、当然知っとるわい、何十年も会ってないがの。いや、何百年じゃったか？　まあいいわ、確かにお前さんからもヤツの匂いがするのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "何百年ってどういうこと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "ええー！　まさかこんなとこでボスの友達に会えるなんて思いもせんかったわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "本当に存在する「お友達」だったんだな。アタシはてっきり、ズゥママの頭がおかしくなって、幻覚を見てるんだと思ってた。ロドスでもわざわざ似たような症状の研究までしたんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ほほう、ガヴィル、お前さんは知らんじゃろうが、わしはお前さんがまだ小さい頃から、ずっとここにいたんじゃ。ズゥママに会いに来たときも、わしはずっと隠れて見ておったぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "こんな風にのぅ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "消えた！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ハハハ、驚いたか！　普段はこうして姿を見せないようにしておるんじゃが、今回はビッグ・アグリーを操縦せねばならんからのぅ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "それにしても、若造どもと機械を作るというのも、なかなかに愉快な日々じゃわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "そのビッグ・アグリーの話だけど、操縦に戻らなくて大丈夫？　建物に突っ込みそうになってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "なぬ？　おっと忘れておったわ！　話はまたあとじゃ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "うわー、ホントに一瞬で操縦席に戻った！　やるじゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "やっぱボスとそっくりや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ああわりぃ、あいつにびっくりしてお前と喋ってる途中だったのを忘れてたよ。つーかどうせ最後は喧嘩になるのに、わざわざこんな話をする意味はあんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前に伝えることだけが目的じゃない。私自身にも言い聞かせているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私にとってお前は、最大の障壁なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "そうなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "正確には、お前というよりは、お前みたいなヤツが、だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "私はこれまで、多くの者に機械の魅力を説いてきた。だが大半は興味を示さず、口説き落とすことができなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "それは、お前のような強い人間がいるからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "つまりお前という存在が、ここでは強ければ欲しいものが手に入ると主張し続けているからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "その強さが、私たちの進歩を阻んでいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "だから私は決めたんだ。皆の思い込みと、お前がもたらした己の力への盲信を、より強い力で打ち破ると。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "うーん、この話、結構理に適ってない？　ドクターはどう思う？",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "確かに。",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ガヴィル",
              "text": "ドクター、お前はどっちの味方なんだ！",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "……",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "クロワッサン",
              "text": "一理あるけど、どっかズレてるような……",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "あの機械はいいものだ。",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "ブレイズ",
              "text": "うん、あのデカブツはイケてるね！",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "……いや、正直アタシも、こいつの言葉には頷きそうになった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "でもアタシは、昔も今も、誰かの手本になる気なんてねぇぞ。アタシが拳でなんでも解決できるって思ってたって、ほかのヤツらとは関係ねぇ。アタシはあくまでアタシだろ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "わかっている、お前のせいではない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "だがガヴィル、どちらにせよ私はここでお前を倒す。このビッグ・アグリーの……機械の力でな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "全員聞け！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "これから改めて、ビッグ・アグリーとガヴィルの決闘を行う。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "この戦いで、真の大族長を決めるのだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "じいや、戦闘の準備を！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "おう、いつでもいいぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "ガヴィル、準備はいいか！　仲間と一緒でも構わない！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "ハッ、一人で十分だ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "お前らは手を出すなよ！　これはアタシとあのデカブツの戦いだからな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "さあ、かかってきやがれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "まずは通常出力からじゃ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "発射！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "へっ、二度も吹き飛ばされると思ったかよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "ほう、さすがガヴィル、見事な反射神経じゃ！　じゃがこれは想定内……次はビッグ・アイアンナックルじゃ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "力比べか？　望むところだ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "text": "ガヴィル、すごーい！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロワッサン",
          "text": "ヤバイやろガヴィルはん！　一人であのデカブツの鉄拳を受け止めたで！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "メディカルチェックのときも不思議に思ったんだけどさ、ガヴィルはなんで医療オペレーターなんてやってるの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "……敵ながらあっぱれじゃ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "じゃがまだじゃ、まだ終わらんぞい！　こういう場合に備えて、このビッグ・アグリーには出力MAXモードがあるんじゃ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "ポチっとな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "なんだと！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ウタゲ",
          "text": "あのデカブツ、パワーアップしてる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ブレイズ",
          "text": "ガヴィルが力比べで押されてるの！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "ああ、なんと素晴らしい音じゃ！　……おや？　どうしたんじゃ、計器が異常な数値を……んんん？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "じいや、どうした！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "ぬわぁ、尻が焦げそうじゃ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "ビッグ・アグリーの状況を聞いているんだ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "ついでにわしの状況も言っただけじゃ！　恐らくエンジンの出力を上げすぎて、ビッグ・アグリーが暴走を始めたんじゃ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "おお、なんかワクワクしてきたわい！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "じいや、早く脱出しろ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "なにを言っておる？　戦うんじゃろ？　ならばこのままやればいいだけのことじゃ！　さあ、ガヴィル、これで決まり――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "じいや！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "――うぬぬ、わかったわい。残念じゃが、どうやら方針変更せざるを得んようじゃ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "大祭司",
          "text": "ズゥママ、わしのことは心配するな。こっちもできる限り暴走を抑えるから、その隙にビッグ・アグリーを止めるのじゃ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "……ガヴィル、仲間と共に離れていろ。お前たちには関係ないことだからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "何言ってんだよ、アタシを倒すんじゃなかったのかよ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ユーネクテス",
          "text": "もちろん倒すが、こんなやり方は望んでいない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ガヴィル",
          "text": "はぁ、水臭ぇこと言いやがって。そいつを止めるってんなら、もちろんアタシも付き合うぜ。いいよな、ドクター？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ケオベ",
          "text": "おいらも手伝う！　大怪獣狩りだ！",
          "portraitKey": null
        }
      ]
