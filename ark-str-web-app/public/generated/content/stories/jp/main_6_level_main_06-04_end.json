{
  "server": "jp",
  "storyId": "main_6_level_main_06-04_end",
  "groupId": "main_6",
  "stageId": "main_06-04",
  "title": "化膿した傷跡",
  "storyCode": "6-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_06-04_end.txt",
  "sourceHash": "5feb195bb48f1ec8e8f871ad4d493c4e08cce6b4363ef6cafe6a1b079eb2bd18",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "外はメチャクチャだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "メフィストがアーツで手下たちを変異させて、仲間すら襲うバケモノを作り出しやがったらしい。感染者すら喰らうバケモノを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "はっ、この戦いは完全に俺たちの負けだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "そして、そのメフィストが残していったチームだが、スラムにある家の地下室で見つかったそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "話によると、死体からは無数の植物が生えて、もう誰であるかすらわからなくなる寸前だったそうだ。何か心当たりはあるか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "もう何もかもがデタラメだ。そこら中でおかしな事が起きてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "チェルノボーグは落とせて、龍門が落とせないのは、やっぱりタルラが来ていないからだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "クラウンスレイヤーたちと行かなかったのも正解みたいだな。通信回線からあいつらの情報は全く流れてこない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ここに残った俺たち数人じゃあ、もう何もできない。クソッ、もうお終いだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "お前は？　どうするつもりだ、龍門の感染者さんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "なぁ、龍門の。アンタ、レユニオンに入らなければ、俺たちみたいにひどいことにならなかったんじゃねぇのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "だがこうでもしなければ、私たちの境遇が好転することはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "……アンタはタルラの演説を聞いてレユニオンに加わる気になったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "いや、私は他人の口上に惹かれることはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "こんな質問をするということは……君も感染者の身分や政治に興味はないようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ああ。アンタもそんなもんは信じてないって顔だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ではどうして君は、まだレユニオンに身を置いてるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "レユニオン以外に行くところなんてないからさ。でもアンタは違うだろ。もし俺たちがここに攻め込まなけりゃ、アンタたちはここで静かに暮らせていたんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "龍門の感染者への迫害は、遅かれ早かれいずれは起こる。レユニオンはその過程を早めたに過ぎない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "アンタ、よく知ってるんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "そうさ。アンタの言うとおりさ。俺の故郷だって元々は、感染者に対して割と寛容なところだった。遠くにある小さな都市でさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "都市を統治してた貴族には感染者の娘がいて、その自治区下では、感染者は隔離区画で普通の生活が送れていた。課せられる採掘への参加義務だって軽かったしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "非感染者だって、特に俺たちに良くしてくれることもなかったが、普通に取引なんかはしてもらってた。たまに壁によりかかりながら一緒に酒を飲むことだってあったさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "だが数年経って、どっかの戦争に破れたとかなんとかで、その責任を問われた貴族は連れて行かれ、新しい市長が着任したんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ああ、「大反乱」か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あの頃は、爵位を持つ者でさえ、その座を剥奪されるのは特に珍しいことでもなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "そうなのか。政治のことは俺はよくわからないし、全部細切れに聞いたことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "地域によって感染者のトランスポーターもいるらしいが、少なくともウルサスにはいなかったからな。俺たちには何も知らされなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "市長が変わった直後は、みんなこれまでと同じで何も変わらないだろうと思っていたさ。だが、次第に重苦しい空気が流れるようになり、食料の配給も少しずつ減らされていった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ジワジワと全てがおかしな雰囲気に変わっていった。物資が不足しだすと、非感染者たちは俺たちに石を投げ始め、失踪する感染者も増えていった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "十数回目の市政府主催の演説が終わる頃には、誰も新市長の着服疑惑や、ダウンタウンを好き放題したことになんて触れなくなってたさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ハッ、俺たち感染者でさえ知ってたことだ、普通の非感染者の市民が知らないわけないだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "それなのに、隔離区画との境界の壁からは「感染者を排除し、都市を浄化する」なんてスローガンが聞こえてくるようになった。隔離区画へ向けて叫んでたんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君たちは私利私欲の犠牲になったんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "モノは使いようってこった。これまでも俺たちはずっと犠牲になってきただろ？　感染者に寛容って言っても、ほんの数十年だけだったしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "それからのことは簡単さ、ほとんどの感染者が殺された。俺たちは命からがら荒野に飛び出し、食うものもなく、さらに大勢が死んでいった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "そして今回の龍門で、また死んだ。俺の同郷はもう一人も残ってないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "だからアンタの言うとおりだ。これはな、起こるべくして起きたことなのさ。感染者に生きていける場所なんてない。希望にすがっちまうのは、まだ目の前でそれが起きていないからってだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "そんな話を私にしてどうする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "もう俺も長くないと思ってね。アンタ、痛みのない殺し方は知ってるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……何を言っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ああ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "いや、そうか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "悪いな、俺の誤解だったのかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "龍門人は今後も君たちを恨み続けるだろう。我々の都市を侵したのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "そうだろうな。だが感染者に自分たちの都市なんてあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "あれは？　燃えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "おい、いきなり押すなよ……言ってくれれば、よく見えるところなんて譲ってやるからさ。無理やりはやめてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "火の広がりが早すぎる。おかしい……これは自然に発生した火災とは思えないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "なんで分かるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "「本物の火」のような広がり方じゃないからだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "じゃあ、さっさと離れようぜ。これ以上こんなところにいたら、どうなるか分かったもんじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "どこへ行くんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "状況を見て出たとこ勝負ってやつだ。おいアンタ、俺たちと一緒に行くか？　龍門人が故郷を離れるのは辛いかもしれないが、俺たちと一緒に行くってのも一つの手だぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "君たちと一緒に行く？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "ああ。いや、聞いてみただけだ、嫌ならいいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "……少し考えさせてもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "しかし、故郷か……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私が故郷と呼べる場所は、どこにあるんだろうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
