{
  "server": "jp",
  "storyId": "act15d0_level_act15d0_08_end",
  "groupId": "act15d0",
  "stageId": "act15d0_08",
  "title": "激戦の末",
  "storyCode": "MB-8",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act15d0/level_act15d0_08_end.txt",
  "sourceHash": "60e29effab871172afdaa3fb245046617c2df946e2caf87c5d0544fe714811cd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": null,
      "text": "このクソ野郎！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "無駄ですよ、アンソニーくん。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "ミス・ロビン、まさかあなたの戦闘能力がこれほどだったとは……ますます気に入りました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "どうです？　今私に協力すれば、まだ許して差しあげますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "必要ない！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_kafka",
      "text": "あいつの手……一体どうなってるんだ？　色が黒く変わってから、すごく硬くなってない？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "僭越ながらご紹介いたしましょう。私のアーツ能力は、鉄元素の操作です。そして私の体も、少しばかり改造が施されていましてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "私を攻撃した時、鉄板を叩いているように感じませんでしたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "それは、ただ単に私のアーツの能力の影響だけではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "私の皮膚の下には、ライン生命の科学技術の結晶――小さな金属板がいくつも埋め込まれているのですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "まあ、この金属板の正式な名称が何だったかは覚えていませんが、とにかくあなたたちの攻撃の威力を大幅に減衰してくれるのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_kafka",
      "text": "ちょっと待って！　お前はライン生命の人間だったの！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "いいえ、残念ながら違います。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "いずれにせよ、拘束具によって動きに制限があるにもかかわらず、ここまで戦えるとは、本当に驚きです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "どうやら私もいくらか本気を出さなければいけないようですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "あいつの手が……ナイフに変わった！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "知っていますか、ミスター・アンソニー。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "この監獄にやって来て初めてあなたを目にした時から、私はずっとある種の違和感を抱いていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "あなたはできるだけ己を抑制し、自分が無害であるかのように、礼儀正しい人間であるかのように見せていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "しかしあなたの存在はまさしく「力」そのもの……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "あの瞬間から、私はこの展開をひたすら待ち望んでいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "あなたのその偽りの上品なヴェールを引き裂いた後に現れる、凶暴な姿を――"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "失望はさせなかっただろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "ええ、大変驚きましたよ。いい意味で。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "だがお前に私の本性を語る資格などない！　この外道が！！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "敢えて口にしたわけではありませんよ。ただ、今のあなたの姿をとても気に入っていると申し上げたかっただけですよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": null,
      "text": "牙さえも使用するほどですから……クククッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": null,
      "text": "しかし残念ながら、あなたの牙をもってしても私の皮膚を引き裂くことなどできません。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……おのれ、クソがっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "はぁ……しかしアンソニーくん、実際ここを抜け出して、何ができるというんです？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "両親を救えるのですか？　一族の栄光を取り戻せるとでもいうのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "教えてあげましょう。ここから出ても、あなたの手には何も残らないでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "監獄内で良い生活を送っていたではないですか。獄長ですらあなたを尊重してくれていたのでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "先ほどあなたを殺す機会はいくらでもあったと言いましたが、実際はそれほど容易でもありません。あなたに脱獄する気がなければ、あなたを片付けるにはより多くの代償が必要だったでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "なぜです？　この監獄に留まって暮らす日々の何が悪いんです？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……六年前の7月24日、晩餐会に参加する予定だった私は、突然ボディーガードに父からの伝言を告げられた。「家が大変な事態になっているから逃げるように」と。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "私はわけもわからず、両親に一目会うことさえできず、逃亡を余儀なくされた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "アイアンフォージシティまで逃げたところで、私は捕まった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "当時はこれでお終いと覚悟した。だがここに入ってしばらく経ち、そうではないのかもしれないと思い始めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "私はここで囚人が受けるべきでない待遇を受け、すぐに気付いた。私の投獄は、恐らく父が手配したものだろうと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "奇遇ですね、私も同じ考えです。もしそうなら、なおさらあなたのお父上の願いを無下にするわけにはいきません。違いますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "父の願い？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "……お前は他人を操るために、上から目線で話の筋を作り上げるのが好きらしいな、ジェッセルトン。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "誰かに言われたことはないか？　器の小さい野郎だと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "……かつてそのようなことを言われた経験はありますね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "しかしながら、私の器の大小は、あなたが脱獄できるかどうかとは関係ありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "私はここで快適に暮らすことができる。望むならここを自分の王国に作り変えることさえできるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "だがそれがどうした？　そんな私はただの自由な囚人にすぎない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "私はここで六年暮らした。この六年、常にここから出ることだけを考えてきた。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "私がここを出たい理由は、自分の力を証明したいからじゃない……一体何が起きたのか知りたいからだ。私の一族を滅亡に追い込んだ連中に「私たちはまだ終わっていない」と教えてやるためだ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "正直、あなたのその義勇に満ちた意気軒昂な発言に、嫌気がさしてきましたよ、アンソニーくん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "だがまあいい……何があろうと、あなたはここから出られない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "慌ててあなたを倒さなくとも、時間はすでに充分稼ぎました。ほかの看守も封鎖を解いて急いで駆けつけてくる頃でしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "あなたも、あなたのお仲間たちもここまでよくやりました。この結果になったのはあなたのせいではありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "ただこの大地には、思い通りにいかないことがたくさんあるというだけの話です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "残念ながら、あなたの脱獄物語はここまでです。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "ほら、死神の足音が聞こえてきましたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "これで本当にお終いなの……？"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_kafka",
      "text": "うーん、どうしようどうしよう……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "残念ながら、死神はしばらく来ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "それにしてもアンソニー、お前は声が大きすぎる……通路の奥にいる私まで響き渡っていたぞ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "……あなたは誰です？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "いや、あなたは……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_136",
      "text": "お前たちの今回の計画は、私ですら少々予想外だったと言わざるを得ないな。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": "avg_npc_136",
      "text": "おかげでほかの看守たちを押さえ込むのにだいぶ時間がかかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_kafka",
      "text": "あれ？　カフカあの人どっかで見たことあるような……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "待て、あなたは――！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_136",
      "text": "ライン生命の警備課主任、サリア！"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "私もお前のことは覚えている、ジェッセルトン。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "あなたのような偉い方に覚えていただけるとは、実に光栄です。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "私の手元まで届く履歴書はそれほど多くないからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "私も、あなたの口から不合格だと言われたあの瞬間は、未だに忘れられませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "それはさておき、非常に興味深いですね。ライン生命の警備課主任であるあなたが、どうしてこのような監獄に？"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "それはお前が気にすることではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "ただ、ここで退場することだけを承知していればいい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "……退場？"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "いやいや、何か勘違いなさっていませんか、サリア主任……いえ、サリア。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "あなたの能力は、幾分か私と似通ったものとお聞きしていました。しかし確認することなく、門前払いされてしまいましたね……"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "あの時から、あなたが本当に私よりも強いのか、少々疑問を抱いていたのですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "今ようやく、それを確認する機会がやってきたようです。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "ふんっ……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_kafka",
      "text": "彼女の手の色も変わった！"
    },
    {
      "type": "dialogue",
      "speakerName": "ロビン",
      "speakerId": "char_451_robin",
      "text": "白くて……綺麗。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "お前のアーツは、確かに少しばかり私と似ているようだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "しかし……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "あの時はお前に言ったはずだ、ジェッセルトン。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "お前は現状に満足しており、物事をやり抜く意志を持っていない。私の部下にそんな奴は必要ない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "お前は器が小さすぎる、と。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "くそっ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "お前が、今のようにやり抜く意志のない軟弱者のままである限り、何度来ようが私は拒否する。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "そこをどけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "サリアァァ――！！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "どけと言っただろう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェッセルトン",
      "speakerId": "avg_npc_137",
      "text": "サ……リ、ア……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_kafka",
      "text": "つ、強すぎる……"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_kafka",
      "text": "警備課の主任がすごいって聞いたけど、これはヤバすぎでしょ……"
    },
    {
      "type": "dialogue",
      "speakerName": "カフカ",
      "speakerId": "char_214_kafka",
      "text": "彼女を怒らせたのがカフカじゃなくてよかったよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "ありがとうございます、ミ……ミス・サリア。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "ああ。まだ動けるなら、このまま先へ進むぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "だがその前に、一つ聞きたいことがある、アンソニー・サイモン。"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "どうぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "フェルディナンドという名を聞いたことがあるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "アンソニー",
      "speakerId": "char_264_Mountain",
      "text": "フェルディナンド……確か父からその名を聞いたことがあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "speakerId": "avg_npc_136",
      "text": "そうか……やはり奴の仕業だったか。"
    },
    {
      "type": "sceneBreak"
    }
