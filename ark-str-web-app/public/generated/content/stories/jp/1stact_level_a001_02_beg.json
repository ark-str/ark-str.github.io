{
  "server": "jp",
  "storyId": "1stact_level_a001_02_beg",
  "groupId": "1stact",
  "stageId": "a001_02",
  "title": "八方美人",
  "storyCode": "GT-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/a001/level_a001_02_beg.txt",
  "sourceHash": "00d875dae257d28bf6198e6aca3120500ee548e1c9c0e6505defb05b98b38e21",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "あの女を止めろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "止めるってどうやって！　他の全員やられちまったのを見てねぇのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "お前がやれ！　いつもの威勢はどこいきやがった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "お、俺には無理だ！　こいつは例の「厄星」だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（エーギル語）我が前に立ちし者、全てに死を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（エーギル語）我に振るわれし武具、全て砕けん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（エーギル語）己の死を望みしもの、我が前に出よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大尉",
      "text": "何をブツブツと……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "なに？　大尉？　大尉が消えた…？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "クソッ、大尉がやられた！　俺たちのリーダーを川まで吹っ飛ばしやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "こ、こいついまの一撃で……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ああ、あなたたちじゃ聞いても分からないわね……まぁいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "彼女はどこ？　言ったほうが身のためよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "彼女だぁ？　誰のことだ？　お、俺は何も知らねぇ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "ぐわっ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "クソッ、お、覚えておけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "おい！　逃げる前に大尉を川から引き上げろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あ、あの人は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "彼女を知ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "うん。あたしの仲間かも……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "でも、この任務を受けたのはあたし一人のはず。やっとの思いでメテオリーテ姉さんからもらった任務なのに……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ううう……それとも何か他の任務で来たのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "うーん。それより賞金稼ぎたち、みんなやられちゃったみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "じゃあ、今がチャンスだね。ここから出よう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "まぁ、あの人がこの村に来たなら、任務も少しは楽になるかも……今は前向きに考えておこう…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "キャロル、暗いから階段降りるときはあたしに掴まって…。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "うん。それよりさっきの彼女、仲間なんでしょう？　合流とかってしないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "うん、できそうならやってみよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ぎゃあーーーーーーーー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "うわぁーーーーーー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "クソッ、お、俺の鼻が！　なんで扉が勝手に開きやがる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "うわっ？　なんでこんなところに人が寝て――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "グラニ！　何があったの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "てめぇら、静かにしやがれ！　シーッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "……シーッ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "チッ、お前みたいな農民には何にも分かんねぇだろうがな。あそこに「厄星」が居るのが見えねえのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "どんな賞金稼ぎだってあの女にゃ会いたくねえ！　あいつの前で啖呵を切るバカがいるとすりゃあ、あいつが街一つぶっ潰すのを見たことがねぇんからだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "話を盛りすぎだよ！　彼女一人で街一つを潰すなんて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "静かにしろ。見つかっちまうだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "むむむ、あたしはどっちかといえば彼女に会いた――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "バカ、静かにしろって言ってるだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "わ、わかったよ……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "うわぁ、彼女の評判、ロドスで流れてる噂より酷いことになってるみたい……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "あ、あの化け物はもう行ったか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "あ、ああ。行ったみたいだ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "命拾いしたな…。ふう、死ぬかと思ったぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "そ、そうなんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "このくらいの「仕事」なんざ俺たちの部隊一つでもなんとかなるって思ってたけどよぉ……。あんな奴まで現れたとなると、こりゃ手に負えねぇ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "――ちょっと待て！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "えっ。なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "はっ！　お前は槍使いのガキ！　こんなところで会うとはな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "なんだよ村長まで居やがる！　そっちから、のこのこやってくるとはな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "グラニ、もしかしてわざと……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "いやいや、この人たちがあまりにも自然に話しかけてくるから、何だか乗せられちゃって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "グズグズ言ってないでさっさと村長を渡しやがれ！　この刀がお前をズタズタに切り裂いちまう前にな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ふーん。その折れた刀で？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "賞金稼ぎ",
      "text": "……こ、このガキ！　いつの間に槍を……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "合図出せ！　周りの奴らを集めろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "粗暴な賞金稼ぎ",
      "text": "あの虫たちも集めろ！　あのヤバい分泌液で田んぼを壊滅させた力をこいつらにも味あわせてやれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
