{
  "server": "jp",
  "storyId": "story_ashlok_set_1_story_1",
  "groupId": "story_ashlok_set_1",
  "stageId": null,
  "title": "決闘",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_ashlok_1_1.txt",
  "sourceHash": "e5fb83ef2d828807293f7de5c58b6d5154b23f27fee67d2cf84992eb0c9080d9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "解説者",
      "text": "見事な一突きだ。ボレスワフ家の若様は、かつての仲間にも一切容赦がない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解説者",
      "text": "しかし、保守的な戦法では轟く火砲を防ぎきれない！　灰毫騎士は再び盾で攻撃を受け止め、逆に相手を会場の隅へと追い詰める！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解説者",
      "text": "ご視聴中の皆様！　騎士たちのエキサイティングな試合をお楽しみになる際には、どうぞお手元のボタンでお好きな選手に応援のベットをすることもお忘れなく！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解説者",
      "text": "ここカジミエーシュでは、一晩にして大富豪となるのも夢ではございません！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "グレイナティ、今がチャンスだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "私の前に立つということは、お前も覚悟を決めたのであろう。まさか、数度剣を交えただけで、もう後悔したのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "友人の頼みを聞くと思って――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "私を殺してくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二週間前"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "いけ！　防具の隙間を狙え……いいぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "声を落とせ、ジョーイ。みんながこちらを見てるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "酒場で中継の観戦するのに、そんな気ぃ遣ってどうすんだよ。俺は感染者が向こうの貴族様をぶちのめすのを応援してるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "あっ……これは別に当てつけのつもりで言ってるわけじゃないからな？　なっ、グレイナティとアルベルト？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ロゲは最近勝率が高いな。インタビューで言ってた「アーツを使って戦い方を変える」ってのも、ただのハッタリじゃなかったみたいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "それに比べてオズ家の跡継ぎときたら、褒められるところなんて、スポンサーが提供した新型のパワーブーツくらいなもんさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "王手だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "やるじゃないか。毎日かかさず新聞を読むことが本当に役に立つとはな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "当然だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "はぁ……降参だ。お前どう見ても「子供の頃に何回かやっただけ」のレベルじゃないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "暇を持て余した親戚が大勢いたからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "あのナイトの駒を守ることに固執していなければ、お前にもまだ勝ち目はあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "なあ、お前たち、もっと酒場らしいことしないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "あの二人がボードゲームで戦術思考を鍛えるのは、今に始まったことじゃないだろ。それよりお前は反省したらどうだ？　この前の予選で、どうして相手にいいようにあしらわれたのかをな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "おい、そりゃないぜ。俺はお前らみたいに、小さい頃から専門的な訓練を受けてきたわけじゃないんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "俺は大騎士領で小さな店を借りたかっただけなんだ。まさかそれを叶える途中で感染するなんてな。騎士競技は金払いがいいから、金が貯まったらさっさと引退するさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お話の途中にすみません。灰毫騎士でいらっしゃいますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ああ、私だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "どうも、『ザ・レッドワイン』の記者です。先日あなたの仮住まいに取材依頼の手紙をお送りしたのですが、どうやら少し行き違いがあって届かなかったようで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "個人的に、あなたの試合でのご活躍には大変期待しておりまして、騎士メジャーを制する実力も十分にお持ちだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "それはどうも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "それでですね、試合でのご活躍もさることながら、観客たちはあなたのプライベートな生活にも興味があると思うのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "あなたがよく来るこの酒場のことや、普段はどのように訓練をされているのか、そして……カリスカ家があなたを追放した経緯についても知りたがると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "私の私生活は、あなたが想像するほど面白いものではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "あなたはご実家に恨みを抱いていると伺いました。勝ち目の薄いメジャー優勝を狙うより、新聞の一面トップ記事のほうが騎士競技の観客を煽り、あなたの影響力を高めることができますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "なにせ、物語を嫌いな人はいませんからねぇ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "荒唐無稽なゴシップでも何でも好きに書けばいいさ。私は気にしない。今日は試合のない日なんだ。他に用がないなら、友人とゲームを続けたいのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "そうですか。お邪魔しました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "感動したぜ、グレイちゃん。俺たちのためにあの『ザ・レッドワイン』の取材を断るなんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "不幸にも感染し、家族と決別して、一人で大騎士領へ……そんな悲劇のヒロインを演じれば、試合で火砲をぶっ放すより簡単に注目を集められるのにな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "我らが戦う場所は、インクの染みた紙切れの上ではない。近道を求めてしまえば、騎士として最初に大切にしていたものを失うことになるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "アルベルトの言う通りだ。見て見ぬふりをするカリスカ家の連中は確かに憎いが、自分の素性を売り物にするのはもっと嫌だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "『ザ・レッドワイン』の別冊で最近新しいコラムが始まったんだ。各家からの支持と資金援助を得るため、貴族出身の競技騎士のインタビューを専門的に載せているらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "歴史的な地位で言えば、カリスカよりアルベルトの家のほうが家格は高いだろ。それなのになんであの記者は――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "いてっ！　何すんだ……ゴホン、お前に気づかなかったとは、見る目がないなと言いたかったんだよ、アルベルト。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ハハハ、悪徳記者に付きまとわれなくて運が良かったよ。高潔にして清廉なボレスワフ家に感謝だな。たいした財産は残っていなかったが、その分面倒ごとが少なくて子孫としては助かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ゲームを続けよう、グレイナティ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "防具に気をつけろよ。その距離で火砲を撃てば、自分も傷つく可能性がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前にとっては遠距離戦のほうが有利だな。さて、俺はこの厄介な問題をどう解決すべきか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "手合せをしている時のお前は、本当に一言も喋らないよな、グレイナティ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ならば……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "あなたの速さでは間に合わない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "私の弾倉は……空だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "すまないな。問題を解決できない以上、お前の「悪い癖」を出させるしかなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "灰毫騎士と模擬戦をするほどの実力が自分になくてよかったと、毎回思うよ、ロバート。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "ああ、俺もそう思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "訓練の邪魔をするな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "うわっ、空砲でも結構な威力だな。スラムの壁を見ろよ、またぶっ壊れそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "コホン、補強の費用は私が出す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……先週の試合の賞金が振り込まれたらな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "この程度の破損なら、廃レンガと合成接着剤で直せるぞ。実家の庭を抵当に入れる前は、この方法で補修していたからな。費用はそうかからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "だが、作業を始める前に、まずはこの砲声に引き寄せられた小さなお客さんの相手をしないとな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の少女",
      "text": "か、灰毫騎士さん……よかったら、サインをいただけませんか？　あなたの試合は、全部見て……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の少女",
      "text": "あ、その、ほとんどはラジオ中継で聴いてるんですけど……ごめんなさい、訓練の邪魔はしたくないので、やっぱり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "邪魔ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "名前は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の少女",
      "text": "ダイアナです！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "書けた。応援に感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者の少女",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "まだ何か用か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ダイアナちゃんは、どうして灰毫騎士のことが好きなんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダイアナ",
      "text": "か、火砲がカッコいいからです！　友達はいつも、レイピアのほうが騎士らしい武器だって言うんですけど、私は盾と火砲だってすごいと思います！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダイアナ",
      "text": "それに、黒い服の人たちが居住区を襲った時に灰毫騎士さんがみんなの前に立って、私とパパとママを守ってくれたんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダイアナ",
      "text": "あと、あと……私も背がちっちゃいから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "そ、そうか……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ここまで熱心なファンなら、灰毫騎士さんも火砲の薬莢を一つくらいプレゼントしてくれるんじゃないか。な？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダイアナ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "持っていけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "またサインが欲しくなったら、ここに来るといい。ただ……訓練中の騎士もいるから、怪我しないように気をつけろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ダイアナ",
      "text": "ありがとうございます！　また絶対に来ます！　試合、頑張ってください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ったく、ファンたちは、こんな朴念仁のどこがいいのかね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "礼を言う、アルベルト。あなたは子供の扱いに慣れているんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "甥や姪とは仲がいいからな。幸い、あいつらは私の熱心なファンでいてくれている。でなければ、さっきの子と同じようにお前の試合での活躍に心を奪われていたかもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "アルベルトのファンだって多いじゃないか。お前の物腰柔らかくて古風な騎士って感じが好きなんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "敵同士になったって、命乞いすれば、ボレスワフの若様なら情にほだされて見逃してくれるよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "いいや、それは違うな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "アルベルトはどの試合にも全力を尽くす。相手を尊重し、そして自らの信念も尊重する男だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "褒めてもらえるなんて、光栄だな。お前との対戦が楽しみになってきたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "その時には手加減はしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "これからロバートの試合を見に行くって話だったのに、なんでお前ら二人が対戦の約束してるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "いいんだよ、別に。俺なんて生き残れるだけで御の字だしな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "すみません、どなたがアルベルト・ボレスワフ様でいらっしゃいますでしょうか？　お手紙です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "私だ。ご苦労。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ファン",
      "text": "サインありがとうございます！　これからも応援してます！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "お前ら、最近アルベルトの様子が少しおかしいと思わないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "お前さては嫉妬してるんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "そうだよ！　なんで数回試合しただけで、あいつにはファンがあんなに増えるんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "例のコラムを読んでないのか？　家柄を自慢する下品な記事が並ぶ中で、アルベルトの騎士道精神に関する解釈は、人の心を揺さぶるものだったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "だが、ボレスワフ家の信念は、大半のカジミエーシュ人にとっては受け付けないものだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "はっ！　お前もあいつに嫉妬してるのか、ロブ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "そういうわけじゃない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "アルベルト、最近のお前は試合中にがむしゃらすぎるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "少しばかり自分を追い込んでいるだけだ。私の目標もお前と同じ、メジャー優勝だからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貴族騎士",
      "text": "実に見事な試合だった、アルベルト・ボレスワフ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "貴族騎士",
      "text": "君はもっと晩餐会に顔を出すべきだ。ボレスワフ家にはもう跡継ぎがいないものとばかり思っていたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お気遣いいただき感謝します。以前は家業に追われ、宴席に顔を出す暇もありませんでしたので。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "貴族騎士",
      "text": "次は執事に招待状を取りに来させるといい……ああ、大変失礼。ボレスワフ家にはもう使用人がいないんだったな。申し訳ないが、ご自分で私の従者のところまで取りに来ていただくしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……ご配慮、感謝いたします。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "今みたいな言われようでも怒らないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "あの程度の皮肉など、どうということはない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "ボレスワフ様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "すまない、この後まだ用事があるんだ。また後でな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "あいつ、最近は興行試合の誘いが増えて、結構長いこと俺たちと一緒に訓練してないよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "あれは『ザ・レッドワイン』の記者だ。まさかアルベルトは……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "自分でうまく対処するだろう。心配はいらない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "まあそうか。あいつはこの前、遺産相続で揉めた時も何も教えてくれなかったしな。あいつと甥たちが屋敷を追い出されそうになった話は、シーズンが終わってから知ったくらいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "まあま、飲みに行こうぜ！　グレイナティが大丈夫って言うなら、きっと大丈夫だ。アルベルトのやつも、疲れてるだけかもしれないしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロバート",
      "text": "はぁ……そうだな。大体本当に何かあったとして、俺たちに何ができるって言うんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジョーイ",
      "text": "お前はいつになったらそういう悲観的な考え方をやめられるんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "……では、お約束通りということで、ボレスワフ様。契約はいつでも有効です。どうぞお忘れなく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "記者",
      "text": "もっとも、私が申し上げるまでもなくお分かりでしょうが、重要な試合ほど見応えがあるというもの。例えば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "商業連合会が提示してくださった契約は全面的に信頼しています。ただ、もう少し準備が必要でしてね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "盗み聞きをするなら、盾と火砲は置いてくるべきだったな、グレイナティ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前が私の説明を待っているのはわかっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ジョーイがいつ飛び出してきて、あなたのその狂った頭をぶん殴るかわからんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前は一人で来たはずだ。心配させたくないだろうからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "そして、あなたの決断が友人たちに不利益を与えることは決してない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "信用してくれて、感謝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "だが、それはあなたが自分自身に何かバカな真似をするつもりだということだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ふと思い出したんだが、両親から家を託されて以来、私はまだ一度も友人をボレスワフの屋敷に招いたことがなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "灰毫騎士、私の最初の客人になってはくれないか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "子供の頃、父はこの庭で私に剣術を教えてくれた。ボレスワフ家は裕福ではないが、我が家の信念を貫き通せば、こちらを軽んじてくる権力者にも打ち勝てると常々言っていた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "両親が亡くなった後、家業を守るため、私は競技騎士になった。本戦直通の「手数料」は払えなかったため、予選から勝ち上がり、その過程でお前たちとも出会った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "ロバートは最初、あなたが私たちを本当の友人として見ているとは信じていなかった。あなたは貴族の生まれで、感染者でもなかったからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "私もかつては品性に欠けた考えで自分を慰めていた――感染者騎士の境遇に比べれば、私が直面していることなど、ずっと楽なものだと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "しかし家の状況は日に日に悪くなり、両親から託された重責を無視することはできなかった。私は忘れ去られた一族を復興させ、より多くの人々にボレスワフの名を覚えてもらわなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "優勝は我々共通の目標だ。優勝すれば私はカリスカ家に自分が一族の恥ではないという証明ができ、お前もまた、より多くの支持を得られる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "だが、私はもう疲れたんだ、グレイナティ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "どれだけ試合に出ても、たった一つの記事の影響力には及ばない。買い戻したこの庭がその証拠だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "記事がもたらす効力は長続きしない。それに頼り切ってはいけないぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "その通りだ。だから私は、ある決断をした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "予選最終戦、我々の試合で――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "灰毫騎士、お前にその試合で私の命を絶ってほしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "気は確かか！　あなたは自分の命で商業連合会と取引をしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "彼らなら私の理想を叶え、ボレスワフ家に栄光をもたらすことができるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "我々の戦う場所は紙切れの上にはないと言っただろう。最初の信念を忘れたのは一体どっちだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "銀行から破産通知書が届いたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "何だと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "もう時間がない。支持者たちがもたらしてくれるのは微々たる慰めに過ぎず、ボレスワフ家の没落は避けられない事実なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "新聞を読むのは子供の頃からの習慣でね。選手情報を集めるだけでなく、自分に関する報道、ボレスワフ家に関する報道もチェックしている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……なぜそのような形ばかりの評価を気にする？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "家族に恩があるからだ。私は代々受け継がれてきた騎士の規範も認めている。家の期待と守ってきたものが私の代で消えてしまうのは嫌なんだ。たとえそれが形ばかりのものでも私は背負いたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "よく考えてみろ、グレイナティ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "確かにカリスカ家はお前を追放し、そのためにお前は一族を恨んでいると誰もが思っている。だが、カリスカ家の中に、お前の尊敬に値する者や、恩を受けた者は一人もいなかったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "祖母",
      "text": "盾を構えて、砲を向けて、撃つ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖母",
      "text": "グレイナティ、お前は良い若芽だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "祖母",
      "text": "カリスカ家の家訓を忘れないように――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "私は、家の者のために何かをしてあげたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "命を捧げることは怖くない。だが、いつか新聞売りの前で、『古き騎士の一家――最後の継承者アルベルト・ボレスワフの手により終焉を迎える』などという記事を目にすることが怖いんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "そして、そのニュースすら誰にも知られないまま消え去ることが、もっと怖い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "グレイナティ、我が友よ。お前がすべてに終止符を打ってくれるのなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "だめだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "来る試合は真の騎士の決闘となる――カリスカの火砲と、ボレスワフの剣のな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "我々は悔いなく戦う。私は最後の願いを叶え、あの忌々しい貴族のボンボンたちのボレスワフ家への嘲笑を忘れることができる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "だめだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "記者は私の訃報を記事にして一面に載せるだろう。契約によれば、ボレスワフ家は再び使用人と家庭教師を雇うことができ、甥と姪が学業を終えるのも援助してもらえることになっている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "彼らは胸を張って成人を祝う宴に参加し、自らの志で道を選ぶことができるようになるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "あなたの思い描くボレスワフ家は、今のカジミエーシュの貴族と何も変わらない。あなたは本来、そのすべてを変えるべきだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "であれば、なぜお前はまだその火砲を持っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "この問いに答えられないのなら、お前は私を理解できるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前が私との対戦を拒んだとしても、私は本戦で幕引きを求めるだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "命と引き換えにすべきではない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "わかっている。だが今となっては、これが私の出せる一番値打ちの高いものなんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "解説者",
      "text": "おっと！　今の一撃は相当な威力ですね！　皆様も私と同じように気になっていることでしょう。小柄な灰毫騎士は一体どのような訓練を経て、あの重い盾をかくも軽々と扱えるようになったのか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解説者",
      "text": "さすがに古式剣術に長けた貴族の末裔と言えど、感染者騎士が地下競技場で千回も万回も鍛え上げてきた戦闘技術を防ぐことはできないようだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解説者",
      "text": "ボレスワフ家の騎士が倒れた！　皆さん、彼女にどうか熱い歓声で祝福を――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "解説者",
      "text": "待ってください……私の見間違いでしょうか……騎士の信条と家の栄誉を背負うボレスワフの子が、再び立ち上がりました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ゴホッ……軽すぎる。まだ、軽すぎるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "本来すべき選択から逃げるつもりか？　お前もあの無能な貴族どもと同じように、私の覚悟を軽んじるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "私がどのような理想のために今日まで戦ってきたか、お前は知っているはずだ。それなのにお前は冷酷にも、栄光へと続く道に立ちはだかるのか。私の頼みは一つだけなんだ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前の火砲を使ってくれ！　グレイナティ・カリスカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "南部林業の開拓者にして支配者であるカリスカが、いかにして火薬で栄誉ある家名を築き上げたか、皆に見せてやれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "お前がどれほどの嘲りと不公平に耐え、騎士メジャーの入り口にたどり着いたか、皆に見せてやれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "はぁ……はぁ……皆に見せてやる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "ボレスワフ家にまだ騎士の栄誉を心に抱く高潔な者がいることを……その者の最後の結末を見せてやる……その者は、家のために消えゆく蝋燭の火を灯すのだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沈黙の騎士は己の武器を構え、力尽きた友人に砲口を向けた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "やっとか……グレイナティ、お前がそれほど冷酷ではないとわかっていた。我々の約束を果たしてくれるはずだと信じていたよ。はぁ……はぁ……お前は友人の頼みを断ったことがないからな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……どういうことだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "私の弾倉は空だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "グレイナティ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "あなたは以前私に約束したな。この試合を真の騎士の決闘にしようと。双方が胸に秘めた未だ叶わぬ理想のために全力を尽くし、手加減も後悔も残さないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "あなたが倒れる前に、私は最後の一発を撃ち尽くしていた。とっくに気づいていたはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "私に斬りかかってきた時、何を考えていた？　古き騎士の信念か、それとも家のために身を捧げる自己陶酔か？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "私はあの問いの答えを見つけた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "祖母から授かった火砲術は確かにカリスカのものだ。私がそれを捨て去ることは難しいかもしれない。だが、その砲口を新たな敵に向ければいい。それは、私にだってできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "これは私の信念だ。家のものじゃない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルベルト",
      "text": "グレイナティ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "あなたはもう立てない、アルベルト。勝負は決した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "トップニュースと家の栄誉のことは忘れるんだ、そして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "自分のために生きろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "お嬢さん、新聞をずっと眺めてるけど買うのかい？　買わないのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "……買う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "毎度あり！　別冊も一冊どうだ？　誰も知らないゴシップや裏話が全部読めるぞ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイナティ",
      "text": "見舞いに行くんだ。神経を逆撫でするようなゴシップは持っていかないほうがいいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "件の競技騎士二人は裏で色々あったらしいぜ。一人の家は正式に破産宣告して、もう一人は陰で感染者を助けてるって話だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "世の中も変わったもんだな。いつから貴族が感染者の生き死にを気にかけるようになったんだっての。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "感染者同士で身を寄せ合ってるんなら、筋は通るんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "そりゃまあ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "おっと、先ほどは気づかず、すみません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "気にしないで。新聞を一部ちょうだい。競技場のニュースを知りたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "どうぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "今日の売れ行きは上々だな。店じまいしたら、また競技場で一賭けするか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "新聞売り",
      "text": "にしても……気づかないうちに大騎士領には随分ザラックが増えたな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
