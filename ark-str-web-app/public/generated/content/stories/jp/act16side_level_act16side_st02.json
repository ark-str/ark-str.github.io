{
  "server": "jp",
  "storyId": "act16side_level_act16side_st02",
  "groupId": "act16side",
  "stageId": "act16side_st02",
  "title": "アイリス",
  "storyCode": "GA-ST-2",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act16side/level_act16side_st02.txt",
  "sourceHash": "e4dc8ef59c26214c0893c51aa86f0aaf27546bfa3e2075f1792db4e1059645e8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "今回の訪問はもういっそバカンスにしちゃえと思ってたけど……まさかこんなことが起きるなんてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ねぇユカタン、イェラグも同じ信仰ある小国よね……どうしてこの国はこんなサミットが開けたのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ラテラーノの影響力はかなり広範囲に及ぶし……教皇が築き上げてきたレガトゥス制度もあってのことだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "イェラグにはそういう基礎がないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "はぁ……影響力ね。イェラグを出て初めて気付いたけど、影響力ってほんと面倒よね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "今思うと、エンシオディスの奴はよくもまあ一人でいくつもの隣国相手に立ち回ってたものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "僕たちには僕たちの強みがあるさ……巫女様の影響力だって徐々に高まってきているし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そうね……そういえば教皇が言ってたあれ、実現できると思う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "……どうだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "各国が密接な関係を維持できたとして、この大地がどうなるかなんてまったく想像できない……夢みたいな話だし、それが良い夢とも限らないし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "でもあの日起きた奇跡を……教皇の演説をなかったことにできる人なんていないだろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ラテラーノは、やっぱり神に愛された国……だったのだろうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ねぇエゼルさん、あなたたちサンクタは一連の出来事をどう思ってるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "え？　あぁ……はい、かなり衝撃を受けました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そうでしょうね、あの鐘は数千年鳴ってなかったらしいし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "ラテラーノはこれからどうなっていくのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……何も変わらないのかもしれません。僕の思うラテラーノ人は……いや、おそらくどこの人も同じで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "後世に語られる重大な歴史的事件が起こったとしても……その時その場に居合わせた人たちには、何の実感も湧かないものなんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "ですが僕たちは変化が起こっていることを自覚して、自らの責任と使命を担っていくつもりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "……あなた、なかなか責任感があるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "さてと、見送りはここまででいいわ。迎えの車がここまで来てくれるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "お疲れ様です。わざわざありがとうございました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "いえ、お気になさらず。どの道、近くの病院にいらっしゃるヴェルリヴ枢機卿のもとへ報告をしに行くつもりでしたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "あっ、その枢機卿にもお礼を言っておいて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "「満足いただけたなら幸いです」――と返事を預かってます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "抜かりのない人ね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "そうだ、エゼルさん、私と夫の記念写真を撮ってくれないかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "ええ、喜んで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "これでいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スキウース",
      "text": "なかなか上手に撮れてるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユカタン",
      "text": "ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "恐縮です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "フィアメッタ、なんか足取りがすんごく重くなった気がしない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "教皇聖下があんな大演説をしたってのに、重荷に感じないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "重荷だったらなんなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "だから真面目に転職を考えてるんだよね。こんなに責任感を求められる仕事、私には合わないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "私の代役には君がピッタリだと思うんだけど、どうかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "バカ言わないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "お二人とも、こんにちは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "エゼルくん、久しぶりだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "二週間も経ってませんよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あなた……任務中？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "いえ、ヴェルリヴ枢機卿に任された仕事を終えて、報告に行くところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "これが僕のラテラーノでの最後の仕事になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いいねぇ、エゼルくん。外に出てみたら、ラテラーノも結構退屈なところだったって気付くはずさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "外にはラテラーノほどおいしいスイーツがあるわけじゃないけど、私たちもただ楽しむために生きてるわけじゃない……そうでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ヴェルリヴは今どこに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "ステファン区中央病院です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "よし、目的地は同じみたいだし、一緒に行こっか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "もう決めたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "うん、決心した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "もうしばらく悩むかと思っていたのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "そんな大げさなことじゃないわ……ただ、みんなもう次の一歩を踏み出してるし、私も足踏みしてられないなって思っただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "そう。それならもうこれ以上詮索する必要はないわね。いい返事が聞けて本当に良かったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "こんな時期に、あなたみたいに優秀な人に加わってもらえてなによりよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "やぁ、ヴェルリヴ。やっぱりここにいたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "あら、あなたたちどうして一緒に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "ここに来る途中で会ったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "イェラグの使者二名ですが、無事目的地まで送り届けました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "お疲れ様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "ああちょっと待ちなさい。私だってただレミュアンに会いに来たわけじゃないの。一緒に来てちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "それじゃあね、レミュアン。また来週。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "うん、また来週ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "レミュアン、第七庁に行くのはもう決まり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "もうとっくに教皇庁のために働いてるでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……サミット後の第七庁は相当忙しくなると思うけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "でも、私にお似合いだと思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "まあそうだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あなたたちも自分の道を歩き出したんだから、私も自分にできることを考えないといけないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "それで、さっきフィアメッタには言ったんだけどさ、私レガトゥスを辞めようと思うんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "面倒臭くなっちゃった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "だってあのヒゲ爺さんったらさ……もう面倒事が増えてく未来が見え見えだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "逃がさないわよ。あなたは私の管轄に入るんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "えぇ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "さっそく一つお願いだけど、この手紙をエルまでよろしくね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……断ってもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ダメよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それと、絶対にあの子に直接渡すこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "なおさら辞めたくなるんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "また天邪鬼なこと言って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "フィアメッタは厳しいなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あなたが辞めるはずないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "何を根拠に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "いつもこの仕事は合わないって言ってるけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あなたも答えを探してる。違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "そんなアンドアインみたいなことしないよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "そういうことじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "だってあなたも、まだ自分が何者かを選べてないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "その答えを出すためには……誰もが長い道を歩むことになるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "あら、モスティマ、人に理解される気分はどう？　光輪がなくてもあなたを理解できる人がいたわね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……だとしたら、それは私の道だよ。フィアメッタが付いてくる必要なんてないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "うぬぼれないで、誰があなたに付いていくって言ったの？　たまたま道が同じなだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "あいつの銃は私が持ってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "もしあいつがまだ本気で自分のことサンクタだと思ってるなら、必ずこの銃を取り返しに来るわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "その時に、自分がやったことのツケを支払わせてやるのよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "だからあなたはその手助けをしなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "……はいはい、わかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "その話で思い出した。街で捕らえられた迷い人たちは、全員釈放されたみたいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……教皇聖下のお考えなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "でも私のやることは変わらないわ。教皇聖下の慈悲深さと私は関係ないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "……ほんとフィアメッタらしいわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "そうだ、あなたには第五庁で手続きしてもらったあと、公証人役場の協定書を使ってロドスに行ってもらうことになるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "えっ、ロドスってあの、モスティマとレミュエルが兼職してる製薬会社よね……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "ヴェルリヴがあの会社との関係を深めたいらしくて、あなたがピッタリの人選なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それに私の知る限り、うちとあの会社は今でもかなり良い関係を築けてるみたい。きっとあなたをたくさんサポートしてくれるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それからそれから、もう一つと〜ってもうれしい知らせがあるわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "今ならなんと！　次の任務のコードネームは、三つの候補の中から好きなのを選べちゃうの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……ねぇ、あなたが私たちの担当になるなら、そのルールを撤廃してもらえたりはしないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "元々はモスティマを監視する役職の名称がなかったから一時的に付けただけであって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "毎月役職名が変わるのにはもううんざりなのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "幽光の夜警は気に入ってたでしょ。お偉いさんのセンスもようやくマシになってきたとか言って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "黙りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "あっ、きれいなお花だねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "そう言われても……ずっとこうしてきたんだから、あなたの役職名が変わるのも慣例になってるのよ。まぁ諦めてちょーだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レミュアン",
      "text": "それで候補は「虚空の美食家」、「荒野のパイロット」、「黎明破壊者」の三つよ。さぁ選んで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "……「黎明破壊者」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "モスティマ",
      "text": "いやぁフィアメッタ、君の好みってほんとわかりやすいよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィアメッタ",
      "text": "黙りなさい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "うう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "目が覚めた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……起きてすぐ見る顔がお前かよ……最近ほんとついてねぇな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "あら、横になってるだけじゃ物足りないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "いや、聞かなかったことにしてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "お？　エゼルも来てんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "ええ、ラテラーノを裏切ろうとした人の末路を見せてあげたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "えっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "若者いびりもほどほどにな、ヴェルリヴ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "私も若者よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "すいませんでした……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "あなたはもうレガトゥスではなくなったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "そうか。まぁそのくらいの代価は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "だけど、まだ私の部下のままよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "そいつはでけぇ代価だことで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "私に向かって大口を叩いたからには、あなたがヴィクトリアで何を学んできたかよく見せてもらうわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……つまり、今後も俺のやり方で事を運べってことか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "今なら、このあいだの質問に答えてあげてもいいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "オレン、私は高尚な人になることに興味なんてないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "だけど、高尚な人のために努力するのは嫌いじゃないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "それは……俺も同感だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "枢機卿、それは僕にも言い聞かせてるんでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "もちろんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "あなたとセシリアに与えられたチャンスを大事になさい。あの子がラテラーノに……何か影響を与えることのないようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリアには……もうラテラーノに帰ってきてほしくないということですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "もしそうなら、なぜ私がわざわざ時間を使ってあの子に戸籍を作ってあげるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "……もちろん同情なんかじゃないわ。重要なのは……あの子には特別な価値があるということよ。その価値のためなら、私は喜んでリスクを背負うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "エゼル、ヴェルリヴがこうもはっきりと約束をしてくれたんだ。逆に疑いたくなる気持ちもわかるが、お前にゃメリットしかねぇよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "はい、わかってます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "そう固くならなくていいわ。私はただ、あなたにラテラーノの誠意を示しただけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "いつか旅に嫌気が差したなら……ラテラーノに戻ってきても構わないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "ラテラーノの門はきっと開かれるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "フェデリコ先輩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "枢機卿ヴェルリヴ殿、こちらが元レガトゥス、オレン・アルジオラスの過去二年間の外出記録報告書です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "お疲れ様、執行人フェデリコ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "げっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "念のためにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "これまでの情報をまとめると、執行人リケーレが彼の共犯者であると推測されます。リケーレを呼び出しますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "いいえ、結構よ。彼はきっと「旧友に騙された」とでも言うでしょうから。そうでしょう、オレン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……恐ろしい女だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "リケーレは追及しない……今のところはね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "だけど、後ほどあなたを通して彼と話させてもらうわ。いいわね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "へいへい、わかりましたよ、っと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "現状この二人に対する処遇はこの通りよ、執行人フェデリコ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "おい、フェデリコ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "何でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "あれから考えてたんだが、お前はノートに残ったほんのわずかな言葉を頼りに、サルカズと会っていた女性がフェオリアだってことまで突き止めただろ。あれは相当骨が折れたはずだぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "その執着はどこから来るんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "お前は一体誰を追っている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……アルトリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "アルトリア……ん？　アルトリアだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "あの指名手配犯の？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……フェデリコ、お前アルトリアとどんな関係だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "彼女は私の遠い親戚です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……フッ、ハハハハハ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "なぁ、フェデリコ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "こんな状態じゃなけりゃ、今すぐお前と飲みにでも行きたいところだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私にそんな時間はありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "いや、ないとは言わせねぇぜ。なんたって俺は数年前……あのアンドアインよりもずっと有名な指名手配犯――ミス・アルトリアと実際に会ってるんだからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴェルリヴ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "落ち着け！　落ち着けって！　な、ヴェルリヴ！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "俺から会いに行ったんじゃねぇよ！　たまたま出くわしたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "……正直、俺もそれなりに色んな経験をしてきたと自負してるが、あの時のことだけは……思い出すだけでゾッとするぜ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "どこで会ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "オレン",
      "text": "三年前、リターニアでだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "エゼルお兄ちゃん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "リケーレ先輩……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "諸々の手続きは済んだ。その子はもう自由にラテラーノから出られるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "リケーレ先輩、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "当然のことをしたまでさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "次にやることはもうわかってんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "はい……フェデリコ先輩と合流した後、ロドスという会社に向かって協力協定を結びます。ラテラーノ外で長い間活動することになるので……その方が都合がいいらしいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "よし、わかってるならいいさ。もうロドスに話はつけてある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ロドスに行ってもお前は公証人役場の執行人のままだからな。こっちまで戻ってくるのが難しい時は、ロドスを通じて任務が通達されるはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "お前とセシリアちゃんの旅は順調に行く予感がするぜ。尋ね人もすぐに見つかるかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "俺の予感はよく当たるんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……えーっと、ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "じゃあ俺はもう行くぜ。セシリアちゃんもまたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "バイバイ、リケーレお兄ちゃん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "ハクションッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リケーレ",
      "text": "うえ……なんだか急に嫌な予感がしてきたな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "リケーレ先輩も変わった人だなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……あれ？　おかしいな、先輩はどうして僕たちが人を探してるのを知ってるんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "エゼルお兄ちゃん、どうしたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "いや、なんでもないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "まだ何か……言い残したことはない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少女が若いサンクタの手を放し、花畑の中央へ向かう。"
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "（ママ、わたしラテラーノを出るよ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "（でも逃げるんじゃないよ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "（パパを探して、ママの言葉も伝えるからね）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "（自分の目でこの大地を見て……カズデルを見つけるんだ）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "（ママ、わたしは幸せだよ。これまでも、これからも……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "（だからずっとわたしを見ててね）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "お姉さん、白いお花を一本摘んでもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "修道士",
      "text": "ええ、どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ありがとう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、そのお花を持っていくのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "そのままじゃすぐにしおれちゃうよ……押し花にしてあげようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "うん、教えてくれる？　自分でもできるようになりたいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ありがとう、エゼルお兄ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、それはこっちのセリフだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "あれ……あれは……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "パティア、本当に私と一緒に来るのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "もちろんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "君はラテラーノに残ってもいいと思うが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "ラテラーノにあたしの目標はありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "どうしたんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……いえ、なんでもありません。失礼しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "ただ……先導者様……笑ってらっしゃるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "いや、普段笑わないからってことじゃ……でも、なんだかいつもと違う気がして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "私はただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "長い間、我々は荒野の中を孤独に歩いているものだと思っていたが……それは私の未熟さとうぬぼれに過ぎなかったことに気付いたのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "パティア、サミットでのあの老人の演説は聞いたかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……目が覚めた時にはもう途中だったので、後半だけ聞きました。街中のスピーカーから聞こえてたので……ほんと騒々しくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "イヴァンジェリスタ――犠牲と結束の美徳を持つ聖徒……もしかしたら、彼はこれまでのその名を使ってきた十人の先代よりも、さらに遠くへと歩みを進めるのかもしれないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "あれは実に壮大でもろいビジョンだったが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "私は祝福を捧げたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パティア",
      "text": "……あの日、先導者様は一体何を知ったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "それはもはや重要ではないんだ、パティア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "たとえ道の果てに望んだ見返りがなくとも、前進すること自体がかがり火を灯すことになる。だから私はこれからも前へと進み続けるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "我々の成してきたこと、これから成すこと、そのすべては……恩恵の取引をするためでも、同情と引き換えるためでもない。私たちはただ信ずるものを礎に歩み続ける。なぜなら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "それが唯一の、尊厳ある生き方だからだ。そう思わないかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロゼラ",
      "text": "先導者様、そろそろ出発しましょう。日が沈む前に急がねば。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンドアイン",
      "text": "ああ。行こうか、兄弟姉妹たち。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エゼル",
      "text": "セシリア、何を見てるんだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "ううん、何でもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セシリア",
      "text": "夕日、きれいだね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
