{
  "server": "jp",
  "storyId": "act18side_level_act18side_02_beg",
  "groupId": "act18side",
  "stageId": "act18side_02",
  "title": "熱情、あるいは悲愴",
  "storyCode": "LE-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18side/level_act18side_02_beg.txt",
  "sourceHash": "9f6b07c8e6b31aeab102e5e34b296780d0149f657a8e5c7144bf642640b625b1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ツェルニーさんの所では上手くいかなかったけど、ほかのアフターグロー区の住民たちはみんな話を聞いてくれるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "十軒以上の家を訪ねて、血液サンプルもいくつか採取できたし、まずまずの成果かな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "もうすぐ日が暮れそう……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "お嬢ちゃん、今日はずっとこの辺を駆け回って忙しそうだったな。お腹が空いただろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "アフターグロー区の名物はいかがかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "名物？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "ザワークラウトの炒めものさ。ほらよ、この香り、このツヤ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（高温の油で炒めた、塩入りの発酵食品？　絶対健康に良くないよ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "どうしたんだい、ぼったくりが怖いとか？　うちはあこぎな商売はしてないから安心しな。ほら一皿持ってけ、金はいらないよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "遠慮しなくてもいいから。一日中歩き回ってみんなの看病をしてくれてるんだ。これは感謝の気持ちさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（はぁ、これだけ親切にされたら断れないよ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "それじゃあ、ありがたく頂きます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "良いってことよ。たんとお食べ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "どうして一口でやめちまうんだ？　あげたんだから全部食べていいんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "まだお腹が空いてなくって。あとで食べます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ところで……レシピを変えてみようと思ったことはありませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "レシピを変えるだって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ええ、この料理はおおよそ成人一食分の量がありますけど、推奨摂取量の少なくとも三倍の塩分が含まれています。脂質に至ってはさらに多くて、五倍ほどでしょうか。健康には害しかありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "お嬢ちゃん、俺はこの料理を何十年も作ってきたんだ。うちへ食べに来る人はみんなうまいと言ってくれるんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "急にレシピを変えたりしたら、常連に怒られちまうよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "レシピを変えるのも皆さんの健康のためですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ここへ買いに来るのは、私も含めてみんな感染者です。このような高脂質かつ塩分過多の食事による影響は、健康な人よりも感染者の方が大きいんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "一つ訊かせてくれ、俺が作ったザワークラウト炒めは旨かったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……とっても美味しかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "そんならいいんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "でもやっぱり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "もういいんだって。お前さんが俺の料理に満足できないってことはわかったからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "はは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "そうだ、いくつかお尋ねしたいことがあるんですが、いいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "どうせ今はほかに客もいないしな。何が聞きたいんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "最近、ご商売の調子はいかがですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "そりゃあもう忙しいもんさ！　気温が上がってきたせいかね、ここ数日は食べに来る人がますます増えてきてるんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "食べに来る方は店主さんのお知り合いですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "ああ。うちをひいきにしてくれる人は、全員アフターグロー区の住民だからな。みんな知った顔だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "皆さん感染者の方ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "おうよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "しばらく顔を見せていなかったのに、ここ数日また来始めたお客さんはいませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "いるな。言われてみると、割と多いぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "できたら、そのお客さんたちのことを少し詳しく教えていただけませんか？　どういった方たちで、どこに住んでいるのか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "なに、お安い御用だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "最後に……店主さん自身は最近の具合はどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "鉱石病のことか？　まあ普通だな、良くも悪くもない。最近は商売がうまくいってるもんで、毎日の仕込みが楽しくてしょうがないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "音楽にはあまり興味がないようですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "いやぁ、俺は元々そういうセンスはからっきしでね。芸術家連中みたいに高望みはしないし、家族を養うことさえできれば十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "質問は以上です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ご協力ありがとうございました、お仕事頑張ってください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "おう、ありがとよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "だがお嬢ちゃん、結局一口しか食ってないじゃないか。腹は減らないのかい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "その話は……さっき――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "冗談冗談。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "お前さんたち医者は健康第一だからな、俺だってわかってるさ！　だが俺たち料理人はやっぱり味が第一だ。そいつはお医者さんにもわかるはずだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ううっ……わかります、でも賛同はできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "わかってくれたので十分さ。俺たちはどっちも客のことを考えてるだけ、方法の違いを否定しないでくれりゃ問題ない。また食べたくなったらぜひ来てくれよな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "はい……はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "それにしても不思議だったなぁ。あの嬢ちゃんはどうして一口食べた後、泣き出しそうな顔をしてたんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "はぁ、あんないい子が、よりによってサルカズとはねぇ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "おやじさん、ザワークラウト炒めを一つください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "はいよ――って、なんだお前か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "ひき肉のソースを倍、軽く焦げ目ありだな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "もちろんそれで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "さっきの女性はあまり見ない顔でしたが、お知り合いですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "露店の主人",
      "text": "ここのところ、ずーっと街を駆け回ってる子だよ。おかげで顔は覚えちまったな。で、どうした？　お前の店で一杯ごちそうでもしたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "いえいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "喫茶店の店長",
      "text": "あの忙しそうな様子だと、きっと大事な仕事をしてるんでしょう。うちのコーヒーを飲む暇なんてありませんよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "異常回復の症例は、思ってたよりも広範囲に分布してる……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "きゃっ、ごめんなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "大丈夫です。私の方こそすみません。この見事な建築物に夢中で、あなたのインスピレーションを邪魔してしまったようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……インスピレーション？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それでは、また。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "え、はい。さよう……\nなら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（行っちゃった……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（私もそろそろ戻った方がいいかな、広場には人が住んでそうな家もないし……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "おい、そこの女！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（すごくお酒臭い……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "そう、お前だよ、魔族野郎！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "どちら様ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "今、俺の家から出てきただろ、覚えてねぇのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ということは、シュナイダーさんのご家族の方ですか？　先ほどお邪魔した時は、ご不在でしたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "俺は息子だ！　なに勝手に親父の血を抜いてやがる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "ハイビスカス、ハイビスカス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "アンダンテさん、ちょうどいいところに来てくれました。この方が興奮していて、何を言いたいのかわからなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "アンダンテ？　ロドスのアンダンテだな！　さっさとお前らの上司に伝えろ！　この魔族を送り返して、二度とアフターグロー区に近づけさせるんじゃねぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "それは……まず落ち着いて、彼女が何をしたか教えてくれますか。その方が報告書もうまく書けますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "（小声）全然帰ってこないと思ったら……先に事務所に戻ってて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（小声）もう少しここにいます。今回の事件にはいくつか不可解な点がありますし、彼の話に何か手がかりがあるかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "こいつは親父の血を抜いたんだ！　魔族野郎が！　血を抜いた！　これが何を意味するかわかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "その、シュナイダーさんは、恐らくブラッドブルードの噂を聞いたのですね？　ですが私は普通のサルカズで、血に対して何の興味も――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "誰がブラッドブルードの話をした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "おいあんた、言ってやれ！　感染者の血を集める奴が……一体何を企んでるかってな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの感染者",
      "text": "あたし？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "そうだ、あんただ！　早く言ってやれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通りすがりの感染者",
      "text": "いえ、その……用があるから、失礼するわ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "チッ、情けねぇ奴だ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "そこのあんちゃん――あんたが言ってやれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "それは……具体的には俺もよく知らないが、感染者の血を使うアーツを行使する術師がいるってのは、聞いたことがあるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "最近じゃ似たような理由で、高塔の術師が秘密裏に感染者を捕らえているとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "その通りだ！　魔族野郎がわざわざ俺たち感染者の血を集めるのに裏がねぇわけねぇんだよ。絶対に良からぬことに使うに違いないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "感染者の血を集めてアーツを……私の知る限り、いわゆる「巫王派の残党」以外にはいま――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "感染者たち",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ハイビスカスが不意に口に出した一言を聞くと、彼女に絡んでいた感染者たちだけでなく、周囲で様子を見ていた人々も一瞬にして静まり返った。"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "あんた……敬称も付けずかの陛下の名を口にするとは……やはり……何か関係があるんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "そうに決まってるだろ！　予言もそう言ってただろうが。この魔族はきっと感染者の血でアーツを使って、悪さをする気だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "予言？　まさか、かの陛下の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "そうだよ！　例の予言だ！　絶対に、予言を実現させちゃいけないんだ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物好きな感染者",
      "text": "予言だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物好きな感染者",
      "text": "ここ数日私も予言について耳にしたが、いつも曖昧ではっきりと内容を知らないんだ……具体的には何と言ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私もとても興味があります。あなた方は予言のせいにして私を追い出そうとしていますが、私は「予言」の内容すら知りません。そんな状態でここを立ち去れると思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "中身は大きな声では言えないんだよ。かの陛下が何かしらのアーツを遺していないって保証は誰にもできないだろ。俺たちの一挙一動だって、もしかしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物好きな感染者",
      "text": "ひっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物好きな感染者",
      "text": "じ、じゃあ……こっそり教えてくれないか、予言が言っているのは一体何のことなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "はぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "（小声）アンダンテさん、あなたも最近、似た噂を聞きましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "（小声）実を言うと、全く覚えがないわけじゃない。だけど全然気にしてなかったんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "（小声）それにかの陛下はとっくに亡くなっているし、たとえまだ健在であったとしても、わざわざアフターグロー区のために予言を残すわけないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンダンテ",
      "text": "（小声）人が増えてきたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "物好きな感染者",
      "text": "お嬢さん、やっぱり君はここから離れた方がいいよ。それが本当かどうかはわからないけど、用心するに越したことはないからね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "アフターグロー区から出ていけ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "そんな根拠のない噂を信じないでください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "噂だと！？　予言を噂だなんて、あんた――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "そちらの方、私が巫……その残党と関係があると言った舌の根も乾かないうちに、今度は例の陛下に対して不敬って……そんな矛盾した言動で、何を目的に、誰を煽ろうとしているんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "お前らみたいな連中は、そもそも常識が通用しないだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "それに、魔族が一人でアフターグロー区にやってきて、調査という名目でみんなの血を集めるなんて、何をしようとしてるかわかったもんじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "たとえあんたに悪意がなくとも、予言を無視してここに居座らせるようなことはできない。そうだろ、みんな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "見物している感染者たち",
      "text": "そうだそうだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "皆さんがありもしない災いを恐れる理由は知りませんけど、きっとそれは「かの陛下」の名前のせいなんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "でも私にはもっと怖いことがあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "それは、この事件の真相がわからないまま終わることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "ここで私が引いたら、人命を救うチャンスを逃すか、自分の臆病さのせいで皆さんを危険に陥れるかの二択です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "だったら、たとえ感染者の血を操る残忍な術師だと思われようと、災いをばらまく「魔族」だと思われようと……私は構いません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "私はただ、少しでも多くの命を救いたいだけなんです！　アフターグロー区にいる目的はそれだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "嘘を吐くな！　今すぐここを離れる気がねぇってことは、アフターグロー区に残って何か企む気だろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "皆さん、私はここであなた方と対立するつもりはありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイビスカス",
      "text": "もしそこまで私のことを見たくないというのなら、ひとまずロドスの事務所に帰ります。ですから皆さんも一度落ち着いてください、それでいいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酔っぱらった感染者",
      "text": "チッ、まぁとりあえずはそれで許してやるか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "ダメだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "ロドスの事務所がどこにあると思ってるんだ？　あそこもアフターグロー区の一部だろうが！　血を集めて回る悪魔が区内にいるのは変わんないだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "それともなにか。ロドスには治外法権があるとでも思ってんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "俺たちは絶対に認めない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しい感染者",
      "text": "みんな俺に続け、この魔族を追い出すぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "掛け声と共に一部の人々は襲い掛かり、また一部は様子を伺うようにそれを見つめ、残りはハイビスカスに背を向けてその場から去った。\n感染者たちが各々の選択をする中で、ハイビスカスはただその場に立ち、戦うことも、逃げ出すこともしなかった。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
