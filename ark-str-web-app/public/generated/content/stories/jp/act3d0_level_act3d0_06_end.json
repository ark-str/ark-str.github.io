{
  "server": "jp",
  "storyId": "act3d0_level_act3d0_06_end",
  "groupId": "act3d0",
  "stageId": "a003_06",
  "title": "キラークイーン",
  "storyCode": "OF-6",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act3d0/level_act3d0_06_end.txt",
  "sourceHash": "844ff70f1b67ccc66b80d960e1ad447158b049de21084878625832cb0011380f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "え？　いまの一瞬で、ぜ、全員倒したの？　貴方が…貴方がこんなにすごいなんて知らなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "想像したことはあったけど…でも……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "いや、その…ですから…この姿はセイロン様には知られたくなかったというか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "でも本当にすごいわ！　なんてカッコいいの、シュヴァルツ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "うっ……。あの…セイロン様？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "こんなに高く跳べるなんて！　壁を駆け上がり、蹴ったかと思えば空中で身を翻して……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "あんなふうに空中で旋回しただけで、全部の攻撃を避けてしまえるなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "そして身体をひねったかと思えば、タタタンッ、敵を全員撃ち抜いて……！　こんなことって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "セ、セイロン様……そんなふうに仰ると、顔に熱が……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "でも、シュヴァルツ、一つだけ強調しておくわ。さっきのは命令したわけじゃない、お友達としてお願いしただけということを覚えておいて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "貴方も遠慮せずに、わたくしに何でも言ってね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "承知いたしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "あら？　そういうのは良くないわ。さっきも言ったでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "……えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "そんな他人行儀な喋り方はもう止めて！　わたしたち、お友達なんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "えっと……その……わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "フフッ。なんだかスッキリしたわ。では次に、急いでシティホールへ向かいましょう。ドクターたちの状況が少し心配だから……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クローニン",
      "text": "この穀潰し共め、こんな小娘一人止められないのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クローニンの護衛",
      "text": "ですがあれはサルカズです！　それに相手は他に何人もいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クローニン",
      "text": "「何人もいる」じゃない、「何人かしかいない」だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クローニン",
      "text": "鬱陶しいロドスの連中め、何だってここに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "なーんだ、こいつらオリジムシよりも弱っちいみたいだね……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クローニン",
      "text": "早く増援を集めろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クローニンの護衛",
      "text": "ですが、クローニン様……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クローニンの護衛",
      "text": "無理ですよ。勝てません、集めたところで絶対に勝てません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クローニン",
      "text": "「ですが」などない！　下がるな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィグナ",
      "text": "ふぁーあ……ドクター、まだ見つからないの？　ライブに間に合わなかったら一生後悔しちゃうじゃない！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "見つけた！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "ああ、帳簿と債券を見つけたぞ。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ヴィグナ",
          "text": "あ、見つけたの？やっぱり叩けばホコリって出るもんなんだね。メテオリーテ姉さんが言ってた通り、時には暴力も必要なんだね！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クローニン",
          "text": "く、クソッ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クローニン",
          "text": "まあいい、逃げられさえすれば後のことはどうにでもなる！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィグナ",
          "text": "あ、ドクター、あいつが窓から逃げるよ！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "構わない。この資料を全て持って行こう！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ヴィグナ",
          "text": "オッケー。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィグナ",
          "text": "あれ、そう言えば将軍のおじさんがまだ外にいるよね？　あのクロなんちゃらとかいうヤツ、逃げないほうがまだマシだったかもね……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ヴィグナ",
          "text": "よし、ドクター。資料はあたしが持っていくよ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クローニン",
          "text": "は、はは……クソったれ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クローニン",
          "text": "すぐに、今すぐに仲間を集めなければ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "text": "その窓、前回はドクターとセイロン殿が脱出するときに使ったようだな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "text": "そして今回は、立場が逆転してシエスタの天災トランスポーターが飛び出して来るとは。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "text": "人生とは儘ならぬものだ、そう思わないか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クローニン",
          "text": "お……お前！　私の部下はどこだ？　私の部下をどこへやった！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "text": "ここにいられては、観光客の邪魔になるのでな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "text": "ついでに、こちらのお嬢様二人は、もう待ちくたびれた様子だぞ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クローニン",
          "text": "シュヴァルツ……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クローニン",
          "text": "お前たち二人が一緒にいるということは……。",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "お前はもう終わりだ！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "証拠は全てこちらにある、もう逃げられない。",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "へラグ",
          "text": "ドクター、油断はするなよ。窮鼠猫を噛むというからな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クローニン",
          "text": "お前ら……お前ら……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "あなたの計画はもう全て露呈しているわ、クローニン！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
