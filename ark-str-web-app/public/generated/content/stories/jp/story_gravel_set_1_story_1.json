  "sourceHash": "5e5716fc6ad0cd98a9a82762078a5a2f362c1bc1996a747a1be087b4fc013927",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "gravel"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "バー 「テラーマーティン」\n――ドアベルの音が店内に響く。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "いらっしゃい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "た……助けてください！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "止まれ！　なあ、そいつを捕まえてくれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "はぁ……災難続きだな、うちの扉は……一昨日直したばかりだというのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "ああ、騎士様……どうか、お助けください……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "はっ、お前を救う騎士様がこんなところにいるわけねえだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "よーく見てみろよ。看板に騎士が描かれてるだけの、ボロっちい酒場じゃねえか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "それにな、騎士もお前みたいな奴に手を差し伸べるわけねえだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "だ、誰か……誰か助けてください！　私は……売られたくなんてありません……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "この……勝手なことをぬかすんじゃねえ！　なあ、聞いてくれよ、お客さん方。俺からしてみりゃ、値札のついた「商品」が逃げ出して、騎士に助けを求めようとしてるんだぜ？　笑っちまうよな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "ほら、叫びたいなら叫んでみろよ。誰がお前を救ってくれるか見てみようじゃねえか！　行くぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "い、嫌！　わ……私は騙されただけなんです。「商品」なんかじゃありません！　うぅ……カジミエーシュに来るつもりなんてなかったのに……お家に帰りたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "ははっ！　ド田舎の人間ってのは何も知らねえんだな。まったくバカなお嬢ちゃんだぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "大方、作り話に騙されて、カヴァレリエルキで騎士になるなんて大それた夢を見ちまった口だろ？　お笑いぐさだな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "ちょうどいいや。おいマスター、酒をくれよ。一杯やってから、この小娘を騎士の旦那に売っ払うとしよう……奴隷としてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "悪いね、お客さん。うちの店は悪徳ハンターお断りなんだ。地下で汚い商売をしてるような奴は特に、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "……何だと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "それにあんた、ここに騎士がいるわけない、と言っていたが……うちを見くびりすぎじゃないか？　今ここに座ってるお客さんこそ、あの名声轟く「錆銅騎士」イングラさんなんだがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "なっ……！　錆銅って……「あの」錆銅騎士か……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "（えっ？　ちょっ、なあ、マスター……！　俺は酒を飲みに来ただけだし、装備だってただのファングッズだぞ……！！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "（いいから、ちょっと協力してくれ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "（わ、分かったよ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "ご……ほんっ。「さっきからうるせぇな。汚いバウンティハンターごときが、俺の手を煩わせようってのか？」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "「出て行け、今すぐにな。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "ちっ……おい、聞こえたな？　騎士の旦那を興ざめさせるんじゃねえよ。行くぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "*カジミエーシュスラング*……この礼儀知らずを外に出したいんだが、誰か手伝ってくれる奴はいないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "い、嫌……！　私、行きたくない……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "奴隷になんてなりたくない、お家に帰りたいの……きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "おい、*カジミエーシュスラング*！　何してやがる、早く出ろっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "ぐっ……あ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "だ……げほ、ごほっ、誰だ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "やかましいわねぇ～。ここで何してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しいハンター",
      "text": "*カジミエーシュスラング*、卑怯だぞ、急に襲ってきやがって……うっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "その程度の実力で威張り散らすつもりなの？　このカヴァレリエルキで？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ふぅ……ありがとう、助かったよ。自分で手を下すことになれば、店の物を壊さないように手加減しないといけないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "えっと……もう終わったのか？　はは……騎士気分を味わうのもなかなか悪くないな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……ん？　君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あら～、カヴァレリエルキはもう、あたしのことなんて忘れちゃったのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "前はよくここに来てたじゃない？　マーティン。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "その剣さばき……そして、腕にある……「バーコード」……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "……ああ、思い出したよ。君だったのか、「グラベル」。マイバウム家の騎士よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "騎士……グラベル、様？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "グラベルって呼んでちょうだい。お堅い称号は抜きにして、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "騎士ぃ？　ふん、背後から相手を襲うなんて暗殺者みたいな真似……騎士がするわけないだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "いいか、真の騎士ってのはイングラさんみたいに強大な力と圧倒的な武力を併せ持ち、名前を聞くだけで皆が震え上がるような存在のことを言うんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "ごめんなさいねぇ、お客さん。競技のためにお金をかけて育てられた大スターと違って～、あたしの技はぜ～んぶ生き残るためのものなのよぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "競技騎士を馬鹿にしてるのか？　ふんっ、お前ら征戦騎士なんて血税を食い潰すしか能がないくせに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "はいはい、二人ともその辺にしてくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "ふむ、この悪徳ハンターは当分目覚めそうにないな。お嬢ちゃん、君はこの隙に逃げなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "それと、そこの勇敢な行動をとってくれたグラベルにお礼を言うのを忘れずにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "あっ、ありがとうございました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "えっと……あなたが、あのグラベルさんだったんですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あらぁ？　あたし、そんなに有名な騎士じゃないんだけど～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "その、昔村に来てくれたって聞きました！　私たちの村の近くには沢山のバウンティハンターがいるんですけど……辺鄙な所にあるので、騎士様が彼らを追い払ってくれることなんて滅多になくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "昔、ねぇ。確かに、「手がかり」を探して色んな場所に行ったけど……でも、それって随分前のことよぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あなたの年齢からして、その頃にあたしと会ってるはずがないと思うんだけどぉ……あなた、だあれ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "わ、私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "まだ混乱しているんだろう。あんまり怖がらせるものじゃないぞ。少しは落ち着かせてやらないと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "しかし……グラベル、久しぶりだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "ええ、久しぶりね、マーティン。最近はどう？　大旦那様、ここにはよく来てるのかしら～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "はは、旦那は元々こんな騒がしい場所へは滅多に来ないよ。たまに来た時は新作のつまみをいくつか頼んでいくんだが……この前、釣りの最中湖に落ちて足を捻ったって聞いてからは暫く来てないね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "そう……それなら、大旦那様がまだ食べてない料理でもお毒味しようかしら～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "だったら、この子にも何か食べさせてやらないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "え～。あたしはこの子の命の恩人なのにぃ、どうして食事まで奢ってあげなきゃいけないのよ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "ぐ、グラベルさん、私……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "も～う……しょうがないわね～。ほら、隣に座って。マーティン、料理は二人分でお願い～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "あ、ありがとうございます、騎士様……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "それで、今回はどうして戻ってきたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "ただの休暇よぉ。湖に落ちた大旦那様のお見舞いに来たの。何日かしたら帰るわ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "帰るって……どこにだ？　君はカジミエーシュの騎士なんだし、一族の首席騎士の住居に戻らなきゃいけないんじゃないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……ううん。あたしはもうカジミエーシュを離れたのよ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "どこへ行こうと、何をしようと、どんな人間になりたいと願おうと……すべてが、お前の自由じゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "自分を信じ続けなさい。そうすれば、お前の決断が過去の努力を無駄にすることも、自らの名を汚すこともなかろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "さあ、行くのじゃ、グラベル。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……そうよ。あたしは確かに、大旦那様に自分の意思を伝えたし……マーティンにもお別れを言ったはずだけどぉ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "ほんと、物忘れの激しいマスターねぇ。あたしのことだって、どうせすぐに忘れちゃったんでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "はは、もう歳だからね。何もかも覚えてられるわけじゃないのさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "（……違う。マーティンの反応は……何か変だわ。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "（あんなに大きな出来事……忘れられる方が不思議だもの……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "あの、グラベルさん。さっきから言ってる「大旦那様」って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "マイバウム家の首席騎士、ガイスキー……界隈の大物さ。昔は名を馳せた征戦騎士だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "当時のマイバウム家といったら、今の若い騎士たちとは比べものにならないほど戦場に貢献していたものさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "ふん、それでも今じゃただの老いぼれだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "……わ、悪かった……騎士よ、あなたの一族と首席騎士への無礼をお詫びします……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "次は、お詫びの機会なんてあげないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "錆銅騎士のファン",
      "text": "うっ……くそっ。マスター、チェック！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "グラベルさんは、マイバウム家の騎士様を……その……尊敬しているんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "当然よぉ。大旦那様のおかげで、あたしは他の「商品」みたいに底辺の仕事をさせられずに済んだんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "そう……大旦那様が訓練に参加する機会を与えて下さったから……あたしは騎士になるチャンスを得ることができたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "羨ましいです……騎士になるチャンスをもらえるなんて……もし私も騎士になれたなら、村に戻ってお父さんとお母さんに会うことができるでしょうか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あなた、もう商品番号は刻まれちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "えっと……ま、まだです……途中で逃げてきたので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "そう、勇敢ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "でも……私、知ってるんです。ハンターは手に負えない人たちだってこと……だから、グラベルさんが私を助けてくれたことで迷惑を掛けてしまわないか……心配で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "大丈夫よぉ。それにこんな汚い取引、消えて当然なんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "（違う――既に根絶やしにしたはずよ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "（……もう少し、様子を見てみましょう。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "さて、そこのバウンティハンターはあなたに手出しできないし……あなたはもう「商品」じゃない。だから、早くお家に帰りなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "ん？　どうしたのぉ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "あの……私……帰れないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "お金もありませんし……それどころか、自分の家がどこにあるかも……分からなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あなたのお家ってカジミエーシュ領内じゃないのぉ？　それなら、村の名前を言えば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "わ、私、カジミエーシュの出身じゃないんです……小さい頃に攫われて……それでカジミエーシュの村に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "家に帰りたい？　よかろう。家はカジミエーシュのどの村じゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "ち……違うの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "む？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……あたし……カジミエーシュの人じゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "それじゃあ、お嬢さんは一体どこから来たんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……わ……わかんない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "全部、忘れちゃった……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "わ、私、ずっと逃げたくて……でも、自分がどこから来たのか、忘れちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "その……ハンターの人にこう言われたんです。「俺が騎士の元へ連れて行ってやる。そうすれば騎士がお前を家まで送り届けてくれるし、運が良ければお前も騎士になれるぞ」って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "それで……カヴァレリエルキまで連れてこられて……やっと気が付いたんです。この人たちは、私を奉公先に売り飛ばそうとしてるんだって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "でも、私は奉公なんてしたくありません！　お家に帰りたい……だから、あの人の言葉を信じたのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "自力でカジミエーシュを離れて、自分の故郷を探して両親に会おうだなんて、こんな幼い子供には土台無理な話だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "はぁ……分かってるわよぉ、そんなことくらい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "（嫌ってほどに、ね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "あの、グラベルさん。その腕にあるのって……「バーコード」、ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "それじゃあ、あなたは……もしかして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……ええ、そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あなたと違って、ハンターの手から逃れるチャンスがなくてね。売られちゃったのよ～。売られた先の大旦那様が超のつく善人でラッキーだったわぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "だが、騎士になることができたのは、グラベル自身の努力があったからこそだ。平民から征戦騎士になることの難しさは、誰もが知ってるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "本当に、すごいです……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "それじゃあ騎士になった後は……故郷に戻って、ご両親を見つけることができたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "私、二人が恋しいんです……もう一度、お父さんとお母さんに会いたい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……見つからなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "え……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あたしがあなたの村に行ったのは、きっとハンターの痕跡を辿ってのことだと思うの。あの人たちが、どこからあたしを攫ってきたのかを知ろうとして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "だけど……見つからなかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……いや、違うわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "グラベル……さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……これ以上、あたしを記憶の渦に引きずり込むのはやめて。どれも……何より恐れていたことばかりだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "もし、大旦那様に……優しい人に出会えなかったら。もし、騎士になれなかったら。もし、このままずっと家族が見つからなかったら……わたしは、一体どうなってたんだろう？　って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "でも、とっくに分かってるの。そういったものが、二度と私の心を蝕むことはないって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "グラベル……何を言っているんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "ねえ、マーティン。あたしがカジミエーシュを離れてロドスに入ったことを、あなたが知らないはずないわよね……ええ、そうよ、あたしは「ロドス」から帰ってきたの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "……そうか。その目を見ればすぐに分かるわい。ワシに別れを告げに来たんじゃな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "はい……あたしは……ロドスに行きます。あの人について行きたいんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "ふむ……それじゃあお前は、奴に本当の名を伝えたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "いいえ。あの人に騙されてはいないか、あたしを利用して悪事を働くつもりはないかを、もう一度この目で確かめる必要がありますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "そうか。ならば、行くといい。ロドスを見て、そして、お前の故郷も探し続けるんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "分かっておる。まだ諦めておらんのじゃろう？　それは正しきことじゃ、グラベル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "大旦那様、あたしは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "反論は聞かぬぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "前にも言ったはずじゃ、グラベル……行け。遅かれ早かれ、お前はいずれ、ここを離れることになる。決心がついたなら、お前を縛るものなど何もないんじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガイスキー",
      "text": "帰りたくなったらいつでもカジミエーシュに帰ってこい。帰って来たくなければ……何も気に病むことはない、行け！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "「ロドス」……？　グラベル、君はマイバウム家の家臣で、第四階級の騎士だろう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "それは……もう過去の話なのよ、マーティン。今のあたしは、ロドスの一員なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "禿頭マーティン",
      "text": "君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "さっきこの子が話してたのは、全部「あたし」の過去よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あたしは騎士に救われることもなく……カジミエーシュに連れてこられて、カヴァレリエルキで売られた……故郷に戻る道すら知らなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "逃げてきた少女",
      "text": "でもグラベルさんは、カジミエーシュで新しい家族を得られたんですよね。それならマイバウム家の家臣として、一人の騎士として、あなたはとっても幸せだったはずでは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "ええ、そうよ。あたしは大旦那様の家臣……だからこそ、大旦那様には永遠の敬意と、感謝の念を抱いているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "だけど、大旦那様は最後に……こう仰ったの。いつまでもこの場所を想い続けるべきじゃない、って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あたしがカジミエーシュを離れたのは、去るべき理由があったから……そして、本当の両親と故郷を探す時が来たからなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "そう……これはすべて、夢に過ぎないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "だって今はもう、誘拐されてカヴァレリエルキに来る子供なんていないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラベル",
      "text": "あの「バウンティハンター」の皮を被った残酷な悪党は、人身売買ビジネス最後の勢力だったわ。だから、あたしが村々を巡ってあいつらを根絶やしにしてやったのよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "グラベル。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "……うぅ……ん？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "（ここは……ロドス？）",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "グラベル。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "あらぁ、ドクター。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "（やっぱり……今のは全部、夢だったのね。）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "（同じような夢を、何度も何度も見てるけど……）",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "ごめんなさい。あたしったら……寝ちゃってたみたいね。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "大丈夫か？　うなされているようだった。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "ふふっ、心配してくれてるの～？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "それにしても……珍しいこともあるものねぇ。いつもはあたしがドクターを見つめてるのに、まさか見つめられる側になるなんて～。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "……",
          "value": "1",
          "blocks": []
        },
        {
          "label": "表情が気になったから。",
          "value": "2",
          "blocks": []
        },
        {
          "label": "変な意味はないんだ、気にしないでくれ……",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "分かってるわ。ドクターはお仕事中に気を散らせたりなんてしないものねぇ。大方、あたしがちゃんと護衛の仕事をしているか見てたんでしょ～？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "グラベル",
          "text": "まぁ～、あたしのことは気にしなくていいから、お仕事の続きをどうぞ～。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
