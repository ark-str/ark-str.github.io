{
  "server": "jp",
  "storyId": "main_4_level_main_04-04_beg",
  "groupId": "main_4",
  "stageId": "main_04-04",
  "title": "恐れるなかれ",
  "storyCode": "4-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_04-04_beg.txt",
  "sourceHash": "2661ba32efe644f95186c31160d64acdb1524238fbeb3b4dafd3b283d12457f0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "すまない、あまり待たせていなければ良いが。近衛局の会議が長引いてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "いえ、大丈夫ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "（チェン隊長、何事もなかったみたいな接し方……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そうか。それで、状況はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "こちらの偵察部隊から、いくつか重要な情報が上がってきたところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そこで、今日はその中から、ご興味のありそうなものを抜き出してきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……あっ、ホシグマさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "こんにちは。小官も同席させていただいてよろしいですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "構わん。アーミヤ、続けてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "わかりました。では、報告を続けますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "我々が、一部の感染者から得た情報を基に調査を行ったところ――龍門の居住区内に、レユニオンの拠点を数カ所発見しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ふむ。それから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "彼らが龍門に潜伏する際のルートも確認しておきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "加えて、レユニオンのうち複数の小隊が、龍門への攻撃を計画していることも判明しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ふん、まったく傲慢な企てだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "近衛局も甘く見られたものだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "で、話にあった廃都市の件はどうなっている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "そちらにも偵察隊を派遣し、状況確認を行っているところです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "現状、廃都市内で確認できたのは大勢のレユニオンの姿ばかりで、元いた住民の行方についてはわからない、と聞いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "また、ある部隊からは、すでにレユニオンと三回以上交戦しているという報告もありました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "確かに、今得ている情報だけでは、この廃都市がレユニオンの動きにどう関わってくるのかを正確に判断することはできませんが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "この先の作戦における重要地点となるのは確かかと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ホシグマ、報告書を取ってきてくれ。デスクの左側、三番目の引き出しだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ホシグマ",
      "text": "今ですか？　わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キミはそのまま続けるように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい。差し当たって、ご提案ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "まずはロドスと近衛局の共同作戦で、龍門内部のレユニオンへの対処から始めるというのはいかがでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――良いとは言えないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "近衛局としては、受け入れられない提案だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……それは、なぜですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "なぜも何もないだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "キミは感染者だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そんな人間が、これ以上スラム街で任務に当たれば、さらなる混乱を招くことになる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "これは、近衛局としての決定だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ですが――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "あっ、すみません。連絡が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "はい、アーミヤです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "（小声）あ、よ、よかった……！　アーミヤさん……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……！　ジェシカさんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）は、はい、そうです……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……？　もしかして、偵察中でしょうか？　なんだか、声が小さいような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）あの、それが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）廃都市内で、レユニオンの幹部を発見したんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "（小声）それも、二人も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "えっ……！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "おや？　負け犬さんのお戻りじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あいにく、犬っころなんかになった覚えはないんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "やれやれ、飛んだ物言いだね。君が任務を果たせていなかったら、その顔に一つや二つは傷をつけてたところだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "へえ～？　その時は挨拶代わりに手足を吹っ飛ばしてあげるから、口でも使って「メイク」してもらわないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "ははっ、面白い考えだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "まあ、現状その気はないから安心しなさい。二人で争ったって何の得にもならないしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "ふうん、そのくらいの知恵はあるんだね。安心したよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "それで、獲物はかかったのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ええ、もちろん。とはいえ、あとはパトリオットが「本物」を取り戻せるかどうかにかかってるけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "ああ、そういえば……あんた、あのジジイが怖いんだっけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "余計な口を利くな。僕は今、虫の居所が悪いんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "あら、ごめんなさ～い？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "でも、今はせっかく大きな獲物が誘い込まれてくれたことだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "text": "もうしばらくは、仲良くやりましょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "……ふむ。仕方ないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "そうしようか。小さな問題から解決したほうがいいだろうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "――さて、それでは出てきてもらおうか、ロドスの諸君。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "僕の目を誤魔化すことはできないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "待ちなさい、ジェシカ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "これは罠よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "ですが、こちらの位置は知られていますし――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "敵の幹部を倒すためには、こうするしか……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "へえ、やっぱりそこにいたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "それにしても、一体どこから入ってきたんだい？　子猫ちゃん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "ここは君が遊びに来ていいような場所じゃないんだけどなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "――ねえ、みんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "はっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "大物を狩るその前に――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メフィスト",
      "text": "小物を仕留めて楽しむとしようか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "text": "おおおおおっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……くっ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
