{
  "server": "jp",
  "storyId": "main_10_level_st_10-02",
  "groupId": "main_10",
  "stageId": "st_10-02",
  "title": "交差点",
  "storyCode": "10-13",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_st_10-02.txt",
  "sourceHash": "cc0fdc81fcf02f8bb227eb019bf614c07ca602ff7b607f8b85dc0f465652a9d9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ハァ……ハァ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "もう限界のようだな、マンドラゴラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……化け物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんたたちサルカズは……どいつもこいつも化け物よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "独創性に欠けた呼称だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "地面に這いつくばっている敵の口から聞く時は、褒め言葉として受け取るようにしている。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ゴホゴホッ……\nゴホッゴホッゴホッ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんたたちは……あの貴族どもとおんなじように……クソだわ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "こんなアーツ……\nこんな生まれつきのアーツ、あたしが、どんなに頑張ったって……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "鉱石病を恩恵だとでも思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "無数のサルカズが、生まれながらにしてこの呪いを背負う。臓腑は膿み、身体が爛れ――君たちは我々を災いを広めるただの害虫として、都市から駆逐する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "生きるため、一度でも多く日の出を拝むためには荒野を放浪するしかない。毎日、毎日、どれほどのサルカズが、故郷の土に埋葬されることすら叶わず、風と共に散る結晶となっているかわかるか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "それなのに君は……\nこの力が羨ましいだと？　ヴィクトリア人よ、随分思いあがっているな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……あたしをヴィクトリア人と呼ぶなんてね。人を侮辱するのが上手いじゃない、クソ魔族。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あたしがどうして鉱石病にかかりたくないか……知ってる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "荒野のサルカズは……あんたたちは死ぬ前に……少なくとも日の出を見ることはできるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "それに比べて、元々都市の暗がりに生きてるあたしたちは、体に黒い石がちょっとでも現れたら……次の日には下水道のハガネガニの餌になるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ヴィクトリア人からすれば、あたしたちのような弱小のターラー人は……サルカズ以下なの！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "でも力さえあれば……\n力さえあれば、あたしたちは生き延びられるのよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "サルカズは、君たちの間にある怨恨にも争いにも興味などない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "私は君たちにチャンスは与えた、一度ならず。それだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "今日君が大人しく北門の守備に就いていれば、これまでのつまらぬ行動を見逃してやったってよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ハハ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "なによ、随分と寛大じゃない。あんたの慈悲深さにひざまずいて感謝すべきね、「将軍」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "なんて言うとでも思った？　クソくらえよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんたみたいな奴、腐るほど見てきたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "どうせあんたは……あたしたちが生きられるのは、全部自分の温情だとでも思ってんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "もういい。もう、ほんっと、うんざりよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんたたちのくだらない賭けの道具になるのも、いくらでも代えのきく生きた駒になるのも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あたしの運命は……ターラー人の運命は……あたしたち自身で決めるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……自身で決める？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君が決められることがあるとでも？　それどころか、ロンディニウムに来た瞬間から、君の運命はすでに決まっていた。君以外の手によって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "なっ……そんなこと……バカ言ってんじゃないわよ！　あたしは……あたしは確かに何度も失敗した、でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんたをここでぶっ殺して、ロンディニウムの情報を持ち帰れば、まだリーダーのもとに帰れるの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……ぶっ殺す？　羽虫のように飛ぶしか能がない偽物の石像でか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "理解できぬのか？　それともしたくないのか？　アンズーリシックの王庭の者がここにいたとしても、彼らが私に敵うとは限らぬぞ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あたしのアーツを魔族のくそったれな巫術と比べるんじゃないわよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "ほう、一度に十体を作り出したか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "非感染者の術師としては、才があると言えよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "だが、これほどまでに粗雑なアーツの造物が相手であれば、君が先般口汚く貶した巫術とやらすら、使うに値しない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "うっ……ぐっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "いい加減に認めなさい、終わりを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "自分の手にあるアーツユニットに入った亀裂は見えているか？　その見掛け倒しのアーツユニットが砕けた時、君は脆弱なフェリーンと何ら変わりなくなる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ハ……ハハハッ！　おっかしいわね……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "だったら……\n何だって言うの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "少女がそう言った瞬間、石でできたアーツユニットが、一際大きな音を立てて砕ける。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "足元の地面が震えた。ボロボロと破片をこぼしながら、石像が一つまた一つと、再び立ち上がる。\n一度壊された身体を寄せ合い、互いに固く抱き合うと、高さ五メートルほどの巨大な石像がそこに現れた。重い翼が羽ばたき、咆哮を上げながら、迷うことなくサルカズへと突っ込んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "防御態勢をとれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "text": "はっ！　将軍もお気をつけて――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "自分たちの身を案じていればよい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "出来の悪い模造品ごときで私を傷つけることはできない。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "……サルカズは宣言通り、いかなるアーツも使わなかった。\n巨大な石像は、怒号を上げて彼に襲い掛かった。翼の風圧で飛ばされた無数の瓦礫が雨のように降りかかり、剥き出しの牙が彼の頭を食い千切ろうとした。しかし――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は剣で軽く、一刺ししただけだった。\nそして石像は空中で動きを止め――永遠にも思える数秒のあと、崩れ落ちた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "見なさい、もはやその石で戯れることはできまい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ハッ……クソ魔族……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "この期に及んでも、こんな……傲慢だなんてね。これだから……生まれつき……力がある奴らは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "クソがっ……あんたを殺す……ぶっ殺す！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "私を殺せば、意気揚々と戻って、リーダーから褒美を得られるとでも思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "たとえ君が本当にやってのけたとして……考えてみるといい。彼女は大喜びで君を迎え入れるか、あるいは君の首をロンディニウムに送り返すか、どちらだと思う？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "モーニング伯爵に伝えておいてもらえるかしら。ロンディニウム内のダブリンメンバーに対する処遇をサルカズに一任するのに、リーダーは同意したわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "必要なら、あのサルカズの将軍に謝罪しましょう――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "――ダブリンはカズデル摂政王との和平を壊すつもりはないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "彼のそばにいるガリア人のことを考えると、本当の協力者にはなれない定めだけれど、今すぐ敵対関係になりたいわけでもないでしょう。違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "ダブリンの誠意を示すために、他の貴族部隊が最近付属区画で捕らえたサルカズのトランスポーターたちを返してあげるつもりよ。伯爵には仲立ちをお願いするわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "安心しなさいって。ウェリントン公爵は伯爵の貢献を忘れない。そしてリーダーとダブリンは言うまでもないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "焦らないようにと、彼に伝えて。リーダーが今取り掛かっている仕事を終わらせたら、私たちもロンディニウムに向かって彼と合流するから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "……前に会ったダブリンのあの指揮官はどうするかって？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "マンドラゴラ……マンドラゴラねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "彼女には十分良くしてあげたわ。わざわざリーダーに頼み込んで、ロンディニウム行きのチャンスまで作ってあげたんだから。最後のチャンスをね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "リーダーは今でも彼女とあの数人がヒロック郡でやらかしたことに対して、非常に不満に思っているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "マンドラゴラって、どうして理解できないのかしら……ダブリンはもう、亡霊部隊の名前を隠れ蓑にする必要ないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "私たちがいずれ建てるのはドラコとターラー人による新たな国――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "民衆の支持を得たいなら、怒りや恨みがもたらす恐怖や感情だけでは不十分でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "もし彼女がリーダーの意図を理解して、怒りを抑えることを学び、ロンディニウムで無事に任務を終えて引き上げてきたなら……ちゃんと情報を伝えたことに免じて、まだ居場所はあったのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルモニ",
      "text": "リーダーが……結成当初のターラーの同胞たちを忘れたことは、一度もないわ。これでも共に灰燼の中から這い上がって来たわけだしね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "夜が明ければ、私のところに外からのトランスポーターが訪ねて来るかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "その者は、どこかの伯爵又は男爵の意を受けているだろうが、間違いなく背後にはターラー地区出身のあの公爵がいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "彼らは私に感謝するかもしれないな。御し難く愚かな指揮官を排除して、今後の交渉がよりよく進むように、場を整えてやったのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "サルカズは常に都合の良い道具として見なされてきた。そう、この点において、我々は君同様、傲慢な貴族たちに憎悪を覚える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "だが……マンドラゴラ、君はここまでだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "まだ何か……ナイフ？　何の変哲もないたかがナイフで私に不意打ちをしようというのか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "ハハハ……\nゴホゴホッ……\n万が一……\n成功したら？"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "もしや……君の脳神経は心臓にあり、先ほど私が刺した際に一緒に駄目にしてしまったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "言ったはずだ、君では私を殺せない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "それに、たとえ私を殺したとしても、何も意味がない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "意味が……ない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "バカ、に……しないで。なんにでも……意味がなきゃいけないとしたら……あたしたちみたいなのが、生きてる意味は……最初っからないじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あたしは、あんたを殺す……誰かの命令だからとかじゃなくて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あたしがそうしたいから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "……本当に狂っているな。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "狂って……る？　自分の顔を見てみなさいよ……うざいくらいに自信に満ちて、涼しい顔して……\nそうよ、あんたにわかるわけないわ……\nだって、あんたは……やりたいことを簡単にできるもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんたが一番大事な人が……そばで死んだ時……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あんたが最も信頼する人が……あんたを見捨てて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……剣であんたを地面に縫い付けた時……そうなったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……あんたは理解するかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "それが死に際の最後の抵抗か？　その程度の呪詛では、私を揺さぶることなどできない。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "フッ……フッ……\nならさっさと手を下せば？"
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンフレッド",
      "text": "君はすでに死んでいる、ターラー人。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "ターラー人……私のこと……ターラー人って呼んだわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "サルカズ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は地に横たわり、苦しそうに息をしている。\n地面は冷たい。冷たくて冷たくて、もう手足の感覚も消えていた。いつの間にか折られていたのか？　それとも必死に走って感覚が麻痺したのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "生きたいか、ターラー人？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "一体誰が……彼女を呼んでいるのは誰だろうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前のすぐ隣に下水道がある。そこから下りれば、憎き貴族どもはお前を追えなくなる。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "そうだ、下りるのだ。\n下水道の中からは強烈な鉄錆と油脂の臭いがする。機械から取り外された廃棄部品と、貴族の食卓から下げられた残飯が交ざり合う。\n彼女は空腹だった。自分が感じる飢餓にむしろ吐き気がした。\n鉄錆と油脂の臭いの他に、彼女はもう一つ濃厚な臭いを嗅ぎ取っていた。\nそれは死の臭いだと彼女は知っている。\n下水道は移動都市に住むムシケラたちの墓場だ。\n金持ちたちは地価の高い都市内に墓を建て、懐が寂しい一般人は遺骨を軌道の外にばら撒く他ない。\nではムシケラは？　ムシケラは誰にも知られることなく、区画の狭間で息絶える。それは永遠に太陽が照らすことのない場所だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "お前は死に向かって歩めるか？　死を厭わぬ勇気がある限り、お前は新たな生を得られる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "リーダー……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "あと少し左に這うだけだ。そうすれば彼女は下水道に入ることができる……あの時と同じように。\nそして彼女の少し右に……ほんの少し右には。\nターラーの同胞が両目を開き、静かに彼女を見つめている。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "リーダー、ごめんなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "今回……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "あたしには……もうあんたは必要ない。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "彼女は最後の力を振り絞って手を伸ばした。指先が、変わり果てた旧友の顔に触れた。"
    },
    {
      "type": "dialogue",
      "speakerName": "マンドラゴラ",
      "text": "もう……あたしたちを追う人はいないわ。おうちに帰りましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "text": "その再会が死の先にあってもか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "誰かが彼女の前に立っていた。その人の足元に火の光はなく、短刀が漆黒の夜を映している。\nマンドラゴラは笑う。\n彼女は思う。自分は本当の死を見たと。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェイスト",
      "text": "前の方にある、あの廃工場の下に入り口があんだ。そこのクレーンをどかせばいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "承知いたしました。先導をお願いいたします、フェイストさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "text": "こちらですよ、無事な方は、怪我している方々を支えてあげてください――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "インドラ",
      "text": "くっそ、ドクター、また追っ手だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……一体どうやって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "工場を離れてから、どれだけ敵を倒しても追手が来ます……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "後で考えよう。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "まずは敵の対処だ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "そうだな。これは地下へ撤退する最後のチャンスだ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "しかし、絶対に敵を地下に入れてはならない。自救軍のあらゆる行動は、彼らだけが地下通路を把握し、サルカズは正確な入り口を知らないことが前提で成り立っている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "万一サルカズがこの入り口を発見したら、サディアン区における自救軍のすべての努力が一瞬にして無駄となる。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "クロージャ、爆発物の用意を。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "はーい……ってええ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "ドクター、あたしにこの通路の入り口を爆破しろってこと？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "ある意味、確実な方法ではあるな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "自救軍の人はどう思うかな……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "クロヴィシアさんは指揮権をドクターに一任した。この場の最終決定権は、ドクターにある。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "アーミヤ、我々はこの先の区画でサルカズを足止めする。私の合図を待て。我々が失敗した場合は、早めに起爆するんだ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "あっちへ行ったぞ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "きょろきょろしてんなよ。お前の相手はここにいるぜ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "うっ――！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "一部隊でサルカズ十人。これくらいなら、なんとかなるね。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "こいつらを止めても……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "お前ら……お前らは逃げられん。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "大君が臭いを嗅ぎ取る……あの方がお前らを一人一人見つけ出し……身体を引き裂いて、喉をかっ切ってやるだろう……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "貴様の言う大君とは誰だ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "さっき……自救軍の別の隊を襲撃した奴か？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "……襲撃？　お前らヴィクトリアのフェリーンなぞ、あの方が……襲撃する価値もない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "サルカズ戦士",
          "text": "あの方はただ……狩りをしているだけだ。貴様らは獲物としてすら不足だがな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ダグザ",
          "text": "こいつらの汚らしい言葉など聞く必要はない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "……インドラ、先ほどの自救軍の戦士たちの状況を覚えているか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "あんな光景、一目見りゃ忘れらんねぇよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "死人は多く見てきたが、あんな、地面に塗りたくったみたいな……人の形すらしてなかったじゃねぇか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ダグザ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "ダグザ、何やってんだ？　あっちにまだ何人か残ってる、すぐに片づけなきゃ――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ダグザ",
          "text": "シージ、頼む、お願いだ。ここから離れよう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "何を言ってやがんだ？　サルカズと戦いてぇのはお前だろ、どうして敵前逃亡しようとしてやがんだ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ダグザ",
          "text": "敵を前にして背中を向ける屈辱はもう経験した。今更一度増えたところでなんてことない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ダグザ",
          "text": "ここからシージを安全な場所まで送り届けられるなら、その後でサルカズと刺し違えに戻ってきてもいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "……わかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ダグザ",
          "text": "シージ、決心したか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "そうかもしれない。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "ダグザ、貴様の選んだ道はわかった。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ダグザ",
          "text": "私の……選んだ道？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "行くがいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "ヴィーナ？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "え、待ってよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ダグザ",
          "text": "私……",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "貴様が探すべき人を探しに行け。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "このサルカズたちに貴様の歩みを止めさせるな。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "みなさん下りてきましたか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "text": "生き残った自救軍の戦士は全員いる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ハイディ",
          "text": "皆様のおかげで、私たちはここまで来ることができました。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ヴィーナは？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "あと四人足りない。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "……ここにいる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "シージチーム、三人戻った。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あれ、ダグザさんは？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "ダグザさんは……大丈夫なんですか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "あのバカ野郎の話はすんじゃねぇ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "どれだけ強く壁を殴っても、あの子には届かないよ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "えっと……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "ダグザにはやるべきことがある。アーミヤ、事前の報告もなく彼女が離れたことに関しては、貴様とドクターに謝罪しよう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "いえ、謝る必要はありませんよ。そうなんですね、わかりました。状況が状況ですし、ダグザさんの決定は理解できます。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "彼女を待つ必要がないとすれば――",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "クロージャ。",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "text": "わ、わかった！　い、いくよ！",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "本当に爆破……しちまったのか？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "モーガン",
          "text": "ダグザちゃん……戻って来ても、道が見つからないだろうね……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シージ",
          "text": "……いや。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "インドラ",
          "text": "ヴィーナ、その「いや」ってのは、あいつは戻ってこねぇってことなのか？　それとも道が見つからないことはねぇって意味か！？",
