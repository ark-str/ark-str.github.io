{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_06_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_06",
  "title": "邂逅",
  "storyCode": "RI-6",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_06_beg.txt",
  "sourceHash": "ccf44ae9ad9088f13f5e665f32791b2a70eedeb278e566a1d284171ae9223a7a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "じいや、調子はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "おう、わしは元気じゃ！　それにしてもとんでもない発射音じゃったな！　あの勢いには危うく吹っ飛ばされそうになったわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "じいやじゃなくて、ビッグ・アグリーの調子を聞いたんだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "わかっとるわい。ついでにわしのことも話しただけじゃ。ビッグ・アグリーの方は予想通りじゃった、連続で砲撃するとオーバーヒートするようじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "じゃがそれ以外の出来は上々、いや、想像以上じゃ！　しかし、あの音には本当にびっくりしたわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "とにかく、集落に戻ったらちゃんと修理せんとな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ。今回は急な祭典だったからな。ビッグ・アグリーもまだ準備が不十分だった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "本当は十分な準備ができてから、他部族の者たちと祭典を開く相談をするつもりだったのだが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "まあ気にするな、結果オーライじゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "それにしても、ビッグ・アグリーを見たときの、あのひよっこ共の驚いた顔！　まだはっきり覚えとるわい！　ハッハッハッ、愉快愉快。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ、目的は達成できた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "これで新たな秩序が生まれ、新たな時代が訪れることじゃろう！　機械時代の到来じゃ！　わくわくしてくるじゃろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "名前をつけるとしたら、「ビッグ・アグリー・イラ」はどうじゃ？　「大祭司時代」もなかなかじゃな。わしみたいにイカした時代になること間違いなしじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "そのまま「機械時代」でいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "はぁ、お主はこれだから困るんじゃ。頭が固いところ以外は優秀なんじゃがな。せっかく外の知識を学んだんじゃから、もっと視野を広げたほうがよいぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ほれ、わしの格好を見てみろ！　知的でオシャレだと思わんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "小さすぎて見えない。オシャレとはどういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "むっ、もうよいわ。お主にこんな話題を振ったわしが悪かったわ。オシャレなどわからんでも、わしが大族長に相応しい装いを用意してやるわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "装いなんてどうでもいい。それより集落に残った者からの伝言で、エンジンを一つ奪ったそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "なに？　本当か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ、ガヴィルが乗っていた機械についていたものらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "それはお手柄じゃ！　早く見たいわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "いや、待っとらんでもこっちが見に行けばいいんじゃ！　よし、わしは先に行っとるぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "じいやは相変わらずだな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "おい、族長の隣にいるリーベリは誰だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "お前、新入りだな？　あれは大祭司様だ！　ビッグ・アグリーの操縦者さ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "マジかよ、オレもビッグ・アグリーに乗りてぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "そりゃやめとけ。お前は知らねぇだろうが、ビッグ・アグリーが完成するまでは毎日爆発騒ぎで、兄弟たちは何人もケガしてんだ。もうあれに乗りたがるヤツは残っちゃいねぇ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "そこに現れたのが大祭司様だ。爆発で何回ぶっ飛ばされても、毎回生きて帰ってくるんだ！　小さいからって侮らないほうがいいぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "そんなにすげぇのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "ああ。ここに来る前はどこの部族にいたかは知らねぇけど、今は尊敬を込めて、みんな大祭司様って呼んでんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "なるほどなぁ！　……あれ？　あそこにいるのはヨギじゃねぇか？　おーい、ヨギー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "ようお前ら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "兄貴と一緒じゃねぇのか？　兄貴はどうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "そのことで、族長に話があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "アホ！　族長じゃなくて大族長だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "ああそうだったな。大族長に話があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "大族長、兄貴が石塊病になっちまったんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "サルゴン語で話せ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "あっ、わかった、すまねぇ。まだ不慣れなもんでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……罹った経緯は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "前に採掘場の奥まで入ったのが原因かもしれねぇ。もっとたくさん鉱石が採れるようにって、オレが反対するのも聞かずに一人で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "採掘場の奥には行くなと言ってあっただろう！　愚かな……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……それで、本人はどうしている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "ガヴィルたちが連れて帰って治療してる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ガヴィル？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "ああ、ガヴィルは本当に医者になったみたいなんだ。兄貴も最初は苦しそうだったけど、ガヴィルが少し治療したら、かなり楽になったみたいでさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……そうか、医者になったというのは、嘘ではなかったのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "それと、ガヴィルから伝言を頼まれてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "伝言？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "後で訪ねてくるらしい。なんか怒ってたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "へっ、族長にやられて悔しいんだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "ああ、族長のあのドガーンって一撃！　凄まじかったもんな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "おい、大族長だっつってんだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "お前も族長って言ったじゃねぇか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "うるせぇなこんにゃろ、族長は族長だろうが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "おめぇこそうるせぇ！　大族長なんて言い慣れてねぇんだよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……ガヴィルは負け惜しみを言いに来るようなヤツではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "大族長、オレはガヴィルを信じて、兄貴を預けたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ああ、私も信じている。お前の兄貴はきっと大丈夫だろう。彼らは今どこに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "トミミの部族のとこだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "トミミのところか……迎えに行くのは、しばらくしてからがいいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヨギ",
      "text": "わかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ガヴィルはエンジンを取り返しに来るつもりじゃろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……だとしても、私に勝てるかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ガヴィルは強い、それは認めよう。だがヤツは、自分の拳が全てだと思いこんでいる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "だが、それは間違いだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "エンジンを取り返すつもりなら、もう一度ビッグ・アグリーの力を味わわせてやればいいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "……何があろうとエンジンは渡さない。このエンジンには、私たちの未来がかかっているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "ガヴィルの話をしていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "フリント、聞いていたのか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "なぁにが大族長だ！　寝言は寝て言えこのアホ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "てめぇこそ、母ちゃんに大族長の正しい呼び方を教えてもらってから出直せバーカ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "うるさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "げっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "お前……クマールか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "ガヴィルに来てほしくないんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "来たら倒すまでだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "それはつまり、来てほしくないということだろう。私がガヴィルを止めに行こう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "いいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "では行ってくる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "どうして戻って来るんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "……ガヴィルの居場所を……聞いてなかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "なんて湿っぽいジャングルなの！　今日もたったの半日歩いただけで背中が汗でびしょびしょだよ。中に水着を着てて良かった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "それにしても、もう二日も探してるのに誰一人いないなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "木に登っても森しか見えないし、ガヴィルが言ってた祭典だってどこでやってるかわからないよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "おーい、誰かー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "おーい、ガヴィルー！　なーんてほっそい尻尾なのー！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "おーい、ドクター！　そのフードそろそろ換えたらー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "……あーあ、これだけ叫んでも反応ナシか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はぁ、ドクターの身に何かあったら、アーミヤちゃんにどう説明したらいいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ガヴィルがドクターの面倒を見ておくって言ってたし、安心していいとは思うけど……いやいや、あの性格で面倒なんて見られる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "なんか心配になってきた……。木を切り倒して、デッカイ音を出してみようかな？　誰か気付いてくれるでしょ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "……ヨギの説明だと、ガヴィルはこっちだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あー！　やっと人に会えた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ハーイ、こんにちは！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "誰だ？　見慣れない服装だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "はい？　何言ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "私の言葉がわからないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ちょっと、嘘でしょ……言葉が通じないなんて！　ガヴィルからは何にも聞いてないんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "だが、強そうな奴だ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "ちょっとちょっと、ここの人ってこういうおもてなしをするの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "やはり強い。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フリント",
      "text": "ガヴィルを倒す前に、お前で肩慣らしだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "あれ？　今の発音、「ガヴィル」に聞こえなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "まあいっか。そっちが手を出してくるつもりなら、私も憂さ晴らしに付き合ってあげるよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
