{
  "server": "jp",
  "storyId": "act18side_level_act18side_04_end",
  "groupId": "act18side",
  "stageId": "act18side_04",
  "title": "驚愕",
  "storyCode": "LE-4",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act18side/level_act18side_04_end.txt",
  "sourceHash": "4977ec051e2c5f165f5ab10dbe7bf20d92644262d98184ebab499cbfc7c7072b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（狂っている！　彼女は狂っている！　丸々一区画の住人の命に関わるのだぞ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（それに、これほどの規模の事件を起こして、逃げられると思っているのか？）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（もし彼女の言いなりになれば、事が発覚して最初に出てくるのは私の名だ！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（この機会を失ったところで別に惜しくなどない。まだチャンスはある……私はまだ待てる！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（着いた……ヴィセハイム出入管理室……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "扉を開けようとした瞬間、エーベンホルツは強烈な頭痛に襲われ、危うく倒れかけた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "逃げ出すのか、臆病者め……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私に指図するな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "たとえウルティカで死ぬことになろうが、お前のような人殺しにはならない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "貴様は……恐れている……怯えている！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "もし恐怖ごときに囚われているなら……貴様は一生自由を手にすることなどできない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "黙れ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "幼稚な愚か者が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "なんとでも言えばいい……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "あの女がそう簡単にここから去らせてくれると思っているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（よし、ここには誰もいない……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（もっと用心して、誰にも見られないように……）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（このままもう少し進めば、移動都市外縁部の無人区画だ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（深呼吸）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "もしかして移動都市の縁から飛び降りる気ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "確かにそれなら最短でヴィセハイムから去ることができますわね。ですがその方法はまったくお勧めできませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ゲルトルーデ、これ以上の干渉は、互いにとって良くないことになるぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "あなたに何か強要するつもりは微塵もありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ならば行かせろ、今すぐ私の目の前から消えるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "あら、どちらへ行くおつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "コンサートが終わるまで、ヴィセハイムはずっと移動しておりますのよ、どこへも行けませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "たとえ命の危険を冒してここを離れようとしても、人のいない荒野に行くことしかできませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "人のいない荒野に行く……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "たとえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "たとえ荒野で死のうとも、ヴィセハイムには居たくないとおっしゃるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "その通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "お気持ちは理解致しましたわ。ですが、少し冷静になって私の話を最後まで聞いてみませんこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "これ以上何を話すというのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "こんな場所で、私にショーダウンさせる気なのかしら、ウルティカ伯爵？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ウルティカ伯爵……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "わざわざその肩書きを強調するな。お前の言いたいことはわかっている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "まず、いまの状況でも私たちの計画は変わらず、滞りなく進行できるということを保証しますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私たちの計画ではなく、お前の計画だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "多少の言い回しの違いであなたの気が済むのなら、異論はありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "だが、クライデの「音」は漏れ出しており、ロドスはその副作用に気付いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "不完全な「塵界の音」で、もう一つを取り除けるのか？　できたとして、ロドスがそれを黙って見ていると思うか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "一つ一つお答えしましょう。まず、漏出していてもクライデの「塵界の音」は「共鳴」が可能ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "ロドスに関しては……ここがどこだとお思いかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "ヴィセハイム――私の領地ですのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "しかもそのハイビスカスさんとやらは感染者ですわ。リターニアの土地を踏ませているだけでも、すでにロドスの顔を立てておりますの。彼女はヴィセハイム以外のどこにも行けません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "それに、彼女が知っているのは、あなたとクライデが原因かもしれないということだけ。「音」については全く無知ですし、因果関係すら立証できないでしょう。彼女は何もできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "わかりますわ。無関係な感染者を傷つけるのが忍びないのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "私からすれば、それは不要な哀れみですのよ。ですが、もし本当にそう思ってらっしゃるなら、なおさら計画通り行動すべきですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "計画通り行動して、感染者たちを死なせろと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "計画の残りの部分をお話しいたしましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "まずあなたはコンサートでクライデと演奏して自分の中にある「塵界の音」を取り除くのですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "その後、私はコンサートホールで混乱を引き起こし、あなたはそれに乗じて逃げる。そして私は機を見てクライデを殺害し、彼の死体をあなたのものに偽装する――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何を言っている！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "彼は現在アフターグロー区における最大の災いですもの。生かしておくなんてありえませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "生かしておくなんてありえないだと――騙されるものか、アフターグロー区最大の災いはお前ではないか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "話しましたわよね？　アフターグロー区のすべての災いの元は、クライデの体内にある壊れた「音」ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "そして共鳴は「塵界の音」のエネルギー漏出を激化させます。これは不可逆的なものですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "たとえあなたが本当に移動都市から飛び降りていたとしても、クライデの「音」は、一週間前の無害に近い状態には戻りませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "さらに問題なのは、「塵界の音」はクライデのそばにいる者だけでなく、彼自身をも傷つけていることです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "彼こそが共鳴の最大の被害者ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "あなたの目には彼がとても健康に見えているでしょうけど、それも一種の疑似的な回復にすぎませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "クライデの身体は本来、「音」に適応しているはずでしたが、ここ最近の急激に上昇するエネルギー漏出によって、すぐにでもバランスを崩すでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "楽観的に見積もったとしても、彼の平穏な暮らしは恐らく二週間ほどで終わって、疑似回復期後の一番激しい急性症状に襲われますわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "彼本人のためにも、アフターグロー区のためにも、演奏した後に死ぬことこそ、最も良い結末ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "これはあなたや私、アフターグロー区、そしてクライデにとっても良いことなのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "私はいつでも使える強力なカードを手に入れ、アフターグロー区は平和になり、クライデは安寧を得られますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "そしてあなた……あなたは自由を得るのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "ウルティカ伯爵、リターニアの正当継承者……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "――巫王の、最後の血統。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "自由。\n物心ついた頃から、自由とは何かを知らない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "可哀想な子ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "礼儀正しくある必要も、挨拶も必要ない。ただ私の話に耳を傾けなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "巫王とは遠く離れた傍系に生まれたけど、あなたは確かに巫王最後の血統だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたを哀れに思う。だから困らせるようなことはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それだけでない。あなたの一族が代々受け継いできた領地もそのまま与える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたはいずれウルティカの領主になる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたは自分の領民に対して責任を負うことを学ぶ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あなたは悪名高い親族とは完全に異なる道を歩むと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "私はそう期待している。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "これは私の記憶の始まり。\n当時私は五、六歳で、それ以前の記憶は一切ない。ぼんやりと覚えているのは、自分が「塵界の音」と呼ばれる妙なものと関係があって、そのせいで命を落としかけたということだけ。\n目の前の純白のドレスを見つめながら、自分は無名の小貴族になるのだと疑いもしなかった。\n時折襲ってくる「音」による頭痛と幻聴に耐え忍ぶ以外には、平穏な一生を過ごすのだと。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無表情な貴族",
      "text": "伯爵……言行を慎み、高塔の外へは、みだりに出るべきではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無表情な貴族",
      "text": "あなたのすべては、女帝陛下から賜ったものなのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臆病な使用人",
      "text": "伯爵、何かお忘れになっていませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "臆病な使用人",
      "text": "お食事の前には、女帝陛下を褒め称えるべきです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "几帳面な教師",
      "text": "伯爵、本日は新しい曲を学びましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "几帳面な教師",
      "text": "これは女帝陛下に対する貴族たちの敬意を表す曲です。よく覚えておいてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平凡な術師",
      "text": "伯爵、なんと素晴らしいアーツコントロールでしょう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "平凡な術師",
      "text": "何ですって？　もっと精密な操作の仕方を学びたいのですか？　いやいや、そんな疲れることをする必要はございません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "周りの者すべてが、できる限り私の自由を制限し、頭に双子の女帝への忠誠心を植え付けようとした。\nもしそれが平穏な暮らしの代償だというのなら、耐えてみせる。\n私は長い間耐えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "無表情な貴族",
      "text": "伯爵様、単刀直入に申し上げます。あなた様こそリターニアの真の主でございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無表情な貴族",
      "text": "私はすでに何年にもわたりあなた様の塔に潜んでおります、きっと私が何者かはおわかりでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無表情な貴族",
      "text": "何も仰らなくて結構です。私の話を聴いていただければそれでよろしい。賛同も反論もする必要はございません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無表情な貴族",
      "text": "わかっております。あなた様は恐れておられるのでしょう？　今の生活すらも失うことを。ですが少なくとも、あの者たちがあなた様をどう思い、何をしようとしているのか知るべきです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "無表情な貴族",
      "text": "ご存じでしょう。僭主（せんしゅ）があなた様に押しつけた代理人が現在、階下で宴を開いています。今からそこへお連れして、真実をお見せしたいと存じます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そう言って、目の前の者は私の手をつかみ、地面から引き上げた。\n私の手は汗にまみれていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "素晴らしい酒だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "地下にこんな美酒があったとは、全く知らなかったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "恐れ入ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "ウルティカのような片田舎には何もございませんが、酒造りの職人は割と多い方なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "あのガキがまだ小さい間に、たっぷり飲んでおいてやらんとな！　あいつには残しておけん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "ハハッ、それはご勘弁を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "あの子がここに軟禁されて数年……いつ酒の味を教えてやろうかと機をうかがっているのですから。酒に溺れさせ、酒狂いにするのです。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "私はしばらく頭がぼうっとしていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "ほう、まだそんな手を残していたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "あのガキが酒に溺れれば、陛下も安心して――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "シッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "おっとそうだった、いかんいかん！　罰としてもう一杯飲もう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "酒の席でしか言えないことですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "あの子に世継ぎを作らせてはならない――これは上からの絶対命令です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "だったら、いっそ薬剤師に頼んで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "それはいけません、証拠が残ってしまいます。あの子を自堕落に育ててこそ、この任務は首尾よく成功となるのです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "見事だ！　まったくもって素晴らしい！　さぁ、飲もう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "無事にあれを墓まで見送ってやれさえすれば、ウルティカは私のものですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "傲慢な声",
      "text": "おお！　さぁ、乾杯だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "聞き覚えのある声",
      "text": "乾杯！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "ハハッ、ハハハハハハ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "貴様、今のが聞こえたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "これが貴様の求めた平穏な一生なのだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "ミスター・エーベンホルツ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "突然、地面に倒れて……危うく病院に連絡するところでしたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "大丈夫ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何も問題ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "計画については……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今は聞きたくない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "もう行く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "言いましたでしょ？　お好きにどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "二度と私を訪ねてくるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ゲルトルーデ",
      "text": "それについては、従うのは難しいですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "おかえりなさい――顔色が悪いですよ。どうかしましたか？　気分でも悪いんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……大丈夫だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "全然大丈夫じゃなさそうです。早く横になってください、僕はお湯を沸かしてきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "必要ない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "遠慮しないでくださいよ。祖父が病気で寝ている時も、こうやってお世話していたので慣れているんです。まずは横になって、他のことは全部僕に任せてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "もし良くならなければ、ハイビスカスさんを呼んできますし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "すぐに戻ってきますね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ウルティカ伯爵は、立っていられないほどの強烈な頭痛に耐えながら粗末なベッドに倒れ込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "次第に意識が朦朧としてくる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "下賤なウジムシが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "自らの高貴な血を捨てるとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "黙れ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "うっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "どこからか聞こえる声",
      "text": "自堕落なゴミが！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "遠くからチェロの音が聞こえてくる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "頭痛が和らぐことはなかったが、ウルティカ伯爵の脳内に響くあの声は、チェロの音に覆い隠された。\n彼はいくらか安堵を覚えた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "この旋律にはやや馴染みがある。\n頭痛がウルティカ伯爵の集中を散らそうとする。だがそれでも彼はこの旋律に聴き覚えがあると感じていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "どこかで聴いたことがある……\nどこで？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "目が覚めましたか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "動かないで。さっきハイビスカスさんが来て、あなたの診察と採血をしていきました。特に大きな問題はなく、恐らく最近のストレスが重なったことによる過度の疲労だろうとのことでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "（ストレスか……フッ……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今のチェロは……君が弾いていたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "そうですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君は……さっきのメロディーをどこで聴いたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "多分、幼い頃に誰かが口ずさんでいたのを聴いたのかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "よく覚えていないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "幼い頃……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "幼い頃――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君は――君はあの――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クライデ",
      "text": "僕が……何ですか？",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "衰弱したウルティカ伯爵は何度かもがいたが、とうとうベッドから起き上がることはできなかった。\nしかし彼の頭の中で埃を被っていた記憶が、チェロの音によって呼び覚まされ、目の前で一つ一つ再生されていく。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
