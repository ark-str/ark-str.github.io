{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_st01",
  "groupId": "act17d0",
  "stageId": "act17d0_st01",
  "title": "コード「ラマルク」",
  "storyCode": "OD-ST-1",
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act17d0/level_act17d0_st01.txt",
  "sourceHash": "a305e0407ae8f290bee731d24f8cc39d37f93867f298725448e4a786be8e9149",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……マグネットヒルNo.2内に入った。繰り返す。マグネットヒルNo.2内に入った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Iana？　Ela？　そちらの状況はどう？　オーバー。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "予定通り。間もなく最終段階を終える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "オーバー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Ela？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "Iana、戦闘準備！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "準備よし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "ジェミニ・レプリケーター起動！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "GRZMOTマイン設置！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "情報が正しいなら、これで最後のはず！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "こっちが終わりしだい、私たちもそちらに向かう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "Gówno！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ela",
      "text": "オーバーアンドアウト！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "情況はこんな感じよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "後はポーランド人に任せとけば大丈夫だろうさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "GRZMOTマインの起爆音だな。あいつらなら大丈夫だろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ここからが本番よ。本気を出していこう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "メーターを見て。この建物の中には、密封された核廃棄物があるみたい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Frost、目標までの状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "前方に検査ステーションと材料保管室。そこを抜ければ、主実験室がある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "ドローンの映像だと、向こうは検査ステーションおよびその周辺に簡易的なバリケードを張っているだけみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "遮蔽物が無い代わりに死角もない。入り口だけは塞がれてて、周辺に大量の有刺鉄線が張り巡らされてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "人数は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "判別可能なのが9人。おおよその位置は小隊の端末上にマーキングした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "検査ステーションから保管室に通じる出入り口は、完全に塞がれている。ドローンだけだとこれ以上は無理ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "報告は以上よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "他に出入り口は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "見つからなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "わかった。何とかする。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "LORDからは何かある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "焼夷弾がまだ残ってるが、何発必要だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "二発。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "検査ステーションの入り口はかなり手の混んだ封鎖をされてる。無計画に爆破すればガレキが更に邪魔になる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "では計画を伝える。天井付近および右の壁を破壊後、一人がロープでよじ登って、上の穴から制圧射撃を行う。残りのメンバーは右の壁に開けた穴を突破口として突入する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Frost、制圧射撃および突入時の支援を任せる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ブリーチングチャージ起爆後、Tachanka、あんたは天井付近にできた穴へ焼夷弾を発射。他の者はマーキングの位置を狙ってスタングレネードを投擲。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "突入はBlitz、あたし、Tachankaの順番よ。行動は迅速に。隙を与えないように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "何か質問は？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "よろしい。では、各員配置について。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Frost、あんたの合図で我々は行動を開始する。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "現在、所定の位置へ移動中。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "ブリーチングチャージをセット。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "こっちも設置した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "行くわよ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "スタングレネード！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "焼夷弾もぶち込んだ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "突入！！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "順調よ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Blitz、2時の方向！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "ファイアインザホール！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "10時の方向に機関銃手！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "前進しろ！　ここは俺が対応する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "ブリーチング弾発射！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "バリケードの破壊に成功！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "敵が倒れたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "あと3人いる！　正面！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "残り2人！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "状況、クリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "クリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "クリア！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "クリア！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "負傷者はいないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "よし、引き続き前進する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Frost、後方を警戒！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あたしが扉を開ける。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Blitzは周辺を警戒。Tachankaはドローンで廊下と保管室の状況を確認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "もうやってる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "よし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "この先の状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "保管室は弾薬でいっぱいだ。奴らはしばらくここに駐在してたんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "材料室に敵はいない。いくつか黒い結晶があるのだけが見える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "危険性は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "判断できない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "その瓶に入ってるのは何だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "発光する鉱物結晶？　こんな光り方のは見たことが無いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "鉱石？　それとも合成化合物かしら？　発光するということは、放射性物質の可能性もあるんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "その点は安心していい。ガイガーカウンターに反応はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "なら進みましょう。その石は気にしなくていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "それより、時間がない。急ぎましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "Ash？　こちらIana。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "敵は片付けたけど、通路を塞がれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "核心部へは通路を変更して向かう。オーバー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "あたしたちは主実験室への突入準備中よ。合流はなるべく早めに頼むわ。オーバー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Iana",
      "text": "了解、オーバーアンドアウト。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "どうする？　他の連中を待つか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "いえ、時間がないわ。これ以上は遅らせられない。進みましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "これが主実験室の扉か。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "最終確認後、突入する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "全員、警戒を。ターゲットを見つけたら優先して制圧。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "可能な限り短時間で。いいわね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "突入！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "誰もいないな……、変な機械があるだけだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "警戒は継続。実験機材がまだ動いてる以上、ターゲットはこの部屋の近辺にいるはず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "なら、まずは実験室に入ろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "ここは実験室内の制御室だ。ガラスの向こうに機械が見えるな？　実際に実験を行っているのはあっち側だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "気を付けろ……敵の数は不明のままだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "歓迎されざる客とは、いつも招いてもいないのに来るものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "（ターゲットらしき人物を発見。まだ撃たないで）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "（周囲の状況を報告）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "（他には誰もいない）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "（こちらも他に敵らしき存在は見当たらない）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "手を上げなさい！　レヴィ博士、端末から離れて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "一体、いつまで待てば会えるのかと心配していたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "警備兵を倒してきたのかね？　それは非常に残念だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "昨日、彼らには給料を支払ったばかりだというのに。無駄金を使ってしまったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "気を付けてくれ、ここは壊れ物だらけなのでな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "勝手に動かないで。茶番は終わりよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "終わり？　私の新たな実験はまだ始まったばかりだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "動かないで……次の警告はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "text": "ハハハハハッ……嫌だと言ったら？",
