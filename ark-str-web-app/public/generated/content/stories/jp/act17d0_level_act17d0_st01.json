    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "えっ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "その通り。まるで突然ロケットで月まで打ち上げられたみたいだ。これは冗談でもなんでもない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "text": "私、偵察に行こうか？",
