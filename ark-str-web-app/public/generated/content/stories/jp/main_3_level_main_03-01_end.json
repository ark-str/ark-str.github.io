  "sourceHash": "74660e59cbc2fb3b8e2afab9211073a373970bc6a5511274214806d5b8334523",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "ご報告します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どうした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "レユニオンの大部分が撤退したようです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "チェン隊長。こちらも、一通りの対処は完了しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "ならば、数日前に捕らえた、レユニオン構成員と思しき容疑者たちはどうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "何か、奴らから聞き出せたことは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "容疑者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "このクロスボウに見覚えはあるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "容疑者",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……では、扱い方はわかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "弾薬の構造はどうなっている？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "それに、スラムで何をしていた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "――龍門で、一体何をするつもりだったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "容疑者",
      "text": "…………",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "……いえ、何も聞き出せていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "奴らはずっとだんまりでして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "あるいは……本当に、何も知らないのかもしれませんが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "その場合、先ほど制圧した連中と同じで、命令に従うだけの手駒みたいなものなんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――なんとしても口を割らせろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "そのためなら、何かしらの方法を取っても構わん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "小隊の情報、指揮の方針、情報源、部隊の配置状況……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "奴らの知るすべてを引き出すんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "その上で、内容は残さず私に報告しろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "どのようなことでも、新しい情報であれば、即刻伝達するように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もしかして、近衛局のほうではすでに、レユニオンの構成員を捕縛していたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いや。正確には、その疑いがある人物しか押さえられていない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "いくら推測を重ねたところで、容疑は容疑にすぎないからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "――ホシグマに連絡を！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "主力部隊の状況はどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "まさか今も、例の感染者に勝手を許しているのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "それが、向こうのレユニオンも撤退した様子とのことで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "近衛局隊員",
      "text": "おとり作戦の可能性を警戒して、ホシグマ督察が調査に当たられているそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "チッ。相手は一人だというのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "行くも戻るも、奴の気の向くまま、とは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "アーミヤ。次の任務はわかっているな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "やはり、ミーシャさんの奪還……ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "その通りだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "今回はキミたちにも、共同で動いてもらいたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "近衛局が攻撃の主体となる。そこでロドスには、対象の捜索と切り込み役を担当してもらおう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェン",
      "text": "とは言っても、戦闘のほうは、撤退するレユニオンを足止めしてくれるだけで構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "……わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "でも、レユニオンを探すってなると……逆にこっちが見つかるリスクもあるわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "今でさえ、偵察チームはサポートが足りてないっていうのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "text": "あたしたちだけじゃ、どうしようもないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "であれば、ここは専門家を頼りましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "フランカさん、ペンギン急便に連絡してください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "もう一度、お二人の手をお借りするしかないようですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
