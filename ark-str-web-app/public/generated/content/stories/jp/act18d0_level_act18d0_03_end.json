{
  "server": "jp",
  "storyId": "act18d0_level_act18d0_03_end",
  "groupId": "act18d0",
  "stageId": "act18d0_03",
  "title": "サボテンの丘",
  "storyCode": "WD-3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act18d0/level_act18d0_03_end.txt",
  "sourceHash": "afda8a624867f919b038fb1c0678480fd7442ca36417b5419735139ee73a0865",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "3下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "あっ、ケルシー修道士、ようやくいらっしゃいましたか。おや？　そのお召し物は……"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "お招きいただき大変光栄です。しかし、突然のお招きでしたので、修道院にはふさわしいドレスがなく、倉庫にあったものを引っ張り出しましたが……このような格好でも構いませんでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "そうでしたか、もちろん構いませんとも！　というよりむしろそのお姿は何というか……とても凛としていて、見惚れてしまいます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ハイディ、こちらがケルシー修道士だ。ほら、ぼうっとしていないで早くご挨拶をして中へ入りなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "――――"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ハイディ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ハイディさん、お会いできて大変光栄に思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "あっ――えっ――あの、えっと……ハイディです――"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "はい、とても可愛らしいお名前ですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "――あなたが、ケルシー修道士、ですか？　おじさまからいろいろお話は伺っております。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "それは光栄です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "――――"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ケルシー修道士、あなたもトムソン氏をご存じでしょう。こちらのハイディ・トムソンは、あの変わり者の娘です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "そうでしたか。あなたのお父上は大変尊敬に値するお方です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "では、どうぞお入りください、ケルシー修道士。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "お招きに改めて感謝いたします、ヴィンセント殿。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "そういえば先日、伯爵がロンディニウムに行かれたのはご存じ？　あなたもあの都市へ行ったことがおありになって？"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "情けない話だが、昔、色々用意して向かったのに、行く途中で天災トランスポーターに「道が塞がれてるから戻れ」と言われてね……"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "落胆して家に帰って、その後すぐに大病を患ってしまったんだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "あら、それは災難でしたこと。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ところで、あの大詩人は今日はいらっしゃってるかな？　個人的にいくつか書いてきた作品があるので、彼に見てもらいたくてね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "やめておきなさい。トムソン氏が伯爵の前で、いわゆる「思想家」の原稿をどれだけ引き裂いてきたかお忘れですかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "わたくし覚えておりますわ。トムソンさんは本当に容赦ありませんものね。「思想の衝突に情けは無用」ともおっしゃってましたわ。激しいお方ですこと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "才能をひけらかしてばかりいるのも考えものだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "あら、そのような若い男性こそ魅力的じゃありませんこと？　意欲に満ちあふれて、素敵ですわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "もちろん、かつては私もトムソン氏を尊敬していたと認めるよ。しかし彼は、伯爵の前でもその傲慢さを隠そうとしない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "傲慢だと？　トムソン氏が？"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ええ。敬愛する伯爵の前では、我々は傲慢であってはならない。爵位や地位に関わらず……ここ数年、伯爵はこの土地をしっかりと治めてきた。これは誰の目にも明らかなことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "ふむ、ドルン郡は伯爵の領地ではなく、皆で共に治めてきた土地ではあるが……伯爵のリーダーとしての資質は確かに本物だ。私は彼を尊敬している！"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "それだけでなく、伯爵は何度もロンディニウムからお招きを受けている。我々のような小さな土地の者からすれば――おっと不躾な表現だがお許しを――これは誇らしいことではないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "おっしゃる通り！"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "あらいやですわ、そんなお堅い話はおよしになって。わたくしたちは皆、ヴィクトリアの民ですのよ、違いますこと？"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "あぁ！　民だなどと！　あの常軌を逸した絞首刑以来、我々は一体自分たちがどこの民なのかわからなくなってしまったというのに！"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "まあそうおっしゃらず。陛下が去ったことは皆残念に思っている。だがご覧なさい、我々は今日もこうして心ゆくまで酒を飲めているではないか。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "そうですわ、今日は楽しい日でしょう？　そんな恐ろしい話はなしにしませんこと？　――ほら、伯爵がいらっしゃいましたわ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "失礼。皆さんのお話を聴かせていただきました。非常に興味深く思います。リチャードさん、あなたの文章をぜひ拝見したいものですな。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "とんでもございません、伯爵、私ごときの文章などあなたのものに比べれば、はるかに見劣りするものでございます。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "そうですわ！　ヴィンセント様、ロンディニウムへ行かれたお話、早くお聴かせ願いたいですわ。どなたかにお会いになりました？　噂の大公爵とか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "皆さん、そう慌てずに。パーティーはまだ始まったばかりですよ。今日は祭日を祝う日だということをお忘れなく。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ところで、皆さんにご紹介したい二名の特別ゲストがいます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ケルシー修道士、どうぞ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ごきげんよう、皆様方。心よりごあいさつを申し上げます。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "まぁ！　なんて整ったお顔立ち……淑女でいらっしゃいますの？　非常に残念ですわ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "残念なことなどあるまい。ごきげんよう、ケルシー修道士。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "これはこれは、ケルシー修道士！　伯爵から懇意になさっているという噂はかねがね伺っております。なんでも、伯爵夫人の病を治して差し上げたとか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "はい。伯爵夫人にとって、あれは大変な出来事だったでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "あなたはどちらのご出身？　サンクタではないラテラーノの修道士なんて珍しいですわ。それにしてもあなたのお姿……なんて魅力的なんでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "美しいレディ、どこからいらっしゃったのかな？　そしてどちらへ行かれるのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "あら、わたくしが先に聞いていますのよ？　横から割り込まないでくださるかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "伯爵からあなたは素晴らしい才能の持ち主だと伺いました。ひょっとして哲学や芸術に関しても、独自の見解をお持ちでしょうか。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "滅相もありません。ただ偶然伯爵夫人をお助けすることができて、伯爵殿に気に入られたというだけです。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ほう、伯爵と懇意なのであれば、きっとトムソン殿のこともご存じでしょう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "もちろんですとも。トムソン殿は、ドルン郡でも有数の文化人です。伯爵が彼の話をされているのをよく耳にします。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "それは素晴らしい。おい君！　私が持ってきた赤ワインを用意してくれ。伯爵とこちらの修道士に振舞って、共に語らいたい！"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "ねぇ、わたくしたちのパーティーを独占しないでくださるかしら。それよりもっと楽しい話をしませんこと？　例えばロンディニウムで行われるファッションショーについてとか……"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "私は何でも構わんよ。ここで足を休められればね。ついでに見聞を広めさせてもらうとしよう。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "まったく、怠け者にも程がありますわよ。真面目にやればあなたの事業はもっと成長するでしょうに。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "やれやれ、三つのワイナリーだけでは、まだ不足だというのかね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "おっと、そうだ！　たしか、もう一人ゲストがいるとおっしゃっていましたね――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "ごきげんよう、おじさまおばさま方。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "ハイディじゃないか！　どうしてここに？"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "おお！　ハイディ、見違えたな……トムソンの奴め、子育てに関してだけは、一生彼には及ばないかもしれん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "皆さん、ハイディはまだお酒を飲んでいい年齢ではないので、彼女にはお酒を渡さないようにお願いしますよ。誰か、クリームソーダを。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "もう、子供扱いはやめてよね、ヴィンセントおじさま。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "そういうわけには行かん。君のお父さんから釘を刺されてるんだ、まだ未成年なのだから……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "はあぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "わかったわかった。ならクリームソーダじゃなくジンジャービールに交換してもらおう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "そうやって気を遣われるのが嫌なの！"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "ハハッ、ハイディは早く大人になりたいんだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "けれども、娘にさっさと成長してほしいと思う父親はいませんわ。わたくしもこれくらいの歳に、ジュエリーを買いたいと言ったら、お父様に大声で叱られましたもの。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "お酒はダメでも、パーティーに参加するくらいはいいでしょ？　ええと……ケルシー修道士の隣に座っちゃお！"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "それは大変光栄です。ハイディさん、帽子をお取りしましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "あっ……だ、大丈夫です。かぶったままで平気ですから……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ハイディ、もともと今日はこっそり抜け出してきたのだから、あまりはしゃぎすぎてはだめだぞ。もう少ししたら、上に行って大人しく寝なさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "ううっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ハイディ、今日の格好はあなたのお母様にそっくりだね。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "そうね、彼女の子供の頃に――"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "もうっ……！！"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……ケルシー修道士、あなたも私がまだ子供だと思われますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "それはあなたにとって、本当に重要なことですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "お注ぎしましょう、ジンジャービールです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "――――"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "あ、ありがとうございます……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "気に入ってもらえたかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……結構美味しいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "あら、ジンジャービールはアルコールなんて入ってないわよね？　どうしてお顔が赤いのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "この子は恥ずかしがり屋ですからね、いつものことですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "さぁ！　それでは皆さんお揃いになりましたので、正式に始めるといたしましょう！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "まったくその通り！　リターニアの芸術は大変素晴らしいですが、リターニア人はその才を鼻にかけています。彼らに私たちを見下す道理などありません！"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "リターニアは異変が多すぎますわ……わたくしは幼い頃から巫王の物語を聞いて育ちました。そしてリターニアへ旅行しようと思った矢先に、双子の女帝があの巫王を殺してしまったんですのよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "巫王の恐ろしさを知りながら、旅行に行こうなどとは……"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "若くして即位した君主たちと違い、巫王は齢五十近くになってからようやく皇帝となり、それでいてリターニアを長きにわたって統治しました。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "巫王がこの大地における最も強大な術師であったことは疑う余地がありません。彼は自らを怪物に変えてしまったんですよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "数々の恐ろしい物語に描かれていましたわ。彼の角は、不気味な形にねじ曲がり、奇妙なエネルギーを放っているんですってよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "しかし写真ですら巫王の姿を見たことはないな。ゲフッ……失礼、いや、この酒は実に美味い――ああ、双子の女帝の写真なら新聞で見たぞ。一人は金ピカで、もう一人は黒ずくめだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "リターニアは情勢の変化が激しい国です。巫王が常に塔から全土を睥睨しており、高みから降りてくることはごく稀でした。王臣との接見ですら、塔の頂上から映された巨大な影で行いました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "しかし双子の女帝に角を折られ、最後に大地に降り立った時、彼の姿は惨めに変わり果て、見る影もない有り様でした。まったく嘆かわしいことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "あのクーデターの全容はわかりませんが、私の知る限り、我が国の最も誇り高き英雄ですら、巫王の実力には及ばなかったはずです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "それこそが「女帝の声」が護衛の騎士を引き連れてヴィクトリアを訪れた際に、それまで騒いでいた公爵たちが言い争いを中断し、手厚くもてなした原因なのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "何ですと？　お聞きした限りではロンディニウムにも行かれたことがあるようですが？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ええ。私はロンディニウムからやってきました。あの地のサンクタから教えを受け、修道士になったのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ははっ、言ったでしょう、ケルシー修道士。ここにいる素晴らしい友人の皆さんは、あなたを気に入ったようですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "もちろん。実は私にはあなたと同じ年頃の娘がいるんでね。しかし私が苦労して稼いできた金貨を湯水のように使うことしか知らなくて……あなたの爪の垢を煎じて飲ませたいくらいだよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "今宵はあなたと知り合えて、とてもうれしかったですわ。あなたはまだ独り身でらっしゃいますこと、ケルシーさん？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "ケルシー修道士！"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "これ、ハイディ！　勝手に口を挟むんじゃない。そろそろ上へ行って寝る時間だぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "まぁまぁ伯爵。伺ってみませんか？　こんな時代です、子供は我々が想像しているよりもはるかに大人ですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "うーむ……そこまでおっしゃるなら仕方ありませんね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "あの……ケルシー修道士、ウルサスに行かれたことはありますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ほう、あの反乱と暴力に満ちた国ですな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "遊学していた頃、サンクト・グリファーブルクでしばらく過ごした経験があります。ハイディさんはウルサスに興味がおありですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "はい、そうなんです！"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "パパが昔、読ませてくれた本がありまして、それがウルサスの作者によって書かれたものだったんです……"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ウルサスには二種類の芸術しかありません。話題集めの単なるおふざけか、真に永遠なる偉大な作品か、です。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "トムソンさんが娘に読ませるほど評価している作品ですもの、きっと後者ですわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "おやおや、皆さんは本当に彼を信頼なさってるんですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "パパは、その作者を非常に高く評価しているんですよ。サンクト・グリファーブルクまで彼を訪ねようとしていますが、ずっと仕事の都合で行けず、今年は古傷が痛んで結局行けていません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "お父上はお怪我をなさっているのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……はい。膝を壊してしまい、手術を受けるのが遅れてしまって、後遺症が残ってるんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "昨年、負傷して帰ってきたのですが、強盗に遭って崖から落ちたと言うだけで、それ以外は何も教えようとしないんですよ。はぁ……一体何があったのやら。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ハイディさん……あなたはウルサスへ行きたいのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "それはダメだ！　あの国は今、前皇帝の死と反乱で、情勢が不安定になっている。あの地へ行って学ぶなら、数年様子を見てからにしなさい！"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "そういうのじゃないってば！　ちょっと訊いてみただけだもん……ケルシー修道士はあの国に対してどのような印象をお持ちですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "……一つお話をしましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "噂によれば、ウルサス第六軍は一瓶のウォッカが原因で、跡形もなく消えたそうです。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "なんとも胡散臭い噂ですな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "いかなる物事も、その始まりだけに注視したあと、終わりに視線をうつせば、目に入った結論は往々にして想像を超えます。我々は過程をもって物事を説明することに慣れている……違いますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "一理ありますな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "事の発端は、とある愚かな軍人の「徴税」行為でした。しかし結果として、ある貴族を脅すことになってしまいました。両者の立場と時勢が絡み、この件は、次第に大きな問題に発展したのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "当時の第六軍は手遅れなほど腐敗していると悪名が高い集団、そして第五軍は、いまだ旧貴族の勢力が深く根付く中、若き皇帝と新たな帝国議会に無条件で服従していました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "具体的な発起人が誰かははっきりしませんが、最終的に第五軍は相手の隙に乗じて、二つの移動都市の経路中央で、第六軍と正面から交戦したのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "「大反乱」の始まりには諸説ありますが、確かに第六師兵団の数々の蛮行については、私も聞いたことがあります。"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "彼らの争いは、そうやって始まったんですの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "……もしこれほど単純であったなら、大反乱などと称されることはなかったでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "長い間辺境に駐屯し、権力や影響力をウルサス内地に持たなかった第四軍――彼らが突然帝国議会に寝返り、「裏切り者」である第六軍との関係を断ち切ったのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "旧貴族が数名のスケープゴートを処刑した後、彼らの手には第六と第八軍という二枚の切り札しか残っていませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "しかし翌年の冬、第八軍とその背後の貴族は同じ手を使い、皇帝に降伏しました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "窮地に立たされた第六軍が最後にどうなったか、容易に想像できるでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "そしてこれらすべての引き金とは――皆さんもうお分かりですね。一人の愚かな軍人が酒に酔い、持っていたウォッカの瓶で若い貴族に傷を負わせてしまったことです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "……見事な解説です、ケルシー修道士。この物語は真相に近いはずでしょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ハイディさん、私は「これがウルサスのすべてだ」とは言いません。この大地のいかなる文明も、あなた自身で確認、考察し、評価するべきなのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "あなたはウルサスの何を見て評価しましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "美しい田園風景？　英雄譚？　サンクト・グリファーブルク歌劇場の悲喜劇でしょうか？　しかし私が見たのは大反乱の余波であり、社会が大きく揺れる時代です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……ヴィクトリアにもそのような時代が訪れるのでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "……訪れないとは保証できません、ハイディさん。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ありえない！　まったくこの子は……修道士のウルサスの話を聞いて怖くなったのかね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ウルサス人を侮辱するつもりはないが、かの帝国は確かに野蛮で、理不尽な国だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "でも今のロンディニウムだって――"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "――同じではない。あの出来事は残念だが、それでヴィクトリアが一瞬でも揺れ動いたことがあったかね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いな商人",
      "speakerId": null,
      "text": "ほらほら、伯爵。ロンディニウムの話題になったことですし、例の旅について語るべきタイミングではありませんか？　我々はそれを心待ちにしていたんですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "大貴族のどなたかにはお目にかかれましたかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ええ。実は旅の途中、光栄なことに、ノーマンディー公爵から彼の旗艦へとディナーに招待されたのですよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "何ですと！　そのようなことを今日まで黙っていたのですか……！"
    },
    {
      "type": "dialogue",
      "speakerName": "明るい女性貴族",
      "speakerId": null,
      "text": "まあ、ノーマンディー公爵ですって……？　あのお方はかねてからリターニア人を嫌ってらっしゃいますが、「女帝の声」の使節たちとはトラブルになりませんでしたの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "何事もありませんでした。しかし公爵の使用人が言うには、あの晩公爵は美しく優雅な使節たちに一度も目を向けなかったそうです。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ハハ、それでこそ「公爵」のあるべき姿ですな。"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ウルサスには気取った公爵が数百……は言い過ぎですが、数十――そこまではいないかもしれませんが、でも確かに溢れてはいます。率直に言わせてもらえれば、無能な方も中にはいらっしゃる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "その発言は驕りにも思えますが、ロンディニウムの空気をまとった方は、皆そうおっしゃいますな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ノーマンディー公爵ほどの方ならば、欲に目が眩んだリターニアの過激な者たちを、何十年でも大人しくさせられると信じています。ましてや彼のような大公爵は一人にとどまらず……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "ハイディ、疲れたのかい？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "え？　ううん……ケルシー修道士のお話についてまだ考えてたの。おじさま、修道士と二人だけでお話ししてもいいかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "風流人ぶる男",
      "speakerId": null,
      "text": "ふむ、しかしロンディニウムの話題にケルシーさんがいなければ、退屈になってしまいますな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "恐縮でございます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィンセント伯爵",
      "speakerId": null,
      "text": "おや、ちょっと失礼。麦畑男爵が私に手招きするのが見えました。彼と話してきます。皆さんとは、また後で話の続きをしましょう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ハイディさんに、がっかりさせてしまいましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "え？　あっ……いえ、そんなことありません、大丈夫です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "うーん、ええと……ただ、もっと詩歌や小麦の収穫なんかについてお話できると思っていたのですが、そうはならなくって……"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "退屈な他国の政治の話ばかりだったと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "うっ、あはは……"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "そういう会話をすることも、このパーティーの意義の一つですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "でも……私の勝手な推測ですが、あなたも少し退屈に感じたのではありませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "さっきのお話、あなたは本当はもっと深くまでご存知のはずです。おじさまを取り囲み騒いでいた人たちを、あなたは実は快く思っていなかったのでは？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "あなたは少し私を誤解しているようですね……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "あはは、それはおっしゃる通りかもしれません、ケルシー修道士。何せ私たちは、今夜知り合ったばかりなのですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ケルシーと呼んでいただいて構いません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "では、ケルシー……私と一緒に少し歩きませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "あと少ししたら、ヴィンセントおじさまに上に行ってベッドで寝るよう言われてしまいます。でも、こんなに早く寝たくありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "外の雪は強くなったみたいですが、嫌ですか……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "――とんでもありません、お供させてください。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "すごい雪ですね！"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ここ数年で一番の大雪です。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……私は雪が好きなんですよ。ケルシー、私はこの故郷が大好きなんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "……ええ、そのようですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "ふぅ……寒いですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "皆さん暖かい暖炉を囲んでいますよね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "はい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "今は私たち二人だけ、ケルシー……えへっ、ケルシー。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "――あなたと二人だけになるのは本当に難しかったですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "ハイディ、君はまだ若い……"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "君のお父上は、こんな簡単に君を巻き込むべきではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "これは私が望んだことです、ケルシー。何も知らぬ子供のように暖かい部屋から窓の外を眺めるのではなく、意義のあることがしたいんです……故郷のために。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "……このヴィクトリアに、吹雪にさらされず冬を過ごせるオークの木があると思いますか？　私たちは、若いうちから準備をしておくべきなのです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "君はお父上とよく似ている。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "――褒めて下さっているのですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "そう思ってくれて構わない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "えへへ……あ、ここへは誰も来ませんので――"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "これでようやく、手紙を渡せますね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "君のお父上の諜報員は、これまで一度も遅れたことがなかった。彼らはこのヴィクトリアで最も優れたトランスポーターや労働者、各界の有志者であった――今回を除いてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ケルシー",
      "speakerId": "char_003_kaltsn08",
      "text": "何かトラブルでもあったのか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "幼いハイディは足を止めて、身にまとったあどけなさを捨てた。\n彼女は正しい。雲行きが怪しくなる前に、若者こそ真っ先に準備を整えなければならない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "――手紙は二通あります、ケルシー殿。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハイディ",
      "speakerId": null,
      "text": "一つはヴィクトリアから、もう一つは「カズデル」からです。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
      "speakerId": "char_003_kaltsn08",
      "aliases": [
        "ケルシー"
      ]
    }
  ]
}
