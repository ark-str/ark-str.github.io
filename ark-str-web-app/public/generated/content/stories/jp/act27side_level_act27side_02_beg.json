{
  "server": "jp",
  "storyId": "act27side_level_act27side_02_beg",
  "groupId": "act27side",
  "stageId": "act27side_02",
  "title": "リトル・ボーイ・ブルー",
  "storyCode": "SL-2",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act27side/level_act27side_02_beg.txt",
  "sourceHash": "48a78c2522f08f88c88de5a41ca05e631514b7119d75024e6dc039bd3faf3bd9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "親愛なるシエスタ市民の皆さん、おはようございます。今日は1099年8月16日です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "湿度は75%、視程距離18キロ、南南西の風が吹いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "予想されている火山の噴火まで、あと十五日あります……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "せっかくのお天気ではありますが、移動都市外の海岸で水遊びなどをするのは控えてください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "平穏な生活に数え切れないほどのトラブルが潜んでいるように、一見穏やかな海面の下には、見えない暗礁や暗流がありますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "さて、日差しが気持ちいい朝ですが、皆さんご機嫌はいかがでしょうか？　本日はバンド、ボーンズボーンの『Life Always Goes On』と共に素晴らしい一日を始めましょう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "朝七時、眠りから引きずり出される、夢の中では口説いていた子とキスをしていた♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "瞼を開けて目に映ったのは、相変わらずうんざりするような光景、太陽と面倒事が一緒にやってきた♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "おしゃれな店主",
      "text": "さーて、今日最初のお客さんは……なんだ、やっぱりあんたか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "おしゃれな店主",
      "text": "こんなに晴れた朝なんだ、火山が噴火しそうっていう知らせ以上にいいニュースはないのかね？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "疲れ切った政府職員",
      "text": "ヘイリー夫人。もしあなたが、少しばかり頑固なところを改めてくれれば、私が持ってきた知らせも良いニュースになるのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "その呼び方のほうを改めな。まだあんたから年寄り扱いされるいわれないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "コスタ、今日のいい天気に免じて、少しは時間をあげようじゃないか――今回はどんな屁理屈を持ち出すつもりだい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "では、就職補助金と免税についての説明を……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "ホントに屁理屈だね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "ここから都市の中央に引っ越した後、あたしたちがどんな職に就けるのかを先に言ってごらん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "観光客が来ない商店街に居座るよりも悪くなることはないですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "それにヘイリーさん、この通りに住んでいるのはあなた方一家だけではないですし……住民全員がこの同意書へのサインを拒んでいるわけでもないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "そうかい。なら同じ理屈だよ。あんたを罵る人間はあたしだけじゃないってことだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "シティホールにアドバイスしておくとね、ここに住んでる人たちが何を一番望んでるかをよく理解しておくことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "当時のヘルマンは、あの火山がもうすぐ噴火すると言ったね。でも結果？　二年が経っても、うんともすんとも言ってない。シエスタの市民はあんたらの政策に振り回されて苦しんでるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "ああ、もちろん、あんたみたいにシティホールで体裁のいい仕事を見つけた人は別だけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "この「ホワイト・ヴォルケーノ」はただの建物じゃないんだ。あたしと三人の子供の家なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "火山噴火って騒いだ時に一回引っ越したんだ。ヘルマンは、自分がもう一回引っ越せなんて言える立場だと思わないことだね。引っ越しを要求するヘルマンが正気かどうかさえこっちは分からないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "ヘイリーさん、これは個人の引っ越しの問題じゃないんですよ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "ここが私の場所、私の生活だとわかってほしい♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "放送の音",
      "text": "あれこれ指図すんなよ、次に言ったら殺すから、殺すから♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "なんて良い曲だ、この歌詞気に入った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "コスタ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヘイリー",
      "text": "ほらほら、もう話を聞く時間は終わりだよ、コスタ。いや「尊敬すべきシティホールのお役人様」、うちの店じゃあ見送りはしてないよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バード",
      "text": "ごめんくださいね。ちょっと聞きたいのだけど……このお店では、まだ歌手を募集している？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "みなさんがご覧になっている展示ケースですが、中の生き物は「シエスタカザンオリジムシ」です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "このオリジムシは、火山環境で長時間過ごしています。外見と習性がいずれも他の地域のオリジムシとは明らかに異なるため、生物学者は特別種として研究しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "不思議なことに、今オリジムシたちは火山を離れ、博物館の恒温器の中で生活していますが、休眠と活動のサイクルは、いまだにシエスタ火山のエネルギーの上下と一致しているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "これはまさに、生物と生態環境の相互作用、そして相互依存の表れです……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "やるじゃない、エイヤフィヤトラ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あっ……スワイヤーさん！　バカンス中ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "まあそんなところね。めったにない休みがとれたなら、やるべきは思う存分、夏を満喫することだけでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "アンタはどうしてここに？　そういえば研究者としての一面を見るのは初めてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "私は博物館の資料整理の応援に来ただけですよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "でも観光客たちは真面目に聞いてたわよ、メモを取ってる人もいたんだから。それにアタシも聞きたいことがあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "この展示品について少し教えてくれないかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "変ですね。スワイヤーさんは展示品より、博物館周辺の地価の方に関心があるみたい……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "チカって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ドリーさん？　どうして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "そんなに驚かないでよ。この建物には火山の絵がたくさんあるから見学に来てみたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "それで、チカって何のこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……土地の価格のことです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "一般的には、景気が良い場所ほど、地価も高くなります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "興味深いね。人間は土地にまで値段を付けるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "なら火口はきっと一番高いんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あっ……そういうことではないんですけど。でもドリーさん、こんなにたくさん人がいる場所に、気軽に姿を現して本当に大丈夫なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "あぁ、キミが何を心配してるかはわかるよ。ここは一つ、その心配を消してあげよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドリーは体を揺らし、軽やかに跳び上がると、あっさりと……スワイヤーの頭の上に止まった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "す、スワイヤーさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "なあに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "随分と驚いた顔をしてるけど、どうしたのよ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "うぅ、何でもないです。帽子がちょっと傾いてますよ。私が直してあげますね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "ほらね、気付いてないでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "どうかな。とっても不思議じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "（小声）ドリーさん！　勝手に人の頭に乗るなんて失礼ですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "はいはい……キミたち人間と付き合ってると色んなルールや規則があるもんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "でもこれで分かったでしょ。いらないトラブルを避けるために、わたしが興味のある人しか、わたしの存在を感じ取れないってわけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ドリー",
      "text": "もうこんな時間だ、わたしは先に行くよ。キミは、約束を忘れないようにね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "ねぇ、エイヤフィヤトラ？　エイヤちゃんってば！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "きゃっ！　スワイヤーさん、ごめんなさい……少しぼうっとしてました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "エイヤちゃんというのは……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "たった今思いついたあだ名よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スワイヤー",
      "text": "シエスタに来たからには、リラックスするのも忘れちゃダメなんだからね。時間ができたらアタシのとこに来なさい、一緒に温泉に行きましょう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "博物館宛てのお荷物です――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "どなたかいらっしゃいませんか――？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "こんにちは。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "博物館の担当の方ですか？　博物館宛ての小包です、受け取りのサインをお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あっ、はい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "差出人住所はリターニア……ヴィルヘルム大学……ケラー先生が取り寄せた資料ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "荷物を入れる箱の中は様々な書類や標本が詰め込まれ、その中に一枚の手紙が入っていた。\n封筒はどうしてか半分なくなっていて、中の写真が露出していた。それに封筒の縁の跡はまるで……かじられたようだった。"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "この写真……ウナ火山？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……トランスポーターさん、待ってください――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "ええと、ご質問の意味がよく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "そのお手紙は確かにリターニアからのものです。受取人住所もここですし、何か問題でも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "すみません、差出人の情報を確認したくて。それと、このお手紙はいつ、どこから送られましたか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "お仕事の邪魔をしてごめんなさい、でも私にとって、とても重要なことなんです――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "そう言われましても……差出人の情報はすべて封筒に書いてあるのでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "あっ、そういえば！　ここに届けるお荷物の中に破れた封筒の郵便物がありましたね。あれは私の手元に届いた時にはすでにその状態だったんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "もともとの配達担当が、昨日突然休んでしまって、荷物を引き取ったんですが、辛うじて破けた封筒に「ヴォルケーノ」と書いてあったので、ここに届けるしかなかったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トランスポーター",
      "text": "手紙に差出人の情報が書かれていなければ、私も詳しいことは分かりません……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ごめんなさい、お邪魔しました……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "写真の裏には、歪んだ文字でそのように書かれていた。分厚い手袋をはめたままペンを握って書いたかのようで、書いた者の筆跡は判別しにくかった。\nインクの跡は時間が経っているように見える。長く旅した手紙であるのか、封筒と写真はかすかに黄ばんでいた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "アデル、何を探しているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "カーン先輩！　博物館の研究資料の中に、私のお父さんのノートはありますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "カティア教授のノート？　どんな課題に関するものかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "お父さんが書いたノートなら、何でもいいです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "そうだな……ケラー教授はヴィルヘルム大学の研究資料の一部をここに置いているけれど、カティア教授の元々の研究分野はアーツで、火山との関連性は比較的薄いから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "『火山植物図鑑』、『火山活動における源石エネルギーの変換について』、『火山噴火データモデル』……これは、全てマグナ教授のノートだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "待ってください。この『火山噴火データモデル』はお母さんのじゃないような……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "慌ててノートを広げると、その中にはいくつかの論文とデータ資料のコピーが入っているだけだった。ノートの最後には、何ページか破り取られたような跡がある。"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "このノートは、見たことがない気がします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "変だな、私も印象にない……火山噴火時の源石エネルギーか……まさに火山学とカティア教授の専門との複合分野だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "アデル、一体何を探してるんだ？　何か重要なことでもあるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "カーン先輩……例えば手紙が、何かしらの……えっと、原因で通常通りに配達されなかった時……何年も後に届くことってあると思いますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "国外に送るのなら、郵便物の紛失の可能性は低くないけれど、何年も遅れて届くかと言うと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "私は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ここ数日……奇妙なことがたくさん起きています。でも、リターニアから「火山」に送られたのなら……私はやっぱり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "きっと私の考え過ぎですよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "毎日部屋に閉じこもっていると気が滅入るぞ。もしも、あれこれと悪い方に考えが転がるようになったなら、外に出た方がいい。ちょうど私も君に手伝ってもらいたいことがあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "黒曜石は知っているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "火山から産出される鉱石ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "そうだ。黒曜石の鉱業はシエスタの主な収入源だったが、後に過度な採掘による環境破壊を考慮して、何年も前に採掘が禁止されたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "シエスタが移転する際はサンプル採取の時間がなくてね。もしここ二年以内に火山から採掘された黒曜石が見つかれば、火山噴火の予測時期が、より正確になるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "まあ、この仕事はシティホールのやかましい連中を黙らせること以外に実質的な意味はない。とは言え、この分の投資はしてもらってるからね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "でも、もう火山に黒曜石のサンプルを採取しに行くことはできませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "そこで、特殊なルートが必要になるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "特殊なルート？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "実を言うと前にも試したことがあるんだけど、あの変人はどうも付き合いが難しくてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "だからこの件は、君の助けが必要なんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "こんにちは、あの……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "だらけた声",
      "text": "黒曜石火山温泉旅館へようこそ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "だらけた声",
      "text": "食事、宿泊、入浴、どれかな？　料金表はそこね。もしオープンイベントの広告がまだ貼られてたら、上に書いてる通りの割引率で計算して、お金はカウンターに置いてくれれば勝手に入っていいよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "この旅館……すごくきれいですね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "どうして黒曜石っていう名前なんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮し出した男性",
      "text": "黒曜石こそがシエスタのソウルだからさ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "えっと……それはなぜですか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮した男性",
      "text": "よーく見てみてくれ。しっかりとした重み、きめ細かな手触り、そして艶やかで温和な色合い。じっくりと観察してみると、この稀に見る美しさの虜になるだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮した男性",
      "text": "それにな、黒曜石一つ一つに唯一無二の美があるんだ――唯一無二とはどういうことかわかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮した男性",
      "text": "つまり黒曜石は自然の生んだ宝で、火山の結晶なのさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮した男性",
      "text": "おっと、つい色々しゃべっちまったな。どうだ、あんたも黒曜石に興味を持ったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "はい……！　とても興味があります！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮した男性",
      "text": "そりゃよかった！　黒曜石を商品と見なすのは低俗な凡人のすることだからな。俺のコレクションを見てみろ、遠慮はいらないよ！　そうだな、まずはこっちから紹介しよう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ご説明ありがとうございました……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "これだけたくさんのコレクションを持っているなら、販売してもいい黒曜石もあったりしますか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "だらけた男性",
      "text": "ん？　販売？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "だらけた男性",
      "text": "ダメだな。一つもないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "だらけた男性",
      "text": "これはコレクションなんだ。コレクションって理解してるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "だらけた男性",
      "text": "その美しさを本当に楽しめる人の家に置く物で、売るための物じゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "だらけた男性",
      "text": "なんだよ、あんたも凡人だったのか……ふん、ならもう話すことはないな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "えっと……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "その辺にしてください、ペリペさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "カーン先輩？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "大丈夫、私がこの人と話すよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペリペ",
      "text": "またあんたか……悪いがお二人さん、今日はもう店仕舞いだ。帰ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "ちゃんと話し合いましょうよ、ペリペさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "シエスタでは何年も前に黒曜石の採掘が禁止になりましたが、私的に購入できるルートをあなたがご存じなのは、私共も承知しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "火山研究にそれほど多くの黒曜石は必要ありませんし、あなたの手の込んだ装飾品にも興味はありません。ここ二年であの火山から採掘されたものが、ほんの少し欲しいだけなんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "コレクターとしてのモットーを曲げることなのは分かりますが、どうか今だけはシエスタのためだと思って、お願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリペ",
      "text": "何も話すことはないな。シエスタ人がどうあるべきかをあんたに教えられる筋合いもない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "カーン先輩、ごめんなさい、私が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カーン",
      "text": "……いいんだ、行こうか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ペリペ",
      "text": "おい、そっちの嬢ちゃん、待ちなよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリペ",
      "text": "あんたは、そっちの眼鏡坊主よりずっと話が通じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "あの……考えを改めてくれたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリペ",
      "text": "いや、俺は大切な宝物たちを売ったりはしない。だが、偶然にも仕入れのルートを知っていてな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "ありがとうございます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ペリペ",
      "text": "俺が教えたって言わないでくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "はい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "迷子の生物",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アデルは嬉しそうに足を踏み出したが、突然現れた生物に行く手を遮られた。\n目の前を行くちびは、シエスタの古い道路標識をかじりながら、のんびりと店の外に出ようとしていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "一歩、二歩、三歩。そこで急に速度を落とすと、温泉旅館の外にある店の看板に視線を移した。そしておもむろに口を開き、住所の書かれた箇所を噛みちぎると去っていった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "えっ、標識と住所を食べてる……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アデル",
      "text": "住所？　封筒の住所もあの子が食べちゃったの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
