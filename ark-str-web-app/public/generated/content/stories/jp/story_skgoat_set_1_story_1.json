{
  "server": "jp",
  "storyId": "story_skgoat_set_1_story_1",
  "groupId": "story_skgoat_set_1",
  "stageId": null,
  "title": "追加の仕事",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_skgoat_1_1.txt",
  "sourceHash": "0a9291a9fa3a24b9bb6fcdc476af1688b9f2c9cfe3832f5173e1964b9419c873",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 地灵"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "ここでいつもリズムが崩れるのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "鍵盤が重くて、後半テンポが上がると追いつかなくなるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "そうかもしれません。でも、克服できるはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "たくさん練習すればきっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "今日はもう十分過ぎるほど練習したでしょう。それに姿勢も乱れてきてる。これ以上練習を続けても、逆効果になるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "休憩にしましょう。それでも随分上達した方よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "でも、次はいつレッスンを受けられるか分かりませんし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "アーススピリット先輩みたいに弾けるようになりたいんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "あなたは才能がある、そんな日はきっとすぐに来るわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "ハーイ！　アーススピリット！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "ドクターに言われて来たんだけ……ど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "あれ？　どうしてエイヤフィヤトラちゃんもここにいるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "アデルにオルガンを教えているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "へぇー、オルガンは君のとっておきの隠し芸だと思ってたのに。そんな簡単に人に教えちゃっていいの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "自分だけのものにしておく必要なんてないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "でもなんでエイヤフィヤトラちゃんがオルガンを勉強するの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "音楽学校ばっかりのリターニアでも、全員に音楽を学ぶよう強制はしないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "それに、今はロドスにいるんだし、楽器なんてできなくたって大丈夫じゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "ロドスには、リターニア人好みの娯楽施設がないのよ。余暇に楽器を弾くことは休息にもなるし、こんな殺伐とした日々の中でも、一時の美しさや安らぎを感じることができるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "しかもリターニアでは、高い音楽的素養を持った人は、高いレベルの教育を受けた人だと見なされるの。これは集合住宅エリアに住む感染者にとっては得がたいものだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "（音楽で一芸に秀でていれば、将来リターニアへ行った時、感染者の身分を隠すのにも便利だしね。）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "（アーススピリット先輩、何を言ってるんだろう？　小声で聞こえないよ！）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "くすぐったいです！　分かりました！　分かりましたから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "アデルに教えているのは、予行演習みたいなものよ。今後、他の人を教える際に、レッスンのカリキュラムを決めるためのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "けど、エイヤフィヤトラちゃんは覚えるのが早いね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "僕が前にロドスに戻って来たのっていつだっけ？　そんなに経ってないはずだけど、練習を始めたのはその後でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "なのに、もう普通に弾けるようになってるんだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "ええ、今日でまだ三回目のレッスンなのに、途切れ途切れだけど弾けるようになったわ。ガリア語で『月光曲』という名の曲よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "アデルが音楽方面でこんなに才能があるだなんて思わなかったわ。本当に羨ましい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "優れた音楽は、こんな時代を生きる私たちに、多少なりとも人生の美しさを感じさせてくれるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "音楽はとても面白いですよ。これとは違うリターニアの楽器なら、両親に教えてもらったこともありますし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "それにしても、この鍵盤は本当に重すぎです。テンポが速くなると手が追いつかなくなっちゃいます……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "でも本当にいい音だね。伝統的なものの音色とは全然違うし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "いつも聴くたびに衝撃を受けるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "でも実はこの楽器、本当はもっともっと大きいんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "弾いたことはありませんが、以前に母が教員をしていた学校で見たことがあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "大聖堂の壁一面ほどもある大きさなんですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "ここにあるのは、伝統的なオルガンを改造したものなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "できる限り元の音を再現しつつも、小さくする必要があったから、妥協してる部分も多いわ。鍵盤が重いのもそのせいね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "もし本物の音を聞いたら、もっと感動するはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "てことは、僕を君の故郷ツアーに連れてってくれるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "それは楽しみだなぁ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "うちはリターニアの辺鄙な片田舎よ。そんな物あるはずないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "ちぇっ……あ、そうだ！　本題を忘れるところだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "ドクターに言われてここに来たんだ。コレを君に渡すようにって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "あら？　何かまた面倒事かしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "それは……記入が必要な地質分析報告書？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "見せてちょうだい。えーと……ロドス前方の航路に関する地質分析報告書……それと――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "近日中に付近で発生する可能性のある、天災に関する報告書及び、地質サンプルの分析が五枚分。サンプルの所属年代と鉱物の構成について鑑別を行い……なるほど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "これ、ドクターはいつまでに必要だって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "明後日。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "明後日！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "この仕事は三人組の専門チームで処理しても最低二日はかかるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "もちろんロドスにはそんなにたくさんの地質学の専門家はいない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "しかもロドスは医療企業として今のところ――おそらく今後も地質実験部門を作る計画はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "とにかく、人も設備も足りないわ。しかもこの状況はこの先も変わらない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "アーススピリット先輩！　私がお手伝いしましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "あなたが心配する必要はないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "私がいれば問題ないから……アデル、あなたはリラックスしてしっかり休みなさい。これは私に任せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "先輩、今日はもう十分に休みましたよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "でも明後日、仕事でバティと一緒に外出するんでしょ？　ちゃんと休みなさい。自分の仕事は自分で処理できるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "私は今回一緒に行けなさそうね。補聴器の調子はどう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "ロドスの室内環境下では今のところ問題ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "外でも、問題がなければいいんですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "そうね。もし外出のために設備支援が必要なら、もう一人の先輩を訪ねて聞いてみるといいわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "あの人はワーカホリックだけど、ずっとあなたのことを気にかけているのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "はい……ですが{@nickname}先輩はずっとお忙しそうで。せ、先輩の邪魔をしてしまうのが怖いんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "大丈夫です。出発前に、準備すべき物はしっかり整えておきます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "それがいいわ。私も今日はしっかり寝てエネルギーを充電して、明日から仕事に着手するわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "時間が足りないんじゃなかったの？　それで間に合うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "十分な休息と適度な娯楽があってこそ、勤務中に100%の集中力を発揮することができるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "特にこういった研究業務では、本来なら三十分ほど集中すれば解決できる問題でも、心身が共に疲れ切った状態では何日徹夜したってまったく進まないものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "もちろん今回の仕事は残業が必要になるけど。残業代については――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "それなら大丈夫。さっきドクターが胸を叩きながら、「残業代は規定通り出す」って言ってたから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "それは良かったわ。とにかく、これ以上追加で仕事が来なければ、余裕で間に合うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "だったら平気かな。実は、僕も一つ報告書を頼みたいんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "なっ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "へへっ、お手数おかけします。どのみち残業代は出るんだからさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "はぁ……一体何の報告書？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "いつものだよ、いつもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "天災トランスポーターが仕事で参考にする地質分析報告書だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "サンプルは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "もう君のサンプル保存ボックスに入れといた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "それで、いつまでに必要なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "なる早で！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "簡単に言ってくれるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "あなたときたら、天災トランスポーターとしてあちこち飛び回っているから、ロドス本艦にいることはめったにないけど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "戻って来ると毎回、私にたっぷり仕事を押しつけるわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "私たちが同僚である前に、友人であることを忘れてないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "仕方ないよ。これが天災トランスポーターの仕事なんだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "今だって、ちょっとロドスに寄っただけだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "もう出発するの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "そうだよ。仕事がまだ終わってないからね。報告書を作ってもらうために戻って来たんだ。受け取ったらすぐに出発するよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "他に何か注文は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "なるべくこの報告書を見る人の頭が混乱して、読むのを諦めるようにしてほしいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "専門的な文章にするってことね。問題ないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "見る人が読むのを諦める……って、どういう報告書なんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "いわゆる天災トランスポーター専用の報告書だよ。でもほとんどの場合、天災トランスポーターに見せるわけじゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "大体は、雇用主か、現地の管理者に見せてるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "彼らは、天災トランスポーターが学者に分析してもらったデータに基づいて、天災をかわすために移転すべきかを自分で判断する……これもある種の仕事のやり方だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "こうすれば誤報の責任は、判断を下す彼らの方に移る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "その状況なら、もし天災が発生しなかったとしても、移転によって発生した経済的損失を、天災トランスポーターのせいにすることはできなくなるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "天災トランスポーターだって結局はただの人だからね。普通の人と同じ心を持ってるし、間違いも犯す。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "一度の誤報で自信を無くして自分が信じられなくなり、結局仕事を辞めてしまう天災トランスポーターだっているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "一定の確率で間違いが起こるのは仕方のないことよ。だけど天災トランスポーターの仕事は、一度の間違いに対して背負うリスクがあまりに重すぎるのよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "こういったリスク回避の方法も、天災トランスポーターを守るために生まれたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "でも、そうなると今度はデータ分析関連の仕事量が増えちゃって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "それにあちこち走り回って時間を取られるから、ロドスから比較的近いところにいる天災トランスポーターの手伝いしかできないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "いいじゃない。そのおかげで、君は長い時間ロドスに留まれるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "もし君が、昔みたいに天災トランスポーター兼地質学専門家としてあちこち走り回ってたら、僕たちはきっと年に数回も会えなくなるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "つまり、あなたが機会さえあれば駆け込んでくるのは、会う時間を増やすためなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "あちゃ〜バレたか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "何ヘラヘラしてるのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "でも、僕にこのやり方を勧めてきたのは君でしょ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "そうよ。私は誰にもバッハマン先生と同じ轍を踏ませたくないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "あ！　それってグルク私立学院のバッハマン教授のことですか？　リターニアの有名な地質学者であり音楽家の……アーススピリット先輩の先生だったんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "私の母が知り合いなんですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "幼い頃、私の誕生日に、ちょうど家にいらっしゃったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "もちろん、バッハマン教授は私の誕生日だとは知らなかったんですけど。仕事の関係で、私の母を訪ねてきたんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "ですがその日が私の誕生日だと知って、プレゼントとして一曲演奏してくれました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "とても美しい音を奏でてくれたことを覚えています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "ええ、彼女は私の最も尊敬する人よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "バッハマン教授に何があったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "ある地方貴族が、彼女を天災トランスポーターとして指名雇用したのよ。それで彼女は、専門的な分析を行ったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "バッハマン教授も天災トランスポーターだったんですか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "地質学者や音楽家としての肩書きほど有名ではないけれど、確かに彼女は天災トランスポーターでもあったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "貴族はバッハマン先生に、明確な答えを出すよう要求した。最終的に天災は起こるのかどうか――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "――結局、住民は移転すべきなのかどうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "彼女はリターニアの学者としてはとても純粋な人だった。年齢は重ねていたけど、警戒心が薄かったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "彼女の考え方は、最も保守的だったわ。だから、現地の地質環境を分析した後、すぐに移転した方がいいと住民たちに提言をしたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "だけど……結果、天災は起こらなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "そして、住民が元の場所に戻った時には、彼らの作物は枯れ果てていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "残ったわずかな食料も、貴族に上納しなければならない……彼らは歯を食いしばって飢えを凌がなくてはならなくなったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "食糧を徴収する際、すがりついて泣いて懇願する住民たちに対し、貴族の代弁者たちはこう言ったの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "「すべてあのバッハマンのせいだ。あいつが誤報さえしなければ、移転しなくて済んだのだ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "「あいつが、お前たちをこんな目に遭わせたんだ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "「全部あいつのせいだ。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "そして民衆の怒りに火が点いた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "彼らは深夜にバッハマン先生を襲撃し、石で殴って気絶させた後、縄で縛って……焼き殺そうと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "あのバッハマン教授が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "だから君は、他の誰にもそんな目に遭ってほしくないんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "それで武力じゃなく、学識でみんなを守ろうとしてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "先輩が地質学を好きなのは、知識で人を守るためだったんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "……いえ、違うわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "最初に地質学を学び始めた目的は単純だったわ。あなたと違って、私には十分なアーツの素質がなかったからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "鉱石病に感染した後、その影響で私のアーツは多少強くなったわ。でも、アーツの素質がないことには変わらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "アーツについては、私はからっきしなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "謙虚にも程があるよ。それでまったくダメっていうなら、僕なんて有り得ないレベルのバカだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "後半は間違ってないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "……まあとにかく、素質がないのにアーツにこだわってもしょうがないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "小さい頃、私は勉強ができたから、両親からは期待されていたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "たくさんの本を読んで、各種の基礎アーツとその理論やテクニックを先取りして把握していた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "周囲の人たちはみんな、私が将来必ず出世するって思っていたの。両親は私が一族の地位を変えて、街に引っ越せるようになることを期待していたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "でも成長するに従って、学ぶ内容はどんどん複雑になっていって、私はただ「賢い」だけじゃ意味がないって気づいたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "たとえ理論をきっちり理解していたとしても、素質がなければ意味がない。できないものはできないのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "でも地質学は違うわ。努力して勉強しさえすれば、知識はちゃんと身につく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "それで、両親に期待されていた自分の姿を、もう一度見つけ出せると思ったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "つまり、初めは仕方なく地質学を勉強してたの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "「仕方なく」なんかじゃない。バッハマン先生の地質学の授業は、私が一番絶望に打ちひしがれていた時期に、私を受け入れ、救ってくれたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "その時から私は地質学を勉強し始めて、コツコツと小さな達成感を積み重ねながら、段々と好きになっていったの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "地質学は私を包容してくれる場所……もう一つの我が家よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "でも地質学って、何だか味気ない感じがするんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "逆よ。たとえば、この大地の全ての本を積み上げたとしても、限りはあるでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "だけど地質学を学んでいると、まるで無限の本棚と向き合っているように感じられるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "フィールドワークをするたびに、調査結果の中からは異なる物語が見つかり、それぞれの土地の歴史の変遷を知ることができるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "まるで大地が私に囁きかけているみたいにね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "地質学はまさに、尽きることなき自然の図書館よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "そういう観点で見れば、つまらなくも寂しくもないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "ということは、ここでの仕事も楽しいってこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "違いますよ、プロヴァンスさん。ただ室内で検査と研究をするだけでは、地質学を追求しているとは言えません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "他の天災トランスポーターが持ってきた土や泥の成分を分析して、天災の可能性を導き出す作業も、地質学とは違います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "アーススピリット先輩が今持っている設備は、どれも携帯用のものです。簡潔な作りで、外出時にサンプリングをする時に使うもの……つまり、フィールドワークにこそ地質学の楽しみがあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "最近の私が、これらの設備と室内にずっとこもりっぱなしなのは、ロドスや天災トランスポーターたちが、私を必要としているから。ただそれだけよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "それにしたって最近は仕事が多すぎない？　どうしてよく知らない天災トランスポーターまでが、私の所へ来て報告書を欲しがるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "天災トランスポーターは、予測を外しちゃうとかなり辛い思いをするからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "君の報告書は、予測の精度を高めてくれるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "こういう報告書は、普通は学者に書いてもらうんだ。学者が書いたものは、専門性の高さもそうだけど、そもそも報告書の内容が仕事に必要なものじゃないことの方が多いんだけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "その点、君は優秀な地質学者というだけじゃなく、自身もとっても優秀な天災トランスポーターだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "だからたとえ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "たとえ雇用主に見せる必要はなくても、参考のために欲しいのね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "ふうん、道理で私の仕事量が増えたわけだわ。そんな理由があったなんて。まったく……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "へへっ！　そんなこと言わずに感謝してよ！　君のことは、天災トランスポーターの間ではもうかなりの噂になってるんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "「あのフラクトゥーアの大先生」……みんな君をそう呼んでるよ。とても鼻が高いでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "つまり、以前にあなたに数回やらされたあれも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "あの意味不明な残業も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "プロヴァンス",
      "text": "あっ……そうだ！　シャワーを浴びて来なくっちゃ。書類はここに置いておくね――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "待ちなさい！　うっ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "しまった、長く座りすぎて脚が――痺れて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "先輩、私が追いかけましょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "その必要はないわ。数歩歩いたら治るから！　あなたは休んでて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "脚が……ああ……ビリビリする……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーススピリット",
      "text": "プロヴァンス！　止まりなさーーい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
