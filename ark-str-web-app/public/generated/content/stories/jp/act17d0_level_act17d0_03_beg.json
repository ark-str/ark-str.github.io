{
  "server": "jp",
  "storyId": "act17d0_level_act17d0_03_beg",
  "groupId": "act17d0",
  "stageId": "act17d0_03",
  "title": "セーフハウス攻防戦",
  "storyCode": "OD-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act17d0/level_act17d0_03_beg.txt",
  "sourceHash": "749041c1c7566331567dde98fbc461d6f167fffa1ff64bc6b4c70b2ca2ab10cb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "銃？　傭兵？"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "何をバカなことを。"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "speakerId": null,
      "text": "ボス、全部本当です！　大型の銃器を持ってる奴が向こうに交じってて、ジャーマはそいつらにやられたんです！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "大型の銃を持った兵だと？　サンクタ人か？"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "つまりお前は、任務に失敗したのは、その四人のサンクタ人がいたせいだと言いたいわけだな？"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "speakerId": null,
      "text": "……えっと……"
    },
    {
      "type": "dialogue",
      "speakerName": "傭兵",
      "speakerId": null,
      "text": "奴らはサンクタ人ではありません……恐らくですが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "サンクタ人でもないのに大型の銃を持っている奴がいるだと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "嘘をつくなら、もっともらしくでっち上げろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "そいつが言っていることは本当だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "あ？　どういう意味だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "そいつが言ったことは本当だ。あの武装した奴らは確かにサンクタ人ではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "ジャーマンは脳天をぶち抜かれたが、弓やボウガンの矢の類は見えなかった。それにサルカズ人ならそこまで貧弱でもない。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "こいつらはあんたの計画にはなかった、不確定要素だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "契約には全身武装した銃器を扱う相手とやり合う条項など含まれていない。ボス、報酬の追加を頼む。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "そいつらは今どこにいる？"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "今、探させている。感染者地区にはもういないようだが、大きな動きもなかった。恐らく町からはそれほど離れてないだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "クソ親父の方はどうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "あんたの親父の手下はかなり手強い。特にあんたの姉が問題だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "何人かの衛兵は殺ったが、屋敷の防衛線は突破できていない。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "あの科学者が作ったモンスターはよくやってくれてるよ。だが、あんたが連れてきた術師たちがゴミだ。かなりのモンスターが無駄に傷ついた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "チッ、この辺で一番高い術師を雇ったんだぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "お前らのボスが術師を派遣してくれるなら話は別だが、そうでないなら俺に文句を言っても始まらん。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "なら科学者にモンスターをもっと作らせろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "或いは、戦術を変えろ。あんたの実家はまるで要塞だ、力押しじゃ全く歯が立たない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "クソ親父は相変わらず部屋に閉じこもってるのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "一度も姿を見ていない。これだけ派手な音を立てているのにな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "ハハハッ……だろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "あいつにも何かあったんだろうさ。何かまでは知らんがな！"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "引き続き屋敷を見張れ。状況が変わればすぐに知らせろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "「戦術を変えてくれ」というこっちの要望については、早急に対応を頼みたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ傭兵",
      "speakerId": null,
      "text": "これはサルカズ傭兵としての直感と経験からだが、先延ばしにするほど、ほころびも多くなる。今回は特にまずそうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "予備のプランは確かにある、だがそれにはもう少し時間が必要だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "私は自分の実験結果には非常に自信を持っているが、君の表情を見るに、君はそうは思ってないようだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "さぁ、言うがいい。今度は何があったんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "もっとペースを上げろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "無意味なスピードアップの要求以外に、もう少し建設的且つ具体的な意見は述べられないのかね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "差し出した死体はもう十分のはずだ。少なくともすぐに20体程度はモンスターが必要だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "ニュータント。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "あ？"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "「こういったモンスター」の名前だ。オリジニュータント、だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "ミュータントだろうと、ニュータントだろうと呼び方などどうでもいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "もっと多くのモンスターが必要だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "すでにそれなりの数を渡しているはずだと思うが、もう全部死なせてしまったわけか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "実に興味深いな……君の手下はどうやってニュータントを操っているんだね？　君たちのいう「アーツ」とやらに頼っているのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "「アーツ」とはなんだというんだ？　超能力か？　神秘学か？　魔法か？　原理は何だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "ほら、私の好奇心を刺激してくれ。君の手下の「術師」とやらとも是非とも話をしてみたいものだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "自分の仕事をやれ、科学者。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "今、お前が気にすべきことは「アーツ」を学ぶことではない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "事が終われば、やりたい研究をする時間は山ほどできるはずだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "（ロシア語）君の事業が成功するとは全く思えないがね。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "時間といえば、君に残された時間はそれほど多くない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "どういう意味だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "このオリジニュータントたちの寿命は長くて一週間ほどだ。何をするにしても、早めに行動した方がいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "どういうことだ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "これは代償だ、せっかちな君が払うべきね。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "君はニュータントたちを早く作れと言い、そのうえニュータントたちに強大な力を要求した。長寿命というさらなる美点までを望むというのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "こんな短期間でメリットばかりを求められても困る。君の望みを叶えるのには何らかのトレードオフが必要だったのだよ。世界のどこに、すべてがうまくいく都合良い話があると思っていたのかね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "俺に小細工はするなと言ったはずだ、科学者。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "私は忙しい。君と冗談を言い合っている時間はないのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "それほど不満なら、自分でやればいいだろう。君の聡明な頭を働かせて、私のような専門家が短時間で解決できなかった遺伝子工学の問題をそれこそ一瞬で解決すればいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "もちろん、私にもっと多くの材料と時間を与えてくれてもいい。そうすれば君が演出する、くだらない「ホームドラマ」に微力ながらもう少しだけ力を貸すことができるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "科学は公平だ。常に選択肢を与えてくれる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "俺に口先ばかりの御託を並べるな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "ごちゃごちゃ言わずに、言われた仕事をしろ！　次も失敗したら、もうそこまでだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ドラッジ",
      "speakerId": null,
      "text": "この手でむごたらしい死をくれてやる！"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "ハハハッ、そこまで言うのなら、もう私は何も言うまい。"
    },
    {
      "type": "dialogue",
      "speakerName": "レヴィ",
      "speakerId": null,
      "text": "君の幸運を祈ろう、友よ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "立ち昇る煙、ここからでも見える程の荒れよう。近付かなくてもおおよその状況は把握できます。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "まさかこれほどの規模だったなんてね……"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "不用意に介入すれば間違いなく厄介なことになります。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "……ただいま戻りました。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "おう、どんな状況じゃった？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "……ひどいの一言です。町の北側の屋敷付近では戦闘状態が続いていて、片方の勢力は傭兵のように見受けられました。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "他の場所の状況はそれ以上です。辺り一面が、半壊した建物の瓦礫だらけになっていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "……さらには感染したサンドビーストが、町中に溢れていました。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "こんな状況だというのに、サルゴンの政府の武力組織は何をしているのでしょう？　首長の軍隊が現れてもおかしくない状況なのに……"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "北側の屋敷内には制式装備の衛兵たちがいましたが、サルゴンの兵士は見当たりませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "もしこの規模の騒ぎが二日も続いているとなると、セーフハウスのオペレーターは……"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "絶望的かもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "そう結論を急ぐでない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "……もう一つ報告があります。セーフハウスを見つけました。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "そして、何者かがセーフハウスを守っていました。見たところロドスの人員には見えませんでしたが。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "傭兵たちに占領されてしまったのかのう？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "いえ……恐らくは違うと思います。武力を有しているのは明らかでしたが、普通の傭兵には見えませんでした。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "彼らの布陣は明らかに手慣れた防衛態勢で、待ち伏せのポイント、トラップ、おびき出すための餌、全てが周到でした。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "そして何よりも、セーフハウス内には非武装の町民たちが多数いました。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "町民ですか？　セーフハウスに陣を構えていたのは、どんな人たちでしたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "見た目からは、あなたたちの同業者かと……銃器を持っていましたので。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "銃器？　BSWの傭兵でしょうか……"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "いえ、識別可能な所属マークは見当たりませんでしたので、BSWと限定することはできないかと。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "所属を隠したプロの武装戦闘員……しかも銃まで持ってる。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "うーん……判断に困るわね。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "町には様々な勢力がおるからのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "ひとまず、盗賊の類いである可能性は排除していいじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "そして首長の軍隊が見受けられぬうえ、戦争にも見えない。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "状況は儂が想像していたよりも、随分と複雑そうじゃのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "少なくとも、混乱の中町民を保護する人たちですし、残虐な暴徒の類ではないと思いますが。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "交渉してみる？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "慎重にならねばのう。町民を保護していると言うても、理由は色々と考えられるからのう。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "相手が話の通じる相手ならいいんじゃがの。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "どう？"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "ダメだ……全くわからない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "電子回路のように見えるが、俺が知っている回路とは違い過ぎる。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "一ヶ月の時間をくれて、さらにマニュアルもあるなら、理解できるかもしれないが……"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "やめだ……上で見張りをしてくる。しゃがみ続けで腰が痛い。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "LORD、おつかれ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "失敗か？"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "私たちの使っている通信機と構造以前に、概念レベルから異なる技術なの。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "修理は諦めた方がいいと思う。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "外見からは普通の通信機にしか見えないのに……"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "前の車と同様、この世界のエネルギー源はとても特殊なのよ。すべての技術の根底に源石と呼ばれるものがある。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "まだその通信機をいじってたんですか。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "源石通信装置は複雑な技術の集合体ですからね。これまでもずっとロドスから派遣された専門術師によってメンテナンスされてきたものですし、直せなくて当然です。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "前にこの機械で救援メッセージを送ったって言ってなかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "ええ、ですが……本当に届いたかはわからないんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "暴徒たちにここが襲われた時、大慌てで通信機を起動したんです。何か言おうとした矢先、暴徒がこの部屋まで入り込んでしまって……"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "かなりせっぱ詰まっていたのでちゃんと伝えられなくて……ロドスのオペレーターが救援信号を受け取っていたとしても、何が起こっていたのか、わからないと思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "つまり、援軍はなしと考えておいた方がよさそうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "はなから期待してないけどな。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "皆さんはずいぶん余裕があるんですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "というより、支援のない作戦に慣れてしまったと言った方がいいかもしれないわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "あの時、皆さんが来てくれるのがほんの少しでも遅ければ、私は今頃まともに話すことすらできなくなっていたでしょうね。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "いや、そのまま棺桶に直行していたか……"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "遅くなりましたが、その節は本当にありがとうございました。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "気にしなくていい、あんたも町民たちを助けてくれたから。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "まあ、感染者を治療して救うのもロドスの本業ですからね。中に入れたこと、許してくれないかなあ……"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "……私は見張り役の後方勤務の予備オペレーターにすぎないので、権限なんて無いに等しいんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "治療して救う……そのためだから、ここには医療物資が準備されているのね？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "でも、武器は何に使うの？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "えっと、それは……"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "ロドスの本業は薬の製造ですが、セーフハウスを所有するのは、実は医療による救助が主目的ではないんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "セーフハウスの主な役割は、外勤オペレーターに物資の補給や予備の武器などを提供することなんです。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "うん……？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "ちょっと待って？　これは何？"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "グレネードランチャーか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "グレネード？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "見せて。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "おいおい、こいつは……地雷か？"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "しかも、結構な種類があるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "……この世界の人は火器を使わないと思っていたけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "たしかに、このグレネードランチャーの構造は少しおかしい。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "発射薬のないグレネードなんて……まさか圧縮ガスで撃ち出すってのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "これを見て？　油圧スプリングを使うタイプもある。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "気を付けてください！　その箱の中は源石爆発物なんです！　とても危険ですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "オクフェンさん、ここに火器と弾薬はないのかしら？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "火器……銃器のことですよね？　エッチング弾薬のことですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "そんな高価なものは普通はセーフハウスに置けませんよ。ロドスのオペレーターでもやはり銃を使う人は少ないですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "これらの爆発物は、あたしたちでも使える？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "はぁ……多分ですが。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "気を付けてください。源石爆発物はどれもとても危険ですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "普段でしたら、これらは戦闘専門のオペレーターにしか提供しないものですが――"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "皆さんはその道に精通してそうですし、状況が状況ですから使ってください。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "感謝する。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "こいつらは？　この得体の知れない部品たちは何だ？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "それらはアーツユニットに使われる、スペアの部品です。大事な物なので壊さないでくださいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "アーツユニット……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "あの「アーツ」とかいうやつか。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "アーツって、あの火の玉を飛ばす技とかの？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "アーツを説明しようとするととんでもなく複雑なんです。私も術師ではありませんし。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "ただ簡単に言えば、アーツの種類は多種多様で、術師たちの得意とする分野もみな異なります。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "さっき言っていた専門術師もその中の一つってことね？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "ん？　皆さんはこれまでにアーツに触れたことがないんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "それが……あまりよくわかってないの。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "そんなことありえますか？　銃を持っているのに、術師じゃないなんて。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "アーツを使えない銃の使用者ってことですか？　これは珍しい。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "あっ、オクフェンさん。まだ足が治ってないんですから、歩かない方がいいですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "大丈夫です。杖がありますし、私も少しくらい、なんとか貢献しないと……必要なら歩きます。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "先生、下の病人たちの様子はどう？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "ケガの具合は皆さん、落ち着いてきていますね。ここの医療設備のおかげです。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "顔色が悪いんだけど、大丈夫？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "一晩寝てないだけですので、大丈夫です。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "先生もゆっくり休んでちょうだい。もし唯一のお医者さんが倒れでもしたら、元も子もないでしょ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "お気遣いありがとうございます。気を付けますので。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "ところで、アーツの話だが。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "なんて言うかな……こう呪文を唱えると、ピカーって光って、病気が治るやつとかはないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "プッ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "何言ってるんですか、ハハハッ……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "ないのか？　なら飲んだら傷口が塞がるポーションは？　そういうのもないのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "そんなのはSF小説でしかありませんよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "ケガを治療するアーツは確かに存在しますが、そうしたアーツは習得できる人も限られるし、習得するのに時間もかかるので、実際に使える人は非常に珍しいんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "そういったアーツをマスターするために、術者はまず全体的な医学知識を身につけ、様々な種族の身体構造を理解することなどが必要ですからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "医療アーツ使用者の大半は、止血や傷の回復を早める程度しかできません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "確かに手術台の上では非常に重要ですが、僕の経験上、本当の治療に取って代わることはできません。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "先生はアーツを使えるんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "少しだけ……ですが、役に立たないアーツです。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "現実的すぎるだろうがよ……はぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "魔法のある世界でもこんなに不便なんだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "……ん？　待て、さっきSF小説って言ったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "この世界のSF小説ってどんな内容なんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "もっと大きい街へ行けば、本屋があるってことなのか？　歴史に関する書籍は？　高いか？"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "なんか、だんだん興味が湧いてきたぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "皆さんは本当に変わってますね。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "一体どこから来たんです？　クルビアですか？　それともヴィクトリア？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "皆さんの言葉は何十年も前のヴィクトリア人のようですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "それは……なんて答えればいいか、本当によくわかってないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ミアロ",
      "speakerId": null,
      "text": "コーエンさんたちはとても遠くからやってきたそうなんです。なんでも、鉱石病の患者すらいないらしいんですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "えっ？？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "……そういうこと。"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "鉱石病のない国？　本当ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "鉱石病がない…つまり感染者がいない。それって感染者に対する差別もないってことですよね？　大地に住むあらゆる人が皆平等で、憎しみなんて最初から存在していない？"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "なんてことだ！　そんな素晴らしい場所があるなんて！"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "素晴らしい、ねぇ……"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "はぁ……"
    },
    {
      "type": "dialogue",
      "speakerName": "オクフェン",
      "speakerId": null,
      "text": "……皆さんの表情を見て理解しました。聞かなかったことにしてください……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "！"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "敵襲！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "情況報告を！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "囲まれてるぞ。今のは第一波にすぎない。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "その前のはただの探りだったってわけだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "さらに大勢が近付いて来てる！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "罠は？"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "問題ない！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "爆発物の補給を気にしておいて。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "Blitz、左翼に注意を！　相手が直進するように誘導して！"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerId": "char_457_blitz",
      "text": "了解。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "Tachanka！　弾薬は節約して！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "ああ、わかってる。"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "視野を広げて、奇襲に警戒！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "相手がどれほどの実力か見てあげましょう。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "来るぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "まだよ……もう少し引き付けて。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "9時！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "Tachanka！　正面、敵がまた立ち上がった！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "敵！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "角の生えたデカい奴は手強い！　頭を狙え！"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerId": "char_458_rfrost",
      "text": "Ash！　あれ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "！？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "あれは……何だ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "Tachanka！　危ない！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "*ロシア語スラング*！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "アレクサンドル！！"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "心配するな。"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerId": "char_459_tachak",
      "text": "俺に構うな！　防衛線を守れ！"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "これは一体……何なの？"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerId": "char_456_ash",
      "text": "人型の生物に注意して！　脆い遮蔽物に隠れてはダメ！！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "専門的且つ適切な布陣じゃな。あの四人、ずいぶん手慣れておる。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "銃声……これほど強烈な爆音となれば、速射型の大型銃器じゃな。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "……囲まれていますね。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "屋敷を襲撃した傭兵と同じ者たちです。間違いありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerId": null,
      "text": "……あのモンスターたち、龍門のことを思い出す。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "「寄生」と「家畜」ね。"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerId": null,
      "text": "でもちょっと違うみたい。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "大型銃器を持つ傭兵と、正体不明のモンスターを駆使する傭兵たち……"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "戦況は刻々と変化している、すぐにでも均衡は崩れるじゃろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "……どうしますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "悩むまでもなかろう……戦闘準備じゃ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レンジャー",
      "speakerId": "char_503_rang",
      "text": "モンスターを操って戦う連中に、まっとうなやからはおらぬ。容赦はいらぬ。"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "speakerId": null,
      "text": "……わかりました。"
    },
    {
      "type": "sceneBreak"
    }
  ],
