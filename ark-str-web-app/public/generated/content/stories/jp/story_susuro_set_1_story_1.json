{
  "server": "jp",
  "storyId": "story_susuro_set_1_story_1",
  "groupId": "story_susuro_set_1",
  "stageId": null,
  "title": "精鋭医師",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_susuro_1_1.txt",
  "sourceHash": "19c9d00fa42f0ee5753b835d983291f3ffcc61c8b160ae91e54003473ff0df3f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "何時っすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "四時だ、何回訊くんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "俺は焦ってるんすよ！　焦らない方がどうかしてますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "焦っても意味ないだろ？　落ち着けよ。ロドス本艦から急行してくれてるんだし、無事に到着してくれるだけでありがたいことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "本艦からここまでの距離を、たった三日で駆けつけるチームを派遣するなんてスゴいっすね、本艦てのは。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "本艦に行ったことはないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "ないっすね。交通費は高く付きますし、ここでやらなきゃいけないこともたくさんありますんで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "本艦は大型の浮揚移動装置を積んでる。見たことないだろ？　あれはかなりの速度が出るからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "浮揚？　空飛ぶ車ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "あれは車じゃないぞ……俺も何と呼べばいいかわからないが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "あー、塔の術師のお偉方が使ってるあのハイテクっすか？　空を漂うあの──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "いやいやそれとも違う！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "ううむ、今この話はやめよう。俺だってそんなに何度も見た訳じゃないから、うまく説明できない。到着した時に見れば分かるさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "そんなに手持ち無沙汰なら、もう一度車両の点検でもしてろ。急いで帰らなきゃならないんだ、万が一にもトラブルが起きちゃ困る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "はいはい、わかったっすよ……ボスはあなたっす、仰せのままに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "そういえば、今回本艦から来るのはどんな人なんすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "本艦に行ったことすらないのに、名前を言ったところでわからないだろうが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "俺たちが送ったのは緊急救護要請だ。誰が来ようと、間違いなく医療部の精鋭だろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "だけど、今回はかなりの大仕事になります。相当な精鋭じゃないと無理っすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "お前が心配することじゃない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "おっ、来たぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "あの乗り物……スゴいっすね。本艦にはあんなものまであんのか。勉強になったっす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "ほら、迎えに行くぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "リターニアへようこそ。ここの事務所責任者フィレガスだ。フィレと呼んでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "初めまして、私は本艦所属の医療オペレーター、ススーロ。彼女たちは私のアシスタントだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "よろしくお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターB",
      "text": "何ぼうっとしてる、挨拶しろよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "あっ！　おっと、そうでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "事務所オペレーターA",
      "text": "俺は運転手……いや、俺はここの事務所駐在のオペレーターっす。そんで、コードネームはピストンっす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "状況は非常に複雑だ。時間がない、先に車に乗ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "今回の事件に関する詳細は、資料をプリントしてある。まずは車内で目を通してくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "わかった、ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "機材を持ってきてるから、車に積むのを手伝ってくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "わ……わかったっす。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二時間後"
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "二つ目の資料を見せて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "どうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "このレポートをチェックして、ほかに準備が必要な機材がないか確認してくれる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "（ちょっと！）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "どうした、何をコソコソと──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "（声が大きいっす！　もうちょっとこっちへ寄って……）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "派遣されてくるのは精鋭だって言ったじゃないすか、どうしてあんなお嬢ちゃんがチームリーダーなんすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "言葉には気を付けろ。ボーナス減らすぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "いつから人を見かけで判断するようになったんだ？　オペレーターマニュアルは読んでないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "わからないなら黙っとけ、あの人は本艦医療部の本物の精鋭だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "はいはい、わかったっす……俺が悪かったっすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "フィレさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "資料は見終わったんだけど、いくつか質問があるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "今回医療援助が必要なほど危険な状態にある人は、そのほとんどが鉱石病感染者ではないみたいだけど、いったい何があったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "ああ。つまりこういうことだ。リターニアの公式の発表では天災が都市の破壊や死傷者をもたらしたとされているが、実際の状況はそれよりも複雑なんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "天災トランスポーターの仕事にミスがあったとか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "今のところは……そうじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "今回、天災からの退避行動自体には何の問題もなかった。少なくともプロセスに手違いはなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "ただ唯一の誤算は……誰も予想していなかったことだが、天災のハリケーンの進路に、大きなハリノミの巣が最低でも十個はあったってことだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "その村は事前に移動を開始していたんだが、天災から逃げた数百匹のハリノミが移動中の隊列に突っ込んでいったんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ハリノミ？　あの一メートル以上はある肉食の虫ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "それが数百匹！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "……なるほど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "死傷者数はわかってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "リターニア当局はまだ正確な数字を出してないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "もう二日経ってるが、まだ結論は出ていない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "つまり現時点では、死傷者数は集計できないってことだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "そうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "領地の衛兵が多くのケガ人を付近の街に移動させたが、俺たちじゃ全部の街の状況を調べる余裕はなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "事務所に配備されてる医療物資はまだ足りてる？　ハリノミの毒素を処理するための解毒剤の在庫は？　手術器具のメンテナンス状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "地元の医療救急隊の動員状況は？　この資料に書かれていない情報も一通り知りたいんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "医療物資に関しては、ひとまず問題ないと言える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "地元の権力者が真っ先に救助活動を開始し、ロドスの事務所も依頼を受けた後に充分な応急救助物資を得られた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "医療設備の状態も問題ないが、自動で動いてくれるわけじゃないんでな。俺たちの人手不足の方は深刻だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "事務所が置かれている街の医者はよく訓練されていると言えるが、緊急事態対応の経験に乏しい。これほどの大災害は多くの者が初めての様子だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "街の人口は元よりそれほど多くないから、診療所は街全体でたったの三箇所、手術のできる医者となるともっと少ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "多くの負傷者が、手術台にたどり着くまで持たない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "今、事務所で多数の難民を受け入れていることもあり、状況は予断を許さない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "それに、この混乱した状況では、感染の有無をすぐさま判別することができない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "搬送される患者の中には当然感染者もいる……感染者が亡くなった後の状況がどうなるか……俺の言いたいことはわかるだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "まだ少し距離がある、皆休めるときに休んでてくれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "着いたっす。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "すでにたくさんの人がいますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "負傷者は事務所の近くに移され、ほかのスタッフたちが対応しているはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "ピストン、お前はここにいろ。後で補給車が来るから、お前はここでそれに対応するんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "ここでただ待ってろって言うんすか？　そんな──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "この手の任務は初めてだろ？　現場はお前が想像するよりずっと過酷だ……いいからここで医療物資の受け取りと分配をしておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "冗談っしょ。お嬢ちゃんたちですら行くってのに、俺みたいな大の男が何をビビるっていうんすか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "……青二才のくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "いいだろう、後悔するなよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "大怪我を負った患者",
      "text": "水……水をくれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "子供",
      "text": "パパ！　パパ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "血まみれの患者",
      "text": "ゴホッ……ゴホッ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "誰か来てください！　この感染者はもう持ちません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "一般患者",
      "text": "感染者？　よ、寄るな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "あなたはなぜここにいるのですか？　早く治療エリアに戻ってください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "衛兵！　衛兵！　どこですか！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……なんてこった……これは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "想像以上だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "一昨日来た時、あの敷地はまだ地元商会の貨物ターミナルだった。今は一般患者の治療エリアに転用されたみたいだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "医者の人数は限られている。医療室で優先的に緊急措置を受けられるのは相当な重傷者だけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "この地面に横たわっている人たちは……どういう状況なの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "恐らく全員感染者だろう。小さい街だ、感染者収容エリアはない。感染者と一般人を、同じ所に置いておくわけにはいかないということだろうな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "だからといって彼らをこんなふうに広場に放っておくの？　フィレさん、事務所の倉庫にスペースを作れる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "問題ない、すぐに中の物を運び出すよう手配する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "それと重傷の感染者を収容する独立したスペースが必要だよ。隔離されている場所が望ましいんだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "それなら宿舎を空けるしかないな、少し時間をくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "わかった、よろしくお願い。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "一班は倉庫へ、感染者の状況を確認。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "二班、三班は私と一緒に、機材を手術室へ運んで！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "患者の分類とそれに応じた場所割りはあなたに任せるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "は、はい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "お、俺も手伝うっす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "はい、お願いします。この人たちを中へと運びます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "アーツを使って傷口の癒合を速める前に、必ず毒素をきれいに抜くこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "もし傷口がそこまでひどくない場合は、できるだけアーツの使用は控えて。ここじゃ医者の体力が一番貴重な資源だし、効率的に配分することでより多くの命を救えるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "まずはこっちをお願いします！　重篤患者がいます！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "状況は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "家族を守ろうとしてハリノミに腕を噛みちぎられたようです。搬送時にはすでに意識を失っていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "感染者です。ですが病状はまだ安定しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "……彼の腕は？　回収できてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "（首を横に振る）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "切断面はすでに細菌に感染してる。左腕にも広範囲にわたって肉眼で確認できるただれがあるから、一部切断の必要があるかもしれない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "……それってつまり両腕とも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "ここは私に任せて、あなたは二班を手伝いに行って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "お願いします！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "ぼうっとしてないで、感染者の応急処置の準備を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "患者の体表結晶は咽喉部、血液検査をして。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "腕の鱗に注意、サヴラ専用のメスを準備。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "部屋の明かりが暗すぎる。ピストンさん、発電機の状況確認をお願いできる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "はい、了解っす！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "三時間後\n事務所の医療室内、重傷患者の手術はいまだ終わらない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "負傷者",
      "text": "先生……私は助からないのでしょうか？　教えてください先生……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "腔内の出血が多い、吸引器の瓶を交換して。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷者",
      "text": "お願いします……先生、この指輪を私の妻に……お願いします……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "あなたは生き延びるよ、だから頑張って。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "ガーゼがなくなった、持ってきて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "負傷者",
      "text": "う……嘘はやめてください、わかってますから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "喋らないで！　あなたは生き延びられる、私が保証するよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "ここを押さえて、縫合する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "オキシドールがなくなりました、誰か倉庫へ行って取ってきてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "ピストンさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "は、はい！　す、すぐに行くっす。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "出血は止まった、あとは任せるよ。私はほかの人を見てくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "こちらにお願いします隊長！　今搬送された患者が危険です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "今行く。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "瀕死の患者",
      "text": "ゴフッ……グブゥ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "胸腹部損傷、腹部開放性外傷。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "中に入れて、優先対応。まずは彼の食道と気管を切開するよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……なんだこれは……なんなんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……こんなの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "立ち止まらないで！　ほかにも病人はいるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "臓器破損、後腹膜出血の有無を確認して！　早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……お……俺は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "すみません……お……俺は。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "大丈夫、お疲れ様。あなたは外で休んでて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "ありがとう……ございます……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……ヤバすぎんだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "オエッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……本艦の人は、普段からこんなことに立ち向かってるのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……うっ……まただ……オエェッ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "大丈夫か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……だ、大丈夫っす。まだあんまり慣れてないもんで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "ほら、タオルだ。顔を拭け。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "ふぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……ウグッ……恥ずかしいっすよ。現場でまっ先にダメになるのがまさか俺だなんて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "気にするな、お前はよくやった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "これでよくやったなんて言えるんすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "お前は自ら困難な任務を買って出て半日も耐えたんだ。お前は専門の医療オペレーターじゃないし、俺は三十分で参っちまうと予想してたんだがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "あのお嬢ちゃん……いや、あの人は、ほんとにスゴいっすね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "はぁ、言ったろ。彼女たちは本艦の精鋭だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "あのススーロという医療オペレーターは、数年前のパレルモ事件の経験者だ。甘く見るな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "パレルモ事件？　あっ……当時シラクーザを震撼させたあの事件っすか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "源石工場が爆発したあの？　確か多くの一般人が急性感染し、医療体制が整ってなかったせいで急性感染者が大量に死亡して……街の大半が崩壊寸前だったとか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "あれこそまさにこの世の地獄だよ。想像してみろ、大量の感染者が急性発作を起こし、至る所崩れ始めた感染者の遺体だらけ、そして空一面に活性粉塵が舞う恐ろしい光景を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "パレルモ事件の経験者の多くは、深刻なトラウマを抱えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "あの人にとっちゃ、今日の光景なんて可愛いもんだろうな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "ダメだ、やっぱり手伝いに行くっす。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "いいから休んどけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "中で吐かれたりしたら、彼女たちの邪魔になる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……それはそうっすけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "そんなに手伝いたいなら、収容エリアへ行って連絡事項がないか聞いてきてくれ。ついでに他の事務所の補給車が来ていないかもな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……はい、すぐに行くっす！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "……ハッ、青二才が。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "ふぅ……大変だった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "あっ、先生、どうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "あなたたちのおかげで、今はもうほとんどの患者さんが安定しています。あとは領主の今後の指針次第かと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "これまではあなた方のことを、医療会社などではないと思っていました。本当に……本当に……大変失礼しました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "改めて、心から感謝します。今は……それ以外の言葉が見つかりません。もしあなた方の支援がなければ、どれだけの死傷者数とそれに伴う二次災害が起こったか、想像すらできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "いや……俺はただの雑用で……えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "医療オペレーターは？　彼女たちは休んでますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "地元の医者",
      "text": "私もどこへ行ったかわからないんです。あなた方の宿舎まで患者用に割り当てたと聞いていますから、ロドスで別に休憩所を用意しているものだと思っていましたが、あなたも知らないとなれば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "そうっすか……あなたも早く休んでください。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "ボス、本部の医療オペレ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "シーッ、静かに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "何か用なら、外で話すぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "彼女たちは……いや、休ませてあげましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "収容エリアはどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "問題ないっす。領主の使いたちが来て、すでに一組目の軽症患者たちの移動を始めてます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "ならいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……えっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "言いたいことがあるならはっきり言え、なにを口ごもってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "いや……ただ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "辞めたくなったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "違うっす。ただロドスの仕事について少し理解が深まったっす……多分、少しだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "ハハハ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "仕事熱心なのはいいことだ。熱心ついでに、医療物資の消耗状況を確認してきてくれないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "記録は二部用意しておいてくれ。一つは事務所の保存用、もう一つは明日の朝、地元政府に提出するためのものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……了解っす。すぐに行くっす。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "四日後"
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "荷物はまとまったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "うん、大丈夫。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "待って待って待って！　ふぅ、間に合った！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "お前何してたんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "ススーロさんに買い物を頼まれてたんす。ほら買ってきたっすよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "こんなに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "コホンッ……こっちはケルシー先生に渡す本で、こっちはガヴィルさんに渡す工芸品だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "これは何ですか、お菓子？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "それはドクターに渡す……プレゼント。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "ドクター？　それって……あのドクターっすか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "とにかく、ケルシー先生とドクターによろしく伝えといてくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "うん、わかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "じゃあ気を付けて帰ってくれよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ススーロ",
      "text": "ありがとう。またね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "行っちゃったっすね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "ほら、戻って仕事だ。報告書が山ほど残っているぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "……うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "どうした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ピストン",
      "text": "俺も機会を作ってロドス本艦へ行ってみるべきかなって……スゴい人たちに会えそうっすから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フィレガス",
      "text": "それもいいだろう。だがそんなことを考える前に、まずは今抱えてる仕事を終わらせろよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
