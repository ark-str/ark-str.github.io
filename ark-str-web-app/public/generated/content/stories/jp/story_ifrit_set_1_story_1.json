{
  "server": "jp",
  "storyId": "story_ifrit_set_1_story_1",
  "groupId": "story_ifrit_set_1",
  "stageId": null,
  "title": "小隊長",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_ifrit_1_1.txt",
  "sourceHash": "7f197b50fb10cb429c2923784f9354d3f3ff0d0456662f45a760b59222b45c1b",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "サイレンス！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "イフリータ、おかえり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今日はやけに早かったね。ドクターから新しい任務を頼まれたりしなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "医療部のヤツらが、数日のうちに再検査をする～とか言って外に出してくれねーんだよ。ドクターにもしばらく休めって言われてさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ところでサイレンス、なんで荷物なんかまとめてんだ？　……どっか出かけんのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……うん。用事があってね。しばらくの間帰ってこられないかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "用事って、どこ行くんだ？　一人で行くのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オレサマも連れてってくれよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "一人だけど、大丈夫。助けてくれる人がいるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "今回は留守番してて、イフリータ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "え～っ、なんでだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "もしかして……あそこに戻るのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "サリアもサイレンスも、ずっとあの白衣のヤツらのこと調べてるんだろ！　それに、ミューがサリアを探しにきたのだって、あのヤな連中のことに絶対関係してるし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "みんな何も言ってくれねーけど、そのくらいお見通しだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "いいだろ、教えてくれよ！　オレサマはもう子供じゃねーんだぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "イフリータ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "そうだね……あなたはもう、子供なんかじゃない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "イフリータ、おいで。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……なんかちっちゃくなったな、サイレンス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "……あなたが大きくなったんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼女は指を伸ばすとイフリータのきめ細やかな髪を撫で、以前より角ばってきたあごに触れた。ずっと実験用具を扱い続けてきたリーベリの指は、柔らかくしなやかながらもタコができている。\nイフリータの覚えている限り、サイレンスがこんなふうに親密なスキンシップを取ってくることは滅多になかった。\n大抵の場合は、壊れ物でも扱うように、ひんやりとした指先で軽く触れてくる程度だ。\nしかし、以前に一度か二度、体調を崩して寝込んでいた時、もうろうとした意識の中で、今と似たような手が触れてくるのを感じたことがある。\nその手は少し震えていたが、イフリータにとっては心細さを一瞬で吹き飛ばしてくれるようなものだった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そして今、またあの手指が彼女の顔に触れ、優しく肩を撫でてくれている。イフリータは少しでも頼もしく大人びて見えるようにと懸命に背筋を伸ばしていた。\nサイレンスは大きくため息をつくと、こう言った。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……リータ……イフリータ……？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "寝ちゃってたの？　検査は終わったから、もう起き上がっても大丈夫よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "どうしたの？　大丈夫……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "今はサイレンス先生がいないから、基本的な検査しかできなかったけど……今のところ、大きな問題はなさそうだったのよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "でも、具合が悪くなったらすぐに言ってちょうだい！",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "イフリータには、手術台に寝かされたあの日から四肢を蝕む痛みが影のように付きまとい、一日として消えたことはない――などということを、目の前の彼女に話すつもりはなかった。\n以前は痛みを感じるたびに泣いて暴れて、夜も眠れずにいたものだが……\n今となっては、消えない痛みには慣れきってしまっていたのだ。\nこんなのは大したことじゃない。少し我慢すればいいことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "心配すんなって！　急に起き上がったからくらっとしただけで、なんともねーよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "検査終わったし、もう行ってもいいだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "あっ、ちょっと待って。検査結果を渡しておきたいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ん？　どうかしたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "うわっ、ちょっ、なんて顔してんだよ！　な、泣くなって……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "な、泣いてなんかないわよ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ははっ、泣き虫がよく言うぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "イフリータ……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "確かに、詳しい資料はサイレンス先生しか見られないし、私はずっと助手をしてただけだけど……それでも、わかってるのよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "この数年、目に見える範囲だけでも源石結晶が増えてきてるもの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "このままだと、病状の悪化が早まる一方よ！　あなたはいつも何ともないって言うけど……そんなわけないじゃない！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "お願いだから、安静にして――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "もういい、やめてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "それ以上言うな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "一日中部屋でじっとしてるのなんて嫌なんだ。採血したり薬飲んだりでほかに何にもできないとか、ありえねーだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "でも！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "でもじゃねえ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……確かにサイレンスはほとんど何も教えてくれねーけど、オレサマだってバカじゃねーんだ。自分の身体のことなんか、自分が一番よくわかってるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "イフリータ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "嫌になるくらいわかってるからこそ……何にもしないでじっとしてるわけにいかねーだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オレサマはサリアより強くならないといけねーんだ！　だって、そうなれば何があっても助けてやれるだろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "そのためにも、無駄にできる時間なんかねーんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "……はあ……わかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "もうこんなこと言わない。あなたの決めたことだものね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "――ただし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "うおっ！？　まだなんかあんのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "もちろん！　危ないと思ったら遠慮なく注意するわよ！　一人でバウンティハンターの野営地を焼き払うとか、あんな無茶はしちゃダメだからね。ひどい怪我なのに任務を優先しようとしたりして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "今度血まみれで担ぎ込まれてきたら……病棟から出してあげないんだから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "あ、あれは仕方なかったんだって……！　オレサマだって無茶したくてしたわけじゃねーし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "それに、今回はオレサマが隊長なんだぜ！　任せてもらうのは初めてだけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "だったら、なおさら自分の身体には気をつけないと！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "はいこれ、痛み止めよ。外勤に行くなら多めに持っていきなさい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "それと、戻ってきたらすぐに検査を受けにくるように！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ちぇっ、わかったよ。ほんと口うるせーなあ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……まあ……なんだ、その。ありがとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "あんま心配すんなよ、大丈夫だからさ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サイレンスは結局、そのあとに言葉を続けることなくロドスを出立した。\n一体何が言いたかったのか、「お願い」というのは何なのか……イフリータには推測することしかできない。\n何か手伝ってほしかったとか？　任せたい任務でもあったとか？　あるいは、離れていても心配がいらないくらい良い子でいてねと伝えたかったのだろうか？\n何度も何度も考えるうちに、イフリータはふと思い至った。もしかすると、サイレンスが伝えたかったのは、「無事でいて」というただそれだけのことだったのではないか、と。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "サイレンスとサリアは、それぞれ違う姿勢でイフリータと向き合っている。\nサリアはイフリータに成長と自立を望んでいるようだが、サイレンスは彼女に平穏な暮らしをさせてやりたいと願っているのだ。\n「あなたは本当に大きくなった」と、サイレンスは言ってくれた。\nけれど、イフリータにはもうわかっていた。彼女は初めこそ、溢れる力を持つ自分を無敵だと思い込んでいたが、実際のところ、サイレンスに頼もしく思ってもらえるほど成長してはいなかったのだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "まだ足りない。\n目標は遠く彼方にある。\nイフリータが行こうとする道のりはまだ長かったが、残された時間は多くなかった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "わあ～……ここにこんな大きい洞窟があったなんて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "エイヤフィヤトラさん、すごい！　ほぼ予測通りの位置ですよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あっ、向こうにきれいな石が！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "ここ、とっても涼しいね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "お昼寝にぴったりだ。この辺とか、ひんやりしてて良い感じ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "……すぅ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "うーん……変ですね……洞窟の位置も大きさも、計算とは少しずれているような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "誤差の範囲ではありますが、ちょっと気になります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "湿度も少し高いですし、足元の泥も……なんだかぬかるんでいますし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "土壌も調べたほうがいいのかも……きゃっ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "っと、あぶね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "あ、ありがとうございます、イフリータさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "礼よりもまずはしっかり立てよな。……今、手ぇ切らなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "大丈夫ですから、お気になさらず。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "大丈夫かどうかはオレサマが判断してやる！　なんたって隊長だからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ほら、いいから見せろって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "本当に大丈夫なので……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "んー……なんともなさそうではあるな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おい、そこのお砂場術師！　お前も護衛なんだからサボんな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "ん？　ああ、大丈夫だよ、ちゃんと見てるから。誰かが転んじゃった時は……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "こうやって砂で受け止めてあげる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "ところで、イフリータもこっちに来ない？　この辺、涼しくて気持ちいいよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……もういい。好きにしろ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "今回の任務は、この洞窟と近くの地質調査だろ？　なら急いで――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "わあっ！　みなさん、来てください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "なんだ、どうした！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "きれいな石がたっくさんあるんです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ほら、これなんてイフリータさんにぴったりですよ！　早く早く！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オマエも遊んでねーで仕事しろーっ！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "確かに地質のことなんかサッパリだけど、隊長はオレサマなんだからちゃんと指示に従ってくれよ！　オマエらの安全だって預かってんだしさ……頼むからさっさと任務を終わらせようぜ、な？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "特にそこの耳が黒いやつ！　隊長の許可なくウロチョロするのは禁止だからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "わかりました！　隊長のご命令には従いまーす！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ところでイフリータさん、これどうぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "？　なんだこれ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "そこで拾った鉱石なんですけど……見てください、この赤！　あなたにぴったりじゃないですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "だから、プレゼントです！　えへへ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ふ……ふん！　た、ただの石ころじゃねーか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "あれ、こういうの嫌いですか？　すっごく似合ってるのに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "っ、そんな顔すんなっての！　い、いらねーとは言ってねーだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "受け取ってやるから、さっさと寄こせ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "イフリータ、また照れてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ちげーよ！　そんなわけねーだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "チッ……おい、エイヤフィヤトラ。作業は進んでるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "ここまでの間ずっと、繰り返しサンプルを集めてるんですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "異常はないとはいえ、やっぱり事前の計算とは違う結果が出ていますね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "もう少し奥まで進んで、中で何が起きているのかを確かめたほうがいいと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "だったら、グズグズしてねーで進むぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "なんだか肌寒くなってきましたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "まだ奥があるのか？　この洞窟、一体どこまで続いてんだ……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "そうですね……計算が正しければ、今は全体の半分ほど進んだあたりでしょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "ただいま。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "奥から土を採ってきたよ。はい、これで大丈夫？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "ええ、十分です。ありがとうございます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "これだけサンプルがあれば、詳しい分析ができそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "それで何がわかるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "色々とわかりますよ。今回の場合は、ここの地層が安定しているかどうかの観察と、天災関係の状況判断が主な目的ですが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "そういえば、ちょっと気になることがあるんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ここに来るまでの間、そこら中に砕けた鉱石が落ちていて……多分この山にできてる裂け目から落ちたんだと思うんですけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "それだけたくさん裂け目があるってことですよね。なんだか変だと思いませんか……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "確かに、普通ではないですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "その裂け目を観察してみましょう。連れていってもらえますか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ふわ～あ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "これで十一回目のあくびだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "二人が戻ってくるまで、もう少しかかると思うし、眠かったら寄りかかっていいから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "だーかーらー、いらないっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オレサマはな、オマエらの面倒見てくれって頼まれてんだよ！　ドクターもオレサマをナメてるよな、そんなの簡単だっつーのに！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "えっと、じゃあどうして緊張してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "バカ言ってんじゃねー！　誰が緊張なんかするかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "これは責任感ってやつだよ！　責任感！　わかるか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オレサマたちは護衛なんだから、オマエもしゃきっとしろ！　絶対足引っ張るんじゃねーぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……ん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "今、なんか聞こえたよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "んー……さっきから、なんだかざわざわしてたんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "こっちに近付いてきてるみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "――ああ、来るぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "ここにある裂け目……どれも大きすぎます。自然にできたものじゃないですね……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "サンプルの分析結果と合わせて考えると……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "っ、わかりました！　オリジムシの群れが原因です！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "大量のオリジムシが繁殖していたせいで、この辺りの鉱石層はほかの場所より緩んでいたんだと思います……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "そう考えると、低温多湿の状態にも説明がつきますね……というかそれより――ここの地層、かなり不安定な状態なんじゃ……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "わわわっ、ご推測通りみたいです！　オリジムシが湧いてきちゃいました！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "わあ～、ほんとに大群だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "さすがエイヤフィヤトラだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "んなこと言ってる場合か！？　分析が正しいってのはわかったから今は後回しにしてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "相手の数が多すぎる！　撤退するぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "クソッ！　コイツらいつまで追っかけてくるんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "このっ――オレサマが焼き尽くしてやる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "はっ、見たか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "所詮はただの虫けらだ！　バーベキューの具材にしてやらあ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "チッ、キリがねーな……めんどくせー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "邪魔してくんならお望み通り――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ぶっ飛ばしてやる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "イフリータさんが数を減らしてくれてますけど、まだまだたくさん追いかけてきますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ひゃっ！　お、追いつかれちゃいそう……！　あのオリジムシは侵入者をどこまでも追いかける習性があるんですよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "はぁ……はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おい、そこのすっとろいヒツジ！　まだ走れるか？　無理ならすぐ言え、オレサマが担いでやるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "す、すっとろいヒツジ……って、私ですか……！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ほかに誰がいんだよ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "私は……げほっ、まだ、大丈夫ですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "だけど、砂も長くは持たないし……んー、困ったね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "あーもー、我慢できねー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "あと何匹居ようが全部オレサマが焼き尽くす！　それでいいだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "っ……待ってください、イフリータさん……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "アーツを使うのは無茶です……！　この辺りの地層は脆くなっていて……あなたの火では、強すぎますから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "もし使ったらどうなるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "コントロールを間違えば……洞窟が崩れるかもしれません……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オマエらは先に行け。オレサマはここでアイツらを足止めする！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "そんなことできません！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "私もイヤだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "絶対ダメです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "あのなあ、指示に従うって約束しただろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイヤフィヤトラ",
      "text": "でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おいおい、まさかオレサマが映画によくいる悲劇のヒーローみたいになるとでも思ってんのか？　サイレンスも何本かそーゆー映画を見てたけど、ジコギセイする主人公はバカだって言ってたぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "その点、オレサマはバカじゃねーからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "要はコントロールさえ間違えなきゃいいんだろ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミント",
      "text": "ううん……一理あるような……でも、本当にそんなことできるんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "できる！　絶対やり遂げてみせるさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "だからオレサマを信じろ。オマエらの安全は、オレサマが預かってんだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ビーズワクス",
      "text": "……わかった。信じるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……よし、みんな行ったな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ハハッ、これでやっと好きなだけ燃やしまくれるぜ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ふん、オレサマが暴走するとでも思ってんのか？　ナメんなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "炎をコントロールする方法くらい、とっくにマスターしたっての！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "わかったらさっさと力を貸しやがれ、このデブ風船！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "うっせーな！　声かけてやっただけでも有り難く思え！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オレサマを痛めつける以外何にもできねーオマエのことなんか、怖くもなんともねーんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "――何をどう燃やすかなんざ、オレサマが決めることなんだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "だったらどうした？　アイツらのことなら、オレサマが守ってみせるさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "――もう二度と仲間を……友達を、傷つけたりなんかしねえ……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "text": "イフリータ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "サリア",
      "text": "すまない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "サイレンス",
      "text": "ダメ――！！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "かつてのイフリータは、自らの中で燃える炎を制御することができなかった。\n彼女は誓った。いつか必ずこの炎をコントロールして、愛する者たちを傷つけないようにしてみせると。\nサリアが「すまない」と言ったあの時、イフリータはかろうじて目を開けていた。\n鋭い刃は目前まで迫っていたが、彼女を深く突き刺したのはその刃ではなく、サリアの瞳に映る悲しみだった。\nもう二度と、あんな表情は見たくない。サリアとサイレンスには、決してあんな顔をさせたくない。\n今のイフリータは、あの頃のように無力ではなかった。\n十分な実力を付けていた。"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "よーく見とけよ、クソデブ野郎！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "この炎はもうオマエの言うことなんざ聞かねーぞ……すっかりオレサマのもんだからな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オレサマは……いつか絶対、オマエを消してやる！　首洗って待ってやがれ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "どうだった、検査終わった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "おう。……別にケガしたわけでもねーのに、なんで検査しないといけねーんだか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "ちょっと、イフリータ！　洞窟をぜーんぶ丸焼きにした挙げ句、ほかの子たちと一緒にアーツで崩落させかけたって聞いたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "よくもそんなことができたわね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "げっ……なんで知ってんだよ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "チクったヤツがわかったら容赦しねーぞ……大したことじゃねーのにぺらぺら喋りやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "まあまあ～。外野で聞いてる分には面白かったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "サイレンスに知られたら、宿題が何倍も増えちゃいそうだけど！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "もちろん、先生が帰ってきたら報告させてもらうわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ぐぬっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "自分がどんなに危ないことをしたか、わかってるの！？　もし……もしものことがあったら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ちゃんと無事で帰ってきただろ！　あんましつこく言うなって！　今回は超気をつけてたしさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "オマエに言われたとおり、戻ってきたらすぐ検査受けたんだし、それでいいだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "あのねえ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "だからサイレンスには言わないでくれよ！　な、頼む！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あれ、怖くなってきちゃったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ちげーよ！　ただ……なんつーか、心配かけたくねえだけだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "サイレンスがいつ戻るかもわかんねーしさ。サリアも一緒に戻ってきてくれたらいーんだけどな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "んー……あの二人なら、事が済んだら戻ってくると思うよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "っ、それって――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あ、言っておくけど、詳しいことは知らないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "あんまり厄介事には関わりたくないんだ。何も知らなければ落ち着いていられるし……ただでさえミーボ改造にかける時間が足りてないのに、ほかのことにまで構ってられないんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "サイレンスが留守にしてる間は君も良い子にしてたほうがいいよ。ドクターからも外出禁止って言われたでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "……うん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "text": "何日かしたら、私たちもクルビアに入るから……その時は絶対、勝手なことはしないように！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "はいはい、わかってるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "サイレンスは自分がやろうとしてることを教えてくれたし……オレサマだって、サイレンスとサリアには迷惑かけたくねーからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メイヤー",
      "text": "うんうん、君もほんとに成長したねえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "ふふん！　今に見てろよ……オレサマは、これからどんどん頼もしくなってやるぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "そうすりゃサイレンスにも心配かけねーし、何かあったらオレサマを頼ってくれるかもしれねーからさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "「イフリータ、手を貸して！」なーんて言われたりして……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イフリータ",
      "text": "へへっ、早くそんな日がくるといいな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
