{
  "server": "jp",
  "storyId": "story_ardign_set_1_story_1",
  "groupId": "story_ardign_set_1",
  "stageId": null,
  "title": "絶対大丈夫！",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/obt/memory/story_ardign_1_1.txt",
  "sourceHash": "337d2f744ce7049090bad498274fab5d494b4bf3343a24a73471563b40556bb0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ハァ、ハァ……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "もっと、もっと急がないと……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "わああ――！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ゴホッ、ゴホゴホッ……うっ、いたたた……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "やばっ！　スキー板は……まだ使えそう。よし、壊れるのはもう少しだけ我慢してね。麓のレンタカー屋さんまでたどり着ければ……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ああもう急がなきゃ……間に合わなくなっちゃう……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "アドナキエルくん、スチュワードくん……もうちょっとだけ待ってて……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "すみませーん、誰かいますかー！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "車を借りたいんです、誰かいませんか――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": "char_209_ardign",
      "text": "……*リターニアスラング*、うるせぇ！　こんな朝っぱらにドンドン叩くんじゃねぇよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "あたっ！　扉がおでこに――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "……おっと、こんな若いお嬢ちゃんが朝からどうしたってんだ。悪いな、頭ぶつけたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "だ、大丈夫です。ここレンタカー屋さんですよね？　お休みのところすみません。でも、街に行くために車が必要なんです！　今すぐに！"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "おいおい、いま何時だと思ってんだ、朝の五時だぞ……そんなに急ぐのか？　こっからだと急いでも、街まで三、四時間はかかるぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "緊急事態で今すぐ行かなきゃいけないんです。お願いですから車を貸してください！　ホントのホントに急いでるんですっ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "*リターニアスラング*、そいつは俺の睡眠より重要なことなのかよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "と、友達の命が危ないんです。北の山岳地帯で怪我して、お医者さんを探さないといけなくて……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "集落では簡単な治療しかできないので……街からちゃんとしたお医者さんを早く連れてこないと、急がないと、手遅れになっちゃう！"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "ってことは、お前は北からここまで来たのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "……まじかよ。真夜中に、あの山岳地帯を越えて？　まだ吹雪だっておさまってねぇだろ……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "だってほかに方法がなかったから。ゴホゴホッ！　……二人のケガはホントにひどくて、動けないんです。集落にはまともな医療設備も薬もないし……"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "滑落か？　それとも凍傷か？　そんなの救助隊を待てばいいんだ。お前がわざわざ山を越えて助けを呼びに来る必要はねぇだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "違うんです、普通の応急手当じゃダメなの……有効な治療薬だって必要になるし……"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "*リターニアスラング*……ったくメンドくせぇな。話もはっきりしねぇし、そんなんじゃ車なんか貸せねぇよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "お願いします！　友達を失いたくないから……少しでも希望が残ってる限り、絶対諦めたくないんです！　だから今すぐ街までお医者さんを……ゲホゲホッ……ゲホッ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "……チッ、ここまで来るだけで精いっぱいじゃねぇか。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "わ、私は平気です……"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "仕方ねぇ、人の命がかかってるみてぇだしな……ついてこい。だが嬢ちゃん、余計なお世話かもしれんが……あんまり希望は持たない方がいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "街に行ったとしても医者が来てくれるとは限らねぇ。高給取りの医者なんてのは、こんな吹雪の中で危険を冒してまで往診してくれるような連中じゃねぇからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "私は故郷じゃ雪そり巡回隊にいたから、車さえあればお医者さんの送り迎えができるし大丈夫です！　それに、ちょ、貯金ならあるから、友達が助かるなら全部お医者さんに渡したっていい――"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "とにかく、優しいお医者さんを探して、来てくれるようお願いしてみます。何が何でもみんなを助けたいんです！"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "……フンッ。友達思いじゃねぇか。"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "医者が見つかるといいな……いいだろう、貸してやる。レンタルは一日からだ、前金と身分証はあるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ごめんなさい……こんなことになるなんて思ってなくて、手持ちはあんまりないんです。前金……これで足りますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "もし足りなければ、こ、このネックレスも受け取ってください。一番お気に入りの誕生日プレゼントだけど、きっと少しは価値があるはず……！　えっと、あの、あとは……"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "……もういいって。そのボロいネックレスは自分で持っときな。車は貸してやる、だが無傷で返せよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ありがとうございますっ、絶対無傷で返すから！　い、一応担保として私のスキー板もここに置いて行きます。お医者さんを見つけたら、山に入る前に取りに来ます！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "……はぁ、あの嬢ちゃんは単純なのか考えなしなのか。"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "壊れかけのスキー板の、どこに担保にする価値があるってんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "まあいい。あの様子じゃ、本当に友達の命のことしか考えてねぇんだろうな……人助けと思っとくか。"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "だが……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "ううっ、寒ぃ。こんなに寒くて真っ暗な中、危険な山岳地帯を越えてくるなんて……一体どうやったんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "それに、わざわざ街から医者を連れて行かなきゃならねぇなんて、一体どんな状況なんだ？　ケガや凍傷レベルなら、もっとマシな解決方法があるだろうに。"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "……まさか鉱石病クラスの危険な病気じゃねぇだろうな？"
    },
    {
      "type": "dialogue",
      "speakerName": "乗り物レンタル商人",
      "speakerId": null,
      "text": "いやいや、そりゃねぇか。死ぬのが確定してるような奴を、誰がそんな苦労して助けに行くってんだ？　どう考えても無駄骨だろ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "（よーし、出発しよう。）"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "（また雪が強くなってきた。でもどうってことないぞ、この程度の雪じゃ私は諦めないよっ！）"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "（絶対に諦めない……）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……本当のこと、言えなかったな。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "もしさっきのお店の人に、二人が鉱石病に感染したって言ってたら……きっと追い返されて、車なんて貸してくれなかっただろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ごめんね、でも私は……行かなきゃいけないんだ。車は絶対に返しに来るから──ううん、新しい車を買ってお返しするね。頑張って稼いで、十倍返ししたっていい！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "絶対ちゃんとお詫びするから。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "でも今は……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "アドナキエルくん、スチュワードくん……もうちょっとだけ頑張ってね。陽が昇る頃には、街の入り口に着くから。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "そしたら鉱石病の治療ができるお医者さんと一緒に、薬を持って帰るよ……絶対。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "絶対に。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "メイリィちゃん……街には無事着けましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ハァ……ハァ……二人とも……起きたんだね……"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "大丈夫ですか……！？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "だい……じょうぶだよ──ゴホッ、ゴホゴホッ！　すぐにお医者さんを見つけて連れてくから……"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "見つけると言っても……街で感染者が出ることはほとんどありませんし、鉱石病を研究している関連企業や医療機関に連絡するしかないと思いますが……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "い、今調べてるけど……でもおかしいのっ、どうして情報が全然出てこないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "感染者を受け入れてくれる病院は……一つもないの！？　他に対応してくれる可能性があるのは……郊外に散らばる製薬会社だけ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "それも当然です……リターニアの街には、鉱石病の治療機関なんていくつも必要ありませんからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "鉱石病は治せない病気です。ひとたび感染してしまったら、高価な薬を長期的に服用し続けて、病状を遅らせるしかできません。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_209_ardign",
      "text": "メイリィ、そもそも鉱石病の薬代は君が負担できる額じゃないし、負担するべきでもない。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_209_ardign",
      "text": "もし本当に対応してくれる医療関係者が見つかったら、僕たちにその連絡先を教えてくれるだけでいい、それから……"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "うん……もう急いで戻らなきゃなんて、考えなくていいですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "メイリィちゃんはオレたちを必死で探して、集落まで連れ帰ってくれたでしょう？　そのおかげで応急処置だって受けられましたし……それだけで十分です。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_209_ardign",
      "text": "ゴホッ……もうここまででいいよ、メイリィ。わざわざ通信装置まで残していってくれてありがとう。僕とアドナキエルは、何とかして一緒に生き延びてみせるから。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……何言ってるんだよ、二人ともっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "すぐにお医者さんを連れてくって言ってるでしょ！　変なこと言わないでよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "二人とも、絶対にそこで待っててね。勝手にどこかへ行っちゃダメだよっ……あと、悪化しないようにちゃんと安静にしててね。"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "だけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "だけども何もないよっ！　わかった！？"
    },
    {
      "type": "dialogue",
      "speakerName": "アドナキエル",
      "speakerId": "char_209_ardign",
      "text": "……うん。わかりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "私を置いていかないって約束して！　絶対にお医者さんを連れて行くからっ！　絶対助けるからっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_209_ardign",
      "text": "メイリィ、ここまでしてくれて感謝してる。でも僕たちは、君まで巻き込みたくないんだ……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "私たちは友達でしょ？　友達が助け合うのは当然のことだよっ！　今の私にとって、二人の命は何よりも大切なんだよっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "もうっ、電話越しに怒鳴らせないでよ！　戻ったら改めてさっきの言葉を反省してもらうからね！　……じゃあ切るよ。良い知らせを待ってて！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "はぁ……あのお馬鹿なケガ人コンビときたら、なんとかして生き延びるだなんて……行く当てなんかないでしょ！　大人しく待っててよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "まずは病院の救護ステーションに行ってみよう。距離は……二キロくらいかな。一晩中走って来たのに比べれば大したことないよ……そうだ、先に電話してみよう。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "プルルルル……プルルルル……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "一般病院の従業員",
      "speakerId": "char_209_ardign",
      "text": "はい、こちらは救急ホットラインです。どうされましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "あっ、すみません。友達が二人、豪雪エリアでケガをしちゃって。すぐに治療が必要なんです……"
    },
    {
      "type": "dialogue",
      "speakerName": "一般病院の従業員",
      "speakerId": "char_209_ardign",
      "text": "はい、わかりました。少々お待ちください……"
    },
    {
      "type": "dialogue",
      "speakerName": "一般病院の従業員",
      "speakerId": "char_209_ardign",
      "text": "大変申し訳ございません。天候が回復しないと救急車を出動させることができません。ご友人はどのような状態ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "一人はお腹と足にひどいケガを……それから二人とも鉱石病に感染しちゃってて……だから治療薬が必要なんです……"
    },
    {
      "type": "dialogue",
      "speakerName": "一般病院の従業員",
      "speakerId": "char_209_ardign",
      "text": "……鉱石病とおっしゃいましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "そうです、二人とも──"
    },
    {
      "type": "dialogue",
      "speakerName": "一般病院の従業員",
      "speakerId": "char_209_ardign",
      "text": "申し訳ありませんが、当院では鉱石病患者の治療は受け付けておりません。お電話ありがとうございました、お大事に。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "もしもし？　もしもしっ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "切られた……なんで！　ホームページには鉱石病の治療もできるって書いてたのに！　病院がダメなら、製薬会社にも電話してみよう……えーっと、鉱石病を治療可能な製薬会社は……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "プルルルル……プルルルル……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "製薬会社社員",
      "speakerId": "char_209_ardign",
      "text": "はい、もしもし？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "あの、リターニアヴォッヘ製薬ですか？　わ、私はメイリィと言います。友達が鉱石病に感染しちゃって、今すぐ治療が必要なんです……"
    },
    {
      "type": "dialogue",
      "speakerName": "製薬会社社員",
      "speakerId": "char_209_ardign",
      "text": "名字も伺えますか？　お住まいはどちらでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "えっ、みょ、名字？　わ、私は北部から来たんだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "製薬会社社員",
      "speakerId": "char_209_ardign",
      "text": "……地元の方ではないのですか？　では患者さんは？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "と、友達はラテラーノとイェラグから来てて、ここへは旅行で来たんです。二人は街の外の山岳地帯にある集落で安静にしてもらっています……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "もしもし？　……もしもし？　もうっ、なんでまた切るのっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "地元の人じゃなくて名字がなかったらダメなの？　鉱石病ってそんなに怖いものなの？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ううっ、つ、次……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……あの、友達が鉱石病に感染して治療が必要なんです。とてもひどいケガで……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……えっ、と、友達は普通の旅行客です。治療費と薬代は絶対ちゃんと払います。約束しますっ！　何なら追加料金も払います──"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……今すぐ私と一緒に行ってくれるお医者さんがいれば──"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "お医者さん……鉱石病を治療できるお医者さんはいますか？　違います、イタズラじゃありません。ホントに病人がいるんです……"
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……どうして？　何で誰も助けてくれないの？　二人の病気は今すぐ治療が必要なんだよっ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "どうして「患者様はどちらのお家柄ですか？」なんて聞くの？　貴族の患者じゃなきゃ治療を受けられないの？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "お金は払うって言ってるのに、どうしてダメなの？　どうして……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "鉱石病だから？　鉱石病だって病気の一種でしょ？　二人はただ病気にかかっちゃっただけなんだよ。病気になりたくてなる人なんているわけないのに……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "どうして感染者になっただけで、誰も助けてくれなくなるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "いや……諦めちゃダメだ……あと三つある……きっと誰かが助けてくれるはずだよっ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "メイリィ、聞こえてる？　……まだ怒ってるかい？"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "だけど、この病気はどうにかしたいと思ったところで、どうにかなるものじゃないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "アドナキエルの熱は少し引いて、今は眠っているよ。僕たちは冷静になって、これからどうすべきか考えなきゃならない。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "これはとても危険な病気なんだ……この状況で鉱石病が伝染しない保証だってどこにもない。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "……君まで巻き込む可能性があるんだ。解決法が見つからなかったなら、もう絶対に僕たちのもとに戻ってきてはいけない。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "それから……"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "もし、もし……来てくれるお医者さんが見つからなくても、病院や他の人たちを責めちゃいけないよ。それは当たり前のことなんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "大雪の山岳地帯は危険すぎる。お医者さんだって人間だし、医療機関も彼らに対する安全責任があるからね。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "……僕もアドナキエルも、君の気持ちはわかってるし、感謝だってしてる。君は間違いなく僕たちの一番の友達だ。でも友達だからこそ、君を危険に晒したくないんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "無理はするな。自分の将来を棒に振らないでくれ。メイリィ、安全になるまで街にとどまるんだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "スチュワード",
      "speakerId": "char_210_stward",
      "text": "このメッセージを受け取ったら返事をくれ、メイリィ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "嫌だ。言われた通りにはしないよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "そんなのはわかってる、わかってるんだよ……でも、でも……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "の、残りは二つ……こっちの会社の従業員は五人だけみたいだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "くっ……構うもんか！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "あのっ！　「ロドス・アイランド製薬」の事務所ですか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "あ……はい、そうです！　どうされました？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "わ……私はメイリィ、リターニア北部から来ました……い、一応小貴族のようなものです。家族はたくさんいて、近所の人たちからも好かれてます。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "今は通帳を持っていませんが、預金は十分にあります……そ、それに働いてお金も稼げるし、治療費は絶対にちゃんと払いますっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "……ん？　えっと、あのー……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ゴホッ、ゴホゴホッ……ううっ、ウソです、ごめんなさいっ！　貴族なんかじゃないし預金もそんなにない……でも、仕事をして治療費を稼げるのはホントですっ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "友達二人が鉱石病に感染しちゃったんです。二人ともひどいケガで危険な状況なの！　今すぐにでも治療が必要なんですっ……！　私たちはよそ者かもしれないけど、どうかお願いします……！"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "重傷の感染者ですか？　その方たちは今どちらに？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "山岳地帯の集落です。ひとまずそこで安静にしてもらってます。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "お願い！　私と一緒に来てほしいんです。少し危険な道になるけど……でも誓うよっ！　私の命に代えても、お医者さんにケガはさせません！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "治療費も絶対何とかします！　友達を助けてもらえるならなんだって……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "お願いだよ……私の友達を助けて……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "どうか……自分の命に代えてでも、なんて言わないでください。"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "メイリィさん、感染者を助けることがロドスの使命です。"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "私たちが一緒に向かいます。感染者の状況を教えてもらえますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "い、一緒に来てくれるの……？"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "はい。すぐに向かいます。感染は初期段階ですか？　もしそうならなおさら急がないと。治療においては、初期段階の対応が最も重要ですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "二人の座標ならあるよ、今送ります！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "だけど、外は猛吹雪だから……かなりの準備が必要だよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "安心してください。ロドスには相応の移動手段がありますし、経験豊かなオペレーターが道中の安全を確保してくれます……たとえ悪天候の危険地帯だろうとたどり着けますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ホントですか！？　良かった……そ、それってホントだよねっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "こんなことって……私、今すっごく寒くて、あ、足の感覚がないんだけど、夢を見てるとかじゃないよね……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "え？　……あなたも治療が必要なようですね。メイリィさん、患者さんと連絡は取れますか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "うん。夢じゃない……夢じゃないんだっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "すぐに連絡します！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "……もしもしっ！？　アドナキエルくん、スチュワードくん、聴こえる？　私見つけたよっ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "二人を救う方法を……ホントに見つけたんだよっ！　二人ともその場を動かないで、すぐに助けに行くから……ロドスと一緒に！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "speakerId": null,
      "text": "準備できたぞ。ロドス救急医療小隊、出発だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "メイリィさん、大丈夫ですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ううっ、私は大丈夫……道案内するよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "あっ、動かないでください。あなたもかなりの衰弱状態ですから……長時間、走り続けてきたんですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "これより座標地点へと向かいます。しかし天候が回復したとしても最低七、八時間はかかる見込みです。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "ううっ、そんなはずないよ、私がここまで来るのに……五時間しかかかってないよ……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "五時間！？"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "そんな無茶な！　あなた……ちょっと、それは……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "まずは車を……お店に返さなきゃ……ごめんなさい……ありが、と……"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "それから……アドナキ……スチュワー……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "うわごとのようですね……"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "ひとまず休んでください、メイリィさん。あなたはもう十分頑張りました。"
    },
    {
      "type": "dialogue",
      "speakerName": "メイリィ",
      "speakerId": "char_209_ardign",
      "text": "フゥ……フゥ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "speakerId": null,
      "text": "俺が運転する。患者が治療を待ってるんだろ？　すぐに向かうぞ。彼女は助手席に乗せるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "いえ、先に医療車で治療します。"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "凍傷、擦過傷が多数、それに関節の挫傷。どうやら……骨折もありそうです。ここまで持ち堪えられたのが奇跡ですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "猛吹雪の中を、しかもこんなに危険な道を、五時間で越えて来るだなんて、無茶苦茶な……命を捨てるようなものですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "speakerId": null,
      "text": "彼女が騒いでたのを聞いた限りじゃ、友達を助けたい一心だろ？　やるじゃねぇか……"
    },
    {
      "type": "dialogue",
      "speakerName": "ロドスオペレーター",
      "speakerId": null,
      "text": "良い根性してやがる。それに、そんなに速く雪山を移動できる実力もあるなら、俺たちが必要とするオペレーターになるんじゃねぇのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "無謀ですよ！　今回は運が良かったんです。次も同じような幸運に恵まれるとは限りません！　まったく……オペレーターになったとしても、こんなことじゃきっと教官にこっぴどく叱られますよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "まあいいです……こんな話をするのは早すぎますね。今は救助が最優先事項ですから。メイリィさん本人に関しては──"
    },
    {
      "type": "dialogue",
      "speakerName": "医療オペレーター",
      "speakerId": "char_016_medic",
      "text": "彼女と、彼女の友人に何が起きたのかを、皆さんの無事を確認した後で、しっかりと話してもらいましょう。"
    },
    {
      "type": "sceneBreak"
    }
  ],
