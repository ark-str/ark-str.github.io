  "sourceHash": "4ec71040b3075df234fa7d04f993e80268471f595d08b5c3e67f4c140c78697c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "鱗獣。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "……貝だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "食える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "食える。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "もっと、もっと……口、いっぱいに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "こぼれた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "拾え、飲み込め。もっと……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "持って、行く。持って、帰る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "持って、帰る。体に、詰める。苦しく、なるまで。詰める。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "宣教師……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "宣教師。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "兄弟、そして姉妹たち。この朝食を思う存分楽しんでください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "これはあなたたちの善行へのご褒美です。我々は飢えや苦痛、病に滅ぼされることなく、むしろそれらを以て、より誠実になり、より団結し、より大きな友愛を得たのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "こうも冗長な茶番劇を一つ一つの都市でご披露なさっていて、あなたはよく食傷なさいませんこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "茶番とは……一体何のことです？　我らが海の偉大さと慈愛を陸地にもたらし、無知な者に施す……これぞ我が喜びそのものですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "彼らには理解が及びませんのに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "我らの海はすべてに対し平等ですから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "さあ、兄弟よ。あなたの手にある鱗獣の肉を、苦しむ兄弟へと分け与えるのです。信じなさい。その小さなものを施して、施された彼が満ち足りることで、あなたの心もより豊かに満ちるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民C",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "そして、施しを受けたあなた。あなたは兄弟に感謝をするのです。自分のものを分けてくれた彼に、感謝を送るべきなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "あなたたち二人は共に立ち、手を取り合い、互いの人生を分かち合うのです。それが、あなたたちをより大きく成長させるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "男性住民D",
      "text": "感謝します……宣教師……様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "良い子ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……約束とは、あなたと「あれ」の間に存在するものではなく、彼らと「あれ」の間に存在するものですのよ。あなたの手を経由しておりますけれど、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "いいえ、約束とは双方の合意をもって行うもの。しかし、彼らのように苦しみ多き者が海に求められるには未だ不十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "故に海が、彼らの願いに応えてくださいます。私は、そんな彼らの声が海に聞こえるよう手助けしているだけですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "あなたも、自分自身を我らの一部と見なしたからには、当然ルールをご理解されているでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あら、ごめんあそばせ。もっと適切な言い回しがありましたわ――あなたは彼らの血肉で道を築き、教会内で己が欲するものを得ていらっしゃるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "そうでなければ、あなたが毎回姿を現す必要などありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "私の欲するものをご存知と……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "他人より優れているという快感は、人を容易に溺れさせますもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "あなたは何か誤解されているようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "最も敬虔なる海の被造物として……私の立場は、決して偽善によるものではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "私がここに立っているのは、心の底から彼らを救いたいがため。もし私がいなければ、彼らはとっくに陸地に転がる汚れた腐肉となっていたことでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "病や飢餓などの事象は抗うことさえできれば、最も深刻な苦しみには成り得ません。なにせ「最も深刻な苦しみ」は、人々の心の奥深くからやってくるのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "災害に抗いきれなくなり、どう足掻いても滅びを避けることなどできないと人々が気付いてしまった時――それこそが、最も深刻な苦しみの訪れなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "こうした苦しみを抱えた都市が、イベリアにはあとどれほどあるのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "この広大な国土は既に、人々が国家へと向ける要求に応える力を失いつつあります。その中で人々は未だ窮屈な肉体の中で生きることを強いられ、孤立し、あるいは互いに争い合っているのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたがイベリアに向ける関心には、感嘆いたしますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "またも、誤解がある様子ですね。良いですか、私が気にかけているものは人々の苦しみであり、陸地の国境線などではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "己が肉体の限界に縛られ、己が種族の伝統的な在り方に執着するあまり盲目的に対決を選び、理解し合おうともしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "人とは皆そういうものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "そして、そのまま放っておけば、いかに力のある者でも一人また一人と打ち負かされ、ついにはすべての人々が苦しみに飲み込まれてしまうのです。あなたも覚えがあるでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それを私に言う必要が本当におありですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "恐らく、これでもまだ伝え足りないほどでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "真の知識とは、伝える価値があるものです。聞き手の方があなたのように愚かであろうとなかろうと、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "もしお気に召さないのでしたら……この話は、我々の協力関係に免じて、ちょっとした娯楽程度のものとして捉えていただけたらと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたの話術は確かに非凡の才の類かと……多くの人が酔いしれるのも頷けますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "ふむ、どうやらまだご理解いただけてないようだ。私は彼らに一切の要求もしていなければ、一切の強制もしておりません。ただ誠実に、新たな可能性を彼らに指し示したい……それだけなのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "身体の脆弱さは、常に彼らの認知能力を制限し続けています。あなたは私が言葉を通じて彼らの心を誘惑し信服させているとお思いのようですが、事実は全くの逆ですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "私は彼らの心を、彼ら自身の肉体が持つ最も基本的な要求に従わせているだけです。聖人の導きなど、一時の盲信をもたらすのみ……強健な肉体を持って初めて、彼らの視野は広がるのですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "海に住まう生き物の中には、目を持たず、身体が小さく、泳ぐこともできず、潮に流されるまま漂うことしかできぬ者もおります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "それらの生き物が感じる海は、私たちが見る海と一体どれだけ違うのでしょう？　目を持たないのなら何を頼って海の神聖さを、深遠なる様を理解するのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "あなたとあなたの僚友は、小さき彼らがその卑しくも硬い肉体をどこで手に入れたかなど知るよしもありません。それどころか、このか弱い生き物たちがもがく様すら見えていないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "さて、本当に傲慢なのは誰でしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "彼らを助ける私でしょうか。それとも、広がる危機にかこつけて、言葉巧みに真の絶望を偽の希望へとすり替え、弱者を欺き、彼らを支配し、権力を盗み取ろうとする、偽りの神の信奉者でしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "それとも――海底を直視することを避けている、愚かなあなたたちでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "私は彼らの視野を広げ、未だ本当の希望があると教えるために、己が見たものを彼らと共有しています。そうして彼らは、自ら選択するのです。陸と共に滅びるか、海と共に生まれ変わるかを。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "それは彼らを飢餓や病という窮地から救い出す意義を持つだけではありません。常に対峙し続けてきた陸に対して、海が見せる寛大さの表れでもあるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "そう。これは征服ではなく、理解であり、受容なのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "私は彼らに道を示し、彼らにより素晴らしい生活をもたらし、最終的には私と同じく真理へと至れるように導いています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "これぞ、私の偉大なる責務。あなたの誤ち多き肉体は心を縛り、視野を狭め、真に偉大なるものを見えなくさせているのでしょう……けれども、私はあなたを赦します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あら。酔いしれているのは、彼らだけではないようですわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ふぅ……歌い手さん、なんとか間に合いましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "食べ物がこんなにたくさん……皆とってもお腹がすいてますけど、これなら全員、ちゃんと食べられそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "一、二、三……これは持ち帰って、しっかり潰して……ペトラおばあさんが飲めるようにスープを作ろうっと。今夜はこれを食べようね、いいでしょ？　ベンチ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "う～……あぅ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "そ、そのまま食べちゃダメ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "これは殻が硬いから、歯が欠けちゃうよ。お家に帰って、柔らかく煮てから食べようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん、あなたもどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "う、歌い手さん？　ぼーっとして、どうしちゃったんですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "焦らずお食べなさい、兄弟。すべてあなたのものですから。ご覧なさい。将来的にはこのすべてが、あなたのものとなるのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "さあ、心を開き、自らを受け入れ、他人を抱擁し、信じ合うことを知り、犠牲の尊さを学ぶのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "紛争はとうに終結しました。苦しみも遠く去って行くことでしょう……共に立つことで、私たちの心と体、そして信仰はより強靭なものとなるのです。足元に広がる、この永遠なる海のように。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "少し、ここを離れさせていただきますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "おや、どうしました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "私……近頃、消化不良気味ですの。このままでは堪えきれずに、あなたのお顔へ吐き出してしまうかもしれませんわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "――我が兄弟よ。貝を落としましたよ。他の兄弟に持ってもらいなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "まさか私に対してそんな言葉を使うとは……実に面白いですね。今日のあなたは随分機嫌が良いようだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "何とでもお好きなように仰ってくださいまし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "きっと海からのメッセージが、あなたを刺激しているのでしょう。我らの盛大なる催しが待ちきれないのですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "ならばお行きなさい、彼女を探しに。旧友を見つけ出し、この喜びを分け与えるのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……見つけたわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "何を……してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "静かに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "こちらへ来て。彼を見なさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "嗅ぎ取れたかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "姿勢に優雅さが足りないわね。教導してあげましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたとは何回踊ったかしらね、スカジ？　二回？　それとも三回かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "いずれにせよ、あなたは良きダンスパートナーだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "彼女はどこ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "心配なのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "当然でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "彼女は無事よ。今のところは、ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "証拠は？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "そんなものが、一体何の役に立つというのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "陸での日々で嗅覚が鈍ったのではなくて？　ハンター。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたの全身から、嫌な匂いがするわ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたよりも、私の方がよほど我慢をしていてよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "彼女は確かにあなたと一緒にいたようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あら。どうやら、前言を撤回する必要がありそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "幸い……なぜ彼女を連れ去ったのか、なぜここにいるのか、なんて理由ばかりを聞きたがる、軟弱な陸地の赤子とは違うようだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "まあ、理由を問うのは私たちの流儀に反するものね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私「たち」？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたがまだ私たちの一員と呼べるのか、私にはわからないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "そう。あなたの心の中には、まだたくさんの疑問があるようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "確信もなく、手出しすることは避けるべきよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "そうでなければ、敵にただチャンスを与えてしまうだけだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "私の目的はあなたじゃないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "それならあなたは、何のために来たのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "知ってるくせに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたはずっと彼女を探しているのね。だけど……彼女さえ見つかれば、あなたの疑問は消えるのかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "彼女の記憶は壊れているわ。だから彼女が私に何かを伝えることなんて、できはしない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなた……ちゃんと鏡を見ているのかしら。今のあなたときたら、檻に囚われる人々よりは多少マシ、というレベルよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……そうね。あなたは私の部下ではないけれど、もう少し教えてあげましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "ハンターが追うべきものは獲物であり、己自身ではないということを忘れてしまってはだめよ。盲目的な追求の末、もたらされるのは気休めにすぎないのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたは虚ろな幻想を渇望するほど弱くなってしまったのかしら、スカジ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "随分多くの道を歩いたのでしょうね。あなたの肌、ひどく乾燥しているもの。もうどれくらい踊っていないの？　もしかして、呼吸のリズムも忘れてしまったのかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "もう一度聞くわ。あなたは、何のために来たのかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あら、手を出さないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あの人、あなたの仲間じゃないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "別段、気にしないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "気にしているのはあなたの方でしょう。心のしこりを取り除きたいのはあなたであって、私ではないもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなた、一体どういうつもり？　彼は何者なの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "仮に教えたとして……私の言葉を信じるかしら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "住民",
      "text": "うお……うおぉ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "慌てず、ゆっくりで良いですよ。焦ると転んでしまいますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "聞こえますか？　この波音が。ざぷん、ざぷん……私たちの心臓、その鼓動とよく似たリズムですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "皆さんが口にするものは、すべて海からの贈り物です。兄弟よ……みなぎる力が口と腹から手足を通じて、心臓へと達するのを感じませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "司教",
      "text": "さあ、眼前の広大なる様を受け入れるのです！　これこそが新しき人生の希望なのですから！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "あれ、歌い手さんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ちょっと目を離した隙に、またいなくなっちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はぁ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "まあいっか。道はわかるだろうし……きっとまた仲間を探しに行ったんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "行こっか、ベンチ。食べ物も持ったし、お家に帰ろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "あぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ベンチ、私歌いたくなっちゃった。一緒に歌いましょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さんが歌ってたの、覚えてる？　……覚えてても、ベンチはまだお喋りできないから意味ないか。じゃあ、こうしましょ。私が歌ってあげる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "彼は故郷を背にして遠く……♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "う～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "行くべき道は前にのみ……♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "幼い住民",
      "text": "う～……あぅ～？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "もう、さっきからなあに？　はぁ……そうだよね、下手だと思ってるんでしょ？　私だってわかってるもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さんよりず～っと下手！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "でも、何回も歌ってたら、私だって上手くなれるはずだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ふん、ふふん……行くべき道は、前にのみ……♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "もう行くわ。これ以上いては、彼に怪しまれてしまうもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "第二隊長！　あなたは一体、何を考えているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "隊員が……仲間が必要なの？　もし必要なら、どうしてあなたはそう言わないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "あなたは敵なの、それとも味方？　もし敵だというなら……私はあなたを殺そうとしたのに、殺意を向け返さなかったのはどうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グレイディーア",
      "text": "あなたはまず、自分が求めるものをはっきりさせなさい。彷徨うハンターは罠さえ見落とすこともあるわ。わけもわからず他人の獲物になるなんて、望ましいとは言えないでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "歌い手さん、あなたの目、なんだかちょっと変わりましたね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "そう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "前まで、歌い手さんが私たちを見る目は、あの怪物たちを見る目と変わりませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "でも、今は違います。あなたはお酒の作り方を教えてくれますし、私たち皆に歌を歌ってくれますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……あなたたちは、あの怪物とは違うわ。当然でしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "怪物は歌なんてせがまないし、話すことさえできない。汚くて、愚かで、食べることしか頭にないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "そ……それじゃ、あの海の怪物は、私たちのことも食べちゃうんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "お腹がすいてたら、食べるでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "ああやって陸へ上がってくるのは、私たちが海へ行くのと同じで、食べ物を探すためなんですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "怪物に同情してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "お腹がすくのは、誰だってつらいですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "食べられた人は、そうは思わないでしょうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "そうですね……私だって、怪物に食べられるのはイヤですもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "前はこんなこと考えもしませんでした。でも今は、えっと……もっとあなたの歌を聞きたいんです。ペトラおばあさんが私に色んなことを教えてくれたみたいに、ベンチに歌を教えてあげたくて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "それなら、おばあさんみたいに長生きしないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "はい！　あっ、でも今は、ちっとも心配してませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アニタ",
      "text": "だって……あなたがいますから！　ばばばーってあいつらをみーんなやっつけて、私たちを助けてくれますもんね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……私の鼓動、速くなってる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "ああ……うん。そうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "スカジ",
      "text": "……結局、私はまだハンターなんだもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
