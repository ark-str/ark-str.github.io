    {
      "type": "dialogue",
      "speakerName": "ロベルタ",
      "speakerId": "avg_484_robrta_1",
      "isRemote": false,
      "text": "（大声で泣く）"
    },
    {
      "type": "dialogue",
      "speakerName": "死体安置所の従業員",
      "speakerId": "avg_npc_523_1",
      "isRemote": false,
      "text": "……"
