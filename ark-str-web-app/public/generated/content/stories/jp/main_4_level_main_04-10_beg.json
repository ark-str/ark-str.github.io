{
  "server": "jp",
  "storyId": "main_4_level_main_04-10_beg",
  "groupId": "main_4",
  "stageId": "main_04-10",
  "title": "風前の灯火",
  "storyCode": "4-10",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_04-10_beg.txt",
  "sourceHash": "af078dffe2d5b01adcd5d1eee562f6207757de0aa5c0e15d1ded0ad2e9108485",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "温度が……急に、下がってきたような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "！　地面も凍って……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "さ、寒い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "っ……！　あ、あの吊るされた人たちまで……氷が、飲み込んで……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "そ、それに……空が、あんな黒い雲で……いっぱいに……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "一体、どうすれば……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ジェシカさん！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "まずは落ち着いてください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "……っ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "はい……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それから、陣形の保持を意識するようにお願いします！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ジェシカ",
      "text": "了解しました！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "フロストリーフ、あなた何をやってるの！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "――「フロストノヴァ」……彼女が、辺り一帯の熱を奪っているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "それにしても、こんな広範囲に影響を及ぼすなんて……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "……ハッ、「スノーデビルのお姫様」か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "私より、体温の低い奴を見たのは初めてだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "――フロストリーフ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "メテオリーテ……悪いな……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "そちらに戻って……時間稼ぎをしてやりたいところだが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "ッ……！　あなた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "ああ……身体が、凍り始めているんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "この脚はもう……動かせそうにない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "そんな……フロストリーフ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "――アーミヤ。包囲を突破して逃げろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "このままでは、一分も持たずに広場のすべてが凍りづけにされそうだからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フロストリーフ",
      "text": "行くんだ。私の犠牲を無駄にしないでくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "そんなこと……できるわけないでしょう！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "彼女の言う通りです！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "フロストリーフさんを見捨てたりなんてしません……！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "誰一人として、置いて行かないと決めていますから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "メテオリーテさん！　敵部隊の動きは、私が封じておきますので――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "その間に、フロストリーフさんを救出してください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "メテオリーテ",
      "text": "了解！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "text": "ドクター！　部隊の指揮をお願いします！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "任せてくれ！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "（頷く）",
          "value": "2",
          "blocks": []
        },
        {
          "label": "わかった！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "――――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "思えば、このアーツ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "一度しか使ったことがないんだが、四の五の言ってはいられんな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "――「凡そ、血の通う者ならば」……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "ほう。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "氷には氷を、というわけか。……だが……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "くっ……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "これで、上手くは舌が回るまい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "貴、様……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "――――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "スノーデビル小隊、配置につけ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "了解。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "我が兄弟たちよ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "奴らの血液に至るまで、すべてを凍らせてやれ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "任せておいてくれ。",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "「凡そ、血の通う者ならば」……「その心我の知るところなり」。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "今のは……アーツの詠唱か？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "あのウサギ、何を……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "――ん……？　黒い……線？　あれは一体……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "ッ！　まさか、さっきのアーツか！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "まずい、こっちに来て――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "や、め――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "っあ……あああああっ……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "ぐっ……か、身体が熱い……！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "メテオリーテさん！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "任せて！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "そっちも、そのまま続けてちょうだい！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "ひっ……いやだ……寒、い……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "う、あ……痛い、いたいぃっ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "……っが……やめ……や、めてくれ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "――っ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "急げ！　同胞たちをこれ以上傷つけさせるな！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "レユニオン構成員",
          "text": "了解！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "あのアーツ……実に強力だな……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "う……ぐっ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "お前……たちを……これ、以上……進ませる、わけ……には……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "っ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストリーフ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "悪いが、アーツは使わせんぞ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "そのまま眠りにつくがいい。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "お前の苦しみも、すぐに終わらせてやる。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "っ……！　ダメ！！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "ああ……それでは、お前がアーミヤか。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "なるほど、良い目をしている。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "確かに、戦士に相応しい眼差しだ。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "……けれども……すまないな。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "あなたは……なぜ……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "……♬",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "――♪――♬――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "これは、一体……？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "――♬――♬――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "……雪が……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "……♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "「眠れ、眠れ」……♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "「ハリネズミの人形と小熊たち」……♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "この、変わったメロディー……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "――まずい、アーツの詠唱だわ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "「静かな黒に沈め」……♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "フロストノヴァ",
          "text": "……「壊れた人形よ」……♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "――",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "空中に……次々と、黒い氷の結晶が……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "ジェシカ",
          "text": "あの結晶、ゆっくり落ちていきますよ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "触れたところから、地面が黒く凍り付いて……",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "メテオリーテ",
          "text": "周りにまで広がってる……！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "みるみるうちに、周囲の地形が侵食されていますね……！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "text": "なんとしても、あの歌を止めなければ！",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "――総員、攻撃態勢を！　全力で対抗するぞ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
