{
  "server": "jp",
  "storyId": "act21side_level_act21side_04_beg",
  "groupId": "act21side",
  "stageId": "act21side_04",
  "title": "雷鳴の夜",
  "storyCode": "IS-4",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsGamedata/jp/gamedata/story/activities/act21side/level_act21side_04_beg.txt",
  "sourceHash": "d70470d13b8a9bf447d8a963ae0e96d453f0db47f45d7ed4dd013fa0e8d6a8a1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "ソラ、まだ～？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "急かさないでよ～！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "ううっ、このドレスきついなあ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "太ったんじゃない？　あたしに内緒でピッツァを食べたとか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "ありえないよ！　昨日の夜一枚多く食べただけだもん！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "ソラ、息吸うて！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "すう～～……"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "よっしゃ、できた！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": null,
      "text": "はい、もうええよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "終わった～？　早く出てきてよ、見たい見たい！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": null,
      "text": "はいはい、今行くから。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "うんわあ～、すんごい綺麗じゃん！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "avg_201_moeshd_1",
      "text": "ほんま、完璧やんな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "えへへ……"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "あーあ、テキサスの奴にも見せてやりたいよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "ほんとにね。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "avg_201_moeshd_1",
      "text": "しかしさすがはソラやで！　こない早いうちから舞台に出るチャンスを掴んでまうなんてな！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "ふっふーん、当然でしょ～！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "『テキサスの死』は三章構成なんだけど……第一幕のリハーサルは無事終わったから、明後日が上演だね！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "うまくいったら、テキサスさんを探すどころか、向こうがあたしを見つけてくれるかも。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "うんうん、ありえるね！　そうなったらピッツァを買ってきてあいつの顔にぶつけてやろ～っと！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "avg_201_moeshd_1",
      "text": "そういや、最近はベッローネのうわさをぎょうさん聞くけども、あんまええ状況やないみたいやし、テキサスはんに妙な影響出てないとええなあ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "あいつなら大丈夫だって。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "avg_201_moeshd_1",
      "text": "せやな。今は信じるしかあらへんわ。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerId": "avg_201_moeshd_1",
      "text": "ほな、ソラの舞台デビューまでゆっくりしよか。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "本当はもっと街でぶらつきたかったのに、結局ソラのボディーガードになっちゃったしね～。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "ちょっと、あたしのせい？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "ま、劇場でただ食いさせてもらったからトントンかな？　へへっ、あのピッツァは本当美味しかったよね！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerId": "avg_103_angel_1",
      "text": "そうだ、これから忙しくなるなら今のうちにお散歩しようよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "いいね。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な役者",
      "speakerId": null,
      "text": "ねぇ、聞いた？　……なんですって。"
    },
    {
      "type": "dialogue",
      "speakerName": "物好きな役者",
      "speakerId": null,
      "text": "それって……テキ……よね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "ん？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な役者",
      "speakerId": null,
      "text": "そう、テキサスが……にな……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "もしかして……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "こんにちは！　今テキサスがどうとかってお話ししてました？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な役者",
      "speakerId": "avg_npc_175",
      "text": "あら。ええ、そうよ。あなたも興味があるの？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "はい。何かあったんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な役者",
      "speakerId": "avg_npc_175",
      "text": "ベッローネにいる彼氏から聞いた話なんだけどね。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な役者",
      "speakerId": "avg_npc_175",
      "text": "何日か前に、建設部長が殺されたでしょ？"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な役者",
      "speakerId": "avg_npc_175",
      "text": "その犯人が捕まったんですって。"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な役者",
      "speakerId": "avg_npc_175",
      "text": "で、それがあのテキサスファミリーの生き残りらしいの。名前は……チェリーニアとかいったかしら。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "そ、そんなはず……！"
    },
    {
      "type": "dialogue",
      "speakerName": "活発な役者",
      "speakerId": "avg_npc_175",
      "text": "裁判の日も決まっていて……明後日やるらしいわよ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "おう、若旦那。また面会を延期させられたらどうしようかと思ってたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "悪かった。最近は立て込んでいたものでな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "ほかのファミリーと睨み合ってたシマから部下を撤退させてるって聞いて、心配してたんだぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "ま、元気そうで何よりだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "あれは単なる損切りさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "ハハッ、あんたのそういう用心深いとこは好きだぜ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "俺たちロッサティは他人の窮地につけこんだりはしない。そこんとこは安心してくれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "だが、一つ聞いておきたいことがあってな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "テキサスのことだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "ああ。あのチェリーニア・テキサスが帰ってきて、あんたの用心棒をしてると聞いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "本人なのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "そうだと言ったら？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "あいつが生きてたなんて、俺たちは知らなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "……その当時、俺の親父が彼女を救ったそうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "なるほど、なるほど。確かにあの人らしいやり方だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "親父はきっと、あいつに新しい都市を見せてやりたいだけなのさ。あれの建設は元々、サルヴァトーレとシラクーザの繋がりに端を発するものだからな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "ははあ、さすがはベッローネだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "テキサスの名がロッサティにとって大きな意味を持つと知りながらご親切にも呼び戻してくださるとは。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "まったく肝が据わってやがる。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "俺もこれには脱帽だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "随分トゲのあるジョークだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "これのどこがジョークだと思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "俺たちからすりゃ、チェリーニアがまだ生きてるって事実自体に大きな意味があるんだぞ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "ベッローネがどう思ってようと、ロッサティはあんたらに借りができた。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "そう言うな。俺たちはこれから共に新都市を築いていこうという関係なんだ、貸し借りなんてやめにしないか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "ハハハッ、よく言った！"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "どうやら、こうなるのを予測してたらしいな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "言えよ、あんたの目的は？"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "簡単なことだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "ロッサティにはこの件に手を出さないでほしい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "ほう？　最後のテキサスが裁かれるのを黙って見てろってか？　そんな真似したらうちのドンにどう言ったもんかわからねえが。"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "裁判が終われば、彼女は拘留される。そっちも会いに行くことはできるだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "……会うだけで満足しろっての？"
    },
    {
      "type": "dialogue",
      "speakerName": "レオントゥッツォ",
      "speakerId": "avg_427_vigil_1",
      "text": "彼女は俺たちの客だが、ロッサティの客でもあるかもしれないな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ウォラック",
      "speakerId": "avg_npc_695_1",
      "text": "……いいだろう、乗った！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "ここに来てチェリーニアを引っ張り出すとはな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "ラヴィニアの考えか？　いや……犯人はチェリーニアじゃないってことくらいあの人ならわかるはずだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "彼女の性格からして、こんな判断をするはずはない……"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "となれば、レオンが説得したのか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "……まあいい。何にせよ、こんな手を使われるとは思わなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "speakerId": "avg_npc_698_1",
      "text": "……これからどうしましょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "speakerId": "avg_npc_698_1",
      "text": "チェリーニアを殺しに行ったほうがいいですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "……七年前の混乱の中で、ファミリーの精鋭が何人あいつにやられたと思う？"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "speakerId": "avg_npc_698_1",
      "text": "ですが――"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "不意打ちしたり、爆弾で吹っ飛ばしたり、あるいは単に毒を盛ったり……そりゃあ、方法自体はいくらでもあるが……"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "あいつを連れ戻したのが誰か、忘れるわけにはいかないだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "誰が思いついたにせよ、賢いやり方だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "こうなれば、多少手荒な方法を取ってでも裁判を止めさせるしかないな。"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "speakerId": "avg_npc_698_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "そもそも、俺たちの目的は街を混乱させることにある。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "ミズ・シチリアへの挑発は初めから計画の内だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "単にそれが少し早まっただけのことさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "マフィア",
      "speakerId": "avg_npc_698_1",
      "text": "……はい。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "speakerId": null,
      "text": "ボクとしては、別の方法もあると思うけどね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ディミトリ",
      "speakerId": "avg_npc_690_1",
      "text": "――誰だ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "speakerId": "avg_npc_683_1",
      "text": "面白そうなことしてるじゃない。ボクも混ぜてくれる？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "……"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "どうぞ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "監督、テキサスさんのこと聞きましたか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "ああ、先ほどな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "何が起きてるのか、ご存知ありませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "私の知りえた限りでは、ラヴィニアの判断だという話だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "ラヴィニアさんっていうと、あたしを助けてくれた、あの……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "……誠実そうな人でしたけど……でも……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "もしや、デビューを遅らせたいと？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "なんとかできないでしょうか……？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "あたしは……とにかく、あの人に一目会いたいんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "デビューの延期が可能かどうかはさておき……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "会ってどうするつもりなのだね？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "君は以前言っていたはずだ。彼女を探すためにこそ、二人の友人を連れシラクーザへと来たのだと。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "これまではずっと、自分が見てきた彼女こそが、本当の彼女だと信じてきたのだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "だが、今や君は知りつつある。彼女の隠された過去の正体を。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "君は、ずっと追いかけてきたその人が、想像とはかけ離れた人物であると気付かされかけているのかもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "そんな今、彼女に会ってどうする？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "君は彼女に、そして彼女は君に――何を告げられるというのかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "……本当に、あの人が想像と違う人だったら……きっと勝手な想像をしたあたしにも責任があると思います。もしかしたら、あの人への理解が足りてないのかもしれません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "隠し事をしたのが向こうであろうとも、か？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "それは相手に理由かあるか次第ですね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "何にせよ、あたしも芸能界で色んな人に会ってきましたから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "そもそも、二面性を持たずにいることのほうが難しいと思います。少なくともあたしにはできそうもありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "いつかはそれが積み重なって、思いとは裏腹の行動を取らないといけなくなることもあるかもしれませんし……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "だから、あたしは誰かの隠し事を無理やり暴くことはしたくないんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "誰にだって秘密はあります。あたしにも、あの人にも、そしてきっとあなたにも。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "それでも、見せたい一面をずっと見せ続けてくれるのなら、それもある種の誠実さだと思いませんか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "……確かにな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "それに、あの時はちゃんと言ってなかったかもしれないんですが……"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "あたしは、テキサスさんを責めるために探しにきたわけではないんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "……あたしたち四人は、龍門で六年近く一緒に過ごしてきました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "この六年のことは、あたしにとってかけがえのないものなんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "きっとあの人にとっても、それは同じだと思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "それなのに、あの人は何も言わずにいなくなってしまいました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "あたしは怒るべきでしょうか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "いいえ、それよりも心配してるんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "エクシアも、クロワッサンも同じ気持ちです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "だからこそ、シラクーザに来たんですから。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "あの人がトラブルに巻き込まれてるのなら、あたしたちが助けになります。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "テキサスさんの過去があの人を潰してしまうほど重たいものなら、あたしたちが一緒に背負います。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "数ある作品で描かれたチェリーニアの末路はすべて根も葉もないものだが、テキサスファミリーの最期は公然の事実だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "彼女の過去は、恐らく君が思うよりずっと深刻なものだろう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "ええ、わかっています。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "それでも、あたしたちはまだ本人の口からそうは聞いてません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "あの人自身の考えを聞く必要があるんです。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "そうして、あたしたちがどれだけ頑張っても、テキサスさんが離れていくのをやめないというのなら……その時ようやく、諦めがつくと思います。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "努力した結果なので、きっと後悔はしません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "……あ、やっぱり後悔はすると思います。でも、多分そこまで強い後悔じゃありません。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "君は聡明な人だな、ソラ君。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "強がりに理由をつけてるだけですよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "でも、こうして話を聞いていただいたおかげで、あたしもだいぶ気持ちが楽になりました。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "確かに、今会えたとしても、何の力にもなってあげられないかもですよね……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "実を言うと、私は君の求めに応えるつもりでいたよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "裁判後、彼女に会えるよう手配しておこう。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "本当ですか！"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "本当だとも。しかし、今はもうしばらく待ちなさい。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "ありがとうございます。それまで、しっかり準備しておきます。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "ふふっ……"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "それにしても君のデビューを見届けられそうにないのは残念だな。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "えっ、見てくださらないんですか？"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "ああ……その日は大事な用事が入りそうでね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "だが、最高のステージを用意しておいたから安心してくれたまえ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "ありがとうございます！"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerId": "avg_npc_684_1",
      "text": "では、そろそろ失礼しますね。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "ああ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": null,
      "text": "……"
    },
    {
      "type": "narration",
      "text": "ベルナルドは書架へと近付くと、一冊の本を手に取った。\nそれはイバラがまとわりついた法典だ。\nしばらくの沈黙のあと、彼は一本の電話をかけた。"
    },
    {
      "type": "dialogue",
      "speakerName": "ベルナルド",
      "speakerId": "avg_npc_685_1",
      "text": "……ディーマ、彼女に伝えてくれ。同意する、と。"
    },
    {
      "type": "narration",
      "text": "どおん、と大きな雷鳴が窓の外で轟いた。\n大雨を予感させるように。"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
