{
  "server": "jp",
  "storyId": "act30side_level_act30side_07_end",
  "groupId": "act30side",
  "stageId": "act30side_07",
  "title": "壊れたブレーキ",
  "storyCode": "RS-7",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act30side/level_act30side_07_end.txt",
  "sourceHash": "23fce94c235844ab1081f9c1994ec60368a05576a0814650bea97fdc54e022d1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "いつまでここに座っているつもり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "すでにこの場所を見つけた以上、彼はいずれ来るでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "本当に来たら、どうする気？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "殺すわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "外国の使節を殺すのは重罪よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そうなった時に考えるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "イェラグ人ではないはずのあなたが、どうしてイェラグのためにここまでしてくれるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "エンシオディスの野心も、「イェラグのため」と言えるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "彼に野心があったとして、その中に「イェラグのため」が含まれていることを否定できる人なんて居ないんじゃないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "多分、それは彼にとって一番聞きたくない誉め言葉でしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "それで？　あなたの答え、まだ聞いていないわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "エンシオディスが「イェラガンドは実在するかもしれない」と言った時、私は思ったの。いつか、その「神様」と一戦交えられるかもしれないって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "だけど、望みはもうなさそうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "エンシオディスにその気がなくなったからよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "もしも彼にその気があれば、あなたは本当に、その実在するかもしれないイェラガンドに立ち向かうの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "かもしれないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "ここでは、刺激を味わいたくても雪崩の時くらいしかチャンスがないから。本当にそんな機会があれば、試してもいいでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "勝てると思うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "いいえ。私、雪崩にだって勝ったことないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "わかったわ。あなたは、その挑戦自体を楽しんでいるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "そして、今この地で起きていることは、あなたが挑戦するに値するものだと思っている、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "そんな大した話じゃないわ。ただ、私はそうやって成長してきたというだけのことよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "……素敵な言い回しね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "さあ、そろそろお戻りなさい、デーゲンブレヒャーさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "あなたの戦場はここではないから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "それが巫女の意思だと言うなら、悪いけど従えないわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "自分の戦場は自分で選ぶわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "ではもし、イェラガンドの意思だと言ったら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……だとすれば、どうして巫女じゃなくあなたが、それを伝える役目をしているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "だって巫女様の侍女ですもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "巫女の意思こそがイェラガンドの意思だ、と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "あるいは、イェラガンドは巫女様の考えを支持している、と捉えてくれてもいいわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "私の推測だけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デーゲンブレヒャー",
      "text": "……フン。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "黒騎士が愚か者でなければ、私を追いかけまわすより、ここで待つことを選ぶはずだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "私が戻ってくるということを、彼女は知っている。まさに、私自身がそれを知っているのと同じように……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "はぁ。生きて帰れるよう願っておくか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "もっと早く、問題の核心はここだと推測できていれば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いや、それは無理だろうな。一国の信仰を自らの野心の隠れ蓑として利用するほど、エンシオディスの肝が据わっていることなど誰に想像できようか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "公爵様が投資なさっただけのことはあるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "そしてあの巫女も……彼女は本当に、このことを何も知らないのだろうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "なぜいないんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "彼女がそこまで迂闊だとは思えない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "これは……石？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "来訪者よ、何用か？"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……私は敬虔な一信徒です。神のご尊顔を間近で拝見できたらと思い伺いました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "主はお疲れになり、今日はもう休まれるところだ。\n明日またおいでになられよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "イェラガンドはよそ者の信仰をも歓迎すると聞きましたが、あの言葉は戯れだったのですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "真に敬虔なる者は身の証を立てる必要などない。誠実を欠いた者の言葉は用をなさぬものだ。\n今日はそれ以上進んではならぬ、と主は仰せだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "どうしても進むと言ったら？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "なっ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「グレーシルクハット」は辺りを見渡した。そこは普段からとても賑やかな、銀心湖沿いの大通りだった。突如として現れた彼には、大勢の視線が集まっている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は思わず、思い切り自分の頬を叩いた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "通行人A",
      "text": "あれ？　あの人、いつからあそこに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人B",
      "text": "見て、なんか自分の顔叩いてるわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "通行人A",
      "text": "頭がおかしいんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ふ、ははっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「グレーシルクハット」は周りに構わず、ただイェラガンド像のほうへ振り返ると、敬虔な信徒を真似て祈りの動作を行った。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "イェラガンドのご加護があらんことを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "この地へと足を踏み入れて以来、彼がこのようなことをするのは初めてだった。\nそうして彼は、少しの躊躇いもなく身をひるがえして立ち去った。\nほど近くから自分を見つめる双眸に気付きもせずに。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "デーゲンブレヒャーは余計なことを言う人じゃないし、この件をエンヤに伝えたりしないわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "それに、私だって別にやりすぎてはいないし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヤエル",
      "text": "はぁ、だから言ったのよ。傍観者でいるのは難しいって。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ため息をつくその姿は、まるで手の焼ける妹からの要求に文句を言う姉のようだった。そして彼女はその場を離れ、人ごみの中へ消えていく。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタA",
      "text": "止まれ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "あっ、こんにちは、お疲れ様でございます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタB",
      "text": "何者だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "ええと、今夜銀心湖で小さな宴がありますよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "そのためのお酒を取りに来たんです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタA",
      "text": "酒を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタB",
      "text": "確かに、そういう話は聞いているな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタB",
      "text": "であれば向こうと確認を取ろう。ついてこい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "はい、わかりました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタB",
      "text": "そこに立て。――おい、こいつのボディチェックを頼む。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタA",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "あのう、私はただお酒を運びに来ただけなのですが、そこまでなさる必要が？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタA",
      "text": "悪いが、時期が時期だからな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタA",
      "text": "お前の言うことが本当だとわかれば、改めて詫びよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "でしたら、お詫びをいただく必要はないでしょうね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタA",
      "text": "なっ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "酒商人が腰から下げていた装置のボタンを押すと、天井の隅に取り付けられていた数台の防犯カメラが突如不自然に回転し始めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタA",
      "text": "ぐっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタB",
      "text": "敵が――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "残念だったな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "チェゲッタB",
      "text": "がはっ――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人のチェゲッタは倒れこみ、酒商人は素早く端末の前へ歩み寄ると操作を始めた。\nすると、カメラは一瞬停止したあと、再び正常に稼働し始めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "事前調査は済ませてあるんだ。イェラグの導入したオペレーティングシステムは前世代型で、致命的なセキュリティホールが二つ存在した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "次世代製品を購入したほうが良いだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "無論、イェラグがヴィクトリアの一部となるのなら、タダで手に入るわけだが。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "酒商人は一息ついたところで、すぐに腰をかがめた。"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "ッ――傷口が開きそうだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "やはり、黒騎士の破壊力は段違いだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "しかし、そんな彼女も全知全能ではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "――イェラガンドのほうは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "後で考えるとしよう。少なくとも、かの神は私がここを見つけ出すのを阻もうとはしなかったのだから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は再び立ち上がり、近くの酒樽へゆっくりと近付いた。\nその酒樽はいかにも重く、しかし近くへ寄っても酒の匂いがしないということに彼は即座に気が付いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "……ははっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その中にあるのは酒ではなく、金属だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "イェラグが仕入れた金属の量は調べていたが、その時点では特に問題を見出せなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "けれどもし、像の建設用として仕入れた金属が、すべて像に使われているわけではないとしたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "残りの金属はどこへ行ったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "この酒樽の中の金属は、どこへ向かうのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "……フッ、なるほど。道理でな。黒騎士の力がいかに恐ろしく強くとも、あれほど容易く像を削れるわけもない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼はきびすを返して端末の前へと戻ると、再び操作を始めた。\n打鍵音が響く中、それに伴いモニターには画像が次々と表示されていく。\nしばらくして、彼はようやく立ち上がった。"
    },
    {
      "type": "dialogue",
      "speakerName": "酒商人？",
      "text": "さて……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "今夜の宴まではあと数時間ある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "――見せてもらおうか、エンシオディス。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あなたが本当に、ヴィクトリアとの戦いへ挑もうとするほど愚かな人物かどうかをな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "つまり、父君と再会ができ、その上で蹴りを入れてきた、と？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "そーいうこと！　超すっきりしたぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "初めはそんなにムカついてなかったんだけどさ。父親ぶろうとしてんの見てたら、なんか蹴っ飛ばしてやりたくなって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はっはっは、さすがですな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "思えば、アークトス殿にはイェラグに来たばかりの頃に一度お会いしているのですが、その後はさっぱりお目にかからなかったのですよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "私がはっきりとあの方のお顔を覚えていれば、貴方に回り道をさせずに済んだのですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "んー、でも実際さあ、私ってほんとにあいつに似てっかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "うーむ。よくよく思い出してみれば、あの方はひげを蓄えていますから……仮に昨日アークトス殿とお酒の席でご一緒していても、容易には気付けそうにありませんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "だよなー。あのツラのどこがイケメンなんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ひげを剃れば……あるいは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はは、何でもありません。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おっ、向こうに駄獣がたくさんいるな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "どうやら、近隣の村の方々もいらしているようですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "今夜はきっと良い夜になることでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おや？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なんか駄獣につつかれてるじゃねぇか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おお、君は！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "リリー！　リリーじゃないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "はっは、この子ときたらお主を見るなり駆け出してな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "よーしよし、いい子だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "へえ……こいつが前に言ってたリリーか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ええ。この子は、私がイェラグで最初に出会った駄獣であり――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "この地でできた、最高の友でもありましてね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おおよし、君はまったく可愛いな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リリー",
      "text": "（荒々しい鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "なあ、撫でてもいいか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "もちろん。この子は人懐っこいですからね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リリー",
      "text": "（人懐っこい鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おお、貴方を気に入ったようですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はははっ、やはりイェラグの血が流れているだけありますな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "うおっ、舐められた！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "どうです、背中に乗ってみませんか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "いいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "もちろんですとも。レオン殿、構いませんよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "はっはっは、無論だとも。お乗りなさい、お嬢さん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "よっしゃ！　じゃあおっさん、支えてくれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "では、私の手に掴まってくださいね。いち、にの、さん――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リリー",
      "text": "（興奮した鳴き声）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "わあ、こいつの背中すっげえどっしりしてんな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "じゃあ私、リリーとそこら辺を回ってくるよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "どうぞどうぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "ふっふ、元気な子じゃのう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ええまったく。私の娘も、子供の頃はああでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "そうだ、お主にこれをやろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "これは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "今日できたばかりの、極上チーズじゃよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "これは、お主のために作ったもんでのう。もうすぐ国へ帰ると聞いておったから、今夜会えるかもしれんと思って持ってきたんじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "そんな、申し訳ない。貴方のチーズは大切な商品でしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "そう言ってくれるな。お主はうちの家族や駄獣を何度も診察してくれたろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "それを思えば、わしのほうこそお主に診察代を払わねばならんくらいじゃ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "だから、代金代わりに受け取ってくれんか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はっはは、そういうことならわかりました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "これほど嬉しい餞別もございませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "……実を言うとな。わしらは初め、お主のことを警戒しておった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "しかし、ひと月共に過ごした今では、皆お主のことを良き友と思うておる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "湿っぽい話はせんでおこう。次に来た時も、必ずわしの牧場へ寄っておくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "ええ、必ず。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "text": "レオンおじ様、子爵様ともお知り合いなのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "おや、巫女様。そうなんです、ハロルドは今じゃわしらの村の人気者でしてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "text": "左様でしたか。あなたと駄獣たちが、楽しい時を過ごせますようお祈りしております。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "ええ、そりゃあもう！　巫女様に会えたおかげで、もう楽しい時は始まっとりますよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "これは巫女様。今宵は大変楽しい宴ですな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "text": "はい、とても。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "text": "此度の本番は明日の式典ではございますが、一般の方は中継を通して観覧するほかありませんので……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "text": "皆様にもこの祝いの空気を楽しんでいただくために、このような席を設けさせていただいた次第です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "さすがは巫女様ですな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "text": "ところで、「グレーシルクハット」様はどちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "彼は暗い男ですから、賑やかな場所が苦手なのかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いやいや、そんなまさか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "確かに賑やかな場所はあまり好きではありませんが、それは性格とは関係のないことですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "おや……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "イェラグの景色はまったく素晴らしいですね。おかげで時間を忘れてしまいました。どうかお許しを、巫女様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "text": "当地の景色を気に入っていただけたのなら何よりです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンヤ",
      "text": "今宵はどうぞ、この宴をお楽しみください。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "ええ、そうさせていただきます。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "そういえば、今夜は酒を持ってきとるんじゃ。ご友人もたしなむようなら、一緒に飲もうではないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "それは――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「グレーシルクハット」がハロルドに向けて、密かにジェスチャーを送った。\nそれは軍で用いられている、回避を意味する暗号だ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……レオン殿、申し訳ありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "また後ほどいただいてもよろしいですかな？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リリー",
      "text": "（興奮気味の鳴き声）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "おーいおっさん、戻ったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "あれ、どこ行ったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "黒い服着たご友人に呼ばれて、どこかへ行ってしもうたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "まさか「ジョン」に？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……マジかよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "今夜の宴はお楽しみになられましたか、子爵様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "相当楽しんでいましたよ。貴方に呼び出されるまではね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "それは結構なことです。この先は楽しめなくなりますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……訳を話してもらいましょうか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "湖の小島にあるイェラガンド像ですが、あの下には何か秘密があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "軍人は秘密という言葉を嫌うものです。その内実を解明するのは貴方がたの仕事では？　「ジョン・スミス」殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "残念ながら、解明には至りませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "「グレーシルクハット」らしからぬ発言ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "思わぬ妨害を受けたものですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "つまりは、失敗したと言いたいのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "いいえ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あの中に何が隠されているかまではわかりませんが、その妨害を受けたこと自体が、あそこに何かあることの証明なのです。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「グレーシルクハット」が懐から取り出したのは、写真や書類、そしてノートの類だった。\nハロルドがいくつか手に取り目を通せば、その顔に先ほどまで浮かんでいた笑みが凍り付く。"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "酒を運んでいるはずの車両に積まれていた貨物。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "金属の実際の流れ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "輸送ルートの設計。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あらゆる情報が一つの事実を示しているのです。すなわち――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あの小島の地下には、エンシオディスの……いえ、この国最大の秘密が隠されているということを。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "リェータ",
      "text": "……！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "……彼女です。逃げられましたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "わかっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "今の話をイェラグ要人の娘に聞かれたのは、よろしくないですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "そういったことに気を払うのは貴方がた諜報員の仕事でしょう。私は軍人ですから、戦争以外は専門外です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "まあ、構いませんよ。彼女はこれまで自分が誰の娘かも知らなかったのですから、何もできようがありませんしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "この国の状況を理解して、早いうちにここを発ってくれるのなら、それも悪くないでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "そうなれば、彼女はただのウルサス国民でしかありません。私もウルサスの恨みを買う勇気はないですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……「グレーシルクハット」殿。これまで私は、貴方への評価を間違えていたのかもしれませんな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "お互い様ですよ、子爵様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "それに、我々のような人間は、警戒し合っておいたほうが良いものです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "大変ごもっともです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "しかし、この言葉がお気に召しても、次にお伝えすることもそうとは限りません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "あなたは手ぶらでは帰れませんよ、子爵様。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "わかっていますとも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "本当におわかりいただけているよう願います。エンシオディスは公爵様に借りがあるのですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "にもかかわらず、彼は一線を越えたのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "貴方はそうして自分を納得させた、ということですかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "この手のことはあなたのほうがお得意だと思いますがね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「グレーシルクハット」",
      "text": "英雄殿。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "宴はいまだ続いている。\n人々はかがり火を囲んで歌い踊り、来たる明日を歓迎していた。\n彼らが思い浮かべる明日はきっと明るく、喜びに満ちていて、思わず踊って歌いたくなるような一日なのだろう。\nハロルドは思った。今この場で、そんな明日を思い描けないのは恐らく自分だけだろう、と。\n彼はふと、わずかに寒さを感じた。\n前回同じような寒さを感じたのは、この土地に来たばかりの頃だ。\nそうして、酒が一瓶欲しいと思った。あるいは、一瓶では足りないかもしれないが。"
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "待ちくたびれたぞハロルド！　ヒック！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老牧畜民",
      "text": "これ以上待たされたら、わし一人で全部飲んじまうところだった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "はっはは、これは申し訳ない。ですが、私が良いお酒を見逃すはずがないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "さあさ、今夜はとことん飲みましょう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "うわっ、酒くさ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "ボスったらどこで遊んでたんですか？　俺たち抜きで飲んできたんですね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "text": "それより見てくださいよ、これ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "弱った兵士",
      "text": "この駄獣ブラインドボックスってやつ、本当にメチャクチャなんですよ！　シークレット以外のやつが、もう三セットずつ揃っちゃったんです！　もしかして、カランド貿易がインチキしてるんじゃ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は部屋の奥へと向かうと、リモコンを手に取り、プロジェクターを操作して次々に資料を映し出す。\nその一つ一つがイェラグに関する情報だ。想定しうる行軍ルートや軍事基地の位置、歩哨所の分布図やチェゲッタ関連の調査資料――\nこうした情報のすべては、彼がイェラグに到着して一週間のうちにまとめられ、目の前に置かれていたが、彼は繰り返しこれを忘れようと努めてきた。\nだがその結果、かえって内容をほとんど覚えてしまっていた。\n彼はリモコンを放り投げ、手近な寝椅子をつかむと、それを広げて身を沈め、目を閉じた。\nハロルドは、地図や砂盤を見るよりも、木の枝に積もった雪が落ちる音を聞くほうが好きだった。それは麦穂の波打つ音を思い出させてくれるのだ。\nサアア、サアア――"
    },
    {
      "type": "dialogue",
      "speakerName": "ずる賢い兵士",
      "text": "ボス？　どうかしたんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "text": "ほっとけよ、どうせ酔っ払ってるだけだって。そんなことより話の続きだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "老練の兵士",
      "text": "聞いた話じゃ、リターニアに対外貿易メインの新都市ができるらしいぞ。ほら見ろ、この優遇政策。とんでもねえ儲けが出るだろ……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "だが、現実は常に期待に反するものだ。\n麦畑を離れ、家へ戻って訓練を続けろと父からいつも厳しく命じられていたように。\nパイプの持ち手がいつの間にか欠けてしまっていたように。\n彼の失った足が二度と戻りはしないように。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "……はぁ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "周囲ではしゃぐ声が次第に小さくなっていき、彼の兵士たちが一斉にハロルドのほうへと視線を向けた。\n――そう、彼の兵士たちが。"
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "全員、実弾を装填し、待機せよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "明日未明に行動を開始する。目標は――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ハロルド",
      "text": "イェラガンド像。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "その声は少しかすれていた。\n波打つ麦穂の立てる音はもう止んでいた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
