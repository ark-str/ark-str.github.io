    {
      "type": "dialogue",
      "speakerName": "見捨てられた負傷兵",
      "speakerId": "avg_npc_423_1",
      "isRemote": false,
      "text": "しかし、もうロンディニウムへの攻撃が始まったんだぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "モラン",
      "speakerId": "avg_npc_728_1",
      "isRemote": false,
      "text": "……彼女を信じましょう。"
