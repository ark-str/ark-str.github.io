    {
      "type": "dialogue",
      "speakerName": "見捨てられた負傷兵",
      "speakerId": "avg_npc_423_1",
      "isRemote": false,
      "text": "私だって信じたいさ。だが、巫術と大砲の音が聞こえるだろう！　リーダー一人では――"
