  "blocks": [
    {
      "type": "narration",
      "text": "第六关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "グラニ、もう行っちゃうの？　スカジさんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "うん、そろそろロドスに戻らないと。でもまた会いに来るよ。スカジは一人がいいって言って先に行っちゃった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "スカジの破壊伝説が広まったから、賞金稼ぎはもうこの村に来ることはないと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "えへへ、そうだね。村の設備や生産が生き返るにはまだ時間がかかりそうだけど……新しい生活がスタートできそう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "どうか気をつけてね。次は収穫の季節に遊びに来て！　バッチリおもてなしするから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "へへ、じゃあ約束だね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "そうだ、さっき郵便が届いたの。滴水村宛になっているけど受取人はグラニって書いてある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "あ、これはロドスの封筒だね。連絡所に入った通信を転記したものだと思う。ここじゃ通信も届かないからね。迷惑かけてごめんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "えーっと、内容は……。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "「グラニへ。スカジが我々に無断で滴水村へ向かった。ロドスから正式な任務は受けていない。出会ったら気をつけるように。\n全てうまくいくように、祈っている。ニアール」"
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "やっぱりね…。そんなことだろうと思ったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "キャロル",
      "text": "グラニ、何してるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "紙飛行機だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グラニ",
      "text": "ロドスの紙は紙質がいいから、遠くまでよく飛ぶんだ――――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
