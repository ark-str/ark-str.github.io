{
  "server": "jp",
  "storyId": "act3d0_level_act3d0_ex03_end",
  "groupId": "act3d0",
  "stageId": "a003_ex03",
  "title": "MCタイム",
  "storyCode": "OF-EX3",
  "avgTag": "戦闘後",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act3d0/level_act3d0_ex03_end.txt",
  "sourceHash": "04be0e35690ff2e119fde49c499bced7bb8c6d14ae466cba2a92bc2de3dc77d9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "text": "いま地面が揺れなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "そりゃそうさ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "そりゃ、ステージからこんなに近いんだぜ！　見てみろよ！？　アレだよ、D.D.D.のあの表情！！　あれはいったいどうやってるんだ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "text": "えっもう引っ込んだじゃない、いつまでもそんなに……待って、また地震？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "うわっ、ウーファーが響いてるのかな……いや待て。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "text": "わっ……わわっ？　あなたも感じた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "……行くぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "text": "な、何よ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "いいから付いてこい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観客",
      "text": "押すな！　離れろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観客",
      "text": "足を踏んでる！！　どけっ！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観客",
      "text": "人が倒れてるぞ！　気をつけろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "text": "ど、どうして急に騒々しくなったの、もしかして……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "……マジかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "……エンペラーだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "へぇー、悪くねぇ天気だ。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "（歓声）"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "エンペラー！　本物だ！！　うわあああああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "text": "何ボーッとしてんだよ！　こんなときにまだ地震なんか気にしてんのか！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "text": "ちが……ただ、本物のエンペラーを見て、待って、少し、興奮して息が……。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "エンペラーさん、こちらへ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "観客の皆様！　どうかお下がりください！　線の内側までお下がりください！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "おい、そこのサヴラの若者。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "大丈夫さ、近づけていい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "ですがエンペラーさん、この後ステージもありますし、万が一のことがあれば……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "万が一？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "銃撃に刺殺、拉致、自殺脅迫、万が一ってそんなところか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "そんなもんで何を止めるつもりだ？　俺をか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "いいや、そんなもんは俺のパフォーマンスの一部になるだけさ。言葉の意味がメロディーでかき消されるみたいにな。わかるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "わ、わかりません……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "簡単に言えば演出の一つってことさ。安心しな。どうなってもMSRはお前たちに責任を問うたりしないさ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "（歓声）"
    },
    {
      "type": "dialogue",
      "speakerName": "観客",
      "text": "エンペラー！！　エンペラー！！　エンペラー！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "よーし、来たな。さあ早く、緊張するな、リラックス、大胆に、自分を信じて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "何が西クルビアが誇るラップの神だ。お、お前はただのチンピラだろう、運が良かっただけの……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "大きな声で、カモン、もっと大きな声で！　おい、サヴラの君、そいつにマイクを渡しな。追い払わなくていい。慌てるな、俺の言う通りにすればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "俺たちの生活をめちゃくちゃにしといて、お前は大成功してふんぞり返りやがって、し……死ね！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "text": "ぎゃああ――ボウガンだ！　早く逃げて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "俺は悪くねぇ、そうだ、全部お前が悪いんだ。お前の作った「ラップ帝国」のせいでどれだけの歌手が犠牲になったと思ってやがる――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "何がエンペラーだ、クソ食らえだ、卑怯者のペンギン風情が！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "フハハハ、卑怯者か。コイツはいい。卑怯な手段を使っているのは一体誰かな？　メディア買収に世論操作、誹謗中傷、そして最後は射殺か、なぁ、ブラザー？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "アンダーグラウンドのゴミ溜めに沈めば、お前が誰かわからなくなるとでも思ったか？　あんな若者たちを手にかけて満足かな、「歌手」さん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "テメェ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "もし俺がお前たちを見過ごしてたら、きっと気に入らない新星たちをどんどん「排除」していってたんだろうな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "それで集まった金をぜーんぶ自分たちの取り分にして、クルビアの全部を踏み台にするんだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "黙れ！　死ね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "エンペラーさんを守れ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "しまった！　エンペラーさんに命中したのか、早く……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "撃ったのは……エンペラーさん？　あいつのボウガンを撃ち抜いたのか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ダダダダダ、ダン！　パーン！　なーんてな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "変だなぁ。アレだけ饒舌にペラペラ喋っておいて、どうして俺の銃口が煙を上げてるんだ？　なあ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "お前が腰抜けだからか、それとも俺が眩しすぎて上手く狙えなかったか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "グッ――うっ――銃を持ち歩いてんのか……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "もし一日に何回も死ぬ経験をすれば、武器を持ち歩く習慣だって身につくもんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "text": "ぐっ――まさか俺一人だけだとでも思ってんのか？　これまでどれだけ敵を作ってきたか数えてみるがいい！　シエスタを生きて出られると思うなよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "俺の過去はあんな虚構の海洋よりもずっと深くて広いんだ。お前の言う敵なんて、どこに沈んでるかわかんねぇなぁ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "大変です。エンペラーさん！　観客の中にヤツの仲間が大量に紛れているようです。こちらでは処理しきれません……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "ああ、分かってるよ。まぁ慌てるな。君たちは現場の秩序を守ってくれればいい。後始末はその道のプロに任せておけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "例えば俺の、ペンギン急便なんかにな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "……なんや休暇に来たんとちゃうん？　あんなー、念の為聞いときたいんやけど、超過勤務手当っちゅーのは出るん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "ホテルであれだけ休んだんだ。確かに少し体を動かしたほうが良さそうだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "テキサ……「ソラ」はホテルでずっと本を読んでたからね……。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "……そうだった。そういう約束だったな。戦闘中も間違えないようにな。問題ないか、テキサス？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "大丈夫！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "ヘイ！　ボス、こっちが片付いたら、明日の最前列のチケットをよろしくぅ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "エンペラーさん、こ、この人たちはいったい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "私たちのことはボス…エンペラーさんの護衛だとでも思ってくれればいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "text": "まぁウチら、タダの物流会社なんやけどなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "text": "あたしたちの業務範囲って、もともと幅広いでしょ。こないだなんかジャズ・バーを買収してたし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "シラクーザの犯罪組織もちょいちょい懲らしめていたもんね。最近は不思議なくらい大人しかったけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "俺たちに挑むのはいいが、いつも龍門でどれだけ喧嘩をしてきてると思ってるんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "喧嘩にかけちゃ俺たちはプロフェッショナルだ、それも最高ランクのな。だーれも相手にならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する観客",
      "text": "この瞬間を待ってたぜ！　西のペンギン！　堂々と姿を現すとはいい度胸だ、死ぬ準備は出来てんだろうな！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "……自分たちのやってきたことを棚に上げて、よくも威勢のいいことだ……。まぁいい、敵がいくら増えても俺の描いていたシナリオと大して変わらない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "text": "テキサス、やれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "text": "了解――あっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "text": "――了解！　いっくよー！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
