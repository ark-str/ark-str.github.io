  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act3d0/level_act3d0_ex03_end.txt",
  "sourceHash": "04be0e35690ff2e119fde49c499bced7bb8c6d14ae466cba2a92bc2de3dc77d9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "speakerToken": "avg_npc_022",
      "operatorId": null,
      "portraitKey": null,
      "text": "いま地面が揺れなかった？"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "そりゃそうさ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "そりゃ、ステージからこんなに近いんだぜ！　見てみろよ！？　アレだよ、D.D.D.のあの表情！！　あれはいったいどうやってるんだ！？"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "speakerToken": "avg_npc_022",
      "operatorId": null,
      "portraitKey": null,
      "text": "えっもう引っ込んだじゃない、いつまでもそんなに……待って、また地震？"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "うわっ、ウーファーが響いてるのかな……いや待て。"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "speakerToken": "avg_npc_022",
      "operatorId": null,
      "portraitKey": null,
      "text": "わっ……わわっ？　あなたも感じた？"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "……行くぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "speakerToken": "avg_npc_022",
      "operatorId": null,
      "portraitKey": null,
      "text": "な、何よ？"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "いいから付いてこい！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "観客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "押すな！　離れろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "観客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "足を踏んでる！！　どけっ！！"
    },
    {
      "type": "dialogue",
      "speakerName": "観客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "人が倒れてるぞ！　気をつけろ！"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "speakerToken": "avg_npc_022",
      "operatorId": null,
      "portraitKey": null,
      "text": "ど、どうして急に騒々しくなったの、もしかして……。"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "……マジかよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "……エンペラーだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "へぇー、悪くねぇ天気だ。"
    },
    {
      "type": "narration",
      "text": "（歓声）"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "エンペラー！　本物だ！！　うわあああああ！"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "speakerToken": "avg_npc_022",
      "operatorId": null,
      "portraitKey": null,
      "text": "……。"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の男性",
      "speakerToken": "avg_npc_021",
      "operatorId": null,
      "portraitKey": null,
      "text": "何ボーッとしてんだよ！　こんなときにまだ地震なんか気にしてんのか！？"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "speakerToken": "avg_npc_022",
      "operatorId": null,
      "portraitKey": null,
      "text": "ちが……ただ、本物のエンペラーを見て、待って、少し、興奮して息が……。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "エンペラーさん、こちらへ。"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "観客の皆様！　どうかお下がりください！　線の内側までお下がりください！"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "おい、そこのサヴラの若者。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "大丈夫さ、近づけていい。"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "ですがエンペラーさん、この後ステージもありますし、万が一のことがあれば……。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "万が一？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "銃撃に刺殺、拉致、自殺脅迫、万が一ってそんなところか？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "そんなもんで何を止めるつもりだ？　俺をか？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "いいや、そんなもんは俺のパフォーマンスの一部になるだけさ。言葉の意味がメロディーでかき消されるみたいにな。わかるか？"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "わ、わかりません……。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "簡単に言えば演出の一つってことさ。安心しな。どうなってもMSRはお前たちに責任を問うたりしないさ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "（歓声）"
    },
    {
      "type": "dialogue",
      "speakerName": "観客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "エンペラー！！　エンペラー！！　エンペラー！！"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "……。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "よーし、来たな。さあ早く、緊張するな、リラックス、大胆に、自分を信じて。"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "何が西クルビアが誇るラップの神だ。お、お前はただのチンピラだろう、運が良かっただけの……。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "大きな声で、カモン、もっと大きな声で！　おい、サヴラの君、そいつにマイクを渡しな。追い払わなくていい。慌てるな、俺の言う通りにすればいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "俺たちの生活をめちゃくちゃにしといて、お前は大成功してふんぞり返りやがって、し……死ね！！"
    },
    {
      "type": "dialogue",
      "speakerName": "観光客の女性",
      "speakerToken": "avg_npc_022",
      "operatorId": null,
      "portraitKey": null,
      "text": "ぎゃああ――ボウガンだ！　早く逃げて！"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "俺は悪くねぇ、そうだ、全部お前が悪いんだ。お前の作った「ラップ帝国」のせいでどれだけの歌手が犠牲になったと思ってやがる――"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "何がエンペラーだ、クソ食らえだ、卑怯者のペンギン風情が！"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "フハハハ、卑怯者か。コイツはいい。卑怯な手段を使っているのは一体誰かな？　メディア買収に世論操作、誹謗中傷、そして最後は射殺か、なぁ、ブラザー？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "アンダーグラウンドのゴミ溜めに沈めば、お前が誰かわからなくなるとでも思ったか？　あんな若者たちを手にかけて満足かな、「歌手」さん？"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "テメェ――！"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "もし俺がお前たちを見過ごしてたら、きっと気に入らない新星たちをどんどん「排除」していってたんだろうな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "それで集まった金をぜーんぶ自分たちの取り分にして、クルビアの全部を踏み台にするんだろう？"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "黙れ！　死ね！"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "エンペラーさんを守れ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "しまった！　エンペラーさんに命中したのか、早く……え？"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "撃ったのは……エンペラーさん？　あいつのボウガンを撃ち抜いたのか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "ダダダダダ、ダン！　パーン！　なーんてな。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "変だなぁ。アレだけ饒舌にペラペラ喋っておいて、どうして俺の銃口が煙を上げてるんだ？　なあ？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "お前が腰抜けだからか、それとも俺が眩しすぎて上手く狙えなかったか？"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "グッ――うっ――銃を持ち歩いてんのか……。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "もし一日に何回も死ぬ経験をすれば、武器を持ち歩く習慣だって身につくもんさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "怪しげな表情の観光客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "ぐっ――まさか俺一人だけだとでも思ってんのか？　これまでどれだけ敵を作ってきたか数えてみるがいい！　シエスタを生きて出られると思うなよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "俺の過去はあんな虚構の海洋よりもずっと深くて広いんだ。お前の言う敵なんて、どこに沈んでるかわかんねぇなぁ？"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "大変です。エンペラーさん！　観客の中にヤツの仲間が大量に紛れているようです。こちらでは処理しきれません……。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "ああ、分かってるよ。まぁ慌てるな。君たちは現場の秩序を守ってくれればいい。後始末はその道のプロに任せておけ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "例えば俺の、ペンギン急便なんかにな。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerToken": "char_201_moeshd",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "……なんや休暇に来たんとちゃうん？　あんなー、念の為聞いときたいんやけど、超過勤務手当っちゅーのは出るん？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "ホテルであれだけ休んだんだ。確かに少し体を動かしたほうが良さそうだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerToken": "char_101_sora_1",
      "operatorId": "char_101_sora",
      "portraitKey": "char_101_sora",
      "text": "テキサ……「ソラ」はホテルでずっと本を読んでたからね……。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "……そうだった。そういう約束だったな。戦闘中も間違えないようにな。問題ないか、テキサス？"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerToken": "char_101_sora_1",
      "operatorId": "char_101_sora",
      "portraitKey": "char_101_sora",
      "text": "大丈夫！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "ヘイ！　ボス、こっちが片付いたら、明日の最前列のチケットをよろしくぅ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "speakerToken": "avg_npc_020",
      "operatorId": null,
      "portraitKey": null,
      "text": "エンペラーさん、こ、この人たちはいったい？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "私たちのことはボス…エンペラーさんの護衛だとでも思ってくれればいい。"
    },
    {
      "type": "dialogue",
      "speakerName": "クロワッサン",
      "speakerToken": "char_201_moeshd",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "まぁウチら、タダの物流会社なんやけどなぁ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "あたしたちの業務範囲って、もともと幅広いでしょ。こないだなんかジャズ・バーを買収してたし。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerToken": "char_101_sora_1",
      "operatorId": "char_101_sora",
      "portraitKey": "char_101_sora",
      "text": "シラクーザの犯罪組織もちょいちょい懲らしめていたもんね。最近は不思議なくらい大人しかったけど。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "俺たちに挑むのはいいが、いつも龍門でどれだけ喧嘩をしてきてると思ってるんだ？"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "喧嘩にかけちゃ俺たちはプロフェッショナルだ、それも最高ランクのな。だーれも相手にならない。"
    },
    {
      "type": "dialogue",
      "speakerName": "興奮する観客",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "この瞬間を待ってたぜ！　西のペンギン！　堂々と姿を現すとはいい度胸だ、死ぬ準備は出来てんだろうな！"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "……自分たちのやってきたことを棚に上げて、よくも威勢のいいことだ……。まぁいい、敵がいくら増えても俺の描いていたシナリオと大して変わらない。"
    },
    {
      "type": "dialogue",
      "speakerName": "エンペラー",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "テキサス、やれ。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "了解――あっ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ソラ",
      "speakerToken": "char_101_sora_1",
      "operatorId": "char_101_sora",
      "portraitKey": "char_101_sora",
      "text": "――了解！　いっくよー！"
    },
    {
      "type": "sceneBreak"
    }
  ],
