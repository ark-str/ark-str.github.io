        {
          "type": "dialogue",
          "speakerName": "クロヴィシア",
          "speakerToken": "avg_npc_401_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "私のよりも……うむ、温かいな。"
        },
        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "speakerToken": "avg_npc_398_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "み、見ろ！　聴罪師の衛兵の背後に突然現れたのは誰だ？"
