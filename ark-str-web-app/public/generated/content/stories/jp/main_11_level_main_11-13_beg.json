  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_11-13_beg.txt",
  "sourceHash": "df448cd5d9482d2751a58470d35db39b538b730b45d8faf43dec033ac277f715",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "speakerToken": "avg_npc_419_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "キリがねぇクソの反乱軍が！　サディアン区からここまでよくもぬけぬけと！"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "speakerToken": "avg_npc_419_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "お前らの、あのでかくて強力な鉄の塊を出せ！"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵士",
      "speakerToken": "avg_npc_241",
      "operatorId": null,
      "portraitKey": null,
      "text": "自走砲のことを言ってるのか？　サルカズ、まだ多くの兵士が前方にいるんだぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "speakerToken": "avg_npc_419_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "そいつらには合図を送ればいいだろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィクトリア兵士",
      "speakerToken": "avg_npc_241",
      "operatorId": null,
      "portraitKey": null,
      "text": "自走砲の攻撃範囲は広すぎる、今から撤退しても間に合わない！"
    },
    {
      "type": "dialogue",
      "speakerName": "サルカズ戦士",
      "speakerToken": "avg_npc_419_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "逃げられねぇのは、そいつら自身の責任だ。俺たちの戦士は皆戦場で生き延びる方法を知っている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "speakerToken": "avg_npc_411_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "あっちのは――可動式の源石砲だよ！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "speakerToken": "avg_npc_411_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "な……何なのこれ、普通の砲弾じゃないよ！"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "speakerToken": "avg_npc_411_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "カズデルには、あたしが聞いたことない高等研究所でもあるわけ？"
    },
    {
      "type": "dialogue",
      "speakerName": "クロージャ",
      "speakerToken": "avg_npc_411_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "こんな短時間で……マンフレッドはどうやってあんなもの手に入れたの？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ドローンはコントロールエリアを見つけたか？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "集中するんだ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "コントロールエリア……まずいよドクター、あたしのドローンがこの砲弾についてるアーツの干渉を受けてる。"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "言ったでしょ、ロンディニウムのシステムは処理できるけど、サルカズの巫術をどうにかするのは難しいんだってば！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "？？？",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター、俺たちに任せてくれ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "わっ、フェイスト！"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "あんたに言われた通り、準備できたぜ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ドローンが妨害されないよう、俺たちエンジニア小隊が何とかしてやる。"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "何かアイディアあるの？"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "クロージャさん、この自走式源石砲は俺たちの工場で組み立てられたんだよ。"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "なら……まさかこの場で分解するとかじゃないよね？"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ハハ、もし俺たちエンジニア小隊がみんなブラッドブルードなら、試してみても良かったかもね。"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "だけど残念ながらさ、俺たちのほとんどがごくごく平凡な職人にすぎねぇんだわ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "自分の手で作り上げたこいつらのことをよーく知ってるってだけ。"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "頼りになる戦友たちのために、チャンスを作れるように、どうやってあいつらの弱点に狙いを定めればいいか知ってんの。"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "結局、俺たちエンジニアが戦場で一番役に立てんのって、こういうところじゃん？"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "そのジップライン……あれの背中に乗るつもりなの？"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "あれの砲口を制御できさえすれば、ドローンは正常に作動するんだよな。合ってる？"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#12$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "理論上はそうだけど、危険すぎるよ……"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "これは俺たちの共同作戦なんだぜ、クロージャさん。"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "あんたとドクターで、俺たちが一番安全な落下点に狙いを定めてくれよ。頼んだ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "砲火の音が鳴る中、フェイストが目の前の戦場を見つめている。\n彼の視線の先にあるのは、凶悪なサルカズなどではなく、かつて最も馴染み深い生産ラインのそばにあった機械だった。大型の機械が移動する音は、彼にとって一番親しみのあるリズムと同じだ。\n彼は、己のやり方で、必ず彼らの都市を取り返す。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ふぅ……この戦場の空の風景をずっと見てみたかったんだ。すげーいい機会だよ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "巨大な機械がゆっくりと道を走行している。\nそれのボディと比べると、戦場にいる人々は、ヴィクトリア人であれサルカズであれ、あまりにちっぽけだった。\nそれの歩みを止められる者はおらず、それの視線はやすやすと道を熔かす。\nそれはまるでこの鋼鉄のジャングルの主であるかのようだった。\nしかし、それは突然悲鳴を発した。\n高くから大地を睥睨していた視界の死角から、十数本のフックが飛んできて、それの最ももろい首の部分にがっちりとはめ込まれた。\n続いて、数十人の小さな人影がジップラインを伝い、それの背中に飛び乗った。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "フェイスト",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター、制御したぜ！"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "狙撃手、付近の敵を片づけるんだ！",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "ヴィクトリア傭兵",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "了解！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クロヴィシア",
          "speakerToken": "avg_npc_401_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "術師たち、攻撃だ！"
        },
        {
          "type": "dialogue",
          "speakerName": "ロックロック",
          "speakerToken": "avg_4040_rockr_1#10$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "はい！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "おやおや、バンシー。ひとしずくの血ですら、あなたはその身に寄せ付けないのですね。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "うぬが操る血液の一滴一滴に、巫術が宿っておろう。"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "フフッ……バンシーの呪術ですか。"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "一体いつから、バンシーはあなたのような、頭の固いつまらない人になったのですか？"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "古のバンシーたちが、どのように夜を纏って滑空し、骨笛を吹いていたかを、私は覚えていますよ――"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "物悲しくも鋭い音色で荒野をさまよう旅人を悼み、同時に漆黒の骨爪を容赦なく、その哀れな者たちの後頭部に突き刺す。"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "まさしくバンシー、あれこそがバンシーなのです。"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "あれらは、ブラッドブルードが他の何よりも賞賛するハンターなのですよ。我々は戦場で肩を並べて、恐怖を武器とし、弱小な敵の命を収穫するのです。"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "けれども、今のバンシーたちは歩むべき道を見失っています。あなた方は、本来の自分をリターニアの術師と似たような服装の中に押し込め、年寄り臭く、格好ばかりを気にしている。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ブラッドブルード、真に迷っておるのはうぬの方であろう。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "歳月は抵抗を許さず大地の全てを押し流し、そこにある命を形作っておる。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "何故、顎を引いてうぬ自身を見ぬのだ？　うぬこそ初めの姿を失って久しかろうに。"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "フッ……皮袋一枚ごときを気にする必要がどこにあるのです？"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "その皮袋こそ、我の法服と同様、我らが今この時、大地を歩んでいく真実の姿であろう。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "古の王庭の根はとうの昔に朽ち果てたのだ。今日の王庭には、ただ樹冠があるのみ。にもかかわらず、いまだ地に落ちようとはせぬ。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "まっこと、荒唐無稽であるよ……死した物が未だにやせこけた土地から養分を吸い取り、あらゆる新生の可能性を奪い取っておるとはな。"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "それこそあなたの真の目的ですか？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "ブラッドブルードの顔から笑みが消えた。彼のそばでは、沸騰した血が一瞬静まった。\nかすかな震動が地上から伝わり、上層の地面も揺れ始める。\n血。血が行軍しているのだ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "アーミヤ",
          "speakerToken": "avg_npc_394_1#12$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "オペレーターのみなさん、防御してください！"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "speakerToken": "avg_npc_404_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "……"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "speakerToken": "avg_npc_404_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "下の戦場……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "マンフレッドはふと、自分がこの場にとどまり過ぎていることに気付いた。都市防衛軍司令塔の弱点はレトだけではない。\n彼とブラッドブルードの注意が目の前の「魔王」と、昔馴染みに吸い寄せられている間、ロドスと自救軍の者は別のルートから、彼らが求める情報に近付いている可能性がある。\nこれこそロドスの計画なのだ。司令塔の上でマンフレッドとブラッドブルードを即座に倒せる確信など彼らにはない。ただ時間稼ぎをしたいだけなのだ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "speakerToken": "avg_npc_404_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "すぐに……"
        },
        {
          "type": "dialogue",
          "speakerName": "アスカロン",
          "speakerToken": "avg_npc_395_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "遅い。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "マンフレッド",
          "speakerToken": "avg_npc_404_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "……"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "そう、もう遅いのだ。たとえアスカロンの執拗な攻撃が相手であっても、彼は片腕で逃れることができる。しかし彼を本当に遮っていたのは目の前の血の海だった。\nブラッドブルードはすでに激高していた。その場にいた全員がこの戦場に拘束されたのだった。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "……バンシー。"
        },
        {
          "type": "dialogue",
          "speakerName": "ブラッドブルードの大君",
          "speakerToken": "avg_npc_410_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "あなたは王庭を……サルカズの伝承そのものを、滅ぼそうというのですか？"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "天地を覆い尽くすほどの血の潮が、司令塔を包み込んだ。ロドスのオペレーターたち、そして都市防衛軍の兵士たち、何もかもが、赤に吞まれようというその時――\n――見えない力によって、深紅の帳は引き裂かれた。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "滅ぼすためではない。ただ自救のために。"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "これ以上、長々しい記憶に囚われるでない。過去の傲慢から抜け出してくるがよい、サルカズの古の王よ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Logos",
          "speakerToken": "avg_npc_650_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "サルカズは既に変わったのだ。変わらねばならぬのだ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "骨筆のもと、金色の呪文がひとりでに書かれていく。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "溺れるほどの血が、主の怒りに呼応して哮りを上げた。地面から、壁から、頭上から、大胆に躍りかかっていくが、若きバンシーと彼が背後に守る者に近付くことはできなかった。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "それは呪術の王がすでに異国の塔の上でルールを定めたがゆえ。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター、司令塔が……"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "熾烈な戦闘が行われている。",
          "value": "1",
          "blocks": []
        },
        {
          "label": "アーミヤとLogos、それにアスカロンを信じている。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ふぅ……三人が本当にあの恐ろしい奴を抑えてくれてるんだ……"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター、ドローンがコントロールエリアに到達したよ。"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "これからハッキングを始めるね……"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "所用時間の見込みはどれくらいだ？",
          "value": "1",
          "blocks": []
        },
        {
          "label": "どれだけの時間が必要か教えてくれ。",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "三十分……いや、二十分でいい。"
        },
        {
          "type": "dialogue",
          "speakerName": "クロージャ",
          "speakerToken": "avg_npc_411_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "ドクター、アーミヤちゃんたち、それから自救軍のみんなが今も大変な思いをしてるのはわかってる……あたしを信じて。もうっ、あたしにもっと手が生えてればいいのに！"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "巨大な機械が再び唸り声を上げた。\n静止していた砲口が再度回転し始める。"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "クロヴィシア",
          "speakerToken": "avg_npc_401_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "何事だ？"
