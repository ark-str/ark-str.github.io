          "type": "dialogue",
          "speakerName": "クロヴィシア",
          "speakerToken": "avg_npc_401_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "フェイストと戦士たちを自走砲から引き揚げさせろ。"
