        {
          "type": "dialogue",
          "speakerName": "自救軍戦士",
          "speakerToken": "avg_npc_398_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "白い角に、黒いローブ、あれも……聴罪師か？"
