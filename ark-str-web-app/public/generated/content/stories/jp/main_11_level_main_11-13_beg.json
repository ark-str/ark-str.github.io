        {
          "type": "dialogue",
          "speakerName": "クロヴィシア",
          "speakerToken": "avg_npc_401_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "巫術によって急速に消耗される命を救うには、治療アーツでは間に合わない。"
