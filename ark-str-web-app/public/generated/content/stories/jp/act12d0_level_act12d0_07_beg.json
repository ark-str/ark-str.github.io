{
  "server": "jp",
  "storyId": "act12d0_level_act12d0_07_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_07",
  "title": "先客",
  "storyCode": "RI-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act12d0/level_act12d0_07_beg.txt",
  "sourceHash": "429f0bde11a270b8acb6c2fb946b06ec603f6a01674ecf7cf31c1a470795826e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "のわああああ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "ありゃりゃ、また失敗か。しかし今回はいい角度に飛んでったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "どこまで吹っ飛ばされたんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "さぁな。まあどうせすぐ戻ってくるだろ。こっちはこっちで続けようぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "さてと、このパイプはどこにつなげば――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "おっ、こんなところに丁度いい挿し口があるな、それ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "おーい、これでどうだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "全然ダメだ。お前本当にできるのかよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "うるせぇ！　こんなエンジン見たことねぇんだ、もっと試させろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "オレがやってやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "オレが見るに、このパイプはここに挿すべきなんだ。それで……このボタンはなんだ？　まあとりあえずポチっとこうぜ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "おめぇこそ適当にやってるだけじゃねぇか！　これはそこじゃなくてこっちに挿すべきなんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "このアホ共、いつまでやってんの。というか、オイルパイプすら挿してないの？　もうどいて、アタシがやるから！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "えっーと、オイルパイプってどこに挿すんだっけ……うーん、考えても無駄か。このデカイ挿し口に決まり！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "ねえ、誰か起動してみて！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "帰ったぞーい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "まったく今の若者は年寄りを敬うことを知らん。誰一人として吹き飛ばされたわしを探しに来んとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "だって大祭司様は、どんなに飛ばされてもピンピンして帰ってくるだろ。みんなもう慣れちまったんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "ほらほら、無駄口叩いてないで起動すんぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "わかったわかった。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ビッグ・アグリー",
      "text": "――――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ビッグ・アグリー、愛しの我が子よ、そろそろ起きる時間じゃぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "おお！　大族長、やっと動いたぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "なんて綺麗なエンジン音なんだ！　こんなに素晴らしい音は初めて聞いたぜ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "ふふーん、やっぱりアタシのおかげね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "お前たち、一体どうやったんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "見ての通りだ大族長！　あれで試してみたら動いたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "このパイプをここに、あのパイプをあそこに挿してみたんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "ええ、ビッグ・アグリーを作り出したときのように！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "よくやった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "ああ、ただのガラクタだったビッグ・アグリーが、こんなにも立派になるとは……高らかに歌いたくなってくるわい！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "あの下手くそな歌をか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "なんじゃと！？　歌の才能はあるつもりだったんじゃが……残念無念じゃ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "いや、もしかしたら、歌い方の問題かもしれん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "大祭司",
      "text": "うむ、そうだ、きっとそうに違いない。次はベルカントで歌ってみるぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "大族長、誰かが突っ込んできたわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "ガヴィルか？　ならば私が……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人",
      "text": "違うわ！　武器をいっぱい持った変なヤツよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ユーネクテス",
      "text": "なんだって？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ズゥママの部族はこの先のはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "あいつ、自分たちの住処をこんな風に改造してんのかよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "すごいじゃない！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "あれ、なんだか中が騒がしいですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "ん？　なんでもう喧嘩になってんだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ケオベ",
      "text": "レユニオンめ、おいらの名前を奪おうとするなんて許さないぞ！　はちみつクッキーより大事なものなんだぞ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人A",
      "text": "ぐあああああ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人B",
      "text": "どっから湧いて出たんだこの変なヤツ！　しかも強ぇ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アダクリス人C",
      "text": "言葉はわかるけど……「レユニオン」っていったい何のことを言ってるのよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ウタゲ",
      "text": "あれっ、この声……ケーちゃんじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "トミミ",
      "text": "ですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ブレイズ",
      "text": "この騒ぎ、もう相当暴れてるみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ガヴィル",
      "text": "とにかく、まずはあいつを大人しくさせるぞ！",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "ケーちゃん、もうやめるんだ！",
          "value": "1",
          "blocks": []
        },
        {
          "label": "……",
          "value": "2",
          "blocks": []
        },
        {
          "label": "ケーちゃん、頑張れ！",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
