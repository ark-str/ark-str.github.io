{
  "server": "jp",
  "storyId": "story_whitw2_set_1_story_1",
  "groupId": "story_whitw2_set_1",
  "stageId": null,
  "title": "匂いの遊戯",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_whitw2_1_1.txt",
  "sourceHash": "e77e09e794f76ed4463f01195d2f9d983dc24a17880a1001aef8e96d4cbadff8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "バーゴ、あなたも来たのね……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "おぬしに嗅ぎ取れたものを、わしに嗅ぎ取れぬとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "私はただ、目的地はここで合っているようね、と言いたかっただけよ――探していたものは、この病室の中だわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ラップランドがどこかで失くした物を探すためだけに、狼の群れがこの陸上艦を隅々まで捜索することになるなんて……滑稽だとは思わない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "不平を言うな、カエサル。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "統率者は群れに対していかなる指示でも下せると決めたのはわしら自身だろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "だったら、早く終わらせましょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "あれは、おぬしの牙か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "……レッド。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "すぅ……すぅ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "う……うぅっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "ラップランドの匂いがするが……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "レッドが握り締めているナイフからだわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "探せと言われた失せ物が、おぬしの牙のナイフだと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "まったく、白い狼ときたら、統率者になっても結局は幼稚な人間でしかないわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ねぇ、ザーロ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "さっきの土ぼこりって、野生の駄獣がロドス本艦を避けようとして立てたものだよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "荒野は目の前に広がっているだろう、何を私に聞くことがある？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "そんなにイライラしないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "よくもそんなことを言えたものだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "――偶然航路を外れた陸上艦が、一時的に荒野の奥へ迷い込み、気の向くままに流離う謎の放浪者に遭遇した。そこに偶然、甲板の上にいたボクたちは、その放浪者の一人に挨拶する機会を得る……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミたちとそのお仲間のために、この新しくて特別な顔合わせを用意するのにボクがどれだけ労力をかけたかは知ってるでしょう？　今更急かさないでよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "このような面倒な真似をする必要はなかっただろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "奴らの動向を掴むだけなら、龍門やアカフラに直接赴いたほうがよほどいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ははっ、やっぱり狼たちはますます人間に似てきてるね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "もちろん、テキサスのとこのボスをアングラなラップバトル観戦に誘うことも、あのダック卿ってやつと会いに賭場へ行くこともできるよ？　シラクーザに居た頃には散々やってたようなことだし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "でも、ああいうやつらは獣主の中では少数派なんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "いわゆる「危機」っていうのがそこまで恐ろしいものなら、どうしてキミの取る最初の動きが、自分と同じように人間社会に入り浸る仲間を探して、人間みたく会議することになっちゃうわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "それよりほかの狼を呼び戻しなよ。もう少しすれば、キミたちのお仲間がここを通りかかるんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "だが、カエサルはまだお前の失くした物を……いや、まさかお前、何も失くしてなどいないのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "そうだよ、ザーロ。そんな物最初からないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "ならば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "もしや、カエサルと、奴に捨てられた牙をわざと鉢合わせたのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ハハッ、ボクは別に、そんなことしろとは言ってないけど？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、オバアサン見える……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "まだ眠っておるようだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "おぬしが近づいただけで、夢の中に居れど震えだすとは……この子供には、おぬしへの恐怖が骨の髄まで刻まれているらしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ふっ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "ここは、夢の中か……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "斯様に悪趣味な真似はよせ、カエサル。わしらはナイフを取りに来ただけであろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "でも、そのナイフは私がレッドに贈ったものなのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "あの子が物心ついたばかりの頃に、私が見つけた獣の牙を与えて、それを鋭いナイフに磨き上げる方法を教えたのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "どういう意味だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "まだわからないの？　ラップランドは意図して私をここへ来させたのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ナイフを回収しろだなんて、ただの口実。彼女は私に、この子の恐怖と苦痛を、そして私がこの子に与えた影響を消し去ってほしいのでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "そうか？　ラップランドらしくない話だが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "憐れな同僚を助けるためか、あるいは自分が身を置く製薬会社の機嫌を取るためかは知らないけれど……どうあれ、考えを推し量ることは難しくないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "だから言ったのよ。彼女は、統率者になっても結局は幼稚な人間でしかないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ここで待っていて、バーゴ。すぐにこの退屈な「仕事」を終わらせてくるわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "レッド。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン……本当に、オバアサン……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "他に誰がいるというの……本当に、かわいそうな子。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "チッ、またなの？　この船に来てからってもの、キミに付け回されるのはこれでもう五回目なんだけど。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "匂いがする……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエから、懐かしい、匂いがする。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "狼の匂いのことだったら、一匹分じゃ済まないと思うけど、どれのこと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン、ここに、いる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オマエ、オバアサンが見つけた、レッドの代わり？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "その言い方、ボクを殺したくて仕方がないって感じかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "煙に隠れるのが大好きなキミの上司さんや、ドクターから怒られないのなら、身体を動かすチャンスがあること自体は大歓迎なんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "いや……レッド、オマエとは、戦わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、説明の仕方、わからない……オバアサンが、オマエのところに現れたなら、オマエも、レッドと同じになる。最後には……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ははっ、心配してくれてありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "……レッド、キミ震えてるみたいだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン、レッドに、言った……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッドは、これまでレッドが殺した連中と、同じだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッドはただ――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アイツのために退屈な勝利を勝ち取っただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、オバアサンの言う通りにした。ケルシーの言う通りに、しなかった……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、間違った。何度も、何度も……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッドは、ウルフハンターで、真狼。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッドは、誰？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッドの心、ぐちゃぐちゃだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "う……うっ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "レッド、キミはあの狼を恨んでる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アイツのこと、忘れちゃいたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "大丈夫、怖がらなくていいんだよ。なんたってここは、キミのロドスなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ボクが手伝ってあげるよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "それでこのようなことをしたと？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "うん。ケルシーがいない今は、放っておくわけにいかないでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "ラップランド、お前は親切さを讃えられたいのか？　あるいは優しさを讃えられたいのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "じゃあ聞くけど、キミはボクに媚びてると思われたいの？　それとも皮肉を言ってると思われたいのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン、どこに行く？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "オバアサンはどこにも行かないわ。ここであなたが追い付いてくるのを待っているだけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "赤く幼き狼は思わず歩き出しかけたが、はたと気付いてその場から動かずにいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "何も疑うことなどないのよ。オバアサンにはもうあなたを騙す必要なんてないもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "あなたの疑問にも、苦しみにも、全部きちんと応えてあげるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ほら、こっちへおいで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "聞き慣れた声に優しい口調、草原を吹き抜けるそよ風が、土の生臭い匂いを運んでくる……ここはとても安全に思えた。\nまるで、何ひとつ変わっていないかのように。\nそうして、しばらくしてから……\n幼き狼は結局こらえきれずに、一歩二歩と歩き出した。"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "これは、夢？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "夢であり、現実でもあるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ついていらっしゃい、レッド。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "どうしてずっと黙っているの？　今までなら、再会するたび、あなたは上手く話せもしないのに、あれこれ聞いてきたじゃない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "そう。あなたは、オバアサンを恨んでいるのね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……オバアサン、レッドを騙した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、オバアサンを、信じていた。なのに――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "「なのに」だなんて、言うものじゃないわ。あなたと私の間には、そんな退屈な感情なんて存在しなかったはずよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "だって、あなたもオバアサンを騙したでしょう？　違う？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "カルネヴァーレの夜、あなたはアンニェーゼの牙にとどめを刺さなかったじゃない。あの子、名前はなんて言ったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "る、ルナカブ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "あなたは私を試そうとして、彼女をわざと見逃したんでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "確かに狼主は牙を折ることもあるけれど、母親は決して我が子を捨てたりなんてしないのよ。嘘でその子を包み込むことはあっても、荒野における命の絆は、純粋であるがゆえに強固なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "けれど、ロドスの人間も、あのサルトリアも……荒野をまるで理解していない。にもかかわらず、あなたは彼らの言葉を信じて、私たちの関係に亀裂を入れてしまったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "まあ、そんな真相も、ゲームの勝ち負けも、今となってはどうでもいいの……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "このすべては、オバアサンが受けるべき屈辱であり、あなたが受けるべき罰でもあるのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、ここ、覚えてる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "さっきも言ったように、ここは夢であり、現実でもあるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "この草むら……匂いを隠して、獲物を静かに待つこと、オバアサンが、教えてくれた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "この木……罠を作ること、落ち葉で隠すこと。オバアサンが、教えてくれた……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "あっち、あの石……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "あなたが、獣の牙を鋭いナイフになるまで磨いた石よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "今通り過ぎた林や洞窟、そして骸はどれも……あなたが通ってきた道ね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン、レッドを連れて、来た道、引き返してる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "どこで、止まる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "そのうちわかるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "私がさっき言ったことの意味を、まだ考えているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、考えないと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、心、ぐちゃぐちゃ。考えても、わからない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "長い歳月を経る中で、狼主たちのゲームは無数に繰り返されてきたけれど、正直なことを言えば、あなたは今も私にとって一番特別な牙なのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "数多の牙の中でも、真に狼の思考で物事を考えていたのはあなただけだった。この陸上艦に残ると決めた今も、あなたは本当の意味では人間の群れに溶け込むことはできていない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "あなたは純粋すぎるがゆえに、本物の狼に限りなく近い存在なの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "本物の、狼……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "だから、さっきオバアサンが言ったことは忘れてちょうだい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "何しろ、この感情は、あなたにとっては複雑すぎるし……それはあなたのせいではないんだもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "やっと着いたわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "こ、ここは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "あなたと出会った場所よ。私はあの草むらで、捨てられていたあなたを拾ったの。あれは嵐の夜だったから、あなたの泣き声は雨音にかき消されかけていたものよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ここが今回の終着点であり、すべての始まり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "オバアサンがこの草むらを焼き払ってあげるわ。そうすれば、これまで私たちが歩いてきたすべてが消えてなくなるでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、わからない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、オバアサンを忘れる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサンとのこと、全部忘れる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ええ。私がもたらした困惑、苦痛、苦しみをすべて忘れることになるわ。まるで私が最初から存在していなかったかのように……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……もう、悪夢、見ない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "そうよ。レッドは賢い子ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "沈黙が落ちる。\n赤く幼き狼はうつむいて、指が白くなるほど拳を握り締めると、黙り込んだまま苦しげな表情を見せた。\n優雅な狼主は急かすことなく、幼き狼に少しの時間を与えてやることにしたが……実のところ彼女の忍耐はすでに限界を迎えていた。\nそこへようやく、幼き狼が顔を上げた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……いやだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、忘れたくない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "レッド、キミはあの狼を恨んでる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アイツのこと、忘れちゃいたい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "大丈夫、怖がらなくていいんだよ。なんたってここは、キミのロドスなんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ボクが手伝ってあげるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "わからない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "へえ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ってことはつまり、忘れたくないんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、忘れたくない？　でも、どうすればいいか、教わってない……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミの直感はいつも正しいでしょ、レッド。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミの人生は、裏切りと嘘で形作られている。それは、忘れてしまいたいと願ってもおかしくないような苦痛だろうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけど、忘れても何の意味もない。だってそれは、肉と骨を引き剥がして自分を空っぽにしてしまうだけだから……そんなの、もっと残酷で暴力的なことでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミは荒野をよく理解しているんだから、悪夢だってキミが生きるための力になってくれるはずさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "う……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ハハッ、そうだ！　いいこと思いついた。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、忘れる必要、ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "オバアサン、レッドに、教えてくれた。レッド、覚えてる……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "恨み、覚える。仇から、目を離さない。そうすれば、レッド、迷わない。ナイフ、振るえる……生き続けられる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "レッド、今まで、オバアサンの仇、討ってた……存在しない仇を。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッド",
      "text": "でも、これからは、自分のために、仇討つ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "レッドは足に力を込め、高く跳躍した。それは、狼が狩りに用いる技法そのものだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "そしてレッドは目にも留まらぬ一撃で、狼主を真っ二つにした。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "謎めいた黒い霧が散り散りになり、噴き出す鮮血がレッドの身体を怪物の如く紅く染め上げる。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "それから、今自分が何をしたのかわからない、信じられないとでも言うかのように、レッドは手を激しく震わせて……そのまま彼女は気を失ってしまった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "だが、次の瞬間には、再び黒い霧が集まり、狼主はレッドの前に姿を現した。"
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "夢の中にいるから、私に歯向かう勇気を得られたというわけ？　でもそんなことをしたって無駄よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "どうしても忘れたくないのなら、私に関わるすべてと共に生きていきなさい。悪夢を重ねて、苦痛を絡ませ編み上げながら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "まあ、それもいいでしょう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "古いゲームはもう終わり。けれど私は、ラップランドがどれほど新しい楽しみをもたらしてくれるかなんて、ザーロたちほど期待していないのよね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "だから、あなたのことは一つの時代の痕跡として残しておきましょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "とは言っても、次の瞬間には、あなたのことなんて完全に忘れ去ってしまうのでしょうけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "何しろあなたは、実際のところ、私が折ってきた牙たちと何の違いもないのだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "バーゴ、出てきてちょうだい。もう行きましょう。ここの匂いと来たら、本当に不快だわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "妙だわ、この匂い……いいえ、そんなはずは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ラップランド、あなたの仕業なの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "バーゴ、聞いてた？　もしかしてボクの聞き間違いかな？　カエサルは統率者の力を疑ってるみたいなんだけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "どうして私の身体からレッドの匂いがするのよ！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "へえ、本当？　そんなことあるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "んー、さっき起きたことを思い出してみようか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "レッドがナイフでキミを傷つけて、キミの血がレッドのほうへ降り注いでたけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アッハハハ！　キミとその牙は、お互いの匂いが身体について離れなくなっちゃったのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "あり得ないわ！　これは私があの子に見せてやった夢でしかないのよ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あれ、燃やしてるの？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ハハッ、すごい雨まで降ってきたね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "焼いたり、雨に濡らしたりすれば、身体についた匂いを消せるとでも？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "無駄だよ、親愛なる狼主さん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "アンニェーゼが教えてくれたんだ。遥か昔、この大地に文明なんて存在せず、狼たちがそれぞれ別行動をしていた頃、キミたちは匂いを交換することで、相手を識別し、交流し、縄張りを示し合い……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "そして、時には協力して狩りを行い、また互いに殺し合ったけれど――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "命が尽きる瞬間まで、身体に染みついたほかの狼の匂いを消すことはできなかったと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "レッドのナイフは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あのナイフはボクの残したもの……「統率者の祝福」を受けたナイフだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "アンニェーゼ、余計な真似を……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンニェーゼ",
      "text": "言っておくが、これを聞かれたのは私だけではない。彼女の目的は知らなかったしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ああ、そういえば……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "狼主は不死不滅で、永遠に存在するんだったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "バーゴ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "ああ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "カエサル、どうやらキミは未来永劫、レッドの匂いをつけたままこの大地を進んでいくしかないみたいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミが一度としてその牙を直視したことすらなくとも、とっくにその子を見捨てていたとしても、その匂いは絶えずキミにその存在を思い出させる。永遠に忘れることはできないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "何しろ、キミは不死にして不滅だからね。しみついた匂いも、永久に付きまとうことになるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "ッ……！！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "（凄まじい遠吠え）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "もちろん、いつでもボクへの復讐を企ててもらって構わないよ。なんせそれは、かえってボクの新しいゲームにインスピレーションを与えてくれるだろうし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "なぜこんなことを？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "統率者ともあろう者が、同僚に対する情などという幼稚なもののためだけに、こんな陰謀を企てて自分の群れの狼を辱めたというの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "キミは、ボクがただレッドに同情したからってだけでこんなことをしたと思ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "あーあ、幼稚な狼主がいたものだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "カエサル、キミを辱めたのは何もレッドのためだけじゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ザーロも、バーゴも、アンニェーゼも、それからほかの連中も……今回のことは、キミたちに対する警告なんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "群狼は、どんどん人間に似てきている。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "狼主たち",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "確かに、荒野は果てしなく続いていて、野蛮で無秩序な場所だ。キミたちが人間や同類にどんなに残忍な真似をしても、それが荒野の在り方だし、ボクは別に構わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だけどカエサル、キミときたら、牙に向ける残忍さすら人間そっくりだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "欺いて、裏切って、飾り立て、認識を歪めて悪夢を植え付ける……そんなのは、浅はかにも表面的な権力を振りかざしているだけじゃない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "（匂いを確かめる）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "カエサル",
      "text": "（やるせないため息をつく）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "くだんの「危機」は目の前に迫っていると、キミたちは教えてくれたでしょう。となれば、群狼はもっと多くの同類と接触しないといけないんだ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "でも、サーミの雪原から、ボリバルの黒流樹海、サルゴンの黄砂、イベリアの塩海に至るまで……人間との関わりに慣れている獣主はごく少数しか存在しない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "だったら、ボクは彼らに証明しないといけないんだ。新しい群狼はより純粋な存在になるんだってことをね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "ラップランド。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ザーロ",
      "text": "彼らがやってくるぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "じゃあ、この夢から離れようか。レッドを穏やかに眠らせてあげないとね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "ボクたちは甲板に戻るとしよう……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ラップランド",
      "text": "荒野の約束を果たす時が来たんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
