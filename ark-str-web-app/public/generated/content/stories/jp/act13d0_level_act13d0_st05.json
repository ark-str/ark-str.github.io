  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act13d0/level_act13d0_st05.txt",
  "sourceHash": "2f6baf648172e43feaa2c5f041de1bf659a97043f9f4103f4a3ea0fa1c9d888e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "中秋 四月"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "ふぅ、今日の任務で汗ビショビショ～。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "早く宿舎に帰ってお風呂入ろっと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "んん？　あれは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "よし、手紙は確かに預かったよ。代金も問題ナシ、と。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ではよろしくお願いいたします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "ハハ、任せてよ。君もすっかり常連さんだね。そろそろ君の家族にも顔を覚えられてしまいそうなくらいさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "それにしても、しばらく故郷に帰ってないだろう？　一度帰ってみたらどうだい？　君の伯父さんに会うたびに、一度レム・ビリトンに帰るよう言ってくれって頼み込まれるんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "まぁこっちも一年じゅう外を飛び回ってばかりだから、そんなことを言う資格なんてないんだけどね。でもやっぱり、どんな手紙を書くよりも顔を見せるのが一番だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……そうですね。でも、ここには私を必要としている患者さんがいますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いつかまとまった時間ができたら、きっと帰ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "わかった。君も自分の考えがあるだろうから、これ以上はしつこく言わない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "ほかの手紙の確認が終わったら、そろそろ出発するとしよう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "お土産は、いつも通りでいいかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "はい、実家の下にある売店のミントキャンディーをお願いします。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "了解。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "伯父さん、ごめん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "へぇ～、ロドスにもトランスポーターっているんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あなたは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あたしは新入りのオペレーターだよ。コードネームはエイプリルっていうんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "こんにちは、エイプリルさん。医療部所属のアンセルです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ロドスにはトランスポーターが大勢いますよ。ですがさっきの彼はロドスのために働いている専属のトランスポーターであって、ロドス所属のオペレーターではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "それって何が違うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "別物ですね。ロドスのオペレーターになることを選んだ人の中にもトランスポーターがいて……えーっと、アンジェリーナさんを知ってますか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "うん。あたしと同い年くらいのトランスポーターの女の子でしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そうです。ロドスに加入したトランスポーターは、感染の治療費をまかなうためにオペレーターになることを選択するのが普通なんです。アンジェリーナさんがそうです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "ふうん、あたしもだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "鉱石病の治療費はどう見積もっても安くはなりません。艦内の様々な業種の人も、みんな同じ理由でここに留まっています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "それって、ロドス専属のトランスポーターになるのと何が違うの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ははっ、よく誤解されるんですが少し違うんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "トランスポーターという仕事は、人との直接的な接触が比較的少ない上、あちこち出かけなければならないので感染者になった後も続けられます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "言い換えれば、ほとんどの人は自分に手紙を届けに来た人が感染者なのかどうかわからないままトランスポーターと接しているんです……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "とにかく、ロドスのオペレーターとなったトランスポーターは、自分が元々いた活動範囲内で仕事を続けられるんです。ただ定期的にロドスに来て治療を受けるだけでいい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "えっ、でもそれってロドスで働いてるって言えるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "もちろんロドスはそのようなトランスポーターにも、外勤任務に類似した長期の任務を依頼していますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "彼ら自身も、ほとんどがロドスを自分の拠点の一つと考えているんです。自分の活動範囲内に私たちオペレーターの親族や友人がいれば、間違いなく彼らに手紙の配達を依頼しますからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "でも私のように、定期的に遠い故郷まで手紙を出す必要があるとなると、彼らに期待するのは難しいです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ロドスでは今のところ、レム・ビリトンから来たトランスポーターはごくごく少数ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "そうなんだ。でも、それって何の拘束力もないよね……前にあたしがいた会社じゃそんなの想像もできないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "どういうことでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "ここは従業員に自由があるってこと。一回だけ来て、仕事に出たらそのままいなくなる人もいるかもでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "鋭いですね。確かに稀にそういう人もいます。その場合は当然責任を追求しますが、何があっても私たちは患者さんを見捨てたりはしません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "アンセル先生は本当にいい人なんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "とんでもない。私はただ一人でも多くの人を助けられればと考えているだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "どのみち、確かにロドス専属のトランスポーターって必要かもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "そんなの考えたこともなかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あれ、そういえばエイプリルさんもレム・ビリトンの出身ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "うん。南部のアイアンキャロットシティ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あぁ、聞いたことがあります。鉱石の生産量で毎年上位に入っていますよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "そうそう、それがうちの町の誇りなの。あたしはなんとも思ってないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私はアイアンリストシティ出身です。エイプリルさんは故郷に連絡を取りあっている親族はいないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "いないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "うちの両親はあたしが小さい頃に鉱山事故で死んじゃって、あたしは二人が働いてた会社に育てられたの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "成人してからはその会社所属のハンターとして働いてね、給料は良くなかったけど、何とか暮らせてた。でも鉱石病に感染しちゃって……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……すみません、不愉快なことを訊いてしまって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "気にしないで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "でも、確かレム・ビリトンの企業の感染者への待遇は悪くなかったはずでは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "レム・ビリトンは鉱業が発展していますから、他国より鉱石病の罹患率がかなり高いのが理由で……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あたしも最初はそう思ってたけど、実際はぜんぜん違った。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "表向きは手厚い福利厚生があるとか言ってるけど、実際はかなりピンハネしててさ。しかも鉱石病になったって知られると、どんどん仕事を減らされちゃうんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あたしみたいな独り暮らしの鉱石病患者は、あそこでは暮らしていけないよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そうだったんですね……知りませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "鉱石病になった労働者の多くが姿を消していったのは、そういう理由だったわけですね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "どのみち会社からは解雇されたし、借りてた部屋も解約しちゃったから、レム・ビリトンはもうあたしの安住の地じゃないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あー、そんな顔しないでよ。あたし、同情されるのってすっごく苦手だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "それに、今はこうしてロドスに来れたんだからさー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "それもそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "それよりさ、さっき手紙をトランスポーターに渡してた時、ちょっと悲しそうな顔してたけど何かあったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あっ、別に言いたくないなら大丈夫だよ。あたしもさっきのことは誰にも言わないし！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "エイプリルさん、お昼はもう済ませましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "まだ。さっき任務から戻ってきたばっかりだから、お風呂に入ってから行くつもりだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "では、ご馳走しますよ。この話はちょっと長くなりますから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "え、いいのー？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "うわーっ、アンセル先生のランチ、すっごくヘルシー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "職業柄ですね。それと、アンセルって呼んでくださいね。歳もそんなに変わらないでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "オッケー！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "とりあえず食べましょう。話はそれからゆっくり。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "はーい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……いつも口では家族に会えなくて残念だと言っていますが、本当はあまり帰りたくないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "帰ると、いろいろと面倒ですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "うちは兄が三人と妹が一人います。両親は早くに亡くなりました。母は肺病、父は過労で。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "でもエイプリルさんと違って、両親が亡くなった時、兄は三人ともすでに働ける年頃だったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "父は亡くなる前に、私と妹をそれぞれ伯父たちに預けました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "へえ、でもそれって珍しいことじゃないよね。うちも親戚がいたらそうなってたかも。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "お父さんが言ってた。うちの親戚はみんな別の都市に行っちゃったんだって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "それで、帰りたくないのは伯父さんがヒドいヤツだから？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いえ。伯父は小さな会社の経営者で、真面目で厳しい人ですが私には良くしてくれます。本当の子供みたいに接してくれて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "だけど……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私が医者になるのを望んではいないんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "えーっ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私は子供の頃から伯父の会社を手伝っていましたから、将来会社を継いでほしかったみたいで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "でも伯父の反対を押し切って私は医者になり、遠路はるばるロドスまで来てしまいました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "え？　まさか家出してきたの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あはは、違いますよ、そこまではしていません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私が医学を学ぶと決めてからロドスに来るまでには、それなりの時間とやり取りがあったんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "伯父とはその間に何度も話し合って、喧嘩もしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "最後には私が選んだ道になんとか納得してくれましたが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "分からなくもないかなー。レム・ビリトンで医者になんかなったら生計が立たなそうだしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ですね。あそこで医者になること自体難しいですし、医術の腕を磨くのも難しい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "鉱山に派遣される医師であっても、ほとんどは基本的な医術しか身に着けていない人たちですから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "生活も伯父の会社で働くほど安定しないでしょうし、仕事を見つけるのも大変ですしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "伯父の言う通り会社を継ごうと考えたことも何度もあります。とてもいい会社ですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "それに、伯父はずっと私を養い続けてくれたのですから、期待を裏切るべきではないのではと悩んでしまって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "でも、自分のやりたいことがあるって当たり前のことでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "その話、うちの両親だったら絶対納得してくれなそうだし、いい伯父さんだと思うけどなー。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ええ、それで私は最終的に自分の決めた道を選んだんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "でも、伯父は胸の内を隠せない人なんです。伯父が人生を捧げてきた会社ですから、やはり継がせたいみたいで。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "今まで二回帰省しましたが、正直いたたまれなかったです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "しかも、兄たちからは伯父以上に反対されているんです。ただ、私が仕送りをしているので強くは言えないみたいですけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "妹はどちらかというと味方なんですけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あたしには手に負えない悩みだなぁ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そうですね。悩みは人それぞれですから……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私は自分が善い行いをしていると信じています。それに、ロドスは待遇もいいですし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ですが、私は伯父の想いに応えることはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "このことだけは……どうしようもないのです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私にできるのは自分の仕事をもっと一生懸命頑張って、より良い結果を出すことだけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いつか胸を張って「伯父さん、僕はたくさんの人を助けて鉱石病治療に大きく貢献したよ」って言えるといいなと思ってます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……まあそれでも、あくまで自信をもって伯父と向き合えるようになるだけで、会社を継いであげることは難しいんですけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "へー、アンセルってひ弱でなよなよした男の子に見えたけど、実は強い意志を持っていろいろ考えてるんだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "それって褒めてます？　けなしてます？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "もちろん褒めてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "はははっ、そうですか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "というか、面倒事があるとは言っても、心ではやっぱり帰りたいんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……そうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ロドスのオペレーターとしていろいろな場所へ赴き視野を広げるのもいいのですが、やはり故郷は故郷ですからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "巨大な煙突や騒々しい機械の音、鉱山労働者たちの掛け声、賑やかな大通り……懐かしく思いますよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ひょっとしたら、いつかロドスを出て故郷に戻り、レム・ビリトンで医者を始めるなんてこともあるかもしれませんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "そっかぁ……うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "どうされました？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "何でもない。ちょっと考えちゃっただけ。あたしも普段はレム・ビリトンを何とも思ってないって言ってるけど、心の底では、帰りたいって思ってるのかなーって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "アンセル、あたしのコードネームの由来はわかる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "暦の四月じゃないんですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "半分は正解。でもほんとはね、歌のタイトルなの。春の歌だよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あたし、自分はレム・ビリトンが嫌いなんだってずっと思ってた。アンセルがさっき懐かしいって言ってたやつ、あたしはどれも嫌いだもん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あたしの記憶の中では、あそこはいつもどんよりとしてて、人や物がウジャウジャしててちょっと息苦しいって感じなの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "まだ感染してなかった頃も、生活は楽じゃなかったしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "毎日会社に顔を出して報告して、任務があればチームで出かけて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "お金は稼げたけど仕事の環境は最悪だったし、いったん仕事に出ると十日以上帰れないのはざらで、何ヶ月も帰れないことだってあった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "任務がないときも、別にやりたいことなんかなかったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "好きなバンドはみんなほかの国のだし、欲しい化粧品だって雑誌で眺めることしかできなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "それに工場が多くて空気が悪いでしょ。だからいつだってスキンケア用品が手放せないの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あと、工場や街の音がめちゃめちゃうるさくて、しょっちゅう夜中に目が覚めちゃってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "しかもしかも、アパートの設備もダメダメだったの。体を洗ってる途中で水が出なくなるんだよ！　信じられる！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "うっ、それは確かにあまりいい思い出とは言えませんね……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "でも、よーく思い返してみると、良いこともあったなーって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "会社はブラックだったけど、長いこと養ってくれたのも事実だし。上の人たちの考えてることは分からなかったけど、でもあの人たちの申し訳なさそうな表情は覚えてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "近所の人たちは普段は無愛想だったけど、あたしを助けてくれたこともあるんだ。上の階の怒りっぽいペッローの爺ちゃんも、あたしが鉱石病になったと知ってから、時々野菜を届けてくれたしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あ、でも下の階のロロ婆ちゃんはほんとにイヤな人だったな。あたしを見かけるとツバを吐くんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "アパート下のスーパーの日替わり惣菜も美味しかったなぁ。あ、そういえばあそこの肉団子、ほかで売ってるのは見たことないけど、すっごく美味しかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "もちろん、子供の頃の両親との生活も楽しかったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "ああわかった！　これがいわゆる思い出フィルターってやつだね！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "あはは、そうなんでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "結局、自分たちの出自は捨てられないんだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私はロドスに来てから、この大地の広さや、もっと素晴らしい暮らしがいくらでもあるということを知りました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "別の生活を考えたこともあります。例えば前衛オペレーターや術師オペレーター、事務職に就くとか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "実際、ここなら新しい生活を選ぶこともできるんですよね。反対する人もいませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "だけど、結局は医者を続けているんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私はレム・ビリトンで生まれ、労働者たちの間で育ちましたから。ある日突然記憶を失いでもしない限り、完全に自分の過去を否定することはできません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "記憶喪失といえば、ドクターもそうだって聞いたような？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "はい、特に秘密というわけではありませんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "だったら、アンセルが言うみたいに、ドクターは新しい生活を選べるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "……それは難しいでしょうね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私はドクターの過去を全く知りませんが、アーミヤさんやケルシー先生、多くの人がドクターのことを知っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "恐らく、ドクターにもどうしようもないことはたくさんあると思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "だから、たとえ記憶喪失になっても、やっぱり自分の過去から逃れるのは難しいのかもしれません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あっ、いつの間にか話題が故郷のことから過去のことになっちゃったね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "でも確かに、故郷って人の過去の中で一番肝心な部分だもんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "そうですね。故郷そのものと言うよりも、故郷で過ごした時間が私たちにどんな痕跡を残したかだと思います。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "私はその痕跡を捨てることもできましたが、やっぱり受け入れることを選んだんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "エイプリルさんはどうですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あたしは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "うーん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "今はまだ分からない、かな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "なるほど、でも大丈夫です。私たちはまだ若いですからね、考える時間はたっぷりあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "だけど、少なくともあたしは、あの暮らしから逃げるためにレム・ビリトンを出るって決めたわけじゃないかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "結局、ただ離れざるを得なかったってだけだから。もしまだあそこで暮らせたなら、きっとそのまま暮らしてたと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "感染者になったせいでいろいろ辛い目にも遭ったけどさ、だからって人を嫌ったり、レム・ビリトンを憎んだりはできないんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "それでいいんだと思います。感染者になったからって、考え方まですぐに変わるものではありませんから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いずれ、ロドスでの生活が長くなってくれば、もっとよく分かるはずです。少なくとも今は、故郷や過去についてお話をするだけで十分です。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "うん、たぶんあたしも過去を受け入れてくタイプだと思う。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "今はまだ、レム・ビリトンやアイアンキャロットシティが好きだなんて言えないけど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "でもずっと忘れないと思う。あたし、悩みがあるといつもアパートの屋上に行ってたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "小さいアパートだったけど、アパートの周りには高い建物がたくさんあってさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "まるで高い建物があたしを閉じ込めるフェンスみたいに感じてた。頭の上にぽっかりとある空だけが、唯一見える景色でね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "でも、なんだかかえって安心感があったなぁ。あたしには広い空間は必要なかったし、たくさんの選択肢もいらなかった。あの狭苦しい感じがちょうどよかったのかもね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "その屋上をグルッと一周して、周りの住人たちが何してるのか観察するんだ。面白いものが見られたり見られなかったりだったけど、本当はそんなのどうでもよかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "それから、ヘッドホンで大好きな「エイプリル」を聴きながら屋上のど真ん中に寝そべるんだ。いろんなことを頭に思い浮かべて、しばらくうたた寝する。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "目が覚めると、ほとんどの悩み事はなくなっちゃってた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "屋上でうたた寝ですか……気持ち良さそうですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "でしょ。今でも時々そういう場所を探して寝てみるんだけど、ロドスの甲板は広すぎるし、あたしの求めてる感じとはちょっと違うんだよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "クルースというオペレーターに会ってみるといいかもしれません。彼女はサボれそうな場所を見つける達人なんです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "ほんと？　それサイコー。後で訊きにいこう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "……こんな話してたら、なんだかちょっと帰りたくなってきちゃったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "アンセルのせいだからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "ははっ、これは申し訳ないことをしました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "でもしばらくはやめとく。あたしはまだ新入りだし、入ったばっかで休暇を取るのはマズいもんね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あっ、そうだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "アンセルが配達を頼んでたトランスポーターはもう行っちゃった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アンセル",
      "text": "いや、まだいると思いますよ。明日発つんじゃなかったかな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "やった！　じゃあお願いしてこよう！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "トランスポーターさん！　レム・ビリトンへ行くんでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "はい。コータスのお嬢さん、あなたも手紙を？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "エイプリルって呼んで。手紙じゃないんだけど、一つお願いしてもいい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "何です？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "レム・ビリトンに行ったら、高い建物の屋上から見える風景を写真に撮ってもらえないかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "え？　ずいぶん変わったリクエストですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ロドストランスポーター",
      "text": "……ですが大した手間でもないですし、いいですよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "やったー！　じゃあお願い！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "故郷に過去か……あたし、意外と気にしてたんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エイプリル",
      "text": "あ、それよりクルースって人を探さなきゃね。帰るかどうか考えるより、のんびりできる場所を見つけるほうが現実的だよね！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
