{
  "server": "jp",
  "storyId": "act29side_level_act29side_07_beg",
  "groupId": "act29side",
  "stageId": "act29side_07",
  "title": "協奏曲「復活」",
  "storyCode": "ZT-7",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/activities/act29side/level_act29side_07_beg.txt",
  "sourceHash": "6c221300f6b68b13806e76d7234b7d8a74a2c3771f957df4e21d58e9cd762d10",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ツヴィリングトゥルム上空の雲が……自由に流れているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "これがあなたが最期の瞬間に見たかったものなの、コーラさん？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "そうよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "あなたのチェロの音が私に見せてくれた。本当に不思議ね、この光景は目を通して頭の中に入ってきたわけじゃない。私の心の底から勝手に芽生えてきたみたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたが望んだように、私はヴィヴィアナさんにちょっとしたヒントを与えてあげたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "彼女はあんなにも本当の家族のそばにいることを切望していた……けど残念なことに、最終的に心の奥底にある最も強烈な感情に従って動くことはなかった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "いいえ、友よ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "全ての人に対する彼女の感情が、私を殺すという決定を彼女に促したの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……あなたは満足しているの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "なぜ満足しないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "私は今愛する人が見守る中で死を迎えている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "惜しむ必要はないわ。私のような罪人にとって、これはすでに最高の結末だから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "あなたのおかげで、私とヴィヴィアナは……もっと遠くの場所へと行くわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "けれどもういくらもかからずに、あなたの感情は完全に散ってしまうわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "曲が終わっても、弦の震動は音を残すように。でもゆっくりと、その音は次第に消えゆき、最終的に静寂に帰る。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "アルトリア、雲を引き止められる人なんていないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "人の心は脆くて儚い。どれだけ強烈な感情だって、どれだけ大きな願いだって、各々終点に向かうことは避けられない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "どんなに強い心を持っていても……避けられないの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "あなたはその何よりも強い心のために来たのでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "私の感情と記憶は全部あなたにあげたわ。求めるものが見つかったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そうね、もしかしたら……すぐに分かるかもしれないわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "それじゃあ、さようなら、アルトリア。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「コーラ」",
      "text": "旋律の中で答えを得られますように。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "コーラ・レーヴェンシュタイン、優しくも頑なな私の友人……この旅にあなたという供がいて、本当にうれしかったわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私たちの望む未来は、私が頑張って実現させる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そしてあなたとは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……きっと旋律の中でまた会うでしょう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "コーラさんが……消えている？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "彼女から離れろ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ブラント……さん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "コーラさんは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "説明の必要はない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "君は自ら判断し、そして……行動に移した。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "それ以外は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……それ以外は、私も君も……今は語ることもできないし、語るべきでもない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "黒炎が彼女を連れ去りました。ルートヴィヒ大学の時と……とても似ています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "ヘーアクンフツホルンのアーツだ。だが全く同じではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "あの時の術者は術式を無理やり発動させた模倣者にすぎない。しかし今この瞬間力を降ろしているのは、まるで彼本人のようだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "赤黒い力が雲の中でうねる。\n焦って引き裂くことも、何かを呑み込むことも、周囲へ広がることもない。\nそれはまさにあの雲間にある塔の頂の玉座の上でゆっくりと歩き、見渡し、待っている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "お前たち見たか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "偉大なるヘーアクンフツホルン様が我々の呼びかけを聞き入れ、謁見をお許しくださった！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」",
      "text": "あのお方は今――我々に向けて永遠なる塔に、「始源の角」に通ずる階段を下ろしてくださっているのだ！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "巫王の信徒たちが高らかに笑っている。\n彼らは次々に楽器を掲げ、鋭い音を奏でながら、それを自身の喉に向け、また胸や腹に突き刺した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "雲の間の黒色はそれに応えるかのように、彼らに向けて幾筋か自らを差し出した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "死にかけの信徒は、王が差し伸べた手に恭しく口づけをし、黒炎と一つになった。すると空へ舞い上がり、双子の塔の上空を漂う黒雲の一部となった。\n旋律を成さない巨大な音が空中で破裂した。\nリターニアにおける恐怖の象徴。比類なく強大な君主、ヘーアクンフツホルンが自らの民に布告した。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……ヘーアクンフツホルン、本当に帰ってきたのか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "厄介だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "楽章そのもののアーツの束縛を受けて、まだ演奏が続いてる。変調した金律楽章は逆にヘーアクンフツホルンの力を強化している。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "……今何をした？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私のアーツであの雲を撃ち抜けるか試してみた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "ヤケになる時じゃない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ヤケになる？　どうして私がヤケになるのだ。レッシング、私がこの瞬間をどれだけ待っていたか知っているか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私の頭にあいつの雑音を流し込まれた時から……いや、生まれた時から、私はこうしなければならない定めにあったのだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君は私に戦えと、自らの責任と罪を直視しろと言った。君の言う通りだ。ヘーアクンフツホルンは私が背負う罪であり、彼に向き合うのが私の責任だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "何とかしてあいつをあの空の宮殿から……あるいはどこかしらから引きずり出してやらなければならない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "それか、私が上へ送って差し上げましょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "なっ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "透明な糸が空から伸び、彼の首に触れる。柔らかく、冷たい感触が無防備な肌に忍び寄る。\nそして、すかさず縮んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "うっ――！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "誰だ！？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "たった今、命を救ってくれた人に対して怒鳴り散らすなんて、少しマナーがなっていないのではなくて？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "黒炎が……私が立っていた場所に落ちた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "レッシングの言う通りにして、あの雲に張り合わない方がよろしくてよ。彼は少し朴念仁なところがありますが、言動は頼りになりますもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "エルマンガルド、随分と突然だな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "時刻表でもご所望でして？　これでもカズデルから駆け付けてきましたのよ。私のキューブちゃんも途中の風で糸がたくさんすれてしまいましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "はぁ、帽子も汚れてますし。あなたの角で拭いてもよろしい？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "ダメだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "つまらないですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "……直接俺の角に触るのもやめてくれ。状況はどれだけ深刻だ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "とても、非常に。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "巫術の測定は必要ありません……この空間にはここにあるべきではない糸で満ちており、リッチですら整理できないほど乱れていますわ。もう一度雨が降れば解決できるものではありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君もリッチなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "見えないかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "私はてっきり……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "リッチはみんな白髪のお爺さんで、長いひげを生やして頭から尻尾までローブに覆われ、手にはドクロのアーツユニットを持っているとでも思ったかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……リッチというものは、言語の美学について、洗練された拘りを持つものだと思っていたがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "そうだ、爺さんは？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "先生の気性は知っているでしょう？　雲の中へと直接飛んで行ってしまいましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ヘーアクンフツホルンが玉座で目を開いてすぐ、先生はリターニアの国境からひとっ飛びで戻ってまいりましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "そうそう、そのうえ私たち全員の糸も引っ張っていましたのよ。カズデルのリッチでさえ彼のあの罵り声が聞こえたかもしれませんわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "どれだけ来た？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "来られる人は全員。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "大変な苦労ですわよ。昨日引っ越すと言われて、あれだけ多くの文献や法器を車に積み込んだばかりなのに、すぐに元住んでいた家が吹き飛ばされそうだと耳にしたんですもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "はぁ、あなた方リターニア人って、実は私たちリッチが一日だって離れたらダメになってしまうのでは？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "イーヴェグナーデ",
      "text": "リッチたちが戻ってきた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グリムマハト",
      "text": "……状況は厳しいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グリムマハト",
      "text": "「始源の角」が……降臨している。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミヒャエル",
      "text": "グリムマハト、ヴァイオリンです――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "グリムマハト",
      "text": "よろしい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グリムマハト",
      "text": "……リーゼロッテ、しばらく一緒に演奏していなかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "イーヴェグナーデ",
      "text": "ああ。楽章の演奏もそろそろ終わるし、慣例通りであれば、我々の出番だな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グリムマハト",
      "text": "ヘーアクンフツホルン……リターニアの定められた厄災。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グリムマハト",
      "text": "我々は一度彼に勝っている――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "グリムマハト",
      "text": "――二度目の勝利も、疑う余地はない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "女帝の旋律だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "グリムマハト様とイーヴェグナーデ様が……動きました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "ヴィヴィアナ、君のすべきことをしろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "金律法衛",
      "text": "……我々も同じだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "金色の輝きが金律法衛の剣と甲冑からほとばしる。\n彼の姿はその輝きの中にほとんど溶け、同時に、他の金律法衛も女帝たちの旋律に呼応する。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アーツの光が至る所から空へ放たれ、近づき、結ばれていく。\n空はすでに黒色で覆われていたが、さらにきらびやかな雲が地上より立ち上る。\nこの金色の守護の下、パイプオルガンの音が双塔の下の人々を優しく包み込む。ヴァイオリンの透き通る激昂した音は鋭い剣となり、逆巻く雲を突き刺す。\nそして数十の手が数多の糸を引き出し、空と風の中の旋律をもてあそぶと、旋律はよりはっきりと認識できるようになった。\n双子の女帝、金律法衛、リッチ。\nリターニアの守護者たちは共に立ち、虚空より帰還したリターニアのかつての王に共に抵抗する。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "混乱は激化しています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ヘーアクンフツホルンに対抗できるのは、女帝の旋律だけです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "旋律……？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "パイプオルガンとヴァイオリンの音以外にも、チェロの音が聴こえます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ですが、私には聞こえません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "雑音の一部であり、伝統的な音楽とは大きく異なるからです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "あなた方は音楽を感じることに慣れています。一方で私はすべての音を無差別に受け取ります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "結論は、はっきりしています――",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "アルトリアです。彼女が脱獄しました。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」？",
      "text": "（鋭い雑音）",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……これは何だ？　落ちてきた黒炎に……人の姿が？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "アーツの産物か、それとも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "残念な事実ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "たった今巫術で探ってみましたわ。これらのアーツエネルギーの中にはまだ少しばかりの人間の感情が残っていますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "まさか何らかの形でまだ生きているというのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "当然……ありえませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "たとえずっと死と付き合ってきた私たちでさえ、肉体と魂がすべて滅びた後に生き続けるなんてできませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "私たちの見たものはわずかばかりの生前の残留物。この狂った信徒たちの言葉を借りれば、「余韻」ですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……彼らの望みは叶ったようなものだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "これは良い知らせではありませんわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "類似する「余韻」というのは往々にして……うーん、どう説明すればよろしいかしら？　つまり私たちの血肉や他の有形物が存在できない空間にのみ現れますの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "その空間には、「生」と「死」の概念はなく、時間の流れもない。ただ情報だけが残りますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "「余韻」というのは情報の痕跡であって、通常であれば、現実においてはただ停滞する幻覚でしかありません。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "しかし先ほど黒炎の中で触れた感情は、いまだ揺れ動いておりましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "結論を言ってくれ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "おバカな朴念仁、ほんと気が短いこと。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "まあ、あなた方はリッチではありませんものね。とにかく、空間の侵食が加速していますの。その上、巫王は空間の改造に成功し、恐らく今も自らの意識をそこに保存していることでしょう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……さっき、我々は上へ行けると言っていたな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "行けますわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "ですが、本当に行きますの？　先ほど言ったように、ヘーアクンフツホルン以外に、誰も入ったことはありませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "彼が「存在」できるのなら、私にだってできるだろう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "あら、若者は元気が有り余っていますわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "カズデルであの生気のない老いぼれやさえない顔した傭兵たちと長くいすぎたせいで、リターニア人がこんなにも面白いことを忘れていましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "でも残念です。リッチでさえ生きている人をその空間に送り込むすべがないですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "「始源の角」に入るには、両側の二つの空間に安定した繋がりが必要ですわ。言うなれば、ここで私が先生を呼び、先生が私に応答するといったような感じですね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ハハッ、あの仮面をかぶった狂人たちの呼び声が、本当にあいつを呼び覚ましたというのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "絶対にありえない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "十数年以上、サルカズの大昔の巫術からリターニアの最新の術式まで爺さんはあらゆる方法を試した。いずれも失敗に終わった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "あの人は、昔リッチの聖殿をこのツヴィリングトゥルムに移そうと試みましたのよ。他の先生が力を合わせて阻止してようやく諦めたけれど。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "エルマンガルド、問題の根源がどこにあるか探れるか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "二人とも見えていますわよ。双子の女帝の塔ですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "塔の中にはたくさん人がいるけれど、二つの塔をまとめて追放してほしいのかしら？　そんなのお安い御用ですが。なんでしたら、ツヴィリングトゥルム全体をどうにかしても構いませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "そういう冗談はやめろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "はいはい。まあ、本当にその時が来たら、私たちリッチの出番はないでしょうしね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "あなた方の金律法衛はベールを展開しましたわ。もし「始源の角」が本当に制御不能となって、双子の女帝の手にすら余る時、彼らはどうすることでしょう？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……双塔を劇場ごと滅ぼすだろう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」？",
      "text": "（鋭い雑音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "また来たぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "ハッ、巫王派残党が……死に絶えてもまだまとわりついてくるか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "ここは俺とエルマンガルドに任せろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "あなたは双子の女帝の塔へと向かい、「始源の角」に入る道を見つけ出すんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "これを持っていけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "これは何だ……布でできた結び目？　くそ、記念品など渡すな。必要ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "記念品ではない、特殊な通信機だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "これはリッチの習慣だ。彼らは糸で互いに情報を伝達する。俺はサルカズの巫術を使えないから、実際の物に頼るしかない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "ほら、こうやって軽く結び目を引けば、俺とエルマンガルドはそれに気付く。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "本当に……気付ければいいがな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "さあさあ、死ぬことはありませんから、ぎゃーぎゃー騒がないでくださいましね。せいぜいちょっと重傷を負うくらいですし、私ならすぐに修繕して差し上げますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "エーベンホルツ、あなたには向き合わねばならないことがある。だが俺が守らねばならないものはすべて下にあるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "それと、誰かがあなたのために背中と、退路を守ってやる必要があるだろ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "わかった。できるだけ生きて帰ってくる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "あなたならできる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "君もな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……誰だ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "サンクタ……それと女帝の術師？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ご機嫌よう。ヴィヴィアナ・ドロステと申します。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "女帝の術師たちは皆、下の橋にて、女帝と共にヘーアクンフツホルンに立ち向かっています。まさかこの階でほかの方に会うとは思ってもみませんでした。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……オペレーター・エーベンホルツ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "今……何と？　待て、貴殿もロドスの人間か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "私はラテラーノ公証人役場の執行人、ロドスとは執行協定を結んでいます。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "ロドスにいた時、リスク管理の観点から、一部のオペレーターの個人資料の閲覧が許されていました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ロドス……ですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "私も何人もの友人が、ロドスと深い関係にあります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "ということは、私たちは、共に行動することができるのですか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「巫王の余韻」？",
      "text": "（鋭い雑音）",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……ここまで追ってきたか。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "聞こえましたか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "上方、塔の頂上近く……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "はい、徐々に鮮明になってきました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "チェロの音か？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "そうです。これがアルトリアのチェロの音です。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "バルコニーで薄灰色の雨が降り出した。アルトリアのチェロの弦に落ちる直前、雨粒は即座に逆流し、目の前で雲となった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "……あるいは、煙の輪。"
    },
    {
      "type": "dialogue",
      "speakerName": "？？？",
      "text": "あの二匹の羊の防御術式ではやはり私の煙の輪を防げんかったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "てっきり……最初に来る聴衆は私のしつこい弟だと思っていたわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "大概にせい、サンクタの子よ、お前のチェロを聞きたい者などおらんぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フレモントさん、あなたもずっと「始源の角」に入りたかったのではなかった？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "それと……あの「情なき大権」。あなたたちはヘーアクンフツホルンが残した面倒事を解決したい。けれど心の奥深くでは、それぞれ別の望みもある。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "グリムマハトは、より強い力を望んでいるわ。そして、あなたは……あぁ、なんて深い感情なのかしら。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "巫王の最も親しい友人として、思想を衝突させたり、アーツを交じえたり……二人の友情は、まさにリターニアのあの輝かしい年月と同調していたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "そして連れ立った後の分かれ道、それは旧友との再会をより期待させてくれる。違うかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "何を言っている……私の考えを読んでいるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "魔王でさえ私の書物を簡単に開く勇気はないというのに、お前は天罰が下るぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたの心の声は私の音色に伴って共振しているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたの心が発する音を無視することなんてできないの。大抵の人に私のチェロの音が聞こえてしまうようにね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "それがお前の小細工というわけか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "お前のチェロの音がその鍵。何がヘーアクンフツホルンの旋律だ。あいつが適当に書き上げた楽譜と何の関係もないではないか！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "「裏切り者の魂は失われた『始源の角』へと導いてくれる。」",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ゼーマン、ロリス、ブラント、ゲルハルト、最後に……コーラ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "彼らの感情の最も深くで巫王の遺言を見つけたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "ほぉ、あいつがいまわの際に発した戯言を聞き取れるのか。素晴らしいな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "勲章でも授与するようリターニアに言っておいてやろうか？　さっさとラテラーノに帰ったらどうだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "灰色の雲がアルトリアの足元に現れた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "それはすぐに破裂し、サンクタを彼女のチェロごときれいに呑み込んだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "ごめんなさい、フレモントさん。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私は止まれないわ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私は会う必要があるのよ……ヘーアクンフツホルンに。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "彼を演奏したいの。彼の過ごした一生を、死ぬ瞬間の思いを、死してなおリターニア上空にこだまする強烈な感情を感じたいの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私は彼から、答えを得たいの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "サンクタめ、こんな見かけ倒しのアーツではお前の死期を早めるだけだぞ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「ゲルハルト」",
      "text": "先生、私は頑張りました。高塔の経典に打ち込み、文献の中に答えを求めました。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ゲルハルト」",
      "text": "他の人の命はあんなにも脆く、一つ間違った決定をするだけで、消滅へと向かう可能性があります。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ゲルハルト」",
      "text": "しかしヘーアクンフツホルンは、死してなお彼の意志は、永遠なる高塔のようにそびえ立っています。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「ゲルハルト」",
      "text": "なぜヘーアクンフツホルンはこれほどまで特別なのでしょうか？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「リーゼロッテ」",
      "text": "本当にヘーアクンフツホルンを殺すことができるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーゼロッテ」",
      "text": "私とヒルデガルトの体内には彼の術式がある。我々は彼に対抗する兵器として生み出された。人工の兵器でしか奪えぬ命は、まだ普通の命と呼べるのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーゼロッテ」",
      "text": "彼らが言っていた。ヘーアクンフツホルンに、「永遠」に関する秘密を教えたのはあなただとな。彼はこの大地にはない幕の後ろに隠れ、死の視線から逃れた。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「リーゼロッテ」",
      "text": "それはどのような空間なのだ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「エルマンガルド」",
      "text": "先生、数千年来、我々リッチはあの「空間」を研究してきましたわ……もしそれが本当に「空間」と呼べるのならばですが。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「エルマンガルド」",
      "text": "しかし我々は誰も入ったことがありません。ヘーアクンフツホルンだけが足を踏み入れました。彼は我々が知るよりも多くの真相を掌握しましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「エルマンガルド」",
      "text": "うーん……先生は気になりませんの？　「始源の角」を奪ってリッチのものにしたくはありませんの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「エルマンガルド」",
      "text": "中の知識をすべて地上に持ち帰ることができますわ。きっとサルカズの役に立つはずです。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「エルマンガルド」",
      "text": "危険？　あの双子の言うことを聞く必要なんてないわ。リターニアは私たちの国ではありませんもの。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "「フレモント」",
      "text": "だか危険なのはあの空間そのものだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「フレモント」",
      "text": "虚空……無尽蔵の……悪魔。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「フレモント」",
      "text": "虚空は決して……空っぽではない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「フレモント」",
      "text": "あまりに多いのだ。危険や……未知の……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "「フレモント」",
      "text": "もういい。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "十分だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……今の黒いのは何？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フレモントさん、あなたの……前回の「死」に際の状況かしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あなたは……虚空を垣間見た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "あとほんの少しで、呑み込まれるところだった。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "リッチには命を半永久的に延ばすことができる特殊な手段があると聞いているわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "たとえそれでも、肉体の消滅に直面した時、あなたはやはり……恐怖を感じるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "お前は自分では理解できない、そして理解すべきでない物事について語っている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……どうして？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "私たちの命はこんなにも短い。なぜ何も知らないまま終局に向かう定めなの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "禁忌にたやすく触れてはならん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フレモント",
      "text": "アルトリア、諦める気がないのなら、ここで死ね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "おびただしい数の糸が、リッチの背後の虚空から落ちる。狂風より速く、嵐よりも密に。\nそれはアルトリアのチェロに絡みついた。糸は彼女の弓と弦を押さえつけて、彼女の両手と体を縛り付けようとする。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "「追放」。\n老いたリッチは彼女をラテラーノに帰すつもりはない。彼は彼女を完全に消そうとしている。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "アルトリアは微笑んで、弓を引いた――これが最後になるかもしれない。"
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "フレモントさん、私の無知と不遜をどうかお許しになって。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "たとえ次の瞬間に死のうとも、虚空に落ちようとも、混沌と化そうとも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "アルトリア",
      "text": "……私は、絶対に演奏をやめない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "最後の音が響いた。\n無限の虚空に呑み込まれる直前、アルトリアは理解した。この演奏はすでに完成したと。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "……エルマンガルド、見たか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エルマンガルド",
      "text": "お知らせくださってどうも。私がはっきりと見るよりも先に、糸の振動が強すぎてこの魂の方がこぼれだしてしまいそうですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "これが「始源の角」。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "レッシング",
      "text": "見た目は……伝説にある巫王の塔とよく似ているな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "黒雲が裂けた。\nまるで巨大な目のように、虚空の中でゆっくりと開かれていく。\nその瞳の深くに映るのはほかではなく、まさに二十三年前のあの漆黒の塔だ。\nあまつさえそれは当時の位置、現在双子の塔の間にある。\n始源の塔は本当に倒れたのか？\n巫王ヘーアクンフツホルンは本当に死んだのか？\nリターニア人の心を覆うこの悪夢は、舞い戻ってきたのではなく、初めから消えていなかったのではないか？"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "チェロの音が消えた？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "フェデリコ",
      "text": "……アルトリア。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "待ってください、フェデリコさん！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "……結び目が動いている。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "レッシングとリッチの警告を感じる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "この空間は異常だ。ドロステ殿、どうか蝋燭の火を消してくれ……他のアーツも使用しないでいただきたい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エーベンホルツ",
      "text": "これから何が起こるかは分からない……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "階段が……変化した？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "これは何か特別なアーツでしょうか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "アルトリアさんのチェロの音による錯覚……それともまた別の力？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "……エーベンホルツさん？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ヴィヴィアナ",
      "text": "かすかな足音だけ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "すぐに、足音すらも消えた。\n螺旋階段はどこまでも、どこまでも延び続ける。果てが見えないほどに。\n自分は上へ向かっているのか、それとも下へ向かっているのか？\nヴィヴィアナは束の間呆然とした。\n階段を歩いているのは自分一人になったということだけを、はっきりと理解していた。"
    },
    {
      "type": "sceneBreak"
    }
  ]
}
