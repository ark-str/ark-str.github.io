{
  "server": "jp",
  "storyId": "story_malist_set_1_story_1",
  "groupId": "story_malist_set_1",
  "stageId": null,
  "title": "エンドレス・サマー",
  "storyCode": null,
  "avgTag": "幕間",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/memory/story_malist_1_1.txt",
  "sourceHash": "b9da3c8d35ce76ce8e44d658c5a87991caaa5221c11b71eabf0649d55c08c15d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "デカルチャー。オレは今すぐアカフラへ戻ることに決めたよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "ええ？　せっかくロドスに手紙を届けに来たから、もう少し見て回りたいんだけど──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "あのさ、アカフラのドゥリン集落の写真を見せたのはアンタだろ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "私じゃなくて、エッジ先生よ。どうしてもあなたにこの写真を見せたいと言ったのは。何でも「斬新な建築様式」をシェアしたいそうで……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "これが「斬新な建築様式」だって？　そもそもティアカウの家屋って時点でかなりいい加減なのに、あの連中ときたら、まさかティアカウの真似をするなんて。こんなのが様式だなんて呼べる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "今思うと、「どでかい水たまり」は見ててうんざりするデザインではあったけど、少なくとも頑丈で、体系的で、リズム感があって、一目見てキャッチの奴の作品だってことは分かったよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ロドスの宿舎エリアにしてみても、恐ろしく不細工ではあるけど、一応、機能によって各エリアは分けられてるし、動線もちゃんと考えられてる。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "けどこの写真の家、支柱は歪んでるし、屋根はボロ布を適当に張っただけ。フェンスなんてどうやったらこんな形になるんだよ。これじゃ建築じゃなくて、危険で悪趣味な積み木だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "スディチ、落ち着いて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "自分の一族がこんなもんの中で暮らしてるんだぞ。どう落ち着けって言うんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "設計代表として、みんながこの妙ちくりんなボロ家を喜んでぶち壊せるように、今度という今度こそは全員が納得するようなデザインを考え出してやる！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "今すぐ外出申請を出してくるよ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "ちょっと。スディチ、待ちなさい。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "なに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "帰るのは別に構わないけど、集落の建築様式を一新して建て直すというのは……正直難しいと思うわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "アダクリスのスタイルを模倣することは、みんなが投票で決めた結果だもの。それに得票率もかなり高かったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "私も個人的にはちょっと雑すぎると思うけど、何と言っても地上に来るのは初めてなわけだから、こういったドゥリンとはまったく違う様式というのは確かに印象的に見えるの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "みんなの性格を考えると、こういう新鮮な物に夢中なときに、あなたのデザインで納得させるのは恐らくかなり骨が折れるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "キャッチの「どでかい水たまり」だって高い得票率で通ったんだ。オレにできないはずないだろ？　それに不満があったとしてもドームを直した時だって、それなりに喧嘩したわけだし別に……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ゴホンッ、とにかく、なるべく頑張ってみんなを説得するつもりでいるから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "説得できたとしても、エネルギー供給量がゼルウェルツァにいた時よりも少ないのよ。その上、建設機械の開発をするために少し回り道もしていて……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "説明するとちょっとややこしいんだけど、現状では生産力が不足しているの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "分かったよ。うちの間抜けどもは頑固なうえに生産力も足りてないから、再建が難しいってことね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "分かってくれたならいいわ──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ああ、分かった。でも、やっぱりオレは帰るぞ！　ゼルウェルツァを建てた職人たちがこんな変てこなもんを作ったなんて考えたら、どうしても我慢ならないんだ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "すぐに休暇を申請してくるから、ここで待ってて！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "エッジ先生がニヤニヤしながらあの写真を渡してきた時、スディチがこんなに怒るだなんて言ってなかったのに……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "あら。デカルチャーさん？　ロドスにいらしたのですか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "アヴドーチャ！　ちょうど良いところに来たわ、スディチを何とか説得してくれない？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "わらわは案じることはないと思いますわよ。アカフラまでかなり距離がありますし、帰る間にきっと冷静になりますわ。スディチさんも昔とは違いますもの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "それに彼はロドスに来てから、まだ一度もアカフラへ帰省しておりませんのよ。もしかしたらただ皆のことが恋しくなって、理由をつけて帰ろうとしているだけかもしれませんわよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "けど、スディチの性格はあなたも知ってるでしょ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "どうしても心配だとおっしゃるのなら、わらわも一緒にアカフラへ行くというのはいかがでしょう？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "お二人のお食事をお持ちしましたわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "ありがとう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "スディチさんはどちらに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "中で設計図を書いてるわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "アヴドーチャ、残念だけどあなたの言った通りにはならなそうよ。帰る間も時間を惜しんで、「ニュー・ゼルウェルツァ」とやらの設計図を書くのに夢中。設計バカのまんまで諦める気は全く――",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "おい、全部聞こえてるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "あははは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "スディチさん……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "急いで食べちゃおう。食事が終わったらすぐ出発だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "アンタらはどうか知らないが、オレはこのボロ家には我慢なんないんだ。デザインが酷いだけじゃなくて、埃もヤバくてとんでもなく不衛生だ。こんな家に住むなら二日酔いのがずっとマシだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "すぐに出発するのは構いませんけれど、ロドスを発ってからの貴方は先へ進むのも、設計図を描くのも、ずっと焦っている様子で……まるで何かに追われているようですわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "余計な心配はいらないよアヴドーチャ、オレは全然問題ない。もうこれ以上こんな部屋にはいられない。先に行ってるからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "でもまだご飯が──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "歩きながら食べるよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "スディチさん、何か心配事がおありでしたら、わらわたちに遠慮なくおっしゃってください。ガヴィルさんたちがゼルウェルツァへ来た前の時のように黙っていては──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "分かってるって！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ミニマリストは苛立たしげに振る舞ったが、その目は泳いでいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "スディチさん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "まだなんかあるの！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "わらわの目を、見てくださいまし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "チッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "分かった、言うよ、言えばいいんだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "実はロドスを発つ数日前に、これを渡されたんだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "貴方のメディカルチェックの結果ですわね。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "この源石融合率──どうしてこんなに高いんですの！？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "違う違う、ひとまず最後まで読んでよ。せめてガヴィルが下の方に書いた注釈だけでもさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "源石環境の影響により……測定値に乱れが発生した……本報告書は無効とする……オペレーター・ミニマリストの容態に異常はなく、比較的安定した状態にある……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "この記述、本当ですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "この結果が出た時、オレもガヴィルも目を丸くしたよ。その後何度か測り直してみたけど全部正常な値が出た。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "仮にこの数値が本当だとしたら、オレは今みたいにぴんぴんしてないだろうって、ガヴィルも言ってたしさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "だけどこいつのおかげで一気に目が覚めたんだよ。確かに間違った結果かもしれないけど、でも……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ゴホンッ、とにかく、そんな感じだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "スディチさん、まだ話は──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "それに考えてみたら、アイツらはデザイン案を一度もオレに見せたことがないんだぞ！　なのに勝手に妙ちくりんな家を山ほど建てやがって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "今は生産力が不足してる状況なんだろ？　なおさら時間を無駄にはできないんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "オレは先に行くからな！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "お帰りなさい、スディチ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "やあやあ戻ってきたな。ガヴィルの奴は何度も帰ってきとるのに、お前ときたら一度も顔を見せに来ないもんだから、寂しくて死んでしまいそうだったぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "それで、あんな写真を送ってきたってわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "まあそんなところだ。あの日は少々飲み過ぎていてな、勢いでデカルチャーに頼んであの写真をお前に届けてもらったのだ。あれを見たらきっと帰ってくると思っていたぞ、ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……この……えーと、家……を実際に目の当たりにすると、写真よりも……刺激的なのは認めざるを得ない。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "そうだろうそうだろう。それでな、せっかくだから『奇談怪論』を読んで、地上人のネーミングを参考に、この様式にこんな名前を付けてみたんだ。「暴れんぼうジャングル風」とな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "暴れんぼう……ジャングル……風……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "どうだ、私も結構ネーミングセンスあるだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……答える前に訊きたいんだけどさ、師匠かキャッチの奴は帰って来てない？　あの二人はアンタの「暴れんぼうジャングル風」に何か意見はなかったの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "いや、まだだ。キャッチが何通か手紙を送ってきただけだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "（小声）ふん、まっそりゃそうか。コイツらの間違いを正せるのはオレしかいないみたいだ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "スディチは深く息を吸い込んだ。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "むっ、スディチ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "エッジ！　じい！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "おお、クロッケ、私をあそこに座らせてくれんか。近頃は歳のせいか腰の調子が──",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "待てって！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "帰ってきてほしいならちゃんと手紙でそう言えば──いや、それはひとまず置いといて、今は「暴れんぼうジャングル風」の話だ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "アンタの後ろにある竹竿の上に建ったボロ家を見てみろよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "床を高くするのが湿気の多い気候に対応するためってのは分かる。けどその下の竹竿は何なの！　曲がってるんだぞ！　支柱が！　力学的構造が完全におかしいんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "オレにはね、アンタらが上り下りする度に竹竿が悲鳴を上げるのが聞こえてくるんだよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "それにその上の窓、板を釘で打ち付けてるけど、晴れた日に日差しが入ってくるのが嫌なの？　それとも雨の日に入ってくる水が足りないわけ？",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "それから、そのボロ布とボロ棚、あとはこのきったない岩も──爆発した「どでかい水たまり」の方がよっぽど美しかったよ！　こんなもんただの貧相な積み木じゃないか！！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "激怒するアダクリス人",
      "text": "この小僧が。ぶっとばされてえのか！　ここは俺の家だぞ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……え？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "（小声）元々の住民の家ですらこんな欠陥だらけってことは、ドゥリン人のなんてもっとひどいに決まってる……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "状況はまさにスディチの予想通りだった。\nドゥリン人の地上での初建設は、自由な発想が思う存分に生かされていた。よく指導に訪れるティアカウたちと意気投合し、スディチが激怒するようなデザインをたくさん思いついていたのだ。\nしかしドゥリンの集落を一通り見て周った後、スディチはこの勝手気ままな家屋を壊して建て直すような生産力が今の集落にないことを潔く認めた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "彼は道すがら描き上げた新しいゼルウェルツァの設計図をしまいこむと、各家を一軒一軒訪ね、アドバイスして回ることにした……\n最も実用的で、最も見落としがちな、しかし最も重要なアドバイスを与え、だらしないドゥリン人たちを監督し、一日中外に出て集落の改装を図った。\nさらに彼は、奇想天外に見えて実はそれほど不便でもないデザインに対し、口では不満を述べながらも、実際に仕事にかかる際には見て見ぬふりを選んだ──\n彼がゼルウェルツァにいた頃の知り合いにとっては、これは想像だにしないことであった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "木材、石材、工具に囲まれ、時間がゆっくりと流れていく。休暇がもうすぐ終わろうとしていた。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "流石はスディチだ、我々ドゥリン人の集落が見違えるように変わったな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ふん。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "今の家は辛うじて建築物って呼べるかもだけど、それでも不細工なことには変わりない。キャッチの奴が帰ってきたら、ここらを見せてみなよ。どんな顔をするのか見ものだね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ハハッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ところで、この近くに湖があって、そのほとりに何かしら建ててほしいとか何とか言ってたよね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "うむ、その通りだ。だがお前はあと数日でロドスに帰るんだろ？　湖にまで手を付けるとなると、少し時間が足りないんじゃないか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "もしオレが帰った後、一族の誰かが突拍子もないことを思いついて湖畔にバカげたもんでも建てたら……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "なぁに、そうなったらまた帰ってきて建て直せばいいじゃないか。誰も文句は言わんよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……そんなこと、本当にできるのかな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ん？　当然じゃないか、あそこには誰も住んでおらんしな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "いや、オレが言ってるのは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "まあいいや、早くみんなを連れて向かうとしよう。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "着いたぞ、この湖だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ここは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "何だか……どことなくゼルウェルツァの「どでかい水たまり」に似ていますわね。天然の砂浜までありますわ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "そう。この場所こそがアカフラ・ドゥリン娯楽産業における今後の発展の道しるべになると思ってるんだ。残念ながら、今は何もないけどね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "今まではみんな、家を建てては直しっていう作業で忙しかったし、最近は改装にもかかりきりだし……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "それより地形の問題よ。水位の上下が激しいから、水位が低い時は水上施設で遊べなくなって、高い時は水辺に建てた施設が水没してしまうの。だから今まで誰もこの仕事を受けなかったのよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "スディチ、無理にとは言わんぞ。今回はお前も集落の家の件で疲れてるだろう。さっきも言ったように、景観施設についてはまた次の機会で構わんさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "いや、次じゃなくて今やる。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりしたドゥリン",
      "text": "よぅ、スディチじゃないか。こないだは俺んちを改装してくれてありがとな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "大したことじゃないよ……砂の城を作ってるの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりしたドゥリン",
      "text": "その通り。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのドゥリン",
      "text": "何がその通りだ。作ってるのは俺だよ、こいつは見てるだけさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "この湖は水位の上下が激しくて、波もあるって聞いたけど、砂の城なんて本当に作れるわけ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりしたドゥリン",
      "text": "運次第ってとこだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりしたドゥリン",
      "text": "運がいい時はしばらく立ったままでいてくれるんだが、運が悪い時には、最高のアイディアが浮かんだ次の瞬間に水で流されることも──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "今まで穏やかだった湖に突如として波が起こり、ほぼ完成していた砂の城が波に巻かれ、一気に形が崩れてしまった。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "波が何度か打ち寄せた後、砂浜には何も残っていなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのドゥリン",
      "text": "ったく何なんだよお前は。良いことはひとつも当たらないくせに、悪いことを言った時はすぐに現実になるんだからよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりしたドゥリン",
      "text": "いやいや、これは良いことでもあるじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりしたドゥリン",
      "text": "「どでかい水たまり」があった頃は、砂の城をどう建てるか考える時間が無限にあった。アーツユーニットを改造して、城の建築を邪魔しに来る奴らにお灸をすえてやろうって余裕もあったくらいだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりしたドゥリン",
      "text": "その結果アーツユーニットの改造は捗ったけど砂の城の建築はまったく進まなかったなぁ。もう少し考えないと良い形にはならないって完成を先延ばしし続けて。どのみち時間はたっぷりあったし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "そう言われると、一理あるような……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのドゥリン",
      "text": "一理あるだって？　こいつは一週間タダでミードを飲めるってんでご機嫌なだけなんだよ。そりゃあ口ではまともそうなことくらい言うだろうさ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "ミード？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "のんびりしたドゥリン",
      "text": "恥ずかしい話だが、今朝二人で賭けをしたんだよ。今日は湖の水が上がってくるかどうか、砂の城が建てられるかどうかって賭けだったんだが……ププッ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ほろ酔いのドゥリン",
      "text": "おまっ、人に酒代を出させるくせに笑いやがったな！　ぶっとばしてやる！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "二人のドゥリンは水の満ちた砂浜の上で取っ組み合いを始めた。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "見たかスディチ、この湖はこういう感じだ。私もここに何を建てるべきか思い浮かばん。お前の休暇も残りわずかだし、やはり今回はゆっくり休んで、次に来た時に考えればいいだろう。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "いや、もうアイディアは浮かんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "まあ。何を建てるおつもりですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ニュー・ゼルウェルツァさ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "スディチ、ここへ来る前にお酒でも飲んだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "んなわけあるか。生産力の問題はしばらく解決しないだろうけど、バカ市民たちの美的センスは矯正しなきゃならないからね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "あっ、それってスディチが考えていた新しいゼルウェルツァの模型を建てるってことかしら？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "これだけ時間が限られてるのに、模型なんてどうやって作るつもりなんだ？　私が集落に戻って材料の調達やら、職人の招集なんかをしてこようか……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "いや、大丈夫だ。砂を使って直接建てるから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "まさかお前、さっきのバカ二人組がケンカしてた時にずっと居眠りしとった訳じゃないよな？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "湖の水位とか波のことはひとまず置いといて、ここが砂の城作りに最適なのは確かだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "エッジじい、アンタ、オレの休暇が残りわずかだってずっと言ってたじゃないか。時間がない以上、あまり手間のかからない物の方がいいでしょ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "砂の城なんざ、すぐ波に呑まれてしまうのが分かってるのに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "そうだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "……スディチ、お前は成長したのか、それとも何かあったのかどっちなんだ？　しばらく見ない間にずいぶん変わったみたいじゃないか。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "彼の好きにさせてあげてくださいまし。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "アヴドーチャ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "スディチさんは何ともありませんわよ。ただ最近は少しだけ心境の変化があったようですの。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "そうなのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "ええ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "……アヴドーチャに免じて、ひとまず信じることにしよう。いいかスディチ、言ったからにはきちんとやり遂げるんだぞ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "もちろんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ああ、それとさ、オレが湖畔に砂の城を建ててる間は、誰も入ってこないようにしてくれない？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ふん、それは投票の結果次第だな。皆がここに来たいと言うなら、私にも止めることはできない。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "ドゥリン人たちの投票の結果、湖付近にはしばらく近付かないことに決まった。\nそれでも好奇心を抑え切れないドゥリン人は、ミニマリストの砂の城が絶えず変化する湖の波に呑まれていないかを知りたがった。\n彼らがこの件にどれだけ関心を寄せているかは、クロッケの立てた賭場の様子からもうかがい知ることができる。\nこっそりと湖の状況を見に行こうとする者も少なくはなかったが、封鎖線の前で似たような考えを持つ大勢の人々と鉢合わせた挙句、自発的に秩序維持に乗り出したクロッケによって阻止された。\n......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": ":\nそしてついに――ロドス帰還予定日の前日に、両目の下に大きなクマを作ったスディチが封鎖線の前までやって来て、ごった返す人だかりに向けてこう言い放った。「完成したよ。」と。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "人々は、精巧且つコンパクトな作りの「ニュー・ゼルウェルツァ」の前で足を止め、驚嘆した。\n円形の広場や街道のデザインはあの地下のゼルウェルツァを想起させたが、道端の建築物はさっぱりとして滑らかで、ミニマリストらしさが明確に表現され、ゼルウェルツァとは全く異なっていた。\nさらにそれらの建築物は特定の様式のコピーなどではないものの、アカフラの要素もある程度取り入れられていた。これがたとえ本場のアカフラにそびえ立っていたとしても違和感はなかっただろう。\n皆の目の前に立つこの短気な建築家が、砂粒を使って湖のほとりに理想都市を築き上げたのだ。"
    },
    {
      "type": "dialogue",
      "speakerName": "驚嘆するドゥリン",
      "text": "スディチがずっと言ってたニュー・ゼルウェルツァって、こんなにすごいものだったんだな。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "褒め称えるドゥリン",
      "text": "このデザインは、アダクリスとフィディアにも広めるべきだろう！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "現実的なドゥリン",
      "text": "スディチの奴、本当に砂でこんな模型を作れるなんて！　この数日間は幸運にも無事で済んで良かったけど、次に波が来たら跡形もなく消えちまうのは残念だな……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "強風が吹き、湖の中心から波が岸辺へ押し寄せて来た。\nバシャッ。\nだがスディチの砂の都市は微動だにしなかった。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "スディチ、お前もしやアーツの隠れ名手だったのか？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ふん、オレはずっと、ただの建築家だよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "またもや波が押し寄せて来た。今度は一回り強い波が都市の一角を浸水させる。\nしかし波が引いた後も、皆の予想とは裏腹に、片隅にあった小屋を除く建造物のほとんどが変わらず無傷のままだった。\n目ざといエッジはその小屋の一階部分が波にさらわれて消えているにもかかわらず、二階が依然として地面に立っていることに一目で気づいた。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "ふっ、お前、ズルしたな──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "さらに湖面が荒れ始めた。高波が白い波しぶきを巻き散らしながら砂浜に向かって次々と打ち寄せ、ニュー・ゼルウェルツァに絶え間なくぶつかってくる。\n人だかりから嘆きの叫び声が上がった。さすがに、今度という今度こそはスディチの運も尽きただろう。湖水もあいつを見放すだろうと言うように。\n横目でスディチの様子をうかがったエッジは、彼も他の者と同様に唇を強く噛みしめているが、その表情はますます得意げになっていることに気付いた。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "正直に言ってみろ、お前は一体何回作り直したんだ？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "波の機嫌がまあまあ良かったから……三、四回ってところかな。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "波がようやく収まった。スディチの砂の城は大部分が波に呑まれてしまったものの、相変わらず砂浜の上にそびえ立っていた。\nこの時、ニュー・ゼルウェルツァの内部にびっしり組み上げられた鋼鉄製の骨組みが陽射しの下で白銀の光を放っているのが、その場にいる全員の目にはっきりと映っていた。\n人々はまず驚嘆し、次に拍手を送り、最後に決して悪意のない笑い声を上げた。\n彼らには、この短気な建築家がついにユーモアを覚え、皆の前で素晴らしいマジックショーを披露したように見えたのだ。\nスディチは何も語らず、少し緊張した様子で視線をそらすと、指で鼻をこすった。"
    },
    {
      "type": "dialogue",
      "speakerName": "エッジ",
      "text": "小僧め、お前のこれほど得意げな顔は初めて見たぞ、ハハッ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "クロッケ",
      "text": "スディチ、正直言って、今すぐに集落をあなたがデザインしたものに変えたいくらいだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "デカルチャー",
      "text": "どうやら、生産力の向上が喫緊の課題になったようね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "それじゃ、オレの目的は……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……ふわぁ～あ……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……これで達成だ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "ですが……スディチさん、どうして砂のお城なんですの？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "言っただろ、ここは砂の城を作るのにピッタリなんだ。ちょうどアンタらも景観を整えたがってたし、オレはただその流れに乗っただけ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "今アンタらが見たのは砂の城だ。そして波が引いた後も、しばらくは流されることのない鉄骨の景観を眺めていられる。これくらいでちょうどいいだろ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "アヴドーチャ、あの検査結果のことまだ覚えてる？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "メディカルチェックのことですわよね？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "あれのおかげで目が覚めたんだ。オレに残された時間は限られてる……あの間違った結果が、いつ現実のものに変わるか分からないんだから。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "……まるで、砂のようですわね。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "だから急いで帰ってきたかったんだよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "建築デザイナーとしても、ゼルウェルツァの設計代表としても、他のヤツらより多少マシな美的センスの持ち主としても、オレはみんながどんな場所に住むかに対して責任を背負ってるんだ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "こうしておけばオレにもし何かあったとしても、ニュー・ゼルウェルツァの模型はここに残ってるからさ。あとはアンタらがそれを建てるだけでしょ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ふわぁ～……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "パゼオンカ",
      "text": "鉄骨入りの砂の城などでなく、普通の素材で模型を建てていれば、そこまで自分を追い込むこともなかったでしょうに。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "それは……",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "単に純粋な美学の問題さ。ロドスにいた時ドクターに話した通り──",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ドクターに？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "ああ、クロージャを待ってるんだ……",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……ロドスの船殻の整備をしてるから、今日は来ないって？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "チッ、せっかくここをどうデザインすべきか分かったってのに。",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "オレの意見？　オレはロドスに来てまだ間もないし、船殻にだって詳しくない。どんな意見が出せるっての？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "それでも聞きたいって言うのなら……次に整備する時には、もっと高耐食性の素材に替えるのをお勧めするよ。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "理由？",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "……すべてが終わって消え去る時、オレやアンタなんかは影も形もなくなるからだよ。最後に残るのは、この船の骨だけだ。コイツこそが永遠なんだ。そして、オレたちの生きた証になるんだよ。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "（小声）……チッ、よくあんな恥ずかしいセリフが言えたな。頭がどうかしてたよ、まったく。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "その、アヴドーチャ、ロドスに戻ったら自分でドクターに聞いて。",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "ミニマリスト",
      "text": "オレはお先に一眠りさせてもらうから。",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
