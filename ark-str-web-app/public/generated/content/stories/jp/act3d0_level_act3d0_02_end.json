  "blocks": [
    {
      "type": "narration",
      "text": "第四关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "早く！　ドクター！　ビーチの方へ逃げますわよ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "ビーチには多くの観光客がいます。あの中へ紛れれば追いつけないはずですわ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "護衛",
      "text": "止まれ！",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "セイロン",
      "text": "貴方たちだけなら――！",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "シュヴァルツ",
      "text": "……。",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "あれ、君は――",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "シュヴァルツ！　良かった、やっと会えましたわ！",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "貴方がいればなんとかなるわね。クローニンさんはいったいどういうつもりなの！？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "ドクター、彼女が前にわたくしが言っていた……。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シュヴァルツ",
          "text": "お嬢様、旦那様が街にいない間は、クローニン様の言うことを聞いてください。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "シュヴァルツ？　何を言っているの？",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シュヴァルツ",
          "text": "クローニン様のもとへ戻りましょう。その人たちは彼に任せて。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "シュヴァルツ",
          "text": "お嬢様には手を上げたくありませんので。",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "セイロン",
          "text": "……シュヴァルツ？",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
