{
  "server": "jp",
  "storyId": "main_3_level_main_03-03_beg",
  "groupId": "main_3",
  "stageId": "main_03-03",
  "title": "旋回",
  "storyCode": "3-3",
  "avgTag": "戦闘前",
  "sourcePath": "vendor/ArknightsData/jp/gamedata/story/obt/main/level_main_03-03_beg.txt",
  "sourceHash": "393bc7bdcac4c2cd6db170ac23d5a88f519c476c4ec337b9eb57579491dd8580",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "くそっ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "怯えるな、敵はたったの二人だ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "さっさと仕留めて――"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "くっ……もう二十人は犠牲になってるぞ！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "あいつら、普通の相手じゃねえ……！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "テキサス、右！"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "右？　あいにく、今は手一杯だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "――そいつを抑え込め！　俺がトドメを刺してやる！"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "カバーは任せた。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "そんじゃ代わりに、つめた～い飲み物でも奢ってくれる～？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "ああ。だから早くしろ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "りょうか～い！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "さ～て、そこのお兄さん？"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "あぁ？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "キミに弾丸をプレゼントするから、ちゃ～んと受け取ってね！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "は？　プレゼント、って……"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "ぐあっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "はい、一丁上がり～！"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "感謝する。"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "こ、この女っ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "だが、剣さえ封じときゃこっちのもん――"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "悪いが、そうはいかない。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "――私の剣は、もう一振りあるんでな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "う、うわああっ！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "よーし！　これで全員片付けたかな？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "にしても、あたしたちのコンビって息ぴったりだよね！　まさに阿吽の呼吸ってやつ？"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "……そうだな。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "いたぞ、逃がすな！"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "増援か。数が多いな。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "まあ、あれほど派手にやれば当然か。"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "くそっ……！！　なんなんだよ、この状況は……！"
    },
    {
      "type": "dialogue",
      "speakerName": "レユニオン構成員",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "お前ら、一体どうしてこんな真似をした！？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "ん～、キミたちに恨みはないんだけど……"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "仕事は仕事だからさ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "一度契約した以上、しっかりそれを遂行するのが物流業界の基本っていうか――"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "エクシア、左だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "えっ？"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "って、うわわ……！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "ごめん、ありがと！"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "ああ。――右の連中は任せた。"
    },
    {
      "type": "dialogue",
      "speakerName": "テキサス",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "走るぞ、そろそろ潮時だ。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "エクシアさん、聞こえますか？　もうじき、そちらに到着します！"
    },
    {
      "type": "dialogue",
      "speakerName": "エクシア",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "了解！　向こうさんはあたしたちに気を取られてるし、動き方はお任せするね！"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "はい！　お二人も、どうかお気をつけて！"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "フランカさん、目標地点には到着しましたか？"
    },
    {
      "type": "dialogue",
      "speakerName": "フランカ",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "ええ、準備OKよ。"
    },
    {
      "type": "dialogue",
      "speakerName": "リスカム",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "――こちらリスカム。我々重装部隊も、配置についています。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "わかりました。――オペレーター各位、注意してください。敵狙撃手が地形を利用して身を隠している可能性がありますので。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "自分の立ち位置には気をつけつつ、狙撃手優先で、攻撃をお願いします。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "では……皆さん、奇襲の準備を。"
    },
    {
      "type": "dialogue",
      "speakerName": "アーミヤ",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "……救出対象の安全のためにも、やりすぎないよう注意してくださいね。"
    },
    {
      "type": "sceneBreak"
    }
  ],
