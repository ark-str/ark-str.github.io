      "text": "Protect Stitch. Protect Stitch."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerId": "avg_1026_gvial2_1",
      "isRemote": false,
      "text": "Hey, where did these bots come fr—"
    },
    {
      "type": "dialogue",
      "speakerName": "Stitch Canvas",
      "speakerId": "avg_4054_malist_1",
      "isRemote": false,
      "text": "—!"
    },
    {
