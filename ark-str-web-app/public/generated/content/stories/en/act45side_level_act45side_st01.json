    {
      "type": "dialogue",
      "speakerName": "Vigna",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Sakiko Togawa",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I've helped them out before. I'm well-acquainted with the entire workflow."
    },
    {
      "type": "dialogue",
      "speakerName": "Sakiko Togawa",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "If they're short of hands, I will most certainly lend mine."
    },
    {
      "type": "dialogue",
      "speakerName": "Vigna",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey..."
    },
    {
      "type": "dialogue",
      "speakerName": "Sakiko Togawa",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Vigna, I'll see you at the usual place!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Vigna",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait, hold—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Vigna",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Jeez. I don't remember her learning any of that..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Vigna",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Fifty-three, fifty-four, fifty-five... fifty-six..."
    },
    {
      "type": "dialogue",
      "speakerName": "Vigna",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
