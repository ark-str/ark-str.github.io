  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Gladiia",
      "speakerId": "avg_474_gladiia_1",
      "text": "Hfff—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Seaborn",
      "speakerId": "avg_npc_186",
      "text": "Do you think you are more like me... or him?"
    },
    {
      "type": "dialogue",
      "speakerName": "Seaborn",
      "speakerId": "avg_npc_186",
      "text": "Gla-dia. You are strong."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Seaborn",
      "speakerId": "avg_npc_186",
      "text": "Emotions. Our kinsmen will learn it. There is much that we are passing on, and we will try to pass them on to you as well."
    },
    {
      "type": "dialogue",
      "speakerName": "Seaborn",
      "speakerId": "avg_npc_186",
      "text": "Ishar-mla. Live. It's good to be alive. Our blood kin will find you again... and they will ask you."
    },
    {
      "type": "dialogue",
      "speakerName": "Seaborn",
      "speakerId": "avg_npc_186",
      "text": "We don't know how to ask questions, but we will learn."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "text": "—It's dead."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "speakerId": "avg_npc_184",
      "text": "You damned mixed-breeds."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gladiia",
      "speakerId": "avg_474_gladiia_1",
      "text": "Yes, step right up. It's your turn now."
    },
    {
      "type": "dialogue",
      "speakerName": "Gladiia",
      "speakerId": "avg_474_gladiia_1",
      "text": "This piece of trash is all by himself, and the Sea Terrors outside probably aren't from the same tribe. So they must be yours."
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "speakerId": "avg_npc_184",
      "text": "I will tear you to shreds. Your blasphemy will be punished."
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "speakerId": "avg_npc_184",
      "text": "I will do it myself. I will take care of you mixed bloods right here, right now. Life is precious, but to keep you alive would be a waste of resources."
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "speakerId": "avg_npc_184",
      "text": "One of you is heavily injured, and the other cannot so much as move. I will scatter what's left of you across the land so that you will be eaten by the most lowly of land creatures."
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "speakerId": "avg_npc_184",
      "text": "I can easily kill you two—"
    },
    {
      "type": "dialogue",
      "speakerName": "Gladiia",
      "speakerId": "avg_474_gladiia_1",
      "text": "Enough with the show. Unlike that piece of trash Seaborn, you at least used to be human, and now you are pretending to still be one. That just makes me want to puke."
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "speakerId": "avg_npc_184",
      "text": "(Shrieks)"
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "speakerId": "avg_npc_184",
      "text": "This is where you will die!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": null,
      "text": "Forgot about me, did you?"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
