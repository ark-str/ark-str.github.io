  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act17d0/level_act17d0_03_end.txt",
  "sourceHash": "d10b41a09f19e796b70f470f8d4f3b1ae3ffbdce9e390c55432d6c961f9d8231",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Thunderbolt!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Aaaagh...! My eyes!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "Where are the casters?! Take out that Vouivre!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't even think about it."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_053",
      "operatorId": null,
      "portraitKey": null,
      "text": "What's happening? There's more of them?"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_054",
      "operatorId": null,
      "portraitKey": null,
      "text": "How?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_053",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're in a bad way. They've got way too much firepower."
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_054",
      "operatorId": null,
      "portraitKey": null,
      "text": "Cut our losses and fall back before this gets any worse."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "...I see you..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_053",
      "operatorId": null,
      "portraitKey": null,
      "text": "Augh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_054",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sniper! !"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_053",
      "operatorId": null,
      "portraitKey": null,
      "text": "Shit, where?!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_054",
      "operatorId": null,
      "portraitKey": null,
      "text": "Forget it! Just run!"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "...You're not getting away."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Mercenary",
      "speakerToken": "avg_npc_053",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ugh..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mercenary",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Fall back! Quickly! Just run!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerToken": "char_458_rfrost_1#4",
      "operatorId": "char_458_rfrost",
      "portraitKey": "char_458_rfrost",
      "text": "They're running!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Sitrep!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "You okay, Alexsandr?"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Yeah, just a flesh wound."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Those guys are learning."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Don't let your guard down!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "We've still got company."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "...That's close enough, friend."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "I appreciate the help, but let's keep a comfy distance until we figure things out."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Relax. We mean you no harm."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're a Rhodes Island field team! And you're holed up in a Rhodes Island safehouse."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're responding to a distress call."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Please identify yourselves."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Calm down! I'm here to help."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "It's the Rhodes Islanders?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#3",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Hey, the cavalry came after all!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#2",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Go get Mr. Occphen."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#3",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Got it."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "speakerToken": "avg_npc_012",
      "operatorId": null,
      "portraitKey": null,
      "text": "Rhodes Island Operator? Hooray! We're saved! We're saved! !"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "speakerToken": "avg_npc_012",
      "operatorId": null,
      "portraitKey": null,
      "text": "That's about the size of it."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "So those four mercenaries are the ones who set up these temporary defenses?"
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "speakerToken": "avg_npc_012",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm really sorry. They broke my communicator, and I couldn't protect the safehouse..."
    },
    {
      "type": "dialogue",
      "speakerName": "Occphen",
      "speakerToken": "avg_npc_012",
      "operatorId": null,
      "portraitKey": null,
      "text": "I wouldn't blame you if you fired me on the spot..."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Don't worry, this old man doesn't have the power to fire anybody."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "And the way I see it, you held out this long all by yourself. That's pretty fantastic."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "If it weren't for you, these Infected would've met a much worse fate."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "How many are they?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Counting the doctor outside, forty-three. All Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And the four mercenaries were protecting them all this time?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Mercenaries going out of their way to look after Infected. That's something you don't see every day."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Mercenaries who not only don't look down on them, but actively try to help them."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe I'm being too paranoid, but where did these saints come from?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "I think they may not realize."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "From the way they talk, I get the impression they were just protecting ordinary, innocent townsfolk."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I guess it's less that they don't discriminate against the Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And more that they don't care about Oripathy."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But they don't look Infected at all?"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "I've never seen mercenaries like them. I've never heard of any 'Team Rainbow'."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "They've got guns, but none of them look like Sankta?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Unless the Sankta figured out a way to hide their 'Fluorescent Lamps'..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "A non-Sankta mercenary group fully decked out with big guns like that is gonna be huge news."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Blacksteel R&D would go nuts if they heard about this."
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "...Let's not talk about them like they're not here."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Regardless, they saved a Rhodes Island Operator and protected a bunch of Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Until we have some evidence, we shouldn't be doubting their motives."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Our top priority is finding a solution to our predicament."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Let's talk to them."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "They've been in there for a while."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "What do you think of this Rhodes Island?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerToken": "char_458_rfrost_1#1",
      "operatorId": "char_458_rfrost",
      "portraitKey": "char_458_rfrost",
      "text": "I've been wondering about them."
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerToken": "char_458_rfrost_1#1",
      "operatorId": "char_458_rfrost",
      "portraitKey": "char_458_rfrost",
      "text": "What kind of pharmaceutical company needs a safehouse full of military-grade hardware out on the edge of civilization?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frost",
      "speakerToken": "char_458_rfrost_1#1",
      "operatorId": "char_458_rfrost",
      "portraitKey": "char_458_rfrost",
      "text": "They've got enough arms and explosives to outfit a platoon."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "And the employees of this 'pharmaceutical company' all look like professional soldiers."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Either this world's doctors are armed to the teeth, or the pharmaceutical business is a front. Probably both."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "They're armed. But they looked well-trained and well-spoken."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "It's a night and day difference with the thugs we ran into before."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#6",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Also..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#6",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Maybe it's just me, but I get a real familiar vibe from them."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#3",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "You know, I got that too."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#3",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "They're reasonable, civilized people, at least. Everything I saw before had me thinking this world was an apocalyptic, bandit-ridden hellscape."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm finished binding your wound, Mr. Alexsandr."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Thanks, Doctor."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Doctor, are you familiar with this Rhodes Island organization?"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "...I've heard a bit from the caravans."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "They're a group that specializes in critical care for the Infected, as well as an Oripathy research team."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "But isn't it an incurable disease?"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes..."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Actually, there used to be a lot of people who claimed to be able to cure Oripathy."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "They were mostly shysters who ended up ruined when their scams were exposed."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "As for those who just exaggerated the effectiveness of their drugs suppressing the symptoms of Oripathy, they might not reach the level of fraud yet, but even their suppressant drugs are very expensive."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "I'd guess so."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I once heard about a lord whose daughter contracted Oripathy, and he spent a lot of money to buy the suppressants from Columbia to save his daughter."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Years later, the lord's money dried up, and his daughter died of the disease."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "But look at this."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "What is it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "This is the safehouse's store of Oripathy suppressants."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "These past few days, I injected some of the more serious sufferers with this, and it really did suppress their symptoms. It works better than any drug I've ever seen before."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "This medicine... must be insanely expensive, no?"
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "But Mr. Occphen wasn't concerned with that at all. When I told him some of my patients were in critical condition, he gave me the box."
    },
    {
      "type": "dialogue",
      "speakerName": "Miarow",
      "speakerToken": "avg_npc_160_1#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's not that I don't believe there are good people in this world, but..."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#3",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Hey, I didn't expect that."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Don't overthink it. Suspicion is costly. Whether you show it or not, it's going to get in the way of our talks with them."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "It looks like our goals are aligned, so we can just lay this stuff on the table."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "If you say so."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Oh, they're here."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Sorry to keep you waiting."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Now let's skip the pleasantries."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Thank you for saving Occphen. Without you, Rhodes Island would have lost a good worker."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "When the mission is over, I'll make a full report, and Rhodes Island will remunerate you appropriately, and compensate you for your supplies."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Remuneration..."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "Remuneration is nice."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Also, you put your lives on the line for the Infected. And that wins this old man's admiration."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "These townsfolk have done a lot for us in our time here. Leaving them to die wouldn't be our style."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "So you're mercenaries?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#8",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "No... We're..."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#2",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Yes. Yes we are."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#2",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "We're mercenaries. The super expensive kind."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#6",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Can you give us the name of your company? Mercenaries like you are a rare breed."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#3",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Err... We're... um..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#3",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "(Russian) Help me think of a name!"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "(Russian) Polar Bear Logistics?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I understand if you're not in a position to say."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#2",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "We're... We're from a faraway country in... in the south!"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "That's right! We're from way down south!"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "The south? South of Sargon? ?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Beyond the foehn hotlands?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#2",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Foehn...? Yes, the south. Right."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "There's other countries beyond the foehn hotlands? ?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "That's... shocking. I've lived a long time, and this is the first I've ever heard of people down there."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "In all the records of all the Lords Ameer, there's never been a single report of someone crossing the hotlands."
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "speakerToken": "char_459_tachak_1",
      "operatorId": "char_459_tachak",
      "portraitKey": "char_459_tachak",
      "text": "(Russian) You could've made your story a little more plausible."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "(Russian) Plausible like Polar Bear Logistics?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Anyway, warriors with Ursine and Victorian accents, it doesn't matter where you come from."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "You're willing to fight for the Infected. And at least on that point, our interests are aligned."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "At least for now, we can work together to deal with this situation."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "I can agree with that."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "So who can tell us what the heck happened to this town?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sarkaz Mercenary..."
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "Controlling the monsters, should be casters."
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "They're organized, disciplined, and most importantly, they know when to cut their losses and back down. They're not here for a quick raid."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "They are all properly geared up with Columbian equipment. Some of them were extremely tough back when they sieged the safe house."
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "avg_npc_166",
      "operatorId": null,
      "portraitKey": null,
      "text": "Judging from the equipments and tactics, they should be professional mercenaries who signed the 'Redmark contract.'"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "I'm afraid it's a rebellion against the local lord."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "But why are they attacking civilians?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "They chased us here from the Infected quarter."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "What on Earth do these mercs actually want?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The most likely answer is they wanted to silence you."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "I'm afraid that's not the only thing they were after."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "avg_npc_156_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What do you mean?"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "When they attacked the Infected quarter yesterday, they were obviously targeting the sick."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "They were trying to round them up."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#1",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "I'm pretty sure that was their goal."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kidnapping... Infected?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "avg_npc_155_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "That doesn't make any sense."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "The enemy's objectives are a mystery to us, but that's not the most important thing."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "For now, the best thing we can do is wait."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#7",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Wait?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "You may not realize it, but we're standing in the middle of a fait accompli."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "We walked into this Lord Ameer's territory without his permission, violating his commandments and the local laws. We've broken a major Sargon taboo."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "The town nobility may be in the middle of a war, but they're still the rulers here."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Sticking our noses in anything else at this point would only make our situation even worse."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "The local lord set up an Infected quarter. That tells us he's not totally cruel and heartless."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "He was willing to let Rhodes Island build a safehouse here. That means he's not an isolationist."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "I think he'll treat us fairly."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#6",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "National law... local government... I get it. That's the best we can hope for right now."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "Until the situation changes again, we'll hold out in the safehouse and wait for the riots to die down."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "I hope you can help us."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#5",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "No problem. We need Rhodes Island's professional expertise too."
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "speakerToken": "char_503_rang",
      "operatorId": "char_503_rang",
      "portraitKey": "char_503_rang",
      "text": "All right then. I'm looking forward to working with the four of you."
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
