          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "FrostNova, you and your team aren't as destructive as the other Reunion units."
