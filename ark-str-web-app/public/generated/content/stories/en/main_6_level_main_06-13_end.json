          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Rhodes Island, we can honestly understand you and your squad."
