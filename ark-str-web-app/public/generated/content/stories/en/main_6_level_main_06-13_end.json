          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#1",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "You may think I'm wrong, and that we don't understand you at all..."
