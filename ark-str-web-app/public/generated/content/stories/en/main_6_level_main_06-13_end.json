        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1#7",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "I think I don't much want to hurt you either. But if I have to, I will kill you all."
        }
      ]
    },
    {
      "type": "choice",
      "options": [
