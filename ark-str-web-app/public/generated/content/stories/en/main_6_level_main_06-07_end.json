{
  "server": "en",
  "storyId": "main_6_level_main_06-07_end",
  "groupId": "main_6",
  "stageId": "main_06-07",
  "title": "It Fell From the Sky!",
  "storyCode": "6-8",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_06-07_end.txt",
  "sourceHash": "9d60a39bd0b7321f5a8cca8f111781636f0560a0e1c173d069acf07b0f107a26",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "*Pant* *pant*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Blaze!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "I'm fine! They... have some moves.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "You're not freezing, are you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Thanks to you, we're okay. You're keeping the air warm enough to stop her chills.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Don't mention it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Hey Frosty, why aren't you using lethal Arts?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "*Hack* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "So that's why.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...FrostNova, she...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "FrostNova's the name?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "*Hack*... Help me... cover...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member",
      "text": "Sister...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Get out of here, Amiya. There could be more Reunion on the way. Do we have any injured? I can help.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "So you're retreating?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "I'm going to politely suggest that you don't fight anymore, snow bunny.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "If you keep using your Arts like that, you're going to die. You're just burning your life into power.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Or, you could always come to Rhodes Island. We've got ways to extend your life.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Don't look at me like that... I don't need your pity.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Do I look like I pity you? You're strong. I respect you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Why are you running away?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "*Cough*... *Hack* *hack*...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Dr. {@nickname}, run. Don't look at her!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Reunion forces closing on our position!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "You're not leaving.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member",
      "text": "Sister, don't use that now, not where you're standing!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "We can't let them escape!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Who knows what Rhodes Island might do to our people in Lungmen!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "The temperature difference... it's causing the structure... to weaken!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "*Cough* *cough*... freeze!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "......♪......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "*Hack*...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member",
      "text": "It's working...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member",
      "text": "The Originium we buried has changed the structure of the lower levels, the plates are tilting!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member",
      "text": "Sister, it's too dangerous! Hold onto me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Yeti Squad Member",
      "text": "Sister?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...Blaze. Do you hear that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Is that the sound of the structure shattering?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Oh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Buried Originium... heat absorption... temperature difference...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's collapsing... FrostNova's Arts can actually do that...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "No!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "The plate is warping!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Reunion is capable of something like this?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "All I know is... the whole district is sinking!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Run! Get to a stable area! The ground here is caving in!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "...Doctor?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Doctor, the ground under you... it's... splitting?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Uh oh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Dr. {@nickname}, move!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Move what...?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Amiya, stay where you are! Dr. {@nickname}, grab onto that lamppost!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Save the Doctor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "The ground is splitting too fast! I can't reach!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Then I'll do it!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "No!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "What did——",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "...I'm okay.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "The buildings can't support their own weight anymore, they're all collapsing!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Meteorite, take her!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "Okay, I've got Amiya!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Put me down!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Amiya, go. I'll get the Doctor! I'm an elite operator, I can do it!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Welp, looks like we're not quite done.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Doctor, I'm going to use airflow and pressure to slow your fall and push away the building beside you. Don't worry, it won't crush you!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Just don't panic! I've got you!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "...See you soon!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "See you.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Sup? Where's FrostNova?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "Your commander fell down there too, huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "...Yes.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Could we not fight?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Rabbit of Rhodes Island, could we forge a temporary armistice? Honestly, we never much wanted to fight you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Mephisto told our sister you'd killed Alex, and she was very concerned about what you would do next.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...Who's Alex?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Skullshatterer.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I'm sorry. I did kill Skullshatterer.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "...Oh.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Infected really should not fight one another. I'm sorry.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "What's to apologize for? It was a battle, wasn't it?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "It was.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "So let's have a ceasefire. Nesti, what do you say?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Huh? *Ursine profanity*!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Nesti says he's fine with it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "I don't think that's what he said.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "As long as we're not in battle, there's no reason to kill anyone, right?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Why is it... you want a ceasefire?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Did you ever notice that both our sides are led by rabbits?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "...Huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "I think something in my brain just broke.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Jessica",
          "text": "Hm?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "These are the yetis of the ice field?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Jessica",
          "text": "Wh- what do you mean?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "Shouldn't they be cold, merciless killers?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "This isn't right.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "That's prejudiced.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Listen here, bunny.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Who wins the battle, or where you go, none of that matters to us. All we care about is our sister's life.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "And you're worried about your friend too, right?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...Right. We didn't come here to hurt anyone.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "You're definitely not here to hunt Reunion for sport, are you?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Of course not!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "You know... it's funny...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "If it weren't for Patriot insisting on unity in the Reunion Movement, we'd have dealt with Mephisto and his people a long time ago.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "And that'd be kinda like hunting Reunion for sport, huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Huh...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Yeti Squad Member",
          "text": "Let's get digging, shall we?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
