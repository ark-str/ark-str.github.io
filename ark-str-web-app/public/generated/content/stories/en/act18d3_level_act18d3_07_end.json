{
  "server": "en",
  "storyId": "act18d3_level_act18d3_07_end",
  "groupId": "act18d3",
  "stageId": "act18d3_07",
  "title": "Protector",
  "storyCode": "SV-7",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act18d3/level_act18d3_07_end.txt",
  "sourceHash": "e36abc2e695d4f04b809310c710c984147bcf54cd4d83ac2fad0aa42822d76c3",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "text": "That should take care of it, I think? We should have enough for me, Grandma, and Bench...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "text": "Oh, and the singer too. She will come back, right? We can't let her go hungry.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "text": "We still have... some. We can put the rest in the box.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "text": "Uh, Uncle Fireplace, you wanted some? O-Okay, I can give you some first.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "text": "Whoa, I think that's seaweed on your arm! Let me have it! I'll make the... uh... seaweed alcohol that the singer taught me to make!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "text": "Huh? Where did Bench go? I only took my eyes off for a moment.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "text": "(Makes children noises)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "text": "Ah... Songs... Ahhh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Stop grabbing...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "This is yours.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "text": "Whaa...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Stop chewing it... It's not something you can eat.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "text": "Woodframe... Woodframe...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Don't call her...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Yeah, give her my harp, will you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "Tell her... No, I guess you can't talk.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "This isn't a goodbye.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "text": "I'll go ask a question. Then, I'll tell her myself.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "High Inquisitor, are we planting explosives at the hill right now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "That is correct.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "On another note, I saw someone entering the chapel.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "She looks very much like that... outsider we met before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "So, High Inquisitor, who is she?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "An Ægir.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I heard she fought the Sea Terrors.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I'm surprised there are others who not only know about these monsters... but specialize in fighting them as well...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "If we blow up the chapel... Will she be affected?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "If we don't strike the evil at its root, even destroying this place won't accomplish anything.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Is that so? So we still have to find out who caused this phenomenon... And you don't know who it is yourself, High Inquisitor?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "You may not ask anything that has nothing to do with the mission.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Understood...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Also, while I'm aware you don't mind, I have to say this nonetheless... The load-bearing structure of this block probably won't withstand the intensity of the explosion.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "The southern half of the city may crumble any moment, and the inhabitants here still don't know anything about this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Proceed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Uh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I want to evacuate the inhabitants.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I mean, to you, they may seem peculiar and problematic...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "...and also things that need to be cleansed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Inquisitor!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Uhh...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Tell me! What is your responsibility?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Yes!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "'For Iberia's prosperity, for Iberia's defense, and for Iberia's orderliness and integrity, I shall raise my sword and my light!'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "In that case, you must lay down your judgment for these men!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "You want me to... lay down judgment? To sentence them to death?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "High Inquisitor, when was the last time you listened to a song? Your records have all gone bad, haven't they? Your player has been gathering dust for a long time too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I heard that song. I heard the song the Ægir was singing for these people.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "That's the kind of song that Iberia should have had.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Before we kill them, I want to know the truth. Just like you were trying to find who is behind this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Perhaps they will still mutate, but when that time comes, I will cleanse them myself, but I would like to evacuate them right now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "High Inquisitor, if I have your permission, I will evacuate everyone right away!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Is that your decision?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I don't know!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Irene, you are not just laying down decisions for those you see in front of you. Your decisions affect much more!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "By sentencing the monsters to live, you also sentence the citizens to die!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I understand! I've already made decisions like this one countless of times!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Your judgment can mitigate disasters or portend ill omens! You may kill hundreds merely to save one!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I understand that, Sir!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "What's at stake behind this deal, the clashes between morals and scriptures... I understand it all!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "That isn't what I'm asking you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "What I'm asking you, Irene, is if you can truly bear this responsibility.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "If you bring them great pain, then you too must bear this pain as well, and it will be far graver than the sins you inflict on others combined.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Do you have the courage? Will your beliefs remain steadfast when your heart is tormented? If you fail, are you certain you can stay unflinching when you witness the outcome of your decision?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I can take it... and I won't waver.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "That's what I've been doing all along ever since I joined the Inquisition. I can do it. If what I do proves to be wrong, then let me receive the proper punishment. This is something I must do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "High Inquisitor! I—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Very well.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Hm...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "This will do. Do your duty, Inquisitor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "—Yes, High Inquisitor! I will evacuate the local inhabitants right away!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Also... The explosives left in the cabinet should be enough to level the whole of Sal Viento.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "That's right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "So...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "If it comes to it, I will override your judgment.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "Right...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor Irene",
      "text": "I'll get going now.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "text": "Who is it?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Hello, High Inquisitor.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "text": "Oh, look who's here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bishop",
      "text": "Welcome, wandering singer.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
