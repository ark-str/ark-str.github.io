    {
      "type": "dialogue",
      "speakerName": "Flametail Knight",
      "speakerToken": "avg_npc_122",
      "operatorId": null,
      "portraitKey": null,
      "text": "Man, you're getting better and better at talking all the time. Where'd that 'Ashen Curse' go again?"
