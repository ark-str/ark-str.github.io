    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "D.D.D.",
      "speakerToken": "avg_NPC_017_3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oooh, Round 1 of the championship has begun, and the highly anticipated LUNG wRATh has had three other teams cooperate to target them!"
