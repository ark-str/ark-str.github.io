    {
      "type": "dialogue",
      "speakerName": "Lin Yühsia",
      "speakerToken": "avg_npc_196_1#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "And avoid working together. It seems we have yet another common understanding."
    },
    {
      "type": "dialogue",
      "speakerName": "Lin Yühsia",
      "speakerToken": "avg_npc_196_1#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "However, before that. We're already being watched."
