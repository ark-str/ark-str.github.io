  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Ugh... Gahh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Those Reunion goons... sure are energetic!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Who are you people?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Why are you in Chernobog at a time like this?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Huh? Wh-what's going on--",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Are you spies?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "(If our identities get revealed and the Ursus government starts to keep an eye on us, the consequences would be unfathomable!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "(If it comes down to it...!)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Sir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "... A little girl?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "You're... an Infected?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Stop right there! Put down your weapon!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "(Be ready to back her up. If they show any signs of hostility...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "(Smoke? Where did it come from...?)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Sir, surely you understand that we have a common enemy!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Dobermann!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Defenders! They're attacking!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Wh-what?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Reunion... they're here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Amiya, be careful...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "She's on a completely different level compared to those ordinary thugs!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Hmph. Trying to run...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Where do you think you're going?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Go. Tear them apart.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Even her minions seem like they're well-trained...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Could she be Reunion's ringleader?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The haze is getting thicker and thicker... are they planning to utilize it to launch a surprise attack?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Sir, we have to evacuate immediately!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "If they manage to cut off our escape route, we'll all...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Get lost, Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "I was tasked with defending this street.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Rabbit, I don't care why you came here or what you plan to do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "If you plan to ruin our city, know that someone will come after you. The rage of Ursus is never-ending.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "If not, then what happens here is none of your business.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "... I understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Everybody in Ursus knows to never turn their back to the enemy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Now scram! We don't have time to deal with you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Thank you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Dobermann!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Hurry! Let's get to the first rendezvous point!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "All teams, move out! Quick!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Come at us, Infected filth!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ursus Captain",
      "text": "Is that all you're capable of? Are you just going to stand there staring at us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "All Chernobogians...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Must die.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
