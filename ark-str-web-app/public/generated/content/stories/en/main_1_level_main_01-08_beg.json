{
  "server": "en",
  "storyId": "main_1_level_main_01-08_beg",
  "groupId": "main_1",
  "stageId": "main_01-08",
  "title": "Resolve",
  "storyCode": "1-8",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_01-08_beg.txt",
  "sourceHash": "73860a20a5cea197182cb1f4bffd969ef046a85e5898fa3ed60dec37a0b3d565",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十一关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Amiya, take the Doctor with you."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "...Go, now!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No! I won't leave you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Surely, you can feel it as well! She... If you don't leave, the entire rescue team will die here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "That Talulah..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "She is a living monster! Amiya!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We'll be fine, as long as we stand together!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "What about the Doctor, then? Can you ensure the Doctor's safety?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "... Hm..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Team E4, we will stay behind and hold the line!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "We must ensure that Amiya, Dr. {@nickname}, and the Medic teams escape safely!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "No, my squad will handle this."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Ace! Be rational, now's not the time to argue over this!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "I am rational."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Surely you can see it as well - everything around her is melting!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I'm not going to leave you all here to fight alone."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Rhodes Island... won't abandon you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Amiya, time is of the essence! You have to escape!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "...You should trust me."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I can't bear to see Rhodes Island sacrifice anyone!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Think about our goal! Think about what we came here for!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "This isn't the time to talk about that still!"
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "--? The heat... is concentrating in her hands?"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "Is she... distorting the space around her?"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "No, that's... the superheated air around her!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Watch out! She's getting ready to use her Arts..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No... You can't! Nearl!! Come back, now!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "That's not her... You'll be killed if you--"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "... Silence."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Uaaaaagh...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Ugh... Gahh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Nearl!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "*cough*... Stay back! Don't worry about me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "It's just... a little warm..."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "What are you saying... don't worry?"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "You don't have a single intact piece of armor on you, and you're telling me not to worry? !"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "You mustn't fight her anymore!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "I already said... Stay back!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Nearl! You stubborn son of a...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "... Hm?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Get down!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "*cough* *cough*... What is it this time!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "... Invisible flames just swept over our head."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Fall back. This entire block is melting..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Don't sacrifice yourself in vain!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Just what monstrosity am I fighting against?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "We have to interrupt her casting somehow..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Snipers, take aim at the enemy!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "Resistance will usher hope into this land."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "But resistance... will not change your fate."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Fire!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "Chernobog has already attained liberation."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "Our work here is done, and your group has proven to be quite interesting."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "What..."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "However, that is all you are worth."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "You have chosen poorly."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "Rhodes Island, you should have stood firmly with the Infected."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "What's... going on?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "Why is the entire plaza... getting scorched?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "What... happened... just now...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "I... I can't breathe... it burns..."
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "Rocks, bolts, arrows..."
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "They're all gone."
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "In a heartbeat... every object around her has been reduced to nothingness..."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "You have the resilience of liberators."
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "... Not even ashes remain..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Amiya. You know what must be done."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Someone... has to stop her."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "...But I grow tired of this."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Amiya!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "This is the price you must pay for slaughtering your fellow Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "I shall grant you an ending that I am quite fond of."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "...Disappear."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Damn it!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Run... hurry!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "That amount of heat, at such a scale... No, no!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Protect Amiya and the Doctor! Quick!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "We won't make it...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "I'll block her!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "AAAAAGH!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "...Huh???"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "A-Amiya?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "You will not hurt them."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#9",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I will never... allow you to do that!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "-----Oh?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#9",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Ngh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#9",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I must... protect everyone...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Amiya is holding back the enemy's Arts... all by herself...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "It's no good... That power is too tremendous!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Even Amiya won't be able to..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "She won't be able to hold out for long!"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "Amiya!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Don't worry... Don't worry about me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I can handle this...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I want to... I must... protect you all!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "Dark matter... is sealing the enemy's Arts within the plaza..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#9",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Ngh... Argh... Ughh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "H-her barrier is catching on fire!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Amiya, stop!! Your ring will--!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I don't care... even if..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Doctor, I'm sorry..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Even if this brings disaster, even if I...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I don't want to lose... the person dearest to me... ever again..."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "Heh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "Very good."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Aghh... Aaaaaahhh...!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Amiya!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Damn it... We're going to lose her...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "What are you doing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Destroying that she-dragon's Arts!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "You..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "... 'O Light of Kazimierz, the Radiant Knight offers her body to thee...'"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Doctor! Just go! We'll help Amiya, but you have to..."
    },
    {
      "type": "dialogue",
      "speakerName": "Talulah",
      "speakerToken": "char_011_talula_1",
      "operatorId": "char_011_talula",
      "portraitKey": "char_011_talula",
      "text": "--!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#9",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Aaaaaaaaghhh!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#9",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "What...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_002_amiya_1#9",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "That's enough, Amiya."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#9",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "--?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "You've done well."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Let us share your burden."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Amiya!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Dobermann, take her with you. I'll see you soon."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "...Ace..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Ace... No... Ace...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Promise me... that you'll..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm sorry, Dr. {@nickname}. You might not remember me."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But I remember you, and I know what kind of person you are."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "... There will come a day when you and Amiya will face this cruel land together."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That is why... you must cherish her, Doctor."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Let's go."
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Godspeed."
    },
    {
      "type": "sceneBreak"
    }
