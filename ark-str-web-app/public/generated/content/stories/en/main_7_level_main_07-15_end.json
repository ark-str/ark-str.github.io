{
  "server": "en",
  "storyId": "main_7_level_main_07-15_end",
  "groupId": "main_7",
  "stageId": "main_07-15",
  "title": "Aegis of the Infected-2",
  "storyCode": "7-17",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_07-15_end.txt",
  "sourceHash": "bd2988381456e6fd915399878d38f20af267d4b5c93fc1032fe4fd106e40fafd",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Runner Three, down!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rosmontis",
      "text": "Runner Seven, destroyed!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Runner Eight, intercepted.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Raidian, execute the feint! Use your Arts to extend or hit their nervous systems directly!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Pull all the enemies!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "*Pant* *pant*... so tough. Is everyone okay?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "No problems yet... But... it's really intense. I've never seen combat on this scale before...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "I'm due for a vacation if I make it back from this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Right. I'll approve it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "But first... let's knock out this team! Then if you want a raise, a vacation, a specific assignment, I'll grant anything!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "Incoming!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "Don't get distracted! Back in formation!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "A major firefight by the east exit? Stay calm, push ahead slow. Don't give them an opening!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "These don't look like Ursus or Yan tactics. What's going on? Who are they?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "After picking off Ursus soldiers for years, now we get ambushed?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "No actual fighting...? Cowards! You'll pay for underestimating the guerrillas!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "Watch the altar! The protection the Captain gave us only mitigates its effects. He told us a million times not to go near it unless we have to!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "Runner, get the other teams on the horn.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "...No response?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "Where are the mortars? And the devils?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guerrilla Fighter",
      "text": "Hold on. Something's not right.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rosmontis",
      "text": "Runner Twelve, destroyed!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "The guerrilla fighters are closing ranks! Now's our best chance to break through!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "No! It could be a trap!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...Hmm..",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Roger. Rosmontis, let's scan the area with our Arts.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "I can't reach it. The enemy... is blocking me somehow.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Sarkaz casters. They're the only ones who could interfere with Arts like Rosmontis's.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Then it's up to me...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Raidian, how long can you keep it up?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "...We'll be quick.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I... I found them. Yes. They have a lot of snipers and casters hidden in those buildings.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "They're calm... some agitated. But they're not fanatics. They're... fortifying that point.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...Duty.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "The Doctor is right. It's a trap.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "I'm nearby. I'm coming.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Can you do it?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Yes. I won't smash the whole building. I'll just destroy the level they're on, so they won't bother us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Amiya, I can do it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Right, Rosmontis... I know you can. Definitely.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "...Amiya, will you p'ei fu me then?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Err? What?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "I heard Blaze say there aren't many people who can make you p'ei fu them.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "P'ei fu? Oh... does that mean 'respect?' Sorry, I'm not so good with the Yan language. I'm pretty sure that's what it means?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "I don't know, Amiya...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...Doesn't matter. Because I've always 'p'ei fu'd' Rosmontis.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "You're amazing, really. I couldn't do what you do...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I couldn't bear that loss and loneliness.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "There's no way I could live with it like you do, suffer through it like you do.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "You're lying.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "But it doesn't matter to me. Even if you're a liar, you're still Amiya to me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Someone could... p'ei fu... a person like me?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "It's like you just said, Rosmontis. You're Rosmontis, so I respect you. As both an elite operator and a friend.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Keep at it, Rosmontis.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Okay. We'll keep at it.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Where are they? What are they waiting for?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "N-No! We can't leave the area! We strike as soon as they show their faces! No one else falls out of contact!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Hey, is that an enemy on top of that building over there?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "...A cat? Just one little Feline...?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Runner! Tell the casters! The enemy deployed a caster on the building across the way!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "We've gotta take her out!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "—A sword? A weapon? She's pulling them out of the air...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Huh? Floating weapons?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Slice from here, to there.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Hold it... with my hands. Cut, with the sword.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "...Like slicing a potato.",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "Like slicing a potato."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Doctor! Get over here!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "The whole building... got cut in half?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Rosmontis is destroying the guerrillas' ambush point. Watch for falling debris!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What the hell was that?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Assuming you're talking about Rosmontis's Arts, it may be time to explain it to you, now that you've seen it so many times.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "It is a state of mind she shapes herself. You can think of it like Rosmontis has a gigantic, second, invisible body that cannot be acted upon.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "It is a formless extension of her sense of touch. She can grab, squeeze, lift up, and toss away.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "But these Arts lack objective manifestation, as opposed to her subjective mind.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "It can act upon us with force, but we cannot act upon it. We only know it exists with the application of special Originium Arts.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "You need not grasp it fully. This is not your area of expertise.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Rosmontis was much more destructive before we put a weapon in her hands. A lot like being crushed beneath the treads of a nomadic city. All that's left is a crying young girl alone in the ruins.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Under no circumstances can that be allowed to happen again.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "...Doctor, move.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "I see it. The command group is coming...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "There should be a waterway under the ruins of the park fountain.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "They hid in such an inconspicuous place.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "...The story of the ambush on Graymane Peak, that supposedly involved seven straight days of stakeout and tricked the strongest of knights, may well have been true.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Let's go, Dr. {@nickname}. No time to lose.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Raidian, cease fire. Find a good place to hide. I need you to focus on keeping our comms up.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Mantra-2, log all our conversations. Every last word.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Runner Group Fourteen, successfully intercepted.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Amiya, Dr. Kal'tsit, I'm ready.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "(Are you okay...? Talk to me! Look at me!)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "(Good, you're with us. I'm okay. Doesn't matter. You hide somewhere, don't let them find you... we need you to regroup.)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "(I know. We'll get them. You stay quiet!)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "(I'm fine. No injuries. A little stone is nothing compared to an Ursus Fortcracker.)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "(Don't panic! I can stop it, you look for an opening!)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "You! What are you looking at?! Too scared to fight us?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Whoever you are, you lost the guts to take us on now? Too scared of Patriot's blood? Scared of his witchcraft?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Thinking back to the time you fought the Sarkaz? You had them outnumbered, you could've won, but in the end you just ran up the casualties!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "But we'll do you one better! You can't break our shields, you can't crack our armor! You're nothing before the undying Patriot!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "The mightiest Ursus warrior... needs no spear or shield. He'll stomp you to pieces.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "You... are nothing!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Our fighters will regroup here soon! You can't run. Reunion will put you through hell!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Oppressors who enslave the Infected like us! You will be swallowed up by the Reunion movement!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Reunion—",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...Reunion already betrayed you, sir.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "—Little girl?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "...Two... Infected little girls?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "What are you doing?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Out of the way.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "There's a man behind you, and I'm going to break the device behind him.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "You think I'll show you mercy just because you look like a kid?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Don't underestimate Patriot's Guard! We're the Aegis of the Infected... I'm here to stop your attack.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "If you attack the Infected, I'll strangle you with my own two hands!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Then my weapons will talk for me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "You... You're the cat from before.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Your sword...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Runner",
          "text": "(Get out of here, guardian! Tell the others! I'll be okay!)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "(That's your job, not mine! You have to survive!)",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Guerrilla Fighter",
          "text": "Come, try to pierce my shield! Try to break my armor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rosmontis",
          "text": "Amiya. I'm out of options.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
