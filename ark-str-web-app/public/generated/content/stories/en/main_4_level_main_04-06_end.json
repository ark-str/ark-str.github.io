  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We've defeated Reunion's forces!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Bah. For a bunch of roadblocks, these guys were a bit tough."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "There's no sign of Ch'en."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We're in a real mess now..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "She's not responding to my calls either! Tsk... This part of her hasn't ever changed."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "L.G.D.! All members, prepare to follow me--"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No, Inspector Hoshiguma."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "You should let us handle it."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We're approaching the Originium-dense zones left by the Catastrophe..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "If you go any further, the healthy risk being infected by Oripathy."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "These consequences are too dire."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Furthermore, as Infected..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Hah. Given your small stature, it's cute when you try to give serious speeches."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Eh? Huh?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Hahaha, I was just giving you a hard time."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "But you don't have to persuade me. I understand your concern."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "L.G.D.! We will be Rhodes Island's shield!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Block the entrance, and don't let a single Reunion member enter or exit!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "We'll let the experts handle this problem!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Inspector..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Oh, just call me Hoshiguma."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Go. Please take care of Ch'en."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Make sure you bring her back with you in one piece."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I will, Hoshiguma...! I swear I'll bring Madam Ch'en back safely...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Make sure to stay safe yourselves."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Okay!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Doctor, please follow me."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Rhodes Island, let's go!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "(Wait for me, Madam Ch'en...)"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "(Frostleaf, Meteorite, Jessica...)"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "(You have to stay strong!)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "We've retrieved the recon team that we were last in contact with."
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "It's... looking really bad..."
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "speakerToken": "char_003_kalts_1",
      "operatorId": "char_003_kalts",
      "portraitKey": "char_003_kalts",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "speakerToken": "char_003_kalts_1",
      "operatorId": "char_003_kalts",
      "portraitKey": "char_003_kalts",
      "text": "Rubor, hypothermia, and necrosis..."
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "speakerToken": "char_003_kalts_1",
      "operatorId": "char_003_kalts",
      "portraitKey": "char_003_kalts",
      "text": "What's going on here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Wounded Operator",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ngh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "speakerToken": "char_003_kalts_1#3",
      "operatorId": "char_003_kalts",
      "portraitKey": "char_003_kalts",
      "text": "Completely frostbitten...?"
    },
    {
      "type": "sceneBreak"
    }
  ],
