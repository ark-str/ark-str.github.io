  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We've defeated Reunion's forces!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Bah. For a bunch of roadblocks, these guys were a bit tough.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "There's no sign of Ch'en.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We're in a real mess now...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "She's not responding to my calls either! Tsk... This part of her hasn't ever changed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "L.G.D.! All members, prepare to follow me--",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "No, Inspector Hoshiguma.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "You should let us handle it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We're approaching the Originium-dense zones left by the Catastrophe...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "If you go any further, the healthy risk being infected by Oripathy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "These consequences are too dire.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Furthermore, as Infected...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Hah. Given your small stature, it's cute when you try to give serious speeches.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Eh? Huh?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Hahaha, I was just giving you a hard time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "But you don't have to persuade me. I understand your concern.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "L.G.D.! We will be Rhodes Island's shield!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Block the entrance, and don't let a single Reunion member enter or exit!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "We'll let the experts handle this problem!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Inspector...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Oh, just call me Hoshiguma.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Go. Please take care of Ch'en.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Make sure you bring her back with you in one piece.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I will, Hoshiguma...! I swear I'll bring Madam Ch'en back safely...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Make sure to stay safe yourselves.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Okay!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Doctor, please follow me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Rhodes Island, let's go!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(Wait for me, Madam Ch'en...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(Frostleaf, Meteorite, Jessica...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(You have to stay strong!)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "We've retrieved the recon team that we were last in contact with.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "It's... looking really bad...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Rubor, hypothermia, and necrosis...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "What's going on here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wounded Operator",
      "text": "Ngh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Completely frostbitten...?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
