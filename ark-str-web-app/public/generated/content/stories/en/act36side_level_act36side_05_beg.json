{
  "server": "en",
  "storyId": "act36side_level_act36side_05_beg",
  "groupId": "act36side",
  "stageId": "act36side_05",
  "title": "Tipsy Merriment",
  "storyCode": "DT-5",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act36side/level_act36side_05_beg.txt",
  "sourceHash": "cff9c3d2e59dbb3ce9da4d6bc889393e53ef3aba49d33b7c4de19cee328c100f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Five, four, three, two, one..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There's the bell! Let's go!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Marcille, on your left!"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hup!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Laios, front! Right!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hup! Hah!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Senshi, behind you! Left! Forward!"
    },
    {
      "type": "dialogue",
      "speakerName": "Senshi",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hooh! Hyah—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Front back front right left left right!"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Eyah—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Front back left front right left back!"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "HIYAH—!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*huff*... *huff*... That's all the ink spirits over here handled..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Much appreciated."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, don't mention it! We're happy to help with any of your troubles, considering the village agreed to take us in for a bit."
    },
    {
      "type": "dialogue",
      "speakerName": "Senshi",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll be off then. Promised to help plant some veggies out in the fields."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Senshi sure has gotten friendly with the locals."
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Is it not the same for you, Chilchuck? Uncle Zhang told me to invite you over for a drink with him after you finished with the ink spirits."
    },
    {
      "type": "dialogue",
      "speakerName": "Chilchuck",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "He just doesn't want to admit he can't outdrink me."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "May I come over for some tea today, Dawn?"
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Certainly, I am available if you are."
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's your turn to tell tales of your adventures, and I am quite looking forward to them."
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Though... I do recall that when you first arrived, you mentioned that you had to save Laios's sister."
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Are you <i>sure</i> you are alright with staying here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's true that our goal is to save Falin."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But..."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's not like rushing will help us find a way to leave faster."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "And I have to admit, life is good here."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We'll talk it over when the time comes. Right, Laios?"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm? Sorry, what did you say?"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I can't believe you weren't listening to me again!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*chuckle* Your passion for ink spirits is well-known across the village by now, Laios."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I mean, these 'ink spirit' slimes are just so interesting!"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "They have fixed forms with distinct heads, bodies, and limbs! Instead of enveloping their prey's heads, they attack like other beasts! They even vocalize!"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But the strangest part is how, unlike other monsters, they don't leave behind any kind of corpse, just some black water."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I told the villagers all about their weaknesses yesterday, but they didn't seem very excited."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That's because you're the only person who cares about that sort of stuff."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...Huh, is that so?"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But even Chilchuck's learned to exploit those weaknesses. The villagers can't seem to grasp them at all. Every time I see them facing ink spirits, it's like they have no idea what they're doing."
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh-gkh!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm starting to suspect they can even understand us..."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's odd. Senshi said they're not like slimes at all. Slimes have distinct organs, after all..."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright, alright, I get it."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm? Did some of them slip through?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hraaagh—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm? That one looked a bit familiar... It's got a mole on its face. Where have I seen that before?"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm pretty sure I killed the exact same one a few days ago. Why's it shown up again?"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What's going on here? ...Wait, could it have come back from the dead? I'm going to go get a better look!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Remember to be back for dinner!"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...*sigh* And he's not listening. As usual."
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Sorry he's like that."
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, it's fine."
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Anyway, do you still remember how long it's been since you arrived at P'o-shan Village?"
    },
    {
      "type": "narration",
      "text": "Of course I...\nHmm?"
    },
    {
      "type": "dialogue",
      "speakerName": "Marcille",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "How long <i>has</i> it been since we arrived?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait, wait wait wait... There's way WAY too many of you."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirits",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We might not have been here long, but we've been killing plenty of ink spirits every day. Who would've thought there'd still be this many left?"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There are so many of them here, yet there's no sign of fighting... Could they actually coexist peacefully?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirits",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't see any of their young, though."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Now that I think about it, I can't tell their genders, either. They're all adults too, no young or old. No matter how you look at it, it's no ordinary monster cluster."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm? Wait, where'd the familiar-looking one go?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Crap, that one spotted me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I've got to think of a way to stop it from calling over more! I can't take them all on my own—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh no, it's about to call out—"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Here, have some fruit!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh...haaa? Munch munch..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Munch munch..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What's that, you want more?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh, gkh."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "As long as you don't start shouting."
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Here, I was saving them as a snack, but... Look, just eat quietly, and come over when you're done. Then we can go around the back of this wall and..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're awfully well-behaved. What's going on here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Sneakily climbs behind the wall)"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Ready to pounce at apricots on the ground)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Apricots pounced! Proceeds to gobble up apricots)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It just attacked the village, but now it's docile over a few pieces of fruit?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Nom nom nom)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Bites onto Laios's pocket)"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm? What're you up to now?"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You attack the village, yet you don’t seem any happier when you win, and you flee when you lose. Now you're just snacking on apricots!"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You do fight over food, but it makes no sense to attack the village for it—there are way more fruits in the mountains. So why attack so often just for a few fruits?"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The villagers haven’t stolen your young or encroached on your territories, so where's all this hostility coming from?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait, isn't that the one with the mole from earlier?"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Take this!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Laios sends an apricot flying at the familiar-looking ink spirit, striking it right in the head with a 'pok!'"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "It staggers from the blow, but quickly recovers and raises its stubby arms to cover its head.\nBut that's when the sweet scent of apricot hits it."
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hruuh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Laios",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
