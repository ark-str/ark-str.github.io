{
  "server": "en",
  "storyId": "1stact_level_a001_05_end",
  "groupId": "1stact",
  "stageId": "a001_05",
  "title": "Different Opinions",
  "storyCode": "GT-5",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/a001/level_a001_05_end.txt",
  "sourceHash": "49dbde6d0e09276e5bc92feb4a0b2005f9bfc3d7dcb7e0a509f4d7a6f8596a5f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Gah...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "You... You meddling brat!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Your head's practically split open, just do what's good for you and get out of our way!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Heh, this is nothing. I've been through worse in my daily training!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Guh—"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "How many of them are left...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Forget it, I lost track. As long as they don't make it inside..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "E-Earthquake?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Huh? Is that an avalanche over there? Why though?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "You've gotta be kidding... She can even smash through a stone wall that thick?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "A new entrance opened up over there! Hurry, let's go in there!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Damn it, those guys are definitely going to swarm in through that new passageway Skadi just created!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "I have to find Carol—"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Stop right there."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Skadi..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Unbelievable... Not even a mountain can stand in her way. Those rumors really were true."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Where's the girl?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "I'm not telling you."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "I'm not the only one after that... thing."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "You ought to cooperate before I'm forced to do things the hard way."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "I can't just hand Carol over to you if you don't tell me what's going on!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "So... you intend to impede a mission from Rhodes Island?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "What mission? You didn't even tell me anything about that!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Unless you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Hey, don't just start swinging at your comrades!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "I'm not your comrade."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "This is your last chance. Take me to see that girl."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "No chance in hell. My mission is to keep her safe."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Aaaaghh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Damn... All she did was tap her sword against my lance, but it feels like my arm is about to snap..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Do you think you can really protect her with abilities of this caliber?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Whether or not I can... has nothing to do with whether or not I will!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Huh? Wait a second!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Watch out!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Tch, that ought to have done the trick!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yeah, we... no, we didn't get her?! She's still unscathed!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "...You again?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gah...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "The l-living Catastrophe! You're the one who hurt the captain! We can't let you leave alive—"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#3",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Now's my chance!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't you even think about it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#2",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "You guys really should worry about holding her back first!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "...Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "What just happened?! That kid just vaulted over our heads?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#2",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "See you later, Skadi!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "You..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#2",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Sorry! When you're ready to explain to me what's going on, maybe then we can talk about Carol!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Stop, get back here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#3",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Sorry again!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "How could you just let her go like that?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "She's too fast for us to catch!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Whatever, let's just deal with this one first."
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "With how much bigger you are, I bet you can't leap over us."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "char_263_skadi#2",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "...You're all dead."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "It really is like a maze in here with all these winding paths. Carol was right."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Hmm? What's a bounty hunter doing here—"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ugh... save me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Poor guy..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "He looks like he got pummeled a few times..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "B-but Skadi is still outside the cave, right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "What's this opening? It looks like the wall was blasted open..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "That must mean—"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "You already figured it out."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "avg_npc_010#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "avg_npc_010#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm a pretty good actor, right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "So it was your doing..."
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
      "operatorId": "char_220_grani",
      "aliases": [
