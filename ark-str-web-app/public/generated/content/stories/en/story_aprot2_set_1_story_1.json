{
  "server": "en",
  "storyId": "story_aprot2_set_1_story_1",
  "groupId": "story_aprot2_set_1",
  "stageId": null,
  "title": "The Play That Was",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_aprot2_1_1.txt",
  "sourceHash": "3857e1c89b3a11a3c1c7171d30c1e3e4ebe2321f6b4a5f36c67af98cc1d8f0f0",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "The sky is a strange color.\nThe sun is dark. The clouds are gray. The sky begins to split in the distance, the crack spreading along its center.\nBut all this is no longer important.\nYou remember this day.\nYou can never forget it.\nIt is like a prophecy destined to come true, one known by everyone.\nIt is like a nightmare that can never be shaken, always entwining.\nYou cannot tell if this is just a play.\nPerhaps your entire life is just a play, in the eyes of another.\nAbyss.\nYou ask yourself.\nThe actor on the stage must follow his script. But what about you?\nWhat choice will you make?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "I can't do it.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "Don't show mercy, Abyss.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "The others would still be alive if I hadn't screwed up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "You have a chance to make things right. Bring back my head and—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Shut up! Don't make me regret this!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Don't show mercy?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Then what am I supposed to do?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "I'm supposed to kill you, take your head and bring it back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Bide my time, wait for the chance to take revenge...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "No, that's not right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "...Take this.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "Your dagger...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Take it. Go.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "Abyss!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "What are you going to do, then, if you let me go?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "You made your choice, once again.\nYou know what you have to do, don't you?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kind Villager",
      "text": "Thanks for taking care of the kids for the past few days, young man.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kind Villager",
      "text": "They say you're a great storyteller!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "You're welcome, sir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "They're all good kids. We should be the ones thanking you for giving us a place to stay.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kind Villager",
      "text": "Oh, no, no, it was no trouble at all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kind Villager",
      "text": "I'll leave you to your work, then.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Telling stories to children?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Looks like you're getting along well with the villagers.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Doesn't take much effort to move your mouth and tongue.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Well, it takes patience I don't have.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Things have been calm here, too calm. The mission's going too smoothly. I'm not used to this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Calm isn't bad.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Certainly better than running into unexpected trouble...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "I know, I know, your dream is to retire quietly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Oh yeah.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "I have a gift for you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Oh? What is it?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "A round object falls on the ground before you.\nIt is slightly rotten, and makes a dull thud as it lands.\nYour 'gift' rolls along on the ground, stopping at your feet.\nThe gaze of its lifeless eyes meets yours."
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "I brought his weapon back, too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "This is yours, isn't it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "But... why...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "The one you let get away.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Suddenly, the past catches up to you, just when you thought you'd finally escaped it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "It was the right decision to not kill him, Abyss.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "The right decision?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "It makes the script even better.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "What's the matter, Abyss? Isn't this the script you wrote for the troupe?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Script...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "No, no!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "I have nothing to do with the troupe! I ran away from it a long time ago!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "This isn't a script! It can't be!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "No...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "It was my own choice...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "What choice?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "What are you talking about, Abyss?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "It was... my own...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "It was right that I didn't kill you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "No, no.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "I don't know what's vexing you, but the best way is to kill me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "No need to take risks. Just carry out the plan—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "No!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "There is no plan! It's not time for you to die yet!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Go! I'll come with you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "We can all get out. We just need to be careful this time... don't get caught...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "Calm down, Abyss.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "I can't escape. It was enough that I got to see you in the end.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "What are you doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Stop! Stop!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "I can't let get you into trouble.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "...Tell me you're joking.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Silent Man",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Get up! Stop acting!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Get up! We need to go, or it'll be too late!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Silent Man",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Say something!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "There's no other way, Abyss.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "Kill me and take my head back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "Do you hear me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "Kill me! We don't have time!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Kill you?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Put my dagger in your heart like this, and watch you die?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "Yes, that's right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sad Man",
      "text": "You made the right choice, Abyss...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Did I?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Was it really my choice?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Ha... haha...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "You'll die. I know you'll die.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Your head will inevitably be separated from your neck. I just hope it won't have to fall into the dust and dirt.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "That's why this time, I'll cut your head off myself.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Is that your prophecy, Abyss?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "I'm not a prophet. I just saw it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "I saw you die. You'll die, even if I let you go.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "I ran, but I could never get away.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Of course you can't.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "You'll never escape their eyes, no matter how well you hide.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "...Who's watching me?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "The audience, of course.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Audience... audience?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Why are they watching me? If I screw up, all they'll do is get rid of me.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Certainly, there are those who are angry at your docile performance on stage. But that's to be expected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "We all know this is where the allure of art truly lies.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "A good play with good actors should be able to move people's emotions, don't you think?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "No... that's not what it is! It can't be!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "It was my choice to let you go! It's not their will!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "If you're really sure about that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Then why are you still trapped in this nightmare?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Why does that day keep repeating itself, even though you've already escaped?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Why do you keep trying anything you can to detach me from that body and bring me back with you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "I...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "You're afraid, Abyss.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Letting me go was your first and only act of defiance.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Running away from the troupe took all the courage you had.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "The Blood Diamond had come for you, but all you could do was hide.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "You were always more afraid of this all being part of some plan than of actually getting caught.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "You don't like being seen, because you're afraid that your 'true self' doesn't actually exist here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Head",
      "text": "Am I wrong?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "Shut your trap.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "You're just a phantom in my dreams. You don't exist!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Abyss",
      "text": "And don't call me Abyss.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Don't call me by that name!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Broken Skull",
      "text": "Poor thing. You couldn't kill your fear. You couldn't silence your doubts.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broken Skull",
      "text": "You know it's anathema to seek the self.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broken Skull",
      "text": "But it can achieve great art!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broken Skull",
      "text": "Even now, you continue to contribute to the stage! They were wrong about you. You're a great actor!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Shut up! I'm not acting!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I'll free myself from you. I'll kill you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I won't go back on stage. I'm not Abyss. My life is not a play!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Broken Skull",
      "text": "You and your tiny, tiny resolve.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broken Skull",
      "text": "Then let me ask you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broken Skull",
      "text": "Who are you, if not Abyss?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I'm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I am—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "...lem?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Shalem?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shalem",
      "text": "—!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shalem",
      "text": "I... I'm here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shalem",
      "text": "Sorry, I was distracted... did something happen?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "What were you daydreaming about?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Not that it matters. It just sounded like you were talking to someone, so I came over and saw you staring into space.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shalem",
      "text": "...You were hearing things. I'm the only one here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shalem",
      "text": "There's no one else.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Really? Guess I should get my hearing checked.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Oh yeah, ■■.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "■■",
      "text": "What did you just call me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Huh? ■■.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "What's the matter? Isn't that your callsign?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Never mind that. Look—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "I have a gift for you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "■■",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "■■",
      "text": "A gift?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
