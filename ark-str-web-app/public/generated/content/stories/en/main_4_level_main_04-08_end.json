  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerId": "char_193_frostl",
      "text": "I know it's you behind there. Hold your fire."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerId": "char_193_frostl",
      "text": "Look who I brought."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Meteorite, it's us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "Who? Is that.. Amiya?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "Amiya! Amiya, you really came!"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "It's so good to see you..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "...but you shouldn't have come. This whole thing is one big trap."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "It wasn't worth it for you to come to our rescue."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "This was the wrong decision...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerId": "char_193_frostl",
      "text": "There's no point in blaming her now."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerId": "char_193_frostl",
      "text": "Besides, even if everyone else doesn't think you can be rescued, Amiya would still not give up on you."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "I wasn't blaming her! It's just that..."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "Tsk. Sorry, Amiya."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "It's okay. I'm just glad to see that you're all still safe."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "Amiya..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "But... what happened to Jessica?"
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": null,
      "text": "Ugh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "She's... still in shock."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "Originally, I wanted to wait for her to get better, but..."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "It seems like she's been... traumatized."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Jessica, are you okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "This is all I can do..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Frostleaf, do me a favor. Place her hands on my arm, and hold her fingers tight."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerId": "char_193_frostl",
      "text": "...Sure thing."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Good."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "...!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Ngh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerId": "char_193_frostl",
      "text": "Amiya!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_193_frostl",
      "text": "I'm fine! It's just... Nnh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_193_frostl",
      "text": "Such deep sorrow..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_193_frostl",
      "text": "It's a bit vague, but..."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": "char_259_Jessica",
      "text": "Jessica!!"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": "char_259_Jessica",
      "text": "It's fine now..."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": "char_259_Jessica",
      "text": "You have to be strong, Jessica...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "...Amiya...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "I'm here."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "Amiya... Amiya..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "There, there... Everything will be okay."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerId": "char_219_meteo",
      "text": "Jessica... Are you alright...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "Amiya... What was I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "...I'm so sorry... I didn't think... I didn't think that..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "It's fine now..."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "Those, those... Auugh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "I know what it's like."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Yes, I've also experienced it..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "...Wanting to run, but your legs not moving..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "...Wanting to scream, but your voice not coming out..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "I understand what you've been through, Jessica... I've been there too."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Try standing up."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "You don't need to be afraid anymore..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Because we're all together now. You're not alone. We'll always be there for you."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Let's go back to Rhodes Island together."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Franka and Liskarm are waiting for you."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerId": "char_259_Jessica",
      "text": "...Mhm!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerId": "char_193_frostl",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerId": "char_193_frostl",
      "text": "Amiya... You... what did you do just now..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Shh... Keep it a secret from Dr. Kal'tsit."
    },
    {
      "type": "sceneBreak"
    }
  ],
