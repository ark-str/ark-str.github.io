    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerId": "avg_1021_kroos2_1",
      "text": "Oops, my bad—"
    },
    {
      "type": "dialogue",
      "speakerName": "Miss Du",
      "speakerId": "avg_npc_296_1",
      "text": "—You're from this afternoon—"
