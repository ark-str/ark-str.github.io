      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "Now that I think about it..."
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "I've only used these Arts once before."
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "'Wherever there is blood...'"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "Hah."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "So you want to use your ice... to counter mine?"
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "Nnh...!"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "How will you do that if you can't even use your tongue anymore?"
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "You..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "Yeti Squadron, spread out."
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "Roger."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "My brethren..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "Flush them out, and freeze their blood."
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "Understood."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "'...Your mind can hide nothing from me.'"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "An incantation?"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "The rabbit of Rhodes Island..."
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "Black... lines? ...What the hell is that?"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "Wh-what kind of Arts is that--"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "W-wait, why is that thing... worming past our barriers? !"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "Don't--"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "...Aaaaaghh!!!!"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "M-my body! It's on fire...! It's burning!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Meteorite!"
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "speakerToken": "char_219_meteo_1",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "I know!"
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "speakerToken": "char_219_meteo_1",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "Please, keep distracting them!"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "N-n-no... so cold...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "Nnngh... it hurts so much!"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_1",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "...Gaah... No, no more..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "...!"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "Hurry! Don't let them hurt our comrades any further!"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerToken": "char_1002_nsabr_2",
          "operatorId": "char_1002_nsabr",
          "portraitKey": "char_1002_nsabr",
          "text": "Understood!"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "Your Originium Arts... are very formidable."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "Nnh... aagh..."
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "Damn you... Get away... from me..."
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "Nnnh..."
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "speakerToken": "char_193_frostl_1",
          "operatorId": "char_193_frostl",
          "portraitKey": "char_193_frostl",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "I won't give you a chance to use your Arts, girl."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "Now, close your eyes and sleep."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "I'll put you out of your misery soon."
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "speakerToken": "char_219_meteo_1",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "Th-this witch...!"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "I take it that you're Amiya."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "...!"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "I like the look in your eyes."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "That is how a warrior should look."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "I'm sorry..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Why are you..."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "......♬"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "——♪——♬——"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "What's going on here?"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "——♬——♬——"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "...It's snowing?"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "......♪"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "'Sleep, my children. Sleep."
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "Hedgehog dolls and teddy bears...'......"
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "This strange melody..."
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "...She's casting her Arts!"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "'Sink quietly into black...♪"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "speakerToken": "char_1505_frstar_1",
          "operatorId": "char_1505_frstar",
          "portraitKey": "char_1505_frstar",
          "text": "...My broken puppets and dolls♬'"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Even more shards of black ice are appearing out of thin air?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Jessica",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "The ice shards are slowly falling onto the ground!"
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "Shoot, the ground is freezing wherever the shards fall...?"
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "The black ice..."
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "speakerToken": "char_219_meteo_1#3",
          "operatorId": "char_219_meteo",
          "portraitKey": "char_219_meteo",
          "text": "It's spreading...?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "The ice crystals are eroding everything around us!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#7",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Don't let her finish her song! !"
        }
      ]
    },
