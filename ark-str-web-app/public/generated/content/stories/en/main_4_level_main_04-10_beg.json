  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第四十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "The temperature... is dropping sharply?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "There's ice forming on the ground...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "It's so cold...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Unbelievable... even the burning effigy was frozen over....!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "The flames were put out... Dark clouds have covered the sky...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Aaahh...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Don't panic!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Jessica, Blacksteel operator!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Yes!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Stay in position!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Roger!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "What are you doing, Frostleaf?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "She's... draining all the heat from her surroundings!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I never knew she was able to affect such a wide area!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Heh... Master of the Yetis...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I've never met... anyone with a lower body temperature than mine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Frostleaf!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Meteorite... To be honest, I wanted to...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Distract her... and buy some time for you...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "You...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "But... my body... is completely frozen.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I can't... move my feet anymore.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Frostleaf! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Amiya, take them with you, and fight your way out of here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "In less than a minute, the enemy commander... will have frozen this entire square.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Don't make me die for nothing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Amiya... We can't... I won't leave her!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I won't leave Frostleaf behind.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I will not... leave anyone behind!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I'll hold off the enemy squads' movements.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Meteorite... I'm counting on you to bring Frostleaf back!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Roger!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Doctor! Please lead our squads!",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Way ahead of you!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "(Nod)",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Affirmative!",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "Now that I think about it...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "I've only used these Arts once before.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "'Wherever there is blood...'",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Hah.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "So you want to use your ice... to counter mine?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "Nnh...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "How will you do that if you can't even use your tongue anymore?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "You...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Yeti Squadron, spread out.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Roger.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "My brethren...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Flush them out, and freeze their blood.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Understood.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "'...Your mind can hide nothing from me.'",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "An incantation?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "The rabbit of Rhodes Island...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Black... lines? ...What the hell is that?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Wh-what kind of Arts is that--",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "W-wait, why is that thing... worming past our barriers? !",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Don't--",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "...Aaaaaghh!!!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "M-my body! It's on fire...! It's burning!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Meteorite!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "I know!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "Please, keep distracting them!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "N-n-no... so cold...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Nnngh... it hurts so much!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "...Gaah... No, no more...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Hurry! Don't let them hurt our comrades any further!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "text": "Understood!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Your Originium Arts... are very formidable.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "Nnh... aagh...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "Damn you... Get away... from me...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "Nnnh...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Frostleaf",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I won't give you a chance to use your Arts, girl.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Now, close your eyes and sleep.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I'll put you out of your misery soon.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "Th-this witch...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I take it that you're Amiya.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I like the look in your eyes.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "That is how a warrior should look.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I'm sorry...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Why are you...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......♬",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "——♪——♬——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "What's going on here?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "——♬——♬——",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...It's snowing?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "'Sleep, my children. Sleep.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Hedgehog dolls and teddy bears...'......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "This strange melody...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "...She's casting her Arts!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "'Sink quietly into black...♪",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...My broken puppets and dolls♬'",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Even more shards of black ice are appearing out of thin air?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Jessica",
          "text": "The ice shards are slowly falling onto the ground!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "Shoot, the ground is freezing wherever the shards fall...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "The black ice...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Meteorite",
          "text": "It's spreading...?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "The ice crystals are eroding everything around us!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Don't let her finish her song! !",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Rhodes Island, we're going all out!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    }
  ]
}
