{
  "server": "en",
  "storyId": "main_4_level_main_04-10_beg",
  "groupId": "main_4",
  "stageId": "main_04-10",
  "title": "Extinguished Flames",
  "storyCode": "4-10",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-10_beg.txt",
