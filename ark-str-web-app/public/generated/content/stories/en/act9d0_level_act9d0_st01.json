{
  "server": "en",
  "storyId": "act9d0_level_act9d0_st01",
  "groupId": "act9d0",
  "stageId": "act9d0_st01",
  "title": "Beg for Mercy",
  "storyCode": "DM-ST-1",
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/activities/act9d0/level_act9d0_st01.txt",
  "sourceHash": "cbef93749cca2403f47fe1b4a5e8a84d6b2fd7375f2b5b943f71255bc65ee6d1",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "background",
      "backgroundId": "bg_cher_3"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You're still pushing forward?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Without treatment, you're definitely getting infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Why would I believe a devil?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "A devil, huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "So many devils around me all the time, sometimes I forget we even have that word."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Gah, stop following us!"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I've been keeping my distance."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "And stop acting nice! If you're gonna kill us, just do it already!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Ru-Rublev, you really shouldn't provoke her..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Okay. We're going then."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Ignore her."
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "S-sorry!"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I don't care if I get infected! We don't need a devil's help!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...Um."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Uh huh..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "There's an abandoned hospital around here. Chernobog District Hospital."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Wanna know where it is?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Rublev...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Don't listen to her. She's trying to trick us."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Let's ditch her... quick."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "See that alley over there? You take that corner and I think we can get there in less than a minute!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Okay."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "——Run!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_cher_9"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "They're fast."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "H-How did she catch up to us so quick?! Agh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Rublev... your leg! Th-the blood is turning black..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Ugh, I could've outran her if I didn't have to save you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Sorry..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Whatever! Just be quiet."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Don't let her find us."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Head down that street, turn left, and you'll come to a ruined plaza."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "On the west side, that big white building, that's the hospital."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "The abandoned hospital."
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...I think... she knows we're here..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Because you don't listen to me——fine."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Hey, devil."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Why did you tell us that?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Felt like it."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "How do you two know each other?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I found him while I was out looking for food."
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Rublev saved me..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "And that's why you do what he says?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "No skin off my back. Whatever you want. But now it's time for you to help out your savior here."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "What are you gonna make him do?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Rublev..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Nothing. I told you, there's a hospital right over there."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I mean, Reunion isn't dumb, so they wouldn't waste perfectly good medical supplies... So if you wanna save your little pal Rublev, you're gonna have to steal."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "It's a bunch of Infected thugs over there. Thugs who murdered your family and friends."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "And that's the only place they'll have the drugs that can stop the onset of Oripathy."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "So go steal, rob, loot, it's all good."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Just don't expect anybody to help you."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "No! Don't listen to her!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "B-But..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "No?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "He knows your name, Rublev. Do you know his?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "What does that have to do with anything?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Don't go! You can't do it! There's too many——"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I——"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I... I want to try..."
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Rublev isn't the only one who got hurt in the Catastrophe..."
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "There's so much pain... I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Why aren't you listening to me?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "He doesn't have to listen to you."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "It's good that you wanna save those people."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Just keep that hospital in mind. They keep the supplies down in an underground storeroom."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You could get in through the vents in the parking garage, or through the sewers, as long as there's not too much toxic waste down there."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You could die there though."
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "C'mon, your legs are shaking! You can't do it! We were dumb to even listen to a devil in the first place!"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Let's get out of here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Eeep——"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Wh-What was that?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Some things went down in Lungmen... wiped some stuff out here too."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Why wouldn't folks have their eye on a perfectly good battlefield hospital here in Chernobog?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Why do you think... a devil like me would know that hospital so well?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Because you——Umm, ah——"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I... I..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "That must hurt like a bastard. I'm starting to think he's probably beyond help at this point."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "If you don't act soon.."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You might just die right here."
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Ah..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "You, ugh, what are you doing? Stay away from me!"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "To go?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Or not to go?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Oh... but what if it's already too late, even if you did go? There's a riot going on, it might be too hard to sneak in and grab the goods——"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I-I'm going."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "——Yeah... you're dead."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Why are you still listening to her? I'm the one who saved you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "But I... want to try..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "There's no way you can do it! We'll go to a drugstore, we'll find some food, that'll be enough!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "——"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I'm sorry!"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Hey... wait!"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "If you knew his name, maybe you could call out and stop him? Kinda sad."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "You... you tricked him! You devil!"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Tricked?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I haven't told a single lie."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "But hey, whether or not you believe me, that's your call."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Whether or not you believe him, that's your call too."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...I, I'm gonna go find him, nnggh..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Why?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "H-He can't do anything without me..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You're scared he's gonna run away."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You're thinking... why did he leave you alone with me? With a devil?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Am not!"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Suka! A monster like you——"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Shut up."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Wait here for him. Don't move."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Or I'll kill you."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Nnng——"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Who do you think I am?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I'm a killer."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I'm the killer who destroyed this city, hurt your parents and friends."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Ah... haha. That's right."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I forgot you had that blade. Look, it's got a Sarkaz charm on the hilt, and it's still bloody."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Whose blood do you think it is?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "*Whimper*... I, I don't know... you made him..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Go ahead and cry. Kids can cry."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "It's all up to you... whether you live or die."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "He can't do it..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You sure?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "If I hadn't dug him out of those ruins, he'd already be dead..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "He needs me."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Nope... nobody needs anyone."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Nobody does."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "This ruined city got quiet again."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "There's a lot less resistance, after that slaughter. That's a good thing. Less effort. Less death."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "But it's quiet over at the hospital too. Nothing moving over there, as far as I can tell."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "He... he didn't..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Maybe... he didn't actually go..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "It's been... Nng... so long..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "He ran away."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "But you saved him. Wouldn't he want to save you too?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...I..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Or maybe you're strong enough to save him, but he couldn't save you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "He... He can't do anything right!"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Like when we went looking for food! He couldn't even tell there was someone else in the store!"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "It's all his fault my leg got——!"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Where are you going?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I... I'm going home alone..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I already told you, you leave and you die."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "But he already ran off!"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Hah."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I can see it in your eyes. You hate him."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "N-No I don't!"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "But if... if he did go... it's been so long... he must be..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "——Shut up."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You won't know anything until he comes back."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You can sit here thinking he's coming back, or that he's not."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "But if you're thinking that he's not, if you're doubting him, hating him, that's on you."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "But you went right to thinking he blew it and ran off. Why?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Because you saved him? Because you're the strong one?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...*whimper*."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Waaahhh——"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You're still strong enough to cry."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Settle down. Give it a minute and you'll be in too much pain to cry."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You're young, you're not Sarkaz. So if can't take it anymore, you can tell me."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "I'll end it for you."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Wah... aahhh... waahh..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You're losing consciousness."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Ah well... guess he won't make it in time."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "No... I can still..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I'll wait... for him..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You've got faith in him again. That's because you're scared to die."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Kids are a good judge of character. You won't get this kind of stuff out of me."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "....Hnng..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "But he's definitely taking way too long."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Got maybe ten minutes."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Don't worry. If it comes down to it, I'm not gonna let a kid die in pain."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "...can't even whimper anymore, huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "What are you thinking?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Do you hate me? Or him?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Or maybe you hate yourself for sticking your nose where it didn't belong, saving that kid, and getting yourself hurt?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...I don't..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You sure?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "So you can still talk. Guess I misjudged you."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Look, Rublev."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "What do you think it is that decides what a person's gonna do?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Is it a nature or nurture thing? Where they're born, how they're born? What kind of baggage they're weighed down with?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Nah, none of that matters."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "It's the whole, complete, sum total of the influences on his life, all those changing thoughts and beliefs."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "And just how strong he believes in those beliefs."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "You saved that kid, but you didn't really trust him completely. You looked down on him, because you saw yourself as his messiah."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "But him? He's easy. You saved him, he wants to save you."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "When it comes to this stuff, he's stronger than you are."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Keep the blade. It's a Sarkaz blade, so I'm allowed to stand in for its owner and give it to you."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "Wave it around, learn to swing it, sell it for cash. Whatever. It's yours."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerId": "avg_npc_046",
      "isRemote": false,
      "text": "That's the deal."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "What... are you talking about...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "R-Rublev! Are you okay?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Look!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I did it! I stole an entire box of medical supplies! Painkillers! Bandages!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Rublev..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Keep it... down. I'm not dead yet..."
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "O-Okay. Let me bandage your wound...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "How do you use the bandage...? Is- is this the Oripathy medicine? I-I'll open it..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Aren't... your parents doctors?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Oh... they never taught me anything. But I'll try..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...You got hurt?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "I'm fine. Just a scratch... Somebody hit me with a piece of metal..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Idiot...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...Hehe..."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Where's... the Sarkaz?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Oh... I didn't see her when I came back... Did she stay with you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Rublev?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "...Say, um... What's... your name?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Oh? Err... Andrey."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Your whole name...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
      "isRemote": false,
      "text": "Andrey Fyodorovich Ostrovsky... heh."
    },
    {
      "type": "dialogue",
      "speakerName": "Unyielding Child",
      "speakerId": null,
      "isRemote": false,
      "text": "What are you laughing at?"
    },
    {
      "type": "dialogue",
      "speakerName": "Waifish Child",
      "speakerId": null,
