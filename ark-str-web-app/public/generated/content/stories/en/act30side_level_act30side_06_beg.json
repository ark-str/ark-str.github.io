    {
      "type": "dialogue",
      "speakerName": "'Trilby Asher'",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Everyone has their own strengths. For example, you'd be stronger than most of Victoria. However—"
