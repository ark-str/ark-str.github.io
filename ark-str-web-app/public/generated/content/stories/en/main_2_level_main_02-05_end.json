  "blocks": [
    {
      "type": "narration",
      "text": "第十七关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Amiya! Hurry!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Miss Misha! Please follow us!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...How... can this be...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "This way, hurry!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "This area is clear! Be careful, they're still after us!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Are they also...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Yes...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Reunion...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "They're also... Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Why?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Why are the Infected fighting each other...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Skullshatterer...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "You... let them go?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "Don't worry...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "They can't run.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "But I've finally found her-- No, no...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "text": "She's finally... come to me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "We've arrived.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "...Are you serious?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "That's what the markings say.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "But... this route is heading up, isn't it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "How's that going to help us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Amiya, Amiya! Up here, that's right, come up here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "--Exusiai!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Are you certain...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Trust me, I wouldn't mess up~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "I know Lungmen's roads like the back of my hand!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Aha...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Let's head up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Wouldn't that be... waiting for the enemy to surround us?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "If you don't hurry and Reunion finds us, maybe!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Tch... Wait, you guys go first...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "I'll go weld the gate's entrance so Reunion can't get in.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "There's a penguin logo on the staircase here. Is this the place?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Sure is. Head forward and take a left, then take the stairs up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "That will take us inside the building...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Weren't we going to go underground?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "No, no, I just said we were heading upstairs.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "...Upstairs?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Are you sure... she's trustworthy?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "'As long as we get to the destination, any route can be taken.' That's one of our mottos here at Penguin Logistics.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Just try our service once. You'll love it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "*gasp*... *gasp*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Sorry, Misha... I didn't know...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Phew...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Hey, you.",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "Are you Dr. {@nickname} of Rhodes Island?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "You don't seem to like climbing stairs.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
