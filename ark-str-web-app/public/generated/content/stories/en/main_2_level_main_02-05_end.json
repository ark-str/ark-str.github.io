  "blocks": [
    {
      "type": "narration",
      "text": "第十七关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "Amiya! Hurry!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Miss Misha! Please follow us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerId": "char_012_misa",
      "text": "...How... can this be..."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "This way, hurry!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "This area is clear! Be careful, they're still after us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerId": "char_012_misa",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerId": "char_012_misa",
      "text": "Are they also...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Yes..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Reunion..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "They're also... Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerId": "char_012_misa",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerId": "char_012_misa",
      "text": "Why?"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerId": "char_012_misa",
      "text": "Why are the Infected fighting each other..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "Skullshatterer..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "You... let them go?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "Don't worry..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "They can't run."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "But I've finally found her-- No, no..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "She's finally... come to me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "We've arrived."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "...Are you serious?"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "That's what the markings say."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "But... this route is heading up, isn't it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "How's that going to help us?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "Amiya, Amiya! Up here, that's right, come up here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "--Exusiai!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Are you certain...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "Trust me, I wouldn't mess up~"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "I know Lungmen's roads like the back of my hand!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Aha..."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "Let's head up."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "Wouldn't that be... waiting for the enemy to surround us?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "If you don't hurry and Reunion finds us, maybe!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "Tch... Wait, you guys go first..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "I'll go weld the gate's entrance so Reunion can't get in."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "There's a penguin logo on the staircase here. Is this the place?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "Sure is. Head forward and take a left, then take the stairs up."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "That will take us inside the building..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Weren't we going to go underground?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "No, no, I just said we were heading upstairs."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "text": "...Upstairs?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "text": "Are you sure... she's trustworthy?"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "'As long as we get to the destination, any route can be taken.' That's one of our mottos here at Penguin Logistics."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "Just try our service once. You'll love it."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "*gasp*... *gasp*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Sorry, Misha... I didn't know..."
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerId": "char_012_misa",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "Phew..."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "Hey, you."
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "speakerId": "char_102_texas",
          "text": "Are you Dr. {@nickname} of Rhodes Island?"
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "speakerId": "char_102_texas",
          "text": "You don't seem to like climbing stairs."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
