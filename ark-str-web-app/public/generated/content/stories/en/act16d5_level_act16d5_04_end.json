{
  "server": "en",
  "storyId": "act16d5_level_act16d5_04_end",
  "groupId": "act16d5",
  "stageId": "act16d5_04",
  "title": "Shopkeeper",
  "storyCode": "WR-4",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act16d5/level_act16d5_04_end.txt",
  "sourceHash": "68a25b38b4061c6ba8bd4db60ef8bddf879c8833e3d630f9604a59fa51c7e097",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Uwhhh, *whimper*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Young lady, look at how the sky is bright now. We've gone quite a far way, and we'll be there soon. Don't you cry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "*whimper*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Now, now, I'm here with you. You're perfectly safe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "*Sigh*... don't cry, now, don't cry. Look, you can see the garden. We'll be right there.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Yaaahhh—!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Wh—Why are they here?! Weren't they meant to fear the sun?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Come, ride on my back, hold on!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Mister! Mister, run faster!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Don't—Don't pull on my hair! My glasses are falling off!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaa! Gkhaa!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "He runs pretty darn quick, that Mr. Nothing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "text": "Hero, what are you talking about?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Hm? Ah, nothing. You get to the garden and hide quick. Leave the outside watch to me.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Hmm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "That miniature Ink Spirit seems a little faster than your garden variety Originium slug... but it also looks like it's gone a little dizzy?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Maybe it really can't catch up to Mr. Nothing...? Who'd have thought?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkh... gkhaa... gkhaa...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Watch this! Hey! Heh! Yah!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Hahah! Can't get us now, can you!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkh!?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Mister! Run a little faster, come on!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "I've wanted to do that forever! Pull off a little something when you're chased through the streets, just like all those martial arts stars on the silver screen!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "F—Faster! Faster!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Don't smack me! I'm not a burdenbeast!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkhaakh—!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "It went around!? With the sun shining on its ass! Didn't they say these things feared sunlight?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "S—Save us!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Tck! Here, young lady, you go on ahead, I'll—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkh!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkh!?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "text": "Gkh... gkh...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "It's Kroos, my benefactor! Dear me, here, good benefactor, come, if you had a free hand, you could've helped me a little sooner! Er, where, where are you?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Right here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Yah...! M—Miss, where did you come from?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Wow! I'd be remiss not to laud your sniping skills as beyond the blue! You slip about like a ghost, land without a whisper! You really are—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Miss! Thank you for saving mister!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Err.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Run on back, quick. Your mum's been looking for you for ages now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "text": "Mm-hm!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Benefactor, why don't you hurry to Lava and Saga's aid? Let me keep watch here, safeguard the perimeter.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Didn't you just cross your heart you'd return to Lava to help her?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "B—Benefactor, might you have the gift of clairaudience...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Nope.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Why've you been holding onto that folding fan the whole time?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Ah, I simply must! This fan is the most precious thing I have, a present to me from my most respected teacher! I'd hate to let it out of my grasp!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "Moreover, here, clasping this fan in my hand, I look quite refined, don't I?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Hmmmgh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Why'd that Ink Spirit get over here just now without any trouble? It counts as daytime, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "text": "I was wondering too! That cretin chased the wind out of me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "text": "Hmm... anyhow, better head for Lava.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "It's quiet.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "We're clearly on the fringe of night here. I can only see a crack of dawnlight. Why aren't any monsters charging through?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "I also thought it strange. It has never been so peaceful, has it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "text": "Isn't it good that it's peaceful?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Ha! That is so. I may at last catch my breath!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Huff!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "text": "Careful you don't crush any goods.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "Saga, the Dusk Beauty you mentioned just now... who does that refer to?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Naturally, the Dusk Beauty of the well-told 'Dusk Beauty Flying to the Moon' tale. My word, to this day I cannot forget the sight of the eyes of Dusk Beauty—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "text": "...???",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "text": "Saga, tell it a little slower. Miss Lava's giving you a funnier and funnier look.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Oh, beg pardon, 'twas my impatience. Lava, thou art also tired from withstanding Ink Spirits, art thou not? Ought we perhaps sit down with some tea, and there make proper talk?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "text": "Sure. I'll go brew you some tea, then.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Right, I would like to ask thee first. Young Dawn, dost thou know any way of leaving this place?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "text": "No.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "text": "Thou dost not?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dawn",
      "text": "(Lightly shakes head)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Storyteller",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
