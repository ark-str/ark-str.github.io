{
  "server": "en",
  "storyId": "main_4_level_main_04-01_end",
  "groupId": "main_4",
  "stageId": "main_04-01",
  "title": "Consolation",
  "storyCode": "4-1",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-01_end.txt",
  "sourceHash": "be54c66177a6113d00439e1eeccb5ebf5a0b148a9b1c5410ec661a000a11183f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十一（后）\n6:03 P.M. \\ Overcast \\ Visibility: 19 km\nDesert by Lungmen \\ Facility #14"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...I've reached the destination.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "No other abnormalities found.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Report complete.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Frostleaf, why were you frowning the whole way here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "I'm just a little concerned about Amiya's group.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "They've already safely returned to Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Nearl and Dobermann already left Lungmen a week ago for their next assignment.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "It must be a pretty tough mission if it required sending those two together.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Blacksteel and Penguin Logistics both have their own matters to attend to.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Oh, Liskarm and Franka...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "I'm... I'm glad that they're safe...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "You've got to work hard as well, just like them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "When Franka sent you over to me, she spoke very highly of you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "R-really...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "If only you weren't so timid, she said.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Uuu....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...Hey, don't act like you're about to start crying!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Aren't you also a member of Blacksteel...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "I, I'm not... crying...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "...In any case, let's continue our mission.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Our next task is to work with the other recon teams to scout out this entire city.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Other than searching for survivors, we also need to assess the situation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "If we encounter hostile Infected, we'll have to deal with the threat quickly.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "Even though our mission isn't particularly dangerous, it's still best to proceed with caution.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "In the event that Reunion is involved in this, we'll retreat immediately and report back to Dr. Kal'tsit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "text": "Mmhm, mmhm!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "text": "All that's left for us to do... is to focus on our job.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "6:12 P.M. \\ Overcast \\ Visibility: 19 km\nRhodes Island\nDeserted Nomadic City - 2 days after the discovery of 'Facility #14'"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Ah... You made it, Doctor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Good timing, Dr. {@nickname}.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Our job here is about done. You probably won't see us for a while~",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Are you leaving already?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "...Got it.",
          "value": "2",
          "blocks": []
        },
        {
          "label": "I'll miss you.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Liskarm",
          "text": "We'll see you soon enough.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka",
          "text": "It won't be long before we're back on standby in Rhodes Island.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka",
          "text": "Don't miss me too much.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Exusiai",
          "text": "Well, unfortunately, we don't have such an official-sounding reason. Right, Texas?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "Hold on a second...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Exusiai",
          "text": "Penguin Logistics... is about to go on vacation!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Exusiai",
          "text": "It's only going to one precious day... But still--",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "...Apologies. This isn't the best time to talk about it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Don't worry... Everyone needs to get some rest.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "...I should be the one saying that to you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Huh...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Exusiai",
          "text": "That's right, that's right. Amiya, girl, you really need a bit of R&R!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "There are many things in Rhodes Island that must be taken care of...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Liskarm",
          "text": "I can understand that, but make sure not to give yourself too much pressure, Amiya.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka",
          "text": "No matter how strong your will is, your body won't be able to keep up if you get exhausted.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka",
          "text": "You'd better not get sick. Everyone's counting on you!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I... Everyone has always been looking after me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "We were also inspired by the way you fight.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "Just that much is enough.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Exusiai",
          "text": "Since I'm already here, I'll take this opportunity to get a free check-up before heading back.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka",
          "text": "Our work here is about done anyway. Next up is...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka",
          "text": "Amiya, Dr. {@nickname}.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "——?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I'm listening.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka & Exusiai",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka & Exusiai",
          "text": "Keep up the good work~! Cheer up!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Wha... huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Liskarm",
          "text": "After we finish our report, we'll be right back.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "No matter what, life must move forward.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Texas",
          "text": "Amiya, take care.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Everyone... I...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...I will. You all take care as well.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "See you next time.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor,",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I have to visit the slums in outer Lungmen again. I should be of assistance.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Will you be fine by yourself?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Isn't that a bit dangerous...?",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Amiya, should I go with you?",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Don't worry, Doctor.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Another member of Rhodes Island, Projekt Red, will be joining me in Lungmen.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "She's really good!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "With her there, you don't have to worry about me.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
