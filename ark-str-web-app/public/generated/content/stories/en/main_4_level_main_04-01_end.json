  "stageId": "main_04-01",
  "title": "Consolation",
  "storyCode": "4-1",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/obt/main/level_main_04-01_end.txt",
