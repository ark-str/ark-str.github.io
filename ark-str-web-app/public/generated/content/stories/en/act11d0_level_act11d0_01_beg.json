  "stageId": "act11d0_01",
  "title": "Silence Maintained",
  "storyCode": "TW-1",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/activities/act11d0/level_act11d0_01_beg.txt",
