  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/activities/act5d0/level_act5d0_01_end.txt",
  "sourceHash": "c49a6efe84beaa148e5c73b6faf6a33cba0c4fac7a5fdc0c9fc9b1a9eae46cda",
