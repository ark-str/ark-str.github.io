{
  "server": "en",
  "storyId": "act18d3_level_act18d3_02_beg",
  "groupId": "act18d3",
  "stageId": "act18d3_02",
  "title": "Singer",
  "storyCode": "SV-2",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/activities/act18d3/level_act18d3_02_beg.txt",
  "sourceHash": "8f1f9d93b9b33fb8b694e7560efd03f357aa0dc2a8fafc32ba396f0ab087f37d",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "background",
      "backgroundId": "bg_ibtownd"
    },
    {
      "type": "narration",
      "text": "3:23 P.M. \\ Overcast\nIberia, Sal Viento"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "This is the place on the map."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "I can't say it smells any good."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Hello."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "May I ask—"
    },
    {
      "type": "dialogue",
      "speakerName": "Another Male Inhabitant",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "(He hangs his head low, and does not speak.)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Monsters?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "They're all humans."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "(She utters Iberian.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Is this not how they speak anymore?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "(Iberian again, the accent somewhat changed.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Moreover, I'm a singer right now."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "A singer doesn't do that. Mister José said so."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": null,
      "isRemote": false,
      "text": "Ninety-nine..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Someone's talking."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": null,
      "isRemote": false,
      "text": "Ninety-nine."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "A... child? He's mumbling a number."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "I can't have misheard."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "You—"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "My necklace just..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "You will not escape!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "speakerId": null,
      "isRemote": false,
      "text": "Ninety-nine, ninety-nine..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "background",
      "backgroundId": "bg_ibbar"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "You can't run."
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "speakerId": null,
      "isRemote": false,
      "text": "*Whimper*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Why take what's mine? Why bring me here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Hm?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "A hole, a few ropes. The ambushes outside were at least much more adequate than this."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Come out, all of you."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "I needed to find you, anyway. Quickly, if you don't mind."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "She's very peculiar."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "Quite, Sheetmetal. Such a person, I've never before seen."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Nor I."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "So you know how to speak after all."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Who are you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "A wandering singer."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "I know not what a wandering singer is."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "Sheetmetal, do not speak to her."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Your face, unfamiliar. Your attire, strange. You are not one from here. What is your business?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "I want to ask a question."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Your clothes, very new."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Have you seen my fellow person?"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "You have much strength. You are able to eat your fill."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "She came here before I did."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Your case, very heavy."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "An instrument is not a light thing."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "The thing in your grasp, very uncanny."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "I assume your harps should come more or less the same."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "(Plucks strings)"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Ears, pained. It is a weapon."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "It is able to not be."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "Sheetmetal, this person, uncanny. Do not heed her. To speak, very tiring."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Bench. Let go of him."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Bench... Do you mean this child?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "I didn't intend anything for him. He took something of mine. Things like that are significant."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "You came to rob something."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "I'm only taking back what's mine. And looking for someone who can understand me when I talk."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Inhabitant",
      "speakerId": null,
      "isRemote": false,
      "text": "*Whimper*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Our child, you may not touch."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Our things, you may not rob."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Hm?"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Our rules, may not be broken."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "Sheetmetal, you have gotten nearer. What are you doing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "She is going to harm our child, steal what is ours, break our rules."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "Is she not our sister? If she is, she too has a share."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "She is surely not."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "You don't understand me."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "I'll go and ask someone else."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "You may not leave."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "One moment, Sheetmetal..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "Ouch!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant B",
      "speakerId": "avg_npc_187",
      "isRemote": false,
      "text": "There—There is a hole here."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Woodframe's hole. You forgot."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerId": "avg_1012_skadiSP_1",
      "isRemote": false,
      "text": "Oh, it comes in handy after all."
    },
    {
      "type": "dialogue",
      "speakerName": "Male Inhabitant A",
      "speakerId": "avg_npc_178",
      "isRemote": false,
      "text": "Those from outside, to our place, you should not have come!"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
