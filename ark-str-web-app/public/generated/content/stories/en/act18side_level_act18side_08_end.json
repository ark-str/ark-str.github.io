{
  "server": "en",
  "storyId": "act18side_level_act18side_08_end",
  "groupId": "act18side",
  "stageId": "act18side_08",
  "title": "Schicksals",
  "storyCode": "LE-8",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act18side/level_act18side_08_end.txt",
  "sourceHash": "39e24ff9877319ada6373db86b5e31b6e38845caa29d21c5f1e48b8d0ec14e1e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Stupid, foolish boy..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You didn't have to do this."
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Why would you go so far for a world that owes you so much?"
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sir?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You must leave now! Originium activity is rising rapidly in this area!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I want to see my grandson one last time."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Only a little further, Hibiscus. Distract him..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kreide, grandpa's here."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kreide, my boy."
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Vent whatever anger you have on me."
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Come to me, before you do any more harm!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I've deceived you for so many years... I thought about dying for your sake, but I never thought you would come to an end like this."
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If your choice is to let the others live, why not let me come with you in my last days?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Let me join you on your final journey, my boy!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The crystalline monster no longer understands the old man's words.\nThe flash of lucidity was a fleeting miracle. All the monster can think about now is dragging everything around it into emptiness, dancing to his cello's tune.\nThe monster follows the sound, playing a song of death."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sir?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grandpa",
      "speakerToken": "avg_npc_495_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Young lady, why do you—"
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll hold down the fort here, Ebenholz. Now!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ha!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gertrude",
      "speakerToken": "avg_npc_484_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "How?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Gertrude",
      "speakerToken": "avg_npc_484_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Friendship, dedication, sacrifice—such childish ideals should have been shattered upon contact with reality. How? How?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Gertrude",
      "speakerToken": "avg_npc_484_1#8$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's not over yet!"
    },
    {
      "type": "dialogue",
      "speakerName": "Gertrude",
      "speakerToken": "avg_npc_484_1#8$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kreide may have forcibly assimilated two verses of the Voice of Mundane, but he could not overcome the disorder and madness of their amalgamation!"
    },
    {
      "type": "dialogue",
      "speakerName": "Gertrude",
      "speakerToken": "avg_npc_484_1#8$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kreide's melody has faded, but Ebenholz's Voice lingers. I—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gertrude",
      "speakerToken": "avg_npc_484_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Argh!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Enough, Gräfin Strollo."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Gertrude's limp hand drops from the strings.\nBiegler withdraws his dagger from Gertrude's back. The blood stains his clothes red."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The Originium outer shell cracks and falls apart.\nThe plaza falls silent, the only sound being inert pieces of Originium shell falling to the ground.\nFinally, the shell shatters completely, leaving behind Kreide lying on the ground with his cello."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait for me... wait for me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No! It's dangerous. We should call Infected Palliative Services..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "What are you saying?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kreide won't die!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "*cough*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You're awake, Kreide!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "See? He'll be fine!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ebenholz...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm here, it's me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't... don't bother. I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "(Takes a deep breath)"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I feel... so light..."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It hurt so much... but I feel better now..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, you'll get better... yes..."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Listen carefully, Ebenholz. This is the last time I'll be able to talk to you."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Remember my words."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Live on, Ebenholz, and walk through the long night."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Fight injustice, and treat others with generosity and charity."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Only by doing so will I live on in your memory."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll ask you, how did your day go, Ebenholz?"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And you'll tell me proudly that you had a good and productive day."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You'll tell me about the challenges you face while doing good, and complain about how fate is a miser."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And it will be okay, because I'll be listening."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's alright to complain a little, when you've worked so hard."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Only by doing so will you rise above pain and suffering, and find peace in your heart."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Remember that we've fought together against cruel fate and won."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "When you think of me, laugh. Don't cry."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#10$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, yes!"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And Ebenholz... I'm sorry."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I haven't thought about what token... to give you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#10$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Anything's fine. Just don't die... please..."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide",
      "speakerToken": "avg_npc_483_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kreide... Kreide..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kreide!!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "They'll find themselves shattered someday, but that day is not today."
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Friendship, dedication, sacrifice..."
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "They may be naive, but someone will shed a tear for them."
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What about you, though, Gräfin Strollo?"
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You destroyed your friendship with Czerny by your own hands."
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You killed your own brother and laughed at his incompetence."
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You want others to sacrifice for you, but what have you done for them?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Pathetic."
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe I acted out of impulse, but dealing with threats to public safety is also part of my job."
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll be sure to mention you in my report, Gräfin Strollo."
    },
    {
      "type": "dialogue",
      "speakerName": "Biegler",
      "speakerToken": "avg_npc_486_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Good night. I hope your dreams don't involve cursing anybody."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Your hand's bleeding! Did you get scratched by Originium crystals?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#7$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah, yes... I guess there's a bit of blood..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You need treatment immediately—"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Treatment? It's Kreide who needs treatment!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ebenholz, he's..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't say it, Hibiscus. I beg you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright."
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "He... he's Infected, Ebenholz. If you don't want Palliative Services to get involved, at least find a room that's isolated, for his own sake."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I know, I know..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "The lounge at the concert hall."
    },
    {
      "type": "dialogue",
      "speakerName": "Hibiscus",
      "speakerToken": "avg_1024_hbisc2_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright, I'll take him there."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I will."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Come, Kreide. I'll carry you."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Ebenholz lifts Kreide up. The Originium crystals inflict more wounds on him, but he pays them no heed.\nHe carries his friend, even as he feels the body cooling, as though embracing a short but sweet dream."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're almost there, Kreide."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Just a little longer."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide?",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Thank you."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You're—You're still alive!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll take you to Hibiscus—"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide?",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Lay me to rest in this building."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide?",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "If you return to The Afterglow someday, you'll remember that you once had a good friend, with whom you've laughed and argued here..."
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide?",
      "speakerToken": "avg_4046_ebnhlz_1#4$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "And at the last, put on a duet to remember."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "No. You're not Kreide. You're—"
    },
    {
      "type": "dialogue",
      "speakerName": "Kreide?",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Isn't this what you wanted?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Shut your mouth. I won't allow you to defile his memory."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Kreide gave his life to cleanse the Voice of Mundane, but it's still in my head?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#10$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I warn you... don't think I'll hesitate to blow my own head off, if you dare imitate him one more time."
    },
    {
      "type": "dialogue",
      "speakerName": "The Voice in His Head",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "(Sighs)"
    },
    {
      "type": "dialogue",
      "speakerName": "The Voice in His Head",
      "speakerToken": "avg_4046_ebnhlz_1#8$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "My foolish bloodline."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Ebenholz no longer hears the voice.\nHe walks toward the lounge in Afterglow Hall, Kreide's body growing heavier in his arms with each step."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're here."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll seal the room. Lie down on the sofa."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's soft. It'll feel nice."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sofa, soft..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You've never slept on one at home..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#9$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#9$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Looks like I've been infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#9$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Arts that once took so much effort now feel so simple. Maybe getting infected isn't so bad after all."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#1$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "That should do it. I'll seal the door from the outside."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Anything else?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "A token... yes, a token."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#6$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll take the cello."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#9$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Look at me, taking back something I bought for you."
    },
    {
      "type": "narration",
      "text": "Ebenholz's lips tremble."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "He stands wordless for a moment before laying his flute at Kreide's side."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#9$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You said you wanted a coin with a hole, but the only thing I have left is this flute..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#9$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm sorry."
    },
    {
      "type": "dialogue",
      "speakerName": "Ebenholz",
      "speakerToken": "avg_4046_ebnhlz_1#9$2",
      "operatorId": null,
      "portraitKey": null,
      "text": "So sorry..."
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
