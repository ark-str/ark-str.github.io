{
  "server": "en",
  "storyId": "main_6_level_main_06-15_end",
  "groupId": "main_6",
  "stageId": "main_06-15",
  "title": "Winter's End",
  "storyCode": "6-17",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_06-15_end.txt",
  "sourceHash": "3741df5bd78fac652043501240302ad0ee63fb8cb7fdef4b4f9aa0497d8a183a",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "It... shattered?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "The old man got this from some wizard.... Said it would keep me alive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Didn't even make it through one fight, huh. I guess it was fake.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Just like I'm his fake daughter, maybe...? And now, like Reunion.... As well.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Mmm!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "Uh....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "*Cough* *cough*.... Blaze!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "The cold's..... gone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "text": "I'm fine! Amiya, hurry, go check on the white rabbit!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "Nice win, Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "My brothers and sisters.... I let them die in vain.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "We accomplished nothing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "FrostNova",
      "text": "My life.... wasn't worth anything at all.",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "They followed you because of your ideas.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Blaze",
          "text": "........",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "My death.... isn't worth anyone's time.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Go save who you can. Hurry.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Go.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Whether it's stopping the raincoats, going to kill Mephisto, or sheltering the Infected who have nowhere else to go....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Go. Go do something worthwhile.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "........",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor...",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "I'll stay.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "You go.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Okay.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor, please tell her.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Please.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "What a.... naive rabbit.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Just like Talulah back then. Very similar.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "To be able to see someone like this before I die, someone so determined to realize their ideals....",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What about the burden you bear?!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "........",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Didn't you promise to join Rhodes Island?",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I guess that's been swirling around in your head, huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Villains are what villains are. I have no complaints about the ending I deserve.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I have hurt you. Reunion, and I, targeted innocent Lungmenites and single-handedly led the Ursus Infected into this nightmare. Such people have no business at Rhodes Island.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "My brothers and sisters.... Those fools must have tried to keep me alive, huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I thought that even if I died here, those idiots would get a place where they could live in peace.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Wrong and wrong. They died. To protect me, a woman who didn't have much time left to begin with.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I'm not happy. We were used and abused. Our lives thrown away.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I'm not happy.... This last moment of life, this does not belong to me. They bought this with their blood!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "This little bit of life..... I must give it to someone trustworthy.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Thank you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...Ah... Even if we survived, where is there to go?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "We had nowhere. The only thing we were ever knew was the snow.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Lungmen is not Ursus. We came, desperate to save our people, and the Infected, looking for a warm place, with food, and shelter....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "That's not Lungmen. From the beginning, it should not have been Lungmen. The people of Lungmen are also struggling to eke out a living.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "We should have gone back to Ursus.... Our homeland.....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Snow.... a peaceful river.... the pine forests gently swaying.... the turquoise moss....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "This world, it's beautiful....",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "So, you think Talulah is the one who orchestrated it all.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...If I'm right... The plot is ready to unfurl.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Even if old man Buldrokkas'tee could stall it for a while, Talulah would have a way to deal with him.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Lungmen can't do anything.... And all Ursus can do is watch.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "But you're still here, and the Infected still have a chance. Even if only a small one...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "——go put an end to Talulah. Stop her madness and don't let Reunion swallow up any more Infected. Reunion doesn't need Talulah, any Talulah....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Or.....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I could make a selfish request. Go save her. No. Go help her. Along with our countless fellow Infected....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "The real one.... Walking on muddy earth.... Talulah....",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "FrostNova?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Go... ahead.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "I think your father really loves you.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Just like you remember your birth parents dying for you.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You remember clearly all that your father did for you.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "........",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "How could I not know? It's just, he's going to outlive me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "How much better it would have been if he had never adopted me. That way, he wouldn't have to feel all the pain I've brought him.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "He's suffered so much....",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "It is because he has suffered so much that he cherishes you.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Hehehe....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...Doctor.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I can call you that, can't I?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Doctor of Rhodes Island, choices just might be meaningless, in this world.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Even so, even if the outcome makes no difference.... I do want to choose for myself. I made my choice.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "With my own hands.... To take the fruit of the seeds I have sown.",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "FrostNova's fingers grope at your face ."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Your fingers... are warm?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Strange. Your face... is cold.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "My body temperature.... Is not so low anymore?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Yes. Your symptoms are gone.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "........",
          "value": "2",
          "blocks": []
        },
        {
          "label": "You're warm, FrostNova",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I can finally touch someone... before I die.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "FrostNova, Amiya and I want you to join Rhodes Island.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Do I really deserve that?",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "If you just die, here and now, you won't have a chance to right your wrongs.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "...It would be rude not to give a response.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Tell Amiya, Dr. {@nickname}....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "In this world, a single person is worthless.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "But she's absolutely not alone.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "From now on, I am at your side. Both of you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I......  would like to join Rhodes Island.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Thank you.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "No... thank you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Your eyes.... remind me of someone I used to know.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I met a boy who said his brother would rather go to the gallows than beg for his enemies' mercy....",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "So he was going to walk across the snowy plains, he was going to walk all of Ursus.... And he didn't come with us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "I thought he was the most idealistic person I'd ever met.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "But now, you and Amiya changed my mind... Maybe ideals can be a kind of faith.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Rhodes Island is all about fighting for shared beliefs.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "The original Reunion.... was the same.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Just the same.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Your eyes, and that boy's, really do look the same.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Only, you're not as determined as he was. You're so much.... So much gentler.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Let me go. My brothers and sisters are waiting for me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "......Father...... I've been such a fool.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "FrostNova",
          "text": "Forgive me.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "She slips down.\nThe corners of her mouth turn up, haughty as she was when she lived."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
