  "blocks": [
    {
      "type": "narration",
      "text": "第三关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "We're in the clear!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "You okay, Big Bob—"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "Huh? That wound on your leg..."
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerId": null,
      "text": "There are some stragglers over there! They're probably from the Valk Vanguards!"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "I can handle this on my own! Go after the ones who are fleeing!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "Sure."
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerId": null,
      "text": "Hmm?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerId": null,
      "text": "This kid..."
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerId": null,
      "text": "Hey, hey, why are you giving me that look?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerId": null,
      "text": "G-get away from me or I'll put a hole through you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerId": null,
      "text": "Huh?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "You took care of them all?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "That's right."
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "Impressive. This kid's got talent."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "Stay there and don't move. I'll patch you up."
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "It's fine, I can take care of myself."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "No means no."
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "You saw it, right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "Mhm."
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "You saw the crystalization on my body, right? Are you trying to get yourself infected?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "Our mission at Rhodes Island is to help all the Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "Rhodes Island..."
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "speakerId": null,
      "text": "Rhodes Island? Aren't you from Victoria...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "Former Victoria Mounted Police. Now, I'm a Rhodes Island operator!"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "Stay back, lass. I'm an Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "speakerId": null,
      "text": "I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "Miss Carol, this might get a bit messy. You should step back a bit."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "All right, I stopped the bleeding."
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "You do this a lot, huh? For the Infected?"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "You're not afraid of me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "A lot of my coworkers are already Infected, but I can't tell who is and who isn't."
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerId": "char_220_grani",
      "text": "Well, it's sometimes hard to tell until it's time to hit the showers, right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "...Hmph."
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "Thanks, shorty. You're naive, but you're a good person."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Big Bob",
      "speakerId": null,
      "text": "..."
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
      "speakerId": "char_220_grani",
      "aliases": [
        "Grani"
      ]
    }
  ]
}
