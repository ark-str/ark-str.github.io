    {
      "type": "dialogue",
      "speakerName": "'Clip' Cliff",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "To the countries involved, this would've sparked a 'conflict.' But to normal folks, we'd call that a 'disaster.'"
