    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Patrol Battalion Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "This is... data for the Imperial Astronomical Bureau? And a token?"
    },
    {
      "type": "dialogue",
      "speakerName": "Patrol Battalion Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Girl? How did this come into your possession? Hey, wake up!"
    },
    {
      "type": "dialogue",
      "speakerName": "Patrol Battalion Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hurry! Call the medic!"
