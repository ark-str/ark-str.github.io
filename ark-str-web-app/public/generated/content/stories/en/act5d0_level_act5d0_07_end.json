{
  "server": "en",
  "storyId": "act5d0_level_act5d0_07_end",
  "groupId": "act5d0",
  "stageId": "act5d0_07",
  "title": "11:08P.M.",
  "storyCode": "CB-7",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act5d0/level_act5d0_07_end.txt",
  "sourceHash": "40b695fad935f8f0a04c1720293e86a1bb2ae93e7ae9cd3e847da53852eae746",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "*Pant* *pant...*",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Capone",
      "text": "Come on, Penguins!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Looks like you two get along great?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Capone",
      "text": "Grr!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "What'd I ever do to you?! I'll clock you one!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Gah! Whose side are you on?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "It- it wasn't me! It was that angel!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Oopsie. I missed. Seems fine though.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso A",
      "text": "Get 'em, while they're—— Agh! What are you choppin' at me for?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso B",
      "text": "Sorry, but I gotta stay loyal to the boss!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso A",
      "text": "Me too!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso B",
      "text": "Oh.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "What are you doing on the ground? Get up and fight if you ain't dead!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Y- yessir!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "You can't be so rough with your employees. Do they at least get hazard pay?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "It's kind of hard to tell who's who. Just try to get everyone wearing black on the ground.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Hoo yeah this is a mess.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Sure is—— woah! Mostima?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "But it looks like you're all doing okay.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "When did you get here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "The boss called me.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Capone",
      "text": "Hey, it's that weird-lookin' Sankta.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Get outta here!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Somebody needs to calm down a bit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "What are you even fighting over here? Let's all take a step back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso A",
      "text": "She stopped the boss?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso B",
      "text": "No! It's that staff! Look out, boss! She's a caster!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Capone",
      "text": "...Looks like we were right not to take her head on... Hey, don't get near 'em!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "I ain't never seen a Sankta like you before. Or wait? Are you a Sarkaz? What the hell are you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "I'm just an ordinary Messenger.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Cazzata!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Grrr——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Time for an intermission... or are you not going to listen to me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Who do you think you are?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "How are you all doing? It's been a long time, hasn't it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Hey! Eyes over here!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "A couple years, I think? Maybe a couple months?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Gah!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "When your days are as rich and full as ours, you kinda lose track of time.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "It's been about four years and three months, Mostima.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Yeah, that's pretty long.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Don't give me that face. If you keep looking that gloomy I'll think you've gotten sick.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Isn't this a touching reunion?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Touching or not, it's definitely not the time to be reminiscing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Are you really going to do it here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "I'll do only what needs doing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "...Okay. Just go easy on them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Don't worry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "And it looks like I've got another customer waiting.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "——?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "No matter how many times I see it, I'm always impressed how Mostima will wave her staff around all light and subtle, only to have some big amazing thing come out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "The mobsters're already scared stiff!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Phew. I guess I should plug a couple of them?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "What's wrong? Are we done?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "You may have some moves, but you can bet I'm not lettin' you stroll outta here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "You don't always have to play the big bad wolf. Just treat this as some after dinner exercise—— Hm.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Wh- what's going on? Did this fire just turn solid?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "...seems like Yith is around here somewhere. We better wrap this up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Who are you monologing at? Come at me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "You keep losing your temper. That's a really bad look for the head of a family. How are you going to keep control of the situation?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Grrr! This smug attitude of yours really pisses me off!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Arts! Take cover!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "We'll take the Penguins. Don't wanna get in your way!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "They're underestimating us. Show them what we can do.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "You got it! Yeeeeeeehaw!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "That's Mostima, the Messenger...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "A Messenger... are Messengers really all like this?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "...is that the wind?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "...wind?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Texas! Run! Quick!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "...Right!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Hey! What's with the earthquake?! What did that caster just do?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Honestly. Old people are so impatient.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "You ain't gettin'——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Ack——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Capone",
      "text": "Hey! It's Arts! Let's get outta here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "A sandstorm? Here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Things're gettin' kinda weird.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "text": "Texas! Over here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "What about Bison and Mostima? Nng!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "The sandstorm cut them off. I'll get them!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Wait, Exusiai!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Every time Mostima's involved, she loses control like this.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Texas! Mostima! Where are you?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Gah... there's sand in my eyes——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Don't panic.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Mostima!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Shield yourself from the sand and come with me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "...That's one old man we don't want to provoke within striking range.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso A",
      "text": "The ground... I'm sinking...! It's quicksand! Run! Don't get swallowed up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso B",
      "text": "Boss! What do we do?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Where are they? Where's Capone?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso A",
      "text": "They ran out under the cover of the sandstorm! We got a few of our guys in their crew...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso B",
      "text": "Boss! This place is gonna collapse!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "...Run. We'll get another shot.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "text": "Shit! What the hell happened?!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rat King",
      "text": "Another shot... hm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rat King",
      "text": "Strange... I don't remember you having any shots left.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
