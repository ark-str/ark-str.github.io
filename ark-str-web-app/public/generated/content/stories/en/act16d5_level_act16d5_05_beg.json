      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#2",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "Are you alright?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_140#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm—I'm alright, so this is where you were, that's great, great! Those monsters just aren't afraid of sunlight anymore now!"
