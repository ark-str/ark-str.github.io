      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What kind of joke is this? You think you get me? You're my mentor now, you're gonna raise me, teach me, huh Hoederer?"
