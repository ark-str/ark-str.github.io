      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...Ugh."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "So... that's why I say she's a fake."
