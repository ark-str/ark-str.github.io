    {
      "type": "dialogue",
      "speakerName": "Hoederer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Some distant ethereal symbol who once gave you a place to stay, one specific flesh-and-blood royal, or—the path she stood for?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...I..."
