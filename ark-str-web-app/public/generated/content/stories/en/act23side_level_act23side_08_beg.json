    {
      "type": "dialogue",
      "speakerName": "Liang Xun",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't have many friends."
    },
    {
      "type": "dialogue",
      "speakerName": "Lee",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Question for you."
    },
    {
      "type": "dialogue",
      "speakerName": "Lee",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "When did you start thinking about getting Huai Tianpei involved?"
