    {
      "type": "dialogue",
      "speakerName": "Lee",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Few know that the Grandmaster is Ling's eldest brother. Seems like it's being kept a secret."
