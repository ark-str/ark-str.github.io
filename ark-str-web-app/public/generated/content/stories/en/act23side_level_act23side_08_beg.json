    {
      "type": "dialogue",
      "speakerName": "Qiubai",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "He would have come as long as there was a single breath left in him. He doesn't care if it's the last thing he does."
    },
    {
      "type": "dialogue",
      "speakerName": "Record Keeper",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I know Mr. Huai came to Yumen to challenge the Grandmaster, and the Grandmaster accepted the challenge. The Grandmaster has spoken of it from time to time, and I can tell you that he's no less looking forward to this than Mr. Huai is."
    },
    {
      "type": "dialogue",
      "speakerName": "Qiubai",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "All kung fu fighters thirst for a good opponent."
    },
    {
      "type": "dialogue",
      "speakerName": "Qiubai",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's an obsession, a strange one. It's natural that you don't understand."
