    {
      "type": "dialogue",
      "speakerName": "'The Singer'",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I heard rumors of chaos in the city, so I thought there might be something I could do to help. Alas, there is not. All I've heard is that the supply shortage was caused by Victorian sabotage."
    },
    {
      "type": "dialogue",
      "speakerName": "'The Singer'",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I've only ever run into the Victorian army by accident, and you and Culann were the ones to save me at the time."
