    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "speakerId": null,
      "text": "IfIwasevenalittlefaster... maybeIcould've..."
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "speakerId": null,
      "text": "Nooneshouldjustvanish likethis."
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "speakerId": null,
      "text": "Attheveryleast, Iwanttofindhisfamily, handthemthisstampalbum, andtellthemI'msorry."
