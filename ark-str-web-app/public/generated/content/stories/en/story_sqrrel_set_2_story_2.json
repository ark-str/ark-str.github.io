    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "speakerId": null,
      "text": "I... Icouldn'tsavehim..."
    },
    {
      "type": "dialogue",
      "speakerName": "Shaw",
      "speakerId": null,
      "text": "Iheardhisvoicethroughthedoor... Heaskedmetosavehim..."
