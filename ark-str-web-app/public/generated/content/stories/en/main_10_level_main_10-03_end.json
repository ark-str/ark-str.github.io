      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Drones...? Hmm, hmm, I see... Oh, so that's where you're going with it. That makes sense."
        },
        {
          "type": "dialogue",
          "speakerName": "Indra",
          "speakerId": "avg_155_tiger_1",
          "text": "What are you mumbling about now, Closure? The Doctor barely said two words, but you're acting like you had a whole conversation!"
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Oh, my bad. I just got an idea."
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Those cannons seem pretty intelligent, and at such a long range, they can't be completely manual. They must have some way of locking onto moving targets near the ground."
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "One or two guys running around won't be enough to get the cannons off our backs."
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "If I deploy all my drones at once, the targeting algorithm might see them as a higher-priority threat than us and the civilians, but..."
        },
        {
          "type": "dialogue",
          "speakerName": "Indra",
          "speakerId": "avg_155_tiger_1",
          "text": "But there's no guarantee?"
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Well obviously, I can't promise anything!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Rhodes Island Operator",
          "speakerId": "avg_npc_012",
          "text": "Closure, the reinforcement failed. The pressure is too great for the drones to withstand!"
        },
        {
          "type": "dialogue",
          "speakerName": "Rhodes Island Operator",
          "speakerId": "avg_npc_012",
          "text": "The base plate is going to collapse within thirty seconds..."
