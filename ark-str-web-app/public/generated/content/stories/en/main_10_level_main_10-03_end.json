        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "We have no other choice. Let's give it a try."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "avg_npc_394_1",
          "text": "On the Doctor's signal, all operators prepare to withdraw."
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Five, four, three––"
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Two––"
