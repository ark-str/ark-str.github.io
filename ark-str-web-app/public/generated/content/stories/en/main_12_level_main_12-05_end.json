  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Guh... Urgh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I really... don't have anything here."
    },
    {
      "type": "dialogue",
      "speakerName": "Starving Thug",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Bollocks! We saw it with our own eyes. You used your stove. Where did you get food?"
    },
    {
      "type": "dialogue",
      "speakerName": "Starving Thug",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "How come you have something to eat every day?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I... I just found it by chance..."
    },
    {
      "type": "dialogue",
      "speakerName": "Starving Thug",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Found it?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Calm Thug",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't go overboard with him. If this guy gets an Oripathy attack, we'll all be dead."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Starving Thug",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Where's your storeroom? Spill it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I really... Just found them... Someone has been leaving things on my windowsill..."
    },
    {
      "type": "dialogue",
      "speakerName": "Starving Thug",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Still trying to hide—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Are his words really so untrustworthy?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Even the Infected get lucky sometimes and find food, right? What's so strange about that?"
    },
    {
      "type": "dialogue",
      "speakerName": "Starving Thug",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "And who are you? Here to rob him, too?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hello. My name is Red."
    },
    {
      "type": "dialogue",
      "speakerName": "Red",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Back in my Ursus days, they all called me 'Redblade.'"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Pick up the pace. Stay close."
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hang in there! We're almost there!"
    },
    {
      "type": "dialogue",
      "speakerName": "Self-Salvation Corps Fighter",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Drat! There's more and more of them."
    },
    {
      "type": "dialogue",
      "speakerName": "Self-Salvation Corps Fighter",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "White Wolf, I've heard about you and your family."
    },
    {
      "type": "dialogue",
      "speakerName": "Self-Salvation Corps Fighter",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm glad to have the opportunity to fight alongside you today."
    },
    {
      "type": "dialogue",
      "speakerName": "Self-Salvation Corps Fighter",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "For Londinium, and for Victoria."
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What are you trying to—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't stop! Keep moving!"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Sarkaz traitor and Victorian insects, it's high time we brought an end to this game of hide-and-seek."
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Where do you want to run? Is it death that you want to escape?"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You and your friends who are hiding in the shadows will all be torn to shreds. It's what you owe us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "This is what everyone in Londinium, Victoria, and across the lands owe us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Run. Run! The storm will still arrive. You can't outrun war!"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Shut your bloody gob!"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Gah, too many people. We need to find a way to break through here!)"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(I only have one grenade left...)"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Robben, take this grenade. Head down, and blow up the bottom deck of power layer."
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Misery, protect them. The rest of you need to keep moving forward."
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You—"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Got it. Don't worry."
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We'll leave the rest to luck."
    },
    {
      "type": "dialogue",
      "speakerName": "Robben",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Horn... You—"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Shut up. I don't have time to pummel you again."
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hurry!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Horn turns around and faces a wave of enemies surging on her position.\nShe smirks a little. It is high time this all came to an end.\nAll this fleeing, the battles, and these sleepless nights.\nSoldiers are meant to die in war."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I wonder... what Bagpipe is up to right now."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "She tightens her grip on her weapon and prepares to charge.\nUnder the dark, cloudy sky, a strange sound can be heard zooming in ever closer from afar."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "A familiar sound, although it has been a long time since it was last heard in Londinium.\nIt is only in their distant memories and fuzzy rumors that people can find that sound's source—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Robben",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That's—"
    },
    {
      "type": "dialogue",
      "speakerName": "Horn",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "!"
    },
    {
      "type": "dialogue",
      "speakerName": "Misery",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Horn, run! Take this chance!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "—"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Soldier",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "'The Last Steam Knight'",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Heavy gushing)"
    },
    {
      "type": "dialogue",
      "speakerName": "'The Last Steam Knight'",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "'Victoria.'"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Drat, these doors—"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "They're too thick. They can't hear us on the other side!"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Grr, they took Clovisia and Catherine. Are they trying to use them as bargaining chips with the Sarkaz?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "These despicable traitors—"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Shining, can you open them?"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We can't delay any longer. We don't know when the Sarkaz will make it here."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shining",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I will give it a try."
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "No! Don't! Don't make a big show like that! That's only going to draw the enemy here faster!"
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We have a bunch of critically wounded and non-combatants here. If we actually start fighting the Royal Court guys, even if <i>we</i> can get away, what about them?"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We'd only be waiting to meet our maker by remaining here. I don't know what my friends are scheming, but my guys is they have more in mind than keeping us here."
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My drone has a small laser cutting device. These steel plates may be thick, but if you give me some time..."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "How long will it take?"
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, keep your pants on! I need to test the output first..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Feist, do you remember what happened to Old Bill?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It has to be... One of those monsters has got to have infiltrated us again. He fooled us again!"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We were too careless. We should've noticed sooner!"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Feist... Are those Sarkaz who can change their faces here too?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "When those <i>things</i> exist, how... how can we trust anyone?"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What if... that's not what this is?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "They're our allies! They're Londinium workers, too!"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I know. I grew up with them."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But what if..."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What if this is their decision. This is the choice that Tommy, Patto, and Day made with everybody else?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But why...? We're supposed to be on the same side!"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's easier to believe that your allies were replaced than to accept that they've betrayed us."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But that's exactly what happened."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I can tell what they were thinking, more or less. Once the rage-induced fervor dissipates, it's not so easy to choose to keep fighting."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Clovisia said as much before too. In the end, we're just a bunch of normal people."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I have to admit that... even I fear leaving, just like them."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Fleeing and cowering... is the most instinctive choice that all normal people make when they are confronted with war."
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Then <i>you</i> stay! Stay here with your friends!"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I won't do that, Rockrock."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I have to face my fear. That's the only way I can remind myself... of the worth of bravery."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I have faith that they haven't crossed that line. I have faith that they were only sucked into this choice by fear."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But none of it matters now."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I will save Granny and Clovisia, just like I did last time."
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But our wounded can't wait much longer."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The drone's laser's working on the door already! It'll take... uh, twenty minutes, maybe?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rockrock",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll help, too. I have tools on me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Your hammer and wrench aren't gonna come in handy here."
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Be patient. Just hold on a little longer, and we can leave this place safe and..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wh-What? I didn't catch any Sarkaz movement!"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Shining—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, hey, Shining. Been a while. I heard you went to a family reunion?"
    },
    {
      "type": "dialogue",
      "speakerName": "Shining",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "W, you're here."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "W! Half of Londinium heard that just now!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The curtain's drawn, right? I've always been pretty accurate with my explosives. Just the right amount."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I heard Kal'tsit got beat up real bad, so I thought I'd find some time to come take a look."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Whoa, she did really did take a beating. Theresis doesn't know how to hold back, huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "And here I thought the guy would go gentler on his 'old friend.'"
    },
    {
      "type": "dialogue",
      "speakerName": "Shining",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "She's still unconscious."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Well, shit, that's too bad. For me, that is. Should I shed a few tears for her?"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Or maybe I oughta take this chance to make sure the old hag never crosses me again?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Muffled braying)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ugh, that little shit's not dead either?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Menacing growl)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmph, still so nasty."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shining",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Mon3tr was very heavily damaged. It wasn't until two hours ago that it recovered its motor functions. I suggest you avoid provoking it."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm saving its master's life. At the very least, it's gotta learn to treat me with a bit more respect."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Otherwise, hehe—"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Mon3tr",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Compromising low roar)"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Now that's more like it."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The Royal Court fighters are heading this way! Quick, we gotta get out of here before they..."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, quit your yapping, Closure. It hurts my ears."
    },
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Whose fault do you think that is?!"
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "If you're so worried, get your men to move double time already."
    },
    {
      "type": "dialogue",
      "speakerName": "W",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I know a couple good spots outside the city. Wanna take a look?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "With the supplies we have on hand, best-case scenario, we should be able to last another week."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What about worst-case scenario?"
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright, I get it."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Cador and I will keep trying to come up with something."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What is the situation like outside?"
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "A borough that normally has less than ten thousand residents suddenly finds its population surging multiple times over. No additional supplies. No police. No law and order."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We're still alive even after the last several days. We should be thankful that the citizens still have a shred of morality."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It could also be because Cador's fists pack a punch."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't deny that."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Have you heard anything about what the dukes' plans are? I heard... Duke Windermere's barracks aren't far from here."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm sure... they won't turn a blind eye to our predicament."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I've heard rumors... Some have said they saw a blaze surge through the night sky."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We all saw that flying thing the Sarkaz had... On the day we were cast out of Londinium, its shadow swept through the entire plate."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My guess is that the dukes are all very fearful of that, and they're only probing how to attack it right now."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Of course, it's also possible that the outside world has gone to hell, and Londinium has been bombed to smithereens. Who knows?"
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe the dukes don't know that there are still people alive here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe... they thought all of us... died."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "If only we had a way to get word out..."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What way? The intercity net is completely paralyzed."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hapless sods trapped in the lockdown zone like us should just worry about whether we'll have anything to eat tomorrow."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's hard to believe that just a few days ago, we were still watching that awful Wrankwood movie in the video shop."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What was that movie called again? <i>War of the Mutant Geeks?</i>"
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The ending was actually pretty touching, though."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I wouldn't know. I fell asleep. All I saw was the nomadic city getting blown up in the explosion at the very end."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "All I remember is that Mr. McClaren was awfully generous with his money. After all, we helped him deal with the video shop's troubles plenty of times."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I only hope that he is doing well. The situation outside wouldn't do his neurasthenia any favors."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I stopped by the video shop for a look. His door was sealed shut."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Why did you always sleep in the video shop, though? I remember we met each other because..."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Because your laughter woke me up."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Sorry, but that movie was really funny."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But to start, it was your fault for falling asleep there."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There is no better place to sleep than there."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That comedy director is really famous. I have all her—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "An untimely growl that signifies hunger can suddenly be heard, shattering the easygoing atmosphere that the two finally managed to build."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Sorry."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You've been eating too little. Your stamina won't last if you keep this up."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's okay. We need to carry on."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The lives we had came to an end just like that. In an instant, this is what it all turned into."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There are lunatics and dead bodies everywhere. There are the blockade walls that the Sarkaz built... There have been men attempting to break through them the past couple days. Their brains are still hanging on the walls."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I still don't understand. How did it—"
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "War has broken out, Baird."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I know. I know! But just because of those few weightless words..."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Everyone's past disappeared without a trace in the blink of an eye."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Whose war is this?"
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The dukes are trying to protect Victoria..."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "All I know is that this war is not mine."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "A small, broken stir as well as the clanging of multiple cans can be heard from the shadows."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What are you doing?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Timid Citizen",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I... I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Baird",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It isn't your turn to stand watch tonight."
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What's that you're hiding underneath your coat?"
    },
    {
      "type": "dialogue",
      "speakerName": "Timid Citizen",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "S-Stay back!"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
