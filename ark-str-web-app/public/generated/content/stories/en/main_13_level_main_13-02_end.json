  "stageId": "main_13-02",
  "title": "Not a Moment's Rest",
  "storyCode": "13-3",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/obt/main/level_main_13-02_end.txt",
