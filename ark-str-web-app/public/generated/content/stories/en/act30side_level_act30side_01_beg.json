      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Again."
    },
    {
      "type": "dialogue",
      "speakerName": "Exhausted Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ma'am... W-We can't anymore. We're spent..."
