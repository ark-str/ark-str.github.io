    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Get up."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What did I teach you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Stand up, and grip your weapons tight!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pumped-Up Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, ma'am!"
    },
    {
      "type": "dialogue",
      "speakerName": "Out-of-Breath Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*pant*... *pant*... Hargh!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Too slow, and not enough force. Your Arts are too rushed, and your tactics too inflexible."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There's some synergy among you. That's about it."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Overall, you're still too weak."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Burly Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Of course we're no match for you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Exhausted Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*huff*... *pant*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Exhausted Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "A compliment from you makes this training more than worth it."
    },
    {
      "type": "dialogue",
      "speakerName": "Pumped-Up Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That's not enough! One day, I'll shatter a boulder with a single bare hand just like you, ma'am!"
    },
    {
      "type": "dialogue",
      "speakerName": "Out-of-Breath Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Just you alone..."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Looks like you've had enough rest."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Do it again."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh—?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frantic Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ma'am! This is bad!"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't panic."
    },
    {
      "type": "dialogue",
      "speakerName": "Frantic Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*pant*... *pant*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frantic Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Phew..."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What happened?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frantic Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There's trouble!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frantic Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Things are looking bad at the foot of the mountain... We can't handle it on our own!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frantic Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's real serious, ma'am! You should head right over!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Whoa! It's starting to move!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hahahahaha! Mom, hurry!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "—Wah!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Irritated Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That's why I told you not to run around on the train! Are you hurt?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Shakes head)"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Look, Mom! A foreigner with a funny hat!"
    },
    {
      "type": "dialogue",
      "speakerName": "Irritated Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't say things like that! And don't point at people! The Saintess has no patience for rude children! Now apologize!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm sorry..."
    },
    {
      "type": "dialogue",
      "speakerName": "Irritated Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I am truly sorry, Sir. You'll have to forgive my boy."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "No bother."
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Please excuse me. My seat is just up ahead."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(The train is, evidently, above capacity.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Roughly half locals and half sightseers. Hm, peculiar for a sightseeing train.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(The sacks in the corner at the back seem strange, too... There's movement inside. Contraband livestock, perhaps?)"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Hm, no other abnormalities, and no strange characters worth keeping an eye on...)"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Intelligence mentions nothing other than a train ride to Lake Silberneherze. Indeed, there are no apparent clues.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(I should find the opportunity to inspect the cabins...)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "*Thump*."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "*Thump* *thump*."
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "For the past few moments, he has been feeling a kind of strange tremor in his seatback.\nIs there perhaps some strange beast that kicks seatbacks on Kjerag's trains?"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "............"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "*thump* *thump* *thump*.\nAs though dissatisfied with his indifference, the kicking intensifies.\nAfter a moment, the child sitting behind him pokes his head out."
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Mister Funny Hat, Mister Funny Hat."
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Are you some kind of train freak? I saw you two days ago, too!"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You saw me...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yep!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Mister, did you fall in love with trains because you had never seen tracks or trains?"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ahem."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Mister, why did you clear your throat? It's okay. I'm not gonna make fun of you."
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "This train is really amazing. I love it, too! Mom told me that it's all thanks to the amazing Saintess and Sir Enciodes and how Kjeragandr has blessed us all!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mischievous Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "How about... I lend you my model train? We can play trains! We'll drive a train together!"
    },
    {
      "type": "dialogue",
      "speakerName": "Irritated Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Put your toys away! Go back to your seat and stop bothering strangers!"
    },
    {
      "type": "dialogue",
      "speakerName": "Irritated Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm truly, terribly sorry that he bothered you again."
    },
    {
      "type": "dialogue",
      "speakerName": "Irritated Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Rest assured, I'll teach him some manners!"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "No, it's fine..."
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(......)"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(This hat...)"
    },
    {
      "type": "dialogue",
      "speakerName": "Foreigner With a Funny Hat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Does it really look so strange?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There are quite a few passengers today. It seems this new Kjeragandr statue is very popular!"
    },
    {
      "type": "narration",
      "text": "Every time I get on the trains here, it reminds me of the arenas of the Kazimierz Major—\nYow! Something bit my toe!"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Is this... a fowlbeast?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Runaway Fowlbeast",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Biting hard)"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "O-Ow-Oww, please have mercy, fowlbeast!"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're going to just let it go?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You sure that's alright? I'm pretty sure pets aren't allowed on the train."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Indeed, that's the rule, but not everything is inspected so closely. They do cut their fellow countrymen some slack every now and then."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Relax. This kind of fowlbeast is usually kept in sacks. It should be no problem."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Let us speak of other things. Come, young lady, my cabin is just ahead."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Phew... Hah!"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Finally, a seat! It was so crowded back there!"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I didn't expect tickets for this train to be so hard to come by. Thanks for the help, dedushka!"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It was the least I could do, young lady."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "No need for the fancy title. Just call me Rosalind."
    },
    {
      "type": "narration",
      "text": "As the young lady wishes...\n'Rosalind.' It's a name that suits you well. A riveting sound to it."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It is pretty great, isn't it? My mamochka picked it."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What do I call you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My name is Harold. Of course, you can also keep calling me 'dedushka,' if please you."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're very lucky. Had you missed this train, you likely would not make it to Lake Silberneherze in time."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "For real?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hehe, good thing I made it, then."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're heading to Lake Silberneherze too, aren't you? What are you doing there?"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I believe I've already answered this question?"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Kjerag's landscapes are truly magnificent. Of course I must feast my eyes upon the sights she has to offer."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You can't fool me. There's not a single guy in your whole gang who looks like a tourist."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We don't look the part to you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Nope."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Uh, you look more like you came looking for trouble."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah, haha. Us? Perish the thought!"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm so enamored of Kjerag's scenery and culture. I'm even contemplating spending my retirement here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, right, so long as there are no major issues, we shall remain nothing but tourists, naturally..."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "And what if—"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "—How about you, Rosalind?"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You speak the Kjerag tongue fairly well for a tourist. Is this your first time here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Somebody's changing the subject hard and fast!"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hah."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Whatever. I didn't get to this part, did I?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You could call me half Kjerag, even if I don't really feel like one at all. I grew up in Ursus with my mamochka."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, so your mother is Ursine?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yep, but she told me I was born in Kjerag, and my papa is from here..."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't remember much about anything that happened when I was a kid. I guess you could call this a vacation."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm, I see."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "By the way, I've been meaning to ask since we met..."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What is that box you are holding, Rosalind?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, this...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Forgive me. If that intrudes upon your privacy in any way, you need not answer."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's okay. It's not really a secret or anything. I'm just figuring out how to explain it..."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's something that... my mamochka left to me."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My..."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Please accept my condolences."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I am sorry to raise such a painful topic, Rosalind."
    },
    {
      "type": "dialogue",
      "speakerName": "Harold",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Truly sorry."
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmph, what's so painful about this?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leto",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm here to fulfill Mamochka's wishes."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Burdenbeast Herder",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Madam Degenbrecher, I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Everything is okay now."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I've taken care of everything that needs taking care of."
    },
    {
      "type": "dialogue",
      "speakerName": "Burdenbeast Herder",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Thank you so much, Madam."
    },
    {
      "type": "dialogue",
      "speakerName": "Burdenbeast Herder",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "If it wasn't for you, who knows what would have happened to me? Thank Kjeragandr I'm still alive."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "This is all that I can do."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Sorry. It's not... a pretty sight."
    },
    {
      "type": "dialogue",
      "speakerName": "Burdenbeast Herder",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*sigh*. There wasn't any other way..."
    },
    {
      "type": "dialogue",
      "speakerName": "Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ma'am, you have blood all over you. Maybe you should clean up first?"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Later."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Time is of the essence. Even though I may have solved the problem for now, I can't guarantee this will be the end of it."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The most important thing is to find the one we're looking for."
    },
    {
      "type": "dialogue",
      "speakerName": "Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But, ma'am, we got news that they're already leaving the station."
    },
    {
      "type": "dialogue",
      "speakerName": "Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Asking the railway to stop the train would only cause a panic."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Stop the train?"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There's no need for that."
    },
    {
      "type": "dialogue",
      "speakerName": "Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What else can we do?"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Look down."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait..."
    },
    {
      "type": "dialogue",
      "speakerName": "Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The train is about to pass right under us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tschäggättä",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait, m-ma'am?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Her figure as she descends upon the train seems both lighter than snow and heavier than stone."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Right then."
    },
    {
      "type": "dialogue",
      "speakerName": "Degenbrecher",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Where might they be?"
    },
    {
      "type": "sceneBreak"
    }
  ],
