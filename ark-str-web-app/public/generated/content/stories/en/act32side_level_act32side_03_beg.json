    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sound from Loudspeakers",
      "speakerId": "avg_4123_ela_1",
      "text": "So much searching, so much lost♪"
    },
    {
      "type": "dialogue",
      "speakerName": "Sound from Loudspeakers",
      "speakerId": "avg_4123_ela_1",
      "text": "Maybe we'll see each other again, at the next corner♪"
