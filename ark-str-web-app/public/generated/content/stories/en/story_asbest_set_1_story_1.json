{
  "server": "en",
  "storyId": "story_asbest_set_1_story_1",
  "groupId": "story_asbest_set_1",
  "stageId": null,
  "title": "Strange Sights",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_asbest_1_1.txt",
  "sourceHash": "7b4eb73702285172527346ece51976a4bfa4b9781a540ae4b00332a699a6169f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Inam",
      "speakerToken": "avg_npc_075",
      "operatorId": null,
      "portraitKey": null,
      "text": "Here. Gavial told me you're with Rhodes Island too."
    },
    {
      "type": "dialogue",
      "speakerName": "Inam",
      "speakerToken": "avg_npc_075",
      "operatorId": null,
      "portraitKey": null,
      "text": "My lieutenants are all businessmen. I've taught them a little Sargonian. Talk to them if you need anything."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright. But why's that one staring at me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Inam",
      "speakerToken": "avg_npc_075",
      "operatorId": null,
      "portraitKey": null,
      "text": "We don't get many guests here, so it's a bit of an occasion."
    },
    {
      "type": "dialogue",
      "speakerName": "Inam",
      "speakerToken": "avg_npc_075",
      "operatorId": null,
      "portraitKey": null,
      "text": "It is for me, at least!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Look at that tail!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Long and fleshy... It looks so soft and flexible too... Are those orange patterns on it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Look, she's carrying all that stuff with her tail! And lifting that heavy door with one hand! Wow!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "She must be really good at wrestling. That tail looks like it could break a tree in half. She's so beautiful!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "I've never seen someone like that. I wanna be friends with her!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait, you're going up to her just like that? I, I'm not sure... whoa..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Metal Crab armor, Metal Crab greaves! Their hard shells stop any attack!"
    },
    {
      "type": "dialogue",
      "speakerName": "Serious Archosauria",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sawfin tooth hammer and Sawfin bone sword! Their sharp edges cut through anything!"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "(She's coming...!)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, hello!"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Something wrong?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh! Well, I like your tail!"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "?"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "My tail? The hell are you talking about?"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm busy. Outta my way!"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "(Whoa! She's scary...)"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, wait!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "No need to be angry, right? I said I like you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "What about you? Don't you think my tail's nice? People say I've got a cool tail!"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ha? What're you on about now?"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Go play in the mud with your friend."
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "You speak our language? In a pretty rowdy way, though..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm not playing in the mud! Did you think I'm a kid or something?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "...We'll have a fight!"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Seriously, what's wrong with you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Outta my way!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Are you nuts?"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Fine, you're nice, your tail's nice, super nice!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh? C'mon, gimme a break!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's a fight!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, watch out—woo, that's right, get your tail round her neck!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Serious Archosauria",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh no, my oil—hey, that was neat, using oil to slip out!"
    },
    {
      "type": "dialogue",
      "speakerName": "Group of Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Woo! Fight! Fight!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Quick, this bush will hide us."
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Haven't you guys fought enough yesterday? Why do I have to be here too?"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "And what about you two?"
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "She bought a bunch of stuff. Of course we want to check it out."
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "She took a few scales off my tail last time!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "She bought all that stuff, but she's living in a shed out here instead of in the village?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Not a bad spot though. That tree isn't too far from the river, but not so close that it would get flooded."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "S-She caught a huge bug!"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "She's frying it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "She's putting it on bread!"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "She ate it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ughh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Look at her, she's putting rocks in her soup."
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "That's the kind of salty rock that gives it more flavor. How did she know about them? I don't think anyone in the village told her."
    },
    {
      "type": "dialogue",
      "speakerName": "Serious Archosauria",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, she knows about those vines that you told me about too. The ones that have a tangy sweetness when you chew them."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Serious Archosauria",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Is she going out to catch fins?"
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe striped fins, but sawfins aren't so easy to catch. I've caught a few with my tail, but it hurts quite a bit."
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe outsiders can learn about the rocks and vines, but when it comes to fins—"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ha!"
    },
    {
      "type": "dialogue",
      "speakerName": "Serious Archosauria",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "How did she do that?"
    },
    {
      "type": "dialogue",
      "speakerName": "Serious Archosauria",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "She... I...."
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Pff."
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Let's go and find some vines."
    },
    {
      "type": "dialogue",
      "speakerName": "Serious Archosauria",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Two hours later"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Um, uh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Still tailing me? Did you think I didn't see you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What about your friend? Eaten by fins?"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Er, no, she saw you eat the bugs and got hungry too, but—"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Looks like she ate the wrong kind!"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "C-Can you help us out?"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Eh?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What is WRONG with you people?"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "It was because you ate them..."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "So what kind did she eat? How many?"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Not sure... and just a few."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Did she vomit? Is she conscious? Are there any spots on her skin? Swelling?"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Er..."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Forget it, I'll take a look myself."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No fever, no rashes. Take this herb and boil it in water. It'll make her throw up."
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Give her plenty of water."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "She threw up three times until there was nothing left, then fell asleep."
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Is she gonna be okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Asbestos",
      "speakerToken": "avg_378_asbest_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Just give her more water and stop yapping already!"
    },
    {
      "type": "dialogue",
      "speakerName": "Shy Archosauria",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
