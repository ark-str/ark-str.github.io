      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, back off!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "I had my eyes on her first!"
