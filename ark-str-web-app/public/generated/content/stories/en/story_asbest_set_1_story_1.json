    {
      "type": "dialogue",
      "speakerName": "Frank Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, and sorry about the other day. Kanna told me you outsiders don't like fighting. I shouldn't have hit you."
