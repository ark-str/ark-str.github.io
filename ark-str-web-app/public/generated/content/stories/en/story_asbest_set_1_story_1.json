    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's such a great place up here! So many vines growing here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Serious Archosauria",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Haha, you may be fierce, but you're pretty darn good!"
