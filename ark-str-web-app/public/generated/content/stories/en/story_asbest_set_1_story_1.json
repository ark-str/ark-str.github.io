    {
      "type": "dialogue",
      "speakerName": "Happy Archosauria",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "I took a look around. No poisonous bugs, so she won't die. Oh, and these vines grow here too? Wow, there's a lot of them!"
