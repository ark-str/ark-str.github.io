    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Traveler?",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(In ancient Sarkaz) Diαblo Balor'sača of the Condemnor Clan and Qui'lon the Errant Overlord will meet us on our way."
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Traveler?",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(In ancient Sarkaz) Oh, and he is here too..."
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Traveler?",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(In ancient Sarkaz) Gul'dul, 'The King of Sarkaz'—"
