    {
      "type": "dialogue",
      "speakerName": "Ermengarde",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...I don't know what misconception you have of Liches, but honestly, I'm not that old. Stop kowtowing."
