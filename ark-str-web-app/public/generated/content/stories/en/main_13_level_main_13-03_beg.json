    },
    {
      "type": "dialogue",
      "speakerName": "Ines",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Something's not quite right. We never passed by any area like this."
    },
    {
      "type": "dialogue",
      "speakerName": "Ines",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Nothing here casts any shadow. Is it an illusion?"
