{
  "server": "en",
  "storyId": "act35side_level_act35side_02_end",
  "groupId": "act35side",
  "stageId": "act35side_02",
  "title": "Special Museum Operation",
  "storyCode": "AS-2",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act35side/level_act35side_02_end.txt",
  "sourceHash": "15fba8a43f301d6aa204c73b8f463f497d2022581d3ef51731c0c335d57cd956",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ugh..."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Anat! You're awake?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*Gasp* My head hurts..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You hit your head when you fainted. That's probably why."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's not just my head. I'm aching all over. Why is there a bruise on my shoulder?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "And my knee?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ugh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Eek! Get away from me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Calm down, Anat! Calm down."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "How am I supposed to calm down when a corpse just came back to life? It touched my ears, didn't it? Do I still have my ears?"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's just copying other people's movements. It doesn't mean any harm, to you or anyone else."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Just treat it as a piece of moving furniture!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ugh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Why do you seem so comfortable with this, Pepe?"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't look at me like that, please!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What did you do?"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yesterday... I placed a gem that I dug up into its chest. The Originium circuit engraved into the gem woke it up."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yesterday?"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You wouldn't loan me an important archaeological discovery like this. The Varjavandabad Museum holds respect from the Shahanshah. Not even a shahzada like me could pull rank here."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "So... I had to sneak in."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There's a reason I didn't want to lend it to you, Pepe."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What is it? If you're worried about co-authorship, I'm cool."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's not that..."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Investment? Sponsorship? I'll renovate your entire museum, if you want!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Why are you looking at me like that?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't understand... why are you so obsessed with becoming the Historian of Shar-Agade? You can still carry on your research if you agree to inherit the title of Padishah from your father."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But once you become an historian and enter the City of Gold, you will never be allowed to leave. You know that."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "All that you learned in school, all the training you underwent to hunt ruins in the desert, all that you've seen on your journeys, all that will become useless if you're the Shahanshah's historian."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Are you simply not happy with the fact that your brother was chosen?"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My dream of becoming the court historian isn't some whim. It's the dream of everyone in my family."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We grew up dreaming about inheriting the golden reed pen from our elders."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "They tell you that whoever holds the pen carries great responsibility, to record all that has ever happened for posterity."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You are writing the truth of your time, the most complete truth that can be known, which needs no conjecture or investigation and can never be buried by sand and earth."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That is what I've always wanted to do."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I want to tell Sargon's history! I want the glory of the Shah to shine forever by my hand, and to inspire everyone who reads it."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Thousands of years later, someone I will never meet will pick up those pages and feel a connection to me and the Shah, linking the three of us."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't you think that's really romantic, Anat?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*Sigh*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I should have known that you wouldn't give up so easily..."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Shouldn't you and Titi have gotten used to my stubbornness by now?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Very well, on behalf of the museum, I approve the loan of the artifact... plus another gem."
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It was gifted to the museum by a private collector many years ago. We discovered that it was connected to the mummy, but we have no idea how to use it."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There's a gem at the museum too?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That's not the point. The point is I'm allowing you to access it."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're going to hand it over so easily?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I never said anything about easy. Co-authorship, investment, sponsorship, plus naming rights fees for the new exhibition hall."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Absolutely! With pleasure!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Pepe..."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Things don't always turn out the way we expect them to. I hope you understand this before you start your investigation."
    },
    {
      "type": "narration",
      "text": "Anat opens the drawer and takes out a wrapped package.\nShe unwraps it to reveal a pyramid-shaped gem, identical to the one that was placed in the mummy's chest.\nPepe takes the gem, holding back the urge to cry out in joy."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "'Second, the lungs. At their first breath, we come to feel.'"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't let me down."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Pepe reaches into the mummy's chest cavity. The gem is absorbed by the blue light inside as soon as it approaches."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Guardian, sealed in sand, I hereby return to you the memories lost to time."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Show the path to the Shah's trove, traveler from the past!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It stopped moving after I put in the second gem?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Did... you expect something different?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Eek—!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That wasn't me. Who's screaming?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It was Titi's voice."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Is something happening?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anat",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll investigate. Keep an eye on the exhibit."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Why didn't you tell me you were just an ordinary cloudbeast?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Well... I guess ordinary cloudbeasts don't understand human speech."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Looks like all the visitors have been evacuated. It's safe for us to go out now. Do you think you could find your way back to Lazvar if I put you down outside?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, stop hitting me! I'm carrying you so you don't have to walk yourself!"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "That's right. Awww, such nice fur... come, I'll introduce you to other little friends of yours."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Look at the imagery on this powder box. This cloudbeast is depicted in equal prominence to a high official. I restored this, by the way."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "And here. This mural is a rare treasure that came from Shar-Agade, the City of Gold."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "In order to accurately restore it, I looked through every book I could find on the Golden City, and even interviewed people who have been there."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait. Does that make me sound like I'm after the secrets of Shar-Agade?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Shouldn't think too much about it. You're just a cloudbeast, and there's no one else in the museum. It's not like what I just said would get me in trouble."
    },
    {
      "type": "narration",
      "text": "Suddenly, she hears the faint sound of cracking."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't tell me..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "No—! Why did the glass have to pick <i>now</i> to crack?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm dead if Anat finds out!"
    },
    {
      "type": "narration",
      "text": "Medjehtiqedti runs toward the display stand, and is shocked by the sight of broken glass littering the floor.\nDisplay cases use specially tempered glass. In the controlled environment of the museum, an accident like this should not have been possible.\nShe looks up to check on the exhibit, but finds the case empty under the pale light.\nShe feels a cold, sharp object pressing against her back as she attempts to examine the broken glass."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "If this is some kind of joke, you can stop."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm too busy for this."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Playing dumb? Which department are you from?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm going to dock your pay, if you don't start talking..."
    },
    {
      "type": "narration",
      "text": "Medjehtiqedti feels the object pressed against her back move away. She sighs of relief and turns around."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "One of the interns? You've got nerve, playing practical jokes on the vice curator. I'll let you off easy this time..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Eek—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You... you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Medjehtiqedti",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "How did you get out of your case?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Why haven't I heard anything else after that scream? Anat hasn't come back yet... well, I'll just look around."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Anat never changes, does she? She's the acting curator, yet her office still looks so bare and sparse."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "She had so many books back in the dorms. Why aren't there any here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "She must be hiding them somewhere..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I knew it. A hidden bookshelf in the wall."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm... My bookshelf at home is due for renovation... I should ask her to introduce me to the designer."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Let's see what you have here... <i>A Study on Tribal Religion in the Southwest</i>, <i>Review of Unearthed Riverside Jewelry...</i>"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "<i>Terra: A Journey,</i> by Dr. E. E. Erikson? The name sounds familiar... that's the Victorian scholar who came to speak at the college, isn't it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Lost of labels in here. I didn't know Anat liked his books so much."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Let's check the section on Sargonian history..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Narantuya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Finally, she's gone.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Narantuya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(This room sure is luxurious... is that gold thread woven into the cushions on the sofa?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Narantuya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(That's the mummy from the poster. They put it right here in the room? I'll never understand the tastes of rich people.)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Narantuya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(There she is... good, she's completely distracted...)"
    },
    {
      "type": "dialogue",
      "speakerName": "Narantuya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(With apologies...)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Narantuya walks up softly and reaches into her pocket, taking out the syringe that she has kept hidden within.\nShe spent countless days and nights training, even when blisters formed on her feet, in order to be able to walk across a sand dune without leaving any footprints.\nNow, she can walk through a crowded market, bells hanging from her neck, without making a single sound.\nA Padishah's daughter stands before her. All alone."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "When Narantuya raises the syringe, however, a hand suddenly grabs hers and immobilizes it in midair."
    },
    {
      "type": "dialogue",
      "speakerName": "Narantuya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "—?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Narantuya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(A hidden bodyguard?)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Narantuya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(You—!)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Narantuya cannot speak.\nThe mummy laying on the sofa has appeared behind her, grabbing her hand with a steely grip.\nHer struggles are futile, and all she can do is watch in terror as the needle approaches her own neck.\nThe other hand of the mummy is clasped across her mouth, not letting go until the entire contents of the syringe have been injected into Narantuya's veins."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "As her consciousness gradually fades, she feels the hand lift her by the collar and hold her outside the window.\nOne last thought flashes through her mind as she feels her feet dangling in the air.\nIf only she had more competent subordinates."
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "An insect lurking in the dark."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What's that sound?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Y-You're moving again?"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My mind is no longer clouded. There is clarity. I must communicate my cognition through language."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "A-Are you alive?"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My life has long passed. What you see is simply a well-preserved vessel."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Who are you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "In times of prosperity, I was His Majesty Lugalszargus Shahanshah's personal guard, defending him from the fires of battle."
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "In times of decline, I willingly forsook the sweet release of death for the eternal torment of time, defending His Majesty's trove from invaders, safeguarding the Shahanshah's vow, and awaiting..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Awaiting the return of the Shahanshah."
    },
    {
      "type": "dialogue",
      "speakerName": "Pepe",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "H-How should I call you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My name is Zubayidamu Yanur Ayyusuiz."
    },
    {
      "type": "dialogue",
      "speakerName": "Nameless Mummy",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You may call me—Zubayr."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Mother, what is that lady doing sitting by the pond, staring down at the water?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "She's dressed in Minoan clothes. The Minoans are said to be great thinkers and debaters."
    },
    {
      "type": "dialogue",
      "speakerName": "Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "She must be thinking about deep, philosophical questions..."
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Philo... what?"
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But she looks so pretty, sitting there alone..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Museum Security",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hanimefendi, the museum is closed."
    },
    {
      "type": "dialogue",
      "speakerName": "Aspasia",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I know. I'm waiting for it to reopen."
    },
    {
      "type": "dialogue",
      "speakerName": "Museum Security",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Well... I'm afraid there's currently no schedule for reopening."
    },
    {
      "type": "dialogue",
      "speakerName": "Museum Security",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "According to procedure, the curator must declare the emergency resolved, perform a risk assessment, and report to the stakeholders before a reopening date can be announced."
    },
    {
      "type": "dialogue",
      "speakerName": "Aspasia",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I know. One of your colleagues already told me."
    },
    {
      "type": "dialogue",
      "speakerName": "Aspasia",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "As you can see, I'm waiting."
    },
    {
      "type": "dialogue",
      "speakerName": "Museum Security",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You said you left something in the museum?"
    },
    {
      "type": "dialogue",
      "speakerName": "Aspasia",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes."
    },
    {
      "type": "dialogue",
      "speakerName": "Museum Security",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Is it very urgent? Could you wait for our staff to look for it? We can contact you once we've found it."
    },
    {
      "type": "dialogue",
      "speakerName": "Aspasia",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "No, I can't wait."
    },
    {
      "type": "dialogue",
      "speakerName": "Museum Security",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "How about this... I can unlock the door, and we'll have someone accompany you inside."
    },
    {
      "type": "dialogue",
      "speakerName": "Aspasia",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Thank you—"
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Mother..."
    },
    {
      "type": "dialogue",
      "speakerName": "Mother",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What is it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Curious Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Is someone jumping from that window?!"
    },
    {
      "type": "narration",
      "text": "Aspasia looks up at the child's cry and sees a woman falling from high up."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "With little time to think or look to the guard opening the door, she dashes over and holds out her arms."
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
