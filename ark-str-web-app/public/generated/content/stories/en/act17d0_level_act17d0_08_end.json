{
  "server": "en",
  "storyId": "act17d0_level_act17d0_08_end",
  "groupId": "act17d0",
  "stageId": "act17d0_08",
  "title": "Infiltration Battle",
  "storyCode": "OD-8",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act17d0/level_act17d0_08_end.txt",
  "sourceHash": "2c03ed1f1588cfb14ebb6374669d9c153405417b67a90b8da7f2486a9c65a739",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "It's still moving!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "Bomb deployed! Time to go!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "It... looks like it's budding?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "What on earth... is it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "text": "Whatever it is, it doesn't belong in this world.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "text": "We have to evacuate. We need to get out before the bomb goes off.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "This way!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I'm out of ammo.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Rangers?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I'm still here...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "You don't look so good.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I'm old, so old... phew...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "What happened to your hand?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I couldn't dodge. That's all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "What do we do now? Should we go to the shelter?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "No news from the mine?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "None.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Hahaha...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I never thought we'd hold out this long... but we're almost to the end of the road.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "What are you doing?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Making a shield. I always wanted to try, actually.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Hahaha...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "What a trip down memory lane. Back to the glorious good old days.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "The young rangers all gathered at the edge of town.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Knowing the overwhelming odds stacked against them, knowing most would spill their blood in the wasteland after the war.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "But they laughed and sang war songs, as if they were facing down bugs to be easily squashed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "War is cruel, and merciless. Some backed down. Many more held the line.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "The fallen became legends. The survivors were tasked with remembering them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "And the last one standing in that bloodbath, after all that time, started to feel the fear of death set in.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "Because he doesn't want the dead to be forgotten?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Hahaha... maybe that's why.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "It's been an honor to fight alongside you, Alexsandr.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "The honor is mine, Rangers.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "But don't be so gloomy. I haven't given up the fight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tachanka",
      "text": "I'll smash a few to death.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Wait... what's that?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "The cavalry's here! Hahahahahaha! We're saved!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "This technique... Must be that young person.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "I picked up a Rhodes Island distress signal and figured it was a normal rescue mission.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "I didn't think I'd run into you.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "Old Ranger.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "You're back in business, huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Haha, at my age? You're making fun.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "What about your sword, Ranger?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "I'm too old. I haven't been able to swing it for years.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "If it weren't for you, today would be the end of these old bones.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "You sell yourself short, Old Ranger.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "Listen up, squad. The objective is the Lord's manor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "The enemy is an extremely dangerous form of Originium organism.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "Keep your location updated.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Be careful. There's many of them. Try not to let your folks fight alone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rangers",
      "text": "Also, be mindful of the ground. They are good at drilling.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "Understood.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "It's an honor to fight beside you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Stormeye",
      "text": "'Scimitar of the Bloody Valley'.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
