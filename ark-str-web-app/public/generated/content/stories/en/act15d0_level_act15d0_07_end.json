  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Urgh, god dammit, where in the world did my card key go..."
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Did I flush it while taking a dump?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "Chief Barton, what's wrong?"
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Mind your own business!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "Y-Yes, sir!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "Tsk, stuck-up asshole..."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer B",
      "speakerToken": "avg_npc_136#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm guessing... someone probably pissed him off."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "Heh, probably Anthony."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't really know what's going on, but it seems like someone's trying to kill him."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "Barton likes to brag about how perfect the prison is. This is gonna keep him on tenterhooks."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer B",
      "speakerToken": "avg_npc_136#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're prison guards, you know."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "Eh, it's not someone getting killed that I'm happy about. I just like seeing him so peeved."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "Besides, let's be honest. We've seen Randal and Barton do so much dirty work over the years."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "If you ask me, I think Randal knows who sent these hitmen in here. He's just turning a blind eye because he's in their pocket."
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer B",
      "speakerToken": "avg_npc_136#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "Gah..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Don't move, Robin."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Don't make me kill you."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#2",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Well, damn, Robin. You're good. Even I didn't have you pegged for a spy."
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#2",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "I think you just might have a gift for this gig."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#4",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Wait a minute. What are you holding?"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#2",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Whoa, that a bomb switch?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#4",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Kafka, lower the tower right now!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#2",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Whoa! It's burning!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#4",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Hurry!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#5",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "I forgot which one's which!"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#5",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "And I kinda get the feeling these probably aren't gonna work anymore!"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#5",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Oh, there we go! Should be this one!"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#5",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Please! Please work!"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#5",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "There!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#5",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "It's not moving! Is the thing broken?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#4",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Robin, why are you doing this?"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#5",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "It's going down!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Dagnabbit!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Whatever, I don't even remember when was the last time I was up there."
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Just need to have Randal make me a new one."
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Tsk."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "Chief Barton, you..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "What?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "What are you doing?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm heading upstairs to see how those damned fools are doing with the clean-up work!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Jailer A",
      "speakerToken": "avg_npc_134",
      "operatorId": null,
      "portraitKey": null,
      "text": "What... What happened here?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Barton",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "What in the name of... What's going on here?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hold onto something, Kafka!"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Anthony, over there! Robin's gonna get thrown into the elevator!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hold on tight, Robin!"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Why..."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Save it for later!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "avg_npc_135#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Get ready!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#5",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Anthony, you and Robin okay?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I'm fine. I got Robin."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Seems like the whole prison's power went out. It's pitch dark here."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "This is an opportunity for us."
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#4",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Yes."
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#4",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "It feels like the tower crashed straight through the floor."
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#4",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "We're probably at the second floor basement. Still some distance away from the clinic."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#1",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Right, we should get going before the jailers get here."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#1",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Robin, are you okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I-Is it really a good thing that I'm okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "It is."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Don't let it get to you."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I did tell you before you could keep trying to kill me."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "If you think you betrayed me for what you did, let me tell you this—"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I'm afraid none of us are close enough to talk about trust just yet."
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#2",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Heh, not even me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Not even you."
    },
    {
      "type": "dialogue",
      "speakerName": "Kafka",
      "speakerToken": "char_214_kafka_1#2",
      "operatorId": "char_214_kafka",
      "portraitKey": "char_214_kafka",
      "text": "Oh, come on, that's cold."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Wouldn't you say it's more problematic to completely trust a person after just a few months?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Of course, I am a little disappointed, but that's all."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Nonetheless, I'm curious. I can tell you weren't acting when we were working together. You can't fake those emotions."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Why did you do this, Robin?"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "My father. He made lots of money, and he was nice to me. I'm proud of him."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "But one day, his company went bankrupt."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "And he's been a failure ever since."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "So he changed. He started drinking a lot, and he got angry. He hated everything around him."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "My mother left him. He was heavily in debt, and in the end, went into the hospital with liver problems, and so many other complications I don't even get the details of."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "My mother tried to talk me into moving in with her."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "But I never forgot how well my father used to treat me."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I wanted to do something for him. So I gave up my hobbies. I tried taking on all kinds of jobs, but the medical bills kept coming."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "Then, one day, someone came to me. He said he could give me lots of money. I just had to kill someone for him."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "And I'm the target."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I see. I can't offer you anything, and that's why you made this choice."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#3",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "No, he's been watching you here, dressed as a jailer. His name is Jesselton."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#3",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "After you made me the offer, he found me and told me—"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#3",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "The very last thing that the Simons did was destroy my father's company."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "My goodness."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "In that case, not only should I not hold this against you, I must apologize."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "No, don't apologize. That isn't what I'm trying to say."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#3",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "It's not like that, Anthony."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#3",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I knew I was doin' wrong. I knew I shouldn't do it."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "But I gave up."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I didn't know what I was supposed to do, otherwise. I just didn't know."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I'm tired. My mother wanted me to make a choice, my father wanted me to make a choice, life wanted me to make a choice, Jesselton wanted me to make a choice, and even you wanted me to make a choice."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I don't wanna make any choices. I don't wanna judge what's right or what's wrong, good or bad. I just don't want to."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I'm sick of it! Why do I have to choose?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "But, you know, Robin, you can't just hand off your decisions."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "You have to think everything through and make your own choices. Then, you need to take responsibility for each of those choices."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Otherwise, you'll never be able to take your fate into your own hands."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "This is the most important thing I've learned during my years here in prison."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Strength is important, and so is intelligence, but the most important trait of all is courage. The courage to make your own decisions and pay the price for them."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I'm afraid of making wrong decisions myself, but I can't let that get in the way of making decisions at all."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I used to think I had no one to rely on because I hadn't found anyone reliable, but I've come to realize there is no one we can truly rely on anywhere in this world."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "No one but ourselves."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I'm sorry I didn't notice your pain in time, Robin."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I must reiterate. What you've done almost ruined my escape plan. That's why I won't forgive you so easily."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Nonetheless, as someone who has suffered a similar situation, I hope you can forget about all this for the time being."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "You must scrutinize yourself and think about what it is that you want to do."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#6",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "What it is... that I want to do..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "Domma's room is right up ahead. You have all the time you need to think."
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#3",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "I understand if you don't completely trust me, but I told Jesselton everything about your plan. He's definitely waiting for you somewhere up ahead."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#5",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "I know."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, you don't hafta worry about finding me. I've been waiting for you right here."
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Robin",
      "speakerToken": "char_451_robin#2",
      "operatorId": "char_451_robin",
      "portraitKey": "char_451_robin",
      "text": "It's coming from Domma's room!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anthony",
      "speakerToken": "char_264_Mountain_1#6",
      "operatorId": "char_264_Mountain",
      "portraitKey": "char_264_Mountain",
      "text": "You don't mean...?!"
    },
    {
      "type": "sceneBreak"
    }
  ],
