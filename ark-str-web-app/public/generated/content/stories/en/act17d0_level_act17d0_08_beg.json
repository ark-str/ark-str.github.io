    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#6",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "Okay, okay, he's had enough."
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "char_456_ash_1#1",
      "operatorId": "char_456_ash",
      "portraitKey": "char_456_ash",
      "text": "Phew..."
    },
    {
      "type": "dialogue",
      "speakerName": "Blitz",
      "speakerToken": "char_457_blitz_1#6",
      "operatorId": "char_457_blitz",
      "portraitKey": "char_457_blitz",
      "text": "You went a little overboard there."
