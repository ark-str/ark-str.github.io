    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ash",
      "speakerToken": "avg_npc_158_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And this one's for Dr. Miarow."
