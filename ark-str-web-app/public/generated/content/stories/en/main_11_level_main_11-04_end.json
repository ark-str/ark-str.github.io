{
  "server": "en",
  "storyId": "main_11_level_main_11-04_end",
  "groupId": "main_11",
  "stageId": "main_11-04",
  "title": "Equivalent Exchange",
  "storyCode": "11-5",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_11-04_end.txt",
  "sourceHash": "67e642d5f460890b38f070620cd48ca9bafcdc2a9089b02045c0e2ea7a5e33ca",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "speakerToken": "avg_npc_012",
      "operatorId": null,
      "portraitKey": null,
      "text": "We have a signal, Amiya!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "avg_npc_394_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Good."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "avg_npc_394_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Casters! Hold the shield with me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "avg_npc_394_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Everyone else, get to the corner!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The Sarkaz casters raise their staves together."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Monsters made of blood rush up from underground. The entire street opens its gaping maw beneath the soldiers."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "avg_npc_394_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Nngh—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "avg_npc_394_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "There's too many of them!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Black lines cut through the flesh of the monsters, but even more rise again from the fallen, gnawing away at the Arts forming a defensive barrier.\nThe fighters run for their lives, but the stench from the predators' jaws is never far behind.\nFinally, they make it into another alley, and find themselves face-to-face with an aura that is potent, pure and fearsome."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Stop."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The bloody tide stops in its tracks.\nIt was as though they ran into an invisible wall when they rounded the corner. The maggot-shaped Arts creations smash themselves into pieces, leaving bloody trails on the ground.\nThe empty street is completely silent."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "avg_npc_394_1#11$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Casualties?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "speakerToken": "avg_npc_012",
      "operatorId": null,
      "portraitKey": null,
      "text": "We're fine. We got out quick enough."
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "speakerToken": "avg_npc_012",
      "operatorId": null,
      "portraitKey": null,
      "text": "I hope we've delayed the Sarkaz, made things safer for Allerdale and Siege..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "avg_npc_394_1#8$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Thanks, everyone, especially our Self-Salvation Corps friends. Thank you for being willing to take this risk with us."
    },
    {
      "type": "dialogue",
      "speakerName": "Self-Salvation Corps Fighter",
      "speakerToken": "avg_npc_398_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Commander Clovisia calls Rhodes Island our most important ally. We're always ready to do what we have to."
    },
    {
      "type": "dialogue",
      "speakerName": "Self-Salvation Corps Fighter",
      "speakerToken": "avg_npc_398_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Plus, if this Rhodes Island operator here hadn't helped us, that Vampire would've done all of us in a long time ago."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "avg_npc_650_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No need to thank me."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "avg_npc_650_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I've seen too much meaningless killing in Londinium. I must stop my compatriots who have gone too far."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Feist",
      "speakerToken": "avg_4072_ironmn_1#8$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sorry, Doctor..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "I thought I was just coming home with you.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Are we not welcome?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I had, er, a little fight with Granny when I skipped out of the factory last year."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "A dozen big, bruising workers surround you.\nTheir eyes are filled with suspicion."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "You glance at the drills and spanners in their hands, then at Feist, dressed like the workers, but here on his own."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Seems like it was more than a little fight.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Are you sure they're not hostiles?",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I guess Granny is still sore at me..."
        },
        {
          "type": "dialogue",
          "speakerName": "Catherine",
          "speakerToken": "avg_npc_648_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I've got no reason to be sore at a dead man. I didn't even know my only grandson was still alive, 'til a minute ago."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I wanted to send a message, but it was too risky. The Sarkaz monitor all communications into Highbury."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I can't let the Sarkaz tie you to the Self-Salvation Corps."
        },
        {
          "type": "dialogue",
          "speakerName": "Catherine",
          "speakerToken": "avg_npc_648_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "So you joined that band of crackpots."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#11$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "...The Londinium Citizens' Self-Salvation Corps."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "We did a lot in Sudean, Granny. The Sarkaz control the media, and they call us an 'unnamed violent gang'..."
        },
        {
          "type": "dialogue",
          "speakerName": "Catherine",
          "speakerToken": "avg_npc_648_1#6$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You're the ones who blew up the wall."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Er... it was the Do..."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "The Sarkaz damaged the walls while pursuing the Corps.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Feist",
              "speakerToken": "avg_4072_ironmn_1#8$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "Right... it was mostly the Sarkaz who did it."
            }
          ]
        },
        {
          "label": "Your grandson fought bravely in the battle.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Feist",
              "speakerToken": "avg_4072_ironmn_1#4$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "Thanks, Doctor."
            },
            {
              "type": "dialogue",
              "speakerName": "Feist",
              "speakerToken": "avg_4072_ironmn_1#4$1",
              "operatorId": null,
              "portraitKey": null,
              "text": "I didn't know you had such high regard for my rope work."
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Catherine",
          "speakerToken": "avg_npc_648_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "So you're here to blow up the armory?"
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Of course not!"
        },
        {
          "type": "dialogue",
          "speakerName": "Catherine",
          "speakerToken": "avg_npc_648_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "What did you say to your Self-Salvation Corps friends? We're making weapons for the Sarkaz, to use against Victorians?"
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "No, Granny. What I told them was..."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "My granny stands up to protect their livelihoods."
        },
        {
          "type": "dialogue",
          "speakerName": "Catherine",
          "speakerToken": "avg_npc_648_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I know you think I'm a brat with little more than a couple of silly tricks."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But I didn't come back to drag the workers into this. And I'm not here to try to convince you, either."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I have my goals, of course, and it'd be brilliant if you were able to help me. But first—"
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I just wanted to see that you're safe."
        },
        {
          "type": "dialogue",
          "speakerName": "Catherine",
          "speakerToken": "avg_npc_648_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Come here, and let me have a look at you."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Granny..."
        },
        {
          "type": "dialogue",
          "speakerName": "Catherine",
          "speakerToken": "avg_npc_648_1#10$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You've put on a few inches, brat."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerToken": "avg_4072_ironmn_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Yeah, I grew a little bit."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "I'll have the goods soon."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "A suit of steam armor... how many men would kill to get one like it?"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "The nobles of Leithanien love to flaunt such storied antiques."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Oh, and do be sure to ask those Columbian firms as well. They might be interested, even if the tech is centuries old."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Getting it out will be no trouble at all. What business do you think I'm running in Londinium these days?"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "The Sarkaz are a gang of raving psychopaths, and they alone can't rule Londinium."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "I have friends in the Defense Forces. They'll take care of it for me."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "I've heard it has a few external blemishes, however. I do hope that won't hurt the price?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Why not cancel the deal, if you're so worried about the price?"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Who's there?!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Don't worry, we just happened to be traveling the same way."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Get this intruder out of here!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Say... where are my bodyguards?"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I've asked them to take a short nap. You can go and wake them once we've finished our chat."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "All of them...? Against just one of you?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "One? Oh, my, no."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Look behind you."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "You... this is Londinium! I've got friends in high places!"
        },
        {
          "type": "dialogue",
          "speakerName": "Indra",
          "speakerToken": "avg_155_tiger_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Oh? Where are they? Do tell, I bet I'd get on famously."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Eek! D-Don't do anything rash, now!"
        },
        {
          "type": "dialogue",
          "speakerName": "Indra",
          "speakerToken": "avg_155_tiger_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Play nice with us and nobody has to get beat."
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerToken": "avg_npc_396_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Whatever Siege says, you do."
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerToken": "avg_npc_396_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Otherwise, my claws won't be aimed at the wall next time."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "A-Alright! I understand!"
        },
        {
          "type": "dialogue",
          "speakerName": "Indra",
          "speakerToken": "avg_155_tiger_1#5$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "...Seriously?"
        },
        {
          "type": "dialogue",
          "speakerName": "Morgan",
          "speakerToken": "avg_npc_405_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You really got into it there."
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerToken": "avg_npc_396_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I learned it from you lot."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Now then, let him go."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "*whimper*..."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You can open your eyes and put your hands down now, Mr. Bader. We're not going to hurt you... at least not yet."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "What do you want?"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "My terms are clear. Cancel the deal for the Cumberland steam armor."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "And you'll let me go if I agree?"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Yes."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "But I'll make sure you keep your side of the bargain."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Show Mr. Bader our map, Morgan."
        },
        {
          "type": "dialogue",
          "speakerName": "Morgan",
          "speakerToken": "avg_npc_405_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "With pleasure."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "The marks on the map... those are my warehouses! How do you know about them?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You don't pay much attention when you're out and about."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "You shadowed me?"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Correct. The Sarkaz cannot be bribed. If they learn that you've smuggled so much contraband into Londinium through your 'connections'..."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "How helpful do you think your friend will be? Will he be in any position to protect you?"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#10$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You're considering tipping off the Sarkaz."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#10$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "That may well get us all killed, but they won't have to know anything if you continue to work with us."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Do I have a choice?"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I understand your circumstances, and I appreciate the opportunity to work with you. You will be compensated fairly."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "Wait a second..."
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "What is your relationship to Allerdale Cumberland? Are you her attendant? I can't imagine House Cumberland is in any position to hire one..."
        },
        {
          "type": "dialogue",
          "speakerName": "Indra",
          "speakerToken": "avg_155_tiger_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Watch your mouth! The Cumberland serves Vina, not the other way 'round!"
        },
        {
          "type": "dialogue",
          "speakerName": "Londinium Merchant",
          "speakerToken": "avg_npc_177",
          "operatorId": null,
          "portraitKey": null,
          "text": "She's the daughter of a duke! You don't mean..."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "No. I'm nobody."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Lady Cumberland and I are comrades, along with thousands upon thousands of Londiniers who long for peace."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerToken": "avg_npc_407_1#3$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I do hope you're one of them, Mr. Bader."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Knight",
          "speakerToken": "avg_npc_240",
          "operatorId": null,
          "portraitKey": null,
          "text": "All those loyal to this land stand with me. The final battle against evil lies before us."
        },
        {
          "type": "dialogue",
          "speakerName": "Knight",
          "speakerToken": "avg_npc_240",
          "operatorId": null,
          "portraitKey": null,
          "text": "Children... do you live here?"
        },
        {
          "type": "dialogue",
          "speakerName": "Knight",
          "speakerToken": "avg_npc_240",
          "operatorId": null,
          "portraitKey": null,
          "text": "Hide not in the corners and shadows. Even if you cannot hold a sword..."
        },
        {
          "type": "dialogue",
          "speakerName": "Knight",
          "speakerToken": "avg_npc_240",
          "operatorId": null,
          "portraitKey": null,
          "text": "There is more to being a warrior than simply holding a sword. Open your eyes. Watch, listen, think."
        },
        {
          "type": "dialogue",
          "speakerName": "Knight",
          "speakerToken": "avg_npc_240",
          "operatorId": null,
          "portraitKey": null,
          "text": "Tell me what is right, what is wrong, and what kind of life you wish to live."
        },
        {
          "type": "dialogue",
          "speakerName": "Knight",
          "speakerToken": "avg_npc_240",
          "operatorId": null,
          "portraitKey": null,
          "text": "I march onwards, with you as my witnesses."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Molly",
          "speakerToken": "avg_npc_657_1#7$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Brilliant! Look how good Ralph is, Lady Golding... how much he's grown. And to think he was a mischievous little beastling just four years ago!"
        },
        {
          "type": "dialogue",
          "speakerName": "Golding",
          "speakerToken": "avg_npc_647_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Yes, I'm delighted. A handkerchief, Molly?"
        },
        {
          "type": "dialogue",
          "speakerName": "Molly",
          "speakerToken": "avg_npc_657_1#2$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Handkerchief? Oh, yes, I can't stain my clothes with tears in front of the children... Oh, but I just can't stop crying, to think that Ralph and the other kids will be leaving school so soon..."
        },
        {
          "type": "dialogue",
          "speakerName": "Golding",
          "speakerToken": "avg_npc_647_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "It's time for them to have a rest. And us, too."
        },
        {
          "type": "dialogue",
          "speakerName": "Molly",
          "speakerToken": "avg_npc_657_1#1$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Yes, the final scene... that's the best part."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Molly",
          "speakerToken": "avg_npc_657_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Who's clapping?"
        },
        {
          "type": "dialogue",
          "speakerName": "Molly",
          "speakerToken": "avg_npc_657_1#8$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "You didn't invite anyone to the rehearsal today, did you?"
        },
        {
          "type": "dialogue",
          "speakerName": "Golding",
          "speakerToken": "avg_npc_647_1#10$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "......"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "The teachers cast their glances toward the back of the classroom.\nA man in military attire claps slowly by the door."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerToken": "avg_npc_649_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "What a splendid performance."
        },
        {
          "type": "dialogue",
          "speakerName": "Golding",
          "speakerToken": "avg_npc_647_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "...Lt. Colonel Lettou."
        },
        {
          "type": "dialogue",
          "speakerName": "Golding",
          "speakerToken": "avg_npc_647_1#4$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "I didn't think the Commander of the Defense Forces would grace this classroom with his presence."
        },
        {
          "type": "dialogue",
          "speakerName": "Lt. Colonel Lettou",
          "speakerToken": "avg_npc_649_1#9$1",
          "operatorId": null,
          "portraitKey": null,
          "text": "Good afternoon, ladies."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
  "observedOperators": []
}
