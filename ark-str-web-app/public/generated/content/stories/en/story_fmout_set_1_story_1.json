{
  "server": "en",
  "storyId": "story_fmout_set_1_story_1",
  "groupId": "story_fmout_set_1",
  "stageId": null,
  "title": "'Divination'",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_fmout_1_1.txt",
  "sourceHash": "ceb1c47d24f027a9ef63abb8b14edb6788e26acf5d2b8b20e01b4650879a9004",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "个人剧情 远山"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Weekend\nRhodes Island Cafeteria"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "And so, just like that—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "And your cards naturally fall like water from one hand—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Into the other.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Wow!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Do you know how?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "I still don't!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Do it again, Gitano!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "*clears throat* Now, watch carefully.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Okay—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Wow!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Do you understand now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Nooope—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Really?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Regrettably, however, that's the end of today's cardistry lesson.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Awww—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "How about one more time?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Then the person teaching here in a short while will be quite angry with me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You wouldn't want to see me get castigated, would you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Just one more, one little bit more? It'll be okay, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Rules are very important. You cannot let your desires lead you to willingly abandon them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Hmm—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Such as it is, I'll give you all some homework.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "If anyone can show us the fruits of their practice by next week's lesson...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Then—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You may draw one reward from the teacher's Treasure Chest.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "The Treasure Chest?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Really?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Really and truly. Just two days ago, your teacher even added something quite fun to it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "As long as you can summon the courage to give us all a display, everyone will get a share.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Yay!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Alright, class dismissed. Don't forget, keep your cards and toys safe with you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "We'll meet next week.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Bye, Miss!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Phew...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Phewie and a half. Breathe easy, miss. Lessons still runnin' slick?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You might get the impression they're lessons, but it's really just entertaining the children.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You have the greater burden.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "It takes quite a lot of brainpower and effort, teaching children the rules of arithmetic.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ain't no nightmare, really. Play numbers long 'nuff 'n they get it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "'n what I teach ain't no mathematics. Umm, what was that name I picked it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "'Business Fanatics Class?' Somethin' like that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Aw, shucks, I'm just the same as you. Three cheers fer fun 'n none fer learnin'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "And that's quite good.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "After all, it's a very cruel thing, doing business.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "You get me, ma'am.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Though it was never originally intended as such, divination is also fundamentally a sort of business.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So it goes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I'll let you set up the classroom in peace, then. Farewell.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Hrmmm—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Oh, right!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Gitano, one second, please!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Do you need anything?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "It's like this, see. Doctor seems fixin' ta head out far with Gavial, makin' fer a corner of Sargon.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Mm-hm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "And me, I'm gettin' ready to visit with, see if I can't do a li'l dealin' while I'm there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Yes, I follow.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So I thought, uh. Y'see, uh. If you could juuuuust do me a li'l favor, gimme a tellin'?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You ought to know—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "I know there is, yep, just, urm, how do I break this—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Spent all my money on gettin' stock in, ha, and now I ain't got a red cent on me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "*Sigh*.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I won't take any money as compensation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ya serious? That's mighty fine!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "But I will need you to promise something.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You must promise me this—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You will not sell anything to the children during class.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Not even if it's 'just snacks.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Uh, haha.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Aw, heck, what makes you think I'd do somethin' like that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Class might be a circus, but I still teach 'em proper.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You might, you might not. Neither has any bearing on me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I simply need your promise, and that will be my price.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "'n if I go back on it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Who knows?",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成懊恼"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Hm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "What do you think?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Sold!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I have accepted your payment.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "No need fer a... contract or somesuch?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Hmm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Our agreement is built upon our trust in each other. We need no contract.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Huh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "In that case, let us begin.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Considering class is about to start, we'll employ a more simple divination method.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "(Pulls out tarot deck)",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Whoa, that's... some crafts, ain't it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Feels like every card in there'd fetch big money.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Way you spread out 'n spin' 'em on the table, is that shufflin'?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Yes. Please wait a moment.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Could just shuffle 'em fancy in one shot, like you were teachin'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Some diviners will do it like that, true.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "But it's too harmful to the cards.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Just like the voyager pushing stubbornly through a blizzard: no matter how healthy, or how warm the clothes, their warmth is pulled away trace by trace in the end.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "The moment warmth is lost, all remedy will be of avail no more.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ahaha...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Just a comparison Sami tend to use fairly often. I imagine you comprehend it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Yup, yup, I getcha.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "All ready now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Mm. They're ready. They should be able to shine a light for you on some of your conundrums.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Gather them together, cut them once, and starting from where you've cut them, lay down three cards.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Remember, do not turn them over yet.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So ya don't actually do a darn thing, Gitano?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I'm merely your guide in understanding. Shouldn't you uncover your own fate?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Or, perhaps, you're easily willing to lay your fate in others' hands?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Alrght, I get it now. Lemme at 'em!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Stack 'em up... cut... lay three cards face down in front.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "That oughta be good, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Your movements are very direct. It seems you are not adrift.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Darn tootin'.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Well, then. Please.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Turn a card however you wish.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ya been so dead serious all this time. Got some pressure on me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "There's nothing to be scared of. Come.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Reveal your first card.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "(Flips card)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "The Knight of Cups, Reversed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ya gotta fill me in. Does forward or backward matter anythin'?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "To put it simply, reversed cards symbolize that you are currently hindered by something.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Huh?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Relax. These hindrances are not necessarily bad in meaning.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "They simply mean that right now, you are unable to successfully proceed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Breakthrough, and success, perhaps aren't too far away.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Gotcha.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Let me look carefully.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Have you run into any problems doing business?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Uh, suppose I have.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "That's how it goes more or less every month. Sometimes I blunder decidin', 'n then I don't earn nothin.' Pain in my keister.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You've probably seen an opportunity, but failed to grasp it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "That's the story of anyone doin' business any day of the week.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "So this time, you've prepared to stake it all?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "I trust my intuition. Headin' to Gavial's ol' place is gonna pay off big!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I see.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "By my understanding, Rhodes Island's procurement services have always been short of hands. As long as you're willing to help them with some work, money won't be a problem, and most risk will be shouldered by Rhodes Island instead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Why choose to go it alone?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "That, huh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Used to workin' by myself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "It seems your decisions are not wholly profit-seeking.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ain't as grand as ya put it, neither. Just seein' the world fer myself, makin' some money on the side to patch up expenses.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Always gotta spend money fer the good stuff, after all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So this, uh, this here card, basically, it ain't no good sign.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Coming events will not be smooth.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So can I just—Gitano—ya gotta teach me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Don't rush. This is merely a beginning.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Come. Reveal your second card.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "D'awwwgh, alright...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "(Shakes as she flips a card)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "The Ace of Wands, Upright.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Wh... what's this one mean...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You have seized an opportunity, and are about to receive an advantage in life from it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Though there may be great danger, you have issued your challenge to life with full conviction.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Sounds like a good thing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "When I divined for myself, I once came to this one too.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Whoa—y'all can even do divination fer yerselves?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "When a flash of miraculous light strikes, diviners are utterly capable of peering into their own paths.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "'n here I thought diviners only took money 'n did stuff fer other folk.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Ultimately, currency cannot settle all questions.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Moreover, there are some paths outsiders have no recourse to interfere in. Only by conversing with themselves, feeling through things, pursuing, can they grasp a chance at a clue.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Gets pretty darn complicated, then.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "It's just like how you choose to conduct business by yourself, Croissant. All your decisions, any of your choices, they're all crystallizations of your years of business experience, aren't they?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Others can only give suggestions. The power to decide lies eternally in your own hand—just as it does now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Even if all three cards portended the worst outcome, would you really change your decisions?",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成懊恼"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Money's spent...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "So you've only come seeking a comfort of sorts, hoping I might give you reassuring results.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Ah—no need to answer me. Many are like that. I understand it very well.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "All of us will tend to hope for something unrealistic in uncertain times, something that'll resolve it all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Unfortunately, I'm not what you've all been hoping for.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "All I can do is peer shallow into the road ahead, and offer all the help I can.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You've paid my terms, and so I have a responsibility to spare no effort for you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Only this, and nothing more.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Gitano...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Let us continue.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Al... Alrighty.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "You will have an adventure, but it seems your journey won't be serene.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "As for the outcome, we may look to the last card to show our answer.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I can't say whether there'll even be a single note of LMD at the end.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "It just keeps gettin' more dangerous...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I only bring up a poorer kind of possibility.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Returning with overflowing riches is not out of possibility's realm, either.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Gosh, could ya imagine?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I'll be visiting Perfumer's sometime for a complete course of aromatic sleep therapy, then.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I'll leave the bill to you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "I make some cash 'n I'll cover ya!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Hm-hmm. It's a done deal.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Now, then, let us explore your destination in this journey.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Your final card, please.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "(Flips tarot card with a swish)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "The Moons, Upright.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So it's upright. 'kay, good start.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "This is... certainly hard to say.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Have... you ever looked into Gavial's hometown situation before?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "I've surveyed Sargon markets before. This stuff'll sell like hotcakes!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "If so, that'll be the best outcome.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "(Is there any possibility it won't be an ordinary Sargon market, I wonder...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "(The Moons upright...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Your journey will not be serene. The fore cards tell of that much.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Be wary of deception, and wary of being cheated.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "In my view, if possible, do proceed cautiously.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Do you like the moons?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Like? Can't say I do fer sure? But when I'm moody out on the deck 'n look up 'n see the moons, that makes me feel alright some.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "And the moonshadow?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Umm. Do folk specifically go lookin' fer the shadow?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Under the radiance of the moon, things often come to be ignored.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "The things this card shows are also as such.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "There is always that which is hidden by radiance, painstakingly concealed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Whether it is fortune or sorrow requires your own careful consideration.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Noted. I'll be watchin' out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "And this should be what these cards have shown.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "What these three cards together make known to you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Croissant, your future will not be relaxed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "At the least, accompanying the Doctor on this journey out, there will be many hindrances.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Do you have any such feeling of your own? For example, a vague unease or confusion in your heart.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Kinda a li'l bit...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "But push past, 'n I should be able to get over it.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Do the, uh, cards say I'm gonna lose my investment?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Not at all. Besides, the tarot never speaks in certainties of futures.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So, still a chance I'm saved.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "If I can't hold out, I oughta last 'nother couple days knockin' on my savin's jar.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Here's hoping.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "As for divining, things would wrap up here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Is there anything else you need me for?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Hmm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Gitano, you pull a card too!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Oh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Didn'tcha just say diviners can divine themselves too?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "I wanna see how yer luck is.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "But that requires me to prepare—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "C'mon, lessee.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "The tarot is not—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Aw, potayto potahto, c'mon. Draw.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "(Draws a card 'for' Gitano.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Come on. Flip it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Wait. Let me prepare a moment.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Phew.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "(Flips tarot card)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Ten of Cups... Reversed...",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "This mean somethin' bad?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Then lemme just turn it round—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Stay your hand and do not touch the card!",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Oh, alright...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Sorry, Gitano.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "No.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "That's not it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "The card's position is in relation to the revealer.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "So this card.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Is Upright.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Hmm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ohh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Right! Yer sittin' opposite me!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So this card mean somethin' good, then?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "In regards to my occupation and personal relations, it's not bad at all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Then—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "(Grabs Gitano's hand and rubs it a few times)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Eh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Lemme borrow a li'l bit of yer good luck, a'ight? This way I can pay ya back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "If you so insist...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "As you wish, then...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Hoooo boy, yer gonna let me pay you back sure as sweeeeeet heck.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "//此处替换成吃惊"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ah!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "What's wrong?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "I just thoughta somethin'!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "If I'm borrowin' yer good luck, don't that mean the whole divination we just did don't count fer nothin' now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Who knows?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "So there ain't no rule like that, huh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "If you want another divination, you will have to make a payment to me again.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Uh, yup. Pass, then.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Hmm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Lemme rub a few more times. That oughta be free, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Hm-hmm~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I'll give you a discount on this one. Free it is.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Aw, thanks!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Five minutes later..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "Hi, Croissant!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Young Studying Operator",
      "text": "It's nice to meet you too, Gitano!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Oooh.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Good day, all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Well, then. I'll be leaving now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "I pray the LMD you earn will be enough to cram Rhodes Island full.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "You got it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Next time ya got stuff to buy, remember, you find me. I'll give ya some deep discounts!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "Fate is a thing of constant change. We'll talk details when the time is right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "(Waves and leaves)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gitano",
      "text": "(I hope my fortune can truly be of help to you, Croissant.)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
