  "sourceHash": "4d079a9c54f88179f2e557004a19ce12c5b6cf0e5980d43d90090e1bfd593f62",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "There is no end... The fog is everywhere..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hm...♪"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Uhh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Singer, you're awake! Good morning!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Was someone just singing?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "I-Is this a song? I don't know how to sing, but you were humming this while you were asleep."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ow! Singer... You are grabbing too hard..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Mother..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Monsters..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Monsters."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Monsters!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "*cough*... Singer, your box... It's really hurting my chest when you press it against me..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "A-Are you letting go? That really scared me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Singer, I thought you were going to kill me."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If I were going to kill you, I could've done that easily."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "But you don't want to kill me."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You can tell?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "I can tell."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But I don't know."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "Eh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "R-Running out again...? Singer, where are you going?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sir... The tides are rising again."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "The colors of the sea... That patch of color has changed."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "What is there in the water? I-Is it shells and finfish? Why would they suddenly show up in the water? And why are they growing closer and closer to the shore?"
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "From far deeper places, they made their way here by following currents that normally would not exist."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "What?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "I thought... the reason they headed into the sea, claiming it would get them food, was some absurd, unfounded belief. I thought, in their despair, they were fooled into doing this..."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "But I never imagined... they are actually dealing with the sea? They are using their own men as fodder to feed the monsters of the sea, and the monsters then also feed them in return?"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "This mutualism is horrifying... and wretched...! No wonder there are so many Sea Terrors here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "But I thought I put an end to it yesterday...!"
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Not all corrections are fruitful. This is something you must understand."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Am I in the wrong, High Inquisitor? I just wanted to save them."
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "To right a wrong, you either bring what strayed from righteousness back onto the right path—"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "But... What do the people here even see as right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You can't grow any food in the lands and seas of Sal Viento anymore."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "This was a foregone conclusion decades ago, and to fight it would be futile. The nomadic city, the society, and the people who live in it... They are all slowly marching towards their death."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "They asked me... If... If there isn't a way out... How are they supposed to see right from wrong?"
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "—Or perhaps make that which is wrong no more."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sir...! You don't mean..."
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "You are doubting me."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "I... No, of course not. I just..."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "They may have turned out like this... but they were once Iberian citizens. I want to protect them, and I hope I can help these inhabitants... so that they can make our country a better place."
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "You should have doubts."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "In making a judgment, rely on no one but yourself!"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, sir..."
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Look out at the sea. What do you see?"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I see... a threat."
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Don't regurgitate your memorized answers."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, sir!"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "The sea... is flowing. It's ever changing."
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Remember everything that you see."
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Change has happened, is happening, and will happen. If you can't see it clearly for yourself, you will find yourself lost."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sir, what is that under your feet?!"
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "What do you think?"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "A Sea Terror... Did we miss one when they attacked last night?! No, doesn't seem like it... This one wandered off the beach... It looks like it's climbed a long way... It's not quite the same..."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "I... uh... I should know this..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "High Inquisitor",
      "speakerToken": "avg_npc_183#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "This is an evil that must be eradicated."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "I get it... I can see it... It's the whole truth of this deal of theirs."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "So this is what becomes of anyone who wanders into the sea... This is not just the monsters' nest. It's their breeding ground."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Uhh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Doesn't that mean that all the people here will become monsters?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "(Grips scabbard)"
    },
    {
      "type": "dialogue",
      "speakerName": "Inquisitor",
      "speakerToken": "avg_npc_182#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "High Inquisitor, I need to head back to the city."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "*pant*... *pant*... Phew... S-Singer, you're too fast..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But not fast enough."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You managed to follow me again."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "H-Haha... Singer, this is my home... I know this place much better than you."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I should leave."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Leave? What do you mean?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I mean leave this place."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh? Did you figure out where to go to find your friend?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "At the very least... I should keep my distance from you."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh? Why's that?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The Inquisitor was right about one thing."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "She talked about a lot of things..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I am a danger to all of you."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Because of what happened last night? You saved us, Singer. We are very thankful of what you did for us."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I saved you? Is that what you think?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If I'd missed even one of the Sea Terrors, it could've torn you to pieces as it marched on."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You would've been killed."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I brought it here. Therefore, I killed you."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "No, that's not how it is..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "How is it not? This has happened before."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "They died because of me. They despised me, they were scared of me, and they blamed me for it."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "They... They were wrong!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You didn't mean to do that."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I didn't mean to?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't know."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Uhh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "After all that, I'm not sure... anymore."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I thought that if I killed it, I would find the answer."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Singer...? You don't look so good."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "You are hurt, and you spent so much of your energy. You haven't completely recovered yet, have you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "You should come back with me and get some rest. You will feel much better once you get more sleep."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Why aren't you afraid of me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hm?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Your grandmother called me a monster, while your friends all looked at me with animosity."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "These kinds of gazes are everywhere... I got used to them long ago."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "But what about you? When you look at me, what do you see?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You... You are a singer."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "A singer. That's what I told you, and you believed it. That Inquisitor, on the other hand, did not. If I tell you I'm a monster now, will you believe me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I won't..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Why are you always following me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Anything that I can give you, you are free to take, yet you don't want them."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You don't want to kill me either."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "K-Kill you? No, Singer, why would I want to kill you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "When I do something for you, you pay me something in return. It's always either that or the other way around."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Whenever you exchange something, there exists a promise. It's only when promises exist that there's trust."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Promise?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You don't know what that is."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "(Shakes head)"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Listen up. You helped me, so I will give you what you want. This is what a promise is."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't want anything..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You are lying."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I can smell as much with my nose as my eyes can see."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Uhh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You told me this is your home, and that's how you know how to find me so quickly. That's a lie too."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If you don't tell me the truth, I can't trust you."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "No, Singer, don't go!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's not that I'm not telling the truth. I just... don't understand."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Singer, to all of us... To me, you are still a mystery. You came from the outside, and I've never met anyone like you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "You want to know how I guessed that you are here. It's not that I'm trying to lie. I'm just... embarrassed."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "This is... the outskirts. It's as far as it gets from the city."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I know that you are hiding from us, and I thought this is where you would probably come too if you wanted to run away."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "'Too?'"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "I come here often myself. Of course, I don't tell Sheetmetal or anyone. They aren't happy when they find me running this far away."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Look at that chunk over there. It's tall. I climb on there sometimes. The stronger the wind gets, the farther I can see."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You are curious about what's outside."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't know. I... I sometimes wonder about how it's like outside. It's pretty pointless, I know, and they kept telling me that too, so all I do is imagine it all by myself here."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "This is the furthest I've gone whenever I go outside to scavenge. Outside... There's nothing useful outside."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If you're curious about what's outside, you just have to walk a little further."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "I used to go to the west side. Sheetmetal would warn me that there were monsters outside, and we would die if we ever stepped out."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#4",
      "operatorId": null,
      "portraitKey": null,
      "text": "Singer, you are from the outside. I am following you around because I have lots and lots of questions... I want to know if what Sheetmetal said is actually true."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Perhaps."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If you head outside, you will die."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Phew... so it's true..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You aren't disappointed."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Singer, if I have the chance, I think I want to see it for myself."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It doesn't matter if there are monsters there... I don't think I'm scared of them."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hm?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The Inquisitor said I'm not afraid of monsters because I don't know what they would do to me."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I think she's right about that."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "She made that up."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "*cough*, *cough*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm not afraid of them either."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Haha... That's gotta be because you know the monsters can't do anything to you."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Not like me. Last night was the first time I got a good look of those monsters. I didn't know what was going to happen to me. My heart was racing like never before."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Then, when I woke up this morning, the weather felt so much better than I've ever experienced. I could feel the wind, and I could see the sea waves splashing ever closer."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "This day has been different than all the other days I've lived, because I don't know what's going to happen."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sounds like you're excited."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Excited?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Fear and excitement are pretty much the same. Both get your heart racing and your blood flowing."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Am I sick?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You are not sick. To some people out there, this is what it means to be alive."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "I didn't know it feels this good to be alive. Is it like this outside every day?"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It must feel better than here."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Can I really go outside...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "My box... Once my box is full."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I need to... get more food. I need to make sure Grandma Petra's all set."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "I... Argh!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The monsters will eat you if you're so careless."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "Singer... you saved me again."
    },
    {
      "type": "dialogue",
      "speakerName": "Skadi",
      "speakerToken": "avg_1012_skadiSP_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And you could've saved me the trouble if you didn't come."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Haha... S-Sorry..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh? Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
      "speakerToken": "avg_npc_180#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "My leg... Something's grabbing my leg."
    },
    {
      "type": "dialogue",
      "speakerName": "Anita",
