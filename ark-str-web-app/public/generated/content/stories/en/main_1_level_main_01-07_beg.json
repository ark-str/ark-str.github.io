{
  "server": "en",
  "storyId": "main_1_level_main_01-07_beg",
  "groupId": "main_1",
  "stageId": "main_01-07",
  "title": "The Tyrant",
  "storyCode": "1-7",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/obt/main/level_main_01-07_beg.txt",
  "sourceHash": "2b0b203a73452e2f441a5748e819e94098aae43aab2a0ab1c0a1ce9642413c7f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerId": "char_130_doberm",
      "text": "Prepare for impact!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerId": "char_130_doberm",
      "text": "Spread out—!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerId": "char_130_doberm",
      "text": "There's too much coming... at this rate, every single building in this city is going to be destroyed!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerId": "char_130_doberm",
      "text": "This is looking bad...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "——!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "We have to relocate!"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerId": "char_016_medic",
      "text": "...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "Hold on!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Aaaaagh!! It's falling... It's falling!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "The sky is crashing down!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Aghhhh! It hurtsss...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "My hand... my hand! Where's my hand..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "No, no way!! I don't want to die...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Aaaaaaaghh!!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerId": "char_148_nearl",
      "text": "Defenders!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerId": "char_148_nearl",
      "text": "Protect our Casters! !"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerId": "char_148_nearl",
      "text": "...!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerId": "char_148_nearl",
      "text": "What's that sound?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerId": "char_014_riope",
      "text": "A massive cluster just toppled the building across the street from us! Get down! !"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerId": "char_016_medic",
      "text": "Eeek...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "... Don't stand there... Medic! Watch out!"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerId": "char_013_riop",
      "text": "Oh no... Medic, get out of there!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......!",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "speakerId": "char_016_medic",
          "text": "Aaaahh!"
        },
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "speakerId": "char_016_medic",
          "text": "...Huh, D-Doctor?"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "The Doctor pushed the medic out of the way? Wouldn't that mean... Doctor...?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "No, Doctor!!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "Dr. {@nickname}!!"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "Huh?"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "N-Nearl's charging forward!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "Get down, Doctor!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "Aagh..."
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "She made it in time!"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "She did it... She saved the Doctor!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "*cough*... Haah..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Nearl! Doctor! Hurry back over here!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "It's fine now!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "I can still hold my shield...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "Jump, Doctor!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "Jump!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Doctor, Doctor..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "You're, you're not hurt?"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "I'm fine... It's no big deal.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "...",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Thanks for saving me, Nearl.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "How could you... put yourself in danger like that!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "At least take me with you, so I can protect you!"
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "I can't allow you to be harmed..."
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "Especially, right before my eyes!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "We should count ourselves lucky that everyone is still safe...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "But..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "(How much longer is this going to last?)"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "(How long are we going to be able to stay alive?)"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "... Hm..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Are fewer rocks falling now?"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "So we managed to weather the first impact..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "But we have to be careful still. Nobody knows how long this Catastrophe will continue for."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "At least... we weren't caught dead in the middle of it."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "We were lucky to slip through."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Mmhm..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "How's everyone doing?"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "Looks like all of the Operators made it through just fine...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "Some were lightly injured, but considering the circumstances, we were quite fortunate!"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "We... we made it!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerId": null,
          "text": "Ugh..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Some of the Reunion members have also..."
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerId": "char_1002_nsabr",
          "text": "...Huh?"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerId": "char_1002_nsabr",
          "text": "Huh... Ahh! ! Rhodes Island!"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "...What?"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerId": "char_1002_nsabr",
          "text": "Arghh...!!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "They're still trying to attack us?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerId": "char_1002_nsabr",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerId": "char_1002_nsabr",
          "text": "Rhodes Island!"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "What's wrong with you bunch!"
        },
        {
          "type": "dialogue",
          "speakerName": "Reunion Member",
          "speakerId": "char_1002_nsabr",
          "text": "Come back here...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "They've gone insane."
        },
        {
          "type": "dialogue",
          "speakerName": "Nearl",
          "speakerId": "char_148_nearl",
          "text": "Do they not value their lives at all?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Dobermann..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "We have no choice..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "We'll suppress them first, and then immediately relocate!"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
