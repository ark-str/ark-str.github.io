  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "char_340_shwaz_2#2",
      "operatorId": "char_340_shwaz",
      "portraitKey": "char_340_shwaz",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "speakerToken": "char_348_ceylon_4#8",
      "operatorId": "char_348_ceylon",
      "portraitKey": "char_348_ceylon",
      "text": "Schwarz?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "char_340_shwaz_2#2",
      "operatorId": "char_340_shwaz",
      "portraitKey": "char_340_shwaz",
      "text": "Cronin's orders are now the Mayor's orders. Everyone, go."
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "speakerToken": "char_340_shwaz_2#2",
      "operatorId": "char_340_shwaz",
      "portraitKey": "char_340_shwaz",
      "text": "Tie these people up. Do not hurt Miss Ceylon."
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "speakerToken": "char_348_ceylon_4#3",
      "operatorId": "char_348_ceylon",
      "portraitKey": "char_348_ceylon",
      "text": "What? Why?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "speakerToken": "char_348_ceylon_4#3",
      "operatorId": "char_348_ceylon",
      "portraitKey": "char_348_ceylon",
      "text": "Do you also think I'm doing this for fun?!"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Let's go!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Now's not the time to talk!",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Bodyguard A",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "They are currently fleeing towards the beach!"
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard B",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Damn, it's too crowded. We won't be able to give chase. Call the sentry at the beach. Surround them!"
        },
        {
          "type": "dialogue",
          "speakerName": "Schwarz",
          "speakerToken": "char_340_shwaz_2#2",
          "operatorId": "char_340_shwaz",
          "portraitKey": "char_340_shwaz",
          "text": "Get back here!"
        },
        {
          "type": "dialogue",
          "speakerName": "Schwarz",
          "speakerToken": "char_340_shwaz_2#2",
          "operatorId": "char_340_shwaz",
          "portraitKey": "char_340_shwaz",
          "text": "?!"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Huh?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerToken": "char_188_helage_1",
          "operatorId": "char_188_helage",
          "portraitKey": "char_188_helage",
          "text": "Doctor, go. I'll handle things here."
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#8",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "Huh? You're...!"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Ceylon, let's get out of here first.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#5",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "Wait... *gasp* *gasp*... Doctor, I'm tired..."
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We finally... made it... to the beach...",
          "value": "1",
          "blocks": []
        },
        {
          "label": "I can't... run any longer either...",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Bodyguard",
          "speakerToken": "avg_npc_020",
          "operatorId": null,
          "portraitKey": null,
          "text": "Milady, please come back with us."
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#3",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "No!"
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard A",
          "speakerToken": "avg_npc_020",
          "operatorId": null,
          "portraitKey": null,
          "text": "Don't hurt Lady Ceylon. As for that 'Doctor,' do as you please."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerToken": "char_188_helage_1",
          "operatorId": "char_188_helage",
          "portraitKey": "char_188_helage",
          "text": "How dare you treat Doctor like that!!"
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard B",
          "speakerToken": "avg_npc_020",
          "operatorId": null,
          "portraitKey": null,
          "text": "It burns! It burns!!"
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard C",
          "speakerToken": "avg_npc_020",
          "operatorId": null,
          "portraitKey": null,
          "text": "Where'd that imp come from?!"
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard C",
          "speakerToken": "avg_npc_020",
          "operatorId": null,
          "portraitKey": null,
          "text": "Yowwwch! My butt! It's on fire!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "Hey Doc, you're having fun again. Why didn't you call me?"
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard A",
          "speakerToken": "avg_npc_020",
          "operatorId": null,
          "portraitKey": null,
          "text": "Tsk... She's just a runt. Show her what we're made of!"
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "Perfect. I was starting to get bored, hehe..."
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#8",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "Doctor, you look even paler than before. What's wrong?"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Ifrit, try not to go overboard!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Burn off all their clothes and call it a day.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "Fine..."
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "All right, medium rare it is!"
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
