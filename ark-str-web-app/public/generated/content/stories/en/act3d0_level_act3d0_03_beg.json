  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "text": "Schwarz?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Cronin's orders are now the Mayor's orders. Everyone, go.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Schwarz",
      "text": "Tie these people up. Do not hurt Miss Ceylon.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "text": "What? Why?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ceylon",
      "text": "Do you also think I'm doing this for fun?!",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Let's go!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Now's not the time to talk!",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Bodyguard A",
          "text": "They are currently fleeing towards the beach!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard B",
          "text": "Damn, it's too crowded. We won't be able to give chase. Call the sentry at the beach. Surround them!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Schwarz",
          "text": "Get back here!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Schwarz",
          "text": "?!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Huh?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Doctor, go. I'll handle things here.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "text": "Huh? You're...!",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Ceylon, let's get out of here first.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "text": "Wait... *gasp* *gasp*... Doctor, I'm tired...",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We finally... made it... to the beach...",
          "value": "1",
          "blocks": []
        },
        {
          "label": "I can't... run any longer either...",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Bodyguard",
          "text": "Milady, please come back with us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "text": "No!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard A",
          "text": "Don't hurt Lady Ceylon. As for that 'Doctor,' do as you please.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "How dare you treat Doctor like that!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard B",
          "text": "It burns! It burns!!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard C",
          "text": "Where'd that imp come from?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard C",
          "text": "Yowwwch! My butt! It's on fire!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "text": "Hey Doc, you're having fun again. Why didn't you call me?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bodyguard A",
          "text": "Tsk... She's just a runt. Show her what we're made of!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "text": "Perfect. I was starting to get bored, hehe...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "text": "Doctor, you look even paler than before. What's wrong?",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Ifrit, try not to go overboard!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Burn off all their clothes and call it a day.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "text": "Fine...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "text": "All right, medium rare it is!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
