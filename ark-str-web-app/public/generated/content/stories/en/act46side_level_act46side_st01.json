    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Impatient Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What's the hurry? The trains aren't running."
    },
    {
      "type": "dialogue",
      "speakerName": "Agitated Woman",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Sorry... excuse me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Impatient Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wait a minute..."
    },
    {
      "type": "dialogue",
      "speakerName": "Impatient Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I've seen this trick before! You're a pickpocket, aren't you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Impatient Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Stop right there! Let me make sure you didn't steal anything..."
    },
    {
      "type": "dialogue",
      "speakerName": "Agitated Woman",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "—!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The woman breaks free of the hand grabbing her shoulder and runs in the direction of the crowd, vanishing into a sea of people."
    },
    {
      "type": "dialogue",
      "speakerName": "Impatient Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh! Hey! Somebody, help! Thief!"
    },
    {
      "type": "dialogue",
      "speakerName": "Staff",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Did you lose something, ma'am?"
    },
    {
      "type": "dialogue",
      "speakerName": "Impatient Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "My purse, jewelry, terminal... huh? Everything seems to be here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Impatient Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But that one..."
    },
    {
      "type": "dialogue",
      "speakerName": "Leisurely Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Probably some unfortunate sod trying to get on without a ticket."
    },
    {
      "type": "dialogue",
      "speakerName": "Leisurely Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I told you, this is pious Kjerag, not postwar Londinium. No one's after your purse."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Leisurely Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "By Kjeragandr..."
    },
    {
      "type": "dialogue",
      "speakerName": "Leisurely Tourist",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Does trying to ride without a ticket get you hunted down by warriors, in Kjerag?"
