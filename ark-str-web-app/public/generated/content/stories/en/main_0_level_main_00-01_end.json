{
  "server": "en",
  "storyId": "main_0_level_main_00-01_end",
  "groupId": "main_0",
  "stageId": "main_00-01",
  "title": "Collapse",
  "storyCode": "0-1",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/obt/main/level_main_00-01_end.txt",
  "sourceHash": "30b6ad4013efda8cb632705f140b6bbfa5e6448c92af13aa2335c7b6a63114bb",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "Ugh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "You bunch... aren't from Ursus..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerId": "char_013_riop",
      "text": "*gasp* *gasp*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerId": "char_130_doberm",
      "text": "Looks like they didn't have time to notify the others."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerId": "char_130_doberm",
      "text": "...Well done, Dr. {@nickname}."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerId": "char_130_doberm",
      "text": "I really should review your capabilities more objectively."
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerId": "char_016_medic",
      "text": "Huh? Amiya... she's heading over to them..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Are you okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "speakerId": "char_002_amiya",
      "text": "Huh? Oh, thank you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "No problem. It's our..."
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "speakerId": "char_002_amiya",
      "text": "You... You're also an Infected?"
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "speakerId": "char_002_amiya",
      "text": "What do you want?! Don't hurt my children... I'm begging you, please don't hurt us..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Find a safe place to hide."
    },
    {
      "type": "dialogue",
      "speakerName": "Female",
      "speakerId": "char_002_amiya",
      "text": "*Crying* ... Please have mercy... Let us go..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerId": "char_016_medic",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Has everyone gotten enough rest?"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerId": "char_016_medic",
      "text": "Ah, I'm fine..."
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Why is she afraid of you?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Dr. {@nickname}..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "You've also asked a similar question before."
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Because I... am an Infected."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Dobermann and I, and most of the members of Rhodes Island, are as well."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Even those Reunion members who we just fought..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "We've contracted a terrible illness. Something that terrifies most people..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "'Oripathy.'"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "Those who have contracted Oripathy are called the 'Infected.'"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Dobermann..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "Ursus has always treated the Infected harshly."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "I mean, who doesn't? Ursus just happens to be particularly cold-blooded about it."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "Civilians are taught to fear the Infected through propaganda. Nobody even bats an eyelid when the Infected are hunted down, and some even cheer for it."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "That's why Reunion chose this place..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "However... this time, it's not just a simple protest anymore."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "They've begun to resort to large-scale violence."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "When Ursus puts an end to the rioting, the Infected in Chernobog will only face more cruelty."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "...In contrast, with you here, Dr. {@nickname}, perhaps Rhodes Island's situation will improve."
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "...Is this also related to me?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "...",
          "value": "2",
          "blocks": []
        },
        {
          "label": "I see, I must be pretty important.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "Both Kal'tsit and Amiya have mentioned that you are a cutting-edge Oripathy researcher."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "...But with your memory loss, I doubt whether you'll be of any use again."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "Ugh... Instructor, that's way too harsh!"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "...Perhaps you'll be able to master the theories again after some reviewing, just like how you relearned your commanding skills?"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "After all, you are our field commander..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "To be honest, I never thought a neurology doctor could also be a master tactician..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "But after seeing you, I can somehow understand it."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "I mean, Rhodes Island itself is very similar to your field of study."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "speakerId": "char_016_medic",
          "text": "Hey! Damn you! Stop running! It's time for your injection!"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "Huh? Huh? I told you, I'm fine! I, I don't need treatment yet!"
        },
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "speakerId": "char_016_medic",
          "text": "You need to get your regular injection to slow your symptoms!"
        },
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "speakerId": "char_016_medic",
          "text": "Didn't you say you were feeling dizzy?"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "That's not the same condition at all!"
        },
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "speakerId": "char_016_medic",
          "text": "What if you start having other issues when you're in battle?"
        },
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "speakerId": "char_016_medic",
          "text": "For the sake of everyone's safety, you have to take care of yourself too!"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Medic",
          "speakerId": "char_016_medic",
          "text": "Stop right there! I'm giving you the shot!"
        },
        {
          "type": "dialogue",
          "speakerName": "Guard",
          "speakerId": "char_013_riop",
          "text": "Aaah! !"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "...This is what Rhodes Island does. We're looking for a cure to the infection, as well as mitigating the problems associated with the Infected."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "That's right. It is not enough to only conduct research, or only try to resolve conflicts."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "We must address all of the problems surrounded the Infected."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "This is the only way for Rhodes Island to give all the Infected a chance at survival..."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "We understand them better than most others because we, like them, are also Infected."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "No matter who is involved or what is required, Rhodes Island seeks to put an end to the spread of hatred and disease."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "Dr. {@nickname}, perhaps this will be your calling as well."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "...At least, this is my wish."
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "What are you talking about...?",
          "value": "1",
          "blocks": []
        },
        {
          "label": "...",
          "value": "2",
          "blocks": []
        },
        {
          "label": "I need some more time to think about this.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "We will give you plenty of time to let all of this sink in."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "However, the time given to us is scarce."
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "Gather up, everyone. We're leaving!"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "Anything could happen on our way to the meeting point!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "(Amiya...)"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "(The situation in Chernobog has become very complicated. We can't afford to create extra pressure for the rescue team. But...)"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerId": "char_002_amiya",
          "text": "(How much time... do we have left?)"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "(...Three hours.)"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "(After three hours, this entire city will be consumed by the Catastrophe.)"
        },
        {
          "type": "dialogue",
          "speakerName": "Dobermann",
          "speakerId": "char_130_doberm",
          "text": "(After that, everything will be over then.)"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "char_1502_crowns",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "char_1502_crowns",
          "text": "We've found some unknown variables."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "char_1502_crowns",
          "text": "Notify the others, now."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "char_1502_crowns",
          "text": "We're going after them."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
