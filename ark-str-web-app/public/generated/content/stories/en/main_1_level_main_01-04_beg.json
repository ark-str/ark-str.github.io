  "stageId": "main_01-04",
  "title": "Omen",
  "storyCode": "1-4",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_01-04_beg.txt",
  "sourceHash": "a4b2c34ce638008d120ddad184e7a23012157e1b84b3cce96c607c4457f9d7a7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第九关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Phew... We finally lost them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "If we keep up the pace, we'll be out of the central region shortly and arrive at the southern exit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "It's starting to get noisier and more chaotic...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "It might be because the Chernobog civilians trying to evacuate the city are running into Reunion.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "It seems like a few districts have already been vacated.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "But those who didn't make it in time are now being held up by Reunion.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "This place used to be a magificent, sprawling plaza.Now... it's been reduced to ruins.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "This city tormented the Infected. To meet their end this way is almost poetic.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Almost...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "You seem quite sentimental.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Perhaps, at one point...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The sky's getting even darker.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Even the air has the smell... of something burning.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Civilian",
      "text": "What are you doing?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Civilian",
      "text": "...Aaaargh!! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "————!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Civilians?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "I can't hear anything anymore.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "We can't tell who they are from this distance.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Reunion is attacking them...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "We can't leverage the terrain to our advantage here. We don't have the capacity to save everybody.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Life is very precious, Amiya. Each and every one.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Regardless, we're already too late.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "After all, we're in for some trouble ourselves.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "We can't catch a break today.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "...Kill them all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "A large number of Reunion forces are coming through the exits!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Get ready to fight our way out!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
