{
  "server": "en",
  "storyId": "main_4_level_main_04-03_beg",
  "groupId": "main_4",
  "stageId": "main_04-03",
  "title": "Artificial Cold",
  "storyCode": "4-3",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-03_beg.txt",
  "sourceHash": "c9124d1b16531ef83d58febccb1ee453c26caba94013588858d996996b83fde8",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "I understand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "All right, keep in touch. Let me know if catch wind of anything.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Just press the third button. Mhm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "...Hmm? Dr. {@nickname}?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Where's Amiya?",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "She went to the slums.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "...You actually let her go alone.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "...Whatever, at least someone is protecting her.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "I suppose you wouldn't be able to do anything even if you went with her. I'll let you off the hook this time.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Did you also come back by yourself?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Oh, Penguin Logistics.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "You also need to take better precautions to stay safe. We won't always have the luxury of reliable local guides.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Dr. {@nickname}...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Amiya will not be in Lungmen for a long time, since she has other missions to do.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "You'll have to face her again.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "...If I were you, I'd make sure to tell her the things that I couldn't say before.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Ah, Doctor?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Were you waiting for me this whole time...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Sorry to have kept you waiting.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Hmm? My complexion looks different from when I left?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Some things happened.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I feel like...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Perhaps Madam Ch'en has her own way of looking at things.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Even though her words are harsh, and she has done things that I can't accept...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Maybe... the difference between us isn't that big.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "She has her responsibilities.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Oh... I understand now...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "She also has her share of burdens to bear.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Perhaps I also...",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Amiya, you also have plenty of responsibilities yourself.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "...",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Is that so...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I... just didn't have other choices.",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "At least you saw your choices through.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "...",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...I suppose all these consequences were the results of my persistence.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor, there's no need... to try to comfort me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Actually, I'm well aware of this.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But what I don't know...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "What I don't know, is how long we have to keep going before this world begins to change.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But, what I do know for sure...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Is that I won't give up.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I'll always bear the consequences of my actions, because... I chose this path.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Doctor...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Will you... stay by my side?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Even though... this guilt will always stay with me...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "The regret of not being able to bring everyone with me. The regret of not being able to save my friends...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But I must face reality.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "With everyone in Rhodes Island...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Hmm? A message from Dr. Kal'tsit...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Dr. Kal'tsit? Did you need something?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Amiya, I've received communications from a few recon teams.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "The situation has changed for the worse.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Okay, I'll be right there.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
