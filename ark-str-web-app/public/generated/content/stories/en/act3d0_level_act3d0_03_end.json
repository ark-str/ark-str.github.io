  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Bodyguard A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hoooooooot! I'm burning! I'm burning!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bodyguard B",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Eeek! My hair!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bodyguard A",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Tsk... Fall back, fall back!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "speakerToken": "char_134_ifrit_summer_1",
      "operatorId": "char_134_ifrit",
      "portraitKey": "char_134_ifrit",
      "text": "Hahaha! See, nothing's more fun than a good scrap, Doc!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "speakerToken": "char_134_ifrit_summer_1",
      "operatorId": "char_134_ifrit",
      "portraitKey": "char_134_ifrit",
      "text": "Oh, that reminds me, Doc. Because I saved you, and didn't go overboard like you asked me to, you'd better not tell Silence about this!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ifrit",
      "speakerToken": "char_134_ifrit_summer_1",
      "operatorId": "char_134_ifrit",
      "portraitKey": "char_134_ifrit",
      "text": "If she finds out about this, she's going to assign me more homework for sure!"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "No problem.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Ifrit",
              "speakerToken": "char_134_ifrit_summer_1",
              "operatorId": "char_134_ifrit",
              "portraitKey": "char_134_ifrit",
              "text": "Hehe, I knew that you're a nice person, Doc!"
            }
          ]
        },
        {
          "label": "Good luck on the homework.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Ifrit",
              "speakerToken": "char_134_ifrit_summer_1",
              "operatorId": "char_134_ifrit",
              "portraitKey": "char_134_ifrit",
              "text": "Hmph, you're on your own then!"
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#8",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "An Originium-powered flamethrower, with such power too... You must be a very skilled Caster."
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "You're right on the money, Missy! I'm super powerful!"
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#2",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "My name is Ceylon."
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#2",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "Thank you for saving us."
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "Oh, um... it's my pleasure. I-I'm just doing the right thing."
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "Hey Doc, this lady is really polite. What should I be doing now?"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Just smile.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Take a bow.",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Bust out some dance moves.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "Oh, um, I'll try it then..."
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "Ahh?! I forgot that I left meat on the grill! Gotta get going!"
        },
        {
          "type": "dialogue",
          "speakerName": "Ifrit",
          "speakerToken": "char_134_ifrit_summer_1",
          "operatorId": "char_134_ifrit",
          "portraitKey": "char_134_ifrit",
          "text": "Doc, Ceylon, come find me afterwards if you want some barbecue!"
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "There she goes.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#2",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "Doctor, let's also hurry back."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerToken": "char_188_helage_1",
          "operatorId": "char_188_helage",
          "portraitKey": "char_188_helage",
          "text": "Doctor, I'm glad you're fine."
        },
        {
          "type": "dialogue",
          "speakerName": "Ceylon",
          "speakerToken": "char_348_ceylon_4#5",
          "operatorId": "char_348_ceylon",
          "portraitKey": "char_348_ceylon",
          "text": "Thank you very much, Mister..."
        },
        {
          "type": "dialogue",
          "speakerName": "Hellagur",
          "speakerToken": "char_188_helage_1",
          "operatorId": "char_188_helage",
          "portraitKey": "char_188_helage",
          "text": "You can call me Hellagur."
        },
        {
          "type": "dialogue",
          "speakerName": "Hellagur",
          "speakerToken": "char_188_helage_1",
          "operatorId": "char_188_helage",
          "portraitKey": "char_188_helage",
          "text": "Just like the Doctor here, I'm also from Rhodes Island."
        },
        {
          "type": "dialogue",
          "speakerName": "Hellagur",
          "speakerToken": "char_188_helage_1",
          "operatorId": "char_188_helage",
          "portraitKey": "char_188_helage",
          "text": "Doctor, do you have a minute? I need to have a few words with you, alone."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
