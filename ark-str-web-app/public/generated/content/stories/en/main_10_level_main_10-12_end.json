{
  "server": "en",
  "storyId": "main_10_level_main_10-12_end",
  "groupId": "main_10",
  "stageId": "main_10-12",
  "title": "Aim",
  "storyCode": "10-14",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_10-12_end.txt",
  "sourceHash": "b7c70aaaef7bbb61d2a9dd8855af367b7193c620a565870f2bceec5fccb31f3e",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "10-end"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Manfred",
      "text": "Have you finished cleaning up the streets?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Yes, General. Everyone on the list has already been dealt with.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Some tried to flee to other boroughs or leave the city just as you said, and we stopped them as well.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Only a few slipped through our net... The soldiers sent to chase after them seemingly ran into the same Sarkaz from Rhodes Island as yesterday.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Manfred",
      "text": "Let them squirm their way underground.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Manfred",
      "text": "That'll make it easier for us to flush them all out at once.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Clovisia",
      "text": "...Multiple of our contact points above ground were attacked all at once?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Clovisia",
      "text": "What of our Messengers? They got taken as well?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Clovisia",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Clovisia",
      "text": "Doctor, I want to hear your view on this.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Rhodes Island wasn't told where these points were.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "The only ones with access to that information are our own troops.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "We were tailed on the way back yesterday.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "It seems the seeds of crisis were sown last night.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "But I don't want to doubt our own soldiers.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "There's no way they'd betray their brothers and sisters.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "The commander is responsible for the team.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "We can't overlook any hypothetical.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "How many soldiers were rescued?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "Twelve people came back with Heidi.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "Among them, nine only ever provided us information on occasion.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "The other three helped us transport supplies, so it is possible they know the locations of some contact points.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "How many more are in Sarkaz hands?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "...A lot more.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "Doctor, you know better than anyone how difficult last night's operation was. As much as I'd like to rescue everyone, I'm forced to admit that we're not yet strong enough.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "Heidi's done good work. Being able to save all those people already went above and beyond my expectations.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "The Sarkaz couldn't know who would be rescued.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Clovisia",
              "text": "There were a lot of uncertainties surrounding our operation last night...",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Clovisia",
              "text": "I doubt the Sarkaz could have full control over everything.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "Unless everyone defected.",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Clovisia",
              "text": "That's simply not possible.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "You don't place a pawn that won't be used.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Clovisia",
              "text": "That's right.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Clovisia",
              "text": "The Sarkaz commander isn't a fool. He would have found a way to make sure his plan succeeded.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "So, if there really were traitors among the soldiers we saved...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "In all likelihood, they would've been the easiest for us to rescue.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "That narrows it down considerably.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "The most obvious suspects are clear.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "Still, I don't want to fling these accusations around about soldiers willing to bleed and die for their homeland.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "We need proof.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "How do you suppose we get that, Doctor?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Please call Feist and Rockrock.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Let's go visit the wounded together.",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "Why aren't you moving? The commander just sent news that Bill's about to wake up.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "...Rockrock.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "I want to tell her that I'm stepping down as captain of the operation team.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "Take a look at these.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "Packages? What's inside them?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "Johnny and Gabby's belongings. I picked out the stuff to send back to their families.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "What remains are their tools, weapons, and equipment. If you really... can't get them out of your head, then pick out something useful and polish it up a bit. That way they'll at least still be with us on the battlefield.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "Hah...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "Sounds like the vice-captain rejected my resignation... Let's go see Bill then.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "You're awake?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Yeah.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Something came up, so Miss Heidi had to leave. She was originally the one in charge of coordinating the treatment of the wounded here.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Wait, you're from Mr. Feist's team. Bill, right?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Mr. Bill, should I go call Feist and Rockrock over?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Ah, no, that's alright.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Miss Amiya, I decided to get up to talk to you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...Huh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Well, uh... I've always been curious about you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Amiya of Rhodes Island...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Why do they trust you so much? You're just a Cautus in her teens.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Are you... talking about our operators?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "We've been through so much together. You're correct that they trust me, but that trust is mutual.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "As far as I can tell, it's no different for everyone in the Self-Salvation Corps either. You also trust Feist, Rockrock, and Clovisia, right?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Haha... Mutual trust, huh? That might be a part of it. After all, you've been through your share of trials and tribulations.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "But your authority does not come from your bloodline, nor have you taken your position by force. You are far too young to have earned the amount of trust you enjoy.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "...Mr. Bill?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Deep down, you've thought about these things too, haven't you? But you don't dare show it. Your fears, your worries, your anxiety... Everything is suppressed by the responsibilities they've forced onto you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Are you worried about me? Did you overhear my conversation with Miss Heidi?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Mm... Maybe. I heard everything.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I appreciate the concern, but my responsibilities were not forced onto me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Our operators placed their faith in me, and I am not going to let them down.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Of course... Of course. Since the very beginning, they've always been devoted to you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "But Amiya... When they look at you, how do you know that they're not looking right past you? Searching for another soul that has endured the twists and turns of fate?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "......!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Everything you believe, do you truly believe it, or...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Are you dreaming a dream given to you by somebody else... one that you can't wake up from no matter how much you struggle?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Mr. Bill... No, that's not who you are!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Who exactly are you?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Allow me to return the question.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Amiya... Who are you?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "You shouldn't be here.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "I see the energy gathering inside your palm. Have you not figured out who I am? Why aren't you attacking?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I cannot touch your emotions, 'Mr. Bill'.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "But... I also cannot feel any malice.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Oh?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "You could have continued pretending to be asleep, yet you said all those things to me...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Hah, didn't I already tell you? We are very curious about you.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "If not for you, we'd have no desire to come here either. Theresis has no sway over us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "No matter what you're after... this is far too cruel.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Cruel...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Do you mean this face we're borrowing?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Yes, which is why I need you to leave.",
          "portraitKey": null
        },
        {
          "type": "narration",
          "text": "Black lines surged from her palm once more, weaving a net around the man in the Self-Salvation Corps uniform.\nOne strand condensed into a lightless blade, pressed against his throat."
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "What a... remarkably gentle threat.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Amiya, a lot of people have told you this before, yes?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "You really are just like her.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Not another word out of you, please.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Unfortunately, you're still too immature.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Always be aware of your surroundings before you make a move.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "...Miss Amiya?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "You, you... you're trying to kill Bill?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "No, I...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "Doctor, I take it that you didn't ask me to bring everyone here just to see this scene?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "I wanted to see who'd make the first move.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "You're already looking at the 'traitor'.",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "I assume you're not referring to Amiya. Then, Bill?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Rockrock... Rockrock, help me...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "I'd rather die myself... than betray you!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Stay away from him. I... No, nobody knows the full extent of his Originium Arts.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "His words are, or rather his very existence is... dangerous.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "Miss Amiya... Can I trust you?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "Last night, we fought side-by-side. I thought Rhodes Island truly had our backs, just as you said.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "But...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "Your expression scares me. It's as if I've seen it somewhere before...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "That's right, you're already mourning the pain and suffering you're about to cause.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "If so, then... why? Why go through with it?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "She... The Sarkaz took my father from me, right before my eyes. Are you going to take my family away too?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I'm sorry, Miss Rockrock... But it's too late. Your family member's already gone.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "But, Bill's right in front of us!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "This must be difficult... for you to accept.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "...I don't understand.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "Look, Amiya, it's not that we're not willing to believe you, but we don't have your Arts. We can't see what you see.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "Commander... I can see it.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "Captain?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "He might not actually be the same Bill we know.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "But those wounds on his body... he got all those from saving me yesterday!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "You said it yourself, Rockrock. The Sarkaz are masters of disguise, but we can't let ourselves be fooled.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "But how...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "Look, I brought along the Metal Crab I was going to give to Bill.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "See for yourself.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Ugh, when did this thing crawl onto me?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "He didn't even spare it a glance. The only thing in his eyes is Miss Amiya. He's so proud of having deceived us that he's long forgotten... about the bond between us.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "All because of this insignificant little machine?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Don't you think you're being a bit too hasty, Feist? Aren't we sworn blood brothers?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "I've made a lot of hasty decisions these last few days.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "Bill, my good man... if he were still around, he'd be ruthlessly making fun of me. I miss him. I miss him so much.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "Whoever you are... Don't make me pry that mask off your face with my wrench.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Rockrock, are you going to break my heart, just like him?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "I'll never turn my back on my family.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "But you... you're acting less and less like him.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "He would never talk like that. He would never try to manipulate us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "...So you really don't think I'm the real Bill? Feist, are you really okay with that?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "I'll have you know, if so, then that means your friend died in vain.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "Anyone else may have the right to say that, but you sure as hell don't!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "Haha. You're pretty smart, but unfortunately for you...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill",
          "text": "It's too late.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "Artilleryman, are you ready?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "text": "Yes, General. The cannon is aimed at the target.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "Remember, we're leveling every single building except the train station and the tracks.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "text": "Yessir!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "Increase the output to maximum.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "text": "M-Maximum? That might blow right through to the structural levels—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "Did you hear what the Confessarius's Messenger said? In their eyes, this whole tract of land, including the factories above, is worth nothing to us.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "text": "Then... Then, what about our people underneath...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "Hoederer will guard the safe areas under the city walls.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "text": "But what about—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "Uhh... Who do you think is heading underground to deal with the rebels?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Sarkaz Warrior",
          "text": "The Sanguinarch?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "As long as you get it. If these toys can take HIM out, I'd be... extremely surprised.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "As for the other one...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "text": "I've been curious for a while now. If it came to an all-out battle with the Prince, who would come out on top?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "text": "Thank goodness you're all here—",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "text": "Huh? Why does it feel like I walked right into a fight about to break out?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "text": "Anyway Doctor, I sent up some drones like you requested— They're really about to resume! Th-They're pointing those cannons right at us!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Clovisia",
          "text": "Notify Heidi and Harmo. We're evacuating immediately.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "text": "Hold on, I'm getting a strong Originium reading! They're aiming at our current location!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "text": "We've only got ten seconds!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "text": "Nine—",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Spare us the countdown.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "Run, now!",
          "value": "2",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Bill?",
          "text": "—Why are you holding on to me?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "text": "You said it yourself, we're sworn blood brothers. I don't want to... pass judgment too hastily.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rockrock",
          "text": "Captain... I don't think... I can carry the two of you...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill?",
          "text": "......",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill?",
          "text": "I'll admit that you people are very... interesting.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill?",
          "text": "Goodbye, Captain.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill?",
          "text": "Goodbye, Rockrock.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Bill?",
          "text": "Bill wanted you to live on. Those were his last words.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
