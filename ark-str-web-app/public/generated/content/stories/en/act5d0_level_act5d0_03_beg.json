{
  "server": "en",
  "storyId": "act5d0_level_act5d0_03_beg",
  "groupId": "act5d0",
  "stageId": "act5d0_03",
  "title": "7:22P.M.",
  "storyCode": "CB-3",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act5d0/level_act5d0_03_beg.txt",
  "sourceHash": "7d12c3015abe061e674ad52b5d57d716044e22b1980bed3faa70dc74f08095c4",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "The shots are coming from above? Are they up on the overpass?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "How high is the angle of attack? Where could they be shooting from?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Doesn't matter. First I've got to——!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Nng——!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Oof!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "I- I'm okay. What's this...? It's sticky...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "A Sauin candle? Real lucky these were here...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "You got one stuck in your horn too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Huh? Oh, thanks. I guess I better yank it... out——!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Don't move, candle boy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Quiet. Take cover behind that crate.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "We lost Fronzo's signal. Oughta be around here somewhere!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Penguin Logistics is here too. Tell the boss as soon as you spot the target.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "You can come out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Oh, okay...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "I appreciate your help, but you really don't wanna get mixed up in this. You better go somewhere safe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I'd love to. It's been a while since I had a trip to Lungmen. But a job's a job...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Considering how I found you, I'm guessing your deal with Penguin Logistics isn't going so well?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "...you could say that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Err, who are you, exactly? I get the feeling you're not a typical passer-by.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Calm down. Let's just say I'm not your enemy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Whoops, they're coming back. Hide.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso A",
      "text": "Mamma mia! Those Penguin bastards got Fronzo! What're we gonna do?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso B",
      "text": "That Bison kid's all alone. This could be our big break.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso A",
      "text": "Can we really just yoink him in the middle of downtown Lungmen?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso B",
      "text": "Mr. Capone says as long as we do it nice and quiet-like, hold off on the guns and bombs, Lungmen won't make a fuss.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso B",
      "text": "Nobody's gonna go looking in those filthy old alleyways, eh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso A",
      "text": "Then we'll be the backup, you find the kid. Capiche?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Well, we can't stay here. Let's get going.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Let's see... over there. Let's say hello.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Ya find Bison yet, baws?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "text": "I'm wearin' shades, not binoculars. Gimme some space!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "text": "Aight... I see 'im. Waving at me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Well let's go get him, then come back and ask this guy what they're up to.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Mmmf—— Mmmh——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "text": "Nah.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "text": "Looks like our lucky little Bison had a smooth landing. He can get hisself back here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "text": "Um... he took a forty-foot drop onto a smooth landin'? How's that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "And the bad guys are kinda hunting for him. You sure we shouldn't go get him?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "text": "She's got him.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "...She's back?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "text": "Exusiai, stay focused.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "There they are! We gotta spring Fronzo!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "text": "Sigh. There's just no end to you people.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I think we lost them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "So what's Texas and the girls gotten themselves into this time? Who are they fighting now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Can I really trust you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I guess I better introduce myself. I'm Mostima. A Messenger for Penguin Logistics.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "I think that makes me your colleague, for now. I usually work alone though.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "...Mostima. I've heard that name from my father before.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "(Not to mention a Sankta with black horns... the rumors were true. Better not ask about them though...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Oh...? Good things I hope?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Erm... how should I say...? Just baseless rumors...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "And after you saved me like that, I have no reason to doubt you. Sorry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Don't worry about it. You got nothing to apologize for.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Thanks... Now we should share our intelligence... although I'm still pretty confused.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Basically, Penguin Logistics is in some kind of conflict with an arm of the Siracusan mafia.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Right. Got it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Huh? You got it already?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "I don't need any more. You need to stop thinking so much. Trust your instincts. That's the Penguin Logistics way.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Oh. So the trick is to just stop thinking, huh...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "They're a very special bunch. Common sense doesn't really work here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "...What about you, Mostima?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Are you always this direct with people?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "I- I think so.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "We need to get moving.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Follow me.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "Eyo, you found the target yet?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "There's too many people. Hey, I'm walkin' here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "text": "C'mon, let's check somewhere else.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "...I don't think they saw us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Just keep going like this, and we'll figure out a way to meet back up with the others.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Hm.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "Wh- what is it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "If we keep going like this, we'll end up...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "G- getting caught by the mob?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "So that's where it was. It's been so many years since I've been back to Lungmen. All the signs are different.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "text": "Right... are you hungry? I'm trying to decide between matcha and chocolate.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
