    {
      "type": "dialogue",
      "speakerName": "Theresa",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "If you really want the King of Sarkaz to reveal the thoughts that you're loath to tell, I will. But I can feel you're still wavering."
    },
    {
      "type": "dialogue",
      "speakerName": "Theresa",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
