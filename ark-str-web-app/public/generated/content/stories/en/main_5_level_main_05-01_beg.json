{
  "server": "en",
  "storyId": "main_5_level_main_05-01_beg",
  "groupId": "main_5",
  "stageId": "main_05-01",
  "title": "Cycle of Enmity",
  "storyCode": "5-1",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_05-01_beg.txt",
  "sourceHash": "8104b095b40ed0a755d94b9b1294bcfab2a8212249a966a336d59aeba110c929",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第一关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "We'll be friends from now on. Those adults won't be able to bully us anymore!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Don't be afraid. From now on, I'll help you no matter what happens.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "If something bad happens to me, you'd better help me too! That's what friends are for!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Hehe, we'll always be together, right?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Do you still remember what you did when that old duke snatched her away?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Can you really do whatever it takes for the sake of Lungmen?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Now, Wei Yenwu, what - or who - are you going to sacrifice this time?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Nngh... Ugh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Hey, wake up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Save her...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Officer Ch'en, wake up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...Let me through! Let me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Puk gaai, I don't have time to deal with this right now!",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "*splash*—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Hnnf!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Finally awake?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Ack...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "What...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Hoshiguma, hurry! Reunion—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Are you done daydreaming? Good grief, you're a mess.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Why are you here? Where's my squad?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "What if I told you that they were all killed in action?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "If you're itching for a beating, then you'd better queue up behind Reunion.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I see your tongue is as sharp as ever. How come your performance in battle doesn't follow suit?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "What's going on over here? I leave for a moment, and you two are already at each others' throats?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Miss Swire, would it kill you to be a little less sarcastic towards her?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Swire",
      "text": "Hmph.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "You too, Ch'en, you only just woke up...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Wait, why do you look like you just got into a fight with a watering cart?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Ask her.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Young lady, what's this empty glass doing here? I remember pouring a glass of water for each of you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Swire",
      "text": "She was spouting nonsense in her sleep.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "Good grief...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Where are we?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "In a cabin in Rhodes Island.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Swire",
      "text": "Officer Ch'en, you and your team retreated to Lungmen about 45 minutes ago.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Swire",
      "text": "You might've thought that you hid your tracks well, but Reunion did not think that was the case.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
