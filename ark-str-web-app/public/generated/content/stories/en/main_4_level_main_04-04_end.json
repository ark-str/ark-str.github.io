  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "*gasp*... Damn it..."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerToken": "char_259_Jessica_1",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "We finally... got them..."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "...No, not yet."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerToken": "char_259_Jessica_1",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "What's that powder drifting down...?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Nngh... Guhh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Uaaagh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It hurts... It huuurrtsssss..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Aaagh... Aaaargh! It itches! It itches!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Graaah?!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Rhodes... Rhodes Island!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Enemy... Enemy!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerToken": "char_259_Jessica_1#3",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "What...! Wh-what's going on..."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerToken": "char_259_Jessica_1#3",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "The enemies we just defeated are standing back up...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "What? Are you done already?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "There's a glow... coming from that guy's staff...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "I haven't even done anything yet."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerToken": "char_259_Jessica_1",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "And... they've got a lot more reinforcements coming..."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "Curse you...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "Right now, I can only pray that this round can kill the enemy leader...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Don't."
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Haha... Do you really have time for a strategy meeting in your position?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "So much self-confidence."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "Hmph. I'll teach you a lesson with this shot..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "No, Meteorite. Don't."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "Tsk...! Why?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "We need to retreat."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "I can feel it..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "It's them. They're here."
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Ohh? You're not going to shoot?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "What a pity."
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "You know, you won't get another chance."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "Is he leaving? But--"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Meteorite! Aim at that collapsing building to the west, now! At least we can distract the enemy to buy us some time!"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "...This is our only option! I'll do it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Jessica, start running."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerToken": "char_259_Jessica_1#3",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "...The Yetis are here."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerToken": "char_259_Jessica_1#5",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "Wait..."
    },
    {
      "type": "dialogue",
      "speakerName": "Jessica",
      "speakerToken": "char_259_Jessica_1#5",
      "operatorId": "char_259_Jessica",
      "portraitKey": "char_259_Jessica",
      "text": "S-so cold..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "... ...Let's go."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Now."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "...Jessica."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "She's right."
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "We need to get out of here...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Amiya, can you hear me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Hello? Hello?"
    },
    {
      "type": "dialogue",
      "speakerName": "Meteorite",
      "speakerToken": "char_219_meteo_1",
      "operatorId": "char_219_meteo",
      "portraitKey": "char_219_meteo",
      "text": "Just go! I'll cover you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Listen, Amiya."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "...Do not come."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "These ruins are..."
    },
    {
      "type": "sceneBreak"
    }
  ],
