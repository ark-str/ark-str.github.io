{"server":"en","storyId":"main_4_level_main_04-04_end","groupId":"main_4","stageId":"main_04-04","title":"Nerves of Steel","storyCode":"4-4","avgTag":"After Operation","sourcePath":"vendor/ArknightsGamedata/en/gamedata/story/obt/main/level_main_04-04_end.txt","sourceHash":"88aa07c1345802d6f357de056a35b5fa7580be17b70b383f359cffff4514b01c","bodyAvailable":true,"blocks":[{"type":"narration","text":"第三十二关（前）"},{"type":"background","backgroundId":"bg_cher_2"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"*gasp*... Damn it..."},{"type":"dialogue","speakerName":"Jessica","speakerId":"char_259_Jessica","isRemote":false,"text":"We finally... got them..."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"..."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"...No, not yet."},{"type":"dialogue","speakerName":"Jessica","speakerId":"char_259_Jessica","isRemote":false,"text":"What's that powder drifting down...?"},{"type":"sceneBreak"},{"type":"dialogue","speakerName":"Reunion Member","speakerId":null,"isRemote":false,"text":"Nngh... Guhh..."},{"type":"dialogue","speakerName":"Reunion Member","speakerId":null,"isRemote":false,"text":"Uaaagh!"},{"type":"dialogue","speakerName":"Reunion Member","speakerId":null,"isRemote":false,"text":"It hurts... It huuurrtsssss..."},{"type":"dialogue","speakerName":"Reunion Member","speakerId":null,"isRemote":false,"text":"Aaagh... Aaaargh! It itches! It itches!!"},{"type":"dialogue","speakerName":"Reunion Member","speakerId":null,"isRemote":false,"text":"Graaah?!!"},{"type":"dialogue","speakerName":"Reunion Member","speakerId":null,"isRemote":false,"text":"Rhodes... Rhodes Island!"},{"type":"dialogue","speakerName":"Reunion Member","speakerId":null,"isRemote":false,"text":"Enemy... Enemy!!"},{"type":"dialogue","speakerName":"Jessica","speakerId":"char_259_Jessica","isRemote":false,"text":"What...! Wh-what's going on..."},{"type":"dialogue","speakerName":"Jessica","speakerId":"char_259_Jessica","isRemote":false,"text":"The enemies we just defeated are standing back up...?"},{"type":"dialogue","speakerName":"Mephisto","speakerId":"char_1507_Mephisto","isRemote":false,"text":"What? Are you done already?"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"There's a glow... coming from that guy's staff...?"},{"type":"dialogue","speakerName":"Mephisto","speakerId":"char_1507_Mephisto","isRemote":false,"text":"I haven't even done anything yet."},{"type":"dialogue","speakerName":"Jessica","speakerId":"char_259_Jessica","isRemote":false,"text":"And... they've got a lot more reinforcements coming..."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"Curse you...!"},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"Right now, I can only pray that this round can kill the enemy leader...!"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"Don't."},{"type":"dialogue","speakerName":"Mephisto","speakerId":"char_1507_Mephisto","isRemote":false,"text":"Haha... Do you really have time for a strategy meeting in your position?"},{"type":"dialogue","speakerName":"Mephisto","speakerId":"char_1507_Mephisto","isRemote":false,"text":"So much self-confidence."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"Hmph. I'll teach you a lesson with this shot..."},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"No, Meteorite. Don't."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"Tsk...! Why?!"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"We need to retreat."},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"I can feel it..."},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"It's them. They're here."},{"type":"dialogue","speakerName":"Mephisto","speakerId":"char_1507_Mephisto","isRemote":false,"text":"Ohh? You're not going to shoot?"},{"type":"dialogue","speakerName":"Mephisto","speakerId":"char_1507_Mephisto","isRemote":false,"text":"What a pity."},{"type":"dialogue","speakerName":"Mephisto","speakerId":"char_1507_Mephisto","isRemote":false,"text":"You know, you won't get another chance."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"Is he leaving? But--"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"Meteorite! Aim at that collapsing building to the west, now! At least we can distract the enemy to buy us some time!"},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"...This is our only option! I'll do it!"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"Jessica, start running."},{"type":"dialogue","speakerName":"Jessica","speakerId":"char_259_Jessica","isRemote":false,"text":"Huh?"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"...The Yetis are here."},{"type":"dialogue","speakerName":"Jessica","speakerId":"char_259_Jessica","isRemote":false,"text":"Wait..."},{"type":"dialogue","speakerName":"Jessica","speakerId":"char_259_Jessica","isRemote":false,"text":"S-so cold..."},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"... ...Let's go."},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"Now."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"...Jessica."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"She's right."},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"We need to get out of here...!"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"Amiya, can you hear me?"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"Hello? Hello?"},{"type":"dialogue","speakerName":"Meteorite","speakerId":"char_219_meteo","isRemote":false,"text":"Just go! I'll cover you!"},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"Listen, Amiya."},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"...Do not come."},{"type":"dialogue","speakerName":"Frostleaf","speakerId":"char_193_frostl","isRemote":false,"text":"These ruins are..."},{"type":"sceneBreak"}],"observedOperators":[{"speakerId":"char_1507_Mephisto","aliases":["Mephisto"]},{"speakerId":"char_193_frostl","aliases":["Frostleaf"]},{"speakerId":"char_219_meteo","aliases":["Meteorite"]},{"speakerId":"char_259_Jessica","aliases":["Jessica"]}]}
