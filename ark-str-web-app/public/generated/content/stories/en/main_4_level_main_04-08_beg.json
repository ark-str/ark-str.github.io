{
  "server": "en",
  "storyId": "main_4_level_main_04-08_beg",
  "groupId": "main_4",
  "stageId": "main_04-08",
  "title": "Acute Stress Disorder",
  "storyCode": "4-8",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-08_beg.txt",
  "sourceHash": "1cc9528a93d9b158a0185382385330a6808218a0811f1e4dacd6897cf7e88a50",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Hmm...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Where is this..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We're getting close to the coordinates that Frostleaf sent us, but..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "What a disgusting smell."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "It's the stench of something burning...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Where did Reunion lead us to?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Tsk! Watch out for the sneak attack!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Darn it...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "speakerToken": "char_1011_wizard_1#2",
      "operatorId": "char_1011_wizard",
      "portraitKey": "char_1011_wizard",
      "text": "I... I missed?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Don't worry. We're safe here!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "speakerToken": "char_1011_wizard_1",
      "operatorId": "char_1011_wizard",
      "portraitKey": "char_1011_wizard",
      "text": "Guh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Wh-what's wrong?"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "speakerToken": "char_1011_wizard_1",
      "operatorId": "char_1011_wizard",
      "portraitKey": "char_1011_wizard",
      "text": "Guh... urgh... aah..."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_193_frostl_1#2",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "He won't be able to answer you."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Wh-what?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "From that building!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Wait, is that..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Frostleaf! Frostleaf, is that you"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "It is. I've taken care of the enemy."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Sorry for making you worry, Amiya."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Ugh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Are you injured?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Medic, hurry!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No way... Why is your body all frostbitten? What happened to you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Don't worry, it's minor."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Meteorite and Jessica are still in the main square."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "They should be safe for the time being, but it's hard to say how long that's going to last for."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "I managed to lure the enemy out, so Reunion hasn't found them yet."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "The enemy?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Our cover hasn't been blown yet, so there's no need for concern yet."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "But, he's going to come soon..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Where are you hiding, little fox?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Hurry and come out. Our game of hide and seek is about to come to an end."
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "For every minute you stay hidden, I'll break another one of your friends' fingers--"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Do you still plan to keep running?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "(Mephisto...!)"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "(He's bluffing. Don't take the bait.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "(What is he doing...)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Reunion is moving."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "That little...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We have to get in touch with Meteorite..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Why can't I get through? We've clearly already crossed the contaminated area..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "*sigh*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Take a look at this."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Your communicator?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "It's... frozen over? Did it get... ruined by the frost?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Mephisto is a nobody."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "There's something wandering in this city..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "...that is far more terrifying."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Something more terrifying?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "The Yetis. If we run into them, we'll be in serious trouble."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Yetis? Are you talking about the Yeti Squadron? What are they exactly...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "I don't have time to explain right now."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "But they are the ones... behind the sudden temperature drop, as well as our squads' injuries."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "It seems like this squad has already established their territory within this city."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "The sky is getting darker. This is a good opportunity for us..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We'll be able to cross this open area more easily."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Let's go rescue Meteorite and Jessica first."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "I'll lead the way."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "What are those things in the main square? I can't really see..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Are they... statues of some sort? Their shapes are really strange..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "And this smell makes me want to vomit..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Over here. Don't get separated."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Don't go look at those things..."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "--We have company."
    },
    {
      "type": "dialogue",
      "speakerName": "Frostleaf",
      "speakerToken": "char_193_frostl_1",
      "operatorId": "char_193_frostl",
      "portraitKey": "char_193_frostl",
      "text": "Let's take them out before they notice us."
    },
    {
      "type": "sceneBreak"
    }
  ],
