{
  "server": "en",
  "storyId": "main_11_level_main_11-15_end",
  "groupId": "main_11",
  "stageId": "main_11-15",
  "title": "Answer Me",
  "storyCode": "11-17",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/obt/main/level_main_11-15_end.txt",
  "sourceHash": "ced4ae572e0aa29d44e2eb8b301d83e5c966d73d6d2cfce35c2455f1d80b4315",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Closure",
      "speakerId": "avg_npc_411_1",
      "text": "Doctor! We have to take Amiya and go!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "......",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Shining can't hold Theresis off for long!"
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "The drone—"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Grab the zipline, Doctor! We'll go as far as we can!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "*huff*... *huff*... *cough* *cough* *cough*..."
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "I'll punch them, if worse comes to worst."
        },
        {
          "type": "narration",
          "text": "I don't like fighting, if I can help it.\nBut Theresa pulled me out of that attic. Amiya and Kal'tsit taught me responsibility."
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "I'm a Vampire too."
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "If it's for you, I..."
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerId": "avg_4072_ironmn_1",
          "text": "Closure! Over here!"
        },
        {
          "type": "dialogue",
          "speakerName": "Closure",
          "speakerId": "avg_npc_411_1",
          "text": "Huh?"
        },
        {
          "type": "dialogue",
          "speakerName": "Feist",
          "speakerId": "avg_4072_ironmn_1",
          "text": "Time to move, Doctor. The zipline's ready. Give me your hand!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "A burst of light explodes as the sword pierces the ground.\nTime stops in an instant."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Theresis",
          "speakerId": "avg_npc_062",
          "text": "...Confessarius witchcraft."
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "speakerId": "avg_npc_404_1",
          "text": "General!"
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "speakerId": "avg_npc_404_1",
          "text": "Dame Kal'tsit..."
        },
        {
          "type": "dialogue",
          "speakerName": "Theresis",
          "speakerId": "avg_npc_062",
          "text": "She approaches the end of this cycle."
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "speakerId": "avg_npc_404_1",
          "text": "Rhodes Island's Cautus was rescued. The Sanguinarch of Vampires is pursuing the Banshee and Ascalon."
        },
        {
          "type": "dialogue",
          "speakerName": "Theresis",
          "speakerId": "avg_npc_062",
          "text": "What of Theresa?"
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "speakerId": "avg_npc_404_1",
          "text": "I just received Her Highness's signal, general."
        },
        {
          "type": "dialogue",
          "speakerName": "Manfred",
          "speakerId": "avg_npc_404_1",
          "text": "It's ready."
        },
        {
          "type": "dialogue",
          "speakerName": "Theresis",
          "speakerId": "avg_npc_062",
          "text": "Good."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "The Regent looks up at the overcast sky and the walls in the distance.\nThe true battlefield of the Sarkaz lies beyond the walls."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Theresis",
          "speakerId": "avg_npc_062",
          "text": "It's time to begin."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Are you ready?"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "There's nothing to make ready."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Right, we're finally here."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Vina, I must—"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "We must bear witness to all this."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "An elaborate black structure lies at the end of the tunnel.\nGeneration after generation, the greatest minds in Victoria came together to build it.\nAll this, just to hold a sword."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "If few are the heroes who can use it to conquer Catastrophe, then let humanity use its wisdom to raise a shield against the storm.\nThese structures, the entire building, was made for this.\nThe voices rise up again.\nThe calls are no longer urgent, no longer sharp, no longer attempting to persuade or incite.\nShe feels a tired sense of peace.\nShe has been here before. She has been guided to this place, long before her memories took shape.\nJust like then, she knows where she must go, what she must take.\nIt is right there, in the middle of the room, unguarded, so unremarkable it might as well have been a tiny decoration in this grand building."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Kyngasycath, the Sighs of Kings.\nIt lay there and continues to do so, over the centuries, through countless reforgings.\nSiege extends a hand towards it.\nBroken shadows fill the space, rising and ebbing, resonating.\nAlexandrina. Alexandrina Vina Victoria. They whisper her name."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "She touches the sword.\nShards of days gone by pass through her body. She hears a boom in her mind.\nSuddenly, she understands.\nShe is the source of all those visions and sounds.\nThey are her doubts, confusion, regrets, recollections.\nThings she has forgotten, and things she intentionally forgot.\nA great hand raises her. Londinium stands up from beneath her, taking her across the land of Victoria.\nThe land that she and her friends walked.\nCountless voices superimpose upon one another.\nVictoria, Victoria.\nThis is Victoria.\nHer Victoria."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "The voices call out."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "—"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Siege opens her eyes. There are no illusions now, no tides. She holds in her hand the Sighs of Kings, symbol of the Victorian monarchy.\nThere is little to show that it is a sword of legend. It is unremarkable in size and design.\nIt looks like an ordinary sword."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "You have the Sighs of Kings, Vina."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "It's... lighter than I expected."
        },
        {
          "type": "narration",
          "text": "Let's go. Time to go home.\nWe—"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Siege wants to turn around and feel the sword's warmth with her friends."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Don't."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "But she feels a colder blade in her back."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "...Allerdale."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Please! Don't. Don't turn around."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Give me the sword."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Your Highness Alexandrina... I'm sorry."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I have to..."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I have to do this."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Allerdale's voice is calm, but filled with a terrible, resolute sorrow.\nSiege recalls the 'memoirs' that Morgan wrote in jest.\nA handful of pages, clumsily written, with less-than-elegant vocabulary.\nThe story starts with a fictional fight. Everyone returns to base after the fight. Allerdale makes a cream stew for them in the story.\nShe laughs in her heart. Allerdale made a stew, yes, but what the memoirs omitted is that...\nIt did not exactly taste great."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "Siege!"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "Oh—!"
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "Don't move."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "You... you too..."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "I don't want to hurt you."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "But I have a debt to pay."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "Our mission is to help Allerdale remove the sword from the Mausoleum of Kings."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "Finish this job, and I can retire."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "It was an offer I couldn't refuse."
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "We just mourned the heroes who fell victim to betrayal together."
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "I thought you would understand."
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "But in the end, you're no different from them."
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "I'm ashamed I thought about trusting you, even for a moment."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "Like I said, living is hard."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "I'm sorry. I want all of us to keep on living. I'll try to make sure we do just that."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "We've both been pushed out of death's way by our friends."
        },
        {
          "type": "dialogue",
          "speakerName": "Totter",
          "speakerId": "avg_4062_totter_1",
          "text": "Unfortunately, our paths happen to diverge this time."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Allerdale..."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Your Highness."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Please hand over the Sighs of Kings, for your own safety."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Is this the only way?"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I betrayed your trust. There's nothing I can say about that."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "You can admonish me, reproach me, try to defeat me. You have the right to do so."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "But I will leave with the sword."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "This is my... destiny... in Londinium."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "You said the Sighs of Kings would protect Londinium from the storm."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I don't want to drag Londinium into the abyss either. I won't let her fall into Sarkaz hands."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Into the hands of the dukes, then."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Whoever is behind you wants to use the Sighs of Kings to intimidate the other dukes and subjugate them."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "They don't care about protecting Victoria."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "We may be meek, but we're in the middle of all this."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "With the people who have been hurt and abused."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I know."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I know what she's after, but it doesn't concern me."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I'm only doing... I only care about what I can actually influence."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "What about the Self-Salvation Corps?"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "You built it with Clovisia. You protected it with your honor."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I have no honor."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Then you protected it with your life."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "What do I tell the Corps fighters, if you're really going to leave?"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Clovisia will handle it."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I no longer have the strength to care about what they think of me."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "You claim you only care about what you can influence."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Aren't you underestimating what you already have?"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "What does one dare to have, when you know it's only a matter of time before you lose it?"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "What does one dare to reveal, when what everyone trusts and respects is just an illusion?"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "What can one hold on to, when you realize this is the one and only end of your path?"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "This isn't even the outcome of a choice."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I simply ended up here. Fate has pushed me to this place, before I even realized it."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "We could never have walked together."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "We met when we were little, didn't we?"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "At Cumberland Manor."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I thought you had forgotten."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "I almost had... I was with Gawain that day."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "The creature that was like the sun told us we would meet again, someday."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "But he could not have guessed that it would end this way."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "You won't give me the sword, Vina."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Then swing it. We must bear witness..."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Allerdale."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Remember my promise?"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "Enough! Say no more."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "I carry nothing on my shoulders. I'll just be your brain trust.\nSorry... I forgot you had Morgan.\nI'll just be a thug then."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "We'll bomb the Sarkaz camp together. You light a fire, and I'll kick their commander's arse once there's smoke."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "I'm joking."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "I know."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "My path is long determined, Vina."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "Why do you say that? You're still with us. The Glasgow Gang has more stories to write."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "So..."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "The answer is yes."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "I'll make sure you come back unharmed after kicking that commander's arse."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "That's my promise."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "It's not a joke. Never has been, never will be."
        },
        {
          "type": "dialogue",
          "speakerName": "Siege",
          "speakerId": "avg_npc_407_1",
          "text": "We'll all make it out of this in one piece."
        },
        {
          "type": "dialogue",
          "speakerName": "Allerdale",
          "speakerId": "avg_npc_397_1",
          "text": "—"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "A sound breaks the stalemate.\nWas it an illusion?\nSiege looks around. The massive statues remain still in the shadows. None of the dead Sarkaz come back to life."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Again.\nNearby, right in front of her.\nThe sound of steam gushing, increasingly rapid.\nIncreasingly loud, increasingly clear, until it fills the entire space."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Dagda",
          "speakerId": "avg_npc_396_1",
          "text": "W-What's that?"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Allerdale's heart skips a beat.\nShe can feel it.\nThe premonition of fate echoes again cruelly."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
  "observedOperators": []
}
