  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "Aaaagh--!"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "Watch out! !"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "I'm fine... It's just a scratch, don't worry..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Not good enough... At this rate, they're going to close in on us."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "I've already found the weak point in their line, but without reinforcements, it's taking all we have just to hold them back!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...Please hold out a bit longer! Focus your fire on the ranged enemies!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Our Casters will take care of their vanguard!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Good, good! This is how things should be! Next up, F3, E5!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "This bloody brat...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Excellent! Now, B4, B5!"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "The enemy is now trying to flank us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Take two Defenders and a Sniper! Just keep them busy!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "And next! H2, H6!"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "They... they're rushing our defensive line!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "speakerToken": "char_014_riope",
      "operatorId": "char_014_riope",
      "portraitKey": "char_014_riope",
      "text": "Vanguards, flush them out!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "That's right, let me see how you struggle!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#1",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Now, Casters. move to C7. Capture their Rook!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Enemy Casters have appeared! So far, they're hiding behind their Defenders!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "It's too late! Take cover!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "speakerToken": "char_016_medic",
      "operatorId": "char_016_medic",
      "portraitKey": "char_016_medic",
      "text": "Aaargghh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "*cough* *cough*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#5",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Now be snuffed out, like flames before a storm!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Is he really commanding his troops like that? How can he give such precise orders just by barking out chess moves?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Those same disorderly thugs have been turned into an army under his command...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "At this rate, he's going to keep exploiting the advantage he gets through his leadership..."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "On the other hand, if we manage to suppress him, they'll fall into disarray!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Don't give them even the slightest opening!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Damn it, we're running out of time!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We can't allow ourselves to be stalled any longer!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Is there some way to turn the tables... anything?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We're going to be... Doctor's going to..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Gaaaaaaahh!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#2",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "What?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#2",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "Huh... What's going on? Why are people getting knocked into the air?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#2",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "What..."
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "speakerToken": "char_1507_Mephisto_1#2",
      "operatorId": "char_1507_Mephisto",
      "portraitKey": "char_1507_Mephisto",
      "text": "... the hell is that?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_148_nearl_1#5",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "You guys sure took your sweet time. I even had time to relocate the civilians."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "--?!!"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_148_nearl_1#5",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Out of my way!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Woah!!"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_148_nearl_1#5",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Let's hit 'em even harder! Don't give the enemies a chance to regroup!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Miss Nearl!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#1",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "I'm here."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#1",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "I'm glad you're still safe, Amiya. Let's move."
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Thank goodness you were deployed in this operation."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Using the signal flare was judicious. Seems like you've been having a rough time."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#1",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#1",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "You must be Dr. {@nickname}, right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#1",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Radiant Knight, Nearl, at your service. Your chariot has arrived."
    },
    {
      "type": "sceneBreak"
    }
  ],
