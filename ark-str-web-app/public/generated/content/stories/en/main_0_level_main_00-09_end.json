{
  "server": "en",
  "storyId": "main_0_level_main_00-09_end",
  "groupId": "main_0",
  "stageId": "main_00-09",
  "title": "Nearl",
  "storyCode": "0-9",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_00-09_end.txt",
  "sourceHash": "c3858645c0fa9edc11df56d1906b67c8695eb256db82087eb3f51a8881e1af06",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第五关（后）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "Aaaagh--!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Watch out! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "I'm fine... It's just a scratch, don't worry...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Not good enough... At this rate, they're going to close in on us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "I've already found the weak point in their line, but without reinforcements, it's taking all we have just to hold them back!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Please hold out a bit longer! Focus your fire on the ranged enemies!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Our Casters will take care of their vanguard!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Good, good! This is how things should be! Next up, F3, E5!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "This bloody brat...!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Excellent! Now, B4, B5!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "The enemy is now trying to flank us!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Take two Defenders and a Sniper! Just keep them busy!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "And next! H2, H6!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "They... they're rushing our defensive line!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ace",
      "text": "Vanguards, flush them out!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "That's right, let me see how you struggle!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Now, Casters. move to C7. Capture their Rook!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Enemy Casters have appeared! So far, they're hiding behind their Defenders!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "It's too late! Take cover!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Medic",
      "text": "Aaargghh!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "*cough* *cough*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Now be snuffed out, like flames before a storm!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Is he really commanding his troops like that? How can he give such precise orders just by barking out chess moves?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Those same disorderly thugs have been turned into an army under his command...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "At this rate, he's going to keep exploiting the advantage he gets through his leadership...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "On the other hand, if we manage to suppress him, they'll fall into disarray!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Don't give them even the slightest opening!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Damn it, we're running out of time!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We can't allow ourselves to be stalled any longer!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Is there some way to turn the tables... anything?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We're going to be... Doctor's going to...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Gaaaaaaahh!!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "What?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "Huh... What's going on? Why are people getting knocked into the air?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "What...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mephisto",
      "text": "... the hell is that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "You guys sure took your sweet time. I even had time to relocate the civilians.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "--?!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Out of my way!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "text": "Woah!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Let's hit 'em even harder! Don't give the enemies a chance to regroup!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Miss Nearl!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "I'm here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "I'm glad you're still safe, Amiya. Let's move.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "text": "Thank goodness you were deployed in this operation.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "Using the signal flare was judicious. Seems like you've been having a rough time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "You must be Dr. {@nickname}, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "text": "Radiant Knight, Nearl, at your service. Your chariot has arrived.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
