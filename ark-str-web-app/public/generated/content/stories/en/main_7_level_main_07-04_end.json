      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Me.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "Kal'tsit grabbed by the waist with one arm and pulled you onto the zipline with the other."
        },
        {
          "type": "dialogue",
          "speakerName": "Kal'tsit",
          "text": "Seize your own fate next time, Dr. {@nickname}.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "The sandstorm was ferocious, and the 'arm' holding you was very hard. You couldn't be certain it belonged to Kal'tsit."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "All squads, take your positions!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "There is no room for error in the operation to come!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "narration",
          "text": "10:30 a.m.\nCore City Foundation"
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Rhodes Island Operator",
          "text": "Yeah, this is definitely a sign of someone breaking in here.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Rhodes Island Operator",
          "text": "Confirmed one infiltrator.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "We can't be sure if that bloodstain over there is Reunion's or someone else's. It hasn't turned yet.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "It very well could be Officer Ch'en's! We have to hurry.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Oh, Doctor!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "I'm glad you made it here safe.",
          "portraitKey": null
        }
      ]
