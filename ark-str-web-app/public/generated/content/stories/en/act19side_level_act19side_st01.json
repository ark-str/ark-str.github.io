          "text": "I'm not trying to stop you, even if we're shattering safety regulations..."
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerId": "avg_135_halo_1",
          "text": "Joyce, I'm gonna go with you."
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You are not a medical worker, Elena.",
