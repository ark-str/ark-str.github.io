        },
        {
          "type": "dialogue",
          "speakerName": "Pioneer",
          "speakerId": "avg_npc_534_1",
          "text": "......"
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerId": "avg_135_halo_1",
          "text": "But..."
        },
