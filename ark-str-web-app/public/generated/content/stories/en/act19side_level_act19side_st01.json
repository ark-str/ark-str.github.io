        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerId": "avg_135_halo_1",
          "text": "Who gives two cares? Remember, I took basic medical training too. An extra pair of helping hands can't hurt in a situation like this, right?"
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerId": "avg_135_halo_1",
          "text": "Plus I've gotta make the trip anyway, with my errand from Dorothy. Might as well be now."
