        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerId": "avg_npc_535_1",
          "text": "Hands up, ladies."
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerId": "avg_135_halo_1",
          "text": "You're... the leader of the Pioneer Team."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerId": "avg_npc_535_1",
          "text": "You remember me? I admit I'm a touch surprised."
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerId": "avg_135_halo_1",
          "text": "Sir, why have you tricked me and Joyce into coming here?"
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerId": "avg_npc_535_1",
          "text": "I trust you know, Urbica... Dr. Urbica."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerId": "avg_npc_535_1",
          "text": "That's how you say your surname, right?"
        },
        {
          "type": "dialogue",
          "speakerName": "Elena",
          "speakerId": "avg_135_halo_1",
          "text": "You pronounced it beautifully..."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerId": "avg_npc_535_1",
          "text": "Gonna trouble you to lend us your communicator there, Doc."
        },
        {
          "type": "dialogue",
          "speakerName": "Sonny",
          "speakerId": "avg_npc_535_1",
          "text": "Pioneer Team needs to ask your superiors a few questions."
        },
        {
          "type": "sceneBreak"
        }
