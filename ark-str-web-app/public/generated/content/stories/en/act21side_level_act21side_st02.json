{
  "server": "en",
  "storyId": "act21side_level_act21side_st02",
  "groupId": "act21side",
  "stageId": "act21side_st02",
  "title": "Cut Open",
  "storyCode": "IS-ST-2",
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/activities/act21side/level_act21side_st02.txt",
  "sourceHash": "0f14a5cc163840352b263de4de4d77177420a9672c46556197d639e69f377bee",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Radical Mafioso",
      "speakerId": null,
      "text": "No one told me about this!"
    },
    {
      "type": "dialogue",
      "speakerName": "Loyal Mafioso",
      "speakerId": null,
      "text": "Me neither."
    },
    {
      "type": "dialogue",
      "speakerName": "Radical Mafioso",
      "speakerId": null,
      "text": "Did she act on her own?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "Don't worry about it."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "I chose to let her do it."
    },
    {
      "type": "dialogue",
      "speakerName": "Radical Mafioso",
      "speakerId": null,
      "text": "Don Alberto! But why?"
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "A gold coin can mean very different things in different circumstances."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "The Bellones will not have their way."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "What's a little smirch on our reputation, if it means we cut another piece of flesh off Bernardo?"
    },
    {
      "type": "dialogue",
      "speakerName": "Loyal Mafioso",
      "speakerId": null,
      "text": "Understood."
    },
    {
      "type": "dialogue",
      "speakerName": "Loyal Mafioso",
      "speakerId": null,
      "text": "What should we do now?"
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "Prepare my car. I'm going to see my daughter."
    },
    {
      "type": "dialogue",
      "speakerName": "Loyal Mafioso",
      "speakerId": null,
      "text": "Yes, Don Alberto."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "By the way, where is Danbrown now?"
    },
    {
      "type": "dialogue",
      "speakerName": "Loyal Mafioso",
      "speakerId": null,
      "text": "Danbrown? I think he's working at a carwash."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "Give me the address."
    },
    {
      "type": "dialogue",
      "speakerName": "Loyal Mafioso",
      "speakerId": null,
      "text": "Are you calling him back?"
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "I never permitted him to leave the famiglia."
    },
    {
      "type": "dialogue",
      "speakerName": "Loyal Mafioso",
      "speakerId": null,
      "text": "Understood."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "And prepare a banquet."
    },
    {
      "type": "dialogue",
      "speakerName": "Loyal Mafioso",
      "speakerId": null,
      "text": "For...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "A feast for the heir to Famiglia Bellone."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Gambino",
      "speakerId": null,
      "text": "Let me go!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bodyguard",
      "speakerId": null,
      "text": "We caught the assassins, thanks to Lappland's tip-off."
    },
    {
      "type": "dialogue",
      "speakerName": "Bodyguard",
      "speakerId": null,
      "text": "They've been identified as having taken part in Leontuzzo's assassination."
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "Do you two know her?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Hey."
    },
    {
      "type": "dialogue",
      "speakerName": "Capone",
      "speakerId": null,
      "text": "Nothing good ever comes of dealing with you, Lappland."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Look on the bright side. It's not every day that you get to sit in a Siracusan cell."
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "Lock them up."
    },
    {
      "type": "dialogue",
      "speakerName": "Bodyguard",
      "speakerId": null,
      "text": "Yes, Your Honor."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "You were the one who waylaid Cellinia, and ordered the bombing of Carracci..."
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "Is that still your story?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "You sure are persistent, aren't you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Don't you and Bellone want to get this case closed as quickly as you can?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Does it matter if it was me or Texas who did it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "You really should hang me, Your Honor."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "I'm just a pawn my famiglia cast aside. Surely, you can do it."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Imagine the positive impact that my death will have on justice in Siracusa."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Isn't it worth a try?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "I don't know what you're planning."
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "But I'll do exactly that, if you really are the culprit, Lappland Saluzzo."
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "First, there's someone I have to see."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Demetri",
      "speakerId": null,
      "text": "Welcome back, Don Bernardo."
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "Take a break. You've been working hard."
    },
    {
      "type": "dialogue",
      "speakerName": "Demetri",
      "speakerId": null,
      "text": "Yes, Don Bernardo."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "Not happy?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "How could I be?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "Come with me."
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "There are some things that you have to know."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "Why did you bring me here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "My lord."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Zaaro",
      "speakerId": null,
      "text": "Bernardo. Are you asking me to tame your unruly cub now?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "He just needs to understand something."
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "What are you—"
    },
    {
      "type": "dialogue",
      "speakerName": "Zaaro",
      "speakerId": null,
      "text": "I am il Signore dei Lupi, cub."
    },
    {
      "type": "narration",
      "text": "Leontuzzo feels a daze at the words 'Signore dei Lupi'.\nFragments of knowledge and memory rush into his mind and take shape."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "The Signori dei Lupi. Sovereign of beasts.\nBeings that were never born. They have existed since time immemorial.\nZaaro is a sovereign of beasts.\nHe and his kind have borne witness to the path that the wolfpack tread on the wildness.\nThey are engaged in a killing game, guided by their own nature.\nThe Signori dei Lupi are immortal.\nThey gain no satisfaction from fighting amongst themselves, so they have set rules for their game.\nEach Signore dei Lupi grooms a human to hunt the others.\nThese are the Fangs of the Signore dei Lupi.\nThe one with the last Fang standing becomes the alpha."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "Signore dei Lupi, the hunt, Fangs..."
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "Could it be...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Zaaro",
      "speakerId": null,
      "text": "Your father has been an excellent Fang."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saluzzo Mafioso",
      "speakerId": null,
      "text": "Rubio, Don Alberto is holding a banquet for Famiglia Bellone."
    },
    {
      "type": "dialogue",
      "speakerName": "Saluzzo Mafioso",
      "speakerId": null,
      "text": "We'll need the best food."
    },
    {
      "type": "dialogue",
      "speakerName": "Rubio",
      "speakerId": null,
      "text": "Could it really be Saluzzo?"
    },
    {
      "type": "dialogue",
      "speakerName": "Saluzzo Mafioso",
      "speakerId": null,
      "text": "Rubio?"
    },
    {
      "type": "dialogue",
      "speakerName": "Rubio",
      "speakerId": null,
      "text": "Oh, it's nothing."
    },
    {
      "type": "dialogue",
      "speakerName": "Rubio",
      "speakerId": null,
      "text": "Let me think... ordinary hospitality won't do when the Bellones are involved."
    },
    {
      "type": "dialogue",
      "speakerName": "Rubio",
      "speakerId": null,
      "text": "Please inform Don Alberto that it would be my honor to prepare the banquet, personally."
    },
    {
      "type": "dialogue",
      "speakerName": "Rubio",
      "speakerId": null,
      "text": "I eagerly await his response."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "In Columbia, a show of kindness by a mafioso often results in the subject becoming a chip in a bargain.\nThe more one cares, the higher the cost.\nIn Siracusa, the subject may take their last breath on a dark, rainy street.\nThe more one cares, the greater the pain.\nOne must become cold and heartless.\nTexas knows that well, and detests it."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "I'm sorry."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": null,
      "text": "No need to apologize to me."
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "You can leave after some paperwork, if you want."
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "Procedurally, you're no longer a suspect."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": null,
      "text": "I'm not worried. It's quieter here in jail."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": null,
      "text": "Haven't you given up yet?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "Do you really think your old friend did it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": null,
      "text": "It's her style, but I don't see the motive."
    },
    {
      "type": "dialogue",
      "speakerName": "Lavinia",
      "speakerId": null,
      "text": "Then it's not time to give up."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bellone Mafioso",
      "speakerId": null,
      "text": "Signorina Lavinia, Famiglia Rossati sends word that Signor Wallach would like to speak with Signorina Cellinia."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": null,
      "text": "Well... no rest for the wicked, then."
    },
    {
      "type": "narration",
      "text": "Lavinia realizes that Texas put something in her pocket as she passed by.\nShe reaches into it and finds a note.\nThere is a phone number and a short message scribbled in a corner:\n'Penguin Logistics delivers, rain or shine.'"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Unhappy Audience Member",
      "speakerId": null,
      "text": "Signor, if you have to sleep, can you at least put your legs down?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": null,
      "text": "...Hmm?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Are you talking to me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unhappy Audience Member",
      "speakerId": null,
      "text": "Who else? How could you sleep in the theater?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unhappy Audience Member",
      "speakerId": null,
      "text": "And to put your feet up like that! How rude!"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "I'm not blocking you, am I?"
    },
    {
      "type": "dialogue",
      "speakerName": "Unhappy Audience Member",
      "speakerId": null,
      "text": "No, but it's really off-putting to have someone so rude beside me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Alright, I'll put my legs down."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Unhappy Audience Member",
      "speakerId": null,
      "text": "Hey, why do you have food with you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Theater Manager",
      "speakerId": null,
      "text": "We don't sell food here."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Yeah, I bought it at the corner store, since you don't sell popcorn here."
    },
    {
      "type": "dialogue",
      "speakerName": "Theater Manager",
      "speakerId": null,
      "text": "Is it your first time here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "A friend suggested I come here to relax."
    },
    {
      "type": "dialogue",
      "speakerName": "Theater Manager",
      "speakerId": null,
      "text": "What do you think of the performance?"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "I don't really understand what's going on."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Why are they doing that?"
    },
    {
      "type": "dialogue",
      "speakerName": "Theater Manager",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Theater Manager",
      "speakerId": null,
      "text": "Escort this gentleman out."
    },
    {
      "type": "dialogue",
      "speakerName": "Theater Manager",
      "speakerId": null,
      "text": "He's not welcome here."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Hey, I bought a ticket!"
    },
    {
      "type": "dialogue",
      "speakerName": "Theater Manager",
      "speakerId": null,
      "text": "Give him a refund."
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "Right away."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "Come with us, signor."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "And get the hell out."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Harsh Security Guard",
      "speakerId": null,
      "text": "Say, I saw him when the show started."
    },
    {
      "type": "dialogue",
      "speakerName": "Harsh Security Guard",
      "speakerId": null,
      "text": "I thought he was some rich boy out to experience society."
    },
    {
      "type": "dialogue",
      "speakerName": "Harsh Security Guard",
      "speakerId": null,
      "text": "Turns out it was a poor cazzo who knows nothing about opera."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Did you like what they were doing on stage?"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "Of course. The actors looked nice."
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "And the songs were beautiful."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Is that what they call 'art'?"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "Stick to the bars, pleb."
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "Oh yeah, here's your ticket money."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "Don't you dare say we took it."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "What's that? You wanna do this the hard way?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "Hey, this guy's strong."
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "I need some help here!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Harsh Security Guard",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Harsh Security Guard",
      "speakerId": null,
      "text": "Something's not right with his eyes."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "A-Aaaahh! My arm! It's gonna break!"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Flippant Security Guard",
      "speakerId": null,
      "text": "H-Hold it right there!"
    },
    {
      "type": "dialogue",
      "speakerName": "Harsh Security Guard",
      "speakerId": null,
      "text": "Just let it go, don't waste your time with a cazzo like that."
    },
    {
      "type": "dialogue",
      "speakerName": "Harsh Security Guard",
      "speakerId": null,
      "text": "C'mon, let's get you bandaged up."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Sorry, Signorina Lavinia..."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Doesn't look like this is something for me."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Guess I should find a bar to get myself drunk, then spend the night at the porno theater."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerId": null,
      "text": "Want a drink?"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "...?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Danbrown looks in the direction the voice came from.\nHe sees a man leaning by the side of the alley, shaking a bottle in his hand."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "I want an explanation, Lappland."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Isn't this what you wanted?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Help the Bellones when they're at their weakest, control them, and dominate them, rather than destroy them."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "I thought I taught you."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "I taught you what to do in times like this."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Oh, I forgot. It's been years since I left, you know."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "I can have you ignoring the business I give you, or you going against me."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "You're my daughter, after all."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "I'm a forgiving man, but I can't let you go over my head to make decisions for the famiglia."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "Even if you did actually guess what I wanted to do."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "I am don of our famiglia."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "Seven years ago, I kicked you out for this. Seven years later, you came back and did it again."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "You knew it would infuriate me. You knew it was the only thing that could infuriate me."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "Why did you do it, figlia mia?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "Because nothing else brings me joy, padre mio."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "I wanted to know if it's really your position that matters most."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "I've always wanted to know."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Lappland raises herself from the ground with great effort.\nHer face is full of joy, as though this was what she came back to Siracusa for."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "speakerId": null,
      "text": "Time's up, boss."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "That'll be all for today."
    },
    {
      "type": "dialogue",
      "speakerName": "Lappland",
      "speakerId": null,
      "text": "That's all?"
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "You defied me."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "But you're still my daughter."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "You know what I want, better than anyone."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "All you're missing is discipline."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "It's my fault for not educating you properly."
    },
    {
      "type": "dialogue",
      "speakerName": "Alberto",
      "speakerId": null,
      "text": "But there's still time."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "So all the Signori dei Lupi live amongst us?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "No, he's the only one who involves himself in human society."
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "The rest of them stay out in the wildness."
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "Why?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "He believes that the authority over man is a form of power."
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "And he wants to use it to triumph over the other Signori dei Lupi."
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "So he wants you to overthrow Signora Sicilia, become the de facto ruler of Siracusa, and help him win his fight with his kind?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "You, me, the entire famiglia, we're all tools to him."
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "Did you think I was going to accept that?"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "How could you accept being a puppet your entire life?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "Figlio mio, there's one thing you've misunderstood."
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "He taught me how to win power, just as I taught you."
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "Using it to defeat the other Fangs is just a part."
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "Every decision that I made, including what I'm doing now, is my own."
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "(No, he's serious.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Leontuzzo",
      "speakerId": null,
      "text": "(Look at him, the strength of his character, he's no puppet.)"
    },
    {
      "type": "dialogue",
      "speakerName": "Bernardo",
      "speakerId": null,
      "text": "We're each other's tools, instruments for our mutual victory. That's all."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "speakerId": null,
      "text": "Boss, the Saluzzos have sent their invitation."
    },
    {
      "type": "dialogue",
      "speakerName": "Mafioso",
      "speakerId": null,
      "text": "Don Alberto would like Signor Leon to attend his banquet."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Sigh."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "I've lost count of how many times you sighed today, Sora."
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerId": null,
      "text": "Can't be helped, considering what happened at the trial."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "How about we raid the prison?"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerId": null,
      "text": "Ya lost yer darned mind?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "At least we'd get to see her."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "I wouldn't recommend it."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "What are you doing here, Miss Caterina?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "That's my line, Sora. Why are you out here? It's dangerous."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "I live nearby."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "You do? Did you get scammed?"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerId": null,
      "text": "It's fine, she's got me n' Exusiai."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "Who's this, Sora?"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Oh, I met Caterina a few days ago over at the theater."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Well... I guess it's fine, if you have friends you can count on."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "What about you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Oh, don't worry about me. A noisy place like this is conductive to my creative work."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Creative work... say, the playwright behind La Morte di Texas is named Caterina too. Could you be...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Uh-huh."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Wow! No wonder you knew so much about the Texas Family!"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerId": null,
      "text": "I read that one! Even I could tell it's one humdinger of a script!"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerId": null,
      "text": "Can I get yer autograph?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Sure. Not that it's worth anything right now."
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerId": null,
      "text": "Le Morty de Texas is gonna be a blockbuster! You'n bet on that!"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Thanks."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Back to what you just said..."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "You look like you can take care of yourselves, and I wouldn't put it past you to actually get it done, if it was any other Siracusan prison."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "But things aren't so easy here in Volsinii, with Lavinia around."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "The eyes of all the famiglie are on that place. You don't know what trouble you might stir up, if you act rashly."
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerId": null,
      "text": "Heh, we were just kiddin' around."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "You didn't look like you were."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "May I ask a question?"
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Do you know Cellinia well?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Sit."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "There's an unwritten rule in art and writing."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "You can base your work on the famiglia, but you can't mention a real famiglia by name."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "I've heard that."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "But somebody put 'La Morte di Texas' out there."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "The first work to use the name of a real famiglia."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "And?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "That means the famiglie aren't trying to stay in the shadows anymore. They're out to take center stage."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "All thanks to the Columbians."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "A lot's changed since the Columbians got mixed up in the Siracusan art scene."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Unscrupulous artists—or rather, craftsmen—pumped out work that's starting to stink."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "They're not making observations about life, they're making pale imitations of it. As long as audiences are willing to shell out money for it."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "It's just a mosaic of pop culture. What was popular yesterday shows up in theaters tomorrow."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Real quality is buried under garbage, which becomes all you find when you look for art."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Isn't that terrible?"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "If it's what everybody likes, then what you call 'art' sounds like garbage."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Some think like that, but not everyone."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "There are those who would like to keep good art from being buried, but they don't know how to fight the tide."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "That old timey opera didn't appeal to me."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "But you never escaped the past, did you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Who are you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Benthonexigios. You'll find my name in the reviews section of Volsinii Arts Weekly."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Ben..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Just call me Ben."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Ben..."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "I... I've got my thoughts about what Siracusa's become."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "People up high say we oughta solve our problems in more civilized ways."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "But when I try to do something all civilized, things turn out the same as they always did."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Why do we fool ourselves like that, when we don't actually have to?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "The famiglie know how things are trending, but no one wants to give what they already had."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Want a drink?"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "That wine's not cheap."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "It's not."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "And this is a cheap pizzeria."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "It is."
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "Why pair a wine like that with pizza like <i>that?</i>"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Because the wine is worth the same as the pizza to me."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "The wine is certainly finely made, but just as much care was put into growing the wheat that ended up in this pizza."
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Is there really that much of a difference in value between them, if you take away the trappings of civilization?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Do you believe in these things?"
    },
    {
      "type": "dialogue",
      "speakerName": "Carwash Worker",
      "speakerId": null,
      "text": "The trappings of civilization?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ben",
      "speakerId": null,
      "text": "Like the label on this wine. Slap it on something, and you're free to feed on the people whom you've fooled."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "So Cellinia fled to Lungmen, and you are her friends..."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Hard to believe, isn't it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "No, I believe it."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Really?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "First, there's no need for you to lie. Second, I always thought there was a chance she was still alive."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Now I understand why she suddenly showed up."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "I guess she made a deal with the Bellones, and now she's here to pay her debt."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Definitely sounds like her."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "But what a coincidence it is that you found the Compagnia dell'alba... (whispers) or perhaps it's no coincidence..."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "What's special about that company?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Nothing. It's nothing."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "The Compagnia dell'alba is a good place to start, if you want to get close to Famiglia Bellone."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "But... well, come with me."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": null,
      "text": "What's this place...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "It's my home."
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerId": null,
      "text": "Wow, books and papers everywhere."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Haha, sorry about that. I didn't have time to clean up."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Take this, Sora."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "A key?"
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Yes. It can be dangerous outside. Come here, if you want to practice."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "It's quieter, and I have plenty of scripts you can look at."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "But..."
    },
    {
      "type": "dialogue",
      "speakerName": "Caterina",
      "speakerId": null,
      "text": "Just think of it as making a new friend."
    },
    {
      "type": "dialogue",
      "speakerName": "Sora",
      "speakerId": "char_101_sora",
      "text": "Alright!"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": [
    {
      "speakerId": "char_101_sora",
      "aliases": [
        "Sora"
      ]
    }
  ]
}
