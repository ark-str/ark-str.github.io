    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Delphine",
      "speakerId": null,
      "text": "I'm on it."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Shearer",
      "speakerId": null,
      "text": "Acknowledged."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Dagda",
      "speakerId": null,
      "text": "Acknowledged."
