      "type": "dialogue",
      "speakerName": "Magdelene",
      "speakerId": "avg_494_vendla_1",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Magdelene",
      "speakerId": "avg_494_vendla_1",
      "text": "Is it over?"
