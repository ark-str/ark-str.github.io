{
  "server": "en",
  "storyId": "act11d0_level_act11d0_08_end",
  "groupId": "act11d0",
  "stageId": "act11d0_08",
  "title": "Sinking Moonlight",
  "storyCode": "TW-8",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act11d0/level_act11d0_08_end.txt",
  "sourceHash": "4e7143a9aeb6ea5aacd5eef010b04827c871b2e28af7aa03e9e10165251c4c67",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "九尾狐活动 8下"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Wounded Townsfolk",
      "text": "Ah! Schultz! That's where you were!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wounded Townsfolk",
      "text": "I heard you were hurt. Are you being discharged?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "*cough*... There are so many wounded. If this keeps up, we'll run out of beds.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "Tatjana... how is Tatjana?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wounded Townsfolk",
      "text": "I- I'm not sure. I heard someone burned to death in front of her, and she...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tatjana",
      "text": "Urk... Ahhh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "Let it out, child. Just let it all out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tatjana",
      "text": "I- I'm sorry... I just...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "A good cry is healthy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tatjana",
      "text": "But it's still chaos out there!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "I'll go. Between me, and the Rhodes Island team...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "We'll figure it out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tatjana",
      "text": "No... Don't tell me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "Take her to a bed. I'm taking command.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Wounded Townsfolk",
      "text": "Of course.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tatjana",
      "text": "Uncle...! Promise me! Promise me you won't get yourself killed!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tatjana",
      "text": "It's pointless.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "It's pointless to even say it's pointless.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "Have some hope, at least. There's always a chance to turn things around.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Let me... through!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Townsfolk",
      "text": "We did it! We shattered the giants!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "This persistence... unexpected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "If you keep holding back, we won't make it out in one piece.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Your eyes are full of hatred, and emptiness.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "You are angry about Dr. Atro. But what of it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "We all have our own baggage.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Shut up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Don't you dare... speak her name.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Gah—!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "When winter comes, when the famine comes, you will still lose. No one will survive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Wolumonde... will end.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "That goes without saying.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Who is it you hate? Who are you going to save?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Grr! Those Arts again!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock Colossus",
      "text": "Gaaaaaaaah!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Suzuran",
      "text": "Folinic!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Delaying the time it takes for Mudrock's Arts to activate... what a strange ability.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "But, do you really have the luxury to be getting distracted?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Suzuran",
      "text": "Hey! L-let go of me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "You're lucky. If you were a few years older, I'd have already hacked off your dominant hand.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Suzuran?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Don't try to run.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock Colossus",
      "text": "GRAAAAAAAHHHH—!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "You're just a medic. Don't try to fight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Severin! You can't!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Another... warrior.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "We found the real murderer.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "The one behind everything! The traitor Biederman! Just moments ago brought to the Rathaus by the Rhodes Island operators!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rebellious Townsfolk",
      "text": "Wait, Biederman... Biederman's still alive? What are you talking about?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Don't listen to his bullshit! Does it even matter who the real murderer is?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "What we're fighting for is the end marginalization of the Infected, and the end to the aristocracy's exploitation of the working class! Winterwisp will rightfully reclaim its land!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "We are Reunion! A new era begins today!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Look, Severin, it's useless...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "Then kill me, Reunion. Let's have a good fight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "And then what? Winter and famine will still destroy this city.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "No.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "It may be a dead end. But I'd rather believe Rhodes Island can keep things from getting worse.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "At least some will survive.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "You see how bruised and battered you are. Your mask is half broken. Your giant is falling apart. And you're exhausted, aren't you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "I can tell. We're not so different, you and I.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "Say, got a light?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "It'll be my last cigarette anyway... Forget it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "(Do it. Now. Don't give them a chance to save me.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Severin Hawthorn, when you die, I will leave this place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "This is a ghost town. Staying here is just waiting to die.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "I will tell them of your death. If they still wish to harm others, I shall personally deal with them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "...Fair enough.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Farewell.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "These Arts, what is this power...?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Suzuran",
      "text": "Wh-why... must you die?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "Get out of here, girl!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Suzuran",
      "text": "Don't die!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "I have to... so that others can live!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Hey! Mudrock's in trouble! Let's go help him! Don't let up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "B-but they even broke the colossi...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ayerscarpe",
      "text": "Surrender.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ayerscarpe",
      "text": "Sarkaz is lost. What do you have to fight for?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Hmph...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ayerscarpe",
      "text": "If you just need to vent your frustration, fine. I volunteer.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ayerscarpe",
      "text": "Until you're satisfied.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Hurry! Fire up the Gramophone!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "I, I don't know Leithanian Arts. Go get us a Leithanian. What, what's that up there? A drone?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Don't look up! Look behind you! There's something with red eyes...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Click",
      "text": "You probably shouldn't move. GreyThroat has you in her sights.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Click",
      "text": "Oh and you don't want to turn around and look for her either. I'm watching you too.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "You seethe. You protect. How many times is this?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "You... Heh, you actually beat me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "Drop your weapon. You're not getting away this time, Mudrock.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "You'll leave them hating Wolumonde same as they always did!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "Doesn't matter. They don't really want change. They only care about what's good for them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "They could have worked together to get through the crisis. They didn't. They didn't care about the truth. They just wanted to loot and riot.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "Miss Tatjana is right. Even if you sacrifice yourself, it won't help anything.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "No matter how complex the backstory here is, a Rhodes Island operator won't sit by while Infected rioters destroy a town.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "A town Atro wanted to protect.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "A Rhodes Island op team will die defending this plaza, this town hall.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Really, this might lead to so much more death...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "But that's after. After 'you' and after 'us.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "As long as we're still here, we'll fight to the end. So Atro can rest in peace.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "You really have defeated me... Maybe you can actually defend this tower to the death. But... why?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Many will die.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Just like Atro. A meaningless death.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "The Infected have a reason to fight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "There's always a justification. But for now, you're not solving the problem. You're only causing destruction.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "After the Catastrophe struck Wolumonde, with supplies low and manpower short, what did you do?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Tell me. Tell me what you did!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "You were told not to move.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "Your Arts are so sloppy that at this distance, my crossbow is enough to incapacitate you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Rhodes Island...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "What led to that fire? And what did that fire lead to?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "The mastermind is already dead.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Is he?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Retreat.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "What? But we just...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "I said, retreat.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Only a few... can pass through the Great Rift and return to the land of warmth.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "It doesn't matter if you want to take back your land or get revenge on the rich... You will only end up a corpse in the snow.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Do you want to spend the winter burning with rage? Do you want to warm yourselves with a fire fed with the bodies of innocents?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "The murderer is dead. It's time to leave.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rebellious Townsfolk",
      "text": "B-but we have to take back Wolumonde! It's our land!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Quiet, Winterwisp. All you want is power. You want to cower behind the strong and pick up whatever scraps of power we leave behind.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Don't question the leader. Wise up, or you'll be six feet under.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rebellious Townsfolk",
      "text": "Err...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "This isn't over!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "We lost so many people! Are we going to leave like that? With our tails between our legs? Just because of a few words?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Calm him down, friends.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "Graaaaagh..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Gaaaah! A.... fist...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "A stone fist from underground? You still have the strength?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "You don't need to go that far just to stop them. They were on our side until a minute ago.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "I wanted to scare them, but... never mind...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "And stop calling your Arts monsters 'friends.' It's creepy.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "You don't have to listen. Leave me alone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "I have decided to retreat. I can't force you all to listen, but...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "I am leaving. Those who follow me are also leaving.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Those who stay... you're on your own.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "By the way, do you have a match?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "They might be wet. Those casters back there were a real pain.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Give a light to that Severin man.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Defeated warriors... are lucky to leave the battlefield alive. Don't dawdle.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Pfah! Forget about Reunion then! It's only a matter of time before we take the Rathaus. This town needs us!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Surrender, Severin!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "I told you they wouldn't go down easily *cough* *cough*—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "They're coming! Eyes left!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Suzuran",
      "text": "Get behind me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Ugh. Bunch of lunatics.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Rhodes Island is protecting this place. You have to go through us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "They're going to use Arts. Prepare the defenses. Target the casters.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "——",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Wh- what? They blocked my Arts?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Why are you doing this?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Leader's orders.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Even if we have to fight you, devil, we're not giving up!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Hah.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "What happened? Are they fighting each other?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "Wait... Mudrock... stopped moving?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Leader?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Earth.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Arise...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Stop, Mudrock. You're burning through your own life.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Doesn't matter.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "You don't have to use that ancient power—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "I said... Arise!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "All the rubble begins to condense into a single point.\nA giant, looking out over the distant mountains.\nMudrock, however, stands motionless."
    },
    {
      "type": "dialogue",
      "speakerName": "Suzuran",
      "text": "It's... huge!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "A last gasp. Its body is collapsing. He pushed himself too hard.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "Fall back. Don't be hasty.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "N-no... Mudrock already spent all his energy. These Arts...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "GreyThroat",
      "text": "That's Sarkaz... witchcraft?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "(I said...)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock Colossus",
      "text": "I said...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "This is way too dangerous. You're sharing your life with your own creation. It's not worth it just to subdue them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Fine. As you wish.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "(Shed your hate and strife. Live. This is your last chance to escape.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock Colossus",
      "text": "Leave this place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "(Those who still fight... only seek death for all.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock Colossus",
      "text": "So... come destroy me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Come defeat me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Wh-why...? Didn't he come to help us? Is he not Reunion?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "I... I don't care! Screw him!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "In the past... we helped you. That fire unsettled us all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "We joined you, we guided you, but not for the sake of their deaths. Only for the sake of our lives.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Now, sadly, it looks like we're not on the same side.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Killing innocent people, and Rhodes Island's warriors, that's not our way.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "And if we're dealing with a bunch of rioters who don't follow orders, why show mercy?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Us, the Sarkaz, the 'devils,' we're enough to take on anyone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "More than enough.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ayerscarpe",
      "text": "What happened? Everything got quiet as soon as that giant appeared.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Click",
      "text": "So uh, that mountain-sized monster is a kind of Originium Art?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ayerscarpe",
      "text": "Let's figure out how to get back to Folinic.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Gah! Damn it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Come on, let's go. This town is done for. We have to find a way over the Great Rift before winter sets in!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Abandon the town, Winterwisp clansmen, workers, and Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "There are other places to exact our revenge. Leave Wolumonde to its fate!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "There's no reason to fight the Sarkaz. Fall back.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Armed Infected",
      "text": "Let's go.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Mudrock, that's enough!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "——!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Phew... Haah... Haah...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "They stopped... That was crazy. Since when are we in the conflict mediation business?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Look at this town... We, brought chaos.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "It's not what we intended, but a rebellion is about self-interest, at its core. Not so many people come with high-minded ideals.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "You're right... So what do we do with our struggle...? With our deceased?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Loss and pain follow us everywhere.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Erm, just a second... I found a spare match.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "Hey, Gendarmerie, here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "......!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "Huh. Do Sarkaz warriors smoke?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Sarkaz Warrior",
      "text": "I already quit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Severin",
      "text": "How about that. Looks like everyone who quits still carries matches.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Cherish your life.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "And you, Rhodes Islanders...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Folinic",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "It's time... to say goodbye.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "Maybe... just maybe, you can find a way to help these people.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Mudrock",
      "text": "But none of that has anything to do with the Sarkaz anymore.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "To the sound of crumbling rock, the Sarkaz turn and leave.\nThe entire block is burning.\nThe mob is gone, having left only out of fear.\nThe last chunk tumbles to the ground."
    },
    {
      "type": "sceneBreak"
    }
  ]
}
