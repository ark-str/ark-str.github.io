{
  "server": "en",
  "storyId": "main_1_level_main_01-12_end",
  "groupId": "main_1",
  "stageId": "main_01-12",
  "title": "Pyrrhic Victory",
  "storyCode": "1-12",
  "avgTag": "After Operation",
