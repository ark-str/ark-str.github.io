{
  "server": "en",
  "storyId": "1stact_level_a001_02_beg",
  "groupId": "1stact",
  "stageId": "a001_02",
  "title": "Sophistication",
  "storyCode": "GT-2",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/a001/level_a001_02_beg.txt",
  "sourceHash": "f396a143163b1bf501d6b731770aa42296d8f25280f4aab05c9bacefb0de3ade",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Stop her!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Stop that monster? Look at how many people she's already taken out!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Why not? You're always going on about how strong you are!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "I-I can't do it! She's a walking Catastrophe, can't you see?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_263_skadi#1",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_263_skadi#1",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "(Ægirian) All that standeth before me shall perish."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_263_skadi#1",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "(Ægirian) All that beareth arms against me shall return to dust."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_263_skadi#1",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "(Ægirian) All that craveth death, step forth."
    },
    {
      "type": "dialogue",
      "speakerName": "'Captain'",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "What the hell are you mumbling about?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh? Captain? Where'd the captain go?"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "The captain fell into the river...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "She... she sent him flying with just a single blow..."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_263_skadi#1",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Ah, I forgot they can't understand me... Oh well."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_263_skadi#1",
      "operatorId": "char_263_skadi",
      "portraitKey": "char_263_skadi",
      "text": "Tell me, where is she?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "She? Who are you talking about? Don't ask me, I don't know anything!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gyaaah!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "You... you'll regret this!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey! Don't just start running! Pull the captain out of the river first!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "That person..."
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "speakerToken": "avg_npc_003",
      "operatorId": null,
      "portraitKey": null,
      "text": "Do you know her?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "She might be my coworker..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#4",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "But, wasn't I the one who was appointed to this job? It took me forever to pry this job from Meteorite too..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#4",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Hrmmm... Maybe she's here on another mission?"
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "speakerToken": "avg_npc_003",
      "operatorId": null,
      "portraitKey": null,
      "text": "Well, seems like the bounty hunters are retreating?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "It's now or never. This is our chance to get out of the village."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "If there are other operators coming to the village, we might even have the upper hand."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Carol, the staircase is really dark. You should hold on to me."
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "speakerToken": "avg_npc_003",
      "operatorId": null,
      "portraitKey": null,
      "text": "Um, will you stop to talk to her?"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Hmm, if possible, then I might—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yeeowwwwch—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Wooooahh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "My nose... my nose...! How'd this door spring open on its own..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Huh? Why is someone crouching here..."
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "speakerToken": "avg_npc_003",
      "operatorId": null,
      "portraitKey": null,
      "text": "Grani! What's going on—"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "Everyone, shut up! Shhhh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "...Shush?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yeah, you peasants couldn't possibly understand. Did you not see that walking Catastrophe?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "No bounty hunter would be stupid enough to face her head-on! The only people foolish enough to swagger up to her are those who haven't seen her level entire cities!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Wow, did she really! You mean she can do that all by herself—"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Quiet, don't let her hear us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "You know, I was hoping she'd notice me—"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "I said be quiet!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Fine, fine..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Somehow these stories about her that are going around are even more outrageous than the ones we hear at Rhodes Island..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "D-did that monster leave?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "I.. I think so...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_008",
      "operatorId": null,
      "portraitKey": null,
      "text": "Phew, she's finally gone... Nearly gave me a heart attack..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#3",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Y-yeah."
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "I thought just our team would be enough to handle this job, but how'd we get ourselves into this mess... How do we even deal with something like that—"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "—Wait a sec!"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#5",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "Oops."
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ahh! You're that kid with the spear! Fancy running into you here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "And the Chief's with you too! You delivered her right to us!"
    },
    {
      "type": "dialogue",
      "speakerName": "Carol",
      "speakerToken": "avg_npc_003",
      "operatorId": null,
      "portraitKey": null,
      "text": "Grani, don't tell me you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#1",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "No no, they just seemed to be so well-behaved, I let my guard down!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Cut the chatter, and hand the chief over to us! Otherwise, you're gonna be talking to the business end of this blade real soon!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Grani",
      "speakerToken": "char_220_grani#2",
      "operatorId": "char_220_grani",
      "portraitKey": "char_220_grani",
      "text": "You mean with that little knife?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "......Wh-when did that kid pull that spear out?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Send the signal and call the others!"
    },
    {
      "type": "dialogue",
      "speakerName": "Violent Bounty Hunter",
      "speakerToken": "avg_npc_007",
      "operatorId": null,
      "portraitKey": null,
      "text": "Also, go release the rest of those bugs that we used to destroy their crops. We'll show them what happens when they try to resist us!"
    },
    {
      "type": "sceneBreak"
    }
  ],
