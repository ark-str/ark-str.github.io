{
  "server": "en",
  "storyId": "story_totter_set_1_story_1",
  "groupId": "story_totter_set_1",
  "stageId": null,
  "title": "A Plan",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_totter_1_1.txt",
  "sourceHash": "7df32679136f3df6ad87d0297795a850a1d9c7b2a2ab6215b092ff028077624f",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Open the door, you lousy scammer!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Open the damn door!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I know you're there! Open this blasted door already!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Good morning, Mr. Haller. You shouldn't be so loud; it'll disturb the others, you know.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Grabs Totter by the collar)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Do you take me for a fool, you son of a bitch?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "You said you'd have it done by Friday! It's Friday, and all you've done is pack up and get ready to leave!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Patience, my friend. I'll explain afterwards.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Pulls away Haller's hand)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Explain? I don't need a goddamn explanation. I need results, you understand? I need the heads of those bastards on a platter, <i>now</i>.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Glances at watch) Just give me a little more time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "You said five days. I gave you five days. What now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "The plan is going well. You'll have your results soon enough.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Plan? What have you been doing the past four days?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "You drank coffee on Monday, played poker on Tuesday, went to the market on Wednesday, and slept through Thursday. Now it's Friday, and you haven't even moved your ass one inch from your room.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Glances at watch)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Stop looking at your goddamn watch!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "It’s not time yet.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "What? Are you telling me to calm down?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "...I guess so?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Easy for you to say, you son of a bitch! It wasn't you who lost everything to those bandits!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Oh, believe me, I could tell how little you had left by the amount you were offering.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "...Yeah, if I had any left over, you'd be worrying about your own head instead of anyone else's.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "My, and here I thought we had a good partnership going.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Slumps against the wall)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "I should've died along with my wife... At least then I wouldn't have to deal with this shit.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Would you like some hot water? I can get you a cup.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "You—forget it. Why should I talk to <i>you</i> about it? You don't know how I feel.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Not quite... I do know, to an extent.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Then do something. I'm begging you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Glances at watch)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Shakes head) *Sigh*...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "It's time. Would you like to come with me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "For what?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Blood for blood, just like you asked.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Here we are. Have you hidden your burdenbeast?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Yes... Wait, why are you the one giving the orders, when I'm the one hiring you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "My apologies, Mr. Haller. Would you like me to go tie it up again?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "No need. I'd rather you explained why you brought me all the way out here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Take these.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Binoculars?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Look over there.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "I don't see anything.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Further. There's a convoy coming towards us from the horizon, flying blood-red flags with black skulls on them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "I see it! It's them! It's them!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Draws crossbow)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "You don't need binoculars?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "No.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "But it's so far away.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Shh. Quiet.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Done.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "So quick?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Yeah... Unless there was something else?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "What?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I mean, I'm not too keen on desecrating corpses, but if you insist...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "You... you're sure there are no survivors?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "By the size of the explosion, I would say the odds are slim.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "They're dead. They're all dead. Good.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "You don't sound as happy as I expected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "I thought I would be, but... it all happened so quick. Almost like it wasn't real.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Now, maybe this isn't the best time to bring this up, but as for the other half...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Tosses out a bag of gold coins)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Take it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Picks up the bag)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Don't you have anything to say?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "...Thank you for your business?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Those eggheads spent a month trying to track that group down and came up empty-handed. How did you do it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "How did you know they would show up right here, right now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Actually...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Ach, let's talk someplace else. I need a stiff drink.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I wouldn't recommend drinking in your current state.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Ha... what would you know about it?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Apparently, the people in this town drink in the morning to celebrate the sunrise. I ordered two drinks. Which one do you want?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "They're not exactly the same size.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Yeah, the big one's mine.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Why did you ask me to choose, then?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "To be polite.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I'll take the small one then, thank you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Guzzles half the mug)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Argh—burp.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "So can you talk now? How did you do it? You didn't prepare anything the last few days. You just showed up there, pulled back your crossbow, and whoosh—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "They're gone.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "What the hell was that? Future sight? Did you bribe one of them?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Come on, tell me. I just don't understand. I was sure you were scamming me when I found you last night, but now...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Let's just say that if you wanted me to lick your boots, I'd get on my knees this instant.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "You're getting a little too excited.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "I've had something to drink.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "It wasn't so hard. It's all about having a good plan, and following it step by step.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Takes out a notebook)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "You complained that I spent all Monday in a cafe, but the cafe in this town plays an important role.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "It's sort of an information exchange for traders passing through.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "It's where all the news spreads, true or false.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Pepper Trader",
      "text": "Have you managed to get your spices out? I've tried other routes, but it seemed like they always knew where we were going.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Incense Trader",
      "text": "Still thinking about what to do. I might just throw my hands up and hire mercenaries to guard the goods. Better than letting it rot in the warehouse.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Pepper Trader",
      "text": "When is the lord ameer going to do something about this? I can't afford any more losses.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Coffee Shop Waiter",
      "text": "Hello, what can I get for you?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "A cup of coffee, please.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Coffee Shop Waiter",
      "text": "Our coffee is strong by most places' standards, so it comes with a plate of honey dates to balance out the bitterness.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Thank you. I like my coffee bitter anyway.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "By the way, could I ask where the town doctor lives?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Coffee Shop Waiter",
      "text": "The east side of town. Just head east along the fountain. Are you ill?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I have a batch of emergency medical supplies that I thought might come in useful for somebody.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Medicine, not money, is the most powerful currency in the barrenlands. Now that the cat was out of the bag, I had to prove I was worth the trip.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I think my luck's about to change.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Jewelry Trader",
      "text": "Time to cut your losses, buddy. Your wife isn't gonna like it when she finds out how much you've lost.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Eh, it's just some spare change. I play for the thrill.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Timber Trader",
      "text": "Ha, that's what we like to hear!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "One more round! Let's go!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I found footprints outside my window Wednesday morning, as expected. Someone tried to cover them up, but it was the work of an amateur.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Have you ever hunted, Mr. Haller?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Wild animals have their own territory, and they follow certain rules when they look for food or wander around in it. Understand their habits, and you'll know where to place your traps.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hawker A",
      "text": "Leaving so soon, sir?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Yes, I'm concerned about these bandits I keep hearing about. The sooner I can leave, the better.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Do you know of any other routes out of here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hawker A",
      "text": "To be honest with you, sir, it makes little difference whichever route you pick. They know every move you're about to make, and there's no way to avoid their ambushes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Have you all been attacked before, then?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trader B",
      "text": "My convoy tried leaving by a tiny trail to the east, but the bastards were laying in wait an hour out from town.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "That's terrifying. Has anyone managed to avoid them?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Trader B",
      "text": "We tried many different routes, big and small, but it makes no difference. You're doomed to run into them no matter what.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I identified where the bandits operated by comparing the convoy routes to the locations where they encountered the outlaws.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I found a few sniping vantage points, from which my crossbow could cover those areas.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "The final step was to lure my prey into the trap.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Hey, kid, wanna make some quick cash?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shrewd Boy",
      "text": "What do you want, sir?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I'm leaving town tomorrow. Get me ten days' worth of fresh water and dry rations, and have my burdenbeast fed before sunset. I'll be leaving before dawn.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Here are four gold coins for your trouble. I'll be waiting at the west entrance at 5 a.m. tomorrow.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shrewd Boy",
      "text": "Wow! You've got it, sir.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Now get going, and don't disturb me. I need to sleep before the trip.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Shrewd Boy",
      "text": "No problem, sir. I'll get it done!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Two gold coins would have been a fair price, but I paid him twice that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "A kid that age can't help but brag when he runs into a stroke of luck. And the more people he tells, the better.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "So you weren't sleeping yesterday?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "No, I slept. Needed to be in top form for what was to come.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Takes a gulp)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "So... that's what happened.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "You sound disappointed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Yeah... I thought I'd hear the breathtaking story of a legendary mercenary, but it ended up being more like one of my wife's business proposals: detailed, but boring.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "A good plan doesn't need twists and turns. The safer it is, the better.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "That's what she said, too! She even had a notebook with her at all times, just like you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "It's a good habit to have. People shouldn't trust their own memories. So what's she doing now?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "The bandits cut off her head... I told you that when I first came to you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "...Oh, right. Sorry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "It's okay. At least she doesn't have to worry about writing any more business proposals. She'd probably have been a poet, if I hadn't dragged her into my business.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Yes, poet is a good occupation. Safe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "To be totally frank with you, chatting with you makes me uncomfortable.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I get that a lot. I'm just grateful to those who are satisfied with merely saying so. Plenty more wouldn't leave it at that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "My brain tells me I should say something comforting, but my heart would never let me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Sorry.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Shakes head) Never mind.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Can I take a look at your notebook?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Sure.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Your writing is really big.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I have something of an eye problem. I can see things far away perfectly, but things that are up close, not so much.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Looks like you meticulously plan out everything in life.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Yes. Having a plan in place makes things less hectic when trouble comes up.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Closes the notebook)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Someone like you must have everything under control, with nothing ever going wrong or deviating from plan.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "I'm sure your life is smooth sailing. You'll never wake up one day only to find you've lost everything.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Guzzles the drink)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Rubs the mug nervously)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Not exactly...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Not exactly what?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "No, my life has hardly ever been in my control.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Takes a sip)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Poor thing.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Please don't say that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "I meant myself.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "(Finishes in a single gulp)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Alright, I've got to go... Hey, where's my money? Oh, right, I gave you everything I had left.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I'll pick up the tab.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Thanks.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Why don't you take these gold coins? You'll need them.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Nah, I won't. Keep them.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "You're drunk.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "Don't worry about it, I can stand on my own. Farewell, friend.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "♪I held her in my arms, before the day was gone♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "♪She smelled of jasmine, beneath the purple veil♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "♪Her soft lips take me away♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "♪To our eternal home far away♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Vengeful Merchant",
      "text": "♪A moment of pain, for a lifetime♪",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "The drunk merchant staggers towards the rising sun, the great red orb on the horizon swallowing up his silhouette. He does not turn back, as though he is headed for his beloved's burning embrace.\nThe dry winds of the desert cover his song in a thin layer of sand, to be preserved for the next traveler."
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "♪Louisa, Louisa in my heart♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "♪Take me home with you, and I'll want nothing more♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "♪Louisa, Louisa in my dreams♪",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Low Male Voice",
      "text": "I'm sorry, Totter, but we have to leave you here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Low Male Voice",
      "text": "We're headed north, and there's no way you can keep up with that injury.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "You'll just abandon me here?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Low Male Voice",
      "text": "This is near the Snow Realm. It's a beautiful place.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "But you're still abandoning me here, right?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Low Male Voice",
      "text": "I'll leave some money for you. There's a village nearby where you can buy necessities.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Stop dodging the question! Answer me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Low Male Voice",
      "text": "Totter, I...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Do you think the same, Ann?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Calm Female Voice",
      "text": "Don't be like that. You know we can't slow down for you. We have our missions to complete.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "So you're abandoning me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Calm Female Voice",
      "text": "You're not a child anymore. Throwing tantrums won't get you anywhere.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "This isn't what we agreed on, Ann.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Calm Female Voice",
      "text": "No one can predict the future, Totter... We might be back by next spring. Or things may have changed by then. Don't beat yourself up over it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Ha. So will you come back for me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Calm Female Voice",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "...I see.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Low Male Voice",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "♪Louisa, Louisa in my heart♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "♪Take me home with you, and I'll want nothing more♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "♪Louisa, Louisa in my dreams♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "♪I'll always be there...♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "♪...Waiting for you♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Finishes in a single gulp)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "The key. Where's the key?",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "Is it this one?\nNo, not this one."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "This one?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "No... forget it.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Sits down)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "...What time is it? Must be almost time. I'll wait outside.",
      "portraitKey": null
    },
    {
      "type": "narration",
      "text": "The eaves of the roof casts a shadow on the hot sands, shielding Totter from the scorching sun.\nTotter could not keep his eyelids open in the warm breeze.\nHe falls asleep, curled up against the door frame."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Totter! Totter! Wake up!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Hmnuh? ...Whoa! What is it?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I'm here to pick you up. Sorry about the delay; we ran into a sandstorm on the way. Hope we didn't keep you waiting?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Stands up and brushes the dirt off his pants) No, you came just in time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "But you had fallen asleep.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Just a nap. I had to go out earlier.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rhodes Island Operator",
      "text": "Er... why are you smiling?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "I'm smiling?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "(Touches the edges of his mouth)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Totter",
      "text": "Strange. Why am I smiling?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
