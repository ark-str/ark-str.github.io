  "groupId": "main_2",
  "stageId": "main_02-01",
  "title": "To Lungmen",
  "storyCode": "2-1",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_02-01_end.txt",
  "sourceHash": "f07cb57ca14f6e1a80ac69f45c4e95e283c3436bdd23b1c2808fcbae242d36c7",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十三关（后）\n10:14 P.M. \\ Clear \\ Visibility: 19 km\nLungmen, District 5- Inspection and Quarantine Zone"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Madam.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "They're here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "text": "Attention, please...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "text": "Due to the Catastrophe's interference, all air traffic in Lungmen has been stopped. All entrances to District 5 will be closed in two hours.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "text": "We thank you for your cooperation during Oripathy inspections.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "text": "If you discover any unregistered Infected, please inform a nearby peace officer immediately.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "text": "The L.G.D. will detain them in accordance with the 'Emergency Handling Act.'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "text": "Attention, please...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's just like the rumors said...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Let's go, Doctor.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We're here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Rhodes Island was scheduled to meet with the L.G.D. at 10 o'clock.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "It's 10:14 now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "You were late 14 minutes; therefore, you've wasted 14 minutes of my time.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...I'm sorry, Madam Ch'en, we just found out that Reunion is here...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "It's fine, I already know. But that's not important right now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...Who might this be?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Dr. {@nickname} is Rhodes Island's consultant. Dr. Kal'tsit should already have informed you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Hmm...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Well, since everyone is here, I'll now need you to follow me to...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "text": "Madam Ch'en! It's an emergency! Those Infected... they're not...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Don't panic!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "First Squad, standby! Snipers, get into position!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Civilian",
      "text": "Wh-what's happening?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "text": "Let go of me! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Tch... What's going on? Report the situation.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "text": "Let me go! ! Why are you arresting me? !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "text": "We didn't do anything wrong! ! !",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "text": "Some Infected... are refusing to be taken in... We're...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "I can see that...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Forget it.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Detain them all.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Disperse the crowd immediately. Open the gates in 30 minutes after you finish the review process.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Also, push the quarantine inspection line forward 40 meters.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Other than you and Dr. {@nickname}, the rest of Rhodes Island will stay here and assist with border security. The two of you, come with me.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "If your group can't handle such a trivial task, I will not be able to assign you any missions.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "PC94172, arrange some work for these people. I don't want to see any more trouble tonight.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "text": "Understood, Madam!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "text": "Everyone, I'd like you to...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "(Madam Ch'en is really tough... she's stricter than I imagined...)",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "... (Nod)",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "You two.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "Follow me.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "We're here.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Wh-what a tall building!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Ugh...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "S-sorry...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "... Rhodes Island is undoubtedly capable.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Oh...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Thank you for your praise, Madam.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "However...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "After the Chernobog incident, there's been a massive surge of refugees into Lungmen.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "The Infected should already know what the consequences of entering Lungmen are.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "I'll remind you once more.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Lungmen is the next Chernobog.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Dr. Kal'tsit...!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "Rhodes Island's representative has already met with Chief Wei.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "Please wait here.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "text": "I'll notify you shortly.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Phew... she's really hard to talk to.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Dr. {@nickname}, from here on, Dr. Kal'tsit will be handling the negotiations.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Please have confidence in her.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
