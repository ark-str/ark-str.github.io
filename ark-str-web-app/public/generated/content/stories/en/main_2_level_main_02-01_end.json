  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十三关（后）\n10:14 P.M. \\ Clear \\ Visibility: 19 km\nLungmen, District 5- Inspection and Quarantine Zone"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_015_lmg",
      "operatorId": "char_015_lmg",
      "portraitKey": "char_015_lmg",
      "text": "Madam."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_015_lmg",
      "operatorId": "char_015_lmg",
      "portraitKey": "char_015_lmg",
      "text": "They're here."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Attention, please..."
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Due to the Catastrophe's interference, all air traffic in Lungmen has been stopped. All entrances to District 5 will be closed in two hours."
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We thank you for your cooperation during Oripathy inspections."
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "If you discover any unregistered Infected, please inform a nearby peace officer immediately."
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "The L.G.D. will detain them in accordance with the 'Emergency Handling Act.'"
    },
    {
      "type": "dialogue",
      "speakerName": "Broadcast",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Attention, please..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "It's just like the rumors said..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Let's go, Doctor."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We're here."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Rhodes Island was scheduled to meet with the L.G.D. at 10 o'clock."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "It's 10:14 now."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": "char_010_chen_1#4",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "You were late 14 minutes; therefore, you've wasted 14 minutes of my time."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...I'm sorry, Madam Ch'en, we just found out that Reunion is here..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "It's fine, I already know. But that's not important right now."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "...Who might this be?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Dr. {@nickname} is Rhodes Island's consultant. Dr. Kal'tsit should already have informed you."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Hmm..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Well, since everyone is here, I'll now need you to follow me to..."
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "speakerToken": "char_015_lmg",
      "operatorId": "char_015_lmg",
      "portraitKey": "char_015_lmg",
      "text": "Madam Ch'en! It's an emergency! Those Infected... they're not..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1#4",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Don't panic!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1#4",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "First Squad, standby! Snipers, get into position!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Civilian",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wh-what's happening?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Let go of me! !"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Tch... What's going on? Report the situation."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Let me go! ! Why are you arresting me? !"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "We didn't do anything wrong! ! !"
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "speakerToken": "char_015_lmg",
      "operatorId": "char_015_lmg",
      "portraitKey": "char_015_lmg",
      "text": "Some Infected... are refusing to be taken in... We're..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "I can see that..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Forget it."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Detain them all."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Disperse the crowd immediately. Open the gates in 30 minutes after you finish the review process."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Also, push the quarantine inspection line forward 40 meters."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1#4",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "Other than you and Dr. {@nickname}, the rest of Rhodes Island will stay here and assist with border security. The two of you, come with me."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1#4",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "If your group can't handle such a trivial task, I will not be able to assign you any missions."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1#4",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "PC94172, arrange some work for these people. I don't want to see any more trouble tonight."
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "speakerToken": "char_015_lmg",
      "operatorId": "char_015_lmg",
      "portraitKey": "char_015_lmg",
      "text": "Understood, Madam!"
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "speakerToken": "char_015_lmg",
      "operatorId": "char_015_lmg",
      "portraitKey": "char_015_lmg",
      "text": "Everyone, I'd like you to..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#5",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#5",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "(Madam Ch'en is really tough... she's stricter than I imagined...)"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "... (Nod)",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1#4",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "You two."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1#4",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "Follow me."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "We're here."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Wh-what a tall building!"
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#6",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Ugh..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#5",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "S-sorry..."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "... Rhodes Island is undoubtedly capable."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#2",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Oh..."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#2",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Thank you for your praise, Madam."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "However..."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "After the Chernobog incident, there's been a massive surge of refugees into Lungmen."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "The Infected should already know what the consequences of entering Lungmen are."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "I'll remind you once more."
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "speakerToken": null,
          "operatorId": null,
          "portraitKey": null,
          "text": "Lungmen is the next Chernobog."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#2",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Dr. Kal'tsit...!"
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "Rhodes Island's representative has already met with Chief Wei."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "Please wait here."
        },
        {
          "type": "dialogue",
          "speakerName": "Ch'en",
          "speakerToken": "char_010_chen_1",
          "operatorId": "char_010_chen",
          "portraitKey": "char_010_chen",
          "text": "I'll notify you shortly."
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#4",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Phew... she's really hard to talk to."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#2",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Dr. {@nickname}, from here on, Dr. Kal'tsit will be handling the negotiations."
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "speakerToken": "char_002_amiya_1#2",
          "operatorId": "char_002_amiya",
          "portraitKey": "char_002_amiya",
          "text": "Please have confidence in her."
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ],
