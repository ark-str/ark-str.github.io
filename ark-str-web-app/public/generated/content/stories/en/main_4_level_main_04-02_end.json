  "stageId": "main_04-02",
  "title": "A Walk in the Rain",
  "storyCode": "4-2",
  "avgTag": "After Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_04-02_end.txt",
