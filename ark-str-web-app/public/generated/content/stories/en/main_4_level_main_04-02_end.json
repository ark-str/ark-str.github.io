  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ahh...! Look out!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Ouch!"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "S-sorry, I didn't mean to run into you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Don't worry about it. You're very polite."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ehehe..."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Um, ma'am, what are you doing here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's still raining. You're not going to go inside?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Ah, um... I'm just... taking a walk."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Are you looking for help?"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh! How'd you know?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I can't tell you~ It's a secret."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Aw... it's fine though!"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ma'am, do you think..."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm... that probably won't work. You're a bit too short..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Hey, you shouldn't say stuff like that! You're shorter than me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Whoa!"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "W-well, we could try... Um, could you help me move that board? Let's do it together!"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "There's a record player under that metal rack. I want to take it back home."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Sure."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "1... 2... 3! Together!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "We did it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Woah, you're really strong, ma'am! Thank you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "But... this record player is broken."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's okay! It's always been broken."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But one day, I'll be able to fix it. I collected a lot of records, but I've never listened to them before..."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...But one day, I'll play them for everyone!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...Such a difficult thing, said so casually..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...What am I doing this for... What can I even do..."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ma'am, you're not scared of me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...Scared of what?"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm an Infected!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#2",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Haha... I am too."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What?! That's such a pity. You're so pretty, too...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#3",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "There's nothing wrong with being an Infected. Whether you are healthy or infected..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#3",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "If you're a good person, that will never change."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh...? I don't get it..."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "(Grrrrrr...)"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...Are you hungry?"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...Mmhm..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...Here, take this. It's all I have."
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wow! Thank you, ma'am!"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But... why did you come here?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "It's because..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#10",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "It's because I made a promise to someone."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Bye bye, ma'am!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#3",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Sure, bye bye!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Even a child like that... In the end, will just..."
    },
    {
      "type": "narration",
      "text": "Those who were robbed of their identity. The Infected. You've long lost the right to call yourselves people."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "What can I accomplish? What more... can I do...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Why... can I not protect those around me..."
    },
    {
      "type": "narration",
      "text": "You cannot."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No... I..."
    },
    {
      "type": "narration",
      "text": "Famine... Persecution... Death...\nThese are the only things awaiting the Infected."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No, that's not true..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "As long as Rhodes Island is fighting for the Infected..."
    },
    {
      "type": "narration",
      "text": "You are but one of the few lucky ones."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No... We've all come together to fight towards a common goal."
    },
    {
      "type": "narration",
      "text": "This world has already become cold and callous."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No, not yet..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "The Infected can't succumb to despair just yet..."
    },
    {
      "type": "narration",
      "text": "You.\nAllow the rage to consume you.\nOnly then..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No... I won't..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I made a promise..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#4",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I made a promise to her...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Who's that...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "A big sister once told me that these dolls won't work unless you make them yourself."
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "So that's why I'm giving this to you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Another Girl's Voice",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "That voice just now...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "That silhouette..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Is that Madam Ch'en?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "------"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "------------"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "------!"
    },
    {
      "type": "dialogue",
      "speakerName": "Another Girl's Voice",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Madam Ch'en..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerToken": "char_010_chen_1",
      "operatorId": "char_010_chen",
      "portraitKey": "char_010_chen",
      "text": "... ..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
