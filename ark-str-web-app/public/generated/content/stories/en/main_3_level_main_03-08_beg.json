  "stageId": "main_03-08",
  "title": "Dusk",
  "storyCode": "3-8",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_03-08_beg.txt",
