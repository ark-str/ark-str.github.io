  "sourceHash": "7f537ea0ea48255e59b43400cfe1fe58321f7f42141e741bceb74045eb7cee31",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_140#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Stay away! Get back!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_143#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It—it bit off my hand—ha, haha—why can't I feel any pain at all, why—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaa!"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Eek—stay away!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#2",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "Are you okay?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Why did you only just come?! Why did nobody sound the bell?! Where'd the vigilant monk go?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You know we trusted you, so we did what you said! Why! Why did my husband have to die?! How can you make up for that?! How?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#4",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "We'll talk when we're safe."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Waaahhh—mama, mama! Give my mama back!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaa!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#4",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Whoa, there! Even less close for comfort!"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "M-Mister, mama, mama—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaa!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#5",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Let's ignore this fellow for now! There seems be something disastrous afoot outside! Young lady, hold on tight, we're going to slip out of here!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaa—! Gkhaa!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Another one?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#5",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "I can't—I can't deal with this!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaa—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#5",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "Where the hell did they all come from?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#5",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "Damnit, there's no way I can hold back this many—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh...?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#4",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "Though they may figures in a painting, there is no need to slaughter them all... observing such a scene only serves to inspire outbursts of sorrow."
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#4",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "Lava, I am here to watch this place. Thou would best hurry to take others to refuge."
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#4",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "You..."
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#4",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "Worry not for me. I have traveled many times here. I have had all manner of thought on the future, anxieties indeterminate—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#5",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "—but for that in front of me, I have never been one moment nor fraction irresolute."
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#5",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "Leave this to me."
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#1",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "Alright. Keep going east. When you're done, find me and we'll converge."
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#5",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "Understood!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaa!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#6",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "I am here! None shall come forward!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#6",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "Those who pass this line—shall be cut down."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Waaahhh—"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ow, ow! My dear young lady! Might you be able to stop pulling on my hair!"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Mamaaa—mamaaaa—"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaa!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#5",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "These cretins only keep gkh-gkh-gkhing! How can things so bent on chasing you not spit out a human word or two?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "...DON'T... RUN..."
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Good heavens, I was only joking! You need not! You absolutely need not—!"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "*whimper* Mister, l—look in front!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Eh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yaaagh!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "A—Are you that fortune-teller...? Where are the other two heroes?"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Behind you, behind you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaa!"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Why did you bring it over here!? Think of something—think of something!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "What can I possibly think of?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Lead them away from here, away!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "I... I'm..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Little Girl",
      "speakerToken": "avg_npc_142#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "*whimper* Waaahhhh, mama, mama—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#1",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh, just stop crying! Stop! Stop crying, girl!"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Agh! Those things are looking at us! Get out of here, get out of—"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhaaaaaagh!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Y-You used your fan?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#5",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Hide yourselves further away."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhao? Gkhaa—"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "narration",
      "text": "]"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "In one move...?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "avg_npc_143#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ao!?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#2",
      "operatorId": null,
      "portraitKey": null,
      "text": "A-Amazing..."
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#5",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Ow-Owie, it hurts so much, it hurts so much—just what are these things, and how can they look so soft, yet be so hard when striking them?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Oh, stop goggling at me. The proverb puts it well; even a cornered burdenbeast will bite. Here, we'd best just hurry on our way!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ink Spirit",
      "speakerToken": "char_empty",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gkhao..."
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Man alive, Nothing, your kickboxing work's not bad, but you've never done a rescue business like this, eh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Deal with the enemies in front of you without checking movement on your whole perimeter, and sooner or later you'll give yourself grief."
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Ah, ahahah... that was quite dangerous just now! My apologies for the grief I gave you, benefactor. Only thanks to you am I safe and sound."
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright, quick, go and get everyone left into shelter."
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1#3",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "Er, what about you, benefactor?"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Me? Don't you mind, I walk light as a feather. They won't ever notice me."
    },
    {
      "type": "dialogue",
      "speakerName": "Mr. Nothing",
      "speakerToken": "char_455_nothing_1",
      "operatorId": "char_455_nothing",
      "portraitKey": "char_455_nothing",
      "text": "(Can the single skill of light-footedness really explain that?!)"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And then... how do we cut down these Ink Spirit numbers fast...?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Villager",
      "speakerToken": "avg_npc_141#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Eyaah! Wh—what's that fire in the garden?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#3",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "Hoo! This blaze soaring skyward makes quite a spectacle!"
    },
    {
      "type": "dialogue",
      "speakerName": "Saga",
      "speakerToken": "char_362_Saga#3",
      "operatorId": "char_362_Saga",
      "portraitKey": "char_362_Saga",
      "text": "Ho? Could it be that the name 'Lava' held this exact meaning?"
    },
    {
