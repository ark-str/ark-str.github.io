    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#1",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "Confirm the extent of all enemy scatter in the vicinity for me."
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#3",
      "operatorId": null,
      "portraitKey": null,
      "text": "This big of an arena?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#1",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "I'm worried about the surrounding buildings getting caught up, so I've been sort of keeping my Arts tied down..."
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#1",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "...but there's just too many enemies. If we keep dragging this out, I'm concerned casualties are going to end up tough to estimate."
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Roger. Special times, special methods, right."
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll find a high vantage point. You focus on casting."
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll help you sort all the ones outside your Arts range. I guarantee I'm not gonna miss a single one."
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#1",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "Good."
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#1",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "I'll submit the mission report afterwards... after all, it's not just the Infected that Rhodes Island helps."
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "Infected...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Lava",
      "speakerToken": "char_1011_purgatory_1#1",
      "operatorId": "char_1011_purgatory",
      "portraitKey": "char_1011_purgatory",
      "text": "What's up?"
    },
    {
      "type": "dialogue",
      "speakerName": "Kroos",
      "speakerToken": "avg_npc_144#5",
      "operatorId": null,
      "portraitKey": null,
      "text": "Huh... nothing, actually. By the way, Lava."
