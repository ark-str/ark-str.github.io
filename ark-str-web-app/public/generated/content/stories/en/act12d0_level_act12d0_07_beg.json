  "stageId": "act12d0_07",
  "title": "First Come First Served",
  "storyCode": "RI-7",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act12d0/level_act12d0_07_beg.txt",
  "sourceHash": "b9fb210ae0e030cc8b52e1ed38ba48f85e78e7668bbe5c1d6bb712a98ff5b08c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wahhhhhhh!!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Tch, another failure. He's flying in a nice arc this time though."
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria B",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Where did he land?"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "No idea. He'll come running back after a while anyway. Let's keep going."
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Okay, what does this tube connect to——"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Haha, this looks like a good port, I'm plugging it in!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, is it working?"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria B",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "No. Do you even know what you're doing?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "What are you yelling for? I've never seen an engine like this before, just let me experiment a bit!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria B",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "I want to try!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria B",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "I think this tube goes here. What does this button do then? Who cares, just press it."
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "You're the one who's messing around! It obviously goes here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria C",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "What are you two idiots doing? The gas pipe isn't even connected. Let me do it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria C",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm, what does the gas pipe go to... Never mind, this port looks bigger, this is probably it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria C",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, somebody try to start it!"
    },
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": "avg_npc_074",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm back!"
    },
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": "avg_npc_074",
      "operatorId": null,
      "portraitKey": null,
      "text": "Youngsters nowadays really have no respect for their elders. No one bothered to look for me after I got blasted away!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "But, High Priest, you always come back safe. Everyone's gotten used to it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria B",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Stop wasting time, let's get on with the testing!"
    },
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": "avg_npc_074",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yeah, yeah, alright."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "The Big, Ugly Thing",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "————!"
    },
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": "avg_npc_074",
      "operatorId": null,
      "portraitKey": null,
      "text": "Big Ugly, my child, it's time to wake up!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ohh! Great Chief, it's moving!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria B",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "This wonderful engine sound! I've never heard anything so amazing!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria C",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Haha, told you I'd get it done!"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1#6",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "How did you do it?"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Just as you saw, Great Chief, it moved just like that!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria B",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "We plugged this tube here and that one there!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria C",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "Just like how we built the Big Ugly!"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "Good."
    },
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": "avg_npc_074",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ahh, the Big Ugly, once but a pile of scrap metal, is now truly majestic. I'm so moved. It makes me want to sing!"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "But you're bad at singing."
    },
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": "avg_npc_074",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm sorry?! Fine. I think I have a real talent for singing though... Terrible!"
    },
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": "avg_npc_074",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh? Maybe it's a style problem."
    },
    {
      "type": "dialogue",
      "speakerName": "High Priest",
      "speakerToken": "avg_npc_074",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, that's right. That has to be the reason. Next time, I'll try singing in bel canto!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "Great Chief, someone broke in!"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1#2",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "Is it Gavial? I..."
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria",
      "speakerToken": "avg_npc_073",
      "operatorId": null,
      "portraitKey": null,
      "text": "No! It's a weirdo carrying a pile of weapons!"
    },
    {
      "type": "dialogue",
      "speakerName": "Eunectes",
      "speakerToken": "char_416_zumama_1#6",
      "operatorId": "char_416_zumama",
      "portraitKey": "char_416_zumama",
      "text": "What?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "speakerToken": "char_411_tomimi_1",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "Zumama's tribe should be right ahead."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#2",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Damn, look what she's done to her own tribe."
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "speakerToken": "char_017_homura_summer",
      "operatorId": "char_017_homura",
      "portraitKey": "char_017_homura",
      "text": "It looks pretty cool!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "speakerToken": "char_411_tomimi_1#2",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "Eh? It seems pretty lively inside."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#2",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Huh? Why are they fighting?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ceobe",
      "speakerToken": "char_2013_cerber_1",
      "operatorId": "char_2013_cerber",
      "portraitKey": "char_2013_cerber",
      "text": "Damn Reunion, you're trying to steal Kay's name now! That's something even more precious than honey biscuits! You'll pay for this!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria A",
      "speakerToken": "avg_npc_071",
      "operatorId": null,
      "portraitKey": null,
      "text": "Gaaaaaaaah!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria B",
      "speakerToken": "avg_npc_070",
      "operatorId": null,
      "portraitKey": null,
      "text": "Where did this weirdo come from? She's too strong!"
    },
    {
      "type": "dialogue",
      "speakerName": "Archosauria C",
      "speakerToken": "avg_npc_072",
      "operatorId": null,
      "portraitKey": null,
      "text": "I can't understand what she's saying. What the hell's a Reunion?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Utage",
      "speakerToken": "char_337_utage_summer_1",
      "operatorId": "char_337_utage",
      "portraitKey": "char_337_utage",
      "text": "Eh, isn't that Kay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "speakerToken": "char_411_tomimi_1",
      "operatorId": "char_411_tomimi",
      "portraitKey": "char_411_tomimi",
      "text": "Yes."
    },
    {
      "type": "dialogue",
      "speakerName": "Blaze",
      "speakerToken": "char_017_homura_summer",
      "operatorId": "char_017_homura",
      "portraitKey": "char_017_homura",
      "text": "Sounds like Kay's making a ruckus in there."
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "speakerToken": "char_187_ccheal_1#3",
      "operatorId": "char_187_ccheal",
      "portraitKey": "char_187_ccheal",
      "text": "Let's calm her down first!"
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Kay, stop!",
          "value": "1",
          "blocks": []
        },
        {
          "label": "......",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Get 'em, Kay!",
          "value": "3",
