    {
      "type": "dialogue",
      "speakerName": "Old Man",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You wretch!!! If I die here... Curse you!!! Curse you!!! My Emperor, I beseech you, lay down your divine punishment on these wretched Infected!!"
