{
  "server": "en",
  "storyId": "story_rope_set_1_story_1",
  "groupId": "story_rope_set_1",
  "stageId": null,
  "title": "Floral Perfume",
  "storyCode": null,
  "avgTag": "Interlude",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/memory/story_rope_1_1.txt",
  "sourceHash": "eb36f15cee67f2ac82f39cc32aabacf3ad8f5709c716c801921c3fea592d990c",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "10:30 A.M. \\ Clear\nRhodes Island Landship, Cabin 4, Convalescent Garden"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "'Scuse me~",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "......?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "'Scuse meee, anyone in—",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Hmmm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Aw, man.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Nobody in? Morniiiing—Mooorniiiing—Just checkiiiiing—Anyone iiiiiiiin—! Halllll—looooooo—?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Huh, actually deserted.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "That's sucky.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Wasting my time somewhere empty-handed ain't my style. Hm-hmm, I'm here after all. Let's let your li'l Peter Pan of Lungmen, Rope, take a look, see what nice stuff's lying around...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "...Wait, no!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "(Claps face)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Stoppit, stoppit, Rope. Pull it in. You can't do that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "(Claps face) (Claps face)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Ugh, what a scary habit to have.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "But you can't leave the door unlocked when no-one's in. That's just too sloppy. You can't blame anyone else when you lose something, okay?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "I swear I won't take anything. Just looking, looking...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Just lemme looksie, scope what's good around here~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Hm? What's on the ground here... iunno. Who cares? Let's jump it!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Hohoh, these flowers are real pretty with their colors. Dunno if they're worth anything...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Oh, this ain't equipment you see everyday. Probably pretty expensive, huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "And over this way's... herbs?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Hm? Hmm?? Whoooa, what IS this smell? This is pungent!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "I'm, I'm getting a little dizzy...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Pteh—haah, close call!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Oh, crap, I thought I was about to faint. That was way too risky...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "'Better to jimmy open a Lungmen treasury box than charge an open door.' No wonder a mentor once said that. Kinda makes sense now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "......",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Heh, okay, the joke ends here.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "If nobody's in, then I'm all hands tied. Wanted to do a little good for once, too. Whatevs.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "I guess I'll just come next time—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "What, I'm not the only one on the down-low?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Hehey, now this is getting interesting. Wherever you came from, li'l dodger, let's have a duel~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Pitter patter, sneakity skatter... position scoped, hook ready—",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Morning dew, peppermint, shaved ice showers♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Setting sun, jasmine, honey flowers♪",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Uh...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Hm-hmm~, hmm~, hm-hmm hm-hmm~~",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Uh, esscuse me...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "And add just a little culture. Hmm, that should be a good amount!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "No, c'mon, you're way too focused.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "And then mix it with the deep soil here. Oh, or perhaps add a little bit more plant ash?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Mhmm, this should do it just nicely!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "(Has she literally not noticed me? You need to keep your wits about you, y'know?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "(And here I thought some thief actually got in. Eugh.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Hmm... the balance still seems a little off. Last time's cultivar had balance issues too. Phew, let me think, what should I do...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Peat, akadama... maintain weak acidity...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "(Still talking to herself. Is this, like, an okay situation?)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "(Oh, but watching from the side is pretty fun~)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "That's right, how could I forget! I can try adding in some sandy soil brought from where it grew!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Mhmm, no matter plants or people, they're all best at home!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "(Kind of makes sense to hear.)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "(But y'know the sort who really work to flee the nest? Never wanna go back, those people? Uh, people? Plants? Whatever, same thing. There's plenty of them, right?)",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Oh, now where did I put that soil again...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Not here, and not here. Hmm... how strange...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Hm?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Wha-wha-wha?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "Huh? Huh??",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rope",
      "text": "What-what's wrong? What's up?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Eh? Ah...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Perfumer",
      "text": "Miss... Rope?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
