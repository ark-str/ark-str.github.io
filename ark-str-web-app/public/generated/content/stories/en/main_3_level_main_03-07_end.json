  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十九关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Don't let them get through!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "W should have escaped with Misha...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "We can't let!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerId": "char_136_hsguma",
      "text": "Out of my way! Do you have a death wish?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Uaaagh!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "O-ohhh... That savage fighting style reminds me of someone from Rhodes Island."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "They do have a lot in common, don't they?"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "text": "Franka, don't just stand there!"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "text": "Hurry up and do something!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "Sure, sure."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "text": "Hah, looks like all those legends about Lungmen's Inspector are true..."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "Stay focused."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "text": "Hey, I'm not just..."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "text": "...Staring at other people! *Bang!*"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Caster",
      "speakerId": null,
      "text": "Argh!"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "text": "See those enemy squads on the second floor? I found 'em first!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "Good job."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "text": "Hehe."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "...Let's go."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "text": "We can't let our client handle this alone."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Franka, have you found Misha?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "I can't find her anywhere."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "W probably... already took her away..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "text": "Tsk... Don't you think that was a bit too fast..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "What was that... an explosion?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Franka, gather your squad. We have to back up the L.G.D.!"
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "speakerId": "char_015_lmg",
      "text": "Rhodes Island, watch out!"
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "speakerId": "char_015_lmg",
      "text": "Th-this enemy..."
    },
    {
      "type": "dialogue",
      "speakerName": "L.G.D. Agent",
      "speakerId": "char_015_lmg",
      "text": "They..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "What happened...? Talk to me!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "The enemy..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "...What? !"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "That's...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "H-how is that possible...?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "...What?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "Tsk... Is this some kind of trick?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "It's a miracle! It's a miracle!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Why...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "Don't just stand there! Take cover!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "We've been sent a miracle!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Is that you...? It's really you!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "...He's fine!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "H-he's fine again!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Skullshatterer is still alive!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Skullshatterer! It's really you!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": null,
      "text": "Hooray! !"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "...Could it be..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "...No..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "Reunion's morale has been boosted since the reappearance of their leader."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "It'll be more difficult to suppress them now."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "...Skullshatterer, things are looking dire."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "But at least... you've come back to us."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "I'm so relieved... I'm so, so glad..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "Misha should have made it out of here as well."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "Now, we can fight without any regrets!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "...I will stay here and hold them back."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "You should all go."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "I'll protect you all..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "What are you talking about, Skullshatterer..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "text": "Didn't you promise that'd we go back to Ursus together? We still have to teach them a lesson!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerId": "char_1500_skulsr",
      "text": "Take care of yourselves. Don't die."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "No... Impossible..."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "Hurry up and move it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "Hoshiguma, contact the L.G.D. forces stationed outside immediately!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "We've neutralized most of the traps and ambushes. The enemy leader, W, and the target are still missing."
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "Right now, we're changing the mission objectives!"
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "speakerId": "char_010_chen",
      "text": "All squads, move in and take out Reunion!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "Why..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "...Why is this happening..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "text": "No..."
    },
    {
      "type": "sceneBreak"
    }
  ],
