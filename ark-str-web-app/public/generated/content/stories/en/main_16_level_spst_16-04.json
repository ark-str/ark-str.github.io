  "blocks": [
    {
      "type": "narration",
      "text": "<p=1>Far North Border, Ursus</>"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Urgh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I can't... run... anymore..."
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "This is it..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Distant Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Is someone there?"
    },
    {
      "type": "dialogue",
      "speakerName": "Distant Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll take a look—"
    },
    {
      "type": "dialogue",
      "speakerName": "Distant Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "No, please let me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Distant Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I can sense that it's only a poor soul who has suffered much."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Exhausted, dehydrated, starved..."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're Infected too."
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*cough* *cough*!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "He's one of us, comrades!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Please, save him, just as you saved all of us—"
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Perform your miracle!"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's not a miracle..."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Oripathy is not the main reason for his pain. I can only stop his illness from tormenting him, but I cannot give him food, clean water, or a safe place to sleep."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I can't perform miracles. I'm not all-powerful. I simply... believe."
    },
    {
      "type": "dialogue",
      "speakerName": "Pious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're always so humble. We understand."
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...Can you hear me, sir?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll hold your hand..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "'Believe. Believe in our life.'"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "'Believe in our body and mind, believe every beat of our heart, believe every inhale and exhale.'"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "'Believe that we are the source of all strength.'"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "No longer will you live in fear of death."
    },
    {
      "type": "narration",
      "text": "The pain brought about by the rapid growth of Originium in his body begin to fade.\nHe can still hear the voices, but he is no longer writhing in pain."
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Wh-Who are you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You saved me..."
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*cough* *cough*—"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What can I do to repay you?"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You can call me Hierda, like everyone else here."
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "A miracle—"
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hierda has once again saved our comrade!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "She saved all of us! With her motherly caress, she takes away our pain!"
    },
    {
      "type": "dialogue",
      "speakerName": "Anxious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hierda!"
    },
    {
      "type": "dialogue",
      "speakerName": "Pious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hierda."
    },
    {
      "type": "dialogue",
      "speakerName": "Many Voices",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hierda!"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hierda... Hierda."
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, that is my name."
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "What do you look like? I can't see you clearly, or any of the others..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Your head is wounded. Did you fall and hurt yourself?"
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe a mild brain hemorrhage is affecting your vision. Don't worry, we can help you walk..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Where are you going?"
    },
    {
      "type": "dialogue",
      "speakerName": "Infected Miner",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't know..."
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Then come with us, for now."
    },
    {
      "type": "dialogue",
      "speakerName": "Pious Voice",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're taking us to a place without pain, right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, as long as you're willing to come with me..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Hierda",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "As long as we believe."
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
