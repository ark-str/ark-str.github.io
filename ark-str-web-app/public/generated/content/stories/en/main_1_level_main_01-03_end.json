      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "Chaaaarge—!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "—Who's there?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "Tsk, where are you looking? Take this!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerToken": "char_1002_nsabr_2",
      "operatorId": "char_1002_nsabr",
      "portraitKey": "char_1002_nsabr",
      "text": "Gah!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "Phew..."
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "speakerToken": "char_013_riop",
      "operatorId": "char_013_riop",
      "portraitKey": "char_013_riop",
      "text": "Reunion's forces are regrouping behind us... they're getting ready to attack!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "They can't keep pace with us! Keep charging!"
    },
    {
      "type": "dialogue",
      "speakerName": "Dobermann",
      "speakerToken": "char_130_doberm_ex",
      "operatorId": "char_130_doberm",
      "portraitKey": "char_130_doberm",
      "text": "We're almost out of Reunion-controlled territory! Don't stop moving!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "These trifling thugs..."
    },
    {
      "type": "dialogue",
      "speakerName": "Nearl",
      "speakerToken": "char_148_nearl_1#3",
      "operatorId": "char_148_nearl",
      "portraitKey": "char_148_nearl",
      "text": "...Can't hope to stop us!"
    },
