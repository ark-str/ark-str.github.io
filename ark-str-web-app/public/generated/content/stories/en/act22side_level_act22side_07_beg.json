    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Moran",
      "speakerToken": "avg_npc_728_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Selmon, are we somewhere safe now?"
    },
    {
      "type": "dialogue",
      "speakerName": "Moran",
      "speakerToken": "avg_npc_728_1#4$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm not afraid of bad news... Tell me."
