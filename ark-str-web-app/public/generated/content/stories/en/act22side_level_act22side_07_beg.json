      "type": "dialogue",
      "speakerName": "Bagpipe",
      "speakerToken": "avg_222_bpipe_1#1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No, see, sure, missions end good or bad, but right or wrong? That's hard to judge."
