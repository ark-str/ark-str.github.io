      "speakerName": "Selmon",
      "speakerToken": "avg_npc_724_1#8$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hah, rotten shame you don't get to see proper. It's the fire from Reed's Arts, no doubt about it."
