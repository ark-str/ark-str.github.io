  "stageId": "main_01-06",
  "title": "Catastrophe",
  "storyCode": "1-6",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_01-06_beg.txt",
