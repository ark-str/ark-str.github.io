  "blocks": [
    {
      "type": "narration",
      "text": "第二十六关（后）"
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "char_107_liskam_1",
      "operatorId": "char_107_liskam",
      "portraitKey": "char_107_liskam",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "char_107_liskam_1",
      "operatorId": "char_107_liskam",
      "portraitKey": "char_107_liskam",
      "text": "What the hell..."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerToken": "char_107_liskam_1",
      "operatorId": "char_107_liskam",
      "portraitKey": "char_107_liskam",
      "text": "All that, for only a single Reunion squad..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "And a really big guy."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "Now that was the highlight. I'm totally exhausted just from dealing with him!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Impossible."
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "How could so many Infected vanish so quickly?"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Was that giant guy just a diversion?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#6",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "Did Reunion manage to completely evacuate this area in such a short period of time?"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No... Madam Ch'en should have blocked off their escape route..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "I'm not seeing the designated waypoint."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "Something... isn't right about this."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "Weeds, ruins, sand dunes..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "All of which are potential spots for an ambush..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "But, I'm not seeing anything."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "No footsteps, no sounds of clothing brushing against plants, no smell of explosives..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "I can't tell what's going on!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "Penguin Logistics, wake up and do your job!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_106_franka_1",
      "operatorId": "char_106_franka",
      "portraitKey": "char_106_franka",
      "text": "This isn't right at all!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Hush!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "What's that sound...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "... ... ... Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "It's from... underground?!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "Amiya! The noise is coming from underground!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#7",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "!!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "Doctor!! Get down, now!!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "These guys... will really stop at nothing!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "...?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "How... did you block that?"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_136_hsguma",
      "operatorId": "char_136_hsguma",
      "portraitKey": "char_136_hsguma",
      "text": "My 'Hannya' is not something you can penetrate."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "We'll see... about that..."
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "The temperature is rising sharply! !"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "Is he trying to detonate his staff?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "Doctor! Run away! At that distance, you'll--"
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "You'll---"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": "char_1500_skulsr",
      "operatorId": "char_1500_skulsr",
      "portraitKey": "char_1500_skulsr",
      "text": "It's over!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#8",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "No... Noooo---!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#8",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "You can't-----"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#8",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "I won't let you hurt Doctor------! !"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": "char_002_amiya_1#8",
      "operatorId": "char_002_amiya",
      "portraitKey": "char_002_amiya",
      "text": "...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*cough* *cough*..."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You are powerful..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "But... look at you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You're so strong."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "*cough*... It hurts..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Even though you have this kind of power..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "You still... in cold blood... watch your fellow Infected..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I can't... forgive..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I can't forgive those like you..."
    },
    {
      "type": "dialogue",
      "speakerName": "Skullshatterer",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Ugh..."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerToken": "char_012_misa_1#2",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "... ..."
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "speakerToken": "char_012_misa_1#2",
      "operatorId": "char_012_misa",
      "portraitKey": "char_012_misa",
      "text": "No... Don't...!"
    },
    {
      "type": "sceneBreak"
    }
  ],
