{
  "server": "en",
  "storyId": "act16side_level_act16side_08_beg",
  "groupId": "act16side",
  "stageId": "act16side_08",
  "title": "Shadow and Ash",
  "storyCode": "GA-8",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act16side/level_act16side_08_beg.txt",
  "sourceHash": "1fd97e0d5a119a55c9140981f86fe0767ba5880ef1b256568bf4f528864101f9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Sigh..."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Forget it, I'll pay for it myself. The repairs here cost too much."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "We'll just have to cut back on the afternoon tea and sweets."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Apostolic Knight",
      "speakerToken": "avg_npc_358_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Your Holiness! I heard the sound of fighting coming from the Basilica! Are you alright?"
    },
    {
      "type": "dialogue",
      "speakerName": "Apostolic Knight",
      "speakerToken": "avg_npc_358_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What... You were attacked by heretics?! I'm sorry! I failed in my duties!"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Fret not, Paolario. Did you forget who won the Basilica's last arm wrestling tournament?"
    },
    {
      "type": "dialogue",
      "speakerName": "Apostolic Knight",
      "speakerToken": "avg_npc_358_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You did."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I was just exercising my wrist a bit, and ended up causing a bit of an accident."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The unrest within the city has already subsided."
    },
    {
      "type": "dialogue",
      "speakerName": "Apostolic Knight",
      "speakerToken": "avg_npc_358_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Yes, they've dispersed. I didn't even get a chance to grill––"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Excuse me, can I come in?"
    },
    {
      "type": "dialogue",
      "speakerName": "Apostolic Knight",
      "speakerToken": "avg_npc_358_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ahem, my apologies. Your Holiness, I'm making a fool of myself."
    },
    {
      "type": "dialogue",
      "speakerName": "Apostolic Knight",
      "speakerToken": "avg_npc_358_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What I meant was, the ones you asked for are here."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Please come in, my children."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Ezell",
      "speakerToken": "avg_4036_forcer_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Salutations, Your Holiness..."
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Good day, Your Holiness. I am Cecelia."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah, welcome. You'll have to forgive me for the mess here."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "As for you two..."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What sweets do you like with tea?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Do you... need me to make something?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#8$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Hmm, let me think..."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe add a few cubes of sugar into your teacup?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ezell, perhaps you should add a few more. Some sweetness will mellow out your nerves."
    },
    {
      "type": "dialogue",
      "speakerName": "Ezell",
      "speakerToken": "avg_4036_forcer_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah! Y-Yes..."
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#12$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Your Holiness, if I... wanted to leave Laterano, would you let me go?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If I said no, would you obey me?"
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe not."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Then go."
    },
    {
      "type": "dialogue",
      "speakerName": "Ezell",
      "speakerToken": "avg_4036_forcer_1#3$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "...Your Holiness?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm just a poor old man whose greatest wish is to spend the rest of his life in a soft rocking chair. How could I muster the effort to manage a young girl's travel plans?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ezell",
      "speakerToken": "avg_4036_forcer_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But, Cecelia is..."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Is what? Do you still think she's some hybrid of angel and devil, a saint who will usher in the Revelation?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Cecelia is just a little girl who wants to go outside and see the world, is she not?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ezell",
      "speakerToken": "avg_4036_forcer_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You're still carrying your mama's guardian gun, right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ah, I'm sorry! Should I leave it with Mister Ezell?"
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But..."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It's fine, my child."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The acquisition of a patron firearm is a solemn affair. It is supposed to require a grand ceremony, the presence of a guardian, the approval of a mentor, as well as lots of troublesome paperwork..."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But, you aren't even of age to obtain a guardian gun. So, just take it with you quietly."
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Is that really okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I wouldn't dare say call this my boon to you. Each and every gun is a valuable asset to Laterano."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But, if this is the only keepsake a child has of her mother, I'm sure no one could oppose that."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Take it with you, my child. You may not have the physical ability to pull the trigger and take out a bad guy... but it will always remind you that wherever you go, your journey began in Laterano."
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "...Okay, thank you, Your Holiness."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Ezell, go with her. Call it your long-term field mission."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Just remember to stop by every now and then."
    },
    {
      "type": "dialogue",
      "speakerName": "Ezell",
      "speakerToken": "avg_4036_forcer_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Ezell",
      "speakerToken": "avg_4036_forcer_1#5$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Do I... really have the right to do that?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Of course you do. Is this not the choice that you made?"
    },
    {
      "type": "dialogue",
      "speakerName": "Ezell",
      "speakerToken": "avg_4036_forcer_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I will do everything in my power to fulfill this mission."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Look after Cecelia well."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Alright, now be on your way. Time waits for no man. When you get to be my age, all you think about is taking your next nap."
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Mister Pope..."
    },
    {
      "type": "dialogue",
      "speakerName": "Cecelia",
      "speakerToken": "avg_npc_352_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I promise to follow this path to the very end."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#9$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Oh?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "In that case, I will pray for you."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Velliv",
      "speakerToken": "avg_npc_361_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Your Holiness, are you satisfied with this outcome?"
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I got to enjoy some sweets with them. I am satisfied with that."
    },
    {
      "type": "dialogue",
      "speakerName": "Velliv",
      "speakerToken": "avg_npc_361_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The man has left, just as you instructed."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#10$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Should I have kept him around a bit longer? Maybe a piece of chocolate would've cheered him up?"
    },
    {
      "type": "dialogue",
      "speakerName": "Velliv",
      "speakerToken": "avg_npc_361_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Your Holiness... you're too soft-hearted."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No, Velliv, the dream of becoming torches in the cold night is doomed to failure. For all of us."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "But, serving a functionary a hot cup of tea... that's something we can always do."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "'This world is hostile to beauty...' May those who reject this aphorism find success."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "It is time for us to move on to our next task as well. Now that the riots have subsided, let's convene the foreign envoys."
    },
    {
      "type": "dialogue",
      "speakerName": "The Pope",
      "speakerToken": "avg_npc_356_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "The Revelation is clear, I will do what I must."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "speakerToken": "avg_213_mostma_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "That's not true, Fiammetta. You don't have to shoulder anyone's burden."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "No, that is my choice."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't care what power he was lusting after, what secrets he was trying to uncover, what answers he was trying to find."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't care about his ideals, his lofty cause, who he redeemed, or who he guided."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I will not forgive him."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Not because of my beliefs, not because of Laterano, not because of the Pontifica Cohors, and not even the time that I've lost..."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I will not forgive him, because––"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Andoain, you betrayed the people who trusted you."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "My old friends."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "How come you're here in one piece?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "How come even His Holiness can't..."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "How come...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "How come... you're asking me that again... The path was never there in the first place. What good does it do groping around in the nothingness?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "speakerToken": "avg_213_mostma_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Is this your penitence?"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Penitence? No, I have nothing to repent... Where can I repent? There is no light, no path. Those who suffer must continue to suffer, those who grieve must continue to grieve."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "There is no salvation, no paradise. This is Laterano, and it is the only thing that belongs to us."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If the light has always been a lie... No, not a lie... It's real, but not as we wished..."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "There has never been a light... let alone illumination..."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "What are you babbling about, Andoain?"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Have I given up? Why would I be here if I had given up?"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "With a barrier this thick, how am I supposed to embrace them? How am I supposed to embrace them?"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Maybe I am nothing more than a swindler peddling false hope... who deceived myself into believing it..."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I don't understand. What is Its judgment? Where does It want me to go? Its very presence has already blocked my path..."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Where shall I find my path?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Andoain! Wake up! Look who's standing in front of you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Who... Ahh... Fiammetta..."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Why are you losing your mind again?! Where did your honey tongue go, your righteous air? Have you lost your spine?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "How am I supposed to convict a husk of a madman? Take a good look at who's standing in front of you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "...I'm in Laterano, Fiammetta. I'm above the Basilica."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm glad to see you all again... No, I'm not glad at all."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Are you trying to get in the way?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You still dare to get in my way?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Apologize, Andoain."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Right now. Get on your knees and apologize to Mostima and Lemuen!"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "......"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Do you think you did nothing wrong?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I have made countless mistakes."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#2$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You're still pretty damned smug, aren't you?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "God forbid."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Listen up, Andoain. I don't give a damn what your beliefs are, nor do I care if all your beliefs have gone to shit."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Lemuen forgave you. Mostima forgave you. Yvangelista XI forgave you. Even if all of Laterano forgives you... I will not."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm so sorry, Fiammetta."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm not the one you should be apologizing to."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "If I had the chance, I'd probably do the same thing all over again."
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "speakerToken": "avg_213_mostma_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Are you for real? You'd say that in front of Fiammetta?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mostima",
      "speakerToken": "avg_213_mostma_1#1$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "And right now, you're not..."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Very good, Andoain."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Take out your gun."
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You know that won't accomplish anything."
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "You think I care about accomplishing something?! I in malam crucem! You think that if I kill you right here, Lemuen gets eight years of her life back?! Or that Mostima gets the whole rest of hers?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Pedicabo ego te et irrumabo! Accomplishing something!"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I want revenge for the sake of getting my goddamned revenge! Do you get that, Andoain?"
    },
    {
      "type": "dialogue",
      "speakerName": "Andoain",
      "speakerToken": "avg_npc_351_1#6$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "Are you so completely obsessed, Fiammetta?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "So what if I am?"
    },
    {
      "type": "dialogue",
      "speakerName": "Fiammetta",
      "speakerToken": "avg_300_phenxi_1#7$1",
      "operatorId": null,
      "portraitKey": null,
      "text": "I'll say it one more time, Andoain–– Take out your gun!"
    },
    {
      "type": "sceneBreak"
    }
  ],
  "observedOperators": []
}
