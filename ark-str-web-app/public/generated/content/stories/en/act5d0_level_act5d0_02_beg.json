  "sourceHash": "e7555a00efc053fa430f54a411835364d29ff59055625a8ca2f99dbe189ba663",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二关（前）"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerToken": "char_201_moeshd#5",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "*Cough cough* Everybody okay?"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#4",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "Just managed to block it——"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "Nice reflexes, you two."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#4",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "Whew, they really blew it up, didn't they?"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "————*indescribable penguin sounds*————"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerToken": "char_201_moeshd#5",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "(Wh- what's that? Baws's makin' all kinds of crazy sounds!)"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#7",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "(Hey, wasn't that box of vinyl records some kind of black market Columbian collectible thingy?)"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerToken": "char_201_moeshd#4",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "(I reckon yer right. What're we gonna do? I ain't never seen the baws all choked up like this before...)"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#7",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "What do you mean—— Hey! They're getting away! Those guys in black!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#4",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "Wait! If they were here setting that trap, why didn't they just ambush us? This isn't adding up. We need to take a minute and come up with a plan before——"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#8",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "Texas!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "Get in."
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "...Listen up."
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "You can expense your speeding tickets tonight."
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "They gotta pay... for my vinyl recoooords!!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerToken": "char_201_moeshd#3",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "Got 'em! Dead ahead!"
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "Exusiai! Pass me my Lil Homie!"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#8",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "You got it, boss!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#2",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "Is that a gun?! But how are you going to pull the trigger...?"
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "Hah! See for yourself, little man. Let our firearms expert tell you about it."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#8",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "That's forty-two layers of logistics-grade cardboard, seamlessly glued together with industrial adhesive, driven by the finest rubber bands. It's really a magnificent piece."
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#2",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "You mean... it's a toy?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#8",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "It's more of a slingshot——Ow! Err, it's a peacemaker!"
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "You can't use live ammo in downtown Lungmen. That's the law."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerToken": "char_102_texas_1#2",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "And yet this is the only time the boss seems to care what the law says."
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "If nobody follows the rules, our whole society goes to hell, you feel me? Texas, put the top down!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "Be careful. Don't want you hitting your head on a traffic signal like last time."
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "Do I look that tall to you?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#5",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "Support sniper in position, boss!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#4",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "W- wait a minute, there's a lot of other cars on the road. Don't tell me you're just gonna——"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafia Driver",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "They're shootin' at us! Return fire!"
    },
    {
      "type": "dialogue",
      "speakerName": "Back Seat Mafioso",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "How am I supposed to aim with you swervin' all over the place?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafia Driver",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, are you hit back there?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Back Seat Mafioso",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "I'm bleeding, they got me, I need a bandage—— No wait, what is this, rubber?"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafia Driver",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "A what?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Back Seat Mafioso",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "It's rubber, but it broke the glass! Shake 'em off, quick! Gah, that hurt!!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#8",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "Clean headshot, boss!"
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "Sic 'em, Texas!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerToken": "char_102_texas_1#4",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "I'm speeding up."
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#4",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "Slow down! Watch out for that big rig—— Aie!"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerToken": "char_201_moeshd",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "Yer gonna wanna hold on tight. Texas's whipped up wilder'n a Forte in a twister right now."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "Exu, blow their tires!"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#5",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "On it!"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#4",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "She's gonna pop their tires with rubber bullets?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Emperor",
      "speakerToken": "char_105_emper",
      "operatorId": "char_105_emper",
      "portraitKey": "char_105_emper",
      "text": "I have spoken. So let it be done."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#2",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "Texas, can you talk some sense into them?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerToken": "char_102_texas_1#2",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "(Looks away) ......"
    },
    {
      "type": "dialogue",
      "speakerName": "Croissant",
      "speakerToken": "char_201_moeshd",
      "operatorId": "char_201_moeshd",
      "portraitKey": "char_201_moeshd",
      "text": "Forget it. They're havin' a good time."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#8",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "Check this out! It's gonna do a cool flip!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Mafia Driver",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Hey, I can't move the steering wheel!"
    },
    {
      "type": "dialogue",
      "speakerName": "Back Seat Mafioso",
      "speakerToken": null,
      "operatorId": null,
      "portraitKey": null,
      "text": "Shit, bail out!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Bison",
      "speakerToken": "char_325_bison_1#4",
      "operatorId": "char_325_bison",
      "portraitKey": "char_325_bison",
      "text": "Wait! Going this fast, we're gonna get pulled in!"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#4",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "Hah."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerToken": "char_103_angel_1#4",
      "operatorId": "char_103_angel",
      "portraitKey": "char_103_angel",
      "text": "All right, now the multi-car pileup is all yours, Texas!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerToken": "char_102_texas_1",
      "operatorId": "char_102_texas",
      "portraitKey": "char_102_texas",
      "text": "Gee, thanks a lot."
    },
    {
      "type": "sceneBreak"
    }
  ],
