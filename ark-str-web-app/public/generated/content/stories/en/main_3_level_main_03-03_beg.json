  "title": "Convolution",
  "storyCode": "3-3",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsGamedata/en/gamedata/story/obt/main/level_main_03-03_beg.txt",
  "sourceHash": "076a696cecf2fb401c8bba18e348d8f74dfda15a5a9fd9aaa947239308370c29",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第二十五关（前）"
    },
    {
      "type": "background",
      "backgroundId": "bg_wild_a"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Curses...!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "There are only two enemies! Get in there already!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "What are you so scared of?!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "We've already lost over twenty soldiers!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Those two devils are no ordinary people...!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "Watch your right!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "Give me a hand."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Keep pressuring her! I'll finish her off!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "I don't have time to deal with that guy rushing at me."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "You owe me a drink next time, all right?"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "Sure, now hurry it up."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "All right!"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "Hey, Mister Reunion guy?"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "This bullet is my gift to you. Make sure to accept it with gratitude~"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Bullet? What the..."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Guh... Ughh..."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "Heh, took care of him for you~"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "Thank you very much."
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Y-you monster!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Her... her sword..."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "Aaaaahh! I'm sorry!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "--Usually, I prefer to use two."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Gaah! Aaagh! !"
    },
    {
      "type": "background",
      "backgroundId": "bg_wild_a"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "That's the rest of them."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "We were totally in sync back there!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "...Guess so."
    },
    {
      "type": "background",
      "backgroundId": "bg_wild_a"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Get back here!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "Here comes their main force."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "Looks like we made a bit too much noise and drew their attention."
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "Aaaaaah!!! You...!!"
    },
    {
      "type": "dialogue",
      "speakerName": "Reunion Member",
      "speakerId": "char_1002_nsabr",
      "isRemote": false,
      "text": "How can this be... What have you done?!"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "Ah, don't take this personally."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "But, we're on a contract, you know?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "When you're in a logistics business, there's nothing more important than fulfilling your contracts!"
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "On your left."
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "Huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "Wha- huh?"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "Th-thanks."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "Please cover my right then."
    },
    {
      "type": "dialogue",
      "speakerName": "Texas",
      "speakerId": "char_102_texas",
      "isRemote": false,
      "text": "Start running. We need to move."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": true,
      "text": "Exusiai, we're currently approaching your position!"
    },
    {
      "type": "dialogue",
      "speakerName": "Exusiai",
      "speakerId": "char_103_angel",
      "isRemote": false,
      "text": "We've drawn the full attention of the enemy. The rest is up to you!"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": true,
      "text": "Stay safe, you two!"
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "Franka, have you arrived at the destination yet?"
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "speakerId": "char_106_franka",
      "isRemote": true,
      "text": "All good here."
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "speakerId": "char_107_liskam",
      "isRemote": true,
      "text": "Liskarm and the other defenders are already in position."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "Everyone, please be on your guard. The enemy snipers may be using the landscape to conceal themselves."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "Make sure to mind your own positioning, and prioritize targeting the enemy snipers."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "Next... we'll prepare our assault."
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "speakerId": "char_002_amiya",
      "isRemote": false,
      "text": "...But don't overdo it, we can't put our target in danger."
    },
    {
      "type": "sceneBreak"
    }
  ],
