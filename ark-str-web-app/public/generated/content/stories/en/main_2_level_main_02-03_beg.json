{
  "server": "en",
  "storyId": "main_2_level_main_02-03_beg",
  "groupId": "main_2",
  "stageId": "main_02-03",
  "title": "Presumption of Innocence",
  "storyCode": "2-3",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/obt/main/level_main_02-03_beg.txt",
  "sourceHash": "92c8804e80a0201968a0f65a9dd917df0b515ccd2d107573daf3b7c5a375ceb9",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "narration",
      "text": "第十五关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Hurry, hide!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "I... I need to go.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "Take this... this is for you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "This is a protective charm. My mother taught me how to these...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "And this is one that I made.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "???",
      "text": "When you make these dolls by hand, you can keep the ones you care about safe.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Children",
      "text": "Okay, sister Misha, we'll take good care of it!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Good, good.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Misha",
      "text": "Now, go hide! And don't make a sound.",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Children",
      "text": "Okay!",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Where'd they go? ! After them! Let's see how far those Infected can run!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Hmm? Now... what do we have here?",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "According to Exusiai's data, our mission target should have been staying somewhere around here...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Argh, the terrain around here is really complicated. If we were doing this alone, this assignment might have been quite troublesome...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Luckily, I got in touch with Penguin Logistics beforehand...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Who's there?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Those people are...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Baddies! You bunch of baddies! Let go of me! Let... Go...!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Tell me! Where'd she run off to?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Stop playing dumb!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Sister! Sister! Where are you...! Help...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Child",
      "text": "Sister Misha! Sister Misha, save me!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Who is it?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Get back here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...You should leave right now if you know what's good for you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Who the hell...?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "You don't like you're from around here!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "You're not afraid of us...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Otherwise...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Gaaah!!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Wh-what was that?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Arts! Sh-she's using Arts?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Aaaargh! Stay away from me!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...Don't bully the defenseless ever again.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Rioter",
      "text": "Aaaagh! Monster!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Heh... Monster, huh?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Everything will be okay. You can come out now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It's dangerous here. You should hurry and find some place safe.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Children",
      "text": "Thank you, ma'am!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Take care!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Amiya, what's going on?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Hm, I saw an Infected just now, probably unregistered...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "From Ursus?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Yes. She was heading deeper into the slums.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Franka, gather the nearby operators.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "Okay.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "The deeper we head into the slums, the more volatile things are going to be...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "There are ordinary civilians, criminals, and refugees - all mixed together.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We'll have to make thorough preparations.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Amiya, we have incoming comms.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Please wait a second.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "That's right.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Amiya, it's the L.G.D.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Was that Madam Ch'en?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Indeed.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "... That's right. We've already found a number of unregistered Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "... Yes.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "... What?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "... We're after an Ursus girl, short white hair, height of about 145 cm, called Misha?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "That's...?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "...Understood.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Amiya, Madam Ch'en wants us to immediately search for the Infected just described.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Once we find her, we are to turn her in to the L.G.D. immediately.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Can I speak to her please?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Hello, hello...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Madam Ch'en, can you hear me?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "I hear you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Can I confirm the validity of that order?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "100% valid, effective immediately.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "I see.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "She suddenly hung up...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Franka",
      "text": "That Ch'en, she's got a bit of a temper.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "So this is going to be our mission for now...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Amiya, I've just received another message from several defenders.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "They met some individuals who were openly hostile to Rhodes Island's operators.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Liskarm",
      "text": "Furthermore, those attackers weren't ordinary people, they were... Infected.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "... Have the defenders fall back towards us.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Scout team! Our target is an Ursine girl with short white hair, height of 145 cm. Remember to stay hidden, and stay safe!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Other operators, follow your leaders and spread out.",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "It'd be best to stall them out.",
          "value": "1",
          "blocks": []
        },
        {
          "label": "So we're... going to lure them in?",
          "value": "2",
          "blocks": []
        },
        {
          "label": "Franka, let's attack them head-on.",
          "value": "3",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Franka",
          "text": "Hey... Not bad.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Franka",
          "text": "Liskarm, this kid's pretty smart.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Liskarm",
          "text": "... Dr. {@nickname} is our tactical commander. You should take this more seriously.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "Let's begin.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Amiya",
          "text": "So... Rhodes Island has to fight against the Infected again...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
