  "blocks": [
    {
      "type": "narration",
      "text": "第三十二关（前）"
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Frostleaf? Frostleaf?!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "What's going on...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Amiya! This is the 2nd Recon Squad....",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "We're currently retreating! But, the enemy...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "Reunion...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Guard",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "It cut out again?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "3rd Recon Squad! Do you copy? 3rd Recon Squad!",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Amiya.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Dr. Kal'tsit! It's me! Did you get--",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "I've been continuously monitoring them from the bridge.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "I need you to ask something to that officer next to you.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "Ask her...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Kal'tsit",
      "text": "'How long does Lungmen intend to keep playing dumb?'",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "I'll pretend I didn't hear that.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "But, we certainly don't have time to waste.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "What happened? I just went to grab some forms, and you two look all serious now.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Hoshiguma",
      "text": "...A new mission?",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "Correct.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Everyone... Gear up. It's about time for us to head out.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Madam Ch'en, I'm am formally requesting that the L.G.D. provide assistance to Rhodes Island on this rescue mission.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "We may even be dealing with Reunion's new temporary headquarters...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Ch'en",
      "text": "...",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Amiya",
      "text": "Furthermore, I believe that our recon squads are still out there fighting, even if we can't see them...",
      "portraitKey": null
    },
    {
      "type": "sceneBreak"
    }
  ]
}
