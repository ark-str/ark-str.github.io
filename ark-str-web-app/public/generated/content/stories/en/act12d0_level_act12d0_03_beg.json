{
  "server": "en",
  "storyId": "act12d0_level_act12d0_03_beg",
  "groupId": "act12d0",
  "stageId": "act12d0_03",
  "title": "Old Times",
  "storyCode": "RI-3",
  "avgTag": "Before Operation",
  "sourcePath": "vendor/ArknightsData/en/gamedata/story/activities/act12d0/level_act12d0_03_beg.txt",
  "sourceHash": "296ac5e0e6c6b44e3e0cf572dcf36466e1dfaf12fe3c4ec71869abccc84075ad",
  "bodyAvailable": true,
  "blocks": [
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Doctor, I took a quick stroll around. Didn't seem like there were any others.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Looks like we're gonna have to head back into the rainforest to look for her bunch after this.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Peta",
      "text": "——! (Cry of victory)",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "text": "Oh, Peta won.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "This Peta's pretty good. Makes me wanna rumble with him, actually.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "text": "Mm-hm! He's one of my tribe's warriors.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "text": "But he's definitely not as good as you, Gavial.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Gavial",
      "text": "Haha, easy enough to say.",
      "portraitKey": null
    },
    {
      "type": "dialogue",
      "speakerName": "Tomimi",
      "text": "Come on, Gavial! You already came so close to becoming Great Chief over when we were little! Like you could lose to Peta!",
      "portraitKey": null
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "When you were little?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hmm? Oh, yeah, that one time.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "I was super young. Thought the idea was so cool, I actually went in for the ceremony once.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Yeah, and you were already so super strong by then!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria Warrior",
          "text": "Gah...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria Champion",
          "text": "So that's all you Wilderness's Wills amount to!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "S-Strong...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria A",
          "text": "Pfeh. All our warriors taken down like nothing.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria B",
          "text": "Let's go in together!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria A",
          "text": "We can't. No number at once will be enough... Can we only give up...?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria Champion",
          "text": "Who else wants to challenge me?! If you're all done, then it's just me versus the Great Chief!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "I do!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria Champion",
          "text": "And you're... Wilderness's Will's orphan, Gavial?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria Champion",
          "text": "I hear you're a terror among the kids, but kids don't join the ceremony. Run back home and drink your milk. You've got a few more years.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hmph! Let's see who wins first!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria Champion",
          "text": "Hah! You really are an orphan. You don't fear death?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "My tribespeople are my family! Cut the crap! Do you wanna go or not?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria Champion",
          "text": "Heh! It's your funeral, brat!",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria Champion",
          "text": "Im... Impossible... Just two punches...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Gavial's... so strong...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Hmph! I guess that's all, then!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Who else wants some?",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "Gavial was an orphan?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Didn't she ever tell you?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Didn't I?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Eh. I guess I didn't, but it's not like it was important enough to come up.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Dunno who my parents were, but that's not all that rare in these parts.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Doctor, it may not make sense to you, but death is pretty common out here.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "It doesn't even take a Catastrophe—honestly, nobody here knows what Catastrophes are—a single cold or a bout of bad weather can kill off folks who would've lived otherwise.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "I'd guess my parents just went like that.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Eugh. Let's quit this talk. All you need to know is the tribe raised me.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Gavial...",
          "portraitKey": null
        }
      ]
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "You've come a long way.",
          "value": "1",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "You can quit it, Doctor. I don't really need the pity treatment.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "I'm not the only orphan ever. Plenty of families around here that link up and raise a bunch of 'em together. It happens all the time.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "......",
          "value": "2",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "Doctor, don't overthink it.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "I didn't even know it was unusual until I left.",
              "portraitKey": null
            },
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "Actually, I guess you could say it's what made me decide to do medicine.",
              "portraitKey": null
            }
          ]
        },
        {
          "label": "Well, at least you're healthier than anyone now.",
          "value": "3",
          "blocks": [
            {
              "type": "dialogue",
              "speakerName": "Gavial",
              "text": "Haha. Yeah.",
              "portraitKey": null
            }
          ]
        }
      ],
      "sharedBlocks": []
    },
    {
      "type": "choice",
      "options": [
        {
          "label": "So how'd that ceremony back then turn out?",
          "value": "1",
          "blocks": []
        }
      ],
      "sharedBlocks": [
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "That one, uh...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "???",
          "text": "Found you, you goshdarned bounty hunter!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Peta",
          "text": "Who's that?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Huh? I know that voice...",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        },
        {
          "type": "dialogue",
          "speakerName": "Ceobe",
          "text": "Give the Doctor back!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Peta",
          "text": "What the hell are you talking about?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Kay?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Tomimi, didn't we tell your people to tie her up and take her back to the tribe?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Um, I thought we did?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "She's real strong. Kid must've just plowed past everyone...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceobe",
          "text": "Bounty hunter! Hand the Doctor over!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Ceobe",
          "text": "Or else I'm gonna chase you to the end of the world, if I hafta!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Tch. Smartest girl ever. Looks like she still hasn't even sobered up.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Peta",
          "text": "Gahhh!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "She sent Peta flying!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria A",
          "text": "She finished Peta off!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria B",
          "text": "She's insanely strong...",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria C",
          "text": "Where'd that weirdo come from?! Which tribe is she?!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria A",
          "text": "No idea! I don't even understand what she's saying!",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Archosauria B",
          "text": "Forget it! All we gotta do is beat her, right?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "Oh, damn it. Now they think Kay's the new challenger, don't they?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Tomimi",
          "text": "Gavial, should we go in and help?",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "No, wait. The dumb little kid is way tougher than you'd think. She can handle this. If we go in, we're just gonna add to the body count.",
          "portraitKey": null
        },
        {
          "type": "dialogue",
          "speakerName": "Gavial",
          "text": "But something tells me this might get messy. Doctor, see if you can help Tomimi's lackeys get this under control.",
          "portraitKey": null
        },
        {
          "type": "sceneBreak"
        }
      ]
    }
  ]
}
